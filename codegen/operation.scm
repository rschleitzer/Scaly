<![CDATA[
;; Generate the protocol of an operation from the levels of scaly.sgm
;; (ROADMAP-operation.md): the binding strength of the binary operators,
;; written as pending types the planner reads an operation by. The compiler
;; has no table; this file is what says that `a + b * c` is `a + (b * c)`.
;;
;; Per operator two types: OpXWaits, `left X` waiting for its right
;; operand, and OpX, `left X right` waiting to see what follows. A following
;; operator that binds TIGHTER descends -- the right operand becomes the
;; left of the new operator, and `left X` waits outside; any other folds
;; the raw operation `left.X(right)` and hands the value to what waits
;; outside, which then meets the operator. OpTop is what waits outside the
;; whole operation, OpValue a value before any operator.

(define (operation-levels)
    (node-list->list (select-elements (children (current-node)) "level")))

;; every operator as (node level-index level-node), the strongest level first
(define (operation-operators)
    (let loop ((levels (operation-levels)) (i 0) (acc '()))
        (if (null? levels)
            acc
            (loop (cdr levels) (+ i 1)
                (append acc
                    (map (lambda (op) (list op i (car levels)))
                        (node-list->list (select-elements (children (car levels)) "operator"))))))))

(define (op-name e) (attribute-string "name" (car e)))
(define (op-value e) (attribute-string "value" (car e)))
(define (op-index e) (car (cdr e)))
(define (op-level e) (attribute-string "name" (car (cdr (cdr e)))))
(define (op-others? e) (string=? "others" (attribute-string "others" (car (cdr (cdr e))))))

;; how the operator is written: a symbol or a word as it stands, the
;; stand-in of the operators no level names as a text name
(define (op-token e)
    (if (op-others? e)
        ($ "'" (op-value e) "'")
        (op-value e)))

(define (op-head e)
    ($ "pending @operator \"" (op-value e) "\" @level \"" (op-level e) "\""
        (if (op-others? e) " @others true" "")))

(define (generate-operation-value ops) ($
"
; a value before any operator: the operator that follows begins the climb
define OpValue[O, V] pending (outer: O, value: V)
{"
    (apply $ (map (lambda (p) ($
"
    operator " (op-token p) "(this)
        Op" (op-name p) "Waits(outer, value)")) ops))
"
    function finish(this)
        value
}
"))

(define (generate-operation-operator o ops) ($
"
; `left " (op-value o) "`, waiting for its right operand
define Op" (op-name o) "Waits[O, L] " (op-head o) " (outer: O, left: L)
{
    function apply(this, right)
        Op" (op-name o) "(outer, left, right)
}

; `left " (op-value o) " right`, waiting to see what follows
define Op" (op-name o) "[O, L, R] " (op-head o) " (outer: O, left: L, right: R)
{"
    (apply $ (map (lambda (p)
        (if (< (op-index p) (op-index o))
            ($
"
    operator " (op-token p) "(this)
        Op" (op-name p) "Waits(Op" (op-name o) "Waits(outer, left), right)")
            ($
"
    operator " (op-token p) "(this)
        outer.apply(left." (op-token o) "(right)) " (op-token p))))
        ops))
"
    function finish(this)
        outer.apply(left." (op-token o) "(right)).finish()
}
"))

(define (generate-operation)
    (let ((ops (operation-operators)))
        ($
"; operation.scaly - Generated from scaly.sgm
; DO NOT EDIT - generated by codegen
;
; The protocol of an operation (ROADMAP-operation.md): an operation is a
; sequence of values and operator names, read from the left. `a +` answers a
; pending value that waits for what follows; the planner evaluates these
; types where it reads an operation and plans what is left, one raw
; operation at a time (`left.+(right)`, the operator as a member: never the
; protocol again). A pending type is never laid out and its members are
; never routines. The levels, the strongest first, are scaly.sgm's
; <level> elements; the level marked `others` takes every operator a type
; declares that no level names.

; nothing waits outside the operation
define OpTop pending @start true ()
{
    function apply(this, value)
        OpValue(this, value)
}
"
            (generate-operation-value ops)
            (apply $ (map (lambda (o) (generate-operation-operator o ops)) ops)))))
]]>
