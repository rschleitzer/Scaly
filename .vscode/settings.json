{
    // The Scaly extension (editors/vscode) contributes the `scaly` language and
    // its grammar, so no association is needed here. Do NOT map *.scaly to
    // plaintext: files.associations OVERRIDES the extension's own extension
    // mapping, which kills both the highlighting and the LSP client (its only
    // activation event is onLanguage:scaly).
    "files.associations": {
        "*.scaly": "scaly"
    }
}
