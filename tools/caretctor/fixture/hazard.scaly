; Fixture for tools/caretctor/scan.py -- NOT part of any package, never built.
;
; Both shapes below are the ones the scanner must separate.  Run:
;     python3 tools/caretctor/scan.py tools/caretctor/fixture
; and expect exactly one HAZARD (the StringBuilder, whose init carries a
; `^this`) and one CONVERT (the empty StringC, whose init allocates nothing).
; The HAZARD form was measured at rc 138; the CONVERT form is merely a wasted
; struct copy.
use scaly.memory.Page
use scaly.containers.StringBuilder
use opensp.StringC.StringC

function hazard(host: ref[Page]) returns ref[StringBuilder]
{
    let p host.allocate(sizeof StringBuilder, alignof StringBuilder) as pointer[StringBuilder]
    set *p: StringBuilder()
    p as ref[StringBuilder]
}

function convertible(host: ref[Page]) returns ref[StringC]
{
    let p host.allocate(sizeof StringC, alignof StringC) as pointer[StringC]
    set *p: StringC()
    p as ref[StringC]
}
