{
  "display_name": "scaly-http",
  "language": "Scaly",
  "type": "experimental",
  "engine": "scaly",
  "mode": "standard",
  "description": "The http package of the Scaly language on its own runtime: one scheduler per core, a fiber per connection with region-based memory that dies with the request, an HTTP/1.1 parser resumable at any byte, pipelined responses in one write, JSON written per request by its own json package and gzipped through libdeflate.",
  "repo": "https://github.com/rschleitzer/Scaly",
  "enabled": true,
  "completeness": {
    "routing": true,
    "middleware": true,
    "request": true,
    "response": true
  },
  "tests": [
    "baseline",
    "pipelined",
    "limited-conn",
    "async",
    "latency-1m",
    "latency-10k",
    "latency-500k-8cpu",
    "json-comp",
    "json-tls",
    "async-db",
    "fortunes",
    "static-tls",
    "8gbit",
    "baseline-h2",
    "static-h2",
    "baseline-h2c",
    "json-h2c",
    "unary-grpc",
    "unary-grpc-tls",
    "echo-ws",
    "echo-ws-pipeline",
    "echo-ws-limited",
    "baseline-h3",
    "static-h3"
  ],
  "maintainers": []
}
