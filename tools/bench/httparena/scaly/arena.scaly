; arena -- the Scaly entry of HttpArena: the http package and its siblings,
; used the way an application uses them.
;
;   profile                              route                     port
;   baseline, limited-conn, latency-*    GET/POST /baseline11      8080
;   pipelined                            GET /pipeline             8080
;   async                                GET /delay/{ms}           8080
;   json-comp                            GET /json/{count}?m=      8080
;   json-tls, 8gbit (POST /echo),
;     static-tls                         the same routes over TLS  8081
;   baseline-h2c, json-h2c               HTTP/2 only, by prior     8082
;                                          knowledge (start_h2c)
;   baseline-h2, static-h2               GET /baseline2, /static   8443 (TLS)
;   baseline-h3, static-h3               the same over QUIC        8443 (UDP)
;   async-db                             GET /async-db             8080 (db.scaly)
;   production-stack (behind an edge)    /public/*, /api/items/{id},
;                                          /api/me                 8080 (stack.scaly)
;   unary-grpc, unary-grpc-tls           BenchmarkService/GetSum   8080, 8443
;   echo-ws, -pipeline, -limited         GET /ws                   8080
;
;   arena [port [tls-port [h2-port [h2c-port]]]]   (default 8080 8081 8443 8082;
;                                                   0 keeps a port closed)
;
; One scheduler per core, a fiber per connection, and a region per request:
; what a handler allocates dies when it returns -- there is no collector.
; The dataset (/data/dataset.json, or DATASET_PATH) is parsed once into
; records; every /json answer is serialized and, where the client accepts
; it, compressed per request by the router (gzip from the compress
; package). TLS 1.3 comes from the tls package (OpenSSL), HTTP/2 from the
; http package, HTTP/3 from the h3 package (ngtcp2).

package scaly 0.2.0
package http 0.2.0
package json 0.2.0
package compress 0.2.0
package tls 0.2.0
package https 0.2.0
package h3 0.2.0
package pg 0.2.0

module db
module stack

use http.Request.Request
use http.Response.Response
use http.Router.Router
use http.WebSocket.WebSocket
use json.Value.JsonValue
use json.Writer.JsonWriter
use tls.Tls.TlsContext

; One dataset entry, as the benchmark's validation reads it back.
define Item
(
    id: i64
    name: String
    category: String
    price: i64
    quantity: i64
    active: bool
    tags: Vector[String]
    score: i64
    rating_count: i64
)

; The dataset, set once in main before the schedulers start and only read
; after: every connection's fiber reads it from its own thread.
shared dataset: ref[Array[Item]]? null

; baseline: a + b, plus the body when there is one.
procedure baseline(req: ref[Request], mutable res: ref[Response])
{
    var sum parse_int_prefix(req.query_param("a")) + parse_int_prefix(req.query_param("b"))
    if req.body.length > 0
        sum := sum + parse_int_prefix(trim(req.body))
    res.send_int(sum)
}

procedure pipeline(req: ref[Request], mutable res: ref[Response])
    res.send_text("ok")

; async: waits ms without holding a thread, then answers the number.
procedure delay(req: ref[Request], mutable res: ref[Response])
{
    let ms parse_int_prefix(req.param("ms"))
    if ms > 0
        Scheduler.sleep(ms)
    res.send_int(ms)
}

; json: the first count items, each with total = price * quantity * m.
procedure json_items(req: ref[Request], mutable res: ref[Response])
{
    let items dataset
    if items = null
    {
        res.set_status(500)
        res.send_empty()
        return
    }
    var count parse_int_prefix(req.param("count"))
    if count < 0
        count := 0
    if count > (items.length as i64)
        count := items.length as i64
    var m: i64 1
    let m_text req.query_param("m")
    if m_text.length > 0
        m := parse_int_prefix(m_text)
    var w JsonWriter()
    w.begin_object()
    w.key("items")
    w.begin_array()
    var i: i64 0
    while i < count
    {
        let it items.at(i as size_t)
        w.begin_object()
        w.key("id")
        w.integer(it.id)
        w.key("name")
        w.text(it.name.as_slice())
        w.key("category")
        w.text(it.category.as_slice())
        w.key("price")
        w.integer(it.price)
        w.key("quantity")
        w.integer(it.quantity)
        w.key("active")
        w.boolean(it.active)
        w.key("tags")
        w.begin_array()
        var t: size_t 0
        while t < it.tags.length
        {
            w.text(it.tags[t].as_slice())
            t := t + 1
        }
        w.end_array()
        w.key("rating")
        w.begin_object()
        w.key("score")
        w.integer(it.score)
        w.key("count")
        w.integer(it.rating_count)
        w.end_object()
        w.key("total")
        w.integer(it.price * it.quantity * m)
        w.end_object()
        i := i + 1
    }
    w.end_array()
    w.key("count")
    w.integer(count)
    w.end_object()
    ; gzip where the client accepts it: the router's (app.compress in main)
    res.send_json(&w)
}

; static: a file of the mounted directory, or its .br/.gz twin by
; Accept-Encoding -- the http package's static handler, which follows the disk.
procedure static_file(req: ref[Request], mutable res: ref[Response]) mutable static_cache
    serve_file(req, res, "/data/static", req.param("path"))

; 8gbit: the body back as it came, Content-Length or chunked.
procedure echo(req: ref[Request], mutable res: ref[Response])
    res.send("application/octet-stream", req.body)

; unary-grpc: SumRequest{a, b} in, SumReply{result} out.
procedure get_sum(req: ref[Request], mutable res: ref[Response])
{
    let msg grpc_message(req.body)
    var reply u8[24]
    let out Slice[u8](24, &reply[0])
    let n proto_put_varint(out, 0, 1, proto_varint(msg, 1) + proto_varint(msg, 2))
    grpc_reply(res, out.slice_to(n))
}

; echo-ws: every text or binary message back as it came.
procedure ws_echo(mutable ws: ref[WebSocket], opcode: u8, payload: Slice[u8])
    ws.send(opcode, payload)

procedure ws_upgrade(req: ref[Request], mutable res: ref[Response])
    res.accept_websocket(req, &ws_echo)

; Ends the server -- registered only in the PGO training run (SCALY_ARENA_TRAIN
; set, train.scaly), whose profile is written at a clean exit.
procedure shutdown(req: ref[Request], mutable res: ref[Response])
{
    res.set_close()
    res.send_text("bye")
    TcpServer.current().shutdown()
}

; Read the dataset onto host as records; false when it cannot be read.
procedure load_dataset(host: ref[Page], path: String) returns bool mutable dataset
{
    let text File.read_to_string(path)
    let parsed JsonValue.parse(text.as_slice())
    if parsed.ok() = false
        return false
    let doc parsed.value
    let items &Array[Item]^host()
    var i: size_t 0
    while i < doc.length()
    {
        let v doc.item(i)
        let rating v.get("rating")
        let tags_v v.get("tags")
        var tags Vector[String]^host(tags_v.length())
        var t: size_t 0
        while t < tags_v.length()
        {
            tags.put(t, String^host(tags_v.item(t).as_string()))
            t := t + 1
        }
        items.add(Item(v.get("id").as_i64(), String^host(v.get("name").as_string()), String^host(v.get("category").as_string()), v.get("price").as_i64(), v.get("quantity").as_i64(), v.get("active").as_bool(), tags, rating.get("score").as_i64(), rating.get("count").as_i64()))
        i := i + 1
    }
    dataset := items
    true
}

; Argument i as a port number, `otherwise` where it is not given.
function port_arg(argc: int, argv: pointer[pointer[const_char]], i: int, otherwise: int) returns int
{
    if argc <= i
        return otherwise
    parse_int_prefix(String(argv[i]).as_slice()) as int
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int mutable dataset, item_l1, user_l1
{
    let port port_arg(argc, argv, 1, 8080)
    let tls_port port_arg(argc, argv, 2, 8081)
    let h2_port port_arg(argc, argv, 3, 8443)
    let h2c_port port_arg(argc, argv, 4, 8082)

    var path String("/data/dataset.json")
    let env_path getenv("DATASET_PATH")
    if env_path <> null
        path := String(env_path)
    if load_dataset(Page.allocate_page(), path) = false
        print "arena: no dataset at `path` - /json answers 500"

    var app Router.create(Page.allocate_page())
    app.any("/baseline11", &baseline)
    app.get("/baseline2", &baseline)
    app.get("/pipeline", &pipeline)
    app.get("/delay/{ms}", &delay)
    app.get("/json/{count}", &json_items)
    app.get("/static/{path...}", &static_file)
    app.post("/echo", &echo)
    app.post("/benchmark.BenchmarkService/GetSum", &get_sum)
    app.get("/ws", &ws_upgrade)
    app.get("/async-db", &async_db)
    ; it waits on the database: over HTTP/2 it runs beside the other streams
    app.waits("/async-db")
    ; production-stack, behind its edge (scaly_nginx)
    app.get("/public/baseline", &baseline)
    app.get("/public/json/{count}", &json_items)
    app.get("/api/items/{id}", &api_item_get)
    app.post("/api/items/{id}", &api_item_post)
    app.get("/api/me", &api_me)
    app.waits("/api/items/{id}")
    app.waits("/api/me")
    let stack_host Page.allocate_page()
    item_l1 := l1_table(stack_host, 100001, ITEM_TTL_MS)
    user_l1 := l1_table(stack_host, 1024, USER_TTL_MS)
    if getenv("SCALY_ARENA_TRAIN") <> null
        app.get("/shutdown", &shutdown)
    ; responses of text and JSON in gzip where the client takes it (the
    ; compress package's libdeflate; the static files choose their twins)
    app.compress("", "gzip", &gzip_compress)

    ; the main port first: a readiness probe that finds the TLS or h2c port
    ; answering must find this one listening too (HttpArena's validate.sh
    ; takes any of them for "up" and asks this one next)
    let main_listener TcpListener.listen_any(port)
    if main_listener.is_open() = false
    {
        print "arena: cannot listen on port `port`"
        return 1
    }

    var cert String("/certs/server.crt")
    var key String("/certs/server.key")
    let env_cert getenv("TLS_CERT")
    let env_key getenv("TLS_KEY")
    if env_cert <> null and env_key <> null
    {
        cert := String(env_cert)
        key := String(env_key)
    }
    ; HTTP/1.1 over TLS 1.3
    let context TlsContext.server(cert, key)
    if context.valid() and tls_port > 0
    {
        let tl TcpListener.listen_any(tls_port)
        if tl.is_open()
            https.Server.start(app, tl, context)
        else
            print "arena: cannot listen on port `tls_port`"
    }
    ; HTTP/2 over TLS, and HTTP/3 on the same port number over UDP
    var h2_context TlsContext.server(cert, key)
    if h2_context.valid() and h2_port > 0
    {
        h2_context.prefer_h2()
        let hl TcpListener.listen_any(h2_port)
        if hl.is_open()
            https.Server.start_h2(app, hl, h2_context)
        else
            print "arena: cannot listen on port `h2_port`"
        if start_h3(app, h2_port, cert, key) = false
            print "arena: no HTTP/3 on port `h2_port` (no TLS context, or no UDP socket)"
    }
    ; HTTP/2 by prior knowledge alone (the main port answers it beside HTTP/1.1)
    if h2c_port > 0
    {
        let cl TcpListener.listen_any(h2c_port)
        if cl.is_open()
            start_h2c(app, cl)
        else
            print "arena: cannot listen on port `h2c_port`"
    }
    ; HTTP/1.1, WebSocket and gRPC on the main port, until the process ends
    let server start(app, main_listener)
    server.wait()
    0
}
