; arena — the HttpArena endpoints of ROADMAP-http.md stage A, served by the
; http package: the entry that is measured against the other frameworks.
;
;   GET/POST /baseline11?a=&b=   the sum of a, b and the (optional) body
;   GET      /baseline2?a=&b=     the same over HTTP/2 (stage E)
;   GET      /pipeline           "ok"
;   GET      /delay/{ms}         waits ms, then answers the number
;   GET      /json/{count}?m=    the first count items of the dataset, each with
;                                total = price * quantity * m, gzip-compressed
;                                when Accept-Encoding allows it (stage B)
;   GET      /async-db?min=&max=&limit=   the items priced between min and max
;                                (default 10, 50), at most limit (1..50, default
;                                50), from Postgres (DATABASE_URL; stage C)
;   GET      /fortunes           the fortune table and one row added per
;                                request, sorted by message, as an HTML table
;   GET      /static/{path...}   a file of /data/static, or its .br/.gz twin by
;                                Accept-Encoding (http.Static; stage D)
;   POST     /echo               the request body, unchanged (8gbit)
;   POST     /benchmark.BenchmarkService/GetSum   unary gRPC: SumRequest{a, b}
;                                in, SumReply{result} out (stage E)
;   GET      /shutdown           ends the server (only with SCALY_ARENA_TRAIN set,
;                                the PGO training run)
;
;   arena [port [tls-port [h2-port [h2c-port]]]]   (default 8080, 8081, 8443, 8082)
;
; The same routes answer over TLS 1.3 on the tls port (json-tls, stage D)
; and on the h2 port, whose ALPN prefers h2 (baseline-h2, static-h2, stage
; E), with the certificate and key the harness mounts (/certs/server.crt and
; /certs/server.key, else TLS_CERT and TLS_KEY); without a readable pair
; both stay closed. Every plain port serves HTTP/2 by prior knowledge
; beside HTTP/1.1 (the h2c port for baseline-h2c and json-h2c).
;
; The dataset (DATASET_PATH, default /data/dataset.json) is read ONCE, parsed
; with the json package into records, and serialized per request by a
; JsonWriter on the handler's frame page -- nothing is prepared for a count
; or a multiplier.

package scaly 0.1.0
package http 0.1.0
package json 0.1.0
package compress 0.1.0
package tls 0.1.0
package https 0.1.0
package pg 0.1.0

use http.Request.Request
use http.Response.Response
use http.Router.Router
use json.Value.JsonValue
use json.Value.JsonParsed
use json.Writer.JsonWriter
use tls.Tls.TlsContext
use pg.Conn.PgConn
use http.Buffer.ByteBuf

; One dataset entry, as the benchmark's validation reads it back.
define Item
(
    id: i64
    name: String
    category: String
    price: i64
    quantity: i64
    active: bool
    tags: Vector[String]
    score: i64
    rating_count: i64
)

; The dataset, set once in main before the schedulers start and only read
; after: every connection's fiber reads it from its own thread.
shared dataset: ref[Array[Item]]? null

procedure baseline(req: ref[Request], mutable res: ref[Response])
{
    var sum parse_int_prefix(req.query_param("a")) + parse_int_prefix(req.query_param("b"))
    if req.body.length > 0
        set sum: sum + parse_int_prefix(trim(req.body))
    res.send_int(sum)
}

procedure pipeline(req: ref[Request], mutable res: ref[Response])
    res.send_text("ok")

procedure delay(req: ref[Request], mutable res: ref[Response])
{
    let ms parse_int_prefix(req.param("ms"))
    if ms > 0
        Scheduler.sleep(ms)
    res.send_int(ms)
}

procedure json_items(req: ref[Request], mutable res: ref[Response]) mutable gzip_compressor
{
    let items dataset
    if items = null
    {
        res.set_status(500)
        res.send_empty()
        return
    }
    var count parse_int_prefix(req.param("count"))
    if count < 0
        set count: 0
    if count > (items.length as i64)
        set count: items.length as i64
    var m: i64 1
    let m_text req.query_param("m")
    if m_text.length > 0
        set m: parse_int_prefix(m_text)
    var w JsonWriter()
    w.begin_object()
    w.key("items")
    w.begin_array()
    var i: i64 0
    while i < count
    {
        let it items.at(i as size_t)
        w.begin_object()
        w.key("id")
        w.integer(it.id)
        w.key("name")
        w.text(it.name.as_slice())
        w.key("category")
        w.text(it.category.as_slice())
        w.key("price")
        w.integer(it.price)
        w.key("quantity")
        w.integer(it.quantity)
        w.key("active")
        w.boolean(it.active)
        w.key("tags")
        w.begin_array()
        var t: size_t 0
        while t < it.tags.length
        {
            w.text(it.tags[t].as_slice())
            set t: t + 1
        }
        w.end_array()
        w.key("rating")
        w.begin_object()
        w.key("score")
        w.integer(it.score)
        w.key("count")
        w.integer(it.rating_count)
        w.end_object()
        w.key("total")
        w.integer(it.price * it.quantity * m)
        w.end_object()
        set i: i + 1
    }
    w.end_array()
    w.key("count")
    w.integer(count)
    w.end_object()
    let body w.bytes()
    ; level 1, as the json-comp profile asks; the compressed copy lives on
    ; this frame's page like the writer
    if req.accepts_encoding("gzip")
    {
        let bound gzip_bound(body.length)
        if bound > 0
        {
            var packed Vector[u8](bound)
            let n gzip_compress(body, packed.as_slice())
            if n > 0
            {
                res.send_encoded("application/json", "gzip", packed.as_slice().slice_to(n))
                return
            }
        }
    }
    res.send("application/json", body)
}

; Read and convert the dataset onto host; false when it cannot be read.
procedure load_dataset(host: ref[Page], path: String) returns bool mutable dataset
{
    let text File.read_to_string(path)
    let parsed JsonValue.parse(text.as_slice())
    if parsed.ok() = false
        return false
    let doc parsed.value
    let items &Array[Item]^host()
    var i: size_t 0
    while i < doc.length()
    {
        let v doc.item(i)
        let rating v.get("rating")
        let tags_v v.get("tags")
        var tags Vector[String]^host(tags_v.length())
        var t: size_t 0
        while t < tags_v.length()
        {
            tags.put(t, String^host(tags_v.item(t).as_string()))
            set t: t + 1
        }
        items.add(Item(v.get("id").as_i64(), String^host(v.get("name").as_string()), String^host(v.get("category").as_string()), v.get("price").as_i64(), v.get("quantity").as_i64(), v.get("active").as_bool(), tags, rating.get("score").as_i64(), rating.get("count").as_i64()))
        set i: i + 1
    }
    set dataset: items
    true
}

; The async-db statement, prepared once per pooled connection.
function items_sql() returns Slice[u8]
    "SELECT id, name, category, price, quantity, active, tags, rating_score, rating_count FROM items WHERE price BETWEEN $1 AND $2 LIMIT $3"

; An integer query parameter, `otherwise` when it is absent.
function query_int(req: ref[Request], name: Slice[u8], otherwise: i64) returns i64
{
    let text req.query_param(name)
    if text.length = 0
        return otherwise
    parse_int_prefix(text)
}

; The items priced between min and max, at most limit of them, as the json
; profile shapes them (without its total); the tags are the JSONB column's
; text, already JSON. No database, or an error: an empty list.
procedure async_db(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let min query_int(req, "min", 10)
    let max query_int(req, "max", 50)
    var limit query_int(req, "limit", 50)
    if limit < 1
        set limit: 1
    if limit > 50
        set limit: 50
    var w JsonWriter()
    w.begin_object()
    w.key("items")
    w.begin_array()
    var count: i64 0
    let got acquire()
    if got <> null
    {
        var c got as ref[PgConn]
        if c.prepare("items", items_sql())
        {
            c.start("items")
            c.param_int(min)
            c.param_int(max)
            c.param_int(limit)
            if c.run()
            {
                while c.next_row()
                {
                    w.begin_object()
                    w.key("id")
                    w.integer(c.column_int(0))
                    w.key("name")
                    w.text(c.column(1))
                    w.key("category")
                    w.text(c.column(2))
                    w.key("price")
                    w.integer(c.column_int(3))
                    w.key("quantity")
                    w.integer(c.column_int(4))
                    w.key("active")
                    w.boolean(c.column_bool(5))
                    w.key("tags")
                    w.raw(c.column(6))
                    w.key("rating")
                    w.begin_object()
                    w.key("score")
                    w.integer(c.column_int(7))
                    w.key("count")
                    w.integer(c.column_int(8))
                    w.end_object()
                    w.end_object()
                    set count: count + 1
                }
            }
        }
        release(c)
    }
    w.end_array()
    w.key("count")
    w.integer(count)
    w.end_object()
    res.send("application/json", w.bytes())
}

; Does message a sort before message b (bytes, which for UTF-8 is code
; point order)?
function sorts_before(a: Slice[u8], b: Slice[u8]) returns bool
{
    var i: size_t 0
    while i < a.length and i < b.length
    {
        if a[i] <> b[i]
            return a[i] < b[i]
        set i: i + 1
    }
    a.length < b.length
}

; s into out with &, <, >, " and ' escaped for HTML.
procedure append_escaped(mutable out: ref[ByteBuf], s: Slice[u8])
{
    var from: size_t 0
    var i: size_t 0
    while i < s.length
    {
        let c s[i]
        if c = 38 or c = 60 or c = 62 or c = 34 or c = 39
        {
            out.append(s.subslice(from, i))
            match c
                case 38: out.append("&amp;")
                case 60: out.append("&lt;")
                case 62: out.append("&gt;")
                case 34: out.append("&quot;")
                case 39: out.append("&#39;")
            set from: i + 1
        }
        set i: i + 1
    }
    out.append(s.slice_from(from))
}

; The fortune table plus one row added here, sorted by message, rendered
; with every message escaped — the TechEmpower Fortunes page.
procedure fortunes(req: ref[Request], mutable res: ref[Response]) mutable pg_pool
{
    let got acquire()
    if got = null
    {
        res.set_status(500)
        res.send_empty()
        return
    }
    var c got as ref[PgConn]
    var ok c.prepare("fortunes", "SELECT id, message FROM fortune")
    if ok
    {
        c.start("fortunes")
        set ok: c.run()
    }
    if ok = false
    {
        release(c)
        res.set_status(500)
        res.send_empty()
        return
    }
    let host Page.allocate_page()
    var ids Array[i64]^host()
    var messages Array[Slice[u8]]^host()
    while c.next_row()
    {
        ids.add(c.column_int(0))
        messages.add(c.column(1))
    }
    ids.add(0)
    messages.add("Additional fortune added at request time.")
    ; insertion sort of an index: two hundred rows, mostly in id order
    let n ids.length
    var order Array[size_t]^host()
    var i: size_t 0
    while i < n
    {
        var j i
        order.add(i)
        while j > 0 and sorts_before(messages.at(i), messages.at(order.at(j - 1)))
        {
            order.put(j, order.at(j - 1))
            set j: j - 1
        }
        order.put(j, i)
        set i: i + 1
    }
    var out ByteBuf.create(host, 32768)
    out.append("<!DOCTYPE html><html><head><title>Fortunes</title></head><body><table><tr><th>id</th><th>message</th></tr>")
    set i: 0
    while i < n
    {
        let k order.at(i)
        out.append("<tr><td>")
        out.append_int(ids.at(k))
        out.append("</td><td>")
        append_escaped(&out, messages.at(k))
        out.append("</td></tr>")
        set i: i + 1
    }
    out.append("</table></body></html>")
    res.send("text/html; charset=utf-8", out.bytes())
    release(c)
    Page.release_page(host)
}

; A file of the mounted static directory (static-tls).
procedure static_file(req: ref[Request], mutable res: ref[Response]) mutable static_cache
    serve_file(req, res, "/data/static", req.param("path"))

; The body back as it came, Content-Length or chunked (8gbit).
procedure echo(req: ref[Request], mutable res: ref[Response])
    res.send("application/octet-stream", req.body)

; BenchmarkService/GetSum (unary-grpc): a + b.
procedure get_sum(req: ref[Request], mutable res: ref[Response])
{
    let msg grpc_message(req.body)
    var reply u8[24]
    let out Slice[u8](24, &reply[0])
    let n proto_put_varint(out, 0, 1, proto_varint(msg, 1) + proto_varint(msg, 2))
    grpc_reply(res, out.slice_to(n))
}

; Ends the server — registered only in the PGO training run (SCALY_ARENA_TRAIN
; set, tools/bench/http/train.scaly), whose profile is written at a clean exit.
procedure shutdown(req: ref[Request], mutable res: ref[Response])
{
    res.set_close()
    res.send_text("bye")
    TcpServer.current().shutdown()
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int mutable dataset
{
    var port 8080
    if argc > 1
        set port: parse_int_prefix(String(*(argv + 1)).as_slice()) as int
    var tls_port 8081
    if argc > 2
        set tls_port: parse_int_prefix(String(*(argv + 2)).as_slice()) as int
    var h2_port 8443
    if argc > 3
        set h2_port: parse_int_prefix(String(*(argv + 3)).as_slice()) as int
    var h2c_port 8082
    if argc > 4
        set h2c_port: parse_int_prefix(String(*(argv + 4)).as_slice()) as int
    let data_host Page.allocate_page()
    var path String("/data/dataset.json")
    let env_path getenv("DATASET_PATH")
    if env_path <> null
        set path: String(env_path)
    if load_dataset(data_host, path) = false
        print "arena: no dataset at `path` - /json answers 500"
    var app Router.create(Page.allocate_page())
    app.any("/baseline11", &baseline)
    app.get("/baseline2", &baseline)
    app.get("/pipeline", &pipeline)
    app.get("/delay/{ms}", &delay)
    app.get("/json/{count}", &json_items)
    app.get("/async-db", &async_db)
    app.get("/fortunes", &fortunes)
    app.get("/static/{path...}", &static_file)
    app.post("/echo", &echo)
    app.post("/benchmark.BenchmarkService/GetSum", &get_sum)
    if getenv("SCALY_ARENA_TRAIN") <> null
        app.get("/shutdown", &shutdown)
    var cert String("/certs/server.crt")
    var key String("/certs/server.key")
    let env_cert getenv("TLS_CERT")
    let env_key getenv("TLS_KEY")
    if env_cert <> null and env_key <> null
    {
        set cert: String(env_cert)
        set key: String(env_key)
    }
    let context TlsContext.server(cert, key)
    if context.valid()
    {
        let tl TcpListener.listen_any(tls_port)
        if tl.is_open()
            https.Server.start(app, tl, context)
        else
            print "arena: cannot listen on port `tls_port`"
    }
    var h2_context TlsContext.server(cert, key)
    if h2_context.valid()
    {
        h2_context.prefer_h2()
        let hl TcpListener.listen_any(h2_port)
        if hl.is_open()
            https.Server.start_h2(app, hl, h2_context)
        else
            print "arena: cannot listen on port `h2_port`"
    }
    let cl TcpListener.listen_any(h2c_port)
    if cl.is_open()
        start(app, cl)
    else
        print "arena: cannot listen on port `h2c_port`"
    if serve(app, port) = false
    {
        print "arena: cannot listen on port `port`"
        return 1
    }
    0
}
