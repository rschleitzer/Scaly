{
  "name": "scaly",
  "displayName": "Scaly",
  "description": "Scaly language support (LSP client for scalyls)",
  "version": "0.1.1",
  "publisher": "scaly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rschleitzer/Scaly.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:scaly"
  ],
  "contributes": {
    "languages": [
      {
        "id": "scaly",
        "aliases": [
          "Scaly",
          "scaly"
        ],
        "extensions": [
          ".scaly"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "scaly",
        "scopeName": "source.scaly",
        "path": "./syntaxes/scaly.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "scaly"
      }
    ],
    "commands": [
      {
        "command": "scaly.restartServer",
        "title": "Scaly: Restart Language Server"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Scaly",
      "properties": {
        "scaly.server.path": {
          "type": "string",
          "default": "scalyls",
          "description": "Path to the scalyls language server binary. Default 'scalyls' resolves it on PATH (the scaly.io installer's wrapper); falls back to ~/.scaly/bin/scalyls."
        },
        "scaly.home": {
          "type": "string",
          "default": "",
          "description": "SCALY_HOME passed to the server (prelude/packages search root). If empty, the first workspace folder is used."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --minify",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.4.0"
  }
}
