{
  "compilerOptions": {
    // node16 (not plain "commonjs"): vscode-languageclient 10 exposes its
    // subpaths through an "exports" map, which the classic "node" resolver
    // cannot read — `import ... from "vscode-languageclient/node"` then fails
    // with TS2307 even though the types are right there. Emitted output stays
    // CommonJS, which is what a VS Code extension host loads.
    "module": "node16",
    "target": "ES2020",
    "lib": ["ES2020"],
    "outDir": "out",
    "rootDir": "src",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["node_modules", "out"]
}
