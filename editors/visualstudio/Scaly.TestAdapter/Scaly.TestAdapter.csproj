<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <!-- The test platform loads adapters named *.TestAdapter.dll. -->
    <AssemblyName>Scaly.TestAdapter</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.TestPlatform.ObjectModel" Version="17.12.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
