; The model (web/model/index.html): a function as a colouring of the plane
; from -6 to 6, and the page moves its parameters -- or lets the program
; find them. Three models, the first ones of Machine Learning with Scaly:
;
;   0  f(x, y) = 1 - (x² + y²) / c, and -1 where that falls below -1:
;      the parameter c
;   1  the neuron z = w1 x + w2 y + b, its guess the sign of z (orange
;      where z > 0, blue where z < 0), and points to guess -- the six of
;      the chapter, or those the reader put down
;   2  the same neuron answering a = tanh(z), and learning: a step of
;      gradient descent moves w1, w2 and b a little towards a smaller loss
;      over the points
;   3  the same, given x² and y² for its inputs instead of x and y
;   4  a network: three hidden neurons and an output that reads them,
;      learning by backpropagation (its numbers in `net`, not the page's)
;
; The program keeps what the page shows in ONE vector of numbers, the
; board, and says before its loop where the board lies in its memory; the
; page reads it straight out of that memory and writes into the board's
; head, where the program finds it on its next round.
;
; The head of the board, what the page writes:
;
;    0  a counter the page raises after it wrote slots 1 to 4
;    1  which model, 0 to 4
;    2  c, or w1, w2 and b in 2, 3 and 4 (for models 2 and 3 where to
;       begin)
;    5  1 while model 2 or 3 learns, 0 while it waits
;    6  a counter: raised, model 2 or 3 takes one step while it waits
;    7  the learning rate
;    8  a counter the page raises after it wrote the points
;    9  how many points there are, at most MAXP
;
; and what the program writes:
;
;   32  the counter of slot 0 it has taken in
;   33  a counter raised with each picture
;   35  w1, w2 and b of model 2 or 3 as it has learned them, in 35 to 37
;   38  its loss over the points
;   39  how many steps it has taken
;   40  why it stopped learning by itself: 0 not, 1 the goal, 2 no headway
;       (`finished`); 0 again once the page lets it learn anew
;   41  model 4's thirteen numbers as it has learned them (`network`)
;
; From slot 64 on the picture, SIZE x SIZE numbers between -1 and 1, row
; by row from the top, which the program writes; after it the points,
; four numbers each: x, y and the kind (+1 orange, -1 blue), which the
; page writes, and what the model guesses there (+1 or -1), which the
; program writes; after them, for model 4, what each hidden neuron answers
; over the plane, TILE x TILE numbers each.

define SIZE int 400
define HEAD int 64
define POINTS int 160064     ; HEAD + SIZE * SIZE
define MAXP int 100
define TILES int 160464      ; POINTS + 4 * MAXP
define TILE int 96
define BOARD int 188112      ; TILES + 3 * TILE * TILE
define NET int 13            ; model 4's numbers

; A point of the plane and its kind, +1 orange or -1 blue.
define Point(x: f64, y: f64, kind: f64)

; --- the models: what the page shows of this program, each between its
; two marker lines (index.html cuts it out of this file) -----------------

; >> quadratic
; The model made up by hand: +1 in the middle, 0 on the circle x² + y² = c,
; and less further out -- but never less than -1.
function quadratic(x: f64, y: f64, c: f64) returns f64
{
    let f 1.0 - (x * x + y * y) / c
    if f < 0.0 - 1.0: 0.0 - 1.0 else f
}
; <<

; >> neuron
; A neuron: its inputs, each times its weight, plus its bias. Its guess is
; the sign of the sum: orange where it is positive, blue where negative.
function neuron(x: f64, y: f64, w1: f64, w2: f64, b: f64) returns f64
{
    w1 * x + w2 * y + b
}
; <<

; >> descent
; The neuron's two inputs at a point: x and y, or their squares.
function inputs(p: Point, squared: bool) returns (f64, f64)
{
    if squared: (p.x * p.x, p.y * p.y) else (p.x, p.y)
}

; The loss over the first n points: for each the neuron's answer
; a = tanh(z) and half the square of how far it is from the point's kind,
; and of these the mean.
function loss(points: Vector[Point], n: int, squared: bool, w1: f64, w2: f64, b: f64) returns f64
{
    var sum 0.0
    var k 0
    while k < n
    {
        let p points[k]
        let (u, v) inputs(p, squared)
        let a tanh(w1 * u + w2 * v + b)
        sum := sum + 0.5 * (a - p.kind) * (a - p.kind)
        k := k + 1
    }
    if n = 0: 0.0 else sum / (n as f64)
}

; One step of gradient descent: for each point what each of the three
; values adds to the loss -- by the chain rule, (a - t)(1 - a²) times the
; input the value multiplies --, of these the mean, and each value moved a
; little against it.
function step(points: Vector[Point], n: int, squared: bool, w1: f64, w2: f64, b: f64, rate: f64) returns (f64, f64, f64)
{
    if n = 0
        return (w1, w2, b)
    var g1 0.0
    var g2 0.0
    var gb 0.0
    var k 0
    while k < n
    {
        let p points[k]
        let (u, v) inputs(p, squared)
        let a tanh(w1 * u + w2 * v + b)
        let d (a - p.kind) * (1.0 - a * a)
        g1 := g1 + d * u
        g2 := g2 + d * v
        gb := gb + d
        k := k + 1
    }
    let m n as f64
    (w1 - rate * g1 / m, w2 - rate * g2 / m, b - rate * gb / m)
}

; When learning ends by itself: when the loss is below 0.02, the goal (1),
; or when after a hundred steps it has fallen by less than 0.0001 since
; the hundred before, no headway (2); else not yet (0).
function finished(loss: f64, hundred_before: f64, steps: int) returns int
{
    if loss < 0.02
        return 1
    if steps % 100 = 0 and hundred_before - loss < 0.0001
        return 2
    0
}
; <<

; >> network
; A small network: three hidden neurons, each with a line of its own through
; the plane, answering h = tanh(w1 x + w2 y + c); and an output neuron that
; reads their answers, a = tanh(v1 h1 + v2 h2 + v3 h3 + b). Its thirteen
; numbers stand in `net`: w1, w2 and c of each hidden neuron, then v1, v2,
; v3 and b.
function hidden(net: Vector[f64], j: int, x: f64, y: f64) returns f64
{
    tanh(net[3 * j] * x + net[3 * j + 1] * y + net[3 * j + 2])
}

function network(net: Vector[f64], x: f64, y: f64) returns f64
{
    var z net[12]
    var j 0
    while j < 3
    {
        z := z + net[9 + j] * hidden(net, j, x, y)
        j := j + 1
    }
    tanh(z)
}
; <<

; The network's loss over the first n points.
function network_loss(net: Vector[f64], points: Vector[Point], n: int) returns f64
{
    var sum 0.0
    var k 0
    while k < n
    {
        let p points[k]
        let a network(net, p.x, p.y)
        sum := sum + 0.5 * (a - p.kind) * (a - p.kind)
        k := k + 1
    }
    if n = 0: 0.0 else sum / (n as f64)
}

; One step of gradient descent for the network, by backpropagation: for each
; point the output's share of the error, d = (a - t)(1 - a²), and from it
; each hidden neuron's, d v_j (1 - h_j²); each number moved a little against
; the mean of what it adds to the loss.
procedure network_step(mutable net: Vector[f64], mutable grad: Vector[f64], points: Vector[Point], n: int,
                       rate: f64)
{
    if n = 0
        return
    var i 0
    while i < NET
    {
        grad.put(i, 0.0)
        i := i + 1
    }
    var h Vector[f64](3)
    var k 0
    while k < n
    {
        let p points[k]
        var z net[12]
        var j 0
        while j < 3
        {
            h.put(j, hidden(net, j, p.x, p.y))
            z := z + net[9 + j] * h[j]
            j := j + 1
        }
        let a tanh(z)
        let d (a - p.kind) * (1.0 - a * a)
        grad.put(12, grad[12] + d)
        j := 0
        while j < 3
        {
            grad.put(9 + j, grad[9 + j] + d * h[j])
            let dj d * net[9 + j] * (1.0 - h[j] * h[j])
            grad.put(3 * j, grad[3 * j] + dj * p.x)
            grad.put(3 * j + 1, grad[3 * j + 1] + dj * p.y)
            grad.put(3 * j + 2, grad[3 * j + 2] + dj)
            j := j + 1
        }
        k := k + 1
    }
    i := 0
    while i < NET
    {
        net.put(i, net[i] - rate * grad[i] / (n as f64))
        i := i + 1
    }
}

; Where model 4 begins: small weights, each hidden neuron another, so that
; they do not learn alike.
procedure begin_network(mutable net: Vector[f64])
{
    net.put(0, 0.5)
    net.put(1, 0.0 - 0.4)
    net.put(2, 0.0)
    net.put(3, 0.3)
    net.put(4, 0.8)
    net.put(5, 0.0)
    net.put(6, 0.0 - 0.7)
    net.put(7, 0.2)
    net.put(8, 0.0)
    net.put(9, 0.3)
    net.put(10, 0.1)
    net.put(11, 0.0 - 0.1)
    net.put(12, 0.0)
}

; --- the picture ---------------------------------------------------------

; Where cell k of SIZE lies on the plane, from -6 to 6.
function place(k: int) returns f64
{
    ((k as f64) + 0.5) * 12.0 / (SIZE as f64) - 6.0
}

; The neuron's guess at (x, y) for the picture: +1 or -1 by the sign of z,
; and between them across the width of one point of the picture, where the
; line z = 0 runs.
function guess(x: f64, y: f64, w1: f64, w2: f64, b: f64) returns f64
{
    let z neuron(x, y, w1, w2, b)
    let slope (w1 * w1 + w2 * w2).sqrt() * 12.0 / (SIZE as f64)
    if slope = 0.0
        return if z > 0.0: 1.0 else if z < 0.0: 0.0 - 1.0 else 0.0
    let v z / slope
    if v > 1.0: 1.0 else if v < 0.0 - 1.0: 0.0 - 1.0 else v
}

function model(which: int, x: f64, y: f64, a: f64, b: f64, c: f64, net: Vector[f64]) returns f64
{
    if which = 4
        return network(net, x, y)
    if which = 3
        return tanh(neuron(x * x, y * y, a, b, c))
    if which = 2
        return tanh(neuron(x, y, a, b, c))
    if which = 1
        return guess(x, y, a, b, c)
    quadratic(x, y, a)
}

; The picture, into the board: a round of the `for` for each of its points,
; on all cores.
procedure picture(mutable board: Vector[f64], which: int, a: f64, b: f64, c: f64, net: Vector[f64])
{
    for p in SIZE * SIZE
        board.put(HEAD + p, model(which, place(p % SIZE), 0.0 - place(p / SIZE), a, b, c, net))
}

; Where cell k of TILE lies on the plane, from -6 to 6.
function tile_place(k: int) returns f64
{
    ((k as f64) + 0.5) * 12.0 / (TILE as f64) - 6.0
}

; What each of model 4's hidden neurons answers over the plane, into the board.
procedure tiles(mutable board: Vector[f64], net: Vector[f64])
{
    var j 0
    while j < 3
    {
        let base TILES + j * TILE * TILE
        for q in TILE * TILE
            board.put(base + q, hidden(net, j, tile_place(q % TILE), 0.0 - tile_place(q / TILE)))
        j := j + 1
    }
}

; The points the page put into the board, into `points`; answers how many.
procedure take_points(mutable points: Vector[Point], board: Vector[f64]) returns int
{
    var n board[9] as int
    if n < 0
        n := 0
    if n > MAXP
        n := MAXP
    var k 0
    while k < n
    {
        points.put(k, Point(board[POINTS + 4 * k], board[POINTS + 4 * k + 1], board[POINTS + 4 * k + 2]))
        k := k + 1
    }
    n
}

; What the model guesses at each point, into the board.
procedure guesses(mutable board: Vector[f64], points: Vector[Point], n: int, which: int, w1: f64, w2: f64,
                  b: f64, net: Vector[f64])
{
    var k 0
    while k < n
    {
        let (u, v) inputs(points[k], which = 3)
        let z if which = 4: network(net, points[k].x, points[k].y) else neuron(u, v, w1, w2, b)
        board.put(POINTS + 4 * k + 3, if z > 0.0: 1.0 else if z < 0.0: 0.0 - 1.0 else 0.0)
        k := k + 1
    }
}

; The loss of a learning model (2, 3 or 4) as it stands.
function model_loss(which: int, points: Vector[Point], n: int, w1: f64, w2: f64, b: f64, net: Vector[f64]) returns f64
{
    if which = 4: network_loss(net, points, n) else loss(points, n, which = 3, w1, w2, b)
}

; A learning model as it stands, into the board.
procedure learned(mutable board: Vector[f64], points: Vector[Point], n: int, which: int, w1: f64, w2: f64,
                  b: f64, net: Vector[f64], steps: int)
{
    board.put(35, w1)
    board.put(36, w2)
    board.put(37, b)
    var i 0
    while i < NET
    {
        board.put(41 + i, net[i])
        i := i + 1
    }
    board.put(38, model_loss(which, points, n, w1, w2, b, net))
    board.put(39, steps as f64)
}

; --- the run -------------------------------------------------------------

var board Vector[f64](BOARD)
var k 0
while k < BOARD
{
    board.put(k, 0.0)
    k := k + 1
}
board.put(2, 36.0)
board.put(7, 0.1)
print "board at `board.as_bytes().data as size_t`"
var points Vector[Point](MAXP)
var net Vector[f64](NET)
var grad Vector[f64](NET)
begin_network(net)
var n 0
var taken 0.0 - 1.0
var placed 0.0
var stepped 0.0
var which 0
var a 0.0
var b 0.0
var c 0.0
var steps 0
var since 0                  ; steps since learning began anew
var before 0.0               ; the loss a hundred steps before, or where it began
var ended 0                  ; why learning stopped by itself (finished), 0 while it may go on
var wanted 0.0               ; what slot 5 said last
repeat
{
    var change false
    if board[0] <> taken
    {
        taken := board[0]
        which := board[1] as int
        a := board[2]
        b := board[3]
        c := board[4]
        if which = 0 and a < 0.1
            a := 0.1
        if which = 4
            begin_network(net)
        steps := 0
        since := 0
        before := model_loss(which, points, n, a, b, c, net)
        ended := 0
        board.put(40, 0.0)
        change := true
    }
    ; the points the reader put down or took away; model 2 learns on from where it stands
    if board[8] <> placed
    {
        placed := board[8]
        n := take_points(points, board)
        ; new points: the loss is another, and learning may go on from here
        since := 0
        before := model_loss(which, points, n, a, b, c, net)
        ended := 0
        board.put(40, 0.0)
        change := true
    }
    ; models 2 and 3 learn while the page says so, or take the one step it asked for
    let squared which = 3
    var go false
    if which >= 2
    {
        ; the page lets it learn anew: it goes on until it ends by itself again
        if board[5] > 0.5 and wanted < 0.5
        {
            since := 0
            before := model_loss(which, points, n, a, b, c, net)
            ended := 0
            board.put(40, 0.0)
        }
        wanted := board[5]
        if board[5] > 0.5 and ended = 0
            go := true
        else if board[6] <> stepped
            go := true
        stepped := board[6]
    }
    if go
    {
        if which = 4
            network_step(net, grad, points, n, board[7])
        else
        {
            let (w1, w2, w0) step(points, n, squared, a, b, c, board[7])
            a := w1
            b := w2
            c := w0
        }
        steps := steps + 1
        since := since + 1
        if board[5] > 0.5
        {
            let now model_loss(which, points, n, a, b, c, net)
            ended := finished(now, before, since)
            if since % 100 = 0
                before := now
            board.put(40, ended as f64)
        }
        change := true
    }
    if change
    {
        if which >= 2
            learned(board, points, n, which, a, b, c, net, steps)
        picture(board, which, a, b, c, net)
        if which = 4
            tiles(board, net)
        if which > 0
            guesses(board, points, n, which, a, b, c, net)
        board.put(32, taken)
        board.put(33, board[33] + 1.0)
    }
    Scheduler.sleep(if go: 40 else 10)
}
