; The model (web/model/index.html): a function as a colouring of the plane
; from -6 to 6, and the page moves its parameters -- or lets the program
; find them. Three models, the first ones of Machine Learning with Scaly:
;
;   0  f(x, y) = cos(pi (x² + y²) / c)          the parameter c
;   1  the neuron z = w1 x + w2 y + b, its guess the sign of z (orange
;      where z > 0, blue where z < 0), and six points to guess
;   2  the same neuron answering a = tanh(z), and learning: a step of
;      gradient descent moves w1, w2 and b a little towards a smaller loss
;      over the six points
;
; The program keeps what the page shows in ONE vector of numbers, the
; board, and says before its loop where the board lies in its memory; the
; page reads it straight out of that memory and writes into the board's
; head, where the program finds it on its next round.
;
; The head of the board, what the page writes:
;
;    0  a counter the page raises after it wrote slots 1 to 4
;    1  which model, 0, 1 or 2
;    2  c, or w1, w2 and b in 2, 3 and 4 (for model 2 where to begin)
;    5  1 while model 2 learns, 0 while it waits
;    6  a counter: raised, model 2 takes one step while it waits
;    7  the learning rate
;
; and what the program writes:
;
;   32  the counter of slot 0 it has taken in
;   33  a counter raised with each picture
;   34  how many points there are (6 for the neurons, else 0)
;   35  w1, w2 and b of model 2 as it has learned them, in 35, 36 and 37
;   38  the loss of model 2 over the six points
;   39  how many steps model 2 has taken
;   40  the points, four numbers each: x, y, the kind (+1 orange, -1
;       blue) and what the model guesses there (+1 or -1)
;
; From slot 64 on the picture, SIZE x SIZE numbers between -1 and 1, row
; by row from the top.

define SIZE int 400
define HEAD int 64
define BOARD int 160064      ; HEAD + SIZE * SIZE
define POINTS int 40

; The six points of the chapter: the first three orange (+1), the others
; blue (-1).
function point_x(k: int) returns f64
{
    if k = 0: 2.0 else if k = 1: 1.0 else if k = 2: 0.5 else if k = 3: 0.0 - 2.0 else if k = 4: 0.0 - 1.0 else 0.0 - 3.0
}

function point_y(k: int) returns f64
{
    if k = 0: 1.5 else if k = 1: 3.0 else if k = 2: 0.0 - 2.5 else if k = 3: 0.0 - 1.0 else if k = 4: 0.0 - 3.0 else 1.0
}

function kind(k: int) returns f64
{
    if k < 3: 1.0 else 0.0 - 1.0
}

; --- the models: what the page shows of this program, each between its
; two marker lines (index.html cuts it out of this file) -----------------

; >> cosine
; The model made up by hand: +1 in the middle, -1 further out, and c says
; how far.
function cosine(x: f64, y: f64, c: f64) returns f64
{
    cos(3.141592653589793 * (x * x + y * y) / c)
}
; <<

; >> neuron
; A neuron: its inputs, each times its weight, plus its bias. Its guess is
; the sign of the sum: orange where it is positive, blue where negative.
function neuron(x: f64, y: f64, w1: f64, w2: f64, b: f64) returns f64
{
    w1 * x + w2 * y + b
}
; <<

; >> descent
; The loss over the six points: for each the neuron's answer a = tanh(z)
; and half the square of how far it is from the point's kind, and of these
; the mean.
function loss(w1: f64, w2: f64, b: f64) returns f64
{
    var sum 0.0
    var k 0
    while k < 6
    {
        let a tanh(w1 * point_x(k) + w2 * point_y(k) + b)
        sum := sum + 0.5 * (a - kind(k)) * (a - kind(k))
        k := k + 1
    }
    sum / 6.0
}

; One step of gradient descent: for each point what each of the three
; values adds to the loss -- by the chain rule, (a - t)(1 - a²) times the
; input the value multiplies --, of these the mean, and each value moved a
; little against it.
function step(w1: f64, w2: f64, b: f64, rate: f64) returns (f64, f64, f64)
{
    var g1 0.0
    var g2 0.0
    var gb 0.0
    var k 0
    while k < 6
    {
        let x point_x(k)
        let y point_y(k)
        let a tanh(w1 * x + w2 * y + b)
        let d (a - kind(k)) * (1.0 - a * a)
        g1 := g1 + d * x
        g2 := g2 + d * y
        gb := gb + d
        k := k + 1
    }
    (w1 - rate * g1 / 6.0, w2 - rate * g2 / 6.0, b - rate * gb / 6.0)
}
; <<

; --- the picture ---------------------------------------------------------

; Where cell k of SIZE lies on the plane, from -6 to 6.
function place(k: int) returns f64
{
    ((k as f64) + 0.5) * 12.0 / (SIZE as f64) - 6.0
}

; The neuron's guess at (x, y) for the picture: +1 or -1 by the sign of z,
; and between them across the width of one point of the picture, where the
; line z = 0 runs.
function guess(x: f64, y: f64, w1: f64, w2: f64, b: f64) returns f64
{
    let z neuron(x, y, w1, w2, b)
    let slope (w1 * w1 + w2 * w2).sqrt() * 12.0 / (SIZE as f64)
    if slope = 0.0
        return if z > 0.0: 1.0 else if z < 0.0: 0.0 - 1.0 else 0.0
    let v z / slope
    if v > 1.0: 1.0 else if v < 0.0 - 1.0: 0.0 - 1.0 else v
}

function model(which: int, x: f64, y: f64, a: f64, b: f64, c: f64) returns f64
{
    if which = 2
        return tanh(neuron(x, y, a, b, c))
    if which = 1
        return guess(x, y, a, b, c)
    cosine(x, y, a)
}

; The picture, into the board: a round of the `for` for each of its points,
; on all cores.
procedure picture(mutable board: Vector[f64], which: int, a: f64, b: f64, c: f64)
{
    for p in SIZE * SIZE
        board.put(HEAD + p, model(which, place(p % SIZE), 0.0 - place(p / SIZE), a, b, c))
}

; The six points, and what the neuron guesses at each.
procedure points(mutable board: Vector[f64], which: int, w1: f64, w2: f64, b: f64)
{
    if which = 0
    {
        board.put(34, 0.0)
        return
    }
    board.put(34, 6.0)
    var k 0
    while k < 6
    {
        let z neuron(point_x(k), point_y(k), w1, w2, b)
        board.put(POINTS + 4 * k, point_x(k))
        board.put(POINTS + 4 * k + 1, point_y(k))
        board.put(POINTS + 4 * k + 2, kind(k))
        board.put(POINTS + 4 * k + 3, if z > 0.0: 1.0 else if z < 0.0: 0.0 - 1.0 else 0.0)
        k := k + 1
    }
}

; Model 2 as it stands, into the board.
procedure learned(mutable board: Vector[f64], w1: f64, w2: f64, b: f64, steps: int)
{
    board.put(35, w1)
    board.put(36, w2)
    board.put(37, b)
    board.put(38, loss(w1, w2, b))
    board.put(39, steps as f64)
}

; --- the run -------------------------------------------------------------

var board Vector[f64](BOARD)
var k 0
while k < BOARD
{
    board.put(k, 0.0)
    k := k + 1
}
board.put(2, 72.0)
board.put(7, 0.1)
print "board at `board.as_bytes().data as size_t`"
var taken 0.0 - 1.0
var stepped 0.0
var which 0
var a 0.0
var b 0.0
var c 0.0
var steps 0
repeat
{
    var change false
    if board[0] <> taken
    {
        taken := board[0]
        which := board[1] as int
        a := board[2]
        b := board[3]
        c := board[4]
        if which = 0 and a < 0.1
            a := 0.1
        steps := 0
        change := true
    }
    ; model 2 learns while the page says so, or takes the one step it asked for
    var go false
    if which = 2
    {
        if board[5] > 0.5
            go := true
        else if board[6] <> stepped
            go := true
        stepped := board[6]
    }
    if go
    {
        let (w1, w2, w0) step(a, b, c, board[7])
        a := w1
        b := w2
        c := w0
        steps := steps + 1
        change := true
    }
    if change
    {
        if which = 2
            learned(board, a, b, c, steps)
        picture(board, which, a, b, c)
        points(board, which, a, b, c)
        board.put(32, taken)
        board.put(33, board[33] + 1.0)
    }
    Scheduler.sleep(if go: 40 else 10)
}
