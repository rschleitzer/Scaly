; A render farm: ONE program, and a plain `for`. The picture is a room lit
; by a lamp in its ceiling, a mirror ball and a glass ball in it, path
; traced: from the eye a ray goes into the room, bounces off what it meets,
; and what light it picks up on its way is the colour it brings back. Many
; rays per point, and the noise of each settles into the picture.
;
; The work is done in PASSES: the first sends SAMPLES rays through each
; point, and each pass after it as many as all before it together -- the
; picture is there at once, its noise halved with each pass. A pass is one
; loop over every point of the picture, and nothing in this program says
; where its rounds run: on this machine's cores, on its graphics card
; (built with --gpu), and on the helpers of this program (built with
; --cluster, the same program started with --scaly-helper elsewhere) --
; where they would end it sooner. A helper that goes has its stretch of
; points rendered by another, or here. After each pass the program shows
; the picture as it stands.
;
; The colour of every ray is rounded to a whole number of 1/4096ths before
; it is added, so a sum does not depend on the order of its parts: the
; picture comes out the same, bit for bit, wherever which point was
; rendered, and whatever helper fell out on the way.
;
; The rays are computed in 32-bit floating point, and the loop over the
; points is `relaxed`: built with --gpu, the program may hand it to a
; graphics card. Metal rounds as the processor does, and the picture stays
; the same bit for bit; a card under WebGPU rounds less strictly, and a
; point it rendered may differ in the last shade here and there.
;
;   RENDER_WIDTH, RENDER_HEIGHT, RENDER_PASSES, RENDER_SAMPLES
;                the picture: 256 x 192, 8 passes, the first of 4 rays a
;                point: 1020 rays in all
;
; What it says, a line each:
;
;   R <pass> <y> <colours>   row y of the picture after the pass, six hex
;                            digits a point
;   P <pass> <ms>            the pass is done, in ms milliseconds
;   C: image <hash>          every sum, hashed (FNV-1a)
;   C: done <ms> ms

function scaly_eio_now_ns() returns i64 extern
; every stream's buffer out (null: all of them) -- the picture is shown after
; each pass, so what the program printed goes out with it
procedure fflush(stream: pointer[void]) returns i32 extern
function sqrt(x: f64) returns f64 extern
function sqrtf(x: f32) returns f32 extern

; --- vectors -------------------------------------------------------------------
;
; The rays are computed in 32-bit floating point, which a graphics card
; has: where the program is built with --gpu, the loop over a tile's points
; may run on one (render#), and its numbers are those of a card's.

define Vec3
(
    x: f32
    y: f32
    z: f32
)

function plus(a: Vec3, b: Vec3) returns Vec3
    Vec3(a.x + b.x, a.y + b.y, a.z + b.z)

function minus(a: Vec3, b: Vec3) returns Vec3
    Vec3(a.x - b.x, a.y - b.y, a.z - b.z)

function times(a: Vec3, b: Vec3) returns Vec3
    Vec3(a.x * b.x, a.y * b.y, a.z * b.z)

function scaled(a: Vec3, k: f32) returns Vec3
    Vec3(a.x * k, a.y * k, a.z * k)

function dot(a: Vec3, b: Vec3) returns f32
    a.x * b.x + a.y * b.y + a.z * b.z

function cross(a: Vec3, b: Vec3) returns Vec3
    Vec3(a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z, a.x * b.y - a.y * b.x)

function unit(a: Vec3) returns Vec3
    scaled(a, 1.0 / sqrtf(dot(a, a)))

; the point at distance t along d from o
function along(o: Vec3, d: Vec3, t: f32) returns Vec3
    Vec3(o.x + d.x * t, o.y + d.y * t, o.z + d.z * t)

function reflected(d: Vec3, n: Vec3) returns Vec3
    minus(d, scaled(n, 2.0 * dot(d, n)))

; --- random numbers --------------------------------------------------------------

; A permuted congruential generator in 32 bits: the next state, and the
; number a state gives.
function next(s: u32) returns u32
    s * 747796405 + 2891336453

function mixed(s: u32) returns u32
{
    let w ((s >> ((s >> 28) + 4)) xor s) * 277803737
    (w >> 22) xor w
}

; A number in [0, 1) from a state.
function chance(s: u32) returns f32
    ((mixed(s) >> 8) as f32) / 16777216.0

; The first state of a ray: from the point, the pass and the ray within the
; pass -- the same wherever it is rendered.
function seed(point: i32, pass: i32, ray: i32) returns u32
    mixed(mixed(point as u32) + mixed((pass as u32) * 65536 + (ray as u32)))

; --- the room ----------------------------------------------------------------------

; It spans -1 to 1 across, 0 to 2 up and -1 to 1 in depth. Its front is a
; wall seen from within only: the eye looks in through it from in front, and
; what is inside sees a wall there, in a mirror too. The lamp is a square in
; the ceiling, LAMP to either side of its middle.
define LAMP f32 0.35
define NEAR f32 0.001
define DEPTH i32 6

function lamp() returns Vec3
    Vec3(15.0, 12.0, 7.0)

function mirror_ball() returns Vec3
    Vec3(-0.42, 0.4, -0.45)

function glass_ball() returns Vec3
    Vec3(0.45, 0.4, -0.02)

define BALL f32 0.4

; What a ray met: how far, of what, and the surface's normal there. The
; kinds: 0 nothing, 1 a white wall, 2 the red wall, 3 the green wall, 4 the
; lamp, 5 the mirror ball, 6 the glass ball.
define Hit
(
    t: f32
    kind: i32
    n: Vec3
)

function albedo(kind: i32) returns Vec3
{
    if kind = 2
        return Vec3(0.63, 0.065, 0.05)
    if kind = 3
        return Vec3(0.14, 0.45, 0.091)
    Vec3(0.725, 0.71, 0.68)
}

; Where a ray from o along d enters a ball, or -1.
function ball(o: Vec3, d: Vec3, c: Vec3) returns f32
{
    let oc minus(o, c)
    let b dot(oc, d)
    let disc b * b - (dot(oc, oc) - BALL * BALL)
    if disc < 0.0
        return -1.0
    let h sqrtf(disc)
    let t1 (0.0 - b) - h
    if t1 > NEAR
        return t1
    let t2 (0.0 - b) + h
    if t2 > NEAR: t2 else -1.0
}

function within(a: f32, low: f32, high: f32) returns bool
    a >= low and a <= high

; The first thing a ray meets.
function hit(o: Vec3, d: Vec3) returns Hit
{
    var t: f32 1000000.0
    var kind: i32 0
    var n Vec3(0.0, 0.0, 0.0)
    if d.x < 0.0
    {
        let s (-1.0 - o.x) / d.x
        let p along(o, d, s)
        if s > NEAR and within(p.y, 0.0, 2.0) and within(p.z, -1.0, 1.0)
        {
            t := s
            kind := 2
            n := Vec3(1.0, 0.0, 0.0)
        }
    }
    if d.x > 0.0
    {
        let s (1.0 - o.x) / d.x
        let p along(o, d, s)
        if s > NEAR and within(p.y, 0.0, 2.0) and within(p.z, -1.0, 1.0)
        {
            t := s
            kind := 3
            n := Vec3(-1.0, 0.0, 0.0)
        }
    }
    if d.y < 0.0
    {
        let s (0.0 - o.y) / d.y
        let p along(o, d, s)
        if s > NEAR and s < t and within(p.x, -1.0, 1.0) and within(p.z, -1.0, 1.0)
        {
            t := s
            kind := 1
            n := Vec3(0.0, 1.0, 0.0)
        }
    }
    if d.y > 0.0
    {
        let s (2.0 - o.y) / d.y
        let p along(o, d, s)
        if s > NEAR and s < t and within(p.x, -1.0, 1.0) and within(p.z, -1.0, 1.0)
        {
            t := s
            kind := if within(p.x, -LAMP, LAMP) and within(p.z, -LAMP, LAMP): 4 else 1
            n := Vec3(0.0, -1.0, 0.0)
        }
    }
    if d.z < 0.0
    {
        let s (-1.0 - o.z) / d.z
        let p along(o, d, s)
        if s > NEAR and s < t and within(p.x, -1.0, 1.0) and within(p.y, 0.0, 2.0)
        {
            t := s
            kind := 1
            n := Vec3(0.0, 0.0, 1.0)
        }
    }
    ; the front, seen from within only: the eye looks in through it
    if d.z > 0.0 and o.z < 1.0
    {
        let s (1.0 - o.z) / d.z
        let p along(o, d, s)
        if s > NEAR and s < t and within(p.x, -1.0, 1.0) and within(p.y, 0.0, 2.0)
        {
            t := s
            kind := 1
            n := Vec3(0.0, 0.0, -1.0)
        }
    }
    let m ball(o, d, mirror_ball())
    if m > 0.0 and m < t
    {
        t := m
        kind := 5
        n := unit(minus(along(o, d, m), mirror_ball()))
    }
    let g ball(o, d, glass_ball())
    if g > 0.0 and g < t
    {
        t := g
        kind := 6
        n := unit(minus(along(o, d, g), glass_ball()))
    }
    Hit(t, kind, n)
}

; Whether a ball stands between o and the point at distance far along d.
function shadowed(o: Vec3, d: Vec3, far: f32) returns bool
{
    let m ball(o, d, mirror_ball())
    let g ball(o, d, glass_ball())
    m > 0.0 and m < far or g > 0.0 and g < far
}

; --- a ray -------------------------------------------------------------------------

; The light a ray from o along d brings back. At a wall it asks the lamp
; directly -- a point on it, chosen at random, unless a ball is in the way
; -- and then goes on in a direction chosen at random, more likely the
; steeper; a mirror turns it, glass turns it or lets it through, the more
; likely through the more head-on. Light seen straight off the lamp counts
; only where the lamp was not asked for it already.
function radiance(o0: Vec3, d0: Vec3, seed0: u32) returns Vec3
{
    var o o0
    var d d0
    var s seed0
    var through Vec3(1.0, 1.0, 1.0)
    var sum Vec3(0.0, 0.0, 0.0)
    var direct true
    var depth: i32 0
    while depth < DEPTH
    {
        let h hit(o, d)
        if h.kind = 0
            break
        if h.kind = 4
        {
            if direct
                sum := plus(sum, times(through, lamp()))
            break
        }
        let p along(o, d, h.t)
        if h.kind = 5
        {
            d := reflected(d, h.n)
            o := along(p, h.n, NEAR * 10.0)
            through := scaled(through, 0.9)
            direct := true
        }
        else
        {
            if h.kind = 6
            {
                let inside dot(d, h.n) > 0.0
                let n if inside: scaled(h.n, -1.0) else h.n
                let eta: f32 if inside: 1.5 else 0.6666667
                let ci 0.0 - dot(d, n)
                let k 1.0 - eta * eta * (1.0 - ci * ci)
                s := next(s)
                var turned true
                if k > 0.0
                {
                    let c if inside: sqrtf(k) else ci
                    let f 1.0 - c
                    let fresnel 0.04 + 0.96 * f * f * f * f * f
                    if chance(s) >= fresnel
                    {
                        turned := false
                        d := unit(plus(scaled(d, eta), scaled(n, eta * ci - sqrtf(k))))
                        o := along(p, n, 0.0 - NEAR * 10.0)
                    }
                }
                if turned
                {
                    d := reflected(d, n)
                    o := along(p, n, NEAR * 10.0)
                }
                direct := true
            }
            else
            {
                let a albedo(h.kind)
                let off along(p, h.n, NEAR * 10.0)
                ; the lamp, at a point of it
                s := next(s)
                let lx (2.0 * chance(s) - 1.0) * LAMP
                s := next(s)
                let lz (2.0 * chance(s) - 1.0) * LAMP
                let to minus(Vec3(lx, 2.0, lz), off)
                let far2 dot(to, to)
                let far sqrtf(far2)
                let wi scaled(to, 1.0 / far)
                let cs dot(wi, h.n)
                if cs > 0.0 and wi.y > 0.0 and shadowed(off, wi, far) = false
                {
                    let area 4.0 * LAMP * LAMP
                    sum := plus(sum, scaled(times(through, times(a, lamp())), cs * wi.y * area / (3.1415927 * far2)))
                }
                ; on, the steeper the likelier: a point of the unit disc,
                ; lifted onto the half sphere over the wall
                var u: f32 1.0
                var v: f32 1.0
                while u * u + v * v >= 1.0
                {
                    s := next(s)
                    u := 2.0 * chance(s) - 1.0
                    s := next(s)
                    v := 2.0 * chance(s) - 1.0
                }
                let w sqrtf(1.0 - u * u - v * v)
                let helper if h.n.x > 0.9 or h.n.x < -0.9: Vec3(0.0, 1.0, 0.0) else Vec3(1.0, 0.0, 0.0)
                let tu unit(cross(helper, h.n))
                let tv cross(h.n, tu)
                d := plus(plus(scaled(tu, u), scaled(tv, v)), scaled(h.n, w))
                o := off
                through := times(through, a)
                direct := false
            }
        }
        depth := depth + 1
    }
    sum
}

; A colour as whole 1/4096ths, at most 2: brighter only the lamp is, and
; the picture shows it white anyway -- a ray that found it the rare way, over
; a wall and a ball, would otherwise stand out as a speck.
function whole(x: f32) returns i32
{
    if x <= 0.0
        return 0
    if x >= 2.0
        return 8192
    (x * 4096.0) as i32
}

; The sums of one pass at one point of the picture: `rays` rays through
; places within it.
function point(x: i32, y: i32, w: i32, h: i32, pass: i32, rays: i32) returns (r: i32, g: i32, b: i32)
{
    ; the eye in front of the open side, as far off as it sees the room
    ; whole: the picture's edges just inside the opening, no frame of
    ; darkness round it
    let eye: f32 2.6
    let reach 0.97 / (eye - 1.0)
    let aspect (w as f32) / (h as f32)
    let tan if aspect > 1.0: reach / aspect else reach
    var r: i32 0
    var g: i32 0
    var b: i32 0
    var k: i32 0
    while k < rays
    {
        var s seed(y * w + x, pass, k)
        s := next(s)
        let jx chance(s)
        s := next(s)
        let jy chance(s)
        let u (2.0 * ((x as f32) + jx) / (w as f32) - 1.0) * aspect * tan
        let v (1.0 - 2.0 * ((y as f32) + jy) / (h as f32)) * tan
        let c radiance(Vec3(0.0, 1.1, eye), unit(Vec3(u, v, -1.0)), next(s))
        r := r + whole(c.x)
        g := g + whole(c.y)
        b := b + whole(c.z)
        k := k + 1
    }
    (r: r, g: g, b: b)
}

; --- the passes ----------------------------------------------------------------------

function parse_int(s: pointer[const_char]) returns int
{
    if s = null
        return 0 - 1
    var v 0
    var any false
    var i 0 as size_t
    repeat
    {
        let c s[i] as int
        if c < 48 or c > 57
            break
        v := v * 10 + (c - 48)
        any := true
        i := i + (1 as size_t)
    }
    if any: v else 0 - 1
}

procedure env_int(name: pointer[const_char], dflt: int) returns int
{
    let v parse_int(getenv(name))
    if v < 0: dflt else v
}

; One pass over the picture: every point's sums of `rays` rays, red, green
; and blue. The loop is the program's only parallel one, and a plain `for`.
procedure render(w: int, h: int, pass: int, rays: int, mutable rs: Vector[i32], mutable gs: Vector[i32], mutable bs: Vector[i32])
{
    let wi w as i32
    let hi h as i32
    let p pass as i32
    let r rays as i32
    relaxed for i in w * h
    {
        ; a card under WebGPU has no 64-bit integers: the counter as i32
        let k i as i32
        let c point(k % wi, k / wi, wi, hi, p, r)
        rs.put(i as size_t, c.r)
        gs.put(i as size_t, c.g)
        bs.put(i as size_t, c.b)
    }
}

function hex(d: int) returns char
    if d < 10: ((48 + d) as char) else ((87 + d) as char)

; A channel's sum over `rays` rays as a shade: the mean light, its square
; root (brighter where it is dim, as an eye sees), 0 to 255.
function shade(sum: i64, rays: int) returns int
{
    if rays = 0
        return 0
    let mean (sum as f64) / ((rays as f64) * 4096.0)
    if mean >= 1.0
        return 255
    (sqrt(mean) * 255.0 + 0.5) as int
}

; Add a pass into the picture and show it as it stands, row by row.
procedure take(w: int, h: int, pass: int, rays: int, mutable sums: Vector[i64], rs: Vector[i32], gs: Vector[i32], bs: Vector[i32])
{
    var y 0
    while y < h
    {
        var line StringBuilder()
        line.append "R `pass` `y` "
        var x 0
        while x < w
        {
            let i (y * w + x) as size_t
            let at i * 3
            sums.put(at, sums[at] + (rs[i] as i64))
            sums.put(at + 1, sums[at + 1] + (gs[i] as i64))
            sums.put(at + 2, sums[at + 2] + (bs[i] as i64))
            var c: size_t 0
            while c < 3
            {
                let v shade(sums[at + c], rays)
                line.append(hex(v / 16))
                line.append(hex(v % 16))
                c := c + 1
            }
            x := x + 1
        }
        let text line.to_string()
        print text
        y := y + 1
    }
}

let W env_int("RENDER_WIDTH", 256)
let H env_int("RENDER_HEIGHT", 192)
let PASSES env_int("RENDER_PASSES", 8)
let SAMPLES env_int("RENDER_SAMPLES", 4)
let N (W * H) as size_t

var sums Vector[i64](N * 3)
var rs Vector[i32](N)
var gs Vector[i32](N)
var bs Vector[i32](N)
let t0 scaly_eio_now_ns()
var rays 0
var pass 0
while pass < PASSES
{
    let p0 scaly_eio_now_ns()
    render(W, H, pass, SAMPLES << pass, rs, gs, bs)
    rays := rays + (SAMPLES << pass)
    take(W, H, pass, rays, sums, rs, gs, bs)
    print "P `pass` `(scaly_eio_now_ns() - p0) / 1000000`"
    fflush(null as pointer[void])
    pass := pass + 1
}
var hash: u64 0xCBF29CE484222325
var i: size_t 0
while i < sums.length
{
    hash := (hash xor (sums[i] as u64)) * 0x100000001B3
    i := i + 1
}
print "C: image `hash as size_t`"
print "C: done `(scaly_eio_now_ns() - t0) / 1000000` ms"
