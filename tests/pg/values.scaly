; The pg package's values against a live server (DATABASE_URL), on a
; temporary table of its own:
;   script    execute: three statements in one message and the rows of the
;             last; a failing script answers the server's message, and the
;             connection takes the next one
;   bytes     a BYTEA parameter holding every byte value comes back the same
;             through a binary column, between text columns of the same row
;   null      a NULL parameter reads as NULL, an empty text does not
;   rollback  BEGIN, an insert, ROLLBACK through execute: the row is gone
;   reason    PgConn.open on a port nothing listens on answers null and says
;             that the server was not reached
; Expected: script bytes null rollback reason

package scaly 0.1.0
package tls 0.1.0
package pg 0.2.0

use pg.Conn.PgConn

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int mutable pg_pool
{
    let got acquire()
    if got = null
    {
        print "no connection"
        return 1
    }
    var c got as ref[PgConn]
    if c.execute("CREATE TEMPORARY TABLE pg_values (id INT PRIMARY KEY, content BYTEA, note TEXT); INSERT INTO pg_values VALUES (1, NULL, 'one'); SELECT id, note FROM pg_values") = false
    {
        print "execute: `String(c.error_message().data as pointer[const_char], c.error_message().length)`"
        return 2
    }
    if c.next_row() = false or c.column_int(0) <> 1 or c.column(1).equals("one") = false
        return 3
    if c.execute("SELECT 1; SELECT x FROM pg_no_such_table") or c.error_message().length = 0
        return 4
    if c.execute("SELECT 2") = false or c.next_row() = false or c.column_int(0) <> 2
        return 5
    Console.print "script "

    var every u8[256]
    var i: size_t 0
    while i < 256
    {
        every[i] := i as u8
        i := i + 1
    }
    if c.prepare("put", "INSERT INTO pg_values VALUES ($1, $2, $3)") = false
        return 6
    c.start("put")
    c.param_int(2)
    c.param_bytes(Slice[u8](256, &every[0]))
    c.param_text("two")
    if c.run() = false or c.affected() <> 1
    {
        print "put: `String(c.error_message().data as pointer[const_char], c.error_message().length)`"
        return 7
    }
    if c.prepare("get", "SELECT id, content, note FROM pg_values WHERE id = $1") = false
        return 8
    c.start("get")
    c.param_int(2)
    c.binary_column(1)
    if c.run() = false or c.next_row() = false
        return 9
    let content c.column(1)
    if c.column_int(0) <> 2 or content.length <> 256 or c.column(2).equals("two") = false
    {
        print "content: `content.length` bytes"
        return 10
    }
    i := 0
    while i < 256
    {
        if content[i] <> (i as u8)
            return 11
        i := i + 1
    }
    Console.print "bytes "

    c.start("put")
    c.param_int(3)
    c.param_null()
    c.param_text("")
    if c.run() = false
        return 12
    c.start("get")
    c.param_int(3)
    c.binary_column(1)
    if c.run() = false or c.next_row() = false
        return 13
    if c.column_is_null(1) = false or c.column_is_null(2) or c.column_is_null(0)
        return 14
    Console.print "null "

    if c.execute("BEGIN") = false
        return 15
    c.start("put")
    c.param_int(4)
    c.param_null()
    c.param_text("four")
    if c.run() = false
        return 16
    if c.execute("ROLLBACK") = false
        return 17
    c.start("get")
    c.param_int(4)
    if c.run() = false or c.next_row()
        return 18
    Console.print "rollback "
    release(c)

    var why Array[u8]()
    var nowhere String("127.0.0.1")
    if PgConn.open(nowhere, 1, "u", "p", "d", &why) <> null or why.as_slice().equals("the server cannot be reached") = false
        return 19
    Console.print "reason"
    0
}
