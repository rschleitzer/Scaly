; Control for negp_union_field_store_by_value.scaly: the same union with a
; String built here, kept by the callee -- on the CALLER's page (`#`), which
; gives the routine that page by itself (the page used to be a declared `rp`
; parameter, 2026-09-25); the run reads it back intact under SCALY_POISON.
define Msg union
(
    Text: String
    Code: int
)
define Box (var host: ref[Page]  var kept: Msg)
{
    procedure keep(mutable this, m: Msg)
        kept := m
    ; reuse the released frame page so the dangling read is visible even
    ; without SCALY_POISON
    procedure churn(mutable this)
    {
        var junk Array[String]()
        var i 0
        while i < 2000
        {
            junk.add(String("yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy"))
            i := i + 1
        }
    }
    procedure work(mutable this)
    {
        var sb StringBuilder()
        sb.append "hello-from-work"
        let s String#(sb.to_string())
        let m Msg.Text(s)
        this.keep(m)
    }
}
if getenv("SCALY_POISON") <> null
    Page.enable_poison()
let root_anchor String("probe")
let host Page.get(root_anchor.get_buffer() as pointer[void])
var b Box(host, Msg.Code(0))
b.work()
b.churn()
choose b.kept
    when t: Text
        print t
    when c: Code
        print "code"
    else
        print "none"
print "\n"
