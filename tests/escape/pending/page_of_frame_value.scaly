; The deep gate's page-of rule: the callee takes the PAGE of its argument
; (`Page.get(out)`) and allocates on it. Handed the address of a frame value,
; that page is garbage — the address is on the stack, not on a page (opensp's
; parse_literal was the witness, 2026-09-22). The default checker accepts this;
; the gate must reject it. Control: ../posp_page_of_host_value.scaly. A variable
; of a PAGE-RESIDENT concept (`var a Array[T]()`) is exempt: the emitter hosts
; it on a page, so Page.get of it is valid.
define Box (var s: String)

procedure fill(mutable out: ref[Box])
{
    let pg Page.get(out)
    set out.s: String^pg("filled")
}

procedure make()
{
    var b Box(String())
    fill(&b)
    print b.s
}

make()
print "\n"
