; The deep gate's element rule (2026-09-23): a callee that keeps an ELEMENT of
; a container keeps what was put INTO the container, not its buffer. Here the
; element is a frame-local box, so keeping it escapes — the gate must say so
; although the container argument itself is never kept.
define Box (var v: int)
define Holder (var kept: ref[Box]?)

procedure keep_first(mutable h: ref[Holder], list: ref[Array[ref[Box]?]])
    set h.kept: list[0]

procedure make(mutable h: ref[Holder])
{
    let b &Box(1)
    let list &Array[ref[Box]?]()
    list.add(b)
    keep_first(h, list)
}

var h Holder(null)
make(&h)
print "done\n"
