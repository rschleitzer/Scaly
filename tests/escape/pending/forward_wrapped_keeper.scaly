; PENDING (README.md): accepted by the compiler at rc 0, prints FAIL.
;
; `fill` builds a String on its own page and puts it, wrapped in a record by a
; static that hands its argument back (`Maker.fact`), into the Array its
; parameter reaches. `outer` only forwards that parameter. The String must
; live as long as the Array -- on the page of `run` -- but it lives on a page
; that is gone when `outer` returns, and `run` reads it after a churn.
;
; Both halves are needed: calling `m.fill(&facts)` directly from `run`, or
; storing `Fact(1, String("fn"))` without the static, reads PASS. Found
; 2026-09-28 writing compiler/Interface.scaly: the Planner's facts took this
; shape and every interface came out without its routine headers.

define Fact
(
    tag: char
    kind: String
)

define Maker
(
    count: int
)
{
    function fact(tag: char, kind: String) returns Fact
        Fact(tag, kind)

    procedure fill(this, mutable facts: ref[Array[Fact]])
    {
        facts.add(Maker.fact("F" as char, String("fn")))
    }

    procedure outer(this, mutable facts: ref[Array[Fact]])
    {
        this.fill(facts)
    }
}

procedure churn() returns int
{
    var sb StringBuilder()
    var i 0
    while i < 200
    {
        sb.append "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
        set i: i + 1
    }
    sb.to_string().get_length() as int
}

procedure run() returns int
{
    var facts Array[Fact]()
    let m Maker(0)
    m.outer(&facts)
    churn()
    let f facts.at 0
    if f.kind.equals("fn")
        print "PASS\n"
    else
        print "FAIL\n"
    0
}

run()
