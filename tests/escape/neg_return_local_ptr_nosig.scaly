; ESCAPE (negative, NO-SIGIL): returning a pointer to a no-sigil frame-local
; object is a use-after-free once the local page is freed at function exit.
; With $ removed from the construction, the binding carries Unspecified life;
; escape soundness step 1 infers that &<frame-local> points into this frame
; (Local pointee) so the checker still REJECTS this. Mirrors neg_return_local_ptr.
define Box
(
    v: int
)

function leak() returns pointer[Box]
{
    let b Box(5)
    return &b
}

function main() returns int
{
    let p leak()
    return (*p).v
}
