; NEG: a METHOD returns a host record holding its parameter (`&Sig^host(params,
; …)`), and the caller stores the result (`set links.resolved: this.mk(p)`) —
; with `p` on the caller's LOCAL page. Rejected by the 2026-09-20 construction
; route. It sat in tests/escape/pending/ until 2026-09-22 with `^host` arguments,
; which are not local at all — the "hole" was the fixture, not the checker.
define Sig (var params: ref[Array[int]]?  var n: int)
define Link (var resolved: ref[Sig]?)
define Box (var host: ref[Page]  var count: int)
{
    procedure mk(mutable this, params: ref[Array[int]]) returns ref[Sig]?
    {
        count := count + 1
        let s &Sig^host(params, count)
        s
    }
    procedure fill(mutable this, mutable links: ref[Link])
    {
        let p &Array[int]()
        p.add(1)
        links.resolved := this.mk(p)
    }
    procedure fill2(mutable this, mutable links: ref[Link])
    {
        let q &Array[int]()
        q.add(2)
        let made this.mk(q)
        links.resolved := made
    }
}
let root_anchor String("probe")
let host Page.get(root_anchor.get_buffer() as pointer[void])
var b Box(host, 0)
var lk Link(null)
b.fill(&lk)
b.fill2(&lk)
print "done\n"
