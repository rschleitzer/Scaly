; ESCAPE (negative, TRANSITIVE Vector-3): the pass-to-storing-callee check made
; transitive. `forward` does NOT store its parameter — it only PASSES it on to
; `stash`, which stores it into the receiver's field. The direct check gives
; `forward` no summary record, so `forward(c, &bx)` would be silently accepted
; (the one known soundness hole). The forwarding fixpoint infers that `forward`
; persists its `p` parameter into `c`'s field (transitively through `stash`), so
; passing `&bx` (a frame-local) to it MUST be REJECTED ("escapes via call").
define Box
(
    v: int
)
define Holder
(
    var b: pointer[Box]
)
{
    procedure stash(this, p: pointer[Box])
        set this.b: p
}

; Pure forwarder: no store of its own, just relays p on to stash.
procedure forward(c: Holder, p: pointer[Box])
    c.stash(p)

procedure fill(c: Holder)
{
    let bx Box(5)
    forward(c, &bx)
}

function main() returns int
{
    return 0
}
