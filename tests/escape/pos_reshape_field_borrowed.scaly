; POS (FIELD reshape, borrowed field): same shape as neg_reshape_field_store,
; but pp's pointer field holds a PARAMETER pointer (bx), not a frame-local. The
; callee stores pp.a frame-external, but pp.a points to caller-owned memory, so
; it is safe. Guards the field check against over-rejection: the field-points-to
; map records only LOCAL-region fields, so pp.a (Caller-region) is unrecorded
; and region_of_arg_path resolves it SAFE. MUST compile.
define Box
(
    v: int
)
define Pair
(
    a: pointer[Box]
    b: pointer[Box]
)
define Sink
(
    var slot: pointer[Box]
)
{
    procedure stash(mutable this, pr: pointer[Pair])
        set this.slot: (*pr).a
}

procedure trigger(mutable sink: Sink, bx: pointer[Box])
{
    let pp Pair(bx, bx)
    sink.stash(&pp)
}

function main() returns int
{
    return 0
}
