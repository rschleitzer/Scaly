; Channel move checker: sending the same message binding twice must be
; rejected — the second send reads a binding whose region already moved.

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer()
{
    let c chan as pointer[Channel]
    let mp Page.allocate_page()
    let m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m.value: 7
    Channel.send(c, m as pointer[void])
    Channel.send(c, m as pointer[void])
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
producer()
