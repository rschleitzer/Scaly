; Mailbox move checker (milestone 2.4): reading the message binding
; after Mailbox.send must be rejected exactly like after Channel.send —
; ownership of the message region moved to the receiver, which may free
; it on another thread at any moment.

define Msg
(
    value: int
)

mutable mbox: pointer[void] null

procedure producer()
{
    let m mbox as pointer[Mailbox]
    let mp Page.allocate_page()
    let msg mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set msg.value: 7
    Mailbox.send(m, msg as pointer[void])
    let v msg.value
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let m Mailbox.create()
set mbox: m as pointer[void]
producer()
