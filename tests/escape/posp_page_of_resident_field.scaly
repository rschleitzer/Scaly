; The page-of rule's exemption reaches through FIELDS (2026-09-25): `Bag`
; holds an Array BY VALUE, and Array.add derives its page from the Array's
; own address after construction (`@inplace`), so `Bag` is page-resident
; itself (Planner.structure_fields_need_residency#) and `var b` is hosted on
; the frame's page. `Page.get(&b)` is that page and what `fill` builds on it
; lives as long as `b`. A String field does NOT do this -- its Page.get(this)
; is in its inits alone (negp_page_of_frame_value.scaly stays rejected).
; Accepted, and prints "2 filled" under SCALY_POISON=1.
define Bag (var items: Array[int], var note: String)

procedure fill(mutable out: ref[Bag])
{
    let pg Page.get(out)
    out.note := String^pg("filled")
    out.items.add(1)
    out.items.add(2)
}

procedure make()
{
    var b Bag(Array[int](), String())
    fill(&b)
    print "`b.items.length` `b.note`"
}

make()
print "\n"
