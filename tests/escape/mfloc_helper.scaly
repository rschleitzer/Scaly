; Helper module for the multi-file diagnostic-location regression (mfloc_main).
; Its leak() has a return-escape; the diagnostic MUST report THIS file, not the
; entry file (mfloc_main.scaly). Not a neg_/pos_ test — the runner globs those,
; so this file is only ever compiled transitively via `module mfloc_helper`.
define Box
(
    v: int
)

function leak() returns Box
{
    let b Box$(5)
    return b
}
