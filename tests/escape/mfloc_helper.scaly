; Helper module for the multi-file diagnostic-location regression (mfloc_main).
; leak() returns a POINTER into a local ($) page — a genuine dangle (the pointee
; stays local), rejected by BOTH compilers at line 13. The diagnostic MUST name
; THIS file, not the entry file. Not a neg_/pos_ test — the runner globs those.
define Box
(
    v: int
)

function leak() returns pointer[Box]
{
    let b Box$(5)
    return &b
}
