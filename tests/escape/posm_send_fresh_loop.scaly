; Channel move checker positive: the canonical producer pattern — a FRESH
; message binding per iteration, sent at the end of the body. The next
; iteration's `let` re-binds the name (new region), so nothing is used
; after its send. Must compile.

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer() mutable chan
{
    let c chan as pointer[Channel]
    var i 0
    while i < 3
    {
        let mp Page.allocate_page()
        let m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
        set m.value: i
        Channel.send(c, m as pointer[void])
        set i: i + 1
    }
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
producer()
