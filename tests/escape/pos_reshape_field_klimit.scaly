; POS (FIELD reshape, k=2 truncation on a recursive struct): the callee stores
; a DEPTH-2 field path (*pr).next.val of its parameter. The access path is
; k-limited to 2, and a path of length 2 resolves to Caller (SAFE) — the depth-1
; field-points-to map cannot prove the deeper field local without risking a
; false positive, so it never flags. Node is self-referential, exercising that
; path composition/truncation stays bounded (the fixpoint terminates). The
; caller passes a param-backed node, so nothing escapes. MUST compile.
define Box
(
    v: int
)
define Node
(
    next: pointer[Node]
    val: pointer[Box]
)
define Sink
(
    var slot: pointer[Box]
)
{
    procedure stash(mutable this, pr: pointer[Node])
        this.slot := (*pr).next.val
}

procedure trigger(mutable sink: Sink, n: pointer[Node])
{
    sink.stash(n)
}

function main() returns int
{
    return 0
}
