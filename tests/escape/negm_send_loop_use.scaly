; Channel move checker: a message bound OUTSIDE the loop and sent inside
; it is used again by the next iteration's read (wrap-around) — the loop
; body is re-walked once after a send, so this must be rejected.

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer()
{
    let c chan as pointer[Channel]
    let mp Page.allocate_page()
    let m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    var i 0
    while i < 2
    {
        set m.value: i
        Channel.send(c, m as pointer[void])
        set i: i + 1
    }
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
producer()
