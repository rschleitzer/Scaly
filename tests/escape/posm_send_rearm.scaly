; Channel move checker positive: a bare `set m: <fresh>` after the send
; re-arms the binding with a NEW region, so the later use is fine. Must
; compile.

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer() mutable chan
{
    let c chan as pointer[Channel]
    let mp Page.allocate_page()
    var m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m.value: 7
    Channel.send(c, m as pointer[void])
    let mp2 Page.allocate_page()
    set m: mp2.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m.value: 8
    Channel.send(c, m as pointer[void])
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
producer()
