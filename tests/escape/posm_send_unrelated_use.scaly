; Channel move checker positive: after the send, only OTHER bindings are
; used (the channel itself, counters, a second independent message).
; Must compile.

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer() io mutable chan
{
    let c chan as pointer[Channel]
    let mp Page.allocate_page()
    let m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m.value: 7
    var count 0
    Channel.send(c, m as pointer[void])
    set count: count + 1
    let mp2 Page.allocate_page()
    let m2 mp2.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m2.value: count
    Channel.send(c, m2 as pointer[void])
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
producer()
