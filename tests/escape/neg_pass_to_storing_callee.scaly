; ESCAPE (negative): passing a $-local-page ref to a callee that STORES it into
; frame-external memory (`this.field`) is a use-after-free once the local page
; is freed at scope exit. The escape checker (Vector 3, interprocedural) must
; REJECT this ("escapes via call"). Here `c` is a PARAMETER (caller's object),
; so storing &bx into c.b leaks the local bx past this frame.
define Box
(
    v: int
)
define Holder
(
    b: pointer[Box]
)
{
    procedure stash(this, p: pointer[Box])
        set this.b: p
}

procedure fill(c: Holder)
{
    let bx Box$(5)
    c.stash(&bx)
}

function main() returns int
{
    return 0
}
