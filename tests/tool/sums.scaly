; `scaly test` (tests/tool/run.sh): three test functions, one failing on
; purpose -- the tool must name it, count it and answer rc 1; a filter runs
; the matching ones only. The program's own statement does not run.
function sum(n: int) returns int
{
    var s 0
    var i 1
    while i <= n
    {
        set s: s + i
        set i: i + 1
    }
    s
}

function test_sum() returns int
{
    if sum(4) <> 10
        return 1
    0
}

function test_wrong() returns int
{
    if sum(3) <> 7
        return 2
    0
}

procedure test_print() returns int
{
    print "printed"
    0
}

print "the program itself"
