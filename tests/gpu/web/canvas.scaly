; A picture for the page: one round per point, its colour a 32-bit number
; (red in the lowest byte, then green, blue, opacity: the bytes a canvas
; takes), the loop `relaxed` so that a card under WebGPU may run it, and the
; picture written as it lies in memory into a file whose name says its
; size -- the page's worker hands such a file back, and the tour shows it.

function colour(x: i32, y: i32, w: i32, h: i32, turns: i32) returns u32
{
    let cr (x as f32) * 3.0 / (w as f32) - 2.1
    let ci (y as f32) * 2.0 / (h as f32) - 1.0
    var zr: f32 0.0
    var zi: f32 0.0
    var k: i32 0
    while k < turns and zr * zr + zi * zi <= 4.0
    {
        let t zr * zr - zi * zi + cr
        zi := zr * 2.0 * zi + ci
        zr := t
        k := k + 1
    }
    if k = turns
        return 0xFF000000
    let shade (k * 255 / turns) as u32
    0xFF000000 | ((255 - shade) << 16) | ((shade * 2 % 256) << 8) | shade
}

let w: i32 300
let h: i32 200
var picture Vector[u32]((w * h) as size_t)
relaxed for p in w * h
    picture.put(p as size_t, colour(p % w, p / w, w, h, 100))
if File.write_bytes("canvas.`w`x`h`.rgba", picture.as_bytes()) = false
    print "no picture written"
print "`w` x `h`"
