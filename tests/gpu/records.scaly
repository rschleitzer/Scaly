; Records and tuples of a card's numbers in a kernel: built, handed to a
; function and back, nested, read field by field, chosen by a value `if`,
; a field of a record of the environment, and such records handed on whole
; (one of them holding another); sqrtf on the card.
; cards: 1

function sqrtf(x: f32) returns f32 extern

define V3
(
    x: f32
    y: f32
    z: f32
)

define Ray
(
    o: V3
    d: V3
    bounces: i32
)

define Box
(
    w: i32
    h: i32
)

; a record holding a record: handed to the card whole, from the environment
define Scene
(
    box: Box
    scale: f32
)

function limit(b: Box) returns i32
    b.h / 8

function shift(s: Scene) returns f32
    (s.box.w as f32) * s.scale

function plus(a: V3, b: V3) returns V3
    V3(a.x + b.x, a.y + b.y, a.z + b.z)

function scaled(a: V3, k: f32) returns V3
    V3(a.x * k, a.y * k, a.z * k)

function dot(a: V3, b: V3) returns f32
    a.x * b.x + a.y * b.y + a.z * b.z

function unit(a: V3) returns V3
    scaled(a, 1.0 / sqrtf(dot(a, a)))

function step(r: Ray) returns Ray
    Ray(plus(r.o, r.d), unit(plus(r.d, V3(0.0, 0.5, 0.25))), r.bounces + 1)

; the whole number below the sum of v's parts, and what is left of it
function parts(v: V3) returns (whole: i32, rest: f32)
{
    let s v.x + v.y + v.z
    let w s as i32
    (whole: w, rest: s - (w as f32))
}

let box Box(64, 40)
let scene Scene(box, 0.25)
let n: size_t 2048
var xs Vector[f32](n)
var ws Vector[i32](n)
for i in n
{
    var r Ray(V3((i as f32) * 0.01, 0.0, 1.0), unit(V3(1.0, (i as f32) * 0.001, 0.5)), 0)
    while r.bounces < limit(box)
        r := step(r)
    let pick if r.o.x > shift(scene): r.o else r.d
    let p parts(pick)
    xs.put(i, p.rest + pick.y)
    ws.put(i, p.whole + r.bounces)
}
var k: size_t 0
while k < n
{
    print "`(xs[k] as f64)` `ws[k]`"
    k := k + 1
}
