; The gate with a reduction. The processor runs the first rows itself and
; has their parts of the sums in the variables when the card takes the
; loop: the card computes every row again, and only the parts of the rows
; the processor had not run are folded in -- in the rows' order, so the
; floating-point sum has the processor's bits. The second time the card is
; asked at the loop's head and every part is folded.
; cards-min: 2

function row_count(y: i32, n: i32) returns i32
{
    let ci (y as f32) * 2.0 / (n as f32) - 1.0
    var count: i32 0
    for x in n
    {
        let cr (x as f32) * 3.0 / (n as f32) - 2.0
        var zr: f32 0.0
        var zi: f32 0.0
        var inside: i32 1
        for k in 64
        {
            let t zr * zr - zi * zi + cr
            zi := zr * 2.0 * zi + ci
            zr := t
            if zr * zr + zi * zi > 4.0
                inside := 0
        }
        count := count + inside
    }
    count
}

function picture(n: i32) returns f64
{
    var total: i32 0
    var weight: f32 0.0
    for y in n
    {
        let c row_count(y, n)
        total := total + c
        weight := weight + (c as f32) / ((y as f32) + 0.3)
    }
    (total as f64) + (weight as f64)
}

let first picture(3000)
let second picture(3000)
print "`first` `second`"
