; The gate, a loop that pays: 3000 rows of a mandelbrot picture, the same
; loop run twice. Nobody forces the card. The first time the processor runs
; a few rows, measures them, and is about to hand the rest to its other
; cores -- there the card takes the loop; the second time it is asked at
; the loop's head.
; cards-min: 2

function row_count(y: i32, n: i32) returns i32
{
    let ci (y as f32) * 2.0 / (n as f32) - 1.0
    var count: i32 0
    for x in n
    {
        let cr (x as f32) * 3.0 / (n as f32) - 2.0
        var zr: f32 0.0
        var zi: f32 0.0
        var inside: i32 1
        for k in 64
        {
            let t zr * zr - zi * zi + cr
            zi := zr * 2.0 * zi + ci
            zr := t
            if zr * zr + zi * zi > 4.0
                inside := 0
        }
        count := count + inside
    }
    count
}

let n: i32 3000
var counts Vector[i32](n as size_t)
var again Vector[i32](n as size_t)
for y in n
    counts.put(y as size_t, row_count(y, n))
for y in n
    again.put(y as size_t, row_count(y, n))
var total 0
var same 1
var i: size_t 0
while i < (n as size_t)
{
    total := total + (counts[i] as int)
    if counts[i] <> again[i]
        same := 0
    i := i + 1
}
print "`total` `same`"
