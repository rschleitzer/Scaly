; A kernel by its shape whose source the printer does not write: a number
; that gets wider where it is bound to a typed name -- the one conversion
; nobody wrote that reaches the printer. It refuses, and under --gpu the
; card is never asked.
; cards: 0

procedure widened_binding(src: ref[Vector[i32]], mutable out: ref[Vector[int]])
{
    for i in src.length
    {
        let w: int src[i]
        out.put(i, w)
    }
}

let n: size_t 4
var a Vector[i32](n)
var o Vector[int](n)
var k: size_t 0
while k < n
{
    a.put(k, (k as i32) * 3 - 5)
    k := k + 1
}
widened_binding(&a, &o)
k := 0
while k < n
{
    print "`a[k]` `o[k]`"
    k := k + 1
}
