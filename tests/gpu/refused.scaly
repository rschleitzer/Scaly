; Kernels by their shape whose source would not compute what the processor
; computes: the conversions the processor's code does through the signed
; ones. The printer refuses them, and under --gpu the card is never asked.
; cards: 0

procedure unsigned_to_float(src: ref[Vector[u32]], mutable out: ref[Vector[f32]])
{
    for i in src.length
        out.put(i, src[i] as f32)
}

procedure float_to_unsigned(src: ref[Vector[f32]], mutable out: ref[Vector[u32]])
{
    for i in src.length
        out.put(i, src[i] as u32)
}

let n: size_t 4
var u Vector[u32](n)
var f Vector[f32](n)
var k: size_t 0
while k < n
{
    u.put(k, (k as u32) * 1500000000)
    k := k + 1
}
unsigned_to_float(&u, &f)
float_to_unsigned(&f, &u)
k := 0
while k < n
{
    print "`f[k] as f64` `u[k] as size_t`"
    k := k + 1
}
