; Mixed processors, relaxed: a loop whose rounds call mul_add, written
; `relaxed for` -- its rounds may go to a helper of either FMA class, and
; then compute other bits in the last place. tests/cluster/run.sh runs an
; arm64 coordinator with an x86_64 helper built for the generic x86_64 (no
; FMA): the rounds go out, and the sum agrees to nine digits.

function wave(x: f64, n: int) returns f64
{
    var s x
    var k 0
    while k < n
    {
        s := exp(s * 0.001) + 0.5 / (1.0 + (k as f64))
        k := k + 1
    }
    s
}

procedure waves(mutable out: Vector[f64])
{
    relaxed for i in out.length
        out.put(i, wave((i as f64) / 1000.0, 20000))
}

var a Vector[f64](4000)
waves(a)
var sum 0.0
var m: size_t 0
while m < a.length
{
    sum := sum + a[m]
    m := m + 1
}
print "relaxed `(sum * 1000.0).round_even() / 1000.0`"
