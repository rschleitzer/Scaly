; Stage-7 milestone 7.0 wire spike — SENDER.
; Builds a message region (SNode chain of 400 strings + 1 oversized
; string), enumerates its pages exactly like deallocate_extensions,
; ships them VERBATIM over TCP loopback to a second OS process, tears
; the region down locally, then benchmarks throughput and round-trips.
; The oversized page length is read from the header slot where
; allocate_oversized records it since the 7.1 opener (current_page@8 —
; Page.oversized_size); this spike originally HARDCODED 102400 because
; the length was not recorded anywhere, the finding that gated 7.1.
; The stdlib serializer this spike prefigured is scaly/memory/Region.scaly
; (milestone 7.1); the spike stays as the raw wire-format reference.

function scaly_eio_now_ns() returns i64 extern

define SNode (content: String, next: pointer[SNode])
define Root (head: pointer[SNode], count: size_t)

mutable pg_old: pointer[size_t] null
mutable pg_len: pointer[size_t] null
mutable pg_cnt: size_t 0
mutable chk: u64 0

function num_to_string(n: i64) returns String
{
    if n = 0
        return "0"
    var value n
    var digits Array[char]()
    while value > 0
    {
        let digit ((value % 10) as char) + 48 as char
        digits.add digit
        set value: value / 10
    }
    var sb StringBuilder()
    var i digits.length
    while i > 0
    {
        set i: i - 1
        let d digits.get i
        if d <> null
            sb.append(*d)
    }
    sb.to_string()
}

procedure report(tag: pointer[const_char], value: i64, unit: pointer[const_char])
{
    var sb StringBuilder()
    var lbl String(tag)
    sb.append lbl
    let vs num_to_string(value)
    sb.append vs
    var us String(unit)
    sb.append us
    let line sb.to_string()
    Console.println(line.to_c_string())
}

procedure read_exact(fd: i32, buf: pointer[void], count: size_t) returns bool
{
    var done 0 as size_t
    while done < count
    {
        let r Io.read(fd, ((buf as size_t) + done) as pointer[void], count - done)
        if r <= (0 as i64)
            return false
        set done: done + (r as size_t)
    }
    true
}

procedure chk_byte(b: u8) mutable chk
    set chk: (chk xor (b as u64)) * (0x100000001b3 as u64)

procedure add_entry(base: size_t, len: size_t) mutable pg_cnt, pg_len, pg_old
{
    let po pg_old
    let pl pg_len
    set po[pg_cnt]: base
    set pl[pg_cnt]: len
    set pg_cnt: pg_cnt + (1 as size_t)
}

; RAW-OFFSET region walk. Typed Page field access (p.next_page etc.)
; from a USER program silently dropped the dependent statements when
; this spike was written — the finding-4 compiler bug, FIXED same day
; (synthesize_literal_struct memory-family shapes + the struct-only
; top-of-chain load gate; tests/regress/page_field_user.scaly). The
; walk stays raw-offset as a wire-format reference: the receiver must
; fix up page headers in raw buffers anyway. Page layout: next_object@0
; current_page@8 next_page@16 exclusive_pages.head@24; PageNode:
; page@0 next@8.
procedure walk_exclusives(p: size_t) mutable pg_cnt, pg_len, pg_old
{
    var nd *((p + (24 as size_t)) as pointer[size_t])
    while nd <> (0 as size_t)
    {
        let excl *(nd as pointer[size_t])
        let no *(excl as pointer[size_t])
        if no = (0 as size_t)
        {
            let olen *((excl + (8 as size_t)) as pointer[size_t])
            add_entry(excl, olen)
        }
        if no <> (0 as size_t)
            walk_region(excl)
        set nd: *((nd + (8 as size_t)) as pointer[size_t])
    }
}

procedure walk_region(p: size_t) mutable pg_cnt, pg_len, pg_old
{
    add_entry(p, 4096 as size_t)
    walk_exclusives p
    var q *((p + (16 as size_t)) as pointer[size_t])
    while q <> (0 as size_t)
    {
        add_entry(q, 4096 as size_t)
        walk_exclusives q
        set q: *((q + (16 as size_t)) as pointer[size_t])
    }
}

procedure fill_content(mutable buf: pointer[u8], i: size_t) returns size_t
{
    let len (5 as size_t) + ((i * (7 as size_t)) % (80 as size_t))
    var j 0 as size_t
    while j < len
    {
        set buf[j]: ((97 as size_t) + ((i + j) % (26 as size_t))) as u8
        set j: j + (1 as size_t)
    }
    len
}

; ==== build the message region ====

let mp Page.allocate_page()
let root mp.allocate(sizeof Root, alignof Root) as pointer[Root]
set root.head: null
set root.count: 0 as size_t

var i 0 as size_t
while i < (400 as size_t)
{
    var cbuf u8[96]
    let len fill_content(cbuf as pointer[u8], i)
    let nd mp.allocate(sizeof SNode, alignof SNode) as pointer[SNode]
    let s String^mp(cbuf as pointer[const_char], len)
    set nd.content: s
    set nd.next: root.head
    set root.head: nd
    set i: i + (1 as size_t)
}

; One oversized payload: 100000 content bytes -> the String buffer
; leaves the page chain via allocate_oversized (gross 100036 rounded
; to 102400 = 25 pages, page-aligned, next_object = null).
let bigbuf scaly_aligned_alloc(4096 as i64, 131072 as i64) as pointer[u8]
var bi 0 as size_t
while bi < (100000 as size_t)
{
    set bigbuf[bi]: ((65 as size_t) + (bi % (26 as size_t))) as u8
    set bi: bi + (1 as size_t)
}
let bnd mp.allocate(sizeof SNode, alignof SNode) as pointer[SNode]
let bs String^mp(bigbuf as pointer[const_char], 100000 as size_t)
set bnd.content: bs
set bnd.next: root.head
set root.head: bnd
scaly_aligned_free(bigbuf as pointer[void])

set root.count: 401 as size_t

; ==== checksum by the traversal the receiver will repeat ====

set chk: 0xcbf29ce484222325 as u64
var items 0 as size_t
var n root.head
while n <> null
{
    let s n.content
    let sl s.get_length()
    var j 0 as size_t
    while j < sl
    {
        let b s.get(j)
        chk_byte b
        set j: j + (1 as size_t)
    }
    chk_byte((sl % (256 as size_t)) as u8)
    set items: items + (1 as size_t)
    set n: n.next
}

; ==== enumerate the region's pages ====

set pg_old: scaly_aligned_alloc(8 as i64, 32768 as i64) as pointer[size_t]
set pg_len: scaly_aligned_alloc(8 as i64, 32768 as i64) as pointer[size_t]
walk_region(mp as size_t)
report("S: pages ", pg_cnt as i64, "")
report("S: items ", items as i64, "")

; ==== connect (retry while the receiver comes up) ====

var fd Io.connect(47613 as i32)
var tries 0
while fd < (0 as i32)
{
    set tries: tries + 1
    if tries > 100
        exit 3
    let t scaly_eio_now_ns()
    var burn 0 as i64
    while scaly_eio_now_ns() - t < (100000000 as i64)
        set burn: burn + (1 as i64)
    set fd: Io.connect(47613 as i32)
}

; ==== ship the frame: header, then each page verbatim ====

let hdr scaly_aligned_alloc(8 as i64, 64 as i64) as pointer[u64]
set hdr[0]: 0x53434c59 as u64
set hdr[1]: pg_cnt as u64
set hdr[2]: (root as size_t) as u64
set hdr[3]: chk
set hdr[4]: items as u64
Io.write_all(fd, hdr as pointer[void], 40 as size_t)

var total 40 as size_t
var pi 0 as size_t
let po pg_old
let pl pg_len
while pi < pg_cnt
{
    set hdr[0]: po[pi] as u64
    set hdr[1]: pl[pi] as u64
    Io.write_all(fd, hdr as pointer[void], 16 as size_t)
    Io.write_all(fd, po[pi] as pointer[void], pl[pi])
    set total: total + (16 as size_t) + pl[pi]
    set pi: pi + (1 as size_t)
}
report("S: frame bytes ", total as i64, "")

; Tear the region down BEFORE the verdict arrives: the receiver must
; be operating on its own copy by construction.
mp.deallocate_extensions()
Page.release_page(mp)
Console.println "S: region freed"

var ack u8[8]
if read_exact(fd, ack as pointer[void], 1 as size_t) = false
    exit 4
if ack[0] = (80 as u8)
    Console.println "S: region PASS"
if ack[0] <> (80 as u8)
{
    Console.println "S: region FAIL"
    exit 4
}

; ==== memcpy baseline (in-process ceiling) ====

let src scaly_aligned_alloc(4096 as i64, 1048576 as i64)
let dst scaly_aligned_alloc(4096 as i64, 1048576 as i64)
var mi 0 as i64
let m0 scaly_eio_now_ns()
while mi < (256 as i64)
{
    let r memcpy(dst, src, 1048576 as size_t)
    set mi: mi + (1 as i64)
}
let m1 scaly_eio_now_ns()
var mms (m1 - m0) / (1000000 as i64)
if mms = 0
    set mms: 1 as i64
report("S: memcpy ", ((256 as i64) * (1000 as i64)) / mms, " MiB/s")

; ==== throughput: 256 MiB through the socket ====

var ti 0 as i64
let t0 scaly_eio_now_ns()
while ti < (256 as i64)
{
    Io.write_all(fd, src, 1048576 as size_t)
    set ti: ti + (1 as i64)
}
if read_exact(fd, ack as pointer[void], 1 as size_t) = false
    exit 4
let t1 scaly_eio_now_ns()
var tms (t1 - t0) / (1000000 as i64)
if tms = 0
    set tms: 1 as i64
report("S: tcp ", ((256 as i64) * (1000 as i64)) / tms, " MiB/s")

; ==== latency: 2000 one-byte round trips ====

var li 0 as i64
let l0 scaly_eio_now_ns()
while li < (2000 as i64)
{
    Io.write_all(fd, ack as pointer[void], 1 as size_t)
    if read_exact(fd, ack as pointer[void], 1 as size_t) = false
        exit 4
    set li: li + (1 as i64)
}
let l1 scaly_eio_now_ns()
report("S: rtt ", (l1 - l0) / (2000 as i64), " ns/rt")

Console.println "S: done"
