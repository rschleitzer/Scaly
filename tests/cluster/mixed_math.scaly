; Mixed processors: this program calls mul_add (through exp), so its rounds
; go only to helpers of its FMA class -- an x86_64 helper built for Haswell
; computes them bit for bit as arm64 does, one built for the generic x86_64
; (no FMA) is passed over. tests/cluster/run.sh builds it for both and runs
; an arm64 coordinator with x86_64 helpers under Rosetta. It prints the
; bits of its results, folded: the same line wherever a round was computed.

function wave(x: f64, n: int) returns f64
{
    var s x
    var k 0
    while k < n
    {
        s := exp(s * 0.001) + 0.5 / (1.0 + (k as f64))
        k := k + 1
    }
    s
}

procedure heavy(mutable out: Vector[f64])
{
    for i in out.length
        out.put(i, wave((i as f64) / 1000.0, 20000))
}

var out Vector[f64](4000)
heavy(out)
var folded: u64 0
var m: size_t 0
while m < out.length
{
    let v out[m]
    folded := (folded * 31) xor v.to_bits()
    m := m + 1
}
print "math `folded`"
