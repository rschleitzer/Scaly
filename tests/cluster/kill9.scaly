; Stage-7 kill -9 probe. ONE program, two roles (KILL9_ROLE=v|s; one
; build per memo rule 10). The victim connects, proves the link with
; one message, then hangs mid-run until the harness kills it with -9.
; Death = close (rule 2): the survivor's blocked receive wakes with
; null, and its monitor delivers one NodeDown (reason 2 = suspected —
; rule 1: suspicion, never a fact) and closes. receive_timeout bounds
; the down-notice wait (rule 6).

define PORT i32 47622

define KMsg
(
    value: i64
)

procedure run_victim()
{
    let page Page.allocate_page()
    let sched Scheduler.create(page)

    var peer Cluster.connect("127.0.0.1", PORT)
    var tries 0
    while peer = null
    {
        set tries: tries + 1
        if tries > 100
            exit 3
        poll(null as pointer[void], 0 as i32, 100 as i32)
        set peer: Cluster.connect("127.0.0.1", PORT)
    }

    let mp Page.allocate_page()
    let m mp.allocate(sizeof KMsg, alignof KMsg) as pointer[KMsg]
    set m.value: 7 as i64
    Cluster.send(peer, 1 as u64, m as pointer[void])
    Console.println "V: sent"

    repeat
        poll(null as pointer[void], 0 as i32, 100 as i32)
}

procedure run_survivor()
{
    let page Page.allocate_page()
    let sched Scheduler.create(page)

    let lfd Cluster.listen(PORT)
    if lfd < (0 as i32)
        exit 3
    Console.println "S: ready"
    let peer Cluster.accept(lfd)
    if peer = null
        exit 3
    let mon Cluster.monitor(peer)
    let ch Cluster.channel(peer, 1 as u64)

    let raw Channel.receive(ch)
    if raw = null
        exit 4
    let rr raw as pointer[ReceivedRegion]
    let rroot rr.root
    let m rroot as pointer[KMsg]
    rr.fix_graph(m)
    if m.value <> (7 as i64)
        exit 4
    Cluster.dispose_message(rr)
    Console.println "S: linked"

    ; the harness kills the victim now: the blocked receive wakes null
    let tail Channel.receive(ch)
    if tail <> null
        exit 5
    Console.println "S: channel closed"

    var timed false
    let d Channel.receive_timeout(mon, 10000 as i32, &timed)
    if d = null
        exit 6
    if timed
        exit 6
    let nd d as pointer[NodeDown]
    if nd.reason <> (2 as i64)
        exit 6
    Console.println "S: down suspect"
    let dp Page.get(d)
    dp.deallocate_extensions()
    Page.release_page(dp)

    let mtail Channel.receive(mon)
    if mtail <> null
        exit 7
    Console.println "S: PASS"
    Cluster.dispose_peer(peer)
}

let role getenv("KILL9_ROLE")
if role = null
    exit 2
let rc (*role) as u8
if rc = (118 as u8)
    run_victim()
else
    run_survivor()
