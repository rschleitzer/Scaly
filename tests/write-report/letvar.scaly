; R2 fixture for tests/write-report: a property is `let` unless it says `var`.
; The check mode's verdicts, one per shape:
define Box (let fixed: int  var count: int  tag: int)
{
    init(f: int)
    {
        fixed := f
        count := 0
        tag := 1
    }

    ; a var field through this: legal
    procedure bump(mutable this)
        count := count + 1

    ; a let field through this, outside init: a violation
    procedure retag(mutable this, t: int)
        tag := t
}

; a let field through a parameter: a violation
procedure refix(mutable b: ref[Box], f: int)
    b.fixed := f

; a let field on a fresh local, before it is published: legal
procedure build() returns int
{
    var b Box(1)
    b.fixed := 2
    b.tag := 3
    b.bump()
    refix(&b, 4)
    b.fixed + b.count + b.tag
}

let n build()
