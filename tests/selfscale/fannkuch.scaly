; fannkuch-redux — for every permutation of 0..n-1, flip the prefix the first
; element names until 0 leads, and keep the largest flip count. The split is
; by the first TWO elements: each pair is an independent pure function of n
; and the pair, returning a small record (a kept value). The
; checksum here is the plain sum of all flip counts, independent of order,
; not the benchmark's alternating one.
;
; Why two (2026-09-28): split by the first element alone, the loop had eleven
; tasks of 120-140 ms, and on a machine of 4 performance and 6 efficiency
; cores the tasks that landed on the slower cores set the wall time — 0.29 s
; where C #5, which cuts the permutations into many blocks, takes 0.22. With
; 110 tasks of ~12 ms the pool balances them: 0.17 s, one core unchanged.
;
; The flips follow the C programs (2026-09-27): one scratch buffer per task,
; handed to every flips_of instead of a fresh Vector per permutation, and
; C #5's method inside -- the leading value stays in a register, and a
; permutation that starts with 0 is neither copied nor flipped. A procedure
; that writes only its task's own buffer keeps the loop parallel (the
; TaskPlanner's purity walk no longer counts the bounds trap as an effect).

define FlipResult (max_flips: int  total_flips: int)

; the flips of one permutation
procedure flips_of(perm: Vector[int], mutable work: Vector[int], n: int) returns int
{
    ; C #5's method: the first value stays in a register, a permutation that
    ; starts with 0 needs no flip and no copy
    let first perm[0]
    if first = 0
        return 0
    var k 1
    while k < n
    {
        work.put(k as size_t, perm[k as size_t])
        k := k + 1
    }
    var flips 0
    var fv first
    repeat
    {
        flips := flips + 1
        let nf work[fv as size_t]
        work.put(fv as size_t, fv)
        if fv > 2
        {
            var lo 1
            var hi fv - 1
            while lo < hi
            {
                let t work[lo as size_t]
                work.put(lo as size_t, work[hi as size_t])
                work.put(hi as size_t, t)
                lo := lo + 1
                hi := hi - 1
            }
        }
        if nf = 0
            break
        fv := nf
    }
    flips
}

; every permutation of 0..n-1 that starts with `first`, `second` (Heap's
; algorithm over the other positions); nothing when the two coincide
function with_prefix(n: int, first: int, second: int) returns FlipResult
{
    if first = second
        return FlipResult(0, 0)
    var perm Vector[int](n as size_t)
    perm.put(0, first)
    perm.put(1, second)
    var p 2
    var v 0
    while v < n
    {
        if v <> first and v <> second
        {
            perm.put(p as size_t, v)
            p := p + 1
        }
        v := v + 1
    }
    let k n - 2
    var c Vector[int](n as size_t)
    var work Vector[int](n as size_t)
    var best flips_of(perm, work, n)
    var total best
    var i 0
    while i < k
    {
        if c[i as size_t] < i
        {
            var a 2
            if i % 2 = 1
                a := 2 + c[i as size_t]
            let b 2 + i
            let t perm[a as size_t]
            perm.put(a as size_t, perm[b as size_t])
            perm.put(b as size_t, t)
            let f flips_of(perm, work, n)
            total := total + f
            if f > best
                best := f
            c.put(i as size_t, c[i as size_t] + 1)
            i := 0
        }
        else
        {
            c.put(i as size_t, 0)
            i := i + 1
        }
    }
    FlipResult(best, total)
}

let n 11
var results Vector[FlipResult]((n * n) as size_t)
for t in n * n
    results.put(t as size_t, with_prefix(n, t / n, t % n))

var max_flips 0
var total 0
for r in results
{
    if r.max_flips > max_flips
        max_flips := r.max_flips
    total := total + r.total_flips
}
print("fannkuch `n`: max `max_flips` flips, `total` in all")
