; spectral-norm with the SIMD vector types (ROADMAP-simd.md phase 4) beside
; spectralnorm.scaly: each row product takes eight columns at a time as two
; independent f64x4 chains, the matrix entry computed in doubles
; ((i + j)(i + j + 1) / 2 + i + 1 is exact in a double at this size). The rows
; are still a plain `for` of pure functions and self-scale as before; this
; program measures the language, the scalar one the engine.

function sqrt(x: double) returns double extern

function av_row(i: int, v: Vector[double], n: int) returns double
{
    let fi i as double
    var acc0 f64x4.splat(0.0)
    var acc1 f64x4.splat(0.0)
    var jv f64x4.iota(0.0, 1.0)
    var j 0
    while j + 8 <= n
    {
        let s0 jv + fi
        let s1 s0 + 4.0
        let a0 s0 * (s0 + 1.0) * 0.5 + (fi + 1.0)
        let a1 s1 * (s1 + 1.0) * 0.5 + (fi + 1.0)
        set acc0: acc0 + f64x4.load(v, j as size_t) / a0
        set acc1: acc1 + f64x4.load(v, (j + 4) as size_t) / a1
        set jv: jv + 8.0
        set j: j + 8
    }
    var sum (acc0 + acc1).sum()
    while j < n
    {
        let s ((i + j) as double)
        set sum: sum + v[j as size_t] / (s * (s + 1.0) * 0.5 + (fi + 1.0))
        set j: j + 1
    }
    sum
}

function atv_row(i: int, v: Vector[double], n: int) returns double
{
    let fi i as double
    var acc0 f64x4.splat(0.0)
    var acc1 f64x4.splat(0.0)
    var jv f64x4.iota(0.0, 1.0)
    var j 0
    while j + 8 <= n
    {
        let s0 jv + fi
        let s1 s0 + 4.0
        let a0 s0 * (s0 + 1.0) * 0.5 + (jv + 1.0)
        let a1 s1 * (s1 + 1.0) * 0.5 + (jv + 5.0)
        set acc0: acc0 + f64x4.load(v, j as size_t) / a0
        set acc1: acc1 + f64x4.load(v, (j + 4) as size_t) / a1
        set jv: jv + 8.0
        set j: j + 8
    }
    var sum (acc0 + acc1).sum()
    while j < n
    {
        let s ((i + j) as double)
        set sum: sum + v[j as size_t] / (s * (s + 1.0) * 0.5 + ((j + 1) as double))
        set j: j + 1
    }
    sum
}

procedure mul_av(v: Vector[double], mutable out: Vector[double], n: int)
{
    for i in n
        out.put(i as size_t, av_row(i, v, n))
}

procedure mul_atv(v: Vector[double], mutable out: Vector[double], n: int)
{
    for i in n
        out.put(i as size_t, atv_row(i, v, n))
}

procedure mul_atav(v: Vector[double], mutable out: Vector[double], mutable tmp: Vector[double], n: int)
{
    mul_av(v, tmp, n)
    mul_atv(tmp, out, n)
}

let n 10000
var u Vector[double](n as size_t)
var v Vector[double](n as size_t)
var tmp Vector[double](n as size_t)
var k 0
while k < n
{
    u.put(k as size_t, 1.0)
    set k: k + 1
}
var step 0
while step < 10
{
    mul_atav(u, v, tmp, n)
    mul_atav(v, u, tmp, n)
    set step: step + 1
}
var vbv: double 0.0
var vv: double 0.0
set k: 0
while k < n
{
    set vbv: vbv + u[k as size_t] * v[k as size_t]
    set vv: vv + v[k as size_t] * v[k as size_t]
    set k: k + 1
}
let norm sqrt(vbv / vv)
let scaled (norm * 1000000000.0) as i64
print("spectral-norm `n`: `scaled` (x 1e-9)")
