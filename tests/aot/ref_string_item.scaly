; AOT Test: a ref[String]? built on the caller page (^rp) and handed back
; Expected: PASS

package scaly 0.1.0

use scaly.containers.String
use scaly.containers.Vector

define MyItem
(
    name: ref[String]?
)

function copy_name#(i: MyItem) returns ref[String]?
{
    var result: ref[String]? null
    if i.name <> null
    {
        let n (*i.name)
        var holder Vector[String]^rp(1)
        holder.put(0, String^rp(n))
        result := holder.get(0)
    }
    result
}

function check() returns int
{
    let item MyItem(&(String("x")))
    let copied copy_name(item)
    if copied = null
        return 1
    if (*copied).equals(String("x")) = false
        return 2
    0
}

if check() = 0
    print("PASS")
else
    print("FAIL")
