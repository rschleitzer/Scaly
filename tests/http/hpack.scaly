; The http package's HPACK against RFC 7541 Appendix C.4: three requests
; with Huffman-coded strings decoded by one decoder, the second and third
; reading entries the earlier ones put into the dynamic table (whose size
; after the third is 164), and a response block from the encoder decoded
; back (an indexed :status, a :status the static table does not hold, a
; field with an indexed name and one with a literal name). Then the
; Huffman decoder over every code: all 256 byte values encoded here from
; the code tables (codes of 5 to 30 bits, so both the 8-bit fast table and
; the length-by-length path), and every value alone at the end of a string
; (each padding).
; Expected: c41 c42 c43 table encoder huffman

package scaly 0.1.0
package http 0.1.0

use http.Buffer.ByteBuf
use http.Hpack.HeaderList
use http.Hpack.HpackDecoder

function hex_value(c: u8) returns u8
{
    if c >= 97
        return c - 87
    c - 48
}

; The bytes a hex string spells, onto out.
procedure unhex(hex: Slice[u8], mutable out: ref[ByteBuf])
{
    var i: size_t 0
    while i + 1 < hex.length
    {
        out.append_byte(hex_value(hex[i]) * 16 + hex_value(hex[i + 1]))
        set i: i + 2
    }
}

; The fields of a list as "name=value" joined by " ".
procedure fields(list: ref[HeaderList]) returns String
{
    var sb StringBuilder()
    var i: size_t 0
    while i < list.count()
    {
        if i > 0
            sb.append(" " as char)
        let n list.name(i)
        let v list.value(i)
        sb.append(String(n.data as pointer[const_char], n.length))
        sb.append("=" as char)
        sb.append(String(v.data as pointer[const_char], v.length))
        set i: i + 1
    }
    sb.to_string()
}

procedure check(mutable d: ref[HpackDecoder], mutable list: ref[HeaderList], hex: Slice[u8], want: String, what: String) returns bool
{
    let host Page.allocate_page()
    var block ByteBuf.create(host, 64)
    unhex(hex, &block)
    list.clear()
    if d.decode(block.bytes(), list) = false
    {
        print "`what`: decode failed"
        return false
    }
    let got fields(list)
    if got.equals(want) = false
    {
        print "`what`: `got`"
        return false
    }
    Console.print "`what` "
    true
}

; The Huffman code of symbol: its bits in the low end of the result, its
; length at code_length.
procedure huffman_code(symbol: u64, mutable code_length: ref[u64]) returns u64
{
    var length: size_t 5
    while length <= 30
    {
        let n HUFF_COUNT[length] as size_t
        let off HUFF_OFFSET[length] as size_t
        var k: size_t 0
        while k < n
        {
            if (HUFF_SYMBOLS[off + k] as u64) = symbol
            {
                set code_length: length as u64
                return (HUFF_FIRST[length] as u64) + (k as u64)
            }
            set k: k + 1
        }
        set length: length + 1
    }
    0
}

; The Huffman coding of the bytes of s onto out, padded with ones.
procedure huffman_encode(s: Slice[u8], mutable out: ref[ByteBuf])
{
    var acc: u64 0
    var bits: u64 0
    var i: size_t 0
    while i < s.length
    {
        var length: u64 0
        let code huffman_code(s[i] as u64, &length)
        set acc: (acc << length) | code
        set bits: bits + length
        while bits >= 8
        {
            out.append_byte(((acc >> (bits - 8)) & 255) as u8)
            set bits: bits - 8
        }
        set i: i + 1
    }
    if bits > 0
    {
        let pad 8 - bits
        out.append_byte((((acc << pad) | (((1 as u64) << pad) - 1)) & 255) as u8)
    }
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    let host Page.allocate_page()
    var d HpackDecoder.create(host)
    var list HeaderList.create(host)
    if check(&d, &list, "828684418cf1e3c2e5f23a6ba0ab90f4ff", String(":method=GET :scheme=http :path=/ :authority=www.example.com"), String("c41")) = false
        return 1
    if check(&d, &list, "828684be5886a8eb10649cbf", String(":method=GET :scheme=http :path=/ :authority=www.example.com cache-control=no-cache"), String("c42")) = false
        return 2
    if check(&d, &list, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", String(":method=GET :scheme=https :path=/index.html :authority=www.example.com custom-key=custom-value"), String("c43")) = false
        return 3
    if d.size <> 164 or d.count <> 3
    {
        print "table: size `d.size` count `d.count`"
        return 4
    }
    Console.print "table "
    var out ByteBuf.create(host, 64)
    encode_status(&out, 200)
    encode_status(&out, 418)
    encode_field(&out, "content-type", "text/plain")
    encode_field(&out, "x-sum", "72")
    var e HpackDecoder.create(host)
    list.clear()
    if e.decode(out.bytes(), &list) = false or fields(&list).equals(String(":status=200 :status=418 content-type=text/plain x-sum=72")) = false
    {
        print "encoder: `fields(&list)`"
        return 5
    }
    Console.print "encoder "

    let hh Page.allocate_page()
    var all Vector[u8](256)
    var v: size_t 0
    while v < 256
    {
        all.put(v, v as u8)
        set v: v + 1
    }
    var coded ByteBuf.create(hh, 1024)
    var plain ByteBuf.create(hh, 1024)
    huffman_encode(all.as_slice(), &coded)
    if huffman_decode(coded.bytes(), &plain) = false or plain.bytes().equals(all.as_slice()) = false
    {
        print "huffman: all 256 values, `plain.length` decoded"
        return 20
    }
    set v: 0
    while v < 256
    {
        coded.clear()
        plain.clear()
        let one all.as_slice().subslice(v, v + 1)
        huffman_encode(one, &coded)
        if huffman_decode(coded.bytes(), &plain) = false or plain.bytes().equals(one) = false
        {
            print "huffman: value `v` alone"
            return 21
        }
        set v: v + 1
    }
    Console.print "huffman"
    0
}
