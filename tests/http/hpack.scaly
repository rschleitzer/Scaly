; The http package's HPACK against RFC 7541 Appendix C.4: three requests
; with Huffman-coded strings decoded by one decoder, the second and third
; reading entries the earlier ones put into the dynamic table (whose size
; after the third is 164), and a response block from the encoder decoded
; back (an indexed :status, a :status the static table does not hold, a
; field with an indexed name and one with a literal name). Then the
; Huffman decoder over every code: all 256 byte values encoded here from
; the code tables (codes of 5 to 30 bits, so both the 8-bit fast table and
; the length-by-length path), and every value alone at the end of a string
; (each padding). Then the views a decoded list holds: a block that
; indexes a 3000-byte dynamic entry three times and then inserts, so that
; the list first owns those views and its bytes grow on the way -- the
; literal views already in it must follow (under poison, a stale one reads
; 0xDD) -- and the new entry (1100 bytes) evicts the big one and is written
; over its bytes; a later block reads it back from the table. Then a
; Huffman-coded field value holding an LF, and one holding a NUL, fail the
; block (their codes are long: the check sits in the slow path alone), and
; HeaderList.header answers as the HTTP/1.1 text of the request would.
; Expected: c41 c42 c43 table encoder huffman views fields

package scaly 0.1.0
package http 0.1.0

use http.Buffer.ByteBuf
use http.Hpack.HeaderList
use http.Hpack.HpackDecoder

function hex_value(c: u8) returns u8
{
    if c >= 97
        return c - 87
    c - 48
}

; The bytes a hex string spells, onto out.
procedure unhex(hex: Slice[u8], mutable out: ref[ByteBuf])
{
    var i: size_t 0
    while i + 1 < hex.length
    {
        out.append_byte(hex_value(hex[i]) * 16 + hex_value(hex[i + 1]))
        set i: i + 2
    }
}

; The fields of a list as "name=value" joined by " ".
procedure fields(list: ref[HeaderList]) returns String
{
    var sb StringBuilder()
    var i: size_t 0
    while i < list.count()
    {
        if i > 0
            sb.append(" " as char)
        let n list.name(i)
        let v list.value(i)
        sb.append(String(n.data as pointer[const_char], n.length))
        sb.append("=" as char)
        sb.append(String(v.data as pointer[const_char], v.length))
        set i: i + 1
    }
    sb.to_string()
}

procedure check(mutable d: ref[HpackDecoder], mutable list: ref[HeaderList], hex: Slice[u8], want: String, what: String) returns bool
{
    let host Page.allocate_page()
    var block ByteBuf.create(host, 64)
    unhex(hex, &block)
    list.clear()
    if d.decode(block.bytes(), list) = false
    {
        print "`what`: decode failed"
        return false
    }
    let got fields(list)
    if got.equals(want) = false
    {
        print "`what`: `got`"
        return false
    }
    Console.print "`what` "
    true
}

; The Huffman code of symbol: its bits in the low end of the result, its
; length at code_length.
procedure huffman_code(symbol: u64, mutable code_length: ref[u64]) returns u64
{
    var length: size_t 5
    while length <= 30
    {
        let n HUFF_COUNT[length] as size_t
        let off HUFF_OFFSET[length] as size_t
        var k: size_t 0
        while k < n
        {
            if (HUFF_SYMBOLS[off + k] as u64) = symbol
            {
                set code_length: length as u64
                return (HUFF_FIRST[length] as u64) + (k as u64)
            }
            set k: k + 1
        }
        set length: length + 1
    }
    0
}

; The Huffman coding of the bytes of s onto out, padded with ones.
procedure huffman_encode(s: Slice[u8], mutable out: ref[ByteBuf])
{
    var acc: u64 0
    var bits: u64 0
    var i: size_t 0
    while i < s.length
    {
        var length: u64 0
        let code huffman_code(s[i] as u64, &length)
        set acc: (acc << length) | code
        set bits: bits + length
        while bits >= 8
        {
            out.append_byte(((acc >> (bits - 8)) & 255) as u8)
            set bits: bits - 8
        }
        set i: i + 1
    }
    if bits > 0
    {
        let pad 8 - bits
        out.append_byte((((acc << pad) | (((1 as u64) << pad) - 1)) & 255) as u8)
    }
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    let host Page.allocate_page()
    var d HpackDecoder.create(host)
    var list HeaderList.create(host)
    if check(&d, &list, "828684418cf1e3c2e5f23a6ba0ab90f4ff", String(":method=GET :scheme=http :path=/ :authority=www.example.com"), String("c41")) = false
        return 1
    if check(&d, &list, "828684be5886a8eb10649cbf", String(":method=GET :scheme=http :path=/ :authority=www.example.com cache-control=no-cache"), String("c42")) = false
        return 2
    if check(&d, &list, "828785bf408825a849e95ba97d7f8925a849e95bb8e8b4bf", String(":method=GET :scheme=https :path=/index.html :authority=www.example.com custom-key=custom-value"), String("c43")) = false
        return 3
    if d.size <> 164 or d.count <> 3
    {
        print "table: size `d.size` count `d.count`"
        return 4
    }
    Console.print "table "
    var out ByteBuf.create(host, 64)
    encode_status(&out, 200)
    encode_status(&out, 418)
    encode_field(&out, "content-type", "text/plain")
    encode_field(&out, "x-sum", "72")
    var e HpackDecoder.create(host)
    list.clear()
    if e.decode(out.bytes(), &list) = false or fields(&list).equals(String(":status=200 :status=418 content-type=text/plain x-sum=72")) = false
    {
        print "encoder: `fields(&list)`"
        return 5
    }
    Console.print "encoder "

    let hh Page.allocate_page()
    var all Vector[u8](256)
    var v: size_t 0
    while v < 256
    {
        all.put(v, v as u8)
        set v: v + 1
    }
    var coded ByteBuf.create(hh, 1024)
    var plain ByteBuf.create(hh, 1024)
    huffman_encode(all.as_slice(), &coded)
    if huffman_decode(coded.bytes(), &plain) = false or plain.bytes().equals(all.as_slice()) = false
    {
        print "huffman: all 256 values, `plain.length` decoded"
        return 20
    }
    set v: 0
    while v < 256
    {
        coded.clear()
        plain.clear()
        let one all.as_slice().subslice(v, v + 1)
        huffman_encode(one, &coded)
        if huffman_decode(coded.bytes(), &plain) = false or plain.bytes().equals(one) = false
        {
            print "huffman: value `v` alone"
            return 21
        }
        set v: v + 1
    }
    Console.print "huffman "

    ; a literal field with incremental indexing (a literal name)
    var b1 ByteBuf.create(hh, 4096)
    var big Vector[u8](3000)
    set v: 0
    while v < 3000
    {
        big.put(v, ((v % 26) + 97) as u8)
        set v: v + 1
    }
    encode_integer(&b1, 64, 6, 0)
    encode_string(&b1, "x-big")
    encode_string(&b1, big.as_slice())
    var vd HpackDecoder.create(hh)
    var vl HeaderList.create(hh)
    if vd.decode(b1.bytes(), &vl) = false or vl.count() <> 1
    {
        print "views: first block"
        return 30
    }
    ; "a: b" as a literal (a view into the list's bytes), the big entry
    ; three times, then an insert
    var b2 ByteBuf.create(hh, 64)
    encode_field(&b2, "a", "b")
    encode_integer(&b2, 128, 7, 62)
    encode_integer(&b2, 128, 7, 62)
    encode_integer(&b2, 128, 7, 62)
    var fresh Vector[u8](1100)
    set v: 0
    while v < 1100
    {
        fresh.put(v, 110)
        set v: v + 1
    }
    encode_integer(&b2, 64, 6, 0)
    encode_string(&b2, "x-new")
    encode_string(&b2, fresh.as_slice())
    vl.clear()
    if vd.decode(b2.bytes(), &vl) = false or vl.count() <> 5
    {
        print "views: second block, `vl.count()` fields"
        return 31
    }
    if vl.name(0).equals("a") = false or vl.value(0).equals("b") = false or vl.name(4).equals("x-new") = false or vl.value(4).equals(fresh.as_slice()) = false
    {
        print "views: the literals moved wrong"
        return 32
    }
    var f: size_t 1
    while f <= 3
    {
        if vl.name(f).equals("x-big") = false or vl.value(f).equals(big.as_slice()) = false
        {
            print "views: field `f`"
            return 33
        }
        set f: f + 1
    }
    var b3 ByteBuf.create(hh, 64)
    encode_integer(&b3, 128, 7, 62)
    vl.clear()
    if vd.decode(b3.bytes(), &vl) = false or vl.count() <> 1 or vl.name(0).equals("x-new") = false or vl.value(0).equals(fresh.as_slice()) = false
    {
        print "views: the table after the insert"
        return 34
    }
    Console.print "views "

    var bad: size_t 0
    while bad < 2
    {
        var hb ByteBuf.create(hh, 64)
        var hv ByteBuf.create(hh, 64)
        var raw ByteBuf.create(hh, 16)
        raw.append("a")
        if bad = 0
            raw.append_byte(10)
        else
            raw.append_byte(0)
        raw.append("b")
        huffman_encode(raw.bytes(), &hv)
        encode_integer(&hb, 0, 4, 0)
        encode_string(&hb, "x-bad")
        encode_integer(&hb, 128, 7, hv.length as u64)
        hb.append(hv.bytes())
        var bd HpackDecoder.create(hh)
        var bl HeaderList.create(hh)
        if bd.decode(hb.bytes(), &bl)
        {
            print "fields: a Huffman-coded byte `raw.bytes()[1]` passed"
            return 40
        }
        set bad: bad + 1
    }
    var fb ByteBuf.create(hh, 128)
    encode_field(&fb, ":authority", "example.org")
    encode_field(&fb, ":path", "/x")
    encode_field(&fb, "x-probe", " spaced ")
    encode_field(&fb, "content-length", "5")
    var fd HpackDecoder.create(hh)
    var fl HeaderList.create(hh)
    if fd.decode(fb.bytes(), &fl) = false
    {
        print "fields: decode"
        return 41
    }
    if fl.header("host").equals("example.org") = false or fl.header("x-probe").equals("spaced") = false or fl.header("X-Probe").length <> 0 or fl.header(":path").length <> 0 or fl.header("content-length").length <> 0 or fl.header("absent").length <> 0
    {
        print "fields: header lookup"
        return 42
    }
    Console.print "fields"
    0
}
