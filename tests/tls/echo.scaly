; The tls package over TCP: a TLS 1.3 echo server
; started on an ephemeral port, its context from the certificate and key
; run.sh makes; main is the client.
;   handshake  both sides of it, over memory BIOs on TcpStreams
;   hello      five bytes there and back
;   big        60 000 bytes -- four TLS records at least -- written in one
;              call, read back whole and compared byte for byte
;   close      a close_notify; the server's read answers the end
; Expected: handshake hello big close done

package scaly 0.1.0
package tls 0.1.0

use tls.Tls.TlsContext
use tls.Tls.TlsStream
use tls.Tls.SslCtxRef

shared atomic server_ctx: u64 0

procedure echo()
{
    var tcp TcpStream.of_task()
    var ctx TlsContext((scaly_atomic_load_u64(&server_ctx) as size_t) as SslCtxRef)
    var s TlsStream.accept(ctx, tcp)
    if s.is_open() = false
        return
    var buf u8[4096]
    repeat
    {
        let n s.read(Slice[u8](4096, &buf[0]))
        if n <= 0
            break
        if s.write(Slice[u8](n as size_t, &buf[0])) = false
            break
    }
    s.close()
}

; Read until want bytes are in back (or the stream ends): the count.
procedure read_all(mutable s: ref[TlsStream], mutable back: Slice[u8], want: size_t) returns size_t
{
    var got: size_t 0
    while got < want
    {
        let n s.read(back.slice_from(got))
        if n <= 0
            break
        got := got + (n as size_t)
    }
    got
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    if argc < 3
    {
        print "usage: echo <cert.pem> <key.pem>"
        return 2
    }
    var server TlsContext.server(String(*(argv + 1)), String(*(argv + 2)))
    if server.valid() = false
    {
        print "no server context"
        return 1
    }
    scaly_atomic_store_u64(&server_ctx, server.ctx as u64)
    var l TcpListener.listen(0)
    let srv l.start(&echo)

    var client TlsContext.client()
    var s TlsStream.connect(client, TcpStream.connect("127.0.0.1", l.port()))
    if s.is_open() = false
    {
        print "handshake failed"
        return 3
    }
    Console.print "handshake "

    let host Page.allocate_page()
    var back allocate_slice[u8]^host(host, 60000)
    s.write("hello")
    if read_all(&s, back, 5) <> 5 or back.subslice(0, 5).equals("hello") = false
    {
        print "hello failed"
        return 4
    }
    Console.print "hello "

    var big allocate_slice[u8]^host(host, 60000)
    var i: size_t 0
    while i < big.length
    {
        big.put(i, ((i * 7) % 251) as u8)
        i := i + 1
    }
    s.write(big)
    if read_all(&s, back, 60000) <> 60000 or back.equals(big) = false
    {
        print "big failed"
        return 5
    }
    Console.print "big "

    s.close()
    Console.print "close "
    srv.shutdown()
    srv.wait()
    l.close()
    server.free()
    client.free()
    Console.print "done"
    0
}
