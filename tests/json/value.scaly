; The json package's value tree (ROADMAP-http.md stage B):
;   access   a JSON-RPC message read by chained accessors; every step on a
;            missing member or the wrong kind answers the empty value
;   numbers  the text is kept (1.50 stays 1.50); as_i64 only for an integer
;            within i64 (both limits pass, one past them does not); as_f64
;   order    members keep document order; a duplicated name answers the first
;   refuse   a refused document: Null, the code, the offset, the message
;   big      a document of 2000 objects, parsed under poison
; Expected: access numbers order refuse big done

package scaly 0.1.0
package json 0.1.0

use json.Value.JsonValue
use json.Value.JsonParsed

var ok true

let msg_text "{\"jsonrpc\":\"2.0\",\"id\":17,\"method\":\"textDocument/hover\",\"params\":{\"textDocument\":{\"uri\":\"file:///a.scaly\"},\"position\":{\"line\":3,\"character\":14}},\"flags\":[true,false,null]}"
let parsed JsonValue.parse(msg_text.as_slice())
if parsed.ok() = false
    set ok: false
let msg parsed.value
if msg.get("id").as_i64() <> 17 or msg.get("method").as_string().equals("textDocument/hover") = false
    set ok: false
if msg.get("params").get("textDocument").get("uri").as_string().equals("file:///a.scaly") = false
    set ok: false
let pos msg.get("params").get("position")
if pos.get("line").as_i64() <> 3 or pos.get("character").as_i64() <> 14
    set ok: false
; missing members and wrong kinds
if msg.get("nope").is_null() = false or msg.get("nope").get("deeper").as_string().length <> 0
    set ok: false
if msg.get("id").as_string().length <> 0 or msg.get("method").as_i64() <> 0 or msg.get("id").length() <> 0
    set ok: false
let flags msg.get("flags")
if flags.is_array() = false or flags.length() <> 3 or flags.item(0).as_bool() = false
    set ok: false
if flags.item(1).is_bool() = false or flags.item(1).as_bool() or flags.item(2).is_null() = false or flags.item(3).is_null() = false
    set ok: false
if msg.has("params") = false or msg.has("nope") or msg.is_object() = false
    set ok: false
if ok
    Console.print "access "

let nums JsonValue.parse("[1.50, -0, 9223372036854775807, -9223372036854775808, 9223372036854775808, -9223372036854775809, 1e3, 2.5, 12345678901234567890123]").value
if nums.item(0).number_text().equals("1.50") = false or nums.item(0).is_integer()
    set ok: false
if nums.item(1).is_integer() = false or nums.item(1).as_i64() <> 0
    set ok: false
if nums.item(2).is_integer() = false or nums.item(2).as_i64() <> 9223372036854775807
    set ok: false
if nums.item(3).is_integer() = false or nums.item(3).as_i64() + 1 <> 0 - 9223372036854775807
    set ok: false
if nums.item(4).is_integer() or nums.item(4).as_i64() <> 0 or nums.item(5).is_integer()
    set ok: false
if nums.item(6).is_integer() or nums.item(6).as_f64() <> 1000.0 or nums.item(7).as_f64() <> 2.5
    set ok: false
if nums.item(8).number_text().equals("12345678901234567890123") = false or nums.item(8).is_integer()
    set ok: false
if nums.item(0).as_f64() <> 1.5 or nums.item(0).is_number() = false or nums.item(0).is_text()
    set ok: false
if ok
    Console.print "numbers "

let obj JsonValue.parse("{\"z\":1,\"a\":2,\"m\":3,\"a\":4}").value
if obj.length() <> 4 or obj.key_at(0).equals(String("z")) = false or obj.key_at(3).equals(String("a")) = false
    set ok: false
if obj.value_at(2).as_i64() <> 3 or obj.get("a").as_i64() <> 2 or obj.key_at(9).length <> 0
    set ok: false
if ok
    Console.print "order "

let bad JsonValue.parse("{\"a\": [1, 2,, 3]}")
if bad.ok() or bad.error <> 3 or bad.offset <> 12 or bad.value.is_null() = false
    set ok: false
if bad.message().equals("a value was expected") = false
    set ok: false
if JsonValue.parse("[1] [2]").ok() or JsonValue.parse("").ok() or JsonValue.parse(" null ").ok() = false
    set ok: false
if ok
    Console.print "refuse "

var sb StringBuilder()
sb.append("[")
var i: size_t 0
while i < 2000
{
    if i > 0
        sb.append(",")
    sb.append("{\"id\":")
    sb.append(i)
    sb.append(",\"name\":\"item ")
    sb.append(i)
    sb.append("\",\"tags\":[\"a\",\"b\"]}")
    set i: i + 1
}
sb.append("]")
let big_text sb.to_string()
let big JsonValue.parse(big_text.as_slice())
if big.ok() = false or big.value.length() <> 2000
    set ok: false
else
{
    set i: 0
    while i < 2000
    {
        let it big.value.item(i)
        if it.get("id").as_i64() <> (i as i64) or it.get("tags").item(1).as_string().equals(String("b")) = false
            set ok: false
        set i: i + 1
    }
    if big.value.item(1999).get("name").as_string().equals("item 1999") = false
        set ok: false
}
if ok
    Console.print "big "

if ok
    Console.print "done"
