; The json package's writer (ROADMAP-http.md stage B):
;   build    objects, arrays, nesting and empty containers: the commas and
;            colons are the writer's business
;   escape   quote, backslash, the named escapes, \u00XX for the other
;            control characters; UTF-8 passes through
;   integer  0, both i64 limits
;   round    parse, write, compare: the canonical text comes back byte for
;            byte, a decimal's trailing zero and an exponent included
;   grow     4 KB of output: the buffer outgrows the bump range into its
;            own page
;   string   quote and stringify, the StringBuilder forms: the same text
;   blocks   the in-place path around its 16-byte steps: every length 0 to
;            40, plain and with a quote, a backslash, a line feed or 0x01 at
;            every position, and a two-byte UTF-8 character -- the same text
;            as the StringBuilder form, in a writer that already holds text
;   verbatim parsed strings written back unlooked-at, sixteen bytes a step:
;            every length 0 to 40 as the whole document (its last byte is
;            the document's, the step reads into the padding), in an array
;            and as a member name, and a number of 1 to 40 digits alone and in
;            an array -- byte for byte the source
; Expected: build escape integer round grow string blocks verbatim done

package scaly 0.1.0
package json 0.1.0

use json.Value.JsonValue
use json.Value.JsonParsed
use json.Writer.JsonWriter

; the blocks case's bytes: a plain one, then the ones that need care
define SPECIALS: u8[] [0x61, 0x22, 0x5C, 0x0A, 0x01, 0xC3]

procedure same(w: ref[JsonWriter], want: Slice[u8]) returns bool
{
    let got w.bytes()
    if got.equals(want)
        return true
    print "  got  `String(got.data as pointer[const_char], got.length)`"
    print "  want `String(want.data as pointer[const_char], want.length)`"
    false
}

var ok true
var w JsonWriter()

w.begin_object()
w.key("id")
w.integer(7)
w.key("name")
w.text("Widget")
w.key("tags")
w.begin_array()
w.text("a")
w.text("b")
w.end_array()
w.key("empty")
w.begin_object()
w.end_object()
w.key("none")
w.begin_array()
w.end_array()
w.key("nested")
w.begin_array()
w.begin_object()
w.key("x")
w.boolean(true)
w.end_object()
w.begin_object()
w.key("y")
w.null_value()
w.end_object()
w.end_array()
w.key("price")
w.number("1.50")
w.key("raw")
w.raw("[1,2]")
w.end_object()
if same(&w, "{\"id\":7,\"name\":\"Widget\",\"tags\":[\"a\",\"b\"],\"empty\":{},\"none\":[],\"nested\":[{\"x\":true},{\"y\":null}],\"price\":1.50,\"raw\":[1,2]}") = false
    set ok: false
if ok
    Console.print "build "

; the bytes Scaly has no escape for, appended by value
var sb StringBuilder()
sb.append("q\"b\\s/n\nr\rt\tb")
sb.append(0x08 as char)
sb.append("f")
sb.append(0x0C as char)
let first sb.to_string()
var sb2 StringBuilder()
sb2.append(0x01 as char)
sb2.append(0x1F as char)
sb2.append(0x7F as char)
sb2.append(" é")
let second sb2.to_string()
w.clear()
w.begin_array()
w.text(first.as_slice())
w.text(second.as_slice())
w.end_array()
let w_escape_first String("\"q\\\"b\\\\s/n\\nr\\rt\\tb\\bf\\f\"")
var want StringBuilder()
want.append("[\"q\\\"b\\\\s/n\\nr\\rt\\tb\\bf\\f\",\"\\u0001\\u001f")
want.append(0x7F as char)
want.append(" é\"]")
let want_text want.to_string()
if same(&w, want_text.as_slice()) = false
    set ok: false
if ok
    Console.print "escape "

w.clear()
w.begin_array()
w.integer(0)
w.integer(0 - 1)
w.integer(9223372036854775807)
w.integer((0 - 9223372036854775807) - 1)
w.end_array()
if same(&w, "[0,-1,9223372036854775807,-9223372036854775808]") = false
    set ok: false
if ok
    Console.print "integer "

let canonical "{\"a\":[1,-2.50,3e+7,true,false,null],\"b\":{\"c\":\"\\u0001\\\"\\n\",\"d\":[]},\"e\":\"é\"}"
let parsed JsonValue.parse(canonical.as_slice())
w.clear()
w.value(parsed.value)
if parsed.ok() = false or same(&w, canonical.as_slice()) = false
    set ok: false
; nesting, empty containers at every position, scalar documents
var shapes List[String]()
shapes.add(String("[[],{},[{}],{\"a\":[]},{\"a\":{\"b\":[1,[2,[]]]}},[[[[]]]]]"))
shapes.add(String("{\"x\":{},\"y\":[],\"z\":{\"w\":{\"v\":[{},[],null]}}}"))
shapes.add(String("[]"))
shapes.add(String("{}"))
shapes.add(String("7"))
shapes.add(String("\"s\""))
shapes.add(String("[true]"))
var shape_it shapes.get_iterator()
while let shape shape_it.next()
{
    let sp JsonValue.parse(shape.as_slice())
    w.clear()
    w.value(sp.value)
    if sp.ok() = false or same(&w, shape.as_slice()) = false
    {
        print "  round: `w.to_string()`"
        set ok: false
    }
}
; a tree as an element among others, and as a member's value
let inner JsonValue.parse("{\"a\":[1,{}]}").value
w.clear()
w.begin_array()
w.value(inner)
w.integer(2)
w.value(inner)
w.end_array()
if same(&w, "[{\"a\":[1,{}]},2,{\"a\":[1,{}]}]") = false
    set ok: false
w.clear()
w.begin_object()
w.key("k")
w.value(inner)
w.key("z")
w.value(inner)
w.end_object()
if same(&w, "{\"k\":{\"a\":[1,{}]},\"z\":{\"a\":[1,{}]}}") = false
    set ok: false
if ok
    Console.print "round "

var small JsonWriter()
small.begin_array()
var i: i64 0
while i < 1000
{
    small.integer(i)
    set i: i + 1
}
small.end_array()
let back JsonValue.parse(small.bytes())
if back.ok() = false or back.value.length() <> 1000 or back.value.item(999).as_i64() <> 999
    set ok: false
if small.to_string().length() <> 3891
    set ok: false
if ok
    Console.print "grow "

let quoted JsonWriter.quote(first.as_slice())
if quoted.as_slice().equals(w_escape_first.as_slice()) = false
    set ok: false
if JsonWriter.stringify(parsed.value).equals(canonical) = false
    set ok: false
if ok
    Console.print "string "

var blocks_ok true
var n: size_t 0
while n <= 40
{
    var at: size_t 0
    while at <= n
    {
        var k: size_t 0
        while k < 6
        {
            ; n bytes of 'b' with SPECIALS[k] at `at` (none when at = n);
            ; 0xC3 is followed by 0xA9, a whole character
            var sb StringBuilder()
            var j: size_t 0
            while j < n
            {
                if j = at
                {
                    sb.append(SPECIALS[k] as char)
                    if SPECIALS[k] = 0xC3
                        sb.append(0xA9 as char)
                }
                else
                    sb.append("b")
                set j: j + 1
            }
            let text sb.to_string()
            var w JsonWriter()
            w.begin_array()
            w.text("x".as_slice())
            w.text(text.as_slice())
            w.end_array()
            var want StringBuilder()
            want.append("[\"x\",")
            want.append(JsonWriter.quote(text.as_slice()))
            want.append("]")
            if w.to_string().equals(want.to_string()) = false
            {
                print "  blocks: length `n`, special `k` at `at`: `w.to_string()`"
                set blocks_ok: false
            }
            set k: k + 1
        }
        set at: at + 1
    }
    set n: n + 1
}
if blocks_ok = false
    set ok: false
if ok
    Console.print "blocks "

var verbatim_ok true
set n: 0
while n <= 40
{
    var body StringBuilder()
    var j: size_t 0
    while j < n
    {
        ; bytes that differ, so a step that lands wrong shows
        body.append(((0x61 + (j % 26)) as u8) as char)
        set j: j + 1
    }
    let b body.to_string()
    ; n digits, none leading zero
    var digits StringBuilder()
    set j: 0
    while j < n
    {
        digits.append((((0x31 + (j % 9)) as u8) as char))
        set j: j + 1
    }
    let d digits.to_string()
    var k: size_t 0
    while k < 5
    {
        var doc StringBuilder()
        if k = 0
            doc.append("\"`b`\"")
        if k = 1
            doc.append("[\"`b`\",\"`b`\"]")
        if k = 2
            doc.append("{\"`b`\":\"`b`\"}")
        if k = 3
            doc.append(d)
        if k = 4
            doc.append("[`d`,`d`]")
        if n = 0 and k >= 3
        {
            set k: k + 1
            continue
        }
        let source doc.to_string()
        let parsed JsonValue.parse(source.as_slice())
        var w JsonWriter()
        w.value(parsed.value)
        if parsed.ok() = false or w.to_string().equals(source) = false
        {
            print "  verbatim: length `n` form `k`: `w.to_string()`"
            set verbatim_ok: false
        }
        set k: k + 1
    }
    set n: n + 1
}
if verbatim_ok = false
    set ok: false
if ok
    Console.print "verbatim "

if ok
    Console.print "done"
