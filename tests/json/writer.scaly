; The json package's writer (ROADMAP-http.md stage B):
;   build    objects, arrays, nesting and empty containers: the commas and
;            colons are the writer's business
;   escape   quote, backslash, the named escapes, \u00XX for the other
;            control characters; UTF-8 passes through
;   integer  0, both i64 limits
;   round    parse, write, compare: the canonical text comes back byte for
;            byte, a decimal's trailing zero and an exponent included
;   grow     4 KB of output: the buffer outgrows the bump range into its
;            own page
;   string   quote and stringify, the StringBuilder forms: the same text
;   blocks   the in-place path around its 16-byte steps: every length 0 to
;            40, plain and with a quote, a backslash, a line feed or 0x01 at
;            every position, and a two-byte UTF-8 character -- the same text
;            as the StringBuilder form, in a writer that already holds text
; Expected: build escape integer round grow string blocks done

package scaly 0.1.0
package json 0.1.0

use json.Value.JsonValue
use json.Value.JsonParsed
use json.Writer.JsonWriter

; the blocks case's bytes: a plain one, then the ones that need care
define SPECIALS: u8[] [0x61, 0x22, 0x5C, 0x0A, 0x01, 0xC3]

procedure same(w: ref[JsonWriter], want: Slice[u8]) returns bool
{
    let got w.bytes()
    if got.equals(want)
        return true
    print "  got  `String(got.data as pointer[const_char], got.length)`"
    print "  want `String(want.data as pointer[const_char], want.length)`"
    false
}

var ok true
var w JsonWriter()

w.begin_object()
w.key("id")
w.integer(7)
w.key("name")
w.text("Widget")
w.key("tags")
w.begin_array()
w.text("a")
w.text("b")
w.end_array()
w.key("empty")
w.begin_object()
w.end_object()
w.key("none")
w.begin_array()
w.end_array()
w.key("nested")
w.begin_array()
w.begin_object()
w.key("x")
w.boolean(true)
w.end_object()
w.begin_object()
w.key("y")
w.null_value()
w.end_object()
w.end_array()
w.key("price")
w.number("1.50")
w.key("raw")
w.raw("[1,2]")
w.end_object()
if same(&w, "{\"id\":7,\"name\":\"Widget\",\"tags\":[\"a\",\"b\"],\"empty\":{},\"none\":[],\"nested\":[{\"x\":true},{\"y\":null}],\"price\":1.50,\"raw\":[1,2]}") = false
    set ok: false
if ok
    Console.print "build "

; the bytes Scaly has no escape for, appended by value
var sb StringBuilder()
sb.append("q\"b\\s/n\nr\rt\tb")
sb.append(0x08 as char)
sb.append("f")
sb.append(0x0C as char)
let first sb.to_string()
var sb2 StringBuilder()
sb2.append(0x01 as char)
sb2.append(0x1F as char)
sb2.append(0x7F as char)
sb2.append(" é")
let second sb2.to_string()
w.clear()
w.begin_array()
w.text(first.as_slice())
w.text(second.as_slice())
w.end_array()
let w_escape_first String("\"q\\\"b\\\\s/n\\nr\\rt\\tb\\bf\\f\"")
var want StringBuilder()
want.append("[\"q\\\"b\\\\s/n\\nr\\rt\\tb\\bf\\f\",\"\\u0001\\u001f")
want.append(0x7F as char)
want.append(" é\"]")
let want_text want.to_string()
if same(&w, want_text.as_slice()) = false
    set ok: false
if ok
    Console.print "escape "

w.clear()
w.begin_array()
w.integer(0)
w.integer(0 - 1)
w.integer(9223372036854775807)
w.integer((0 - 9223372036854775807) - 1)
w.end_array()
if same(&w, "[0,-1,9223372036854775807,-9223372036854775808]") = false
    set ok: false
if ok
    Console.print "integer "

let canonical "{\"a\":[1,-2.50,3e+7,true,false,null],\"b\":{\"c\":\"\\u0001\\\"\\n\",\"d\":[]},\"e\":\"é\"}"
let parsed JsonValue.parse(canonical.as_slice())
w.clear()
w.value(parsed.value)
if parsed.ok() = false or same(&w, canonical.as_slice()) = false
    set ok: false
if ok
    Console.print "round "

var small JsonWriter()
small.begin_array()
var i: i64 0
while i < 1000
{
    small.integer(i)
    set i: i + 1
}
small.end_array()
let back JsonValue.parse(small.bytes())
if back.ok() = false or back.value.length() <> 1000 or back.value.item(999).as_i64() <> 999
    set ok: false
if small.to_string().length() <> 3891
    set ok: false
if ok
    Console.print "grow "

let quoted JsonWriter.quote(first.as_slice())
if quoted.as_slice().equals(w_escape_first.as_slice()) = false
    set ok: false
if JsonWriter.stringify(parsed.value).equals(canonical) = false
    set ok: false
if ok
    Console.print "string "

var blocks_ok true
var n: size_t 0
while n <= 40
{
    var at: size_t 0
    while at <= n
    {
        var k: size_t 0
        while k < 6
        {
            ; n bytes of 'b' with SPECIALS[k] at `at` (none when at = n);
            ; 0xC3 is followed by 0xA9, a whole character
            var sb StringBuilder()
            var j: size_t 0
            while j < n
            {
                if j = at
                {
                    sb.append(SPECIALS[k] as char)
                    if SPECIALS[k] = 0xC3
                        sb.append(0xA9 as char)
                }
                else
                    sb.append("b")
                set j: j + 1
            }
            let text sb.to_string()
            var w JsonWriter()
            w.begin_array()
            w.text("x".as_slice())
            w.text(text.as_slice())
            w.end_array()
            var want StringBuilder()
            want.append("[\"x\",")
            want.append(JsonWriter.quote(text.as_slice()))
            want.append("]")
            if w.to_string().equals(want.to_string()) = false
            {
                print "  blocks: length `n`, special `k` at `at`: `w.to_string()`"
                set blocks_ok: false
            }
            set k: k + 1
        }
        set at: at + 1
    }
    set n: n + 1
}
if blocks_ok = false
    set ok: false
if ok
    Console.print "blocks "

if ok
    Console.print "done"
