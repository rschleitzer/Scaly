; 5.1 op kernel: row-wise f32 softmax (max-subtracted for numerical
; stability). Parallel over rows: reads through pointer subscripts
; (x.data, out.data are read-only aliases — write masks admit), writes
; via disjoint out.put slots derived from the loop variable. expf is a
; whitelisted benign extern.
; Expected: PASS

function expf(x: float) returns float extern

procedure softmax_f32(x: Vector[float], mutable out: Vector[float], rows: int, n: int)
{
    let xp x.data
    let op out.data
    for r in rows
    {
        var mx xp[r * n]
        var j 1
        while j < n
        {
            let v xp[r * n + j]
            if v > mx
                mx := v
            j := j + 1
        }
        var sum: float 0.0
        var j2 0
        while j2 < n
        {
            let e expf(xp[r * n + j2] - mx)
            out.put((r * n + j2) as size_t, e)
            sum := sum + e
            j2 := j2 + 1
        }
        let inv 1.0 / sum
        var j3 0
        while j3 < n
        {
            out.put((r * n + j3) as size_t, op[r * n + j3] * inv)
            j3 := j3 + 1
        }
    }
}

var ok true

; Row 0: [1,2,3] -> [0.090031, 0.244728, 0.665241]; row 1: [0,0,0] -> 1/3.
var x Vector[float](6)
x.put(0, 1.0)
x.put(1, 2.0)
x.put(2, 3.0)
x.put(3, 0.0)
x.put(4, 0.0)
x.put(5, 0.0)
var out Vector[float](6)
softmax_f32(x, out, 2, 3)

let p out.data
if (p[0] > 0.0899) = false
    ok := false
if (p[0] < 0.0901) = false
    ok := false
if (p[1] > 0.2446) = false
    ok := false
if (p[1] < 0.2449) = false
    ok := false
if (p[2] > 0.6651) = false
    ok := false
if (p[2] < 0.6654) = false
    ok := false

; Each row sums to 1.
let s0 p[0] + p[1] + p[2]
if (s0 > 0.9999) = false
    ok := false
if (s0 < 1.0001) = false
    ok := false
let s1 p[3] + p[4] + p[5]
if (s1 > 0.9999) = false
    ok := false
if (s1 < 1.0001) = false
    ok := false
if (p[3] > 0.3332) = false
    ok := false
if (p[3] < 0.3335) = false
    ok := false

; Numerical stability: a large-magnitude row must not overflow.
var xb Vector[float](3)
xb.put(0, 1000.0)
xb.put(1, 1001.0)
xb.put(2, 1002.0)
var outb Vector[float](3)
softmax_f32(xb, outb, 1, 3)
let pb outb.data
let sb pb[0] + pb[1] + pb[2]
if (sb > 0.9999) = false
    ok := false
if (sb < 1.0001) = false
    ok := false
if (pb[2] > 0.6651) = false
    ok := false
if (pb[2] < 0.6654) = false
    ok := false

if ok
    print("PASS")
else
    print("FAIL")
