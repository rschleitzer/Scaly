; 5.2 autodiff: end-to-end gradient through a 2-layer block —
; x(4x8) -> matmul W1(8x16) -> GELU -> matmul W2(16x8) ->
; layernorm(gamma, beta) -> softmax -> wsum. Every parameter and the
; input gradient is gradchecked against a central difference, so a
; wrong adjoint anywhere in the chain (or a wrong accumulation across
; ops) fails. Weight scales are kept small so activations stay in the
; well-conditioned range of the f32 numeric check.
; Expected: PASS

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function tval(i: int) returns float
{
    let r pmod(i * 7 + 3, 11)
    ((r - 5) as float) * 0.25
}

function wval(i: int) returns float
{
    let r pmod(i * 5 + 2, 7)
    ((r - 3) as float) * 0.3 + 0.1
}

function close_enough(a: float, b: float, atol: float, rtol: float) returns bool
{
    var d a - b
    if d < 0.0
        set d: 0.0 - d
    var m a
    if m < 0.0
        set m: 0.0 - m
    var mb b
    if mb < 0.0
        set mb: 0.0 - mb
    if mb > m
        set m: mb
    if d <= atol + rtol * m
        return true
    false
}

procedure num_grad(tape: Tape, out: int, id: int, i: int, h: float) returns float
{
    let orig tape.value_at(id, i)
    tape.set_value(id, i, orig + h)
    tape.recompute()
    let fp tape.value_at(out, 0)
    tape.set_value(id, i, orig - h)
    tape.recompute()
    let fm tape.value_at(out, 0)
    tape.set_value(id, i, orig)
    tape.recompute()
    (fp - fm) / (2.0 * h)
}

procedure check_leaf(tape: Tape, out: int, id: int, count: int, h: float, atol: float, rtol: float, minmax: float) returns bool
{
    var good true
    var maxabs: float 0.0
    var i 0
    while i < count
    {
        let ga tape.grad_at(id, i)
        let gn num_grad(tape, out, id, i, h)
        if close_enough(ga, gn, atol, rtol) = false
            set good: false
        var mag ga
        if mag < 0.0
            set mag: 0.0 - mag
        if mag > maxabs
            set maxabs: mag
        set i: i + 1
    }
    if maxabs < minmax
        set good: false
    good
}

var ok true

var tape Tape()
let x tape.leaf(4, 8)
var i 0
while i < 32
{
    let v tval(i)
    tape.set_value(x, i, v)
    set i: i + 1
}
let w1 tape.leaf(8, 16)
var i2 0
while i2 < 128
{
    let v tval(i2 + 5) * 0.5
    tape.set_value(w1, i2, v)
    set i2: i2 + 1
}
let w2 tape.leaf(16, 8)
var i3 0
while i3 < 128
{
    let v tval(i3 + 11) * 0.35
    tape.set_value(w2, i3, v)
    set i3: i3 + 1
}
let gamma tape.leaf(1, 8)
let beta tape.leaf(1, 8)
var i4 0
while i4 < 8
{
    let vg 1.0 + tval(i4) * 0.2
    tape.set_value(gamma, i4, vg)
    let vb tval(i4 + 7) * 0.3
    tape.set_value(beta, i4, vb)
    set i4: i4 + 1
}

let h1 tape.matmul(x, w1)
let g1 tape.gelu(h1)
let h2 tape.matmul(g1, w2)
let ln tape.layernorm(h2, gamma, beta, 0.00001)
let sm tape.softmax(ln)
var w Vector[float](32)
var i5 0
while i5 < 32
{
    let v wval(i5)
    w.put(i5 as size_t, v)
    set i5: i5 + 1
}
let s tape.wsum(sm, w)
tape.backward s

if check_leaf(tape, s, x, 32, 0.02, 0.003, 0.05, 0.0005) = false
{
    print("FAIL block x")
    set ok: false
}
if check_leaf(tape, s, w1, 128, 0.02, 0.003, 0.05, 0.0001) = false
{
    print("FAIL block w1")
    set ok: false
}
if check_leaf(tape, s, w2, 128, 0.02, 0.003, 0.05, 0.0001) = false
{
    print("FAIL block w2")
    set ok: false
}
if check_leaf(tape, s, gamma, 8, 0.02, 0.003, 0.05, 0.0005) = false
{
    print("FAIL block gamma")
    set ok: false
}
if check_leaf(tape, s, beta, 8, 0.02, 0.003, 0.05, 0.0005) = false
{
    print("FAIL block beta")
    set ok: false
}

if ok
    print("PASS")
else
    print("FAIL")
