; Stage-6 bridge autodiff: batched/windowed attention + broadcast add.
; tape.attention_windowed(q,k,v,hs,win) applies causal attention WITHIN
; each window of `win` rows (a query never attends across a window
; boundary); tape.add_bcast(x,y) adds a shared y block to every window
; of x. Both gradchecked against central differences on a wsum
; objective; windowing is asserted directly: the first row of EACH
; window sees only its own key, so out row = v row there.
; Expected: PASS

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function tval(i: int) returns float
{
    let r pmod(i * 7 + 3, 11)
    ((r - 5) as float) * 0.25
}

function wval(i: int) returns float
{
    let r pmod(i * 5 + 2, 7)
    ((r - 3) as float) * 0.3 + 0.1
}

function close_enough(a: float, b: float, atol: float, rtol: float) returns bool
{
    var d a - b
    if d < 0.0
        d := 0.0 - d
    var m a
    if m < 0.0
        m := 0.0 - m
    var mb b
    if mb < 0.0
        mb := 0.0 - mb
    if mb > m
        m := mb
    if d <= atol + rtol * m
        return true
    false
}

procedure num_grad(mutable tape: Tape, out: int, id: int, i: int, h: float) returns float
{
    let orig tape.value_at(id, i)
    tape.set_value(id, i, orig + h)
    tape.recompute()
    let fp tape.value_at(out, 0)
    tape.set_value(id, i, orig - h)
    tape.recompute()
    let fm tape.value_at(out, 0)
    tape.set_value(id, i, orig)
    tape.recompute()
    (fp - fm) / (2.0 * h)
}

procedure check_leaf(mutable tape: Tape, out: int, id: int, count: int, h: float, atol: float, rtol: float) returns bool
{
    var good true
    var maxabs: float 0.0
    var i 0
    while i < count
    {
        let ga tape.grad_at(id, i)
        let gn num_grad(tape, out, id, i, h)
        if close_enough(ga, gn, atol, rtol) = false
            good := false
        var mag ga
        if mag < 0.0
            mag := 0.0 - mag
        if mag > maxabs
            maxabs := mag
        i := i + 1
    }
    if maxabs < 0.0005
        good := false
    good
}

var ok true

; --- windowed attention: 4 rows = 2 windows of 2, two heads, dim 4 ---
{
    var tape Tape()
    let q tape.leaf(4, 4)
    let k tape.leaf(4, 4)
    let v tape.leaf(4, 4)
    var i 0
    while i < 16
    {
        tape.set_value(q, i, tval(i + 1))
        tape.set_value(k, i, tval(i + 4))
        tape.set_value(v, i, tval(i + 8))
        i := i + 1
    }
    let att tape.attention_windowed(q, k, v, 2, 2)
    var w Vector[float](16)
    var j 0
    while j < 16
    {
        w.put(j as size_t, wval(j + 1))
        j := j + 1
    }
    let s tape.wsum(att, w)
    tape.backward s
    var good check_leaf(tape, s, q, 16, 0.02, 0.005, 0.02)
    if check_leaf(tape, s, k, 16, 0.02, 0.005, 0.02) = false
        good := false
    if check_leaf(tape, s, v, 16, 0.02, 0.005, 0.02) = false
        good := false
    ; window boundary: row 0 and row 2 each open a window, so each sees
    ; only its own key -> out row == v row
    var c 0
    while c < 4
    {
        let ov0 tape.value_at(att, 0 * 4 + c)
        let vv0 tape.value_at(v, 0 * 4 + c)
        if close_enough(ov0, vv0, 0.00001, 0.00001) = false
            good := false
        let ov2 tape.value_at(att, 2 * 4 + c)
        let vv2 tape.value_at(v, 2 * 4 + c)
        if close_enough(ov2, vv2, 0.00001, 0.00001) = false
            good := false
        c := c + 1
    }
    if good = false
    {
        print("FAIL windowed")
        ok := false
    }
}

; --- broadcast add: x 4x3, y 2x3, out row i = x[i] + y[i mod 2] ---
{
    var tape Tape()
    let x tape.leaf(4, 3)
    let y tape.leaf(2, 3)
    var i 0
    while i < 12
    {
        tape.set_value(x, i, tval(i + 2))
        i := i + 1
    }
    var i2 0
    while i2 < 6
    {
        tape.set_value(y, i2, tval(i2 + 9))
        i2 := i2 + 1
    }
    let sumn tape.add_bcast(x, y)
    var w Vector[float](12)
    var j 0
    while j < 12
    {
        w.put(j as size_t, wval(j + 3))
        j := j + 1
    }
    let s tape.wsum(sumn, w)
    tape.backward s
    var good check_leaf(tape, s, x, 12, 0.02, 0.005, 0.02)
    if check_leaf(tape, s, y, 6, 0.02, 0.005, 0.02) = false
        good := false
    ; value check: out row i equals x row i + y row (i mod 2)
    var r 0
    while r < 4
    {
        var c 0
        while c < 3
        {
            let ov tape.value_at(sumn, r * 3 + c)
            let xv tape.value_at(x, r * 3 + c)
            let yv tape.value_at(y, pmod(r, 2) * 3 + c)
            if close_enough(ov, xv + yv, 0.00001, 0.00001) = false
                good := false
            c := c + 1
        }
        r := r + 1
    }
    if good = false
    {
        print("FAIL bcast")
        ok := false
    }
}

if ok
    print("PASS")
else
    print("FAIL")
