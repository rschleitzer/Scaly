; Stage-5 milestone 5.3: training-step throughput of the bigram-MLP
; trainer (embedding -> matmul -> GELU -> matmul -> fused
; softmax-crossentropy, Adam on all three parameter leaves) on
; synthetic tokens at the demo-relevant shape. steps/s is the 5.3
; gate metric. The tape kernels live in libscaly.a, so they run at
; the ARCHIVE's opt level (-O2 since 5.3), not this program's.

function scaly_eio_now_ns() returns i64 extern

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function lcg(s: int) returns int
    pmod(s * 1103515245 + 12345, 2147483648)

function num_to_string(n: i64) returns String
{
    if n = 0
        return "0"
    var value n
    var digits Array[char]()
    while value > 0
    {
        let digit ((value % 10) as char) + (48 as char)
        digits.add digit
        set value: value / 10
    }
    var sb StringBuilder()
    var i digits.length
    while i > 0
    {
        set i: i - 1
        let d digits.get i
        if d <> null
            sb.append(*d)
    }
    sb.to_string()
}

procedure run_steps(mutable tape: Tape, emb: int, loss: int, table: int, w1: int, w2: int, count: int, base: int) returns int
{
    var s 777
    var step 1
    while step <= count
    {
        var b 0
        while b < 128
        {
            set s: lcg(s)
            let tok pmod(s, 96)
            tape.set_token(emb, b, tok as i64)
            set s: lcg(s)
            let tgt pmod(s, 96)
            tape.set_token(loss, b, tgt as i64)
            set b: b + 1
        }
        tape.recompute()
        tape.zero_grads()
        tape.backward loss
        let t base + step
        tape.adam_step(table, 0.01, 0.9, 0.999, 0.00000001, t)
        tape.adam_step(w1, 0.01, 0.9, 0.999, 0.00000001, t)
        tape.adam_step(w2, 0.01, 0.9, 0.999, 0.00000001, t)
        set step: step + 1
    }
    count
}

let V 96
let D 32
let H 64
let B 128
var tape Tape()
let table tape.leaf(V, D)
let w1 tape.leaf(D, H)
let w2 tape.leaf(H, V)
var s 42
var i 0
while i < V * D
{
    set s: lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(table, i, rv)
    set i: i + 1
}
var i2 0
while i2 < D * H
{
    set s: lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(w1, i2, rv)
    set i2: i2 + 1
}
var i3 0
while i3 < H * V
{
    set s: lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(w2, i3, rv)
    set i3: i3 + 1
}
let bsz B as size_t
var ids Vector[i64](bsz)
let emb tape.embedding(table, ids, B)
let h1 tape.matmul(emb, w1)
let a1 tape.gelu(h1)
let logits tape.matmul(a1, w2)
var tgs Vector[i64](bsz)
let loss tape.crossentropy(logits, tgs)


; warmup (promotion settles), then the timed run
run_steps(tape, emb, loss, table, w1, w2, 20, 0)
let t0 scaly_eio_now_ns()
let timed run_steps(tape, emb, loss, table, w1, w2, 100, 20)
let t1 scaly_eio_now_ns()
let ns t1 - t0
var sps 0 as i64
if ns > 0
    set sps: ((timed as i64) * 1000000000) / ns
var sb StringBuilder()
sb.append "train_step B128 D32 H64 V96: "
let str num_to_string(sps)
sb.append str
sb.append " steps/s"
let line sb.to_string()
Console.println(line.to_c_string())
