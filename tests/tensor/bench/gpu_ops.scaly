; Stage-6 GPU op parity, through the scalygpu package (milestone 6.2;
; the 6.1 hand-rolled driver now lives there as the GpuTape concept).
; A mini transformer graph (embedding with DUPLICATE token ids,
; add_bcast, layernorm, matmul, windowed attention, add, gelu,
; crossentropy) runs once on the CPU tape (the reference), then
; GpuTape.attach redirects the tape's buffers into shared MTLBuffers
; (unified memory: the CPU keeps reading through the same pointers)
; and the whole step - forward, gradient zeroing, seed, backward - is
; encoded as ONE command buffer per variant:
;   1. MPS GEMMs + MSL long-tail kernels (the hybrid 6.0 decided on)
;   2. MSL matmul kernels only (the single-encoder variant)
; plus a two-tape Adam parity check through GpuTape.step_adam. GPU
; reductions are NOT bit-identical to the CPU (order) - every gate is
; a tolerance, and attach ZEROES op output buffers so a silently
; no-op kernel cannot inherit the CPU result (the 6.0 lesson).
;
; Run via tests/tensor/bench/run_gpu_ops.sh (darwin-only; SKIPs off
; macOS / without a Metal device).

package scalygpu 0.1.0

use scalygpu.gputape.GpuTape

function exit(code: int) extern

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function lcg(s: int) returns int
    pmod(s * 1103515245 + 12345, 2147483648)

function num_to_string(n: i64) returns String
{
    if n = 0
        return "0"
    var value n
    var digits Array[char]()
    while value > 0
    {
        let digit ((value % 10) as char) + (48 as char)
        digits.add digit
        value := value / 10
    }
    var sb StringBuilder()
    var i digits.length
    while i > 0
    {
        i := i - 1
        let d digits.get i
        if d <> null
            sb.append(*d)
    }
    sb.to_string()
}

; positive-range fixed-point, 6 decimals (for max-abs-diff)
function fixed6(f: float) returns String
{
    var ok false
    if f >= 0.0
        if f < 1000.0
            ok := true
    if ok = false
        return "nan"
    let m ((f * 1000000.0) + 0.5) as int
    let ip m / 1000000
    let fr m - ip * 1000000
    var sb StringBuilder()
    let istr num_to_string(ip as i64)
    sb.append istr
    sb.append "."
    var scale 100000
    while scale > 0
    {
        let d fr / scale % 10
        let dstr num_to_string(d as i64)
        sb.append dstr
        scale := scale / 10
    }
    sb.to_string()
}

procedure fill(mutable tape: Tape, id: int, count: int, s0: int) returns int
{
    var s s0
    var i 0
    while i < count
    {
        s := lcg(s)
        let r pmod(s, 2001) - 1000
        let rv (r as float) * 0.0001
        tape.set_value(id, i, rv)
        i := i + 1
    }
    s
}

procedure fill_const(mutable tape: Tape, id: int, count: int, v: float)
{
    var i 0
    while i < count
    {
        tape.set_value(id, i, v)
        i := i + 1
    }
}

function maxdiff_ptr(a: pointer[float], b: pointer[float], count: int) returns float
{
    var md: float 0.0
    var i 0
    while i < count
    {
        var d a[i] - b[i]
        if d < 0.0
            d := 0.0 - d
        if d > md
            md := d
        i := i + 1
    }
    md
}

; --- device check (attach without a device is a LOUD error by
; design; the portable SKIP is this explicit check) ---
if GpuTape.available() = 0
{
    Console.println("SKIP: no Metal device")
    exit(0)
}

; --- the mini transformer graph (every trainer op) ---
let V 12
let D 8
let T 8
let B 2
let TT B * T
let F 16
let HEADS 2
var tape Tape()
let table tape.leaf(V, D)
let posemb tape.leaf(T, D)
let g1 tape.leaf(1, D)
let b1 tape.leaf(1, D)
let wq tape.leaf(D, D)
let wk tape.leaf(D, D)
let wv tape.leaf(D, D)
let wo tape.leaf(D, D)
let g2 tape.leaf(1, D)
let b2 tape.leaf(1, D)
let wf tape.leaf(D, F)
let wp tape.leaf(F, D)
let gf tape.leaf(1, D)
let bf tape.leaf(1, D)
let whead tape.leaf(D, V)

var s 42
s := fill(tape, table, V * D, s)
s := fill(tape, posemb, T * D, s)
s := fill(tape, wq, D * D, s)
s := fill(tape, wk, D * D, s)
s := fill(tape, wv, D * D, s)
s := fill(tape, wo, D * D, s)
s := fill(tape, wf, D * F, s)
s := fill(tape, wp, F * D, s)
s := fill(tape, whead, D * V, s)
fill_const(tape, g1, D, 1.0)
fill_const(tape, g2, D, 1.0)
fill_const(tape, gf, D, 1.0)

; token ids with guaranteed DUPLICATES (scatter-add collision check)
var ids Vector[i64](TT as size_t)
var tt 0
while tt < TT
{
    ids.put(tt as size_t, pmod(tt * 7, V) as i64)
    tt := tt + 1
}
let emb tape.embedding(table, ids, TT)
let x0 tape.add_bcast(emb, posemb)
let n1 tape.layernorm(x0, g1, b1, 0.00001)
let q tape.matmul(n1, wq)
let k tape.matmul(n1, wk)
let v tape.matmul(n1, wv)
let at tape.attention_windowed(q, k, v, HEADS, T)
let o tape.matmul(at, wo)
let x1 tape.add(x0, o)
let n2 tape.layernorm(x1, g2, b2, 0.00001)
let h tape.matmul(n2, wf)
let e tape.gelu(h)
let m tape.matmul(e, wp)
let x2 tape.add(x1, m)
let nf tape.layernorm(x2, gf, bf, 0.00001)
let logits tape.matmul(nf, whead)
var tgs Vector[i64](TT as size_t)
var t2 0
while t2 < TT
{
    tgs.put(t2 as size_t, pmod(t2 * 5 + 3, V) as i64)
    t2 := t2 + 1
}
let loss tape.crossentropy(logits, tgs)

; --- CPU reference ---
tape.recompute()
tape.zero_grads()
tape.backward loss

let nnodes tape.nodes.get_length() as int
let buf tape.nodes.get_buffer()
var offv Vector[int](nnodes as size_t)
var total 0
var ci 0
while ci < nnodes
{
    let node buf + ci
    offv.put(ci as size_t, total)
    total := total + node.rows * node.cols
    ci := ci + 1
}
var sval Vector[float](total as size_t)
var sgrad Vector[float](total as size_t)
let svp sval.data
let sgp sgrad.data
let ofp offv.data
var ci2 0
while ci2 < nnodes
{
    let node buf + ci2
    let count node.rows * node.cols
    let vp node.value.data
    let gp node.grad.data
    var j 0
    while j < count
    {
        svp[ofp[ci2] + j] := vp[j]
        sgp[ofp[ci2] + j] := gp[j]
        j := j + 1
    }
    ci2 := ci2 + 1
}

; --- attach: redirect to MTLBuffer slots + scratch, through the
; package (no trainable params here - the whole-step parity does not
; run Adam on this tape) ---
var noparams Vector[int]()
let g GpuTape.attach(tape, noparams, loss, 0)

; --- variant 0: hybrid (MPS GEMM + MSL long tail); variant 1:
; MSL-only matmuls (single encoder). One command buffer each. ---
var failed 0
var variant 0
while variant < 2
{
    g.set_msl(variant)
    g.begin()
    g.encode_step()
    let rc g.commit_wait()
    if rc <> 0
    {
        Console.println("FAIL: command buffer did not complete")
        exit(1)
    }
    var maxv: float 0.0
    var maxg: float 0.0
    var mi 0
    while mi < nnodes
    {
        let node buf + mi
        let count node.rows * node.cols
        let vd maxdiff_ptr(node.value.data, svp + ofp[mi], count)
        let gd maxdiff_ptr(node.grad.data, sgp + ofp[mi], count)
        if vd > maxv
            maxv := vd
        if gd > maxg
            maxg := gd
        if vd > 0.001
            failed := 1
        if gd > 0.001
            failed := 1
        mi := mi + 1
    }
    ; non-triviality: the GPU wrote real values (op outputs started
    ; zeroed; a no-op walk would leave the loss at 0, far from the CPU)
    let lnode buf + loss
    let lp lnode.value.data
    let gpu_loss lp[0]
    let cpu_loss svp[ofp[loss]]
    if gpu_loss < 0.1
        failed := 1
    var sb StringBuilder()
    if variant = 0
        sb.append "hybrid (MPS gemm + MSL ops):  "
    else
        sb.append "MSL-only (single encoder):    "
    sb.append "max value diff "
    let vs fixed6(maxv)
    sb.append vs
    sb.append "  max grad diff "
    let gs fixed6(maxg)
    sb.append gs
    sb.append "  loss cpu "
    let cls fixed6(cpu_loss)
    sb.append cls
    sb.append " gpu "
    let gls fixed6(gpu_loss)
    sb.append gls
    let line sb.to_string()
    Console.println(line.to_c_string())
    variant := variant + 1
}

; --- Adam parity: CPU adam_step on tape A; on tape B the package's
; step_adam kernel, grads produced by the CPU backward THROUGH the
; redirected buffers (unified memory - the per-op-sync precedent).
; NOTE: this second attach resets the slot registry and releases the
; first tape's buffers - all main-tape comparisons are done above. ---
var tape_a Tape()
let xa tape_a.leaf(4, 8)
let ga tape_a.gelu(xa)
var sa 77
sa := fill(tape_a, xa, 32, sa)
tape_a.recompute()
tape_a.zero_grads()
tape_a.backward ga
tape_a.adam_step(xa, 0.001, 0.9, 0.999, 0.00000001, 1)
tape_a.adam_step(xa, 0.001, 0.9, 0.999, 0.00000001, 2)

var tape_b Tape()
let xb tape_b.leaf(4, 8)
let gb tape_b.gelu(xb)
var sb2 77
sb2 := fill(tape_b, xb, 32, sb2)
var bparams Vector[int](1)
bparams.put(0, xb)
let gpu_b GpuTape.attach(tape_b, bparams, gb, 0)
tape_b.recompute()
tape_b.zero_grads()
tape_b.backward gb
gpu_b.step_adam(0.001, 0.9, 0.999, 0.00000001, 1)
gpu_b.step_adam(0.001, 0.9, 0.999, 0.00000001, 2)
let bufb tape_b.nodes.get_buffer()
let nodeb bufb + xb
let bufa tape_a.nodes.get_buffer()
let nodea bufa + xa
let adiff maxdiff_ptr(nodeb.value.data, nodea.value.data, 32)
var asb StringBuilder()
asb.append "adam (2 steps):               max value diff "
let astr fixed6(adiff)
asb.append astr
let aline asb.to_string()
Console.println(aline.to_c_string())
if adiff > 0.0001
    failed := 1

if failed = 1
{
    Console.println("FAIL")
    exit(1)
}
Console.println("PASS")
