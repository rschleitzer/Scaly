; 5.3 training loop: char-level bigram MLP over real Thomas Mann text
; (tests/tensor/mann.txt = Der Tod in Venedig, Projekt Gutenberg body,
; UTF-8). The char tokenizer (~90 symbols incl. umlauts) feeds
; LCG-picked batches through embedding -> matmul -> GELU -> matmul ->
; fused softmax-crossentropy on ONE tape; set_token mutates the batch
; data in place, so a training step allocates nothing. Phase A: 30 SGD
; steps must descend from the uniform baseline ln(V); phase B: 300
; Adam steps must land well below it (bigram territory).
; Expected: PASS

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function lcg(s: int) returns int
    pmod(s * 1103515245 + 12345, 2147483648)

; --- load the corpus ---
let path String("tests/tensor/mann.txt")
let text File.read_to_string(path)
let tlen text.get_length() as int

; --- char tokenizer: UTF-8 decode, first-seen vocab ids ---
var map Vector[int](16384)
let mp map.data
let tsz text.get_length()
var toks Vector[i64](tsz)
let tp toks.data
var ntok 0
var vocab 0
var pos 0
while pos < tlen
{
    let b0 text.get(pos as size_t) as int
    var cp b0
    var adv 1
    if b0 >= 192
    {
        if b0 < 224
        {
            let b1 text.get((pos + 1) as size_t) as int
            cp := (b0 - 192) * 64 + (b1 - 128)
            adv := 2
        }
    }
    if b0 >= 224
    {
        if b0 < 240
        {
            let b1 text.get((pos + 1) as size_t) as int
            let b2 text.get((pos + 2) as size_t) as int
            cp := ((b0 - 224) * 64 + (b1 - 128)) * 64 + (b2 - 128)
            adv := 3
        }
    }
    if b0 >= 240
    {
        cp := 0
        adv := 4
    }
    if cp >= 16384
        cp := 0
    if mp[cp] = 0
    {
        vocab := vocab + 1
        mp[cp] := vocab
    }
    let tid mp[cp] - 1
    tp[ntok] := tid as i64
    ntok := ntok + 1
    pos := pos + adv
}

; --- model: bigram MLP, all state on one tape ---
let V vocab
let D 32
let H 64
let B 128
var tape Tape()
let table tape.leaf(V, D)
let w1 tape.leaf(D, H)
let w2 tape.leaf(H, V)
var s 42
var i 0
while i < V * D
{
    s := lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(table, i, rv)
    i := i + 1
}
var i2 0
while i2 < D * H
{
    s := lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(w1, i2, rv)
    i2 := i2 + 1
}
var i3 0
while i3 < H * V
{
    s := lcg(s)
    let r pmod(s, 2001) - 1000
    let rv (r as float) * 0.0001
    tape.set_value(w2, i3, rv)
    i3 := i3 + 1
}
let bsz B as size_t
var ids Vector[i64](bsz)
let emb tape.embedding(table, ids, B)
let h1 tape.matmul(emb, w1)
let a1 tape.gelu(h1)
let logits tape.matmul(a1, w2)
var tgs Vector[i64](bsz)
let loss tape.crossentropy(logits, tgs)

; --- train: 30 SGD steps, then 300 Adam steps ---
var first_sum: float 0.0
var sgd_sum: float 0.0
var last_sum: float 0.0
var step 1
while step <= 330
{
    var b 0
    while b < B
    {
        s := lcg(s)
        let p pmod(s, ntok - 1)
        tape.set_token(emb, b, tp[p])
        tape.set_token(loss, b, tp[p + 1])
        b := b + 1
    }
    tape.recompute()
    let lv tape.value_at(loss, 0)
    if step <= 10
        first_sum := first_sum + lv
    if step > 20
        if step <= 30
            sgd_sum := sgd_sum + lv
    if step > 310
        last_sum := last_sum + lv
    tape.zero_grads()
    tape.backward loss
    if step <= 30
    {
        tape.sgd_step(table, 5.0)
        tape.sgd_step(w1, 5.0)
        tape.sgd_step(w2, 5.0)
    }
    if step > 30
    {
        let t step - 30
        tape.adam_step(table, 0.01, 0.9, 0.999, 0.00000001, t)
        tape.adam_step(w1, 0.01, 0.9, 0.999, 0.00000001, t)
        tape.adam_step(w2, 0.01, 0.9, 0.999, 0.00000001, t)
    }
    step := step + 1
}
let first_avg first_sum / 10.0
let sgd_avg sgd_sum / 10.0
let last_avg last_sum / 20.0

; Every gate is a POSITIVE range requirement: a diverged run yields
; NaN averages, and every comparison against NaN is false — so a
; `if x >= bound: fail`-style gate would wave NaN through.
var corpus_ok false
if ntok >= 100000
    if vocab >= 60
        if vocab <= 200
            corpus_ok := true
; the untrained model must start at the uniform baseline ln(V)
var start_ok false
if first_avg > 4.0
    if first_avg < 6.0
        start_ok := true
; 30 SGD steps must descend measurably
var sgd_ok false
if sgd_avg > 0.5
    if sgd_avg < first_avg - 0.05
        sgd_ok := true
; Adam must land in bigram territory, far below the baseline
var adam_ok false
if last_avg > 0.5
    if last_avg < 3.4
        adam_ok := true
var ok true
if corpus_ok = false
    ok := false
if start_ok = false
    ok := false
if sgd_ok = false
    ok := false
if adam_ok = false
    ok := false
if ok
    print("PASS")
else
    print("FAIL")
