; The h3 package (ROADMAP-http.md stage G) against a client written here on
; ngtcp2's client side (h3/ngtcp2_glue.c), over UDP on the loopback:
;   handshake  TLS 1.3 with ALPN h3 completes
;   streams    three requests on one connection at once: GET /sum?a=1&b=2
;              answers 3; GET /big 100 000 bytes, each byte where it belongs
;              (many packets, more than one train of them); GET /nope a 404
;              without a body
; Arguments: the certificate, its key, a UDP port.
; Expected: handshake streams

package scaly 0.1.0
package http 0.1.0
package tls 0.1.0
package h3 0.1.0

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response
use http.Router.Router
use http.Hpack.HeaderList
use tls.Tls.SslCtxRef

procedure sum(req: ref[Request], mutable res: ref[Response])
    res.send_int(parse_int_prefix(req.query_param("a")) + parse_int_prefix(req.query_param("b")))

; 100 000 bytes: byte i is i % 251.
procedure big(req: ref[Request], mutable res: ref[Response])
{
    var body Vector[u8](100000)
    var i: size_t 0
    while i < 100000
    {
        body.put(i, (i % 251) as u8)
        set i: i + 1
    }
    res.send("application/octet-stream", body.as_slice())
}

; A request stream of the client: what it sends, what came back.
define CStream
(
    var id: i64
    var request: ByteBuf
    var queued: size_t
    var fin_sent: bool
    var response: ByteBuf
    var done: bool
)

define Client
(
    var streams: Array[ref[CStream]]
    var handshake: bool
)

procedure c_stream_data(mutable conn: pointer[void], flags: u32, stream_id: i64, offset: u64, data: pointer[u8], datalen: size_t, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) returns i32
{
    ngtcp2_conn_extend_max_stream_offset(conn, stream_id, datalen as u64)
    ngtcp2_conn_extend_max_offset(conn, datalen as u64)
    var c user_data as ref[Client]
    var i: size_t 0
    while i < c.streams.length
    {
        var s: ref[CStream] c.streams[i]
        if s.id = stream_id
        {
            if datalen > 0
                s.response.append(Slice[u8](datalen, data))
            if (flags & NGTCP2_STREAM_DATA_FLAG_FIN) <> 0
                set s.done: true
        }
        set i: i + 1
    }
    0
}

procedure c_stream_close(mutable conn: pointer[void], flags: u32, stream_id: i64, app_error_code: u64, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) returns i32
    0

procedure c_handshake(mutable conn: pointer[void], mutable user_data: pointer[void]) returns i32
{
    var c user_data as ref[Client]
    set c.handshake: true
    0
}

; A request's HEADERS frame: GET, https, localhost and path, QPACK-coded
; (static references, literals without Huffman).
procedure request_frame(mutable out: ref[ByteBuf], path: Slice[u8])
{
    var block ByteBuf.create(Page.allocate_page(), 256)
    block.append_byte(0)
    block.append_byte(0)
    ; :method GET (static 17), :scheme https (static 23)
    block.append_byte(209)
    block.append_byte(215)
    ; :authority (static name 0) and :path (static name 1) as literals
    encode_integer(&block, 80, 4, 0)
    encode_integer(&block, 0, 7, 9)
    block.append("localhost")
    encode_integer(&block, 80, 4, 1)
    encode_integer(&block, 0, 7, path.length as u64)
    block.append(path)
    append_quic_varint(out, 1)
    append_quic_varint(out, block.length as u64)
    out.append(block.bytes())
}

; A response's status and body (its HEADERS and DATA frames); status 0
; when it is malformed.
procedure response_of(bytes: Slice[u8], mutable body: ref[ByteBuf]) returns i64
{
    var fields HeaderList.create(Page.allocate_page())
    var status: i64 0
    var at: size_t 0
    while at < bytes.length
    {
        let kind quic_varint(bytes, &at)
        let length quic_varint(bytes, &at)
        if kind < 0 or length < 0 or at + (length as size_t) > bytes.length
            return 0
        let payload bytes.subslice(at, at + (length as size_t))
        set at: at + (length as size_t)
        if kind = 1
        {
            if qpack_decode(payload, &fields) = false
                return 0
            set status: parse_int_prefix(fields.get(":status"))
        }
        if kind = 0
            body.append(payload)
    }
    status
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    if argc < 4
    {
        print "usage: h3 <cert> <key> <port>"
        return 1
    }
    let cert String(*(argv + 1))
    let key String(*(argv + 2))
    let port parse_int_prefix(String(*(argv + 3)).as_slice()) as int
    var app Router.create(Page.allocate_page())
    app.get("/sum", &sum)
    app.get("/big", &big)
    if start_h3(app, port, cert, key) = false
    {
        print "h3: the server did not start"
        return 2
    }

    let host Page.allocate_page()
    let fd quic_socket(0, false)
    var local allocate_slice[u8]^host(host, 128)
    var local_length: size_t 0
    var remote allocate_slice[u8]^host(host, 128)
    var remote_length: size_t 0
    if fd < 0 or scaly_eio_sockname(fd, local.data as pointer[void], 128, &local_length) <> 0 or scaly_eio_loopback6(port as i32, remote.data as pointer[void], 128, &remote_length) <> 0
    {
        print "h3: no client socket"
        return 3
    }
    var ctx SSL_CTX_new(TLS_client_method())
    var client &Client^host(Array[ref[CStream]]^host(), false)
    var conn: pointer[void] null
    if scaly_quic_client_new(&conn, local.data as pointer[void], local_length, remote.data as pointer[void], remote_length, scaly_eio_now_ns() as u64, &c_stream_data, &c_stream_close, &c_handshake, client as pointer[void]) <> 0
    {
        print "h3: no client connection"
        return 4
    }
    var ssl: pointer[void] null
    var octx: pointer[void] null
    if scaly_quic_client_tls_new(ctx as pointer[void], conn, &ssl, &octx) <> 0
    {
        print "h3: no client TLS"
        return 5
    }
    var tx allocate_slice[u8]^host(host, 1500)
    var rx allocate_slice[u8]^host(host, 65536)
    var from allocate_slice[u8]^host(host, 128)
    let deadline scaly_eio_now_ns() + 10000000000
    var opened false
    var finished false
    while finished = false and scaly_eio_now_ns() < deadline
    {
        let now scaly_eio_now_ns() as u64
        if client.handshake and opened = false
        {
            Console.print "handshake "
            var k: size_t 0
            while k < 3
            {
                var path: Slice[u8] "/sum?a=1&b=2"
                if k = 1
                    set path: "/big"
                if k = 2
                    set path: "/nope"
                var id: i64 0
                ngtcp2_conn_open_bidi_stream(conn, &id, null)
                let page Page.allocate_page()
                var s &CStream^page(id, ByteBuf.create(page, 256), 0, false, ByteBuf.create(page, 1024), false)
                request_frame(&s.request, path)
                client.streams.add(s)
                set k: k + 1
            }
            set opened: true
        }
        ; write: every stream's request with its FIN, then what else is due
        repeat
        {
            var stream_id: i64 0 - 1
            var data: pointer[u8] null
            var length: size_t 0
            var flags: u32 NGTCP2_WRITE_STREAM_FLAG_MORE
            var chosen: ref[CStream]? null
            var i: size_t 0
            while i < client.streams.length
            {
                let s: ref[CStream] client.streams[i]
                if s.fin_sent = false
                {
                    set chosen: s
                    set stream_id: s.id
                    let rest s.request.bytes().slice_from(s.queued)
                    set data: rest.data
                    set length: rest.length
                    set flags: flags | NGTCP2_WRITE_STREAM_FLAG_FIN
                    break
                }
                set i: i + 1
            }
            var consumed: i64 0 - 1
            let n scaly_quic_write(conn, tx.data, 1500, &consumed, flags, stream_id, data, length, now)
            if chosen <> null and consumed >= 0
            {
                var s chosen as ref[CStream]
                set s.queued: s.queued + (consumed as size_t)
                if s.queued = s.request.length
                    set s.fin_sent: true
            }
            if n = NGTCP2_ERR_WRITE_MORE
                continue
            if n <= 0
                break
            scaly_eio_udp_send(fd, tx.data as pointer[void], n as size_t, remote.data as pointer[void], remote_length)
        }
        ; read what came
        repeat
        {
            var from_length: size_t 0
            let got scaly_eio_udp_recv(fd, rx.data as pointer[void], rx.length, from.data as pointer[void], from.length, &from_length)
            if got < 0
                break
            scaly_quic_read(conn, local.data as pointer[void], local_length, from.data as pointer[void], from_length, rx.data, got as size_t, scaly_eio_now_ns() as u64)
        }
        let now2 scaly_eio_now_ns() as u64
        if ngtcp2_conn_get_expiry(conn) <= now2
            ngtcp2_conn_handle_expiry(conn, now2)
        set finished: opened
        var j: size_t 0
        while j < client.streams.length
        {
            let s: ref[CStream] client.streams[j]
            if s.done = false
                set finished: false
            set j: j + 1
        }
        if finished = false
            Scheduler.sleep(1)
    }
    if finished = false
    {
        print "h3: not all responses came (handshake `client.handshake`)"
        return 6
    }
    let bh Page.allocate_page()
    var sum_body ByteBuf.create(bh, 16)
    var big_body ByteBuf.create(bh, 100000)
    var nope_body ByteBuf.create(bh, 16)
    let s0: ref[CStream] client.streams[0]
    let s1: ref[CStream] client.streams[1]
    let s2: ref[CStream] client.streams[2]
    let sum_status response_of(s0.response.bytes(), &sum_body)
    let big_status response_of(s1.response.bytes(), &big_body)
    let nope_status response_of(s2.response.bytes(), &nope_body)
    var pattern true
    var i: size_t 0
    while i < big_body.length
    {
        if big_body.bytes()[i] <> ((i % 251) as u8)
            set pattern: false
        set i: i + 1
    }
    if sum_status <> 200 or sum_body.bytes().equals("3") = false or big_status <> 200 or big_body.length <> 100000 or pattern = false or nope_status <> 404 or nope_body.length <> 0
    {
        print "streams: sum `sum_status` big `big_status` (`big_body.length` bytes, pattern `pattern`) nope `nope_status`"
        return 7
    }
    Console.print "streams"
    0
}
