; Scheduler.spawn_detached (2026-09-28): a task nobody holds; once it has
; finished, its record and fiber record go on the scheduler's free list and
; the next detached task runs in them. The proof is the scheduler's PAGE:
; the bytes allocated on it and its extension pages are the same before and
; after a second detached task and a hundred thousand more, a hundred at a
; time. (Until 2026-10-23 the proof was two 8-byte probe allocations coming
; out adjacent -- which they cannot when the first takes a page's last
; slot, and it did once the Scheduler record grew by 32 bytes.) spawn_arg
; leaves every record on the page for good, and a server with a task per
; connection grew without bound (the refuter: the same program with
; spawn_arg fails at the first check). A detached task still sleeps, yields
; and allocates like any other, and spawn_arg keeps its handle.
; Expected: reused bounded mixed done

mutable ran: int 0

procedure note() mutable ran
    ran := ran + 1

procedure busy() mutable ran
{
    let s String("a region-allocated string, dying with the task")
    Scheduler.yield()
    Scheduler.sleep(1)
    if s.length() > 0
        ran := ran + 1
}

; The bytes allocated on page and on the extension pages chained to it,
; read without allocating: every page's bump offset, summed.
procedure probe(page: ref[Page]) returns size_t
{
    var n: size_t 0
    var p page as pointer[Page]
    while p <> null
    {
        n := n + ((p.next_object as size_t) - (p as size_t))
        p := p.next_page
    }
    n
}

let page Page.allocate_page()
let sched Scheduler.create(page)

Scheduler.spawn_detached(&note, null)
Scheduler.run()
let a0 probe(page)
Scheduler.spawn_detached(&note, null)
Scheduler.run()
let a1 probe(page)
if a1 <> a0
    exit 1
Console.print "reused "

; a hundred thousand detached tasks, a hundred at a time: after the first
; hundred records, nothing more on the page
var k 0
while k < 100
{
    Scheduler.spawn_detached(&note, null)
    k := k + 1
}
Scheduler.run()
let b0 probe(page)
var round 0
while round < 1000
{
    k := 0
    while k < 100
    {
        Scheduler.spawn_detached(&note, null)
        k := k + 1
    }
    Scheduler.run()
    round := round + 1
}
let b1 probe(page)
if ran <> 100102
    exit 2
if b1 <> b0
    exit 3
Console.print "bounded "

; detached tasks that yield, sleep and allocate, beside a joined one
ran := 0
var i 0
while i < 50
{
    Scheduler.spawn_detached(&busy, null)
    i := i + 1
}
let joined Scheduler.spawn(&busy)
Scheduler.join(joined)
Scheduler.run()
if ran <> 51
    exit 4
Console.print "mixed "

Console.print "done"
