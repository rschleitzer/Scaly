; Milestone 1.1 demonstrator: stackful context-switch ping-pong through the
; AAPCS64 / SysV x86-64 / Win64 switchers archived in libscaly.a. The extern
; declarations come from the prelude (scaly.fiber module) — nothing local.
; make_context's third argument is the stack's LOW address: only the Win64
; switcher reads it (the TIB stack bounds), the other two ignore it.
; The fiber entry function receives the jumper's context as its argument and
; must never return; each scaly_jump_context returns the (fresh) context of
; whoever jumped to us.
; Expected: ping pong ping pong ping pong done

procedure fiber_main(mutable first_ctx: pointer[void])
{
    var mctx first_ctx
    repeat
    {
        Console.print "pong "
        mctx := scaly_jump_context(mctx)
    }
}

let stack_mem scaly_aligned_alloc(4096, 65536)
let stack_top ((stack_mem as size_t) + (65536 as size_t)) as pointer[void]
let fiber_fn &fiber_main
var fctx scaly_make_context(stack_top, fiber_fn, stack_mem)
var i: int 0
while i < 3
{
    Console.print "ping "
    fctx := scaly_jump_context(fctx)
    i := i + 1
}
Console.println "done"
