; A fault in one parallel chunk STOPS the running siblings (TRAPS.md 3.21),
; and the chunks taken after it run no iteration at all.
;
; The index comes from a TABLE, not from arithmetic: `tab[k] = k` everywhere
; except `tab[TRIP] = n`, one past the end, so iteration TRIP raises the
; fault a fixed, short distance into the FIRST chunk while every other
; iteration is in range and has millions to go. The wave's fault word is the
; cancel word; the emitted chunk loop polls it once per iteration (a
; MONOTONIC load -- a plain one would be hoisted out and read once).
;
; The observable is the work itself: `acc` is prefilled with a sentinel, so
; the slots that differ are exactly the iterations that ran.
;
; ★★★WHAT THE FIRST VERSION GOT WRONG, AND WHY THIS ONE REPEATS ITSELF
; (2026-09-20, TRAPS.md 3.22). It assumed the fault chunk RUNS FIRST. It
; need not: TaskPool.submit deals the chunks round-robin over the workers'
; deques, a worker drains its OWN deque before it steals, and a worker the
; OS does not schedule during the wave (four workers plus anything else on
; four cores) leaves its deque for LAST. The fault chunk is the head of
; deque 0 -- of the LAST deque to be drained when worker 0 is the starved
; one. Measured with timestamps in the runtime: chunk 0 submitted at t=0,
; taken by a THIEF at 27.6 ms after twelve chunks had run whole; the two
; siblings still running stopped 20 us after record_fault, the chunk taken
; afterwards wrote nothing. The cancel was perfect; the fixture had measured
; the scheduler (~3 % of runs on an idle four-core box, far more under
; load). No threshold can turn such a round into a verdict, so the fixture
; does not try: it asks whether the round was INFORMATIVE and repeats the
; wave when it was not.
;
; The verdict rule is algebraic, not statistical. A BROKEN cancel loses at
; most the fault chunk's own tail, which is less than one chunk (< n/16 here,
; less on wider machines); a cancelled wave that is informative lost at
; least a few siblings. So `written <= n - n/8` -- two chunks' worth missing
; -- is a state a broken build cannot reach, and the ONLY state that passes.
; A round in which every sibling had already finished (the fault chunk ran
; last) or in which the fork came after TRIP (the fault fired INLINE, nothing
; was submitted) is inconclusive and is simply run again, up to ten times; a
; round that catches nothing fails outright. The rounds taken go to stderr.
;
; The vacuity guard is per round and is the POOL's submit counter, not the
; work count: a promoted wave submits, an inline fault does not.
; Expected: caught submitted partial
; ExpectedExit: 0

procedure fill(mutable acc: ref[Vector[int]], src: ref[Vector[int]],
               tab: ref[Vector[size_t]], n: size_t)
{
    for i in n
    {
        let idx tab[i]
        let x src[idx]
        acc.put(i, x * 3)
    }
}

let host Page.allocate_page()
let n 4000000 as size_t
let trip n / (16 as size_t)         ; 6.25% of the range -- see the comment above
var acc Vector[int]^host(n)
var src Vector[int]^host(n)
var tab Vector[size_t]^host(n)
var k 0 as size_t
while k < n
{
    src.put(k, (k as int))
    tab.put(k, k)
    set k: k + 1
}
tab.put(trip, n)

let pl TaskPool.default_pool()
let bar n - n / (8 as size_t)       ; at most this many slots may have run
var rounds 0
var verdict 0                       ; 0 inconclusive, 1 proven, 2 not caught
repeat
{
    var j 0 as size_t
    while j < n
    {
        acc.put(j, 0 - 1)
        set j: j + 1
    }
    let subs_before TaskPool.submit_count(pl)
    var caught false
    try fill(&acc, &src, &tab, n)
    else
        set caught: true
    let subs_after TaskPool.submit_count(pl)
    let submitted subs_after > subs_before
    var written: size_t 0
    set j: 0
    while j < n
    {
        if acc[j] <> (0 - 1)
            set written: written + 1
        set j: j + 1
    }
    set rounds: rounds + 1
    if not caught
    {
        set verdict: 2
        break
    }
    if submitted
    {
        if written <= bar
        {
            set verdict: 1
            break
        }
    }
    if rounds >= 10
        break
}
scaly_eputs("rounds=")
scaly_eputi(rounds)
scaly_eputnl()
if verdict = 1
    Console.println "caught submitted partial"
if verdict = 0
    Console.println "INCONCLUSIVE"
if verdict = 2
    Console.println "NOT-CAUGHT"
