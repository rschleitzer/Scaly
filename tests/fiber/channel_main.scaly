; Main-context receive + the sender-death proof over the unified async
; channel. The main context receives by driving the dispatcher (like a
; main-context join), then joins the producer — disposing its WHOLE
; fiber region — and only afterwards reads the message content. The
; message lives on its own heap page, so it survives the sender's
; wholesale teardown (the freed-bucket delta proves the producer's
; region actually died). The producer fiber borrows the creator's send
; handle; main retires it after the receive and disposes the drained
; channel.
; Expected: sent joined value7 freed done

define Msg
(
    value: int
)

mutable chan: pointer[void] null

procedure producer()
{
    let c chan as pointer[Channel]
    ; region-allocate inside the fiber so dispose has something to free
    var k 0
    while k < 20
    {
        let s String("producer payload producer payload")
        set k: k + 1
    }
    let mp Page.allocate_page()
    let m mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set m.value: 7
    Channel.send(c, m as pointer[void])
    Console.print "sent "
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()
set chan: ch as pointer[void]
let buckets_before Fiber.freed_bucket_count()
let tp Scheduler.spawn(&producer)
let raw Channel.receive(ch)
let n Scheduler.join(tp)
Console.print "joined "
let m raw as pointer[Msg]
if m.value = 7
    Console.print "value7 "
let mp Page.get(raw)
mp.deallocate_extensions()
Page.release_page(mp)
if Fiber.freed_bucket_count() > buckets_before
    Console.print "freed "
Channel.close_sender(ch)
let tail Channel.receive(ch)
if tail = null
    Channel.dispose(ch)
Console.println "done"
Page.release_page(page)
