; The no-scheduler leg of colorless I/O (milestone 2.5): Io calls work
; on a thread with NO scheduler — a would-block waits in poll(2)
; instead of parking. No Scheduler.create anywhere in this program: the
; main thread blocks in accept before the client thread connects, then
; in read before the client writes.
; Expected: got-hi done

procedure client_entry(arg: pointer[void]) returns pointer[void]
{
    let port (arg as size_t) as i32
    let fd Io.connect(port)
    if fd = ((0 - 1) as i32)
        exit 4
    Io.write(fd, "hi" as pointer[void], 2 as size_t)
    null
}

let lfd Io.listen(0 as i32)
if lfd = ((0 - 1) as i32)
    exit 1
let port Io.local_port(lfd)
let t Thread.spawn(&client_entry, (port as size_t) as pointer[void])
let cfd Io.accept(lfd)
if cfd = ((0 - 1) as i32)
    exit 2
Io.set_nonblocking(cfd)
var buf u8[8]
var got 0 as i64
while got < (2 as i64)
{
    let n Io.read(cfd, ((buf as size_t) + (got as size_t)) as pointer[void], (8 as size_t) - (got as size_t))
    if n <= (0 as i64)
        exit 3
    set got: got + n
}
var ok true
if (*(buf as pointer[u8]) as int) <> 104
    set ok: false
if (*(((buf as size_t) + (1 as size_t)) as pointer[u8]) as int) <> 105
    set ok: false
if ok
    Console.print "got-hi "
Thread.join(t)
Console.println "done"
