; Stage-7 memo rule 6 — Channel.receive_timeout: timeouts are explicit
; and local. An empty open channel times out (null + *timed_out=true);
; a message arriving within the window is delivered; after the close
; the drained receive returns null WITHOUT the timeout flag (exactly
; receive's closed contract — code that handles close handles it here
; too). The worker gets the creator's send handle through the spawn
; cell and retires it after one message.
; Expected: timeout msg7 closed done

define TMsg
(
    value: int
)

procedure worker(arg: pointer[void]) returns pointer[void]
{
    let cell arg as pointer[size_t]
    let ch_v *cell
    let ch ch_v as pointer[Channel]
    ; let the main context reach its timed wait first
    poll(null as pointer[pollfd], 0 as u64, 150 as i32)
    let mp Page.allocate_page()
    let m mp.allocate(sizeof TMsg, alignof TMsg) as pointer[TMsg]
    set m.value: 7
    Channel.send(ch, m as pointer[void])
    Channel.close_sender(ch)
    null
}

let page Page.allocate_page()
let sched Scheduler.create(page)
let ch Channel.create()

var timed false
let r0 Channel.receive_timeout(ch, 80 as i32, &timed)
if r0 <> null
    exit 1
if timed = false
    exit 1
Console.print "timeout "

let cp Page.allocate_page()
let cell cp.allocate(8 as size_t, 8 as size_t) as pointer[size_t]
set *cell: ch as size_t
let th Thread.spawn(&worker, cell as pointer[void])

set timed: false
let r1 Channel.receive_timeout(ch, 5000 as i32, &timed)
if r1 = null
    exit 2
if timed
    exit 2
let m r1 as pointer[TMsg]
if m.value = 7
    Console.print "msg7 "
let pp Page.get(r1)
pp.deallocate_extensions()
Page.release_page(pp)

set timed: false
let r2 Channel.receive_timeout(ch, 5000 as i32, &timed)
if r2 <> null
    exit 3
if timed
    exit 3
Console.print "closed "

Channel.dispose(ch)
Thread.join(th)
Page.release_page(cp)
Page.release_page(page)
Console.println "done"
