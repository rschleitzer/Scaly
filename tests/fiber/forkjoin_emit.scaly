; Fork-join of calls (ROADMAP 4.8, route 3), written the plain way: a pure
; function calling itself twice in one expression runs its two calls in
; parallel once the recursion proves long (the heartbeat promotes, an idle
; worker steals). Each shape is checked against a loop that computes the same
; value; a heavy integer recursion, a float recursion and one over a buffer
; must each be stolen at least once when there is a second worker.
;
; Isolated: its verdict counts forks and submits, which follow measured time -- run alone
; Expected: forkjoin-emit-ok done

; the worst case: no work per node
function fib(n: int) returns int
{
    if n < 2
        return n
    fib(n - 1) + fib(n - 2)
}

function leaf(lo: int, hi: int) returns int
{
    var acc 0
    var i lo
    while i < hi
    {
        set acc: acc + (i * i) % 1000003
        set i: i + 1
    }
    acc
}

; a range split in halves, real work in the leaves
function rsum(lo: int, hi: int) returns int
{
    if hi - lo <= 2048
        return leaf(lo, hi)
    let mid lo + (hi - lo) / 2
    rsum(lo, mid) + rsum(mid, hi)
}

; a float recursion: the halves are added in the same order forked or not,
; so the digits are those of the sequential run
function area(a: double, b: double, depth: int) returns double
{
    if depth = 0
    {
        var s: double 0.0
        var k 0
        let h (b - a) / 4096.0
        while k < 4096
        {
            let x a + h * (k as double)
            set s: s + x * x * h
            set k: k + 1
        }
        return s
    }
    let m (a + b) * 0.5
    area(a, m, depth - 1) + area(m, b, depth - 1)
}

; a recursion over a buffer: the pointer argument crosses to the thief
function maxof(p: pointer[int], lo: int, hi: int) returns int
{
    if hi - lo <= 4096
    {
        var best *(p + lo)
        var i lo + 1
        while i < hi
        {
            if *(p + i) > best
                set best: *(p + i)
            set i: i + 1
        }
        return best
    }
    let mid lo + (hi - lo) / 2
    let l maxof(p, lo, mid)
    let r maxof(p, mid, hi)
    if l > r
        return l
    r
}

; a comparison as the operator
function balanced(n: int) returns bool
{
    if n < 2
        return true
    balanced(n - 1) = balanced(n - 2)
}

procedure check(name: pointer[const_char], ok: bool)
{
    if not ok
    {
        scaly_eputs name
        scaly_eputs " wrong\n"
        exit 1
    }
}

let two TaskPool.ncpu() > 1
var before ForkJoin.steal_count()

var fa 0
var fb 1
var k 0
while k < 32
{
    let t fa + fb
    set fa: fb
    set fb: t
    set k: k + 1
}
check("fib", fib(32) = fa)

let big 200000000
var want 0
var j 0
while j < big
{
    set want: want + (j * j) % 1000003
    set j: j + 1
}
check("rsum", rsum(0, big) = want)
if two and ForkJoin.steal_count() = before
    check("rsum-stolen", false)

set before: ForkJoin.steal_count()
let a1 area(0.0, 3.0, 12)
check("area", a1 > 8.99 and a1 < 9.01)
check("area-repeat", area(0.0, 3.0, 12) = a1)

let n 4000000
let host Page.allocate_page()
let buf host.allocate((n as size_t) * 8, 8) as pointer[int]
var i 0
while i < n
{
    set *(buf + i): (i * 7919) % 1000003
    set i: i + 1
}
set *(buf + 2345678): 2000000
check("maxof", maxof(buf, 0, n) = 2000000)
check("balanced", balanced(30))

; many small executions stay cheap and right
var small 0
set i: 0
while i < 2000
{
    set small: small + rsum(0, 5000 + i)
    set i: i + 1
}
var small_want 0
set i: 0
while i < 2000
{
    set small_want: small_want + leaf(0, 5000 + i)
    set i: i + 1
}
check("small", small = small_want)
print "forkjoin-emit-ok done"
