; Control (2026-11-23) for xfail_getref_alias_kept_by_receiver and the
; xfail_frame_address_in_* fixtures: a record that holds a reference into
; memory the receiver outlives -- a holder on the receiver's page, a value
; of the receiver itself -- or no reference at all, kept by the receiver, is
; legal and reads correctly; run under SCALY_POISON.
; run-env: SCALY_POISON=1
; Expected: PASS

define Entry(name: ref[String]?, n: int)

define Registry(var entries: Array[Entry], var names: Vector[String])
{
    ; the holder on the receiver's page
    procedure on_page(mutable this, n: int)
    {
        var holder Vector[String]^this(1)
        holder.put(0, String^this("page"))
        let r holder.get(0)
        this.entries.add(Entry(r, n))
    }

    ; a reference into the receiver's own vector
    procedure own(mutable this, n: int)
    {
        let r this.names.get(0)
        let e Entry(r, n)
        this.entries.add(e)
    }

    ; no reference at all
    procedure plain(mutable this, n: int)
    {
        var e Entry(null, 0)
        e := Entry(null, n)
        this.entries.add(e)
    }
}

var names Vector[String](1)
names.put(0, "own")
var reg Registry(Array[Entry](), names)
reg.on_page(1)
reg.own(2)
reg.plain(3)
var ok reg.entries.length = 3
var i: size_t 0
while i < reg.entries.length
{
    let e reg.entries[i]
    let nm e.name
    if e.n = 1 and (nm = null or (*nm) <> "page")
        ok := false
    if e.n = 2 and (nm = null or (*nm) <> "own")
        ok := false
    if e.n = 3 and nm <> null
        ok := false
    i := i + 1
}
if ok
    print "PASS"
else
    print "FAIL"
