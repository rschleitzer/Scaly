; Regression: the `?` sigil is accepted on a GENERIC ARGUMENT in expression
; position -- `Array[ref[Leaf]?]^page()` (2026-08-25).
;
; The parser reads `[...]` in expression position as a VECTOR LITERAL whose
; elements are OPERANDS, not as a GenericArguments list; only the planner's
; s107 merge turns the row back into a Type. So the `?` had nowhere to attach
; and the exact type that every DECLARATION position accepts was a hard parse
; error here -- `expected ']'`. Every other spelling worked, which is what made
; it a wart rather than a limit: the field, the parameter, the annotated local,
; AND the desugared `Array[Option[ref[Leaf]]]` in this very position.
;
; It matters because a container of OPTIONAL references is the ordinary shape
; in the ports (a sparse table: clear a slot with null, test it on read), and
; the sugar was the only spelling missing.
;
; The fix desugars in Modeler.handle_vector# rather than travelling as a flag:
; the row becomes `[Type(Option), Matrix([row])]`, the nested-generic shape
; extract_row_to_type# already rebuilds -- so Model, Plan and Planner are
; untouched. This test asserts the two spellings are the SAME TYPE by handing
; a value built with one to a parameter declared with the other.
;
; Self-hosted-only. Expected: PASS

use scaly.memory.Page
use scaly.containers.Array

define Leaf (v: int)

define Mk ()
{
    ; declared with the DESUGARED spelling; fed a value built with the SUGAR
    function sum(a: ref[Array[Option[ref[Leaf]]]]) returns int
    {
        let n a.get_length()
        let buf a.get_buffer()
        var s 0
        var i: size_t 0
        while i < n
        {
            let e *(buf + i)
            if e <> null
                s := s + e.v
            i := i + 1
        }
        s
    }
}

function probe(host: pointer[Page]) returns int
{
    ; the sugar, in construction position: this is what used to be `expected ']'`
    let a Array[ref[Leaf]?]^host()

    var k 0
    while k < 3
    {
        let g host.allocate(sizeof Leaf, alignof Leaf) as ref[Leaf]
        g := Leaf(((k + 1) * 10))
        a.add(g)
        k := k + 1
    }
    ; a genuinely absent element -- the reason the element type must be optional
    var hole: ref[Leaf]? null
    a.add(hole)

    var flags 0
    if a.get_length() <> (4 as size_t)
        flags := flags + 1
    ; the sugar-built value satisfies the desugared parameter type
    if Mk.sum(a) <> 60
        flags := flags + 2

    let buf a.get_buffer()
    let e3 *(buf + (3 as size_t))
    if e3 <> null
        flags := flags + 4
    let e0 *(buf + (0 as size_t))
    if e0 = null
        flags := flags + 8
    if e0.v <> 10
        flags := flags + 16
    flags
}

let r probe(Page.allocate_page())
if r = 0
    print "PASS\n"
if r <> 0
    print "FAIL\n"
