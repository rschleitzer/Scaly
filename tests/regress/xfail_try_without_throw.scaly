; Expected-failure: a `try` whose condition throws nothing is a lie --
; the `when` arms are unreachable.
;
; Until 2026-09-07 this form compiled WORDLESSLY and did nothing: the arm was
; not emitted (the 55 did not occur in the IR), and a runtime trap ended
; the process with rc 15 as if no try stood there. An author could thus write
; down a handled case that is none.
;
; A runtime trap is not a `throw`: today it is catchable only around a
; CALL, with Region.run_guarded (tests/regress/panic_caught.scaly).
; xfail: this try cannot catch anything

define OobErr union (Oob: Detail)
define Detail(index: size_t)

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[2]
    buf[0] := 10
    let s Slice[int](2, &buf[0])

    try let x s[(argc as size_t) + 4]
        when e: Oob
            return 55
    x as int
}
