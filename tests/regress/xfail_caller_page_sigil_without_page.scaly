; Regression (2026-09-24): `#` names the CALLER's page, and `fill` has none (it
; returns nothing, so the page rules gave it no caller page). The emitter took
; the routine's own frame instead -- released on return -- and the store check
; trusted the `#`, so the spelling meant to fix xfail_store_local_part compiled
; at rc 0 and still handed the caller a dangling String.
; Planner.operand_is_pageless_caller_construction#.
; xfail: error: a part of the value stored here is built on this routine's page
define Holder (var s: String)

procedure fill(mutable out: ref[Holder], n: int)
{
    var sb StringBuilder()
    sb.append "hello-"
    sb.append n
    set out: Holder(String#(sb.to_string()))
}

procedure churn() returns int
{
    var t: int 0
    var i: int 0
    while i < 200
    {
        let x String("zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz")
        set t: t + (x.get_length() as int)
        set i: i + 1
    }
    t
}

procedure run()
{
    var h Holder(String(""))
    fill(&h, 7)
    churn()
    if h.s.equals(String("hello-7"))
        print("PASS")
    else
        print("FAIL")
}
run()
