; SIMD vector types, phase 1 (ROADMAP-simd.md): every element type and width,
; construction, splat, iota, lanes, with, the operators lane by lane (a scalar
; side broadcast, an integer literal into a float vector included), the
; comparisons into masks, the mask operations, select, the casts, and vectors
; as parameters, results, record fields and Array elements. Every value is
; checked against the scalar computation of its lanes.
; Expected: PASS
define Particle (tag: int  pos: f64x4  vel: f64x4)

function scale(v: f64x4, k: double) returns f64x4
    v * k

function lane_sum(v: f64x4) returns double
    v[0] + v[1] + v[2] + v[3]

procedure check() returns int
{
    let a f64x4(1.0, 2.0, 3.0, 4.0)
    if lane_sum(a * 2) <> 20.0
        return 1
    if lane_sum(scale(a, 0.5)) <> 5.0
        return 2
    let neg 0.0 - a
    let neg2 -a
    if neg[3] <> 0.0 - 4.0 or neg2[1] <> 0.0 - 2.0
        return 3
    let q a / 2.0
    if q[0] <> 0.5
        return 4
    ; f32 and the other widths
    let f f32x8.iota(0.0, 1.5)
    if f[7] <> 10.5
        return 5
    let f16 f32x16.splat(2.0) * f32x16.iota(1.0, 1.0)
    if f16[15] <> 32.0
        return 6
    let d8 f64x8.splat(1.0) + f64x8.iota(0.0, 1.0)
    if d8[7] <> 8.0
        return 7
    ; integers: signed division, remainder, shifts, comparisons
    let i i32x4(0 - 7, 7, 9, 0 - 9)
    let idiv i / 2
    if idiv[0] <> 0 - 3 or idiv[2] <> 4
        return 8
    let irem i % 4
    if irem[1] <> 3 or irem[3] <> 0 - 1
        return 9
    let sh i64x2(1, 3) << 4
    if sh[1] <> 48
        return 10
    let sr i64x4(0 - 64, 64, 8, 16) >> 2
    if sr[0] <> 0 - 16 or sr[1] <> 16
        return 11
    let i8w i32x8.iota(0, 3)
    if (i8w > 10).count() <> 4
        return 12
    ; unsigned: wrap, unsigned compare, unsigned shift
    let u u8x16.splat(200) + u8x16.splat(100)
    if u[9] <> 44
        return 13
    let big u32x4(4000000000, 1, 2, 3)
    if (big > 5).count() <> 1
        return 14
    let ushr u32x8.splat(4000000000) >> 28
    if ushr[0] <> 14
        return 15
    let u32w u8x32.iota(0, 8)
    if u32w[31] <> 248
        return 16
    ; masks
    let m1 a > 1.5
    let m2 a < 3.5
    let both m1 and m2
    let either m1 or m2
    let only m1 xor m2
    if both.count() <> 2 or either.count() <> 4 or only.count() <> 2
        return 17
    let inv not m1
    if inv.count() <> 1 or (mask4.none_set()).any() or mask4.all_set().all() = false
        return 18
    if (i8w <> i8w).any() or (i8w = i8w).all() = false
        return 19
    let pick select(m1, a, f64x4.splat(0.0))
    let pick2 m2.select(a, f64x4.splat(9.0))
    if lane_sum(pick) <> 9.0 or pick2[3] <> 9.0
        return 20
    ; with, casts
    let w a.with(2, 7.5)
    if w[2] <> 7.5 or w[3] <> 4.0
        return 21
    let ints a as i64x4
    let back (ints * 3) as f64x4
    if back[3] <> 12.0
        return 22
    let narrow f64x4(1.5, 2.5, 3.5, 4.5) as f32x4
    let wide narrow as f64x4
    if wide[1] <> 2.5
        return 23
    ; records and containers
    let p Particle(7, a, f64x4.splat(0.25))
    let moved p.pos + p.vel * 4.0
    if moved[0] <> 2.0 or p.tag <> 7
        return 24
    var arr Array[f64x4]()
    arr.add a
    arr.add(a * 10.0)
    let second arr[1]
    if second[2] <> 30.0 or arr[0][3] <> 4.0
        return 25
    42
}

let rc check()
if rc = 42
    print("PASS")
else
    print("FAIL `rc`")
