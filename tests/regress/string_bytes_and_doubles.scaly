; A view of bytes and a double reach a String and an interpolation
; (2026-10-21): String(Slice[u8]) copies the bytes, StringBuilder appends a
; Slice[u8] as it is and an f64 as the shortest text that reads back to it.
; Before, `String(req.param("name"))` was "no matching initializer", and
; "`x`" with x an f64 or a Slice[u8] was an argument type mismatch.
let bytes "world".as_slice()
let s String(bytes)
let empty String("".as_slice())
let third 1.0 / 3.0
let text "Hello, `s`! `bytes` `0.1` `third` `1e21` `-2.5` `0.0` `empty.get_length()`"
if text.equals("Hello, world! world 0.1 0.3333333333333333 1e+21 -2.5 0 0")
    print "PASS"
else
    print "FAIL `text`"
