; Regression (2026-09-24): a braceless `if` body that is a `choose` with an
; `else` arm took the NEXT LINE into its operand run -- the construct ends at
; its last arm's newline, and the enclosing statement keeps collecting. The
; function below answered 0 instead of 77 at rc 0 whenever the condition was
; false; a call on that line instead aborted the emitter with an empty operator
; name. It is rc 4 at the absorbed operand now
; (Planner.report_absorbed_after_control#); absorbed_after_choose_ok.scaly is
; the braced body.
; xfail: this joined the choose/match/if/try before it
define Expr union
(
    Name: int
    Other: int
)

function probe(gate: int, e: Expr) returns int
{
    if gate = 1
        choose e
            when n: Name
                if n > 0
                    return 10
            else
                0
    77
}

print "`probe(0, Expr.Name(5))`"
