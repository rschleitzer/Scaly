; Regression (2026-09-25): a GENERIC record from another package holding a
; non-generic record BY VALUE had no layout for that field in a root that never
; names the field's type. `Wrap[int]` came out `{ i64, ptr }` -- the field
; `inner: Inner` (24 bytes) laid out as the 8-byte placeholder -- so `Holder`
; was 16 bytes short and `after` sat at the wrong offset, rc 0. Live in the
; tree: dazzle_cli's NamedTable[ELObj] was `{ ptr }` for the library's
; `{ NameTable }`. ensure_member_layout# already recursed into the by-value
; fields of a NON-generic dependency struct; instantiate_generic# does the same
; now (Planner.ensure_field_layouts#).
;
; An IR gate: the package lives in its own SCALY_HOME, which has no runtime
; archive to link against, and the evidence is the struct type itself.
; env: SCALY_HOME=tests/regress/generic_field_cross_package_home
; args: --no-prelude
; expect-ir: %_Z4WrapIiE = type { i64, %_Z5Inner }
; expect-ir: %_Z5Inner = type { i64, i64, i64 }

package gfl 0.1.0
use gfl.shapes.Wrap

define Holder (w: Wrap[int]  after: int)

function after_of(h: ref[Holder]) returns int
    h.after

function holder_size() returns size_t
    sizeof Holder
