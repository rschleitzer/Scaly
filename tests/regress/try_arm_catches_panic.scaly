; Regression: `try ... when e: OutOfBounds` catches a runtime PANIC and
; binds its detail TYPED.
;
; The arm form is the reason why the panic union RuntimeFault stands in the
; prelude: a `when` arm is a selection over a variant tag, so
; a catchable fault needs a union and not a record.
;
; Checked:
;   (1) the arm binds e with e.index / e.length
;   (2) locals of the CATCHER survive the jump (returns_twice)
;   (3) the regions of the skipped frames come back
;   (4) nesting: a try with an arm INSIDE the arm of another
;   (5) arm AND else together, on the success path
;
; No union value is materialised: every arm knows its payload type, the
; Emitter lays out the record and the shim fills it (emit_try_panic_catch#).
;
; Expected: PASS
function deep(n: i64) returns i64
{
    let s String("eine Region auf diesem Rahmen")
    var buf int[2]
    buf[0] := 7
    let v Slice[int](2, &buf[0])
    if n > 0
        return v[(n as size_t) + 4]
    (s.get_length() as i64)
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var vor 100
    vor := vor + argc
    let mark0 scaly_panic_mark()

    ; (1) the arm binds typed, (2) locals survive
    try let a deep(1)
        when e: OutOfBounds
        {
            if e.index <> (5 as size_t)
                return 1
            if e.length <> (2 as size_t)
                return 2
            if vor <> 101
                return 3

            ; (4) nesting with an arm
            try let b deep(1)
                when e2: OutOfBounds
                    if e2.length <> (2 as size_t)
                        return 4

            ; (3) regions back
            if scaly_panic_mark() <> mark0
                return 5

            ; (5) arm AND else together: nothing panics here, so the success path
            try let c deep(0)
                when e3: OutOfBounds
                    return 6
            else
                return 7
            if c < 1
                return 8

            print "PASS"
            return 0
        }
    print "FAIL not caught"
    9
}
