; Regression (2026-09-27): the IR half of stack_vector -- a local
; `Vector[int](n)` used only through put and [] gets its record and buffer on
; the machine stack (StackVectors.scaly, Emitter.emit_stack_vector#), and the
; frame page only on the path where n * sizeof T exceeds the 256-byte slot.
; expect-ir: %vec.stack = alloca %_Z6VectorIiE
; expect-ir: %vec.buf = alloca [256 x i8], align 16
; expect-ir: %vec.fits = icmp ule i64 %vec.bytes, 256

function scratch(n: int) returns int
{
    var v Vector[int](n as size_t)
    v.put(0, n)
    v[0]
}

print("`scratch(3)`")
