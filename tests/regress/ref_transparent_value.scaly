; A `ref[T]` reaching a context that wants a `T` IS that value, and a `set`
; whose target is a `ref[T]` and whose source is a `T` writes THROUGH the
; reference. Before 2026-08-27 every one of these was silently wrong at rc 0:
; the read positions answered 0 or the raw ADDRESS, and the write vanished.
;
; The RHS decides which meaning a `set` has: a pointee value stores through,
; a reference of the target's own type rebinds.

define Cell (v: int)

function takes_int(x: int) returns int
    x + 100

function r_return(r: ref[int]) returns int
{
    return r
}

function r_tail(r: ref[int]) returns int
{
    r
}

function r_binding(r: ref[int]) returns int
{
    let v: int r
    v
}

function r_argument(r: ref[int]) returns int
{
    takes_int(r)
}

procedure w_scalar(mutable r: ref[int], x: int)
{
    r := x
}

procedure w_struct(mutable r: ref[Cell], c: Cell)
{
    r := c
}

; ★ The star spelling is GONE: `*r` on a non-optional reference is a hard rc-4
; since the sweep finished (xfail_deref_of_ref.scaly). While both existed they
; emitted instruction-identically, which is what made the sweep provable.

; a reference source REBINDS the local rather than writing the pointee
function rebinds(a: ref[int], b: ref[int]) returns int
{
    var r: ref[int] a
    r := b
    r
}


function r_compare(r: ref[int]) returns bool
{
    r <> 0
}

function r_compare_u32(r: ref[u32]) returns bool
{
    r > 3
}

; ★ An `as` on a reference keeps its ADDRESS meaning and is deliberately NOT
; loaded. `&arr[0] as size_t` is how this tree takes an address as a number
; (tests/regress/address_of_array_element.scaly measures the stride with it),
; and no rule can tell that apart from a value read: both are a reference cast
; to an integer. A cell whose VALUE is wanted at another width binds it first.
function r_cast_keeps_address(r: ref[int], s: ref[int]) returns bool
{
    let a r as size_t
    let b s as size_t
    a <> b
}

function r_condition(r: ref[bool]) returns int
{
    if r
        return 1
    0
}

; an UNTYPED binding keeps the reference -- it does not load. `let q r` is how
; a borrow is aliased, and the store-through rule then reaches the pointee
; through it.
procedure alias_and_store(mutable r: ref[int])
{
    let q r
    q := 7
}


; ★ A page-hosted CONSTRUCTION assigned to a ref target is ambiguous, and the
; target's MUTABILITY settles it: a `var` local can be rebound, a parameter and
; a `let` cannot, so there the only reading left is the store.
procedure stores_construction(mutable out: ref[Cell])
{
    out := Cell^this(5)
}

function rebinds_construction(a: ref[Cell]) returns int
{
    var t: ref[Cell] a
    t := Cell^this(8)
    t.v
}


; ARITHMETIC on a SCALAR pointee reads the value. The struct case stays with
; report_ref_arithmetic# -- xfail_ref_arithmetic.scaly measures it on a
; two-field Box, where a byte-stride GEP is the hazard and value arithmetic
; means nothing.
function r_add(r: ref[int], n: int) returns int
    r + n

function r_sub(i: size_t, r: ref[size_t]) returns size_t
    i - r

function r_shift(r: ref[int], n: int) returns int
    r << n


; ★ MUTABILITY gates every rebind. Two ref PARAMETERS of the same type cannot
; rebind -- a parameter is not a slot the callee owns -- so the assignment
; copies the pointee, which is what `set *a: *b` meant.
procedure copies_between_refs(mutable a: ref[int], b: ref[int])
{
    a := b
}

var ok: bool true

var a: int 7
if r_return(&a) <> 7
    ok := false
if r_tail(&a) <> 7
    ok := false
if r_binding(&a) <> 7
    ok := false
if r_argument(&a) <> 107
    ok := false

var s: int 0
w_scalar(&s, 42)
if s <> 42
    ok := false


var c Cell(1)
var c2 Cell(9)
w_struct(&c, c2)
if c.v <> 9
    ok := false

var x: int 3
var y: int 4
if rebinds(&x, &y) <> 4
    ok := false

if r_compare(&a) = false
    ok := false
var u: u32 9
if r_compare_u32(&u) = false
    ok := false
var other: int 1
if r_cast_keeps_address(&a, &other) = false
    ok := false
var no: bool false
if r_condition(&no) <> 0
    ok := false
var yes: bool true
if r_condition(&yes) <> 1
    ok := false
var al: int 1
alias_and_store(&al)
if al <> 7
    ok := false

var sc Cell(0)
stores_construction(&sc)
if sc.v <> 5
    ok := false
var rc Cell(1)
if rebinds_construction(&rc) <> 8
    ok := false
if rc.v <> 1
    ok := false

if r_add(&a, 2) <> 9
    ok := false
var sz: size_t 3
if r_sub(10 as size_t, &sz) <> (7 as size_t)
    ok := false
if r_shift(&a, 1) <> 14
    ok := false

var ca: int 1
var cb: int 99
copies_between_refs(&ca, &cb)
if ca <> 99
    ok := false
if cb <> 99
    ok := false

if ok
    println "PASS"
else
    println "FAIL"
