; Gate: Slice.at -- the borrowed reference. A METHOD and therefore another
; emission path than operator[] (a method is emitted for EVERY instantiation,
; an operator only where it is used).
; expect-rc: 15
; expect-out: Slice.at: index out of bounds

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[4]
    buf[0] := 10
    let s Slice[int](4, &buf[0])
    let r s.at((argc as size_t) + 3)
    r
}
