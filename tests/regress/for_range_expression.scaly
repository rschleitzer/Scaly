; Regression (2026-09-28): the range of a `for` that is an EXPRESSION ran over
; its first operand only -- `for t in n * n` iterated n times, rc 0. plan_for
; collapsed the operand run to type the loop but stored the raw run in the
; plan, and every reader takes its first operand (Planner.plan_for#).
; Expected: PASS

function count_to(k: int) returns int
{
    var c 0
    for i in k
        c := c + 1
    c
}

let n 4
var a 0
for t in n * n
    a := a + 1
var b 0
for t in n + 3
    b := b + t
var c 0
for t in count_to(3) * 2 - 1
    c := c + 1
var d Vector[int]((n * n) as size_t)
for t in n * n
    d.put(t as size_t, t / n + t % n)
var s 0
for x in d
    s := s + x
if a = 16 and b = 21 and c = 5 and s = 48
    print("PASS")
else
    print("FAIL `a` `b` `c` `s`")
