; A view of bytes reaches a String and an interpolation (2026-10-21):
; String(Slice[u8]) copies the bytes, StringBuilder appends a Slice[u8] as
; it is. Before, `String(req.param("name"))` was "no matching initializer",
; and "`x`" with x a Slice[u8] was an argument type mismatch.
let bytes "world".as_slice()
let s String(bytes)
let empty String("".as_slice())
let text "Hello, `s`! `bytes` `empty.get_length()`"
if text.equals("Hello, world! world 0")
    print "PASS"
else
    print "FAIL `text`"
