; Control for xfail_duplicate_function / xfail_duplicate_method: what is NOT
; the same routine twice. Overloads by type and by arity, a method beside a
; free function of its name, the same C prototype declared twice.

function strlen(s: pointer[const_char]) returns size_t extern
function strlen(s: pointer[const_char]) returns size_t extern

function twice(n: int) returns int
    n * 2

function twice(n: size_t) returns size_t
    n * 3

define Box
(
    v: int
)
{
    function get(this) returns int
        v

    function get(this, k: int) returns int
        v + k

    function twice(this) returns int
        v * 4
}

let b Box(7)
let six: size_t 2
if twice(7) = 14 and twice(six) = 6 and b.get() = 7 and b.get(1) = 8 and b.twice() = 28 and strlen("abc") = 3
    print "PASS\n"
else
    print "FAIL\n"
