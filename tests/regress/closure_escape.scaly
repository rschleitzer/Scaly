; Regression (GAP B substep 2, escaping closures): a closure RETURNED from a
; function escapes its frame, so its record is allocated on the caller's page
; (`#`) instead of the stack. `make_adder` returns a closure capturing its
; parameter; the returned closure is called after make_adder has returned.
; Self-hosted-only.
;
;   make_adder(5) returns \x: x + 5 (captures n=5, env on caller page)
;   apply(add5, 10) = 10 + 5 = 15
;   make_adder(100) returns \x: x + 100; apply(add100, 1) = 101
; Expected: PASS

define IntFn delegate(int) returns int

function make_adder(n: int) returns IntFn
{
    return \x: x + n
}

function apply(f: IntFn, x: int) returns int
    f(x)

let add5 make_adder(5)
let add100 make_adder(100)

let r1 apply(add5, 10)
let r2 apply(add100, 1)

if r1 = 15
{
    if r2 = 101
        print("PASS")
    else
        print("FAIL add100")
}
else
    print("FAIL add5")
