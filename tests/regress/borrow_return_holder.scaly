; Regression: borrow-return holder de-sigil (2026-07-03). The restamp/unify
; shape `var out Vector[T](n) ... &out` in a ref[Vector[T]]?-returning
; function: the addr-taken promotion (plan_binding#) relocates the holder to
; the caller's page, and region_of_operand's `&promoted` arm ranks the
; returned reference Caller so the return/tail escape gates accept it —
; without the arm the compile hard-errors "reference into a local page
; escapes via return". The churn loop recycles root pages so a regressed
; local-page allocation is overwritten before the read-back. Self-hosted-only.
; Expected: PASS

package scaly 0.1.0

use scaly.containers.String
use scaly.containers.Vector

define probe
{
    function restamp_args(args: Vector[int]) returns ref[Vector[int]]?
    {
        var out Vector[int](args.length)
        var i: size_t 0
        while i < args.length
        {
            let ap args.get i
            if ap <> null
                out.put(i, (*ap))
            i := i + 1
        }
        &out
    }
}

function churn(n: size_t) returns size_t
{
    var total: size_t 0
    var i: size_t 0
    while i < n
    {
        var junk Vector[String](3)
        junk.put(0, "xxxxx")
        junk.put(1, "yyyyy")
        junk.put(2, "zzzzz")
        let jp junk.get 0
        if jp <> null
            total := total + (*jp).get_length()
        i := i + 1
    }
    total
}

function check() returns int
{
    var v Vector[int](2)
    v.put(0, 7)
    v.put(1, 35)
    let r probe.restamp_args(v)
    if r = null
        return 1
    let c churn(50)
    if c = 0
        return 4
    let rv (*r)
    let a rv.get 0
    let b rv.get 1
    if a = null
        return 2
    if b = null
        return 3
    (*a) + (*b)
}

if check() = 42
    print("PASS")
else
    print("FAIL")
