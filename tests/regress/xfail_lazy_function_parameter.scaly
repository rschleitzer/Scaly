; An argument of a method's put-in that reads a field of the CALLER's `this`
; is refused (2026-10-19, Planner.check_lazy_shadow#): the put-in binds `this`
; to the receiver where the argument is evaluated, so the emitted block would
; read the receiver's field. The way is a local: `let mine base`.
; xfail: names this, which the function binds where the argument is evaluated
define Box (v: int)
{
    function or_else(this, fallback: lazy int) returns int
        if v <> 0: v else fallback
}

define Calc (base: int)
{
    function first(this, other: Box) returns int
        other.or_else(base)
}

print "`Calc(20).first(Box(0))`"
