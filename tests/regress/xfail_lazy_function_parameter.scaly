; A lazy parameter is put in where its routine is called (2026-10-18): an
; operator's (scaly/logic.scaly) and, since 2026-10-19, a free function's
; (Planner.put_in_lazy_call#). A METHOD's would be evaluated before the call
; without a word, so it is refused (Planner.plan_function#).
; xfail: a lazy parameter is so far taken by an operator and by a free function
define Box (v: int)
{
    function or_else(this, fallback: lazy int) returns int
        if v <> 0: v else fallback
}

let b Box(0)
print "`b.or_else(5)`"
