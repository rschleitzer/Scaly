; Regression (2026-11-12), the twin of the xfail_*float* fixtures: with the
; conversion written, integers and floating-point numbers meet as they should.

var r: u32 1
let x: f32 2.5
r := r + (x as u32)
let n 3
let y 2.5 * (n as f64) + 1.0
let z: f32 x * 2.0
if r = 3 and y = 8.5 and z = 5.0 and (n as f64) > 2.5
    print "PASS"
else
    print "FAIL"
