; Regression (2026-09-23): arithmetic on a Slice VALUE. No operator resolves,
; so the Emitter added the integer to the RECORD (`add %Slice`) and
; `*(s + i)` read garbage at rc 0; the same through a field, `*(h.s + 1)`.
; opensp's corpus went 380 -> 124 over this shape with every file compiling
; clean. The view is indexed (`s[i]`), narrowed (`slice_from`/`subslice`), or
; handed to C as `s.data` (slice_view_ok.scaly).
; xfail: error: arithmetic on a Slice value
define Holder (s: Slice[char])

function second(h: Holder) returns char
    *(h.s + 1)

let text "abc"
if second(Holder(Slice[char](3, text.get_buffer() as pointer[char]))) = ("b" as char)
    print("PASS")
