; Regression: box-value-on-page primitive `&^obj v` — box a COPY of an
; existing by-value value onto a page (Page.get(obj)) and yield pointer[X]
; that outlives the frame. Replaces the hand-rolled holder idiom
; `var H Vector[X]^rp(1); H.put(0, v); H.get(0)`. Self-hosted-only.
;
;   box_point#(page, p) returns &^page p          ; box a by-value param
;   box_big#(page)      returns &# make_big() ; box an sret call RESULT
; The second case exercises the struct-by-ref load: make_big returns a wide
; struct via sret, so emit_operand yields the result-slot pointer — emit_box
; must LOAD the struct before copying, else only the 8-byte pointer is stored.
; The returned pointers survive the frame because the copies live on the
; caller's page, not the stack.
; Expected: PASS

package scaly 0.1.0

use scaly.containers.String

define Point(x: int, y: int)

define Big(a: int, b: int, c: int, d: int, e: int, f: int)

function box_point#(p: Point) returns pointer[Point]
    &# p

function make_big() returns Big
    Big(10, 20, 30, 40, 50, 60)

function box_big#() returns pointer[Big]
    &# make_big()

let src Point(3, 4)
let bp box_point#(src)
let bb box_big#()
if (*bp).x = 3
{
    if (*bp).y = 4
    {
        if (*bb).a = 10
        {
            if (*bb).f = 60
                print("PASS")
            else
                print("FAIL big.f")
        }
        else
            print("FAIL big.a")
    }
    else
        print("FAIL y")
}
else
    print("FAIL x")
