; Gate: the bounds check of Slice.operator[] MUST arrive in the emission.
;
; It is the tree's first test that really fires a RUNTIME trap
; (until 2026-09-07 none did, and the runner could not
; judge it either -- a fixture that ends with exit 15 prints no PASS).
; The marker `; expect-rc:` is there for exactly this.
;
; The receiver is constructed LOCALLY, and that is the risky shape: a
; generic operator loses its result there (tools/opzero/scan.py), but not the
; bounds check. This test pins that it stays that way.
;
; The index comes from argc so that it does not fold away.
; expect-rc: 15
; expect-out: Slice[]: index out of bounds

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[4]
    buf[0] := 10
    let s Slice[int](4, &buf[0])
    s[(argc as size_t) + 3]
}
