; Regression: `try ... when e: InvalidRegion` catches an invalid RECEIVED
; frame -- the third catchable trap kind, and the first that
; is not a programmer error in the caller's own code: the data comes from
; somewhere else, so a long-running process must be able to lose the MESSAGE
; instead of itself.
;
; Checked:
;   (1) the arm binds e with e.what (the site) and e.address (the pointer the
;       mapping choked on)
;   (2) locals of the catcher survive the jump
;   (3) the counter at the panic site counts
;   (4) the else form catches the same kind
;   (5) a VALID frame takes the success path through the same try
;   (6) two hundred catches in a row, without the program dying
;
; ★What this gate does NOT check: that the pages of the half-built receive
; come back. `Region.deserialize` gives them back through the TABLE before
; raising, and that is measured (1.5 MB against 21.4 MB peak
; RSS over 5000 catches) -- but it cannot be checked from in here: the
; HeapBucket always hands out the lowest free slot, so a probe page's address
; is the same with and without the leak. Two versions of that probe passed the
; control WITHOUT the release; a vacuous check would be worse than none.
;
; Expected: PASS

define Msg (n: i64, more: pointer[u8])

function make_frame(host: ref[Page], bend: bool) returns pointer[u8]
{
    let mp Page.allocate_page()
    let msg mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    msg.n := 42
    msg.more := mp.allocate(16 as size_t, 8 as size_t) as pointer[u8]
    let frame Region.serialize(mp, msg as pointer[void], host)
    mp.deallocate_extensions()
    Page.release_page(mp)
    if bend
    {
        let h frame as pointer[u64]
        *(h + 3) := 0x1000 as u64
    }
    frame
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var before_local 100
    before_local := before_local + argc
    let before Region.panic_region_count()

    let host Page.allocate_page()
    let bad make_frame(host, true)

    try let rr Region.deserialize(bad, host)
        when e: InvalidRegion
        {
            ; (2) locals of the catcher
            if before_local <> 101
            {
                print "FAIL: a local of the catcher did not survive the jump"
                return 1
            }

            ; (1) the address the mapping choked on
            if e.address <> (0x1000 as size_t)
            {
                print "FAIL: e.address does not name the bent root"
                return 2
            }

            ; (3) counted
            if Region.panic_region_count() - before <> 1
            {
                print "FAIL: the region counter did not count exactly once"
                return 3
            }

            ; (1) and the site, as text
            let w String(e.what)
            if w.equals(String("Region.deserialize: root outside the received region")) = false
            {
                print "FAIL: e.what does not name the site"
                print w
                return 4
            }
        }

    ; (4) the else form catches the same kind
    var caught_else false
    let host2 Page.allocate_page()
    let bad2 make_frame(host2, true)
    try let rr2 Region.deserialize(bad2, host2)
    else
        caught_else := true
    if caught_else = false
    {
        print "FAIL: the else form did not catch the invalid frame"
        return 5
    }

    ; (5) a VALID frame goes through the same try
    let host3 Page.allocate_page()
    let good make_frame(host3, false)
    var ok false
    try let rr3 Region.deserialize(good, host3)
        when e3: InvalidRegion
        {
            print "FAIL: the valid frame panicked"
            return 6
        }
    if rr3 <> null
    {
        ok := true
        let r3 rr3 as ref[ReceivedRegion]
        r3.release()
    }
    if ok = false
    {
        print "FAIL: the valid frame produced no region"
        return 7
    }

    ; (6) two hundred catches in a row
    var i 0
    while i < 200
    {
        let h4 Page.allocate_page()
        let f4 make_frame(h4, true)
        var c4 false
        try let rr4 Region.deserialize(f4, h4)
        else
            c4 := true
        if c4 = false
        {
            print "FAIL: a later catch did not happen"
            return 8
        }
        h4.deallocate_extensions()
        Page.release_page(h4)
        i := i + 1
    }
    if Region.panic_region_count() - before <> 202
    {
        print "FAIL: the total number of catches is wrong"
        return 9
    }

    print "PASS"
    0
}
