; Regression (2026-11-01): a vector literal as a VALUE has no lowering -- the
; plan gave it the type of no value, the emitter a stack array of empty
; records, and a typed binding read the array's address as the vector's
; length at rc 0 (`let ys: Vector[String] ["a", "b"]` was empty).
;
; xfail: a vector literal is not a value

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    let ys: Vector[int] [5, 6, 7]
    if ys.length = 3
        print "FAIL\n"
    0
}
