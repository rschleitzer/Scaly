; The positive control for xfail_deref_non_pointer: a deref of something that
; genuinely IS pointer-shaped must stay silent -- the Option a lookup answers,
; and a raw buffer walked with pointer arithmetic. Prints PASS.

var a Array[int]()
a.add 5
let r a.get(0 as size_t)
var ok true
if r = null
    set ok: false
else
{
    if (*r) <> 5
        set ok: false
}

var v Vector[int](2)
v.put(0 as size_t, 9)
let p v.data
if (*(p + 0)) <> 9
    set ok: false

; and the subscript itself needs no star any more
if a[0] <> 5
    set ok: false

if ok
    print "PASS"
else
    print "FAIL"
