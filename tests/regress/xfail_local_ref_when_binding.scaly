; Regression (2026-09-24): the address of a `when` binding — a COPY of the
; union arm, living in this frame — kept in a local and returned. This is the
; "set ref_var: <choose-bound value>" class CLAUDE.md carried as ACTIVE since
; session 25: rc 0, and under SCALY_POISON the caller read garbage.
; xfail: error: reference into a local page escapes via return
define Payload (var name: String  var n: int)
define U union (A: Payload  B: int)

procedure pick(n: int) returns ref[Payload]?
{
    let u U.A(Payload(String("hello"), n))
    var r: ref[Payload]? null
    choose u
        when a: A
            r := &a
        else
            0
    r
}

let p pick(42)
print("FAIL")
