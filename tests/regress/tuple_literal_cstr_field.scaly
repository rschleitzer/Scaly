; A String LITERAL bound to a pointer[const_char]-like FIELD on the
; positional-tuple construction path is the c_data pointer, not the varint
; String record.
;
; Before 2026-08-29 it was the record: a construction that matched no init#
; falls through to the tuple path, where no parameter list steers the
; argument, so the literal was stored as `@.sconst = c"\02as\00"` and the
; field then pointed at the LENGTH BYTE. `Holder("as", 2).first()` answered
; 2 where the identical record WITH a matching init# answered 97 — rc 0,
; nothing said.
;
; `Slice[T]` declares only `init ()`, so EVERY `Slice[T](p, n)` runs this
; path, which is why the defect was first recorded as a `Slice[const_char]`
; one. The element type is innocent and every arm below proves it: each
; reads 97 from a literal and 97 from a real buffer.

define Holder (data: pointer[char], n: size_t)
{
    function first(this) returns int
        *data as int
}

define HolderCC (data: pointer[const_char], n: size_t)
{
    function first(this) returns int
        *data as int
}

define HolderInit (data: pointer[char], n: size_t)
{
    init(d: pointer[char], k: size_t)
    {
        set data: d
        set n: k
    }
    function first(this) returns int
        *data as int
}

var ok true

; the tuple path, plain records
if Holder("as", 2).first() <> 97
    set ok: false
if HolderCC("as", 2).first() <> 97
    set ok: false

; the same record with a matching init# — the arm that was always right
if HolderInit("as", 2).first() <> 97
    set ok: false

; Slice, every VALUE element type, from a literal.
;
; ★`Slice[const_char]` was covered here and is DELIBERATELY GONE (2026-08-30).
; `const_char` is a POINTEE MARKER for the C boundary, not a value type: every
; one of its occurrences in the tree is `pointer[const_char]` in an `extern` or
; a cast, and `Planner.is_primitive_type_name` does not know the name, so a
; bare `const_char` is `unknown type`. That never surfaced while `Slice`'s only
; T-by-value member was `operator []`, which is emitted ONLY WHERE USED --
; adding the `put` METHOD, which is emitted for EVERY instantiation, made
; `Slice[const_char]` uncompilable. The element type is now `char` at all four
; sites that used it (Emitter.jit_symbol_in_set, tscaly's Keywords/parser/
; checker); `type_is_cstr_pointer#` accepts `pointer[char]`, so the literal
; coercion this file guards is unchanged. **Do not restore these rows** --
; restoring them re-breaks the build, and the cstr-FIELD coverage that is this
; file's actual subject lives in HolderCC/HolderInit above.
if (Slice[char]("as", 2)[0] as int) <> 97
    set ok: false
if (Slice[u8]("as", 2)[0] as int) <> 97
    set ok: false

; and from a real buffer — the direction that was never broken, kept as the
; control so a fix that breaks it cannot pass
;
; The cast is load-bearing and not noise: `c_data()` answers
; pointer[const_char], and is_char_like_cross_compatible# accepts
; (param=const_char, arg=char) but REFUSES the reverse on purpose — "you must
; not silently assign immutable data to mutable storage". The tuple path never
; asked until report_component_type_mismatch# landed; the `u8` line below
; needs no cast because the u8 row of that table accepts the whole family.
let s String("as")
let d s.c_data()
if (Slice[char](d as pointer[char], 2)[0] as int) <> 97
    set ok: false
if (Slice[u8](d, 2)[0] as int) <> 97
    set ok: false

; the length field is untouched by the coercion
if Slice[char]("as", 2).length <> (2 as size_t)
    set ok: false

; a multi-character literal still reads its SECOND byte correctly — the
; varint form would have shifted every index by one
if (Slice[char]("as", 2)[1] as int) <> 115
    set ok: false

if ok
    println "PASS"
else
    println "FAIL"
