; `=` at the START of an operation is a prefix that does nothing
; (the author, 2026-10-04): a binding, a `set`, a
; return, a tuple component, a vector element and a one-expression body may
; all begin with it. Anywhere else `=` compares -- (3) and (6) hold both.
; A binding dropped its leading `=` before; the others are new.
; Expected: PASS

define Pair (a: int, b: int)

function twice(n: int) returns int
    = n * 2

function same(a: int, b: int) returns bool
{
    return = a = b
}

var ok true

let a = 42
var b = a + 1
if a <> 42 or b <> 43
    ok := false

b := 7
if b <> 7
    ok := false

let eq = a = 42
if eq = false
    ok := false

let p Pair(= 1, = 2)
if p.a <> 1 or p.b <> 2
    ok := false

if twice(= 4) <> 8
    ok := false

if same(3, 3) = false or same(3, 4)
    ok := false

if ok
    print "PASS"
