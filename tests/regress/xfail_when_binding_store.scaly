; xfail: error: the when binding a is a copy of the union arm, and a store into it changes nothing
;
; Regression (2026-09-23): a member store into a `when` binding. The binding is
; a COPY of the arm (and the choose copies its subject first), so the store can
; never reach the union — and the emitter GEP'd through the LOADED payload VALUE
; (`getelementptr %PayloadA, %PayloadA %variant.val`), storing to wherever the
; payload's first eight bytes pointed: this program died with exit 139 before it
; printed a line (x = 1 is the address). The idiom is copy the arm out, change
; the copy, write the arm back (when_binding_store_ok.scaly).
define PayloadA (var x: int  var y: int)
define PayloadB (var z: int)
define Data union (A: PayloadA  B: PayloadB)
define Holder (var data: Data)

procedure bump(mutable h: ref[Holder])
{
    choose h.data
        when a: A
            set a.x: a.x + 100
        else
            0
}

let root Page.allocate_page()
let h &Holder^root(Data.A(PayloadA(1, 2)))
bump(h)
