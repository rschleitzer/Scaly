; Regression (2026-09-27): a PREFIX operator applied to a CALL on the right side
; of a binary operator (`6 <= *w(b, 0)`, `5 - -f(3)`). The prefix branch of the
; operand collapse took the prefix and the callee NAME and left the argument
; tuple behind: a comparison and the `if` around it vanished (neither arm ran),
; an arithmetic right side was garbage — rc 0 under the previous compiler.
; The call is folded before the prefix now. `lhs` and `var_rhs` were right
; before and stay pinned beside it.
; Expected: PASS
function w(p: pointer[u64], i: i64) returns pointer[u64]
    ((p as size_t) + ((i * 8) as size_t)) as pointer[u64]

function f(x: int) returns int
    x * 2

define Box (v: int)
{
    function get(this, k: int) returns int
        v + k
}

procedure check() returns int
{
    var buf u64[2]
    let b buf as pointer[u64]
    set *w(b, 0): 5 as u64
    set *w(b, 1): 7 as u64
    let q w(b, 1)
    var hit 0
    if 6 <= *w(b, 0)
        return 1
    else
        set hit: hit + 1
    if *q >= *w(b, 0)
        set hit: hit + 1
    else
        return 2
    if *w(b, 1) >= *q
        set hit: hit + 1
    if hit <> 3
        return 3
    let d *w(b, 1) - *w(b, 0)
    if d <> (2 as u64)
        return 4
    if 5 - -f(3) <> 11
        return 5
    var z 1
    set z: z + -f(2)
    if z <> 0 - 3
        return 6
    let bx Box(10)
    if 100 - -bx.get(2) <> 112
        return 7
    let lhs *w(b, 1) - 3
    if lhs <> (4 as u64)
        return 8
    let var_rhs *q - *w(b, 0) + *q
    if var_rhs <> (9 as u64)
        return 9
    42
}

let rc check()
if rc = 42
    print("PASS")
else
    print("FAIL `rc`")
