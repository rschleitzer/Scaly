; Regression (2026-09-23): a CHAINED call (`this.acc().m(x)`) as an operand of
; a binary operator. The right side's call-fold took ONE argument tuple, and
; the method hop rides on that tuple: `a or this.acc().m(x)` evaluated only
; `this.acc()` and handed its pointer to the phi as the bool — false for every
; input at rc 0 (tscaly lessons §3.5jm for `or`, §3.5kw for `and`). The whole
; run of tuples is folded now. Every shape below answered wrong or was refused
; under the previous compiler except `alone` and `or_bound`.
; Expected: PASS
define Judge (limit: int)
{
    function is_big(this, x: int) returns bool
        x > limit
    function twice(this, x: int) returns int
        x * 2
    function me(this) returns ref[Judge]
        this
}

define Host (judge: ref[Judge])
{
    function the_judge(this) returns ref[Judge]
        judge

    function alone(this, x: int) returns bool
        this.the_judge().is_big(x)

    function or_bound(this, a: bool, x: int) returns bool
    {
        let big this.the_judge().is_big(x)
        a or big
    }

    function or_chain(this, a: bool, x: int) returns bool
        a or this.the_judge().is_big(x)

    function and_chain(this, a: bool, x: int) returns bool
        a and this.the_judge().is_big(x)

    function lhs_or(this, a: bool, x: int) returns bool
        this.the_judge().is_big(x) or a

    function three_hops(this, a: bool, x: int) returns bool
        a or this.the_judge().me().is_big(x)

    function cmp_rhs(this, x: int) returns bool
        18 = this.the_judge().twice(x)

    function arith_rhs(this, x: int) returns int
        1 + this.the_judge().twice(x)
}

function check() returns int
{
    let root Page.allocate_page()
    let j &Judge^root(5)
    let h Host(j)
    if h.alone(9) = false
        return 1
    if h.or_bound(false, 9) = false
        return 2
    if h.or_chain(false, 9) = false
        return 3
    if h.or_chain(false, 1)
        return 4
    if h.and_chain(true, 9) = false
        return 5
    if h.and_chain(true, 1)
        return 6
    if h.lhs_or(false, 9) = false
        return 7
    if h.three_hops(false, 9) = false
        return 8
    if h.cmp_rhs(9) = false
        return 9
    if h.arith_rhs(9) <> 19
        return 10
    42
}

let rc check()
if rc = 42
    print("PASS")
else
    print("FAIL `rc`")
