; Regression: cstring literal in return position (S80 finding, fixed
; 2026-07-29). A function `returns pointer[const_char]` returning string
; literals emitted `ret ptr null` for EVERY such return (tail, single
; explicit return, and multi-branch arms — the arms additionally lost
; their ret entirely and fell through), so callers dereferenced NULL
; (RtfFOTBuilder.raw SIGSEGV; worked around with direct-emitting
; helpers). The fix wraps the string constant in PlannedAs in
; plan_return and the plan_action implicit-tail path — the same shape
; coerce_string_args_to_cstr gives argument positions — so emit_as
; lowers it to the plain .str global pointer. Expected: PASS

function f_tail() returns pointer[const_char]
    " CE"

function f_single() returns pointer[const_char]
{
    return " CYR"
}

function f_multi(i: int) returns pointer[const_char]
{
    if i = 1
        return " A"
    if i = 2
        return " B"
    return " other"
}

function check() returns int
{
    let t f_tail()
    if t = null
        return 1
    if *(t + 1) <> "C"
        return 2
    let s f_single()
    if s = null
        return 3
    if *(s + 3) <> "R"
        return 4
    let a f_multi(1)
    if a = null
        return 5
    if *(a + 1) <> "A"
        return 6
    let b f_multi(2)
    if b = null
        return 7
    if *(b + 1) <> "B"
        return 8
    let o f_multi(9)
    if o = null
        return 9
    if *(o + 1) <> "o"
        return 10
    0
}

if check() = 0
    print("PASS")
else
    print("FAIL")
