; Runtime trap: a RECEIVED region does not hold together (exit 18).
;
; The frame is serialized properly and then bent -- the old root address in
; its header (`h[3]`) afterwards points at 0x1000, i.e. at nothing inside the
; region. That is exactly what happens in operation when a sender ships a
; region that was not closed, when a generated walker runs with the wrong
; field map, or when a frame arrives corrupt off the wire.
;
; ★It is exit 18 and NOT 17: 17 was both this runtime fault AND the planner's
; stack guard, a compile-time abort that must never be catchable. One code
; cannot mean both; this gate holds the split.
;
; It also checks that the message names the ADDRESS: that is what separates a
; wrong walker from a truncated frame.
;
; expect-rc: 18
; expect-out: Region.deserialize: root outside the received region
; expect-out: 0x0000000000001000

define Msg (n: i64, more: pointer[u8])

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int io
{
    let mp Page.allocate_page()
    let msg mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]
    set msg.n: 42
    set msg.more: mp.allocate(16 as size_t, 8 as size_t) as pointer[u8]

    let host Page.allocate_page()
    let frame Region.serialize(mp, msg as pointer[void], host)
    mp.deallocate_extensions()
    Page.release_page(mp)

    let h frame as pointer[u64]
    set *(h + 3): 0x1000 as u64

    let rr Region.deserialize(frame, host)
    print "FAIL: the invalid frame went through"
    0
}
