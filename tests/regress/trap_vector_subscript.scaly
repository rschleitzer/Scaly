; Gate: Vector.operator[]. The Vector is of FIXED size and is frozen here from
; an Array -- the shape the tree uses.
; expect-rc: 15
; expect-out: Vector[]: index out of bounds

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var arr Array[int]()
    arr.add(10)
    arr.add(11)
    let v Vector[int](arr)
    v[(argc as size_t) + 1]
}
