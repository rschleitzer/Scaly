; Gate: Slice.put -- the write path. It writes THROUGH the view into memory
; that does not belong to it, which is why an index beside it would overwrite
; foreign memory here. So the check is not only a diagnosis.
; expect-rc: 15
; expect-out: Slice.put: index out of bounds

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[4]
    buf[0] := 10
    let s Slice[int](4, &buf[0])
    s.put((argc as size_t) + 3, 99)
    0
}
