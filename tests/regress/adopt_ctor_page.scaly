; Regression: step-D adoption rule (2026-07-04). A defaulted (no-sigil)
; construction in an arg position of an explicit-^ ctor becomes a field
; of the ^-allocated aggregate, so its guts must live on the ctor's
; page. Without the adoption restamp the inner String defaults to the
; constructing frame's local page (rule 1), which is released when init
; returns and recycled by the churn loop before the read-back.
; Covers BOTH wirings: Named (data class, reshape path) and the String
; arg (init ctor path, restamped by restamp_components).
; Self-hosted-only.
; Expected: PASS

package scaly 0.1.0

use scaly.containers.String
use scaly.containers.Vector

define Named
(
    id: size_t
    name: String
)

define Owner
(
    named: pointer[Named]
)
{
    init(n: String)
    {
        named := Named^this(1, String(n))
    }

    function read_back(this: Owner) returns size_t
        (*named).name.get_length()
}

function churn(n: size_t) returns size_t
{
    var total: size_t 0
    var i: size_t 0
    while i < n
    {
        var junk Vector[String](3)
        junk.put(0, "xxxxx")
        junk.put(1, "yyyyy")
        junk.put(2, "zzzzz")
        let jp junk.get 0
        if jp <> null
            total := total + (*jp).get_length()
        i := i + 1
    }
    total
}

function check() returns int
{
    var o Owner("hello")
    let c churn(50)
    if c = 0
        return 4
    if o.read_back() <> 5
        return 1
    42
}

if check() = 42
    print("PASS")
else
    print("FAIL")
