; Runtime trap: `x as ref[T]` met a null (exit 21).
;
; ★Until today NO gate pinned this trap -- the same situation as
; for the eight bounds traps, and invisible for the same reason: a
; trap cannot reach the PASS-on-stdout convention. Hence an `expect-rc`
; fixture.
;
; Both halves of what the message does are checked: that it arrives at all,
; and that it names the PLACE -- a run has no source location, so the mangled
; name of the enclosing symbol is what a reader can grep for.
;
; expect-rc: 21
; expect-out: Scaly: null unwrapped as ref in
; expect-out: _Z5probem

function probe(n: size_t) returns int
{
    var buf int[2]
    buf[0] := 10
    let s Slice[int](2, &buf[0])
    let r s.get(n) as ref[int]         ; the claim, and it is false
    r
}

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    let v probe((argc as size_t) + 4)
    v as int
}
