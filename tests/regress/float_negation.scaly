; A prefix minus on a double negates it as a double (2026-10-21,
; Emitter.emit_intrinsic_unary_op#): it asked the result type's name, which
; knew `double` and not `f64`, and negated the value as an integer --
; `sub (double 0.0, double 2.5)` answered -1.75 at rc 0, for `-2.5`, `-x`,
; `-(2.5)` and `abs` alike.
let x 2.5
let a -2.5
let b -x
let c -(x * 2.0)
let d abs -x
let e: f32 -(1.5 as f32)
if a = 0.0 - 2.5 and b = 0.0 - 2.5 and c = 0.0 - 5.0 and d = 2.5 and e = (0.0 as f32) - (1.5 as f32)
    print "PASS"
else
    print "FAIL"
