; 7.2 compiler-generated walkers: NPO Option fields. `pointer[Cell]?` is
; a bare nullable pointer at the LLVM level (null = None) — the walker
; fixes it like any pointer slot and descends only when nonnull. Chain of
; two cells round-trips; the None tail stays null.
; Expected: PASS

define Cell
(
    name: String
    next: pointer[Cell]?
)

let mp Page.allocate_page()
let c1 mp.allocate(sizeof Cell, alignof Cell) as pointer[Cell]
let c2 mp.allocate(sizeof Cell, alignof Cell) as pointer[Cell]
let n1 String^mp("one")
c1.name := n1
c1.next := c2
let n2 String^mp("two")
c2.name := n2
c2.next := null

let host Page.allocate_page()
let frame Region.serialize(mp, c1 as pointer[void], host)
mp.deallocate_extensions()
Page.release_page(mp)

let rr Region.deserialize(frame, host)
if rr = null
    exit 4
let rroot rr.root
let r1 rroot as pointer[Cell]
rr.fix_graph(r1)

var ok true
let rn1 r1.name
if rn1.equals("one") = false
    ok := false
if r1.next = null
    exit 5
let r2 r1.next
let rn2 r2.name
if rn2.equals("two") = false
    ok := false
if r2.next <> null
    ok := false

rr.release()

if ok
    print("PASS")
else
    print("FAIL")
