; Expected-failure: a `try` with a fault arm AND a foreign arm.
;
; The OutOfBounds arm alone would be reachable, the other never -- so the
; form is a confusion, and it gets a message OF ITS OWN. Until the
; differentiation it said "the when arms are unreachable", which was not true
; for the fault arm.
; xfail: this try mixes a runtime-fault arm

define E union (Nonsense: D)
define D(a: int)

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[2]
    let s Slice[int](2, &buf[0])
    try let x s[(argc as size_t) + 4]
        when e: OutOfBounds
            return 1
        when f: Nonsense
            return 2
    x as int
}
