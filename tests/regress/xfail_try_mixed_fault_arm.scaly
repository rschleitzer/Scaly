; Expected-failure: ein `try` mit einem Fault-Arm UND einem fremden Arm.
;
; Der OutOfBounds-Arm allein waere erreichbar, der andere nie -- also ist die
; Form eine Verwirrung, und sie bekommt eine EIGENE Meldung. Bis zur
; Differenzierung sagte sie "the when arms are unreachable", was fuer den
; Fault-Arm nicht stimmte.
; xfail: this try mixes a runtime-fault arm

define E union (Nonsense: D)
define D(a: int)

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var buf int[2]
    let s Slice[int](2, &buf[0])
    try let x s[(argc as size_t) + 4]
        when e: OutOfBounds
            return 1
        when f: Nonsense
            return 2
    x as int
}
