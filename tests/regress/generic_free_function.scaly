; Regression: a generic FREE function must be MONOMORPHIZED against its
; explicit type-argument list (2026-09-04).
;
; A generic function whose type parameter appears only in the RETURN type has
; nothing to infer from, and `resolve_function_call` matched the UNINSTANTIATED
; declaration: every parameter was concrete, so the candidate matched as-is.
; The IR named it — the mangled symbol carried NO type argument and the return
; type was the generic one:
;
;   define %_Z5SliceI1TE @_Z11alloc_slice...Pagem(...)   ← Slice[T], not Slice[u64]
;     %mul = mul i64 %2, 8                               ← sizeof T folded to 8
;
; The caller expects Slice[u64] and got Slice[T] — the same SIZE by luck, so it
; linked, ran, and answered a garbage value at rc 0. `sizeof T` folding to 8 is
; the second half: right for a 64-bit T by accident, wrong for every other one.
;
; The explicit list rides operand 0 as a PlannedType's `generics` (the s107
; pre-pass folds `name + Matrix` into it) and is now threaded into
; resolve_function_call and bound BY POSITION.
;
; The test uses TWO different element widths on purpose: with the defect the
; u32 leg reads at the wrong stride, so a single-width test could pass by the
; same luck that hid this for months. The inferable form is checked alongside —
; it always worked, and must keep working.
;
; Expected: PASS

use scaly.memory.Page

; T only in the RETURN type — nothing to infer from
function make_of[T](host: ref[Page], n: size_t) returns Slice[T]
    Slice[T](n, host.allocate(n * sizeof T, alignof T) as pointer[T])

; T inferable from the argument — the path that always worked
function first_of[T](s: Slice[T]) returns T
    s[0 as size_t]

let rp Page.allocate_root_page()
let host rp as ref[Page]

var ok true

; 64-bit element
var a make_of[u64](host, 4 as size_t)
a.put(0 as size_t, 11 as u64)
a.put(3 as size_t, 44 as u64)
if (a[0 as size_t] as int) <> 11
    set ok: false
if (a[3 as size_t] as int) <> 44
    set ok: false

; 32-bit element: a different stride, which the folded `sizeof T` gets wrong
var b make_of[u32](host, 4 as size_t)
b.put(0 as size_t, 7 as u32)
b.put(3 as size_t, 9 as u32)
if (b[0 as size_t] as int) <> 7
    set ok: false
if (b[3 as size_t] as int) <> 9
    set ok: false

; the inferable form still works
if (first_of[u64](a) as int) <> 11
    set ok: false

if ok
    print "PASS"
if ok = false
    print "FAIL"
