; Regression: a `when` arm selects by the KIND of the panic, not by "any
; panic".
;
; With more than one catchable kind that is a checkable claim -- and the
; coupling it rests on is tight: the variant TAG of one union in the prelude
; must agree with what `scaly_panic_last_kind` answers in the shim. If those
; two orders disagreed, an arm would bind another kind's payload and nothing
; would say a word. Hence every pairing.
;
; Expected: PASS

function null_trap(n: size_t) returns int
{
    var buf int[2]
    buf[0] := 7
    let v Slice[int](2, &buf[0])
    let r v.get(n) as ref[int]
    r
}

function oob_trap(n: size_t) returns int
{
    var buf int[2]
    buf[0] := 7
    let v Slice[int](2, &buf[0])
    v[n]
}

procedure size_trap(mutable arr: ref[Array[int]], buf: pointer[int])
{
    ; a Vector that lies about its length: (len, data) allocates nothing
    let huge Vector[int]((0 as size_t) - (1 as size_t), buf)
    arr.add(huge)
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    let bad (argc as size_t) + 4

    ; (1) a NULL panic against an OutOfBounds arm: the arm stays cold and the
    ;     else catches
    var wrong_arm false
    var else_ran false
    try let a null_trap(bad)
        when e: OutOfBounds
            wrong_arm := true
    else
        else_ran := true
    if wrong_arm
    {
        print "FAIL: the OutOfBounds arm caught a null panic"
        return 1
    }
    if else_ran = false
    {
        print "FAIL: the else did not catch the null panic"
        return 2
    }

    ; (2) a BOUNDS panic against a NullReference arm: the same the other way
    var wrong_arm2 false
    var else_ran2 false
    try let b oob_trap(bad)
        when e2: NullReference
            wrong_arm2 := true
    else
        else_ran2 := true
    if wrong_arm2
    {
        print "FAIL: the NullReference arm caught a bounds panic"
        return 3
    }
    if else_ran2 = false
    {
        print "FAIL: the else did not catch the bounds panic"
        return 4
    }

    ; (3) each kind against its own arm, with its payload's detail
    var oob_ok false
    try let c oob_trap(bad)
        when e3: OutOfBounds
            if e3.index = (5 as size_t)
                if e3.length = (2 as size_t)
                    oob_ok := true
    if oob_ok = false
    {
        print "FAIL: the OutOfBounds arm stayed out or lied"
        return 5
    }

    var null_ok false
    try let d null_trap(bad)
        when e4: NullReference
            if e4.where <> null
                null_ok := true
    if null_ok = false
    {
        print "FAIL: the NullReference arm stayed out or lied"
        return 6
    }

    ; (4) and the form a real catcher writes: BOTH arms on one try, a switch
    ;     with two cases -- each kind takes its own
    var pick1 0
    try let e5 oob_trap(bad)
        when e6: OutOfBounds
            pick1 := 1
        when e7: NullReference
            pick1 := 2
    var pick2 0
    try let e8 null_trap(bad)
        when e9: OutOfBounds
            pick2 := 1
        when e10: NullReference
            pick2 := 2
    if pick1 <> 1
    {
        print "FAIL: with two arms the bounds panic took the wrong one"
        return 7
    }
    if pick2 <> 2
    {
        print "FAIL: with two arms the null panic took the wrong one"
        return 8
    }

    ; (5) ★★★The most dangerous pairing, because the two share a payload
    ;     SHAPE: SizeOverflow and OutOfBounds are both two size_t. If the
    ;     orders in the prelude union and in the shim disagreed, an
    ;     OutOfBounds arm would bind two numbers here without complaint --
    ;     the wrong two.
    var arr Array[int]()
    arr.add(1)
    arr.add(2)
    var sbuf int[2]
    sbuf[0] := 7
    var wrong_oob false
    var size_ok false
    try size_trap(&arr, &sbuf[0])
        when e11: OutOfBounds
            wrong_oob := true
        when e12: SizeOverflow
            if e12.length = (2 as size_t)
                size_ok := true
    if wrong_oob
    {
        print "FAIL: the OutOfBounds arm caught a size overflow"
        return 9
    }
    if size_ok = false
    {
        print "FAIL: the SizeOverflow arm stayed out or lied"
        return 10
    }

    print "PASS"
    0
}
