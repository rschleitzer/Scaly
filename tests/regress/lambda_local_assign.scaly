; A lambda may freely assign a BODY-LOCAL variable (not a capture) — the
; WP9 capture-assignment check must not flag it. Here `acc` is bound inside
; the lambda body, so `set acc:` is legal.
; Expected: PASS
let inc \x: { var acc x
acc := acc + 1
acc }
if inc(41) <> 42
{
    print("FAIL")
    exit 1
}
print("PASS")
