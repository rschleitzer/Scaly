; Control for xfail_absorbed_after_choose.scaly: the same `choose` in a BRACED
; `if` body ends with the body, and the line after the `if` is the function's
; value again.
; Expected: PASS
define Expr union
(
    Name: int
    Other: int
)

function probe(gate: int, e: Expr) returns int
{
    if gate = 1
    {
        choose e
            when n: Name
                if n > 0
                    return 10
            else
                0
    }
    77
}

if probe(0, Expr.Name(5)) = 77 and probe(1, Expr.Name(5)) = 10 and probe(1, Expr.Other(1)) = 77
    print "PASS"
else
    print "FAIL"
