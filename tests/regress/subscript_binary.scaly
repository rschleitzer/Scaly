; Regression: `base[index] <op> rhs` — a subscript followed by a binary
; operator mis-collapsed (the operator fell into the prefix branch, was
; built as a unary intrinsic, and the whole expression dropped; since the
; s185 hard trap it aborted with "unknown unary operator"). The fix:
; (1) collapse_operand_sequence's subscript pre-pass fuses [value, Matrix]
; into a `[]` operator call before the prefix/binary machinery runs;
; (2) find_subscript_operator dispatches to the concept's `operator []`,
; planning + recording it on first use (mirrors stage-0's
; findSubscriptOperator); (3) the Modeler no longer drops routine-target
; operator members (the stage-1-era handle_constituent workaround);
; (4) plan_operator prepends the implicit `this` receiver and binds it as
; pointer[T] so bare field reads in operator bodies resolve.
; Also covers: parenthesized subscript groups (plan_component collapse
; gate), out-of-bounds -> null, and a user-defined struct's `operator []`
; reading a field. Self-hosted-only. Expected: PASS

package scaly 0.1.0

use scaly.containers.Vector

define Doubler(factor: int)
{
    operator [](i: int) returns int
        factor * i
}

function check() returns int
{
    var v Vector[int](2)
    v.put(0, 30)
    v.put(1, 2)
    if v[0] = null
        return 1
    if v[5] <> null
        return 2
    let r v[0]
    if r = null
        return 3
    let a (*r)
    let s (v[1])
    if s = null
        return 4
    let b (*s)
    if a + b <> 32
        return 5
    let d Doubler(5)
    let x d[2]
    a + b + x
}

if check() = 42
    print("PASS")
else
    print("FAIL")
