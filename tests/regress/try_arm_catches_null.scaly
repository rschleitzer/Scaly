; Regression: `try ... when e: NullReference` catches the NULL UNWRAP
; (TRAPS.md 3.12) -- the second catchable trap kind.
;
; The trap sits two frames deep in code that knows nothing about catch points:
; `x as ref[T]` is the claim that something is there, and it is false. Without
; a `try` the same access ends the process with exit 21
; (trap_null_unwrap.scaly).
;
; Checked:
;   (1) the arm binds e with e.where, and that names the enclosing symbol
;   (2) locals of the CATCHER survive the jump (returns_twice)
;   (3) the regions of the skipped frames come back
;   (4) the counter at the panic site counts the CAUGHT trap -- only since the
;       kind became catchable can anybody read it at all
;   (5) the `else` form catches the same kind without naming it
;   (6) a valid run takes the success path
;
; Expected: PASS

function inner(n: size_t) returns int
{
    let s String("a region on this frame")
    var buf int[2]
    set buf[0]: 7
    let v Slice[int](2, &buf[0])
    let r v.get(n) as ref[int]        ; for n >= 2 the claim is false
    r + ((s.get_length() as int) / 22)
}

function outer(n: size_t) returns int
    inner(n) + 1

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    var before_local 100
    set before_local: before_local + argc
    let mark0 scaly_panic_mark()
    let before Region.panic_null_count()

    try let a outer((argc as size_t) + 4)
        when e: NullReference
        {
            ; (2) locals of the catcher
            if before_local <> 101
            {
                print "FAIL: a local of the catcher did not survive the jump"
                return 2
            }

            ; (3) regions back
            if scaly_panic_mark() <> mark0
            {
                print "FAIL: the region watermark has moved"
                return 3
            }

            ; (4) counted, and readable because we are alive
            if Region.panic_null_count() - before <> 1
            {
                print "FAIL: the null counter did not count exactly once"
                return 4
            }

            ; (1) the place, as the mangled name of the enclosing symbol.
            ;     ★This check comes AFTER the watermark check ON PURPOSE: the
            ;     String construction is this frame's first allocation and
            ;     moves the watermark itself, which turned check (3) red -- a
            ;     measurement that moves its own instrument.
            let w String(e.where)
            if w.equals(String("_Z5innerm")) = false
            {
                print "FAIL: e.where does not name the symbol"
                print w
                return 1
            }

            ; (5) the else form catches the same kind
            var caught_else false
            try let b outer((argc as size_t) + 4)
            else
                set caught_else: true
            if caught_else = false
            {
                print "FAIL: the else form did not catch the null unwrap"
                return 5
            }
            if Region.panic_null_count() - before <> 2
            {
                print "FAIL: the second catch was not counted"
                return 6
            }

            ; (6) and a valid run goes through
            try let c outer(0)
                when e3: NullReference
                {
                    print "FAIL: the valid run panicked"
                    return 7
                }
            if c <> 9
            {
                print "FAIL: the valid run returned nothing"
                return 8
            }

            print "PASS"
            return 0
        }
    print "FAIL: not caught"
    9
}
