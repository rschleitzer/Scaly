; A record `var` no initializer names, set to a call's result: the copy goes
; to its set site's stack slot, not to the frame page (record_var_set pins
; what it computes). Before 2026-09-29 every such set allocated on the frame
; page -- once per string in the json parser.
; expect-ir: set.slot

define R (a: int, b: size_t, c: bool)

function f(x: int) returns R
    R(x, 1, true)

procedure g(k: int) returns int
{
    var r R(0, 2, false)
    if k > 3
        r := f(k)
    r.a
}

print "`g(5)`"
