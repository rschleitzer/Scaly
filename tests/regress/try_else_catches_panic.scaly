; Regression: `try ... else` catches a runtime PANIC.
;
; Until 2026-09-07 this form was a silent no-op -- the trap ended the
; process with rc 15 as if no try stood there. Now the Emitter installs
; a catch point BEFORE the condition (emit_try_panic_catch#).
;
; Checked is what the form has to carry:
;   (1) locals of the CATCHER survive the jump -- that hangs on the
;       returns_twice attribute on setjmp; without it LLVM would be free to
;       pull them into registers, and after the jump anything could stand there.
;   (2) the success path binds the variable and runs through normally
;   (3) the regions of the skipped frames come back (water mark)
;   (4) nesting: a try INSIDE the catch branch of another
;
; The when-arm form is NOT here: it needs a union value in memory
; and is not built yet -- an arm without a throwing condition is the hard
; diagnostic in xfail_try_without_throw.scaly.
;
; Expected: PASS
function deep(n: i64) returns i64
{
    let s String("eine Region auf diesem Rahmen")
    var buf int[2]
    buf[0] := 7
    let v Slice[int](2, &buf[0])
    if n > 0
        return v[(n as size_t) + 4]
    (s.get_length() as i64)
}

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    ; (1) locals that must survive the jump
    var vor 100
    let konstant 41
    vor := vor + argc

    let mark0 scaly_panic_mark()

    try let a deep(1)
    else
    {
        if vor <> 101
        {
            scaly_eputs "FAIL: local lost after the jump"
            scaly_eputnl()
            return 1
        }
        if konstant <> 41
        {
            scaly_eputs "FAIL: let local lost"
            scaly_eputnl()
            return 2
        }
        if Region.panic_index() <> 5
            return 3

        ; (4) nesting: a try INSIDE the catch branch
        try let b deep(1)
        else
        {
            if Region.panic_length() <> 2
                return 4
            scaly_eputs "caught nested"
            scaly_eputnl()
        }

        ; (3) the regions are back
        if scaly_panic_mark() <> mark0
        {
            scaly_eputs "FAIL: water mark moved"
            scaly_eputnl()
            return 5
        }

        ; (2) the success path binds and runs through
        try let c deep(0)
        else
            return 6
        if c < 1
            return 7

        print "PASS"
        return 0
    }
    scaly_eputs "FAIL: not caught"
    scaly_eputnl()
    8
}
