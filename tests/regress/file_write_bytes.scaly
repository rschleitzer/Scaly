; A sequence of numbers as bytes, and bytes into a file as they are:
; `values.as_bytes()` is the elements' memory seen as Slice[u8] (four bytes
; per u32, in the machine's order), `File.write_bytes` writes a Slice[u8]
; whatever it holds -- zero bytes among them, which a text would end at.

procedure main() returns int
{
    var values Vector[u32](4)
    values.put(0, 0x04030201)
    values.put(1, 0)
    values.put(2, 0xFF00FF00)
    values.put(3, 7)
    let bytes values.as_bytes()
    if bytes.length <> 16
        return 1
    if bytes[0] <> 1 or bytes[3] <> 4 or bytes[9] <> 0xFF or bytes[12] <> 7
        return 2
    if values.as_slice().subslice(1, 3).as_bytes().length <> 8
        return 3

    let path "/tmp/scaly_regress_write_bytes.bin"
    if File.write_bytes(path, bytes) = false
        return 4
    let back File.read_to_string(path)
    if back.get_length() <> 16
        return 5
    let read back.as_slice()
    var i: size_t 0
    while i < 16
    {
        if (read[i] as u8) <> bytes[i]
            return 6
        i := i + 1
    }
    print "PASS"
    0
}
