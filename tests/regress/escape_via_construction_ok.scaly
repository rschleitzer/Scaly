define Leaf (n: int)
define Keeper (items: ref[Array[ref[Leaf]?]])

procedure box_it(host: ref[Page], items: ref[Array[ref[Leaf]?]]) returns ref[Keeper]
    &Keeper^host(items)

procedure build(host: ref[Page]) returns ref[Keeper]
{
    let list &Array[ref[Leaf]?]^host()
    list.add(&Leaf^host(7))
    box_it(host, list)
}

define Callback (state: ref[Array[int]]?)

procedure consume(cb: ref[Callback]) returns int
{
    if cb.state = null
        return 0
    let s cb.state as ref[Array[int]]
    s.length as int
}

procedure with_frame_callback() returns int
{
    var acc Array[int]()
    acc.add(1)
    acc.add(2)
    var cb Callback(&acc)
    consume(&cb)
}

procedure borrow(mutable arr: ref[Array[int]], buf: pointer[int])
{
    let view Vector[int](2, buf)
    arr.add(view)
}

