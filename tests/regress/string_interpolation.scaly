; Regression: string interpolation. A double-quoted literal with unescaped
; backticks embeds expressions: "The answer is `n`!". The Modeler desugars
; it to the StringBuilder block pattern ({ let 'isb$' StringBuilder() ...
; 'isb$'.to_string() }); embedded expressions re-parse and plan like user
; code, so StringBuilder.append overload resolution picks the conversion by
; type (String, char, cstring, int, size_t, bool). An escaped backtick stays
; a literal character and never triggers interpolation. Self-hosted-only.
; Expected: PASS

var ok true

let n 42
let s1 "The answer is `n`!"
if (s1.equals("The answer is 42!")) = false
{
    print("FAIL s1\n")
    ok := false
}

let who String("world")
let s2 "hello `who`"
if (s2.equals("hello world")) = false
{
    print("FAIL s2\n")
    ok := false
}

let s3 "sum: `n + 8`"
if (s3.equals("sum: 50")) = false
{
    print("FAIL s3\n")
    ok := false
}

let c: char "x"
let s4 "char `c` ok"
if (s4.equals("char x ok")) = false
{
    print("FAIL s4\n")
    ok := false
}

let s5 "`n` at start"
if (s5.equals("42 at start")) = false
{
    print("FAIL s5\n")
    ok := false
}

let s6 "at end `n`"
if (s6.equals("at end 42")) = false
{
    print("FAIL s6\n")
    ok := false
}

let s7 "`n``n + 1`"
if (s7.equals("4243")) = false
{
    print("FAIL s7\n")
    ok := false
}

let s8 "len: `who.get_length()`"
if (s8.equals("len: 5")) = false
{
    print("FAIL s8\n")
    ok := false
}

let neg 0 - 7
let s9 "neg `neg`"
if (s9.equals("neg -7")) = false
{
    print("FAIL s9\n")
    ok := false
}

let s10 "flag `n = 42`"
if (s10.equals("flag true")) = false
{
    print("FAIL s10\n")
    ok := false
}

; escaped backtick stays literal — compare against a built expectation so a
; consistently-wrong decode can't self-confirm
let s11 "a \` b"
let esb StringBuilder()
esb.append("a ")
esb.append(96 as char)
esb.append(" b")
let expected11 esb.to_string()
if (s11.equals(expected11)) = false
{
    print("FAIL s11\n")
    ok := false
}

; embedded expression containing its own string literal (escaped quotes)
let s12 "outer `String(\"inner\").get_length()`"
if (s12.equals("outer 5")) = false
{
    print("FAIL s12\n")
    ok := false
}

if ok
    print("PASS")
else
    print("FAIL")
