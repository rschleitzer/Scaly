; Regression: a global named through a namespace (2026-10-09).
;
; A global is registered by its bare name alone -- one declared inside a
; namespace body too -- so `Ns.count` names nothing. It was planned as a bare
; Type operand, the read was not emitted and the statement it stands in was
; DROPPED at rc 0: this program printed 100. The dangling-reference check let
; it pass because a global of the last segment's name exists (and a global is
; registered as a concept of its name as well).
;
; How it was found: `h := (h xor Modeler.scaly_package_stamp) * p` in the
; tool's cache key had no load, no xor and no store in the IR, so the
; compiler's stamp was missing from the key of every compiled package.
; xfail: not found: Ns.count; the global count is not reached through a namespace or a module

define Ns
{
    mutable count: int 5

    function one() returns int
        1
}

procedure key() returns int
{
    var h 100
    h := (h xor Ns.count) * 3
    h
}

print("`key()`")
