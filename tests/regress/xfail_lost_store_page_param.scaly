; Regression (2026-09-25): R8's net at a PARAMETER position. `fill` keeps a
; String built on the page it is given in its parameter `r`; `poke` hands it
; its own parameter through `inner`, typed by the generic parameter T, which
; the page rule cannot resolve at model level -- so `poke` gets no caller page
; and the String would land on its frame. The escape post-pass reports the call
; (Planner.report_lost_store_page#, every stored-into position, not only the
; receiver).
; xfail: hands state that outlives the routine to a callee that keeps values
define Rec (var name: String)

define Filler (unused: int)
{
    procedure fill(this, mutable r: ref[Rec], t: String)
        set r.name: String(t)
}

define Box[T] (var inner: T)
{
    procedure poke(this, mutable r: ref[Rec], t: String)
        inner.fill(r, t)
}

var rec Rec(String("a"))
let b Box[Filler](Filler(0))
b.poke(&rec, String("hello"))
print "`rec.name.get_length()`"
