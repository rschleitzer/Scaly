; Regression (2026-09-24): `allocate(sizeof StringBuilder)` + `set *p:
; StringBuilder()`. Two defects, both silent at rc 0 (a bus error at the first
; append): `sizeof StringBuilder` in a program root answered 16 for a 24-byte
; record (Planner.compute_payload_size# sized Array by a stale name table), and
; the construction ran on a temporary on this routine's page whose buffer died
; with the frame after the record was copied into *p (it is now built in
; place, Emitter.emit_in_place_deref_ctor#).
; Expected: PASS
define Holder (var sb: pointer[StringBuilder])

procedure build(host: ref[Page]) returns String
{
    let p host.allocate(sizeof StringBuilder, 8) as pointer[StringBuilder]
    *p := StringBuilder()
    var i: int 0
    while i < 300
    {
        (*p).append "abcdefghij"
        i := i + 1
    }
    (*p).to_string()
}

procedure run()
{
    let root Page.allocate_page()
    let s build(root)
    if s.get_length() = 3000
        print("PASS")
    else
        print("FAIL `s.get_length()`")
}
run()
