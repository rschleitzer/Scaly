; 7.2 compiler-generated walkers: tagged-union TAG DISPATCH. A message
; struct carries four union fields (String payload — an UNALIGNED slot at
; byte offset 1 —, pointer payload with descend, scalar payload, unit
; variant); the generated walker switches on each tag and swizzles only
; the live variant. Round-trips through Region.serialize/deserialize with
; the original region freed before the verify.
; Expected: PASS

define Item
(
    title: String
    value: i64
)

define Payload union
(
    Text: String
    Ref: pointer[Item]
    Num: i64
    Nothing
)

define Msg
(
    a: Payload
    b: Payload
    c: Payload
    d: Payload
)

let mp Page.allocate_page()
let msg mp.allocate(sizeof Msg, alignof Msg) as pointer[Msg]

let s String^mp("union text payload")
let pa Payload.Text(s)
msg.a := pa

let it mp.allocate(sizeof Item, alignof Item) as pointer[Item]
let lab String^mp("item title")
it.title := lab
it.value := 77
let pb Payload.Ref(it)
msg.b := pb

let pc Payload.Num(123)
msg.c := pc
let pd Payload.Nothing
msg.d := pd

let host Page.allocate_page()
let frame Region.serialize(mp, msg as pointer[void], host)
mp.deallocate_extensions()
Page.release_page(mp)

let rr Region.deserialize(frame, host)
if rr = null
    exit 4
let rroot rr.root
let m2 rroot as pointer[Msg]
rr.fix_graph(m2)

var ok true

choose m2.a
    when t: Text
    {
        if t.equals("union text payload") = false
            ok := false
    }
    else
        ok := false

choose m2.b
    when r: Ref
    {
        let rl r.title
        if rl.equals("item title") = false
            ok := false
        if r.value <> (77 as i64)
            ok := false
    }
    else
        ok := false

choose m2.c
    when n: Num
    {
        if n <> (123 as i64)
            ok := false
    }
    else
        ok := false

choose m2.d
    when u: Nothing
        0
    else
        ok := false

rr.release()

if ok
    print("PASS")
else
    print("FAIL")
