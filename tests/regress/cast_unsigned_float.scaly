; Regression: a cast between an integer and a floating-point number goes by
; the INTEGER's signedness -- the source's into floating point, the target's
; out of it (2026-11-10).
;
; Both directions were the signed conversion for every type. So an unsigned
; number in the upper half of its range came out negative
; (`(3000000000 as u32) as f32` was -1294967296, a u8 of 200 was -56, a
; size_t beyond 2^63 was negative), `true as f64` was -1 (a one-bit integer
; read as signed), and floating point into an unsigned integer had no result
; for the upper half of the target (`3000000000.0 as u32` answered whatever
; the machine makes of an overflowing signed conversion: 2147483647 on
; arm64). All at rc 0. A SIMD cast into unsigned lanes had the same defect.
;
; The signed conversions are pinned beside them: they must not have moved.
;
; Expected: PASS

function u32_to_f32(x: u32) returns f32
    x as f32

function u32_to_f64(x: u32) returns f64
    x as f64

function u8_to_f64(x: u8) returns f64
    x as f64

function u16_to_f32(x: u16) returns f32
    x as f32

function u64_to_f64(x: u64) returns f64
    x as f64

function size_to_f64(x: size_t) returns f64
    x as f64

function bool_to_f64(b: bool) returns f64
    b as f64

function bool_to_f32(b: bool) returns f32
    b as f32

function f32_to_u32(x: f32) returns u32
    x as u32

function f64_to_u32(x: f64) returns u32
    x as u32

function f64_to_u8(x: f64) returns u8
    x as u8

function f64_to_u16(x: f64) returns u16
    x as u16

function f64_to_u64(x: f64) returns u64
    x as u64

function f64_to_size(x: f64) returns size_t
    x as size_t

function i32_to_f64(x: i32) returns f64
    x as f64

function int_to_f64(x: int) returns f64
    x as f64

function f64_to_i32(x: f64) returns i32
    x as i32

function f64_to_int(x: f64) returns int
    x as int

; --- an unsigned integer into floating point ---------------------------
let big: u32 3000000000
if ((u32_to_f32(big) as f64) = 3000000000.0) = false
    exit 1
if (u32_to_f64(big) = 3000000000.0) = false
    exit 2
let top: u32 4294967295
if (u32_to_f64(top) = 4294967295.0) = false
    exit 3
; the nearest f32 to 2^32 - 1 is 2^32
if ((u32_to_f32(top) as f64) = 4294967296.0) = false
    exit 4
let b8: u8 200
if (u8_to_f64(b8) = 200.0) = false
    exit 5
let w16: u16 65535
if ((u16_to_f32(w16) as f64) = 65535.0) = false
    exit 6
let huge: u64 0xF000000000000000
if (u64_to_f64(huge) = 17293822569102704640.0) = false
    exit 7
let sz: size_t 0x8000000000000000
if (size_to_f64(sz) = 9223372036854775808.0) = false
    exit 8
; the lower half is what it always was
let small: u32 7
if (u32_to_f64(small) = 7.0) = false
    exit 9

; --- a bool is 0 or 1 ---------------------------------------------------
let yes 3 > 2
let no 2 > 3
if (bool_to_f64(yes) = 1.0) = false
    exit 10
if (bool_to_f64(no) = 0.0) = false
    exit 11
if ((bool_to_f32(yes) as f64) = 1.0) = false
    exit 12

; --- floating point into an unsigned integer ----------------------------
if (f32_to_u32(3000000000.0) = 3000000000) = false
    exit 20
if (f64_to_u32(4294967295.0) = 4294967295) = false
    exit 21
if (f64_to_u8(200.9) = 200) = false
    exit 22
if (f64_to_u16(65535.5) = 65535) = false
    exit 23
if (f64_to_u64(10000000000000000000.0) = 10000000000000000000) = false
    exit 24
if (f64_to_size(9223372036854775808.0) = 0x8000000000000000) = false
    exit 25
; cut off toward zero, a fraction below zero included
if (f64_to_u32(0.0 - 0.75) = 0) = false
    exit 26
if (f64_to_u32(7.99) = 7) = false
    exit 27

; --- the signed conversions did not move --------------------------------
if (i32_to_f64(0 - 5) = 0.0 - 5.0) = false
    exit 30
if (int_to_f64(0 - 9007199254740992) = 0.0 - 9007199254740992.0) = false
    exit 31
if (f64_to_i32(0.0 - 2.5) = 0 - 2) = false
    exit 32
if (f64_to_int(0.0 - 4000000000.5) = 0 - 4000000000) = false
    exit 33
if (f64_to_i32(2147483647.0) = 2147483647) = false
    exit 34

; --- SIMD: floating point into unsigned lanes ---------------------------
let lanes f32x4(3000000000.0, 1.5, 0.0, 4294967040.0) as u32x4
if (lanes[0] = 3000000000) = false
    exit 40
if (lanes[1] = 1) = false
    exit 41
if (lanes[3] = 4294967040) = false
    exit 42
let signed_lanes f32x4(0.0 - 2.5, 1.5, 0.0, 100.0) as i32x4
if (signed_lanes[0] = 0 - 2) = false
    exit 43

print "PASS"
exit 0
