; The limit of the rule from xfail_try_without_throw: what is reported is a try
; with unreachable `when` ARMS. A try without arms says nothing about error kinds
; and is left alone -- otherwise the diagnostic would be a statement about the
; form instead of about the unreachability.
;
; ★Since 2026-09-07 this form is also a CATCH POINT (emit_try_panic_catch#,
; try_else_catches_panic.scaly): nothing panics here, so the
; else branch never runs -- what the test goes on checking is the diagnostic's
; limit and the undisturbed success path.
;
; Expected: PASS

function plain(n: int) returns int
    n + 1

procedure main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    try let v plain(argc)
    else
        return 9

    if v <> 2
        return 1

    print "PASS"
    0
}
