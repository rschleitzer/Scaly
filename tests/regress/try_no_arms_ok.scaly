; Die Grenze der Regel aus xfail_try_without_throw: gemeldet wird ein try mit
; unerreichbaren `when`-ARMEN. Ein try ohne Arme sagt nichts ueber Fehlerarten
; und bleibt unbehelligt -- sonst waere die Diagnose eine Aussage ueber die
; Form statt ueber die Unerreichbarkeit.
;
; ★Seit 2026-09-07 ist diese Form zugleich ein FANGPUNKT (emit_try_panic_catch#,
; try_else_catches_panic.scaly): hier panickt nichts, also laeuft der
; else-Zweig nie -- was der Test weiter prueft, ist die Diagnose-Grenze und
; der ungestoerte Erfolgspfad.
;
; Erwartet: PASS

function plain(n: int) returns int
    n + 1

function main(argc: int, argv: pointer[pointer[const_char]]) returns int
{
    try let v plain(argc)
    else
        return 9

    if v <> 2
        return 1

    print "PASS"
    0
}
