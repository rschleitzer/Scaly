; A constant's initializer is folded exactly and must fit the type it is
; declared (2026-10-19, Planner.fold_initializer#): `define BAD: u8 200 + 100`
; is rc 4. Before, any mixed-precedence initializer was refused here (the old
; fold went strictly left to right), and a value too large wrapped.
; xfail: the constant 300 does not fit u8, the type it is declared
define BAD: u8 200 + 100

let x BAD
print "should not compile\n"
