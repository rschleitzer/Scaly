; SIMD vector types, phase 2: load and store on a Slice, a
; Vector and an Array (by value and through a ref), the unchecked forms over a
; pointer, the math methods, the reductions (a float sum ORDERED, lane 0
; first), and a negative int broadcast into a float vector (phase 1 read the
; int as unsigned). Every value is checked against the scalar computation.
; Expected: PASS

; a procedure that stores declares the container it writes
procedure scale_into(mutable out: Slice[double], xs: Slice[double], k: double)
{
    var i: size_t 0
    while i + 4 <= xs.length
    {
        let v f64x4.load(xs, i)
        (v * k).store(out, i)
        i := i + 4
    }
}

function dot(a: Slice[double], b: Slice[double]) returns double
{
    var acc f64x4.splat(0.0)
    var i: size_t 0
    while i + 4 <= a.length
    {
        acc := f64x4.load(a, i).fma(f64x4.load(b, i), acc)
        i := i + 4
    }
    acc.sum()
}

procedure fill_array(mutable arr: ref[Array[i32]], n: int)
{
    var i 0
    while i < n
    {
        arr.add((i * 3) as i32)
        i := i + 1
    }
}

procedure check() returns int
{
    ; Vector: load, store, as_slice into a procedure
    var xs Vector[double](8)
    var i: size_t 0
    while i < 8
    {
        xs.put(i, (i as double) + 1.0)
        i := i + 1
    }
    let first f64x4.load(xs, 0)
    let second f64x4.load(xs, 4)
    if first[0] <> 1.0 or second[3] <> 8.0
        return 1
    var out Vector[double](8)
    scale_into(out.as_slice(), xs.as_slice(), 2.0)
    if out[5] <> 12.0 or out[0] <> 2.0
        return 2
    (second + 100.0).store(xs, 2)
    if xs[2] <> 105.0 or xs[5] <> 108.0 or xs[6] <> 7.0
        return 3
    ; the dot product through fma and an ordered sum
    var ones Vector[double](8)
    i := 0
    while i < 8
    {
        ones.put(i, 1.0)
        i := i + 1
    }
    if dot(out.as_slice(), ones.as_slice()) <> 72.0
        return 4
    ; Array through a ref, i32 lanes, reductions
    var arr Array[i32]()
    fill_array(&arr, 8)
    let a0 i32x8.load(arr, 0)
    if a0.sum() <> 84 or a0.max_lane() <> 21 or a0.min_lane() <> 0
        return 5
    let neg a0 - 10
    if neg.abs().sum() <> 48 or neg.min(i32x8.splat(0)).sum() <> 0 - 22
        return 6
    if neg.max(0).product() <> 0 or i32x4(1, 2, 3, 4).product() <> 24
        return 7
    ; the unchecked pointer forms
    let p out.data
    let q f64x4.load_ptr(p + 4)
    if q[0] <> 10.0
        return 8
    (q * 0.5).store_ptr(p)
    if out[0] <> 5.0 or out[3] <> 8.0
        return 9
    ; math
    let m f64x4(4.0, 9.0, 0.0 - 2.5, 2.75)
    let r m.abs().sqrt()
    if r[0] <> 2.0 or r[1] <> 3.0
        return 10
    let fl m.floor()
    if fl[2] <> 0.0 - 3.0 or fl[3] <> 2.0
        return 11
    if m.min(1.0).sum() <> 0.5 or m.max(f64x4.splat(3.0)).max_lane() <> 9.0
        return 12
    ; ordered float sum: 1e16 + 1.0 + (-1e16) + 1.0 is 1.0 lane by lane
    let big f64x4(10000000000000000.0, 1.0, 0.0 - 10000000000000000.0, 1.0)
    if big.sum() <> 1.0
        return 13
    ; f32 and unsigned lanes
    let f f32x8.iota(1.0, 1.0)
    if f.product() <> 40320.0 or f.min_lane() <> 1.0
        return 14
    let u u8x16.splat(250) + u8x16.iota(0, 1)
    if u.max_lane() <> 255 or u.min_lane() <> 0
        return 15
    ; a negative int broadcast into a float vector
    let n 0 - 3
    let nv f64x4.splat(n)
    let nm f64x4(n, 1, 2, 3)
    if nv[0] <> 0.0 - 3.0 or nm[0] <> 0.0 - 3.0
        return 16
    42
}

let rc check()
if rc = 42
    print("PASS")
else
    print("FAIL `rc`")
