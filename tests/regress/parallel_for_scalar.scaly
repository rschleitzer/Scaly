; `for x in vec` over a SCALAR-element Vector: the outlined task
; function must LOAD the element value from the cell's element pointer (the
; same scalar-element fix as the sequential path). The rounds add into one
; sum: a put at the element itself would run on one core, since two
; elements could name one slot.

let idxs Vector[size_t](4)
idxs.put(0 as size_t, 0 as size_t)
idxs.put(1 as size_t, 1 as size_t)
idxs.put(2 as size_t, 2 as size_t)
idxs.put(3 as size_t, 3 as size_t)
var sum 0
for x in idxs
    sum := sum + (x as int) * 10
if sum = 60
    print "PASS"
else
    print "FAIL"
