; The byte buffer every message is built in and read from: growable, on a
; page its owner names (a connection's), with the protocol's big-endian
; integers. A growth takes a larger block on the same page and leaves the
; old one to the page.

; memmove(3) — a consumed prefix is dropped by sliding the rest forward.
function memmove(dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

define PgBuf
(
    host: ref[Page]
    var data: Slice[u8]
    var length: size_t
)
{
    procedure create(host: ref[Page], capacity: size_t) returns PgBuf
    {
        let d allocate_slice[u8]^host(host, capacity)
        PgBuf(host, d, 0)
    }

    ; The filled part.
    function bytes(this) returns Slice[u8]
        data.slice_to(length)

    ; The unfilled part — where a read goes.
    function spare(this) returns Slice[u8]
        data.slice_from(length)

    procedure clear(mutable this)
        length := 0

    ; n more bytes are filled (a read wrote them into spare()).
    procedure advance(mutable this, n: size_t)
        length := length + n

    ; Room for n more bytes: at least double on growth.
    procedure reserve(mutable this, n: size_t)
    {
        if length + n <= data.length
            return
        var cap data.length * 2
        if cap < length + n
            cap := length + n
        let fresh allocate_slice[u8]^host(host, cap)
        if length > 0
            memcpy(fresh.data as pointer[void], data.data as pointer[void], length)
        data := fresh
    }

    ; Drop the first n bytes, sliding the rest to the front.
    procedure consume(mutable this, n: size_t)
    {
        if n >= length
        {
            length := 0
            return
        }
        let rest length - n
        memmove(data.data as pointer[void], data.slice_from(n).data as pointer[void], rest)
        length := rest
    }

    procedure append(mutable this, s: Slice[u8])
    {
        if s.length = 0
            return
        this.reserve(s.length)
        memcpy(data.slice_from(length).data as pointer[void], s.data as pointer[void], s.length)
        length := length + s.length
    }

    procedure append_byte(mutable this, b: u8)
    {
        this.reserve(1)
        data.put(length, b)
        length := length + 1
    }

    ; A string and its terminating NUL, as every protocol string is sent.
    procedure append_cstr(mutable this, s: Slice[u8])
    {
        this.append(s)
        this.append_byte(0)
    }

    procedure append_i16(mutable this, v: i64)
    {
        this.append_byte(((v >> 8) & 255) as u8)
        this.append_byte((v & 255) as u8)
    }

    procedure append_i32(mutable this, v: i64)
    {
        this.append_byte(((v >> 24) & 255) as u8)
        this.append_byte(((v >> 16) & 255) as u8)
        this.append_byte(((v >> 8) & 255) as u8)
        this.append_byte((v & 255) as u8)
    }

    ; Overwrite the four bytes at `at` with v — a message's length, known
    ; only once its body is written.
    procedure put_i32(mutable this, at: size_t, v: i64)
    {
        data.put(at, ((v >> 24) & 255) as u8)
        data.put(at + 1, ((v >> 16) & 255) as u8)
        data.put(at + 2, ((v >> 8) & 255) as u8)
        data.put(at + 3, (v & 255) as u8)
    }

    ; Begin a message of type t: the type byte and a length to be patched by
    ; finish; answers where the length stands.
    procedure begin(mutable this, t: u8) returns size_t
    {
        this.append_byte(t)
        let at length
        this.append_i32(0)
        at
    }

    ; The message whose length stands at `at` is complete.
    procedure finish(mutable this, at: size_t)
        this.put_i32(at, (length - at) as i64)

    ; A decimal integer, sent as a text parameter.
    procedure append_decimal(mutable this, v: i64)
    {
        if v < 0
        {
            this.append_byte(45)
            this.append_decimal((0 as i64) - v)
            return
        }
        var digits u8[20]
        var n: size_t 0
        var x v
        repeat
        {
            digits[n] := ((x % 10) as u8) + 48
            n := n + 1
            x := x / 10
            if x = 0
                break
        }
        while n > 0
        {
            n := n - 1
            this.append_byte(digits[n])
        }
    }
}

; The big-endian 32-bit integer at s[at], signed.
function be_i32(s: Slice[u8], at: size_t) returns i64
{
    let u ((s[at] as u64) << 24) | ((s[at + 1] as u64) << 16) | ((s[at + 2] as u64) << 8) | (s[at + 3] as u64)
    if u >= 0x80000000
        return (u as i64) - 0x100000000
    u as i64
}

; The big-endian 16-bit integer at s[at], unsigned.
function be_u16(s: Slice[u8], at: size_t) returns i64
    (((s[at] as u64) << 8) | (s[at + 1] as u64)) as i64

; A decimal integer at the front of s (an optional '-'); 0 for none.
function decimal_of(s: Slice[u8]) returns i64
{
    var i: size_t 0
    var negative false
    if s.length > 0 and s[0] = 45
    {
        negative := true
        i := 1
    }
    var v: i64 0
    while i < s.length and s[i] >= 48 and s[i] <= 57
    {
        v := v * 10 + ((s[i] - 48) as i64)
        i := i + 1
    }
    if negative
        return (0 as i64) - v
    v
}
