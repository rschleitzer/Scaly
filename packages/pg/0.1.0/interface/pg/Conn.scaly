; One connection to a Postgres server: the startup and authentication
; (SCRAM-SHA-256, or a cleartext password when the server asks for one),
; statements prepared once per connection, and queries through the extended
; protocol — Bind with text parameters, Execute, Sync — whose rows are read
; whole into the input buffer and walked in place:
;
;   if c.prepare("items", "SELECT … WHERE price BETWEEN $1 AND $2 LIMIT $3")
;   c.start("items")  c.param_int(10)  c.param_int(50)  c.param_int(20)
;   if c.run()
;       while c.next_row()
;           … c.column(0) … c.column_int(3) …
;
; A column is a view into the input buffer, valid until the next query.
; Everything a connection holds lives on its own page, released by close.

use pg.Buf.PgBuf
use pg.Scram.ScramClient

define PgConn
@resident true @inplace true (
    host: ref[Page]
    var tcp: TcpStream
    var inb: PgBuf
    var outb: PgBuf
    var open: bool
    ; the read position in inb while messages are taken off it
    var rpos: size_t
    ; the payload of the message next_message() answered last
    var msg_start: size_t
    var msg_length: size_t
    ; row iteration over the buffered answer of the last run()
    var walk: size_t
    var row_start: size_t
    ; the Bind message being built by start/param_*
    var bind_at: size_t
    var param_count_at: size_t
    var param_count: i64
    ; where the ErrorResponse of the last operation stands in inb (0: none)
    var error_at: size_t
    var error_length: size_t
    ; the statements prepared on this connection
    var prepared: Array[String]
)
{
    ; Connect and authenticate; not is_open() when the server cannot be
    ; reached or refuses. The connection lives on a page of its own.
    procedure connect(mutable host_name: String, port: int, user: Slice[u8], password: Slice[u8], database: Slice[u8]) @page true @direct true @deep true returns ref[PgConn]? io linked

    function is_open(this) @ret_param_0 true @deep true returns bool linked

    ; The server's message of the last failed operation (its 'M' field),
    ; empty when there was none.
    function error_message(this) @ret_param_0 true @deep true returns Slice[u8] linked

    procedure close(mutable this) @ret_nonlocal true @deep true io linked

    ; Send what outb holds; false (and closed) on an error.
    procedure flush(mutable this) @ret_nonlocal true @deep true returns bool io linked

    ; At least n bytes after rpos in inb, reading as needed.
    procedure need(mutable this, n: size_t) @ret_nonlocal true @deep true returns bool io linked

    ; The next message's type byte (0 when the stream ended); its payload is
    ; inb[msg_start, msg_start + msg_length).
    procedure next_message(mutable this) @ret_param_0 true @deep true returns u8 io linked

    function payload(this) @ret_param_0 true @deep true returns Slice[u8] linked

    ; Start a new exchange: nothing of the previous answer is kept.
    procedure reset_input(mutable this) @deep true linked

    ; Read up to ReadyForQuery; false when an ErrorResponse came (kept for
    ; error_message) or the stream ended.
    procedure drain(mutable this) @ret_nonlocal true @deep true returns bool io linked

    procedure startup(mutable this, user: Slice[u8], password: Slice[u8], database: Slice[u8]) @ret_nonlocal true @deep true returns bool io linked

    ; Prepare sql as the statement `name` unless this connection has; false
    ; when the server refuses it.
    procedure prepare(mutable this, name: Slice[u8], sql: Slice[u8]) @ret_nonlocal true @deep true returns bool io linked

    ; Begin a query of the prepared statement `name`; the parameters follow
    ; with param_text / param_int, then run.
    procedure start(mutable this, name: Slice[u8]) @deep true linked

    procedure param_text(mutable this, v: Slice[u8]) @deep true linked

    procedure param_int(mutable this, v: i64) @deep true linked

    ; Send the query and read its whole answer; false on an error. The rows
    ; are then walked with next_row.
    procedure run(mutable this) @ret_nonlocal true @deep true returns bool io linked

    ; Advance to the next DataRow of the last run(); false after the last.
    procedure next_row(mutable this) @ret_nonlocal true @deep true returns bool linked

    ; Column i of the current row as text; empty for NULL.
    function column(this, i: int) @page true @direct true @ret_param_0 true @deep true returns Slice[u8] linked

    function column_int(this, i: int) @ret_nonlocal true @deep true returns i64 linked

    ; A boolean column: Postgres' text form is "t" or "f".
    function column_bool(this, i: int) @ret_param_0 true @deep true returns bool linked
}
