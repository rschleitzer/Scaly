; The byte buffer every message is built in and read from: growable, on a
; page its owner names (a connection's), with the protocol's big-endian
; integers. A growth takes a larger block on the same page and leaves the
; old one to the page.

; memmove(3) — a consumed prefix is dropped by sliding the rest forward.
function memmove(dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

define PgBuf
(
    host: ref[Page]
    var data: Slice[u8]
    var length: size_t
)
{
    procedure create(host: ref[Page], capacity: size_t) @page true @direct true @ret_explicit_0 true @deep true returns PgBuf linked

    ; The filled part.
    function bytes(this) @ret_param_0 true @deep true returns Slice[u8] linked

    ; The unfilled part — where a read goes.
    function spare(this) @ret_param_0 true @deep true returns Slice[u8] linked

    procedure clear(mutable this) @deep true linked

    ; n more bytes are filled (a read wrote them into spare()).
    procedure advance(mutable this, n: size_t) @deep true linked

    ; Room for n more bytes: at least double on growth.
    procedure reserve(mutable this, n: size_t) @deep true linked

    ; Drop the first n bytes, sliding the rest to the front.
    procedure consume(mutable this, n: size_t) @deep true linked

    procedure append(mutable this, s: Slice[u8]) @deep true linked

    procedure append_byte(mutable this, b: u8) @persists true @deep true linked

    ; A string and its terminating NUL, as every protocol string is sent.
    procedure append_cstr(mutable this, s: Slice[u8]) @ret_nonlocal true @deep true linked

    procedure append_i16(mutable this, v: i64) @ret_nonlocal true @deep true linked

    procedure append_i32(mutable this, v: i64) @ret_nonlocal true @deep true linked

    ; Overwrite the four bytes at `at` with v — a message's length, known
    ; only once its body is written.
    procedure put_i32(mutable this, at: size_t, v: i64) @persists true @ret_nonlocal true @deep true linked

    ; Begin a message of type t: the type byte and a length to be patched by
    ; finish; answers where the length stands.
    procedure begin(mutable this, t: u8) @ret_param_0 true @deep true returns size_t linked

    ; The message whose length stands at `at` is complete.
    procedure finish(mutable this, at: size_t) @ret_nonlocal true @deep true linked

    ; A decimal integer, sent as a text parameter.
    procedure append_decimal(mutable this, v: i64) @deep true linked
}

; The big-endian 32-bit integer at s[at], signed.
function be_i32(s: Slice[u8], at: size_t) @ret_param_0 true @deep true returns i64 linked

; The big-endian 16-bit integer at s[at], unsigned.
function be_u16(s: Slice[u8], at: size_t) @ret_param_0 true @deep true returns i64 linked

; A decimal integer at the front of s (an optional '-'); 0 for none.
function decimal_of(s: Slice[u8]) @ret_nonlocal true @deep true returns i64 linked
