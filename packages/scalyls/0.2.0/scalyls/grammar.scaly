        if word = "or"
            return true
        if word = "xor"
            return true
        false
    }

    ; True for a lone identifier that resolves to a VALUE, not to a binding:
    ; true/false (Modeler), null (Planner), this (the receiver parameter).
    function is_value_word(word: String) returns bool
