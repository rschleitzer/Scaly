; codelens.scaly - textDocument/codeLens: assemble the CodeLens[] array from
; every lens family.
;
; One family lives elsewhere because it is expensive: scalyls.tasklens plans a
; package root to answer the self-scaling verdict of each `for` loop. The four
; families HERE need no plan at all — a path table, one parse, and a length
; check — which is why they answer on a buffer the planner could not touch:
;
;   GENERATED FILE   "generated from codegen/parser-scaly.scm - edit the
;                    generator, then ./mkp" at the top of every file ./mkp
;                    writes. The rule it states is one this repo breaks often
;                    enough to document it in CLAUDE.md; a lens states it where
;                    the mistake is made. The table below MIRRORS ./mkp (its
;                    GENERATED list plus its msggen loop) and mkp is the
;                    authority — the two must agree, and a generator that moves
;                    must move here too.
;
;   PACKAGE / MODULE the file a `package NAME VERSION` or `module NAME`
;                    declaration resolves to, and — the useful half — when it
;                    resolves to NOTHING. A declared module whose file is
;                    missing is a compile error waiting for the next build; a
;                    lens turns it into an answer while typing the line.
;
;   MUTABLE / SHARED which THREAD sees a module global's cell, and — the
;                    half that is not a matter of taste at all — whether the
;                    declaration produces a global AT ALL. See the section
;                    above storage_lens# for the three measurements this rests
;                    on.
;
;   RUN              "Run (scalyc --jit)" on a file that HAS top-level
;                    statements, i.e. a program rather than a library. This one
;                    is CLICKABLE, so it is the reason the extension gained two
;                    commands (scaly.runFile / scaly.openPath): a lens command
;                    id must be a command the CLIENT has registered — the
;                    built-in `vscode.open` takes a Uri OBJECT and rejects the
;                    string a JSON-RPC argument can carry.
;
; ASCII ONLY in the titles, for the reason tasklens.scaly gives.
;
; PATH ARITHMETIC, not search: every family below decides with `ends_with` /
; `last_index_of` / `substring` on the document path. There is no substring
; SEARCH primitive on String (index_of takes a byte), and none is needed —
; which also means these lenses cost nothing measurable next to the plan.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line. Syntax unions are matched by PAYLOAD TYPE
; (`when m: ModuleSyntax`), and every arm of a value-returning choose returns
; explicitly. Quotes are 0x22 bytes.

use scaly.os.File
use scaly.memory.runtime
use scaly.memory.root_pages.getenv

use scalyls.diagnostics
use scalyls.symbols
use scalyls.json
use scalyls.tasklens
use scalyls.instlens
use scalyls.storelens

use scalyc.compiler.Modeler
use scalyc.compiler.Planner
use scalyc.compiler.Plan.*
use scalyc.compiler.parser
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

define codelens
{
    ; The whole CodeLens[] array for `uri`. `text` is the source the worker
    ; resolved (the parent's buffer, or the file from disk when it had none).
    procedure lenses(mutable uri: String, mutable text: String) returns String mutable lc_col, lc_line, lc_off, modeler_error_count
    {
        let path diagnostics.strip_uri uri

        var sb StringBuilder()
        sb.append("[" as char)
        var first true

        ; Cheapest first, and in the order they read down the file: the file's
        ; own banner and its Run action sit at the top, the declarations follow,
        ; the loops last. The client sorts by position anyway; this only keeps
        ; the array legible in a transcript.
        let head codelens.head_fragment(path, text)
        if head.get_length() > 0
        {
            symbols.append_fragment(&sb, head)
            set first: false
        }

        let decls codelens.declaration_fragment(text, path)
        if decls.get_length() > 0
        {
            if first = false
                sb.append("," as char)
            symbols.append_fragment(&sb, decls)
            set first: false
        }

        let planned codelens.planned_fragment(path, text)
        if planned.get_length() > 0
        {
            if first = false
                sb.append("," as char)
            symbols.append_fragment(&sb, planned)
            set first: false
        }

        sb.append("]" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; THE SHARED PLAN.
    ;
    ; Every plan-derived family (the `for`-loop verdicts, the instantiation
    ; counts) needs the SAME plan, and planning is by far the most expensive
    ; thing this request does — measured 0.45 s for the scaly root and 2.45 s for
    ; dazzle, the largest in this tree. So the parse and the plan happen ONCE
    ; here and every family is handed the result; each family planning for itself
    ; would double the cost of the whole request for nothing.
    ;
    ; WHICH program is planned is the same decision tasklens.scaly documents: a
    ; package member goes through its ROOT (a member planned alone cannot resolve
    ; its siblings, and for the classifier that turns a "parallel" verdict into a
    ; wrong "blocked" one rather than a missing answer), a standalone document is
    ; planned as itself. `plan_text` is the text whose offsets the plan carries —
    ; the file ON DISK for a member, because the modeler reads from disk.
    ; ====================================================================
    procedure planned_fragment(mutable path: String, mutable text: String) returns String mutable lc_col, lc_line, lc_off, modeler_error_count
    {
        let root diagnostics.package_root path
        if root.get_length() > 0
            return codelens.root_planned_fragment(root, path, text)
        codelens.document_planned_fragment(path, text)
    }

    procedure root_planned_fragment(mutable root: String, path: String, text: String) returns String mutable lc_col, lc_line, lc_off, modeler_error_count
    {
        let plan_text File.read_to_string(path)
        if plan_text.get_length() = 0
            return ""
        let root_text File.read_to_string(root)
        if root_text.get_length() = 0
            return ""

        var result String("")
        var p parser.Parser(root_text)
        choose p.parse_program()
            when err: Error
            {
                ; The root itself does not parse. Its own diagnostics are
                ; published elsewhere; there is no plan to read from.
            }
            when program: Success
            {
                ; The root program NAME is part of every module path the strict
                ; use-visibility check compares against — a placeholder makes the
                ; planner report every sibling as invisible
                ; (diagnostics.root_program_name# has the full account).
                let prog_name diagnostics.root_program_name(root)
                let model Modeler.build_program(root, prog_name, program, true)
                var planner Planner.Planner(root)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model
                if plan <> null
                    set result: codelens.families(plan, planner.has_diagnostics(), root, path, plan_text, text)
            }
        result
    }

    procedure document_planned_fragment(mutable path: String, mutable text: String) returns String mutable lc_col, lc_line, lc_off, modeler_error_count
    {
        if text.get_length() = 0
            return ""
        var result String("")
        var p parser.Parser(text)
        choose p.parse_program()
            when err: Error
            {
                ; A buffer being typed into does not parse, and a document that
                ; does not parse has no plan. Deliberately NOT repaired
                ; (symbols.repaired_source#): the repair blanks a line, which
                ; would change the very site counts these families pair on — an
                ; answer about a program the author never wrote.
            }
            when program: Success
            {
                let prog_name "document"
                let model Modeler.build_program(path, prog_name, program, true)
                var planner Planner.Planner(path)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model
                if plan <> null
                    set result: codelens.families(plan, planner.has_diagnostics(), path, path, text, text)
            }
        result
    }

    ; Join every plan-derived family over the one plan.
    procedure families(plan: Plan, has_diag: bool, entry_file: String, path: String, plan_text: String, anchor_text: String) returns String mutable lc_col, lc_line, lc_off
    {
        var sb StringBuilder()
        var first true

        let loops tasklens.fragment(plan, has_diag, entry_file, path, plan_text, anchor_text)
        if loops.get_length() > 0
        {
            symbols.append_fragment(&sb, loops)
            set first: false
        }

        let insts instlens.fragment(plan, has_diag, plan_text, anchor_text)
        if insts.get_length() > 0
        {
            if first = false
                sb.append("," as char)
            symbols.append_fragment(&sb, insts)
            set first: false
        }

        ; No `has_diag` here, deliberately: this family marks a SHAPE, so a
        ; truncated plan costs it sites rather than making the ones it found
        ; wrong (storelens.scaly's SCOPE note).
        let stores storelens.fragment(plan, plan_text, anchor_text)
        if stores.get_length() > 0
        {
            if first = false
                sb.append("," as char)
            symbols.append_fragment(&sb, stores)
            set first: false
        }

        sb.to_string()
    }

    ; ====================================================================
    ; The file-level lenses, both at offset 0.
    ;
    ; Offset 0 rather than "the first top-level statement": a file-level action
    ; belongs at the top of the file, the line always exists, and it costs no
    ; walk over the statement union. Two lenses at one position are what an
    ; editor shows side by side, which is the conventional look for this.
    ; ====================================================================
    procedure head_fragment(path: String, mutable text: String) returns String mutable lc_col, lc_line, lc_off
    {
        var sb StringBuilder()
        var first true

        let banner codelens.generated_banner(text, path)
        if banner.get_length() > 0
        {
            symbols.append_fragment(&sb, banner)
            set first: false
        }

        if codelens.has_top_level_statements text
        {
            if first = false
                sb.append("," as char)
            symbols.append_fragment(&sb, symbols.lens_object(text, 0, 3, "Run (scalyc --jit)", "scaly.runFile", path))
            set first: false
        }

        sb.to_string()
    }

    ; True when the document is a PROGRAM: it parses and carries at least one
    ; top-level statement. A library root (`define X { module a }`) carries
    ; none, so it gets no Run lens — which is the whole distinction the CLI
    ; makes too. A buffer that does not parse gets none either: `--jit` on it
    ; would print a diagnostic the editor is already showing.
    procedure has_top_level_statements(mutable text: String) returns bool
    {
        var p parser.Parser(text)
        choose p.parse_program()
            when err: Error
                return false
            when program: Success
            {
                if program.statements = null
                    return false
                let stmts (*program.statements)
                if stmts.length = 0
                    return false
                return true
            }
    }

    ; ====================================================================
    ; GENERATED FILES — the table, mirroring ./mkp.
    ;
    ; Answers the finished banner lens for `path`, or "". Every entry is decided
    ; on a path SUFFIX, so the checkout root is whatever precedes it and the
    ; click target is absolute without knowing where the checkout lives.
    ;
    ; Each arm hands banner_lens# BOTH halves — the root it just computed and the
    ; generator's path RELATIVE to it — because the relative path is what the
    ; title must show and only this table knows it. The first draft answered the
    ; absolute path alone and rebuilt the relative one from the common prefix of
    ; the two paths; that is not the same thing and it was wrong wherever the
    ; generator sits in the same directory branch as its output ("controlflow.sgm"
    ; for tests/controlflow.sgm, since the document is tests/selfhosted/…).
    ; ====================================================================
    procedure generated_banner(text: String, path: String) returns String mutable lc_col, lc_line, lc_off
    {
        ; The three compiler-side DSSSL outputs (mkp's `gen codegen/scaly.dsl`).
        let parser_out "/packages/scalyc/0.1.0/scalyc/compiler/parser.scaly"
        let root1 codelens.strip_suffix(path, parser_out)
        if root1.get_length() > 0
            return codelens.banner_lens(text, root1, "codegen/parser-scaly.scm")

        let syntax_out "/packages/scalyc/0.1.0/scalyc/compiler/Syntax.scaly"
        let root2 codelens.strip_suffix(path, syntax_out)
        if root2.get_length() > 0
            return codelens.banner_lens(text, root2, "codegen/syntax-scaly.scm")

        let grammar_out "/packages/scalyls/0.1.0/scalyls/grammar.scaly"
        let root3 codelens.strip_suffix(path, grammar_out)
        if root3.get_length() > 0
            return codelens.banner_lens(text, root3, "codegen/highlight-scaly.scm")

        ; tests/selfhosted/<topic>__<name>.scaly comes from tests/<topic>.sgm
        ; (mkp's four `gen codegen/test-<topic>.dsl` lines). The .sgm is what an
        ; author edits — the literate document IS the test source — so that is
        ; what the lens points at, not the .dsl driver.
        let dir codelens.directory_of path
        let base codelens.file_name path
        if dir.ends_with("/tests/selfhosted")
        {
            let cut base.index_of("_" as u8)
            if cut > 0
            {
                let topic base.substring(0, cut as size_t)
                var rel StringBuilder()
                rel.append "tests/"
                rel.append topic
                rel.append ".sgm"
                let r rel.to_string()
                let root codelens.strip_suffix(dir, "/tests/selfhosted")
                if root.get_length() > 0
                    return codelens.banner_lens(text, root, r)
            }
        }

        ; The opensp message tables come from James Clark's .msg catalogs via
        ; tools/msggen.py (mkp's msggen loop). The catalogs live in a separate
        ; checkout that need not exist here, so the lens points at the
        ; generator, which always does.
        if dir.ends_with("/packages/opensp/0.1.0/opensp")
        {
            if base.ends_with("Messages.scaly")
            {
                let root codelens.strip_suffix(dir, "/packages/opensp/0.1.0/opensp")
                if root.get_length() > 0
                    return codelens.banner_lens(text, root, "tools/msggen.py")
            }
        }

        ""
    }

    ; The banner lens itself: the title names the generator RELATIVE to the
    ; checkout (what a reader can act on), the click opens it absolutely.
    procedure banner_lens(text: String, root: String, rel: String) returns String mutable lc_col, lc_line, lc_off
    {
        let target codelens.join(root, rel)
        var title StringBuilder()
        title.append "generated from "
        title.append rel
        title.append " - edit the generator, then ./mkp"
        let t title.to_string()
        symbols.lens_object(text, 0, 3, t, "scaly.openPath", target)
    }

    ; ====================================================================
    ; PACKAGE / MODULE declarations.
    ;
    ; THE SEARCH DIRECTORY IS NOT ALWAYS THE FILE'S OWN — this is the whole
    ; subtlety, and getting it wrong makes the lens LIE about the file system.
    ; The Modeler is the authority (Modeler.build_module# walks a file's
    ; top-level declarations with the directory the FILE was loaded from, while
    ; Modeler.handle_namespace# descends into `define NS { … }` with
    ; <dir>/NS — skipping that append when the directory's last segment is
    ; already NS). So:
    ;
    ;   module lexer   at the top level of compiler/parser.scaly
    ;                                       -> compiler/lexer.scaly   (SIBLING)
    ;   define scalyls { module json }  in   scalyls.scaly
    ;                                       -> scalyls/json.scaly     (CHILD)
    ;
    ; The first draft used the child rule everywhere and reported "missing
    ; module file: parser/lexer.scaly" for a module that resolves perfectly —
    ; found by pointing the lens at this tree's own sources on the first run.
    ; `base` below is that search directory, threaded exactly as the Modeler
    ; threads it; `dir` is the document's own directory, used only for display.
    ; ====================================================================
    procedure declaration_fragment(mutable text: String, mutable path: String) returns String mutable lc_col, lc_line, lc_off
    {
        let dir codelens.directory_of path
        var p parser.Parser(text)
        var result String("")
        choose p.parse_program()
            when err: Error
            {
                ; No parse, no declarations. The parse error itself is a
                ; diagnostic, not a lens.
            }
            when program: Success
                set result: codelens.declarations_fragment(text, path, dir, dir, program.file.declarations)
        result
    }

    procedure declarations_fragment(text: String, mutable path: String, mutable base: String, dir: String, decls: ref[Vector[DeclarationSyntax]]?) returns String mutable lc_col, lc_line, lc_off
    {
        var sb StringBuilder()
        if decls = null
            return sb.to_string()
        let list (*decls)
        var first true
        var i: size_t 0
        while i < list.length
        {
            let dptr list.get i
            if dptr <> null
            {
                let d (*dptr)
                let piece codelens.declaration_lens(text, path, base, dir, d)
                if piece.get_length() > 0
                {
                    if first = false
                        sb.append("," as char)
                    symbols.append_fragment(&sb, piece)
                    set first: false
                }
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; One declaration: a lens for `package` / `module`, a recursion for a
    ; namespace, nothing for the rest.
    procedure declaration_lens(text: String, mutable path: String, mutable base: String, dir: String, decl: DeclarationSyntax) returns String mutable lc_col, lc_line, lc_off
    {
        choose decl
            when pkg: PackageSyntax
                return codelens.package_lens(text, path, pkg)
            when m: ModuleSyntax
                return codelens.module_lens(text, base, dir, m)
            when def: DefinitionSyntax
            {
                choose def.concept_
                    when n: NamespaceSyntax
                    {
                        ; Modeler.handle_namespace#: <base>/<name>, unless
                        ; base's last segment already IS the name.
                        var child base
                        let last codelens.file_name base
                        if last <> def.name
                            set child: codelens.join(base, def.name)
                        return codelens.declarations_fragment(text, path, child, dir, n.declarations)
                    }
                    when c: ClassSyntax
                        return ""
                    when un: UnionSyntax
                        return ""
                    when cn: ConstantSyntax
                        return ""
                    when dl: DelegateSyntax
                        return ""
                    when ic: IntrinsicSyntax
                        return ""
            }
            when e: EmptySyntax
                return ""
            when u: UseSyntax
                return ""
            when priv: PrivateSyntax
                return ""
            when f: FunctionSyntax
                return ""
            when pr: ProcedureSyntax
                return ""
            when o: OperatorSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when mut: MutableSyntax
                return codelens.storage_lens(text, mut.start, "mutable", mut.binding.annotation, "thread-local: one cell per thread")
            when sh: SharedSyntax
                return codelens.storage_lens(text, sh.start, "shared", sh.binding.annotation, "process-global: the declarer owns the race discipline")
    }

    ; ====================================================================
    ; MUTABLE / SHARED module globals.
    ;
    ; TWO THINGS ARE INVISIBLE IN THE SOURCE and both are stated here.
    ;
    ; (1) WHICH THREAD SEES THE CELL. `mutable` is THREAD-LOCAL (M2.2: the
    ; allocator state is a per-thread stack discipline, and a process-shared
    ; mutable would be a data race under threads); `shared` is the exemption
    ; that keeps a global PROCESS-wide, and its declarer owns the race
    ; discipline — initialize while single-threaded, or mutate via
    ; scaly_atomic_*. The two spellings differ by one keyword and by nothing
    ; else on the line, so the consequence is invisible exactly where it
    ; matters. Measured against the emitted IR, which is the second producer
    ; of this fact and the one the test derives its expectation from:
    ; `mutable c: int 7` emits `@c = thread_local global i64 7`, while
    ; `shared t: pointer[void] null` emits `@t = global ptr null`
    ; (Emitter.scaly's global loop: LLVMSetThreadLocal unless is_shared).
    ;
    ; (2) WHETHER THERE IS A GLOBAL AT ALL. Until 2026-09-23 the failure was
    ; SILENT: Modeler.handle_declaration# modeled the declaration only when
    ; its annotation resolved to a TYPE and DROPPED it otherwise. Since then
    ; the compiler reports it at the declaration (Planner.plan_untyped_global#,
    ; rc 4), and the lens says the same thing while the file is being typed.
    ; Both of these compiled with rc 0 and emitted NOTHING (measured):
    ;
    ;   mutable bad 9            — no annotation at all. An annotation starts
    ;                              at a COLON (parse_bindingannotation#), so
    ;                              the `u8[64]` of a local's `var buf u8[64]`
    ;                              is not one either — same silent case.
    ;   mutable pair: (x: int) 0 — a colon IS present and the global is still
    ;                              dropped: a BindingSpec is a union of
    ;                              Structure / Type / Array and only the Type
    ;                              arm models to a type.
    ;
    ; Nothing was reported at the declaration; the first USE failed, as
    ; `unknown assignment target: bad` at the use's own line — a diagnostic
    ; that named the wrong place. The second example is why the condition
    ; below MIRRORS THE MODELER (the spec must be a TypeSyntax) instead of
    ; testing for a colon, and it is the case the gate uses to prove the
    ; difference; the Modeler stays the authority, so if it ever accepts
    ; another spec, declares_a_type# is the one line to follow it in.
    ;
    ; WHERE THE LENS FIRES. On a DECLARATION, never on a statement — which is
    ; the same distinction the compiler makes and the reason this family sits
    ; in the declaration walk instead of scanning for a keyword. Measured:
    ; a `mutable` that follows a top-level STATEMENT is parsed as a statement
    ; (parse_file# takes the declaration list first, then stops), is modeled
    ; as a local Binding, and emits no global — and a lens claiming
    ; "thread-local" over it would be describing a cell that does not exist.
    ;
    ; NAMESPACE BODIES ARE COVERED, and that is a correction: this repo's
    ; CLAUDE.md says a `mutable` is "rejected inside a namespace body", which
    ; is not what the compiler does. Modeler.handle_namespace# routes its
    ; declarations through the same handle_declaration#, and
    ; `define ns { mutable inner: int 3 }` emits
    ; `@inner = thread_local global i64 3` and reads back correctly from a
    ; function of that namespace (measured 2026-08-14). The declaration walk
    ; recurses into namespaces for the module lens already, so this family
    ; inherits the coverage; if the compiler ever does start rejecting it, the
    ; lens follows for free, because there would then be a diagnostic instead.
    ;
    ; Not clickable (the empty command id), for tasklens.scaly's reason: the
    ; sentence is the whole message. ASCII only in the titles.
    ; ====================================================================
    procedure storage_lens(text: String, offset: size_t, keyword: String, annotation: ref[BindingAnnotationSyntax]?, title: String) returns String mutable lc_col, lc_line, lc_off
    {
        let width keyword.get_length()
        if codelens.declares_a_type annotation
            return symbols.lens_object(text, offset, width, title, "", "")

        var sb StringBuilder()
        sb.append "no type: the compiler rejects this - "
        sb.append keyword
        sb.append " NAME: TYPE INIT"
        let untyped sb.to_string()
        symbols.lens_object(text, offset, width, untyped, "", "")
    }

    ; Exactly Modeler.handle_binding_annotation#'s condition: an annotation is
    ; present AND its spec is a TypeSyntax. Anything else models to null, and a
    ; null type is what makes the Modeler drop the whole declaration.
    function declares_a_type(annotation: ref[BindingAnnotationSyntax]?) returns bool
    {
        if annotation = null
            return false
        let a (*annotation)
        choose a.spec
            when t: TypeSyntax
                return true
            when s: StructureSyntax
                return false
            when arr: ArraySyntax
                return false
    }

    ; `package NAME VERSION` -> packages/NAME/VERSION/NAME.scaly under the ONE
    ; resolution base the compiler uses: $SCALY_HOME when set, else the current
    ; directory (Package system, "Resolution has exactly ONE base").
    ;
    ; The version text is read from the SOURCE BYTES rather than from the two
    ; Literals of VersionSyntax: a syntax node's `end` runs to the start of the
    ; next token, so a span would carry trailing trivia — while "digits and
    ; dots from version.start" is exactly a version and nothing else.
    procedure package_lens(text: String, mutable path: String, pkg: PackageSyntax) returns String mutable lc_col, lc_line, lc_off
    {
        if pkg.version = null
            return ""
        let v (*pkg.version)
        let version codelens.version_text(text, v.start)
        if version.get_length() = 0
            return ""

        var rel StringBuilder()
        rel.append "packages/"
        rel.append(pkg.name.name)
        rel.append "/"
        rel.append version
        rel.append "/"
        rel.append(pkg.name.name)
        rel.append ".scaly"
        let relative rel.to_string()

        ; No base means no ABSOLUTE answer, and a relative path is not something
        ; to hand a click: vscode.Uri.file resolves it against nothing. Say what
        ; the declaration names and offer no command.
        let base codelens.resolution_base path
        if base.get_length() = 0
        {
            var plain StringBuilder()
            plain.append "package: "
            plain.append relative
            let pt plain.to_string()
            return symbols.lens_object(text, pkg.start, 7, pt, "", "")
        }

        let target codelens.join(base, relative)
        if File.exists(target) = false
        {
            var missing StringBuilder()
            missing.append "not found: "
            missing.append relative
            let mt missing.to_string()
            return symbols.lens_object(text, pkg.start, 7, mt, "", "")
        }
        var title StringBuilder()
        title.append "package root: "
        title.append relative
        let t title.to_string()
        symbols.lens_object(text, pkg.start, 7, t, "scaly.openPath", target)
    }

    ; `module NAME` -> <base>/NAME.scaly, where `base` is the search directory
    ; the Modeler would use (see the section comment above). Shown relative to
    ; the document's own directory, so a sibling reads "lexer.scaly" and a
    ; namespace child reads "scalyls/json.scaly".
    procedure module_lens(text: String, mutable base: String, dir: String, m: ModuleSyntax) returns String mutable lc_col, lc_line, lc_off
    {
        var t StringBuilder()
        t.append(m.name)
        t.append ".scaly"
        let leaf t.to_string()
        let target codelens.join(base, leaf)
        let relative codelens.relative_to(target, dir)

        if File.exists(target) = false
        {
            var missing StringBuilder()
            missing.append "missing module file: "
            missing.append relative
            let mt missing.to_string()
            return symbols.lens_object(text, m.start, 6, mt, "", "")
        }
        var title StringBuilder()
        title.append "opens "
        title.append relative
        let t title.to_string()
        symbols.lens_object(text, m.start, 6, t, "scaly.openPath", target)
    }

    ; The digits-and-dots run starting at `offset` ("0.1.0").
    function version_text(text: String, offset: size_t) returns String
    {
        let n text.get_length()
        var k offset
        while k < n
        {
            let c text.get k
            var ok false
            if c = ("." as char)
                set ok: true
            if c >= 0x30
                if c <= 0x39
                    set ok: true
            if ok = false
                break
            set k: k + 1
        }
        if k <= offset
            return ""
        text.substring(offset, k - offset)
    }

    ; The base a `package` declaration resolves against, ABSOLUTE, or "".
    ;
    ; The compiler has exactly ONE base: $SCALY_HOME when set, else
    ; cwd-relative. The first half carries over; the second CANNOT — a language
    ; server's cwd is whatever the editor chose, and a lens that turned that
    ; into a click would open a file the compiler never reads. So the fallback
    ; asks the DOCUMENT instead: the nearest ancestor directory that contains a
    ; `packages` directory is the checkout the compiler would be invoked from,
    ; which is the same answer for every real in-repo case and no answer at all
    ; outside one.
    procedure resolution_base(mutable path: String) returns String
    {
        let home getenv "SCALY_HOME"
        if home <> null
        {
            let s String(home)
            if s.get_length() > 0
                return s
        }

        ; Walk up. The bound is a loop guard, not a depth limit — a path is
        ; finite, but a malformed one must not be able to spin the worker.
        var dir codelens.directory_of path
        var depth 0
        while depth < 64
        {
            let probe codelens.join(dir, "packages")
            if File.exists probe
                return dir
            let up codelens.directory_of dir
            if up = dir
                return ""
            if up.get_length() <= 1
                return ""
            set dir: up
            set depth: depth + 1
        }
        ""
    }

    ; ====================================================================
    ; Path arithmetic.
    ; ====================================================================

    ; <path minus suffix>, or "" when path does not end in suffix (or would be
    ; left empty — a suffix that IS the whole path answers nothing rather than
    ; a bare relative name).
    function strip_suffix(path: String, suffix: String) returns String
    {
        if path.ends_with(suffix) = false
            return ""
        let plen path.get_length()
        let slen suffix.get_length()
        if slen >= plen
            return ""
        path.substring(0, plen - slen)
    }

    function join(left: String, right: String) returns String
    {
        var sb StringBuilder()
        sb.append left
        sb.append "/"
        sb.append right
        sb.to_string()
    }

    ; Everything before the last "/" ("." when there is none).
    function directory_of(path: String) returns String
    {
        let at path.last_index_of("/" as u8)
        if at <= 0
            return "."
        path.substring(0, at as size_t)
    }

    ; Everything after the last "/".
    function file_name(path: String) returns String
    {
        let at path.last_index_of("/" as u8)
        if at < 0
            return path
        let start (at as size_t) + 1
        let n path.get_length()
        if start >= n
            return ""
        path.substring(start, n - start)
    }

    ; `target` with a leading "<dir>/" removed, or `target` unchanged when it
    ; does not live under `dir`. What the reader wants to see for a resolved
    ; module: "lexer.scaly" for a sibling, "scalyls/json.scaly" for a child.
    function relative_to(target: String, dir: String) returns String
    {
        let prefix codelens.join(dir, "")
        if target.starts_with(prefix) = false
            return target
        let plen prefix.get_length()
        let tlen target.get_length()
        if plen >= tlen
            return target
        target.substring(plen, tlen - plen)
    }

}
