; symbols.scaly - textDocument/documentSymbol support.
;
; Parse a document's text (parser only — no modeler/planner) and turn its
; top-level declarations into a hierarchical LSP DocumentSymbol[] tree. The
; result is the bare JSON array `[ <symbol>... ]`; the parent wraps it in a
; Response envelope with the request id (server.handle_document_symbol).
;
; Each <symbol>:
;   {"name":<name>,"kind":<int>,"range":{...},"selectionRange":{...},
;    "children":[ <symbol>... ]}
; LSP SymbolKind ints used here:
;   Module=2 Namespace=3 Constructor=9 Enum=10 Method=6 Function=12
;   Variable=13 Constant=14 EnumMember=22 Struct=23 Operator=25
; range/selectionRange use the syntax node's start..end byte offsets,
; converted to 0-based line/character (selectionRange == range here).
;
; UNION-MATCH NOTE: the Syntax unions are matched by PAYLOAD TYPE name
; (`when f: FunctionSyntax`), mirroring Modeler.scaly — NOT by variant tag.
; The throws-union from parse_program# is matched by tag (Success/Error).
;
; STRING/JSON NOTE: outgoing JSON uses a local StringBuilder appended in
; place; nested pieces come from String-returning helpers. Quotes are 0x22
; bytes. A potentially-large piece (a nested symbol / children array) is
; appended ONE BYTE AT A TIME (inline `while` over its bytes) rather than as
; a single StringBuilder.append(String): the runtime's Array.add(Vector)
; takes a manual-grow path (own_page.allocate of the whole new buffer)
; whenever a single append more than doubles the buffer's capacity, and that
; path SIGSEGVs for buffers larger than one exclusive page. Byte-at-a-time
; append only ever grows via the safe reallocate() doubling, so it never
; trips it. The loop is inlined (not a helper) because a StringBuilder
; mutated through a pointer/by-value parameter does not propagate to the
; caller — only the in-place `sb.append(...)` form on a local does.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line. `choose *ptr` does not parse — bind the
; deref to a local first. In a choose returning a value, EVERY arm uses an
; explicit `return` (mixing return + bare arms drops the bare ones).

use scaly.io.File
use scaly.memory.runtime
use scaly.memory.root_pages.getenv
use scalyls.json
use scalyls.symindex
use scalyls.grammar
use scalyls.nameset
use scalyls.semantic

use scalyc.compiler.parser

; libc stream primitives for enumerating sibling .scaly files when a
; go-to-definition target is not in the current file. Declared here (not in
; the scaly package) so no scaly/scalyc source is touched (fixpoint-safe).
; popen runs `/bin/sh -c <cmd>` — portable across macOS + Linux, sidestepping
; the platform-specific `struct dirent` layout that raw readdir would need.
function popen(command: pointer[const_char], mode: pointer[const_char]) returns pointer[void] extern
function pclose(stream: pointer[void]) returns i32 extern
; fgetc returns a C `int` (32-bit). It MUST be i32, not Scaly's 64-bit int:
; at EOF the C -1 (0xFFFFFFFF) would zero-extend to 4294967295 in a 64-bit
; register, so an i64 `c < 0` EOF test never fires and the read loop spins
; forever (worker hang -> poll timeout -> null result).
function fgetc(stream: pointer[void]) returns i32 extern

; Syntax tree types (parser output). Imported by payload type so the
; `choose ... when x: TSyntax` arms resolve.
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyls.nameset.*
use scalyls.json.*

define symbols
{
    ; Build the documentSymbol result ARRAY from `source`. On a parse error
    ; the array is empty (the diagnostics path reports the error separately).
    function document_symbols(rp, source: String) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)

        var p parser.Parser(source)
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var first true
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let piece symbols.decl_symbol(source, d)
                            if piece.get_length() > 0
                            {
                                if first = false
                                    sb.append("," as char)
                                var ci: size_t 0
                                let cn piece.get_length()
                                while ci < cn
                                {
                                    sb.append(piece.get(ci) as char)
                                    set ci: ci + 1
                                }
                                set first: false
                            }
                        }
                        set i: i + 1
                    }
                }
            }

        sb.append("]" as char)
        sb.to_string()
    }

    ; One top-level declaration -> a symbol, or "" for declarations with no
    ; outline presence (use/package/empty). Every arm returns explicitly.
    function decl_symbol(rp, source: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.routine_symbol(source, f.target, f.start, f.end, 12)
            when pr: ProcedureSyntax
                return symbols.routine_symbol(source, pr.target, pr.start, pr.end, 12)
            when o: OperatorSyntax
                return symbols.routine_symbol(source, o.target, o.start, o.end, 25)
            when def: DefinitionSyntax
                return symbols.definition_symbol(source, def)
            when m: ModuleSyntax
                return symbols.symbol_object(source, m.name, 2, m.start, m.end, "[]")
            when mut: MutableSyntax
                return symbols.symbol_object(source, mut.binding.name, 13, mut.start, mut.end, "[]")
            when sh: SharedSyntax
                return symbols.symbol_object(source, sh.binding.name, 13, sh.start, sh.end, "[]")
            when priv: PrivateSyntax
                return symbols.export_symbol(source, priv.export_)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function export_symbol(rp, source: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.routine_symbol(source, f.target, f.start, f.end, 12)
            when pr: ProcedureSyntax
                return symbols.routine_symbol(source, pr.target, pr.start, pr.end, 12)
            when o: OperatorSyntax
                return symbols.routine_symbol(source, o.target, o.start, o.end, 25)
            when def: DefinitionSyntax
                return symbols.definition_symbol(source, def)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.symbol_object(source, m.name, 2, m.start, m.end, "[]")
    }

    ; A function / procedure / operator: name from its target, no children.
    function routine_symbol(rp, source: String, target: TargetSyntax, start: size_t, end: size_t, kind: i64) returns String
    {
        let name symbols.target_name target
        symbols.symbol_object(source, name, kind, start, end, "[]")
    }

    ; The declared name of a routine target (operator targets may be the
    ; anonymous index form `[]`).
    function target_name(rp, target: TargetSyntax) returns String
    {
        choose target
            when named: NamedSyntax
                return String(named.name)
            when r: RoutineSyntax
                return "[]"
    }

    ; A `define X` declaration. Kind + children depend on the concept:
    ;   Class -> Struct(23) with its members as children
    ;   Namespace -> Namespace(3) with its declarations as children
    ;   Union -> Enum(10) with its variants (+ body members) as children
    ;   Constant -> Constant(14); Delegate -> Function(12); Intrinsic -> Struct(23)
    function definition_symbol(rp, source: String, def: DefinitionSyntax) returns String
    {
        var kind: i64 (23 as i64)
        var children "[]"
        choose def.concept_
            when c: ClassSyntax
            {
                set kind: 23
                set children: symbols.body_children(source, c.body)
            }
            when n: NamespaceSyntax
            {
                set kind: 3
                set children: symbols.namespace_children(source, n)
            }
            when un: UnionSyntax
            {
                set kind: 10
                set children: symbols.union_children(source, un)
            }
            when cn: ConstantSyntax
                set kind: 14
            when dl: DelegateSyntax
                set kind: 12
            when ic: IntrinsicSyntax
                set kind: 23
        symbols.symbol_object(source, def.name, kind, def.start, def.end, children)
    }

    ; Children of a class body: methods, constructors, nested definitions.
    function body_children(rp, source: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var first true
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let piece symbols.member_symbol(source, m)
                        if piece.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn piece.get_length()
                            while ci < cn
                            {
                                sb.append(piece.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; One member of a class/union body -> a symbol, or "" if it has no
    ; outline presence (empty, implement, trait, macro, module).
    function member_symbol(rp, source: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.routine_symbol(source, f.target, f.start, f.end, 6)
            when pr: ProcedureSyntax
                return symbols.routine_symbol(source, pr.target, pr.start, pr.end, 6)
            when o: OperatorSyntax
                return symbols.routine_symbol(source, o.target, o.start, o.end, 25)
            when ini: InitSyntax
                return symbols.symbol_object(source, "init", 9, ini.start, ini.end, "[]")
            when dei: DeInitSyntax
                return symbols.symbol_object(source, "deinit", 9, dei.start, dei.end, "[]")
            when def: DefinitionSyntax
                return symbols.definition_symbol(source, def)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.symbol_object(source, m.name, 2, m.start, m.end, "[]")
    }

    ; Children of a namespace: its nested declarations (reuses decl_symbol#).
    function namespace_children(rp, source: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var first true
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let piece symbols.decl_symbol(source, d)
                    if piece.get_length() > 0
                    {
                        if first = false
                            sb.append("," as char)
                        var ci: size_t 0
                        let cn piece.get_length()
                        while ci < cn
                        {
                            sb.append(piece.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set i: i + 1
            }
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; Children of a union: each variant as an EnumMember(22), then any body
    ; members (methods defined on the union).
    function union_children(rp, source: String, un: UnionSyntax) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)
        var first true
        if un.variants <> null
        {
            let variants (*un.variants)
            var i: size_t 0
            while i < variants.length
            {
                let vptr variants.get i
                if vptr <> null
                {
                    if first = false
                        sb.append("," as char)
                    let vsym symbols.symbol_object(source, vptr.name, 22, vptr.start, vptr.end, "[]")
                    var ci: size_t 0
                    let cn vsym.get_length()
                    while ci < cn
                    {
                        sb.append(vsym.get(ci) as char)
                        set ci: ci + 1
                    }
                    set first: false
                }
                set i: i + 1
            }
        }
        if un.body <> null
        {
            let b (*un.body)
            if b.members <> null
            {
                let members (*b.members)
                var j: size_t 0
                while j < members.length
                {
                    let mptr members.get j
                    if mptr <> null
                    {
                        let m (*mptr)
                        let piece symbols.member_symbol(source, m)
                        if piece.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn piece.get_length()
                            while ci < cn
                            {
                                sb.append(piece.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set j: j + 1
                }
            }
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; Leaf builders
    ; ====================================================================

    function symbol_object(rp, source: String, name: String, kind: i64, start: size_t, end: size_t, children: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("name"))
        sb.append(json.quote_string(name))
        sb.append("," as char)
        sb.append(symbols.key("kind"))
        sb.append(json.format_i64(kind))
        sb.append("," as char)
        sb.append(symbols.key("range"))
        sb.append(symbols.range_for(source, start, end))
        sb.append("," as char)
        sb.append(symbols.key("selectionRange"))
        sb.append(symbols.range_for(source, start, end))
        sb.append("," as char)
        sb.append(symbols.key("children"))
        var ci: size_t 0
        let cn children.get_length()
        while ci < cn
        {
            sb.append(children.get(ci) as char)
            set ci: ci + 1
        }
        sb.append("}" as char)
        sb.to_string()
    }

    ; {"start":<pos>,"end":<pos>}
    function range_for(rp, source: String, start: size_t, end: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("start"))
        sb.append(symbols.offset_to_pos(source, start))
        sb.append("," as char)
        sb.append(symbols.key("end"))
        sb.append(symbols.offset_to_pos(source, end))
        sb.append("}" as char)
        sb.to_string()
    }

    ; Byte offset -> {"line":L,"character":C}, both 0-based. ASCII columns
    ; (UTF-16 units == bytes for ASCII). Numeric LF compare (10), never "\n".
    ; Mirrors diagnostics.diag_object#'s offset walk.
    function offset_to_pos(rp, source: String, offset: size_t) returns String
    {
        var line: size_t 0
        var col: size_t 0
        let src_len source.get_length()
        var target offset
        if target > src_len
            set target: src_len
        var off: size_t 0
        while off < target
        {
            let c source.get off
            if c = ("\n" as char)
            {
                set line: line + 1
                set col: 0
            }
            else
                set col: col + 1
            set off: off + 1
        }

        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("line"))
        sb.append(json.format_i64(line as i64))
        sb.append("," as char)
        sb.append(symbols.key("character"))
        sb.append(json.format_i64(col as i64))
        sb.append("}" as char)
        sb.to_string()
    }

    ; `"key":`
    function key(rp, k: pointer[const_char]) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)
        sb.append k
        sb.append("\"" as char)
        sb.append(":" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; textDocument/foldingRange (parse-only)
    ;
    ; Collapsible regions of the document: every multi-line declaration that
    ; has a body — top-level functions / procedures / operators, `define`
    ; classes / namespaces / unions (and their members recursively) — yields
    ; one LSP FoldingRange {"startLine":L,"endLine":L} (both 0-based). The
    ; result is the FLAT JSON array `[ <range>... ]` (FoldingRange[] is flat;
    ; ranges nest implicitly by line containment). The parent wraps it in a
    ; Response envelope. Same parse-tree walk as documentSymbol/completion,
    ; flattened into comma-joined fragments (callers join non-empty fragments
    ; with one comma). Single-line declarations produce "" and are dropped.
    ;
    ; END-OFFSET NOTE: a syntax node's `end` runs to the START of the next
    ; token (trailing trivia included), so converting it straight to a line
    ; would over-fold past the closing `}` into the blank line / next decl.
    ; fold_range# backs `end` up over trailing whitespace (last_real_offset)
    ; so endLine lands on the closing-brace line. Statement-level folds
    ; (if/while bodies) are NOT emitted — the walk stops at routine bodies.
    ; ====================================================================

    function folding_ranges(rp, source: String) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)

        var p parser.Parser(source)
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var first true
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let frag symbols.fold_decl(source, d)
                            if frag.get_length() > 0
                            {
                                if first = false
                                    sb.append("," as char)
                                var ci: size_t 0
                                let cn frag.get_length()
                                while ci < cn
                                {
                                    sb.append(frag.get(ci) as char)
                                    set ci: ci + 1
                                }
                                set first: false
                            }
                        }
                        set i: i + 1
                    }
                }
            }

        sb.append("]" as char)
        sb.to_string()
    }

    ; One top-level declaration -> a fragment (its own range, plus the bodies
    ; of a definition's members). "" for use/package/empty/trait/macro/mutable.
    function fold_decl(rp, source: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.fold_range(source, f.start, f.end)
            when pr: ProcedureSyntax
                return symbols.fold_range(source, pr.start, pr.end)
            when o: OperatorSyntax
                return symbols.fold_range(source, o.start, o.end)
            when def: DefinitionSyntax
                return symbols.fold_definition(source, def)
            when m: ModuleSyntax
                return symbols.fold_range(source, m.start, m.end)
            when mut: MutableSyntax
                return ""
            when sh: SharedSyntax
                return ""
            when priv: PrivateSyntax
                return symbols.fold_export(source, priv.export_)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function fold_export(rp, source: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.fold_range(source, f.start, f.end)
            when pr: ProcedureSyntax
                return symbols.fold_range(source, pr.start, pr.end)
            when o: OperatorSyntax
                return symbols.fold_range(source, o.start, o.end)
            when def: DefinitionSyntax
                return symbols.fold_definition(source, def)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.fold_range(source, m.start, m.end)
    }

    ; A `define X` -> its own range followed by its members' ranges.
    function fold_definition(rp, source: String, def: DefinitionSyntax) returns String
    {
        var members ""
        choose def.concept_
            when c: ClassSyntax
                set members: symbols.fold_body(source, c.body)
            when n: NamespaceSyntax
                set members: symbols.fold_namespace(source, n)
            when un: UnionSyntax
                set members: symbols.fold_union(source, un)
            when cn: ConstantSyntax {}
            when dl: DelegateSyntax {}
            when ic: IntrinsicSyntax {}
        let own symbols.fold_range(source, def.start, def.end)
        symbols.join_two(own, members)
    }

    ; Members of a class body -> a comma-joined fragment (no brackets).
    function fold_body(rp, source: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        var first true
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.fold_member(source, m)
                        if frag.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.to_string()
    }

    ; One class/union member -> its range, "", or a nested definition fragment.
    function fold_member(rp, source: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.fold_range(source, f.start, f.end)
            when pr: ProcedureSyntax
                return symbols.fold_range(source, pr.start, pr.end)
            when o: OperatorSyntax
                return symbols.fold_range(source, o.start, o.end)
            when ini: InitSyntax
                return symbols.fold_range(source, ini.start, ini.end)
            when dei: DeInitSyntax
                return symbols.fold_range(source, dei.start, dei.end)
            when def: DefinitionSyntax
                return symbols.fold_definition(source, def)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.fold_range(source, m.start, m.end)
    }

    ; Nested declarations of a namespace -> a comma-joined fragment.
    function fold_namespace(rp, source: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        var first true
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let frag symbols.fold_decl(source, d)
                    if frag.get_length() > 0
                    {
                        if first = false
                            sb.append("," as char)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set i: i + 1
            }
        }
        sb.to_string()
    }

    ; Body members of a union -> a comma-joined fragment. Variants are
    ; single-line and never fold, so only the union's methods contribute.
    function fold_union(rp, source: String, un: UnionSyntax) returns String
    {
        var sb StringBuilder()
        var first true
        if un.body <> null
        {
            let b (*un.body)
            if b.members <> null
            {
                let members (*b.members)
                var j: size_t 0
                while j < members.length
                {
                    let mptr members.get j
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.fold_member(source, m)
                        if frag.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set j: j + 1
                }
            }
        }
        sb.to_string()
    }

    ; A FoldingRange {"startLine":L,"endLine":L}, or "" for a single-line
    ; (non-foldable) declaration. `end` is backed up over trailing whitespace
    ; so endLine is the closing-brace line, not the next token's line.
    function fold_range(rp, source: String, start: size_t, end: size_t) returns String
    {
        let start_line symbols.line_at(source, start)
        let real_end symbols.last_real_offset(source, end)
        let end_line symbols.line_at(source, real_end)
        if end_line <= start_line
            return ""
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("startLine"))
        sb.append(json.format_i64(start_line as i64))
        sb.append("," as char)
        sb.append(symbols.key("endLine"))
        sb.append(json.format_i64(end_line as i64))
        sb.append("}" as char)
        sb.to_string()
    }

    ; Join two comma-joined fragments with a comma, dropping empties.
    function join_two(rp, a: String, b: String) returns String
    {
        if a.get_length() = 0
            return b
        if b.get_length() = 0
            return a
        var sb StringBuilder()
        var ai: size_t 0
        let an a.get_length()
        while ai < an
        {
            sb.append(a.get(ai) as char)
            set ai: ai + 1
        }
        sb.append("," as char)
        var bi: size_t 0
        let bn b.get_length()
        while bi < bn
        {
            sb.append(b.get(bi) as char)
            set bi: bi + 1
        }
        sb.to_string()
    }

    ; 0-based line number of a byte offset (count LFs before it). Mirrors
    ; offset_to_pos#'s line walk; numeric LF compare (10), never "\n".
    function line_at(source: String, offset: size_t) returns size_t
    {
        var line: size_t 0
        let src_len source.get_length()
        var target offset
        if target > src_len
            set target: src_len
        var off: size_t 0
        while off < target
        {
            let c source.get off
            if c = ("\n" as char)
                set line: line + 1
            set off: off + 1
        }
        line
    }

    ; Back `end` up over trailing whitespace so it points just past the last
    ; real character (the closing `}`), not into the next token's leading trivia.
    function last_real_offset(source: String, end: size_t) returns size_t
    {
        let src_len source.get_length()
        var e end
        if e > src_len
            set e: src_len
        while e > 0
        {
            let c source.get(e - 1)
            if symbols.is_ws_byte(c) = false
                return e
            set e: e - 1
        }
        e
    }

    ; ASCII whitespace: space, tab, LF, CR.
    function is_ws_byte(c: u8) returns bool
    {
        if c = 32
            return true
        if c = 9
            return true
        if c = 10
            return true
        if c = 13
            return true
        false
    }

    ; ====================================================================
    ; textDocument/semanticTokens/full (lexical)
    ;
    ; A single raw byte scan classifies every token into the legend below and
    ; emits the LSP delta-encoded `data` array. Legend (token-type indices):
    ;   0 keyword  1 type  2 function  3 variable  4 operator  5 string
    ;   6 number   7 comment
    ; No modifiers. Classification is LEXICAL (no parser): keywords via the
    ; parser's keyword set; the identifier right after `function`/`procedure`
    ; -> function, after `define`/`union`/`trait`/`module` -> type; any other
    ; identifier -> type if it starts uppercase, else variable. Operators are
    ; runs of + - * / = % & | ^ ~ < > (mirrors lexer scan_operator); strings
    ; are " " / ' ' / ` ` ; numbers start with a digit; comments are `;` to EOL
    ; and `;* ... *;` (split into one token per line — LSP tokens are
    ; single-line). The result is {"data":[...]}; the server wraps it in a
    ; Response (the data array can be large -> byte-at-a-time wrapper).
    ;
    ; ENCODING: each token is 5 ints [dLine, dStartChar, length, type, 0],
    ; delta-encoded against the previous token (dStartChar absolute when
    ; dLine>0). All JSON uses quote BYTES (0x22) — string-literal escapes are
    ; NOT decoded by the lexer, so a `\"` in a literal would land raw.
    ; ====================================================================

    function semantic_tokens(rp, source: String, uri: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("data"))            ; "data":
        sb.append("[" as char)

        ; Semantic name tables: reuse completion_items# (one parse + walk) to
        ; harvest declared function/method names (CompletionItemKind 2/3) and
        ; type names (struct 22 / enum-union 13), plus the lowercase primitives.
        ; An identifier USE matching one of these is coloured by its declared
        ; kind, not just its shape.
        let comp_items symbols.completion_items source
        let fn_list symbols.names_from_items(comp_items, 2, 3)
        let ty_list symbols.names_from_items(comp_items, 22, 13)
        let prim_list symbols.primitive_type_list()

        ; Cross-file name tables: function/method + struct/enum names harvested
        ; from the current file's directory tree AND the package dependency tree
        ; (stdlib String/Vector/Page, …) via the symindex cache. "" (no
        ; workspace context) -> empty lists -> identical to the intra-file path.
        ; No file-size gate: lookups go through the O(1) hash table below, so the
        ; per-identifier cost no longer scales with the list bytes (the Step 27
        ; gate is removed; the harvest cost is bounded by the content-hashed
        ; symindex regardless of the current file's size).
        let xname_blob symbols.workspace_name_blob uri
        let xfn_list symbols.tagged_name_list(xname_blob, 0x46)  ; F
        let xty_list symbols.tagged_name_list(xname_blob, 0x54)  ; T

        ; One hashed name->token-kind table from the five lists. Type lists
        ; (primitives, intra-file types, cross-file types) -> token type 1;
        ; function lists (intra-file + cross-file) -> 2. A name that is both
        ; resolves to function (insert only raises a slot's kind). The table
        ; borrows the lists' buffers (alive for this function) and is freed
        ; before return.
        let ns_cap (NS_CAP as size_t)
        let ns_slots nameset.create ns_cap
        nameset.insert_name_list(ns_slots, ns_cap, prim_list, 1)
        nameset.insert_name_list(ns_slots, ns_cap, ty_list, 1)
        nameset.insert_name_list(ns_slots, ns_cap, xty_list, 1)
        nameset.insert_name_list(ns_slots, ns_cap, fn_list, 2)
        nameset.insert_name_list(ns_slots, ns_cap, xfn_list, 2)

        ; Scope-aware tables: routine [start,end)+param-names and field-decl
        ; offsets, both from ONE more parse. param_in_scope / is_field_decl_offset
        ; query this per identifier; the after-dot property case uses prev_was_dot.
        let scope_tbl symbols.scope_table source

        let n source.get_length()
        var i: size_t 0
        var line: size_t 0
        var col: size_t 0
        var prev_line: size_t 0
        var prev_col: size_t 0
        var first true
        var pending: i64 (0 - 1)                   ; -1 none, 1 type-name, 2 fn-name
        var prev_was_dot false                     ; previous emitted token was `.`

        while i < n
        {
            let c source.get i

            ; newline (does NOT reset pending — whitespace between `function`
            ; and the name must keep the pending classification)
            if c = 10
            {
                set line: line + 1
                set col: 0
                set i: i + 1
                continue
            }

            ; space / tab / CR (also keeps pending)
            if symbols.is_ws_byte(c)
            {
                set col: col + 1
                set i: i + 1
                continue
            }

            ; comment: `;` to EOL, or `;* ... *;` (possibly multi-line)
            if c = 59
            {
                var is_multi false
                if i + 1 < n
                    if source.get(i + 1) = 42
                        set is_multi: true

                if is_multi
                {
                    var seg_col col
                    var seg_line line
                    var k i
                    var done false
                    while k < n
                    {
                        if done
                            break
                        let cc source.get k
                        if cc = 10
                        {
                            let seglen col - seg_col
                            if seglen > 0
                            {
                                if first = false
                                    sb.append("," as char)
                                sb.append(symbols.encode_token(prev_line, prev_col, seg_line, seg_col, seglen, 7))
                                set prev_line: seg_line
                                set prev_col: seg_col
                                set first: false
                            }
                            set line: line + 1
                            set col: 0
                            set k: k + 1
                            set seg_line: line
                            set seg_col: 0
                            continue
                        }
                        if cc = 42
                            if k + 1 < n
                                if source.get(k + 1) = 59
                                {
                                    set col: col + 2
                                    set k: k + 2
                                    set done: true
                                    continue
                                }
                        set col: col + 1
                        set k: k + 1
                    }
                    let seglen col - seg_col
                    if seglen > 0
                    {
                        if first = false
                            sb.append("," as char)
                        sb.append(symbols.encode_token(prev_line, prev_col, seg_line, seg_col, seglen, 7))
                        set prev_line: seg_line
                        set prev_col: seg_col
                        set first: false
                    }
                    set i: k
                    set pending: 0 - 1
                    set prev_was_dot: false
                    continue
                }

                ; single-line comment: from i to the next newline
                var j i
                while j < n
                {
                    if source.get(j) = 10
                        break
                    set j: j + 1
                }
                let clen j - i
                if first = false
                    sb.append("," as char)
                sb.append(symbols.encode_token(prev_line, prev_col, line, col, clen, 7))
                set prev_line: line
                set prev_col: col
                set first: false
                set col: col + clen
                set i: j
                set pending: 0 - 1
                set prev_was_dot: false
                continue
            }

            ; A single-line token from here. Classify [i, j) -> tok_type/tlen.
            var tok_type: i64 (0 - 1)
            var tlen: size_t 0
            let start_col col

            ; string literal " (34) / string identifier ' (39) / fragment ` (96)
            if symbols.is_string_start(c)
            {
                let q c
                var j i + 1
                while j < n
                {
                    let cc source.get j
                    if cc = 10
                        break
                    if cc = 92          ; backslash escape: skip next
                    {
                        set j: j + 2
                        continue
                    }
                    if cc = q
                    {
                        set j: j + 1               ; include the closing quote
                        break
                    }
                    set j: j + 1
                }
                if j > n
                    set j: n
                set tlen: j - i
                set tok_type: 5                 ; string
                set pending: 0 - 1
            }

            ; number: starts with a digit
            if symbols.is_digit(c)
            {
                var j i + 1
                while j < n
                {
                    let cc source.get j
                    if symbols.is_num_byte(cc) = false
                        break
                    set j: j + 1
                }
                set tlen: j - i
                set tok_type: 6                 ; number
                set pending: 0 - 1
            }

            ; identifier: starts with a letter
            if symbols.is_letter(c)
            {
                var j i + 1
                while j < n
                {
                    let cc source.get j
                    if symbols.is_ident_byte(cc) = false
                        break
                    set j: j + 1
                }
                set tlen: j - i
                let word symbols.substring(source, i, j)
                let after_dot prev_was_dot
                var t: i64 (3)                     ; variable
                if symbols.is_upper(c)
                    set t: 1                ; lexical: uppercase -> type
                if pending = 1
                    set t: 1                ; after define/union/... -> type
                if pending = 2
                    set t: 2                ; after function/procedure -> function
                ; semantic override: resolve the USE to its declared kind via
                ; the hashed name set (1 type / 2 function, function wins).
                let nk nameset.lookup(ns_slots, ns_cap, source, i, j)
                if nk >= 0
                    set t: nk
                ; parameter: in scope of the enclosing routine (above function)
                if symbols.param_in_scope(scope_tbl, source, i, j, i)
                    set t: 8
                ; property (a): a field/property name at its declaration site
                if symbols.is_field_decl_offset(scope_tbl, i)
                    set t: 9
                ; property (b): an after-`.` member access not resolved as a
                ; function/method or type (Type.method / ns.fn keep their kind)
                if after_dot
                {
                    if t <> 1
                        if t <> 2
                            set t: 9
                }
                if grammar.is_keyword(word)
                    set t: 0                ; keyword wins (grammar-derived)
                ; The four word operators. An operator is normally an identifier
                ; made exclusively of operator characters, which the run below
                ; already classifies; these are the only ones spelled in letters
                ; and so the only ones reachable here. Without this they read as
                ; `variable`, i.e. as bindings.
                if grammar.is_word_operator(word)
                    set t: 4                ; operator
                ; true/false/null/this resolve to a VALUE, not to a binding.
                if grammar.is_value_word(word)
                    set t: 0                ; keyword
                set tok_type: t
                ; set pending for the NEXT identifier off this keyword, else clear
                if t = 0
                {
                    var np: i64 (0 - 1)
                    if word = "function"
                        set np: 2
                    if word = "procedure"
                        set np: 2
                    if word = "define"
                        set np: 1
                    if word = "union"
                        set np: 1
                    if word = "trait"
                        set np: 1
                    if word = "module"
                        set np: 1
                    set pending: np
                }
                if t <> 0
                    set pending: 0 - 1
            }

            ; operator: a run of operator characters. The class is generated
            ; from ONE table (codegen/highlight-scaly.scm) and must match the
            ; lexer's; note it excludes '^', which is the lifetime sigil and
            ; never an operator character (lexer.scaly:330).
            if grammar.is_op_char(c)
            {
                var j i + 1
                while j < n
                {
                    let cc source.get j
                    if grammar.is_op_char(cc) = false
                        break
                    set j: j + 1
                }
                set tlen: j - i
                set tok_type: 4
                set pending: 0 - 1
            }

            ; Emit the single-line token (if one was classified).
            if tok_type >= 0
            {
                if first = false
                    sb.append("," as char)
                sb.append(symbols.encode_token(prev_line, prev_col, line, start_col, tlen, tok_type))
                set prev_line: line
                set prev_col: start_col
                set first: false
                set col: col + tlen
                set i: i + tlen
                set prev_was_dot: false
                continue
            }

            ; other punctuation / unknown: skip one char. A `.` arms the
            ; after-dot property classification for the next identifier.
            var is_dot false
            if c = 0x2E
                set is_dot: true
            set prev_was_dot: is_dot
            set col: col + 1
            set i: i + 1
            set pending: 0 - 1
        }

        sb.append("]" as char)
        sb.append("}" as char)
        nameset.destroy ns_slots
        sb.to_string()
    }

    ; One delta-encoded semantic token: "dLine,dStartChar,length,type,0".
    function encode_token(rp, prev_line: size_t, prev_col: size_t, tline: size_t, tcol: size_t, tlen: size_t, ttype: i64) returns String
    {
        let dline tline - prev_line
        var dcol tcol
        if dline = 0
            set dcol: tcol - prev_col
        var sb StringBuilder()
        sb.append(json.format_i64(dline as i64))
        sb.append("," as char)
        sb.append(json.format_i64(dcol as i64))
        sb.append("," as char)
        sb.append(json.format_i64(tlen as i64))
        sb.append("," as char)
        sb.append(json.format_i64(ttype))
        sb.append("," as char)
        sb.append("0" as char)                    ; 0 (no modifiers)
        sb.to_string()
    }

    function is_letter(c: u8) returns bool
    {
        if c >= 65
            if c <= 90
                return true
        if c >= 97
            if c <= 122
                return true
        false
    }

    function is_upper(c: u8) returns bool
    {
        if c >= 65
            if c <= 90
                return true
        false
    }

    function is_digit(c: u8) returns bool
    {
        if c >= 48
            if c <= 57
                return true
        false
    }

    ; Bytes that continue a numeric literal: digits, hex letters, x/X, ., _.
    function is_num_byte(c: u8) returns bool
    {
        if c >= 48
            if c <= 57
                return true
        if c >= 65
            if c <= 70
                return true
        if c >= 97
            if c <= 102
                return true
        if c = 120
            return true
        if c = 88
            return true
        if c = 46
            return true
        if c = 95
            return true
        false
    }

    ; Quote bytes that open a string: " (34), ' (39), ` (96).
    function is_string_start(c: u8) returns bool
    {
        if c = 34
            return true
        if c = 39
            return true
        if c = 96
            return true
        false
    }

    ; ----- semanticTokens: declared-name resolution -----
    ; The lexical scan colours by shape; these let it colour by MEANING — an
    ; identifier USE gets its declared kind (a function call -> function, a
    ; type reference -> type), which a regex/shape pass cannot do. The declared
    ; names are harvested by REUSING completion_items# (which already classifies
    ; every declared name by CompletionItemKind), so no walk is duplicated.

    ; Extract a newline-delimited, newline-bracketed list of the labels in a
    ; completion-items JSON array whose kind is k1 or k2. ("\nadd\nfoo\n")
    function names_from_items(rp, items_json: String, k1: i64, k2: i64) returns String
    {
        var sb StringBuilder()
        sb.append("\n" as char)                    ; leading newline
        let jv json.parse items_json
        let count json.array_length jv
        var i: size_t 0
        while i < count
        {
            let item json.array_get(jv, i)
            let kind json.as_i64(json.get(item, "kind"))
            if kind = k1
            {
                sb.append(json.as_string(json.get(item, "label")))
                sb.append("\n" as char)
            }
            if kind = k2
            {
                sb.append(json.as_string(json.get(item, "label")))
                sb.append("\n" as char)
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; The lowercase primitive/builtin type names (uppercase types are caught
    ; lexically). Newline-bracketed, like names_from_items#. Built with byte
    ; appends (string-literal escapes are not decoded, so no "\n" literals).
    function primitive_type_list(rp) returns String
    {
        var sb StringBuilder()
        sb.append("\n" as char)
        sb.append "int"
        sb.append("\n" as char)
        sb.append "bool"
        sb.append("\n" as char)
        sb.append "char"
        sb.append("\n" as char)
        sb.append "void"
        sb.append("\n" as char)
        sb.append "float"
        sb.append("\n" as char)
        sb.append "double"
        sb.append("\n" as char)
        sb.append "size_t"
        sb.append("\n" as char)
        sb.append "u8"
        sb.append("\n" as char)
        sb.append "u16"
        sb.append("\n" as char)
        sb.append "u32"
        sb.append("\n" as char)
        sb.append "u64"
        sb.append("\n" as char)
        sb.append "i8"
        sb.append("\n" as char)
        sb.append "i16"
        sb.append("\n" as char)
        sb.append "i32"
        sb.append("\n" as char)
        sb.append "i64"
        sb.append("\n" as char)
        sb.append "pointer"
        sb.append("\n" as char)
        sb.append "ref"
        sb.append("\n" as char)
        sb.to_string()
    }

    ; Byte-equality of a[astart,astart+len) and b[bstart,bstart+len).
    function range_equals(a: String, astart: size_t, b: String, bstart: size_t, len: size_t) returns bool
    {
        var k: size_t 0
        while k < len
        {
            let ca a.get(astart + k)
            let cb b.get(bstart + k)
            if ca <> cb
                return false
            set k: k + 1
        }
        true
    }

    ; ----- semanticTokens: scope-aware parameters + declared fields -----
    ; These refine the declared-NAME resolution (which is file-global, like
    ; fn_list/ty_list) with two POSITION-aware classes that a name set cannot
    ; express:
    ;   - parameter: an identifier inside the routine whose parameter list
    ;     names it (scope-aware — `x` only colours inside its own routine).
    ;   - property (declaration): a field/property NAME at its declaration
    ;     site in a `define X (fields)` structure.
    ; Both come from ONE parse via `scope_table#`, which returns a blob of
    ; TAB/LF-delimited tagged records (no aggregate-through-param mutation —
    ; each walker RETURNS a record fragment, mirroring names_from_items#):
    ;   "P" <TAB> start <TAB> end <TAB> "name1 name2 ..." <LF>   (routine scope)
    ;   "F" <TAB> offset <LF>                                    (field decl)
    ; semantic_tokens# builds the table once, then `param_in_scope` /
    ; `is_field_decl_offset` query it per identifier token. The after-dot
    ; property case needs no table (it tracks the previous emitted token).

    ; First letter byte at or after `from` (the real name token start; a
    ; PartSyntax/PropertySyntax `start` is `previous_position`, just before the
    ; name, so trailing trivia / a leading `(`/`,` precede the letter).
    function name_offset_at(source: String, from: size_t) returns size_t
    {
        let n source.get_length()
        var i from
        while i < n
        {
            if symbols.is_letter(source.get i)
                break
            set i: i + 1
        }
        i
    }

    ; The parameter names of a parameter set, space-joined (with a trailing
    ; space). A leading `this` receiver is dropped (it is never written as an
    ; argument). A bare-type parameter set carries no names.
    function params_set_names(rp, parameters: ref[ParameterSetSyntax]?) returns String
    {
        var sb StringBuilder()
        if parameters <> null
        {
            let ps (*parameters)
            choose ps
                when params: ParametersSyntax
                {
                    if params.items <> null
                    {
                        let items (*params.items)
                        var i: size_t 0
                        if items.length > 0
                        {
                            let i0 items.get(0)
                            if i0 <> null
                            {
                                let it0 (*i0)
                                let kw_this "this"
                                if it0.name = kw_this
                                    set i: 1
                            }
                        }
                        while i < items.length
                        {
                            let iptr items.get i
                            if iptr <> null
                            {
                                let it (*iptr)
                                var k: size_t 0
                                let nn it.name.get_length()
                                while k < nn
                                {
                                    sb.append(it.name.get(k) as char)
                                    set k: k + 1
                                }
                                sb.append(" " as char)
                            }
                            set i: i + 1
                        }
                    }
                }
                when ty: TypeSyntax {}
        }
        sb.to_string()
    }

    ; One routine-scope record "P\t<start>\t<end>\t<names>\n", or "" when the
    ; routine has no (non-this) parameters.
    function param_record(rp, start: size_t, end: size_t, names: String) returns String
    {
        if names.get_length() > 0
        {
            var sb StringBuilder()
            sb.append("P" as char)
            sb.append("\t" as char)
            sb.append(json.format_i64(start as i64))
            sb.append("\t" as char)
            sb.append(json.format_i64(end as i64))
            sb.append("\t" as char)
            var k: size_t 0
            let nn names.get_length()
            while k < nn
            {
                sb.append(names.get(k) as char)
                set k: k + 1
            }
            sb.append("\n" as char)
            return sb.to_string()
        }
        ""
    }

    ; One routine-range record "R\t<start>\t<end>\n", emitted for EVERY routine
    ; (function/procedure/operator/init/method) regardless of whether it has
    ; parameters, so the enclosing-routine lookup (scope-aware references/rename)
    ; can find the routine containing any cursor. param_in_scope /
    ; is_field_decl_offset both skip unknown tags, so adding R is safe for them.
    function r_record(rp, start: size_t, end: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("R" as char)
        sb.append("\t" as char)
        sb.append(json.format_i64(start as i64))
        sb.append("\t" as char)
        sb.append(json.format_i64(end as i64))
        sb.append("\n" as char)
        sb.to_string()
    }

    ; One field-declaration record "F\t<offset>\n".
    function f_record(rp, off: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("F" as char)
        sb.append("\t" as char)
        sb.append(json.format_i64(off as i64))
        sb.append("\n" as char)
        sb.to_string()
    }

    ; The scope record for a routine target (named -> its routine; an anonymous
    ; routine target has no name to scope but its params still apply).
    function st_target(rp, source: String, start: size_t, end: size_t, target: TargetSyntax) returns String
    {
        var sb StringBuilder()
        sb.append(symbols.r_record(start, end))
        choose target
            when named: NamedSyntax
                sb.append(symbols.param_record(start, end, symbols.params_set_names(named.routine.parameters)))
            when r: RoutineSyntax
                sb.append(symbols.param_record(start, end, symbols.params_set_names(r.parameters)))
        sb.to_string()
    }

    ; The scope record for an init (its `page`/explicit params are colourable).
    function st_init(rp, source: String, start: size_t, end: size_t, parameters: ref[ParameterSetSyntax]?) returns String
    {
        var sb StringBuilder()
        sb.append(symbols.r_record(start, end))
        sb.append(symbols.param_record(start, end, symbols.params_set_names(parameters)))
        sb.to_string()
    }

    ; One structure part -> its field-declaration record (verified against the
    ; declared name so a stray non-name byte never produces a bogus offset).
    function field_record(rp, source: String, part: PartSyntax) returns String
    {
        choose part
            when fld: Field
            {
                let prop fld.property
                let off symbols.name_offset_at(source, prop.start)
                let nlen prop.name.get_length()
                if off + nlen <= source.get_length()
                    if symbols.range_equals(source, off, prop.name, 0, nlen)
                        return symbols.f_record off
                return ""
            }
            when prop2: Property
            {
                let off symbols.name_offset_at(source, prop2.start)
                let nlen prop2.name.get_length()
                if off + nlen <= source.get_length()
                    if symbols.range_equals(source, off, prop2.name, 0, nlen)
                        return symbols.f_record off
                return ""
            }
    }

    ; Top-level declaration -> its scope/field records (concatenated, each
    ; newline-terminated, so plain concatenation needs no separator).
    function st_decl(rp, source: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.st_target(source, f.start, f.end, f.target)
            when pr: ProcedureSyntax
                return symbols.st_target(source, pr.start, pr.end, pr.target)
            when o: OperatorSyntax
                return symbols.st_target(source, o.start, o.end, o.target)
            when def: DefinitionSyntax
                return symbols.st_definition(source, def)
            when m: ModuleSyntax
                return ""
            when mut: MutableSyntax
                return ""
            when sh: SharedSyntax
                return ""
            when priv: PrivateSyntax
                return symbols.st_export(source, priv.export_)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function st_export(rp, source: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.st_target(source, f.start, f.end, f.target)
            when pr: ProcedureSyntax
                return symbols.st_target(source, pr.start, pr.end, pr.target)
            when o: OperatorSyntax
                return symbols.st_target(source, o.start, o.end, o.target)
            when def: DefinitionSyntax
                return symbols.st_definition(source, def)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return ""
    }

    ; A `define X` -> field records (class structure) + member scope records.
    function st_definition(rp, source: String, def: DefinitionSyntax) returns String
    {
        choose def.concept_
            when c: ClassSyntax
                return symbols.st_class(source, c)
            when n: NamespaceSyntax
                return symbols.st_namespace(source, n)
            when un: UnionSyntax
                return symbols.st_union(source, un)
            when cn: ConstantSyntax
                return ""
            when dl: DelegateSyntax
                return ""
            when ic: IntrinsicSyntax
                return ""
    }

    ; Class: field declarations from the structure parts, then body members.
    function st_class(rp, source: String, c: ClassSyntax) returns String
    {
        var sb StringBuilder()
        let st c.structure
        if st.parts <> null
        {
            let parts (*st.parts)
            var i: size_t 0
            while i < parts.length
            {
                let pptr parts.get i
                if pptr <> null
                {
                    let part (*pptr)
                    let frag symbols.field_record(source, part)
                    var ci: size_t 0
                    let cn frag.get_length()
                    while ci < cn
                    {
                        sb.append(frag.get(ci) as char)
                        set ci: ci + 1
                    }
                }
                set i: i + 1
            }
        }
        let bodyfrag symbols.st_body(source, c.body)
        var bi: size_t 0
        let bn bodyfrag.get_length()
        while bi < bn
        {
            sb.append(bodyfrag.get(bi) as char)
            set bi: bi + 1
        }
        sb.to_string()
    }

    ; Members of a class/union body -> concatenated scope/field records.
    function st_body(rp, source: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.st_member(source, m)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.to_string()
    }

    ; One class/union member -> its scope/field records.
    function st_member(rp, source: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.st_target(source, f.start, f.end, f.target)
            when pr: ProcedureSyntax
                return symbols.st_target(source, pr.start, pr.end, pr.target)
            when o: OperatorSyntax
                return symbols.st_target(source, o.start, o.end, o.target)
            when ini: InitSyntax
                return symbols.st_init(source, ini.start, ini.end, ini.parameters)
            when dei: DeInitSyntax
                return ""
            when def: DefinitionSyntax
                return symbols.st_definition(source, def)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return ""
    }

    ; Nested declarations of a namespace -> concatenated records.
    function st_namespace(rp, source: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let frag symbols.st_decl(source, d)
                    var ci: size_t 0
                    let cn frag.get_length()
                    while ci < cn
                    {
                        sb.append(frag.get(ci) as char)
                        set ci: ci + 1
                    }
                }
                set i: i + 1
            }
        }
        sb.to_string()
    }

    ; A union -> its body members' records (variants carry no params/fields).
    function st_union(rp, source: String, un: UnionSyntax) returns String
    {
        var result ""
        if un.body <> null
            set result: symbols.st_body(source, un.body)
        result
    }

    ; Build the whole scope/field table from one parse of the program.
    function scope_table(rp, source: String) returns String
    {
        var sb StringBuilder()
        var p parser.Parser(source)
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let frag symbols.st_decl(source, d)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        sb.to_string()
    }

    ; True when the token source[tstart,tend) names a parameter of the INNERMOST
    ; routine whose [start,end) byte range contains `offset`. Innermost = the
    ; containing P record with the greatest start (nested routines start later).
    function param_in_scope(table: String, source: String, tstart: size_t, tend: size_t, offset: size_t) returns bool
    {
        let tlen tend - tstart
        let n table.get_length()
        var i: size_t 0
        var found false
        var best_start: size_t 0
        var best_name_start: size_t 0
        var best_name_end: size_t 0
        while i < n
        {
            let tag table.get i
            if tag = 0x50
            {
                set i: i + 2            ; skip 'P' + tab
                var rstart: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x09
                        break
                    set rstart: rstart * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1            ; skip tab
                var rend: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x09
                        break
                    set rend: rend * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1            ; skip tab
                let name_start i
                while i < n
                {
                    if table.get(i) = 0x0A
                        break
                    set i: i + 1
                }
                let name_end i
                set i: i + 1            ; skip newline
                if offset >= rstart
                {
                    if offset < rend
                    {
                        var take false
                        if found = false
                            set take: true
                        if rstart >= best_start
                            set take: true
                        if take
                        {
                            set found: true
                            set best_start: rstart
                            set best_name_start: name_start
                            set best_name_end: name_end
                        }
                    }
                }
                continue
            }
            ; other (F) record: skip to end of line
            while i < n
            {
                if table.get(i) = 0x0A
                    break
                set i: i + 1
            }
            set i: i + 1
        }
        if found
        {
            var k best_name_start
            while k < best_name_end
            {
                if table.get(k) = 0x20
                {
                    set k: k + 1
                    continue
                }
                var j k
                while j < best_name_end
                {
                    if table.get(j) = 0x20
                        break
                    set j: j + 1
                }
                if (j - k) = tlen
                    if symbols.range_equals(table, k, source, tstart, tlen)
                        return true
                set k: j
            }
        }
        false
    }

    ; The innermost routine [start,end) whose range contains `offset`, packed as
    ; "<start> <end>", or "" when the offset is in no routine. Innermost = the R
    ; record with the greatest start among those containing the offset (a nested
    ; routine starts later than its enclosing one). Used by the scope-aware
    ; references/rename/highlight scan to confine a local/parameter to its
    ; declaring routine.
    function enclosing_routine(rp, table: String, offset: size_t) returns String
    {
        let n table.get_length()
        var i: size_t 0
        var found false
        var best_start: size_t 0
        var best_end: size_t 0
        while i < n
        {
            let tag table.get i
            if tag = 0x52                ; R
            {
                set i: i + 2            ; skip 'R' + tab
                var rstart: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x09
                        break
                    set rstart: rstart * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1            ; skip tab
                var rend: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x0A
                        break
                    set rend: rend * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1            ; skip newline
                if offset >= rstart
                    if offset < rend
                    {
                        var take false
                        if found = false
                            set take: true
                        if rstart >= best_start
                            set take: true
                        if take
                        {
                            set found: true
                            set best_start: rstart
                            set best_end: rend
                        }
                    }
                continue
            }
            ; other record: skip to end of line
            while i < n
            {
                if table.get(i) = 0x0A
                    break
                set i: i + 1
            }
            set i: i + 1
        }
        if found
        {
            var sb StringBuilder()
            sb.append(json.format_i64(best_start as i64))
            sb.append(" " as char)
            sb.append(json.format_i64(best_end as i64))
            return sb.to_string()
        }
        ""
    }

    ; True when `off` is the start offset of a declared field/property name.
    function is_field_decl_offset(table: String, off: size_t) returns bool
    {
        let n table.get_length()
        var i: size_t 0
        while i < n
        {
            let tag table.get i
            if tag = 0x46
            {
                set i: i + 2            ; skip 'F' + tab
                var roff: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x0A
                        break
                    set roff: roff * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1            ; skip newline
                if roff = off
                    return true
                continue
            }
            ; other (P) record: skip to end of line
            while i < n
            {
                if table.get(i) = 0x0A
                    break
                set i: i + 1
            }
            set i: i + 1
        }
        false
    }

    ; ====================================================================
    ; textDocument/completion (parse-only)
    ;
    ; Collect every declared name in the file — top-level functions /
    ; procedures / operators / types / mutables, plus the members of structs,
    ; namespaces and unions — into a flat LSP CompletionItem[] array. The
    ; editor does the prefix filtering, so the cursor position is not used (a
    ; future member-after-`.` mode would need type resolution). The result is
    ; the bare JSON array `[ <item>... ]`; the server wraps it in a Response.
    ;
    ; Each <item>: {"label":<name>,"kind":<int>}. LSP CompletionItemKind ints
    ; (DISTINCT from documentSymbol's SymbolKind ints):
    ;   Method=2 Function=3 Constructor=4 Variable=6 Module=9 Enum=13
    ;   EnumMember=20 Constant=21 Struct=22 Operator=24
    ;
    ; Same parse-tree walk as documentSymbol, but flattened: each helper
    ; returns a COMMA-JOINED FRAGMENT of items (no surrounding brackets, no
    ; leading/trailing comma), and callers join non-empty fragments with a
    ; single comma. Items are small, but the whole array can be large (a big
    ; file has hundreds of names), so fragments are appended ONE BYTE AT A TIME
    ; — the same large-append hazard documented in the STRING/JSON NOTE.
    ; ====================================================================

    function completion_items(rp, source: String) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)

        var p parser.Parser(source)
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var first true
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let frag symbols.completion_decl(source, d)
                            if frag.get_length() > 0
                            {
                                if first = false
                                    sb.append("," as char)
                                var ci: size_t 0
                                let cn frag.get_length()
                                while ci < cn
                                {
                                    sb.append(frag.get(ci) as char)
                                    set ci: ci + 1
                                }
                                set first: false
                            }
                        }
                        set i: i + 1
                    }
                }
            }

        sb.append("]" as char)
        sb.to_string()
    }

    ; A {"label":<name>,"kind":<int>} item. Small -> plain append is fine.
    function completion_item(rp, name: String, kind: i64) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(name))
        sb.append("," as char)
        sb.append(symbols.key("kind"))
        sb.append(json.format_i64(kind))
        sb.append("}" as char)
        sb.to_string()
    }

    ; One top-level declaration -> a fragment (its own item, plus the members
    ; of a definition). "" for use/package/empty/trait/macro.
    function completion_decl(rp, source: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.completion_item(symbols.target_name(f.target), 3)
            when pr: ProcedureSyntax
                return symbols.completion_item(symbols.target_name(pr.target), 3)
            when o: OperatorSyntax
                return symbols.completion_item(symbols.target_name(o.target), 24)
            when def: DefinitionSyntax
                return symbols.completion_definition(source, def)
            when m: ModuleSyntax
                return symbols.completion_item(m.name, 9)
            when mut: MutableSyntax
                return symbols.completion_item(mut.binding.name, 6)
            when sh: SharedSyntax
                return symbols.completion_item(sh.binding.name, 6)
            when priv: PrivateSyntax
                return symbols.completion_export(source, priv.export_)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function completion_export(rp, source: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.completion_item(symbols.target_name(f.target), 3)
            when pr: ProcedureSyntax
                return symbols.completion_item(symbols.target_name(pr.target), 3)
            when o: OperatorSyntax
                return symbols.completion_item(symbols.target_name(o.target), 24)
            when def: DefinitionSyntax
                return symbols.completion_definition(source, def)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.completion_item(m.name, 9)
    }

    ; A `define X` -> the type's name item followed by its members' items.
    function completion_definition(rp, source: String, def: DefinitionSyntax) returns String
    {
        var kind: i64 (22 as i64)
        var members ""
        choose def.concept_
            when c: ClassSyntax
            {
                set kind: 22
                set members: symbols.completion_body(source, c.body)
            }
            when n: NamespaceSyntax
            {
                set kind: 9
                set members: symbols.completion_namespace(source, n)
            }
            when un: UnionSyntax
            {
                set kind: 13
                set members: symbols.completion_union(source, un)
            }
            when cn: ConstantSyntax
                set kind: 21
            when dl: DelegateSyntax
                set kind: 3
            when ic: IntrinsicSyntax
                set kind: 22

        let name_item symbols.completion_item(def.name, kind)
        var sb StringBuilder()
        var ai: size_t 0
        let an name_item.get_length()
        while ai < an
        {
            sb.append(name_item.get(ai) as char)
            set ai: ai + 1
        }
        if members.get_length() > 0
        {
            sb.append("," as char)
            var mi: size_t 0
            let mn members.get_length()
            while mi < mn
            {
                sb.append(members.get(mi) as char)
                set mi: mi + 1
            }
        }
        sb.to_string()
    }

    ; Members of a class body -> a comma-joined fragment (no brackets).
    function completion_body(rp, source: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        var first true
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.completion_member(source, m)
                        if frag.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.to_string()
    }

    ; One class/union member -> an item, or "" / a nested fragment.
    function completion_member(rp, source: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.completion_item(symbols.target_name(f.target), 2)
            when pr: ProcedureSyntax
                return symbols.completion_item(symbols.target_name(pr.target), 2)
            when o: OperatorSyntax
                return symbols.completion_item(symbols.target_name(o.target), 24)
            when ini: InitSyntax
                return symbols.completion_item("init", 4)
            when dei: DeInitSyntax
                return symbols.completion_item("deinit", 4)
            when def: DefinitionSyntax
                return symbols.completion_definition(source, def)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.completion_item(m.name, 9)
    }

    ; Nested declarations of a namespace -> a comma-joined fragment.
    function completion_namespace(rp, source: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        var first true
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let frag symbols.completion_decl(source, d)
                    if frag.get_length() > 0
                    {
                        if first = false
                            sb.append("," as char)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set i: i + 1
            }
        }
        sb.to_string()
    }

    ; Variants (EnumMember) + body members of a union -> a comma-joined
    ; fragment.
    function completion_union(rp, source: String, un: UnionSyntax) returns String
    {
        var sb StringBuilder()
        var first true
        if un.variants <> null
        {
            let variants (*un.variants)
            var i: size_t 0
            while i < variants.length
            {
                let vptr variants.get i
                if vptr <> null
                {
                    let vitem symbols.completion_item(vptr.name, 20)
                    if first = false
                        sb.append("," as char)
                    var ci: size_t 0
                    let cn vitem.get_length()
                    while ci < cn
                    {
                        sb.append(vitem.get(ci) as char)
                        set ci: ci + 1
                    }
                    set first: false
                }
                set i: i + 1
            }
        }
        if un.body <> null
        {
            let b (*un.body)
            if b.members <> null
            {
                let members (*b.members)
                var j: size_t 0
                while j < members.length
                {
                    let mptr members.get j
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.completion_member(source, m)
                        if frag.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                    set j: j + 1
                }
            }
        }
        sb.to_string()
    }

    ; ====================================================================
    ; Context-aware completion (member-after-`.`, lexical)
    ;
    ; When a `.` precedes the cursor, offer ONLY the members of the receiver
    ; whose name immediately precedes the dot — but only when that name is a
    ; declared struct / namespace / union in this file (a LEXICAL match on the
    ; receiver token, not a type resolution of an arbitrary expression). So
    ; `Point.` / `json.` / `Shape.` complete to that concept's members; an
    ; unknown receiver (a variable like `sb.`, which needs the planner to type)
    ; or no dot at all falls back to the flat all-names list (completion_items#).
    ; The cursor arrives as a packed "<line> <char>" (same as hover).
    ; ====================================================================

    ; Decide member-context vs flat completion from the packed cursor position.
    function completion_packed(rp, source: String, uri: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)

        ; Case 0: a multi-segment field-access chain `a.b.c.` — resolve the type
        ; of the chain by following each field/method through the type graph,
        ; then list the final type's members. Falls back to flat on any
        ; unresolved step.
        let chain symbols.receiver_chain_before_cursor(source, offset)
        if chain.get_length() > 0
            if symbols.has_dot(chain)
            {
                let ctype symbols.resolve_chain_type(source, uri, chain)
                if ctype.get_length() > 0
                {
                    let cmem symbols.members_for_type(source, uri, ctype)
                    if cmem.get_length() > 0
                        return cmem
                }
                return symbols.completion_items source
            }

        let receiver symbols.receiver_before_cursor(source, offset)
        if receiver.get_length() > 0
        {
            ; Case 1: the receiver token itself names a declared concept in this
            ; file (Type. / namespace. / union.) -> that concept's members.
            let direct symbols.member_completions(source, receiver)
            if direct.get_length() > 0
                return direct
            ; Case 2 (semantic): PREFER the planner-resolved receiver type — it
            ; handles reassigned / call-bound / generic receivers the lexical
            ; resolve_variable_type# below cannot. Query the type at a use of the
            ; receiver token; on a hit, list that concept's members. Falls
            ; through to the lexical cases on a miss / parse error (common while
            ; the buffer is mid-edit at `receiver.`).
            let recv_off symbols.receiver_last_offset(source, offset)
            if recv_off < source.get_length()
            {
                let stype semantic.receiver_type_at_offset(source, uri, recv_off)
                if stype.get_length() > 0
                {
                    let sbase symbols.simple_base_name stype
                    let smem symbols.members_for_type(source, uri, sbase)
                    if smem.get_length() > 0
                        return smem
                }
            }
            ; Case 2 (lexical): resolve the receiver's declared type lexically,
            ; then list that type's members (this file first, then sibling
            ; .scaly files in the dir tree).
            let tname symbols.resolve_variable_type(source, receiver)
            if tname.get_length() > 0
            {
                let mem symbols.members_for_type(source, uri, tname)
                if mem.get_length() > 0
                    return mem
                ; The receiver was bound from a CALL (`let r foo(x)`): the lexical
                ; resolver returns the callee name, which is a function, not a
                ; concept. Use the function's declared return type instead.
                let rt symbols.function_return_type_ws(source, uri, tname)
                if rt.get_length() > 0
                {
                    let rmem symbols.members_for_type(source, uri, rt)
                    if rmem.get_length() > 0
                        return rmem
                }
            }
            ; Case 3: the receiver names a concept defined in ANOTHER file or a
            ; dependency package (e.g. `String.` / `Vector.` from the stdlib).
            ; Search the dir tree then the package tree.
            let xpkg symbols.member_completions_in_workspace(uri, receiver)
            if xpkg.get_length() > 0
                return xpkg
        }
        symbols.completion_items source
    }

    ; Members of the concept named `type_name`: this file first, then sibling
    ; .scaly files under the current file's directory tree (cross-file). ""
    ; when no such concept is found anywhere.
    function members_for_type(rp, source: String, uri: String, type_name: String) returns String
    {
        let here symbols.member_completions(source, type_name)
        if here.get_length() > 0
            return here
        symbols.member_completions_in_workspace(uri, type_name)
    }

    ; Enumerate sibling .scaly files (skipping the current one) and return the
    ; members of the first concept named `type_name`, mirroring
    ; find_definition_in_workspace#: the current file's directory tree first,
    ; then ON A MISS the package dependency tree (so stdlib String/StringBuilder/
    ; Vector members complete). "" if none.
    function member_completions_in_workspace(rp, uri: String, type_name: String) returns String
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let here symbols.member_completions_in_dir(dir, path, type_name)
        if here.get_length() > 0
            return here
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.member_completions_in_dir(pkg, path, type_name)
        ""
    }

    ; Enumerate the .scaly files under `dir` (recursively, skipping self_path)
    ; and return the members of the first concept named `type_name`. "" if none.
    ;
    ; Step 29 follow-up: query the persistent symindex instead of re-parsing each
    ; file with member_completions#. Each cached ws record carries an "M"-tagged
    ; detail field = the concept's bracketless member-completion fragment, so the
    ; member list is rebuilt from the cache (members_from_ws_blob#) — no re-parse,
    ; shared with workspace/symbol + cross-file definition + semanticTokens.
    function member_completions_in_dir(rp, dir: String, self_path: String, type_name: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir   ; abs paths, each + LF

        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                set result: symbols.members_from_ws_blob(blob, type_name)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; Lexically resolve the declared type name of the variable `receiver` (the
    ; base concept name, generics stripped). Recognises two declaration shapes,
    ; first occurrence in the file winning (no scope/shadow tracking):
    ;   - colon form:  `var receiver: TYPE` / `let receiver: TYPE` / param
    ;     `receiver: TYPE`  -> the identifier after the `:`.
    ;   - constructor form: `var receiver TYPE$(...)` / `let receiver TYPE(...)`
    ;     (a lifetime sigil $/#/^ or `[`/`(` right after TYPE) -> TYPE.
    ; "" when no such declaration is found (e.g. `let r compute(x)` with no
    ; sigil, or an undeclared name) -> caller falls back to the flat list.
    function resolve_variable_type(rp, source: String, receiver: String) returns String
    {
        let len source.get_length()
        var prev_start: size_t 0       ; previous identifier token span
        var prev_end: size_t 0
        var have_prev: size_t 0        ; 1 once a prev identifier token is seen
        var prev_punct: size_t 0       ; last significant punctuation: ( , or 0
        var result ""
        var k: size_t 0
        while k < len
        {
            if result.get_length() <> 0
                break
            let c source.get k
            if symbols.is_ident_byte(c) = false
            {
                if c = 0x28
                    set prev_punct: c as size_t
                if c = 0x2C
                    set prev_punct: c as size_t
                if c <> 0x20
                    if c <> 0x09
                        if c <> 0x28
                            if c <> 0x2C
                                set prev_punct: 0
                set k: k + 1
            }
            if symbols.is_ident_byte(c)
            {
                var j k
                while j < len
                {
                    if symbols.is_ident_byte(source.get j) = false
                        break
                    set j: j + 1
                }
                if symbols.token_equals(source, k, j, receiver)
                    set result: symbols.type_after_decl(source, j, len, prev_start, prev_end, have_prev, prev_punct)
                set prev_start: k
                set prev_end: j
                set have_prev: 1
                set prev_punct: 0
                set k: j
            }
        }
        result
    }

    ; Given the receiver token ending at `recv_end` and its left context (the
    ; previous identifier token + last punctuation), return the declared type
    ; name, or "" when this isn't a declaration of the receiver.
    function type_after_decl(rp, source: String, recv_end: size_t, len: size_t, prev_start: size_t, prev_end: size_t, have_prev: size_t, prev_punct: size_t) returns String
    {
        let after symbols.skip_ws(source, recv_end, len)

        ; Is the previous identifier token the keyword `var` or `let`? The
        ; keyword literals are bound to locals first: a bare string literal
        ; passed straight to the non-`#` token_equals has no page and crashes.
        var is_binding: bool false
        if have_prev <> 0
        {
            let kw_var "var"
            let kw_let "let"
            if symbols.token_equals(source, prev_start, prev_end, kw_var)
                set is_binding: true
            if symbols.token_equals(source, prev_start, prev_end, kw_let)
                set is_binding: true
        }
        ; A parameter context: the receiver is preceded by `(` or `,`.
        var is_param: bool false
        if prev_punct = 0x28
            set is_param: true
        if prev_punct = 0x2C
            set is_param: true

        ; Colon form: `receiver : TYPE` (annotated binding or parameter) -> the
        ; identifier after the `:`.
        if after < len
            if source.get(after) = 0x3A
            {
                var colon_ok: bool false
                if is_binding
                    set colon_ok: true
                if is_param
                    set colon_ok: true
                if colon_ok
                {
                    let tstart symbols.skip_ws(source, after + 1, len)
                    return symbols.read_type_name(source, tstart, len)
                }
            }

        ; Constructor form: `var/let receiver TYPE<sigil>` -> TYPE.
        if is_binding
            if after < len
                if symbols.is_ident_byte(source.get after)
                {
                    var te after
                    while te < len
                    {
                        if symbols.is_ident_byte(source.get te) = false
                            break
                        set te: te + 1
                    }
                    if te < len
                        if symbols.is_ctor_sigil(source.get te)
                            return symbols.substring(source, after, te)
                }
        ""
    }

    ; First index at or after `pos` that is not a space or tab.
    function skip_ws(source: String, pos: size_t, len: size_t) returns size_t
    {
        var p pos
        while p < len
        {
            let c source.get p
            if c <> 0x20
                if c <> 0x09
                    break
            set p: p + 1
        }
        p
    }

    ; A constructor follows a type name when the next byte is a lifetime sigil
    ; ($ # ^) or a `[` (generics) / `(` (call). `(` is permissive: a false
    ; positive resolves a non-existent concept and harmlessly falls back.
    function is_ctor_sigil(c: u8) returns bool
    {
        if c = 0x24
            return true                            ; $
        if c = 0x23
            return true                            ; #
        if c = 0x5E
            return true                            ; ^
        if c = 0x5B
            return true                            ; [
        if c = 0x28
            return true                            ; (
        false
    }

    ; Read the leading identifier at `start` (stops at the first non-ident byte,
    ; so a generic `Vector[char]` yields the base `Vector`). "" if none.
    function read_type_name(rp, source: String, start: size_t, len: size_t) returns String
    {
        if start < len
            if symbols.is_ident_byte(source.get start)
            {
                var e start
                while e < len
                {
                    if symbols.is_ident_byte(source.get e) = false
                        break
                    set e: e + 1
                }
                return symbols.substring(source, start, e)
            }
        ""
    }

    ; ====================================================================
    ; Type-graph resolution (field-access chains + call-result return types)
    ;
    ; The single-identifier receiver resolver above (resolve_variable_type#)
    ; handles `v.` where `v` is a variable of a constructor/annotated type. The
    ; helpers below extend that to the cases it can't reach by following the
    ; declared types through the parse tree:
    ;   - field-access chains `a.b.c.` — resolve `a`'s type, look up field `b`'s
    ;     type in that concept, then field `c`'s type, and list `c`'s members.
    ;   - call results `let r foo(x); r.` — `foo` is a function, not a concept,
    ;     so use its declared RETURN type.
    ; This is genuine type resolution through the declared type graph (not full
    ; Hindley-Milner inference): a field/return type is taken as its base concept
    ; name. LIMITS: a generic / pointer / ref field type resolves to the wrapper
    ; base (`pointer`/`ref`/`Vector`), not the inner element type; intermediate
    ; method-CALLS in a chain (`a.f().b`) are not followed (the `(` stops the
    ; chain capture); first-declaration-wins, no scope/shadow/generic-substitution.
    ; ====================================================================

    ; The base concept name of a TypeSyntax (its NameSyntax base, generics and
    ; dotted extensions dropped) — e.g. `Vector` from `Vector[char]`.
    function type_base_name(rp, ty: TypeSyntax) returns String
    {
        let nms ty.name
        String(nms.name)
    }

    ; The base name of a routine's declared return type, or "" when it returns
    ; nothing.
    function routine_return_base(rp, routine: RoutineSyntax) returns String
    {
        if routine.returns_ <> null
        {
            let rs (*routine.returns_)
            return symbols.type_base_name(rs.type)
        }
        ""
    }

    ; If `target` is a routine NAMED `name`, its return-type base name, else "".
    function target_return_type(rp, source: String, target: TargetSyntax, name: String) returns String
    {
        choose target
            when named: NamedSyntax
            {
                if named.name = name
                    return symbols.routine_return_base(named.routine)
                return ""
            }
            when r: RoutineSyntax
                return ""
    }

    ; The type (base concept name) of member `member_name` of concept
    ; `type_name`, searching THIS source only: a field/property's declared type,
    ; or a method's return type. "" when the concept or member is not found here.
    function member_type(rp, source: String, type_name: String, member_name: String) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.mt_decl(source, d, type_name, member_name)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    function mt_decl(rp, source: String, decl: DeclarationSyntax, type_name: String, member_name: String) returns String
    {
        choose decl
            when def: DefinitionSyntax
                return symbols.mt_definition(source, def, type_name, member_name)
            when priv: PrivateSyntax
                return symbols.mt_export(source, priv.export_, type_name, member_name)
            else
                return ""
    }

    function mt_export(rp, source: String, export_: ExportSyntax, type_name: String, member_name: String) returns String
    {
        choose export_
            when def: DefinitionSyntax
                return symbols.mt_definition(source, def, type_name, member_name)
            else
                return ""
    }

    ; The concept named `type_name`: look up `member_name` in its fields/methods.
    ; Otherwise recurse into a namespace's nested declarations.
    function mt_definition(rp, source: String, def: DefinitionSyntax, type_name: String, member_name: String) returns String
    {
        if def.name = type_name
        {
            var t ""
            choose def.concept_
                when c: ClassSyntax
                    set t: symbols.mt_in_class(source, c, member_name)
                else
                    0
            return t
        }
        var nested ""
        choose def.concept_
            when n: NamespaceSyntax
                set nested: symbols.mt_namespace(source, n, type_name, member_name)
            else
                0
        nested
    }

    function mt_namespace(rp, source: String, ns: NamespaceSyntax, type_name: String, member_name: String) returns String
    {
        var result ""
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                if result.get_length() = 0
                {
                    let dptr decls.get i
                    if dptr <> null
                    {
                        let d (*dptr)
                        set result: symbols.mt_decl(source, d, type_name, member_name)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    ; Look up `member_name` in a class: its structure fields first, then its
    ; method bodies' return types. "" when absent.
    function mt_in_class(rp, source: String, c: ClassSyntax, member_name: String) returns String
    {
        var result ""
        if c.structure.parts <> null
        {
            let parts (*c.structure.parts)
            var i: size_t 0
            while i < parts.length
            {
                if result.get_length() = 0
                {
                    let pp parts.get i
                    if pp <> null
                    {
                        let part (*pp)
                        set result: symbols.mt_part(source, part, member_name)
                    }
                }
                set i: i + 1
            }
        }
        if result.get_length() > 0
            return result
        if c.body <> null
        {
            let b (*c.body)
            if b.members <> null
            {
                let members (*b.members)
                var j: size_t 0
                while j < members.length
                {
                    if result.get_length() = 0
                    {
                        let mp members.get j
                        if mp <> null
                        {
                            let m (*mp)
                            set result: symbols.mt_member_return(source, m, member_name)
                        }
                    }
                    set j: j + 1
                }
            }
        }
        result
    }

    ; A field/property part named `member_name` -> its declared type base, "".
    function mt_part(rp, source: String, part: PartSyntax, member_name: String) returns String
    {
        choose part
            when fld: FieldSyntax
            {
                if fld.property.name = member_name
                    return symbols.type_base_name(fld.property.annotation.type)
                return ""
            }
            when prop: PropertySyntax
            {
                if prop.name = member_name
                    return symbols.type_base_name(prop.annotation.type)
                return ""
            }
    }

    ; A class-body method named `member_name` -> its return-type base, "".
    function mt_member_return(rp, source: String, member: MemberSyntax, member_name: String) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.target_return_type(source, f.target, member_name)
            when pr: ProcedureSyntax
                return symbols.target_return_type(source, pr.target, member_name)
            else
                return ""
    }

    ; member_type# across the workspace: THIS source first, then the current
    ; file's directory tree, then the package tree (so stdlib field/method types
    ; resolve). "" when the concept/member is found nowhere.
    function member_type_ws(rp, source: String, uri: String, type_name: String, member_name: String) returns String
    {
        let here symbols.member_type(source, type_name, member_name)
        if here.get_length() > 0
            return here
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let in_dir symbols.member_type_in_dir(dir, path, type_name, member_name)
        if in_dir.get_length() > 0
            return in_dir
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.member_type_in_dir(pkg, path, type_name, member_name)
        ""
    }

    ; Step 33: read each sibling/package file's CACHED ws blob (symindex.valid →
    ; get_blob#, else workspace_symbols_in_file# + put) and resolve the member
    ; type from the concept record's 5th membertypes field via
    ; member_type_from_ws_blob# — no per-request, per-segment re-parse. Shared
    ; with workspace/symbol + def + sig + member-completion + type-hint +
    ; semanticTokens. Structured like return_type_in_dir#.
    function member_type_in_dir(rp, dir: String, self_path: String, type_name: String, member_name: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir
        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                set result: symbols.member_type_from_ws_blob(blob, type_name, member_name)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; The declared return-type base of a top-level (or namespace-nested)
    ; function/procedure named `fname`, searching THIS source only. "" when not
    ; found / no return type.
    function function_return_type(rp, source: String, fname: String) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.frt_decl(source, d, fname)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    function frt_decl(rp, source: String, decl: DeclarationSyntax, fname: String) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.target_return_type(source, f.target, fname)
            when pr: ProcedureSyntax
                return symbols.target_return_type(source, pr.target, fname)
            when def: DefinitionSyntax
                return symbols.frt_definition(source, def, fname)
            when priv: PrivateSyntax
                return symbols.frt_export(source, priv.export_, fname)
            else
                return ""
    }

    function frt_export(rp, source: String, export_: ExportSyntax, fname: String) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.target_return_type(source, f.target, fname)
            when pr: ProcedureSyntax
                return symbols.target_return_type(source, pr.target, fname)
            when def: DefinitionSyntax
                return symbols.frt_definition(source, def, fname)
            else
                return ""
    }

    function frt_definition(rp, source: String, def: DefinitionSyntax, fname: String) returns String
    {
        var result ""
        choose def.concept_
            when n: NamespaceSyntax
            {
                if n.declarations <> null
                {
                    let decls (*n.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.frt_decl(source, d, fname)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
            else
                0
        result
    }

    ; function_return_type# across the workspace: THIS source, then dir tree,
    ; then package tree. "" when found nowhere.
    function function_return_type_ws(rp, source: String, uri: String, fname: String) returns String
    {
        let here symbols.function_return_type(source, fname)
        if here.get_length() > 0
            return here
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let in_dir symbols.function_return_type_in_dir(dir, path, fname)
        if in_dir.get_length() > 0
            return in_dir
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.function_return_type_in_dir(pkg, path, fname)
        ""
    }

    function function_return_type_in_dir(rp, dir: String, self_path: String, fname: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir
        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                set result: symbols.function_return_type(fsrc, fname)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; True when `s` contains a `.` (a multi-segment receiver chain).
    function has_dot(s: String) returns bool
    {
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            if s.get(i) = 0x2E
                return true
            set i: i + 1
        }
        false
    }

    ; The full dotted receiver chain `a.b.c` to the left of `offset`, skipping
    ; the in-progress member word the cursor sits in. "" when there is no
    ; `.`-qualified receiver. Walks left over identifier bytes and dots from the
    ; dot before the cursor; stops at the first other byte (so `f().b` captures
    ; only `b`). Leading dots are trimmed.
    function receiver_chain_before_cursor(rp, source: String, offset: size_t) returns String
    {
        let len source.get_length()
        if len = 0
            return ""
        var p offset
        if p > len
            set p: len

        ; Skip back over the in-progress member word.
        while p > 0
        {
            if symbols.is_ident_byte(source.get(p - 1)) = false
                break
            set p: p - 1
        }

        if p > 0
            if source.get(p - 1) = 0x2E
            {
                let dot p - 1
                ; Walk left over [ident | '.'] to the chain start.
                var cstart dot
                while cstart > 0
                {
                    let cc source.get(cstart - 1)
                    if symbols.is_ident_byte(cc) = false
                        if cc <> 0x2E
                            break
                    set cstart: cstart - 1
                }
                ; Trim a leading dot (e.g. after `)` -> `.a.b`).
                if cstart < dot
                    if source.get(cstart) = 0x2E
                        set cstart: cstart + 1
                if cstart < dot
                    return symbols.substring(source, cstart, dot)
            }
        ""
    }

    ; Resolve the type (base concept name) of a multi-segment receiver chain
    ; `a.b.c`: resolve `a`'s declared type, then follow each subsequent segment
    ; as a field/method of the running type. "" when any step fails to resolve.
    function resolve_chain_type(rp, source: String, uri: String, chain: String) returns String
    {
        let n chain.get_length()
        var base ""
        var seg_start: size_t 0
        var seg_index: size_t 0
        var failed false
        var i: size_t 0
        while i <= n
        {
            var at_delim false
            if i = n
                set at_delim: true
            if i < n
                if chain.get(i) = 0x2E
                    set at_delim: true
            if at_delim
            {
                if failed = false
                {
                    let seg symbols.substring(chain, seg_start, i)
                    if seg.get_length() = 0
                        set failed: true
                    if seg.get_length() > 0
                    {
                        if seg_index = 0
                            set base: symbols.resolve_variable_type(source, seg)
                        if seg_index > 0
                            set base: symbols.member_type_ws(source, uri, base, seg)
                        if base.get_length() = 0
                            set failed: true
                    }
                    set seg_index: seg_index + 1
                }
                set seg_start: i + 1
            }
            set i: i + 1
        }
        if failed
            return ""
        base
    }

    ; The identifier token immediately before a `.` to the left of `offset`,
    ; skipping any in-progress member word the cursor sits in. "" when there is
    ; no `.`-qualified receiver (so the caller offers the flat list). E.g. for
    ; `Point.ge|`, `Point.|`, or `Point .|` returns "Point"; for `foo|`, `a + b`,
    ; or `).` returns "".
    function receiver_before_cursor(rp, source: String, offset: size_t) returns String
    {
        let len source.get_length()
        if len = 0
            return ""
        var p offset
        if p > len
            set p: len

        ; Skip back over the in-progress member word (identifier bytes left of
        ; the cursor), leaving p just after the dot (or unchanged).
        while p > 0
        {
            if symbols.is_ident_byte(source.get(p - 1)) = false
                break
            set p: p - 1
        }

        ; Require a `.` immediately to the left.
        if p > 0
            if source.get(p - 1) = 0x2E
            {
                let dot p - 1
                ; Walk back over the receiver identifier ending just before it.
                var r dot
                while r > 0
                {
                    if symbols.is_ident_byte(source.get(r - 1)) = false
                        break
                    set r: r - 1
                }
                if r < dot
                {
                    var sb StringBuilder()
                    var k r
                    while k < dot
                    {
                        sb.append(source.get(k) as char)
                        set k: k + 1
                    }
                    return sb.to_string()
                }
            }
        ""
    }

    ; The byte offset of the LAST character of the `.`-receiver token before
    ; the cursor (the same token receiver_before_cursor# returns), or `len`
    ; (the source length, a sentinel) when there is no such receiver. Used to
    ; query the semantic resolver at a use of the receiver variable.
    function receiver_last_offset(rp, source: String, offset: size_t) returns size_t
    {
        let len source.get_length()
        if len = 0
            return len
        var p offset
        if p > len
            set p: len
        while p > 0
        {
            if symbols.is_ident_byte(source.get(p - 1)) = false
                break
            set p: p - 1
        }
        if p > 0
            if source.get(p - 1) = 0x2E
            {
                let dot p - 1
                if dot > 0
                    if symbols.is_ident_byte(source.get(dot - 1))
                        return dot - 1
            }
        len
    }

    ; The base concept name of a possibly-qualified / generic type name:
    ; everything before the first `[` (generics) and after the last `.`
    ; (namespace). "scaly.containers.String" -> "String", "Vector[char]" ->
    ; "Vector". Used to look up the members of a semantically-resolved receiver.
    function simple_base_name(rp, name: String) returns String
    {
        let n name.get_length()
        var end n
        var i: size_t 0
        while i < end
        {
            if name.get(i) = 0x5B
                set end: i
            set i: i + 1
        }
        var start: size_t 0
        var j: size_t 0
        while j < end
        {
            if name.get(j) = 0x2E
                set start: j + 1
            set j: j + 1
        }
        name.substring(start, end - start)
    }

    ; Parse the program and return the member CompletionItem[] of the concept
    ; named `receiver` (found at top level or nested in a namespace), or "" when
    ; no such concept exists. A found concept with no members yields "[]" (a
    ; non-empty string), distinguishing it from the not-found "".
    function member_completions(rp, source: String, receiver: String) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.mem_decl(source, d, receiver)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    ; One top-level declaration: the members of `receiver` if this is (or
    ; nests) the matching definition, else "".
    function mem_decl(rp, source: String, decl: DeclarationSyntax, receiver: String) returns String
    {
        choose decl
            when f: FunctionSyntax
                return ""
            when pr: ProcedureSyntax
                return ""
            when o: OperatorSyntax
                return ""
            when def: DefinitionSyntax
                return symbols.mem_definition(source, def, receiver)
            when m: ModuleSyntax
                return ""
            when mut: MutableSyntax
                return ""
            when sh: SharedSyntax
                return ""
            when priv: PrivateSyntax
                return symbols.mem_export(source, priv.export_, receiver)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function mem_export(rp, source: String, export_: ExportSyntax, receiver: String) returns String
    {
        choose export_
            when f: FunctionSyntax
                return ""
            when pr: ProcedureSyntax
                return ""
            when o: OperatorSyntax
                return ""
            when def: DefinitionSyntax
                return symbols.mem_definition(source, def, receiver)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return ""
    }

    ; A `define X`: when its name equals `receiver`, return its members wrapped
    ; as a JSON array (Class -> methods, Namespace -> declarations, Union ->
    ; variants + body). Otherwise recurse into a namespace's nested
    ; declarations for a nested match. "" when neither matches.
    function mem_definition(rp, source: String, def: DefinitionSyntax, receiver: String) returns String
    {
        if def.name = receiver
        {
            var members ""
            choose def.concept_
                when c: ClassSyntax
                    set members: symbols.completion_body(source, c.body)
                when n: NamespaceSyntax
                    set members: symbols.completion_namespace(source, n)
                when un: UnionSyntax
                    set members: symbols.completion_union(source, un)
                else
                    0
            var sb StringBuilder()
            sb.append("[" as char)
            var ci: size_t 0
            let cn members.get_length()
            while ci < cn
            {
                sb.append(members.get(ci) as char)
                set ci: ci + 1
            }
            sb.append("]" as char)
            return sb.to_string()
        }
        var nested ""
        choose def.concept_
            when n: NamespaceSyntax
                set nested: symbols.mem_namespace(source, n, receiver)
            else
                0
        nested
    }

    ; Nested declarations of a namespace: first nested definition named
    ; `receiver`, else "".
    function mem_namespace(rp, source: String, ns: NamespaceSyntax, receiver: String) returns String
    {
        var result ""
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                if result.get_length() = 0
                {
                    let dptr decls.get i
                    if dptr <> null
                    {
                        let d (*dptr)
                        set result: symbols.mem_decl(source, d, receiver)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    ; ====================================================================
    ; textDocument/hover (parse-only)
    ;
    ; Find the innermost declaration whose [start,end) byte range contains
    ; the cursor and report its kind + name as a markdown code span. Reuses
    ; the same parse-tree walk as documentSymbol but returns a single hit.
    ; The cursor arrives as a 0-based (line, character); convert it to a byte
    ; offset with position_to_offset#. Hover text is short, so plain
    ; StringBuilder.append is fine here (the byte-at-a-time rule is only for
    ; potentially-large pieces — see the STRING/JSON NOTE).
    ; ====================================================================

    ; The request frame packs the position as "<line> <character>" (decimal,
    ; space-separated). Parse it, run the walk, and wrap the result in the LSP
    ; hover envelope. An empty walk result yields "" (server -> result:null).
    function hover_packed(rp, source: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let n packed.get_length()
        while i < n
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }
        symbols.hover_envelope(symbols.hover_at(source, line, character))
    }

    ; {"contents":{"kind":"markdown","value":<text>}}  or "" when text empty.
    function hover_envelope(rp, text: String) returns String
    {
        if text.get_length() = 0
            return ""
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("contents"))
        sb.append("{" as char)
        sb.append(symbols.key("kind"))
        sb.append(json.quote_string("markdown"))
        sb.append("," as char)
        sb.append(symbols.key("value"))
        sb.append(json.quote_string(text))
        sb.append("}" as char)
        sb.append("}" as char)
        sb.to_string()
    }

    ; 0-based (line, character) -> byte offset. Walks LFs to the line start,
    ; then advances `character` columns, clamping at the next LF / EOF.
    function position_to_offset(rp, source: String, line: size_t, character: size_t) returns size_t
    {
        let len source.get_length()
        var off: size_t 0
        var cur_line: size_t 0
        while cur_line < line
        {
            if off >= len
                return off
            let c source.get off
            set off: off + 1
            if c = ("\n" as char)
                set cur_line: cur_line + 1
        }
        var col: size_t 0
        while col < character
        {
            if off >= len
                return off
            let c source.get off
            if c = ("\n" as char)
                return off
            set off: off + 1
            set col: col + 1
        }
        off
    }

    ; Parse the program and return the hover text for the innermost top-level
    ; declaration containing `offset`, or "" on no match / parse error.
    function hover_at(rp, source: String, line: size_t, character: size_t) returns String
    {
        let offset symbols.position_to_offset(source, line, character)
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.hover_decl(source, d, offset)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    ; Hover text for one top-level declaration (recurses for the innermost).
    function hover_decl(rp, source: String, decl: DeclarationSyntax, offset: size_t) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.hover_leaf(f.start, f.end, offset, "function", symbols.target_name(f.target))
            when pr: ProcedureSyntax
                return symbols.hover_leaf(pr.start, pr.end, offset, "procedure", symbols.target_name(pr.target))
            when o: OperatorSyntax
                return symbols.hover_leaf(o.start, o.end, offset, "operator", symbols.target_name(o.target))
            when def: DefinitionSyntax
                return symbols.hover_definition(source, def, offset)
            when m: ModuleSyntax
                return symbols.hover_leaf(m.start, m.end, offset, "module", String(m.name))
            when mut: MutableSyntax
                return symbols.hover_leaf(mut.start, mut.end, offset, "mutable", String(mut.binding.name))
            when sh: SharedSyntax
                return symbols.hover_leaf(sh.start, sh.end, offset, "shared", String(sh.binding.name))
            when priv: PrivateSyntax
                return symbols.hover_export(source, priv.export_, offset)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function hover_export(rp, source: String, export_: ExportSyntax, offset: size_t) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.hover_leaf(f.start, f.end, offset, "function", symbols.target_name(f.target))
            when pr: ProcedureSyntax
                return symbols.hover_leaf(pr.start, pr.end, offset, "procedure", symbols.target_name(pr.target))
            when o: OperatorSyntax
                return symbols.hover_leaf(o.start, o.end, offset, "operator", symbols.target_name(o.target))
            when def: DefinitionSyntax
                return symbols.hover_definition(source, def, offset)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.hover_leaf(m.start, m.end, offset, "module", String(m.name))
    }

    ; A `define X`. Recurse into the body/members for the innermost match;
    ; otherwise report the concept itself (struct/namespace/union/…).
    function hover_definition(rp, source: String, def: DefinitionSyntax, offset: size_t) returns String
    {
        if offset >= def.start
        {
            if offset < def.end
            {
                var child ""
                choose def.concept_
                    when c: ClassSyntax
                        set child: symbols.hover_body(source, c.body, offset)
                    when n: NamespaceSyntax
                        set child: symbols.hover_namespace(source, n, offset)
                    when un: UnionSyntax
                        set child: symbols.hover_union(source, un, offset)
                    else
                        0
                if child.get_length() > 0
                    return child

                var kind "struct"
                choose def.concept_
                    when c2: ClassSyntax
                        set kind: "struct"
                    when n2: NamespaceSyntax
                        set kind: "namespace"
                    when un2: UnionSyntax
                        set kind: "union"
                    when cn2: ConstantSyntax
                        set kind: "constant"
                    when dl2: DelegateSyntax
                        set kind: "function"
                    when ic2: IntrinsicSyntax
                        set kind: "struct"
                var sb StringBuilder()
                sb.append kind
                sb.append(" " as char)
                sb.append def.name
                return sb.to_string()
            }
        }
        ""
    }

    ; Innermost-matching member of a class body, or "".
    function hover_body(rp, source: String, body: ref[BodySyntax]?, offset: size_t) returns String
    {
        var result ""
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    if result.get_length() = 0
                    {
                        let mptr members.get i
                        if mptr <> null
                        {
                            let m (*mptr)
                            set result: symbols.hover_member(source, m, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        result
    }

    ; Hover text for one class/union member (recurses into nested defines).
    function hover_member(rp, source: String, member: MemberSyntax, offset: size_t) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.hover_leaf(f.start, f.end, offset, "method", symbols.target_name(f.target))
            when pr: ProcedureSyntax
                return symbols.hover_leaf(pr.start, pr.end, offset, "method", symbols.target_name(pr.target))
            when o: OperatorSyntax
                return symbols.hover_leaf(o.start, o.end, offset, "operator", symbols.target_name(o.target))
            when ini: InitSyntax
                return symbols.hover_leaf(ini.start, ini.end, offset, "init", "init")
            when dei: DeInitSyntax
                return symbols.hover_leaf(dei.start, dei.end, offset, "deinit", "deinit")
            when def: DefinitionSyntax
                return symbols.hover_definition(source, def, offset)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.hover_leaf(m.start, m.end, offset, "module", String(m.name))
    }

    ; Innermost-matching nested declaration of a namespace, or "".
    function hover_namespace(rp, source: String, ns: NamespaceSyntax, offset: size_t) returns String
    {
        var result ""
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                if result.get_length() = 0
                {
                    let dptr decls.get i
                    if dptr <> null
                    {
                        let d (*dptr)
                        set result: symbols.hover_decl(source, d, offset)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    ; A union: each variant, then any body members.
    function hover_union(rp, source: String, un: UnionSyntax, offset: size_t) returns String
    {
        var result ""
        if un.variants <> null
        {
            let variants (*un.variants)
            var i: size_t 0
            while i < variants.length
            {
                if result.get_length() = 0
                {
                    let vptr variants.get i
                    if vptr <> null
                        set result: symbols.hover_leaf(vptr.start, vptr.end, offset, "case", String(vptr.name))
                }
                set i: i + 1
            }
        }
        if result.get_length() = 0
            if un.body <> null
                set result: symbols.hover_body(source, un.body, offset)
        result
    }

    ; `kind name` when start <= offset < end, else "".
    function hover_leaf(rp, start: size_t, end: size_t, offset: size_t, kind: pointer[const_char], name: String) returns String
    {
        if offset >= start
            if offset < end
            {
                var sb StringBuilder()
                sb.append kind
                sb.append(" " as char)
                sb.append name
                return sb.to_string()
            }
        ""
    }

    ; ====================================================================
    ; textDocument/definition (parse-only, single file)
    ;
    ; Extract the identifier under the cursor, then search this file's parse
    ; tree for a declaration with that exact name and return its LSP Location
    ; ({"uri":...,"range":...}). This is intra-file only: no cross-file or
    ; scope resolution, so it jumps to the FIRST declaration of that name in
    ; the document. An unknown / non-identifier cursor yields "" (the server
    ; maps "" to result:null).
    ;
    ; The walk mirrors the documentSymbol / hover walks 1:1 (same union-by-
    ; payload-type matching, same control-flow idioms), but matches by name
    ; instead of by cursor-offset containment.
    ; ====================================================================

    ; The request frame packs the position as "<line> <character>" (same as
    ; hover). Parse it, find the identifier at that offset, and resolve it to a
    ; Location, or "" when there is no identifier / no matching declaration.
    function definition_packed(rp, source: String, uri: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let n packed.get_length()
        while i < n
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)
        let name symbols.identifier_at(source, offset)
        if name.get_length() = 0
            return ""
        symbols.find_definition(source, uri, name)
    }

    ; Is byte `c` part of a normal (alphanumeric / underscore) identifier?
    function is_ident_byte(c: u8) returns bool
    {
        if c >= 0x30
            if c <= 0x39
                return true                        ; 0-9
        if c >= 0x41
            if c <= 0x5A
                return true                        ; A-Z
        if c >= 0x61
            if c <= 0x7A
                return true                        ; a-z
        if c = 0x5F
            return true                            ; _
        false
    }

    ; The maximal identifier run covering `offset`, or "" if the cursor is not
    ; on (or just past) an identifier. Anchors on the byte at `offset`, else
    ; the byte before it (cursor sitting just after the name), then expands.
    function identifier_at(rp, source: String, offset: size_t) returns String
    {
        let len source.get_length()
        if len = 0
            return ""
        var off offset
        if off >= len
            set off: len - 1

        var anchor off
        if symbols.is_ident_byte(source.get off) = false
        {
            if off = 0
                return ""
            if symbols.is_ident_byte(source.get(off - 1)) = false
                return ""
            set anchor: off - 1
        }

        var start anchor
        while start > 0
        {
            if symbols.is_ident_byte(source.get(start - 1)) = false
                break
            set start: start - 1
        }
        var end anchor + 1
        while end < len
        {
            if symbols.is_ident_byte(source.get end) = false
                break
            set end: end + 1
        }

        var sb StringBuilder()
        var k start
        while k < end
        {
            sb.append(source.get(k) as char)
            set k: k + 1
        }
        sb.to_string()
    }

    ; Parse the program and return the Location of the first declaration named
    ; `name`, or "" on no match / parse error.
    function find_definition(rp, source: String, uri: String, name: String) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.def_decl(source, uri, d, name)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    ; One top-level declaration: a Location if it (or a nested member) is named
    ; `name`, else "".
    function def_decl(rp, source: String, uri: String, decl: DeclarationSyntax, name: String) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.def_match(source, uri, symbols.target_name(f.target), name, f.start)
            when pr: ProcedureSyntax
                return symbols.def_match(source, uri, symbols.target_name(pr.target), name, pr.start)
            when o: OperatorSyntax
                return symbols.def_match(source, uri, symbols.target_name(o.target), name, o.start)
            when def: DefinitionSyntax
                return symbols.def_definition(source, uri, def, name)
            when m: ModuleSyntax
                return symbols.def_module_match(source, uri, String(m.name), name, m.start)
            when mut: MutableSyntax
                return symbols.def_match(source, uri, String(mut.binding.name), name, mut.start)
            when sh: SharedSyntax
                return symbols.def_match(source, uri, String(sh.binding.name), name, sh.start)
            when priv: PrivateSyntax
                return symbols.def_export(source, uri, priv.export_, name)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function def_export(rp, source: String, uri: String, export_: ExportSyntax, name: String) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.def_match(source, uri, symbols.target_name(f.target), name, f.start)
            when pr: ProcedureSyntax
                return symbols.def_match(source, uri, symbols.target_name(pr.target), name, pr.start)
            when o: OperatorSyntax
                return symbols.def_match(source, uri, symbols.target_name(o.target), name, o.start)
            when def: DefinitionSyntax
                return symbols.def_definition(source, uri, def, name)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.def_module_match(source, uri, String(m.name), name, m.start)
    }

    ; A `define X`: try its members/variants first (innermost), then its own
    ; name.
    function def_definition(rp, source: String, uri: String, def: DefinitionSyntax, name: String) returns String
    {
        var child ""
        choose def.concept_
            when c: ClassSyntax
                set child: symbols.def_body(source, uri, c.body, name)
            when n: NamespaceSyntax
                set child: symbols.def_namespace(source, uri, n, name)
            when un: UnionSyntax
                set child: symbols.def_union(source, uri, un, name)
            else
                0
        if child.get_length() > 0
            return child
        symbols.def_match(source, uri, def.name, name, def.start)
    }

    ; Members of a class body.
    function def_body(rp, source: String, uri: String, body: ref[BodySyntax]?, name: String) returns String
    {
        var result ""
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    if result.get_length() = 0
                    {
                        let mptr members.get i
                        if mptr <> null
                        {
                            let m (*mptr)
                            set result: symbols.def_member(source, uri, m, name)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        result
    }

    ; One class/union member.
    function def_member(rp, source: String, uri: String, member: MemberSyntax, name: String) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.def_match(source, uri, symbols.target_name(f.target), name, f.start)
            when pr: ProcedureSyntax
                return symbols.def_match(source, uri, symbols.target_name(pr.target), name, pr.start)
            when o: OperatorSyntax
                return symbols.def_match(source, uri, symbols.target_name(o.target), name, o.start)
            when ini: InitSyntax
                return ""
            when dei: DeInitSyntax
                return ""
            when def: DefinitionSyntax
                return symbols.def_definition(source, uri, def, name)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.def_module_match(source, uri, String(m.name), name, m.start)
    }

    ; Nested declarations of a namespace.
    function def_namespace(rp, source: String, uri: String, ns: NamespaceSyntax, name: String) returns String
    {
        var result ""
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                if result.get_length() = 0
                {
                    let dptr decls.get i
                    if dptr <> null
                    {
                        let d (*dptr)
                        set result: symbols.def_decl(source, uri, d, name)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    ; Variants of a union, then any body members.
    function def_union(rp, source: String, uri: String, un: UnionSyntax, name: String) returns String
    {
        var result ""
        if un.variants <> null
        {
            let variants (*un.variants)
            var i: size_t 0
            while i < variants.length
            {
                if result.get_length() = 0
                {
                    let vptr variants.get i
                    if vptr <> null
                        set result: symbols.def_match(source, uri, String(vptr.name), name, vptr.start)
                }
                set i: i + 1
            }
        }
        if result.get_length() = 0
            if un.body <> null
                set result: symbols.def_body(source, uri, un.body, name)
        result
    }

    ; def_match# for a `module NAME` statement, which is a LOAD DIRECTIVE and not
    ; a definition of NAME — the concept lives in the file the module names. The
    ; hit is tagged with a leading "M" so definition_workspace_packed# can hold
    ; it back as a last resort and answer NAME's real declaration in that file
    ; first (def_in_module_file#). A plain Location always starts with "{", so the
    ; tag is unambiguous, and it never reaches the client
    ; (definition_workspace_packed# is the only exit and strips it).
    function def_module_match(rp, source: String, uri: String, candidate: String, name: String, start: size_t) returns String
    {
        if candidate = name
        {
            let loc symbols.location_object(source, uri, start)
            var sb StringBuilder()
            sb.append("M" as char)
            sb.append loc
            return sb.to_string()
        }
        ""
    }

    ; A Location pointing at `start` when `candidate` equals `name`, else "".
    function def_match(rp, source: String, uri: String, candidate: String, name: String, start: size_t) returns String
    {
        if candidate = name
            return symbols.location_object(source, uri, start)
        ""
    }

    ; LSP Location: {"uri":<uri>,"range":{...}} — a zero-width range at `start`
    ; (the declaration keyword), so the editor jumps there without selecting
    ; the whole declaration body.
    function location_object(rp, source: String, uri: String, start: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("uri"))
        sb.append(json.quote_string(uri))
        sb.append("," as char)
        sb.append(symbols.key("range"))
        sb.append(symbols.range_for(source, start, start))
        sb.append("}" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; Cross-file go-to-definition (workspace)
    ;
    ; definition_packed# above resolves the cursor identifier within the
    ; CURRENT file. When it finds nothing, fall back to a workspace search:
    ; enumerate the sibling .scaly files in the current file's directory (and
    ; subdirectories) and run the same name-matching parse-tree walk over each,
    ; returning the first match's Location (pointing at that other file). The
    ; current file's in-memory `source` is searched first (so unsaved edits
    ; win); other files are read from disk.
    ;
    ; File discovery shells out to `find` via popen — portable across macOS +
    ; Linux, and crash-isolated in the worker, so a discovery failure can only
    ; lose this one result. LIMITS (documented): searches the current file's
    ; directory tree only (not other packages); intra-package, lexical name
    ; match, first file wins on a name defined in several files; a single quote
    ; in the directory path breaks the `find` command (workspace paths rarely
    ; have one).
    ; ====================================================================

    ; Try the current file first; on a miss, search sibling files. `source` is
    ; the in-memory current-file text; `uri` is its file:// uri.
    function definition_workspace_packed(rp, source: String, uri: String, packed: String) returns String
    {
        ; An "M"-tagged intra-file hit is a `module NAME` statement, not a
        ; definition of NAME (def_module_match#) — containers.scaly declares
        ; `module Vector` and USES `Vector[int]` in the same file. Resolve the
        ; module to its own file below, keep the module line as a LAST RESORT,
        ; and strip the tag: this is the only exit toward the client.
        let here symbols.definition_packed(source, uri, packed)
        var here_module ""
        if here.get_length() > 0
        {
            if here.get(0) <> ("M" as char)
                return here
            set here_module: symbols.substring(here, 1, here.get_length())
        }

        ; Intra-file miss: re-derive the cursor identifier and search siblings.
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }
        let offset symbols.position_to_offset(source, line, character)
        let name symbols.identifier_at(source, offset)
        if name.get_length() = 0
            return here_module
        if here_module.get_length() > 0
        {
            let path symbols.uri_to_path uri
            let inmod symbols.def_in_module_file(path, name)
            if inmod.get_length() > 0
                return inmod
        }
        let ws symbols.find_definition_in_workspace(uri, name)
        if ws.get_length() > 0
            return ws
        here_module
    }

    ; Resolve `name` across the workspace: first the current file's directory
    ; tree (intra-package / project-local, fast), then — on a miss — the package
    ; dependency tree (stdlib + declared packages under <SCALY_HOME/>packages/),
    ; so symbols defined in packages/scaly etc. resolve cross-package. Returns a
    ; Location pointing at the matching file, or "".
    function find_definition_in_workspace(rp, uri: String, name: String) returns String
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let here symbols.find_definition_in_dir(dir, path, name)
        if here.get_length() > 0
            return here
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.find_definition_in_dir(pkg, path, name)
        ""
    }

    ; Enumerate the .scaly files under `dir` (recursively) and return the first
    ; one (other than `self_path`) declaring `name`, as a Location pointing at
    ; that file. "" if none / empty dir.
    ;
    ; Step 29: instead of re-parsing each file with find_definition# on every
    ; request, query the persistent symindex — the SAME content-hash-cached ws
    ; symbol blobs workspace/symbol and semanticTokens build (parse-once,
    ; shared). Each cached record carries a full SymbolInformation whose
    ; location object holds a SPAN range (uri + selecting range), so a cross-file
    ; definition is answered straight from a cached record (def_from_ws_blob#) —
    ; no re-parse, no new blob data. The first def-on-miss in a session warms the
    ; index; later def / workspace-symbol / semanticTokens requests reuse it.
    ; RANGE NOTE: the cached location's range is a SPAN (selects the decl), where
    ; the current-file path (definition_packed#) returns a zero-width range
    ; (jump-without-select). A span is valid LSP and nicer for cross-file (it's
    ; what workspace/symbol already ships) — kept intentionally.
    function find_definition_in_dir(rp, dir: String, self_path: String, name: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir   ; abs paths, each + LF

        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                        {
                            let blob symbols.blob_for_file fpath
                            if blob.get_length() > 0
                            {
                                set result: symbols.def_from_ws_blob(blob, name, false)
                                ; No definition, but a `module NAME` statement:
                                ; NAME's definitions live in the file that module
                                ; names, so resolve that ONE file (Modeler's own
                                ; rule, def_in_module_file#) and keep the module
                                ; line only as a last resort. Walking on instead
                                ; would be the expensive answer: `module NAME`
                                ; sits in the NAMESPACE file, which `find` lists
                                ; ahead of the whole subdirectory holding the
                                ; concepts, so a hit here must still terminate
                                ; the scan.
                                if result.get_length() = 0
                                {
                                    let m symbols.def_from_ws_blob(blob, name, true)
                                    if m.get_length() > 0
                                    {
                                        set result: symbols.def_in_module_file(fpath, name)
                                        if result.get_length() = 0
                                            set result: m
                                    }
                                }
                            }
                        }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; The content-hash-cached ws symbol blob of `fpath` — the SAME blob
    ; workspace/symbol and semanticTokens build (parse-once, shared), built and
    ; stored here on a cache miss. "" when the file does not exist.
    function blob_for_file(rp, fpath: String) returns String
    {
        if File.exists(fpath) = false
            return ""
        let fsrc File.read_to_string(fpath)
        let chash fsrc.hash()
        if symindex.valid(fpath, chash)
            return symindex.get_blob fpath
        let furi symbols.path_to_uri fpath
        let blob symbols.workspace_symbols_in_file(fsrc, furi)
        symindex.put(fpath, chash, blob)
        blob
    }

    ; The Location of `name`'s own declaration in the single file `fpath` (a
    ; `module NAME` statement there does NOT count — see def_from_ws_blob#), or
    ; "" when the file is absent or declares no such name.
    function def_in_file(rp, fpath: String, name: String) returns String
    {
        let blob symbols.blob_for_file fpath
        if blob.get_length() = 0
            return ""
        symbols.def_from_ws_blob(blob, name, false)
    }

    ; `decl_path` holds a `module NAME` statement, which says NAME's definitions
    ; live in a sibling FILE. Resolve that file the way the Modeler does
    ; (Modeler.handle_namespace#: a `module foo` inside `define <ns>` loads
    ; <dir>/<ns>/foo.scaly; a top-level one loads <dir>/foo.scaly) and answer
    ; NAME's declaration there. Both shapes are tried because scalyls sees only
    ; the file, not the enclosing namespace name — which throughout this tree IS
    ; the file's stem (containers.scaly / `define containers`). Two File.exists
    ; probes on a module hit, no directory walk.
    function def_in_module_file(rp, decl_path: String, name: String) returns String
    {
        let dir symbols.dir_of decl_path
        if dir.get_length() = 0
            return ""
        let stem symbols.file_stem decl_path
        let nested symbols.def_in_file(symbols.module_file_path(dir, stem, name), name)
        if nested.get_length() > 0
            return nested
        symbols.def_in_file(symbols.module_file_path(dir, "", name), name)
    }

    ; "<dir>/<mid>/<name>.scaly", or "<dir>/<name>.scaly" when `mid` is empty.
    function module_file_path(rp, dir: String, mid: String, name: String) returns String
    {
        var sb StringBuilder()
        sb.append dir
        sb.append("/" as char)
        if mid.get_length() > 0
        {
            sb.append mid
            sb.append("/" as char)
        }
        sb.append name
        sb.append ".scaly"
        sb.to_string()
    }

    ; The last component of `path` with a trailing ".scaly" removed.
    function file_stem(rp, path: String) returns String
    {
        let dir symbols.dir_of path
        var start: size_t 0
        if dir.get_length() > 0
            set start: dir.get_length() + 1
        var end path.get_length()
        if end >= start + 6
            if symbols.matches_at(path, end - 6, ".scaly")
                set end: end - 6
        symbols.substring(path, start, end)
    }

    ; The SymbolKind integer of one ws blob record, given the record's json part
    ; [json_start, rec_end) and the caller's prebuilt "\"kind\":" needle (built
    ; once per blob walk, not per record); `0 - 1` when the record carries none.
    ; The json is `{"name":<quoted>,"kind":N,"location":{...}}`, so the needle
    ; occurs exactly once — a quoted identifier cannot contain it.
    function ws_record_kind(blob: String, json_start: size_t, rec_end: size_t, kind_needle: String) returns i64
    {
        let kn kind_needle.get_length()
        var s json_start
        while s + kn <= rec_end
        {
            if symbols.matches_at(blob, s, kind_needle)
            {
                var j s + kn
                var v: i64 0
                while j < rec_end
                {
                    let c blob.get j
                    if c >= 0x30
                        if c <= 0x39
                        {
                            set v: v * 10 + ((c - 0x30) as i64)
                            set j: j + 1
                            continue
                        }
                    break
                }
                return v
            }
            set s: s + 1
        }
        0 - 1
    }

    ; Walk a cached ws symbol blob (records "name<TAB>{json}<LF>") and return the
    ; location object of the FIRST record whose name EXACTLY equals `name`, or "".
    ; Records are in declaration order, so the first exact match is the file's
    ; first declaration of `name` — matching find_definition#'s first-wins.
    ; EXACT byte match (NOT name_matches, which is case-insensitive SUBSTRING —
    ; wrong for a definition jump). The returned location object is the same
    ; {uri,range} shape find_definition# emits (range here is a SPAN). The
    ; location is the LAST field in each record's json, single-line; its value
    ; is extracted by finding the "location": needle and taking the balanced
    ; {...} after it (depth-tracked — the range nests {start{},end{}}).
    ;
    ; `modules_only` splits the walk in two, because a `module NAME` statement
    ; (SymbolKind 2) is a LOAD DIRECTIVE, not a definition of NAME: the concept
    ; lives in the file the module names, and `packages/scaly/.../containers.scaly`
    ; lists twenty of them ahead of every container's own file in `find` order.
    ; false = the definition pass (module records SKIPPED, so `define Array[T]`
    ; in containers/Array.scaly wins over `module Array`); true = the module pass
    ; (ONLY module records), which tells find_definition_in_dir# to resolve the
    ; named file (def_in_module_file#) and, failing that, to answer the module
    ; line — the only thing we know when nothing declares `name`.
    function def_from_ws_blob(rp, blob: String, name: String, modules_only: bool) returns String
    {
        var needle StringBuilder()
        needle.append("\"" as char)
        needle.append "location"
        needle.append("\"" as char)
        needle.append(":" as char)
        let loc_needle needle.to_string()
        let ln loc_needle.get_length()

        var knb StringBuilder()
        knb.append("\"" as char)
        knb.append "kind"
        knb.append("\"" as char)
        knb.append(":" as char)
        let kind_needle knb.to_string()

        let nm_len name.get_length()
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                ; name = [rec_start, tab)
                var tab rec_start
                while tab < i
                {
                    if blob.get(tab) = 9
                        break
                    set tab: tab + 1
                }
                ; exact name match
                if tab - rec_start = nm_len
                {
                    var matched true
                    var k: size_t 0
                    while k < nm_len
                    {
                        if blob.get(rec_start + k) <> name.get(k)
                        {
                            set matched: false
                            break
                        }
                        set k: k + 1
                    }
                    ; kind gate: the definition pass skips SymbolKind 2
                    ; (module), the fallback pass takes nothing else.
                    if matched
                    {
                        let kind symbols.ws_record_kind(blob, tab, i, kind_needle)
                        if modules_only
                            if kind <> 2
                                set matched: false
                        if modules_only = false
                            if kind = 2
                                set matched: false
                    }
                    if matched
                    {
                        ; find "location": in the json part [tab, i)
                        var s tab
                        while s + ln <= i
                        {
                            if symbols.matches_at(blob, s, loc_needle)
                            {
                                ; balanced {...} after the needle
                                var lstart s + ln
                                var j lstart
                                var depth: i64 0
                                while j < i
                                {
                                    let c blob.get j
                                    if c = 0x7B
                                        set depth: depth + 1
                                    if c = 0x7D
                                    {
                                        set depth: depth - 1
                                        if depth = 0
                                            return symbols.substring(blob, lstart, j + 1)
                                    }
                                    set j: j + 1
                                }
                            }
                            set s: s + 1
                        }
                    }
                }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        ""
    }

    ; Find the first record in a cached ws blob whose name EXACTLY equals `name`
    ; AND whose DETAIL field is tagged `tag` ('S'/'M'), and return "Y" + the
    ; payload after the tag byte; "" when there is no such record. The leading
    ; "Y" sentinel distinguishes a found-but-empty payload (a zero-arg routine's
    ; "S" detail / a fieldless concept's "M" detail) from a genuine miss.
    ; Records are `name<TAB>{json}<TAB>detail<LF>`: tab1 = name/json sep, tab2 =
    ; json/detail sep, detail = [tab2+1, i). A record whose detail is empty or a
    ; different tag is skipped (so a name shared by a routine and a type resolves
    ; to the right record for each query).
    function detail_payload(rp, blob: String, name: String, tag: u8) returns String
    {
        let nm_len name.get_length()
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                var tab1: size_t i
                var tab2: size_t i
                var tab3: size_t i
                var ntabs: size_t 0
                var t: size_t rec_start
                while t < i
                {
                    if blob.get(t) = 9
                    {
                        if ntabs = 0
                            set tab1: t
                        if ntabs = 1
                            set tab2: t
                        if ntabs = 2
                            set tab3: t
                        set ntabs: ntabs + 1
                    }
                    set t: t + 1
                }
                if ntabs >= 3
                    if tab1 - rec_start = nm_len
                    {
                        var matched true
                        var k: size_t 0
                        while k < nm_len
                        {
                            if blob.get(rec_start + k) <> name.get(k)
                            {
                                set matched: false
                                break
                            }
                            set k: k + 1
                        }
                        if matched
                        {
                            ; detail = [tab2+1, tab3) — bounded at the THIRD tab
                            ; (Step 32 added a 4th rettype field), NOT the LF, so
                            ; the rettype never bleeds into the "S"/"M" payload.
                            let dstart tab2 + 1
                            if dstart < tab3
                                if blob.get(dstart) = tag
                                {
                                    var sb StringBuilder()
                                    sb.append("Y" as char)    ; Y sentinel
                                    var d dstart + 1
                                    while d < tab3
                                    {
                                        sb.append(blob.get(d) as char)
                                        set d: d + 1
                                    }
                                    return sb.to_string()
                                }
                        }
                    }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        ""
    }

    ; Cross-file signatureHelp from a cached ws blob: the routine named `name`'s
    ; "S"-tagged detail (0x1F-joined param labels) rebuilt into a SignatureHelp
    ; via build_signature_from_labels#. "" on no match.
    function sig_from_ws_blob(rp, blob: String, name: String, active: size_t) returns String
    {
        let r symbols.detail_payload(blob, name, 0x53)
        if r.get_length() > 0
        {
            let labels symbols.substring(r, 1, r.get_length())
            return symbols.build_signature_from_labels(name, labels, active)
        }
        ""
    }

    ; Cross-file member completion from a cached ws blob: the concept named
    ; `name`'s "M"-tagged detail (bracketless completion items) wrapped in
    ; [...]. "" on no match (so the caller falls back), "[...]" / "[]" on a
    ; found concept (matching mem_definition#).
    function members_from_ws_blob(rp, blob: String, name: String) returns String
    {
        let r symbols.detail_payload(blob, name, 0x4D)
        if r.get_length() > 0
        {
            let frag symbols.substring(r, 1, r.get_length())
            var sb StringBuilder()
            sb.append("[" as char)
            var d: size_t 0
            let de frag.get_length()
            while d < de
            {
                sb.append(frag.get(d) as char)
                set d: d + 1
            }
            sb.append("]" as char)
            return sb.to_string()
        }
        ""
    }

    ; ====================================================================
    ; Cross-file type-hint inference from the cached ws blob (Step 32)
    ;
    ; inlayHint TYPE inference (infer_binding_type# / concept_or_return_type#)
    ; resolves "is NAME a concept?" and "what does routine NAME return?" — the
    ; two cross-file questions a binding initializer poses. Before Step 32 the
    ; intra-MISS fallback re-parsed each sibling/package file per request
    ; (members_for_type# / function_return_type_ws#). These readers answer both
    ; from the SAME content-hash-cached ws blobs the rest of the server shares
    ; (workspace/symbol + def + sig + member + semanticTokens) — no re-parse.
    ; The 4th rettype field that ws_item# now emits carries the routine return
    ; base; concept-ness is read from the json `"kind":` (23 struct / 10 enum).
    ; Both readers use EXACT name match (range_equals), NOT name_matches (the
    ; case-insensitive substring used by workspace/symbol filtering).
    ; ====================================================================

    ; The 4th (rettype) field of the FIRST record in `blob` whose name EXACTLY
    ; equals `name`, "" on no match (or a routine that returns nothing — same
    ; "" → no hint). Records are `name<TAB>{json}<TAB>detail<TAB>rettype<LF>`;
    ; rettype = [tab3+1, i). Mirrors def_from_ws_blob#'s exact-name walk.
    function return_type_from_ws_blob(rp, blob: String, name: String) returns String
    {
        let nm_len name.get_length()
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                var tab1: size_t i
                var tab3: size_t i
                var tab4: size_t i
                var ntabs: size_t 0
                var t: size_t rec_start
                while t < i
                {
                    if blob.get(t) = 9
                    {
                        if ntabs = 0
                            set tab1: t
                        if ntabs = 2
                            set tab3: t
                        if ntabs = 3
                            set tab4: t
                        set ntabs: ntabs + 1
                    }
                    set t: t + 1
                }
                ; rettype = [tab3+1, tab4) — bounded at the FOURTH tab (Step 33
                ; added a 5th membertypes field), NOT the LF.
                if ntabs >= 4
                    if tab1 - rec_start = nm_len
                        if symbols.range_equals(blob, rec_start, name, 0, nm_len)
                            return symbols.substring(blob, tab3 + 1, tab4)
                set rec_start: i + 1
            }
            set i: i + 1
        }
        ""
    }

    ; True when the FIRST record in `blob` whose name EXACTLY equals `name` is a
    ; concept — its json `"kind":` is 23 (struct) or 10 (enum/union). The first
    ; `"kind":` in a record is always the json's (it precedes the detail field's
    ; completion-item kinds), so the scan stops at it. Mirrors
    ; tagged_names_from_ws_blob#'s kind extraction + def_from_ws_blob#'s exact
    ; name match.
    function concept_in_ws_blob(rp, blob: String, name: String) returns bool
    {
        var needle StringBuilder()
        needle.append("\"" as char)
        needle.append "kind"
        needle.append("\"" as char)
        needle.append(":" as char)
        let kind_needle needle.to_string()
        let kn kind_needle.get_length()

        let nm_len name.get_length()
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                ; name = [rec_start, tab)
                var tab rec_start
                while tab < i
                {
                    if blob.get(tab) = 9
                        break
                    set tab: tab + 1
                }
                if tab - rec_start = nm_len
                    if symbols.range_equals(blob, rec_start, name, 0, nm_len)
                    {
                        ; first "kind": in [tab, i) is the json's
                        var kind: i64 (0 - 1)
                        var s tab
                        while s + kn <= i
                        {
                            if symbols.matches_at(blob, s, kind_needle)
                            {
                                var j s + kn
                                var v: i64 0
                                while j < i
                                {
                                    let c blob.get j
                                    if c >= 0x30
                                        if c <= 0x39
                                        {
                                            set v: v * 10 + ((c - 0x30) as i64)
                                            set j: j + 1
                                            continue
                                        }
                                    break
                                }
                                set kind: v
                                set s: i                   ; stop scanning
                            }
                            set s: s + 1
                        }
                        if kind = 23
                            return true
                        if kind = 10
                            return true
                        return false
                    }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        false
    }

    ; The type base of member `member_name` of the concept named `type_name`,
    ; read from the FIRST exact-name record's 5th (membertypes) field — the
    ; 0x1F-joined `name 0x1F type 0x1F ...` pairs concept_member_types# emits.
    ; "" when the concept is found but the member isn't, OR the member's type is
    ; empty (a void method — no chainable type), OR no such concept. First
    ; concept wins (like def_from_ws_blob#). membertypes = [tab4+1, i).
    function member_type_from_ws_blob(rp, blob: String, type_name: String, member_name: String) returns String
    {
        let tn_len type_name.get_length()
        let mt_len member_name.get_length()
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                var tab1: size_t i
                var tab4: size_t i
                var ntabs: size_t 0
                var t: size_t rec_start
                while t < i
                {
                    if blob.get(t) = 9
                    {
                        if ntabs = 0
                            set tab1: t
                        if ntabs = 3
                            set tab4: t
                        set ntabs: ntabs + 1
                    }
                    set t: t + 1
                }
                if ntabs >= 4
                    if tab1 - rec_start = tn_len
                        if symbols.range_equals(blob, rec_start, type_name, 0, tn_len)
                        {
                            ; Walk the 0x1F-joined pairs in [tab4+1, i): even
                            ; tokens are member names, odd tokens their types.
                            var ps tab4 + 1
                            var seg_start ps
                            var expect_name true
                            var matched_name false
                            while ps <= i
                            {
                                var at_sep false
                                if ps = i
                                    set at_sep: true
                                if ps < i
                                    if blob.get(ps) = 0x1F
                                        set at_sep: true
                                if at_sep
                                {
                                    let is_name expect_name
                                    if is_name
                                    {
                                        set matched_name: false
                                        if ps - seg_start = mt_len
                                            if symbols.range_equals(blob, seg_start, member_name, 0, mt_len)
                                                set matched_name: true
                                    }
                                    if is_name = false
                                        if matched_name
                                            return symbols.substring(blob, seg_start, ps)
                                    set expect_name: is_name = false
                                    set seg_start: ps + 1
                                }
                                set ps: ps + 1
                            }
                            return ""        ; concept found, member not
                        }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        ""
    }

    ; Is there a concept named `name` anywhere in the workspace? Mirrors
    ; find_definition_in_workspace#: the current file's directory tree, then ON A
    ; MISS the package dependency tree. Reads CACHED ws blobs via the symindex.
    function concept_in_workspace(rp, uri: String, name: String) returns bool
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        if symbols.concept_in_dir(dir, path, name)
            return true
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.concept_in_dir(pkg, path, name)
        false
    }

    ; Scan the .scaly files under `dir` (skipping self_path) for a concept named
    ; `name`, reading each file's CACHED ws blob (symindex.valid → get_blob#,
    ; else workspace_symbols_in_file# + put). Structured exactly like
    ; find_definition_in_dir#.
    function concept_in_dir(rp, dir: String, self_path: String, name: String) returns bool
    {
        if dir.get_length() = 0
            return false
        let listing symbols.list_scaly_files dir
        var found false
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if found = false
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                if symbols.concept_in_ws_blob(blob, name)
                                    set found: true
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        found
    }

    ; The return-type base of the routine named `name` anywhere in the workspace
    ; (dir tree, then package tree), "" when found nowhere / void. Reads CACHED
    ; ws blobs via the symindex; structured like function_return_type_ws# but
    ; cache-served (no per-file re-parse).
    function return_type_in_workspace(rp, uri: String, name: String) returns String
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let here symbols.return_type_in_dir(dir, path, name)
        if here.get_length() > 0
            return here
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.return_type_in_dir(pkg, path, name)
        ""
    }

    function return_type_in_dir(rp, dir: String, self_path: String, name: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir
        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                set result: symbols.return_type_from_ws_blob(blob, name)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; ====================================================================
    ; Cross-file semantic-token name resolution
    ;
    ; semantic_tokens#'s declared-kind resolution (fn_list/ty_list from
    ; completion_items#) colours an identifier USE by its kind only when the
    ; declaration is in the SAME file. This harvests function/method and
    ; struct/enum names from the rest of the workspace so a call to a cross-file
    ; function colours as function and a cross-file type reference as type. It
    ; reuses the persistent symindex — the SAME content-hash-cached ws symbol
    ; blobs workspace/symbol builds (parse-once, shared) — extracting names by
    ; SymbolKind: function/method (12/6) -> tag "F", struct/enum (23/10) ->
    ; tag "T". The result is a blob of tagged lines "F<TAB>name<LF>" /
    ; "T<TAB>name<LF>"; semantic_tokens# splits it into two newline-bracketed
    ; name lists via tagged_name_list#. "" when there is no workspace context,
    ; so a scratch file with no siblings behaves exactly as the intra-file path.
    ; Mirrors find_definition_in_workspace#: current file's dir tree, then the
    ; package tree (stdlib String / Vector / Page, …).
    ; ====================================================================

    function workspace_name_blob(rp, uri: String) returns String
    {
        if uri.get_length() > 0
        {
            let path symbols.uri_to_path uri
            let dir symbols.dir_of path
            var sb StringBuilder()
            ; (1) the current file's directory tree (project-local, fast).
            ; Lexical (depth-0 byte scan), NOT a full parse — see
            ; tagged_names_in_dir / tagged_names_lexical.
            let here symbols.tagged_names_in_dir(dir, path)
            var hi: size_t 0
            let hn here.get_length()
            while hi < hn
            {
                sb.append(here.get(hi) as char)
                set hi: hi + 1
            }
            ; (2) the package dependency tree (stdlib String/Vector/Page, …).
            ; Aggregated, not first-match: a file uses names from both. Skipped
            ; when it would re-scan the same dir. Duplicate names are harmless —
            ; the hash set dedups. Re-enabled in Step 28 (the O(1) lookup makes
            ; the larger name set affordable; the symindex caches the parse).
            let pkg symbols.package_search_dir path
            if pkg.get_length() > 0
                if pkg <> dir
                {
                    let there symbols.tagged_names_in_dir(pkg, path)
                    var ti: size_t 0
                    let tn there.get_length()
                    while ti < tn
                    {
                        sb.append(there.get(ti) as char)
                        set ti: ti + 1
                    }
                }
            return sb.to_string()
        }
        ""
    }

    ; Harvest tagged function/type names from every .scaly file under `dir`
    ; (recursively) except `self_path` (the current file — its declarations are
    ; already in the intra-file lists). Reuses the symindex (parse-once, content
    ; hashed), so a query reuses the cached ws blob whenever the file is
    ; unchanged. Each file contributes its tagged-name fragment.
    function workspace_names_in_dir(rp, dir: String, self_path: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir

        var sb StringBuilder()
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                let fpath symbols.substring(listing, line_start, i)
                if fpath.get_length() > 0
                    if fpath <> self_path
                        if File.exists(fpath)
                        {
                            let fsrc File.read_to_string(fpath)
                            let chash fsrc.hash()
                            var blob ""
                            if symindex.valid(fpath, chash)
                                set blob: symindex.get_blob fpath
                            if symindex.valid(fpath, chash) = false
                            {
                                let furi symbols.path_to_uri fpath
                                set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                symindex.put(fpath, chash, blob)
                            }
                            let frag symbols.tagged_names_from_ws_blob blob
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                set line_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; Walk a cached ws symbol blob (records "name<TAB>{json}<LF>") and emit a
    ; tagged-name line per function/method (SymbolKind 12/6 -> "F") and struct/
    ; enum (23/10 -> "T"). Other kinds (namespaces, variables, constructors,
    ; operators, modules) are skipped — they match the intra-file path, where
    ; only completion kinds 2/3 (fn) and 22/13 (type) feed the lists.
    function tagged_names_from_ws_blob(rp, blob: String) returns String
    {
        var sb StringBuilder()
        var needle StringBuilder()
        needle.append("\"" as char)
        needle.append "kind"
        needle.append("\"" as char)
        needle.append(":" as char)
        let kind_needle needle.to_string()

        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10             ; record terminator
            {
                ; name = [rec_start, tab)
                var tab rec_start
                while tab < i
                {
                    if blob.get(tab) = 9
                        break
                    set tab: tab + 1
                }
                let kind symbols.ws_record_kind(blob, tab, i, kind_needle)
                var tagb: size_t 0
                if kind = 12
                    set tagb: 0x46           ; F: function
                if kind = 6
                    set tagb: 0x46           ; F: method
                if kind = 23
                    set tagb: 0x54           ; T: struct
                if kind = 10
                    set tagb: 0x54           ; T: enum/union
                if tagb > 0
                {
                    sb.append(tagb as char)
                    sb.append("\t" as char)
                    var k rec_start
                    while k < tab
                    {
                        sb.append(blob.get(k) as char)
                        set k: k + 1
                    }
                    sb.append("\n" as char)
                }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; ----- fast lexical top-level name harvest (no full parse) -----
    ; The cross-package semanticTokens harvest only needs each file's TOP-LEVEL
    ; declaration names tagged F (function/procedure/delegate) or T (class/union/
    ; intrinsic) — exactly what workspace_symbols_in_file + ws_decl emit for the
    ; top level (it iterates file.declarations only; nested defines/methods live
    ; inside `{...}` at depth>0 and are NOT emitted). A full parse_program of every
    ; package file (incl. the 21k-line Planner.scaly, Emitter.scaly, 9.5k-line
    ; symbols.scaly under <SCALY_HOME>/packages) cost ~7.5s on a cold worker —
    ; right at the 8s budget. A brace-depth-0 byte scan skips all routine/type
    ; BODIES and runs in a fraction of that. Emits the tagged_names_from_ws_blob
    ; format ("F\tname\n" / "T\tname\n").

    ; Skip whitespace, newlines, comments and string/char/fragment literals from
    ; k; return the next real-code offset.
    function lex_skip_ws(source: String, k0: size_t, n: size_t) returns size_t
    {
        var k k0
        while k < n
        {
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                set k: symbols.skip_noncode(source, k, n)
                continue
            }
            if symbols.is_ws_byte(c)
            {
                set k: k + 1
                continue
            }
            if c = 10
            {
                set k: k + 1
                continue
            }
            break
        }
        k
    }

    ; Read an identifier starting at k (or "" if k is not an ident start).
    function lex_read_ident(rp, source: String, k: size_t, n: size_t) returns String
    {
        if k >= n
            return ""
        if symbols.is_ident_byte(source.get k) = false
            return ""
        var j k
        while j < n
        {
            if symbols.is_ident_byte(source.get j) = false
                break
            set j: j + 1
        }
        symbols.substring(source, k, j)
    }

    ; k points at `[`; return the offset just past the matching `]`.
    function lex_skip_brackets(source: String, k0: size_t, n: size_t) returns size_t
    {
        var k k0
        var d: i64 0
        while k < n
        {
            let c source.get k
            if c = 0x5B
                set d: d + 1
            if c = 0x5D
            {
                set d: d - 1
                if d = 0
                {
                    set k: k + 1
                    break
                }
            }
            set k: k + 1
        }
        k
    }

    function tagged_names_lexical(rp, source: String) returns String
    {
        var sb StringBuilder()
        let n source.get_length()
        var i: size_t 0
        while i < n
        {
            let c source.get i
            if symbols.is_noncode_start(c)
            {
                set i: symbols.skip_noncode(source, i, n)
                continue
            }
            if symbols.is_ident_byte(c) = false
            {
                set i: i + 1
                continue
            }
            ; read an identifier word [wstart, i). The declaration keywords
            ; `function`/`procedure`/`define` are reserved and never appear
            ; inside expression bodies, so a flat all-depth scan emits both
            ; top-level declarations AND class/namespace MEMBERS (kind-6
            ; methods, e.g. hashing::is_prime) — matching ws_definition's
            ; recursive ws_body/ws_namespace member emission. No brace
            ; depth tracking needed.
            let wstart i
            while i < n
            {
                if symbols.is_ident_byte(source.get i) = false
                    break
                set i: i + 1
            }
            let word symbols.substring(source, wstart, i)
            var is_fn false
            if word = "function"
                set is_fn: true
            if word = "procedure"
                set is_fn: true
            if is_fn
            {
                let fk symbols.lex_skip_ws(source, i, n)
                let fnm symbols.lex_read_ident(source, fk, n)
                if fnm.get_length() > 0
                {
                    sb.append("F" as char)
                    sb.append("\t" as char)
                    sb.append fnm
                    sb.append("\n" as char)
                }
                continue
            }
            if word = "define"
            {
                var k symbols.lex_skip_ws(source, i, n)
                let nm symbols.lex_read_ident(source, k, n)
                if nm.get_length() > 0
                {
                    set k: k + nm.get_length()
                    set k: symbols.lex_skip_ws(source, k, n)
                    ; skip generic params [ ... ]
                    if k < n
                        if source.get(k) = 0x5B
                            set k: symbols.lex_skip_brackets(source, k, n)
                    set k: symbols.lex_skip_ws(source, k, n)
                    var tag: size_t 0
                    if k < n
                    {
                        let pc source.get k
                        if pc = 0x28              ; ( -> class/struct
                            set tag: 0x54
                        if symbols.is_ident_byte(pc)
                        {
                            let cw symbols.lex_read_ident(source, k, n)
                            if cw = "union"
                                set tag: 0x54
                            if cw = "intrinsic"
                                set tag: 0x54
                            if cw = "delegate"
                                set tag: 0x46
                        }
                    }
                    if tag > 0
                    {
                        sb.append(tag as char)
                        sb.append("\t" as char)
                        sb.append nm
                        sb.append("\n" as char)
                    }
                }
                continue
            }
        }
        sb.to_string()
    }

    ; Lexical analogue of workspace_names_in_dir: list every .scaly file under
    ; `dir` (recursively), read each (skipping self_path), and aggregate the
    ; tagged_names_lexical fragment. No full parse and no symindex (the byte scan
    ; is cheap enough to re-run per request); the rich features keep their full-
    ; blob symindex cache, populated by their own queries.
    function tagged_names_in_dir(rp, dir: String, self_path: String) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir
        var sb StringBuilder()
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                let fpath symbols.substring(listing, line_start, i)
                if fpath.get_length() > 0
                    if fpath <> self_path
                        if File.exists(fpath)
                        {
                            let fsrc File.read_to_string(fpath)
                            let frag symbols.tagged_names_lexical fsrc
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                set line_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; Extract the names tagged `tag` ("F"/"T") from a workspace_name_blob# into a
    ; newline-bracketed list ("\nname\n..\n"), the shape name_set_contains reads.
    function tagged_name_list(rp, blob: String, tag: u8) returns String
    {
        var sb StringBuilder()
        sb.append("\n" as char)                        ; leading newline
        let n blob.get_length()
        var line_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = 10
            {
                if i > line_start + 1
                    if blob.get(line_start) = tag
                        if blob.get(line_start + 1) = 9
                        {
                            var k line_start + 2
                            while k < i
                            {
                                sb.append(blob.get(k) as char)
                                set k: k + 1
                            }
                            sb.append("\n" as char)
                        }
                set line_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; ====================================================================
    ; Cross-package search roots
    ;
    ; Beyond the current file's directory tree, cross-package go-to-definition
    ; and signatureHelp also scan the package dependency tree so stdlib symbols
    ; (String / StringBuilder / Page / Vector, …) resolve. The package root is
    ; resolved the same way the compiler resolves the prelude (Modeler.scaly's
    ; scaly_home_base#): <SCALY_HOME>/packages when SCALY_HOME is set (the
    ; install wrapper sets it — absolute), else derived from the current file's
    ; path by walking up to the enclosing `/packages` segment (covers in-repo
    ; development). Both yield ABSOLUTE paths so the result Location uri opens.
    ; ====================================================================

    ; "<SCALY_HOME>/" when SCALY_HOME is set and non-empty, else "". Mirrors
    ; Modeler.scaly::scaly_home_base#.
    function scaly_home_base(rp) returns String
    {
        let home getenv "SCALY_HOME"
        if home = null
            return ""
        var home_str String(home)
        if home_str.get_length() = 0
            return ""
        var sb StringBuilder()
        var i: size_t 0
        let hl home_str.get_length()
        while i < hl
        {
            sb.append(home_str.get(i) as char)
            set i: i + 1
        }
        sb.append("/" as char)
        sb.to_string()
    }

    ; The packages/ root to scan for cross-package symbols, or "" when none can
    ; be determined. Prefers <SCALY_HOME>/packages; otherwise the longest prefix
    ; of `path` ending in a `/packages` segment.
    function package_search_dir(rp, path: String) returns String
    {
        let base symbols.scaly_home_base()
        if base.get_length() > 0
        {
            var sb StringBuilder()
            var i: size_t 0
            let bl base.get_length()
            while i < bl
            {
                sb.append(base.get(i) as char)
                set i: i + 1
            }
            sb.append "packages"
            return sb.to_string()
        }
        symbols.packages_dir_from_path path
    }

    ; `path` truncated to include its last "/packages" segment (so
    ; "/u/Scaly/packages/scalyls/0.1.0/x.scaly" -> "/u/Scaly/packages"), or ""
    ; when `path` is not under a packages/ directory.
    function packages_dir_from_path(rp, path: String) returns String
    {
        let needle "/packages/"
        let pn path.get_length()
        let nn needle.get_length()
        if pn >= nn
        {
            var last_found: size_t 0
            var found false
            var i: size_t 0
            while i + nn <= pn
            {
                if symbols.matches_at(path, i, needle)
                {
                    set last_found: i
                    set found: true
                }
                set i: i + 1
            }
            if found
                return symbols.substring(path, 0, last_found + nn - 1)
        }
        ""
    }

    ; Run `find '<dir>' -name '*.scaly'` and return its stdout (newline-
    ; separated absolute paths) with a guaranteed trailing LF. "" on failure.
    ; The quote bytes are emitted as 0x27 (the lexer treats a `'` as the start
    ; of a string-identifier token, so it must not appear in a "..." literal).
    function list_scaly_files(rp, dir: String) returns String
    {
        var cmd StringBuilder()
        cmd.append "find "
        cmd.append("'" as char)
        var di: size_t 0
        let dn dir.get_length()
        while di < dn
        {
            cmd.append(dir.get(di) as char)
            set di: di + 1
        }
        cmd.append("'" as char)
        cmd.append " -name "
        cmd.append("'" as char)
        cmd.append "*.scaly"
        cmd.append("'" as char)
        cmd.append " 2>/dev/null"
        let cmd_str cmd.to_string()

        let f popen(cmd_str.to_c_string(), "r")
        if f = null
            return ""

        var sb StringBuilder()
        var keep true
        while keep
        {
            let c fgetc f
            if c < 0
                set keep: false
            if c >= 0
                sb.append(c as char)
        }
        pclose f
        sb.append("\n" as char)                    ; trailing LF
        sb.to_string()
    }

    ; Bytes [start,end) of `s` as a new String.
    function substring(rp, s: String, start: size_t, end: size_t) returns String
    {
        var sb StringBuilder()
        var i start
        while i < end
        {
            sb.append(s.get(i) as char)
            set i: i + 1
        }
        sb.to_string()
    }

    ; Strip a leading "file://" from a uri to get the filesystem path.
    function uri_to_path(rp, uri: String) returns String
    {
        if uri.starts_with("file://")
            return symbols.substring(uri, 7, uri.get_length())
        uri
    }

    ; Wrap a filesystem path back into a "file://" uri.
    function path_to_uri(rp, path: String) returns String
    {
        var sb StringBuilder()
        sb.append "file://"
        var i: size_t 0
        let n path.get_length()
        while i < n
        {
            sb.append(path.get(i) as char)
            set i: i + 1
        }
        sb.to_string()
    }

    ; The directory portion of `path` (everything before the last '/'), or "".
    function dir_of(rp, path: String) returns String
    {
        let n path.get_length()
        if n = 0
            return ""
        var last: size_t 0
        var found false
        var i: size_t 0
        while i < n
        {
            if path.get(i) = 0x2F       ; /
            {
                set last: i
                set found: true
            }
            set i: i + 1
        }
        if found
            return symbols.substring(path, 0, last)
        ""
    }

    ; ====================================================================
    ; workspace/symbol (parse-based, all files)
    ;
    ; Build a flat LSP SymbolInformation[] of every declaration across the
    ; workspace whose name matches the query (case-insensitive substring; an
    ; empty query matches everything), reusing the cross-file `find` discovery
    ; + the parse-tree walk. Each item:
    ;   {"name":..,"kind":<SymbolKind int>,"location":{"uri":..,"range":..}}
    ; The SymbolKind ints are the same as documentSymbol's (Function=12 etc.),
    ; NOT completion's CompletionItemKind. The walk mirrors completion_items#
    ; 1:1 (flat, comma-joined fragments) but each item carries a Location and
    ; is filtered by the query. PERSISTENT INDEX (symindex): the per-file symbol
    ; set is parsed once into a content-hashed blob and reused across queries —
    ; only files whose content changed are re-parsed, so repeated queries over a
    ; large tree are cheap. LIMITS: intra-workspace; lexical name match; the
    ; index reflects disk content (unsaved editor edits don't show, as before).
    ; ====================================================================

    ; Search every .scaly file under `root` and return the SymbolInformation[]
    ; array (already bracketed). "[]" when root is empty (no workspace folder).
    ; Each file's UNFILTERED symbol blob is cached by content hash in symindex;
    ; a query reuses the cached parse when the file is unchanged and filters the
    ; blob by name, re-parsing only files whose content moved.
    function workspace_symbols(rp, root: String, query: String) returns String
    {
        if root.get_length() = 0
            return "[]"
        let listing symbols.list_scaly_files root

        var sb StringBuilder()
        sb.append("[" as char)
        var first true
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                let fpath symbols.substring(listing, line_start, i)
                if fpath.get_length() > 0
                    if File.exists(fpath)
                    {
                        let fsrc File.read_to_string(fpath)
                        let chash fsrc.hash()
                        var blob ""
                        if symindex.valid(fpath, chash)
                            set blob: symindex.get_blob fpath
                        if symindex.valid(fpath, chash) = false
                        {
                            let furi symbols.path_to_uri fpath
                            set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                            symindex.put(fpath, chash, blob)
                        }
                        let frag symbols.filter_ws_blob(blob, query)
                        if frag.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                            set first: false
                        }
                    }
                set line_start: i + 1
            }
            set i: i + 1
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; All symbols in one file as an UNFILTERED tagged blob: each record is
    ; `name <0x09> {json} <0x0A>`. Cacheable (query-independent); a query is
    ; applied later by filter_ws_blob#. Records are newline-terminated, so the
    ; builders below concatenate fragments rather than comma-joining.
    function workspace_symbols_in_file(rp, source: String, uri: String) returns String
    {
        var p parser.Parser(source)
        var sb StringBuilder()
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let frag symbols.ws_decl(source, uri, d)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        sb.to_string()
    }

    ; Filter a cached tagged blob by `query`, emitting the matching records'
    ; JSON objects comma-joined (no brackets) — the per-file fragment that
    ; workspace_symbols# joins across files. Each record is
    ; `name <0x09> {json} <0x0A>`; the name is matched (case-insensitive
    ; substring), the json part emitted on a match.
    function filter_ws_blob(rp, blob: String, query: String) returns String
    {
        var sb StringBuilder()
        var first true
        let n blob.get_length()
        var rec_start: size_t 0
        var i: size_t 0
        while i < n
        {
            if blob.get(i) = ("\n" as char)       ; record terminator
            {
                ; tab1 = name/json separator, tab2 = json/detail separator.
                ; Emit only the json part [tab1+1, tab2) so the detail field
                ; (Step 29 follow-up) never reaches workspace/symbol output —
                ; keeping it byte-identical.
                var tab1: size_t i
                var tab2: size_t i
                var ntabs: size_t 0
                var t: size_t rec_start
                while t < i
                {
                    if blob.get(t) = ("\t" as char)
                    {
                        if ntabs = 0
                            set tab1: t
                        if ntabs = 1
                            set tab2: t
                        set ntabs: ntabs + 1
                    }
                    set t: t + 1
                }
                if ntabs >= 1
                {
                    let name symbols.substring(blob, rec_start, tab1)
                    if symbols.name_matches(name, query)
                    {
                        let jstart tab1 + 1
                        let jobj symbols.substring(blob, jstart, tab2)
                        if first = false
                            sb.append("," as char)
                        var ci: size_t 0
                        let cn jobj.get_length()
                        while ci < cn
                        {
                            sb.append(jobj.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set rec_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; One top-level declaration -> a fragment (its own item if it matches, plus
    ; its members). "" for use/package/empty/trait/macro and non-matches.
    function ws_decl(rp, source: String, uri: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.ws_item(source, uri, symbols.target_name(f.target), 12, f.start, f.end, symbols.routine_param_detail(source, f.target), symbols.target_return_field(f.target), "")
            when pr: ProcedureSyntax
                return symbols.ws_item(source, uri, symbols.target_name(pr.target), 12, pr.start, pr.end, symbols.routine_param_detail(source, pr.target), symbols.target_return_field(pr.target), "")
            when o: OperatorSyntax
                return symbols.ws_item(source, uri, symbols.target_name(o.target), 25, o.start, o.end, symbols.routine_param_detail(source, o.target), symbols.target_return_field(o.target), "")
            when def: DefinitionSyntax
                return symbols.ws_definition(source, uri, def)
            when m: ModuleSyntax
                return symbols.ws_item(source, uri, String(m.name), 2, m.start, m.end, "", "", "")
            when mut: MutableSyntax
                return symbols.ws_item(source, uri, String(mut.binding.name), 13, mut.start, mut.end, "", "", "")
            when sh: SharedSyntax
                return symbols.ws_item(source, uri, String(sh.binding.name), 13, sh.start, sh.end, "", "", "")
            when priv: PrivateSyntax
                return symbols.ws_export(source, uri, priv.export_)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function ws_export(rp, source: String, uri: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.ws_item(source, uri, symbols.target_name(f.target), 12, f.start, f.end, symbols.routine_param_detail(source, f.target), symbols.target_return_field(f.target), "")
            when pr: ProcedureSyntax
                return symbols.ws_item(source, uri, symbols.target_name(pr.target), 12, pr.start, pr.end, symbols.routine_param_detail(source, pr.target), symbols.target_return_field(pr.target), "")
            when o: OperatorSyntax
                return symbols.ws_item(source, uri, symbols.target_name(o.target), 25, o.start, o.end, symbols.routine_param_detail(source, o.target), symbols.target_return_field(o.target), "")
            when def: DefinitionSyntax
                return symbols.ws_definition(source, uri, def)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return symbols.ws_item(source, uri, String(m.name), 2, m.start, m.end, "", "", "")
    }

    ; A `define X` -> its own item (struct/namespace/union/…) joined with its
    ; members' items.
    function ws_definition(rp, source: String, uri: String, def: DefinitionSyntax) returns String
    {
        var kind: i64 (23 as i64)
        var children ""
        choose def.concept_
            when c: ClassSyntax
            {
                set kind: 23
                set children: symbols.ws_body(source, uri, c.body)
            }
            when n: NamespaceSyntax
            {
                set kind: 3
                set children: symbols.ws_namespace(source, uri, n)
            }
            when un: UnionSyntax
            {
                set kind: 10
                set children: symbols.ws_union(source, uri, un)
            }
            when cn: ConstantSyntax
                set kind: 14
            when dl: DelegateSyntax
                set kind: 12
            when ic: IntrinsicSyntax
                set kind: 23
        let own symbols.ws_item(source, uri, def.name, kind, def.start, def.end, symbols.concept_member_detail(source, def), "", symbols.concept_member_types(source, def))
        symbols.join_fragments(own, children)
    }

    ; Members of a class body -> a comma-joined fragment.
    function ws_body(rp, source: String, uri: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.ws_member(source, uri, m)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.to_string()
    }

    ; One class/union member -> an item, or "" / a nested fragment.
    function ws_member(rp, source: String, uri: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.ws_item(source, uri, symbols.target_name(f.target), 6, f.start, f.end, symbols.routine_param_detail(source, f.target), symbols.target_return_field(f.target), "")
            when pr: ProcedureSyntax
                return symbols.ws_item(source, uri, symbols.target_name(pr.target), 6, pr.start, pr.end, symbols.routine_param_detail(source, pr.target), symbols.target_return_field(pr.target), "")
            when o: OperatorSyntax
                return symbols.ws_item(source, uri, symbols.target_name(o.target), 25, o.start, o.end, symbols.routine_param_detail(source, o.target), symbols.target_return_field(o.target), "")
            when ini: InitSyntax
                return symbols.ws_item(source, uri, "init", 9, ini.start, ini.end, "", "", "")
            when dei: DeInitSyntax
                return symbols.ws_item(source, uri, "deinit", 9, dei.start, dei.end, "", "", "")
            when def: DefinitionSyntax
                return symbols.ws_definition(source, uri, def)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return symbols.ws_item(source, uri, String(m.name), 2, m.start, m.end, "", "", "")
    }

    ; Nested declarations of a namespace -> a concatenated record fragment.
    function ws_namespace(rp, source: String, uri: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let frag symbols.ws_decl(source, uri, d)
                    var ci: size_t 0
                    let cn frag.get_length()
                    while ci < cn
                    {
                        sb.append(frag.get(ci) as char)
                        set ci: ci + 1
                    }
                }
                set i: i + 1
            }
        }
        sb.to_string()
    }

    ; Variants (EnumMember=22) + body members of a union -> a comma-joined
    ; fragment. Each variant is filtered by the query, so the comma is only
    ; emitted for a matching variant.
    function ws_union(rp, source: String, uri: String, un: UnionSyntax) returns String
    {
        var sb StringBuilder()
        if un.variants <> null
        {
            let variants (*un.variants)
            var i: size_t 0
            while i < variants.length
            {
                let vptr variants.get i
                if vptr <> null
                {
                    let vitem symbols.ws_item(source, uri, String(vptr.name), 22, vptr.start, vptr.end, "", "", "")
                    var ci: size_t 0
                    let cn vitem.get_length()
                    while ci < cn
                    {
                        sb.append(vitem.get(ci) as char)
                        set ci: ci + 1
                    }
                }
                set i: i + 1
            }
        }
        if un.body <> null
        {
            let b (*un.body)
            if b.members <> null
            {
                let members (*b.members)
                var j: size_t 0
                while j < members.length
                {
                    let mptr members.get j
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.ws_member(source, uri, m)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                    }
                    set j: j + 1
                }
            }
        }
        sb.to_string()
    }

    ; The ws-blob DETAIL field of a routine: "S" + its 0x1F-joined param labels
    ; (Step 29 follow-up). Lets cross-file signatureHelp rebuild a SignatureHelp
    ; from the cached blob without re-parsing. A zero-arg routine yields "S"
    ; alone (still non-empty, so it is distinguishable from a non-routine's empty
    ; detail). An anonymous RoutineSyntax target -> "".
    function routine_param_detail(rp, source: String, target: TargetSyntax) returns String
    {
        choose target
            when named: NamedSyntax
            {
                var sb StringBuilder()
                sb.append("S" as char)
                let labels symbols.signature_param_labels(source, named.routine)
                var i: size_t 0
                let ln labels.get_length()
                while i < ln
                {
                    sb.append(labels.get(i) as char)
                    set i: i + 1
                }
                return sb.to_string()
            }
            when r: RoutineSyntax
                return ""
    }

    ; The ws-blob DETAIL field of a `define X`: "M" + its member completion
    ; fragment (the bracketless comma-joined {label,kind} items mem_definition#
    ; wraps in [...]). Lets cross-file member completion rebuild the member list
    ; from the cached blob without re-parsing. An empty/fieldless concept yields
    ; "M" alone -> members_from_ws_blob# wraps it as "[]" (found-but-empty,
    ; matching mem_definition#).
    function concept_member_detail(rp, source: String, def: DefinitionSyntax) returns String
    {
        var members ""
        choose def.concept_
            when c: ClassSyntax
                set members: symbols.completion_body(source, c.body)
            when n: NamespaceSyntax
                set members: symbols.completion_namespace(source, n)
            when un: UnionSyntax
                set members: symbols.completion_union(source, un)
            else
                0
        var sb StringBuilder()
        sb.append("M" as char)
        var i: size_t 0
        let ln members.get_length()
        while i < ln
        {
            sb.append(members.get(i) as char)
            set i: i + 1
        }
        sb.to_string()
    }

    ; The ws-blob MEMBERTYPES field of a `define X` (Step 33): for a CLASS, the
    ; flat 0x1F-joined member-name / type-base pairs of its fields and methods
    ; (name1 0x1F type1 0x1F name2 0x1F type2 0x1F ...), so cross-file
    ; chain-segment resolution (member_type_from_ws_blob#) can look up a field's
    ; or method's type from the cache WITHOUT re-parsing the sibling. "" for
    ; namespaces / unions / non-classes — a chain segment's type is always a
    ; class field or method. Each pair is name 0x1F typebase 0x1F (a trailing
    ; 0x1F is harmless — the reader stops at the matched name). A type base is a
    ; bare identifier (no 0x1F / tab / newline); a void method's typebase is ""
    ; (the reader returns "" for it — a void result has no chainable type).
    function concept_member_types(rp, source: String, def: DefinitionSyntax) returns String
    {
        var sb StringBuilder()
        choose def.concept_
            when c: ClassSyntax
            {
                if c.structure.parts <> null
                {
                    let parts (*c.structure.parts)
                    var i: size_t 0
                    while i < parts.length
                    {
                        let pp parts.get i
                        if pp <> null
                        {
                            let part (*pp)
                            let frag symbols.cmt_part part
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                        set i: i + 1
                    }
                }
                if c.body <> null
                {
                    let b (*c.body)
                    if b.members <> null
                    {
                        let members (*b.members)
                        var j: size_t 0
                        while j < members.length
                        {
                            let mp members.get j
                            if mp <> null
                            {
                                let m (*mp)
                                let frag symbols.cmt_member m
                                var ci: size_t 0
                                let cn frag.get_length()
                                while ci < cn
                                {
                                    sb.append(frag.get(ci) as char)
                                    set ci: ci + 1
                                }
                            }
                            set j: j + 1
                        }
                    }
                }
            }
            else
                0
        sb.to_string()
    }

    ; A class structure part -> its `name 0x1F typebase 0x1F` pair fragment.
    function cmt_part(rp, part: PartSyntax) returns String
    {
        choose part
            when fld: FieldSyntax
                return symbols.cmt_pair(String(fld.property.name), symbols.type_base_name(fld.property.annotation.type))
            when prop: PropertySyntax
                return symbols.cmt_pair(String(prop.name), symbols.type_base_name(prop.annotation.type))
    }

    ; A class-body member -> its `name 0x1F returnbase 0x1F` pair fragment, "" for
    ; non-routine members (init/deinit/nested define/etc — not chain targets).
    function cmt_member(rp, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.cmt_pair(symbols.target_name(f.target), symbols.target_return_field(f.target))
            when pr: ProcedureSyntax
                return symbols.cmt_pair(symbols.target_name(pr.target), symbols.target_return_field(pr.target))
            else
                return ""
    }

    ; `name 0x1F type_base 0x1F` (both raw, no escaping — neither contains a
    ; 0x1F / tab / newline). "" when the member has no name.
    function cmt_pair(rp, name: String, type_base: String) returns String
    {
        if name.get_length() = 0
            return ""
        var sb StringBuilder()
        var ni: size_t 0
        let nn name.get_length()
        while ni < nn
        {
            sb.append(name.get(ni) as char)
            set ni: ni + 1
        }
        sb.append(0x1F as char)
        var ti: size_t 0
        let tn type_base.get_length()
        while ti < tn
        {
            sb.append(type_base.get(ti) as char)
            set ti: ti + 1
        }
        sb.append(0x1F as char)
        sb.to_string()
    }

    ; One tagged symbol record
    ; `name <0x09> {"name","kind","location"} <0x09> detail <0x09> rettype <0x09> membertypes <0x0A>`.
    ; UNFILTERED (query-independent, so it can be cached); filter_ws_blob# does
    ; the name match later AND drops the detail+rettype fields (bounding at the
    ; SECOND tab) so workspace/symbol output stays byte-identical. A
    ; SymbolInformation JSON object never contains a raw tab or newline
    ; (json.quote_string# escapes them); the detail field (param labels /
    ; completion items) likewise has no raw tab/newline; and the rettype field
    ; (Step 32) and the membertypes field (Step 33) are bare identifiers /
    ; 0x1F-joined identifier pairs (no tab/newline) — so all four delimiters are
    ; unambiguous. `detail` is "S<labels>" for routines, "M<members>" for
    ; `define`s, "" else (routine_param_detail# / concept_member_detail#).
    ; `rettype` is the routine's return-type base (target_return_field#), ""
    ; for non-routines / void — it backs cache-served cross-file type-hint
    ; inference (return_type_from_ws_blob#). `membertypes` is a class's
    ; 0x1F-joined member-name/type pairs (concept_member_types#), "" else — it
    ; backs cache-served cross-file chain-segment resolution
    ; (member_type_from_ws_blob#).
    function ws_item(rp, source: String, uri: String, name: String, kind: i64, start: size_t, end: size_t, detail: String, rettype: String, membertypes: String) returns String
    {
        var sb StringBuilder()
        var ni: size_t 0
        let nn name.get_length()
        while ni < nn                              ; raw name (matched by filter)
        {
            sb.append(name.get(ni) as char)
            set ni: ni + 1
        }
        sb.append("\t" as char)                    ; tab: name / json separator
        sb.append("{" as char)
        sb.append(symbols.key("name"))
        sb.append(json.quote_string(name))
        sb.append("," as char)
        sb.append(symbols.key("kind"))
        sb.append(json.format_i64(kind))
        sb.append("," as char)
        sb.append(symbols.key("location"))
        sb.append(symbols.location_span_object(source, uri, start, end))
        sb.append("}" as char)
        sb.append("\t" as char)                    ; tab: json / detail separator
        var di: size_t 0
        let dl detail.get_length()
        while di < dl
        {
            sb.append(detail.get(di) as char)
            set di: di + 1
        }
        sb.append("\t" as char)                    ; tab: detail / rettype separator
        var ri: size_t 0
        let rl rettype.get_length()
        while ri < rl
        {
            sb.append(rettype.get(ri) as char)
            set ri: ri + 1
        }
        sb.append("\t" as char)                    ; tab: rettype / membertypes separator
        var mi: size_t 0
        let ml membertypes.get_length()
        while mi < ml
        {
            sb.append(membertypes.get(mi) as char)
            set mi: mi + 1
        }
        sb.append("\n" as char)                    ; newline: record terminator
        sb.to_string()
    }

    ; The ws-blob RETTYPE field (Step 32): a routine target's return-type base
    ; name (target's NamedSyntax routine returns_), "" for an anonymous routine
    ; or one that returns nothing. Non-routine declarations pass "" directly.
    function target_return_field(rp, target: TargetSyntax) returns String
    {
        choose target
            when named: NamedSyntax
                return symbols.routine_return_base(named.routine)
            when r: RoutineSyntax
                return ""
    }

    ; Concatenate two tagged-record fragments (records are newline-terminated,
    ; so plain concatenation yields a valid record stream). The result can be
    ; large, so the bytes are copied one at a time.
    function join_fragments(rp, a: String, b: String) returns String
    {
        if a.get_length() = 0
            return b
        if b.get_length() = 0
            return a
        var sb StringBuilder()
        var i: size_t 0
        let an a.get_length()
        while i < an
        {
            sb.append(a.get(i) as char)
            set i: i + 1
        }
        var j: size_t 0
        let bn b.get_length()
        while j < bn
        {
            sb.append(b.get(j) as char)
            set j: j + 1
        }
        sb.to_string()
    }

    ; Lowercase an ASCII byte (A-Z -> a-z), else unchanged.
    function lower_byte(c: u8) returns u8
    {
        if c >= 0x41
            if c <= 0x5A
                return c + 0x20
        c
    }

    ; True when `name[start..)` begins with `query` (case-insensitive).
    function matches_at(name: String, start: size_t, query: String) returns bool
    {
        let qn query.get_length()
        var j: size_t 0
        while j < qn
        {
            if symbols.lower_byte(name.get(start + j)) <> symbols.lower_byte(query.get j)
                return false
            set j: j + 1
        }
        true
    }

    ; True when `query` is a case-insensitive substring of `name` (empty query
    ; matches everything).
    function name_matches(name: String, query: String) returns bool
    {
        let qn query.get_length()
        if qn = 0
            return true
        let nn name.get_length()
        if nn < qn
            return false
        var i: size_t 0
        let last nn - qn
        while i <= last
        {
            if symbols.matches_at(name, i, query)
                return true
            set i: i + 1
        }
        false
    }

    ; ====================================================================
    ; textDocument/references (lexical, single file)
    ;
    ; Extract the identifier under the cursor and return an LSP Location[]
    ; for EVERY whole-token occurrence of that identifier in the document.
    ; This is a purely LEXICAL scan — no parse tree, no scope resolution — so
    ; it matches the name wherever it appears as a complete identifier token
    ; (declarations and all uses, including unrelated same-named locals; it
    ; does NOT look inside comments only in the sense that a `;`-comment's text
    ; is still scanned — a known limitation of the naive approach). The result
    ; is the bare JSON array `[ <location>... ]`; the server wraps it in a
    ; Response envelope. No identifier under the cursor -> `[]`.
    ;
    ; Each location's range covers the whole token [start,end) (not zero-width
    ; like go-to-definition) so the editor highlights each occurrence. The
    ; array can be large, so locations are appended ONE BYTE AT A TIME (see the
    ; STRING/JSON NOTE) — a many-occurrence file would otherwise trip the
    ; runtime's manual-grow path.
    ; ====================================================================

    ; The references/rename cursor frame is prefixed with the workspace root as
    ; "<root>\n<rest>" (root may be empty). root_prefix# returns the root (the
    ; bytes before the first LF, "" when there is none), strip_root_prefix#
    ; returns the rest (everything after the first LF, or the whole string when
    ; there is no LF — the pre-Step-37 form). The root is threaded so the
    ; cross-file walk can fan out from the real workspace root (a use in a
    ; parent/sibling directory outside the current file's own dir tree) instead
    ; of only the current file's directory; "" falls back to the dir tree.
    function root_prefix(rp, packed: String) returns String
    {
        let plen packed.get_length()
        var i: size_t 0
        while i < plen
        {
            if packed.get(i) = 0x0A
                return symbols.substring(packed, 0, i)
            set i: i + 1
        }
        ""
    }

    function strip_root_prefix(rp, packed: String) returns String
    {
        let plen packed.get_length()
        var i: size_t 0
        while i < plen
        {
            if packed.get(i) = 0x0A
                return symbols.substring(packed, i + 1, plen)
            set i: i + 1
        }
        packed
    }

    function references_packed(rp, source: String, uri: String, packed: String) returns String
    {
        let root symbols.root_prefix packed
        let pos symbols.strip_root_prefix packed
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn pos.get_length()
        while i < pn
        {
            let c pos.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)
        let name symbols.identifier_at(source, offset)
        if name.get_length() = 0
            return "[]"
        let scope_tbl symbols.scope_table source
        let comp_items symbols.completion_items source
        let range_packed symbols.scan_scope(source, scope_tbl, comp_items, uri, name, offset)
        ; A local/parameter is confined to its routine in the current file; a
        ; module/file-wide name (range_packed "") fans out across the workspace
        ; root (or the current file's directory tree when no root is set).
        if range_packed.get_length() > 0
            return symbols.scan_tokens(source, uri, name, true, range_packed)
        symbols.references_workspace(source, uri, name, root)
    }

    ; True when `c` opens a comment (`;`) or a string/char/fragment literal
    ; (" ' `). The lexical token scans skip these wholesale so a name inside a
    ; comment or a string literal is never reported as a reference/rename site.
    function is_noncode_start(c: u8) returns bool
    {
        if c = 59                       ; ;
            return true
        symbols.is_string_start c
    }

    ; Given that source[k] opens a comment or a string literal, return the
    ; offset just past it (so the caller resumes scanning real code). Mirrors
    ; the semantic_tokens# scanner's comment/string handling: `;` to EOL, a
    ; `;* ... *;` block (possibly multi-line), or a " ' ` literal (escape-aware:
    ; a backslash skips the next byte; a newline inside a single-quoted run
    ; terminates it). Returns k unchanged if source[k] is neither.
    function skip_noncode(source: String, k: size_t, len: size_t) returns size_t
    {
        let c source.get k
        ; comment: `;` to EOL, or `;* ... *;`
        if c = 59
        {
            var is_multi false
            if k + 1 < len
                if source.get(k + 1) = 42
                    set is_multi: true
            if is_multi
            {
                var j k + 2
                while j < len
                {
                    if source.get(j) = 42
                        if j + 1 < len
                            if source.get(j + 1) = 59
                            {
                                set j: j + 2
                                return j
                            }
                    set j: j + 1
                }
                return len
            }
            var j2 k + 1
            while j2 < len
            {
                if source.get(j2) = 10
                    break
                set j2: j2 + 1
            }
            return j2
        }
        ; string / char / fragment literal
        if symbols.is_string_start(c)
        {
            let q c
            var j k + 1
            while j < len
            {
                let cc source.get j
                if cc = 10
                    break
                if cc = 92              ; backslash: skip next byte
                {
                    set j: j + 2
                    continue
                }
                if cc = q
                {
                    set j: j + 1                   ; include the closing quote
                    break
                }
                set j: j + 1
            }
            if j > len
                set j: len
            return j
        }
        k
    }

    ; True when `offset` falls inside a comment or a string literal (so a
    ; rename/prepareRename request there is rejected). Linear scan to `offset`.
    function offset_in_noncode(source: String, offset: size_t) returns bool
    {
        let len source.get_length()
        var k: size_t 0
        while k < len
        {
            if k > offset
                break
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                let nk symbols.skip_noncode(source, k, len)
                if offset < nk
                    return true
                set k: nk
                continue
            }
            set k: k + 1
        }
        false
    }

    ; True when lo <= off < hi.
    function in_range(off: size_t, lo: size_t, hi: size_t) returns bool
    {
        if off >= lo
            if off < hi
                return true
        false
    }

    ; ----- shadow exclusion: same-named locals across files (Step 38) -----
    ; A module/file-wide name N is scanned across every file (references/rename
    ; fan-out). But a routine in some file may bind N LOCALLY (as a parameter or
    ; via `let N`/`var N`), in which case every occurrence of N inside that
    ; routine refers to the local, never the module-wide symbol. Renaming those
    ; would corrupt unrelated code. So before scanning a file for N we compute
    ; its SHADOW RANGES — the byte spans of routines that bind N locally — and
    ; the token scan skips any occurrence whose start falls in a shadow range.
    ; The whole routine is skipped (the safe direction: never rename into a
    ; routine that owns a same-named local; missing a real ref is the lesser
    ; harm than corrupting an unrelated local). Detection is purely lexical /
    ; parse-based (no planner — the Step 34/35 lesson): routine ranges come from
    ; one `scope_table#` parse, params from its P records, `let`/`var` locals
    ; from a lexical sub-scan of each routine range. A cheap byte pre-gate
    ; (`has_local_binding_candidate`) skips the parse for the common file that
    ; cannot bind N at all. Residual limit: a `when`/`for`-pattern binding of N
    ; (not `let`/`var`/param) is not detected, so such a routine is NOT skipped.

    ; True when source[k,j) is the keyword `let` or `var` (byte compare, no
    ; allocation — usable from a non-# scanner).
    function token_is_decl_kw(source: String, k: size_t, j: size_t) returns bool
    {
        if (j - k) <> 3
            return false
        let c0 source.get k
        let c1 source.get(k + 1)
        let c2 source.get(k + 2)
        if c0 = 0x6C                     ; 'l'
            if c1 = 0x65                 ; 'e'
                if c2 = 0x74             ; 't'
                    return true
        if c0 = 0x76                     ; 'v'
            if c1 = 0x61                 ; 'a'
                if c2 = 0x72             ; 'r'
                    return true
        false
    }

    ; True when `name` is bound as a local within the byte range [lo,hi): it
    ; occurs as a whole token either right after a `let`/`var` keyword OR
    ; immediately followed (past spaces/tabs) by a `:` (a parameter `name: T`, a
    ; `set name:` target, a `when name:` pattern, etc.). Comments/strings are
    ; skipped. The colon form over-approximates in the SAFE direction (a stray
    ; `name:` only causes a routine to be skipped, never an unrelated rename).
    function range_binds_name(source: String, name: String, lo: size_t, hi: size_t) returns bool
    {
        let len source.get_length()
        var bound hi
        if bound > len
            set bound: len
        var prev_is_decl false
        var k lo
        while k < bound
        {
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                set k: symbols.skip_noncode(source, k, len)
                continue
            }
            if symbols.is_ident_byte(c) = false
            {
                set k: k + 1
                continue
            }
            var j k
            while j < len
            {
                if symbols.is_ident_byte(source.get j) = false
                    break
                set j: j + 1
            }
            if symbols.token_equals(source, k, j, name)
            {
                if prev_is_decl
                    return true
                var p j
                while p < len
                {
                    let pc source.get p
                    if pc = 0x20
                    {
                        set p: p + 1
                        continue
                    }
                    if pc = 0x09
                    {
                        set p: p + 1
                        continue
                    }
                    break
                }
                if p < len
                    if source.get(p) = 0x3A    ; ':'
                        return true
            }
            set prev_is_decl: symbols.token_is_decl_kw(source, k, j)
            set k: j
        }
        false
    }

    ; Cheap whole-file pre-gate: could `source` bind `name` locally anywhere? If
    ; false the file cannot shadow `name`, so the routine-boundary scan in
    ; `shadow_ranges#` is skipped entirely.
    function has_local_binding_candidate(source: String, name: String) returns bool
    {
        symbols.range_binds_name(source, name, 0, source.get_length())
    }

    ; Given `open_pos` at a `{`, return the offset just past its matching `}`
    ; (or `len` if unbalanced). Braces inside comments/strings are skipped.
    function match_brace_end(source: String, open_pos: size_t, len: size_t) returns size_t
    {
        var depth: int 0
        var p open_pos
        while p < len
        {
            let c source.get p
            if symbols.is_noncode_start(c)
            {
                set p: symbols.skip_noncode(source, p, len)
                continue
            }
            if c = 0x7B                  ; {
            {
                set depth: depth + 1
                set p: p + 1
                continue
            }
            if c = 0x7D                  ; }
            {
                set depth: depth - 1
                if depth <= 0
                    return p + 1
                set p: p + 1
                continue
            }
            set p: p + 1
        }
        len
    }

    ; Given the byte just after a routine keyword (function/procedure/operator/
    ; init/deinit), return the routine's end offset (exclusive): the byte after
    ; its closing `}` for a brace body, or the end of its single-expression line
    ; for a braceless body. ()/[] depth is tracked so a `{` or end-of-signature
    ; newline is only acted on at depth 0; a `returns` clause continuing on the
    ; next line is not mistaken for a single-line body; comments/strings skipped.
    function routine_body_end(source: String, after_kw: size_t, len: size_t) returns size_t
    {
        var depth: int 0
        var p after_kw
        while p < len
        {
            let c source.get p
            if symbols.is_noncode_start(c)
            {
                set p: symbols.skip_noncode(source, p, len)
                continue
            }
            if c = 0x28                  ; (
            {
                set depth: depth + 1
                set p: p + 1
                continue
            }
            if c = 0x5B                  ; [
            {
                set depth: depth + 1
                set p: p + 1
                continue
            }
            if c = 0x29                  ; )
            {
                set depth: depth - 1
                set p: p + 1
                continue
            }
            if c = 0x5D                  ; ]
            {
                set depth: depth - 1
                set p: p + 1
                continue
            }
            if depth <= 0
            {
                if c = 0x7B              ; { -> brace body
                    return symbols.match_brace_end(source, p, len)
                if c = 0x0A              ; newline at depth 0 = sig end
                {
                    var q p + 1
                    while q < len
                    {
                        let qc source.get q
                        if symbols.is_noncode_start(qc)
                        {
                            set q: symbols.skip_noncode(source, q, len)
                            continue
                        }
                        if qc = 0x20
                        {
                            set q: q + 1
                            continue
                        }
                        if qc = 0x09
                        {
                            set q: q + 1
                            continue
                        }
                        if qc = 0x0A
                        {
                            set q: q + 1
                            continue
                        }
                        break
                    }
                    if q < len
                        if source.get(q) = 0x7B    ; brace body next line
                            return symbols.match_brace_end(source, q, len)
                    ; a `returns` clause on the next line is still the signature
                    if q + 7 <= len
                        if symbols.token_is_returns(source, q)
                        {
                            set p: q
                            continue
                        }
                    ; braceless single-line body: ends at the next newline
                    var e q
                    while e < len
                    {
                        if source.get(e) = 0x0A
                            break
                        set e: e + 1
                    }
                    return e
                }
            }
            set p: p + 1
        }
        len
    }

    ; True when source[q..q+7) is the whole keyword `returns` (followed by a
    ; non-identifier byte). No allocation.
    function token_is_returns(source: String, q: size_t) returns bool
    {
        let len source.get_length()
        if q + 7 > len
            return false
        if source.get(q) = 0x72          ; r
            if source.get(q + 1) = 0x65    ; e
                if source.get(q + 2) = 0x74; t
                    if source.get(q + 3) = 0x75 ; u
                        if source.get(q + 4) = 0x72 ; r
                            if source.get(q + 5) = 0x6E ; n
                                if source.get(q + 6) = 0x73 ; s
                                {
                                    if q + 7 = len
                                        return true
                                    if symbols.is_ident_byte(source.get(q + 7)) = false
                                        return true
                                    return false
                                }
        false
    }

    ; The shadow ranges of `name` in `source`: a newline-terminated list of
    ; "<start> <end>" routine byte spans where `name` is bound as a parameter or
    ; a `let`/`var` local. "" when the file binds `name` nowhere (the common
    ; case — pre-gated by `has_local_binding_candidate`). PURELY LEXICAL: routine
    ; boundaries come from a byte scan (keyword + brace matching / single-line
    ; body), NOT a parse — one parse of a large file is ~seconds and would blow
    ; the worker budget when fanned out over many files (s38 measurement).
    function shadow_ranges(rp, source: String, name: String) returns String
    {
        let len source.get_length()
        if symbols.range_binds_name(source, name, 0, len) = false
            return ""
        let kw_function "function"
        let kw_procedure "procedure"
        let kw_operator "operator"
        let kw_init "init"
        let kw_deinit "deinit"
        var sb StringBuilder()
        var k: size_t 0
        while k < len
        {
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                set k: symbols.skip_noncode(source, k, len)
                continue
            }
            if symbols.is_ident_byte(c) = false
            {
                set k: k + 1
                continue
            }
            var j k
            while j < len
            {
                if symbols.is_ident_byte(source.get j) = false
                    break
                set j: j + 1
            }
            var is_kw false
            if symbols.token_equals(source, k, j, kw_function)
                set is_kw: true
            if is_kw = false
                if symbols.token_equals(source, k, j, kw_procedure)
                    set is_kw: true
            if is_kw = false
                if symbols.token_equals(source, k, j, kw_operator)
                    set is_kw: true
            if is_kw = false
                if symbols.token_equals(source, k, j, kw_init)
                    set is_kw: true
            if is_kw = false
                if symbols.token_equals(source, k, j, kw_deinit)
                    set is_kw: true
            if is_kw
            {
                let rend symbols.routine_body_end(source, j, len)
                if symbols.range_binds_name(source, name, k, rend)
                {
                    sb.append(json.format_i64(k as i64))
                    sb.append(" " as char)
                    sb.append(json.format_i64(rend as i64))
                    sb.append("\n" as char)
                }
                ; routines don't nest in a body -> resume past this routine
                if rend > j
                    set k: rend
                if rend <= j
                    set k: j
                continue
            }
            set k: j
        }
        sb.to_string()
    }

    ; True when `off` falls inside any shadow range of `shadow_packed` (the
    ; newline-terminated "<start> <end>" list from shadow_ranges#).
    function in_shadow(shadow_packed: String, off: size_t) returns bool
    {
        let n shadow_packed.get_length()
        var i: size_t 0
        while i < n
        {
            var rstart: size_t 0
            var rend: size_t 0
            var seen_space false
            while i < n
            {
                let c shadow_packed.get i
                if c = 0x0A
                {
                    set i: i + 1
                    break
                }
                if c = 0x20
                    set seen_space: true
                if c <> 0x20
                {
                    let digit (c - 0x30) as size_t
                    if seen_space = false
                        set rstart: rstart * 10 + digit
                    if seen_space
                        set rend: rend * 10 + digit
                }
                set i: i + 1
            }
            if symbols.in_range(off, rstart, rend)
                return true
        }
        false
    }

    ; Scan `source` for every whole-token occurrence of `name` and build the
    ; COMMA-JOINED fragment (no brackets, no leading/trailing comma) of either
    ; LSP Locations ({"uri":...,"range":...} when `want_uri`, for references) or
    ; DocumentHighlights ({"range":...} when not, for documentHighlight). Each
    ; occurrence is appended one byte at a time (the result can be large — see
    ; the STRING/JSON NOTE).
    ;
    ; Comments and string literals are skipped wholesale, so a name appearing
    ; inside them is never matched. `range_packed` confines matches to a byte
    ; range "<rstart> <rend>" (a local/parameter scoped to its declaring
    ; routine); "" scans the whole file (a module/file-wide name). `shadow_packed`
    ; (newline-terminated "<start> <end>" routine spans, "" when none) is applied
    ; on the whole-file path: a match inside a routine that binds `name` locally
    ; (a same-named parameter / `let`/`var` local) is skipped, so a module-wide
    ; rename never touches an unrelated same-named local in any file.
    function scan_fragment(rp, source: String, uri: String, name: String, want_uri: bool, range_packed: String, shadow_packed: String) returns String
    {
        var rstart: size_t 0
        var rend: size_t 0
        var scoped false
        if range_packed.get_length() > 0
        {
            set scoped: true
            var seen_space false
            var ri: size_t 0
            let rn range_packed.get_length()
            while ri < rn
            {
                let rc range_packed.get ri
                if rc = 0x20
                    set seen_space: true
                if rc <> 0x20
                {
                    let digit (rc - 0x30) as size_t
                    if seen_space = false
                        set rstart: rstart * 10 + digit
                    if seen_space
                        set rend: rend * 10 + digit
                }
                set ri: ri + 1
            }
        }

        var sb StringBuilder()
        var first true
        let len source.get_length()
        var k: size_t 0
        while k < len
        {
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                set k: symbols.skip_noncode(source, k, len)
                continue
            }
            if symbols.is_ident_byte(c) = false
                set k: k + 1
            if symbols.is_ident_byte(c)
            {
                ; Token start at k (k is always at a boundary here — we jump
                ; k to the token end after each token). Find its end.
                var j k
                while j < len
                {
                    if symbols.is_ident_byte(source.get j) = false
                        break
                    set j: j + 1
                }
                if symbols.token_equals(source, k, j, name)
                {
                    var ok true
                    if scoped
                        set ok: symbols.in_range(k, rstart, rend)
                    if ok
                        if symbols.in_shadow(shadow_packed, k)
                            set ok: false
                    if ok
                    {
                        if first = false
                            sb.append("," as char)
                        var piece ""
                        if want_uri
                            set piece: symbols.location_span_object(source, uri, k, j)
                        if want_uri = false
                            set piece: symbols.highlight_object(source, k, j)
                        var ci: size_t 0
                        let cn piece.get_length()
                        while ci < cn
                        {
                            sb.append(piece.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set k: j
            }
        }
        sb.to_string()
    }

    ; The single-file JSON array `[ <fragment> ]` of Locations / Highlights.
    function scan_tokens(rp, source: String, uri: String, name: String, want_uri: bool, range_packed: String) returns String
    {
        ; Single-file / scoped path (a local confined to its routine, or
        ; documentHighlight): no shadow exclusion needed.
        let frag symbols.scan_fragment(source, uri, name, want_uri, range_packed, "")
        var sb StringBuilder()
        sb.append("[" as char)
        var i: size_t 0
        let n frag.get_length()
        while i < n
        {
            sb.append(frag.get(i) as char)
            set i: i + 1
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; True when `path` lies under directory `dir` (dir is a prefix and either
    ; the whole path or immediately followed by a `/`). Used to drop dependency-
    ; package files from a workspace-root walk. matches_at is case-insensitive,
    ; which is fine for a path prefix (and correct on a case-insensitive FS).
    function path_under_dir(path: String, dir: String) returns bool
    {
        let dl dir.get_length()
        if dl = 0
            return false
        let pl path.get_length()
        if pl < dl
            return false
        if symbols.matches_at(path, 0, dir) = false
            return false
        if pl = dl
            return true
        if path.get(dl) = 0x2F          ; '/'
            return true
        false
    }

    ; True when `needle` occurs anywhere in `path` (bounds-checked, unlike a
    ; bare matches_at). Used for the "/retired/" segment check.
    function path_contains(path: String, needle: String) returns bool
    {
        let nl needle.get_length()
        if nl = 0
            return false
        let pl path.get_length()
        if pl < nl
            return false
        var i: size_t 0
        let last pl - nl
        while i <= last
        {
            if symbols.matches_at(path, i, needle)
                return true
            set i: i + 1
        }
        false
    }

    ; The current file's own package directory: the path prefix up to and
    ; including the package-name segment right after "/packages/" (e.g.
    ; ".../packages/scalyls/0.1.0/x.scaly" -> ".../packages/scalyls"), or "" when
    ; the file is not under a packages/ tree. Used so a workspace-root walk
    ; INCLUDES the package being edited but EXCLUDES sibling dependency packages.
    function current_package_dir(rp, path: String) returns String
    {
        let needle "/packages/"
        let pn path.get_length()
        let nn needle.get_length()
        if pn >= nn
        {
            var i: size_t 0
            while i + nn <= pn
            {
                if symbols.matches_at(path, i, needle)
                {
                    ; [i, i+nn) is "/packages/"; the package name runs to the
                    ; next '/'. Return the prefix up to that '/'.
                    var j i + nn
                    while j < pn
                    {
                        if path.get(j) = 0x2F
                            break
                        set j: j + 1
                    }
                    return symbols.substring(path, 0, j)
                }
                set i: i + 1
            }
        }
        ""
    }

    ; True when `fpath` must be excluded from a workspace-ROOT walk: a file in
    ; the reference-only retired/ tree, or a file under SOME packages/ tree that
    ; is NOT the current file's own package (i.e. a dependency / the prelude,
    ; which a user edit must never rename). `cur_pkg_dir` is the current file's
    ; own package dir ("" when it is not under a packages/ tree, in which case
    ; every packages/ file is a dependency). Applied ONLY when fanning out from
    ; an explicit root — the dir-of# fallback (the current file's own dir tree)
    ; is never filtered (Step 36 behavior). In a normal user project the prelude
    ; lives under SCALY_HOME (outside the root) so it is never even a walk
    ; candidate; this if bites the in-repo case where the prelude / sibling
    ; packages and retired/ sit under the repo root.
    function excluded_from_root_walk(rp, fpath: String, cur_pkg_dir: String) returns bool
    {
        if symbols.path_contains(fpath, "/retired/")
            return true
        if symbols.path_contains(fpath, "/packages/")
        {
            if cur_pkg_dir.get_length() = 0
                return true
            if symbols.path_under_dir(fpath, cur_pkg_dir)
                return false
            return true
        }
        false
    }

    ; Cross-file references: a JSON array of Locations for `name` across the
    ; current file (whole-file scan) AND every other .scaly file under the walk
    ; root, each carrying its own uri. The walk root is the workspace `root`
    ; when set (so a use in a parent/sibling directory outside the current
    ; file's own dir tree is found), else the current file's directory tree
    ; (the Step 36 fallback, byte-identical). Only used for a module/file-wide
    ; name (a local/parameter is confined to its routine, in the current file).
    ; When walking an explicit root, the dependency-package and retired/ subtrees
    ; are excluded; the dir-tree fallback is never filtered. Each file's matches
    ; are gathered as a fragment and appended byte at a time (can be large).
    function references_workspace(rp, source: String, uri: String, name: String, root: String) returns String
    {
        var sb StringBuilder()
        sb.append("[" as char)
        var first true

        ; (1) the current file (in-memory text, whole-file scan). Skip any
        ; routine that binds `name` as a same-named local/parameter (shadow).
        let cur_shadow symbols.shadow_ranges(source, name)
        let cur symbols.scan_fragment(source, uri, name, true, "", cur_shadow)
        if cur.get_length() > 0
        {
            var ci: size_t 0
            let cn cur.get_length()
            while ci < cn
            {
                sb.append(cur.get(ci) as char)
                set ci: ci + 1
            }
            set first: false
        }

        ; (2) the other .scaly files under the walk root (or the current file's
        ; directory tree when no root is set).
        let path symbols.uri_to_path uri
        var walk_dir root
        var apply_excl true
        if root.get_length() = 0
        {
            set walk_dir: symbols.dir_of path
            set apply_excl: false
        }
        let cur_pkg_dir symbols.current_package_dir path
        if walk_dir.get_length() > 0
        {
            let listing symbols.list_scaly_files walk_dir
            var line_start: size_t 0
            let n listing.get_length()
            var i: size_t 0
            while i < n
            {
                if listing.get(i) = ("\n" as char)
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                    {
                        var skip false
                        if fpath = path
                            set skip: true
                        if apply_excl
                            if skip = false
                                set skip: symbols.excluded_from_root_walk(fpath, cur_pkg_dir)
                        if skip = false
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let furi symbols.path_to_uri fpath
                                let fshadow symbols.shadow_ranges(fsrc, name)
                                let frag symbols.scan_fragment(fsrc, furi, name, true, "", fshadow)
                                if frag.get_length() > 0
                                {
                                    if first = false
                                        sb.append("," as char)
                                    var fi: size_t 0
                                    let fn frag.get_length()
                                    while fi < fn
                                    {
                                        sb.append(frag.get(fi) as char)
                                        set fi: fi + 1
                                    }
                                    set first: false
                                }
                            }
                    }
                    set line_start: i + 1
                }
                set i: i + 1
            }
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; True when `name` is a declared function / type / operator / namespace /
    ; module / mutable (any completion item) or a structure field — a name that
    ; legitimately occurs across routines/scopes, so references/rename must scan
    ; the whole file rather than confine to one routine. Locals and parameters
    ; are NOT here, so they get scoped.
    function name_is_module_wide(rp, source: String, comp_items: String, scope_tbl: String, uri: String, name: String) returns bool
    {
        if symbols.name_in_completion(comp_items, name)
            return true
        if symbols.name_is_field(source, scope_tbl, name)
            return true
        ; A name declared in a sibling file / dependency package (so absent from
        ; the current file's completion) is still module-wide — e.g. a function
        ; used here but defined elsewhere. Checked last (the workspace harvest is
        ; symindex-cached but heavier than the in-file checks above).
        symbols.name_in_workspace(uri, name)
    }

    ; True when `name` is a function/type declared anywhere in the workspace name
    ; blob (current file's directory tree + dependency package tree), each line
    ; "<tag><TAB><name><LF>".
    function name_in_workspace(rp, uri: String, name: String) returns bool
    {
        let blob symbols.workspace_name_blob uri
        let nlen name.get_length()
        if nlen = 0
            return false
        let n blob.get_length()
        var i: size_t 0
        while i < n
        {
            var nl i
            while nl < n
            {
                if blob.get(nl) = 0x0A
                    break
                set nl: nl + 1
            }
            var t i
            while t < nl
            {
                if blob.get(t) = 0x09
                    break
                set t: t + 1
            }
            if t < nl
            {
                let nstart t + 1
                if (nl - nstart) = nlen
                    if symbols.range_equals(blob, nstart, name, 0, nlen)
                        return true
            }
            set i: nl + 1
        }
        false
    }

    ; True when `name` equals the label of any completion item.
    function name_in_completion(rp, comp_items: String, name: String) returns bool
    {
        let jv json.parse comp_items
        let count json.array_length jv
        var i: size_t 0
        while i < count
        {
            let item json.array_get(jv, i)
            let lbl json.as_string(json.get(item, "label"))
            if lbl = name
                return true
            set i: i + 1
        }
        false
    }

    ; True when `name` is the name of a declared field/property, found by
    ; resolving each F-record offset in the scope table to its identifier token
    ; and comparing it whole-token to `name`.
    function name_is_field(rp, source: String, table: String, name: String) returns bool
    {
        let slen source.get_length()
        let nlen name.get_length()
        if nlen = 0
            return false
        let n table.get_length()
        var i: size_t 0
        while i < n
        {
            let tag table.get i
            if tag = 0x46               ; F
            {
                set i: i + 2           ; skip 'F' + tab
                var roff: size_t 0
                while i < n
                {
                    let c table.get i
                    if c = 0x0A
                        break
                    set roff: roff * 10 + ((c - 0x30) as size_t)
                    set i: i + 1
                }
                set i: i + 1           ; skip newline
                if roff + nlen <= slen
                    if symbols.field_name_matches(source, roff, nlen, name)
                        return true
                continue
            }
            while i < n
            {
                if table.get(i) = 0x0A
                    break
                set i: i + 1
            }
            set i: i + 1
        }
        false
    }

    ; True when source[off,off+nlen) equals `name` AND is a whole token (the
    ; following byte, if any, is not an identifier byte).
    function field_name_matches(source: String, off: size_t, nlen: size_t, name: String) returns bool
    {
        if symbols.range_equals(source, off, name, 0, nlen) = false
            return false
        let slen source.get_length()
        if off + nlen < slen
            if symbols.is_ident_byte(source.get(off + nlen))
                return false
        true
    }

    ; The scan scope for the identifier `name` at `offset`: "" (whole file) for a
    ; module/file-wide name or a cursor outside any routine, else the enclosing
    ; routine's "<start> <end>" (a local/parameter is confined to its routine,
    ; eliminating cross-routine false matches).
    function scan_scope(rp, source: String, scope_tbl: String, comp_items: String, uri: String, name: String, offset: size_t) returns String
    {
        let routine symbols.enclosing_routine(scope_tbl, offset)
        if routine.get_length() = 0
            return ""
        if symbols.name_is_module_wide(source, comp_items, scope_tbl, uri, name)
            return ""
        routine
    }

    ; True when source[start,end) equals `name` byte-for-byte.
    function token_equals(source: String, start: size_t, end: size_t, name: String) returns bool
    {
        let tlen end - start
        if tlen <> name.get_length()
            return false
        var k: size_t 0
        while k < tlen
        {
            if source.get(start + k) <> name.get(k)
                return false
            set k: k + 1
        }
        true
    }

    ; LSP Location with a range covering the whole token [start,end).
    function location_span_object(rp, source: String, uri: String, start: size_t, end: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("uri"))
        sb.append(json.quote_string(uri))
        sb.append("," as char)
        sb.append(symbols.key("range"))
        sb.append(symbols.range_for(source, start, end))
        sb.append("}" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; textDocument/documentHighlight (lexical, single file)
    ;
    ; The same whole-token lexical scan as references, but the result is a
    ; DocumentHighlight[] — per-document ranges with NO uri (the editor knows
    ; the current document). The editor uses this to highlight every
    ; occurrence of the symbol under the cursor. No identifier -> `[]`.
    ; ====================================================================

    function highlights_packed(rp, source: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)
        let name symbols.identifier_at(source, offset)
        if name.get_length() = 0
            return "[]"
        let scope_tbl symbols.scope_table source
        let comp_items symbols.completion_items source
        ; documentHighlight is single-document, so no workspace uri is threaded;
        ; "" makes a cross-file name fall to the in-file checks only (cosmetic).
        let range_packed symbols.scan_scope(source, scope_tbl, comp_items, "", name, offset)
        symbols.scan_tokens(source, "", name, false, range_packed)
    }

    ; LSP DocumentHighlight: {"range":{...}} covering the whole token.
    function highlight_object(rp, source: String, start: size_t, end: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("range"))
        sb.append(symbols.range_for(source, start, end))
        sb.append("}" as char)
        sb.to_string()
    }

    ; ====================================================================
    ; textDocument/rename + textDocument/prepareRename (lexical, single file)
    ;
    ; Rename reuses the same whole-token lexical scan as references: find the
    ; identifier under the cursor and rewrite EVERY whole-token occurrence of
    ; it in the document to the new name. The result is an LSP WorkspaceEdit
    ; ({"changes":{"<uri>":[ <TextEdit>... ]}}), each TextEdit replacing one
    ; token span with the new name. Like references this is purely lexical —
    ; no scope resolution — so it renames the name wherever it appears as a
    ; complete identifier (including unrelated same-named locals and comment
    ; text), a known limitation of the naive approach. No identifier under the
    ; cursor (or an empty new name) -> "" (the server maps "" to result:null).
    ;
    ; prepareRename returns just the Range of the identifier under the cursor
    ; so the editor can pre-fill + validate the rename box; "" when the cursor
    ; is not on a renameable identifier.
    ;
    ; The TextEdit array can be large (many occurrences), so each edit is
    ; appended ONE BYTE AT A TIME (see the STRING/JSON NOTE).
    ; ====================================================================

    ; The rename request frame packs the position AND the new name as
    ; "<line> <char> <newName>" (line/char decimal, newName an identifier with
    ; no spaces). Parse all three, find the old identifier at the cursor, and
    ; build the WorkspaceEdit. "" on no identifier / empty new name.
    function rename_packed(rp, source: String, uri: String, packed: String) returns String
    {
        let root symbols.root_prefix packed
        let pos symbols.strip_root_prefix packed
        var line: size_t 0
        var character: size_t 0
        var phase: int 0                           ; 0=line 1=char 2=newName
        var name_sb StringBuilder()
        var i: size_t 0
        let pn pos.get_length()
        while i < pn
        {
            let c pos.get i
            if phase = 2
                name_sb.append(c as char)
            if phase <> 2
            {
                if c = 0x20
                    set phase: phase + 1
                if c <> 0x20
                {
                    let digit (c - 0x30) as size_t
                    if phase = 0
                        set line: line * 10 + digit
                    if phase = 1
                        set character: character * 10 + digit
                }
            }
            set i: i + 1
        }
        let new_name name_sb.to_string()

        let offset symbols.position_to_offset(source, line, character)
        if symbols.offset_in_noncode(source, offset)
            return ""
        let old_name symbols.identifier_at(source, offset)
        if old_name.get_length() = 0
            return ""
        if grammar.is_keyword(old_name)
            return ""
        if new_name.get_length() = 0
            return ""
        let scope_tbl symbols.scope_table source
        let comp_items symbols.completion_items source
        let range_packed symbols.scan_scope(source, scope_tbl, comp_items, uri, old_name, offset)
        ; A local/parameter renames within its routine in the current file; a
        ; module/file-wide name (range_packed "") renames across the workspace
        ; root (or the current file's directory tree when no root is set).
        if range_packed.get_length() > 0
            return symbols.rename_edits(source, uri, old_name, new_name, range_packed)
        symbols.rename_workspace(source, uri, old_name, new_name, root)
    }

    ; Scan `source` for every whole-token occurrence of `old_name` and build the
    ; COMMA-JOINED fragment (no brackets) of LSP TextEdits replacing each with
    ; `new_name`. Comments and string literals are skipped; `range_packed`
    ; confines matches to a routine range ("" = whole file). `shadow_packed` (see
    ; scan_fragment#) skips occurrences inside a routine that binds `old_name`
    ; locally, so a module-wide rename never rewrites an unrelated same-named
    ; local. Each TextEdit is appended one byte at a time (the array can be large).
    function edits_fragment(rp, source: String, old_name: String, new_name: String, range_packed: String, shadow_packed: String) returns String
    {
        var rstart: size_t 0
        var rend: size_t 0
        var scoped false
        if range_packed.get_length() > 0
        {
            set scoped: true
            var seen_space false
            var ri: size_t 0
            let rcn range_packed.get_length()
            while ri < rcn
            {
                let rc range_packed.get ri
                if rc = 0x20
                    set seen_space: true
                if rc <> 0x20
                {
                    let digit (rc - 0x30) as size_t
                    if seen_space = false
                        set rstart: rstart * 10 + digit
                    if seen_space
                        set rend: rend * 10 + digit
                }
                set ri: ri + 1
            }
        }

        var sb StringBuilder()
        var first true
        let len source.get_length()
        var k: size_t 0
        while k < len
        {
            let c source.get k
            if symbols.is_noncode_start(c)
            {
                set k: symbols.skip_noncode(source, k, len)
                continue
            }
            if symbols.is_ident_byte(c) = false
                set k: k + 1
            if symbols.is_ident_byte(c)
            {
                var j k
                while j < len
                {
                    if symbols.is_ident_byte(source.get j) = false
                        break
                    set j: j + 1
                }
                if symbols.token_equals(source, k, j, old_name)
                {
                    var ok true
                    if scoped
                        set ok: symbols.in_range(k, rstart, rend)
                    if ok
                        if symbols.in_shadow(shadow_packed, k)
                            set ok: false
                    if ok
                    {
                        if first = false
                            sb.append("," as char)
                        let piece symbols.text_edit_object(source, k, j, new_name)
                        var ci: size_t 0
                        let cn piece.get_length()
                        while ci < cn
                        {
                            sb.append(piece.get(ci) as char)
                            set ci: ci + 1
                        }
                        set first: false
                    }
                }
                set k: j
            }
        }
        sb.to_string()
    }

    ; Single-file WorkspaceEdit {"changes":{"<uri>":[ <edits_fragment> ]}}.
    function rename_edits(rp, source: String, uri: String, old_name: String, new_name: String, range_packed: String) returns String
    {
        ; Single-file scoped path (a local confined to its routine): no shadow.
        let frag symbols.edits_fragment(source, old_name, new_name, range_packed, "")
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("changes"))
        sb.append("{" as char)                    ; { (changes object)
        sb.append(json.quote_string(uri))
        sb.append(":" as char)
        sb.append("[" as char)                    ; [ (TextEdit array)
        var i: size_t 0
        let n frag.get_length()
        while i < n
        {
            sb.append(frag.get(i) as char)
            set i: i + 1
        }
        sb.append("]" as char)
        sb.append("}" as char)                    ; } changes object
        sb.append("}" as char)                    ; } workspace edit
        sb.to_string()
    }

    ; Cross-file rename: a WorkspaceEdit whose `changes` object carries one
    ; "<uri>":[ <edits> ] entry per file that has ≥1 occurrence of `old_name` —
    ; the current file (in-memory, whole-file scan) plus every other .scaly file
    ; under the walk root: the workspace `root` when set, else the current
    ; file's directory tree (the Step 36 fallback, byte-identical). Only used
    ; for a module/file-wide name (a local/parameter renames within its routine
    ; in the current file). When walking an explicit root the dependency-package
    ; and retired/ subtrees are excluded (renaming the prelude from a user edit
    ; would be wrong); the dir-tree fallback is never filtered. Fragments are
    ; appended byte at a time.
    function rename_workspace(rp, source: String, uri: String, old_name: String, new_name: String, root: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("changes"))
        sb.append("{" as char)                    ; { (changes object)
        var first true

        ; (1) the current file. Skip any routine that binds `old_name` as a
        ; same-named local/parameter (shadow).
        let cur_shadow symbols.shadow_ranges(source, old_name)
        let cur symbols.edits_fragment(source, old_name, new_name, "", cur_shadow)
        if cur.get_length() > 0
        {
            sb.append(json.quote_string(uri))
            sb.append(":" as char)
            sb.append("[" as char)
            var ci: size_t 0
            let cn cur.get_length()
            while ci < cn
            {
                sb.append(cur.get(ci) as char)
                set ci: ci + 1
            }
            sb.append("]" as char)
            set first: false
        }

        ; (2) the other .scaly files under the walk root (or the current file's
        ; directory tree when no root is set).
        let path symbols.uri_to_path uri
        var walk_dir root
        var apply_excl true
        if root.get_length() = 0
        {
            set walk_dir: symbols.dir_of path
            set apply_excl: false
        }
        let cur_pkg_dir symbols.current_package_dir path
        if walk_dir.get_length() > 0
        {
            let listing symbols.list_scaly_files walk_dir
            var line_start: size_t 0
            let n listing.get_length()
            var i: size_t 0
            while i < n
            {
                if listing.get(i) = ("\n" as char)
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                    {
                        var skip false
                        if fpath = path
                            set skip: true
                        if apply_excl
                            if skip = false
                                set skip: symbols.excluded_from_root_walk(fpath, cur_pkg_dir)
                        if skip = false
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let fshadow symbols.shadow_ranges(fsrc, old_name)
                                let frag symbols.edits_fragment(fsrc, old_name, new_name, "", fshadow)
                                if frag.get_length() > 0
                                {
                                    if first = false
                                        sb.append("," as char)
                                    let furi symbols.path_to_uri fpath
                                    sb.append(json.quote_string(furi))
                                    sb.append(":" as char)
                                    sb.append("[" as char)
                                    var fi: size_t 0
                                    let fn frag.get_length()
                                    while fi < fn
                                    {
                                        sb.append(frag.get(fi) as char)
                                        set fi: fi + 1
                                    }
                                    sb.append("]" as char)
                                    set first: false
                                }
                            }
                    }
                    set line_start: i + 1
                }
                set i: i + 1
            }
        }
        sb.append("}" as char)                    ; } changes object
        sb.append("}" as char)                    ; } workspace edit
        sb.to_string()
    }

    ; LSP TextEdit: {"range":<token span>,"newText":<new name>}.
    function text_edit_object(rp, source: String, start: size_t, end: size_t, new_name: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("range"))
        sb.append(symbols.range_for(source, start, end))
        sb.append("," as char)
        sb.append(symbols.key("newText"))
        sb.append(json.quote_string(new_name))
        sb.append("}" as char)
        sb.to_string()
    }

    ; prepareRename: the request frame packs the position as "<line> <char>"
    ; (same as hover). Return the Range of the identifier under the cursor, or
    ; "" when the cursor is not on a renameable identifier.
    function prepare_rename_packed(rp, source: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)
        if symbols.offset_in_noncode(source, offset)
            return ""
        let name symbols.identifier_at(source, offset)
        if name.get_length() = 0
            return ""
        if grammar.is_keyword(name)
            return ""
        symbols.identifier_range(source, offset)
    }

    ; The Range covering the identifier run at `offset` (the same span logic
    ; as identifier_at#, but returning the range instead of the text), or ""
    ; when the cursor is not on / just past an identifier.
    function identifier_range(rp, source: String, offset: size_t) returns String
    {
        let len source.get_length()
        if len = 0
            return ""
        var off offset
        if off >= len
            set off: len - 1

        var anchor off
        if symbols.is_ident_byte(source.get off) = false
        {
            if off = 0
                return ""
            if symbols.is_ident_byte(source.get(off - 1)) = false
                return ""
            set anchor: off - 1
        }

        var start anchor
        while start > 0
        {
            if symbols.is_ident_byte(source.get(start - 1)) = false
                break
            set start: start - 1
        }
        var end anchor + 1
        while end < len
        {
            if symbols.is_ident_byte(source.get end) = false
                break
            set end: end + 1
        }

        symbols.range_for(source, start, end)
    }

    ; ====================================================================
    ; textDocument/signatureHelp (parse-only)
    ;
    ; When the cursor is inside a call's argument list, find the function /
    ; procedure / operator / method being called (the identifier just before
    ; the enclosing `(`) and report its parameter list as an LSP SignatureHelp,
    ; with activeParameter set to the depth-0 comma count between the `(` and
    ; the cursor. The target is found by the same name-matching parse-tree walk
    ; as definition (this file first, then sibling .scaly files in the dir tree).
    ;
    ; LIMITS (lexical, like definition/references): the call target is matched
    ; by NAME only (no receiver-type resolution), so `obj.method(` resolves to
    ; the first `method` declared anywhere; constructors (`Foo(`) are not
    ; matched (no named init). String literals / comments inside the argument
    ; list can confuse the bracket scan. The cursor arrives as a packed
    ; "<line> <char>" (same as hover).
    ;
    ; Result: {"signatures":[{"label":"name(p0, p1)","parameters":[
    ;   {"label":"p0"},{"label":"p1"}]}],"activeSignature":0,
    ;   "activeParameter":<n>}  or "" (server -> result:null) when the cursor is
    ; not in a recognised call.
    ; ====================================================================

    function signature_packed(rp, source: String, uri: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
                set seen_space: true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    set line: line * 10 + digit
                if seen_space
                    set character: character * 10 + digit
            }
            set i: i + 1
        }

        let offset symbols.position_to_offset(source, line, character)
        let paren symbols.find_enclosing_paren(source, offset)
        let len source.get_length()
        if paren < len
        {
            let name symbols.name_before_paren(source, paren)
            if name.get_length() > 0
            {
                let active symbols.count_active_param(source, paren, offset)
                ; Method call `recv.name(`? Scope overload resolution to the
                ; receiver's concept first, so a same-named routine in an
                ; unrelated package can't shadow it (the unscoped searches below
                ; return the first file's `name`, whichever concept it belongs
                ; to). Falls through when the receiver / its type can't be
                ; resolved lexically (reassigned or call-bound receivers).
                let receiver symbols.receiver_before_method(source, paren)
                if receiver.get_length() > 0
                {
                    let concept symbols.resolve_variable_type(source, receiver)
                    if concept.get_length() > 0
                    {
                        let scoped symbols.find_signature_in_concept_ws(uri, concept, name, active)
                        if scoped.get_length() > 0
                            return scoped
                    }
                }
                let here symbols.find_signature(source, name, active)
                if here.get_length() > 0
                    return here
                let ws symbols.find_signature_in_workspace(uri, name, active)
                if ws.get_length() > 0
                    return ws
            }
        }
        ""
    }

    ; Scan left from `offset` for the `(` that encloses the cursor at the
    ; current argument nesting. Returns its byte offset, or the source length
    ; (a sentinel that is never a valid match, since offset <= len) when there
    ; is no enclosing `(` — including when a `[` encloses us first (an index /
    ; generic, not a call). Closing brackets raise the depth; matching openers
    ; lower it; an opener at depth 0 is the enclosing one.
    function find_enclosing_paren(source: String, offset: size_t) returns size_t
    {
        let len source.get_length()
        var p offset
        if p > len
            set p: len
        var depth: size_t 0
        var result len
        var searching true
        while searching
        {
            if p = 0
                set searching: false
            if p > 0
            {
                let c source.get(p - 1)
                if c = 0x29                 ; )
                    set depth: depth + 1
                if c = 0x5D                 ; ]
                    set depth: depth + 1
                if c = 0x28                 ; (
                {
                    if depth = 0
                    {
                        set result: p - 1
                        set searching: false
                    }
                    if depth > 0
                        set depth: depth - 1
                }
                if c = 0x5B                 ; [
                {
                    if depth = 0
                        set searching: false           ; an index/generic encloses us
                    if depth > 0
                        set depth: depth - 1
                }
                set p: p - 1
            }
        }
        result
    }

    ; The identifier ending just before `paren_pos` (skipping whitespace), i.e.
    ; the called function's name, or "" when none (e.g. `(` after `)` or `]`).
    function name_before_paren(rp, source: String, paren_pos: size_t) returns String
    {
        var e paren_pos
        while e > 0
        {
            let c source.get(e - 1)
            if c <> 0x20
                if c <> 0x09
                    if c <> 0x0A
                        if c <> 0x0D
                            break
            set e: e - 1
        }
        if e = 0
            return ""
        if symbols.is_ident_byte(source.get(e - 1)) = false
            return ""
        var s e
        while s > 0
        {
            if symbols.is_ident_byte(source.get(s - 1)) = false
                break
            set s: s - 1
        }
        symbols.substring(source, s, e)
    }

    ; The receiver identifier of a method call `recv.NAME(` whose `(` is at
    ; `paren_pos` — the token before the `.` that precedes the method name. ""
    ; when the call is not a simple `ident.NAME(` (a free function `NAME(`, or a
    ; chained/parenthesised receiver like `).NAME(`). Used to scope signatureHelp
    ; overload resolution to the receiver's concept.
    function receiver_before_method(rp, source: String, paren_pos: size_t) returns String
    {
        var e paren_pos
        while e > 0
        {
            let c source.get(e - 1)
            if c <> 0x20
                if c <> 0x09
                    if c <> 0x0A
                        if c <> 0x0D
                            break
            set e: e - 1
        }
        if e = 0
            return ""
        if symbols.is_ident_byte(source.get(e - 1)) = false
            return ""
        var s e
        while s > 0
        {
            if symbols.is_ident_byte(source.get(s - 1)) = false
                break
            set s: s - 1
        }
        if s = 0
            return ""
        if source.get(s - 1) <> 0x2E      ; '.'
            return ""
        var re s - 1
        if re = 0
            return ""
        if symbols.is_ident_byte(source.get(re - 1)) = false
            return ""
        var rs re
        while rs > 0
        {
            if symbols.is_ident_byte(source.get(rs - 1)) = false
                break
            set rs: rs - 1
        }
        symbols.substring(source, rs, re)
    }

    ; Count depth-0 commas between `paren_pos` and `offset` — the 0-based index
    ; of the argument the cursor is in. Nested `()`/`[]` are skipped.
    function count_active_param(source: String, paren_pos: size_t, offset: size_t) returns size_t
    {
        let len source.get_length()
        var end offset
        if end > len
            set end: len
        var depth: size_t 0
        var commas: size_t 0
        var i paren_pos + 1
        while i < end
        {
            let c source.get i
            if c = 0x28
                set depth: depth + 1
            if c = 0x5B
                set depth: depth + 1
            if c = 0x29
                if depth > 0
                    set depth: depth - 1
            if c = 0x5D
                if depth > 0
                    set depth: depth - 1
            if c = 0x2C
                if depth = 0
                    set commas: commas + 1
            set i: i + 1
        }
        commas
    }

    ; ====================================================================
    ; textDocument/inlayHint (parameter-name hints, parse/lexical)
    ;
    ; At each call site `callee(arg0, arg1, …)` within the requested range,
    ; label each argument with the callee's corresponding parameter name —
    ; `f(⟨key:⟩ a, ⟨value:⟩ b)`. The parameter names are resolved by reusing the
    ; signatureHelp machinery (find_signature# intra-file, then the symindex-
    ; backed find_signature_in_workspace# cross-file), so a leading `this` is
    ; dropped the same way and the names match the signature labels.
    ;
    ; The request packs the visible range as "<sl> <sc> <el> <ec>" (4 ints). Only
    ; call sites overlapping the range are processed. Type hints additionally
    ; ride this scan (see below). LIMITS (lexical): the callee is matched by NAME
    ; (no receiver-type resolution); constructor calls `Foo(`/`Foo$(` (sigil
    ; before `(`) and `function`/`procedure`/`operator`/`define` DEFINITIONS are
    ; skipped; nameless (bare-type) parameters emit no hint. Result is the LSP
    ; InlayHint[] array, appended byte-at-a-time.
    ;
    ; PERF: a wide range can hold dozens of sites; resolving each by re-parsing
    ; the source (find_signature#/function_return_type#/members_for_type#) is
    ; O(sites x parse) and blows the worker's 8s budget on a big file. So
    ; inlay_hints_packed# builds a single-parse intra-file resolution map ONCE
    ; (binding_map#) and the per-site param-name / type inference consult it
    ; first, falling back to the cross-file path (symindex-cached for params)
    ; only on an intra-file miss.
    ; ====================================================================

    ; ----- single-parse intra-file resolution map (for inlay hints) -----
    ; binding_map# does ONE parse and emits a record per declaration:
    ;   R <0x09> name <0x09> param-labels(0x1F-joined, this-dropped) <0x09> rettype <0x0A>
    ;   C <0x09> name <0x0A>                                  (a `define` concept)
    ; Param labels / return-type bases / names contain no raw tab or newline, so
    ; the delimiters are unambiguous. The lookups scan this small blob (one record
    ; per decl, not per byte). Mirrors the scope_table# / frt_* walk 1:1.

    function bm_routine_record(rp, source: String, name: String, routine: RoutineSyntax) returns String
    {
        var sb StringBuilder()
        sb.append("R" as char)
        sb.append("\t" as char)
        var ni: size_t 0
        let nl name.get_length()
        while ni < nl
        {
            sb.append(name.get(ni) as char)
            set ni: ni + 1
        }
        sb.append("\t" as char)
        let labels symbols.signature_param_labels(source, routine)
        var li: size_t 0
        let ll labels.get_length()
        while li < ll
        {
            sb.append(labels.get(li) as char)
            set li: li + 1
        }
        sb.append("\t" as char)
        let rt symbols.routine_return_base routine
        var ri: size_t 0
        let rl rt.get_length()
        while ri < rl
        {
            sb.append(rt.get(ri) as char)
            set ri: ri + 1
        }
        sb.append("\n" as char)
        sb.to_string()
    }

    function bm_concept_record(rp, name: String) returns String
    {
        var sb StringBuilder()
        sb.append("C" as char)
        sb.append("\t" as char)
        var i: size_t 0
        let nl name.get_length()
        while i < nl
        {
            sb.append(name.get(i) as char)
            set i: i + 1
        }
        sb.append("\n" as char)
        sb.to_string()
    }

    function bm_target(rp, source: String, target: TargetSyntax) returns String
    {
        choose target
            when named: NamedSyntax
                return symbols.bm_routine_record(source, String(named.name), named.routine)
            when r: RoutineSyntax
                return ""
    }

    function bm_decl(rp, source: String, decl: DeclarationSyntax) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.bm_target(source, f.target)
            when pr: ProcedureSyntax
                return symbols.bm_target(source, pr.target)
            when o: OperatorSyntax
                return symbols.bm_target(source, o.target)
            when def: DefinitionSyntax
                return symbols.bm_definition(source, def)
            when priv: PrivateSyntax
                return symbols.bm_export(source, priv.export_)
            else
                return ""
    }

    function bm_export(rp, source: String, export_: ExportSyntax) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.bm_target(source, f.target)
            when pr: ProcedureSyntax
                return symbols.bm_target(source, pr.target)
            when o: OperatorSyntax
                return symbols.bm_target(source, o.target)
            when def: DefinitionSyntax
                return symbols.bm_definition(source, def)
            else
                return ""
    }

    function bm_definition(rp, source: String, def: DefinitionSyntax) returns String
    {
        var sb StringBuilder()
        let crec symbols.bm_concept_record(def.name)
        var ci: size_t 0
        let cn crec.get_length()
        while ci < cn
        {
            sb.append(crec.get(ci) as char)
            set ci: ci + 1
        }
        var members ""
        choose def.concept_
            when c: ClassSyntax
                set members: symbols.bm_body(source, c.body)
            when n: NamespaceSyntax
                set members: symbols.bm_namespace(source, n)
            when un: UnionSyntax
                set members: symbols.bm_body(source, un.body)
            else
                0
        var mi: size_t 0
        let mn members.get_length()
        while mi < mn
        {
            sb.append(members.get(mi) as char)
            set mi: mi + 1
        }
        sb.to_string()
    }

    function bm_body(rp, source: String, body: ref[BodySyntax]?) returns String
    {
        var sb StringBuilder()
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    let mptr members.get i
                    if mptr <> null
                    {
                        let m (*mptr)
                        let frag symbols.bm_member(source, m)
                        var ci: size_t 0
                        let cn frag.get_length()
                        while ci < cn
                        {
                            sb.append(frag.get(ci) as char)
                            set ci: ci + 1
                        }
                    }
                    set i: i + 1
                }
            }
        }
        sb.to_string()
    }

    function bm_member(rp, source: String, member: MemberSyntax) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.bm_target(source, f.target)
            when pr: ProcedureSyntax
                return symbols.bm_target(source, pr.target)
            when o: OperatorSyntax
                return symbols.bm_target(source, o.target)
            when def: DefinitionSyntax
                return symbols.bm_definition(source, def)
            else
                return ""
    }

    function bm_namespace(rp, source: String, ns: NamespaceSyntax) returns String
    {
        var sb StringBuilder()
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                let dptr decls.get i
                if dptr <> null
                {
                    let d (*dptr)
                    let frag symbols.bm_decl(source, d)
                    var ci: size_t 0
                    let cn frag.get_length()
                    while ci < cn
                    {
                        sb.append(frag.get(ci) as char)
                        set ci: ci + 1
                    }
                }
                set i: i + 1
            }
        }
        sb.to_string()
    }

    function binding_map(rp, source: String) returns String
    {
        var sb StringBuilder()
        var p parser.Parser(source)
        choose p.parse_program()
            when err: Error {}
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        let dptr decls.get i
                        if dptr <> null
                        {
                            let d (*dptr)
                            let frag symbols.bm_decl(source, d)
                            var ci: size_t 0
                            let cn frag.get_length()
                            while ci < cn
                            {
                                sb.append(frag.get(ci) as char)
                                set ci: ci + 1
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        sb.to_string()
    }

    ; The "Y"-prefixed 0x1F-joined param labels of the FIRST routine named `name`
    ; in the map, or "" on no match. "Y" alone = found-but-zero-arg.
    function map_labels(rp, map: String, name: String) returns String
    {
        let mn map.get_length()
        let nl name.get_length()
        var rs: size_t 0
        while rs < mn
        {
            var re rs
            while re < mn
            {
                if map.get(re) = 0x0A
                    break
                set re: re + 1
            }
            if map.get(rs) = 0x52           ; R
            {
                let nstart rs + 2
                var t2 nstart
                while t2 < re
                {
                    if map.get(t2) = 0x09
                        break
                    set t2: t2 + 1
                }
                if (t2 - nstart) = nl
                    if symbols.range_equals(map, nstart, name, 0, nl)
                    {
                        var t3 t2 + 1
                        while t3 < re
                        {
                            if map.get(t3) = 0x09
                                break
                            set t3: t3 + 1
                        }
                        var sb StringBuilder()
                        sb.append("Y" as char)
                        var li t2 + 1
                        while li < t3
                        {
                            sb.append(map.get(li) as char)
                            set li: li + 1
                        }
                        return sb.to_string()
                    }
            }
            set rs: re + 1
        }
        ""
    }

    ; The return-type base of the FIRST routine named `name` in the map, or "".
    ; ("" also when the routine returns nothing — same no-hint outcome.)
    function map_return_type(rp, map: String, name: String) returns String
    {
        let mn map.get_length()
        let nl name.get_length()
        var rs: size_t 0
        while rs < mn
        {
            var re rs
            while re < mn
            {
                if map.get(re) = 0x0A
                    break
                set re: re + 1
            }
            if map.get(rs) = 0x52           ; R
            {
                let nstart rs + 2
                var t2 nstart
                while t2 < re
                {
                    if map.get(t2) = 0x09
                        break
                    set t2: t2 + 1
                }
                if (t2 - nstart) = nl
                    if symbols.range_equals(map, nstart, name, 0, nl)
                    {
                        var t3 t2 + 1
                        while t3 < re
                        {
                            if map.get(t3) = 0x09
                                break
                            set t3: t3 + 1
                        }
                        return symbols.substring(map, t3 + 1, re)
                    }
            }
            set rs: re + 1
        }
        ""
    }

    ; True when the map carries a concept (`define`) named `name`.
    function map_is_concept(rp, map: String, name: String) returns bool
    {
        let mn map.get_length()
        let nl name.get_length()
        var rs: size_t 0
        while rs < mn
        {
            var re rs
            while re < mn
            {
                if map.get(re) = 0x0A
                    break
                set re: re + 1
            }
            if map.get(rs) = 0x43           ; C
            {
                let nstart rs + 2
                if (re - nstart) = nl
                    if symbols.range_equals(map, nstart, name, 0, nl)
                        return true
            }
            set rs: re + 1
        }
        false
    }

    ; Strip a "Y"-prefixed 0x1F-joined "name: Type" label list to a 0x1F-joined
    ; list of bare parameter NAMES, preserving positional alignment (one field
    ; per parameter, even when nameless).
    function names_from_labels(rp, payload: String) returns String
    {
        var sb StringBuilder()
        var first true
        let pn payload.get_length()
        var seg_start: size_t 1                    ; skip the "Y" sentinel
        var i: size_t 1
        while i <= pn
        {
            var at_delim false
            if i = pn
                set at_delim: true
            if i < pn
                if payload.get(i) = 0x1F
                    set at_delim: true
            if at_delim
            {
                if first = false
                    sb.append(0x1F as char)
                var ce seg_start
                while ce < i
                {
                    if payload.get(ce) = 0x3A
                        break
                    set ce: ce + 1
                }
                var ni seg_start
                while ni < ce
                {
                    sb.append(payload.get(ni) as char)
                    set ni: ni + 1
                }
                set first: false
                set seg_start: i + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    function inlay_hints_packed(rp, source: String, uri: String, packed: String) returns String
    {
        var sl: size_t 0
        var sc: size_t 0
        var el: size_t 0
        var ec: size_t 0
        var field: size_t 0
        var i: size_t 0
        let pn packed.get_length()
        while i < pn
        {
            let c packed.get i
            if c = 0x20
            {
                set field: field + 1
                set i: i + 1
                continue
            }
            let digit (c - 0x30) as size_t
            if field = 0
                set sl: sl * 10 + digit
            if field = 1
                set sc: sc * 10 + digit
            if field = 2
                set el: el * 10 + digit
            if field = 3
                set ec: ec * 10 + digit
            set i: i + 1
        }
        let range_start symbols.position_to_offset(source, sl, sc)
        let range_end symbols.position_to_offset(source, el, ec)

        ; One parse: the intra-file resolution map shared by every site below.
        let map symbols.binding_map source

        var sb StringBuilder()
        sb.append("[" as char)
        var first true
        let len source.get_length()
        let kw_let "let"
        let kw_var "var"
        var binding_pending false
        var k: size_t 0
        while k < len
        {
            let c source.get k
            if symbols.is_ident_byte(c) = false
            {
                set k: k + 1
                continue
            }
            var j k
            while j < len
            {
                if symbols.is_ident_byte(source.get j) = false
                    break
                set j: j + 1
            }
            ; A `let`/`var` binding NAME (the token right after the keyword): emit a
            ; Type hint just after the name when its type can be inferred and the
            ; site is in range. Annotated / literal / unresolvable bindings -> none.
            if binding_pending
            {
                set binding_pending: false
                if k >= range_start
                    if k <= range_end
                    {
                        let bt symbols.infer_binding_type(source, uri, j, map)
                        if bt.get_length() > 0
                        {
                            if first = false
                                sb.append("," as char)
                            let th symbols.inlay_type_hint_object(source, j, bt)
                            var ti: size_t 0
                            let tn th.get_length()
                            while ti < tn
                            {
                                sb.append(th.get(ti) as char)
                                set ti: ti + 1
                            }
                            set first: false
                        }
                    }
                set k: j
                continue
            }
            ; Arm the binding scan when this token is the `let`/`var` keyword.
            if symbols.token_equals(source, k, j, kw_let)
                set binding_pending: true
            if symbols.token_equals(source, k, j, kw_var)
                set binding_pending: true
            ; A call iff the token is immediately followed by `(` and the site
            ; overlaps the requested range.
            if j < len
                if source.get(j) = 0x28
                    if j >= range_start
                        if k <= range_end
                        {
                            let callee symbols.substring(source, k, j)
                            if grammar.is_keyword(callee) = false
                                if symbols.preceded_by_def_keyword(source, k) = false
                                {
                                    let names symbols.call_param_names(source, uri, callee, map)
                                    if names.get_length() > 0
                                    {
                                        let frag symbols.call_arg_hints(source, j, names, range_start, range_end)
                                        if frag.get_length() > 0
                                        {
                                            if first = false
                                                sb.append("," as char)
                                            var fi: size_t 0
                                            let fn frag.get_length()
                                            while fi < fn
                                            {
                                                sb.append(frag.get(fi) as char)
                                                set fi: fi + 1
                                            }
                                            set first: false
                                        }
                                    }
                                }
                        }
            set k: j
        }
        sb.append("]" as char)
        sb.to_string()
    }

    ; True when the identifier starting at `name_start` is the name in a routine
    ; DEFINITION (`function`/`procedure`/`operator`) or a `define` — i.e. the
    ; preceding non-whitespace token is one of those keywords. Such a `name(` is
    ; a declaration's parameter list, not a call, and must not get hints.
    function preceded_by_def_keyword(rp, source: String, name_start: size_t) returns bool
    {
        var e name_start
        while e > 0
        {
            let c source.get(e - 1)
            if symbols.is_ws_byte(c) = false
                break
            set e: e - 1
        }
        if e = 0
            return false
        if symbols.is_ident_byte(source.get(e - 1)) = false
            return false
        var s e
        while s > 0
        {
            if symbols.is_ident_byte(source.get(s - 1)) = false
                break
            set s: s - 1
        }
        let kwf "function"
        if symbols.token_equals(source, s, e, kwf)
            return true
        let kwp "procedure"
        if symbols.token_equals(source, s, e, kwp)
            return true
        let kwo "operator"
        if symbols.token_equals(source, s, e, kwo)
            return true
        let kwd "define"
        if symbols.token_equals(source, s, e, kwd)
            return true
        false
    }

    ; The callee's parameter NAMES (0x1F-joined) for inlay hints: resolve its
    ; SignatureHelp (intra-file, then cross-file via the symindex), then strip
    ; each parameter label "name: Type" to just "name" (a nameless bare-type
    ; parameter yields an empty segment). "" when the callee is unresolved or
    ; has no parameters (a zero-arg call has no arguments to label anyway).
    function call_param_names(rp, source: String, uri: String, callee: String, map: String) returns String
    {
        ; Intra-file: the single-parse map carries the routine's labels directly.
        let mlabels symbols.map_labels(map, callee)
        if mlabels.get_length() > 0
            return symbols.names_from_labels mlabels
        ; Cross-file: the symindex-cached signature path.
        var sig symbols.find_signature_in_workspace(uri, callee, 0)
        if sig.get_length() = 0
            return ""
        let v json.parse sig
        let sigs json.get(v, "signatures")
        let sig0 json.array_get(sigs, 0)
        let params json.get(sig0, "parameters")
        let np json.array_length params
        var sb StringBuilder()
        var i: size_t 0
        while i < np
        {
            let p json.array_get(params, i)
            let plabel json.as_string(json.get(p, "label"))
            var nlen: size_t 0
            let ll plabel.get_length()
            var ci: size_t 0
            while ci < ll
            {
                if plabel.get(ci) = 0x3A         ; :
                {
                    set nlen: ci
                    break
                }
                set ci: ci + 1
            }
            if i > 0
                sb.append(0x1F as char)
            var ni: size_t 0
            while ni < nlen
            {
                sb.append(plabel.get(ni) as char)
                set ni: ni + 1
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; Scan a call's argument list (from the `(` at `paren_pos`) and emit a
    ; comma-joined InlayHint fragment: one parameter-name hint per depth-0
    ; argument whose start offset lies within [range_start, range_end] and whose
    ; parameter (by position) has a name. Nested `()`/`[]` are skipped; the scan
    ; stops at the matching `)`.
    function call_arg_hints(rp, source: String, paren_pos: size_t, names: String, range_start: size_t, range_end: size_t) returns String
    {
        var sb StringBuilder()
        var first true
        let len source.get_length()
        var depth: size_t 0
        var arg_index: size_t 0
        var expecting true
        var a paren_pos + 1
        var scanning true
        while scanning
        {
            if a >= len
                set scanning: false
            if a < len
            {
                let ac source.get a
                if ac = 0x28
                    set depth: depth + 1
                if ac = 0x5B
                    set depth: depth + 1
                if ac = 0x29
                {
                    if depth = 0
                        set scanning: false
                    if depth > 0
                        set depth: depth - 1
                }
                if ac = 0x5D
                    if depth > 0
                        set depth: depth - 1
                if scanning
                {
                    if ac = 0x2C
                        if depth = 0
                        {
                            set arg_index: arg_index + 1
                            set expecting: true
                            set a: a + 1
                            continue
                        }
                    if expecting
                        if symbols.is_ws_byte(ac) = false
                        {
                            let pname symbols.nth_field(names, arg_index)
                            if pname.get_length() > 0
                                if a >= range_start
                                    if a <= range_end
                                    {
                                        if first = false
                                            sb.append("," as char)
                                        let hint symbols.inlay_hint_object(source, a, pname)
                                        var hi: size_t 0
                                        let hn hint.get_length()
                                        while hi < hn
                                        {
                                            sb.append(hint.get(hi) as char)
                                            set hi: hi + 1
                                        }
                                        set first: false
                                    }
                            set expecting: false
                        }
                    set a: a + 1
                }
            }
        }
        sb.to_string()
    }

    ; The k-th 0x1F-separated field of `s` (0-based), or "" when out of range.
    ; (The separator is hardcoded — a u8 parameter adjacent to the size_t `k`
    ; triggers stage-0's adjacent-param mis-widening, truncating `k` to i8.)
    function nth_field(rp, s: String, k: size_t) returns String
    {
        var idx: size_t 0
        var seg_start: size_t 0
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            if s.get(i) = 0x1F
            {
                if idx = k
                    return symbols.substring(s, seg_start, i)
                set idx: idx + 1
                set seg_start: i + 1
            }
            set i: i + 1
        }
        if idx = k
            return symbols.substring(s, seg_start, n)
        ""
    }

    ; One LSP InlayHint: a Parameter-kind (2) hint "<name>:" at `offset`, with a
    ; trailing space (paddingRight) before the argument text.
    function inlay_hint_object(rp, source: String, offset: size_t, name: String) returns String
    {
        var lbl StringBuilder()
        var i: size_t 0
        let nn name.get_length()
        while i < nn
        {
            lbl.append(name.get(i) as char)
            set i: i + 1
        }
        lbl.append(":" as char)
        let lbl_str lbl.to_string()
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("position"))
        sb.append(symbols.offset_to_pos(source, offset))
        sb.append("," as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(lbl_str))
        sb.append("," as char)
        sb.append(symbols.key("kind"))
        sb.append "2"                             ; InlayHintKind.Parameter
        sb.append("," as char)
        sb.append(symbols.key("paddingRight"))
        sb.append "true"
        sb.append("}" as char)
        sb.to_string()
    }

    ; One LSP InlayHint: a Type-kind (1) hint ": <type>" at `offset` (just after
    ; the binding NAME), with a leading space (paddingLeft) after the name.
    function inlay_type_hint_object(rp, source: String, offset: size_t, type_name: String) returns String
    {
        var lbl StringBuilder()
        lbl.append(":" as char)
        lbl.append(" " as char)                   ; (space)
        var i: size_t 0
        let nn type_name.get_length()
        while i < nn
        {
            lbl.append(type_name.get(i) as char)
            set i: i + 1
        }
        let lbl_str lbl.to_string()
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("position"))
        sb.append(symbols.offset_to_pos(source, offset))
        sb.append("," as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(lbl_str))
        sb.append("," as char)
        sb.append(symbols.key("kind"))
        sb.append "1"                             ; InlayHintKind.Type
        sb.append("," as char)
        sb.append(symbols.key("paddingLeft"))
        sb.append "true"
        sb.append("}" as char)
        sb.to_string()
    }

    ; True when `name` is a primitive / wrapper builtin (int/bool/.../pointer/ref)
    ; — these get NO type hint (a `pointer`/`ref` wrapper base is also dropped per
    ; the type-graph limits). Scans the `\n`-bracketed primitive_type_list#.
    function is_primitive_type_name(rp, name: String) returns bool
    {
        let list symbols.primitive_type_list()
        let nl name.get_length()
        if nl = 0
            return false
        let ll list.get_length()
        var i: size_t 0
        while i < ll
        {
            if list.get(i) = 0x0A
            {
                var e i + 1
                while e < ll
                {
                    if list.get(e) = 0x0A
                        break
                    set e: e + 1
                }
                if (e - (i + 1)) = nl
                    if symbols.range_equals(list, i + 1, name, 0, nl)
                        return true
            }
            set i: i + 1
        }
        false
    }

    ; Infer the declared type (base concept name) of a `let`/`var` binding whose
    ; NAME identifier ends at `name_end`, for a Type inlay hint. "" (no hint) when
    ; the binding is annotated (`: T`), the initializer is a literal/operator, or
    ; the type can't be resolved (including a primitive result). Reuses the
    ; Step-17/22 resolvers — no new inference:
    ;   constructor `T(`/`T$(`/`T^p(`/`T[..]` -> T
    ;   call / ctor-call `T(..)`  -> T if T is a concept, else T's return type
    ;   field chain `a.b.c`       -> resolve_chain_type#
    ;   bare variable `other`     -> resolve_variable_type#
    function infer_binding_type(rp, source: String, uri: String, name_end: size_t, map: String) returns String
    {
        let len source.get_length()
        let after symbols.skip_ws(source, name_end, len)
        ; Annotated binding `NAME: T` -> the user already sees the type. No hint.
        if after < len
            if source.get(after) = 0x3A
                return ""
        ; The initializer must start with an identifier (a literal / `(` / prefix
        ; operator is not a resolvable type token).
        if after >= len
            return ""
        if symbols.is_ident_byte(source.get after) = false
            return ""
        ; NOTE: inlay TYPE hints stay LEXICAL. A semantic (planner) attempt was
        ; evaluated and dropped: stage-0's planner mis-types a binding VALUE for
        ; the exact shapes the lexical walk can't reach (a mid-chain call
        ; `let g make_w().unwrap()` collapses to make_w()'s Wrapper, not Point),
        ; so preferring it would surface a WRONG hint where lexical correctly
        ; shows none. The lexical inference below is already strong (ctor /
        ; call-return / chain). Semantic IS used for completion receivers (which
        ; read the correctly-typed use-site variable, not the binding value).
        ; Read the first identifier token T = [after, te).
        var te after
        while te < len
        {
            if symbols.is_ident_byte(source.get te) = false
                break
            set te: te + 1
        }
        ; Field-access chain `a.b.c` (or `a.b.c()`): follow the type graph.
        if te < len
            if source.get(te) = 0x2E
            {
                var ce te
                while ce < len
                {
                    let cc source.get ce
                    if symbols.is_ident_byte(cc) = false
                        if cc <> 0x2E
                            break
                    set ce: ce + 1
                }
                let chain symbols.substring(source, after, ce)
                let ct symbols.resolve_chain_type(source, uri, chain)
                if symbols.is_primitive_type_name(ct)
                    return ""
                return ct
            }
        let tname symbols.substring(source, after, te)
        if te < len
        {
            let sig source.get te
            ; Lifetime sigils ($ # ^) unambiguously mean construction -> T.
            if sig = 0x24
                return tname
            if sig = 0x23
                return tname
            if sig = 0x5E
                return tname
            ; `T(..)` (ctor-or-call) and `T[..]` (generic ctor or index): T is the
            ; type only if it names a concept; otherwise `T(..)` is a function call
            ; (use its return type) and `T[..]` is an index (can't infer -> "").
            ; The intra-file map answers concept/return-type with no extra parse;
            ; only an intra-miss touches the cross-file (re-parsing) path.
            if sig = 0x28
                return symbols.concept_or_return_type(source, uri, tname, map)
            if sig = 0x5B
            {
                if symbols.map_is_concept(map, tname)
                    return tname
                ; A lowercase intra-miss is a variable index (`vec[i]`), not a
                ; generic type ctor — skip the cross-file concept parse.
                ; cross-file concept check is cache-served (Step 32), not a
                ; per-request re-parse via members_for_type#.
                if symbols.is_upper(source.get after)
                    if symbols.concept_in_workspace(uri, tname)
                        return tname
                return ""
            }
        }
        ; Bare identifier initializer (`let alias other`): resolve the variable's
        ; declared type, then disambiguate (a var bound from a call resolves to
        ; the callee NAME, whose return type is the real type).
        let vt symbols.resolve_variable_type(source, tname)
        if vt.get_length() = 0
            return ""
        symbols.concept_or_return_type(source, uri, vt, map)
    }

    ; Resolve a NAME that is either a concept (-> itself) or a routine (-> its
    ; return-type base) to a displayable type, "" otherwise (incl. a primitive
    ; result). The intra-file map answers with no extra parse; an intra-miss
    ; falls back to the cross-file (re-parsing) workspace path.
    function concept_or_return_type(rp, source: String, uri: String, name: String, map: String) returns String
    {
        if name.get_length() = 0
            return ""
        if symbols.map_is_concept(map, name)
            return name
        let mrt symbols.map_return_type(map, name)
        if mrt.get_length() > 0
        {
            if symbols.is_primitive_type_name(mrt)
                return ""
            return mrt
        }
        ; Intra-map miss: consult the SAME content-hash-cached ws blobs the rest
        ; of the server shares (Step 32) instead of re-parsing each sibling /
        ; package file (the old members_for_type# / function_return_type_ws#).
        if symbols.concept_in_workspace(uri, name)
            return name
        let rt symbols.return_type_in_workspace(uri, name)
        if symbols.is_primitive_type_name(rt)
            return ""
        rt
    }

    ; Parse the program and return the SignatureHelp for the first function /
    ; procedure / operator / method named `name`, or "" on no match / parse error.
    function find_signature(rp, source: String, name: String, active: size_t) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                set result: ""
            when program: Success
            {
                let file program.file
                if file.declarations <> null
                {
                    let decls (*file.declarations)
                    var i: size_t 0
                    while i < decls.length
                    {
                        if result.get_length() = 0
                        {
                            let dptr decls.get i
                            if dptr <> null
                            {
                                let d (*dptr)
                                set result: symbols.sig_decl(source, d, name, active)
                            }
                        }
                        set i: i + 1
                    }
                }
            }
        result
    }

    ; One top-level declaration: a SignatureHelp if it (or a nested member) is
    ; the routine named `name`, else "".
    function sig_decl(rp, source: String, decl: DeclarationSyntax, name: String, active: size_t) returns String
    {
        choose decl
            when f: FunctionSyntax
                return symbols.sig_target(source, f.target, name, active)
            when pr: ProcedureSyntax
                return symbols.sig_target(source, pr.target, name, active)
            when o: OperatorSyntax
                return symbols.sig_target(source, o.target, name, active)
            when def: DefinitionSyntax
                return symbols.sig_definition(source, def, name, active)
            when m: ModuleSyntax
                return ""
            when mut: MutableSyntax
                return ""
            when sh: SharedSyntax
                return ""
            when priv: PrivateSyntax
                return symbols.sig_export(source, priv.export_, name, active)
            when e: EmptySyntax
                return ""
            when pkg: PackageSyntax
                return ""
            when u: UseSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
    }

    ; A `private` declaration unwraps to its exported construct.
    function sig_export(rp, source: String, export_: ExportSyntax, name: String, active: size_t) returns String
    {
        choose export_
            when f: FunctionSyntax
                return symbols.sig_target(source, f.target, name, active)
            when pr: ProcedureSyntax
                return symbols.sig_target(source, pr.target, name, active)
            when o: OperatorSyntax
                return symbols.sig_target(source, o.target, name, active)
            when def: DefinitionSyntax
                return symbols.sig_definition(source, def, name, active)
            when t: TraitSyntax
                return ""
            when m: ModuleSyntax
                return ""
    }

    ; A `define X`: recurse into the body / namespace / union for a member
    ; routine named `name` (a definition itself has no parameter list).
    function sig_definition(rp, source: String, def: DefinitionSyntax, name: String, active: size_t) returns String
    {
        var child ""
        choose def.concept_
            when c: ClassSyntax
                set child: symbols.sig_body(source, c.body, name, active)
            when n: NamespaceSyntax
                set child: symbols.sig_namespace(source, n, name, active)
            when un: UnionSyntax
                set child: symbols.sig_union(source, un, name, active)
            else
                0
        child
    }

    ; Members of a class body.
    function sig_body(rp, source: String, body: ref[BodySyntax]?, name: String, active: size_t) returns String
    {
        var result ""
        if body <> null
        {
            let b (*body)
            if b.members <> null
            {
                let members (*b.members)
                var i: size_t 0
                while i < members.length
                {
                    if result.get_length() = 0
                    {
                        let mptr members.get i
                        if mptr <> null
                        {
                            let m (*mptr)
                            set result: symbols.sig_member(source, m, name, active)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        result
    }

    ; One class/union member.
    function sig_member(rp, source: String, member: MemberSyntax, name: String, active: size_t) returns String
    {
        choose member
            when f: FunctionSyntax
                return symbols.sig_target(source, f.target, name, active)
            when pr: ProcedureSyntax
                return symbols.sig_target(source, pr.target, name, active)
            when o: OperatorSyntax
                return symbols.sig_target(source, o.target, name, active)
            when ini: InitSyntax
                return ""
            when dei: DeInitSyntax
                return ""
            when def: DefinitionSyntax
                return symbols.sig_definition(source, def, name, active)
            when e: EmptySyntax
                return ""
            when im: ImplementSyntax
                return ""
            when t: TraitSyntax
                return ""
            when mac: MacroSyntax
                return ""
            when m: ModuleSyntax
                return ""
    }

    ; Nested declarations of a namespace.
    function sig_namespace(rp, source: String, ns: NamespaceSyntax, name: String, active: size_t) returns String
    {
        var result ""
        if ns.declarations <> null
        {
            let decls (*ns.declarations)
            var i: size_t 0
            while i < decls.length
            {
                if result.get_length() = 0
                {
                    let dptr decls.get i
                    if dptr <> null
                    {
                        let d (*dptr)
                        set result: symbols.sig_decl(source, d, name, active)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    ; Body members of a union (variants carry no parameter list).
    function sig_union(rp, source: String, un: UnionSyntax, name: String, active: size_t) returns String
    {
        var result ""
        if un.body <> null
            set result: symbols.sig_body(source, un.body, name, active)
        result
    }

    ; If the routine target is named `name`, build its SignatureHelp; else "".
    function sig_target(rp, source: String, target: TargetSyntax, name: String, active: size_t) returns String
    {
        choose target
            when named: NamedSyntax
            {
                if named.name = name
                    return symbols.build_signature(source, String(named.name), named.routine, active)
                return ""
            }
            when r: RoutineSyntax
                return ""
    }

    ; Assemble the SignatureHelp JSON for a routine: a label "name(p0, p1)" and
    ; a parameters array, with activeParameter clamped to the last parameter.
    function build_signature(rp, source: String, name: String, routine: RoutineSyntax, active: size_t) returns String
    {
        var sig_label StringBuilder()
        var arr StringBuilder()
        var count: size_t 0

        var ni: size_t 0
        let nl name.get_length()
        while ni < nl
        {
            sig_label.append(name.get(ni) as char)
            set ni: ni + 1
        }
        sig_label.append("(" as char)

        var first true
        if routine.parameters <> null
        {
            let ps (*routine.parameters)
            choose ps
                when params: ParametersSyntax
                {
                    if params.items <> null
                    {
                        let items (*params.items)
                        ; Drop a leading `this` receiver parameter: at a call
                        ; site the receiver is written as `recv.method(...)` (or
                        ; is implicit for a sibling call), never as the first
                        ; argument, so showing/counting it would misalign
                        ; activeParameter for every method.
                        var i: size_t 0
                        if items.length > 0
                        {
                            let i0 items.get(0)
                            if i0 <> null
                            {
                                let it0 (*i0)
                                let kw_this "this"
                                if it0.name = kw_this
                                    set i: 1
                            }
                        }
                        while i < items.length
                        {
                            let iptr items.get i
                            if iptr <> null
                            {
                                let it (*iptr)
                                let ptext symbols.param_label(source, it)
                                if ptext.get_length() > 0
                                {
                                    if first = false
                                    {
                                        sig_label.append("," as char)
                                        sig_label.append(" " as char)
                                        arr.append("," as char)
                                    }
                                    var li: size_t 0
                                    let ll ptext.get_length()
                                    while li < ll
                                    {
                                        sig_label.append(ptext.get(li) as char)
                                        set li: li + 1
                                    }
                                    let item_obj symbols.param_item ptext
                                    var ai: size_t 0
                                    let al item_obj.get_length()
                                    while ai < al
                                    {
                                        arr.append(item_obj.get(ai) as char)
                                        set ai: ai + 1
                                    }
                                    set first: false
                                    set count: count + 1
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
                when ty: TypeSyntax
                {
                    let ptext symbols.type_text(source, ty)
                    if ptext.get_length() > 0
                    {
                        var li: size_t 0
                        let ll ptext.get_length()
                        while li < ll
                        {
                            sig_label.append(ptext.get(li) as char)
                            set li: li + 1
                        }
                        let item_obj symbols.param_item ptext
                        var ai: size_t 0
                        let al item_obj.get_length()
                        while ai < al
                        {
                            arr.append(item_obj.get(ai) as char)
                            set ai: ai + 1
                        }
                        set count: count + 1
                    }
                }
        }
        sig_label.append(")" as char)

        var act active
        if count > 0
            if act >= count
                set act: count - 1
        if count = 0
            set act: 0

        let sig_label_str sig_label.to_string()
        let arr_str arr.to_string()

        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("signatures"))
        sb.append("[" as char)
        sb.append("{" as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(sig_label_str))
        sb.append("," as char)
        sb.append(symbols.key("parameters"))
        sb.append("[" as char)
        var pi: size_t 0
        let pl arr_str.get_length()
        while pi < pl
        {
            sb.append(arr_str.get(pi) as char)
            set pi: pi + 1
        }
        sb.append("]" as char)
        sb.append("}" as char)
        sb.append("]" as char)
        sb.append("," as char)
        sb.append(symbols.key("activeSignature"))
        sb.append("0" as char)
        sb.append("," as char)
        sb.append(symbols.key("activeParameter"))
        sb.append(json.format_i64(act as i64))
        sb.append("}" as char)
        sb.to_string()
    }

    ; The reconstructed parameter labels of a routine joined by 0x1F (unit
    ; separator — never appears in a label, so an internal generic comma like
    ; `Map[String, int]` is preserved within a single label). Drops a leading
    ; `this` receiver. This is the param-label source of truth shared by the
    ; cross-file path: routine_param_detail# stores it in the ws blob and
    ; build_signature_from_labels# rebuilds the SignatureHelp from it (the
    ; intra-file build_signature# still builds its labels inline — kept untouched
    ; so the proven intra-file path is zero-risk; the two formats must match, and
    ; the cross-file LSP test asserts they do).
    function signature_param_labels(rp, source: String, routine: RoutineSyntax) returns String
    {
        var sb StringBuilder()
        var first true
        if routine.parameters <> null
        {
            let ps (*routine.parameters)
            choose ps
                when params: ParametersSyntax
                {
                    if params.items <> null
                    {
                        let items (*params.items)
                        var i: size_t 0
                        if items.length > 0
                        {
                            let i0 items.get(0)
                            if i0 <> null
                            {
                                let it0 (*i0)
                                let kw_this "this"
                                if it0.name = kw_this
                                    set i: 1
                            }
                        }
                        while i < items.length
                        {
                            let iptr items.get i
                            if iptr <> null
                            {
                                let it (*iptr)
                                let ptext symbols.param_label(source, it)
                                if ptext.get_length() > 0
                                {
                                    if first = false
                                        sb.append(0x1F as char)
                                    var li: size_t 0
                                    let ll ptext.get_length()
                                    while li < ll
                                    {
                                        sb.append(ptext.get(li) as char)
                                        set li: li + 1
                                    }
                                    set first: false
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
                when ty: TypeSyntax
                {
                    let ptext symbols.type_text(source, ty)
                    if ptext.get_length() > 0
                    {
                        var li: size_t 0
                        let ll ptext.get_length()
                        while li < ll
                        {
                            sb.append(ptext.get(li) as char)
                            set li: li + 1
                        }
                    }
                }
        }
        sb.to_string()
    }

    ; Rebuild a SignatureHelp from a routine name + its 0x1F-joined param labels
    ; (as stored in the ws blob by routine_param_detail#) + the request's active
    ; parameter index. Mirrors build_signature#'s label/array assembly so the
    ; cross-file result is byte-identical to the intra-file one.
    function build_signature_from_labels(rp, name: String, labels: String, active: size_t) returns String
    {
        var sig_label StringBuilder()
        var arr StringBuilder()
        var count: size_t 0

        var ni: size_t 0
        let nl name.get_length()
        while ni < nl
        {
            sig_label.append(name.get(ni) as char)
            set ni: ni + 1
        }
        sig_label.append("(" as char)

        ; Append a trailing 0x1F so every segment (incl. the last) ends with a
        ; separator and the split loop flushes uniformly.
        var first true
        let ln labels.get_length()
        if ln > 0
        {
            var work StringBuilder()
            var wi: size_t 0
            while wi < ln
            {
                work.append(labels.get(wi) as char)
                set wi: wi + 1
            }
            work.append(0x1F as char)
            let ws work.to_string()
            let wn ws.get_length()
            var seg_start: size_t 0
            var i: size_t 0
            while i < wn
            {
                if ws.get(i) = 0x1F
                {
                    let ptext symbols.substring(ws, seg_start, i)
                    if first = false
                    {
                        sig_label.append("," as char)
                        sig_label.append(" " as char)
                        arr.append("," as char)
                    }
                    var li: size_t 0
                    let ll ptext.get_length()
                    while li < ll
                    {
                        sig_label.append(ptext.get(li) as char)
                        set li: li + 1
                    }
                    let item_obj symbols.param_item ptext
                    var ai: size_t 0
                    let al item_obj.get_length()
                    while ai < al
                    {
                        arr.append(item_obj.get(ai) as char)
                        set ai: ai + 1
                    }
                    set first: false
                    set count: count + 1
                    set seg_start: i + 1
                }
                set i: i + 1
            }
        }
        sig_label.append(")" as char)

        var act active
        if count > 0
            if act >= count
                set act: count - 1
        if count = 0
            set act: 0

        let sig_label_str sig_label.to_string()
        let arr_str arr.to_string()

        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("signatures"))
        sb.append("[" as char)
        sb.append("{" as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(sig_label_str))
        sb.append("," as char)
        sb.append(symbols.key("parameters"))
        sb.append("[" as char)
        var pi: size_t 0
        let pl arr_str.get_length()
        while pi < pl
        {
            sb.append(arr_str.get(pi) as char)
            set pi: pi + 1
        }
        sb.append("]" as char)
        sb.append("}" as char)
        sb.append("]" as char)
        sb.append("," as char)
        sb.append(symbols.key("activeSignature"))
        sb.append("0" as char)
        sb.append("," as char)
        sb.append(symbols.key("activeParameter"))
        sb.append(json.format_i64(act as i64))
        sb.append("}" as char)
        sb.to_string()
    }

    ; The label for one parameter: "name" or "name: Type". Reconstructed from
    ; the clean ItemSyntax.name + a recursive render of the annotation's type
    ; (NOT source spans — the lexer reads one token ahead, so every syntax-node
    ; `end` overshoots into the next token; only `name` fields are reliable).
    function param_label(rp, source: String, it: ItemSyntax) returns String
    {
        var sb StringBuilder()
        let nm it.name
        var i: size_t 0
        let nl nm.get_length()
        while i < nl
        {
            sb.append(nm.get(i) as char)
            set i: i + 1
        }
        if it.annotation <> null
        {
            let ann (*it.annotation)
            let tt symbols.type_text(source, ann.type)
            if tt.get_length() > 0
            {
                sb.append(":" as char)
                sb.append(" " as char)
                var ti: size_t 0
                let tl tt.get_length()
                while ti < tl
                {
                    sb.append(tt.get(ti) as char)
                    set ti: ti + 1
                }
            }
        }
        sb.to_string()
    }

    ; Render a TypeSyntax back to text: base name, dotted extensions, generic
    ; arguments in `[...]` (recursive), and a trailing `?` when optional. Built
    ; entirely from `name` String fields, so it is immune to the span-overshoot
    ; that makes substring of a type unreliable.
    function type_text(rp, source: String, ty: TypeSyntax) returns String
    {
        var sb StringBuilder()
        let nms ty.name
        let bn nms.name
        var i: size_t 0
        let bl bn.get_length()
        while i < bl
        {
            sb.append(bn.get(i) as char)
            set i: i + 1
        }
        if nms.extensions <> null
        {
            let exts (*nms.extensions)
            var ei: size_t 0
            while ei < exts.length
            {
                let eptr exts.get ei
                if eptr <> null
                {
                    let ex (*eptr)
                    sb.append("." as char)
                    let en ex.name
                    var xi: size_t 0
                    let xl en.get_length()
                    while xi < xl
                    {
                        sb.append(en.get(xi) as char)
                        set xi: xi + 1
                    }
                }
                set ei: ei + 1
            }
        }
        if ty.generics <> null
        {
            let g (*ty.generics)
            if g.generics <> null
            {
                let gs (*g.generics)
                sb.append("[" as char)
                var first true
                var gi: size_t 0
                while gi < gs.length
                {
                    let gptr gs.get gi
                    if gptr <> null
                    {
                        let ga (*gptr)
                        if first = false
                        {
                            sb.append("," as char)
                            sb.append(" " as char)
                        }
                        let inner symbols.type_text(source, ga.type)
                        var ii: size_t 0
                        let il inner.get_length()
                        while ii < il
                        {
                            sb.append(inner.get(ii) as char)
                            set ii: ii + 1
                        }
                        set first: false
                    }
                    set gi: gi + 1
                }
                sb.append("]" as char)
            }
        }
        if ty.optional <> null
            sb.append("?" as char)
        sb.to_string()
    }

    ; A {"label":<text>} parameter object.
    function param_item(rp, ptext: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(symbols.key("label"))
        sb.append(json.quote_string(ptext))
        sb.append("}" as char)
        sb.to_string()
    }

    ; Cross-file signatureHelp: the current file's directory tree first, then —
    ; on a miss — the package dependency tree (so stdlib routines resolve), the
    ; same two-step search as find_definition_in_workspace#. "" if none.
    function find_signature_in_workspace(rp, uri: String, name: String, active: size_t) returns String
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let here symbols.find_signature_in_dir(dir, path, name, active)
        if here.get_length() > 0
            return here
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.find_signature_in_dir(pkg, path, name, active)
        ""
    }

    ; Enumerate the .scaly files under `dir` (recursively) and return the first
    ; routine named `name`'s SignatureHelp (skipping `self_path`). "" if none.
    ;
    ; Step 29 follow-up: query the persistent symindex instead of re-parsing each
    ; file with find_signature#. Each cached ws record carries an "S"-tagged
    ; detail field = the routine's 0x1F-joined param labels, so the SignatureHelp
    ; is rebuilt from the cache (sig_from_ws_blob#) — no re-parse, shared with
    ; workspace/symbol + cross-file definition + member completion.
    function find_signature_in_dir(rp, dir: String, self_path: String, name: String, active: size_t) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir

        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                set result: symbols.sig_from_ws_blob(blob, name, active)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }

    ; Concept-scoped cross-file signatureHelp: the signature of routine `name`
    ; as declared by the concept `concept` (the receiver's resolved type), so a
    ; method call `recv.name(` picks the RIGHT overload even when an unrelated
    ; package declares a same-named routine (e.g. StringBuilder.append vs
    ; dazzle's BoundVarList.append). Directory tree first, then the package tree
    ; (matching find_signature_in_workspace#). "" when not found -> the caller
    ; falls back to the unscoped, name-only search.
    function find_signature_in_concept_ws(rp, uri: String, concept: String, name: String, active: size_t) returns String
    {
        let path symbols.uri_to_path uri
        let dir symbols.dir_of path
        let here symbols.find_signature_in_concept_dir(dir, path, concept, name, active)
        if here.get_length() > 0
            return here
        let pkg symbols.package_search_dir path
        if pkg.get_length() > 0
            if pkg <> dir
                return symbols.find_signature_in_concept_dir(pkg, path, concept, name, active)
        ""
    }

    ; Enumerate the .scaly files under `dir` (recursively); on the first whose
    ; cached blob DEFINES `concept` (carries an "M" member record for it), return
    ; that same blob's signature for routine `name`. Mirrors find_signature_in_dir#
    ; but gates on the concept, so the signature is read from the receiver's own
    ; type's file — not the first file that happens to declare `name`. "" if none.
    function find_signature_in_concept_dir(rp, dir: String, self_path: String, concept: String, name: String, active: size_t) returns String
    {
        if dir.get_length() = 0
            return ""
        let listing symbols.list_scaly_files dir

        var result ""
        var line_start: size_t 0
        let n listing.get_length()
        var i: size_t 0
        while i < n
        {
            if listing.get(i) = ("\n" as char)
            {
                if result.get_length() = 0
                {
                    let fpath symbols.substring(listing, line_start, i)
                    if fpath.get_length() > 0
                        if fpath <> self_path
                            if File.exists(fpath)
                            {
                                let fsrc File.read_to_string(fpath)
                                let chash fsrc.hash()
                                var blob ""
                                if symindex.valid(fpath, chash)
                                    set blob: symindex.get_blob fpath
                                if symindex.valid(fpath, chash) = false
                                {
                                    let furi symbols.path_to_uri fpath
                                    set blob: symbols.workspace_symbols_in_file(fsrc, furi)
                                    symindex.put(fpath, chash, blob)
                                }
                                if symbols.members_from_ws_blob(blob, concept).get_length() > 0
                                    set result: symbols.sig_from_ws_blob(blob, name, active)
                            }
                }
                set line_start: i + 1
            }
            set i: i + 1
        }
        result
    }
}
