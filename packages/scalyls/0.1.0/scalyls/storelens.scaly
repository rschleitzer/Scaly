; storelens.scaly - textDocument/codeLens: a `set` that writes a value CARRYING
; A REGION BUFFER through a pointer parameter, in a routine that has no page to
; pin it on.
;
; ★★★THE HAZARD, reproduced end to end on 2026-08-14. Two programs, one keyword
; apart:
;
;     function fill(out: pointer[Holder], n: int) returns bool
;     {
;         let s String("hello")
;         set *out: Holder(s)
;         true
;     }
;
; The caller reads back `XXXXXXXXXXXXXXXX` — whatever the released page was
; handed to next. Write `function fill(rp, out: ...)` and the same program
; prints `hello`. Both compile with rc 0 and neither says a word.
;
; ★★★WHY, and this is the fact the whole family is built on. The planner DID
; notice: it gave the String a CALLER-PAGE lifetime, which is the right answer.
; But `fill` has no page parameter, so at emission there is no caller page to
; allocate from, and the request falls back to this function's OWN frame —
;
;     %forced_page  = call @scaly_force_frame(ptr %frame)      <- own frame
;     %struct.region = call @Page.allocate(%forced_page, ...)
;     store { ptr } %field.load, ptr %name                     <- written upwards
;     call @scaly_release_frame(ptr %frame)                    <- and freed
;
; — while the `rp` version allocates from `%0`, the caller's page. The escape
; checker does not object because it is FIELD-INSENSITIVE: what escapes is the
; inner buffer of a by-value String field of a by-value struct, written through
; a pointer. CLAUDE.md's out-param entry says such a function "must be checked
; by hand"; this family is what tells the hand where to look.
;
; ★★★THE RETURN HALF OF THAT DOCTRINE IS REFUTED, which is why no lens here says
; anything about a return, and why "return-page warning" would be the wrong name
; for this. Measured the same day, three ways:
;   * `function f(...) returns StringC   StringC(a, b)` emits
;     `scaly_force_frame(%1)` — the CALLER's page — constructs into it and
;     memcpys to the sret slot. The sret slot is never the init's `this`, so the
;     `Page.get(<sret slot>)` story does not happen.
;   * the real `StringC.substr`, named in CLAUDE.md as THE instance of that bug,
;     does exactly that in today's tree.
;   * a String returned through TWO frames is not copied at all: the middle
;     function passes its own `_rp` straight down, so the value is built on the
;     outermost caller's page.
; And across the whole opensp package, of 314 constructors that allocate through
; `Page.get(this)` — the ordinary container idiom, not an exception — ZERO call
; sites hand one a stack alloca. A RETURN is safe; the STORE is the live class.
;
; ★A MARKER, NOT A VERDICT. A marked store is one whose buffer CANNOT be pinned
; in this routine, not one that is proven to dangle: a value that arrived as an
; argument is on the caller's page already and is perfectly safe to store.
; Deciding which is which means tracing the stored value back to its
; construction, exact only for the simplest shape and guesswork for a nested
; construction, a call result or an alias — and a plausible-looking wrong
; verdict is worse than none (tasklens.scaly's rule, for its reason). So the
; title states the MECHANISM and names the parameter.
;
; ★THREE NARROWINGS. The first draft put 133 lenses on ONE file
; (packages/dazzle/0.1.0/dazzle/Style.scaly); with all three it puts 15 there
; and 11 on opensp's Parser.scaly. ★★Each was then removed ON ITS OWN and
; re-measured, because the first version of this comment credited the cut to the
; wrong one — the page-parameter guard reads like the decisive filter and turns
; out to remove NOTHING from either file:
;
;   DECLARED HERE — the big cut (Style 123 -> 15, Parser 23 -> 11).
;   `plan.functions` is ONE FLAT VECTOR for the whole root and a Span is a bare
;   pair of byte offsets, so walking all of it collects offsets from every file
;   of the package and draws them into THIS one. That was the first version, and
;   it put "writes StringC" on `set done: true`. A function is only walked when
;   its `loc.start` is a `function`/`procedure` keyword in this text AND the name
;   there is its own (instlens.scaly's join, same collision residual: two files
;   with a routine of the same name at the same offset).
;
;   THE SOURCE MUST NOT SETTLE IT (Style 20 -> 15, Parser 26 -> 11).
;   source_settled# has the three cases.
;
;   NO PAGE PARAMETER — cuts NOTHING on either file, and is load-bearing anyway.
;   A routine that HAS one can pin (`String^host(...)`, `T#(...)`), so the same
;   store there is an ordinary, answerable decision; without one there is nothing
;   to pin onto, which is exactly what makes the fixture above dangle. That it
;   removes no site here is a fact ABOUT THIS TREE — every one of the 26 marked
;   stores is already in a page-less routine — not a reason to drop the guard:
;   drop it and the `rp` twin of the fixture is marked too, which is the gate's
;   counter-control for it.
;
; ★And the SWEEP in that gate had the same disease as this comment, found the
; same way: its first version asked only whether a marked line holds a `set` and
; sits in a page-less routine, and it stayed GREEN with `declared_here` removed
; and 41 foreign offsets drawn in. It could not fail — the anchoring maps every
; offset to the nearest PRECEDING `set` site, so "is a `set` line" is true by
; construction. It asks about ATTRIBUTION now (the parameter the title names must
; be a parameter of the enclosing routine and must appear in the store's target),
; which is what actually separates a correct mark from a foreign one.
;
; SCOPE, stated because it is narrower than "everything that can dangle":
;   * The buffer types are `String` and `StringC` BY NAME — the two CLAUDE.md's
;     rule names — reached through by-value struct fields, transitively (an
;     `ExternalId` carrying two Strings counts, and says so).
;   * A property that is itself a `pointer[T]`/`ref[T]` is NOT followed: a
;     frame-allocated object reached through a plain pointer field is the same
;     class and is not covered. Following pointers would mark nearly every store
;     in the tree.
;   * Unions are not walked (only `plan.structures`), so a variant payload
;     carrying a String is missed.
;   * Only `plan.functions` — every `function` and `procedure` of the root,
;     methods included. An operator or an initializer is missed.
;   * A truncated plan (a root with hard diagnostics) yields FEWER sites, never
;     wrong ones. Absence is not a claim of safety, which is the one thing a
;     reader must not read into it.
;
; ANCHORING is tasklens.scaly's rule: the plan's offsets index the text the plan
; was built from (disk, for a package member) while the lens is drawn in the
; BUFFER, so the two `set`-keyword site sets are paired IN ORDER and a count
; mismatch answers NOTHING. `set` is a keyword with exactly one use, like `for`,
; so a `set` token in code always opens an assignment. A PlannedAction carries
; the span of its SOURCE's first operand (Planner.scaly's `action_loc`, chosen
; there for -g line info) and never of the keyword, so each flagged offset is
; mapped to the `set` site that PRECEDES it.
;
; ASCII ONLY in the titles, and no command id — there is nothing to click.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line. Quotes are 0x22 bytes.

use scaly.memory.runtime

use scalyls.symbols
use scalyls.instlens
use scalyls.json

; Model.* is not optional: `Span` lives in Model.scaly, and without it visible
; the emitter cannot lay `loc` out — `act.loc.start` then fails with
; `member not found: Span.start` (the dangling-member trap, exit 16).
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*

define storelens
{
    ; The store lenses as a COMMA-JOINED FRAGMENT, or "". The plan is the
    ; caller's — codelens.scaly plans once for every plan-derived family.
    function fragment(rp, plan: Plan, plan_text: String, anchor_text: String) returns String
    {
        let sites storelens.count_set_sites plan_text
        if sites = 0
            return ""
        let anchors storelens.count_set_sites anchor_text
        if anchors <> sites
            return ""

        let raw storelens.collect(plan, plan_text)
        if raw.get_length() = 0
            return ""
        let blob storelens.dedupe raw
        storelens.render(blob, plan_text, anchor_text)
    }

    ; ====================================================================
    ; The walk. One blob line per flagged store:
    ;     <offset>\t<parameter>\t<stored type>\t<carrier>\n
    ; It mirrors placehints.scaly's walk arm for arm — same fields, same order,
    ; and it never prunes, because an operand's children are not inside its own
    ; span (plan-spans-are-not-a-tree).
    ;
    ; The two guards are the first two narrowings from the header, and they sit
    ; HERE rather than at the store because both are properties of the routine:
    ; a `page_parameter` means the author has a page to pin onto, and
    ; `declared_here` is the file filter without which the flat function vector
    ; draws other files' offsets into this one.
    ; ====================================================================
    function collect(rp, plan: Plan, plan_text: String) returns String
    {
        var sb StringBuilder()
        if plan.functions = null
            return sb.to_string()
        let fns (*plan.functions)
        var i: size_t 0
        while i < fns.length
        {
            let fp fns.get i
            if fp <> null
            {
                let fn (*fp)
                if fn.page_parameter = null
                {
                    if storelens.declared_here(plan_text, fn)
                    {
                        let params storelens.pointer_params fn
                        if params.get_length() > 0
                            storelens.collect_impl(&sb, plan, params, fn.impl)
                    }
                }
            }
            set i: i + 1
        }
        sb.to_string()
    }

    function declared_here(plan_text: String, fn: PlannedFunction) returns bool
    {
        let len plan_text.get_length()
        if fn.loc.start >= len
            return false
        var is_site false
        if instlens.is_keyword_at(plan_text, fn.loc.start, len, "function")
            set is_site: true
        if instlens.is_keyword_at(plan_text, fn.loc.start, len, "procedure")
            set is_site: true
        if is_site = false
            return false
        let nm instlens.routine_name_at(plan_text, fn.loc.start)
        nm = fn.name
    }

    ; The routine's pointer/ref parameters as "\n<name>\n" runs, so membership is
    ; one `contains` and no container has to be threaded through the walk. (An
    ; Array grown through a pointer from a callee is the documented worker-killer:
    ; `Array.add` reallocates via `Page.get(this)` on a receiver that is not
    ; page-hosted — placehints.dedupe# has the account.)
    ;
    ; `PlannedType.name` for a pointer is the bare word "pointer" with the
    ; pointee in `generics[0]` (Planner.get_readable_name#), so this is an exact
    ; test and not a prefix match on a rendered name.
    function pointer_params(rp, fn: PlannedFunction) returns String
    {
        var sb StringBuilder()
        if fn.input = null
            return sb.to_string()
        let items (*fn.input)
        var i: size_t 0
        while i < items.length
        {
            let ip items.get i
            if ip <> null
            {
                let it (*ip)
                if it.name <> null
                {
                    if it.item_type <> null
                    {
                        let ty (*it.item_type)
                        var is_ptr false
                        if ty.name = "pointer"
                            set is_ptr: true
                        if ty.name = "ref"
                            set is_ptr: true
                        if is_ptr
                        {
                            let nm (*it.name)
                            sb.append("\n" as char)
                            sb.append nm
                            sb.append("\n" as char)
                        }
                    }
                }
            }
            set i: i + 1
        }
        sb.to_string()
    }

    procedure collect_impl(sb: ref[StringBuilder], plan: Plan, params: String, impl: PlannedImplementation)
    {
        choose impl
            when action: Action
                storelens.collect_action(sb, plan, params, action)
            when ext: Extern
                0
            when inst: Instruction
                0
            when intr: Intrinsic
                0
    }

    ; The one place that decides. A function BODY is also a PlannedAction, and
    ; so is a for/while/repeat body — all of them target-less, which is what
    ; keeps them out of here without a special case.
    procedure collect_action(sb: ref[StringBuilder], plan: Plan, params: String, act: PlannedAction)
    {
        if act.target <> null
        {
            let param storelens.target_param(act.target, params)
            if param.get_length() > 0
            {
                if storelens.source_settled(act.source) = false
                {
                    let carrier storelens.carrier_of(plan, act.result_type, 0)
                    if carrier.get_length() > 0
                        storelens.emit_site(sb, act.loc.start, param, act.result_type.name, carrier)
                }
            }
        }
        storelens.collect_operands_opt(sb, plan, params, act.source)
        storelens.collect_operands_opt(sb, plan, params, act.target)
    }

    ; True when the store needs no marking because the SOURCE settles the
    ; question on the line itself. Three cases, all exact and all measured:
    ;
    ;   `set *out: StringC^host(...)`     the author pinned it HERE. Whether
    ;                                     `host` outlives the caller is not
    ;                                     something this family can judge, but
    ;                                     the decision has visibly been made and
    ;                                     re-asking is noise. Detected as
    ;                                     Lifetime.Reference, the `^name` life.
    ;   `set *out_id: ExternalId()`       a construction with NO arguments builds
    ;                                     an empty value: String/StringC's
    ;                                     zero-arg init sets `data: null` and
    ;                                     allocates nothing.
    ;   `set *out: Holder(String())`      and therefore, RECURSIVELY, so does a
    ;                                     construction all of whose arguments are
    ;                                     themselves settled. This third case is
    ;                                     not a refinement of the second, it is
    ;                                     the second one level up, and leaving it
    ;                                     out marked a store of an empty Holder
    ;                                     (found by the gate's quiet fixture).
    ;
    ; A CONSTANT settles too — a number or a literal carries no region buffer of
    ; its own. Anything else — a bare name, a call result, a construction with a
    ; non-settled argument — is not settled here and gets its lens.
    ;
    ; The depth cap is a loop guard, for dedupe#'s reason: a plan must not be
    ; able to spin the worker.
    function source_settled(source: ref[Vector[PlannedOperand]]?) returns bool
    {
        if source = null
            return false
        let ops (*source)
        if ops.length <> 1
            return false
        let op ops.get 0
        if op = null
            return false
        let o (*op)
        storelens.operand_settled(o, 0)
    }

    function operand_settled(op: PlannedOperand, depth: int) returns bool
    {
        if depth > 4
            return false
        choose op.expr
            when k: Constant
                return true
            when c: Call
            {
                choose c.life
                    when r: Reference
                        return true
                    else
                        0
                if c.mangled_name.contains("C1E") = false
                    return false
                if c.args = null
                    return true
                let args (*c.args)
                var i: size_t 0
                while i < args.length
                {
                    let ap args.get i
                    if ap = null
                        return false
                    let a (*ap)
                    if storelens.operand_settled(a, depth + 1) = false
                        return false
                    set i: i + 1
                }
                return true
            }
            when t: Tuple
            {
                choose t.life
                    when r: Reference
                        return true
                    else
                        0
                if t.components = null
                    return true
                let comps (*t.components)
                var i: size_t 0
                while i < comps.length
                {
                    let cp comps.get i
                    if cp = null
                        return false
                    let comp (*cp)
                    if comp.value = null
                        return false
                    let vals (*comp.value)
                    if vals.length <> 1
                        return false
                    let vp vals.get 0
                    if vp = null
                        return false
                    let v (*vp)
                    if storelens.operand_settled(v, depth + 1) = false
                        return false
                    set i: i + 1
                }
                return true
            }
            else
                return false
    }

    ; The pointer parameter this store writes THROUGH, or "".
    ;
    ; A `set` target is an lvalue chain — `*p`, `p.f`, `(*p).f`, `p[i].f` — so
    ; ANY Variable in it that names a pointer parameter means the store lands in
    ; that parameter's pointee. Deliberately an over-approximation of the chain
    ; ROOT (which would mean modelling the deref operator's call shape); the only
    ; way it could differ is a pointer parameter used as a SUBSCRIPT, which is
    ; not a thing an index can be.
    function target_param(rp, target: ref[Vector[PlannedOperand]]?, params: String) returns String
    {
        if target = null
            return ""
        let ops (*target)
        var i: size_t 0
        while i < ops.length
        {
            let op ops.get i
            if op <> null
            {
                let hit storelens.param_in_operand((*op), params)
                if hit.get_length() > 0
                    return hit
            }
            set i: i + 1
        }
        ""
    }

    function param_in_operand(rp, op: PlannedOperand, params: String) returns String
    {
        storelens.param_in_expr(op.expr, params)
    }

    ; Only the arms an lvalue chain can be built from are walked: a Variable is
    ; the answer, a Call is the deref/subscript operator (its receiver sits in
    ; the arguments), and an As is a cast. Everything else answers "".
    function param_in_expr(rp, expr: PlannedExpression, params: String) returns String
    {
        choose expr
            when v: Variable
            {
                var probe StringBuilder()
                probe.append("\n" as char)
                probe.append(v.name)
                probe.append("\n" as char)
                let key probe.to_string()
                if params.contains key
                    return String(v.name)
                return ""
            }
            when c: Call
            {
                if c.args = null
                    return ""
                let args (*c.args)
                var i: size_t 0
                while i < args.length
                {
                    let ap args.get i
                    if ap <> null
                    {
                        let hit storelens.param_in_operand((*ap), params)
                        if hit.get_length() > 0
                            return hit
                    }
                    set i: i + 1
                }
                return ""
            }
            when az: As
            {
                if az.value = null
                    return ""
                let v az.value
                return storelens.param_in_operand((*v), params)
            }
            else
                return ""
    }

    ; ====================================================================
    ; Does this type carry a region buffer BY VALUE?
    ;
    ; Answers the buffer type's name ("String" / "StringC") or "". A property
    ; that is itself a pointer/ref is not followed — see the SCOPE note at the
    ; top; the depth cap is a loop guard (a struct cannot contain itself by
    ; value, but a truncated plan must not be able to spin the worker), and it
    ; also bounds the cost, since each level rescans plan.structures.
    ; ====================================================================
    function carrier_of(rp, plan: Plan, ty: PlannedType, depth: int) returns String
    {
        if depth > 4
            return ""
        if ty.name = "String"
            return "String"
        if ty.name = "StringC"
            return "StringC"
        if ty.name = "pointer"
            return ""
        if ty.name = "ref"
            return ""
        if plan.structures = null
            return ""

        let sts (*plan.structures)
        var i: size_t 0
        while i < sts.length
        {
            let sp sts.get i
            if sp <> null
            {
                let st (*sp)
                if storelens.structure_matches(st, ty)
                {
                    let inner storelens.carrier_in_properties(plan, st, depth)
                    if inner.get_length() > 0
                        return inner
                    return ""
                }
            }
            set i: i + 1
        }
        ""
    }

    ; The mangled name is the precise key (it distinguishes two instantiations of
    ; one generic); the readable name is the fallback for a type planned without
    ; one.
    function structure_matches(st: PlannedStructure, ty: PlannedType) returns bool
    {
        if ty.mangled_name.get_length() > 0
            return st.mangled_name = ty.mangled_name
        st.name = ty.name
    }

    function carrier_in_properties(rp, plan: Plan, st: PlannedStructure, depth: int) returns String
    {
        if st.properties = null
            return ""
        let props (*st.properties)
        var i: size_t 0
        while i < props.length
        {
            let pp props.get i
            if pp <> null
            {
                let prop (*pp)
                let inner storelens.carrier_of(plan, prop.prop_type, depth + 1)
                if inner.get_length() > 0
                    return inner
            }
            set i: i + 1
        }
        ""
    }

    ; ====================================================================
    ; The rest of the walk — the arms that only recurse.
    ; ====================================================================

    procedure collect_statement(sb: ref[StringBuilder], plan: Plan, params: String, stmt: PlannedStatement)
    {
        choose stmt
            when a: Action
                storelens.collect_action(sb, plan, params, a)
            when bnd: Binding
                storelens.collect_operands_opt(sb, plan, params, bnd.operation)
            when br: Break
                storelens.collect_operands_opt(sb, plan, params, br.result)
            when ret: Return
                storelens.collect_operands_opt(sb, plan, params, ret.result)
            when th: Throw
                storelens.collect_operands_opt(sb, plan, params, th.result)
            when cont: Continue
                0
    }

    procedure collect_statement_opt(sb: ref[StringBuilder], plan: Plan, params: String, opt: ref[PlannedStatement]?)
    {
        if opt <> null
        {
            let s opt
            storelens.collect_statement(sb, plan, params, (*s))
        }
    }

    procedure collect_operands_opt(sb: ref[StringBuilder], plan: Plan, params: String, opt: ref[Vector[PlannedOperand]]?)
    {
        if opt = null
            return
        let ops (*opt)
        var i: size_t 0
        while i < ops.length
        {
            let op ops.get i
            if op <> null
            {
                let o (*op)
                storelens.collect_expr(sb, plan, params, o.expr)
            }
            set i: i + 1
        }
    }

    procedure collect_operand_opt(sb: ref[StringBuilder], plan: Plan, params: String, opt: ref[PlannedOperand]?)
    {
        if opt <> null
        {
            let o opt
            let v (*o)
            storelens.collect_expr(sb, plan, params, v.expr)
        }
    }

    procedure collect_expr(sb: ref[StringBuilder], plan: Plan, params: String, expr: PlannedExpression)
    {
        choose expr
            when k: Constant
                0
            when ty: Type
                0
            when v: Variable
                0
            when g: GlobalRef
                0
            when c: Call
                storelens.collect_operands_opt(sb, plan, params, c.args)
            when t: Tuple
            {
                if t.components <> null
                {
                    let comps (*t.components)
                    var i: size_t 0
                    while i < comps.length
                    {
                        let cp comps.get i
                        if cp <> null
                        {
                            let comp (*cp)
                            storelens.collect_operands_opt(sb, plan, params, comp.value)
                        }
                        set i: i + 1
                    }
                }
            }
            when mx: Matrix
                0
            when b: Block
            {
                if b.statements <> null
                {
                    let stmts (*b.statements)
                    var i: size_t 0
                    while i < stmts.length
                    {
                        let sp stmts.get i
                        if sp <> null
                            storelens.collect_statement(sb, plan, params, (*sp))
                        set i: i + 1
                    }
                }
            }
            when iff: If
            {
                storelens.collect_operands_opt(sb, plan, params, iff.condition)
                storelens.collect_statement_opt(sb, plan, params, iff.consequent)
                storelens.collect_statement_opt(sb, plan, params, iff.alternative)
            }
            when m: Match
            {
                storelens.collect_operands_opt(sb, plan, params, m.condition)
                if m.branches <> null
                {
                    let brs (*m.branches)
                    var i: size_t 0
                    while i < brs.length
                    {
                        let bp brs.get i
                        if bp <> null
                        {
                            let br (*bp)
                            storelens.collect_statement_opt(sb, plan, params, br.consequent)
                        }
                        set i: i + 1
                    }
                }
                storelens.collect_statement_opt(sb, plan, params, m.alternative)
            }
            when ch: Choose
            {
                storelens.collect_operands_opt(sb, plan, params, ch.condition)
                if ch.cases <> null
                {
                    let cs (*ch.cases)
                    var i: size_t 0
                    while i < cs.length
                    {
                        let wp cs.get i
                        if wp <> null
                        {
                            let w (*wp)
                            storelens.collect_statement_opt(sb, plan, params, w.consequent)
                        }
                        set i: i + 1
                    }
                }
                storelens.collect_statement_opt(sb, plan, params, ch.alternative)
            }
            when fr: For
            {
                storelens.collect_operands_opt(sb, plan, params, fr.expr)
                storelens.collect_action(sb, plan, params, fr.body)
            }
            when wh: While
            {
                storelens.collect_operands_opt(sb, plan, params, wh.cond.operation)
                storelens.collect_action(sb, plan, params, wh.body)
            }
            when rep: Repeat
                storelens.collect_action(sb, plan, params, rep.body)
            when lm: Lambda
                0
            when tr: Try
            {
                storelens.collect_operands_opt(sb, plan, params, tr.cond.operation)
                if tr.catches <> null
                {
                    let cs (*tr.catches)
                    var i: size_t 0
                    while i < cs.length
                    {
                        let wp cs.get i
                        if wp <> null
                        {
                            let w (*wp)
                            storelens.collect_statement_opt(sb, plan, params, w.consequent)
                        }
                        set i: i + 1
                    }
                }
                storelens.collect_statement_opt(sb, plan, params, tr.alternative)
            }
            when so: SizeOf
                0
            when ao: AlignOf
                0
            when iz: Is
                storelens.collect_operand_opt(sb, plan, params, iz.value)
            when az: As
                storelens.collect_operand_opt(sb, plan, params, az.value)
            when vc: VariantConstruction
                storelens.collect_operand_opt(sb, plan, params, vc.value)
    }

    ; ====================================================================
    ; The blob.
    ; ====================================================================

    procedure emit_site(sb: ref[StringBuilder], offset: size_t, param: String, stored: String, carrier: String)
    {
        sb.append(json.format_i64(offset as i64))
        sb.append(0x09 as char)
        sb.append param
        sb.append(0x09 as char)
        sb.append stored
        sb.append(0x09 as char)
        sb.append carrier
        sb.append("\n" as char)
    }

    ; DEDUPE BY OFFSET, as a second pass over the finished blob — a generic body
    ; is planned once per instantiation, so one source store is reached many
    ; times. Same shape and same reason as placehints.dedupe#, including why it
    ; is a second pass over a String rather than a set threaded through the walk.
    function dedupe(rp, blob: String) returns String
    {
        var out StringBuilder()
        let bn blob.get_length()
        var k: size_t 0
        while k < bn
        {
            let line_start k
            while k < bn
            {
                if blob.get(k) = 0x0A
                    break
                set k: k + 1
            }
            let line_end k
            if k < bn
                set k: k + 1
            if line_end > line_start
            {
                let line blob.substring(line_start, line_end - line_start)
                let kept out.to_string()
                if storelens.has_line(kept, line) = false
                {
                    out.append line
                    out.append("\n" as char)
                }
            }
        }
        out.to_string()
    }

    ; Is a line with the same leading OFFSET field already kept?
    function has_line(kept: String, line: String) returns bool
    {
        let tab line.index_of(0x09)
        if tab <= 0
            return false
        let digits line.substring(0, tab as size_t)
        let kn kept.get_length()
        var k: size_t 0
        while k < kn
        {
            let start k
            while k < kn
            {
                if kept.get(k) = 0x0A
                    break
                set k: k + 1
            }
            let end k
            if k < kn
                set k: k + 1
            if end > start
            {
                let ln kept.substring(start, end - start)
                let t ln.index_of(0x09)
                if t > 0
                {
                    let d ln.substring(0, t as size_t)
                    if d = digits
                        return true
                }
            }
        }
        false
    }

    ; ====================================================================
    ; Rendering: one lens per blob line, drawn at the BUFFER's `set` site of the
    ; same index as the plan text's.
    ; ====================================================================
    function render(rp, blob: String, plan_text: String, anchor_text: String) returns String
    {
        var sb StringBuilder()
        var first true
        let bn blob.get_length()
        var k: size_t 0
        while k < bn
        {
            let line_start k
            while k < bn
            {
                if blob.get(k) = 0x0A
                    break
                set k: k + 1
            }
            let line_end k
            if k < bn
                set k: k + 1
            if line_end > line_start
            {
                let line blob.substring(line_start, line_end - line_start)
                let piece storelens.lens_for(line, plan_text, anchor_text)
                if piece.get_length() > 0
                {
                    if first = false
                        sb.append("," as char)
                    symbols.append_fragment(&sb, piece)
                    set first: false
                }
            }
        }
        sb.to_string()
    }

    function lens_for(rp, line: String, plan_text: String, anchor_text: String) returns String
    {
        let offset storelens.field_at(line, 0)
        let param storelens.field_at(line, 1)
        let stored storelens.field_at(line, 2)
        let carrier storelens.field_at(line, 3)
        if param.get_length() = 0
            return ""

        let want storelens.parse_size offset
        let idx storelens.set_index_at(plan_text, want)
        if idx < 0
            return ""
        let at storelens.set_site_at_index(anchor_text, idx)
        if at >= anchor_text.get_length()
            return ""

        var title StringBuilder()
        title.append "writes "
        title.append stored
        if stored <> carrier
        {
            title.append " (carries "
            title.append carrier
            title.append ")"
        }
        title.append " through '"
        title.append param
        title.append "' - no page parameter here, so its buffer cannot be pinned"
        let t title.to_string()
        ; 3 == length of "set"
        symbols.lens_object(anchor_text, at, 3, t, "", "")
    }

    ; The n-th TAB-separated field of `line`, or "".
    function field_at(rp, line: String, n: size_t) returns String
    {
        let len line.get_length()
        var field: size_t 0
        var start: size_t 0
        var k: size_t 0
        while k <= len
        {
            var at_end false
            if k = len
                set at_end: true
            else
            {
                if line.get(k) = 0x09
                    set at_end: true
            }
            if at_end
            {
                if field = n
                {
                    if k <= start
                        return ""
                    return line.substring(start, k - start)
                }
                set field: field + 1
                set start: k + 1
            }
            set k: k + 1
        }
        ""
    }

    function parse_size(digits: String) returns size_t
    {
        let n digits.get_length()
        var v: size_t 0
        var k: size_t 0
        while k < n
        {
            let c digits.get k
            if c < 0x30
                return v
            if c > 0x39
                return v
            set v: v * 10 + ((c - 0x30) as size_t)
            set k: k + 1
        }
        v
    }

    ; ====================================================================
    ; The `set`-site scanner. `set` is a keyword with exactly one use in the
    ; language, so a `set` TOKEN in code always opens an assignment — no parse
    ; needed, which is what keeps the pairing usable on a buffer that does not
    ; parse. Comments and string literals are skipped wholesale
    ; (symbols.skip_noncode#), exactly as tasklens.scaly's `for` scan does, and
    ; for the same reason: a "set" inside a comment would shift every later
    ; index by one.
    ; ====================================================================

    function next_set_site(source: String, from: size_t) returns size_t
    {
        let len source.get_length()
        var k from
        while k < len
        {
            let c source.get k
            if symbols.is_noncode_start c
            {
                set k: symbols.skip_noncode(source, k, len)
                continue
            }
            if c = ("s" as char)
            {
                if storelens.is_set_token(source, k, len)
                    return k
            }
            set k: k + 1
        }
        len
    }

    function count_set_sites(source: String) returns size_t
    {
        let len source.get_length()
        var n: size_t 0
        var k: size_t 0
        while k < len
        {
            set k: storelens.next_set_site(source, k)
            if k >= len
                return n
            set n: n + 1
            set k: k + 3
        }
        n
    }

    ; The index of the `set` site at or before `offset`, or -1 when the offset
    ; precedes every one of them.
    function set_index_at(source: String, offset: size_t) returns int
    {
        let len source.get_length()
        var idx: int 0 - 1
        var n: int 0
        var k: size_t 0
        while k < len
        {
            set k: storelens.next_set_site(source, k)
            if k >= len
                return idx
            if k > offset
                return idx
            set idx: n
            set n: n + 1
            set k: k + 3
        }
        idx
    }

    function set_site_at_index(source: String, idx: int) returns size_t
    {
        let len source.get_length()
        var n: int 0
        var k: size_t 0
        while k < len
        {
            set k: storelens.next_set_site(source, k)
            if k >= len
                return len
            if n = idx
                return k
            set n: n + 1
            set k: k + 3
        }
        len
    }

    ; Is source[k..] the keyword `set` on both token boundaries? A bare `set` at
    ; EOF is not an assignment (it needs a target), so k+3 must exist.
    function is_set_token(source: String, k: size_t, len: size_t) returns bool
    {
        if k + 3 >= len
            return false
        let c1 source.get(k + 1)
        if c1 <> ("e" as char)
            return false
        let c2 source.get(k + 2)
        if c2 <> ("t" as char)
            return false
        let c3 source.get(k + 3)
        if symbols.is_ident_byte c3
            return false
        if k > 0
        {
            let c0 source.get(k - 1)
            if symbols.is_ident_byte c0
                return false
        }
        true
    }
}
