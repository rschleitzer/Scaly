; json.scaly - A minimal JSON value tree, parser and serializer.
;
; Scope: enough JSON for LSP / JSON-RPC traffic. Numbers are stored as
; i64 (LSP positions and ids are integers); a fractional/exponent part is
; parsed and discarded (the integer part is kept). String escapes are
; handled on read AND write: " \ / and the control escapes b f n r t,
; plus \uXXXX decoded to the UTF-8 encoding of its codepoint, surrogate
; pairs included.
;
; LAYOUT NOTE: the array/object children are held in non-generic structs
; (JsonArray / JsonObject = count + raw pointer) rather than
; Vector[JsonValue] — a recursive union whose layout pulled in a generic
; instantiation would need that generic planned in every consuming
; package. The Array/Object variants embed those structs BY VALUE (16B),
; so JsonValue's payload is 16 bytes. A consuming package that imports
; only JsonValue (not JsonArray/JsonObject) sizes the union correctly
; anyway: the compiler's layout path resolves a cross-package by-value
; field/variant type from the raw concept registry regardless of `use`
; visibility (Planner.lookup_concept_for_layout). Before that fix these
; variants had to be held by pointer (8B) to keep the union the same
; size in every consumer — that workaround is no longer needed.
;
; PAYLOADLESS-VARIANT NOTE: every variant carries a payload (Null wraps an
; empty JsonNull). A BARE payloadless variant value (`JsonValue.Null`)
; emits fine intra-package but is read as a TYPE, not a value, when the
; union comes from another package ("cannot be used as a value"). The
; compiler's own unions follow the same rule — e.g. Lifetime.Unspecified
; wraps an Unspecified() struct rather than being bare.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE and has
; no else (it desugars to an `if` with no alternative). Real branching
; uses if/else. Every if below is the true-runs-the-body form.

use scaly.memory.runtime

; Empty payload for the Null variant (see PAYLOADLESS-VARIANT NOTE).
define JsonNull ()

; A contiguous run of JsonValues / JsonMembers as a view (length + buffer);
; an empty array / object holds the empty view.
define JsonArray (items: Slice[JsonValue])
define JsonMember (key: String, value: JsonValue)
define JsonObject (members: Slice[JsonMember])

define JsonValue union
(
    Null: JsonNull
    Bool: bool
    Number: i64
    Str: String
    Array: JsonArray
    Object: JsonObject
)

; Cursor over the source text. `ok` latches false on the first parse
; error; a malformed document still yields a well-formed (if truncated)
; JsonValue rather than throwing.
define JsonParser
(
    source: String
    pos: size_t
    ok: bool
)

define json
{
    ; ====================================================================
    ; Construction helpers (value position)
    ; ====================================================================

    function null_value() returns JsonValue
        JsonValue.Null(JsonNull())

    function bool_value(b: bool) returns JsonValue
        JsonValue.Bool b

    function number_value(n: i64) returns JsonValue
        JsonValue.Number n

    function string_value(s: String) returns JsonValue
        JsonValue.Str s

    ; ====================================================================
    ; Accessors
    ; ====================================================================

    function is_null(this: JsonValue) returns bool
    {
        choose this
            when n: Null
                true
            else
                false
    }

    function as_i64(this: JsonValue) returns i64
    {
        choose this
            when n: Number
                n
            else
                0
    }

    function as_bool(this: JsonValue) returns bool
    {
        choose this
            when b: Bool
                b
            else
                false
    }

    ; Returns a copy of the string payload, or an empty String otherwise.
    function as_string(rp, this: JsonValue) returns String
    {
        choose this
            when s: Str
                String(s)
            else
                String()
    }

    function array_length(this: JsonValue) returns size_t
    {
        choose this
            when arr: Array
                arr.items.length
            else
                0 as size_t
    }

    ; Element i of an array, or Null when out of range / not an array.
    ; The returned value aliases the tree (no deep copy).
    function array_get(this: JsonValue, i: size_t) returns JsonValue
    {
        choose this
            when arr: Array
            {
                if i >= arr.items.length
                    return JsonValue.Null(JsonNull())

                arr.items[i]
            }
            else
                json.null_value()
    }

    ; Look up a member of an object by key. Returns Null when the value is
    ; not an object or the key is absent.
    ; A String member key against a `Slice[char]` literal, byte for byte, no allocation.
    function key_equals(s: String, k: Slice[char]) returns bool
    {
        if s.get_length() <> k.length
            return false
        var i: size_t 0
        while i < k.length
        {
            if s.get(i) <> (k[i] as u8)
                return false
            set i: i + 1
        }
        true
    }

    function get(this: JsonValue, key: Slice[char]) returns JsonValue
    {
        choose this
            when obj: Object
            {
                var i: size_t 0
                while i < obj.members.length
                {
                    let mm obj.members[i]
                    if json.key_equals(mm.key, key)
                        return mm.value

                    set i: i + 1
                }
                json.null_value()
            }
            else
                json.null_value()
    }

    ; ====================================================================
    ; Parsing
    ; ====================================================================

    function parse(rp, source: String) returns JsonValue
    {
        var p JsonParser(source, 0, true)
        json.parse_value(&p)
    }

    function parse_value(rp, p: ref[JsonParser]) returns JsonValue
    {
        json.skip_ws p
        let c json.peek p
        if c = 0
        {
            set p.ok: false
            return JsonValue.Null(JsonNull())
        }

        if c = 0x7B             ; '{'
            return json.parse_object p

        if c = 0x5B             ; '['
            return json.parse_array p

        if c = 0x22             ; '"'
            return JsonValue.Str(json.parse_string(p))

        if json.match_literal(p, "true")
            return JsonValue.Bool true

        if json.match_literal(p, "false")
            return JsonValue.Bool false

        if json.match_literal(p, "null")
            return JsonValue.Null(JsonNull())

        if json.is_digit(c) || (c = 0x2D)   ; digit or '-'
            return JsonValue.Number(json.parse_number p)

        set p.ok: false
        json.null_value()
    }

    function parse_object(rp, p: ref[JsonParser]) returns JsonValue
    {
        json.expect(p, 0x7B)         ; '{'
        json.skip_ws p

        var members List[JsonMember]()
        var count: size_t 0

        if json.peek(p) = 0x7D     ; empty object '}'
            json.advance p
        else
        {
            while true
            {
                json.skip_ws p
                let key json.parse_string p
                json.skip_ws p
                json.expect(p, 0x3A) ; ':'
                let value json.parse_value p
                members.add(JsonMember(key, value))
                set count: count + 1
                json.skip_ws p

                let sep json.peek p
                if sep <> 0x2C  ; not ',' -> object ends
                {
                    json.expect(p, 0x7D)
                    break
                }
                json.advance p            ; consume ','
            }
        }

        ; Materialize the List into a contiguous, order-preserving buffer.
        if count = 0
            return JsonValue.Object(JsonObject(null))

        let buf allocate_slice[JsonMember](rp as ref[Page], count)
        var it members.get_iterator()
        var i: size_t 0
        while let m it.next()
        {
            buf.put(i, *m)
            set i: i + 1
        }
        JsonValue.Object(JsonObject(buf))
    }

    function parse_array(rp, p: ref[JsonParser]) returns JsonValue
    {
        json.expect(p, 0x5B)         ; '['
        json.skip_ws p

        var items List[JsonValue]()
        var count: size_t 0

        if json.peek(p) = 0x5D     ; empty array ']'
            json.advance p
        else
        {
            while true
            {
                let value json.parse_value p
                items.add value
                set count: count + 1
                json.skip_ws p

                let sep json.peek p
                if sep <> 0x2C  ; not ',' -> array ends
                {
                    json.expect(p, 0x5D)
                    break
                }
                json.advance p            ; consume ','
            }
        }

        if count = 0
            return JsonValue.Array(JsonArray(null))

        let buf allocate_slice[JsonValue](rp as ref[Page], count)
        var it items.get_iterator()
        var i: size_t 0
        while let e it.next()
        {
            buf.put(i, *e)
            set i: i + 1
        }
        JsonValue.Array(JsonArray(buf))
    }

    function parse_string(rp, p: ref[JsonParser]) returns String
    {
        if json.peek(p) <> 0x22   ; must open with '"'
        {
            set p.ok: false
            return String()
        }

        json.advance p                    ; opening quote
        var sb StringBuilder()

        while true
        {
            let c json.peek p
            if c = 0            ; EOF before close
            {
                set p.ok: false
                return sb.to_string()
            }

            if c = 0x22         ; closing quote
            {
                json.advance p
                return sb.to_string()
            }

            if c = 0x5C            ; backslash escape
            {
                json.advance p            ; consume backslash
                let e json.peek p
                json.advance p            ; consume escape char
                if e = 0x75         ; 'u' — one to four bytes, so not a char
                    json.append_utf8(&sb, json.read_unicode_escape(p))
                else
                    sb.append(json.decode_escape(e))
            }
            else
            {
                sb.append(c as char)
                json.advance p
            }
        }

        sb.to_string()
    }

    ; Maps a single-byte escape letter to its byte. `\u` is NOT handled here
    ; and cannot be: its codepoint encodes to one to four bytes and this
    ; answers a char — parse_string routes it to read_unicode_escape# +
    ; append_utf8# instead.
    function decode_escape(e: u8) returns char
    {
        if e = 0x6E             ; 'n'
            return "\n" as char

        if e = 0x74             ; 't'
            return "\t" as char

        if e = 0x72             ; 'r'
            return "\r" as char

        if e = 0x62             ; 'b'
            return 8 as char

        if e = 0x66             ; 'f'
            return 12 as char

        ; default: \" \\ \/ map to themselves
        e as char
    }

    ; Reads the four hex digits of a \uXXXX escape at the cursor (the `u` is
    ; already consumed) and advances past them.
    function read_hex4(p: ref[JsonParser]) returns i64
    {
        var value: i64 0
        var k 0
        while k < 4
        {
            let h json.peek p
            json.advance p
            set value: (value * 16) + json.hex_value(h)
            set k: k + 1
        }
        value
    }

    ; Reads a \uXXXX escape and answers its CODEPOINT, joining a
    ; surrogate PAIR (\uD83D\uDE00) into the one codepoint it denotes.
    ; A lone surrogate — which no well-formed document can mean — answers
    ; U+FFFD, so the encoding downstream stays well-formed.
    function read_unicode_escape(p: ref[JsonParser]) returns i64
    {
        let hi json.read_hex4 p
        if hi < 0xD800
            return hi
        if hi > 0xDFFF
            return hi
        if hi > 0xDBFF
            return 0xFFFD             ; a low surrogate with no high one

        ; A high surrogate: take the next escape only if it is the matching
        ; low one, and leave the cursor untouched otherwise — the `\u` may
        ; belong to an ordinary escape that has to be read as itself.
        let save p.pos
        if json.peek(p) <> 0x5C
            return 0xFFFD
        json.advance p
        if json.peek(p) <> 0x75
        {
            set p.pos: save
            return 0xFFFD
        }
        json.advance p
        let lo json.read_hex4 p
        if lo < 0xDC00
        {
            set p.pos: save
            return 0xFFFD
        }
        if lo > 0xDFFF
        {
            set p.pos: save
            return 0xFFFD
        }
        (0x10000 + ((hi - 0xD800) * 0x400)) + (lo - 0xDC00)
    }

    ; Appends the UTF-8 encoding of `cp` to `sb`.
    ;
    ; ★This is what makes the decoded buffer BYTE-FOR-BYTE the document. The
    ; old decoder answered one `?` for anything above 0x7F, so a client that
    ; escapes non-ASCII (JSON allows it; python's json.dumps does it by
    ; DEFAULT) delivered a buffer SHORTER than the file — measured on
    ; server.scaly, 60440 against 60526 bytes over 43 `★`/`—` — and from the
    ; first hit onwards EVERY offset was wrong: diagnostics, hover, all of it.
    ; A length that merely looks plausible is the failure mode, so the gate in
    ; tests/lsp/run.sh checks the BYTE COUNT, not only the content.
    procedure append_utf8(sb: ref[StringBuilder], cp: i64)
    {
        if cp < 0x80
        {
            sb.append(cp as char)
            return
        }
        if cp < 0x800
        {
            sb.append((0xC0 | (cp >> 6)) as char)
            sb.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        if cp < 0x10000
        {
            sb.append((0xE0 | (cp >> 12)) as char)
            sb.append((0x80 | ((cp >> 6) & 0x3F)) as char)
            sb.append((0x80 | (cp & 0x3F)) as char)
            return
        }
        sb.append((0xF0 | (cp >> 18)) as char)
        sb.append((0x80 | ((cp >> 12) & 0x3F)) as char)
        sb.append((0x80 | ((cp >> 6) & 0x3F)) as char)
        sb.append((0x80 | (cp & 0x3F)) as char)
    }

    function parse_number(p: ref[JsonParser]) returns i64
    {
        var negative false
        if json.peek(p) = 0x2D  ; '-'
        {
            set negative: true
            json.advance p
        }

        var value: i64 0
        while json.is_digit(json.peek p)
        {
            set value: (value * 10) + ((json.peek(p) - 0x30) as i64)
            json.advance p
        }

        ; Discard a fractional/exponent part (integer part kept).
        if json.peek(p) = 0x2E  ; '.'
        {
            json.advance p
            while json.is_digit(json.peek p)
                json.advance p
        }

        if negative
            return 0 - value

        value
    }

    ; ====================================================================
    ; Low-level cursor helpers
    ; ====================================================================

    function peek(p: ref[JsonParser]) returns u8
    {
        if p.pos >= p.source.get_length()
            return 0 as u8

        p.source.get p.pos
    }

    function advance(p: ref[JsonParser])
        set p.pos: p.pos + 1

    function skip_ws(p: ref[JsonParser])
    {
        ; space 0x20, tab 0x09, LF 0x0A, CR 0x0D
        var c json.peek p
        while (c = 0x20) || (c = 0x09) || (c = 0x0A) || (c = 0x0D)
        {
            json.advance p
            set c: json.peek p
        }
    }

    function expect(p: ref[JsonParser], c: u8)
    {
        if json.peek(p) = c
        {
            json.advance p
            return
        }
        set p.ok: false
    }

    function is_digit(c: u8) returns bool
        (c >= 0x30) && (c <= 0x39)

    function hex_value(c: u8) returns i64
    {
        if (c >= 0x30) && (c <= 0x39)     ; 0-9
            return (c - 0x30) as i64

        if (c >= 0x61) && (c <= 0x66)     ; a-f
            return ((c - 0x61) + 10) as i64

        if (c >= 0x41) && (c <= 0x46)     ; A-F
            return ((c - 0x41) + 10) as i64

        0
    }

    ; Matches `lit` at the cursor; advances past it and returns true on a
    ; hit, leaves the cursor untouched and returns false on a miss.
    function match_literal(p: ref[JsonParser], lit: Slice[char]) returns bool
    {
        let len lit.length
        var i: size_t 0
        while i < len
        {
            if (p.pos + i) >= p.source.get_length()
                return false

            if p.source.get(p.pos + i) <> (lit[i] as u8)
                return false

            set i: i + 1
        }
        set p.pos: p.pos + len
        true
    }

    ; ====================================================================
    ; Serialization
    ;
    ; Recursive: each level builds its own StringBuilder and the recursion
    ; returns String pieces (a StringBuilder does not propagate when passed
    ; across a function boundary). This relies on two stage-0 planner fixes
    ; (s197): a method call on a call result with a lifetime — e.g.
    ; sb.append(json.format_i64(n)) is fine, but `expr(x).to_c_string$()`
    ; was dropped — and a recursive namespace call whose first param is
    ; named `this` (json.stringify(...) calling itself). Both are now
    ; handled; see Planner.cpp processChainedMethodCalls + the namespace
    ; sibling arg-count match.
    ; ====================================================================

    function stringify(rp, this: JsonValue) returns String
    {
        ; Every arm uses an explicit `return`: in a choose that mixes
        ; explicit-return arms with bare-expression arms, the bare arms
        ; yield an empty/dropped value under stage-0.
        choose this
            when nul: Null
                return "null"
            when b: Bool
            {
                if b
                    return "true"
                return "false"
            }
            when n: Number
                return json.format_i64 n
            when s: Str
                return json.quote_string s
            when arr: Array
            {
                var sb StringBuilder()
                sb.append("[" as char)    ; '['
                var i: size_t 0
                while i < arr.items.length
                {
                    if i > 0
                        sb.append("," as char)       ; ','

                    sb.append(json.stringify(arr.items[i]))
                    set i: i + 1
                }
                sb.append("]" as char)    ; ']'
                return sb.to_string()
            }
            when obj: Object
            {
                var sb StringBuilder()
                sb.append("{" as char)    ; '{'
                var i: size_t 0
                while i < obj.members.length
                {
                    if i > 0
                        sb.append("," as char)

                    let mm obj.members[i]
                    sb.append(json.quote_string(mm.key))
                    sb.append(":" as char)           ; ':'
                    sb.append(json.stringify(mm.value))
                    set i: i + 1
                }
                sb.append("}" as char)    ; '}'
                return sb.to_string()
            }
            else
                return "null"
    }

    ; Quote and escape a string into a "..."-wrapped JSON string literal.
    function quote_string(rp, s: String) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)            ; opening '"'
        let len s.get_length()
        var i: size_t 0
        while i < len
        {
            let c s.get i
            if c = 0x22            ; '"'
            {
                sb.append("\\" as char)
                sb.append("\"" as char)
            }
            else
            {
                if c = 0x5C        ; '\'
                {
                    sb.append("\\" as char)
                    sb.append("\\" as char)
                }
                else
                {
                    if c = 0x0A    ; LF
                    {
                        sb.append("\\" as char)
                        sb.append("n" as char)       ; 'n'
                    }
                    else
                    {
                        if c = 0x0D    ; CR
                        {
                            sb.append("\\" as char)
                            sb.append("r" as char)   ; 'r'
                        }
                        else
                        {
                            if c = 0x09    ; tab
                            {
                                sb.append("\\" as char)
                                sb.append("t" as char)   ; 't'
                            }
                            else
                                sb.append(c as char)
                        }
                    }
                }
            }
            set i: i + 1
        }
        sb.append("\"" as char)            ; closing '"'
        sb.to_string()
    }

    function format_i64(rp, n: i64) returns String
    {
        if n = 0
            return "0"

        var sb StringBuilder()
        var value n
        if value < 0
        {
            sb.append("-" as char)        ; '-'
            set value: 0 - value
        }

        ; Collect digits least-significant first, then emit reversed.
        var digits Array[char]()
        while value > 0
        {
            let digit ((value % 10) as char) + ("0" as char)
            digits.add digit
            set value: value / 10
        }

        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                sb.append(*d)
        }
        sb.to_string()
    }
}
