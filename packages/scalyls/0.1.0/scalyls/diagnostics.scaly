; diagnostics.scaly - Run a document's text through the Scaly compiler
; pipeline (parse -> model -> plan; no emitter) and turn the collected
; errors into an LSP textDocument/publishDiagnostics notification.
;
; Sources of diagnostics (mirrors cli.run#'s --plan path):
;   * parser ParserError.Invalid  -> one diagnostic at its byte offset
;   * planner.diagnostics         -> the hard, would-be-dropped resolutions
; The advisory planner.errors array is intentionally ignored (it fires
; thousands of times benignly during a normal compile).
;
; A parse error no longer ENDS the report: the semantic half still runs, from
; disk for a package member and over a repaired buffer for a standalone
; document. broken_buffer_report# has both routes and the one thing that
; was deliberately left out.
;
; Envelope:
;   {"jsonrpc":"2.0","method":"textDocument/publishDiagnostics",
;    "params":{"uri":<uri>,"diagnostics":[ <diag>... ]}}
; Each <diag>:
;   {"range":{"start":{"line":L,"character":C},
;             "end":{"line":L,"character":C}},
;    "severity":1,"message":<msg>}
; LSP line/character are 0-based (one less than cli's 1-based report).
;
; ★THE REPLY IS A LIST, one notification per LINE. A package member is planned
; through its ROOT (package_report#), so the planner answers for EVERY module of
; that root in one pass — and the answer for every module but the open one used
; to be computed and thrown away by a `dp.file = path` filter. A file that is not
; open in the editor then reported nothing, although its diagnostics were already
; in hand. So the reply now carries the open document's notification FIRST and
; one notification per sibling module after it, and server.write_notifications#
; writes each as its own frame.
;
; LF is a safe separator because json.quote_string# escapes 0x0A to `\n`: no
; notification we build can contain a raw one. Paths cannot either.
;
; ★CLEAN SIBLINGS ARE REPORTED TOO, with an EMPTY diagnostics array, and that is
; the whole reason no state is needed anywhere: LSP diagnostics are owned by the
; server until it says otherwise, so a fixed error must be cleared explicitly. The
; alternative — remembering which files were last reported and diffing — puts a
; second, mutable copy of that answer in the parent, where a worker respawn or a
; server restart makes it wrong. The price is one small notification per module of
; the root per typing burst; the largest root in this tree has 58 files (~9 KB),
; against an analysis that costs 0.45-2.45 s, so the message volume is not the
; term that matters.
;
; ★WHAT THIS DOES NOT REACH: the planner is DEMAND-DRIVEN. A routine nothing calls
; is never planned, so it yields no diagnostics — in a sibling exactly as in the
; open document. This is not a limit of the fan-out; it is the same limit the
; single-file report always had, seen across more files.
;
; STRING/JSON NOTE: outgoing JSON uses a local StringBuilder appended in
; place; nested pieces come from String-returning helpers (a StringBuilder
; passed to a callee to mutate does not propagate). Quotes are 0x22 bytes.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line. `choose *ptr` does not parse — bind the
; deref to a local first.

use scaly.memory.runtime
use scaly.os.File
use scaly.os.Path
use scalyls.json
use scalyls.symbols

; Compiler pipeline (scalyc package).
use scalyc.compiler.parser
use scalyc.compiler.Modeler
use scalyc.compiler.Planner
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyc.compiler.Planner.*
use scalyc.compiler.FunctionIndex.*
use scalyc.compiler.ConceptIndex.*

define diagnostics
{
    ; Build a publishDiagnostics notification for `uri` from `text`.
    procedure publish_diagnostics(rp, mutable uri: String, mutable text: String) returns String mutable modeler_error_count
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(diagnostics.key("jsonrpc"))
        sb.append(diagnostics.quoted("2.0"))
        sb.append("," as char)
        sb.append(diagnostics.key("method"))
        sb.append(diagnostics.quoted("textDocument/publishDiagnostics"))
        sb.append("," as char)
        sb.append(diagnostics.key("params"))
        sb.append("{" as char)                    ; params {
        sb.append(diagnostics.key("uri"))
        sb.append(json.quote_string(uri))
        sb.append("," as char)
        sb.append(diagnostics.key("diagnostics"))
        sb.append("[" as char)

        ; `first` gates the comma separator between diagnostic objects.
        var first true
        let path diagnostics.strip_uri uri

        ; The sibling notifications, LF-separated, appended after this
        ; document's own envelope (see the header). Empty for a standalone
        ; document, which has no root and therefore no siblings.
        var extra String("")

        var p parser.Parser(text)
        choose p.parse_program()
            when err: Error
            {
                ; Surface the parse error — and then KEEP GOING. Stopping here
                ; ("the parse error IS the answer") meant a single unfinished
                ; line hid every semantic diagnostic in the document, and an
                ; unfinished line is the normal state of a buffer being typed
                ; into: a type error was invisible until the file parsed again.
                ; broken_buffer_report# supplies the rest.
                choose err
                    when i: Invalid
                    {
                        sb.append(diagnostics.diag_object(text, i.start, i.message))
                        set first: false
                    }
                    when d: Different
                    {
                        sb.append(diagnostics.diag_object(text, 0, "unexpected top-level construct"))
                        set first: false
                    }

                let report diagnostics.broken_buffer_report(path, text)
                let body diagnostics.report_head report
                if body.get_length() > 0
                {
                    if first = false
                        sb.append("," as char)
                    sb.append body
                    set first: false
                }
                set extra: diagnostics.report_tail report
            }
            when program: Success
            {
                ; A file that BELONGS TO A PACKAGE cannot be planned on its
                ; own. Modeling the bare document builds a one-module program,
                ; so every name defined in a SIBLING module of the same package
                ; is simply absent and each call to one is reported as
                ; "function not found" — a false positive, and a flood of them:
                ; opensp/Dtd.scaly produced 56 while the package itself
                ; compiles clean. The file's own `use opensp.StringC.StringC`
                ; clauses cannot help, because the module they name was never
                ; walked. Names from the file itself and from the prelude
                ; resolve, which is what makes the failure look selective.
                ;
                ; So plan through the package ROOT instead, and keep only the
                ; diagnostics that belong to THIS file (PlannerDiagnostic
                ; carries its file for exactly this reason). A standalone
                ; program has no root and keeps the buffer-based path below.
                let root diagnostics.package_root path
                if root.get_length() > 0
                {
                    let report diagnostics.package_report(root, path)
                    let body diagnostics.report_head report
                    if body.get_length() > 0
                    {
                        if first = false
                            sb.append("," as char)
                        sb.append body
                        set first: false
                    }
                    set extra: diagnostics.report_tail report
                }
                if root.get_length() = 0
                {
                    let prog_name "document"
                    let model Modeler.build_program(path, prog_name, program, true)

                    var planner Planner.Planner(path)
                    diagnostics.register_packages(&planner, &model)
                    let plan planner.plan_program model

                    ; ★A PROGRAM ROOT is a standalone document that still has
                    ; MODULES — `define app { module util }` reads util.scaly
                    ; from disk — so this plan answers for more than one file
                    ; here too, and the `dp.file` filter is not optional: without
                    ; it a diagnostic from a module was rendered at ITS byte
                    ; offset in THIS buffer, i.e. under an unrelated line of a
                    ; file that is perfectly fine. Measured on a two-module
                    ; probe: `unknown type` in util.scaly appeared on line 8 of
                    ; the root. The sibling half below is where it belongs.
                    var di: size_t 0
                    while di < planner.diagnostics.length
                    {
                        let dp planner.diagnostics.get di
                        if dp <> null
                        {
                            if dp.file = path
                            {
                                if first = false
                                    sb.append("," as char)

                                sb.append(diagnostics.diag_object(text, dp.start, dp.message))
                                set first: false
                            }
                        }
                        set di: di + 1
                    }

                    set extra: diagnostics.sibling_notifications(&model.module_, path, path, &planner)
                }
            }

        sb.append("]" as char)
        sb.append("}" as char)                    ; } params
        sb.append("}" as char)                    ; } root

        ; The sibling notifications follow, one per line.
        if extra.get_length() > 0
        {
            sb.append("\n" as char)
            sb.append extra
        }
        sb.to_string()
    }

    ; Build a publishDiagnostics notification with an EMPTY diagnostics
    ; array for `uri` — used on textDocument/didClose to clear any
    ; diagnostics the editor is still showing for a now-closed document.
    ; Same envelope as publish_diagnostics#, minus the compiler pipeline.
    function clear_diagnostics(rp, uri: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(diagnostics.key("jsonrpc"))
        sb.append(diagnostics.quoted("2.0"))
        sb.append("," as char)
        sb.append(diagnostics.key("method"))
        sb.append(diagnostics.quoted("textDocument/publishDiagnostics"))
        sb.append("," as char)
        sb.append(diagnostics.key("params"))
        sb.append("{" as char)                    ; params {
        sb.append(diagnostics.key("uri"))
        sb.append(json.quote_string(uri))
        sb.append("," as char)
        sb.append(diagnostics.key("diagnostics"))
        sb.append("[" as char)
        sb.append("]" as char)
        sb.append("}" as char)                    ; } params
        sb.append("}" as char)                    ; } root
        sb.to_string()
    }

    ; The package root file that owns `path` as a (possibly nested) module,
    ; or "" when `path` is not a package member.
    ;
    ; A module file at <dir>/<name>.scaly is owned by <dir>.scaly — the module
    ; declarations of X.scaly resolve against the sibling directory X/ (see
    ; Modeler.build_program's ns_path join). So walking up means: take the
    ; directory, append ".scaly", and keep going while that file exists.
    ; packages/opensp/0.1.0/opensp/Dtd.scaly -> packages/opensp/0.1.0/opensp.scaly
    ; and no further, since packages/opensp/0.1.0.scaly does not exist.
    ;
    ; The depth bound is a loop guard, not a semantic limit: nesting in this
    ; tree is 2 (scalyc/compiler/Planner.scaly), and a symlink cycle in the
    ; path must not be able to spin the worker.
    procedure package_root(rp, mutable path: String) returns String
    {
        var found String("")
        var current: String path
        var depth 0
        while depth < 16
        {
            let dir Path.get_directory_name(current)
            if dir.get_length() = 0
                return found

            var sb StringBuilder()
            sb.append dir
            sb.append ".scaly"
            let candidate sb.to_string()

            if File.exists(candidate) = false
                return found

            set found: candidate
            set current: candidate
            set depth: depth + 1
        }
        found
    }

    ; The program name the compiler would use for `root`: its file name minus
    ; the .scaly extension (mirrors cli.extract_program_name#).
    ;
    ; It NAMES THE ROOT MODULE, so it is part of every module path the strict
    ; use-visibility check compares against. Passing a placeholder is not
    ; cosmetic: the sibling modules load and their names resolve, but every one
    ; of them reports as `defined in <placeholder>.opensp.StringC but not
    ; visible here` because the file's own `use opensp.StringC.StringC` cannot
    ; match a path with a foreign root segment. The false positives change
    ; wording and stay.
    procedure root_program_name(rp, mutable root: String) returns String
    {
        let base Path.get_file_name(root)
        let len base.get_length()

        ; 6 == length of ".scaly"
        var cut: size_t 0
        if len > 6
        {
            let tail base.substring(len - 6, 6)
            if tail = ".scaly"
                set cut: len - 6
        }
        if cut = 0
            return base

        ; Trailing implicit return: an explicit `return base.substring(...)`
        ; trips the escape checker's return-of-page-call false positive (see
        ; strip_uri# for the same shape).
        base.substring(0, cut)
    }

    ; Planner diagnostics for the whole package root `root`, obtained by planning
    ; it once so that sibling modules resolve.
    ;
    ; Returns a REPORT: the comma-separated diagnostic objects for `path` (no
    ; enclosing brackets), then — separated by LF — one complete
    ; publishDiagnostics notification per OTHER module file of the root, clean
    ; ones included (empty array). report_head#/report_tail# split it; the header
    ; has the reasoning for both halves.
    ;
    ; SAVED-STATE NOTE: the modeler reads every module from DISK, so the byte
    ; offsets these diagnostics carry are relative to the SAVED text of `path`
    ; — they are mapped to line/character with that same text, never with the
    ; editor buffer, or an unsaved edit would shift every reported line. The
    ; consequence is that semantic diagnostics for a package member reflect the
    ; file as last saved. That is the same bargain symindex.scaly already
    ; documents for workspace/symbol ("unsaved editor edits, which never touch
    ; disk, are not reflected"). Parse errors are unaffected: publish_
    ; diagnostics# still takes those from the live buffer.
    procedure package_report(rp, mutable root: String, path: String) returns String mutable modeler_error_count
    {
        var sb StringBuilder()

        ; The sibling notifications. Built in the same pass as `sb`, from the
        ; same plan — a second plan for them would cost what the whole feature
        ; is supposed to be free of.
        var extra StringBuilder()

        ; The document as the planner saw it. Empty = unreadable; nothing can
        ; be said about offsets into a text we do not have.
        let disk File.read_to_string(path)
        if disk.get_length() = 0
            return sb.to_string()

        let root_text File.read_to_string(root)
        if root_text.get_length() = 0
            return sb.to_string()

        var first true
        var p parser.Parser(root_text)
        choose p.parse_program()
            when err: Error
            {
                ; The package root itself does not parse. Nothing to report
                ; against THIS document — its own parse errors were already
                ; taken from the buffer by publish_diagnostics#.
            }
            when program: Success
            {
                let prog_name diagnostics.root_program_name(root)
                let model Modeler.build_program(root, prog_name, program, true)

                var planner Planner.Planner(root)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model

                var di: size_t 0
                while di < planner.diagnostics.length
                {
                    let dp planner.diagnostics.get di
                    if dp <> null
                    {
                        ; Keep only what belongs to this document; the other
                        ; modules' offsets are in their own coordinate space.
                        if dp.file = path
                        {
                            if first = false
                                sb.append("," as char)

                            sb.append(diagnostics.diag_object(disk, dp.start, dp.message))
                            set first: false
                        }
                    }
                    set di: di + 1
                }

                extra.append(diagnostics.sibling_notifications(&model.module_, root, path, &planner))
            }

        let head sb.to_string()
        let tail extra.to_string()
        var out StringBuilder()
        out.append head
        if tail.get_length() > 0
        {
            out.append("\n" as char)
            out.append tail
        }
        out.to_string()
    }

    ; One LF-terminated publishDiagnostics notification per module file of `m`'s
    ; tree EXCEPT `path` — the answer the plan already holds for every file but
    ; the one that was asked about.
    ;
    ; The file list is the MODELER's (Module.file, filled by
    ; build_referenced_module#), not a directory walk: only a file this analysis
    ; actually read may be claimed to be clean.
    ;
    ; ★`entry` is the file the plan STARTED from (the package root, or the
    ; document itself for a program root), and it is what bounds the fan-out to
    ; the subtree that entry owns. The bound is not cosmetic: build_program#
    ; attaches the PRELUDE as a sub-module of the main module, so an unbounded
    ; walk publishes into packages/scaly/0.1.0/scaly/prelude.scaly — a file of
    ; another root, whose diagnostics this analysis has no business clearing.
    ; Measured on a two-module probe, where prelude.scaly was the only sibling
    ; the first version reported.
    procedure sibling_notifications(rp, m: ref[Module], entry: String, path: String, planner: ref[Planner.Planner]) returns String
    {
        var sb StringBuilder()

        let prefix diagnostics.subtree_prefix entry
        let files diagnostics.module_files(m)
        let flen files.get_length()
        var fstart: size_t 0
        var fi: size_t 0
        while fi < flen
        {
            ; Bind the byte first: `files.get fi = X` is a parenless call whose
            ; head swallows the comparison (CLAUDE.md's dropped-chain class; the
            ; arity gate reports it as "got 0").
            let fc files.get fi
            if fc = ("\n" as char)
            {
                if fi > fstart
                {
                    let f files.substring(fstart, fi - fstart)
                    if f <> path and diagnostics.owns_file(entry, prefix, f)
                        sb.append(diagnostics.sibling_notification(f, planner))
                }
                set fstart: fi + 1
            }
            set fi: fi + 1
        }
        sb.to_string()
    }

    ; The publishDiagnostics notification for one sibling module `file`, followed
    ; by its LF, read out of the planner that has already run.
    ;
    ; A file the analysis found NOTHING in is reported with an empty array —
    ; that is what clears a diagnostic the user has just fixed, and the header
    ; explains why it is done statelessly. A file that carries diagnostics but
    ; cannot be READ yields nothing at all: its offsets index a text we do not
    ; have, the same bargain the head half makes.
    procedure sibling_notification(rp, file: String, planner: ref[Planner.Planner]) returns String
    {
        var sb StringBuilder()

        var count: size_t 0
        var di: size_t 0
        while di < planner.diagnostics.length
        {
            let dp planner.diagnostics.get di
            if dp <> null and dp.file = file
                set count: count + 1
            set di: di + 1
        }

        var body StringBuilder()
        if count > 0
        {
            let text File.read_to_string(file)
            if text.get_length() = 0
                return sb.to_string()

            var first true
            var dj: size_t 0
            while dj < planner.diagnostics.length
            {
                let dp planner.diagnostics.get dj
                if dp <> null
                    if dp.file = file
                    {
                        if first = false
                            body.append("," as char)
                        body.append(diagnostics.diag_object(text, dp.start, dp.message))
                        set first: false
                    }
                set dj: dj + 1
            }
        }

        sb.append(diagnostics.notification(symbols.path_to_uri(file), body.to_string()))
        sb.append("\n" as char)
        sb.to_string()
    }

    ; The publishDiagnostics envelope for `uri` around an already-assembled,
    ; comma-separated `body` of diagnostic objects ("" = none).
    function notification(rp, uri: String, body: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(diagnostics.key("jsonrpc"))
        sb.append(diagnostics.quoted("2.0"))
        sb.append("," as char)
        sb.append(diagnostics.key("method"))
        sb.append(diagnostics.quoted("textDocument/publishDiagnostics"))
        sb.append("," as char)
        sb.append(diagnostics.key("params"))
        sb.append("{" as char)                    ; params {
        sb.append(diagnostics.key("uri"))
        sb.append(json.quote_string(uri))
        sb.append("," as char)
        sb.append(diagnostics.key("diagnostics"))
        sb.append("[" as char)
        sb.append body
        sb.append("]" as char)
        sb.append("}" as char)                    ; } params
        sb.append("}" as char)                    ; } root
        sb.to_string()
    }

    ; The directory an entry file owns its modules under: "<dir>/<name>/". The
    ; convention is the modeler's own — build_referenced_module# resolves
    ; `module foo` of <dir>/<name>.scaly to <dir>/<name>/foo.scaly, and
    ; handle_namespace# appends the namespace segment the same way — and it is
    ; the same one package_root# walks UP.
    function subtree_prefix(rp, entry: String) returns String
    {
        let len entry.get_length()

        ; 6 == length of ".scaly"
        var cut len
        if len > 6
        {
            let tail entry.substring(len - 6, 6)
            if tail = ".scaly"
                set cut: len - 6
        }

        var sb StringBuilder()
        sb.append(entry.substring(0, cut))
        sb.append("/" as char)
        sb.to_string()
    }

    ; True when `file` belongs to the tree rooted at `entry`: the entry itself,
    ; or anything under the directory it owns.
    function owns_file(entry: String, prefix: String, file: String) returns bool
    {
        if file = entry
            return true
        file.starts_with prefix
    }

    ; Every module FILE reachable from `m`, one per line (a path cannot contain
    ; an LF). Depth-first, `m` itself first.
    ;
    ; ★MODULES DECLARED IN A NAMESPACE need the member walk below, and they are
    ; the normal case, not an exotic one: every package root in this tree writes
    ; `define <pkg> { module a  module b }`, and handle_namespace# puts those in
    ; Namespace.modules — NOT in Module.modules, which only carries the ones
    ; declared at file level. A walk over Module.modules alone therefore finds no
    ; sibling at all in any real package; measured on a two-module probe, where
    ; it found only the prelude.
    ;
    ; model.packages — every `package NAME VERSION` dependency — is not walked at
    ; all: a diagnostic there belongs to that package's own root.
    function module_files(rp, m: ref[Module]) returns String
    {
        var sb StringBuilder()
        sb.append m.file
        sb.append("\n" as char)

        var i: size_t 0
        while i < m.modules.length
        {
            let sub m.modules.get i
            if sub <> null
                sb.append(diagnostics.module_files(sub))
            set i: i + 1
        }

        var j: size_t 0
        while j < m.members.length
        {
            let mem m.members.get j
            if mem <> null
                sb.append(diagnostics.member_module_files(mem))
            set j: j + 1
        }
        sb.to_string()
    }

    ; The module files nested inside one member — i.e. inside a namespace, the
    ; only member kind that can declare modules.
    function member_module_files(rp, mem: ref[Member]) returns String
    {
        var sb StringBuilder()
        choose mem
            when c: Concept
                sb.append(diagnostics.definition_module_files(&c.definition))
            else
            {
                ; An operator, a function or a package member declares no module.
            }
        sb.to_string()
    }

    ; The module files of a namespace definition, recursing through nested
    ; namespaces (`define a { define b { module c } }`).
    function definition_module_files(rp, d: ref[Definition]) returns String
    {
        var sb StringBuilder()
        choose d
            when ns: Namespace
            {
                var i: size_t 0
                while i < ns.modules.length
                {
                    let sub ns.modules.get i
                    if sub <> null
                        sb.append(diagnostics.module_files(sub))
                    set i: i + 1
                }

                var j: size_t 0
                while j < ns.members.length
                {
                    let mem ns.members.get j
                    if mem <> null
                        sb.append(diagnostics.member_module_files(mem))
                    set j: j + 1
                }
            }
            else
            {
                ; A structure, union, global, type alias or delegate holds none.
            }
        sb.to_string()
    }

    ; The head of a report (everything before the first LF) — the diagnostic
    ; objects belonging to the document that was asked about.
    function report_head(rp, report: String) returns String
    {
        let cut diagnostics.first_lf report
        report.substring(0, cut)
    }

    ; The tail of a report (everything after the first LF) — the sibling
    ; notifications, or "" when there are none.
    function report_tail(rp, report: String) returns String
    {
        let len report.get_length()
        let cut diagnostics.first_lf report
        if cut >= len
            return String("")

        report.substring(cut + 1, len - cut - 1)
    }

    ; Offset of the first LF in `s`, or its length when there is none.
    function first_lf(s: String) returns size_t
    {
        let len s.get_length()
        var i: size_t 0
        while i < len
        {
            let c s.get i
            if c = ("\n" as char)
                return i
            set i: i + 1
        }
        len
    }

    ; The SEMANTIC diagnostics of a document whose buffer does NOT parse — the
    ; body publish_diagnostics# appends after the parse error itself.
    ;
    ; The point: a broken line must not hide the rest of the file. There are two
    ; routes, and only one of them involves a guess.
    ;
    ; A PACKAGE MEMBER is planned through its ROOT, and the modeler reads every
    ; module from DISK (package_report#) — so the broken BUFFER never enters
    ; that analysis at all. The diagnostics are exactly the ones the file gets
    ; while it parses, with no repair and nothing to filter; their offsets are
    ; the saved text's, which package_report# already documents. Every file
    ; of this tree, and of any real project, takes this route.
    ;
    ; A STANDALONE document has no source but the buffer, so it goes through
    ; symbols.repaired_source# — the same length-preserving line blanking the
    ; read-only requests use. THAT is a guess, so every diagnostic it yields is
    ; checked with symbols.trust_repaired_diagnostic# before it is reported.
    ;
    ; DELIBERATELY NOT DONE: reporting the parse errors of the LATER repair
    ; rounds, to get more than one syntax message. Only the FIRST parse error is
    ; a fact about the buffer; a later one is a fact about a text one of whose
    ; lines we erased, and it can be pure fiction. Blank the line carrying a
    ; wrong closer and the parser next stops at the line that was fine, which
    ; would put a red squiggle under correct code. There is no filter for that
    ; the way there is for a name the repair deleted — the evidence the parser
    ; would need is the very line that is gone — so the honest count of
    ; certain syntax errors in a broken buffer stays one.
    procedure broken_buffer_report(rp, mutable path: String, mutable text: String) returns String mutable modeler_error_count
    {
        var sb StringBuilder()

        let root diagnostics.package_root path
        if root.get_length() > 0
        {
            sb.append(diagnostics.package_report(root, path))
            return sb.to_string()
        }

        let repaired symbols.repaired_source text

        ; The repair gave up: repaired_source# then answers the ORIGINAL, which
        ; still does not parse. parse_error_offset# reports a value PAST THE END
        ; when a text parses, so this is the "no usable repair" test.
        if symbols.parse_error_offset(repaired) <= repaired.get_length()
            return sb.to_string()

        var first true
        var p parser.Parser(repaired)
        choose p.parse_program()
            when err: Error
            {
                ; Unreachable (the text was just checked to parse); answering
                ; nothing is the only honest thing to do if it ever is not.
            }
            when program: Success
            {
                let prog_name "document"
                let model Modeler.build_program(path, prog_name, program, true)

                var planner Planner.Planner(path)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model

                var di: size_t 0
                while di < planner.diagnostics.length
                {
                    let dp planner.diagnostics.get di
                    if dp <> null
                    {
                        ; Offsets are mapped through the ORIGINAL text: the
                        ; repair is length-preserving, so every offset indexes
                        ; the same byte in both, and the reader sees the line
                        ; that is actually in the editor. That equivalence holds
                        ; for THIS file only, hence the file test: a module's
                        ; diagnostic carries an offset into ITS text and would be
                        ; drawn under an unrelated line here.
                        ;
                        ; ★And no sibling notifications are emitted from the
                        ; repaired route, deliberately: the repair BLANKS a line
                        ; of this buffer, so a name it erased makes a module that
                        ; uses that name report "not found" — a diagnostic
                        ; manufactured by the repair, in a file the user is not
                        ; even editing. The siblings keep whatever the last
                        ; parsing analysis published, which is stale at worst.
                        if dp.file = path
                            if symbols.trust_repaired_diagnostic(text, repaired, dp.start, dp.message)
                            {
                                if first = false
                                    sb.append("," as char)

                                sb.append(diagnostics.diag_object(text, dp.start, dp.message))
                                set first: false
                            }
                    }
                    set di: di + 1
                }
            }

        sb.to_string()
    }

    ; Register every loaded package's concepts with the planner
    ; (inlined mirror of cli.register_packages).
    procedure register_packages(mutable planner: ref[Planner.Planner], model: ref[Program])
    {
        var i: size_t 0
        while i < model.packages.length
        {
            let pkg_ptr model.packages.get i
            if pkg_ptr <> null
            {
                planner.register_loaded_package(pkg_ptr.name, *pkg_ptr)
                planner.register_module_concepts(*pkg_ptr)
            }
            set i: i + 1
        }
    }

    ; One LSP diagnostic object at the given byte offset.
    function diag_object(rp, source: String, offset: size_t, message: String) returns String
    {
        ; Byte offset -> 0-based line / character (ASCII; UTF-16 units ==
        ; bytes for ASCII, good enough for now). Numeric LF compare (10),
        ; never "\n" (the lexer mis-handles the escape).
        var line: size_t 0
        var col: size_t 0
        let src_len source.get_length()
        var target offset
        if target > src_len
            set target: src_len
        var off: size_t 0
        while off < target
        {
            let c source.get off
            if c = ("\n" as char)
            {
                set line: line + 1
                set col: 0
            }
            else
                set col: col + 1
            set off: off + 1
        }

        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(diagnostics.key("range"))
        sb.append("{" as char)                    ; range {
        sb.append(diagnostics.key("start"))
        sb.append(diagnostics.pos(line, col))
        sb.append("," as char)
        sb.append(diagnostics.key("end"))
        sb.append(diagnostics.pos(line, col + 1))
        sb.append("}" as char)                    ; } range
        sb.append("," as char)
        sb.append(diagnostics.key("severity"))
        sb.append("1" as char)                    ; 1 = Error
        sb.append("," as char)
        sb.append(diagnostics.key("message"))
        sb.append(json.quote_string(message))
        sb.append("}" as char)
        sb.to_string()
    }

    ; {"line":L,"character":C}
    function pos(rp, line: size_t, character: size_t) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(diagnostics.key("line"))
        sb.append(json.format_i64(line as i64))
        sb.append("," as char)
        sb.append(diagnostics.key("character"))
        sb.append(json.format_i64(character as i64))
        sb.append("}" as char)
        sb.to_string()
    }

    ; Strip a `file://` scheme prefix from a document URI, leaving a
    ; filesystem path the modeler can resolve sibling modules against.
    ; Non-file URIs are returned unchanged.
    function strip_uri(rp, uri: String) returns String
    {
        ; A non-file:// URI is returned unchanged. The stripped result is the
        ; trailing implicit return (an explicit `return uri.substring(rp,...)`
        ; trips the escape checker's return-of-page-call false positive).
        if uri.starts_with("file://") = false
            return uri

        ; 7 == length of "file://"
        let len uri.get_length()
        uri.substring(7, len - 7)
    }

    ; `"key":`
    function key(rp, k: Slice[char]) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)
        sb.append(k.data, k.length)
        sb.append("\"" as char)
        sb.append(":" as char)
        sb.to_string()
    }

    ; `"s"`
    function quoted(rp, s: Slice[char]) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)
        sb.append(s.data, s.length)
        sb.append("\"" as char)
        sb.to_string()
    }
}
