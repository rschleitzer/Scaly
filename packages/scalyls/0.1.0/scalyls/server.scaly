; server.scaly - LSP JSON-RPC lifecycle + dispatch loop.
;
; Reads Content-Length framed messages from stdin (scalyls.rpc), parses
; each body as JSON (scalyls.json), dispatches on `method`, and writes
; framed JSON responses to stdout. Requests (with an `id`) get a Response;
; notifications (no `id`) do not.
;
; Lifecycle handled here:
;   initialize   -> capabilities + serverInfo
;   initialized  -> notification, ignored
;   shutdown     -> null result
;   exit         -> terminate the process
;
; Diagnostics for textDocument/didOpen and textDocument/didChange live in
; scalyls.diagnostics; the dispatch hooks call into it.
;
; STRING/JSON NOTE: outgoing JSON is assembled with a local StringBuilder,
; appending to it directly (the in-place method-call form, which is the
; only StringBuilder-mutation that propagates — an aggregate receiver is
; copied across a plain call boundary). Helpers therefore RETURN String
; pieces (the format_i64#/quote_string# pattern) rather than mutating a
; passed-in builder. Double quotes are injected as 0x22 bytes (the lexer
; does not decode `\"` reliably — same class as the CR/LF escape issue).
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line (`;` starts a comment, not a separator).

use scaly.memory.runtime
use scalyls.rpc
use scalyls.json
use scalyls.json.JsonValue
use scalyls.diagnostics
use scalyls.docstore
use scalyls.symbols
use scalyls.worker

define server
{
    ; Main loop: read a frame, dispatch, repeat. An empty body means EOF
    ; on stdin -> shut the loop down.
    procedure run() mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len
    {
        ; Each message is read + dispatched inside process_one(), a plain
        ; (non-#) helper. The message body — read via read_message() onto
        ; the HELPER's local page (rp resolves to the callee's own root
        ; page) — and everything the dispatch allocates on that page are
        ; reclaimed when process_one() returns, every iteration. Reading
        ; the body directly on run()'s never-returning loop page instead
        ; pinned one oversized body page per edit there forever.
        while server.process_one()
            0
    }

    ; Read and dispatch a single message. Returns true to continue the
    ; loop, false at EOF (empty body) to shut it down. The body lives on
    ; this function's local page and is freed on return.
    procedure process_one() returns bool mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len
    {
        let body rpc.read_message()
        if body.get_length() = 0
            return false

        server.handle_message body
        ; Diagnostics are the only work this server does that nobody is waiting
        ; for, so it runs LAST: while the client still has messages queued, they
        ; are dispatched first and the owed analysis waits. A typing burst
        ; therefore costs ONE analysis instead of one per keystroke, and the
        ; completion / hover requests inside the burst are answered immediately.
        if worker.stdin_has_input() = false
            server.flush_dirty()
        true
    }

    ; Run the owed diagnostics analyses, newest buffer first, and stop as soon as
    ; the client speaks again — an answer it is waiting for outranks a diagnostic
    ; it is not.
    procedure flush_dirty() mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        var uri docstore.dirty_uri()
        while uri.get_length() > 0
        {
            docstore.clear_dirty uri
            let text docstore.get uri
            server.publish_for(uri, text)
            if worker.stdin_has_input()
                return
            set uri: docstore.dirty_uri()
        }
    }

    procedure handle_message(mutable body: String) mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len
    {
        let msg json.parse body

        let method_val json.get(msg, "method")
        let method json.as_string method_val

        ; An `id` field marks a Request (needs a Response). Notifications
        ; carry no id. A comparison result bound straight to a `let`
        ; mis-plans under stage-0, so latch has_id via a if instead.
        let id_val json.get(msg, "id")
        var has_id true
        if json.is_null(id_val)
            set has_id: false
        let id json.as_i64 id_val

        if method = "initialize"
        {
            ; Capture the workspace root (workspace/symbol carries no uri).
            server.capture_workspace_root msg
            if has_id
                rpc.write_message(server.initialize_response(id))
            return
        }

        if method = "shutdown"
        {
            if has_id
                rpc.write_message(server.null_result_response(id))
            return
        }

        if method = "exit"
        {
            exit 0
            return
        }

        if method = "textDocument/didOpen"
        {
            server.handle_did_open msg
            return
        }

        if method = "textDocument/didChange"
        {
            server.handle_did_change msg
            return
        }

        if method = "textDocument/didClose"
        {
            server.handle_did_close msg
            return
        }

        if method = "textDocument/documentSymbol"
        {
            if has_id
                server.handle_document_symbol(msg, id)
            return
        }

        if method = "textDocument/hover"
        {
            if has_id
                server.handle_hover(msg, id)
            return
        }

        if method = "textDocument/definition"
        {
            if has_id
                server.handle_definition(msg, id)
            return
        }

        if method = "textDocument/references"
        {
            if has_id
                server.handle_references(msg, id)
            return
        }

        if method = "textDocument/documentHighlight"
        {
            if has_id
                server.handle_document_highlight(msg, id)
            return
        }

        if method = "textDocument/completion"
        {
            if has_id
                server.handle_completion(msg, id)
            return
        }

        if method = "completionItem/resolve"
        {
            if has_id
                server.handle_completion_resolve(msg, id)
            return
        }

        if method = "textDocument/prepareRename"
        {
            if has_id
                server.handle_prepare_rename(msg, id)
            return
        }

        if method = "textDocument/rename"
        {
            if has_id
                server.handle_rename(msg, id)
            return
        }

        if method = "textDocument/signatureHelp"
        {
            if has_id
                server.handle_signature_help(msg, id)
            return
        }

        if method = "textDocument/foldingRange"
        {
            if has_id
                server.handle_folding_range(msg, id)
            return
        }

        if method = "textDocument/formatting"
        {
            if has_id
                server.handle_formatting(msg, id)
            return
        }

        if method = "textDocument/semanticTokens/full"
        {
            if has_id
                server.handle_semantic_tokens(msg, id)
            return
        }

        if method = "textDocument/inlayHint"
        {
            if has_id
                server.handle_inlay_hint(msg, id)
            return
        }

        if method = "textDocument/codeAction"
        {
            if has_id
                server.handle_code_action(msg, id)
            return
        }

        if method = "textDocument/codeLens"
        {
            if has_id
                server.handle_code_lens(msg, id)
            return
        }

        if method = "textDocument/selectionRange"
        {
            if has_id
                server.handle_selection_range(msg, id)
            return
        }

        if method = "textDocument/typeDefinition"
        {
            if has_id
                server.handle_type_definition(msg, id)
            return
        }

        if method = "textDocument/prepareCallHierarchy"
        {
            if has_id
                server.handle_prepare_call_hierarchy(msg, id)
            return
        }

        if method = "callHierarchy/incomingCalls"
        {
            if has_id
                server.handle_incoming_calls(msg, id)
            return
        }

        if method = "callHierarchy/outgoingCalls"
        {
            if has_id
                server.handle_outgoing_calls(msg, id)
            return
        }

        if method = "workspace/symbol"
        {
            if has_id
                server.handle_workspace_symbol(msg, id)
            return
        }

        ; initialized + any other notification: ignore — a notification carries
        ; no id and owes no answer.
        ;
        ; ★★★A REQUEST, though, must ALWAYS be answered, even one we do not
        ; implement, and the older wording here ("left unanswered for now — the
        ; client tolerates this") was measurably wrong about that. Claude Code's
        ; LSP client maps its goToImplementation operation onto
        ; textDocument/implementation UNCONDITIONALLY — it never reads
        ; implementationProvider back out of our initialize result — and its
        ; transport has no request timeout at all (only a ContentModified
        ; retry). So silence here does not degrade the feature, it hangs the
        ; caller forever: measured 2026-08-15 at 94 s with no answer, killed by
        ; hand. `null` is the LSP-legal "no result" and reads to that client as
        ; "no matches", which is the truth for every method we do not serve.
        if has_id
            rpc.write_message(server.null_result_response(id))
    }

    ; ====================================================================
    ; Document sync -> diagnostics
    ; ====================================================================

    procedure handle_did_open(msg: JsonValue) mutable doc_slots
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let text json.as_string(json.get(doc, "text"))
        ; Remember the buffer so later navigation requests (which carry only a
        ; uri) see this text — including unsaved edits — instead of disk.
        docstore.put(uri, text)
        docstore.mark_dirty uri
    }

    procedure handle_did_change(msg: JsonValue) mutable doc_slots
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))

        ; textDocumentSync = incremental: each contentChange is either a
        ; ranged edit (replace the [start,end) span with its text) or a
        ; full-document replacement (no range). Apply them in order, starting
        ; from the current stored buffer, to rebuild the whole document.
        let changes json.get(params, "contentChanges")
        let n json.array_length changes
        if n = 0
            return

        var text docstore.get uri
        var i: size_t 0
        while i < n
        {
            let change json.array_get(changes, i)
            set text: server.apply_change(text, change)
            set i: i + 1
        }
        ; Store the rebuilt buffer so navigation sees this (unsaved) edit, and
        ; only MARK the analysis as owed — see docstore.mark_dirty# for why
        ; analysing per keystroke made every following request wait.
        docstore.put(uri, text)
        docstore.mark_dirty uri
    }

    ; Apply one LSP contentChange to `text`, returning the new full document.
    ; No `range` -> a full-document replacement (the change text IS the whole
    ; document). With a range -> replace the [start,end) span (start/end as
    ; 0-based line/character) with the change text. The result is assembled
    ; ONE BYTE AT A TIME (prefix, inserted text, suffix): a single
    ; StringBuilder.append of a large String hits the runtime's manual-grow
    ; crash (see symbols.scaly's STRING/JSON NOTE).
    function apply_change(rp, text: String, change: JsonValue) returns String
    {
        let range json.get(change, "range")
        let new_text json.as_string(json.get(change, "text"))

        if json.is_null(range)
            return new_text

        let start json.get(range, "start")
        let end json.get(range, "end")
        let s_line json.as_i64(json.get(start, "line"))
        let s_char json.as_i64(json.get(start, "character"))
        let e_line json.as_i64(json.get(end, "line"))
        let e_char json.as_i64(json.get(end, "character"))
        let s_off symbols.position_to_offset(text, s_line as size_t, s_char as size_t)
        let e_off symbols.position_to_offset(text, e_line as size_t, e_char as size_t)

        var sb StringBuilder()
        var i: size_t 0
        while i < s_off
        {
            sb.append(text.get(i) as char)
            set i: i + 1
        }
        var j: size_t 0
        let nn new_text.get_length()
        while j < nn
        {
            sb.append(new_text.get(j) as char)
            set j: j + 1
        }
        let tlen text.get_length()
        var k e_off
        while k < tlen
        {
            sb.append(text.get(k) as char)
            set k: k + 1
        }
        sb.to_string()
    }

    ; documentSymbol: return the outline tree for the requested document.
    ; The request carries only a uri (no text), so the worker re-reads the
    ; file from disk. The result is the DocumentSymbol[] array wrapped in a
    ; Response envelope with the request id.
    procedure handle_document_symbol(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        ; In-memory text (empty -> worker reads disk) so the outline reflects
        ; unsaved edits.
        let text docstore.get uri
        let result worker.symbols(uri, text)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; foldingRange: collapsible regions of the document. Like documentSymbol
    ; the request carries only a uri, so the worker re-reads the file (falling
    ; back from the in-memory copy). The result is the FoldingRange[] array
    ; wrapped in a Response envelope; it can be large, so document_symbol_response#
    ; (byte-at-a-time) builds it.
    ; textDocument/codeAction. The request carries the diagnostics the client
    ; already holds for the range, and a visibility diagnostic ENDS in the fix:
    ;   "... but not visible here; add: use demo.widgets.Widget"
    ; So the answer is read off the request rather than recomputed — re-running
    ; the planner to ask which name is invisible would ask a question it has
    ; already answered, and let the two answers drift apart.
    ;
    ; Nothing to fix -> `[]`, which is what the client gets on every ordinary
    ; cursor position (it asks constantly, unprompted).
    procedure handle_code_action(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let packed server.diagnostics_packed(json.get(params, "context"))
        if packed.get_length() = 0
        {
            rpc.write_message(server.document_symbol_response(id, "[]"))
            return
        }
        let text docstore.get uri
        let result worker.code_actions(uri, text, packed)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; textDocument/codeLens: one lens per `for` loop, carrying the TaskPlanner's
    ; self-scaling verdict (scalyls.tasklens). The request carries only a uri, so
    ; the in-memory buffer is passed along — the lens POSITIONS are the buffer's,
    ; even though the verdicts come from the file as last saved.
    ;
    ; The client asks again on every document version, so this pays a package-root
    ; plan per edit burst — the same cost class as the diagnostics it already runs
    ; per burst, and the reason the answer is never computed in this process.
    procedure handle_code_lens(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let text docstore.get uri
        let result worker.code_lenses(uri, text)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; The diagnostics of a codeAction context, one per line, as
    ; `<line> <character> <message>` — the 0-based start position of the
    ; diagnostic, then its text.
    ;
    ; ★THE PARENT PACKS, THE WORKER DECIDES. Which messages have a fix, and what
    ; the fix is, is settled in ONE place (symbols.code_actions_packed#) — the
    ; parent does not look inside a message at all. It used to: it scraped the
    ; `use` path out of the visibility hint and sent only that, so the parent
    ; knew one fix and the worker knew the rest. Every fix added after it would
    ; have had to be recognised twice, on both sides of a pipe, which is exactly
    ; the drift the recognise-from-the-message rule exists to avoid.
    ;
    ; A message cannot contain an LF (the planner writes none, and a diagnostic
    ; is one line), but one is replaced by a space rather than trusted — the line
    ; IS the framing here.
    function diagnostics_packed(rp, context: JsonValue) returns String
    {
        var sb StringBuilder()
        let diags json.get(context, "diagnostics")
        let n json.array_length diags
        var i: size_t 0
        while i < n
        {
            let d json.array_get(diags, i)
            let message json.as_string(json.get(d, "message"))
            if message.get_length() > 0
            {
                let range json.get(d, "range")
                let start json.get(range, "start")
                sb.append(json.format_i64(json.as_i64(json.get(start, "line"))))
                sb.append(" " as char)
                sb.append(json.format_i64(json.as_i64(json.get(start, "character"))))
                sb.append(" " as char)

                var k: size_t 0
                while k < message.get_length()
                {
                    let c message.get k
                    if c = 0x0A
                        sb.append(" " as char)
                    if c <> 0x0A
                        sb.append(c as char)
                    set k: k + 1
                }
                sb.append("\n" as char)
            }
            set i: i + 1
        }
        sb.to_string()
    }

    ; The offset of `needle` in `hay`, or hay's length when absent.
    function find_substring(hay: String, needle: String) returns size_t
    {
        let hn hay.get_length()
        let nn needle.get_length()
        if nn = 0
            return hn
        if nn > hn
            return hn
        var i: size_t 0
        while i <= (hn - nn)
        {
            var k: size_t 0
            var same true
            while k < nn
            {
                if hay.get(i + k) <> needle.get(k)
                {
                    set same: false
                    break
                }
                set k: k + 1
            }
            if same
                return i
            set i: i + 1
        }
        hn
    }

    ; textDocument/prepareCallHierarchy — the entry point: resolve the cursor to
    ; the routine whose hierarchy is asked for. The two call requests below then
    ; arrive with the ITEM this returned, not with a cursor.
    procedure handle_prepare_call_hierarchy(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        var pb StringBuilder()
        pb.append(json.format_i64(json.as_i64(json.get(position, "line"))))
        pb.append(" " as char)
        pb.append(json.format_i64(json.as_i64(json.get(position, "character"))))
        let text docstore.get uri
        let result worker.prepare_call_hierarchy(uri, text, pb.to_string())
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; callHierarchy/incomingCalls — who calls the item. The item's OWN uri is
    ; the document (it may live in a different file than the cursor did), and
    ; the workspace root rides along the same way references passes it.
    procedure handle_incoming_calls(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let item json.get(params, "item")
        let uri json.as_string(json.get(item, "uri"))
        let name json.as_string(json.get(item, "name"))
        let root docstore.workspace_root()
        var pb StringBuilder()
        var ri: size_t 0
        let rn root.get_length()
        while ri < rn
        {
            pb.append(root.get(ri) as char)
            set ri: ri + 1
        }
        pb.append("\n" as char)
        var ni: size_t 0
        let nn name.get_length()
        while ni < nn
        {
            pb.append(name.get(ni) as char)
            set ni: ni + 1
        }
        let text docstore.get uri
        let result worker.incoming_calls(uri, text, pb.to_string())
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; callHierarchy/outgoingCalls — what the item calls. The item's range start
    ; locates the routine in its own file.
    procedure handle_outgoing_calls(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let item json.get(params, "item")
        let uri json.as_string(json.get(item, "uri"))
        let range json.get(item, "range")
        let start json.get(range, "start")
        var pb StringBuilder()
        pb.append(json.format_i64(json.as_i64(json.get(start, "line"))))
        pb.append(" " as char)
        pb.append(json.format_i64(json.as_i64(json.get(start, "character"))))
        let text docstore.get uri
        let result worker.outgoing_calls(uri, text, pb.to_string())
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; textDocument/typeDefinition. Same request shape as definition; the worker
    ; resolves the TYPE of the thing at the cursor and then looks THAT up.
    procedure handle_type_definition(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))
        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let text docstore.get uri
        let result worker.type_definition(uri, text, pb.to_string())
        rpc.write_message(server.definition_response(id, result))
    }

    ; textDocument/selectionRange. The request carries an ARRAY of positions
    ; (a multi-cursor selection asks for all of them at once) and the reply must
    ; hold one chain per position, in the same order. They are packed as one
    ; "<line> <char>" per line, the same shape every other position frame uses.
    procedure handle_selection_range(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let positions json.get(params, "positions")
        let n json.array_length positions
        var pb StringBuilder()
        var i: size_t 0
        while i < n
        {
            let pos json.array_get(positions, i)
            pb.append(json.format_i64(json.as_i64(json.get(pos, "line"))))
            pb.append(" " as char)
            pb.append(json.format_i64(json.as_i64(json.get(pos, "character"))))
            pb.append("\n" as char)
            set i: i + 1
        }
        let text docstore.get uri
        let result worker.selection_ranges(uri, text, pb.to_string())
        rpc.write_message(server.document_symbol_response(id, result))
    }

    procedure handle_folding_range(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let text docstore.get uri
        let result worker.folding(uri, text)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; formatting: `Format Document` / format on save. Like foldingRange the
    ; request carries only a uri (plus FormattingOptions, which are ignored —
    ; this tree's indentation is four spaces and the formatter's job is to
    ; follow the house form, not the editor's preference). The result is a
    ; TextEdit[]; it can be one edit per changed line, so the large-payload
    ; response builder applies.
    procedure handle_formatting(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let text docstore.get uri
        let result worker.formatting(uri, text)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; semanticTokens/full: whole-document token classification for syntax
    ; highlighting. Like documentSymbol the request carries only a uri. The
    ; result is {"data":[...]} (delta-encoded ints) wrapped in a Response; the
    ; data array can be large, so document_symbol_response# (byte-at-a-time).
    procedure handle_semantic_tokens(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let text docstore.get uri
        let result worker.semantic_tokens(uri, text)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; hover: the request carries a uri + a {line,character} position. Pack the
    ; position as "<line> <char>" and hand it to the worker, which re-reads the
    ; file (the server is stateless) and reports the symbol under the cursor.
    ; An empty worker reply -> result:null.
    procedure handle_hover(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        ; PREFER the planner-resolved type (handles reassigned vars, generic
        ; element types, pointer/ref inner types, mid-chain calls). The
        ; semantic query runs the full pipeline in the worker and can
        ; crash/hang; on an empty/miss reply FALL BACK to the lexical hover
        ; walk (a separate worker round-trip, so a pipeline crash here never
        ; costs the lexical answer).
        let sem worker.semantic_type(uri, text, packed)
        var value server.semantic_hover_from_framed sem
        if value.get_length() = 0
            set value: worker.hover(uri, text, packed)
        rpc.write_message(server.hover_response(id, value))
    }

    ; Decode the worker's framed semantic-type reply ("1<name>" hit / "0" miss
    ; / "" crash) into an LSP hover object, or "" on a miss/crash so the
    ; caller falls back to the lexical hover.
    function semantic_hover_from_framed(rp, framed: String) returns String
    {
        if framed.get_length() = 0
            return ""
        let tag framed.get(0)
        if tag <> 0x31
            return ""
        let tname framed.substring(1, framed.get_length() - 1)
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("contents"))
        sb.append("{" as char)                    ; contents {
        sb.append(server.key("kind"))
        sb.append(json.quote_string("markdown"))
        sb.append("," as char)
        sb.append(server.key("value"))
        sb.append(json.quote_string(tname))
        sb.append("}" as char)
        sb.append("}" as char)
        sb.to_string()
    }

    ; definition: like hover, the request carries a uri + {line,character}.
    ; Pack the position as "<line> <char>" and hand it to the worker, which
    ; re-reads the file and resolves the identifier under the cursor to a
    ; declaration in the same file. An empty worker reply -> result:null.
    procedure handle_definition(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.definition(uri, text, packed)
        rpc.write_message(server.definition_response(id, result))
    }

    ; signatureHelp: the request carries a uri + {line,character}. Pack the
    ; position as "<line> <char>" and ask the worker for the parameter list of
    ; the call enclosing the cursor. An empty worker reply -> result:null.
    procedure handle_signature_help(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.signature_help(uri, text, packed)
        rpc.write_message(server.hover_response(id, result))
    }

    ; inlayHint: the request carries a uri + a {start,end} range. Pack the range
    ; as "<sl> <sc> <el> <ec>" and hand it to the worker, which resolves each
    ; in-range call site's parameter names. The result is an InlayHint[] array
    ; (can be large -> document_symbol_response# appends it byte-at-a-time).
    procedure handle_inlay_hint(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let range json.get(params, "range")
        let start json.get(range, "start")
        let end_ json.get(range, "end")
        let sl json.as_i64(json.get(start, "line"))
        let sc json.as_i64(json.get(start, "character"))
        let el json.as_i64(json.get(end_, "line"))
        let ec json.as_i64(json.get(end_, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(sl))
        pb.append(" " as char)
        pb.append(json.format_i64(sc))
        pb.append(" " as char)
        pb.append(json.format_i64(el))
        pb.append(" " as char)
        pb.append(json.format_i64(ec))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.inlay_hints(uri, text, packed)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; references: the request carries a uri + {line,character} + a
    ; context.includeDeclaration flag (ignored — the lexical scan cannot
    ; distinguish the declaration from uses, so all whole-token occurrences
    ; are always returned). Pack the position and hand it to the worker, which
    ; re-reads the file and scans it. The result is a Location[] array.
    procedure handle_references(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        ; Prefix the workspace root (captured at initialize) as "<root>\n..." so
        ; the worker's cross-file walk can fan out from the real root (a use in a
        ; parent/sibling directory) instead of only the current file's dir tree.
        ; An empty root (no rootUri given) leaves a bare leading "\n" -> the
        ; worker falls back to the dir tree (Step 36 behavior).
        let root docstore.workspace_root()
        var pb StringBuilder()
        var ri: size_t 0
        let rn root.get_length()
        while ri < rn
        {
            pb.append(root.get(ri) as char)
            set ri: ri + 1
        }
        pb.append("\n" as char)                    ; \n  (root / position separator)
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.references(uri, text, packed)
        ; document_symbol_response# wraps a pre-serialized JSON array as the
        ; result, appending it byte-at-a-time (a many-occurrence array can be
        ; large — same large-append hazard as the outline).
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; documentHighlight: like references but the result ranges carry no uri
    ; (the editor highlights occurrences in the current document only).
    procedure handle_document_highlight(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.highlights(uri, text, packed)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; completion: when a `.` precedes the cursor and its receiver names a
    ; declared concept, return that concept's members; otherwise return every
    ; declared name as a flat CompletionItem[] (the editor prefix-filters).
    ; Pack the cursor position "<line> <char>" so the worker can detect the
    ; member-access context. Like the other navigation requests, the in-memory
    ; text is passed so unsaved edits are reflected; empty -> worker reads disk.
    procedure handle_completion(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        ; The CompletionItem[] array can be large (many names); reuse the
        ; byte-at-a-time array wrapper.
        let result worker.completion(uri, text, packed)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; completionItem/resolve: fill in the `documentation` of the ONE entry the
    ; client has selected, and answer the entry.
    ;
    ; The request carries the CompletionItem and NOTHING ELSE — no textDocument,
    ; no position — so the entry has to say where it came from itself. It does:
    ; symbols.with_item_data# put the uri of the file it was read from into
    ; `data`, which the client returns untouched. The buffer for THAT file is
    ; looked up in the docstore (empty when the editor has it closed, in which
    ; case the worker reads disk), so an entry from a file being edited resolves
    ; against the unsaved text like every other request.
    ;
    ; The answer is the entry the client sent, plus `documentation` — never a
    ; freshly built one. Re-serializing what arrived is what keeps every field
    ; the client set (and every field a future version of this server adds)
    ; instead of silently dropping it; the injection is a splice before the
    ; object's closing brace, which needs no scan because stringify# produced
    ; the string one line above.
    procedure handle_completion_resolve(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let item json.get(msg, "params")
        ; `label` is a reserved word in Scaly and cannot be a binding name.
        let item_label json.as_string(json.get(item, "label"))
        let data json.as_string(json.get(item, "data"))
        let serialized json.stringify item

        ; No label or no data: an entry this server did not produce (or one from
        ; before `data` existed). Answer it unchanged — resolve is allowed to
        ; add nothing, and inventing a lookup target would be a guess.
        var doc ""
        if item_label.get_length() > 0
            if data.get_length() > 0
            {
                let text docstore.get data
                set doc: worker.completion_resolve(data, text, item_label)
            }

        if doc.get_length() = 0
        {
            rpc.write_message(server.document_symbol_response(id, serialized))
            return
        }
        rpc.write_message(server.document_symbol_response(id, server.with_documentation(serialized, doc)))
    }

    ; `serialized` (a JSON object) with `"documentation":<doc>` spliced in before
    ; its closing brace. Byte-at-a-time: a doc block in this tree runs to
    ; hundreds of bytes and this runs in the PARENT, with no crash isolation.
    function with_documentation(rp, serialized: String, doc: String) returns String
    {
        let n serialized.get_length()
        if n < 2
            return serialized

        var sb StringBuilder()
        var i: size_t 0
        while i < n - 1                          ; everything but the final '}'
        {
            sb.append(serialized.get(i) as char)
            set i: i + 1
        }
        ; `{}` would leave a leading comma behind; anything else has a member.
        if n > 2
            sb.append("," as char)
        sb.append(server.key("documentation"))
        var di: size_t 0
        let dn doc.get_length()
        while di < dn
        {
            sb.append(doc.get(di) as char)
            set di: di + 1
        }
        sb.append("}" as char)
        sb.to_string()
    }

    ; prepareRename: the request carries a uri + {line,character}. Pack the
    ; position as "<line> <char>" and ask the worker for the range of the
    ; renameable identifier under the cursor. An empty worker reply ->
    ; result:null (the editor then refuses the rename).
    procedure handle_prepare_rename(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder()
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.prepare_rename(uri, text, packed)
        rpc.write_message(server.hover_response(id, result))
    }

    ; rename: the request carries a uri + {line,character} + a newName. Pack
    ; the position AND the new name as "<line> <char> <newName>" and ask the
    ; worker to rewrite every whole-token occurrence of the identifier at the
    ; cursor. The result is an LSP WorkspaceEdit (can be large -> byte-at-a-time
    ; wrap); an empty worker reply -> result:null.
    procedure handle_rename(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))
        let new_name json.as_string(json.get(params, "newName"))

        ; Prefix the workspace root as "<root>\n<line> <char> <newName>" so the
        ; worker can fan a module/file-wide rename out across the real root; an
        ; empty root falls back to the current file's dir tree (Step 36).
        let root docstore.workspace_root()
        var pb StringBuilder()
        var ri: size_t 0
        let rn root.get_length()
        while ri < rn
        {
            pb.append(root.get(ri) as char)
            set ri: ri + 1
        }
        pb.append("\n" as char)                    ; \n  (root / position separator)
        pb.append(json.format_i64(line))
        pb.append(" " as char)
        pb.append(json.format_i64(character))
        pb.append(" " as char)
        ; new_name is an identifier (no spaces). Append byte-at-a-time (small,
        ; but keeps to the no-StringBuilder.append(String) discipline).
        var ni: size_t 0
        let nn new_name.get_length()
        while ni < nn
        {
            pb.append(new_name.get(ni) as char)
            set ni: ni + 1
        }
        let packed pb.to_string()

        let text docstore.get uri
        let result worker.rename(uri, text, packed)
        ; Empty -> not renameable / worker unavailable -> null. A real
        ; WorkspaceEdit can be large, so wrap it byte-at-a-time.
        if result.get_length() = 0
            rpc.write_message(server.null_result_response(id))
        if result.get_length() > 0
            rpc.write_message(server.document_symbol_response(id, result))
    }

    ; workspace/symbol: search the whole workspace for declarations whose name
    ; matches params.query. The request carries no document uri, so the search
    ; root comes from the stored workspace root (captured at initialize). The
    ; result SymbolInformation[] can be large -> byte-at-a-time wrap.
    procedure handle_workspace_symbol(msg: JsonValue, id: i64) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let params json.get(msg, "params")
        let query json.as_string(json.get(params, "query"))
        let root docstore.workspace_root()
        let result worker.workspace_symbols(root, query)
        rpc.write_message(server.document_symbol_response(id, result))
    }

    ; Capture the workspace root path from initialize params. Prefer rootUri
    ; (file:// -> path), then rootPath, then workspaceFolders[0].uri. Stored in
    ; the docstore so workspace/symbol (which carries no uri) can find it.
    procedure capture_workspace_root(msg: JsonValue) mutable ws_root_data, ws_root_len
    {
        let params json.get(msg, "params")

        let root_uri_val json.get(params, "rootUri")
        if json.is_null(root_uri_val) = false
        {
            docstore.set_workspace_root(symbols.uri_to_path(json.as_string(root_uri_val)))
            return
        }

        let root_path_val json.get(params, "rootPath")
        if json.is_null(root_path_val) = false
        {
            docstore.set_workspace_root(json.as_string(root_path_val))
            return
        }

        let folders json.get(params, "workspaceFolders")
        if json.is_null(folders) = false
            if json.array_length(folders) > 0
            {
                let f0 json.array_get(folders, 0)
                docstore.set_workspace_root(symbols.uri_to_path(json.as_string(json.get(f0, "uri"))))
            }
    }

    ; A closed document leaves no buffer to analyze; clear whatever
    ; diagnostics the editor still shows for it (empty diagnostics array).
    procedure handle_did_close(msg: JsonValue) mutable doc_slots
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string(json.get(doc, "uri"))
        ; Drop the in-memory buffer; subsequent requests fall back to disk.
        docstore.remove uri
        let payload diagnostics.clear_diagnostics uri
        rpc.write_message payload
    }

    ; Diagnostics are computed in a crash-isolated worker subprocess (see
    ; scalyls.worker): a SIGSEGV/abort/hang in the compiler pipeline on a
    ; bad document then loses only that one result, not the whole server.
    procedure publish_for(mutable uri: String, mutable text: String) mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid
    {
        let payload worker.analyze(uri, text)
        server.write_notifications payload
    }

    ; The diagnostics reply is a LINE-SEPARATED list of publishDiagnostics
    ; notifications: the analysed document first, then one per sibling module of
    ; its package root (scalyls.diagnostics' header has the reasoning). Write each
    ; as its own JSON-RPC frame.
    ;
    ; An empty line is skipped rather than framed — an empty frame is not a valid
    ; message, and the tail deliberately ends in an LF.
    ;
    ; ★A SIBLING THAT IS ITSELF OPEN IS SKIPPED, and this is the one thing in the
    ; fan-out the worker cannot decide: the docstore lives only in the parent.
    ; The reason is that the two analyses are not equivalent. A sibling's
    ; notification is derived from DISK, while a file's own analysis takes its
    ; parse errors from the LIVE BUFFER — so publishing over an open file erases
    ; exactly the diagnostic the user is looking at. Measured on two open files of
    ; one root: an unfinished line in B showed `expected '}'`, and one keystroke
    ; in A cleared it, with the broken line still on screen. An open file loses
    ; nothing by being skipped — it gets its own analysis on its own next edit.
    procedure write_notifications(mutable payload: String)
    {
        let len payload.get_length()
        if len = 0
            return

        var start: size_t 0
        var i: size_t 0
        var line: size_t 0
        while i < len
        {
            ; Bind the byte first — `payload.get i = X` is a parenless call
            ; whose head swallows the comparison.
            let c payload.get i
            if c = ("\n" as char)
            {
                if i > start
                {
                    server.write_notification(payload.substring(start, i - start), line)
                    set line: line + 1
                }
                set start: i + 1
            }
            set i: i + 1
        }
        if len > start
            server.write_notification(payload.substring(start, len - start), line)
    }

    ; Write one publishDiagnostics notification, unless it is a sibling (index
    ; > 0) whose document the editor has open — see write_notifications# for why.
    ; Line 0 is the analysed document itself and is always written.
    procedure write_notification(mutable notification: String, index: size_t)
    {
        if index > 0
        {
            let msg json.parse notification
            let params json.get(msg, "params")
            let uri json.as_string(json.get(params, "uri"))
            if docstore.find(uri) >= 0
                return
        }
        rpc.write_message notification
    }

    ; ====================================================================
    ; Response builders (local StringBuilder; quotes as 0x22 bytes; nested
    ; pieces via String-returning helpers)
    ; ====================================================================

    ; {"jsonrpc":"2.0","id":<id>,"result":{"capabilities":
    ;   {"textDocumentSync":1},"serverInfo":{"name":"scalyls",
    ;   "version":"0.1.0"}}}
    function initialize_response(rp, id: i64) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("jsonrpc"))
        sb.append(server.quoted("2.0"))
        sb.append("," as char)
        sb.append(server.key("id"))
        sb.append(json.format_i64(id))
        sb.append("," as char)
        sb.append(server.key("result"))
        sb.append("{" as char)                    ; result {
        sb.append(server.key("capabilities"))
        sb.append("{" as char)                    ; capabilities {
        sb.append(server.key("textDocumentSync"))
        sb.append("2" as char)                    ; 2 = incremental
        sb.append("," as char)
        sb.append(server.key("documentSymbolProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("hoverProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("definitionProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("referencesProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("documentHighlightProvider"))
        sb.append "true"
        sb.append("," as char)
        ; completionProvider must be a CompletionOptions object (not a bool).
        ; `.` is declared as a TRIGGER CHARACTER: without it an editor asks only
        ; while identifier characters are being typed, so `recv.` offered nothing
        ; until the first letter after the dot — the member list, which is the
        ; whole point of the member-after-`.` resolution, never appeared at the
        ; moment it is wanted.
        ;
        ; resolveProvider:true — the entries arrive WITHOUT documentation and
        ; get it one at a time, for the entry the user has selected. Unlike the
        ; codeLens below, where the title IS the verdict and there is no cheaper
        ; half to send first, a completion list here runs to hundreds of entries
        ; and the doc block of each is the largest thing it could carry; see the
        ; completionItem/resolve section in symbols.scaly.
        sb.append(server.key("completionProvider"))
        sb.append("{" as char)
        sb.append(server.key("triggerCharacters"))
        sb.append("[" as char)
        sb.append("\"" as char)
        sb.append("." as char)
        sb.append("\"" as char)
        sb.append("]" as char)
        sb.append("," as char)
        sb.append(server.key("resolveProvider"))
        sb.append "true"
        sb.append("}" as char)
        sb.append("," as char)
        ; renameProvider as RenameOptions {prepareProvider:true} so the editor
        ; also calls textDocument/prepareRename to validate + pre-fill.
        sb.append(server.key("renameProvider"))
        sb.append("{" as char)
        sb.append(server.key("prepareProvider"))
        sb.append "true"
        sb.append("}" as char)
        sb.append("," as char)
        ; signatureHelpProvider with ( and , as trigger / retrigger chars.
        sb.append(server.key("signatureHelpProvider"))
        sb.append("{" as char)
        sb.append(server.key("triggerCharacters"))
        sb.append("[" as char)
        sb.append("\"" as char)
        sb.append("(" as char)
        sb.append("\"" as char)
        sb.append("," as char)
        sb.append("\"" as char)
        sb.append("," as char)                    ; , (the trigger char)
        sb.append("\"" as char)
        sb.append("]" as char)
        sb.append("}" as char)
        sb.append("," as char)
        sb.append(server.key("foldingRangeProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("documentFormattingProvider"))
        sb.append "true"
        sb.append("," as char)
        ; semanticTokensProvider: legend (token types, no modifiers) + full.
        ; The token-type order MUST match symbols.semantic_tokens#'s indices:
        ;   0 keyword 1 type 2 function 3 variable 4 operator 5 string
        ;   6 number  7 comment 8 parameter 9 property
        sb.append(server.key("semanticTokensProvider"))
        sb.append("{" as char)
        sb.append(server.key("legend"))
        sb.append("{" as char)                    ; legend {
        sb.append(server.key("tokenTypes"))
        sb.append("[" as char)
        sb.append(server.quoted("keyword"))
        sb.append("," as char)
        sb.append(server.quoted("type"))
        sb.append("," as char)
        sb.append(server.quoted("function"))
        sb.append("," as char)
        sb.append(server.quoted("variable"))
        sb.append("," as char)
        sb.append(server.quoted("operator"))
        sb.append("," as char)
        sb.append(server.quoted("string"))
        sb.append("," as char)
        sb.append(server.quoted("number"))
        sb.append("," as char)
        sb.append(server.quoted("comment"))
        sb.append("," as char)
        sb.append(server.quoted("parameter"))
        sb.append("," as char)
        sb.append(server.quoted("property"))
        sb.append("]" as char)
        sb.append("," as char)
        ; tokenModifiers: the BIT ORDER of this list is the wire format — a
        ; token's fifth integer is a bitset indexed into it, so an entry may be
        ; appended but never reordered or removed. Only names from LSP's own
        ; list are used: a custom one would be legal and invisible, because no
        ; theme has a rule for it.
        sb.append(server.key("tokenModifiers"))
        sb.append("[" as char)
        sb.append(server.quoted("declaration"))
        sb.append("," as char)
        sb.append(server.quoted("readonly"))
        sb.append("," as char)
        sb.append(server.quoted("static"))
        sb.append("," as char)
        sb.append(server.quoted("defaultLibrary"))
        sb.append("]" as char)
        sb.append("}" as char)                    ; } legend
        sb.append("," as char)
        sb.append(server.key("full"))
        sb.append "true"
        sb.append("}" as char)                    ; } semanticTokensProvider
        sb.append("," as char)
        sb.append(server.key("workspaceSymbolProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("inlayHintProvider"))
        sb.append "true"
        sb.append("," as char)
        ; codeActionProvider as a bare true rather than CodeActionOptions: we
        ; advertise no codeActionKinds filter, so the client asks on every
        ; position and we answer [] where there is nothing to fix.
        sb.append(server.key("codeActionProvider"))
        sb.append "true"
        sb.append("," as char)
        ; codeLensProvider must be a CodeLensOptions object (the spec has no
        ; boolean form). resolveProvider:false — every lens arrives with its
        ; title already computed, because the title IS the verdict and there is
        ; no cheaper half to send first.
        sb.append(server.key("codeLensProvider"))
        sb.append("{" as char)
        sb.append(server.key("resolveProvider"))
        sb.append "false"
        sb.append("}" as char)
        sb.append("," as char)
        sb.append(server.key("selectionRangeProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("typeDefinitionProvider"))
        sb.append "true"
        sb.append("," as char)
        sb.append(server.key("callHierarchyProvider"))
        sb.append "true"
        sb.append("}" as char)                    ; } capabilities
        sb.append("," as char)
        sb.append(server.key("serverInfo"))
        sb.append("{" as char)                    ; serverInfo {
        sb.append(server.key("name"))
        sb.append(server.quoted("scalyls"))
        sb.append("," as char)
        sb.append(server.key("version"))
        sb.append(server.quoted("0.1.0"))
        sb.append("}" as char)                    ; } serverInfo
        sb.append("}" as char)                    ; } result
        sb.append("}" as char)                    ; } root
        sb.to_string()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":null}
    function null_result_response(rp, id: i64) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("jsonrpc"))
        sb.append(server.quoted("2.0"))
        sb.append("," as char)
        sb.append(server.key("id"))
        sb.append(json.format_i64(id))
        sb.append("," as char)
        sb.append(server.key("result"))
        sb.append "null"
        sb.append("}" as char)
        sb.to_string()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is a
    ; pre-serialized JSON value (the DocumentSymbol[] array).
    ;
    ; `result` can be many KB (a big file's outline). It is appended ONE BYTE
    ; AT A TIME, not via a single StringBuilder.append(String): a single
    ; append that more than doubles the buffer hits the runtime's manual-grow
    ; path (own_page.allocate of the whole buffer), which SIGSEGVs past one
    ; exclusive page. This runs in the PARENT (no crash isolation), so the
    ; byte-at-a-time form is what keeps a large outline from killing the
    ; server. See symbols.scaly's STRING/JSON NOTE.
    function document_symbol_response(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("jsonrpc"))
        sb.append(server.quoted("2.0"))
        sb.append("," as char)
        sb.append(server.key("id"))
        sb.append(json.format_i64(id))
        sb.append("," as char)
        sb.append(server.key("result"))
        var ci: size_t 0
        let cn result.get_length()
        while ci < cn
        {
            sb.append(result.get(ci) as char)
            set ci: ci + 1
        }
        sb.append("}" as char)
        sb.to_string()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized hover object, or null when empty (no symbol at cursor).
    ; Hover payloads are small, so a single append is fine here.
    function hover_response(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("jsonrpc"))
        sb.append(server.quoted("2.0"))
        sb.append("," as char)
        sb.append(server.key("id"))
        sb.append(json.format_i64(id))
        sb.append("," as char)
        sb.append(server.key("result"))
        if result.get_length() = 0
            sb.append "null"
        if result.get_length() > 0
            sb.append result
        sb.append("}" as char)
        sb.to_string()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized Location object, or null when empty (no declaration found
    ; for the identifier under the cursor). A single Location is small, so a
    ; single append is fine here.
    function definition_response(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder()
        sb.append("{" as char)
        sb.append(server.key("jsonrpc"))
        sb.append(server.quoted("2.0"))
        sb.append("," as char)
        sb.append(server.key("id"))
        sb.append(json.format_i64(id))
        sb.append("," as char)
        sb.append(server.key("result"))
        if result.get_length() = 0
            sb.append "null"
        if result.get_length() > 0
            sb.append result
        sb.append("}" as char)
        sb.to_string()
    }

    ; `"key":`  (quoted key followed by a colon)
    function key(rp, k: Slice[char]) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)
        sb.append(k.data, k.length)
        sb.append("\"" as char)
        sb.append(":" as char)
        sb.to_string()
    }

    ; `"s"`  (quoted string literal; no escaping — fixed ASCII only)
    function quoted(rp, s: Slice[char]) returns String
    {
        var sb StringBuilder()
        sb.append("\"" as char)
        sb.append(s.data, s.length)
        sb.append("\"" as char)
        sb.to_string()
    }
}
