; server.scaly - LSP JSON-RPC lifecycle + dispatch loop.
;
; Reads Content-Length framed messages from stdin (scalyls.rpc), parses
; each body as JSON (scalyls.json), dispatches on `method`, and writes
; framed JSON responses to stdout. Requests (with an `id`) get a Response;
; notifications (no `id`) do not.
;
; Lifecycle handled here:
;   initialize   -> capabilities + serverInfo
;   initialized  -> notification, ignored
;   shutdown     -> null result
;   exit         -> terminate the process
;
; Diagnostics for textDocument/didOpen and textDocument/didChange live in
; scalyls.diagnostics; the dispatch hooks call into it.
;
; STRING/JSON NOTE: outgoing JSON is assembled with a local StringBuilder,
; appending to it directly (the in-place method-call form, which is the
; only StringBuilder-mutation that propagates — an aggregate receiver is
; copied across a plain call boundary). Helpers therefore RETURN String
; pieces (the format_i64#/quote_string# pattern) rather than mutating a
; passed-in builder. Double quotes are injected as 0x22 bytes (the lexer
; does not decode `\"` reliably — same class as the CR/LF escape issue).
;
; CONTROL-FLOW NOTE: `guard COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line (`;` starts a comment, not a separator).

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.memory.Page
use scaly.memory.runtime
use scalyls.rpc
use scalyls.json
use scalyls.json.JsonValue
use scalyls.diagnostics
use scalyls.docstore
use scalyls.symbols
use scalyls.worker

define server
{
    ; Main loop: read a frame, dispatch, repeat. An empty body means EOF
    ; on stdin -> shut the loop down.
    function run()
    {
        ; Each message is read + dispatched inside process_one(), a plain
        ; (non-#) helper. The message body — read via read_message#() onto
        ; the HELPER's local page (rp resolves to the callee's own root
        ; page) — and everything the dispatch allocates on that page are
        ; reclaimed when process_one() returns, every iteration. Reading
        ; the body directly on run()'s never-returning loop page instead
        ; pinned one oversized body page per edit there forever.
        while server.process_one()
            0
    }

    ; Read and dispatch a single message. Returns true to continue the
    ; loop, false at EOF (empty body) to shut it down. The body lives on
    ; this function's local page and is freed on return.
    function process_one() returns bool
    {
        let body rpc.read_message#()
        guard body.get_length() = (0 as size_t)
            return false

        server.handle_message(body)
        true
    }

    function handle_message(body: String)
    {
        let msg json.parse#(body)

        let method_val json.get(msg, "method")
        let method json.as_string#(method_val)

        ; An `id` field marks a Request (needs a Response). Notifications
        ; carry no id. A comparison result bound straight to a `let`
        ; mis-plans under stage-0, so latch has_id via a guard instead.
        let id_val json.get(msg, "id")
        var has_id true
        guard json.is_null(id_val)
            set has_id: false
        let id json.as_i64(id_val)

        guard method.equals("initialize")
        {
            guard has_id
                rpc.write_message(server.initialize_response#(id))
            return
        }

        guard method.equals("shutdown")
        {
            guard has_id
                rpc.write_message(server.null_result_response#(id))
            return
        }

        guard method.equals("exit")
        {
            exit(0)
            return
        }

        guard method.equals("textDocument/didOpen")
        {
            server.handle_did_open(msg)
            return
        }

        guard method.equals("textDocument/didChange")
        {
            server.handle_did_change(msg)
            return
        }

        guard method.equals("textDocument/didClose")
        {
            server.handle_did_close(msg)
            return
        }

        guard method.equals("textDocument/documentSymbol")
        {
            guard has_id
                server.handle_document_symbol(msg, id)
            return
        }

        guard method.equals("textDocument/hover")
        {
            guard has_id
                server.handle_hover(msg, id)
            return
        }

        guard method.equals("textDocument/definition")
        {
            guard has_id
                server.handle_definition(msg, id)
            return
        }

        guard method.equals("textDocument/references")
        {
            guard has_id
                server.handle_references(msg, id)
            return
        }

        guard method.equals("textDocument/documentHighlight")
        {
            guard has_id
                server.handle_document_highlight(msg, id)
            return
        }

        guard method.equals("textDocument/completion")
        {
            guard has_id
                server.handle_completion(msg, id)
            return
        }

        guard method.equals("textDocument/prepareRename")
        {
            guard has_id
                server.handle_prepare_rename(msg, id)
            return
        }

        guard method.equals("textDocument/rename")
        {
            guard has_id
                server.handle_rename(msg, id)
            return
        }

        ; initialized + any other notification: ignore. Unknown requests
        ; are left unanswered for now (the client tolerates this for the
        ; methods we do not advertise).
    }

    ; ====================================================================
    ; Document sync -> diagnostics
    ; ====================================================================

    function handle_did_open(msg: JsonValue)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let text json.as_string#(json.get(doc, "text"))
        ; Remember the buffer so later navigation requests (which carry only a
        ; uri) see this text — including unsaved edits — instead of disk.
        docstore.put(uri, text)
        server.publish_for(uri, text)
    }

    function handle_did_change(msg: JsonValue)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))

        ; textDocumentSync = incremental: each contentChange is either a
        ; ranged edit (replace the [start,end) span with its text) or a
        ; full-document replacement (no range). Apply them in order, starting
        ; from the current stored buffer, to rebuild the whole document.
        let changes json.get(params, "contentChanges")
        let n json.array_length(changes)
        guard n = (0 as size_t)
            return

        var text docstore.get#(uri)
        var i: size_t 0
        while i < n
        {
            let change json.array_get(changes, i)
            set text: server.apply_change#(text, change)
            set i: i + 1
        }
        ; Store the rebuilt buffer so navigation sees this (unsaved) edit.
        docstore.put(uri, text)
        server.publish_for(uri, text)
    }

    ; Apply one LSP contentChange to `text`, returning the new full document.
    ; No `range` -> a full-document replacement (the change text IS the whole
    ; document). With a range -> replace the [start,end) span (start/end as
    ; 0-based line/character) with the change text. The result is assembled
    ; ONE BYTE AT A TIME (prefix, inserted text, suffix): a single
    ; StringBuilder.append of a large String hits the runtime's manual-grow
    ; crash (see symbols.scaly's STRING/JSON NOTE).
    function apply_change#(rp, text: String, change: JsonValue) returns String
    {
        let range json.get(change, "range")
        let new_text json.as_string#(json.get(change, "text"))

        guard json.is_null(range)
            return new_text

        let start json.get(range, "start")
        let end json.get(range, "end")
        let s_line json.as_i64(json.get(start, "line"))
        let s_char json.as_i64(json.get(start, "character"))
        let e_line json.as_i64(json.get(end, "line"))
        let e_char json.as_i64(json.get(end, "character"))
        let s_off symbols.position_to_offset#(text, s_line as size_t, s_char as size_t)
        let e_off symbols.position_to_offset#(text, e_line as size_t, e_char as size_t)

        var sb StringBuilder#()
        var i: size_t 0
        while i < s_off
        {
            sb.append(text.get(i) as char)
            set i: i + 1
        }
        var j: size_t 0
        let nn new_text.get_length()
        while j < nn
        {
            sb.append(new_text.get(j) as char)
            set j: j + 1
        }
        let tlen text.get_length()
        var k e_off
        while k < tlen
        {
            sb.append(text.get(k) as char)
            set k: k + 1
        }
        sb.to_string#()
    }

    ; documentSymbol: return the outline tree for the requested document.
    ; The request carries only a uri (no text), so the worker re-reads the
    ; file from disk. The result is the DocumentSymbol[] array wrapped in a
    ; Response envelope with the request id.
    function handle_document_symbol(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        ; In-memory text (empty -> worker reads disk) so the outline reflects
        ; unsaved edits.
        let text docstore.get#(uri)
        let result worker.symbols#(uri, text)
        rpc.write_message(server.document_symbol_response#(id, result))
    }

    ; hover: the request carries a uri + a {line,character} position. Pack the
    ; position as "<line> <char>" and hand it to the worker, which re-reads the
    ; file (the server is stateless) and reports the symbol under the cursor.
    ; An empty worker reply -> result:null.
    function handle_hover(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.hover#(uri, text, packed)
        rpc.write_message(server.hover_response#(id, result))
    }

    ; definition: like hover, the request carries a uri + {line,character}.
    ; Pack the position as "<line> <char>" and hand it to the worker, which
    ; re-reads the file and resolves the identifier under the cursor to a
    ; declaration in the same file. An empty worker reply -> result:null.
    function handle_definition(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.definition#(uri, text, packed)
        rpc.write_message(server.definition_response#(id, result))
    }

    ; references: the request carries a uri + {line,character} + a
    ; context.includeDeclaration flag (ignored — the lexical scan cannot
    ; distinguish the declaration from uses, so all whole-token occurrences
    ; are always returned). Pack the position and hand it to the worker, which
    ; re-reads the file and scans it. The result is a Location[] array.
    function handle_references(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.references#(uri, text, packed)
        ; document_symbol_response# wraps a pre-serialized JSON array as the
        ; result, appending it byte-at-a-time (a many-occurrence array can be
        ; large — same large-append hazard as the outline).
        rpc.write_message(server.document_symbol_response#(id, result))
    }

    ; documentHighlight: like references but the result ranges carry no uri
    ; (the editor highlights occurrences in the current document only).
    function handle_document_highlight(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.highlights#(uri, text, packed)
        rpc.write_message(server.document_symbol_response#(id, result))
    }

    ; completion: return every declared name in the document as a flat
    ; CompletionItem[] (the editor prefix-filters; the cursor position is not
    ; used). Like the other navigation requests, the in-memory text is passed
    ; so unsaved edits are reflected; an empty buffer -> worker reads disk.
    function handle_completion(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let text docstore.get#(uri)
        ; The CompletionItem[] array can be large (many names); reuse the
        ; byte-at-a-time array wrapper.
        let result worker.completion#(uri, text, String#(""))
        rpc.write_message(server.document_symbol_response#(id, result))
    }

    ; prepareRename: the request carries a uri + {line,character}. Pack the
    ; position as "<line> <char>" and ask the worker for the range of the
    ; renameable identifier under the cursor. An empty worker reply ->
    ; result:null (the editor then refuses the rename).
    function handle_prepare_rename(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.prepare_rename#(uri, text, packed)
        rpc.write_message(server.hover_response#(id, result))
    }

    ; rename: the request carries a uri + {line,character} + a newName. Pack
    ; the position AND the new name as "<line> <char> <newName>" and ask the
    ; worker to rewrite every whole-token occurrence of the identifier at the
    ; cursor. The result is an LSP WorkspaceEdit (can be large -> byte-at-a-time
    ; wrap); an empty worker reply -> result:null.
    function handle_rename(msg: JsonValue, id: i64)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        let position json.get(params, "position")
        let line json.as_i64(json.get(position, "line"))
        let character json.as_i64(json.get(position, "character"))
        let new_name json.as_string#(json.get(params, "newName"))

        var pb StringBuilder#()
        pb.append(json.format_i64#(line))
        pb.append(0x20 as char)                    ; space
        pb.append(json.format_i64#(character))
        pb.append(0x20 as char)                    ; space
        ; new_name is an identifier (no spaces). Append byte-at-a-time (small,
        ; but keeps to the no-StringBuilder.append(String) discipline).
        var ni: size_t 0
        let nn new_name.get_length()
        while ni < nn
        {
            pb.append(new_name.get(ni) as char)
            set ni: ni + 1
        }
        let packed pb.to_string#()

        let text docstore.get#(uri)
        let result worker.rename#(uri, text, packed)
        ; Empty -> not renameable / worker unavailable -> null. A real
        ; WorkspaceEdit can be large, so wrap it byte-at-a-time.
        guard result.get_length() = (0 as size_t)
            rpc.write_message(server.null_result_response#(id))
        guard result.get_length() > (0 as size_t)
            rpc.write_message(server.document_symbol_response#(id, result))
    }

    ; A closed document leaves no buffer to analyze; clear whatever
    ; diagnostics the editor still shows for it (empty diagnostics array).
    function handle_did_close(msg: JsonValue)
    {
        let params json.get(msg, "params")
        let doc json.get(params, "textDocument")
        let uri json.as_string#(json.get(doc, "uri"))
        ; Drop the in-memory buffer; subsequent requests fall back to disk.
        docstore.remove(uri)
        let payload diagnostics.clear_diagnostics#(uri)
        rpc.write_message(payload)
    }

    ; Diagnostics are computed in a crash-isolated worker subprocess (see
    ; scalyls.worker): a SIGSEGV/abort/hang in the compiler pipeline on a
    ; bad document then loses only that one result, not the whole server.
    function publish_for(uri: String, text: String)
    {
        let payload worker.analyze#(uri, text)
        rpc.write_message(payload)
    }

    ; ====================================================================
    ; Response builders (local StringBuilder; quotes as 0x22 bytes; nested
    ; pieces via String-returning helpers)
    ; ====================================================================

    ; {"jsonrpc":"2.0","id":<id>,"result":{"capabilities":
    ;   {"textDocumentSync":1},"serverInfo":{"name":"scalyls",
    ;   "version":"0.1.0"}}}
    function initialize_response#(rp, id: i64) returns String
    {
        var sb StringBuilder#()
        sb.append(0x7B as char)                    ; {
        sb.append(server.key#("jsonrpc"))
        sb.append(server.quoted#("2.0"))
        sb.append(0x2C as char)                    ; ,
        sb.append(server.key#("id"))
        sb.append(json.format_i64#(id))
        sb.append(0x2C as char)
        sb.append(server.key#("result"))
        sb.append(0x7B as char)                    ; result {
        sb.append(server.key#("capabilities"))
        sb.append(0x7B as char)                    ; capabilities {
        sb.append(server.key#("textDocumentSync"))
        sb.append(0x32 as char)                    ; 2 = incremental
        sb.append(0x2C as char)
        sb.append(server.key#("documentSymbolProvider"))
        sb.append("true")
        sb.append(0x2C as char)
        sb.append(server.key#("hoverProvider"))
        sb.append("true")
        sb.append(0x2C as char)
        sb.append(server.key#("definitionProvider"))
        sb.append("true")
        sb.append(0x2C as char)
        sb.append(server.key#("referencesProvider"))
        sb.append("true")
        sb.append(0x2C as char)
        sb.append(server.key#("documentHighlightProvider"))
        sb.append("true")
        sb.append(0x2C as char)
        ; completionProvider must be a CompletionOptions object (not a bool).
        ; Empty {} = no trigger chars; the editor invokes it on word typing.
        sb.append(server.key#("completionProvider"))
        sb.append(0x7B as char)                    ; {
        sb.append(0x7D as char)                    ; }
        sb.append(0x2C as char)
        ; renameProvider as RenameOptions {prepareProvider:true} so the editor
        ; also calls textDocument/prepareRename to validate + pre-fill.
        sb.append(server.key#("renameProvider"))
        sb.append(0x7B as char)                    ; {
        sb.append(server.key#("prepareProvider"))
        sb.append("true")
        sb.append(0x7D as char)                    ; }
        sb.append(0x7D as char)                    ; } capabilities
        sb.append(0x2C as char)
        sb.append(server.key#("serverInfo"))
        sb.append(0x7B as char)                    ; serverInfo {
        sb.append(server.key#("name"))
        sb.append(server.quoted#("scalyls"))
        sb.append(0x2C as char)
        sb.append(server.key#("version"))
        sb.append(server.quoted#("0.1.0"))
        sb.append(0x7D as char)                    ; } serverInfo
        sb.append(0x7D as char)                    ; } result
        sb.append(0x7D as char)                    ; } root
        sb.to_string#()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":null}
    function null_result_response#(rp, id: i64) returns String
    {
        var sb StringBuilder#()
        sb.append(0x7B as char)
        sb.append(server.key#("jsonrpc"))
        sb.append(server.quoted#("2.0"))
        sb.append(0x2C as char)
        sb.append(server.key#("id"))
        sb.append(json.format_i64#(id))
        sb.append(0x2C as char)
        sb.append(server.key#("result"))
        sb.append("null")
        sb.append(0x7D as char)
        sb.to_string#()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is a
    ; pre-serialized JSON value (the DocumentSymbol[] array).
    ;
    ; `result` can be many KB (a big file's outline). It is appended ONE BYTE
    ; AT A TIME, not via a single StringBuilder.append(String): a single
    ; append that more than doubles the buffer hits the runtime's manual-grow
    ; path (own_page.allocate of the whole buffer), which SIGSEGVs past one
    ; exclusive page. This runs in the PARENT (no crash isolation), so the
    ; byte-at-a-time form is what keeps a large outline from killing the
    ; server. See symbols.scaly's STRING/JSON NOTE.
    function document_symbol_response#(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder#()
        sb.append(0x7B as char)
        sb.append(server.key#("jsonrpc"))
        sb.append(server.quoted#("2.0"))
        sb.append(0x2C as char)
        sb.append(server.key#("id"))
        sb.append(json.format_i64#(id))
        sb.append(0x2C as char)
        sb.append(server.key#("result"))
        var ci: size_t 0
        let cn result.get_length()
        while ci < cn
        {
            sb.append(result.get(ci) as char)
            set ci: ci + 1
        }
        sb.append(0x7D as char)
        sb.to_string#()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized hover object, or null when empty (no symbol at cursor).
    ; Hover payloads are small, so a single append is fine here.
    function hover_response#(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder#()
        sb.append(0x7B as char)
        sb.append(server.key#("jsonrpc"))
        sb.append(server.quoted#("2.0"))
        sb.append(0x2C as char)
        sb.append(server.key#("id"))
        sb.append(json.format_i64#(id))
        sb.append(0x2C as char)
        sb.append(server.key#("result"))
        guard result.get_length() = (0 as size_t)
            sb.append("null")
        guard result.get_length() > (0 as size_t)
            sb.append(result)
        sb.append(0x7D as char)
        sb.to_string#()
    }

    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized Location object, or null when empty (no declaration found
    ; for the identifier under the cursor). A single Location is small, so a
    ; single append is fine here.
    function definition_response#(rp, id: i64, result: String) returns String
    {
        var sb StringBuilder#()
        sb.append(0x7B as char)
        sb.append(server.key#("jsonrpc"))
        sb.append(server.quoted#("2.0"))
        sb.append(0x2C as char)
        sb.append(server.key#("id"))
        sb.append(json.format_i64#(id))
        sb.append(0x2C as char)
        sb.append(server.key#("result"))
        guard result.get_length() = (0 as size_t)
            sb.append("null")
        guard result.get_length() > (0 as size_t)
            sb.append(result)
        sb.append(0x7D as char)
        sb.to_string#()
    }

    ; `"key":`  (quoted key followed by a colon)
    function key#(rp, k: pointer[const_char]) returns String
    {
        var sb StringBuilder#()
        sb.append(0x22 as char)
        sb.append(k)
        sb.append(0x22 as char)
        sb.append(0x3A as char)                    ; :
        sb.to_string#()
    }

    ; `"s"`  (quoted string literal; no escaping — fixed ASCII only)
    function quoted#(rp, s: pointer[const_char]) returns String
    {
        var sb StringBuilder#()
        sb.append(0x22 as char)
        sb.append(s)
        sb.append(0x22 as char)
        sb.to_string#()
    }
}
