; semantic.scaly - planner-based (semantic) type resolution.
;
; The lexical type resolvers in symbols.scaly (resolve_variable_type# /
; resolve_chain_type# / member_type_ws# / infer_binding_type# /
; concept_or_return_type#) walk the PARSE TREE only and hit a hard ceiling:
; they cannot resolve a reassigned variable, a generic type's element type
; (Box[int].get() -> int), a pointer/ref inner type, or a method call in the
; MIDDLE of a chain (a.f().b).
;
; This module breaks that ceiling by running the SAME modeler+planner
; pipeline the diagnostics path already runs (parser -> Modeler.build_program#
; -> Planner.plan_program), then walking the resulting Plan for the planned
; node whose source span best covers a byte offset, and reading its
; already-resolved type. Every Planned* node carries a `loc: Span` (source
; byte offsets) AND a resolved PlannedType, so the offset -> type map is just
; a tree walk — no compiler change, fixpoint-safe.
;
; WALK MODE (threaded as a parameter — a module-mutable global was rejected by
; stage-0 here). The SAME traversal reports a different node's type per mode:
;   0 HOVER    — the smallest-span expression covering the offset (final type
;                after member access; the call over its same-span receiver).
;   2 RECEIVER — the innermost receiver's OWN base type (completion wants g's
;                type from `g.member`, not the enclosing member-access type).
; (Mode 1 — a binding's declared type for inlay hints — was evaluated and
; dropped: stage-0's planner mis-types a binding VALUE for the mid-chain shapes
; the lexical walk can't reach, so it would surface a wrong hint. Inlay type
; hints stay lexical; see symbols.scaly::infer_binding_type#.)
;
; CHOOSING THE NODE (mode 0) — width, not depth. Planner spans are coarse: a
; method call's receiver shares the call's span, and a function body is wrapped
; in one `void` block operand. So "innermost by tree depth" wrongly picks the
; receiver (Point) over the call result (int). The walk picks the SMALLEST-
; width operand containing the offset, prefers the OUTER one on an equal-width
; tie, and skips `void`/empty so an uncovered offset (a binding name) falls
; through to the lexical hover.
;
; The pipeline can SIGSEGV / hang on bad input, so this runs in the same
; crash-isolated worker as diagnostics; the server / lexical resolvers fall
; back on a miss / crash.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line. Plan unions are matched by VARIANT TAG NAME
; (`when c: Call` binds the PlannedCall payload) — NOT by payload type
; (unlike the Syntax unions in symbols.scaly). In a choose returning a value,
; EVERY arm uses an explicit return.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Vector
use scaly.memory.Page
use scaly.memory.runtime

use scalyls.diagnostics

use scalyc.compiler.parser
use scalyc.compiler.Modeler
use scalyc.compiler.Model.Program
use scalyc.compiler.Model.Span
use scalyc.compiler.Planner

use scalyc.compiler.Plan.Plan
use scalyc.compiler.Plan.PlannedType
use scalyc.compiler.Plan.PlannedOperand
use scalyc.compiler.Plan.PlannedStatement
use scalyc.compiler.Plan.PlannedExpression
use scalyc.compiler.Plan.PlannedImplementation
use scalyc.compiler.Plan.PlannedAction
use scalyc.compiler.Plan.PlannedBinding
use scalyc.compiler.Plan.PlannedBlock
use scalyc.compiler.Plan.PlannedCall
use scalyc.compiler.Plan.PlannedTuple
use scalyc.compiler.Plan.PlannedComponent
use scalyc.compiler.Plan.PlannedIf
use scalyc.compiler.Plan.PlannedMatch
use scalyc.compiler.Plan.PlannedBranch
use scalyc.compiler.Plan.PlannedChoose
use scalyc.compiler.Plan.PlannedWhen
use scalyc.compiler.Plan.PlannedFor
use scalyc.compiler.Plan.PlannedWhile
use scalyc.compiler.Plan.PlannedRepeat
use scalyc.compiler.Plan.PlannedTry
use scalyc.compiler.Plan.PlannedAs
use scalyc.compiler.Plan.PlannedIs
use scalyc.compiler.Plan.PlannedVariantConstruction
use scalyc.compiler.Plan.PlannedFunction
use scalyc.compiler.Plan.PlannedStructure
use scalyc.compiler.Plan.PlannedUnion
use scalyc.compiler.Plan.PlannedInitializer
use scalyc.compiler.Plan.PlannedOperator
use scalyc.compiler.Plan.PlannedDeInitializer
use scalyc.compiler.Plan.PlannedGlobal
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

; A resolution candidate: `found` true with a non-empty `type_name`, plus the
; source-span `width` of the operand it came from (smaller = tighter match).
define ResolveResult
(
    found: bool
    width: size_t
    type_name: String
)

define semantic
{
    ; HOVER entry: resolve the type at the packed "<line> <char>" position.
    ; Returns the resolved type name (e.g. "int", "Point",
    ; "scaly.containers.String"), or "" on a miss / parse error / unresolved.
    function semantic_type_packed(rp, source: String, uri: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let n packed.get_length()
        while i < n
        {
            let c packed.get i
            if c = (0x20 as u8)
                set seen_space: true
            if c <> (0x20 as u8)
            {
                let digit (c - (0x30 as u8)) as size_t
                if seen_space = false
                    set line: line * (10 as size_t) + digit
                if seen_space
                    set character: character * (10 as size_t) + digit
            }
            set i: i + 1
        }
        let offset semantic.position_to_offset(source, line, character)
        ; Only resolve when the cursor sits on a real token. Hovering
        ; whitespace / past EOF defers to the lexical hover (which reports the
        ; enclosing declaration) — and keeps coarse planner spans from
        ; reporting a body expression's type for a cursor on inter-token
        ; whitespace.
        let len source.get_length()
        if offset >= len
            return ""
        let b source.get offset
        if b = (0x20 as u8)
            return ""
        if b = (0x09 as u8)
            return ""
        if b = (0x0A as u8)
            return ""
        if b = (0x0D as u8)
            return ""
        let path diagnostics.strip_uri(uri)
        semantic.resolve_at(source, path, 0 as size_t, offset)
    }

    ; Worker reply wrapper: a leading status byte distinguishes a genuine
    ; MISS ("0") from a pipeline CRASH (empty frame). Without it, an empty
    ; reply on a legitimate miss would be read as a crash by worker.exchange#
    ; and respawn the worker on every hover. On a hit the reply is "1<name>".
    function semantic_type_framed(rp, source: String, uri: String, packed: String) returns String
    {
        let ty semantic.semantic_type_packed(source, uri, packed)
        var sb StringBuilder()
        if ty.get_length() > (0 as size_t)
        {
            sb.append(0x31 as char)                ; '1' = hit
            sb.append ty
            return sb.to_string()
        }
        sb.append(0x30 as char)                    ; '0' = miss
        sb.to_string()
    }

    ; COMPLETION entry (mode 2): the OWN type of the receiver expression at
    ; `offset` (the innermost variable's base type, NOT the enclosing member
    ; access). "" on a miss / unresolved.
    function receiver_type_at_offset(rp, source: String, uri: String, offset: size_t) returns String
    {
        let path diagnostics.strip_uri(uri)
        semantic.resolve_at(source, path, 2 as size_t, offset)
    }

    ; Run the full pipeline and walk the Plan for the type at `offset`.
    function resolve_at(rp, source: String, path: String, mode: size_t, offset: size_t) returns String
    {
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                return ""
            when program: Success
            {
                let prog_name "document"
                let model Modeler.build_program(path, prog_name, program, true)
                var planner Planner.Planner(path)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model
                if plan <> null
                {
                    let pl (*plan)
                    let rr semantic.walk_plan(pl, mode, offset)
                    if rr.found
                        set result: String(rr.type_name)
                }
            }
        result
    }

    ; 0-based (line, character) -> byte offset (self-contained copy of
    ; symbols.position_to_offset#, so this module does not depend on symbols —
    ; symbols depends on semantic for the Phase-2 prefer/fallback).
    function position_to_offset(rp, source: String, line: size_t, character: size_t) returns size_t
    {
        let len source.get_length()
        var off: size_t 0
        var cur_line: size_t 0
        while cur_line < line
        {
            if off >= len
                return off
            let c source.get off
            set off: off + 1
            if c = (10 as char)
                set cur_line: cur_line + 1
        }
        var col: size_t 0
        while col < character
        {
            if off >= len
                return off
            let c source.get off
            if c = (10 as char)
                return off
            set off: off + 1
            set col: col + 1
        }
        off
    }

    function none(rp) returns ResolveResult
        ResolveResult(false, 0 as size_t, "")

    ; ====================================================================
    ; Plan walk — first FOUND match wins across non-overlapping siblings.
    ; ====================================================================
    function walk_plan(rp, plan: Plan, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()

        if plan.statements <> null
            set result: semantic.walk_statements(*plan.statements, mode, offset)

        if result.found = false
        {
            if plan.functions <> null
            {
                let fns (*plan.functions)
                var i: size_t 0
                while i < fns.length
                {
                    if result.found = false
                    {
                        let fp fns.get i
                        if fp <> null
                            set result: semantic.walk_impl((*fp).impl, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.structures <> null
            {
                let sts (*plan.structures)
                var i: size_t 0
                while i < sts.length
                {
                    if result.found = false
                    {
                        let sp sts.get i
                        if sp <> null
                            set result: semantic.walk_structure(*sp, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.unions <> null
            {
                let uns (*plan.unions)
                var i: size_t 0
                while i < uns.length
                {
                    if result.found = false
                    {
                        let up uns.get i
                        if up <> null
                            set result: semantic.walk_union(*up, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.globals <> null
            {
                let gls (*plan.globals)
                var i: size_t 0
                while i < gls.length
                {
                    if result.found = false
                    {
                        let gp gls.get i
                        if gp <> null
                        {
                            let g (*gp)
                            if g.value <> null
                                set result: semantic.walk_operands(*g.value, mode, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }

        result
    }

    function walk_structure(rp, st: PlannedStructure, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()

        if st.methods <> null
        {
            let ms (*st.methods)
            var i: size_t 0
            while i < ms.length
            {
                if result.found = false
                {
                    let mp ms.get i
                    if mp <> null
                        set result: semantic.walk_impl((*mp).impl, mode, offset)
                }
                set i: i + 1
            }
        }

        if result.found = false
        {
            if st.initializers <> null
            {
                let inits (*st.initializers)
                var i: size_t 0
                while i < inits.length
                {
                    if result.found = false
                    {
                        let ip inits.get i
                        if ip <> null
                            set result: semantic.walk_impl((*ip).impl, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        if result.found = false
        {
            if st.operators <> null
            {
                let ops (*st.operators)
                var i: size_t 0
                while i < ops.length
                {
                    if result.found = false
                    {
                        let op ops.get i
                        if op <> null
                            set result: semantic.walk_impl((*op).impl, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        if result.found = false
        {
            if st.deinitializer <> null
                set result: semantic.walk_impl((*st.deinitializer).impl, mode, offset)
        }

        result
    }

    function walk_union(rp, un: PlannedUnion, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()

        if un.methods <> null
        {
            let ms (*un.methods)
            var i: size_t 0
            while i < ms.length
            {
                if result.found = false
                {
                    let mp ms.get i
                    if mp <> null
                        set result: semantic.walk_impl((*mp).impl, mode, offset)
                }
                set i: i + 1
            }
        }

        if result.found = false
        {
            if un.operators <> null
            {
                let ops (*un.operators)
                var i: size_t 0
                while i < ops.length
                {
                    if result.found = false
                    {
                        let op ops.get i
                        if op <> null
                            set result: semantic.walk_impl((*op).impl, mode, offset)
                    }
                    set i: i + 1
                }
            }
        }

        result
    }

    function walk_impl(rp, impl: PlannedImplementation, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose impl
            when action: Action
                return semantic.walk_action(action, mode, offset)
            when ext: Extern
                return semantic.none()
            when inst: Instruction
                return semantic.none()
            when intr: Intrinsic
                return semantic.none()
    }

    function walk_action(rp, act: PlannedAction, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if act.source <> null
            set result: semantic.walk_operands(*act.source, mode, offset)
        if result.found = false
        {
            if act.target <> null
                set result: semantic.walk_operands(*act.target, mode, offset)
        }
        result
    }

    ; ====================================================================
    ; Statements
    ; ====================================================================
    function walk_statements(rp, stmts: Vector[PlannedStatement], mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        var i: size_t 0
        while i < stmts.length
        {
            if result.found = false
            {
                let sp stmts.get i
                if sp <> null
                    set result: semantic.walk_statement(*sp, mode, offset)
            }
            set i: i + 1
        }
        result
    }

    function walk_statement(rp, stmt: PlannedStatement, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose stmt
            when a: Action
                return semantic.walk_action(a, mode, offset)
            when bnd: Binding
                return semantic.walk_binding(bnd, mode, offset)
            when br: Break
                return semantic.walk_operands_opt(br.result, mode, offset)
            when ret: Return
                return semantic.walk_operands_opt(ret.result, mode, offset)
            when th: Throw
                return semantic.walk_operands_opt(th.result, mode, offset)
            when cont: Continue
                return semantic.none()
    }

    function walk_binding(rp, bnd: PlannedBinding, mode: size_t, offset: size_t) returns ResolveResult
    {
        if bnd.operation <> null
        {
            let r semantic.walk_operands(*bnd.operation, mode, offset)
            if r.found
                return r
        }
        ; Cursor on the binding NAME -> the binding item's inferred type.
        let bi bnd.binding_item
        if bi.item_type <> null
        {
            if semantic.contains(bi.loc, offset)
            {
                let tn semantic.type_name(*bi.item_type)
                if tn.get_length() > (0 as size_t)
                    return ResolveResult(true, bi.loc.end - bi.loc.start, tn)
            }
        }
        semantic.none()
    }

    ; ====================================================================
    ; Operands / expressions
    ; ====================================================================
    function walk_operands(rp, ops: Vector[PlannedOperand], mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        var i: size_t 0
        while i < ops.length
        {
            if result.found = false
            {
                let op ops.get i
                if op <> null
                    set result: semantic.walk_operand(*op, mode, offset)
            }
            set i: i + 1
        }
        result
    }

    function walk_operands_opt(rp, opt: ref[Vector[PlannedOperand]]?, mode: size_t, offset: size_t) returns ResolveResult
    {
        if opt <> null
            return semantic.walk_operands(*opt, mode, offset)
        semantic.none()
    }

    function walk_operand(rp, op: PlannedOperand, mode: size_t, offset: size_t) returns ResolveResult
    {
        ; Prune: children spans nest inside the operand's span.
        if semantic.contains(op.loc, offset) = false
            return semantic.none()
        let self_width op.loc.end - op.loc.start
        let child semantic.walk_expr(op.expr, mode, offset)
        ; RECEIVER mode (completion): the innermost expression's OWN base type
        ; (ignoring member access / the enclosing call) — `g.member` reports
        ; g's type, not the member-access result.
        if mode = (2 as size_t)
        {
            if child.found
                return child
            let bt semantic.expr_type(op.expr, op.result_type)
            if bt.get_length() > (0 as size_t)
                return ResolveResult(true, self_width, bt)
            return semantic.none()
        }
        let self_type semantic.operand_final_type(op)
        ; A strictly-tighter deeper match wins (genuine nesting f(g x)).
        if child.found
        {
            if child.width < self_width
                return child
        }
        ; Otherwise this operand, when it has a usable (non-void) type. On an
        ; equal-width tie this beats the deeper match — the call over its
        ; same-span receiver.
        if self_type.get_length() > (0 as size_t)
            return ResolveResult(true, self_width, self_type)
        ; This operand has no usable type (a void block wrapper): defer to the
        ; deeper match even at equal width.
        if child.found
            return child
        semantic.none()
    }

    function walk_operand_opt(rp, opt: ref[PlannedOperand]?, mode: size_t, offset: size_t) returns ResolveResult
    {
        if opt <> null
            return semantic.walk_operand(*opt, mode, offset)
        semantic.none()
    }

    function walk_expr(rp, expr: PlannedExpression, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose expr
            when k: Constant
                return semantic.none()
            when ty: Type
                return semantic.none()
            when v: Variable
                return semantic.none()
            when g: GlobalRef
                return semantic.none()
            when c: Call
                return semantic.walk_call(c, mode, offset)
            when t: Tuple
                return semantic.walk_tuple(t, mode, offset)
            when mx: Matrix
                return semantic.none()
            when b: Block
                return semantic.walk_block(b, mode, offset)
            when iff: If
                return semantic.walk_if(iff, mode, offset)
            when m: Match
                return semantic.walk_match(m, mode, offset)
            when ch: Choose
                return semantic.walk_choose(ch, mode, offset)
            when fr: For
                return semantic.walk_for(fr, mode, offset)
            when wh: While
                return semantic.walk_while(wh, mode, offset)
            when rep: Repeat
                return semantic.walk_action(rep.body, mode, offset)
            when lm: Lambda
                return semantic.none()
            when tr: Try
                return semantic.walk_try(tr, mode, offset)
            when so: SizeOf
                return semantic.none()
            when ao: AlignOf
                return semantic.none()
            when iz: Is
                return semantic.walk_operand_opt(iz.value, mode, offset)
            when az: As
                return semantic.walk_operand_opt(az.value, mode, offset)
            when vc: VariantConstruction
                return semantic.walk_operand_opt(vc.value, mode, offset)
    }

    function walk_call(rp, c: PlannedCall, mode: size_t, offset: size_t) returns ResolveResult
    {
        if c.args <> null
            return semantic.walk_operands(*c.args, mode, offset)
        semantic.none()
    }

    function walk_tuple(rp, t: PlannedTuple, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if t.components <> null
        {
            let comps (*t.components)
            var i: size_t 0
            while i < comps.length
            {
                if result.found = false
                {
                    let cp comps.get i
                    if cp <> null
                    {
                        let comp (*cp)
                        if comp.value <> null
                            set result: semantic.walk_operands(*comp.value, mode, offset)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    function walk_block(rp, b: PlannedBlock, mode: size_t, offset: size_t) returns ResolveResult
    {
        if b.statements <> null
            return semantic.walk_statements(*b.statements, mode, offset)
        semantic.none()
    }

    function walk_if(rp, iff: PlannedIf, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if iff.condition <> null
            set result: semantic.walk_operands(*iff.condition, mode, offset)
        if result.found = false
        {
            if iff.consequent <> null
                set result: semantic.walk_statement(*iff.consequent, mode, offset)
        }
        if result.found = false
        {
            if iff.alternative <> null
                set result: semantic.walk_statement(*iff.alternative, mode, offset)
        }
        result
    }

    function walk_match(rp, m: PlannedMatch, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if m.condition <> null
            set result: semantic.walk_operands(*m.condition, mode, offset)
        if result.found = false
        {
            if m.branches <> null
            {
                let brs (*m.branches)
                var i: size_t 0
                while i < brs.length
                {
                    if result.found = false
                    {
                        let bp brs.get i
                        if bp <> null
                        {
                            let br (*bp)
                            if br.consequent <> null
                                set result: semantic.walk_statement(*br.consequent, mode, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        if result.found = false
        {
            if m.alternative <> null
                set result: semantic.walk_statement(*m.alternative, mode, offset)
        }
        result
    }

    function walk_choose(rp, ch: PlannedChoose, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if ch.condition <> null
            set result: semantic.walk_operands(*ch.condition, mode, offset)
        if result.found = false
        {
            if ch.cases <> null
            {
                let cs (*ch.cases)
                var i: size_t 0
                while i < cs.length
                {
                    if result.found = false
                    {
                        let wp cs.get i
                        if wp <> null
                        {
                            let wh (*wp)
                            if wh.consequent <> null
                                set result: semantic.walk_statement(*wh.consequent, mode, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        if result.found = false
        {
            if ch.alternative <> null
                set result: semantic.walk_statement(*ch.alternative, mode, offset)
        }
        result
    }

    function walk_for(rp, fr: PlannedFor, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if fr.expr <> null
            set result: semantic.walk_operands(*fr.expr, mode, offset)
        if result.found = false
            set result: semantic.walk_action(fr.body, mode, offset)
        result
    }

    function walk_while(rp, wh: PlannedWhile, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.walk_binding(wh.cond, mode, offset)
        if result.found = false
            set result: semantic.walk_action(wh.body, mode, offset)
        result
    }

    function walk_try(rp, tr: PlannedTry, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.walk_binding(tr.cond, mode, offset)
        if result.found = false
        {
            if tr.catches <> null
            {
                let cs (*tr.catches)
                var i: size_t 0
                while i < cs.length
                {
                    if result.found = false
                    {
                        let wp cs.get i
                        if wp <> null
                        {
                            let wh (*wp)
                            if wh.consequent <> null
                                set result: semantic.walk_statement(*wh.consequent, mode, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        if result.found = false
        {
            if tr.alternative <> null
                set result: semantic.walk_statement(*tr.alternative, mode, offset)
        }
        result
    }

    ; ====================================================================
    ; Type extraction
    ; ====================================================================

    ; The clean source type of an operand. PlannedOperand.result_type is often
    ; ABI-lowered (an lvalue variable reads back as `pointer`) or the chain
    ; BASE (b.get() reports the receiver), so prefer the post-access type: the
    ; LAST PlannedMemberAccess.result_type when a member chain is present (so
    ; a.f().b yields .b's type), else the expression's own typed field.
    function operand_final_type(rp, op: PlannedOperand) returns String
    {
        if op.member_access <> null
        {
            let ma (*op.member_access)
            if ma.length > (0 as size_t)
            {
                let lp ma.get(ma.length - (1 as size_t))
                if lp <> null
                    return semantic.type_name((*lp).result_type)
            }
        }
        semantic.expr_type(op.expr, op.result_type)
    }

    ; The expression's own resolved type field, falling back to `fallback`
    ; (the operand's result_type) for shapes without a cleaner field.
    function expr_type(rp, expr: PlannedExpression, fallback: PlannedType) returns String
    {
        choose expr
            when v: Variable
                return semantic.type_name(v.variable_type)
            when g: GlobalRef
                return semantic.type_name(g.global_type)
            when c: Call
                return semantic.type_name(c.result_type)
            when t: Tuple
                return semantic.type_name(t.tuple_type)
            when vc: VariantConstruction
                return semantic.type_name(vc.union_type)
            when az: As
                return semantic.type_name(az.target_type)
            else
                return semantic.type_name(fallback)
    }

    ; True when offset is within [loc.start, loc.end).
    function contains(rp, loc: Span, offset: size_t) returns bool
    {
        if offset < loc.start
            return false
        if offset >= loc.end
            return false
        true
    }

    ; The readable type name, or "" when empty / "void" / an unresolved type
    ; variable. Suppressing "void" matters: an offset on no typed sub-expr (a
    ; binding name) would otherwise bubble to the enclosing block operand and
    ; report "void", masking the lexical fallback. Suppressing a type variable
    ; (a generic param `T` the planner left unsubstituted) avoids a meaningless
    ; `: T` hint.
    function type_name(rp, pt: PlannedType) returns String
    {
        if pt.variable <> null
            return ""
        if pt.name.get_length() = (0 as size_t)
            return ""
        if pt.name.equals("void")
            return ""
        String(pt.name)
    }
}
