; semantic.scaly - planner-based (semantic) type resolution.
;
; The lexical type resolvers in symbols.scaly (resolve_variable_type# /
; resolve_chain_type# / member_type_ws# / infer_binding_type# /
; concept_or_return_type#) walk the PARSE TREE only and hit a hard ceiling:
; they cannot resolve a reassigned variable, a generic type's element type
; (Box[int].get() -> int), a pointer/ref inner type, or a method call in the
; MIDDLE of a chain (a.f().b).
;
; This module breaks that ceiling by running the SAME modeler+planner
; pipeline the diagnostics path already runs (parser -> Modeler.build_program#
; -> Planner.plan_program), then walking the resulting Plan for the planned
; node whose source span best covers a byte offset, and reading its
; already-resolved type. Every Planned* node carries a `loc: Span` (source
; byte offsets) AND a resolved PlannedType, so the offset -> type map is just
; a tree walk — no compiler change, fixpoint-safe.
;
; CHOOSING THE NODE — width, not depth. Planner spans are coarse: a method
; call's receiver shares the call's span, and a function body is wrapped in
; one `void` block operand spanning the whole body. So "innermost by tree
; depth" wrongly picks the receiver (Point) over the call result (int). The
; walk instead picks the SMALLEST-width operand containing the offset, and on
; an equal-width tie prefers the OUTER one (the call over its receiver), and
; skips `void`/empty types so an uncovered offset (e.g. a binding name) falls
; through to the lexical hover instead of reporting the enclosing block.
;
; The pipeline can SIGSEGV / hang on bad input, so this runs in the same
; crash-isolated worker as diagnostics; the server falls back to the lexical
; hover walk on a miss / crash (a separate worker round-trip, so a pipeline
; crash here never costs the lexical answer).
;
; CONTROL-FLOW NOTE: `guard COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line. Plan unions are matched by VARIANT TAG NAME
; (`when c: Call` binds the PlannedCall payload) — NOT by payload type
; (unlike the Syntax unions in symbols.scaly). In a choose returning a value,
; EVERY arm uses an explicit return.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Vector
use scaly.memory.Page
use scaly.memory.runtime

use scalyls.symbols
use scalyls.diagnostics

use scalyc.compiler.parser
use scalyc.compiler.Modeler
use scalyc.compiler.Model.Program
use scalyc.compiler.Model.Span
use scalyc.compiler.Planner

use scalyc.compiler.Plan.Plan
use scalyc.compiler.Plan.PlannedType
use scalyc.compiler.Plan.PlannedOperand
use scalyc.compiler.Plan.PlannedStatement
use scalyc.compiler.Plan.PlannedExpression
use scalyc.compiler.Plan.PlannedImplementation
use scalyc.compiler.Plan.PlannedAction
use scalyc.compiler.Plan.PlannedBinding
use scalyc.compiler.Plan.PlannedBlock
use scalyc.compiler.Plan.PlannedCall
use scalyc.compiler.Plan.PlannedTuple
use scalyc.compiler.Plan.PlannedComponent
use scalyc.compiler.Plan.PlannedIf
use scalyc.compiler.Plan.PlannedMatch
use scalyc.compiler.Plan.PlannedBranch
use scalyc.compiler.Plan.PlannedChoose
use scalyc.compiler.Plan.PlannedWhen
use scalyc.compiler.Plan.PlannedFor
use scalyc.compiler.Plan.PlannedWhile
use scalyc.compiler.Plan.PlannedRepeat
use scalyc.compiler.Plan.PlannedTry
use scalyc.compiler.Plan.PlannedAs
use scalyc.compiler.Plan.PlannedIs
use scalyc.compiler.Plan.PlannedVariantConstruction
use scalyc.compiler.Plan.PlannedFunction
use scalyc.compiler.Plan.PlannedStructure
use scalyc.compiler.Plan.PlannedUnion
use scalyc.compiler.Plan.PlannedInitializer
use scalyc.compiler.Plan.PlannedOperator
use scalyc.compiler.Plan.PlannedDeInitializer
use scalyc.compiler.Plan.PlannedGlobal

; A resolution candidate: `found` true with a non-empty `type_name`, plus the
; source-span `width` of the operand it came from (smaller = tighter match).
define ResolveResult
(
    found: bool
    width: size_t
    type_name: String
)

define semantic
{
    ; Worker entry: resolve the type at the packed "<line> <char>" position.
    ; Returns the resolved type name (e.g. "int", "Point",
    ; "scaly.containers.String"), or "" on a miss / parse error / unresolved.
    function semantic_type_packed#(rp, source: String, uri: String, packed: String) returns String
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let n packed.get_length()
        while i < n
        {
            let c packed.get(i)
            guard c = (0x20 as u8)
                set seen_space: true
            guard c <> (0x20 as u8)
            {
                let digit (c - (0x30 as u8)) as size_t
                guard seen_space = false
                    set line: line * (10 as size_t) + digit
                guard seen_space
                    set character: character * (10 as size_t) + digit
            }
            set i: i + 1
        }
        let offset symbols.position_to_offset#(source, line, character)
        ; Only resolve when the cursor sits on a real token. Hovering
        ; whitespace / past EOF defers to the lexical hover (which reports the
        ; enclosing declaration) — and keeps coarse planner spans from
        ; reporting a body expression's type for a cursor on inter-token
        ; whitespace.
        let len source.get_length()
        guard offset >= len
            return String#("")
        let b source.get(offset)
        guard b = (0x20 as u8)
            return String#("")
        guard b = (0x09 as u8)
            return String#("")
        guard b = (0x0A as u8)
            return String#("")
        guard b = (0x0D as u8)
            return String#("")
        let path diagnostics.strip_uri#(uri)
        semantic.resolve_at#(source, path, offset)
    }

    ; Worker reply wrapper: a leading status byte distinguishes a genuine
    ; MISS ("0") from a pipeline CRASH (empty frame). Without it, an empty
    ; reply on a legitimate miss would be read as a crash by worker.exchange#
    ; and respawn the worker on every hover. On a hit the reply is "1<name>".
    function semantic_type_framed#(rp, source: String, uri: String, packed: String) returns String
    {
        let ty semantic.semantic_type_packed#(source, uri, packed)
        var sb StringBuilder#()
        guard ty.get_length() > (0 as size_t)
        {
            sb.append(0x31 as char)                ; '1' = hit
            sb.append(ty)
            return sb.to_string#()
        }
        sb.append(0x30 as char)                    ; '0' = miss
        sb.to_string#()
    }

    ; Run the full pipeline and walk the Plan for the type at `offset`.
    function resolve_at#(rp, source: String, path: String, offset: size_t) returns String
    {
        var p parser.Parser$(source)
        var result String#("")
        choose p.parse_program#()
            when err: Error
                return String#("")
            when program: Success
            {
                let prog_name String#("document")
                let model Modeler.build_program#(path, prog_name, program, true)
                var planner Planner.Planner$(path)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program(model)
                guard plan <> null
                {
                    let pl (*plan)
                    let rr semantic.walk_plan#(pl, offset)
                    guard rr.found
                        set result: String#(rr.type_name)
                }
            }
        result
    }

    function none#(rp) returns ResolveResult
        ResolveResult(false, 0 as size_t, String#(""))

    ; ====================================================================
    ; Plan walk — first FOUND match wins across non-overlapping siblings.
    ; Top-level statements, then free functions, struct/union members,
    ; then globals.
    ; ====================================================================
    function walk_plan#(rp, plan: Plan, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()

        guard plan.statements <> null
            set result: semantic.walk_statements#(*plan.statements, offset)

        guard result.found = false
        {
            guard plan.functions <> null
            {
                let fns (*plan.functions)
                var i: size_t 0
                while i < fns.length
                {
                    guard result.found = false
                    {
                        let fp fns.get(i)
                        guard fp <> null
                            set result: semantic.walk_impl#((*fp).impl, offset)
                    }
                    set i: i + 1
                }
            }
        }

        guard result.found = false
        {
            guard plan.structures <> null
            {
                let sts (*plan.structures)
                var i: size_t 0
                while i < sts.length
                {
                    guard result.found = false
                    {
                        let sp sts.get(i)
                        guard sp <> null
                            set result: semantic.walk_structure#(*sp, offset)
                    }
                    set i: i + 1
                }
            }
        }

        guard result.found = false
        {
            guard plan.unions <> null
            {
                let uns (*plan.unions)
                var i: size_t 0
                while i < uns.length
                {
                    guard result.found = false
                    {
                        let up uns.get(i)
                        guard up <> null
                            set result: semantic.walk_union#(*up, offset)
                    }
                    set i: i + 1
                }
            }
        }

        guard result.found = false
        {
            guard plan.globals <> null
            {
                let gls (*plan.globals)
                var i: size_t 0
                while i < gls.length
                {
                    guard result.found = false
                    {
                        let gp gls.get(i)
                        guard gp <> null
                        {
                            let g (*gp)
                            guard g.value <> null
                                set result: semantic.walk_operands#(*g.value, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }

        result
    }

    function walk_structure#(rp, st: PlannedStructure, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()

        guard st.methods <> null
        {
            let ms (*st.methods)
            var i: size_t 0
            while i < ms.length
            {
                guard result.found = false
                {
                    let mp ms.get(i)
                    guard mp <> null
                        set result: semantic.walk_impl#((*mp).impl, offset)
                }
                set i: i + 1
            }
        }

        guard result.found = false
        {
            guard st.initializers <> null
            {
                let inits (*st.initializers)
                var i: size_t 0
                while i < inits.length
                {
                    guard result.found = false
                    {
                        let ip inits.get(i)
                        guard ip <> null
                            set result: semantic.walk_impl#((*ip).impl, offset)
                    }
                    set i: i + 1
                }
            }
        }

        guard result.found = false
        {
            guard st.operators <> null
            {
                let ops (*st.operators)
                var i: size_t 0
                while i < ops.length
                {
                    guard result.found = false
                    {
                        let op ops.get(i)
                        guard op <> null
                            set result: semantic.walk_impl#((*op).impl, offset)
                    }
                    set i: i + 1
                }
            }
        }

        guard result.found = false
        {
            guard st.deinitializer <> null
                set result: semantic.walk_impl#((*st.deinitializer).impl, offset)
        }

        result
    }

    function walk_union#(rp, un: PlannedUnion, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()

        guard un.methods <> null
        {
            let ms (*un.methods)
            var i: size_t 0
            while i < ms.length
            {
                guard result.found = false
                {
                    let mp ms.get(i)
                    guard mp <> null
                        set result: semantic.walk_impl#((*mp).impl, offset)
                }
                set i: i + 1
            }
        }

        guard result.found = false
        {
            guard un.operators <> null
            {
                let ops (*un.operators)
                var i: size_t 0
                while i < ops.length
                {
                    guard result.found = false
                    {
                        let op ops.get(i)
                        guard op <> null
                            set result: semantic.walk_impl#((*op).impl, offset)
                    }
                    set i: i + 1
                }
            }
        }

        result
    }

    function walk_impl#(rp, impl: PlannedImplementation, offset: size_t) returns ResolveResult
    {
        choose impl
            when action: Action
                return semantic.walk_action#(action, offset)
            when ext: Extern
                return semantic.none#()
            when inst: Instruction
                return semantic.none#()
            when intr: Intrinsic
                return semantic.none#()
    }

    function walk_action#(rp, act: PlannedAction, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard act.source <> null
            set result: semantic.walk_operands#(*act.source, offset)
        guard result.found = false
        {
            guard act.target <> null
                set result: semantic.walk_operands#(*act.target, offset)
        }
        result
    }

    ; ====================================================================
    ; Statements
    ; ====================================================================
    function walk_statements#(rp, stmts: Vector[PlannedStatement], offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        var i: size_t 0
        while i < stmts.length
        {
            guard result.found = false
            {
                let sp stmts.get(i)
                guard sp <> null
                    set result: semantic.walk_statement#(*sp, offset)
            }
            set i: i + 1
        }
        result
    }

    function walk_statement#(rp, stmt: PlannedStatement, offset: size_t) returns ResolveResult
    {
        choose stmt
            when a: Action
                return semantic.walk_action#(a, offset)
            when bnd: Binding
                return semantic.walk_binding#(bnd, offset)
            when br: Break
                return semantic.walk_operands_opt#(br.result, offset)
            when ret: Return
                return semantic.walk_operands_opt#(ret.result, offset)
            when th: Throw
                return semantic.walk_operands_opt#(th.result, offset)
            when cont: Continue
                return semantic.none#()
    }

    function walk_binding#(rp, bnd: PlannedBinding, offset: size_t) returns ResolveResult
    {
        guard bnd.operation <> null
        {
            let r semantic.walk_operands#(*bnd.operation, offset)
            guard r.found
                return r
        }
        ; Cursor on the binding NAME -> the binding item's inferred type.
        let bi bnd.binding_item
        guard bi.item_type <> null
        {
            guard semantic.contains#(bi.loc, offset)
            {
                let tn semantic.type_name#(*bi.item_type)
                guard tn.get_length() > (0 as size_t)
                    return ResolveResult(true, bi.loc.end - bi.loc.start, tn)
            }
        }
        semantic.none#()
    }

    ; ====================================================================
    ; Operands / expressions
    ; ====================================================================
    function walk_operands#(rp, ops: Vector[PlannedOperand], offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        var i: size_t 0
        while i < ops.length
        {
            guard result.found = false
            {
                let op ops.get(i)
                guard op <> null
                    set result: semantic.walk_operand#(*op, offset)
            }
            set i: i + 1
        }
        result
    }

    function walk_operands_opt#(rp, opt: ref[Vector[PlannedOperand]]?, offset: size_t) returns ResolveResult
    {
        guard opt <> null
            return semantic.walk_operands#(*opt, offset)
        semantic.none#()
    }

    function walk_operand#(rp, op: PlannedOperand, offset: size_t) returns ResolveResult
    {
        ; Prune: children spans nest inside the operand's span.
        guard semantic.contains#(op.loc, offset) = false
            return semantic.none#()
        let self_width op.loc.end - op.loc.start
        let self_type semantic.operand_final_type#(op)
        let child semantic.walk_expr#(op.expr, offset)
        ; A strictly-tighter deeper match wins (genuine nesting f(g(x))).
        guard child.found
        {
            guard child.width < self_width
                return child
        }
        ; Otherwise this operand, when it has a usable (non-void) type. On an
        ; equal-width tie this beats the deeper match — the call over its
        ; same-span receiver.
        guard self_type.get_length() > (0 as size_t)
            return ResolveResult(true, self_width, self_type)
        ; This operand has no usable type (a void block wrapper): defer to the
        ; deeper match even at equal width.
        guard child.found
            return child
        semantic.none#()
    }

    function walk_operand_opt#(rp, opt: ref[PlannedOperand]?, offset: size_t) returns ResolveResult
    {
        guard opt <> null
            return semantic.walk_operand#(*opt, offset)
        semantic.none#()
    }

    function walk_expr#(rp, expr: PlannedExpression, offset: size_t) returns ResolveResult
    {
        choose expr
            when k: Constant
                return semantic.none#()
            when ty: Type
                return semantic.none#()
            when v: Variable
                return semantic.none#()
            when g: GlobalRef
                return semantic.none#()
            when c: Call
                return semantic.walk_call#(c, offset)
            when t: Tuple
                return semantic.walk_tuple#(t, offset)
            when mx: Matrix
                return semantic.none#()
            when b: Block
                return semantic.walk_block#(b, offset)
            when iff: If
                return semantic.walk_if#(iff, offset)
            when m: Match
                return semantic.walk_match#(m, offset)
            when ch: Choose
                return semantic.walk_choose#(ch, offset)
            when fr: For
                return semantic.walk_for#(fr, offset)
            when wh: While
                return semantic.walk_while#(wh, offset)
            when rep: Repeat
                return semantic.walk_action#(rep.body, offset)
            when lm: Lambda
                return semantic.none#()
            when tr: Try
                return semantic.walk_try#(tr, offset)
            when so: SizeOf
                return semantic.none#()
            when ao: AlignOf
                return semantic.none#()
            when iz: Is
                return semantic.walk_operand_opt#(iz.value, offset)
            when az: As
                return semantic.walk_operand_opt#(az.value, offset)
            when vc: VariantConstruction
                return semantic.walk_operand_opt#(vc.value, offset)
    }

    function walk_call#(rp, c: PlannedCall, offset: size_t) returns ResolveResult
    {
        guard c.args <> null
            return semantic.walk_operands#(*c.args, offset)
        semantic.none#()
    }

    function walk_tuple#(rp, t: PlannedTuple, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard t.components <> null
        {
            let comps (*t.components)
            var i: size_t 0
            while i < comps.length
            {
                guard result.found = false
                {
                    let cp comps.get(i)
                    guard cp <> null
                    {
                        let comp (*cp)
                        guard comp.value <> null
                            set result: semantic.walk_operands#(*comp.value, offset)
                    }
                }
                set i: i + 1
            }
        }
        result
    }

    function walk_block#(rp, b: PlannedBlock, offset: size_t) returns ResolveResult
    {
        guard b.statements <> null
            return semantic.walk_statements#(*b.statements, offset)
        semantic.none#()
    }

    function walk_if#(rp, iff: PlannedIf, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard iff.condition <> null
            set result: semantic.walk_operands#(*iff.condition, offset)
        guard result.found = false
        {
            guard iff.consequent <> null
                set result: semantic.walk_statement#(*iff.consequent, offset)
        }
        guard result.found = false
        {
            guard iff.alternative <> null
                set result: semantic.walk_statement#(*iff.alternative, offset)
        }
        result
    }

    function walk_match#(rp, m: PlannedMatch, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard m.condition <> null
            set result: semantic.walk_operands#(*m.condition, offset)
        guard result.found = false
        {
            guard m.branches <> null
            {
                let brs (*m.branches)
                var i: size_t 0
                while i < brs.length
                {
                    guard result.found = false
                    {
                        let bp brs.get(i)
                        guard bp <> null
                        {
                            let br (*bp)
                            guard br.consequent <> null
                                set result: semantic.walk_statement#(*br.consequent, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        guard result.found = false
        {
            guard m.alternative <> null
                set result: semantic.walk_statement#(*m.alternative, offset)
        }
        result
    }

    function walk_choose#(rp, ch: PlannedChoose, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard ch.condition <> null
            set result: semantic.walk_operands#(*ch.condition, offset)
        guard result.found = false
        {
            guard ch.cases <> null
            {
                let cs (*ch.cases)
                var i: size_t 0
                while i < cs.length
                {
                    guard result.found = false
                    {
                        let wp cs.get(i)
                        guard wp <> null
                        {
                            let wh (*wp)
                            guard wh.consequent <> null
                                set result: semantic.walk_statement#(*wh.consequent, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        guard result.found = false
        {
            guard ch.alternative <> null
                set result: semantic.walk_statement#(*ch.alternative, offset)
        }
        result
    }

    function walk_for#(rp, fr: PlannedFor, offset: size_t) returns ResolveResult
    {
        var result semantic.none#()
        guard fr.expr <> null
            set result: semantic.walk_operands#(*fr.expr, offset)
        guard result.found = false
            set result: semantic.walk_action#(fr.body, offset)
        result
    }

    function walk_while#(rp, wh: PlannedWhile, offset: size_t) returns ResolveResult
    {
        var result semantic.walk_binding#(wh.cond, offset)
        guard result.found = false
            set result: semantic.walk_action#(wh.body, offset)
        result
    }

    function walk_try#(rp, tr: PlannedTry, offset: size_t) returns ResolveResult
    {
        var result semantic.walk_binding#(tr.cond, offset)
        guard result.found = false
        {
            guard tr.catches <> null
            {
                let cs (*tr.catches)
                var i: size_t 0
                while i < cs.length
                {
                    guard result.found = false
                    {
                        let wp cs.get(i)
                        guard wp <> null
                        {
                            let wh (*wp)
                            guard wh.consequent <> null
                                set result: semantic.walk_statement#(*wh.consequent, offset)
                        }
                    }
                    set i: i + 1
                }
            }
        }
        guard result.found = false
        {
            guard tr.alternative <> null
                set result: semantic.walk_statement#(*tr.alternative, offset)
        }
        result
    }

    ; ====================================================================
    ; Type extraction
    ; ====================================================================

    ; The clean source type of an operand. PlannedOperand.result_type is often
    ; ABI-lowered (an lvalue variable reads back as `pointer`) or the chain
    ; BASE (b.get() reports the receiver), so prefer the post-access type: the
    ; LAST PlannedMemberAccess.result_type when a member chain is present (so
    ; a.f().b yields .b's type), else the expression's own typed field.
    function operand_final_type#(rp, op: PlannedOperand) returns String
    {
        guard op.member_access <> null
        {
            let ma (*op.member_access)
            guard ma.length > (0 as size_t)
            {
                let lp ma.get(ma.length - (1 as size_t))
                guard lp <> null
                    return semantic.type_name#((*lp).result_type)
            }
        }
        semantic.expr_type#(op.expr, op.result_type)
    }

    ; The expression's own resolved type field, falling back to `fallback`
    ; (the operand's result_type) for shapes without a cleaner field.
    function expr_type#(rp, expr: PlannedExpression, fallback: PlannedType) returns String
    {
        choose expr
            when v: Variable
                return semantic.type_name#(v.variable_type)
            when g: GlobalRef
                return semantic.type_name#(g.global_type)
            when c: Call
                return semantic.type_name#(c.result_type)
            when t: Tuple
                return semantic.type_name#(t.tuple_type)
            when vc: VariantConstruction
                return semantic.type_name#(vc.union_type)
            when az: As
                return semantic.type_name#(az.target_type)
            else
                return semantic.type_name#(fallback)
    }

    ; True when offset is within [loc.start, loc.end).
    function contains#(rp, loc: Span, offset: size_t) returns bool
    {
        guard offset < loc.start
            return false
        guard offset >= loc.end
            return false
        true
    }

    ; The readable type name, or "" when empty (an unresolved type variable)
    ; or "void". Suppressing "void" matters: an offset on no typed
    ; sub-expression (e.g. a binding name) would otherwise bubble to the
    ; enclosing block operand and report "void", masking the lexical fallback.
    function type_name#(rp, pt: PlannedType) returns String
    {
        guard pt.name.get_length() = (0 as size_t)
            return String#("")
        guard pt.name.equals("void")
            return String#("")
        String#(pt.name)
    }
}
