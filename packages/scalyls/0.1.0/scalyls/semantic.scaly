; semantic.scaly - planner-based (semantic) type resolution.
;
; The lexical type resolvers in symbols.scaly (resolve_variable_type# /
; resolve_chain_type# / member_type_ws# / infer_binding_type# /
; concept_or_return_type#) walk the PARSE TREE only and hit a hard ceiling:
; they cannot resolve a reassigned variable, a generic type's element type
; (Box[int].get() -> int), a pointer/ref inner type, or a method call in the
; MIDDLE of a chain (a.f().b).
;
; This module breaks that ceiling by running the SAME modeler+planner
; pipeline the diagnostics path already runs (parser -> Modeler.build_program#
; -> Planner.plan_program), then walking the resulting Plan for the planned
; node whose source span best covers a byte offset, and reading its
; already-resolved type. Every Planned* node carries a `loc: Span` (source
; byte offsets) AND a resolved PlannedType, so the offset -> type map is just
; a tree walk — no compiler change, fixpoint-safe.
;
; WALK MODE (threaded as a parameter — a module-mutable global was rejected by
; stage-0 here). The SAME traversal reports a different node's type per mode:
;   0 HOVER    — the smallest-span expression covering the offset (final type
;                after member access; the call over its same-span receiver).
;   2 RECEIVER — the innermost receiver's OWN base type (completion wants g's
;                type from `g.member`, not the enclosing member-access type).
; (Mode 1 — a binding's declared type for inlay hints — was evaluated and
; dropped: stage-0's planner mis-types a binding VALUE for the mid-chain shapes
; the lexical walk can't reach, so it would surface a wrong hint. Inlay type
; hints stay lexical; see symbols.scaly::infer_binding_type#.)
;
; CHOOSING THE NODE (mode 0) — width, not depth. Planner spans are coarse: a
; method call's receiver shares the call's span, and a function body is wrapped
; in one `void` block operand. So "innermost by tree depth" wrongly picks the
; receiver (Point) over the call result (int). The walk picks the SMALLEST-
; width operand containing the offset, prefers the OUTER one on an equal-width
; tie, and skips `void`/empty so an uncovered offset (a binding name) falls
; through to the lexical hover.
;
; The pipeline can SIGSEGV / hang on bad input, so this runs in the same
; crash-isolated worker as diagnostics; the server / lexical resolvers fall
; back on a miss / crash.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line. Plan unions are matched by VARIANT TAG NAME
; (`when c: Call` binds the PlannedCall payload) — NOT by payload type
; (unlike the Syntax unions in symbols.scaly). In a choose returning a value,
; EVERY arm uses an explicit return.

use scaly.memory.runtime
use scaly.os.File

use scalyls.diagnostics

use scalyc.compiler.parser
use scalyc.compiler.Modeler
use scalyc.compiler.Planner

use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

; A resolution candidate: `found` true with a non-empty `type_name`, plus the
; source-span `width` of the operand it came from (smaller = tighter match).
define ResolveResult
(
    found: bool
    width: size_t
    type_name: String
)

define semantic
{
    ; HOVER entry: resolve the type at the packed "<line> <char>" position.
    ; Returns the resolved type name (e.g. "int", "Point",
    ; "scaly.containers.String"), or "" on a miss / parse error / unresolved.
    procedure semantic_type_packed(mutable source: String, mutable uri: String, packed: String) returns String mutable modeler_error_count
    {
        var line: size_t 0
        var character: size_t 0
        var seen_space: bool false
        var i: size_t 0
        let n packed.get_length()
        while i < n
        {
            let c packed.get i
            if c = 0x20
                seen_space := true
            if c <> 0x20
            {
                let digit (c - 0x30) as size_t
                if seen_space = false
                    line := line * 10 + digit
                if seen_space
                    character := character * 10 + digit
            }
            i := i + 1
        }
        let offset semantic.position_to_offset(source, line, character)
        ; Only resolve when the cursor sits on a real token. Hovering
        ; whitespace / past EOF defers to the lexical hover (which reports the
        ; enclosing declaration) — and keeps coarse planner spans from
        ; reporting a body expression's type for a cursor on inter-token
        ; whitespace.
        let len source.get_length()
        if offset >= len
            return ""
        let b source.get offset
        if b = 0x20
            return ""
        if b = 0x09
            return ""
        if b = 0x0A
            return ""
        if b = 0x0D
            return ""
        let path diagnostics.strip_uri uri
        semantic.resolve_at(source, path, 0, offset)
    }

    ; Worker reply wrapper: a leading status byte distinguishes a genuine
    ; MISS ("0") from a pipeline CRASH (empty frame). Without it, an empty
    ; reply on a legitimate miss would be read as a crash by worker.exchange#
    ; and respawn the worker on every hover. On a hit the reply is "1<name>".
    procedure semantic_type_framed(mutable source: String, mutable uri: String, packed: String) returns String mutable modeler_error_count
    {
        let ty semantic.semantic_type_packed(source, uri, packed)
        var sb StringBuilder()
        if ty.get_length() > 0
        {
            sb.append("1" as char)                ; '1' = hit
            sb.append ty
            return sb.to_string()
        }
        sb.append("0" as char)                    ; '0' = miss
        sb.to_string()
    }

    ; COMPLETION entry (mode 2): the OWN type of the receiver expression at
    ; `offset` (the innermost variable's base type, NOT the enclosing member
    ; access). "" on a miss / unresolved.
    procedure receiver_type_at_offset(mutable source: String, mutable uri: String, offset: size_t) returns String mutable modeler_error_count
    {
        let path diagnostics.strip_uri uri
        semantic.resolve_at(source, path, 2, offset)
    }

    ; Run the full pipeline and walk the Plan for the type at `offset`.
    ;
    ; TWO PLANS, cheap one first. The document planned ALONE answers every name
    ; that lives in this file or in the prelude, and it costs 0.03 s — but a
    ; file that is a MODULE of a package cannot resolve its SIBLINGS that way:
    ; the one-module program the modeler builds has no `rpc`, no `worker`, no
    ; `json`, so every call into one is simply unresolved and the walk finds
    ; nothing. That is the whole defect this fallback closes. Measured
    ; 2026-08-15 in scalyls/server.scaly: `pb.to_string()` (prelude) and
    ; `server.semantic_hover_from_framed` (same file) resolved, while
    ; `worker.semantic_type(…)` and `rpc.read_message()` did not — which is what
    ; made it look like a rule about QUALIFIED calls, and is not one:
    ; `rpc.read_byte()` inside rpc.scaly is just as qualified and resolves.
    ; The same gap in the diagnostics route produced a flood of false
    ; "function not found" (diagnostics.publish_diagnostics#) and is closed the
    ; same way; codelens.planned_fragment# routes through the root for the
    ; third time.
    procedure resolve_at(mutable source: String, mutable path: String, mode: size_t, offset: size_t) returns String mutable modeler_error_count
    {
        ; WHICH LINK of a member chain the cursor is on. The plan cannot say:
        ; a PlannedMemberAccess carries a NAME and no span, and the operand's
        ; own span is NOT the chain's text — measured 2026-08-18 on the same
        ; `t.mid.leaf.v` in four statement contexts, where reconstructing the
        ; name tokens backwards from `loc.end` came out shifted by 1, 5, 3 and 1
        ; respectively. So the question is answered from the SOURCE, where it is
        ; a local one (chain_position#), and it decides WHICH QUESTION to ask of
        ; the walk rather than trying to correct its answer.
        var m mode
        if mode = 0
        {
            let cp semantic.chain_position(source, offset)
            ; A middle link is the one position neither mode reports. Answering
            ; "" hands it to the lexical hover, which says where the cursor IS —
            ; the honest miss this module already prefers over a wrong type.
            if cp = 2
                return ""
            if cp = 1
                m := 2
            if cp = 3
                m := 3
        }
        var p parser.Parser(source)
        var result ""
        choose p.parse_program()
            when err: Error
                return ""
            when program: Success
            {
                let prog_name "document"
                let model Modeler.build_program(path, prog_name, program, true)
                var planner Planner.Planner(path)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model
                if plan <> null
                {
                    let pl (*plan)
                    ; `program.file` is the SAME parse the Modeler above was
                    ; handed, so its routine starts are the very numbers the
                    ; plan's spans carry — see is_routine_start#, which is what
                    ; keeps a foreign file's span out of the answer.
                    let rr semantic.walk_plan(pl, m, offset, program.file, path)
                    if rr.found
                        result := String(rr.type_name)
                }
                if result.get_length() = 0
                    result := semantic.resolve_through_root(source, path, m, offset, program.file)
            }
        result
    }

    ; The document plan had no answer. If this file is a module of a package,
    ; plan the package ROOT and ask the same question of that plan.
    ;
    ; ★THE BUFFER MUST BE THE SAVED TEXT, and the guard is not caution. The
    ; modeler reads every module from DISK, so the root plan's spans index the
    ; SAVED bytes of this file while `offset` was computed from the editor
    ; buffer — the same bargain diagnostics.package_report# documents for its
    ; line numbers. For a DIAGNOSTIC a stale offset misplaces a message; here it
    ; would name the type of whatever expression happens to sit at that offset
    ; in the saved text, i.e. trade one silent wrong answer for another. Unequal
    ; text therefore keeps the document-plan behaviour, which is what an
    ; unsaved buffer had before this fallback existed.
    ;
    ; ★It also bounds the cost for the one caller that fires on a KEYSTROKE:
    ; completion (mode 2) asks at `receiver.`, i.e. on a buffer that differs
    ; from disk by construction, so it keeps the 0.03 s path. The root plan
    ; costs what the diagnostics of the same root cost — 0.86 s for scalyls,
    ; ~1.9 s for opensp, 2.45 s for dazzle — against the 20 s budget kind "x"
    ; carries (worker.budget_for_kind#).
    procedure resolve_through_root(source: String, mutable path: String, mode: size_t, offset: size_t, file: FileSyntax) returns String mutable modeler_error_count
    {
        let root diagnostics.package_root path
        if root.get_length() = 0
            return ""
        let disk File.read_to_string(path)
        if disk.get_length() = 0
            return ""
        if disk = source
            return semantic.root_resolve(root, path, mode, offset, file)
        ""
    }

    ; Plan `root` — the package root that owns `path` — and walk that plan for
    ; the type at `offset`. `file` is the parse of the DOCUMENT, so the walk's
    ; file identity is decided exactly as it is for the document plan.
    procedure root_resolve(mutable root: String, path: String, mode: size_t, offset: size_t, file: FileSyntax) returns String mutable modeler_error_count
    {
        let root_text File.read_to_string(root)
        if root_text.get_length() = 0
            return ""
        var p parser.Parser(root_text)
        var result ""
        choose p.parse_program()
            when err: Error
                return ""
            when program: Success
            {
                ; The root program NAME is part of every module path the strict
                ; use-visibility check compares against; a placeholder makes the
                ; planner report every sibling as invisible
                ; (diagnostics.root_program_name# has the full account).
                let prog_name diagnostics.root_program_name(root)
                let model Modeler.build_program(root, prog_name, program, true)
                var planner Planner.Planner(root)
                diagnostics.register_packages(&planner, &model)
                let plan planner.plan_program model
                if plan <> null
                {
                    let pl (*plan)
                    let rr semantic.walk_plan(pl, mode, offset, file, path)
                    if rr.found
                        result := String(rr.type_name)
                }
            }
        result
    }

    ; ====================================================================
    ; WHERE IN A MEMBER CHAIN THE CURSOR IS
    ;
    ; Mode 0 reports a chain's FINAL type and mode 2 the receiver's OWN base
    ; type, and until 2026-08-18 hover asked mode 0 at every offset — so every
    ; column of `t.mid.leaf.v` answered `int` (t: Top, mid: Mid, leaf: Leaf),
    ; and hovering `t` said the Top was an int. Three of the four names carried
    ; another name's type: a plausible-looking answer to a different question,
    ; indistinguishable from a right one.
    ;
    ; The question is decided HERE, on the source, because the plan cannot
    ; answer it (see resolve_at#) — and it is a LOCAL question: only the two
    ; characters bracketing the token under the cursor are read, never the
    ; whole chain. That is what keeps `a.f(x.y).b` out of trouble without
    ; parsing it: a token followed by `(` or `[` is a CALL or a subscript, whose
    ; text the neighbour test cannot see past, and it keeps mode 0 — which is
    ; the answer a call site is supposed to give anyway.
    ; ====================================================================

    ; 0 = not a chain at all (mode 0 answers it, unchanged);
    ; 1 = the RECEIVER of a chain;  2 = a MIDDLE link (neither mode answers it);
    ; 3 = the LAST link, a plain field — mode 0's answer, but only from an
    ;     operand that actually HAS a member chain (see walk_operand#).
    function chain_position(source: String, offset: size_t) returns size_t
    {
        let n source.get_length()
        if n = 0
            return 0
        var at offset
        if at >= n
            return 0
        if semantic.is_ident_byte(source.get at) = false
        {
            if at = 0
                return 0
            if semantic.is_ident_byte(source.get(at - 1)) = false
                return 0
            at := at - 1
        }
        var start at
        while start > 0
        {
            if semantic.is_ident_byte(source.get(start - 1)) = false
                break
            start := start - 1
        }
        var end at + 1
        while end < n
        {
            if semantic.is_ident_byte(source.get end) = false
                break
            end := end + 1
        }
        ; Forward: a dot means more links follow; a `(`/`[` means the neighbour
        ; test cannot see past this link, so leave the question to mode 0.
        var j end
        while j < n
        {
            let c source.get j
            if c <> 0x20
                break
            j := j + 1
        }
        if j >= n
            return 0
        let after source.get j
        if after = 0x28
            return 0
        if after = 0x5B
            return 0
        var more true
        if after <> 0x2E
            more := false
        ; Backward: a dot means this token is itself a member.
        var i start
        while i > 0
        {
            if source.get(i - 1) <> 0x20
                break
            i := i - 1
        }
        var member false
        if i > 0 and source.get(i - 1) = 0x2E
            member := true
        if member
        {
            if more
                return 2
            return 3
        }
        if more
            return 1
        0
    }

    ; Letters, digits and `_` — the bytes an identifier is made of. A private
    ; copy for the same reason position_to_offset# is one: this module does not
    ; depend on symbols.
    function is_ident_byte(c: u8) returns bool
    {
        if c >= 0x61 and c <= 0x7A or c >= 0x41 and c <= 0x5A or c >= 0x30 and c <= 0x39 or c = 0x5F
            return true
        false
    }

    ; ====================================================================
    ; FILE IDENTITY for planner spans.
    ;
    ; A Span is a bare pair of BYTE OFFSETS (Model.scaly: `define Span(start,
    ; end)`) — it does not say which file it indexes. The plan built for this
    ; document also holds every routine the planner instantiated on its behalf:
    ; the prelude's, and every method of every generic the document's own types
    ; pull in. Those spans index THOSE files, so they overlap the document's own
    ; offsets, and a walk that compares numbers alone will happily report one of
    ; them. Measured 2026-08-12 on packages/scaly/0.1.0/scaly/containers/
    ; Vector.scaly: EVERY hover answered `bool` — the return type of
    ; `Slice[T].equals`, whose span 1328..2073 in containers/Slice.scaly covers
    ; most of Vector.scaly's `define Vector[T]` (1614..4831). The file reads as
    ; a generic container, so its own bodies plan to empty template stubs and
    ; nothing local competed.
    ;
    ; PlannedFunction.file CANNOT decide this, which is the trap: a generic
    ; instantiated for this document is stamped with the file that REQUESTED it
    ; (Planner passes `this.file`, its current module — Plan.scaly's own comment
    ; on the field calls that the "stale entry file"), so those Slice methods
    ; report Vector.scaly. Only the prelude's honestly-stamped entries would be
    ; caught by a path comparison.
    ;
    ; What IS exact is the span START. Modeler.build_function# builds the model
    ; span as `Span(func.start, func.end)` straight off the routine's own
    ; FunctionSyntax, and every PlannedFunction — instantiations included —
    ; copies it verbatim. So a planned routine belongs to the document iff its
    ; loc.start is the start of a routine the DOCUMENT declares, and
    ; resolve_at# feeds the collector the same parse tree the Modeler consumed,
    ; so both sides are literally the same numbers. A rejected walk yields ""
    ; and the server falls back to the lexical hover — which is what a file of
    ; uninstantiated generic templates should answer anyway.
    ;
    ; ★THE START ALONE STOPPED BEING ENOUGH when root_resolve# landed. A plan
    ; built from the package ROOT holds every module of the package, and a
    ; sibling's routine that happens to start at the same byte offset as one of
    ; this document's would pass the start test and hand back a type read out of
    ; ANOTHER FILE's operands — the very class this section exists to keep out,
    ; only now with 56 more files to collide with. So owns_routine# adds the
    ; file, for the one plan node that carries it: PlannedFunction.file is
    ; documented as "the source file of this function's module" and is what
    ; diagnostics filters on (`dp.file = path`). It does not REPLACE the start
    ; test — for an instantiation that field is the requesting module, which is
    ; exactly the Slice/Vector case above — the two together are what is exact.
    ; PlannedInitializer / PlannedOperator / PlannedDeInitializer / PlannedGlobal
    ; carry no file, so those four rest on the start test alone, as they did
    ; before.
    ; ====================================================================

    ; Does this planned routine belong to the open document? Both halves are
    ; needed; the section header above has the reasoning for each.
    function owns_routine(file: FileSyntax, path: String, fn_file: String, start: size_t) returns bool
    {
        if fn_file = path
            return semantic.is_routine_start(file, start)
        false
    }

    ; Does the document declare a routine (function / procedure / operator /
    ; init / deinit) or a module-level global starting exactly at `start`?
    function is_routine_start(file: FileSyntax, start: size_t) returns bool
    {
        if file.declarations = null
            return false
        let decls (*file.declarations)
        var i: size_t 0
        while i < decls.length
        {
            let dptr decls.get i
            if dptr <> null and semantic.decl_has_start(*dptr, start)
                return true
            i := i + 1
        }
        false
    }

    function decl_has_start(decl: DeclarationSyntax, start: size_t) returns bool
    {
        choose decl
            when f: FunctionSyntax
                return f.start = start
            when pr: ProcedureSyntax
                return pr.start = start
            when o: OperatorSyntax
                return o.start = start
            when mut: MutableSyntax
                return mut.start = start
            when sh: SharedSyntax
                return sh.start = start
            when def: DefinitionSyntax
                return semantic.definition_has_start(def, start)
            when priv: PrivateSyntax
                return semantic.export_has_start(priv.export_, start)
            when m: ModuleSyntax
                return false
            when e: EmptySyntax
                return false
            when pkg: PackageSyntax
                return false
            when u: UseSyntax
                return false
    }

    function export_has_start(export_: ExportSyntax, start: size_t) returns bool
    {
        choose export_
            when f: FunctionSyntax
                return f.start = start
            when pr: ProcedureSyntax
                return pr.start = start
            when o: OperatorSyntax
                return o.start = start
            when def: DefinitionSyntax
                return semantic.definition_has_start(def, start)
            when m: ModuleSyntax
                return false
    }

    function definition_has_start(def: DefinitionSyntax, start: size_t) returns bool
    {
        choose def.concept_
            when c: ClassSyntax
                return semantic.body_has_start(c.body, start)
            when n: NamespaceSyntax
                return semantic.namespace_has_start(n, start)
            when un: UnionSyntax
                return semantic.union_has_start(un, start)
            else
                return false
    }

    function namespace_has_start(ns: NamespaceSyntax, start: size_t) returns bool
    {
        if ns.declarations = null
            return false
        let decls (*ns.declarations)
        var i: size_t 0
        while i < decls.length
        {
            let dptr decls.get i
            if dptr <> null and semantic.decl_has_start(*dptr, start)
                return true
            i := i + 1
        }
        false
    }

    function union_has_start(un: UnionSyntax, start: size_t) returns bool
    {
        semantic.body_has_start(un.body, start)
    }

    function body_has_start(body: ref[BodySyntax]?, start: size_t) returns bool
    {
        if body = null
            return false
        let b (*body)
        if b.members = null
            return false
        let members (*b.members)
        var i: size_t 0
        while i < members.length
        {
            let mptr members.get i
            if mptr <> null and semantic.member_has_start(*mptr, start)
                return true
            i := i + 1
        }
        false
    }

    function member_has_start(member: MemberSyntax, start: size_t) returns bool
    {
        choose member
            when f: FunctionSyntax
                return f.start = start
            when pr: ProcedureSyntax
                return pr.start = start
            when o: OperatorSyntax
                return o.start = start
            when ini: InitSyntax
                return ini.start = start
            when def: DefinitionSyntax
                return semantic.definition_has_start(def, start)
            when e: EmptySyntax
                return false
            when m: ModuleSyntax
                return false
    }

    ; 0-based (line, character) -> byte offset (self-contained copy of
    ; symbols.position_to_offset#, so this module does not depend on symbols —
    ; symbols depends on semantic for the Phase-2 prefer/fallback).
    function position_to_offset(source: String, line: size_t, character: size_t) returns size_t
    {
        let len source.get_length()
        var off: size_t 0
        var cur_line: size_t 0
        while cur_line < line
        {
            if off >= len
                return off
            let c source.get off
            off := off + 1
            if c = ("\n" as char)
                cur_line := cur_line + 1
        }
        var col: size_t 0
        while col < character
        {
            if off >= len
                return off
            let c source.get off
            if c = ("\n" as char)
                return off
            off := off + 1
            col := col + 1
        }
        off
    }

    function none() returns ResolveResult
        ResolveResult(false, 0, "")

    ; Keep the TIGHTER of two candidates. With the containment prune gone
    ; (walk_operand#), sibling subtrees are all traversed and more than one can
    ; report a hit, so "first found wins" would hand back whichever sibling the
    ; loop reached first rather than the one that actually sits under the
    ; cursor. On a tie the FIRST/outer one is kept, matching walk_operand#'s
    ; equal-width preference.
    function tighter(a: ResolveResult, b: ResolveResult) returns ResolveResult
    {
        if b.found = false
            return a
        if a.found = false
            return b
        if b.width < a.width
            return b
        a
    }

    ; ====================================================================
    ; Plan walk — first FOUND match wins across non-overlapping siblings.
    ; ====================================================================
    function walk_plan(plan: Plan, mode: size_t, offset: size_t, file: FileSyntax, path: String) returns ResolveResult
    {
        var result semantic.none()

        if plan.statements <> null
            result := semantic.walk_statements(*plan.statements, mode, offset)

        if result.found = false
        {
            if plan.functions <> null
            {
                let fns (*plan.functions)
                var i: size_t 0
                while i < fns.length
                {
                    if result.found = false
                    {
                        let fp fns.get i
                        if fp <> null and semantic.owns_routine(file, path, (*fp).file, (*fp).loc.start)
                            result := semantic.walk_impl((*fp).impl, mode, offset)
                    }
                    i := i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.structures <> null
            {
                let sts (*plan.structures)
                var i: size_t 0
                while i < sts.length
                {
                    if result.found = false
                    {
                        let sp sts.get i
                        if sp <> null
                            result := semantic.walk_structure(*sp, mode, offset, file, path)
                    }
                    i := i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.unions <> null
            {
                let uns (*plan.unions)
                var i: size_t 0
                while i < uns.length
                {
                    if result.found = false
                    {
                        let up uns.get i
                        if up <> null
                            result := semantic.walk_union(*up, mode, offset, file, path)
                    }
                    i := i + 1
                }
            }
        }

        if result.found = false
        {
            if plan.globals <> null
            {
                let gls (*plan.globals)
                var i: size_t 0
                while i < gls.length
                {
                    if result.found = false
                    {
                        let gp gls.get i
                        if gp <> null
                        {
                            let g (*gp)
                            if g.value <> null and semantic.is_routine_start(file, g.loc.start)
                                result := semantic.walk_operands(*g.value, mode, offset)
                        }
                    }
                    i := i + 1
                }
            }
        }

        result
    }

    function walk_structure(st: PlannedStructure, mode: size_t, offset: size_t, file: FileSyntax, path: String) returns ResolveResult
    {
        var result semantic.none()

        if st.methods <> null
        {
            let ms (*st.methods)
            var i: size_t 0
            while i < ms.length
            {
                if result.found = false
                {
                    let mp ms.get i
                    if mp <> null and semantic.owns_routine(file, path, (*mp).file, (*mp).loc.start)
                        result := semantic.walk_impl((*mp).impl, mode, offset)
                }
                i := i + 1
            }
        }

        if result.found = false
        {
            if st.initializers <> null
            {
                let inits (*st.initializers)
                var i: size_t 0
                while i < inits.length
                {
                    if result.found = false
                    {
                        let ip inits.get i
                        if ip <> null and semantic.is_routine_start(file, (*ip).loc.start)
                            result := semantic.walk_impl((*ip).impl, mode, offset)
                    }
                    i := i + 1
                }
            }
        }

        if result.found = false
        {
            if st.operators <> null
            {
                let ops (*st.operators)
                var i: size_t 0
                while i < ops.length
                {
                    if result.found = false
                    {
                        let op ops.get i
                        if op <> null and semantic.is_routine_start(file, (*op).loc.start)
                            result := semantic.walk_impl((*op).impl, mode, offset)
                    }
                    i := i + 1
                }
            }
        }

        if result.found = false
        {
        }

        result
    }

    function walk_union(un: PlannedUnion, mode: size_t, offset: size_t, file: FileSyntax, path: String) returns ResolveResult
    {
        var result semantic.none()

        if un.methods <> null
        {
            let ms (*un.methods)
            var i: size_t 0
            while i < ms.length
            {
                if result.found = false
                {
                    let mp ms.get i
                    if mp <> null and semantic.owns_routine(file, path, (*mp).file, (*mp).loc.start)
                        result := semantic.walk_impl((*mp).impl, mode, offset)
                }
                i := i + 1
            }
        }

        if result.found = false
        {
            if un.operators <> null
            {
                let ops (*un.operators)
                var i: size_t 0
                while i < ops.length
                {
                    if result.found = false
                    {
                        let op ops.get i
                        if op <> null and semantic.is_routine_start(file, (*op).loc.start)
                            result := semantic.walk_impl((*op).impl, mode, offset)
                    }
                    i := i + 1
                }
            }
        }

        result
    }

    function walk_impl(impl: PlannedImplementation, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose impl
            when action: Action
                return semantic.walk_action(action, mode, offset)
            when ext: Extern
                return semantic.none()
            when inst: Instruction
                return semantic.none()
            when intr: Intrinsic
                return semantic.none()
    }

    function walk_action(act: PlannedAction, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if act.source <> null
            result := semantic.walk_operands(*act.source, mode, offset)
        if act.target <> null
        {
            let t semantic.walk_operands(*act.target, mode, offset)
            result := semantic.tighter(result, t)
        }
        result
    }

    ; ====================================================================
    ; Statements
    ; ====================================================================
    function walk_statements(stmts: Vector[PlannedStatement], mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        var i: size_t 0
        while i < stmts.length
        {
            let sp stmts.get i
            if sp <> null
            {
                let r semantic.walk_statement(*sp, mode, offset)
                result := semantic.tighter(result, r)
            }
            i := i + 1
        }
        result
    }

    function walk_statement(stmt: PlannedStatement, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose stmt
            when a: Action
                return semantic.walk_action(a, mode, offset)
            when bnd: Binding
                return semantic.walk_binding(bnd, mode, offset)
            when br: Break
                return semantic.walk_operands_opt(br.result, mode, offset)
            when ret: Return
                return semantic.walk_operands_opt(ret.result, mode, offset)
            when th: Throw
                return semantic.walk_operands_opt(th.result, mode, offset)
            when cont: Continue
                return semantic.none()
    }

    function walk_binding(bnd: PlannedBinding, mode: size_t, offset: size_t) returns ResolveResult
    {
        var op_result semantic.none()
        if bnd.operation <> null
            op_result := semantic.walk_operands(*bnd.operation, mode, offset)
        let bi bnd.binding_item
        var on_name semantic.contains(bi.loc, offset)
        ; MEMBER mode (3): the cursor is on a field token and so is never on the
        ; binding NAME — while this item's span is coarse enough to contain the
        ; whole initializer, which is how `let body_start symbols.
        ; implementation_start(routine.implementation)` answered `size_t` for
        ; the field written inside the argument. Both name answers below must
        ; therefore stay out of that mode.
        if mode = 3
            on_name := false
        if on_name
        {
            ; Cursor on the binding NAME -> the binding item's declared type.
            if bi.item_type <> null
            {
                let tn semantic.type_name(*bi.item_type)
                if tn.get_length() > 0
                {
                    let name_hit ResolveResult(true, bi.loc.end - bi.loc.start, tn)
                    return semantic.tighter(op_result, name_hit)
                }
            }
            ; An UNTYPED `let`/`var` records no item_type at all (measured:
            ; `let own_page Page.get(this as pointer[void])` has item_type null),
            ; and no initializer operand covers the name either — their spans
            ; start at the initializer. Answer what the binding IS: the type its
            ; initializer produces. Without this the cursor on the name has
            ; nothing to match and falls through to the lexical hover, which can
            ; only name the enclosing routine.
            if op_result.found = false
            {
                let init_tn semantic.operation_type bnd
                if init_tn.get_length() > 0
                    return ResolveResult(true, bi.loc.end - bi.loc.start, init_tn)
            }
        }
        op_result
    }

    ; The type a binding's initializer produces: the LAST operand of the
    ; operation sequence, read through operand_final_type# so a member chain
    ; reports what the chain ends in rather than its receiver.
    function operation_type(bnd: PlannedBinding) returns String
    {
        if bnd.operation = null
            return ""
        let ops (*bnd.operation)
        if ops.length = 0
            return ""
        let lp ops.get(ops.length - 1)
        if lp = null
            return ""
        semantic.operand_final_type(*lp)
    }

    ; ====================================================================
    ; Operands / expressions
    ; ====================================================================
    function walk_operands(ops: Vector[PlannedOperand], mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        var i: size_t 0
        while i < ops.length
        {
            let op ops.get i
            if op <> null
            {
                let r semantic.walk_operand(*op, mode, offset)
                result := semantic.tighter(result, r)
            }
            i := i + 1
        }
        result
    }

    function walk_operands_opt(opt: ref[Vector[PlannedOperand]]?, mode: size_t, offset: size_t) returns ResolveResult
    {
        if opt <> null
            return semantic.walk_operands(*opt, mode, offset)
        semantic.none()
    }

    function walk_operand(op: PlannedOperand, mode: size_t, offset: size_t) returns ResolveResult
    {
        ; NO PRUNE. This used to return early unless the operand's own span
        ; contained the offset, on the premise that "children spans nest inside
        ; the operand's span" — and that premise is FALSE for planner operands.
        ; They are not a containment hierarchy: an operand's span covers its own
        ; tokens only, and its children lie BESIDE it. Measured 2026-08-12 in
        ; containers/Vector.scaly line 73
        ; (`set data: own_page.allocate(len * sizeof T, alignof T) as pointer[T]`):
        ; the `As` operand spans 2333..2359 = the trailing `as pointer[T]`, while
        ; its value — the whole call, and the `len` the cursor is on at 2311 —
        ; sits before it; a Call operand's span likewise stops after the callee
        ; name (`memset` = 2359..2366), leaving every argument outside. So the
        ; prune cut the descent at the first non-containing link and the walk
        ; never got below block/if level: hovering ANY token of that line
        ; answered the enclosing block's type, `pointer`, all the way across.
        ; Descend always; the operand's own type is offered only when its span
        ; does contain the offset, and the smallest containing span still wins.
        let self_width op.loc.end - op.loc.start
        let child semantic.walk_expr(op.expr, mode, offset)
        let self_covers semantic.contains(op.loc, offset)
        ; RECEIVER mode (completion): the innermost expression's OWN base type
        ; (ignoring member access / the enclosing call) — `g.member` reports
        ; g's type, not the member-access result.
        if mode = 2
        {
            if child.found
                return child
            if self_covers = false
                return semantic.none()
            let bt semantic.expr_type(op.expr, op.result_type)
            if bt.get_length() > 0
                return ResolveResult(true, self_width, bt)
            return semantic.none()
        }
        ; Not on this operand: only what lies below it can answer.
        if self_covers = false
            return child
        ; A BLOCK is a statement wrapper, not an expression the cursor can be
        ; "on" — only its statements can answer. The module header assumed a
        ; block types as `void` and is dropped by type_name#, but a body block's
        ; result_type is whatever the planner left there: the `init (len:
        ; size_t)` body in containers/Vector.scaly carries `pointer[void]`, so
        ; every offset no statement covered — a binding NAME, above all —
        ; bubbled up and answered with it. Suppress it structurally instead of
        ; relying on the type it happens to hold.
        var self_type semantic.operand_final_type op
        if semantic.is_block op.expr
            self_type := ""
        ; MEMBER mode (3): the cursor is on a plain field at the end of a chain,
        ; so only an operand that HAS a chain may answer for it. Without this an
        ; operand whose chain the planner could not type contributes "" and the
        ; ENCLOSING one answers instead — measured on symbols.scaly's
        ; `symbols.body_children(source, c.body)`, where `body` reported
        ; `String`, the surrounding call's return type. That is the last
        ; position where a wrong type could still reach a member token; a miss
        ; here falls through to the lexical hover, which says where the cursor
        ; sits rather than naming a type it does not know.
        if mode = 3 and semantic.ends_in_field(op.member_access) = false
            self_type := ""
        ; A strictly-tighter deeper match wins (genuine nesting f(g x)).
        if child.found
        {
            if child.width < self_width
                return child
        }
        ; EQUAL-WIDTH TIE — two shapes share a span and want OPPOSITE answers:
        ;   `own_page.allocate(…)`: the receiver operand carries the CALL's own
        ;     span, and mode 0 reports what the call yields (the documented
        ;     "call over its same-span receiver").
        ;   `len > 0`: an OPERATOR call's span covers its LEFT operand's text
        ;     ALONE — measured `    if len` = 2245..2254, with `>` and `0`
        ;     outside it — so the tie is between the operator's `bool` and the
        ;     operand the cursor is genuinely on, and hovering `len` answered
        ;     `bool`.
        ; PlannedCall.is_operator separates them exactly, which is why the tie
        ; is broken on the CALL KIND and not on the span.
        if child.found
        {
            if semantic.is_operator_call op.expr
                return child
        }
        ; Otherwise this operand, when it has a usable (non-void) type. On an
        ; equal-width tie this beats the deeper match — the call over its
        ; same-span receiver.
        if self_type.get_length() > 0
            return ResolveResult(true, self_width, self_type)
        ; This operand has no usable type (a void block wrapper): defer to the
        ; deeper match even at equal width.
        if child.found
            return child
        semantic.none()
    }

    function walk_operand_opt(opt: ref[PlannedOperand]?, mode: size_t, offset: size_t) returns ResolveResult
    {
        if opt <> null
            return semantic.walk_operand(*opt, mode, offset)
        semantic.none()
    }

    function walk_expr(expr: PlannedExpression, mode: size_t, offset: size_t) returns ResolveResult
    {
        choose expr
            when k: Constant
                return semantic.none()
            when ty: Type
                return semantic.none()
            when v: Variable
                return semantic.none()
            when g: GlobalRef
                return semantic.none()
            when c: Call
                return semantic.walk_call(c, mode, offset)
            when t: Tuple
                return semantic.walk_tuple(t, mode, offset)
            when mx: Matrix
                return semantic.none()
            when b: Block
                return semantic.walk_block(b, mode, offset)
            when iff: If
                return semantic.walk_if(iff, mode, offset)
            when m: Match
                return semantic.walk_match(m, mode, offset)
            when ch: Choose
                return semantic.walk_choose(ch, mode, offset)
            when fr: For
                return semantic.walk_for(fr, mode, offset)
            when wh: While
                return semantic.walk_while(wh, mode, offset)
            when rep: Repeat
                return semantic.walk_action(rep.body, mode, offset)
            when lm: Lambda
                return semantic.none()
            when tr: Try
                return semantic.walk_try(tr, mode, offset)
            when so: SizeOf
                return semantic.none()
            when ao: AlignOf
                return semantic.none()
            when iz: Is
                return semantic.walk_operand_opt(iz.value, mode, offset)
            when az: As
                return semantic.walk_operand_opt(az.value, mode, offset)
            when vc: VariantConstruction
                return semantic.walk_operand_opt(vc.value, mode, offset)
    }

    ; Is this expression a plain statement block? (see walk_operand#)
    function is_block(expr: PlannedExpression) returns bool
    {
        choose expr
            when b: Block
                return true
            else
                return false
    }

    ; Is this expression a call of an OPERATOR (`>`, `+`, …) rather than of a
    ; function or method? Breaks the equal-width tie in walk_operand#.
    function is_operator_call(expr: PlannedExpression) returns bool
    {
        choose expr
            when c: Call
                return c.is_operator
            else
                return false
    }

    function walk_call(c: PlannedCall, mode: size_t, offset: size_t) returns ResolveResult
    {
        if c.args <> null
            return semantic.walk_operands(*c.args, mode, offset)
        semantic.none()
    }

    function walk_tuple(t: PlannedTuple, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if t.components <> null
        {
            let comps (*t.components)
            var i: size_t 0
            while i < comps.length
            {
                let cp comps.get i
                if cp <> null
                {
                    let comp (*cp)
                    if comp.value <> null
                    {
                        let r semantic.walk_operands(*comp.value, mode, offset)
                        result := semantic.tighter(result, r)
                    }
                }
                i := i + 1
            }
        }
        result
    }

    function walk_block(b: PlannedBlock, mode: size_t, offset: size_t) returns ResolveResult
    {
        if b.statements <> null
            return semantic.walk_statements(*b.statements, mode, offset)
        semantic.none()
    }

    function walk_if(iff: PlannedIf, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if iff.condition <> null
            result := semantic.walk_operands(*iff.condition, mode, offset)
        if iff.consequent <> null
        {
            let c semantic.walk_statement(*iff.consequent, mode, offset)
            result := semantic.tighter(result, c)
        }
        if iff.alternative <> null
        {
            let a semantic.walk_statement(*iff.alternative, mode, offset)
            result := semantic.tighter(result, a)
        }
        result
    }

    function walk_match(m: PlannedMatch, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if m.condition <> null
            result := semantic.walk_operands(*m.condition, mode, offset)
        if m.branches <> null
        {
            let brs (*m.branches)
            var i: size_t 0
            while i < brs.length
            {
                let bp brs.get i
                if bp <> null
                {
                    let br (*bp)
                    if br.consequent <> null
                    {
                        let r semantic.walk_statement(*br.consequent, mode, offset)
                        result := semantic.tighter(result, r)
                    }
                }
                i := i + 1
            }
        }
        if m.alternative <> null
        {
            let a semantic.walk_statement(*m.alternative, mode, offset)
            result := semantic.tighter(result, a)
        }
        result
    }

    function walk_choose(ch: PlannedChoose, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if ch.condition <> null
            result := semantic.walk_operands(*ch.condition, mode, offset)
        if ch.cases <> null
        {
            let cs (*ch.cases)
            var i: size_t 0
            while i < cs.length
            {
                let wp cs.get i
                if wp <> null
                {
                    let wh (*wp)
                    if wh.consequent <> null
                    {
                        let r semantic.walk_statement(*wh.consequent, mode, offset)
                        result := semantic.tighter(result, r)
                    }
                }
                i := i + 1
            }
        }
        if ch.alternative <> null
        {
            let a semantic.walk_statement(*ch.alternative, mode, offset)
            result := semantic.tighter(result, a)
        }
        result
    }

    function walk_for(fr: PlannedFor, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.none()
        if fr.expr <> null
            result := semantic.walk_operands(*fr.expr, mode, offset)
        let body semantic.walk_action(fr.body, mode, offset)
        semantic.tighter(result, body)
    }

    function walk_while(wh: PlannedWhile, mode: size_t, offset: size_t) returns ResolveResult
    {
        let cond semantic.walk_binding(wh.cond, mode, offset)
        let body semantic.walk_action(wh.body, mode, offset)
        semantic.tighter(cond, body)
    }

    function walk_try(tr: PlannedTry, mode: size_t, offset: size_t) returns ResolveResult
    {
        var result semantic.walk_binding(tr.cond, mode, offset)
        if tr.catches <> null
        {
            let cs (*tr.catches)
            var i: size_t 0
            while i < cs.length
            {
                let wp cs.get i
                if wp <> null
                {
                    let wh (*wp)
                    if wh.consequent <> null
                    {
                        let r semantic.walk_statement(*wh.consequent, mode, offset)
                        result := semantic.tighter(result, r)
                    }
                }
                i := i + 1
            }
        }
        if tr.alternative <> null
        {
            let a semantic.walk_statement(*tr.alternative, mode, offset)
            result := semantic.tighter(result, a)
        }
        result
    }

    ; ====================================================================
    ; Type extraction
    ; ====================================================================

    ; Does this operand end in a plain FIELD access? This is the test by which
    ; MEMBER mode (3) admits an operand, and both halves are load-bearing. No
    ; chain at all means the operand is not the one the cursor's member belongs
    ; to. A chain ending in a METHOD is a CALL — `symbols.implementation_start(
    ; routine.implementation)` has a member chain too, and its span covers the
    ; argument, so it answered `size_t` for the field written inside it until
    ; this half excluded it.
    function ends_in_field(member_access: ref[Vector[PlannedMemberAccess]]?) returns bool
    {
        if member_access = null
            return false
        let ma (*member_access)
        if ma.length = 0
            return false
        let lp ma.get(ma.length - 1)
        if lp = null
            return false
        let last (*lp)
        if last.is_method
            return false
        true
    }

    ; The clean source type of an operand. PlannedOperand.result_type is often
    ; ABI-lowered (an lvalue variable reads back as `pointer`) or the chain
    ; BASE (b.get() reports the receiver), so prefer the post-access type: the
    ; LAST PlannedMemberAccess.result_type when a member chain is present (so
    ; a.f().b yields .b's type), else the expression's own typed field.
    function operand_final_type(op: PlannedOperand) returns String
    {
        if op.member_access <> null
        {
            let ma (*op.member_access)
            if ma.length > 0
            {
                let lp ma.get(ma.length - 1)
                if lp <> null
                    return semantic.type_name((*lp).result_type)
            }
        }
        semantic.expr_type(op.expr, op.result_type)
    }

    ; The expression's own resolved type field, falling back to `fallback`
    ; (the operand's result_type) for shapes without a cleaner field.
    function expr_type(expr: PlannedExpression, fallback: PlannedType) returns String
    {
        choose expr
            when v: Variable
                return semantic.type_name(v.variable_type)
            when g: GlobalRef
                return semantic.type_name(g.global_type)
            when c: Call
                return semantic.type_name(c.result_type)
            when t: Tuple
                return semantic.type_name(t.tuple_type)
            when vc: VariantConstruction
                return semantic.type_name(vc.union_type)
            when az: As
                return semantic.type_name(az.target_type)
            else
                return semantic.type_name fallback
    }

    ; True when offset is within [loc.start, loc.end).
    function contains(loc: Span, offset: size_t) returns bool
    {
        if offset < loc.start
            return false
        if offset >= loc.end
            return false
        true
    }

    ; The readable type name, or "" when empty / "void" / an unresolved type
    ; variable. Suppressing "void" matters: an offset on no typed sub-expr (a
    ; binding name) would otherwise bubble to the enclosing block operand and
    ; report "void", masking the lexical fallback. Suppressing a type variable
    ; (a generic param `T` the planner left unsubstituted) avoids a meaningless
    ; `: T` hint.
    ;
    ; `pt.name` is the BARE name — the resolved generic arguments sit beside it
    ; in `pt.generics`, so reading the field alone reported `pointer` for a
    ; `pointer[Page]` and `Vector` for a `Vector[int]`, i.e. it dropped exactly
    ; the part a hover is asked for. Planner.get_readable_name# is the
    ; compiler's own renderer for this (the DWARF type names go through it) and
    ; recurses into nested arguments; the emptiness tests stay on `pt.name`,
    ; which is what they were written against.
    function type_name(pt: PlannedType) returns String
    {
        if pt.variable <> null
            return ""
        if pt.name.get_length() = 0
            return ""
        if pt.name = "void"
            return ""
        Planner.get_readable_name pt
    }
}
