; rpc.scaly - Content-Length framed JSON-RPC transport over stdin/stdout.
;
; LSP frames every message as:
;
;     Content-Length: <N>\r\n
;     \r\n
;     <N bytes of UTF-8 JSON body>
;
; This module reads one frame at a time from fd 0 and writes frames to
; fd 1. Reads are byte-at-a-time for the header (frame headers are tiny)
; and bulk for the body. No JSON is interpreted here — the body String is
; handed to scalyls.json by the caller.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else); branching uses if/else. CR (13) and LF (10) are emitted as
; numeric bytes, never "\r"/"\n" literals (the lexer stores those raw as
; backslash+letter — s185 escape class).

use scaly.memory.runtime

define RPC_STDIN_FD: int 0
define RPC_STDOUT_FD: int 1

define rpc
{
    ; Read a single byte from stdin. Returns the byte (0..255), or -1 on
    ; EOF / error.
    function read_byte() returns int
    {
        var c: u8 0
        let cp &c
        let n read(RPC_STDIN_FD, cp as pointer[void], 1 as size_t)
        ; Read the byte back THROUGH the pointer: `read` wrote it via cp,
        ; and stage-0 does not reload an escaped local (`c as int` returns
        ; the stale pre-read value), so deref cp to force a memory load.
        if n = 1
            return (*cp) as int

        -1
    }

    ; Fill exactly `n` bytes from stdin into `buf`. Stops early on EOF.
    function read_exact(buf: pointer[void], n: size_t)
    {
        var total: size_t 0
        while total < n
        {
            let dst (buf as pointer[u8] + total) as pointer[void]
            let got read(RPC_STDIN_FD, dst, n - total)

            if got = 0          ; EOF
                return

            if got > (n - total)            ; (size_t)-1 error wraps high
                return

            set total: total + got
        }
    }

    ; Read one framed message. Returns the JSON body as a String on the
    ; caller's page, or an empty String at EOF / on a malformed frame.
    function read_message(rp) returns String
    {
        var content_length: size_t 0

        ; ---- headers: read lines until a blank line ----
        while true
        {
            var line StringBuilder()
            var eof false

            while true
            {
                let b rpc.read_byte()
                if b < 0                    ; EOF mid-stream
                {
                    set eof: true
                    break
                }

                if b = 10                   ; LF terminates the line
                    break

                if b <> 13                  ; drop CR, keep the rest
                    line.append(b as char)
            }

            if eof
                return String()

            let line_str line.to_string()
            if line_str.get_length() = 0   ; blank -> headers done
                break

            if line_str.starts_with("Content-Length:")
                set content_length: rpc.parse_header_size line_str
        }

        ; ---- body ----
        if content_length = 0
            return String()

        var body String(content_length)
        let buf body.get_buffer()
        rpc.read_exact(buf as pointer[void], content_length)
        body
    }

    ; Parse the integer value from a "Header-Name: <digits>" line.
    function parse_header_size(line: String) returns size_t
    {
        let colon line.index_of(0x3A)    ; ':'
        if colon < 0
            return 0 as size_t

        var i (colon + 1) as size_t
        let len line.get_length()

        ; skip leading spaces
        while (i < len) && (line.get(i) = 0x20)
            set i: i + 1

        var value: size_t 0
        while (i < len) && (line.get(i) >= 0x30) && (line.get(i) <= 0x39)
        {
            set value: (value * 10) + ((line.get(i) - 0x30) as size_t)
            set i: i + 1
        }
        value
    }

    ; Write a JSON body as a framed message to stdout.
    function write_message(body: String)
    {
        let len body.get_length()

        var sb StringBuilder()
        sb.append "Content-Length: "
        ; A StringBuilder mutated across a function boundary does not
        ; propagate (the receiver is copied), so the size is formatted
        ; into its own String and appended by value.
        sb.append(rpc.format_size(len))
        sb.append(13 as char)              ; CR
        sb.append(10 as char)              ; LF
        sb.append(13 as char)              ; CR
        sb.append(10 as char)              ; LF

        rpc.write_all(sb.to_string())
        rpc.write_all body
    }

    ; Write every byte of `s` to stdout, retrying short writes.
    function write_all(s: String)
    {
        let len s.get_length()
        if len = 0
            return

        let buf s.get_buffer()
        var total: size_t 0
        while total < len
        {
            let dst (buf + total) as pointer[void]
            let w write(RPC_STDOUT_FD, dst, len - total)

            if w = 0
                return

            if w > (len - total)        ; (size_t)-1 error wraps high
                return

            set total: total + w
        }
    }

    function format_size(rp, n: size_t) returns String
    {
        if n = 0
            return "0"

        var sb StringBuilder()
        var value n
        var digits Array[char]()
        while value > 0
        {
            let digit ((value % 10) as char) + (0x30 as char)
            digits.add digit
            set value: value / 10
        }

        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                sb.append(*d)
        }
        sb.to_string()
    }

    ; ====================================================================
    ; fd-parameterized variants — same framing, but over an arbitrary fd
    ; (the worker pipe) instead of stdin/stdout. Kept as independent copies
    ; of the stdin/stdout functions above so the proven editor path is
    ; never disturbed.
    ; ====================================================================

    function read_byte_fd(fd: int) returns int
    {
        var c: u8 0
        let cp &c
        let n read(fd, cp as pointer[void], 1 as size_t)
        if n = 1
            return (*cp) as int

        -1
    }

    function read_exact_fd(fd: int, buf: pointer[void], n: size_t)
    {
        var total: size_t 0
        while total < n
        {
            let dst (buf as pointer[u8] + total) as pointer[void]
            let got read(fd, dst, n - total)

            if got = 0
                return

            if got > (n - total)
                return

            set total: total + got
        }
    }

    function read_message_fd(rp, fd: int) returns String
    {
        var content_length: size_t 0

        while true
        {
            var line StringBuilder()
            var eof false

            while true
            {
                let b rpc.read_byte_fd fd
                if b < 0
                {
                    set eof: true
                    break
                }

                if b = 10
                    break

                if b <> 13
                    line.append(b as char)
            }

            if eof
                return String()

            let line_str line.to_string()
            if line_str.get_length() = 0
                break

            if line_str.starts_with("Content-Length:")
                set content_length: rpc.parse_header_size line_str
        }

        if content_length = 0
            return String()

        var body String(content_length)
        let buf body.get_buffer()
        rpc.read_exact_fd(fd, buf as pointer[void], content_length)
        body
    }

    function write_all_fd(fd: int, s: String)
    {
        let len s.get_length()
        if len = 0
            return

        let buf s.get_buffer()
        var total: size_t 0
        while total < len
        {
            let dst (buf + total) as pointer[void]
            let w write(fd, dst, len - total)

            ; write() is C's ssize_t: -1 on error (EPIPE when the worker pipe's
            ; reader has died — the crash-isolation path), 0 at EOF. As a size_t,
            ; (size_t)-1 wraps high, so `w > remaining` detects the error — now
            ; correct under both compilers (the self-hosted emitter emits an
            ; unsigned `ugt` for size_t comparisons).
            if w > (len - total)        ; (size_t)-1 error wraps high
                return

            if w = 0
                return

            set total: total + w
        }
    }

    function write_message_fd(fd: int, body: String)
    {
        let len body.get_length()

        var sb StringBuilder()
        sb.append "Content-Length: "
        sb.append(rpc.format_size(len))
        sb.append(13 as char)
        sb.append(10 as char)
        sb.append(13 as char)
        sb.append(10 as char)

        rpc.write_all_fd(fd, sb.to_string())
        rpc.write_all_fd(fd, body)
    }
}
