; worker.scaly - crash-isolated analysis worker.
;
; The diagnostics pipeline (parser -> modeler -> planner) runs the real
; Scaly compiler, which still SIGSEGVs / aborts / hangs on some inputs.
; Running it in-process would take the whole server down on a single bad
; document. So the parent (server.run) does ONLY transport + dispatch, and
; the dangerous pipeline runs in a persistent child process:
;
;     editor <-stdio-> [parent: transport + dispatch]
;                            |  request  (pipe: parent -> worker)
;                            v  response (pipe: worker -> parent)
;                      [worker: diagnostics pipeline]
;
; Per analysis the parent sends two raw frames (uri, then document text)
; to the worker, then waits for the framed publishDiagnostics payload with
; a TIMEOUT (raw framing avoids JSON-escaping arbitrary document text). If
; the worker crashes (EOF on its output pipe) or hangs (poll timeout), the
; parent kills + reaps it, returns an empty-diagnostics clear for the uri,
; and re-spawns a fresh worker on the next request. The parent thus never
; dies from a compiler bug.
;
; The worker is persistent (one fork, many requests) rather than fork-per-
; request: the pipeline is stateless per document, and the page leak that
; would have made a long-lived worker grow without bound is fixed.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line. CR/LF are numeric bytes (rpc handles the
; framing); quotes are 0x22 bytes.

use scaly.io.File
use scaly.memory.runtime
use scalyls.rpc
use scalyls.diagnostics
use scalyls.symbols
use scalyls.semantic

; POSIX process / pipe primitives (libc). Declared here rather than in the
; scaly package so no scaly/scalyc source is touched (fixpoint-safe).
function fork() returns i32 extern
; pipe fills two C `int` (32-bit) fds. Scaly `int` is 64-bit, so the fd
; pair MUST be an i32[2] (an int[2] would be 2x8 bytes and splice both fds
; into one garbage i64). The fd values themselves are small and widen
; cleanly into `int` when handed to read/write/close.
function pipe(fds: pointer[i32]) returns i32 extern
function close(fd: int) returns i32 extern
function waitpid(pid: int, status: pointer[i32], options: int) returns i32 extern
function kill(pid: int, sig: int) returns i32 extern
; poll: the C prototype is `int poll(struct pollfd *, nfds_t, int)`, and
; nfds_t is 32 bits on macOS (unsigned int) but 64 on glibc (unsigned long).
; ONE seed serves every target, so the width cannot be per-OS: `u64` is the
; portable choice, because the caller then writes the WHOLE register and a
; 32-bit callee reads the correct low half. `timeout` and the RESULT are
; plain C `int`, i.e. 32 bits on both.
; This declaration must stay type-identical to the one in scaly/fiber.scaly:
; both modules are linked into this binary, and they used to disagree --
; `declare i32 @poll(ptr, i32, i32)` against `declare i64 @poll(ptr, i64,
; i64)` -- so this call read a 64-bit result from a function that returns 32,
; with the upper half undefined.
function poll(fds: pointer[pollfd], nfds: u64, timeout: i32) returns i32 extern
function signal(sig: int, handler: pointer[void]) returns pointer[void] extern

; struct pollfd { int fd; short events; short revents; } — 8 bytes, matches
; the C layout on LP64 (i32 + i16 + i16).
define pollfd
(
    fd: i32
    events: i16
    revents: i16
)

define POLLIN i16 1
define SIGKILL int 9
define SIGPIPE int 13

; Wait at most this long for the worker to answer one PER-DOCUMENT request
; before declaring it hung and killing it (milliseconds). Sized for the
; single-document pipeline (parse -> model -> plan), which is well under a
; second even on the largest file in this tree.
define ANALYZE_TIMEOUT_MS i32 8000

; The whole-tree searches ("w" = workspace/symbol, and the cross-package
; definition / signatureHelp scans that share its index) get their own, far
; larger budget: on a COLD worker they parse every .scaly file under the root
; to build the symindex — measured 6.4-7.4s over this tree's 747 files / 11.6
; MB, i.e. INSIDE the 8s per-document budget but with no margin, so ordinary
; machine jitter pushed them over it.
;
; Sharing one budget was a correctness bug, not just a slow path. Exceeding it
; kills the worker (worker.shutdown#), and the symindex lives ONLY in the
; worker (symindex.scaly), so the kill threw away the very index the request
; was building: the next query started cold, timed out again, and the search
; never completed while every OTHER request paid a fresh worker's respawn. The
; empty `[]` fallback made it silent — the editor sees a valid, successful
; empty result, not an error.
;
; Kept finite so a genuinely hung pipeline is still reaped (that is the whole
; point of the isolation); it only has to exceed a legitimate cold scan by
; enough that jitter cannot reach it.
define WORKSPACE_TIMEOUT_MS i32 60000

; Worker process state, owned by the PARENT. worker_pid <= 0 means "no
; live worker"; the fds are the parent's ends of the two pipes.
mutable worker_pid: int 0
mutable worker_in:  int 0      ; parent -> worker  (write end)
mutable worker_out: int 0      ; worker -> parent  (read end)

define worker
{
    ; ====================================================================
    ; Child side: read framed {uri,text} requests, emit framed payloads.
    ; ====================================================================
    ; Protocol (over the pipe, NOT JSON): each request is FOUR framed
    ; messages — a kind tag ("d" diagnostics / "s" documentSymbol / "c"
    ; completion / "h" hover / "g" definition / "r" references / "l"
    ; documentHighlight / "n" rename / "p" prepareRename / "f" signatureHelp /
    ; "w" workspace/symbol / "o" foldingRange / "t" semanticTokens), the uri, the raw
    ; document text (the parent's in-memory copy; empty = unknown), then a
    ; packed cursor position ("<line> <char>", or "<line> <char> <newName>"
    ; for rename; empty for d/s) — and the reply is one framed payload. Raw framing avoids round-tripping arbitrary
    ; document text through JSON string-escaping (which would corrupt
    ; newlines/quotes/braces). When the document text frame is empty (the
    ; parent has no buffer for this uri) the worker re-reads the file from
    ; disk, preserving the old stateless behavior as a fallback.
    function serve(in_fd: int, out_fd: int) returns int
    {
        ; Each request is handled in serve_one (a plain helper) so its local
        ; page — holding the request frames AND everything the diagnostics
        ; pipeline allocates — is reclaimed every iteration. Handling inline
        ; in this never-returning loop would pin it all on serve's page and
        ; leak the whole pipeline working-set per request. The loop is driven
        ; by a flag (a call WITH args is not accepted as a while condition).
        var keep_going true
        while keep_going
            set keep_going: worker.serve_one(in_fd, out_fd)
        0
    }

    ; Handle one request. Returns true to keep serving, false at EOF (the
    ; parent closed its end). A plain (non-#) helper so its local page —
    ; holding the request frames AND the whole diagnostics-pipeline working
    ; set — is reclaimed on return, every iteration.
    function serve_one(in_fd: int, out_fd: int) returns bool
    {
        let kind rpc.read_message_fd in_fd
        if kind.get_length() = 0
            return false

        let uri rpc.read_message_fd in_fd
        let doctext rpc.read_message_fd in_fd
        let position rpc.read_message_fd in_fd

        ; workspace/symbol: the `uri` frame carries the workspace ROOT path and
        ; `position` the query; there is no single document. Handle it before
        ; the per-document source resolution below (which would try to read the
        ; root directory as a file).
        if kind = "w"
        {
            rpc.write_message_fd(out_fd, symbols.workspace_symbols(uri, position))
            return true
        }

        ; Resolve the document source: prefer the parent's in-memory copy
        ; (sees unsaved edits); fall back to reading the file from disk when
        ; the parent has no buffer for this uri (empty doctext frame).
        let path diagnostics.strip_uri uri
        var source doctext
        if source.get_length() = 0
            set source: File.read_to_string(path)

        ; documentSymbol: outline of the resolved source.
        if kind = "s"
        {
            rpc.write_message_fd(out_fd, symbols.document_symbols(source))
            return true
        }

        ; completion: when a `.` precedes the cursor and its receiver names a
        ; declared concept, the members of that concept; otherwise the flat
        ; all-names list (the editor prefix-filters either way).
        if kind = "c"
        {
            rpc.write_message_fd(out_fd, symbols.completion_packed(source, uri, position))
            return true
        }

        ; hover: symbol under the packed "<line> <char>" cursor position.
        if kind = "h"
        {
            rpc.write_message_fd(out_fd, symbols.hover_packed(source, position))
            return true
        }

        ; definition: declaration for the identifier at the cursor. Searches
        ; the current file first (result Location refers back to `uri`), then
        ; sibling .scaly files in the same directory tree (cross-file).
        if kind = "g"
        {
            rpc.write_message_fd(out_fd, symbols.definition_workspace_packed(source, uri, position))
            return true
        }

        ; references: all occurrences of the identifier at the cursor; the
        ; result Locations refer back to `uri`.
        if kind = "r"
        {
            rpc.write_message_fd(out_fd, symbols.references_packed(source, uri, position))
            return true
        }

        ; documentHighlight: occurrences in the current document (range-only).
        if kind = "l"
        {
            rpc.write_message_fd(out_fd, symbols.highlights_packed(source, position))
            return true
        }

        ; rename: rewrite every occurrence of the identifier at the cursor to
        ; the new name (packed as "<line> <char> <newName>"); the result
        ; WorkspaceEdit refers back to `uri`.
        if kind = "n"
        {
            rpc.write_message_fd(out_fd, symbols.rename_packed(source, uri, position))
            return true
        }

        ; prepareRename: the range of the renameable identifier at the cursor.
        if kind = "p"
        {
            rpc.write_message_fd(out_fd, symbols.prepare_rename_packed(source, position))
            return true
        }

        ; signatureHelp: the parameter list of the call enclosing the cursor.
        if kind = "f"
        {
            rpc.write_message_fd(out_fd, symbols.signature_packed(source, uri, position))
            return true
        }

        ; inlayHint: parameter-name hints for call sites in the packed
        ; "<sl> <sc> <el> <ec>" range.
        if kind = "y"
        {
            rpc.write_message_fd(out_fd, symbols.inlay_hints_packed(source, uri, position))
            return true
        }

        ; foldingRange: collapsible regions of the resolved source (uri-only,
        ; no position).
        if kind = "o"
        {
            rpc.write_message_fd(out_fd, symbols.folding_ranges(source))
            return true
        }

        ; semanticTokens: delta-encoded token classification of the source
        ; (uri-only, no position).
        if kind = "t"
        {
            rpc.write_message_fd(out_fd, symbols.semantic_tokens(source, uri))
            return true
        }

        ; semantic type: run the modeler+planner and resolve the type at the
        ; packed "<line> <char>" position. Returns the raw resolved type name
        ; (e.g. "int"), or "" on a miss / parse error / unresolved. The full
        ; pipeline can crash/hang here; the isolation + 8s poll handle it, and
        ; the server falls back to the lexical hover on an empty reply.
        if kind = "x"
        {
            rpc.write_message_fd(out_fd, semantic.semantic_type_framed(source, uri, position))
            return true
        }

        rpc.write_message_fd(out_fd, diagnostics.publish_diagnostics(uri, source))
        true
    }

    ; ====================================================================
    ; Parent side: spawn / kill / analyze.
    ; ====================================================================

    ; Fork a fresh worker and record its pid + pipe fds. On any failure
    ; worker_pid stays 0 (analyze then falls back to a clear payload).
    procedure spawn()
    {
        ; Writing to a dead worker's pipe must NOT kill the parent with
        ; SIGPIPE — that would defeat the whole isolation. Ignore it so the
        ; write returns an error instead; analyze then respawns. Set once in
        ; the parent (re-setting on respawn is harmless); the child inherits
        ; the disposition, which is fine.
        signal(SIGPIPE, 1 as pointer[void])  ; SIG_IGN

        var p2c i32[2]                       ; parent -> child
        if pipe(p2c as pointer[i32]) <> 0
            return
        var c2p i32[2]                       ; child -> parent
        if pipe(c2p as pointer[i32]) <> 0
            return

        let pid fork()
        if pid = 0
        {
            ; Child: keep p2c read end + c2p write end; drop the others.
            ; CRUCIAL: also drop the inherited editor stdin/stdout (fd 0/1).
            ; The worker talks only over the pipes; if it kept fd 1 open the
            ; editor's stdout pipe would never see EOF when the parent exits
            ; (the child would still hold a write end) and the client would
            ; hang. stderr (fd 2) stays open for crash output.
            close 0
            close 1
            close(*(p2c + 1))
            close(*(c2p + 0))
            let rc worker.serve(*(p2c + 0), *(c2p + 1))
            exit rc
            return
        }
        if pid < 0                        ; fork failed
        {
            close(*(p2c + 0))
            close(*(p2c + 1))
            close(*(c2p + 0))
            close(*(c2p + 1))
            return
        }

        ; Parent: keep p2c write end + c2p read end; drop the others.
        close(*(p2c + 0))
        close(*(c2p + 1))
        set worker_pid: pid
        set worker_in:  *(p2c + 1)
        set worker_out: *(c2p + 0)
    }

    procedure ensure()
    {
        if worker_pid <= 0
            worker.spawn()
    }

    ; Kill + reap the current worker and close its pipes. Leaves state in
    ; the "no worker" condition so the next analyze re-spawns.
    procedure shutdown()
    {
        if worker_pid > 0
        {
            kill(worker_pid, SIGKILL)
            ; i32, not int: waitpid writes FOUR bytes through this pointer
            ; (C `int *status`), so an i64 slot would leave four bytes of the
            ; local unwritten and the declaration would not resolve.
            var status i32 0
            waitpid(worker_pid, &status, 0)
        }
        if worker_in > 0
            close worker_in
        if worker_out > 0
            close worker_out
        set worker_pid: 0
        set worker_in:  0
        set worker_out: 0
    }

    ; Analyze (uri,text) in the worker. Returns the publishDiagnostics
    ; payload, or an empty-diagnostics clear payload if the worker is
    ; unavailable / crashed / hung (and respawns it next time). The text is
    ; the editor's latest buffer (the position frame is unused for diagnostics).
    function analyze(rp, uri: String, text: String) returns String
        worker.exchange("d", uri, text, "", diagnostics.clear_diagnostics(uri))

    ; Build the documentSymbol result for `uri` in the worker. `text` is the
    ; in-memory document copy (empty -> worker reads disk). Returns the JSON
    ; array; an empty array `[]` if the worker is unavailable/crashed/hung.
    function symbols(rp, uri: String, text: String) returns String
        worker.exchange("s", uri, text, "", "[]")

    ; Hover for `uri` at the packed "<line> <char>" position. `text` is the
    ; in-memory document copy (empty -> worker reads disk). Returns the LSP
    ; hover object, or "" (empty) if unavailable / no symbol at the cursor.
    function hover(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("h", uri, text, packed, "")

    ; Go-to-definition for `uri` at the packed "<line> <char>" position.
    ; `text` is the in-memory copy (empty -> worker reads disk). Returns the
    ; LSP Location object, or "" if unavailable / no matching declaration.
    function definition(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("g", uri, text, packed, "")

    ; Find-all-references for `uri` at the packed "<line> <char>" position.
    ; `text` is the in-memory copy (empty -> worker reads disk). Returns the
    ; LSP Location[] array; `[]` if unavailable / crashed / hung / no identifier.
    function references(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("r", uri, text, packed, "[]")

    ; documentHighlight for `uri` at the packed "<line> <char>" position.
    ; `text` is the in-memory copy (empty -> worker reads disk). Returns the
    ; LSP DocumentHighlight[] array (ranges only); `[]` if unavailable / none.
    function highlights(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("l", uri, text, packed, "[]")

    ; Completion for `uri` at the packed "<line> <char>" position. `text` is
    ; the in-memory copy (empty -> worker reads disk). Returns the members of
    ; the `.`-qualified receiver under the cursor when it names a declared
    ; concept, else a CompletionItem[] of every declared name; `[]` if
    ; unavailable.
    function completion(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("c", uri, text, packed, "[]")

    ; Rename for `uri`. `packed` is "<line> <char> <newName>". `text` is the
    ; in-memory copy (empty -> worker reads disk). Returns the LSP
    ; WorkspaceEdit, or "" if unavailable / no identifier at the cursor.
    function rename(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("n", uri, text, packed, "")

    ; prepareRename for `uri` at the packed "<line> <char>" position. `text`
    ; is the in-memory copy (empty -> worker reads disk). Returns the LSP Range
    ; of the renameable identifier, or "" if unavailable / not renameable.
    function prepare_rename(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("p", uri, text, packed, "")

    ; signatureHelp for `uri` at the packed "<line> <char>" position. `text`
    ; is the in-memory copy (empty -> worker reads disk). Returns the LSP
    ; SignatureHelp, or "" if unavailable / cursor not inside a known call.
    function signature_help(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("f", uri, text, packed, "")

    ; inlayHint for `uri` over the packed "<sl> <sc> <el> <ec>" range. `text` is
    ; the in-memory copy (empty -> worker reads disk). Returns the LSP
    ; InlayHint[] array; `[]` if unavailable / crashed / hung.
    function inlay_hints(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("y", uri, text, packed, "[]")

    ; foldingRange for `uri` (uri-only, no position). `text` is the in-memory
    ; copy (empty -> worker reads disk). Returns the LSP FoldingRange[] array;
    ; `[]` if unavailable / crashed / hung.
    function folding(rp, uri: String, text: String) returns String
        worker.exchange("o", uri, text, "", "[]")

    ; Semantic type at the packed "<line> <char>" position. `text` is the
    ; in-memory copy (empty -> worker reads disk). Returns the framed reply
    ; "1<name>" on a hit, "0" on a miss, or "" if unavailable / crashed / hung
    ; (the server decodes the tag and falls back to the lexical hover).
    function semantic_type(rp, uri: String, text: String, packed: String) returns String
        worker.exchange("x", uri, text, packed, "")

    ; semanticTokens for `uri` (uri-only, no position). `text` is the in-memory
    ; copy (empty -> worker reads disk). Returns the LSP {"data":[...]} object;
    ; an empty-data object if unavailable / crashed / hung. The fallback is
    ; built with quote BYTES (string-literal escapes are not decoded).
    function semantic_tokens(rp, uri: String, text: String) returns String
    {
        var fb StringBuilder()
        fb.append("{" as char)
        fb.append("\"" as char)
        fb.append "data"
        fb.append("\"" as char)
        fb.append(":" as char)
        fb.append("[" as char)
        fb.append("]" as char)
        fb.append("}" as char)
        worker.exchange("t", uri, text, "", fb.to_string())
    }

    ; workspace/symbol: search every .scaly file under `root` for declarations
    ; matching `query`. `root` rides in the uri frame, `query` in the position
    ; frame; the text frame is unused. Returns SymbolInformation[]; `[]` if
    ; unavailable / no root / no match.
    function workspace_symbols(rp, root: String, query: String) returns String
        worker.exchange("w", root, "", query, "[]")

    ; Send one (kind,uri,text,position) request to the worker and return its
    ; framed reply, or `fallback` if the worker is unavailable / crashed /
    ; hung. Up to two attempts: a worker that crashed mid-request is reaped
    ; and the request retried once on a fresh worker, so a transient crash is
    ; invisible to the editor. A deterministically-crashing input falls
    ; through to the fallback after the retry (bounded — no respawn storm).
    function exchange(rp, kind: pointer[const_char], uri: String, text: String, position: String, fallback: String) returns String
    {
        var attempts: int 0
        while attempts < 2
        {
            set attempts: attempts + 1
            worker.ensure()
            ; No live worker (spawn failed): nothing to do -> fallback.
            if worker_pid <= 0
                return fallback

            ; Send the request as four raw frames: kind, uri, doc text,
            ; packed cursor position.
            let kind_str String(kind)
            rpc.write_message_fd(worker_in, kind_str)
            rpc.write_message_fd(worker_in, uri)
            rpc.write_message_fd(worker_in, text)
            rpc.write_message_fd(worker_in, position)

            ; Wait for the answer with a timeout (catches a hung pipeline).
            ; The budget is per REQUEST KIND: a whole-tree scan legitimately
            ; takes seconds on a cold worker, where a per-document request
            ; never does. See WORKSPACE_TIMEOUT_MS for why one shared budget
            ; made the search unable to ever complete.
            var budget: i32 ANALYZE_TIMEOUT_MS
            if kind_str = "w"
                set budget: WORKSPACE_TIMEOUT_MS
            var pfd pollfd(worker_out as i32, POLLIN, 0)
            let pr poll(&pfd, 1 as u64, budget)

            ; poll == 0 (timeout) or < 0 (error): the pipeline hung. Kill it
            ; and give up — retrying would just hang again.
            if pr <= 0
            {
                worker.shutdown()
                return fallback
            }

            let resp rpc.read_message_fd worker_out
            ; Non-empty = a real answer.
            if resp.get_length() > 0
                return resp

            ; Empty = the worker crashed mid-request (its write end closed).
            ; Reap it; the loop respawns a fresh one and retries once.
            worker.shutdown()
        }
        fallback
    }
}
