; main.scaly - Entry point for the Scaly language server (scalyls).
;
; Speaks LSP JSON-RPC over stdin/stdout. Build it like the compiler, but
; linking LLVM (the diagnostics pipeline pulls in the scalyc package):
;   scalyc -o scalyls packages/scalyls/0.1.0/main.scaly \
;       -L<llvm-libdir> -lLLVM-18

package scaly 0.1.0
package scalyc 0.1.0
package scalyls 0.1.0

use scalyls.server

procedure main(argc: int, argv: pointer[pointer[char]]) returns int
{
    server.run()
    return 0
}
