; main.scaly - Entry point for the Scaly language server (scalyls).
;
; Speaks LSP JSON-RPC over stdin/stdout. Build it like the compiler, but
; linking LLVM (the diagnostics pipeline pulls in the scalyc package):
;   scalyc -o scalyls packages/scalyls/0.1.0/main.scaly \
;       -L<llvm-libdir> -lLLVM-18

package scaly 0.1.0
package scalyc 0.1.0
package json 0.1.0
package scalyls 0.1.0

use scalyls.server

procedure main(argc: int, argv: pointer[pointer[char]]) returns int mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len
{
    server.run()
    return 0
}
