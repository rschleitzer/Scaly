; scalyls - Scaly Language Server
;
; Package root. Depends on the scaly stdlib. The compiler pipeline
; (scalyc package) is pulled in later, once the server moves past the
; transport/JSON foundation built here in Step 1+2.

package scaly 0.1.0

; The diagnostics module drives the self-hosted compiler pipeline.
package scalyc 0.1.0

define scalyls
{
    ; JSON value tree + parser + serializer (reusable; not LSP-specific).
    module json

    ; Content-Length framed JSON-RPC transport over stdin/stdout.
    module rpc

    ; Diagnostics: text -> compiler pipeline -> publishDiagnostics.
    module diagnostics

    ; Persistent workspace symbol index (worker side): content-hashed per-file
    ; symbol blobs so workspace/symbol re-parses only changed files.
    module symindex

    ; Grammar-derived keyword classification for semantic highlighting,
    ; generated from scaly.sgm <keyword> elements by ./mkp.
    module grammar

    ; O(1) hashed name->token-kind set backing semanticTokens declared-kind
    ; resolution (replaces the linear name-list scan).
    module nameset

    ; documentSymbol: text -> parse -> DocumentSymbol[] outline tree.
    module symbols

    ; textDocument/formatting: token-based re-indentation. Line structure is
    ; never touched — in Scaly an LF separates constructs.
    module format

    ; Planner-based (semantic) type resolution: run the modeler+planner and
    ; map a byte offset to the innermost planned node's resolved type.
    module semantic

    ; textDocument/codeLens: the TaskPlanner's self-scaling verdict over
    ; every `for` loop — the only editor surface where parallelization is
    ; observable at all.
    module tasklens

    ; textDocument/codeLens: instantiation counts per routine, and the routines
    ; the demand-driven planner never emitted.
    module instlens

    ; textDocument/codeLens: assembles the array from every lens family, and
    ; owns the three that need no plan (generated file, package/module
    ; resolution, Run).
    module codelens

    ; In-memory document store (parent side) so navigation features see
    ; unsaved editor edits instead of re-reading from disk.
    module docstore

    ; Crash-isolated worker subprocess running the diagnostics pipeline.
    module worker

    ; LSP JSON-RPC lifecycle + dispatch loop.
    module server
}
