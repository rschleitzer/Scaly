; server.scaly - LSP JSON-RPC lifecycle + dispatch loop.
;
; Reads Content-Length framed messages from stdin (scalyls.rpc), parses
; each body as JSON (scalyls.json), dispatches on `method`, and writes
; framed JSON responses to stdout. Requests (with an `id`) get a Response;
; notifications (no `id`) do not.
;
; Lifecycle handled here:
;   initialize   -> capabilities + serverInfo
;   initialized  -> notification, ignored
;   shutdown     -> null result
;   exit         -> terminate the process
;
; Diagnostics for textDocument/didOpen and textDocument/didChange live in
; scalyls.diagnostics; the dispatch hooks call into it.
;
; STRING/JSON NOTE: outgoing JSON is assembled with a local StringBuilder,
; appending to it directly (the in-place method-call form, which is the
; only StringBuilder-mutation that propagates — an aggregate receiver is
; copied across a plain call boundary). Helpers therefore RETURN String
; pieces (the format_i64#/quote_string# pattern) rather than mutating a
; passed-in builder. Double quotes are injected as 0x22 bytes (the lexer
; does not decode `\"` reliably — same class as the CR/LF escape issue).
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line (`;` starts a comment, not a separator).

use scaly.memory.runtime
use scalyls.rpc
use scalyls.json
use scalyls.json.JsonValue
use scalyls.diagnostics
use scalyls.docstore
use scalyls.symbols
use scalyls.worker

define server
{
    ; Main loop: read a frame, dispatch, repeat. An empty body means EOF
    ; on stdin -> shut the loop down.
    procedure run() @deep true io mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len reads doc_slots linked












    ; Read and dispatch a single message. Returns true to continue the
    ; loop, false at EOF (empty body) to shut it down. The body lives on
    ; this function's local page and is freed on return.
    procedure process_one() @ret_nonlocal true @deep true returns bool io mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len reads doc_slots linked
















    ; Run the owed diagnostics analyses, newest buffer first, and stop as soon as
    ; the client speaks again — an answer it is waiting for outranks a diagnostic
    ; it is not.
    procedure flush_dirty() @deep true io mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked













    procedure handle_message(mutable body: String) @deep true io mutable dir_slots, doc_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid, ws_root_data, ws_root_len reads ws_root_data linked



































































































































































































































    ; ====================================================================
    ; Document sync -> diagnostics
    ; ====================================================================

    procedure handle_did_open(msg: JsonValue) @ret_caller true @deep true mutable doc_slots reads doc_slots linked











    procedure handle_did_change(msg: JsonValue) @deep true mutable doc_slots reads doc_slots linked





























    ; Apply one LSP contentChange to `text`, returning the new full document.
    ; No `range` -> a full-document replacement (the change text IS the whole
    ; document). With a range -> replace the [start,end) span (start/end as
    ; 0-based line/character) with the change text. The result is assembled
    ; ONE BYTE AT A TIME (prefix, inserted text, suffix): a single
    ; StringBuilder.append of a large String hits the runtime's manual-grow
    ; crash (see symbols.scaly's STRING/JSON NOTE).
    function apply_change(rp, text: String, change: JsonValue) @direct true @ret_caller true @deep true returns String linked








































    ; documentSymbol: return the outline tree for the requested document.
    ; The request carries only a uri (no text), so the worker re-reads the
    ; file from disk. The result is the DocumentSymbol[] array wrapped in a
    ; Response envelope with the request id.
    procedure handle_document_symbol(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked











    ; foldingRange: collapsible regions of the document. Like documentSymbol
    ; the request carries only a uri, so the worker re-reads the file (falling
    ; back from the in-memory copy). The result is the FoldingRange[] array
    ; wrapped in a Response envelope; it can be large, so document_symbol_response#
    ; (byte-at-a-time) builds it.
    ; textDocument/codeAction. The request carries the diagnostics the client
    ; already holds for the range, and a visibility diagnostic ENDS in the fix:
    ;   "... but not visible here; add: use demo.widgets.Widget"
    ; So the answer is read off the request rather than recomputed — re-running
    ; the planner to ask which name is invisible would ask a question it has
    ; already answered, and let the two answers drift apart.
    ;
    ; Nothing to fix -> `[]`, which is what the client gets on every ordinary
    ; cursor position (it asks constantly, unprompted).
    procedure handle_code_action(msg: JsonValue, id: i64) @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked















    ; textDocument/codeLens: one lens per `for` loop, carrying the TaskPlanner's
    ; self-scaling verdict (scalyls.tasklens). The request carries only a uri, so
    ; the in-memory buffer is passed along — the lens POSITIONS are the buffer's,
    ; even though the verdicts come from the file as last saved.
    ;
    ; The client asks again on every document version, so this pays a package-root
    ; plan per edit burst — the same cost class as the diagnostics it already runs
    ; per burst, and the reason the answer is never computed in this process.
    procedure handle_code_lens(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked









    ; The diagnostics of a codeAction context, one per line, as
    ; `<line> <character> <message>` — the 0-based start position of the
    ; diagnostic, then its text.
    ;
    ; ★THE PARENT PACKS, THE WORKER DECIDES. Which messages have a fix, and what
    ; the fix is, is settled in ONE place (symbols.code_actions_packed#) — the
    ; parent does not look inside a message at all. It used to: it scraped the
    ; `use` path out of the visibility hint and sent only that, so the parent
    ; knew one fix and the worker knew the rest. Every fix added after it would
    ; have had to be recognised twice, on both sides of a pipe, which is exactly
    ; the drift the recognise-from-the-message rule exists to avoid.
    ;
    ; A message cannot contain an LF (the planner writes none, and a diagnostic
    ; is one line), but one is replaced by a space rather than trusted — the line
    ; IS the framing here.
    function diagnostics_packed(rp, context: JsonValue) @direct true @ret_caller true @deep true returns String linked



































    ; The offset of `needle` in `hay`, or hay's length when absent.
    function find_substring(hay: String, needle: String) @ret_nonlocal true @deep true returns size_t linked




























    ; textDocument/prepareCallHierarchy — the entry point: resolve the cursor to
    ; the routine whose hierarchy is asked for. The two call requests below then
    ; arrive with the ITEM this returned, not with a cursor.
    procedure handle_prepare_call_hierarchy(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked














    ; callHierarchy/incomingCalls — who calls the item. The item's OWN uri is
    ; the document (it may live in a different file than the cursor did), and
    ; the workspace root rides along the same way references passes it.
    procedure handle_incoming_calls(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads ws_root_data linked



























    ; callHierarchy/outgoingCalls — what the item calls. The item's range start
    ; locates the routine in its own file.
    procedure handle_outgoing_calls(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked















    ; textDocument/typeDefinition. Same request shape as definition; the worker
    ; resolves the TYPE of the thing at the cursor and then looks THAT up.
    procedure handle_type_definition(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked
















    ; textDocument/selectionRange. The request carries an ARRAY of positions
    ; (a multi-cursor selection asks for all of them at once) and the reply must
    ; hold one chain per position, in the same order. They are packed as one
    ; "<line> <char>" per line, the same shape every other position frame uses.
    procedure handle_selection_range(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked






















    procedure handle_folding_range(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked









    ; formatting: `Format Document` / format on save. Like foldingRange the
    ; request carries only a uri (plus FormattingOptions, which are ignored —
    ; this tree's indentation is four spaces and the formatter's job is to
    ; follow the house form, not the editor's preference). The result is a
    ; TextEdit[]; it can be one edit per changed line, so the large-payload
    ; response builder applies.
    procedure handle_formatting(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked









    ; semanticTokens/full: whole-document token classification for syntax
    ; highlighting. Like documentSymbol the request carries only a uri. The
    ; result is {"data":[...]} (delta-encoded ints) wrapped in a Response; the
    ; data array can be large, so document_symbol_response# (byte-at-a-time).
    procedure handle_semantic_tokens(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked









    ; hover: the request carries a uri + a {line,character} position. Pack the
    ; position as "<line> <char>" and hand it to the worker, which re-reads the
    ; file (the server is stateless) and reports the symbol under the cursor.
    ; An empty worker reply -> result:null.
    procedure handle_hover(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked




























    ; Decode the worker's framed semantic-type reply ("1<name>" hit / "0" miss
    ; / "" crash) into an LSP hover object, or "" on a miss/crash so the
    ; caller falls back to the lexical hover.
    function semantic_hover_from_framed(rp, framed: String) @direct true @ret_caller true @deep true returns String linked





















    ; definition: like hover, the request carries a uri + {line,character}.
    ; Pack the position as "<line> <char>" and hand it to the worker, which
    ; re-reads the file and resolves the identifier under the cursor to a
    ; declaration in the same file. An empty worker reply -> result:null.
    procedure handle_definition(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked



















    ; signatureHelp: the request carries a uri + {line,character}. Pack the
    ; position as "<line> <char>" and ask the worker for the parameter list of
    ; the call enclosing the cursor. An empty worker reply -> result:null.
    procedure handle_signature_help(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked



















    ; inlayHint: the request carries a uri + a {start,end} range. Pack the range
    ; as "<sl> <sc> <el> <ec>" and hand it to the worker, which resolves each
    ; in-range call site's parameter names. The result is an InlayHint[] array
    ; (can be large -> document_symbol_response# appends it byte-at-a-time).
    procedure handle_inlay_hint(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked



























    ; references: the request carries a uri + {line,character} + a
    ; context.includeDeclaration flag (ignored — the lexical scan cannot
    ; distinguish the declaration from uses, so all whole-token occurrences
    ; are always returned). Pack the position and hand it to the worker, which
    ; re-reads the file and scans it. The result is a Location[] array.
    procedure handle_references(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads ws_root_data linked




































    ; documentHighlight: like references but the result ranges carry no uri
    ; (the editor highlights occurrences in the current document only).
    procedure handle_document_highlight(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked



















    ; completion: when a `.` precedes the cursor and its receiver names a
    ; declared concept, return that concept's members; otherwise return every
    ; declared name as a flat CompletionItem[] (the editor prefix-filters).
    ; Pack the cursor position "<line> <char>" so the worker can detect the
    ; member-access context. Like the other navigation requests, the in-memory
    ; text is passed so unsaved edits are reflected; empty -> worker reads disk.
    procedure handle_completion(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked





















    ; completionItem/resolve: fill in the `documentation` of the ONE entry the
    ; client has selected, and answer the entry.
    ;
    ; The request carries the CompletionItem and NOTHING ELSE — no textDocument,
    ; no position — so the entry has to say where it came from itself. It does:
    ; symbols.with_item_data# put the uri of the file it was read from into
    ; `data`, which the client returns untouched. The buffer for THAT file is
    ; looked up in the docstore (empty when the editor has it closed, in which
    ; case the worker reads disk), so an entry from a file being edited resolves
    ; against the unsaved text like every other request.
    ;
    ; The answer is the entry the client sent, plus `documentation` — never a
    ; freshly built one. Re-serializing what arrived is what keeps every field
    ; the client set (and every field a future version of this server adds)
    ; instead of silently dropping it; the injection is a splice before the
    ; object's closing brace, which needs no scan because stringify# produced
    ; the string one line above.
    procedure handle_completion_resolve(msg: JsonValue, id: i64) @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked


























    ; `serialized` (a JSON object) with `"documentation":<doc>` spliced in before
    ; its closing brace. Byte-at-a-time: a doc block in this tree runs to
    ; hundreds of bytes and this runs in the PARENT, with no crash isolation.
    function with_documentation(rp, serialized: String, doc: String) @direct true @deep true returns String linked



























    ; prepareRename: the request carries a uri + {line,character}. Pack the
    ; position as "<line> <char>" and ask the worker for the range of the
    ; renameable identifier under the cursor. An empty worker reply ->
    ; result:null (the editor then refuses the rename).
    procedure handle_prepare_rename(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads doc_slots linked



















    ; rename: the request carries a uri + {line,character} + a newName. Pack
    ; the position AND the new name as "<line> <char> <newName>" and ask the
    ; worker to rewrite every whole-token occurrence of the identifier at the
    ; cursor. The result is an LSP WorkspaceEdit (can be large -> byte-at-a-time
    ; wrap); an empty worker reply -> result:null.
    procedure handle_rename(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads ws_root_data linked















































    ; workspace/symbol: search the whole workspace for declarations whose name
    ; matches params.query. The request carries no document uri, so the search
    ; root comes from the stored workspace root (captured at initialize). The
    ; result SymbolInformation[] can be large -> byte-at-a-time wrap.
    procedure handle_workspace_symbol(msg: JsonValue, id: i64) @ret_nonlocal true @deep true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads ws_root_data linked








    ; Capture the workspace root path from initialize params. Prefer rootUri
    ; (file:// -> path), then rootPath, then workspaceFolders[0].uri. Stored in
    ; the docstore so workspace/symbol (which carries no uri) can find it.
    procedure capture_workspace_root(msg: JsonValue) @deep true mutable ws_root_data, ws_root_len reads ws_root_data linked


























    ; A closed document leaves no buffer to analyze; clear whatever
    ; diagnostics the editor still shows for it (empty diagnostics array).
    procedure handle_did_close(msg: JsonValue) @ret_caller true @deep true io mutable doc_slots reads doc_slots linked










    ; Diagnostics are computed in a crash-isolated worker subprocess (see
    ; scalyls.worker): a SIGSEGV/abort/hang in the compiler pipeline on a
    ; bad document then loses only that one result, not the whole server.
    procedure publish_for(mutable uri: String, mutable text: String) @deep true @deep_beyond_1 true io mutable dir_slots, idx_epoch, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, ph_blob_data, ph_blob_len, ph_hash, ph_path_data, ph_path_len, ph_used, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig, worker_in, worker_out, worker_pid reads worker_pid linked





    ; The diagnostics reply is a LINE-SEPARATED list of publishDiagnostics
    ; notifications: the analysed document first, then one per sibling module of
    ; its package root (scalyls.diagnostics' header has the reasoning). Write each
    ; as its own JSON-RPC frame.
    ;
    ; An empty line is skipped rather than framed — an empty frame is not a valid
    ; message, and the tail deliberately ends in an LF.
    ;
    ; ★A SIBLING THAT IS ITSELF OPEN IS SKIPPED, and this is the one thing in the
    ; fan-out the worker cannot decide: the docstore lives only in the parent.
    ; The reason is that the two analyses are not equivalent. A sibling's
    ; notification is derived from DISK, while a file's own analysis takes its
    ; parse errors from the LIVE BUFFER — so publishing over an open file erases
    ; exactly the diagnostic the user is looking at. Measured on two open files of
    ; one root: an unfinished line in B showed `expected '}'`, and one keystroke
    ; in A cleared it, with the broken line still on screen. An open file loses
    ; nothing by being skipped — it gets its own analysis on its own next edit.
    procedure write_notifications(mutable payload: String) @deep true io reads doc_slots linked




























    ; Write one publishDiagnostics notification, unless it is a sibling (index
    ; > 0) whose document the editor has open — see write_notifications# for why.
    ; Line 0 is the analysed document itself and is always written.
    procedure write_notification(mutable notification: String, index: size_t) @deep true io reads doc_slots linked












    ; ====================================================================
    ; Response builders (local StringBuilder; quotes as 0x22 bytes; nested
    ; pieces via String-returning helpers)
    ; ====================================================================

    ; {"jsonrpc":"2.0","id":<id>,"result":{"capabilities":
    ;   {"textDocumentSync":1},"serverInfo":{"name":"scalyls",
    ;   "version":"0.1.0"}}}
    function initialize_response(rp, id: i64) @direct true @ret_caller true @deep true returns String linked























































































































































































    ; {"jsonrpc":"2.0","id":<id>,"result":null}
    function null_result_response(rp, id: i64) @direct true @ret_caller true @deep true returns String linked















    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is a
    ; pre-serialized JSON value (the DocumentSymbol[] array).
    ;
    ; `result` can be many KB (a big file's outline). It is appended ONE BYTE
    ; AT A TIME, not via a single StringBuilder.append(String): a single
    ; append that more than doubles the buffer hits the runtime's manual-grow
    ; path (own_page.allocate of the whole buffer), which SIGSEGVs past one
    ; exclusive page. This runs in the PARENT (no crash isolation), so the
    ; byte-at-a-time form is what keeps a large outline from killing the
    ; server. See symbols.scaly's STRING/JSON NOTE.
    function document_symbol_response(rp, id: i64, result: String) @direct true @ret_caller true @deep true returns String linked





















    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized hover object, or null when empty (no symbol at cursor).
    ; Hover payloads are small, so a single append is fine here.
    function hover_response(rp, id: i64, result: String) @direct true @ret_caller true @deep true returns String linked


















    ; {"jsonrpc":"2.0","id":<id>,"result":<result>}  where <result> is the
    ; pre-serialized Location object, or null when empty (no declaration found
    ; for the identifier under the cursor). A single Location is small, so a
    ; single append is fine here.
    function definition_response(rp, id: i64, result: String) @direct true @ret_caller true @deep true returns String linked


















    ; `"key":`  (quoted key followed by a colon)
    function key(rp, k: Slice[char]) @direct true @ret_caller true @deep true returns String linked









    ; `"s"`  (quoted string literal; no escaping — fixed ASCII only)
    function quoted(rp, s: Slice[char]) @direct true @ret_caller true @deep true returns String linked







}
