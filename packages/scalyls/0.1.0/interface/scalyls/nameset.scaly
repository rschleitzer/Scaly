; nameset.scaly - O(1) hashed name->token-kind set for semanticTokens.
;
; semantic_tokens# colours an identifier USE by its declared kind by testing
; it against several name lists: the lowercase primitives, the intra-file
; function/type names (from completion_items#), and the cross-file function/
; type names (from the workspace symindex). The old membership test was a
; LINEAR newline-list scan, so the per-request cost was O(identifiers x total
; list bytes) — the bottleneck that forced Step 27's two band-aids (cross-file
; harvest dir-tree-only + skipped above 96000 bytes).
;
; This replaces the five separate lists with ONE per-request open-addressing
; hash table mapping a name -> the token type to colour it (1 = type, 2 =
; function). Per-identifier lookup is O(token length) instead of O(list bytes),
; which removes the size gate, speeds the intra-file path, and lets the
; cross-package stdlib scan back in.
;
; PRIORITY: a name that is both a type and a function resolves to FUNCTION.
; insert() only ever raises a slot's kind (function 2 > type 1), so insertion
; order is irrelevant and function always wins.
;
; MEMORY MODEL: unlike docstore/symindex, the table is NOT persistent — it
; lives only for one semantic_tokens# call. The slot array is a single libc
; malloc'd block, freed before the function returns (nameset.destroy). Slots
; BORROW: each stores a raw pointer into a name list's byte buffer (the lists
; are let-bound Strings alive for the whole function), so there is no per-name
; allocation. Only the slot array is malloc'd.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).
; One statement per line (`;` starts a comment, not a separator).

use scaly.memory.runtime

; libc allocator (free comes from scaly.memory.runtime; malloc is declared
; locally — fixpoint-safe, no scaly/scalyc source is touched).
function malloc(size: size_t) returns pointer[void] extern

; Slot count: a power of two so the probe mask is cap-1. Sized for the whole
; packages/ tree (a few thousand distinct fn/type names across stdlib + the
; self-hosted compiler) with a low load factor. On overflow insert silently
; drops a name (it then colours by shape, not a crash).
define NS_CAP int 32768

; One table slot: a BORROWED view into a name list's buffer, the
; token type to colour the name (1 type / 2 function), and a `used` flag.
define NameSlot
(
    var name:     Slice[u8]
    var kind:     i64
    var used:     bool
)

define nameset
{
    ; FNV-1a over p[0,len) (mirrors scaly.containers.hashing.hash); used for
    ; BOTH insert (name bytes) and lookup (source bytes) so equal byte
    ; sequences hash identically.
    function hash_ptr(p: Slice[u8]) @ret_nonlocal true returns size_t linked
















    ; FNV-1a over the byte range s[start,end). Hashes the logical content (after
    ; the String's varint length prefix) via get_buffer, no per-call allocation.
    function hash_range(s: String, start: size_t, end: size_t) @ret_nonlocal true returns size_t linked







    ; Byte-equality of a[0,len) and b[0,len) over two raw pointers.
    function eq_ptr(a: Slice[u8], b: Slice[u8]) @ret_nonlocal true returns bool linked
















    ; Allocate + zero a slot array of `cap` entries. null on malloc failure
    ; (callers then treat every name as absent — colours by shape).
    function create(cap: size_t) @ret_caller true returns pointer[NameSlot] linked


















    procedure destroy(mutable slots: pointer[NameSlot]) @ret_nonlocal true linked





    ; Insert (or raise the kind of) the name `name` views with the
    ; precomputed hash `h`. Open addressing, linear probe. An existing entry for
    ; the same name is only ever raised (kind 2 function > 1 type), so function
    ; wins regardless of order. A full table drops the name silently.
    procedure insert(mutable slots: pointer[NameSlot], cap: size_t, name: Slice[u8], h: size_t, kind: i64) linked





























    ; Insert every newline-delimited segment of `list` (a names_from_items# /
    ; primitive_type_list# / tagged_name_list# result) with the given kind. Slots
    ; borrow the list's buffer, so `list` must outlive the table.
    procedure insert_name_list(mutable slots: pointer[NameSlot], cap: size_t, list: String, kind: i64) linked



































    ; The token kind for source[start,end), or -1 if the name is not in the set.
    function lookup(slots: pointer[NameSlot], cap: size_t, source: String, start: size_t, end: size_t) @ret_param_0 true returns i64 linked






























}
