; symbols.scaly - textDocument/documentSymbol support.
;
; Parse a document's text (parser only — no modeler/planner) and turn its
; top-level declarations into a hierarchical LSP DocumentSymbol[] tree. The
; result is the bare JSON array `[ <symbol>... ]`; the parent wraps it in a
; Response envelope with the request id (server.handle_document_symbol).
;
; Each <symbol>:
;   {"name":<name>,"kind":<int>,"range":{...},"selectionRange":{...},
;    "children":[ <symbol>... ]}
; LSP SymbolKind ints used here:
;   Module=2 Namespace=3 Constructor=9 Enum=10 Method=6 Function=12
;   Variable=13 Constant=14 EnumMember=22 Struct=23 Operator=25
; range/selectionRange use the syntax node's start..end byte offsets,
; converted to 0-based line/character (selectionRange == range here).
;
; UNION-MATCH NOTE: the Syntax unions are matched by PAYLOAD TYPE name
; (`when f: FunctionSyntax`), mirroring Modeler.scaly — NOT by variant tag.
; The throws-union from parse_program# is matched by tag (Success/Error).
;
; STRING/JSON NOTE: outgoing JSON uses a local StringBuilder appended in
; place; nested pieces come from String-returning helpers. Quotes are 0x22
; bytes. A potentially-large piece (a nested symbol / children array) is
; appended ONE BYTE AT A TIME (inline `while` over its bytes) rather than as
; a single StringBuilder.append(String): the runtime's Array.add(Vector)
; takes a manual-grow path (own_page.allocate of the whole new buffer)
; whenever a single append more than doubles the buffer's capacity, and that
; path SIGSEGVs for buffers larger than one exclusive page. Byte-at-a-time
; append only ever grows via the safe reallocate() doubling, so it never
; trips it. The loop is inlined (not a helper) because a StringBuilder
; mutated through a pointer/by-value parameter does not propagate to the
; caller — only the in-place `sb.append(...)` form on a local does.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no
; else). One statement per line. `choose *ptr` does not parse — bind the
; deref to a local first. In a choose returning a value, EVERY arm uses an
; explicit `return` (mixing return + bare arms drops the bare ones).

use scaly.os.File
use scaly.memory.runtime
use scaly.memory.root_pages.getenv
use scalyls.json
use scalyls.symindex
use scalyls.grammar
use scalyls.nameset
use scalyls.semantic

use scalyc.compiler.parser

; libc stream primitives for enumerating sibling .scaly files when a
; go-to-definition target is not in the current file. Declared here (not in
; the scaly package) so no scaly/scalyc source is touched (fixpoint-safe).
; popen runs `/bin/sh -c <cmd>` — portable across macOS + Linux, sidestepping
; the platform-specific `struct dirent` layout that raw readdir would need.
function popen(command: pointer[const_char], mode: pointer[const_char]) returns pointer[OpaqueFile] extern
function pclose(stream: pointer[OpaqueFile]) returns i32 extern
; fgetc returns a C `int` (32-bit). It MUST be i32, not Scaly's 64-bit int:
; at EOF the C -1 (0xFFFFFFFF) would zero-extend to 4294967295 in a 64-bit
; register, so an i64 `c < 0` EOF test never fires and the read loop spins
; forever (worker hang -> poll timeout -> null result).
function fgetc(stream: pointer[OpaqueFile]) returns i32 extern

; Syntax tree types (parser output). Imported by payload type so the
; `choose ... when x: TSyntax` arms resolve.
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyls.nameset.*
use scalyls.json.*

mutable prof_list: int linked
mutable prof_read: int linked
mutable prof_fresh: int linked
mutable prof_sig: int linked
mutable prof_bytes: int linked

; ---- the LINE CURSOR (offset_to_pos#'s fast path) -----------------------
;
; ★WHY IT EXISTS. offset_to_pos# walks the source from byte 0 for every offset
; it converts, and workspace_symbols_in_file# converts TWO offsets per symbol
; against ONE source — so building a file's cached symbol blob costs
; O(symbols x bytes). Measured 2026-08-24 on this tree: one inlayHint over
; packages/scaly/.../Vector.scaly builds the blob for every .scaly file under
; packages/ and took 89 s, past the worker's 60 s budget, so the request
; answered EMPTY and the worker was respawned WITHOUT its index — which means
; the next request pays the whole price again and no request can ever finish.
; A synthetic file of N equal declarations timed 0.2 / 0.5 / 1.7 / 6.5 s for
; N = 250 / 500 / 1000 / 2000, i.e. exactly quadratic, and short-circuiting
; offset_to_pos# alone took a 34.5 s two-package request to 1.2 s.
;
; WHAT IT IS. The last converted offset plus its line/column, so the next
; conversion walks the DISTANCE between the two instead of the whole file.
; Both directions, because the order is not monotone: ws_definition# emits a
; concept's own span [start, end] before its members' spans, which start
; INSIDE it. The total walk is then proportional to the file, not to its
; square.
;
; ★SOUNDNESS. The cursor is keyed on the source's BUFFER ADDRESS and length,
; which is only an identity while that buffer is LIVE — a freed buffer's
; address can come back on another String. That is why the cursor is armed by
; an explicit window (line_cursor_begin#/line_cursor_end#) around
; workspace_symbols_in_file#, where `source` is the parameter and therefore
; alive throughout: a String sharing its address inside that window IS that
; allocation. Outside the window the cursor is off and offset_to_pos# walks
; from 0 exactly as before, so every other caller is unaffected.
mutable lc_data: pointer[u8] linked
mutable lc_len: size_t linked
mutable lc_off: size_t linked
mutable lc_line: size_t linked
mutable lc_col: size_t linked
mutable lc_active: bool linked

define symbols
{
    procedure prof_reset() @deep true mutable prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked








    ; `SCALYLS_PROF=1` reports, per request, what the cross-file scans cost:
    ; how many directory listings were taken (each is a `find` through popen,
    ; i.e. a shell process), how many files were read and hashed, how many of
    ; those reads a cached listing/blob spared, and how much blob TEXT the
    ; signature lookups scanned. Measured on an inlayHint over
    ; packages/opensp/ContentState.scaly (2026-08-12), which is why the knob
    ; exists: find=2 read=170 fresh=6479 sigscan=4949 scanKB=128035 — the reads
    ; and the shell spawns are handled, and the 128 MB of blob scanning is not.
    procedure prof_dump() @deep true io reads prof_list linked


















    ; Build the documentSymbol result ARRAY from `source`. On a parse error
    ; the array is empty (the diagnostics path reports the error separately).
    procedure document_symbols(rp, mutable source: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked













































    ; One top-level declaration -> a symbol, or "" for declarations with no
    ; outline presence (use/package/empty). Every arm returns explicitly.
    procedure decl_symbol(rp, source: String, decl: DeclarationSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






























    ; A `private` declaration unwraps to its exported construct.
    procedure export_symbol(rp, source: String, export_: ExportSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
















    ; A function / procedure / operator: name from its target, no children.
    procedure routine_symbol(rp, source: String, target: TargetSyntax, start: size_t, end: size_t, kind: i64) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





    ; The declared name of a routine target (operator targets may be the
    ; anonymous index form `[]`).
    function target_name(rp, target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked








    ; A `define X` declaration. Kind + children depend on the concept:
    ;   Class -> Struct(23) with its members as children
    ;   Namespace -> Namespace(3) with its declarations as children
    ;   Union -> Enum(10) with its variants (+ body members) as children
    ;   Constant -> Constant(14); Delegate -> Function(12); Intrinsic -> Struct(23)
    procedure definition_symbol(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




























    ; Children of a class body: methods, constructors, nested definitions.
    procedure body_children(rp, source: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked








































    ; One member of a class/union body -> a symbol, or "" if it has no
    ; outline presence (empty, implement, trait, macro, module).
    procedure member_symbol(rp, source: String, member: MemberSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked


























    ; Children of a namespace: its nested declarations (reuses decl_symbol#).
    procedure namespace_children(rp, source: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




































    ; Children of a union: each variant as an EnumMember(22), then any body
    ; members (methods defined on the union).
    procedure union_children(rp, source: String, un: UnionSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
































































    ; ====================================================================
    ; Leaf builders
    ; ====================================================================

    procedure symbol_object(rp, source: String, name: String, kind: i64, start: size_t, end: size_t, children: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked



























    ; ====================================================================
    ; textDocument/selectionRange (lexical)
    ;
    ; Smart-expand (Shift+Alt+Right): from the token under the cursor outward
    ; through every enclosing bracket pair, ending at the whole file. The reply
    ; is a nest of {"range":R,"parent":{...}} with the INNERMOST range at the
    ; top, one chain per requested position.
    ;
    ; Lexical rather than parse-based on purpose: the editor asks for this while
    ; the buffer is being typed in, i.e. usually while it does not parse, and a
    ; bracket walk still answers. Comments and string literals are skipped, so a
    ; brace inside either opens no level.
    ; ====================================================================

    ; True for `(`, `[`, `{`.
    function is_open_bracket(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; True for `)`, `]`, `}`.
    function is_close_bracket(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; The offset just PAST the bracket matching the one at `open_pos` (an
    ; exclusive end), or `len` when it is unbalanced. Counts every bracket kind
    ; together, which is right for balanced source and cannot mis-nest here:
    ; the walk that produced `open_pos` counted the same way.
    function matching_close(source: String, open_pos: size_t, len: size_t) @ret_nonlocal true @deep true returns size_t linked
























    ; {"range":R} — plus "parent" when `parent` is non-empty.
    procedure selection_object(rp, source: String, start: size_t, end: size_t, parent: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked















    ; The chain for ONE cursor offset, innermost first.
    procedure selection_chain(rp, source: String, off: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked









































































































    ; One chain per packed "<line> <char>" line; the LSP SelectionRange[].
    procedure selection_ranges_packed(rp, source: String, packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
















































    ; {"start":<pos>,"end":<pos>}
    procedure range_for(rp, source: String, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked












    ; Arm the line cursor for `source` — see the LINE CURSOR block at the top of
    ; this file for why the window is explicit. `source` must stay alive until
    ; line_cursor_end#, which is what makes the buffer address an identity.
    procedure line_cursor_begin(source: String) @deep true mutable lc_active, lc_col, lc_data, lc_len, lc_line, lc_off reads lc_data linked









    ; Disarm it. Every later offset_to_pos# walks from 0 again.
    procedure line_cursor_end() @deep true mutable lc_active, lc_data, lc_len reads lc_active linked






    ; True when the cursor is armed for exactly this source: same buffer
    ; address AND same length. Both halves are needed — the length alone would
    ; accept a different string, and the address alone is only meaningful while
    ; the buffer is live, which the window guarantees.
    procedure line_cursor_holds(source: String, src_len: size_t) @ret_nonlocal true @deep true returns bool reads lc_active linked











    ; The column of `lf` — the offset of an LF byte — i.e. the distance back to
    ; the byte after the previous LF. Bounded by one line's length, and reached
    ; only when a BACKWARD step crosses a line boundary.
    function line_cursor_column_before(text: Slice[u8], lf: size_t) @ret_nonlocal true @deep true returns size_t linked











    ; Move the armed cursor to `target`, in whichever direction it lies. The
    ; bytes are read through the buffer pointer rather than String.get#, which
    ; decodes the varint length prefix TWICE per byte.
    procedure line_cursor_seek(target: size_t) @deep true mutable lc_col, lc_line, lc_off reads lc_data linked



































    ; Byte offset -> {"line":L,"character":C}, both 0-based. ASCII columns
    ; (UTF-16 units == bytes for ASCII). Numeric LF compare (10), never "\n".
    ; Mirrors diagnostics.diag_object#'s offset walk.
    procedure offset_to_pos(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked













































    ; `"key":`
    function key(rp, k: Slice[char]) @direct true @ret_caller true @deep true returns String linked









    ; One LSP CodeLens over [offset, offset+width) of `source`:
    ;   {"range":{...},"command":{"title":<title>,"command":<id>[,"arguments":[<arg>]]}}
    ;
    ; It lives HERE, beside range_for#/key#, because all three lens families need
    ; it — scalyls.tasklens, scalyls.instlens and scalyls.codelens — and the
    ; alternative was a third copy or a `use` cycle between codelens and the
    ; families it composes.
    ;
    ; An EMPTY `command_id` renders the title as plain, non-clickable text (VS
    ; Code makes a span instead of a link) and suppresses the arguments; a
    ; non-empty one is invoked with `argument` as its single string parameter,
    ; which is all a JSON-RPC argument can carry.
    procedure lens_object(rp, source: String, offset: size_t, width: size_t, title: String, command_id: Slice[char], argument: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





























    ; ====================================================================
    ; textDocument/foldingRange (parse-only)
    ;
    ; Collapsible regions of the document: every multi-line declaration that
    ; has a body — top-level functions / procedures / operators, `define`
    ; classes / namespaces / unions (and their members recursively) — yields
    ; one LSP FoldingRange {"startLine":L,"endLine":L} (both 0-based). The
    ; result is the FLAT JSON array `[ <range>... ]` (FoldingRange[] is flat;
    ; ranges nest implicitly by line containment). The parent wraps it in a
    ; Response envelope. Same parse-tree walk as documentSymbol/completion,
    ; flattened into comma-joined fragments (callers join non-empty fragments
    ; with one comma). Single-line declarations produce "" and are dropped.
    ;
    ; END-OFFSET NOTE: a syntax node's `end` runs to the START of the next
    ; token (trailing trivia included), so converting it straight to a line
    ; would over-fold past the closing `}` into the blank line / next decl.
    ; fold_range# backs `end` up over trailing whitespace (last_real_offset)
    ; so endLine lands on the closing-brace line. Statement-level folds
    ; (if/while bodies) are NOT emitted — the walk stops at routine bodies.
    ; ====================================================================

    ; ====================================================================
    ; textDocument/codeAction — the `use` quick fix (lexical)
    ;
    ; The planner already knows the answer and writes it into the diagnostic:
    ;   function not found: Widget - defined in demo.widgets but not visible
    ;   here; add: use demo.widgets.Widget
    ; The client hands that diagnostic straight back in the codeAction request,
    ; so this needs no analysis at all — only the INSERT POSITION, which is a
    ; line scan. `packed` is the newline-separated list of use paths the parent
    ; lifted out of the diagnostics (see server.use_paths_from_diagnostics#).
    ;
    ; Deliberately NOT re-derived here: recomputing which name is invisible
    ; would mean running the planner a second time to answer a question it has
    ; already answered, and the two answers could then disagree.
    ; ====================================================================

    ; The line a new `use` belongs on: after the last NON-BLANK line of the
    ; file's leading run of comments, `package` declarations and `use` lines —
    ; that is, at the bottom of the header, before the first real declaration.
    ; Returns a 0-based LINE number; the edit inserts a whole line there.
    ;
    ; A blank line neither moves the point nor ends the run. That is what puts
    ; the new line at the bottom of the header block instead of below the blank
    ; that separates the header from `define`, and it is why every real file in
    ; this tree — which opens with a `;` header comment — gets its `use` in the
    ; right place. The first draft moved the point on `use` and `package` only,
    ; so a commented file (i.e. all of them) had the line inserted at the very
    ; top, ABOVE its own header.
    function use_insert_line(source: String) @ret_nonlocal true @deep true returns size_t linked














































    ; True when source[t,end) begins with `word` (a plain byte compare).
    function line_starts_with(source: String, t: size_t, end: size_t, word: String) @ret_nonlocal true @deep true returns bool linked














    ; ====================================================================
    ; textDocument/codeAction — the quick fixes
    ;
    ; EVERY FIX IS READ OFF THE DIAGNOSTIC'S OWN MESSAGE, never recomputed. The
    ; planner has already decided what is wrong and said so; asking it again
    ; would be a second answer to a settled question, and the two would drift.
    ; What the buffer is used for is the EDIT — the text a fix has to produce —
    ; not the judgement.
    ;
    ; ★THE MESSAGES ARE THE INTERFACE, and it is an unchecked one: each marker
    ; below is a substring of a string literal in Planner.scaly, and a reworded
    ; diagnostic silently turns its fix off. That is why the gate asserts the
    ; whole round trip — compiler diagnostic through the server to the edit —
    ; rather than these functions alone. A fix that stops firing is invisible
    ; otherwise: an empty action list is what the editor gets on every ordinary
    ; cursor position anyway.
    ;
    ; ★A FIX IS OFFERED ONLY WHEN IT NEEDS NO GUESS. Each one below refuses on
    ; the shapes it cannot rewrite exactly (a second `=` on the line, a comment
    ; that would be swallowed into the parens, a name the cursor does not sit
    ; on) — a quick fix is applied without being read, so a plausible-looking
    ; wrong edit is worse than no fix at all.
    ; ====================================================================

    ; The comma-joined CodeAction fragments for every diagnostic in `packed`
    ; (one `<line> <character> <message>` per line), wrapped in the array.
    function code_actions_packed(rp, source: String, uri: String, packed: String) @direct true @ret_caller true @deep true returns String linked

































    ; The fixes for ONE packed diagnostic, comma-joined (no brackets), or "".
    function code_actions_for(rp, source: String, uri: String, entry: String) @direct true @ret_caller true @deep true returns String linked




































    ; True when the message describes a statement whose parenless call head
    ; swallowed the chain that was meant to be its argument.
    ;
    ; TWO WORDINGS reach here, because the collapse ends in two different
    ; places. When it leaves no name behind, the planner says so outright. When
    ; it leaves one, the message is about a discarded operator — and the
    ; operator NAME settles it soundly rather than by guess: an operator in this
    ; language consists EXCLUSIVELY of the eleven operator characters, the four
    ; word operators being the only exceptions. So an alphanumeric name that is
    ; none of those is not an operator at all, it is the callee the head
    ; swallowed. `print helper(2)` reports operator `helper` and is this; `a + b`
    ; keeps its symbolic name and is left alone, because parenthesizing a real
    ; dead expression would produce nonsense.
    function swallowed_call_head(message: String) @ret_nonlocal true @deep true returns bool linked










































    ; ---- fix: `a = b` -> `set a: b` ------------------------------------
    ;
    ; The whole line is replaced, indentation preserved. A trailing comment
    ; rides along at the end, where it still belongs.
    function set_code_action(rp, source: String, uri: String, line: size_t) @direct true @ret_caller true @deep true returns String linked
































    ; The offset of the ONE `=` in [from, to) that is an operator on its own,
    ; or `to` when the line has none or more than one.
    ;
    ; An `=` adjacent to another operator character belongs to a different
    ; operator (`<=`, `>=`, `<>` is not one but `==` is), and a line with two of
    ; them — `if a = b: c = d` — cannot be rewritten without deciding which
    ; comparison the author meant. Both refuse.
    function sole_equals(source: String, from: size_t, to: size_t) @ret_nonlocal true @deep true returns size_t linked



































    ; ---- fix: `f x.m()` -> `f(x.m())` ----------------------------------
    ;
    ; The head is everything up to the first space, the argument everything
    ; after it. A line carrying a `;` is refused: the comment would end up
    ; INSIDE the parentheses, which compiles and means something else.
    function paren_code_action(rp, source: String, uri: String, line: size_t) @direct true @ret_caller true @deep true returns String linked


































    ; ---- fix: a misspelled name -> the nearest one in the file ---------
    ;
    ; For `unknown identifier: N`, `unknown type: N` and `unknown assignment
    ; target: N`. Candidates are the identifiers that OCCUR IN THE BUFFER —
    ; which is where the intended name is: a local, a parameter, a field or a
    ; declaration, all of them written correctly somewhere else in the file. A
    ; walk over the declarations alone would miss precisely the locals, which is
    ; what most typos are.
    ;
    ; ★THE SPAN COMES FROM THE LINE, NOT FROM THE DIAGNOSTIC'S COLUMN, and that
    ; is a measurement rather than a preference: of the three messages this
    ; handles, only one points AT the name. `unknown assignment target: countre`
    ; is reported at the `set` that begins the statement, and an unknown
    ; ARGUMENT at the callee's opening paren — a first version keyed on
    ; identifier_at# therefore offered nothing for either, and would have
    ; rewritten the wrong word had it not checked.
    ;
    ; So the anchor is the diagnostic's LINE, and the name must occur on it
    ; EXACTLY ONCE as a whole identifier. That is still exact: with two
    ; occurrences there is no way to tell which one the planner meant, and the
    ; fix is refused rather than guessed.
    function spelling_code_actions(rp, source: String, uri: String, line: size_t, character: size_t, message: String) @direct true @ret_caller true @deep true returns String linked
















































    ; The offset of the ONE occurrence of `word` as a whole identifier in
    ; [from, to), or `to` when there is none or more than one.
    function sole_word_occurrence(source: String, from: size_t, to: size_t, word: String) @ret_nonlocal true @deep true returns size_t linked














































    ; The name a `unknown ...: N` message reports, or "". The name ends at the
    ; first space, because a visibility hint may follow it.
    function unknown_name_in(rp, message: String) @direct true @ret_caller true @deep true returns String linked















    ; True when `s` begins with `prefix`.
    function starts_with_str(s: String, prefix: String) @ret_nonlocal true @deep true returns bool linked














    ; Up to three identifiers of the buffer nearest to `name`, one per line,
    ; closest first. "" when nothing is near enough.
    ;
    ; NEAR ENOUGH is deliberately tight — one edit for a short name, two from
    ; five bytes up. A quick fix is applied without being read; offering the
    ; wrong name is worse than offering none.
    function spelling_candidates(rp, source: String, name: String) @direct true @ret_caller true @deep true returns String linked

















    ; Append every buffer identifier whose distance from `name` is exactly `d`,
    ; skipping duplicates and stopping at three in total.
    procedure append_candidates_at(mutable sb: ref[StringBuilder], mutable count: ref[size_t], source: String, name: String, d: size_t) @deep true linked












































    ; The offset past a comment or a string literal starting at `i`, else `i`.
    function skip_non_code(source: String, i: size_t) @ret_nonlocal true @deep true returns size_t linked





























































    ; True when the LF-separated `list` already holds `word`.
    function list_contains(list: String, word: String) @ret_nonlocal true @deep true returns bool linked


































    ; Levenshtein distance between `a` and `b`, answering `cap + 1` as soon as
    ; the answer cannot be `cap` or less. Two fixed rows, so a name of 64 bytes
    ; or more is simply not a candidate — no name in this tree comes close, and
    ; a heap row per identifier of the buffer would not be worth it.
    function edit_distance(a: String, b: String, cap: size_t) @ret_nonlocal true @deep true returns size_t linked




























































    ; ---- shared builders ------------------------------------------------

    ; A quickfix CodeAction with one TextEdit. An EMPTY range (start = end) is
    ; LSP's spelling of an insertion — it replaces nothing.
    function edit_code_action(rp, uri: String, title: String, preferred: bool, start_line: size_t, start_char: size_t, end_line: size_t, end_char: size_t, new_text: String) @direct true @ret_caller true @deep true returns String linked










































    ; {"line":L,"character":C}
    function position_object(rp, line: size_t, character: size_t) @direct true @ret_caller true @deep true returns String linked












    ; The `use <path>` insertion at line `at`, column 0.
    function use_code_action(rp, uri: String, path: String, at: size_t) @direct true @ret_caller true @deep true returns String linked












    ; The offset of the LF ending the line that starts at `ls` (or the length).
    function line_end(source: String, ls: size_t) @ret_nonlocal true @deep true returns size_t linked













    ; The offset of the first `b` in [from, to), else `to`.
    function index_of_byte(source: String, from: size_t, to: size_t, b: u8) @ret_nonlocal true @deep true returns size_t linked











    ; The offset of `needle` in `hay`, or hay's length when absent.
    function find_substring(hay: String, needle: String) @ret_nonlocal true @deep true returns size_t linked




























    ; The decimal number in [from, to), or 0.
    function parse_uint(s: String, from: size_t, to: size_t) @ret_nonlocal true @deep true returns size_t linked
















    ; Bytes [from, to) with leading and trailing spaces and tabs removed.
    function trimmed(rp, source: String, from: size_t, to: size_t) @direct true @ret_caller true @deep true returns String linked













    procedure folding_ranges(rp, mutable source: String) @direct true @ret_caller true @deep true returns String linked













































    ; One top-level declaration -> a fragment (its own range, plus the bodies
    ; of a definition's members). "" for use/package/empty/trait/macro/mutable.
    function fold_decl(rp, source: String, decl: DeclarationSyntax) @direct true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function fold_export(rp, source: String, export_: ExportSyntax) @direct true @deep true returns String linked
















    ; A `define X` -> its own range followed by its members' ranges.
    function fold_definition(rp, source: String, def: DefinitionSyntax) @direct true @deep true returns String linked
















    ; Members of a class body -> a comma-joined fragment (no brackets).
    function fold_body(rp, source: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String linked






































    ; One class/union member -> its range, "", or a nested definition fragment.
    function fold_member(rp, source: String, member: MemberSyntax) @direct true @deep true returns String linked


























    ; Nested declarations of a namespace -> a comma-joined fragment.
    function fold_namespace(rp, source: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String linked


































    ; Body members of a union -> a comma-joined fragment. Variants are
    ; single-line and never fold, so only the union's methods contribute.
    function fold_union(rp, source: String, un: UnionSyntax) @direct true @ret_caller true @deep true returns String linked






































    ; A FoldingRange {"startLine":L,"endLine":L}, or "" for a single-line
    ; (non-foldable) declaration. `end` is backed up over trailing whitespace
    ; so endLine is the closing-brace line, not the next token's line.
    function fold_range(rp, source: String, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String linked

















    ; Join two comma-joined fragments with a comma, dropping empties.
    function join_two(rp, a: String, b: String) @direct true @deep true returns String linked
























    ; 0-based line number of a byte offset (count LFs before it). Mirrors
    ; offset_to_pos#'s line walk; numeric LF compare (10), never "\n".
    function line_at(source: String, offset: size_t) @ret_nonlocal true @deep true returns size_t linked

















    ; Back `end` up over trailing whitespace so it points just past the last
    ; real character (the closing `}`), not into the next token's leading trivia.
    function last_real_offset(source: String, end: size_t) @ret_nonlocal true @deep true returns size_t linked















    ; ASCII whitespace: space, tab, LF, CR.
    function is_ws_byte(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; ====================================================================
    ; textDocument/semanticTokens/full (lexical)
    ;
    ; A single raw byte scan classifies every token into the legend below and
    ; emits the LSP delta-encoded `data` array. Legend (token-type indices):
    ;   0 keyword  1 type  2 function  3 variable  4 operator  5 string
    ;   6 number   7 comment
    ; No modifiers. Classification is LEXICAL (no parser): keywords via the
    ; parser's keyword set; the identifier right after `function`/`procedure`
    ; -> function, after `define`/`union`/`trait`/`module` -> type; any other
    ; identifier -> type if it starts uppercase, else variable. Operators are
    ; runs of + - * / = % & | ^ ~ < > (mirrors lexer scan_operator); strings
    ; are " " / ' ' / ` ` ; numbers start with a digit; comments are `;` to EOL
    ; and `;* ... *;` (split into one token per line — LSP tokens are
    ; single-line). The result is {"data":[...]}; the server wraps it in a
    ; Response (the data array can be large -> byte-at-a-time wrapper).
    ;
    ; ENCODING: each token is 5 ints [dLine, dStartChar, length, type, 0],
    ; delta-encoded against the previous token (dStartChar absolute when
    ; dLine>0). All JSON uses quote BYTES (0x22) — string-literal escapes are
    ; NOT decoded by the lexer, so a `\"` in a literal would land raw.
    ; ====================================================================

    procedure semantic_tokens(rp, mutable source: String, mutable uri: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked


























































































































































































































































































































































































































































































    ; One delta-encoded semantic token with no modifiers.
    function encode_token(rp, prev_line: size_t, prev_col: size_t, tline: size_t, tcol: size_t, tlen: size_t, ttype: i64) @direct true @ret_caller true @deep true returns String linked


    ; One delta-encoded semantic token: "dLine,dStartChar,length,type,mods".
    ; `mods` is a BITSET over the legend in server.initialize_response#:
    ;   1 declaration   2 readonly   4 static   8 defaultLibrary
    function encode_token_mods(rp, prev_line: size_t, prev_col: size_t, tline: size_t, tcol: size_t, tlen: size_t, ttype: i64, mods: i64) @direct true @ret_caller true @deep true returns String linked


















    ; ---- semantic token MODIFIERS --------------------------------------
    ;
    ; The classification above is lexical, and so is this. What each one means:
    ;
    ;   declaration  the identifier directly after the keyword that declares it,
    ;                or a field at its declaration offset. EXACT: the keyword
    ;                immediately precedes the name.
    ;   readonly     a `let` binding — at its declaration AND at its uses inside
    ;                the enclosing routine. This is the one that earns the
    ;                feature in Scaly, where `let` versus `var` is the whole
    ;                mutability story and nothing in the source repeats it at the
    ;                use site.
    ;   static       a module-level `mutable` / `shared` global, declaration and
    ;                uses. LSP has no `global`; `static` is the conventional
    ;                mapping and the one themes style.
    ;   defaultLibrary  a name that comes from the PACKAGE dependency tree.
    ;
    ; ★THE `readonly` SET IS SCOPED LEXICALLY, and its limit is written here
    ; rather than discovered later: names are collected per ROUTINE (the set is
    ; cleared at every `function` / `procedure` / `operator` / `init` / `deinit`
    ; keyword) and a `var` of the same name removes it again, but a `let` inside
    ; an inner BLOCK stays in the set after that block ends. So an outer `var x`
    ; used after an inner `let x` is coloured readonly although it is not. It
    ; costs a colour, not an answer, and the alternative — a scope-accurate set —
    ; means walking statement bodies, which this scan deliberately does not do
    ; (the editor asks for tokens while the buffer does not parse).

    ; The module-level `mutable` / `shared` names of the file, LF-separated.
    ; A pre-pass, because a use can precede the declaration.
    function global_name_list(rp, source: String) @direct true @ret_caller true @deep true returns String linked
























































    ; `list` plus `word`, unless it is already there.
    function name_list_add(rp, list: String, word: String) @direct true @deep true returns String linked










    ; `list` without `word`.
    function name_list_remove(rp, list: String, word: String) @direct true @deep true returns String linked



























    function is_letter(c: u8) @ret_nonlocal true @deep true returns bool linked






    function is_upper(c: u8) @ret_nonlocal true @deep true returns bool linked






    function is_digit(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; Bytes that continue a numeric literal: digits, hex letters, x/X, ., _.
    function is_num_byte(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; Quote bytes that open a string: " (34), ' (39), ` (96).
    function is_string_start(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; ----- semanticTokens: declared-name resolution -----
    ; The lexical scan colours by shape; these let it colour by MEANING — an
    ; identifier USE gets its declared kind (a function call -> function, a
    ; type reference -> type), which a regex/shape pass cannot do. The declared
    ; names are harvested by REUSING completion_items# (which already classifies
    ; every declared name by CompletionItemKind), so no walk is duplicated.

    ; Extract a newline-delimited, newline-bracketed list of the labels in a
    ; completion-items JSON array whose kind is k1 or k2. ("\nadd\nfoo\n")
    procedure names_from_items(rp, mutable items_json: String, k1: i64, k2: i64) @direct true @ret_caller true @deep true returns String linked

























    ; The lowercase primitive/builtin type names (uppercase types are caught
    ; lexically). Newline-bracketed, like names_from_items#. Built with byte
    ; appends (string-literal escapes are not decoded, so no "\n" literals).
    function primitive_type_list(rp) @direct true @ret_caller true @deep true returns String linked








































    ; Byte-equality of a[astart,astart+len) and b[bstart,bstart+len).
    function range_equals(a: String, astart: size_t, b: String, bstart: size_t, len: size_t) @ret_nonlocal true @deep true returns bool linked













    ; ----- semanticTokens: scope-aware parameters + declared fields -----
    ; These refine the declared-NAME resolution (which is file-global, like
    ; fn_list/ty_list) with two POSITION-aware classes that a name set cannot
    ; express:
    ;   - parameter: an identifier inside the routine whose parameter list
    ;     names it (scope-aware — `x` only colours inside its own routine).
    ;   - property (declaration): a field/property NAME at its declaration
    ;     site in a `define X (fields)` structure.
    ; Both come from ONE parse via `scope_table#`, which returns a blob of
    ; TAB/LF-delimited tagged records (no aggregate-through-param mutation —
    ; each walker RETURNS a record fragment, mirroring names_from_items#):
    ;   "P" <TAB> start <TAB> end <TAB> "name1 name2 ..." <LF>   (routine scope)
    ;   "F" <TAB> offset <LF>                                    (field decl)
    ; semantic_tokens# builds the table once, then `param_in_scope` /
    ; `is_field_decl_offset` query it per identifier token. The after-dot
    ; property case needs no table (it tracks the previous emitted token).

    ; First letter byte at or after `from` (the real name token start; a
    ; PartSyntax/PropertySyntax `start` is `previous_position`, just before the
    ; name, so trailing trivia / a leading `(`/`,` precede the letter).
    function name_offset_at(source: String, from: size_t) @ret_nonlocal true @deep true returns size_t linked












    ; The parameter names of a parameter set, space-joined (with a trailing
    ; space). A leading `this` receiver is dropped (it is never written as an
    ; argument). A bare-type parameter set carries no names.
    function params_set_names(rp, parameters: ref[ParameterSetSyntax]?) @direct true @ret_caller true @deep true returns String linked















































    ; One routine-scope record "P\t<start>\t<end>\t<names>\n", or "" when the
    ; routine has no (non-this) parameters.
    function param_record(rp, start: size_t, end: size_t, names: String) @direct true @ret_caller true @deep true returns String linked























    ; One routine-range record "R\t<start>\t<end>\n", emitted for EVERY routine
    ; (function/procedure/operator/init/method) regardless of whether it has
    ; parameters, so the enclosing-routine lookup (scope-aware references/rename)
    ; can find the routine containing any cursor. param_in_scope /
    ; is_field_decl_offset both skip unknown tags, so adding R is safe for them.
    function r_record(rp, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String linked











    ; One field-declaration record "F\t<offset>\n".
    function f_record(rp, off: size_t) @direct true @ret_caller true @deep true returns String linked









    ; The scope record for a routine target (named -> its routine; an anonymous
    ; routine target has no name to scope but its params still apply).
    function st_target(rp, source: String, start: size_t, end: size_t, target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked











    ; The scope record for an init (its `page`/explicit params are colourable).
    function st_init(rp, source: String, start: size_t, end: size_t, parameters: ref[ParameterSetSyntax]?) @direct true @ret_caller true @deep true returns String linked







    ; One structure part -> its field-declaration record (verified against the
    ; declared name so a stray non-name byte never produces a bogus offset).
    function field_record(rp, source: String, part: PartSyntax) @direct true @ret_caller true @deep true returns String linked





















    ; Top-level declaration -> its scope/field records (concatenated, each
    ; newline-terminated, so plain concatenation needs no separator).
    function st_decl(rp, source: String, decl: DeclarationSyntax) @direct true @ret_caller true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function st_export(rp, source: String, export_: ExportSyntax) @direct true @ret_caller true @deep true returns String linked
















    ; A `define X` -> field records (class structure) + member scope records.
    function st_definition(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String linked
















    ; Class: field declarations from the structure parts, then body members.
    function st_class(rp, source: String, c: ClassSyntax) @direct true @ret_caller true @deep true returns String linked




































    ; Members of a class/union body -> concatenated scope/field records.
    function st_body(rp, source: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String linked































    ; One class/union member -> its scope/field records.
    function st_member(rp, source: String, member: MemberSyntax) @direct true @ret_caller true @deep true returns String linked


























    ; Nested declarations of a namespace -> concatenated records.
    function st_namespace(rp, source: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String linked



























    ; A union -> its body members' records (variants carry no params/fields).
    function st_union(rp, source: String, un: UnionSyntax) @direct true @ret_caller true @deep true returns String linked







    ; Build the whole scope/field table from one parse of the program.
    procedure scope_table(rp, mutable source: String) @direct true @ret_caller true @deep true returns String linked


































    ; True when the token source[tstart,tend) names a parameter of the INNERMOST
    ; routine whose [start,end) byte range contains `offset`. Innermost = the
    ; containing P record with the greatest start (nested routines start later).
    function param_in_scope(table: String, source: String, tstart: size_t, tend: size_t, offset: size_t) @ret_nonlocal true @deep true returns bool linked

































































































    ; The innermost routine [start,end) whose range contains `offset`, packed as
    ; "<start> <end>", or "" when the offset is in no routine. Innermost = the R
    ; record with the greatest start among those containing the offset (a nested
    ; routine starts later than its enclosing one). Used by the scope-aware
    ; references/rename/highlight scan to confine a local/parameter to its
    ; declaring routine.
    function enclosing_routine(rp, table: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked





































































    ; True when `off` is the start offset of a declared field/property name.
    function is_field_decl_offset(table: String, off: size_t) @ret_nonlocal true @deep true returns bool linked



































    ; ====================================================================
    ; textDocument/completion (parse-only)
    ;
    ; Collect every declared name in the file — top-level functions /
    ; procedures / operators / types / mutables, plus the members of structs,
    ; namespaces and unions — into a flat LSP CompletionItem[] array. The
    ; editor does the prefix filtering, so the cursor position is not used (a
    ; future member-after-`.` mode would need type resolution). The result is
    ; the bare JSON array `[ <item>... ]`; the server wraps it in a Response.
    ;
    ; Each <item>: {"label":<name>,"kind":<int>}. LSP CompletionItemKind ints
    ; (DISTINCT from documentSymbol's SymbolKind ints):
    ;   Method=2 Function=3 Constructor=4 Variable=6 Module=9 Enum=13
    ;   EnumMember=20 Constant=21 Struct=22 Operator=24
    ;
    ; Same parse-tree walk as documentSymbol, but flattened: each helper
    ; returns a COMMA-JOINED FRAGMENT of items (no surrounding brackets, no
    ; leading/trailing comma), and callers join non-empty fragments with a
    ; single comma. Items are small, but the whole array can be large (a big
    ; file has hundreds of names), so fragments are appended ONE BYTE AT A TIME
    ; — the same large-append hazard documented in the STRING/JSON NOTE.
    ; ====================================================================

    procedure completion_items(rp, mutable source: String) @direct true @ret_caller true @deep true returns String linked













































    ; A {"label":<name>,"kind":<int>} item. Small -> plain append is fine.
    function completion_item(rp, name: String, kind: i64) @direct true @ret_caller true @deep true returns String linked




    ; The same item plus LSP's `detail` — the grey text the editor shows beside
    ; the label and in the details pane. An empty `detail` is OMITTED rather
    ; than sent as "", so an item without one looks exactly as it did before.
    ;
    ; What goes in there: for a routine the signature minus its name (the label
    ; already carries that), for a field or a typed binding its type. The point
    ; is that a completion list of bare names cannot be read — `append` says
    ; nothing about whether it takes a String, a char or an int, and Scaly
    ; overloads that name six ways.
    function completion_item_detail(rp, name: String, kind: i64, detail: String) @direct true @ret_caller true @deep true returns String linked


















    ; A routine's completion detail: `function(p: T) returns R`. The routine WORD
    ; is kept because the CompletionItemKind icon cannot tell a `function` from a
    ; `procedure`, and in Scaly that distinction is the difference between a pure
    ; call and one that may mutate its inputs or do I/O — exactly what a reader
    ; needs before picking an entry. The NAME is dropped: it is the label.
    ;
    ; A leading `this` is dropped, unlike in hover's routine_signature_text#: a
    ; hover renders the DECLARATION, so it says what the line says, while an
    ; accepted completion is about to be WRITTEN as a call, where the receiver
    ; stands before the dot. Counting it here would also disagree with the
    ; SignatureHelp that pops up one keystroke later (signature_param_labels#
    ; drops it for the same reason), and two surfaces disagreeing about the
    ; arity of the same call is worse than either answer alone.
    function routine_detail_text(rp, source: String, kind: Slice[char], routine: RoutineSyntax) @direct true @ret_caller true @deep true returns String linked
























    ; `(p: T, q: U)` as parameter_set_text#, but WITHOUT a leading `this` — the
    ; call-site view of the same parameter list. Same receiver test as
    ; signature_param_labels#, so completion detail and SignatureHelp agree.
    function call_parameter_set_text(rp, source: String, parameters: ref[ParameterSetSyntax]?) @direct true @ret_caller true @deep true returns String linked


















































    ; The same, reached through a TargetSyntax (a named routine or a bare one).
    function target_detail_text(rp, source: String, kind: Slice[char], target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked








    ; A binding's declared type, or "" when it has none (`var i 0` — the type is
    ; inferred and the parse tree cannot name it; that is the planner's answer,
    ; and completion is deliberately parse-only).
    function binding_detail_text(rp, source: String, binding: BindingSyntax) @direct true @ret_caller true @deep true returns String linked













    ; One top-level declaration -> a fragment (its own item, plus the members
    ; of a definition). "" for use/package/empty/trait/macro.
    function completion_decl(rp, source: String, decl: DeclarationSyntax) @direct true @ret_caller true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function completion_export(rp, source: String, export_: ExportSyntax) @direct true @ret_caller true @deep true returns String linked
















    ; A `define X` -> the type's name item followed by its members' items.
    function completion_definition(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String linked

















































    ; Members of a class body -> a comma-joined fragment (no brackets).
    function completion_body(rp, source: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String linked






































    ; A class -> its FIELDS (CompletionItemKind Field=5), in declaration order,
    ; followed by its body members. The fields used to be missing entirely:
    ; `Point.` offered `get_x` and not `x`, so no completion could ever name a
    ; field — which after `this.` is the first thing you reach for.
    function completion_class(rp, source: String, c: ClassSyntax) @direct true @ret_caller true @deep true returns String linked














    ; The `(a: int  b: T)` part of a class -> comma-joined Field items.
    function completion_structure(rp, source: String, structure: StructureSyntax) @direct true @ret_caller true @deep true returns String linked




























    ; The `start` of one structure part. It is `previous_position`, i.e. the end
    ; of the `(` or of the part before it — NOT the name token; name_offset_at#
    ; is what turns it into the first letter of the declaration.
    function part_start(rp, part: PartSyntax) @ret_param_0 true @deep true returns size_t linked








    ; The declared name of one structure part.
    function part_name(rp, part: PartSyntax) @direct true @ret_caller true @deep true returns String linked








    ; A field's declared type, for its completion `detail`. Unlike a binding's,
    ; a property's annotation is not optional — a field always names its type.
    function part_detail_text(rp, source: String, part: PartSyntax) @direct true @ret_caller true @deep true returns String linked








    ; Append `fragment` to `sb` ONE BYTE AT A TIME — see the STRING/JSON NOTE at
    ; the top of this file: a single StringBuilder.append(String) that more than
    ; doubles the buffer takes Array.add's manual-grow path, which SIGSEGVs past
    ; one exclusive page, and a member list is exactly a potentially-large piece.
    procedure append_fragment(mutable sb: ref[StringBuilder], fragment: String) @deep true linked










    ; One class/union member -> an item, or "" / a nested fragment.
    function completion_member(rp, source: String, member: MemberSyntax) @direct true @ret_caller true @deep true returns String linked


























    ; Nested declarations of a namespace -> a comma-joined fragment.
    function completion_namespace(rp, source: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String linked


































    ; Variants (EnumMember) + body members of a union -> a comma-joined
    ; fragment.
    function completion_union(rp, source: String, un: UnionSyntax) @direct true @ret_caller true @deep true returns String linked






























































    ; ====================================================================
    ; completionItem/resolve — the `data` round-trip and the doc block
    ;
    ; The `;` block above a declaration is the most valuable thing a completion
    ; entry could carry: in this tree it holds the reasoning the signature
    ; cannot, which is why hover shows it (with_doc#). Sending it with every
    ; entry is what makes that expensive — a flat list here has HUNDREDS of them
    ; (379 for scalyls/symbols.scaly, measured), and a member list read from
    ; another file would ship that file's comments on every keystroke. LSP's
    ; resolve is the seam that makes it payable: the client asks for the ONE
    ; entry it has selected, and only then is the block read.
    ;
    ; The round trip needs an identity for the entry, and LSP offers exactly one
    ; field for it: `data`, which the client hands back untouched. Here it is
    ; the URI OF THE FILE THE ENTRY WAS READ FROM — which is NOT the document
    ; the completion was requested in whenever the receiver's concept lives
    ; elsewhere (`String.` resolves into packages/scaly). The label carries the
    ; name, so the file is the only other thing resolve needs.
    ;
    ; ★★★RESOLVE NEVER WALKS THE WORKSPACE, and that is what `data` buys.
    ; Measured on this tree before this was built, one warm session, the
    ; scalyls package: a cross-PACKAGE definition — the search a resolve would
    ; have to run if it only knew the name — costs 7.93 s, a cross-file one
    ; 1.12 s cold, against 0.03 s for a lookup that stays inside a known file.
    ; resolve fires while the user ARROWS THROUGH THE LIST, and a request that
    ; overruns its budget kills the worker and takes the symindex with it
    ; (WORKSPACE_TIMEOUT_MS has the account), so a walking resolve would not be
    ; "a slow entry" — it would make every request after it cold. Naming the
    ; file in `data` reduces the whole feature to one parse of one file.
    ;
    ; ★The data is attached HERE, to the FINISHED ARRAY, rather than inside
    ; completion_item_detail#. Two reasons, and the first is the load-bearing
    ; one: every entry of ONE response comes from ONE file (member_completions_
    ; in_dir# stops at the first file declaring the concept), so the file is a
    ; property of the RESPONSE and not of the entry. And completion_items# has
    ; three other consumers — the semantic name tables and the nameset harvest —
    ; which read these items for labels and kinds; a field added at the leaf
    ; would grow into their input for no reason.
    ; ====================================================================

    ; `items` (a CompletionItem[] array) with `"data":<uri>` added to every
    ; entry. An empty `uri` leaves the array untouched.
    ;
    ; The scan tracks JSON string state (backslash escapes included) and brace
    ; depth, so a `}` inside a `detail` string cannot be mistaken for the end of
    ; an entry. Today no detail can contain one — a Scaly type or parameter name
    ; has no braces in it — but that is a fact about the current shape of a
    ; neighbouring function, and a scanner that depends on it would fail
    ; silently and much later.
    function with_item_data(rp, items: String, uri: String) @direct true @deep true returns String linked
























































    ; The `documentation` value for the entry named `name` declared in `source`
    ; (whose uri is `uri`): an LSP MarkupContent object, or "" when there is no
    ; doc block — the parent then answers the entry unchanged.
    ;
    ; FENCED, for hover's reason (see the doc-comment section): the value is
    ; markdown, consecutive lines REFLOW into one paragraph there, and these
    ; comments are hand-wrapped with aligned tables, bullet runs and ★ markers
    ; whose meaning is carried by the line structure. The signature is NOT
    ; repeated here — the entry's `detail` already carries it, and a client
    ; renders detail above documentation.
    procedure completion_documentation(rp, mutable source: String, mutable uri: String, mutable name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked























    ; The doc block above the declaration of `name` in `source`, or "".
    ;
    ; The declaration is located with find_definition#, the SAME walk
    ; textDocument/definition uses, and the block is then read with the same
    ; doc_comment# hover reads — so the documentation an entry resolves to is by
    ; construction the block above the declaration the editor would jump to.
    ; Its limit is that walk's own and is inherited rather than re-decided here:
    ; the FIRST declaration of the name in the file wins.
    procedure completion_doc_text(rp, mutable source: String, mutable uri: String, mutable name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






















    ; ====================================================================
    ; Context-aware completion (member-after-`.`, lexical)
    ;
    ; When a `.` precedes the cursor, offer ONLY the members of the receiver
    ; whose name immediately precedes the dot — but only when that name is a
    ; declared struct / namespace / union in this file (a LEXICAL match on the
    ; receiver token, not a type resolution of an arbitrary expression). So
    ; `Point.` / `json.` / `Shape.` complete to that concept's members; an
    ; unknown receiver (a variable like `sb.`, which needs the planner to type)
    ; or no dot at all falls back to the flat all-names list (completion_items#).
    ; The cursor arrives as a packed "<line> <char>" (same as hover).
    ; ====================================================================

    ; Decide member-context vs flat completion from the packed cursor position.
    ;
    ; TWO texts, and which one each lookup gets is load-bearing (see
    ; repaired_source#): `source` is the RAW buffer, the only place the receiver
    ; being typed exists, and every byte scan here reads it; `parse_source` is the
    ; repaired copy, and every lookup that PARSES reads that one, or a single
    ; unfinished line answers nothing at all. Blanking preserves length, so one
    ; cursor offset is valid in both.
    procedure completion_packed(rp, source: String, mutable parse_source: String, mutable uri: String, packed: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, modeler_error_count, prof_fresh, prof_list, prof_read reads prof_list linked
































































































































































    ; The flat all-names list of THIS document, tagged with its own uri so
    ; completionItem/resolve knows where to read the doc blocks from.
    procedure flat_items(rp, mutable parse_source: String, uri: String) @direct true @deep true returns String linked





    ; ====================================================================
    ; Parse repair for the read-only requests
    ;
    ; Every walk in this file starts with parse_program# and answers ""/"[]" on
    ; Error, so ONE unfinished line takes the WHOLE document down — and mid-edit
    ; is the normal state of a buffer, i.e. exactly when these are asked for.
    ; Measured 2026-08-12 with `        set this.` typed into a method body of
    ; opensp/ContentState.scaly: documentSymbol 0, foldingRange 0, inlayHint 0,
    ; and hover / definition / signatureHelp / completion all null — the hover and
    ; definition probes were on a HEALTHY line far from the edit. Only
    ; references / documentHighlight / semanticTokens survived, being byte scans.
    ;
    ; The repair blanks the line the parse error points at — its bytes become
    ; SPACES, so the length is preserved and every offset in the document still
    ; indexes the same byte (the walks, the syntax spans and position_to_offset#
    ; all agree with the caller's cursor) — and re-parses.
    ;
    ; It needs no cursor, because the error offset lands ON the offending line
    ; (measured: "expected identifier" at the typed line, character 12). That is
    ; what lets documentSymbol and foldingRange, which carry no position at all,
    ; be repaired by the same code.
    ;
    ; Bounded to TWO blanked lines: a repair is a guess, and a file broken in
    ; more places than that is more honestly answered by the empty result than by
    ; a document with its lines erased one by one.
    ;
    ; NOT for everyone: rename / prepareRename rewrite the real buffer, and semanticTokens
    ; is a lexer pass that already works — repairing it would blank a line's
    ; colours. And the completion path must keep the RAW buffer for its byte
    ; scans: the receiver it needs is the one being typed, on the very line this
    ; blanks, which is why completion_packed# takes both texts.
    ;
    ; DIAGNOSTICS use it too since 2026-08-12, but only for the SEMANTIC half:
    ; the reported parse error still comes from the raw buffer (it is the one
    ; fact about a broken buffer that needs no guess), and every planner
    ; diagnostic obtained from the repaired text must pass
    ; trust_repaired_diagnostic# below. See diagnostics.broken_buffer_
    ; diagnostics# for why a package member does not need the repair at all.
    ; ====================================================================

    ; `source` when it parses; else a copy with the offending line (or two)
    ; blanked out, if that parses; else `source` unchanged.
    procedure repaired_source(rp, mutable source: String) @direct true @ret_param_0 true @deep true returns String linked
















    ; The byte offset the parser stopped at, or a value PAST the end when the
    ; source parses. A `Different` error carries no offset — the construct was
    ; not recognised at all — and answers "no repair" rather than have
    ; blank_line_at# guess a line.
    procedure parse_error_offset(rp, mutable source: String) @deep true returns size_t linked

















    ; `source` with the bytes of the line containing `offset` replaced by spaces
    ; (the LF is kept). Length-preserving by construction — that is the whole
    ; point, see the note above.
    function blank_line_at(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked







































    ; Is a diagnostic produced from `repaired` safe to report against the buffer
    ; `original` it was repaired from?
    ;
    ; The repair BLANKS WHOLE LINES, so a diagnostic found in the repaired text
    ; can be a consequence of the blanking instead of a statement about the
    ; code: blank the line that declares a name and every use of it elsewhere
    ; reports `unknown identifier: N` — about a name that is right there on the
    ; reader's screen. A false diagnostic is worse than a missing one, so
    ; diagnostics.broken_buffer_report# asks this before it keeps one, and
    ; two classes are dropped:
    ;
    ;   * anything located ON a blanked line — it is a statement about spaces;
    ;   * anything whose message QUOTES a word that a blanked line carries. That
    ;     is exactly the shape of the class above, because every name-resolution
    ;     diagnostic names the name it could not find (`unknown identifier: N`,
    ;     `function not found: N`, `... not visible here`).
    ;
    ; ALSO REQUIRING the word to be GONE from the repaired text looks like an
    ; obvious refinement — "the repair cannot have deleted a name that is still
    ; there" — and it is WRONG, measured 2026-08-12: it re-admitted every case
    ; this exists for. Blank the line `function helper(` and `return helper()`
    ; four lines down keeps the word alive, so the refinement skipped the check
    ; and the invented `function not found: helper` came straight back. The name
    ; a blanked DECLARATION declares is by definition still present at its USE
    ; sites — which is where the false diagnostic is reported.
    ;
    ; The price is over-dropping: a real diagnostic about a name that merely also
    ; appears on the broken line is lost. That is the direction to err in, and
    ; the whole reason this function exists.
    ;
    ; Keywords and value words are skipped: they are not names, and `set`/`this`
    ; on a blanked line would otherwise suppress most of the file's messages
    ; (`cannot cast this value to i64` quotes `this` as a token).
    ;
    ; `original` and `repaired` have the SAME LENGTH by construction (the repair
    ; turns bytes into spaces, see blank_line_at#), so a byte position means the
    ; same thing in both texts and a blanked line is one carrying a differing
    ; byte. A length mismatch means this is not that repair, and nothing here can
    ; be attributed to it.
    function trust_repaired_diagnostic(rp, original: String, repaired: String, offset: size_t, message: String) @ret_nonlocal true @deep true returns bool linked




































































    ; The name of the innermost `define` whose [start,end) contains `offset`, or
    ; "" when the cursor is not inside one. Parse-only, like every other walk
    ; here; the innermost wins, so a nested define inside a namespace or a class
    ; body answers for its own body.
    procedure enclosing_concept_name(rp, mutable source: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked































    ; One top-level declaration: the enclosing concept's name, or "".
    function enclosing_concept_decl(rp, source: String, decl: DeclarationSyntax, offset: size_t) @direct true @ret_caller true @deep true returns String linked










    ; A `private` declaration unwraps to its exported construct.
    function enclosing_concept_export(rp, source: String, export_: ExportSyntax, offset: size_t) @direct true @ret_caller true @deep true returns String linked








    ; A `define X` containing `offset`: the name of the innermost nested define,
    ; else X itself. "" when the offset is outside it.
    function enclosing_concept_definition(rp, source: String, def: DefinitionSyntax, offset: size_t) @direct true @ret_caller true @deep true returns String linked




















    ; The innermost nested `define` of a class/union body, or "".
    function enclosing_concept_body(rp, source: String, body: ref[BodySyntax]?, offset: size_t) @direct true @ret_caller true @deep true returns String linked



























    ; One class/union member: only a nested `define` can be a concept.
    function enclosing_concept_member(rp, source: String, member: MemberSyntax, offset: size_t) @direct true @ret_caller true @deep true returns String linked








    ; The innermost nested `define` of a namespace, or "".
    function enclosing_concept_namespace(rp, source: String, ns: NamespaceSyntax, offset: size_t) @direct true @ret_caller true @deep true returns String linked























    ; Members of the concept named `type_name`: this file first, then sibling
    ; .scaly files under the current file's directory tree (cross-file). ""
    ; when no such concept is found anywhere.
    ;
    ; Both halves tag their entries with the file they were READ from (see the
    ; completionItem/resolve section): the local hit with this document's uri,
    ; the workspace hit with the uri of whichever file declared the concept —
    ; which is the whole point of tagging here rather than at the caller, since
    ; only this function knows which of the two answered.
    procedure members_for_type(rp, mutable source: String, mutable uri: String, type_name: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked







    ; Enumerate sibling .scaly files (skipping the current one) and return the
    ; members of the first concept named `type_name`, mirroring
    ; find_definition_in_workspace#: the current file's directory tree first,
    ; then ON A MISS the package dependency tree (so stdlib String/StringBuilder/
    ; Vector members complete). "" if none.
    procedure member_completions_in_workspace(rp, mutable uri: String, type_name: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked












    ; Enumerate the .scaly files under `dir` (recursively, skipping self_path)
    ; and return the members of the first concept named `type_name`. "" if none.
    ;
    ; Step 29 follow-up: query the persistent symindex instead of re-parsing each
    ; file with member_completions#. Each cached ws record carries an "M"-tagged
    ; detail field = the concept's bracketless member-completion fragment, so the
    ; member list is rebuilt from the cache (members_from_ws_blob#) — no re-parse,
    ; shared with workspace/symbol + cross-file definition + semanticTokens.
    procedure member_completions_in_dir(rp, mutable dir: String, self_path: String, type_name: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked





































    ; Lexically resolve the declared type name of the variable `receiver` (the
    ; base concept name, generics stripped). Recognises two declaration shapes,
    ; first occurrence in the file winning (no scope/shadow tracking):
    ;   - colon form:  `var receiver: TYPE` / `let receiver: TYPE` / param
    ;     `receiver: TYPE`  -> the identifier after the `:`.
    ;   - constructor form: `var receiver TYPE$(...)` / `let receiver TYPE(...)`
    ;     (a lifetime sigil $/#/^ or `[`/`(` right after TYPE) -> TYPE.
    ; "" when no such declaration is found (e.g. `let r compute(x)` with no
    ; sigil, or an undeclared name) -> caller falls back to the flat list.
    function resolve_variable_type(rp, source: String, receiver: String) @direct true @ret_caller true @deep true returns String linked












































    ; Given the receiver token ending at `recv_end` and its left context (the
    ; previous identifier token + last punctuation), return the declared type
    ; name, or "" when this isn't a declaration of the receiver.
    function type_after_decl(rp, source: String, recv_end: size_t, len: size_t, prev_start: size_t, prev_end: size_t, have_prev: size_t, prev_punct: size_t) @direct true @ret_caller true @deep true returns String linked


























































    ; First index at or after `pos` that is not a space or tab.
    function skip_ws(source: String, pos: size_t, len: size_t) @ret_nonlocal true @deep true returns size_t linked












    ; A constructor follows a type name when the next byte is a lifetime sigil
    ; ($ # ^) or a `[` (generics) / `(` (call). `(` is permissive: a false
    ; positive resolves a non-existent concept and harmlessly falls back.
    function is_ctor_sigil(c: u8) @ret_nonlocal true @deep true returns bool linked














    ; Read the leading identifier at `start` (stops at the first non-ident byte,
    ; so a generic `Vector[char]` yields the base `Vector`). "" if none.
    function read_type_name(rp, source: String, start: size_t, len: size_t) @direct true @ret_caller true @deep true returns String linked
















    ; ====================================================================
    ; Type-graph resolution (field-access chains + call-result return types)
    ;
    ; The single-identifier receiver resolver above (resolve_variable_type#)
    ; handles `v.` where `v` is a variable of a constructor/annotated type. The
    ; helpers below extend that to the cases it can't reach by following the
    ; declared types through the parse tree:
    ;   - field-access chains `a.b.c.` — resolve `a`'s type, look up field `b`'s
    ;     type in that concept, then field `c`'s type, and list `c`'s members.
    ;   - call results `let r foo(x); r.` — `foo` is a function, not a concept,
    ;     so use its declared RETURN type.
    ; This is genuine type resolution through the declared type graph (not full
    ; Hindley-Milner inference): a field/return type is taken as its base concept
    ; name. LIMITS: a generic / pointer / ref field type resolves to the wrapper
    ; base (`pointer`/`ref`/`Vector`), not the inner element type; intermediate
    ; method-CALLS in a chain (`a.f().b`) are not followed (the `(` stops the
    ; chain capture); first-declaration-wins, no scope/shadow/generic-substitution.
    ; ====================================================================

    ; The base concept name of a TypeSyntax (its NameSyntax base, generics and
    ; dotted extensions dropped) — e.g. `Vector` from `Vector[char]`.
    function type_base_name(rp, ty: TypeSyntax) @direct true @ret_caller true @deep true returns String linked





    ; The base name of a routine's declared return type, or "" when it returns
    ; nothing.
    function routine_return_base(rp, routine: RoutineSyntax) @direct true @ret_caller true @deep true returns String linked









    ; If `target` is a routine NAMED `name`, its return-type base name, else "".
    function target_return_type(rp, source: String, target: TargetSyntax, name: String) @direct true @ret_caller true @deep true returns String linked












    ; The type (base concept name) of member `member_name` of concept
    ; `type_name`, searching THIS source only: a field/property's declared type,
    ; or a method's return type. "" when the concept or member is not found here.
    procedure member_type(rp, mutable source: String, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked































    function mt_decl(rp, source: String, decl: DeclarationSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked










    function mt_export(rp, source: String, export_: ExportSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked








    ; The concept named `type_name`: look up `member_name` in its fields/methods.
    ; Otherwise recurse into a namespace's nested declarations.
    function mt_definition(rp, source: String, def: DefinitionSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked




















    function mt_namespace(rp, source: String, ns: NamespaceSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked























    ; Look up `member_name` in a class: its structure fields first, then its
    ; method bodies' return types. "" when absent.
    function mt_in_class(rp, source: String, c: ClassSyntax, member_name: String) @direct true @ret_caller true @deep true returns String linked















































    ; A field/property part named `member_name` -> its declared type base, "".
    function mt_part(rp, source: String, part: PartSyntax, member_name: String) @direct true @ret_caller true @deep true returns String linked
















    ; A class-body method named `member_name` -> its return-type base, "".
    function mt_member_return(rp, source: String, member: MemberSyntax, member_name: String) @direct true @ret_caller true @deep true returns String linked










    ; member_type# across the workspace: THIS source first, then the current
    ; file's directory tree, then the package tree (so stdlib field/method types
    ; resolve). "" when the concept/member is found nowhere.
    procedure member_type_ws(rp, mutable source: String, mutable uri: String, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked















    ; Step 33: read each sibling/package file's CACHED ws blob (symindex.valid →
    ; get_blob#, else workspace_symbols_in_file# + put) and resolve the member
    ; type from the concept record's 5th membertypes field via
    ; member_type_from_ws_blob# — no per-request, per-segment re-parse. Shared
    ; with workspace/symbol + def + sig + member-completion + type-hint +
    ; semanticTokens. Structured like return_type_in_dir#.
    procedure member_type_in_dir(rp, mutable dir: String, self_path: String, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked






























    ; The declared return-type base of a top-level (or namespace-nested)
    ; function/procedure named `fname`, searching THIS source only. "" when not
    ; found / no return type.
    procedure function_return_type(rp, mutable source: String, fname: String) @direct true @ret_caller true @deep true returns String linked































    function frt_decl(rp, source: String, decl: DeclarationSyntax, fname: String) @direct true @ret_caller true @deep true returns String linked














    function frt_export(rp, source: String, export_: ExportSyntax, fname: String) @direct true @ret_caller true @deep true returns String linked












    function frt_definition(rp, source: String, def: DefinitionSyntax, fname: String) @direct true @ret_caller true @deep true returns String linked





























    ; function_return_type# across the workspace: THIS source, then dir tree,
    ; then package tree. "" when found nowhere.
    procedure function_return_type_ws(rp, mutable source: String, mutable uri: String, fname: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked















    procedure function_return_type_in_dir(rp, mutable dir: String, self_path: String, fname: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked






























    ; True when `s` contains a `.` (a multi-segment receiver chain).
    function has_dot(s: String) @ret_nonlocal true @deep true returns bool linked












    ; The full dotted receiver chain `a.b.c` to the left of `offset`, skipping
    ; the in-progress member word the cursor sits in. "" when there is no
    ; `.`-qualified receiver. Walks left over identifier bytes and dots from the
    ; dot before the cursor; stops at the first other byte (so `f().b` captures
    ; only `b`). Leading dots are trimmed.
    function receiver_chain_before_cursor(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked






































    ; Resolve the type (base concept name) of a multi-segment receiver chain
    ; `a.b.c`: resolve `a`'s declared type, then follow each subsequent segment
    ; as a field/method of the running type. "" when any step fails to resolve.
    procedure resolve_chain_type(rp, mutable source: String, mutable uri: String, chain: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked









































    ; The identifier token immediately before a `.` to the left of `offset`,
    ; skipping any in-progress member word the cursor sits in. "" when there is
    ; no `.`-qualified receiver (so the caller offers the flat list). E.g. for
    ; `Point.ge|`, `Point.|`, or `Point .|` returns "Point"; for `foo|`, `a + b`,
    ; or `).` returns "".
    function receiver_before_cursor(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked













































    ; The byte offset of the LAST character of the `.`-receiver token before
    ; the cursor (the same token receiver_before_cursor# returns), or `len`
    ; (the source length, a sentinel) when there is no such receiver. Used to
    ; query the semantic resolver at a use of the receiver variable.
    function receiver_last_offset(rp, source: String, offset: size_t) @ret_nonlocal true @deep true returns size_t linked























    ; The base concept name of a possibly-qualified / generic type name:
    ; everything before the first `[` (generics) and after the last `.`
    ; (namespace). "scaly.containers.String" -> "String", "Vector[char]" ->
    ; "Vector". Used to look up the members of a semantically-resolved receiver.
    function simple_base_name(rp, name: String) @direct true @ret_caller true @deep true returns String linked





















    ; Parse the program and return the member CompletionItem[] of the concept
    ; named `receiver` (found at top level or nested in a namespace), or "" when
    ; no such concept exists. A found concept with no members yields "[]" (a
    ; non-empty string), distinguishing it from the not-found "".
    procedure member_completions(rp, mutable source: String, receiver: String) @direct true @ret_caller true @deep true returns String linked































    ; One top-level declaration: the members of `receiver` if this is (or
    ; nests) the matching definition, else "".
    function mem_decl(rp, source: String, decl: DeclarationSyntax, receiver: String) @direct true @ret_caller true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function mem_export(rp, source: String, export_: ExportSyntax, receiver: String) @direct true @ret_caller true @deep true returns String linked
















    ; A `define X`: when its name equals `receiver`, return its members wrapped
    ; as a JSON array (Class -> methods, Namespace -> declarations, Union ->
    ; variants + body). Otherwise recurse into a namespace's nested
    ; declarations for a nested match. "" when neither matches.
    function mem_definition(rp, source: String, def: DefinitionSyntax, receiver: String) @direct true @ret_caller true @deep true returns String linked


































    ; Nested declarations of a namespace: first nested definition named
    ; `receiver`, else "".
    function mem_namespace(rp, source: String, ns: NamespaceSyntax, receiver: String) @direct true @ret_caller true @deep true returns String linked























    ; ====================================================================
    ; textDocument/hover (parse-only)
    ;
    ; Find the innermost declaration whose [start,end) byte range contains
    ; the cursor and report its kind + name as a markdown code span. Reuses
    ; the same parse-tree walk as documentSymbol but returns a single hit.
    ; The cursor arrives as a 0-based (line, character); convert it to a byte
    ; offset with position_to_offset#. Hover text is short, so plain
    ; StringBuilder.append is fine here (the byte-at-a-time rule is only for
    ; potentially-large pieces — see the STRING/JSON NOTE).
    ; ====================================================================

    ; The request frame packs the position as "<line> <character>" (decimal,
    ; space-separated). Parse it, run the walk, and wrap the result in the LSP
    ; hover envelope. An empty walk result yields "" (server -> result:null).
    procedure hover_packed(rp, mutable source: String, packed: String) @direct true @ret_caller true @deep true returns String linked
























    ; {"contents":{"kind":"markdown","value":<text>}}  or "" when text empty.
    function hover_envelope(rp, text: String) @direct true @ret_caller true @deep true returns String linked

















    ; 0-based (line, character) -> byte offset. Walks LFs to the line start,
    ; then advances `character` columns, clamping at the next LF / EOF.
    function position_to_offset(rp, source: String, line: size_t, character: size_t) @ret_nonlocal true @deep true returns size_t linked



























    ; Parse the program and return the hover text for the innermost top-level
    ; declaration containing `offset`, or "" on no match / parse error.
    procedure hover_at(rp, mutable source: String, line: size_t, character: size_t) @direct true @deep true returns String linked
































    ; Hover text for one top-level declaration (recurses for the innermost).
    function hover_decl(rp, source: String, decl: DeclarationSyntax, offset: size_t) @direct true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function hover_export(rp, source: String, export_: ExportSyntax, offset: size_t) @direct true @deep true returns String linked
















    ; A `define X`. Recurse into the body/members for the innermost match;
    ; otherwise report the concept itself (struct/namespace/union/…).
    function hover_definition(rp, source: String, def: DefinitionSyntax, offset: size_t) @direct true @deep true returns String linked



























































    ; The `(width: int  height: int)` structure of a class: `property name: T`
    ; for the part the cursor is on, or "" when it is on none. `limit` is the
    ; first offset that is no longer the structure's (the body's `start`).
    ;
    ; WHY THIS EXISTS. Without it a hover on a property's DECLARATION fell
    ; through to the concept itself and answered `struct Box` — which is not
    ; merely unhelpful, it is a plausible-looking answer to a different
    ; question: the same argument the routine-declaration block below states,
    ; one level in. Hovering the same name in a USE or in a `set` always
    ; answered `int`, so the declaration was the one place the type was hidden.
    ;
    ; Tested from the LAST part backwards, for the reason that block gives: a
    ; syntax node's `end` overshoots into the next token, so every boundary
    ; here is a `start` and the last part that starts at or before the cursor is
    ; the one it is on. A cursor on the closing paren therefore reports the last
    ; property, exactly as one on a routine's closing paren reports the last
    ; parameter.
    function hover_structure_at(rp, source: String, structure: StructureSyntax, offset: size_t, limit: size_t) @direct true @deep true returns String linked























    ; `property name: Type` for one structure part, with its doc block.
    ;
    ; The DOC ANCHOR is the first LETTER of the declaration, not the part's
    ; `start`: that start is `previous_position` — the end of the `(` or of the
    ; part before it, which in a multi-line structure sits on ANOTHER LINE — and
    ; doc_comment# requires the declaration to be the first thing on its line,
    ; so anchoring on the raw start would drop every property's doc block.
    function hover_part_text(rp, source: String, part: PartSyntax) @direct true @deep true returns String linked

















    ; Innermost-matching member of a class body, or "".
    function hover_body(rp, source: String, body: ref[BodySyntax]?, offset: size_t) @direct true @deep true returns String linked



























    ; Hover text for one class/union member (recurses into nested defines).
    function hover_member(rp, source: String, member: MemberSyntax, offset: size_t) @direct true @deep true returns String linked


























    ; Innermost-matching nested declaration of a namespace, or "".
    function hover_namespace(rp, source: String, ns: NamespaceSyntax, offset: size_t) @direct true @deep true returns String linked























    ; A union: each variant, then any body members.
    function hover_union(rp, source: String, un: UnionSyntax, offset: size_t) @direct true @deep true returns String linked






















    ; `kind name` when start <= offset < end, else "".
    function hover_leaf(rp, source: String, start: size_t, end: size_t, offset: size_t, kind: Slice[char], name: String) @direct true @deep true returns String linked






    ; A `deinit` member: it has no name, no parameters and no return, so the
    ; word IS the whole header. The body still gets the `in` form of it, for
    ; the reason enclosing_text# states — the split is the only thing this
    ; needs over the one-liner it replaced (symbols.hover_word#, retired with
    ; it because deinit was its only caller).
    function hover_deinit(rp, source: String, dei: DeInitSyntax, offset: size_t) @direct true @deep true returns String linked













    ; --------------------------------------------------------------------
    ; DOC COMMENTS — the `;` block written directly above a declaration
    ;
    ; WHY. In this tree the comment block above a routine IS its documentation,
    ; and it is where the reasoning lives — the hazard a parameter guards
    ; against, the measurement a constant rests on, the reason a shape is the
    ; way it is. The signature alone answers "what does it take"; only the block
    ; answers "why". None of it reached the reader without opening the file.
    ;
    ; ATTACHED ONLY TO A DECLARATION-LEVEL ANSWER. `parameter k: size_t` and
    ; `returns int` are statements about a CONSTITUENT, and the routine's doc is
    ; not about them; the in-body fallback `in method get_x` is a statement about
    ; where the cursor IS, and repeating the whole block on every hover inside a
    ; body would bury the semantic type hover that normally answers there.
    ;
    ; ★FENCED, and that is a rendering decision with a reason. The hover value is
    ; markdown, where consecutive lines REFLOW into one paragraph — and these
    ; comments are hand-wrapped, with aligned tables, bullet runs and ★ markers
    ; whose meaning is carried by the line structure. The markdown alternative to
    ; a fence is a hard line break, i.e. two TRAILING SPACES per line: invisible,
    ; and the first tool that trims trailing whitespace silently reflows the
    ; block. A fence preserves the structure in every renderer.
    ; --------------------------------------------------------------------

    ; `text` with the doc block above `start` appended, or `text` unchanged when
    ; there is none. An empty `text` (no hover here) stays empty.
    function with_doc(rp, source: String, start: size_t, text: String) @direct true @deep true returns String linked




















    ; The three backticks of a markdown code fence. A backtick opens string
    ; interpolation, so it is written as the escaped character.
    function fence(rp) @direct true @ret_caller true @deep true returns String linked








    ; The `;` comment block immediately above the declaration that begins at
    ; `start`, markers stripped, or "" when there is none.
    ;
    ; A BLANK LINE ENDS THE BLOCK, which is what makes a file-level banner or an
    ; unrelated note above it stay out — this tree separates those with an empty
    ; line, and a walk that crossed one would hand the reader the section header
    ; of the region instead of the doc of the routine.
    function doc_comment(rp, source: String, start: size_t) @direct true @ret_caller true @deep true returns String linked
























    ; Offset of the first byte of the line containing `off`.
    function line_start(source: String, off: size_t) @ret_nonlocal true @deep true returns size_t linked












    ; First offset in [from, to) that is neither a space nor a tab, else `to`.
    function skip_blanks(source: String, from: size_t, to: size_t) @ret_nonlocal true @deep true returns size_t linked












    ; True when the line [from, to) is a `;` LINE comment.
    ;
    ; A `;*` block comment is deliberately not one: its content runs past this
    ; line and its closing `*;` is elsewhere, so a line-wise walk would hand the
    ; reader whatever the block happens to contain — including commented-out
    ; source — as if it were documentation.
    function is_doc_line(source: String, from: size_t, to: size_t) @ret_nonlocal true @deep true returns bool linked


















    ; The comment block in [top, limit) as text: one line per source line, with
    ; the indentation, the `;` and one following space removed. A bare `;` line
    ; becomes an empty line, which is how a paragraph break survives.
    function doc_text(rp, source: String, top: size_t, limit: size_t) @direct true @ret_caller true @deep true returns String linked






































    ; `kind name`.
    function kind_name_text(rp, kind: Slice[char], name: String) @direct true @ret_caller true @deep true returns String linked








    ; `in kind name` — the IN-BODY fallback, and the leading word is the whole
    ; point of it. This answer is a statement about where the cursor SITS, not
    ; about the token under it: the semantic hover is what names the token, and
    ; when it misses (a keyword, a brace, a routine the demand-driven planner
    ; never planned, an unresolvable name) the bare `function process_one` reads
    ; as an answer ABOUT `read_message` — measured 2026-08-15 through the LSP
    ; plugin, where three positions of `let body rpc.read_message()` all reported
    ; the enclosing routine and goToDefinition at the same position resolved
    ; correctly, i.e. the two contradicted each other. `in` costs three
    ; characters and cannot be read that way.
    function enclosing_text(rp, kind: Slice[char], name: String) @direct true @ret_caller true @deep true returns String linked









    ; --------------------------------------------------------------------
    ; Hovering a routine DECLARATION: its signature, and its constituents
    ;
    ; `in kind name` answers the question "what am I inside of", which is all
    ; a body offset needs (there the semantic hover answers with a type when it
    ; can, and this is only its fallback). On the DECLARATION LINE itself that
    ; answer throws away everything that is written there, so a header offset
    ; reports the CONSTITUENT under the cursor — `parameter k: size_t`,
    ; `returns pointer[OpenElement]`, `generic T` — and the whole reconstructed
    ; signature anywhere else in the header (the name, the keyword, the parens).
    ;
    ; Every boundary here is a `start`, never an `end`: the lexer reads one token
    ; ahead, so every syntax node's `end` overshoots into the next token (the
    ; same reason param_label#/type_text# rebuild from `name` fields instead of
    ; slicing the source). Hence "the header" is everything before the
    ; implementation's first token, and the constituents are tested from the
    ; LAST one backwards — the last parameter item that starts at or before the
    ; cursor is the one it is on. A cursor on the closing paren therefore reports
    ; the last parameter, which is where it sits.
    ; --------------------------------------------------------------------

    ; Hover for a function / procedure / operator (top level or a member).
    function hover_routine(rp, source: String, start: size_t, end: size_t, offset: size_t, kind: Slice[char], target: TargetSyntax) @direct true @deep true returns String linked












    ; The constituent under `offset`, or the whole signature; inside the body
    ; `in kind name`.
    function hover_signature(rp, source: String, start: size_t, offset: size_t, kind: Slice[char], name: String, routine: RoutineSyntax) @direct true @deep true returns String linked





























    ; Hover for an `init` member: it has no name, no return and no generics, so
    ; the parameter half of hover_signature# is all of it.
    function hover_init(rp, source: String, ini: InitSyntax, offset: size_t) @direct true @deep true returns String linked

















    ; `kind name[G](p: T, q: U) returns R throws E`, rebuilt from the tree's
    ; name/type fields. The receiver `this` is KEPT: this renders a DECLARATION,
    ; so the hover says what the line says (unlike signature_param_labels#,
    ; which feeds SignatureHelp at a CALL site, where the receiver is written
    ; before the dot and counting it would misalign activeParameter).
    function routine_signature_text(rp, source: String, kind: Slice[char], name: String, routine: RoutineSyntax) @direct true @ret_caller true @deep true returns String linked


























    ; `role Type` — `returns pointer[OpenElement]`, `throws Error`. (`label` is
    ; a reserved word, hence `role`.)
    function labeled_type_text(rp, role: Slice[char], source: String, ty: TypeSyntax) @direct true @ret_caller true @deep true returns String linked








    ; `(p: T, q: U)`, `(T)` for a bare unnamed type, `()` for none.
    function parameter_set_text(rp, source: String, parameters: ref[ParameterSetSyntax]?) @direct true @ret_caller true @deep true returns String linked







































    ; `[T]`, `[K, V]`, or "" when the routine is not generic.
    function generic_arguments_text(rp, source: String, g: GenericArgumentsSyntax) @direct true @ret_caller true @deep true returns String linked





























    ; `parameter name: Type` for the parameter the cursor is on (the bare type
    ; for an unnamed single-type parameter set), or "" when it is on none.
    function hover_parameter_at(rp, source: String, offset: size_t, parameters: ref[ParameterSetSyntax]?) @direct true @ret_caller true @deep true returns String linked







































    ; `generic T` for the generic parameter the cursor is on, or "". `limit` is
    ; the start of the parameter list (the generics end where it begins).
    function hover_generic_at(rp, source: String, offset: size_t, generics: ref[GenericArgumentsSyntax]?, limit: size_t) @direct true @ret_caller true @deep true returns String linked


























    ; The `start` of a parameter set, 0 when there is none.
    function parameter_set_start(rp, parameters: ref[ParameterSetSyntax]?) @ret_nonlocal true @deep true returns size_t linked














    ; The offset of an implementation's first token — the end of the header.
    function implementation_start(rp, implementation: ImplementationSyntax) @ret_param_0 true @deep true returns size_t linked












    ; The offset of an action's first token.
    ; where the body of an init/deinit begins; a `linked` one has none, so
    ; everything up to its end is the declaration
    function implementation_start(rp, impl: ImplementationSyntax, end: size_t) @ret_nonlocal true @deep true returns size_t linked









    function action_start(rp, action: ActionSyntax) @ret_param_0 true @deep true returns size_t linked










    ; ====================================================================
    ; textDocument/definition (parse-only, single file)
    ;
    ; Extract the identifier under the cursor, then search this file's parse
    ; tree for a declaration with that exact name and return its LSP Location
    ; ({"uri":...,"range":...}). This is intra-file only: no cross-file or
    ; scope resolution, so it jumps to the FIRST declaration of that name in
    ; the document. An unknown / non-identifier cursor yields "" (the server
    ; maps "" to result:null).
    ;
    ; The walk mirrors the documentSymbol / hover walks 1:1 (same union-by-
    ; payload-type matching, same control-flow idioms), but matches by name
    ; instead of by cursor-offset containment.
    ; ====================================================================

    ; The request frame packs the position as "<line> <character>" (same as
    ; hover). Parse it, find the identifier at that offset, and resolve it to a
    ; Location, or "" when there is no identifier / no matching declaration.
    procedure definition_packed(rp, mutable source: String, uri: String, packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





























    ; Is byte `c` part of a normal (alphanumeric / underscore) identifier?
    function is_ident_byte(c: u8) @ret_nonlocal true @deep true returns bool linked












    ; The maximal identifier run covering `offset`, or "" if the cursor is not
    ; on (or just past) an identifier. Anchors on the byte at `offset`, else
    ; the byte before it (cursor sitting just after the name), then expands.
    function identifier_at(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String linked











































    ; Parse the program and return the Location of the first declaration named
    ; `name`, or "" on no match / parse error.
    procedure find_definition(rp, mutable source: String, uri: String, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked































    ; One top-level declaration: a Location if it (or a nested member) is named
    ; `name`, else "".
    procedure def_decl(rp, source: String, uri: String, decl: DeclarationSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






























    ; A `private` declaration unwraps to its exported construct.
    procedure def_export(rp, source: String, uri: String, export_: ExportSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
















    ; A `define X`: try its members/variants first (innermost), then its own
    ; name.
    procedure def_definition(rp, source: String, uri: String, def: DefinitionSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




















    ; Structure parts of a class — the half def_body# is not: it walks a class
    ; BODY, so before this a property had no declaration to jump to at all and
    ; goToDefinition on a field answered nothing. The Location points at the
    ; NAME token (name_offset_at# of the part's `previous_position` start),
    ; because a property has no keyword ahead of it the way every other
    ; declaration this file matches does.
    procedure def_structure(rp, source: String, uri: String, structure: StructureSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked


























    ; Members of a class body.
    procedure def_body(rp, source: String, uri: String, body: ref[BodySyntax]?, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked



























    ; One class/union member.
    procedure def_member(rp, source: String, uri: String, member: MemberSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked


























    ; Nested declarations of a namespace.
    procedure def_namespace(rp, source: String, uri: String, ns: NamespaceSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked























    ; Variants of a union, then any body members.
    procedure def_union(rp, source: String, uri: String, un: UnionSyntax, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






















    ; def_match# for a `module NAME` statement, which is a LOAD DIRECTIVE and not
    ; a definition of NAME — the concept lives in the file the module names. The
    ; hit is tagged with a leading "M" so definition_workspace_packed# can hold
    ; it back as a last resort and answer NAME's real declaration in that file
    ; first (def_in_module_file#). A plain Location always starts with "{", so the
    ; tag is unambiguous, and it never reaches the client
    ; (definition_workspace_packed# is the only exit and strips it).
    procedure def_module_match(rp, source: String, uri: String, candidate: String, name: String, start: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked












    ; A Location pointing at `start` when `candidate` equals `name`, else "".
    procedure def_match(rp, source: String, uri: String, candidate: String, name: String, start: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






    ; LSP Location: {"uri":<uri>,"range":{...}} — a zero-width range at `start`
    ; (the declaration keyword), so the editor jumps there without selecting
    ; the whole declaration body.
    procedure location_object(rp, source: String, uri: String, start: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked












    ; ====================================================================
    ; Member-scoped go-to-definition — the RECEIVER's concept picks the file
    ;
    ; definition_packed# and the workspace search below match by NAME alone, and
    ; a method name is not unique: this tree declares `append` twenty-six times,
    ; so `line.append(b as char)` on a StringBuilder answered dazzle's
    ; SaveFOTBuilder.append — whichever file the walk listed first. The receiver
    ; stands right there in the source, so ask what it IS before searching: a
    ; member reference is scoped to its concept, and only that concept may answer
    ; it. Same reasoning for outgoing_item# on the call-hierarchy side.
    ;
    ; The type is resolved LEXICALLY, cheapest shape first — no plan, no modeler
    ; run, so a hit costs one parse of the current document and a cursor that is
    ; not on a member costs two byte scans:
    ;   `this.m`          -> the enclosing concept (enclosing_concept_name#)
    ;   `v.m`             -> v's declared / constructed type (resolve_variable_type#)
    ;   `Type.m` / `ns.m` -> the receiver token itself
    ; A receiver none of the three reaches (a field, a call result) yields "" and
    ; the caller falls back to the name search, i.e. to the previous answer. The
    ; call-bound form `let r make_it()` is caught one level down, where the miss
    ; is already established (definition_scoped_by_type#), because the return-type
    ; lookup it needs walks the workspace.
    ;
    ; The semantic resolver is deliberately NOT used here, though it types more
    ; receivers than this: it plans the document (measured 6-7 s once per worker
    ; process, the reason completion has a budget of its own), and a definition
    ; jump that is right but pays that on a cold worker trades a wrong answer for
    ; a killed worker — which loses the symindex and makes every LATER request
    ; cold. What is bought here is the FILE, and lexical resolution names it.
    ;
    ; LIMITS: overloads are not told apart (the concept's FIRST member of that
    ; name wins — argument types are not compared, exactly as the name search
    ; never compared them); a plain FIELD is not a member here (def_body# walks a
    ; class BODY, not its structure parts) and falls through; and the cross-file
    ; half narrows to the concept's FILE rather than to the concept, so a second
    ; concept in that same file with a same-named member could answer.
    ; ====================================================================

    ; The concept that scopes a member reference at `offset`, or "" when the
    ; cursor is not on a `.`-qualified member / the receiver names nothing.
    procedure scoping_type_at(rp, mutable source: String, offset: size_t) @direct true @deep true returns String linked










    ; The concept a NON-`this` receiver names: its declared / constructed type
    ; when the receiver is a local or a parameter, else the token itself (a
    ; `Type.` / `namespace.` receiver IS the concept name). Never "" — a name
    ; that turns out to be neither costs one lookup that finds nothing.
    ; Split out of scoping_type_at# because the call-hierarchy caller resolves a
    ; receiver PER CALL SITE and must not pay the `this` parse each time.
    function scoping_type_of_receiver(rp, source: String, receiver: String) @direct true @deep true returns String linked







    ; The Location of member `name` of concept `type_name`, or "".
    procedure definition_scoped_by_type(rp, mutable source: String, mutable uri: String, mutable type_name: String, name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked
















    ; `name` as a member of concept `type_name`: the concept declared in THIS
    ; buffer first (member-scoped, exact), else the FILE that declares it, where
    ; the name is matched against that file's cached blob — no parse. "" when the
    ; concept is nowhere, or has no such member.
    procedure definition_in_type(rp, mutable source: String, mutable uri: String, mutable type_name: String, name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_fresh linked





















    ; The Location of `member_name` declared INSIDE the concept `type_name` of
    ; THIS source (namespaces, unions and nested concepts included), or "".
    ; Reuses the def_* member walkers, so a hit is exactly what a definition jump
    ; answers — only scoped to one concept instead of to the whole file.
    procedure member_definition(rp, mutable source: String, uri: String, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked































    procedure md_decl(rp, source: String, uri: String, decl: DeclarationSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked










    procedure md_export(rp, source: String, uri: String, export_: ExportSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked








    ; The concept named `type_name`: look `member_name` up among ITS members.
    ; Otherwise recurse into a namespace's nested declarations — every concept of
    ; a package module is declared inside `define <namespace>`.
    procedure md_definition(rp, source: String, uri: String, def: DefinitionSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




























    procedure md_namespace(rp, source: String, uri: String, ns: NamespaceSyntax, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked























    ; ====================================================================
    ; Cross-file go-to-definition (workspace)
    ;
    ; definition_packed# above resolves the cursor identifier within the
    ; CURRENT file. When it finds nothing, fall back to a workspace search:
    ; enumerate the sibling .scaly files in the current file's directory (and
    ; subdirectories) and run the same name-matching parse-tree walk over each,
    ; returning the first match's Location (pointing at that other file). The
    ; current file's in-memory `source` is searched first (so unsaved edits
    ; win); other files are read from disk.
    ;
    ; File discovery shells out to `find` via popen — portable across macOS +
    ; Linux, and crash-isolated in the worker, so a discovery failure can only
    ; lose this one result. LIMITS (documented): searches the current file's
    ; directory tree only (not other packages); intra-package, lexical name
    ; match, first file wins on a name defined in several files; a single quote
    ; in the directory path breaks the `find` command (workspace paths rarely
    ; have one).
    ; ====================================================================

    ; Try the current file first; on a miss, search sibling files. `source` is
    ; the in-memory current-file text; `uri` is its file:// uri.
    procedure definition_workspace_packed(rp, mutable source: String, mutable uri: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked





































































    ; Resolve `name` across the workspace: first the current file's directory
    ; tree (intra-package / project-local, fast), then — on a miss — the package
    ; dependency tree (stdlib + declared packages under <SCALY_HOME/>packages/),
    ; so symbols defined in packages/scaly etc. resolve cross-package. Returns a
    ; Location pointing at the matching file, or "".
    procedure find_definition_in_workspace(rp, mutable uri: String, mutable name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked












    ; Enumerate the .scaly files under `dir` (recursively) and return the first
    ; one (other than `self_path`) declaring `name`, as a Location pointing at
    ; that file. "" if none / empty dir.
    ;
    ; Step 29: instead of re-parsing each file with find_definition# on every
    ; request, query the persistent symindex — the SAME content-hash-cached ws
    ; symbol blobs workspace/symbol and semanticTokens build (parse-once,
    ; shared). Each cached record carries a full SymbolInformation whose
    ; location object holds a SPAN range (uri + selecting range), so a cross-file
    ; definition is answered straight from a cached record (def_from_ws_blob#) —
    ; no re-parse, no new blob data. The first def-on-miss in a session warms the
    ; index; later def / workspace-symbol / semanticTokens requests reuse it.
    ; RANGE NOTE: the cached location's range is a SPAN (selects the decl), where
    ; the current-file path (definition_packed#) returns a zero-width range
    ; (jump-without-select). A span is valid LSP and nicer for cross-file (it's
    ; what workspace/symbol already ships) — kept intentionally.
    procedure find_definition_in_dir(rp, mutable dir: String, self_path: String, mutable name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked





















































    ; The content-hash-cached ws symbol blob of `fpath` — the SAME blob
    ; workspace/symbol and semanticTokens build (parse-once, shared), built and
    ; stored here on a cache miss. "" when the file does not exist.
    ;
    ; ★The read is skipped entirely for a file this REQUEST already validated
    ; (symindex.fresh#). That matters because the cross-file scans ask per CALL
    ; SITE, not once: an inlayHint over a file in packages/opensp resolved ~40
    ; callees and each resolution re-read and re-hashed all 56 files of the
    ; directory — 2.54 MB × 40 ≈ 100 MB per request, with every blob already
    ; cached. Eight call sites carried this read+hash+valid+put dance inline;
    ; they all built the identical blob and now route through here, so the
    ; freshness rule holds for every cross-file feature rather than one.
    procedure blob_for_file(rp, mutable fpath: String) @persists true @direct true @ret_caller true @deep true returns String io mutable idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_read reads prof_fresh linked























    ; ====================================================================
    ; textDocument/typeDefinition (lexical)
    ;
    ; "Go to the declaration of this thing's TYPE". Three cases, in the order a
    ; reader means them:
    ;   * the cursor is on a VARIABLE   -> its declared / constructed type
    ;   * on a ROUTINE                  -> that routine's return type, because
    ;     the type of `compute(x)` is what compute RETURNS
    ;   * on anything else              -> the name itself, so asking on a type
    ;     behaves like go-to-definition instead of answering nothing
    ; The resolved type name is then looked up as a declaration: the current
    ; file first, then the workspace and the package tree.
    ;
    ; Lexical, reusing resolve_variable_type# — the same resolver the inlay TYPE
    ; hints run on. A planner-backed answer would be sharper (a reassigned var,
    ; a mid-chain call), and the seam for it is the same one hover uses: ask the
    ; semantic worker first and fall back to this. Not done here because the
    ; lexical answer is the one already proven over this tree.
    ; ====================================================================
    procedure type_definition_packed(rp, mutable source: String, mutable uri: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads lc_data linked


















































































    ; True when the OPEN BUFFER itself declares `name`. One parse of the
    ; document — the same blob the answer is read out of two steps later, and
    ; the same test — so asking it first costs nothing and saves a walk of every
    ; sibling and every package.
    procedure buffer_declares(mutable source: String, uri: String, name: String) @ret_nonlocal true @deep true returns bool mutable lc_active, lc_col, lc_data, lc_len, lc_line, lc_off reads lc_data linked






    ; The Location of `name`'s own declaration in the single file `fpath` (a
    ; `module NAME` statement there does NOT count — see def_from_ws_blob#), or
    ; "" when the file is absent or declares no such name.
    procedure def_in_file(rp, mutable fpath: String, name: String) @direct true @ret_caller true @deep true returns String io mutable idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_read reads prof_fresh linked







    ; `decl_path` holds a `module NAME` statement, which says NAME's definitions
    ; live in a sibling FILE. Resolve that file the way the Modeler does
    ; (Modeler.handle_namespace#: a `module foo` inside `define <ns>` loads
    ; <dir>/<ns>/foo.scaly; a top-level one loads <dir>/foo.scaly) and answer
    ; NAME's declaration there. Both shapes are tried because scalyls sees only
    ; the file, not the enclosing namespace name — which throughout this tree IS
    ; the file's stem (containers.scaly / `define containers`). Two File.exists
    ; probes on a module hit, no directory walk.
    procedure def_in_module_file(rp, mutable decl_path: String, mutable name: String) @direct true @ret_caller true @deep true returns String io mutable idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_read reads prof_fresh linked











    ; "<dir>/<mid>/<name>.scaly", or "<dir>/<name>.scaly" when `mid` is empty.
    function module_file_path(rp, dir: String, mid: String, name: String) @direct true @ret_caller true @deep true returns String linked














    ; The last component of `path` with a trailing ".scaly" removed.
    function file_stem(rp, path: String) @direct true @ret_caller true @deep true returns String linked











    ; The SymbolKind integer of one ws blob record, given the record's json part
    ; [json_start, rec_end) and the caller's prebuilt "\"kind\":" needle (built
    ; once per blob walk, not per record); `0 - 1` when the record carries none.
    ; The json is `{"name":<quoted>,"kind":N,"location":{...}}`, so the needle
    ; occurs exactly once — a quoted identifier cannot contain it.
    function ws_record_kind(blob: String, json_start: size_t, rec_end: size_t, kind_needle: String) @ret_nonlocal true @deep true returns i64 linked




























    ; Walk a cached ws symbol blob (records "name<TAB>{json}<LF>") and return the
    ; location object of the FIRST record whose name EXACTLY equals `name`, or "".
    ; Records are in declaration order, so the first exact match is the file's
    ; first declaration of `name` — matching find_definition#'s first-wins.
    ; EXACT byte match (NOT name_matches, which is case-insensitive SUBSTRING —
    ; wrong for a definition jump). The returned location object is the same
    ; {uri,range} shape find_definition# emits (range here is a SPAN). The
    ; location is the LAST field in each record's json, single-line; its value
    ; is extracted by finding the "location": needle and taking the balanced
    ; {...} after it (depth-tracked — the range nests {start{},end{}}).
    ;
    ; `modules_only` splits the walk in two, because a `module NAME` statement
    ; (SymbolKind 2) is a LOAD DIRECTIVE, not a definition of NAME: the concept
    ; lives in the file the module names, and `packages/scaly/.../containers.scaly`
    ; lists twenty of them ahead of every container's own file in `find` order.
    ; false = the definition pass (module records SKIPPED, so `define Array[T]`
    ; in containers/Array.scaly wins over `module Array`); true = the module pass
    ; (ONLY module records), which tells find_definition_in_dir# to resolve the
    ; named file (def_in_module_file#) and, failing that, to answer the module
    ; line — the only thing we know when nothing declares `name`.
    function def_from_ws_blob(rp, blob: String, name: String, modules_only: bool) @direct true @ret_caller true @deep true returns String linked





























































































    ; Find the first record in a cached ws blob whose name EXACTLY equals `name`
    ; AND whose DETAIL field is tagged `tag` ('S'/'M'), and return "Y" + the
    ; payload after the tag byte; "" when there is no such record. The leading
    ; "Y" sentinel distinguishes a found-but-empty payload (a zero-arg routine's
    ; "S" detail / a fieldless concept's "M" detail) from a genuine miss.
    ; Records are `name<TAB>{json}<TAB>detail<LF>`: tab1 = name/json sep, tab2 =
    ; json/detail sep, detail = [tab2+1, i). A record whose detail is empty or a
    ; different tag is skipped (so a name shared by a routine and a type resolves
    ; to the right record for each query).
    function detail_payload(rp, blob: String, name: String, tag: u8) @direct true @ret_caller true @deep true returns String linked






































































    ; Cross-file signatureHelp from a cached ws blob: the routine named `name`'s
    ; "S"-tagged detail (0x1F-joined param labels) rebuilt into a SignatureHelp
    ; via build_signature_from_labels#. "" on no match.
    procedure sig_from_ws_blob(rp, blob: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String mutable prof_bytes, prof_sig reads prof_sig linked












    ; Cross-file member completion from a cached ws blob: the concept named
    ; `name`'s "M"-tagged detail (bracketless completion items) wrapped in
    ; [...]. "" on no match (so the caller falls back), "[...]" / "[]" on a
    ; found concept (matching mem_definition#).
    function members_from_ws_blob(rp, blob: String, name: String) @direct true @ret_caller true @deep true returns String linked




















    ; ====================================================================
    ; Cross-file type-hint inference from the cached ws blob (Step 32)
    ;
    ; inlayHint TYPE inference (infer_binding_type# / concept_or_return_type#)
    ; resolves "is NAME a concept?" and "what does routine NAME return?" — the
    ; two cross-file questions a binding initializer poses. Before Step 32 the
    ; intra-MISS fallback re-parsed each sibling/package file per request
    ; (members_for_type# / function_return_type_ws#). These readers answer both
    ; from the SAME content-hash-cached ws blobs the rest of the server shares
    ; (workspace/symbol + def + sig + member + semanticTokens) — no re-parse.
    ; The 4th rettype field that ws_item# now emits carries the routine return
    ; base; concept-ness is read from the json `"kind":` (23 struct / 10 enum).
    ; Both readers use EXACT name match (range_equals), NOT name_matches (the
    ; case-insensitive substring used by workspace/symbol filtering).
    ; ====================================================================

    ; The 4th (rettype) field of the FIRST record in `blob` whose name EXACTLY
    ; equals `name`, "" on no match (or a routine that returns nothing — same
    ; "" → no hint). Records are `name<TAB>{json}<TAB>detail<TAB>rettype<LF>`;
    ; rettype = [tab3+1, i). Mirrors def_from_ws_blob#'s exact-name walk.
    function return_type_from_ws_blob(rp, blob: String, name: String) @direct true @ret_caller true @deep true returns String linked







































    ; True when the FIRST record in `blob` whose name EXACTLY equals `name` is a
    ; concept — its json `"kind":` is 23 (struct) or 10 (enum/union). The first
    ; `"kind":` in a record is always the json's (it precedes the detail field's
    ; completion-item kinds), so the scan stops at it. Mirrors
    ; tagged_names_from_ws_blob#'s kind extraction + def_from_ws_blob#'s exact
    ; name match.
    function concept_in_ws_blob(rp, blob: String, name: String) @ret_nonlocal true @deep true returns bool linked

































































    ; The type base of member `member_name` of the concept named `type_name`,
    ; read from the FIRST exact-name record's 5th (membertypes) field — the
    ; 0x1F-joined `name 0x1F type 0x1F ...` pairs concept_member_types# emits.
    ; "" when the concept is found but the member isn't, OR the member's type is
    ; empty (a void method — no chainable type), OR no such concept. First
    ; concept wins (like def_from_ws_blob#). membertypes = [tab4+1, i).
    function member_type_from_ws_blob(rp, blob: String, type_name: String, member_name: String) @direct true @ret_caller true @deep true returns String linked





































































    ; Is there a concept named `name` anywhere in the workspace? Mirrors
    ; find_definition_in_workspace#: the current file's directory tree, then ON A
    ; MISS the package dependency tree. Reads CACHED ws blobs via the symindex.
    procedure concept_in_workspace(rp, mutable uri: String, name: String) @ret_nonlocal true @deep true returns bool io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked











    ; Scan the .scaly files under `dir` (skipping self_path) for a concept named
    ; `name`, reading each file's CACHED ws blob (symindex.valid → get_blob#,
    ; else workspace_symbols_in_file# + put). Structured exactly like
    ; find_definition_in_dir#.
    procedure concept_in_dir(rp, mutable dir: String, self_path: String, name: String) @ret_nonlocal true @deep true returns bool io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked































    ; The return-type base of the routine named `name` anywhere in the workspace
    ; (dir tree, then package tree), "" when found nowhere / void. Reads CACHED
    ; ws blobs via the symindex; structured like function_return_type_ws# but
    ; cache-served (no per-file re-parse).
    procedure return_type_in_workspace(rp, mutable uri: String, name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked












    procedure return_type_in_dir(rp, mutable dir: String, self_path: String, name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked






























    ; ====================================================================
    ; Cross-file semantic-token name resolution
    ;
    ; semantic_tokens#'s declared-kind resolution (fn_list/ty_list from
    ; completion_items#) colours an identifier USE by its kind only when the
    ; declaration is in the SAME file. This harvests function/method and
    ; struct/enum names from the rest of the workspace so a call to a cross-file
    ; function colours as function and a cross-file type reference as type. It
    ; reuses the persistent symindex — the SAME content-hash-cached ws symbol
    ; blobs workspace/symbol builds (parse-once, shared) — extracting names by
    ; SymbolKind: function/method (12/6) -> tag "F", struct/enum (23/10) ->
    ; tag "T". The result is a blob of tagged lines "F<TAB>name<LF>" /
    ; "T<TAB>name<LF>"; semantic_tokens# splits it into two newline-bracketed
    ; name lists via tagged_name_list#. "" when there is no workspace context,
    ; so a scratch file with no siblings behaves exactly as the intra-file path.
    ; Mirrors find_definition_in_workspace#: current file's dir tree, then the
    ; package tree (stdlib String / Vector / Page, …).
    ; ====================================================================

    ; The two halves of workspace_name_blob# on their own. semanticTokens needs
    ; them apart because `defaultLibrary` is a statement about WHERE a name
    ; comes from: a name of the package dependency tree is library, a name of a
    ; sibling file is the reader's own code, and the union cannot tell them
    ; apart. Together they do exactly the work the union did — the symindex
    ; caches each directory's blob — so asking for both costs nothing extra.
    procedure local_name_blob(rp, mutable uri: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked








    ; "" when the file has no package tree, or when it IS the directory already
    ; covered by local_name_blob# (the same skip workspace_name_blob# makes).
    procedure package_name_blob(rp, mutable uri: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked













    procedure workspace_name_blob(rp, mutable uri: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked








































    ; Harvest tagged function/type names from every .scaly file under `dir`
    ; (recursively) except `self_path` (the current file — its declarations are
    ; already in the intra-file lists). Reuses the symindex (parse-once, content
    ; hashed), so a query reuses the cached ws blob whenever the file is
    ; unchanged. Each file contributes its tagged-name fragment.
    procedure workspace_names_in_dir(rp, mutable dir: String, self_path: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked



































    ; Walk a cached ws symbol blob (records "name<TAB>{json}<LF>") and emit a
    ; tagged-name line per function/method (SymbolKind 12/6 -> "F") and struct/
    ; enum (23/10 -> "T"). Other kinds (namespaces, variables, constructors,
    ; operators, modules) are skipped — they match the intra-file path, where
    ; only completion kinds 2/3 (fn) and 22/13 (type) feed the lists.
    function tagged_names_from_ws_blob(rp, blob: String) @direct true @ret_caller true @deep true returns String linked





















































    ; ----- fast lexical top-level name harvest (no full parse) -----
    ; The cross-package semanticTokens harvest only needs each file's TOP-LEVEL
    ; declaration names tagged F (function/procedure/delegate) or T (class/union/
    ; intrinsic) — exactly what workspace_symbols_in_file + ws_decl emit for the
    ; top level (it iterates file.declarations only; nested defines/methods live
    ; inside `{...}` at depth>0 and are NOT emitted). A full parse_program of every
    ; package file (incl. the 21k-line Planner.scaly, Emitter.scaly, 9.5k-line
    ; symbols.scaly under <SCALY_HOME>/packages) cost ~7.5s on a cold worker —
    ; right at the 8s budget. A brace-depth-0 byte scan skips all routine/type
    ; BODIES and runs in a fraction of that. Emits the tagged_names_from_ws_blob
    ; format ("F\tname\n" / "T\tname\n").

    ; Skip whitespace, newlines, comments and string/char/fragment literals from
    ; k; return the next real-code offset.
    function lex_skip_ws(source: String, k0: size_t, n: size_t) @ret_nonlocal true @deep true returns size_t linked

























    ; Read an identifier starting at k (or "" if k is not an ident start).
    function lex_read_ident(rp, source: String, k: size_t, n: size_t) @direct true @ret_caller true @deep true returns String linked















    ; k points at `[`; return the offset just past the matching `]`.
    function lex_skip_brackets(source: String, k0: size_t, n: size_t) @ret_nonlocal true @deep true returns size_t linked






















    function tagged_names_lexical(rp, source: String) @direct true @ret_caller true @deep true returns String linked





























































































    ; Lexical analogue of workspace_names_in_dir: list every .scaly file under
    ; `dir` (recursively), read each (skipping self_path), and aggregate the
    ; tagged_names_lexical fragment. No full parse and no symindex (the byte scan
    ; is cheap enough to re-run per request); the rich features keep their full-
    ; blob symindex cache, populated by their own queries.
    procedure tagged_names_in_dir(rp, mutable dir: String, self_path: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked


































    ; Extract the names tagged `tag` ("F"/"T") from a workspace_name_blob# into a
    ; newline-bracketed list ("\nname\n..\n"), the shape name_set_contains reads.
    function tagged_name_list(rp, blob: String, tag: u8) @direct true @ret_caller true @deep true returns String linked





























    ; ====================================================================
    ; Cross-package search roots
    ;
    ; Beyond the current file's directory tree, cross-package go-to-definition
    ; and signatureHelp also scan the package dependency tree so stdlib symbols
    ; (String / StringBuilder / Page / Vector, …) resolve. The package root is
    ; resolved the same way the compiler resolves the prelude (Modeler.scaly's
    ; scaly_home_base#): <SCALY_HOME>/packages when SCALY_HOME is set (the
    ; install wrapper sets it — absolute), else derived from the current file's
    ; path by walking up to the enclosing `/packages` segment (covers in-repo
    ; development). Both yield ABSOLUTE paths so the result Location uri opens.
    ; ====================================================================

    ; "<SCALY_HOME>/" when SCALY_HOME is set and non-empty, else "". Mirrors
    ; Modeler.scaly::scaly_home_base#.
    procedure scaly_home_base(rp) @direct true @ret_caller true @deep true returns String io linked



















    ; The packages/ root to scan for cross-package symbols, or "" when none can
    ; be determined. Prefers <SCALY_HOME>/packages; otherwise the longest prefix
    ; of `path` ending in a `/packages` segment.
    procedure package_search_dir(rp, path: String) @direct true @ret_caller true @deep true returns String io linked


















    ; `path` truncated to include its last "/packages" segment (so
    ; "/u/Scaly/packages/scalyls/0.1.0/x.scaly" -> "/u/Scaly/packages"), or ""
    ; when `path` is not under a packages/ directory.
    function packages_dir_from_path(rp, path: String) @direct true @ret_caller true @deep true returns String linked
























    ; Run `find -H '<dir>' -name '*.scaly'` and return its stdout (newline-
    ; separated absolute paths) with a guaranteed trailing LF. "" on failure.
    ; The quote bytes are emitted as 0x27 (the lexer treats a `'` as the start
    ; of a string-identifier token, so it must not appear in a "..." literal).
    ;
    ; ★★★The `-H` is load-bearing and was missing until 2026-08-14: `find` does
    ; NOT follow a symlink that is its own STARTING POINT, so a walk root
    ; reached through one listed NOTHING — and every cross-file answer then
    ; came back as if the workspace held a single file. Silently, because a
    ; shorter list is a well-formed result: references/rename lose every other
    ; file, workspace/symbol goes empty, the definition fan-out never leaves
    ; the buffer. Measured on this box, where /tmp -> private/tmp:
    ;     find /tmp -name '*.scaly'          -> 0
    ;     find /private/tmp -name '*.scaly'  -> 245
    ;     find -H /tmp -name '*.scaly'       -> 245
    ; `-H` follows symlinks for the command-line operand ONLY, so a link INSIDE
    ; the tree is still not descended — no cycles, no file counted twice. Both
    ; BSD and GNU find have it.
    ; ★How it hid: it needs a symlinked root to show at all, so it was invisible
    ; on Linux boxes and on any project under a real path, while on macOS it
    ; made every /tmp-based LSP fixture accidentally immune to the workspace
    ; walk — which is exactly why the shared-scratch coupling the Linux run
    ; found on 2026-08-14 could never reproduce here. Gate: "lsp symlinked
    ; workspace root" in tests/lsp/run.sh.
    procedure list_scaly_files(rp, dir: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked



















































    ; Bytes [start,end) of `s` as a new String.
    function substring(rp, s: String, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String linked











    ; Strip a leading "file://" from a uri to get the filesystem path.
    function uri_to_path(rp, uri: String) @direct true @deep true returns String linked






    ; Wrap a filesystem path back into a "file://" uri. A file of a generated
    ; package interface (a dependency is loaded through it) is answered as its
    ; SOURCE file: the interface keeps every line where the source has it, so
    ; a definition's line and column are the source's.
    function path_to_uri(rp, path: String) @direct true @ret_caller true @deep true returns String linked















    ; does `/interface/` start at byte i of path?
    function at_interface_dir(path: String, i: size_t) @ret_nonlocal true @deep true returns bool linked















    ; The directory portion of `path` (everything before the last '/'), or "".
    function dir_of(rp, path: String) @direct true @ret_caller true @deep true returns String linked





















    ; ====================================================================
    ; workspace/symbol (parse-based, all files)
    ;
    ; Build a flat LSP SymbolInformation[] of every declaration across the
    ; workspace whose name matches the query (case-insensitive substring; an
    ; empty query matches everything), reusing the cross-file `find` discovery
    ; + the parse-tree walk. Each item:
    ;   {"name":..,"kind":<SymbolKind int>,"location":{"uri":..,"range":..}}
    ; The SymbolKind ints are the same as documentSymbol's (Function=12 etc.),
    ; NOT completion's CompletionItemKind. The walk mirrors completion_items#
    ; 1:1 (flat, comma-joined fragments) but each item carries a Location and
    ; is filtered by the query. PERSISTENT INDEX (symindex): the per-file symbol
    ; set is parsed once into a content-hashed blob and reused across queries —
    ; only files whose content changed are re-parsed, so repeated queries over a
    ; large tree are cheap. LIMITS: intra-workspace; lexical name match; the
    ; index reflects disk content (unsaved editor edits don't show, as before).
    ; ====================================================================

    ; Search every .scaly file under `root` and return the SymbolInformation[]
    ; array (already bracketed). "[]" when root is empty (no workspace folder).
    ; Each file's UNFILTERED symbol blob is cached by content hash in symindex;
    ; a query reuses the cached parse when the file is unchanged and filters the
    ; blob by name, re-parsing only files whose content moved.
    procedure workspace_symbols(rp, mutable root: String, query: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked











































    ; All symbols in one file as an UNFILTERED tagged blob: each record is
    ; `name <0x09> {json} <0x0A>`. Cacheable (query-independent); a query is
    ; applied later by filter_ws_blob#. Records are newline-terminated, so the
    ; builders below concatenate fragments rather than comma-joining.
    procedure workspace_symbols_in_file(rp, mutable source: String, uri: String) @direct true @ret_caller true @deep true returns String mutable lc_active, lc_col, lc_data, lc_len, lc_line, lc_off reads lc_data linked








































    ; Filter a cached tagged blob by `query`, emitting the matching records'
    ; JSON objects comma-joined (no brackets) — the per-file fragment that
    ; workspace_symbols# joins across files. Each record is
    ; `name <0x09> {json} <0x0A>`; the name is matched (case-insensitive
    ; substring), the json part emitted on a match.
    function filter_ws_blob(rp, blob: String, query: String) @direct true @ret_caller true @deep true returns String linked
























































    ; One top-level declaration -> a fragment (its own item if it matches, plus
    ; its members). "" for use/package/empty/trait/macro and non-matches.
    procedure ws_decl(rp, source: String, uri: String, decl: DeclarationSyntax) @direct true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked






























    ; A `private` declaration unwraps to its exported construct.
    procedure ws_export(rp, source: String, uri: String, export_: ExportSyntax) @direct true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
















    ; A `define X` -> its own item (struct/namespace/union/…) joined with its
    ; members' items.
    procedure ws_definition(rp, source: String, uri: String, def: DefinitionSyntax) @direct true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked































    ; Structure parts of a class -> one Field(8) record each.
    ;
    ; WHY THEY ARE IN THE INDEX. This blob is the ONLY thing a cross-file
    ; question can consult — def_in_file# answers from it without a parse — so
    ; while it held declarations and body members but not structure parts, a
    ; property was invisible to every cross-file jump: `b.width` with `Box` in
    ; another file answered null, where the same expression resolved fine when
    ; the concept sat in the open document (def_structure# handles that half).
    ; The measured shape in this tree is `def.concept_` / `c.structure` — every
    ; record of Syntax.scaly read from parser.scaly, Modeler.scaly or
    ; symbols.scaly — 349 properties whose declaration could not be reached.
    ;
    ; The location is the NAME TOKEN, not the part's `start`: a PartSyntax start
    ; is `previous_position` (the end of the `(` or of the previous part), so a
    ; span from it selects the punctuation and the whitespace ahead of the name.
    ;
    ; ★They also enter workspace/symbol, which is not a side effect but the same
    ; fact: this blob IS the workspace symbol table, and a field is a symbol.
    procedure ws_structure(rp, source: String, uri: String, structure: StructureSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




























    ; Members of a class body -> a comma-joined fragment.
    procedure ws_body(rp, source: String, uri: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked































    ; One class/union member -> an item, or "" / a nested fragment.
    procedure ws_member(rp, source: String, uri: String, member: MemberSyntax) @direct true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked


























    ; Nested declarations of a namespace -> a concatenated record fragment.
    procedure ws_namespace(rp, source: String, uri: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked



























    ; Variants (EnumMember=22) + body members of a union -> a comma-joined
    ; fragment. Each variant is filtered by the query, so the comma is only
    ; emitted for a matching variant.
    procedure ws_union(rp, source: String, uri: String, un: UnionSyntax) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




















































    ; The ws-blob DETAIL field of a routine: "S" + its 0x1F-joined param labels
    ; (Step 29 follow-up). Lets cross-file signatureHelp rebuild a SignatureHelp
    ; from the cached blob without re-parsing. A zero-arg routine yields "S"
    ; alone (still non-empty, so it is distinguishable from a non-routine's empty
    ; detail). An anonymous RoutineSyntax target -> "".
    function routine_param_detail(rp, source: String, target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked




















    ; The ws-blob DETAIL field of a `define X`: "M" + its member completion
    ; fragment (the bracketless comma-joined {label,kind} items mem_definition#
    ; wraps in [...]). Lets cross-file member completion rebuild the member list
    ; from the cached blob without re-parsing. An empty/fieldless concept yields
    ; "M" alone -> members_from_ws_blob# wraps it as "[]" (found-but-empty,
    ; matching mem_definition#).
    function concept_member_detail(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String linked



























    ; The ws-blob MEMBERTYPES field of a `define X` (Step 33): for a CLASS, the
    ; flat 0x1F-joined member-name / type-base pairs of its fields and methods
    ; (name1 0x1F type1 0x1F name2 0x1F type2 0x1F ...), so cross-file
    ; chain-segment resolution (member_type_from_ws_blob#) can look up a field's
    ; or method's type from the cache WITHOUT re-parsing the sibling. "" for
    ; namespaces / unions / non-classes — a chain segment's type is always a
    ; class field or method. Each pair is name 0x1F typebase 0x1F (a trailing
    ; 0x1F is harmless — the reader stops at the matched name). A type base is a
    ; bare identifier (no 0x1F / tab / newline); a void method's typebase is ""
    ; (the reader returns "" for it — a void result has no chainable type).
    function concept_member_types(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String linked



























































    ; A class structure part -> its `name 0x1F typebase 0x1F` pair fragment.
    function cmt_part(rp, part: PartSyntax) @direct true @ret_caller true @deep true returns String linked








    ; A class-body member -> its `name 0x1F returnbase 0x1F` pair fragment, "" for
    ; non-routine members (init/deinit/nested define/etc — not chain targets).
    function cmt_member(rp, member: MemberSyntax) @direct true @ret_caller true @deep true returns String linked










    ; `name 0x1F type_base 0x1F` (both raw, no escaping — neither contains a
    ; 0x1F / tab / newline). "" when the member has no name.
    function cmt_pair(rp, name: String, type_base: String) @direct true @ret_caller true @deep true returns String linked























    ; One tagged symbol record
    ; `name <0x09> {"name","kind","location"} <0x09> detail <0x09> rettype <0x09> membertypes <0x0A>`.
    ; UNFILTERED (query-independent, so it can be cached); filter_ws_blob# does
    ; the name match later AND drops the detail+rettype fields (bounding at the
    ; SECOND tab) so workspace/symbol output stays byte-identical. A
    ; SymbolInformation JSON object never contains a raw tab or newline
    ; (json.quote_string# escapes them); the detail field (param labels /
    ; completion items) likewise has no raw tab/newline; and the rettype field
    ; (Step 32) and the membertypes field (Step 33) are bare identifiers /
    ; 0x1F-joined identifier pairs (no tab/newline) — so all four delimiters are
    ; unambiguous. `detail` is "S<labels>" for routines, "M<members>" for
    ; `define`s, "" else (routine_param_detail# / concept_member_detail#).
    ; `rettype` is the routine's return-type base (target_return_field#), ""
    ; for non-routines / void — it backs cache-served cross-file type-hint
    ; inference (return_type_from_ws_blob#). `membertypes` is a class's
    ; 0x1F-joined member-name/type pairs (concept_member_types#), "" else — it
    ; backs cache-served cross-file chain-segment resolution
    ; (member_type_from_ws_blob#).
    procedure ws_item(rp, source: String, uri: String, name: String, kind: i64, start: size_t, end: size_t, detail: String, rettype: String, membertypes: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked
















































    ; The ws-blob RETTYPE field (Step 32): a routine target's return-type base
    ; name (target's NamedSyntax routine returns_), "" for an anonymous routine
    ; or one that returns nothing. Non-routine declarations pass "" directly.
    function target_return_field(rp, target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked








    ; Concatenate two tagged-record fragments (records are newline-terminated,
    ; so plain concatenation yields a valid record stream). The result can be
    ; large, so the bytes are copied one at a time.
    function join_fragments(rp, a: String, b: String) @direct true @deep true returns String linked























    ; Lowercase an ASCII byte (A-Z -> a-z), else unchanged.
    function lower_byte(c: u8) @ret_nonlocal true @deep true returns u8 linked






    ; True when `name[start..)` begins with `query` (case-insensitive).
    function matches_at(name: String, start: size_t, query: String) @ret_nonlocal true @deep true returns bool linked












    ; True when `query` is a case-insensitive substring of `name` (empty query
    ; matches everything).
    function name_matches(name: String, query: String) @ret_nonlocal true @deep true returns bool linked


















    ; ====================================================================
    ; textDocument/references (lexical, single file)
    ;
    ; Extract the identifier under the cursor and return an LSP Location[]
    ; for EVERY whole-token occurrence of that identifier in the document.
    ; This is a LEXICAL scan — no type resolution — but not a naive one:
    ; comments and string literals are skipped wholesale (is_noncode_start#),
    ; a local/parameter is confined to its declaring routine, and a
    ; module-wide name skips any routine that binds it locally (shadow
    ; exclusion, below). What remains unresolved is the TYPE: two same-named
    ; members of different concepts are one name to this scan. The result
    ; is the bare JSON array `[ <location>... ]`; the server wraps it in a
    ; Response envelope. No identifier under the cursor -> `[]`.
    ;
    ; Each location's range covers the whole token [start,end) (not zero-width
    ; like go-to-definition) so the editor highlights each occurrence. The
    ; array can be large, so locations are appended ONE BYTE AT A TIME (see the
    ; STRING/JSON NOTE) — a many-occurrence file would otherwise trip the
    ; runtime's manual-grow path.
    ; ====================================================================

    ; The references/rename cursor frame is prefixed with the workspace root as
    ; "<root>\n<rest>" (root may be empty). root_prefix# returns the root (the
    ; bytes before the first LF, "" when there is none), strip_root_prefix#
    ; returns the rest (everything after the first LF, or the whole string when
    ; there is no LF — the pre-Step-37 form). The root is threaded so the
    ; cross-file walk can fan out from the real workspace root (a use in a
    ; parent/sibling directory outside the current file's own dir tree) instead
    ; of only the current file's directory; "" falls back to the dir tree.
    function root_prefix(rp, packed: String) @direct true @ret_caller true @deep true returns String linked












    function strip_root_prefix(rp, packed: String) @direct true @deep true returns String linked












    procedure references_packed(rp, mutable source: String, mutable uri: String, mutable packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads prof_list linked







































    ; True when `c` opens a comment (`;`) or a string/char/fragment literal
    ; (" ' `). The lexical token scans skip these wholesale so a name inside a
    ; comment or a string literal is never reported as a reference/rename site.
    function is_noncode_start(c: u8) @ret_nonlocal true @deep true returns bool linked






    ; Given that source[k] opens a comment or a string literal, return the
    ; offset just past it (so the caller resumes scanning real code). Mirrors
    ; the semantic_tokens# scanner's comment/string handling: `;` to EOL, a
    ; `;* ... *;` block (possibly multi-line), or a " ' ` literal (escape-aware:
    ; a backslash skips the next byte; a newline inside a single-quoted run
    ; terminates it). Returns k unchanged if source[k] is neither.
    function skip_noncode(source: String, k: size_t, len: size_t) @ret_nonlocal true @deep true returns size_t linked






























































    ; True when `offset` falls inside a comment or a string literal (so a
    ; rename/prepareRename request there is rejected). Linear scan to `offset`.
    function offset_in_noncode(source: String, offset: size_t) @ret_nonlocal true @deep true returns bool linked





















    ; True when lo <= off < hi.
    function in_range(off: size_t, lo: size_t, hi: size_t) @ret_nonlocal true @deep true returns bool linked






    ; ----- shadow exclusion: same-named locals across files (Step 38) -----
    ; A module/file-wide name N is scanned across every file (references/rename
    ; fan-out). But a routine in some file may bind N LOCALLY (as a parameter or
    ; via `let N`/`var N`), in which case every occurrence of N inside that
    ; routine refers to the local, never the module-wide symbol. Renaming those
    ; would corrupt unrelated code. So before scanning a file for N we compute
    ; its SHADOW RANGES — the byte spans of routines that bind N locally — and
    ; the token scan skips any occurrence whose start falls in a shadow range.
    ; The whole routine is skipped (the safe direction: never rename into a
    ; routine that owns a same-named local; missing a real ref is the lesser
    ; harm than corrupting an unrelated local). Detection is purely lexical /
    ; parse-based (no planner — the Step 34/35 lesson): routine ranges come from
    ; one `scope_table#` parse, params from its P records, `let`/`var` locals
    ; from a lexical sub-scan of each routine range. A cheap byte pre-gate
    ; (`has_local_binding_candidate`) skips the parse for the common file that
    ; cannot bind N at all. Binders recognised: `let`/`var`/`for`, a parameter
    ; `N: T` and a `when N: T` pattern. Residual limit: a lambda parameter
    ; (`\N y: ...`) is not detected, so such a routine is NOT skipped.

    ; True when source[k,j) is a keyword that BINDS the token following it:
    ; `let`, `var` or `for` (`for name in seq` binds `name` for the loop body —
    ; without it a module-wide rename rewrote unrelated loop variables). Byte
    ; compare, no allocation — usable from a non-# scanner.
    function token_is_binder_kw(source: String, k: size_t, j: size_t) @ret_nonlocal true @deep true returns bool linked





















    ; True when source[k,j) is the keyword `set`. `set name: value` WRITES an
    ; already-bound name, so the `name:` after it is not a binding — see the
    ; colon rule in range_binds_name#.
    function token_is_set_kw(source: String, k: size_t, j: size_t) @ret_nonlocal true @deep true returns bool linked













    ; True when the token starting at `k` is reached through a member access —
    ; the nearest non-blank byte before it is a `.`. `set r.field: v` writes a
    ; FIELD, so `field:` there is not a binding of `field` either.
    function preceded_by_dot(source: String, k: size_t) @ret_nonlocal true @deep true returns bool linked






















    ; True when `name` is bound as a local within the byte range [lo,hi): it
    ; occurs as a whole token either right after a `let`/`var`/`for` keyword OR
    ; immediately followed (past spaces/tabs) by a `:` (a parameter `name: T`, a
    ; `when name:` pattern). Comments/strings are skipped.
    ;
    ; The colon form used to include a `set name:` ASSIGNMENT target, on the
    ; argument that over-approximating only skips a routine and never renames
    ; something unrelated. That argument is wrong in the other direction: a
    ; skipped routine drops its occurrences from references AND rename, so a
    ; `mutable` global — the very shape that carries `set NAME:` — lost every
    ; write site, and F2 renamed the declaration while leaving the assignments
    ; behind. A partial rename is broken code, so the assignment target and the
    ; `set r.field:` member write are both excluded now.
    function range_binds_name(source: String, name: String, lo: size_t, hi: size_t) @ret_nonlocal true @deep true returns bool linked




































































    ; Cheap whole-file pre-gate: could `source` bind `name` locally anywhere? If
    ; false the file cannot shadow `name`, so the routine-boundary scan in
    ; `shadow_ranges#` is skipped entirely.
    function has_local_binding_candidate(source: String, name: String) @ret_nonlocal true @deep true returns bool linked




    ; Given `open_pos` at a `{`, return the offset just past its matching `}`
    ; (or `len` if unbalanced). Braces inside comments/strings are skipped.
    function match_brace_end(source: String, open_pos: size_t, len: size_t) @ret_nonlocal true @deep true returns size_t linked






























    ; Given the byte just after a routine keyword (function/procedure/operator/
    ; init/deinit), return the routine's end offset (exclusive): the byte after
    ; its closing `}` for a brace body, or the end of its single-expression line
    ; for a braceless body. ()/[] depth is tracked so a `{` or end-of-signature
    ; newline is only acted on at depth 0; a `returns` clause continuing on the
    ; next line is not mistaken for a single-line body; comments/strings skipped.
    function routine_body_end(source: String, after_kw: size_t, len: size_t) @ret_nonlocal true @deep true returns size_t linked





























































































    ; True when source[q..q+7) is the whole keyword `returns` (followed by a
    ; non-identifier byte). No allocation.
    function token_is_returns(source: String, q: size_t) @ret_nonlocal true @deep true returns bool linked



















    ; The shadow ranges of `name` in `source`: a newline-terminated list of
    ; "<start> <end>" routine byte spans where `name` is bound as a parameter or
    ; a `let`/`var` local. "" when the file binds `name` nowhere (the common
    ; case — pre-gated by `has_local_binding_candidate`). PURELY LEXICAL: routine
    ; boundaries come from a byte scan (keyword + brace matching / single-line
    ; body), NOT a parse — one parse of a large file is ~seconds and would blow
    ; the worker budget when fanned out over many files (s38 measurement).
    function shadow_ranges(rp, source: String, name: String) @direct true @ret_caller true @deep true returns String linked
































































    ; ====================================================================
    ; Call hierarchy (lexical)
    ;
    ; prepareCallHierarchy resolves the name at the cursor to the routine it
    ; DECLARES — from a call site too, so "show me the callers" works where the
    ; reader is looking. incomingCalls walks the workspace for call sites and
    ; groups them by the routine that CONTAINS them; outgoingCalls scans one
    ; routine's body for the names it calls.
    ;
    ; The shared primitive is routine_records#: the same routine-keyword walk
    ; shadow_ranges# does, but reporting every routine with its NAME instead of
    ; testing one for shadowing. Lexical, so it answers on a buffer mid-edit.
    ;
    ; A call is `name(` with `name` not a keyword and not preceded by a routine
    ; or `define` keyword (preceded_by_def_keyword#) — the same test the inlay
    ; hints use, so a declaration's parameter list is never read as a call.
    ; ====================================================================

    ; One record per routine of `source`, newline-terminated:
    ;   <name> <0x09> <start> <0x09> <name_start> <0x09> <name_end> <0x09> <end>
    ; `start` is the routine keyword, `end` its body end (exclusive). An `init`
    ; / `deinit` has no name of its own and is reported under the keyword.
    function routine_records(rp, source: String) @direct true @ret_caller true @deep true returns String linked














































































































    ; The field `which` (0-based) of the record starting at `at` in `records`.
    function record_field(rp, records: String, at: size_t, which: size_t) @direct true @ret_caller true @deep true returns String linked
























    ; Parse a decimal field into a size_t (0 when empty / non-numeric).
    function record_number(records: String, at: size_t, which: size_t) @ret_nonlocal true @deep true returns size_t linked




































    ; The offset of the record whose [start,end) covers `off`, or the length of
    ; `records` when none does. Routines do not nest, so the first hit wins.
    function record_covering(records: String, off: size_t) @ret_nonlocal true @deep true returns size_t linked





















    ; The byte offset of a packed "<line> <char>" position frame.
    function packed_offset(source: String, packed: String) @ret_nonlocal true @deep true returns size_t linked


























    ; A CallHierarchyItem. `kind` is LSP SymbolKind (12 Function, 6 Method).
    ; `selectionRange` must be INSIDE `range` — the editor uses it to place the
    ; cursor when you click the entry, so it points at the NAME.
    procedure call_item(rp, source: String, uri: String, name: String, start: size_t, name_start: size_t, name_end: size_t, end: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





















    ; The item for the routine record at `at`, over `source`/`uri`.
    procedure call_item_at(rp, source: String, uri: String, records: String, at: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked











    ; prepareCallHierarchy: one item for the routine named at the cursor. It
    ; resolves from a CALL SITE too — that is where a reader asks "who calls
    ; this?" — by looking the name up in this buffer's routines first and then,
    ; on a miss, wherever the workspace declares it.
    procedure prepare_call_hierarchy_packed(rp, mutable source: String, mutable uri: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads lc_line linked
























































































    ; The call sites of routine `name` within [lo,hi) of `source`, as a
    ; comma-joined fragment of Ranges ("" when none). A call is `name(` that is
    ; not itself a declaration's parameter list.
    procedure call_site_ranges(rp, source: String, name: String, lo: size_t, hi: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked











































    ; callHierarchy/incomingCalls: every routine that calls `name`, anywhere
    ; under the walk root, each with the ranges of its call sites. The current
    ; buffer is scanned from `source` so unsaved edits count; the other files
    ; are read from disk, exactly as references does.
    procedure incoming_calls(rp, source: String, uri: String, name: String, mutable root: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads prof_list linked






































    ; One file's contribution: for each routine that calls `name`, a
    ; CallHierarchyIncomingCall {"from":<item>,"fromRanges":[...]}.
    procedure append_incoming_for(mutable sb: ref[StringBuilder], mutable first: ref[bool], source: String, uri: String, name: String) @deep true mutable lc_col, lc_line, lc_off reads lc_line linked






































    ; True when `name` occurs in `source` as a whole token at all.
    function contains_token(source: String, name: String) @ret_nonlocal true @deep true returns bool linked

























    ; callHierarchy/outgoingCalls: the routines called from the body of the
    ; routine containing `offset`, each with the ranges of its call sites HERE.
    ; A callee is resolved to an item in this file first and only then across
    ; the workspace; one that resolves nowhere is dropped, because an item
    ; needs a location and inventing one would send the reader somewhere false.
    procedure outgoing_calls(rp, mutable source: String, mutable uri: String, offset: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads lc_line linked




























































































    ; The item for `callee`: the concept `scope` names when the call site was
    ; `.`-qualified (that concept's file may answer, nobody else), else this
    ; file's routine of that name, else the file the workspace declares it in.
    ; "" when it resolves nowhere.
    procedure outgoing_item(rp, source: String, mutable uri: String, records: String, mutable callee: String, mutable scope: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads lc_line linked



















































    ; `callee` taken from the file that declares the concept `type_name` — the
    ; call-hierarchy half of definition_in_type#. "" when the concept resolves
    ; nowhere, when it is declared in THIS file (the caller's own records answer
    ; then, and they carry the buffer rather than the saved bytes), or when that
    ; file declares no such routine.
    procedure outgoing_item_in_type(rp, source: String, mutable uri: String, callee: String, mutable type_name: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads lc_line linked


































    ; True when the newline-separated `seen` list already holds `name`.
    function seen_contains(seen: String, name: String) @ret_nonlocal true @deep true returns bool linked


















    ; The `uri` field of a Location JSON object, or "".
    function location_uri(rp, loc: String) @direct true @ret_caller true @deep true returns String linked





























    ; True when `off` falls inside any shadow range of `shadow_packed` (the
    ; newline-terminated "<start> <end>" list from shadow_ranges#).
    function in_shadow(shadow_packed: String, off: size_t) @ret_nonlocal true @deep true returns bool linked


































    ; Scan `source` for every whole-token occurrence of `name` and build the
    ; COMMA-JOINED fragment (no brackets, no leading/trailing comma) of either
    ; LSP Locations ({"uri":...,"range":...} when `want_uri`, for references) or
    ; DocumentHighlights ({"range":...} when not, for documentHighlight). Each
    ; occurrence is appended one byte at a time (the result can be large — see
    ; the STRING/JSON NOTE).
    ;
    ; Comments and string literals are skipped wholesale, so a name appearing
    ; inside them is never matched. `range_packed` confines matches to a byte
    ; range "<rstart> <rend>" (a local/parameter scoped to its declaring
    ; routine); "" scans the whole file (a module/file-wide name). `shadow_packed`
    ; (newline-terminated "<start> <end>" routine spans, "" when none) is applied
    ; on the whole-file path: a match inside a routine that binds `name` locally
    ; (a same-named parameter / `let`/`var` local) is skipped, so a module-wide
    ; rename never touches an unrelated same-named local in any file.
    procedure scan_fragment(rp, source: String, uri: String, name: String, want_uri: bool, range_packed: String, shadow_packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




















































































    ; The single-file JSON array `[ <fragment> ]` of Locations / Highlights.
    procedure scan_tokens(rp, source: String, uri: String, name: String, want_uri: bool, range_packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked

















    ; True when `path` lies under directory `dir` (dir is a prefix and either
    ; the whole path or immediately followed by a `/`). Used to drop dependency-
    ; package files from a workspace-root walk. matches_at is case-insensitive,
    ; which is fine for a path prefix (and correct on a case-insensitive FS).
    function path_under_dir(path: String, dir: String) @ret_nonlocal true @deep true returns bool linked
















    ; True when `needle` occurs anywhere in `path` (bounds-checked, unlike a
    ; bare matches_at). Used for the "/retired/" segment check.
    function path_contains(path: String, needle: String) @ret_nonlocal true @deep true returns bool linked


















    ; The current file's own package directory: the path prefix up to and
    ; including the package-name segment right after "/packages/" (e.g.
    ; ".../packages/scalyls/0.1.0/x.scaly" -> ".../packages/scalyls"), or "" when
    ; the file is not under a packages/ tree. Used so a workspace-root walk
    ; INCLUDES the package being edited but EXCLUDES sibling dependency packages.
    function current_package_dir(rp, path: String) @direct true @ret_caller true @deep true returns String linked




























    ; True when `fpath` must be excluded from a workspace-ROOT walk: a file in
    ; the reference-only retired/ tree, or a file under SOME packages/ tree that
    ; is NOT the current file's own package (i.e. a dependency / the prelude,
    ; which a user edit must never rename). `cur_pkg_dir` is the current file's
    ; own package dir ("" when it is not under a packages/ tree, in which case
    ; every packages/ file is a dependency). Applied ONLY when fanning out from
    ; an explicit root — the dir-of# fallback (the current file's own dir tree)
    ; is never filtered (Step 36 behavior). In a normal user project the prelude
    ; lives under SCALY_HOME (outside the root) so it is never even a walk
    ; candidate; this if bites the in-repo case where the prelude / sibling
    ; packages and retired/ sit under the repo root.
    function excluded_from_root_walk(rp, fpath: String, cur_pkg_dir: String) @ret_nonlocal true @deep true returns bool linked














    ; Cross-file references: a JSON array of Locations for `name` across the
    ; current file (whole-file scan) AND every other .scaly file under the walk
    ; root, each carrying its own uri. The walk root is the workspace `root`
    ; when set (so a use in a parent/sibling directory outside the current
    ; file's own dir tree is found), else the current file's directory tree
    ; (the Step 36 fallback, byte-identical). Only used for a module/file-wide
    ; name (a local/parameter is confined to its routine, in the current file).
    ; When walking an explicit root, the dependency-package and retired/ subtrees
    ; are excluded; the dir-tree fallback is never filtered. Each file's matches
    ; are gathered as a fragment and appended byte at a time (can be large).
    procedure references_workspace(rp, source: String, uri: String, name: String, mutable root: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads prof_list linked

















































































    ; True when `name` is a declared function / type / operator / namespace /
    ; module / mutable (any completion item) or a structure field — a name that
    ; legitimately occurs across routines/scopes, so references/rename must scan
    ; the whole file rather than confine to one routine. Locals and parameters
    ; are NOT here, so they get scoped.
    procedure name_is_module_wide(rp, source: String, mutable comp_items: String, scope_tbl: String, mutable uri: String, name: String) @ret_nonlocal true @deep true returns bool io mutable dir_slots, prof_list reads prof_list linked










    ; True when `name` is a function/type declared anywhere in the workspace name
    ; blob (current file's directory tree + dependency package tree), each line
    ; "<tag><TAB><name><LF>".
    procedure name_in_workspace(rp, mutable uri: String, name: String) @ret_nonlocal true @deep true returns bool io mutable dir_slots, prof_list reads prof_list linked


































    ; True when `name` equals the label of any completion item.
    procedure name_in_completion(rp, mutable comp_items: String, name: String) @ret_nonlocal true @deep true returns bool linked















    ; True when `name` is the name of a declared field/property, found by
    ; resolving each F-record offset in the scope table to its identifier token
    ; and comparing it whole-token to `name`.
    function name_is_field(rp, source: String, table: String, name: String) @ret_nonlocal true @deep true returns bool linked






































    ; True when source[off,off+nlen) equals `name` AND is a whole token (the
    ; following byte, if any, is not an identifier byte).
    function field_name_matches(source: String, off: size_t, nlen: size_t, name: String) @ret_nonlocal true @deep true returns bool linked









    ; The scan scope for the identifier `name` at `offset`: "" (whole file) for a
    ; module/file-wide name or a cursor outside any routine, else the enclosing
    ; routine's "<start> <end>" (a local/parameter is confined to its routine,
    ; eliminating cross-routine false matches).
    procedure scan_scope(rp, source: String, scope_tbl: String, mutable comp_items: String, mutable uri: String, name: String, offset: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, prof_list reads prof_list linked









    ; True when source[start,end) equals `name` byte-for-byte.
    function token_equals(source: String, start: size_t, end: size_t, name: String) @ret_nonlocal true @deep true returns bool linked














    ; LSP Location with a range covering the whole token [start,end).
    procedure location_span_object(rp, source: String, uri: String, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked












    ; ====================================================================
    ; textDocument/documentHighlight (lexical, single file)
    ;
    ; The same whole-token lexical scan as references, but the result is a
    ; DocumentHighlight[] — per-document ranges with NO uri (the editor knows
    ; the current document). The editor uses this to highlight every
    ; occurrence of the symbol under the cursor. No identifier -> `[]`.
    ; ====================================================================

    procedure highlights_packed(rp, mutable source: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads lc_line linked


































    ; LSP DocumentHighlight: {"range":{...}} covering the whole token.
    procedure highlight_object(rp, source: String, start: size_t, end: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked









    ; ====================================================================
    ; textDocument/rename + textDocument/prepareRename (lexical, single file)
    ;
    ; Rename reuses the same whole-token lexical scan as references: find the
    ; identifier under the cursor and rewrite EVERY whole-token occurrence of
    ; it in the document to the new name. The result is an LSP WorkspaceEdit
    ; ({"changes":{"<uri>":[ <TextEdit>... ]}}), each TextEdit replacing one
    ; token span with the new name. It inherits references' scan and therefore
    ; its guarantees: comments and string literals are never rewritten, a local
    ; stays inside its routine, and a routine that binds the name locally is
    ; skipped. It also inherits the one open limit — no TYPE resolution, so
    ; same-named members of different concepts rename together. No identifier
    ; under the cursor (or an empty new name) -> "" (server maps "" to null).
    ;
    ; prepareRename returns just the Range of the identifier under the cursor
    ; so the editor can pre-fill + validate the rename box; "" when the cursor
    ; is not on a renameable identifier.
    ;
    ; The TextEdit array can be large (many occurrences), so each edit is
    ; appended ONE BYTE AT A TIME (see the STRING/JSON NOTE).
    ; ====================================================================

    ; The rename request frame packs the position AND the new name as
    ; "<line> <char> <newName>" (line/char decimal, newName an identifier with
    ; no spaces). Parse all three, find the old identifier at the cursor, and
    ; build the WorkspaceEdit. "" on no identifier / empty new name.
    procedure rename_packed(rp, mutable source: String, mutable uri: String, mutable packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads prof_list linked




















































    ; Scan `source` for every whole-token occurrence of `old_name` and build the
    ; COMMA-JOINED fragment (no brackets) of LSP TextEdits replacing each with
    ; `new_name`. Comments and string literals are skipped; `range_packed`
    ; confines matches to a routine range ("" = whole file). `shadow_packed` (see
    ; scan_fragment#) skips occurrences inside a routine that binds `old_name`
    ; locally, so a module-wide rename never rewrites an unrelated same-named
    ; local. Each TextEdit is appended one byte at a time (the array can be large).
    procedure edits_fragment(rp, source: String, old_name: String, new_name: String, range_packed: String, shadow_packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked














































































    ; Single-file WorkspaceEdit {"changes":{"<uri>":[ <edits_fragment> ]}}.
    procedure rename_edits(rp, source: String, uri: String, old_name: String, new_name: String, range_packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked























    ; Cross-file rename: a WorkspaceEdit whose `changes` object carries one
    ; "<uri>":[ <edits> ] entry per file that has ≥1 occurrence of `old_name` —
    ; the current file (in-memory, whole-file scan) plus every other .scaly file
    ; under the walk root: the workspace `root` when set, else the current
    ; file's directory tree (the Step 36 fallback, byte-identical). Only used
    ; for a module/file-wide name (a local/parameter renames within its routine
    ; in the current file). When walking an explicit root the dependency-package
    ; and retired/ subtrees are excluded (renaming the prelude from a user edit
    ; would be wrong); the dir-tree fallback is never filtered. Fragments are
    ; appended byte at a time.
    procedure rename_workspace(rp, source: String, uri: String, old_name: String, new_name: String, mutable root: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, lc_col, lc_line, lc_off, prof_list reads prof_list linked




























































































    ; LSP TextEdit: {"range":<token span>,"newText":<new name>}.
    procedure text_edit_object(rp, source: String, start: size_t, end: size_t, new_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked












    ; prepareRename: the request frame packs the position as "<line> <char>"
    ; (same as hover). Return the Range of the identifier under the cursor, or
    ; "" when the cursor is not on a renameable identifier.
    procedure prepare_rename_packed(rp, source: String, packed: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked

































    ; The Range covering the identifier run at `offset` (the same span logic
    ; as identifier_at#, but returning the range instead of the text), or ""
    ; when the cursor is not on / just past an identifier.
    procedure identifier_range(rp, source: String, offset: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




































    ; ====================================================================
    ; textDocument/signatureHelp (parse-only)
    ;
    ; When the cursor is inside a call's argument list, find the function /
    ; procedure / operator / method being called (the identifier just before
    ; the enclosing `(`) and report its parameter list as an LSP SignatureHelp,
    ; with activeParameter set to the depth-0 comma count between the `(` and
    ; the cursor. The target is found by the same name-matching parse-tree walk
    ; as definition (this file first, then sibling .scaly files in the dir tree).
    ;
    ; LIMITS (lexical, like definition/references): the call target is matched
    ; by NAME only (no receiver-type resolution), so `obj.method(` resolves to
    ; the first `method` declared anywhere; constructors (`Foo(`) are not
    ; matched (no named init). String literals / comments inside the argument
    ; list can confuse the bracket scan. The cursor arrives as a packed
    ; "<line> <char>" (same as hover).
    ;
    ; Result: {"signatures":[{"label":"name(p0, p1)","parameters":[
    ;   {"label":"p0"},{"label":"p1"}]}],"activeSignature":0,
    ;   "activeParameter":<n>}  or "" (server -> result:null) when the cursor is
    ; not in a recognised call.
    ; ====================================================================

    procedure signature_packed(rp, mutable source: String, mutable uri: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked



























































    ; Scan left from `offset` for the `(` that encloses the cursor at the
    ; current argument nesting. Returns its byte offset, or the source length
    ; (a sentinel that is never a valid match, since offset <= len) when there
    ; is no enclosing `(` — including when a `[` encloses us first (an index /
    ; generic, not a call). Closing brackets raise the depth; matching openers
    ; lower it; an opener at depth 0 is the enclosing one.
    function find_enclosing_paren(source: String, offset: size_t) @ret_nonlocal true @deep true returns size_t linked










































    ; The identifier ending just before `paren_pos` (skipping whitespace), i.e.
    ; the called function's name, or "" when none (e.g. `(` after `)` or `]`).
    function name_before_paren(rp, source: String, paren_pos: size_t) @direct true @ret_caller true @deep true returns String linked























    ; The receiver identifier of a method call `recv.NAME(` whose `(` is at
    ; `paren_pos` — the token before the `.` that precedes the method name. ""
    ; when the call is not a simple `ident.NAME(` (a free function `NAME(`, or a
    ; chained/parenthesised receiver like `).NAME(`). Used to scope signatureHelp
    ; overload resolution to the receiver's concept.
    function receiver_before_method(rp, source: String, paren_pos: size_t) @direct true @ret_caller true @deep true returns String linked







































    ; Count depth-0 commas between `paren_pos` and `offset` — the 0-based index
    ; of the argument the cursor is in. Nested `()`/`[]` are skipped.
    function count_active_param(source: String, paren_pos: size_t, offset: size_t) @ret_nonlocal true @deep true returns size_t linked


























    ; ====================================================================
    ; textDocument/inlayHint (parameter-name hints, parse/lexical)
    ;
    ; At each call site `callee(arg0, arg1, …)` within the requested range,
    ; label each argument with the callee's corresponding parameter name —
    ; `f(⟨key:⟩ a, ⟨value:⟩ b)`. The parameter names are resolved by reusing the
    ; signatureHelp machinery (find_signature# intra-file, then the symindex-
    ; backed find_signature_in_workspace# cross-file), so a leading `this` is
    ; dropped the same way and the names match the signature labels.
    ;
    ; The request packs the visible range as "<sl> <sc> <el> <ec>" (4 ints). Only
    ; call sites overlapping the range are processed. Type hints additionally
    ; ride this scan (see below). LIMITS (lexical): the callee is matched by NAME
    ; (no receiver-type resolution); constructor calls `Foo(`/`Foo$(` (sigil
    ; before `(`) and `function`/`procedure`/`operator`/`define` DEFINITIONS are
    ; skipped; nameless (bare-type) parameters emit no hint. Result is the LSP
    ; InlayHint[] array, appended byte-at-a-time.
    ;
    ; PERF: a wide range can hold dozens of sites; resolving each by re-parsing
    ; the source (find_signature#/function_return_type#/members_for_type#) is
    ; O(sites x parse) and blows the worker's 8s budget on a big file. So
    ; inlay_hints_packed# builds a single-parse intra-file resolution map ONCE
    ; (binding_map#) and the per-site param-name / type inference consult it
    ; first, falling back to the cross-file path (symindex-cached for params)
    ; only on an intra-file miss.
    ; ====================================================================

    ; ----- single-parse intra-file resolution map (for inlay hints) -----
    ; binding_map# does ONE parse and emits a record per declaration:
    ;   R <0x09> name <0x09> param-labels(0x1F-joined, this-dropped) <0x09> rettype <0x0A>
    ;   C <0x09> name <0x0A>                                  (a `define` concept)
    ; Param labels / return-type bases / names contain no raw tab or newline, so
    ; the delimiters are unambiguous. The lookups scan this small blob (one record
    ; per decl, not per byte). Mirrors the scope_table# / frt_* walk 1:1.

    function bm_routine_record(rp, source: String, name: String, routine: RoutineSyntax) @direct true @ret_caller true @deep true returns String linked

































    function bm_concept_record(rp, name: String) @direct true @ret_caller true @deep true returns String linked















    function bm_target(rp, source: String, target: TargetSyntax) @direct true @ret_caller true @deep true returns String linked








    function bm_decl(rp, source: String, decl: DeclarationSyntax) @direct true @ret_caller true @deep true returns String linked
















    function bm_export(rp, source: String, export_: ExportSyntax) @direct true @ret_caller true @deep true returns String linked














    function bm_definition(rp, source: String, def: DefinitionSyntax) @direct true @ret_caller true @deep true returns String linked






























    function bm_body(rp, source: String, body: ref[BodySyntax]?) @direct true @ret_caller true @deep true returns String linked































    function bm_member(rp, source: String, member: MemberSyntax) @direct true @ret_caller true @deep true returns String linked














    function bm_namespace(rp, source: String, ns: NamespaceSyntax) @direct true @ret_caller true @deep true returns String linked



























    procedure binding_map(rp, mutable source: String) @direct true @ret_caller true @deep true returns String linked


































    ; The "Y"-prefixed 0x1F-joined param labels of the FIRST routine named `name`
    ; in the map, or "" on no match. "Y" alone = found-but-zero-arg.
    function map_labels(rp, map: String, name: String) @direct true @ret_caller true @deep true returns String linked

















































    ; The return-type base of the FIRST routine named `name` in the map, or "".
    ; ("" also when the routine returns nothing — same no-hint outcome.)
    function map_return_type(rp, map: String, name: String) @direct true @ret_caller true @deep true returns String linked









































    ; True when the map carries a concept (`define`) named `name`.
    function map_is_concept(rp, map: String, name: String) @ret_nonlocal true @deep true returns bool linked
























    ; Strip a "Y"-prefixed 0x1F-joined "name: Type" label list to a 0x1F-joined
    ; list of bare parameter NAMES, preserving positional alignment (one field
    ; per parameter, even when nameless).
    function names_from_labels(rp, payload: String) @direct true @ret_caller true @deep true returns String linked






































    procedure inlay_hints_packed(rp, mutable source: String, mutable uri: String, packed: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads lc_line linked































































































































    ; True when the identifier starting at `name_start` is the name in a routine
    ; DEFINITION (`function`/`procedure`/`operator`) or a `define` — i.e. the
    ; preceding non-whitespace token is one of those keywords. Such a `name(` is
    ; a declaration's parameter list, not a call, and must not get hints.
    function preceded_by_def_keyword(rp, source: String, name_start: size_t) @ret_nonlocal true @deep true returns bool linked



































    ; The callee's parameter NAMES (0x1F-joined) for inlay hints: resolve its
    ; SignatureHelp (intra-file, then cross-file via the symindex), then strip
    ; each parameter label "name: Type" to just "name" (a nameless bare-type
    ; parameter yields an empty segment). "" when the callee is unresolved or
    ; has no parameters (a zero-arg call has no arguments to label anyway).
    procedure call_param_names(rp, source: String, mutable uri: String, mutable callee: String, map: String) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked













































    ; Scan a call's argument list (from the `(` at `paren_pos`) and emit a
    ; comma-joined InlayHint fragment: one parameter-name hint per depth-0
    ; argument whose start offset lies within [range_start, range_end] and whose
    ; parameter (by position) has a name. Nested `()`/`[]` are skipped; the scan
    ; stops at the matching `)`.
    procedure call_arg_hints(rp, source: String, paren_pos: size_t, names: String, range_start: size_t, range_end: size_t) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




































































    ; The k-th 0x1F-separated field of `s` (0-based), or "" when out of range.
    ; (The separator is hardcoded — a u8 parameter adjacent to the size_t `k`
    ; triggers stage-0's adjacent-param mis-widening, truncating `k` to i8.)
    function nth_field(rp, s: String, k: size_t) @direct true @ret_caller true @deep true returns String linked





















    ; One LSP InlayHint: a Parameter-kind (2) hint "<name>:" at `offset`, with a
    ; trailing space (paddingRight) before the argument text.
    procedure inlay_hint_object(rp, source: String, offset: size_t, name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked




























    ; One LSP InlayHint: a Type-kind (1) hint ": <type>" at `offset` (just after
    ; the binding NAME), with a leading space (paddingLeft) after the name.
    procedure inlay_type_hint_object(rp, source: String, offset: size_t, type_name: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





























    ; One LSP InlayHint carrying a NOTE — a label that is neither a parameter name
    ; nor a type, so it takes the Type kind (LSP has only those two) and stands on
    ; its own with padding on both sides. Used by scalyls.placehints for the
    ; allocation-placement labels.
    procedure inlay_note_hint_object(rp, source: String, offset: size_t, note: String) @direct true @ret_caller true @deep true returns String mutable lc_col, lc_line, lc_off reads lc_line linked





















    ; True when `name` is a primitive / wrapper builtin (int/bool/.../pointer/ref)
    ; — these get NO type hint (a `pointer`/`ref` wrapper base is also dropped per
    ; the type-graph limits). Scans the `\n`-bracketed primitive_type_list#.
    function is_primitive_type_name(rp, name: String) @ret_nonlocal true @deep true returns bool linked


























    ; Infer the declared type (base concept name) of a `let`/`var` binding whose
    ; NAME identifier ends at `name_end`, for a Type inlay hint. "" (no hint) when
    ; the binding is annotated (`: T`), the initializer is a literal/operator, or
    ; the type can't be resolved (including a primitive result). Reuses the
    ; Step-17/22 resolvers — no new inference:
    ;   constructor `T(`/`T$(`/`T^p(`/`T[..]` -> T
    ;   call / ctor-call `T(..)`  -> T if T is a concept, else T's return type
    ;   field chain `a.b.c`       -> resolve_chain_type#
    ;   bare variable `other`     -> resolve_variable_type#
    procedure infer_binding_type(rp, mutable source: String, mutable uri: String, name_end: size_t, map: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked






















































































    ; Resolve a NAME that is either a concept (-> itself) or a routine (-> its
    ; return-type base) to a displayable type, "" otherwise (incl. a primitive
    ; result). The intra-file map answers with no extra parse; an intra-miss
    ; falls back to the cross-file (re-parsing) workspace path.
    procedure concept_or_return_type(rp, source: String, mutable uri: String, name: String, map: String) @direct true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_fresh, prof_list, prof_read reads prof_list linked























    ; Parse the program and return the SignatureHelp for the first function /
    ; procedure / operator / method named `name`, or "" on no match / parse error.
    procedure find_signature(rp, mutable source: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked































    ; One top-level declaration: a SignatureHelp if it (or a nested member) is
    ; the routine named `name`, else "".
    function sig_decl(rp, source: String, decl: DeclarationSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked






























    ; A `private` declaration unwraps to its exported construct.
    function sig_export(rp, source: String, export_: ExportSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked
















    ; A `define X`: recurse into the body / namespace / union for a member
    ; routine named `name` (a definition itself has no parameter list).
    function sig_definition(rp, source: String, def: DefinitionSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked














    ; Members of a class body.
    function sig_body(rp, source: String, body: ref[BodySyntax]?, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked



























    ; One class/union member.
    function sig_member(rp, source: String, member: MemberSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked


























    ; Nested declarations of a namespace.
    function sig_namespace(rp, source: String, ns: NamespaceSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked























    ; Body members of a union (variants carry no parameter list).
    function sig_union(rp, source: String, un: UnionSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked







    ; If the routine target is named `name`, build its SignatureHelp; else "".
    function sig_target(rp, source: String, target: TargetSyntax, name: String, active: size_t) @direct true @ret_caller true @deep true returns String linked












    ; Assemble the SignatureHelp JSON for a routine: a label "name(p0, p1)" and
    ; a parameters array, with activeParameter clamped to the last parameter.
    function build_signature(rp, source: String, name: String, routine: RoutineSyntax, active: size_t) @direct true @ret_caller true @deep true returns String linked
















































































































































    ; The reconstructed parameter labels of a routine joined by 0x1F (unit
    ; separator — never appears in a label, so an internal generic comma like
    ; `Map[String, int]` is preserved within a single label). Drops a leading
    ; `this` receiver. This is the param-label source of truth shared by the
    ; cross-file path: routine_param_detail# stores it in the ws blob and
    ; build_signature_from_labels# rebuilds the SignatureHelp from it (the
    ; intra-file build_signature# still builds its labels inline — kept untouched
    ; so the proven intra-file path is zero-risk; the two formats must match, and
    ; the cross-file LSP test asserts they do).
    function signature_param_labels(rp, source: String, routine: RoutineSyntax) @direct true @ret_caller true @deep true returns String linked



































































    ; Rebuild a SignatureHelp from a routine name + its 0x1F-joined param labels
    ; (as stored in the ws blob by routine_param_detail#) + the request's active
    ; parameter index. Mirrors build_signature#'s label/array assembly so the
    ; cross-file result is byte-identical to the intra-file one.
    function build_signature_from_labels(rp, name: String, labels: String, active: size_t) @direct true @ret_caller true @deep true returns String linked










































































































    ; The label for one parameter: "name" or "name: Type". Reconstructed from
    ; the clean ItemSyntax.name + a recursive render of the annotation's type
    ; (NOT source spans — the lexer reads one token ahead, so every syntax-node
    ; `end` overshoots into the next token; only `name` fields are reliable).
    function param_label(rp, source: String, it: ItemSyntax) @direct true @ret_caller true @deep true returns String linked






























    ; Render a TypeSyntax back to text: base name, dotted extensions, generic
    ; arguments in `[...]` (recursive), and a trailing `?` when optional. Built
    ; entirely from `name` String fields, so it is immune to the span-overshoot
    ; that makes substring of a type unreliable.
    function type_text(rp, source: String, ty: TypeSyntax) @direct true @ret_caller true @deep true returns String linked










































































    ; A {"label":<text>} parameter object.
    function param_item(rp, ptext: String) @direct true @ret_caller true @deep true returns String linked









    ; Cross-file signatureHelp: the current file's directory tree first, then —
    ; on a miss — the package dependency tree (so stdlib routines resolve), the
    ; same two-step search as find_definition_in_workspace#. "" if none.
    procedure find_signature_in_workspace(rp, mutable uri: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked












    ; Enumerate the .scaly files under `dir` (recursively) and return the first
    ; routine named `name`'s SignatureHelp (skipping `self_path`). "" if none.
    ;
    ; Step 29 follow-up: query the persistent symindex instead of re-parsing each
    ; file with find_signature#. Each cached ws record carries an "S"-tagged
    ; detail field = the routine's 0x1F-joined param labels, so the SignatureHelp
    ; is rebuilt from the cache (sig_from_ws_blob#) — no re-parse, shared with
    ; workspace/symbol + cross-file definition + member completion.
    procedure find_signature_in_dir(rp, mutable dir: String, self_path: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked































    ; Concept-scoped cross-file signatureHelp: the signature of routine `name`
    ; as declared by the concept `concept` (the receiver's resolved type), so a
    ; method call `recv.name(` picks the RIGHT overload even when an unrelated
    ; package declares a same-named routine (e.g. StringBuilder.append vs
    ; dazzle's BoundVarList.append). Directory tree first, then the package tree
    ; (matching find_signature_in_workspace#). "" when not found -> the caller
    ; falls back to the unscoped, name-only search.
    procedure find_signature_in_concept_ws(rp, mutable uri: String, concept: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked












    ; Enumerate the .scaly files under `dir` (recursively); on the first whose
    ; cached blob DEFINES `concept` (carries an "M" member record for it), return
    ; that same blob's signature for routine `name`. Mirrors find_signature_in_dir#
    ; but gates on the concept, so the signature is read from the receiver's own
    ; type's file — not the first file that happens to declare `name`. "" if none.
    procedure find_signature_in_concept_dir(rp, mutable dir: String, self_path: String, concept: String, name: String, active: size_t) @direct true @ret_caller true @deep true returns String io mutable dir_slots, idx_slots, lc_active, lc_col, lc_data, lc_len, lc_line, lc_off, prof_bytes, prof_fresh, prof_list, prof_read, prof_sig reads prof_list linked































}
