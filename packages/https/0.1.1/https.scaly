; https — the http package's server over TLS 1.3:
; the same connection loop (http.Server.serve_connection) over a TlsStream.
; Its own package, so that http alone never links OpenSSL and tls alone never
; links http.

package scaly 0.1.0
package http 0.1.0
package tls 0.1.0

define https
{
    module Server
}
