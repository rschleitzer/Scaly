; HTTP/3 over ngtcp2: a UDP socket per core on the same port (SO_REUSEPORT,
; the kernel spreading the clients over them), each served by one task on a
; thread of its own. A round receives what waits, hands every datagram to
; its connection (ngtcp2_conn_read_pkt, whose callbacks collect stream data
; and open and close streams), answers the requests that became complete,
; runs the connections' timers and writes what they have to send.
;
; A request stream is answered once its FIN arrived -- never inside an
; ngtcp2 callback, so that no handler runs in the middle of ngtcp2: its
; HEADERS (QPACK -- http.Qpack) and DATA frames become a Request for the
; same router and handlers as every other protocol, and the response they
; write becomes a HEADERS and a DATA frame on the stream, which keeps it
; until the client acknowledged it (ngtcp2 may send any of it again).
;
; Every connection opens a control stream with its SETTINGS. A QPACK
; dynamic table is offered only on request (h3_offer_qpack_table, before
; start_h3): it spares the server a tenth of its CPU in baseline-h3 and
; costs the client more than that -- its encoder keeps the table and reads
; a Section Acknowledgment per request -- so where the client is the
; bottleneck, as in HttpArena, fewer requests are answered (2026-09-30).
; Offered (with no blocked streams), the connection opens a QPACK decoder
; stream too. The client's encoder stream fills the connection's table (a
; QpackTable, made when that stream opens), and the decoder stream answers
; with what RFC 9204 4.4 asks: an Insert Count Increment after inserts, a
; Section Acknowledgment after a field section that named the table, a
; Stream Cancellation for a request stream reset unanswered. A client whose
; encoder indexes :authority and user-agent then sends them as one byte
; each instead of a Huffman-coded literal on every request. The client's
; control and QPACK decoder streams are read and dropped, and its encoder
; stream too while no table is offered.
;
; Routing: an ID this server chose carries its connection's slot and
; generation in its first eight bytes, so a datagram finds its connection
; without a table; only a client's first datagrams, under the ID it chose
; itself, are matched against the connections' remembered ones.
;
; Until 2026-09-30 this was OpenSSL's QUIC server, which keeps every stream
; a client opened until the connection ends (its GC waits for a
; STOP_SENDING that a stream read to its end never gets:
; recv_stream_fully_drained is a TODO) -- 400 bytes per request, 2 GiB in a
; run of baseline-h3.

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response
use http.Router.Router
use http.Hpack.HeaderList
use http.Qpack.QpackTable
use tls.Tls.SslCtxRef

; Our connection IDs: slot (4 bytes) and generation (4), then random.
define CID_LENGTH: size_t 18
; What a connection grants its client.
define MAX_DATA: u64 16777216
define MAX_STREAM_DATA: u64 1048576
define MAX_STREAMS_BIDI: u64 256
define IDLE_TIMEOUT_MS: u64 30000
; A datagram in, a packet out, a struct sockaddr_storage.
define RX_SIZE: size_t 65536
define TX_SIZE: size_t 1500
define ADDR_CAP: size_t 128
; The response bytes a thread's streams may hold unacknowledged: past it no
; more requests are answered until the clients took some -- their streams
; wait under QUIC's flow control. Without it every stream held its whole
; response at once: 64 connections of 64 streams of static files, static-h3
; at 2 GiB (2026-09-30).
define H3_OUTPUT_BUDGET: size_t 4194304
; Packets one connection sends in a round before the others get theirs,
; and the most one train of them carries (Linux's UDP GSO: 64 segments).
define PACKETS_PER_ROUND: int 64
define TRAIN_SEGMENTS: int 64
; A train is one UDP send of at most 64 KiB (more is EMSGSIZE; the first
; version of the trains lost a fortieth of them to it, and throughput
; halved while ngtcp2 waited to send them again).
define TRAIN_BYTES: size_t 65000

; What the h3 threads serve: set once by start_h3, before the threads.
shared atomic h3_router: u64 linked
shared atomic h3_ctx: u64 linked
; The QPACK dynamic table capacity offered, 0 for none (the default).
shared atomic h3_qpack_capacity: u64 linked

; Offer clients a QPACK dynamic table of capacity bytes (at most
; QPACK_TABLE_CAPACITY; 0: none); before start_h3.
procedure h3_offer_qpack_table(capacity: size_t) @ret_nonlocal true @deep true reads h3_qpack_capacity linked

; The QPACK dynamic table capacity offered.
procedure h3_table_capacity() @ret_nonlocal true @deep true returns size_t reads h3_qpack_capacity linked

; A QUIC variable-length integer (RFC 9000 16) at s[at]: its value, and at
; moved past it; -1 when the bytes end inside it.
procedure quic_varint(s: Slice[u8], mutable at: ref[size_t]) @ret_param_0 true @deep true returns i64 linked

procedure append_quic_varint(mutable out: ref[ByteBuf], v: u64) @ret_nonlocal true @deep true linked

; A little-endian u32 at s[at].
function cid_word(s: Slice[u8], at: size_t) @ret_param_0 true @deep true returns u32 linked

procedure put_cid_word(mutable s: Slice[u8], at: size_t, v: u32) @ret_nonlocal true @deep true linked

; A stream of a connection, on a page of its own: the request as it came,
; the response until the client acknowledged all of it.
define QStream
(
    id: i64
    page: ref[Page]
    var input: ByteBuf
    var output: ByteBuf
    ; output bytes ngtcp2 took, and those the client acknowledged
    var queued: size_t
    var acked: size_t
    ; a FIN follows the output (a response; the control stream never ends)
    var finish: bool
    var fin_sent: bool
    ; the request's FIN came; the response is in output
    var complete: bool
    var answered: bool
    var in_sendq: bool
    ; its place in its connection's streams
    var index: size_t
    ; a client's unidirectional stream: its type (RFC 9114 6.2), -1 until
    ; it arrived
    var kind: i64
)

; A connection on a page of its own.
define QConn
@resident true @inplace true (
    page: ref[Page]
    listener: pointer[void]
    slot: u32
    gen: u32
    var conn: pointer[void]
    var ssl: pointer[void]
    var octx: pointer[void]
    ; the client's address, and the ID it chose for its first datagrams
    var remote: Slice[u8]
    var remote_length: size_t
    var first_dcid: Slice[u8]
    var first_dcid_length: size_t
    ; every stream, those with something to send, those ready to answer
    var streams: Array[ref[QStream]]
    var sendq: Array[ref[QStream]]
    var readyq: Array[ref[QStream]]
    var gone: bool
    ; the QPACK dynamic table, once the client's encoder stream opened
    var table: ref[QpackTable]?
    ; our QPACK decoder stream, and the instructions waiting for room in
    ; its buffer (h3_decoder_move)
    var decoder: ref[QStream]?
    var backlog: ByteBuf
)

; The per-thread working state of answering a request.
define H3Work
(
    router: ref[Router]
    var fields: HeaderList
    var text: ByteBuf
    var body: ByteBuf
    var block: ByteBuf
    var name: ByteBuf
    req: ref[Request]
    res: ref[Response]
    outb: ref[ByteBuf]
)

; A thread's listener: its socket, its connections by slot, its buffers.
define QListener
@resident true @inplace true (
    host: ref[Page]
    fd: i32
    ctx: SslCtxRef
    var local: Slice[u8]
    var local_length: size_t
    var conns: Array[ref[QConn]?]
    var generation: u32
    ; unacknowledged response bytes of every connection (H3_OUTPUT_BUDGET)
    var pending: size_t
    var rx: Slice[u8]
    var tx: Slice[u8]
    ; a connection's packets of a round, back to back (h3_flush)
    var train: Slice[u8]
    var addr: Slice[u8]
    work: ref[H3Work]
)

; ---- ngtcp2's callbacks (with its signatures) ----------------------------

; A stream the client opened: its record, as the stream's user data.
procedure h3_stream_open(mutable conn: pointer[void], stream_id: i64, mutable user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 io linked

procedure h3_new_stream(mutable c: ref[QConn], stream_id: i64) @deep true returns ref[QStream] linked

; Stream data: kept for a request stream, to h3_uni_data for the client's
; unidirectional ones; the credit goes back at once. A FIN makes the request
; ready to answer.
procedure h3_stream_data(mutable conn: pointer[void], flags: u32, stream_id: i64, offset: u64, data: pointer[u8], datalen: size_t, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 io reads h3_qpack_capacity linked

; Data on a client's unidirectional stream, behind its type: the encoder
; stream's instructions carried out (the Insert Count Increment they owe
; into the backlog) when a table is offered, every other stream's bytes
; dropped. Not 0 when an instruction is malformed or a second encoder
; stream opens: ngtcp2 then ends the connection.
procedure h3_uni_data(mutable c: ref[QConn], mutable s: ref[QStream], bytes: Slice[u8]) @deep true returns i32 reads h3_qpack_capacity linked

; The client acknowledged datalen more bytes of a stream.
procedure h3_acked(mutable conn: pointer[void], stream_id: i64, offset: u64, datalen: u64, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 linked

; A stream is done on both sides: its record goes, and the client may open
; another request stream.
procedure h3_stream_close(mutable conn: pointer[void], flags: u32, stream_id: i64, app_error_code: u64, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 io linked

procedure h3_more_streams(mutable conn: pointer[void], max_streams: u64, mutable user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 linked

; The handshake is done: the control stream with its SETTINGS -- empty,
; or the QPACK table capacity offered, with the QPACK decoder stream.
procedure h3_handshake_completed(mutable conn: pointer[void], mutable user_data: pointer[void]) @ret_nonlocal true @deep true returns i32 io reads h3_qpack_capacity linked

; A unidirectional stream of ours with its type, queued: null when ngtcp2
; opens none.
procedure h3_open_uni(mutable conn: pointer[void], mutable c: ref[QConn], kind: u8) @page true @direct true @deep true returns ref[QStream]? io linked

; The decoder instructions of the backlog onto our decoder stream, as far
; as its buffer holds them without growing: ngtcp2 keeps pointing at the
; bytes it sent until the client acknowledges them, and a grown buffer
; moves (and may free the old one). Once all of them are acknowledged the
; buffer starts over -- the stream lives as long as the connection.
procedure h3_decoder_move(mutable c: ref[QConn]) @deep true @deep_this_1 true linked

; A new ID of ours: its slot and generation where the random bytes began.
procedure h3_new_cid(mutable user_data: pointer[void], mutable cid: pointer[u8], cidlen: size_t) @ret_nonlocal true @deep true returns i32 linked

; A stream's record gone: out of the connection's lists, its unacknowledged
; response out of the budget, its page back.
procedure h3_drop_stream(mutable c: ref[QConn], s: ref[QStream]) @ret_nonlocal true @deep true @deep_beyond_2 true @deep_this_1 true linked

procedure h3_remove(mutable list: ref[Array[ref[QStream]]], s: ref[QStream]) @deep true @deep_this_1 true linked

; ---- answering ------------------------------------------------------------

; Answer a request stream whose FIN arrived: its response into s.output.
; A malformed request gets no HEADERS, only the FIN. A request without a
; body fills the Request straight from its fields and the Response writes
; a QPACK field section (its qpack mode) -- no HTTP/1.1 text in either
; direction, which was a fifth of the samples in baseline-h3 (2026-09-30).
procedure h3_answer(mutable w: ref[H3Work], mutable c: ref[QConn], mutable s: ref[QStream]) @deep true linked

; ---- the listener ---------------------------------------------------------

; The connection a datagram's destination ID names, or null.
procedure h3_route(l: ref[QListener], dcid: Slice[u8]) @page true @direct true @ret_param_0 true @deep true returns ref[QConn]? linked

; A connection for a client's first datagram, or null when it opens none.
procedure h3_open(mutable l: ref[QListener], pkt: Slice[u8], addr: Slice[u8], now: u64) @page true @direct true @deep true @deep_this_1 true @deep_whole_1 true returns ref[QConn]? io linked

; A connection gone: a CONNECTION_CLOSE unless it went quietly (idle,
; draining, dropped), its streams, TLS and ngtcp2 state, its page.
procedure h3_close(mutable l: ref[QListener], mutable c: ref[QConn], quietly: bool, now: u64) @ret_nonlocal true @deep true @deep_beyond_2 true @deep_into_1_2 true io linked

; One datagram: to its connection, or a new one.
procedure h3_receive(mutable l: ref[QListener], pkt: Slice[u8], addr: Slice[u8], now: u64) @deep true @deep_beyond_7 true @deep_this_1 true @deep_whole_1 true io linked

; A train of a connection's packets out, in one call where the OS can.
procedure h3_send_train(l: ref[QListener], c: ref[QConn], length: size_t, segment: size_t) @ret_nonlocal true @deep true io linked

; What a connection has to send, as far as a round goes: true when it sent.
; Its packets go out in trains -- written back to back, all of one size
; but the last, sent in one call (Linux's UDP GSO) -- where a sendto each
; was half of the server's samples in the kernel in static-h3 (2026-09-30).
procedure h3_flush(mutable l: ref[QListener], mutable c: ref[QConn], now: u64) @ret_nonlocal true @deep true @deep_beyond_2 true @deep_into_1_2 true returns bool io linked

; Answer a connection's complete requests, as the budget allows.
procedure h3_answer_ready(mutable l: ref[QListener], mutable c: ref[QConn]) @deep true @deep_this_2 true linked

; The h3 task of a thread: every connection, round after round.
procedure h3_loop() @deep true io reads h3_ctx linked

procedure h3_thread(mutable arg: pointer[void]) @ret_nonlocal true @deep true returns pointer[void] io linked

; ALPN for HTTP/3: h3 when the client offers it, else nothing.
procedure h3_alpn_select(ssl: pointer[void], mutable selected: pointer[pointer[u8]], mutable selected_length: pointer[u8], offered: pointer[u8], offered_length: u32, arg: pointer[void]) @deep true returns i32 linked

; Serve router over HTTP/3 on UDP `port` with the certificate and key: a
; socket and a thread per core; false when the TLS context or the first
; socket cannot be made.
procedure start_h3(router: ref[Router], port: int, cert_file: String, key_file: String) @ret_nonlocal true @deep true returns bool io reads h3_router linked
