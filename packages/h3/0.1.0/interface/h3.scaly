; h3 -- HTTP/3 (RFC 9114) for the http package's router, over QUIC from
; ngtcp2 (ROADMAP-http.md, stage G), TLS 1.3 from OpenSSL through ngtcp2's
; crypto helper. Its own package, so that only a program serving HTTP/3
; links ngtcp2: it needs libngtcp2, libngtcp2_crypto_ossl, libssl and
; libcrypto, and the object of h3/ngtcp2_glue.c (the C this binding cannot
; do without -- see that file).

package scaly 0.1.0
package http 0.1.0
package tls 0.1.0

define h3
{
    module Ngtcp2
    module Socket
    module Server
}
