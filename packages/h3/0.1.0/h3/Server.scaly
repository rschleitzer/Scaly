; HTTP/3 over ngtcp2: a UDP socket per core on the same port (SO_REUSEPORT,
; the kernel spreading the clients over them), each served by one task on a
; thread of its own. A round receives what waits, hands every datagram to
; its connection (ngtcp2_conn_read_pkt, whose callbacks collect stream data
; and open and close streams), answers the requests that became complete,
; runs the connections' timers and writes what they have to send.
;
; A request stream is answered once its FIN arrived -- never inside an
; ngtcp2 callback, so that no handler runs in the middle of ngtcp2: its
; HEADERS (QPACK, static table only -- http.Qpack) and DATA frames become
; HTTP/1.1 request text for the same router and handlers as every other
; protocol, and the HTTP/1.1 response they write becomes a HEADERS and a
; DATA frame on the stream, which keeps it until the client acknowledged it
; (ngtcp2 may send any of it again). Every connection opens a control stream
; with an empty SETTINGS frame (a QPACK table capacity of 0 by default); the
; client's control and QPACK streams are read and dropped.
;
; Routing: an ID this server chose carries its connection's slot and
; generation in its first eight bytes, so a datagram finds its connection
; without a table; only a client's first datagrams, under the ID it chose
; itself, are matched against the connections' remembered ones.
;
; Until 2026-09-30 this was OpenSSL's QUIC server, which keeps every stream
; a client opened until the connection ends (its GC waits for a
; STOP_SENDING that a stream read to its end never gets:
; recv_stream_fully_drained is a TODO) -- 400 bytes per request, 2 GiB in a
; run of baseline-h3.

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response
use http.Router.Router
use http.Hpack.HeaderList
use tls.Tls.SslCtxRef

; Our connection IDs: slot (4 bytes) and generation (4), then random.
define CID_LENGTH: size_t 18
; What a connection grants its client.
define MAX_DATA: u64 16777216
define MAX_STREAM_DATA: u64 1048576
define MAX_STREAMS_BIDI: u64 256
define IDLE_TIMEOUT_MS: u64 30000
; A datagram in, a packet out, a struct sockaddr_storage.
define RX_SIZE: size_t 65536
define TX_SIZE: size_t 1500
define ADDR_CAP: size_t 128
; The response bytes a thread's streams may hold unacknowledged: past it no
; more requests are answered until the clients took some -- their streams
; wait under QUIC's flow control. Without it every stream held its whole
; response at once: 64 connections of 64 streams of static files, static-h3
; at 2 GiB (2026-09-30).
define H3_OUTPUT_BUDGET: size_t 4194304
; Packets one connection sends in a round before the others get theirs.
define PACKETS_PER_ROUND: int 64

; What the h3 threads serve: set once by start_h3, before the threads.
shared atomic h3_router: u64 0
shared atomic h3_ctx: u64 0

; A QUIC variable-length integer (RFC 9000 16) at s[at]: its value, and at
; moved past it; -1 when the bytes end inside it.
procedure quic_varint(s: Slice[u8], mutable at: ref[size_t]) returns i64
{
    var pos: size_t at
    if pos >= s.length
        return 0 - 1
    let first s[pos]
    let n (1 as size_t) << ((first >> 6) as size_t)
    if pos + n > s.length
        return 0 - 1
    var v: u64 (first & 63) as u64
    var k: size_t 1
    while k < n
    {
        set v: (v << 8) | (s[pos + k] as u64)
        set k: k + 1
    }
    set at: pos + n
    v as i64
}

procedure append_quic_varint(mutable out: ref[ByteBuf], v: u64)
{
    if v < 64
        out.append_byte(v as u8)
    else if v < 16384
    {
        out.append_byte((64 | (v >> 8)) as u8)
        out.append_byte((v & 255) as u8)
    }
    else if v < 1073741824
    {
        out.append_byte((128 | (v >> 24)) as u8)
        out.append_byte(((v >> 16) & 255) as u8)
        out.append_byte(((v >> 8) & 255) as u8)
        out.append_byte((v & 255) as u8)
    }
    else
    {
        out.append_byte((192 | (v >> 56)) as u8)
        var shift: u64 48
        repeat
        {
            out.append_byte(((v >> shift) & 255) as u8)
            if shift = 0
                break
            set shift: shift - 8
        }
    }
}

; A little-endian u32 at s[at].
function cid_word(s: Slice[u8], at: size_t) returns u32
    (s[at] as u32) | ((s[at + 1] as u32) << 8) | ((s[at + 2] as u32) << 16) | ((s[at + 3] as u32) << 24)

procedure put_cid_word(mutable s: Slice[u8], at: size_t, v: u32)
{
    s.put(at, (v & 255) as u8)
    s.put(at + 1, ((v >> 8) & 255) as u8)
    s.put(at + 2, ((v >> 16) & 255) as u8)
    s.put(at + 3, ((v >> 24) & 255) as u8)
}

; A stream of a connection, on a page of its own: the request as it came,
; the response until the client acknowledged all of it.
define QStream
(
    id: i64
    page: ref[Page]
    var input: ByteBuf
    var output: ByteBuf
    ; output bytes ngtcp2 took, and those the client acknowledged
    var queued: size_t
    var acked: size_t
    ; a FIN follows the output (a response; the control stream never ends)
    var finish: bool
    var fin_sent: bool
    ; the request's FIN came; the response is in output
    var complete: bool
    var answered: bool
    var in_sendq: bool
)

; A connection on a page of its own.
define QConn
(
    page: ref[Page]
    listener: pointer[void]
    slot: u32
    gen: u32
    var conn: pointer[void]
    var ssl: pointer[void]
    var octx: pointer[void]
    ; the client's address, and the ID it chose for its first datagrams
    var remote: Slice[u8]
    var remote_length: size_t
    var first_dcid: Slice[u8]
    var first_dcid_length: size_t
    ; every stream, those with something to send, those ready to answer
    var streams: Array[ref[QStream]]
    var sendq: Array[ref[QStream]]
    var readyq: Array[ref[QStream]]
    var gone: bool
)

; The per-thread working state of answering a request.
define H3Work
(
    router: ref[Router]
    var fields: HeaderList
    var text: ByteBuf
    var body: ByteBuf
    var block: ByteBuf
    var name: ByteBuf
    req: ref[Request]
    res: ref[Response]
    outb: ref[ByteBuf]
)

; A thread's listener: its socket, its connections by slot, its buffers.
define QListener
(
    host: ref[Page]
    fd: i32
    ctx: SslCtxRef
    var local: Slice[u8]
    var local_length: size_t
    var conns: Array[ref[QConn]?]
    var generation: u32
    ; unacknowledged response bytes of every connection (H3_OUTPUT_BUDGET)
    var pending: size_t
    var rx: Slice[u8]
    var tx: Slice[u8]
    var addr: Slice[u8]
    work: ref[H3Work]
)

; ---- ngtcp2's callbacks (with its signatures) ----------------------------

; A stream the client opened: its record, as the stream's user data.
procedure h3_stream_open(mutable conn: pointer[void], stream_id: i64, mutable user_data: pointer[void]) returns i32
{
    var c user_data as ref[QConn]
    let s h3_new_stream(c, stream_id)
    ngtcp2_conn_set_stream_user_data(conn, stream_id, s as pointer[void])
    0
}

procedure h3_new_stream(mutable c: ref[QConn], stream_id: i64) returns ref[QStream]
{
    let page Page.allocate_page()
    let s &QStream^page(stream_id, page, ByteBuf.create(page, 512), ByteBuf.create(page, 512), 0, 0, true, false, false, false, false)
    c.streams.add(s)
    s
}

; Stream data: kept for a request stream, dropped for the client's others;
; the credit goes back at once. A FIN makes the request ready to answer.
procedure h3_stream_data(mutable conn: pointer[void], flags: u32, stream_id: i64, offset: u64, data: pointer[u8], datalen: size_t, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) returns i32
{
    ngtcp2_conn_extend_max_stream_offset(conn, stream_id, datalen as u64)
    ngtcp2_conn_extend_max_offset(conn, datalen as u64)
    if stream_user_data = null or (stream_id & 2) <> 0
        return 0
    var s stream_user_data as ref[QStream]
    if datalen > 0
        s.input.append(Slice[u8](datalen, data))
    if (flags & NGTCP2_STREAM_DATA_FLAG_FIN) <> 0 and s.complete = false
    {
        set s.complete: true
        var c user_data as ref[QConn]
        c.readyq.add(s)
    }
    0
}

; The client acknowledged datalen more bytes of a stream.
procedure h3_acked(mutable conn: pointer[void], stream_id: i64, offset: u64, datalen: u64, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) returns i32
{
    if stream_user_data = null
        return 0
    var s stream_user_data as ref[QStream]
    set s.acked: s.acked + (datalen as size_t)
    if s.answered
    {
        let c user_data as ref[QConn]
        var l c.listener as ref[QListener]
        set l.pending: l.pending - (datalen as size_t)
    }
    0
}

; A stream is done on both sides: its record goes, and the client may open
; another request stream.
procedure h3_stream_close(mutable conn: pointer[void], flags: u32, stream_id: i64, app_error_code: u64, mutable user_data: pointer[void], mutable stream_user_data: pointer[void]) returns i32
{
    var c user_data as ref[QConn]
    if stream_user_data <> null
        h3_drop_stream(c, stream_user_data as ref[QStream])
    if (stream_id & 3) = 0
        ngtcp2_conn_extend_max_streams_bidi(conn, 1)
    0
}

procedure h3_more_streams(mutable conn: pointer[void], max_streams: u64, mutable user_data: pointer[void]) returns i32
    0

; The handshake is done: the control stream, with an empty SETTINGS frame.
procedure h3_handshake_completed(mutable conn: pointer[void], mutable user_data: pointer[void]) returns i32
{
    var c user_data as ref[QConn]
    var id: i64 0
    if ngtcp2_conn_open_uni_stream(conn, &id, null) <> 0
        return 0
    var s h3_new_stream(c, id)
    ngtcp2_conn_set_stream_user_data(conn, id, s as pointer[void])
    ; type 0 (control), SETTINGS (4) of length 0
    s.output.append_byte(0)
    s.output.append_byte(4)
    s.output.append_byte(0)
    set s.finish: false
    set s.in_sendq: true
    c.sendq.add(s)
    0
}

; A new ID of ours: its slot and generation where the random bytes began.
procedure h3_new_cid(mutable user_data: pointer[void], mutable cid: pointer[u8], cidlen: size_t) returns i32
{
    let c user_data as ref[QConn]
    if cidlen < 8
        return 0 - 1
    var s Slice[u8](cidlen, cid)
    put_cid_word(s, 0, c.slot)
    put_cid_word(s, 4, c.gen)
    0
}

; A stream's record gone: out of the connection's lists, its unacknowledged
; response out of the budget, its page back.
procedure h3_drop_stream(mutable c: ref[QConn], s: ref[QStream])
{
    if s.answered
    {
        var l c.listener as ref[QListener]
        set l.pending: l.pending - (s.output.length - s.acked)
    }
    h3_remove(&c.streams, s)
    h3_remove(&c.sendq, s)
    h3_remove(&c.readyq, s)
    s.page.deallocate_extensions()
    Page.release_page(s.page)
}

procedure h3_remove(mutable list: ref[Array[ref[QStream]]], s: ref[QStream])
{
    var i: size_t 0
    while i < list.length
    {
        let t: ref[QStream] list[i]
        if (t as pointer[void]) = (s as pointer[void])
        {
            list.put(i, list[list.length - 1])
            set list.length: list.length - 1
            return
        }
        set i: i + 1
    }
}

; ---- answering ------------------------------------------------------------

; Answer a request stream whose FIN arrived: its response into s.output.
; A malformed request gets no HEADERS, only the FIN.
procedure h3_answer(mutable w: ref[H3Work], mutable s: ref[QStream])
{
    set s.answered: true
    set s.finish: true
    let input s.input.bytes()
    w.fields.clear()
    w.body.clear()
    var headers_seen false
    var at: size_t 0
    while at < input.length
    {
        let kind quic_varint(input, &at)
        let length quic_varint(input, &at)
        if kind < 0 or length < 0 or at + (length as size_t) > input.length
            return
        let payload input.subslice(at, at + (length as size_t))
        set at: at + (length as size_t)
        if kind = 1 and headers_seen = false
        {
            if qpack_decode(payload, &w.fields) = false
                return
            set headers_seen: true
        }
        if kind = 0
            w.body.append(payload)
    }
    if headers_seen = false or fields_request_text(&w.fields, &w.text, w.body.length > 0) = false
        return
    if w.body.length > 0
    {
        w.text.append("content-length: ")
        w.text.append_uint(w.body.length as u64)
        w.text.append("\r\n\r\n")
        w.text.append(w.body.bytes())
    }
    if parse_request(w.text.bytes(), w.req) <= 0
        return
    w.outb.clear()
    dispatch(w.router, w.req, w.res)
    let response w.outb.bytes()
    ; the HEADERS frame: a field section of the status and the fields
    w.block.clear()
    qpack_begin(&w.block)
    qpack_status(&w.block, response_status(response))
    var pos response_fields_at(response)
    var body_at response.length
    repeat
    {
        var vs: size_t 0
        var ve: size_t 0
        let next next_field(response, pos, &w.name, &vs, &ve)
        if next = 0
        {
            if pos + 1 < response.length
                set body_at: pos + 2
            break
        }
        if connection_specific(w.name.bytes()) = false
            qpack_field(&w.block, w.name.bytes(), response.subslice(vs, ve))
        set pos: next
    }
    append_quic_varint(&s.output, 1)
    append_quic_varint(&s.output, w.block.length as u64)
    s.output.append(w.block.bytes())
    if body_at < response.length
    {
        let body response.slice_from(body_at)
        append_quic_varint(&s.output, 0)
        append_quic_varint(&s.output, body.length as u64)
        s.output.append(body)
    }
    w.outb.clear()
}

; ---- the listener ---------------------------------------------------------

; The connection a datagram's destination ID names, or null.
procedure h3_route(l: ref[QListener], dcid: Slice[u8]) returns ref[QConn]?
{
    if dcid.length = CID_LENGTH
    {
        let slot cid_word(dcid, 0) as size_t
        if slot < l.conns.length
        {
            let c: ref[QConn]? l.conns[slot]
            if c <> null and c.gen = cid_word(dcid, 4)
                return c
        }
    }
    ; a client's first datagrams carry the ID it chose itself
    var i: size_t 0
    while i < l.conns.length
    {
        let c: ref[QConn]? l.conns[i]
        if c <> null and c.first_dcid.slice_to(c.first_dcid_length).equals(dcid)
            return c
        set i: i + 1
    }
    null
}

; A connection for a client's first datagram, or null when it opens none.
procedure h3_open(mutable l: ref[QListener], pkt: Slice[u8], addr: Slice[u8], now: u64) returns ref[QConn]?
{
    var version: u32 0
    var dcid u8[20]
    var dcid_length: size_t 0
    var scid u8[20]
    var scid_length: size_t 0
    if scaly_quic_accept(pkt.data, pkt.length, &version, &dcid[0], &dcid_length, &scid[0], &scid_length) <> 0
        return null
    ; a free slot, or a new one
    var slot: size_t 0
    while slot < l.conns.length and l.conns[slot] <> null
        set slot: slot + 1
    if slot = l.conns.length
        l.conns.add(null)
    set l.generation: l.generation + 1
    let page Page.allocate_page()
    var own allocate_slice[u8]^page(page, CID_LENGTH)
    RAND_bytes(own.data, CID_LENGTH as i32)
    put_cid_word(own, 0, slot as u32)
    put_cid_word(own, 4, l.generation)
    var remote allocate_slice[u8]^page(page, ADDR_CAP)
    var k: size_t 0
    while k < addr.length
    {
        remote.put(k, addr[k])
        set k: k + 1
    }
    var first allocate_slice[u8]^page(page, 20)
    set k: 0
    while k < dcid_length
    {
        first.put(k, dcid[k])
        set k: k + 1
    }
    var c &QConn^page(page, l as pointer[void], slot as u32, l.generation, null, null, null, remote, addr.length, first, dcid_length, Array[ref[QStream]]^page(), Array[ref[QStream]]^page(), Array[ref[QStream]]^page(), false)
    var conn: pointer[void] null
    if scaly_quic_conn_new(&conn, &dcid[0], dcid_length, &scid[0], scid_length, own.data, CID_LENGTH, l.local.data as pointer[void], l.local_length, remote.data as pointer[void], addr.length, version, now, MAX_DATA, MAX_STREAM_DATA, MAX_STREAMS_BIDI, IDLE_TIMEOUT_MS, c as pointer[void]) <> 0
    {
        page.deallocate_extensions()
        Page.release_page(page)
        return null
    }
    set c.conn: conn
    var ssl: pointer[void] null
    var octx: pointer[void] null
    if scaly_quic_tls_new(l.ctx as pointer[void], conn, &ssl, &octx) <> 0
    {
        ngtcp2_conn_del(conn)
        page.deallocate_extensions()
        Page.release_page(page)
        return null
    }
    set c.ssl: ssl
    set c.octx: octx
    l.conns.put(slot, c)
    c
}

; A connection gone: a CONNECTION_CLOSE unless it went quietly (idle,
; draining, dropped), its streams, TLS and ngtcp2 state, its page.
procedure h3_close(mutable l: ref[QListener], mutable c: ref[QConn], quietly: bool, now: u64)
{
    if quietly = false
    {
        let n scaly_quic_close(c.conn, l.tx.data, l.tx.length, now)
        if n > 0
            scaly_eio_udp_send(l.fd, l.tx.data as pointer[void], n as size_t, c.remote.data as pointer[void], c.remote_length)
    }
    while c.streams.length > 0
    {
        let last: ref[QStream] c.streams[c.streams.length - 1]
        h3_drop_stream(c, last)
    }
    scaly_quic_tls_free(c.ssl, c.octx)
    ngtcp2_conn_del(c.conn)
    l.conns.put(c.slot as size_t, null)
    let page c.page
    page.deallocate_extensions()
    Page.release_page(page)
}

; One datagram: to its connection, or a new one.
procedure h3_receive(mutable l: ref[QListener], pkt: Slice[u8], addr: Slice[u8], now: u64)
{
    var version: u32 0
    var dcid: pointer[u8] null
    var dcid_length: size_t 0
    if scaly_quic_decode(pkt.data, pkt.length, CID_LENGTH, &version, &dcid, &dcid_length) <> 0
        return
    var found h3_route(l, Slice[u8](dcid_length, dcid))
    if found = null
        set found: h3_open(l, pkt, addr, now)
    if found = null
        return
    var c found as ref[QConn]
    let rv scaly_quic_read(c.conn, l.local.data as pointer[void], l.local_length, addr.data as pointer[void], addr.length, pkt.data, pkt.length, now) as i64
    if rv <> 0
        h3_close(l, c, rv = NGTCP2_ERR_DRAINING or rv = NGTCP2_ERR_DROP_CONN, now)
}

; What a connection has to send, as far as a round goes: true when it sent.
procedure h3_flush(mutable l: ref[QListener], mutable c: ref[QConn], now: u64) returns bool
{
    var sent false
    var packets 0
    var i: size_t 0
    repeat
    {
        ; the next stream with bytes or a FIN to hand over
        var s: ref[QStream]? null
        while i < c.sendq.length
        {
            var q: ref[QStream] c.sendq[i]
            if q.queued < q.output.length or (q.finish and q.fin_sent = false)
            {
                set s: q
                break
            }
            c.sendq.put(i, c.sendq[c.sendq.length - 1])
            set c.sendq.length: c.sendq.length - 1
            set q.in_sendq: false
        }
        var stream_id: i64 0 - 1
        var flags: u32 NGTCP2_WRITE_STREAM_FLAG_MORE
        var data: pointer[u8] null
        var length: size_t 0
        if s <> null
        {
            let t s as ref[QStream]
            set stream_id: t.id
            let rest t.output.bytes().slice_from(t.queued)
            set data: rest.data
            set length: rest.length
            if t.finish
                set flags: flags | NGTCP2_WRITE_STREAM_FLAG_FIN
        }
        var consumed: i64 0 - 1
        let n scaly_quic_write(c.conn, l.tx.data, l.tx.length, &consumed, flags, stream_id, data, length, now)
        if s <> null and consumed >= 0
        {
            var t s as ref[QStream]
            set t.queued: t.queued + (consumed as size_t)
            if t.finish and t.queued = t.output.length
                set t.fin_sent: true
        }
        if n = NGTCP2_ERR_WRITE_MORE
            continue
        if n = NGTCP2_ERR_STREAM_DATA_BLOCKED or n = NGTCP2_ERR_STREAM_SHUT_WR or n = NGTCP2_ERR_STREAM_NOT_FOUND
        {
            ; this stream waits for credit: the next one
            set i: i + 1
            continue
        }
        if n < 0
        {
            h3_close(l, c, false, now)
            return sent
        }
        if n = 0
            break
        scaly_eio_udp_send(l.fd, l.tx.data as pointer[void], n as size_t, c.remote.data as pointer[void], c.remote_length)
        set sent: true
        set packets: packets + 1
        if packets >= PACKETS_PER_ROUND
            break
        ; a new packet: every stream may have room again
        set i: 0
    }
    ngtcp2_conn_update_pkt_tx_time(c.conn, now)
    sent
}

; Answer a connection's complete requests, as the budget allows.
procedure h3_answer_ready(mutable l: ref[QListener], mutable c: ref[QConn])
{
    while c.readyq.length > 0 and l.pending < H3_OUTPUT_BUDGET
    {
        var s: ref[QStream] c.readyq[0]
        c.readyq.put(0, c.readyq[c.readyq.length - 1])
        set c.readyq.length: c.readyq.length - 1
        h3_answer(l.work, s)
        set l.pending: l.pending + s.output.length
        if s.in_sendq = false
        {
            set s.in_sendq: true
            c.sendq.add(s)
        }
    }
}

; The h3 task of a thread: every connection, round after round.
procedure h3_loop()
{
    let fd ((Scheduler.task_arg() as size_t) as i64) as i32
    let ctx (scaly_atomic_load_u64(&h3_ctx) as size_t) as SslCtxRef
    let router (scaly_atomic_load_u64(&h3_router) as size_t) as ref[Router]
    let host Page.allocate_page()
    let outb &ByteBuf^host(host, allocate_slice[u8]^host(host, 16384), 0, false)
    let w &H3Work^host(router, HeaderList.create(host), ByteBuf.create(host, 1024), ByteBuf.create(host, 1024), ByteBuf.create(host, 1024), ByteBuf.create(host, 64), &Request^host(null, null, null, null, null, null, 1, true, null, null), Response.create(host, outb), outb)
    var l &QListener^host(host, fd, ctx, allocate_slice[u8]^host(host, ADDR_CAP), 0, Array[ref[QConn]?]^host(), 0, 0, allocate_slice[u8]^host(host, RX_SIZE), allocate_slice[u8]^host(host, TX_SIZE), allocate_slice[u8]^host(host, ADDR_CAP), w)
    var local_length: size_t 0
    scaly_eio_sockname(fd, l.local.data as pointer[void], ADDR_CAP, &local_length)
    set l.local_length: local_length
    repeat
    {
        var got 0
        repeat
        {
            var addr_length: size_t 0
            let n scaly_eio_udp_recv(fd, l.rx.data as pointer[void], l.rx.length, l.addr.data as pointer[void], l.addr.length, &addr_length)
            if n < 0
                break
            set got: got + 1
            h3_receive(l, l.rx.slice_to(n as size_t), l.addr.slice_to(addr_length), scaly_eio_now_ns() as u64)
            if got >= 256
                break
        }
        let now scaly_eio_now_ns() as u64
        var active false
        var i: size_t 0
        while i < l.conns.length
        {
            let found: ref[QConn]? l.conns[i]
            if found <> null
            {
                var c found as ref[QConn]
                h3_answer_ready(l, c)
                var alive true
                if ngtcp2_conn_get_expiry(c.conn) <= now
                {
                    let rv ngtcp2_conn_handle_expiry(c.conn, now) as i64
                    if rv <> 0
                    {
                        h3_close(l, c, rv = NGTCP2_ERR_IDLE_CLOSE, now)
                        set alive: false
                    }
                }
                if alive and h3_flush(l, c, now)
                    set active: true
            }
            set i: i + 1
        }
        if got = 0 and active = false
            Scheduler.sleep(1)
    }
}

procedure h3_thread(mutable arg: pointer[void]) returns pointer[void]
{
    let page Page.allocate_page()
    let sched Scheduler.create(page)
    Scheduler.spawn_arg(&h3_loop, arg)
    Scheduler.run()
    null
}

; ALPN for HTTP/3: h3 when the client offers it, else nothing.
procedure h3_alpn_select(ssl: pointer[void], mutable selected: pointer[pointer[u8]], mutable selected_length: pointer[u8], offered: pointer[u8], offered_length: u32, arg: pointer[void]) returns i32
{
    if alpn_pick(offered, offered_length, "h3", selected, selected_length)
        return SSL_TLSEXT_ERR_OK
    SSL_TLSEXT_ERR_NOACK
}

; Serve router over HTTP/3 on UDP `port` with the certificate and key: a
; socket and a thread per core; false when the TLS context or the first
; socket cannot be made.
procedure start_h3(router: ref[Router], port: int, cert_file: String, key_file: String) returns bool
{
    var ctx SSL_CTX_new(TLS_server_method())
    if ctx = null
        return false
    SSL_CTX_set_options(ctx, TLS13_ONLY | SERVER_PREFERENCE)
    if SSL_CTX_use_certificate_chain_file(ctx, cert_file.to_c_string()) <> 1 or SSL_CTX_use_PrivateKey_file(ctx, key_file.to_c_string(), SSL_FILETYPE_PEM) <> 1 or SSL_CTX_check_private_key(ctx) <> 1
    {
        SSL_CTX_free(ctx)
        return false
    }
    SSL_CTX_set_alpn_select_cb(ctx, &h3_alpn_select, null)
    if scaly_quic_setup(&h3_stream_data, &h3_acked, &h3_stream_open, &h3_stream_close, &h3_more_streams, &h3_handshake_completed, &h3_new_cid) <> 0
        return false
    let cores scaly_eio_ncpu()
    var spread cores > 1
    var first quic_socket(port, spread)
    if first < 0 and spread
    {
        ; no SO_REUSEPORT (Windows): one socket
        set first: quic_socket(port, false)
        set spread: false
    }
    if first < 0
        return false
    scaly_atomic_store_u64(&h3_router, router as u64)
    scaly_atomic_store_u64(&h3_ctx, ctx as u64)
    Thread.spawn(&h3_thread, ((first as i64) as size_t) as pointer[void])
    var k 1
    while spread and k < cores
    {
        let more quic_socket(port, true)
        if more < 0
            break
        Thread.spawn(&h3_thread, ((more as i64) as size_t) as pointer[void])
        set k: k + 1
    }
    true
}
