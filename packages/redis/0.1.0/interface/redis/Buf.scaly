; The byte buffer a command is built in and a reply read into: growable,
; on a page its owner names (a connection's). A growth takes a larger block
; on the same page and leaves the old one to the page.

define RespBuf
(
    host: ref[Page]
    var data: Slice[u8]
    var length: size_t
)
{
    procedure create(host: ref[Page], capacity: size_t) @page true @direct true @ret_explicit_0 true @deep true returns RespBuf linked

    ; The filled part.
    function bytes(this) @ret_param_0 true @deep true returns Slice[u8] linked

    ; The unfilled part — where a read goes.
    function spare(this) @ret_param_0 true @deep true returns Slice[u8] linked

    procedure clear(mutable this) @deep true linked

    ; n more bytes are filled (a read wrote them into spare()).
    procedure advance(mutable this, n: size_t) @deep true linked

    ; Room for n more bytes: at least double on growth.
    procedure reserve(mutable this, n: size_t) @deep true linked

    procedure append(mutable this, s: Slice[u8]) @deep true linked

    procedure append_byte(mutable this, b: u8) @persists true @deep true linked

    ; A decimal integer.
    procedure append_decimal(mutable this, v: i64) @deep true linked
}

; A decimal integer at the front of s (an optional '-'); 0 for none.
function resp_decimal(s: Slice[u8]) @ret_nonlocal true @deep true returns i64 linked
