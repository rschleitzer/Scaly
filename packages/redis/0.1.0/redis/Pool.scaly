; Connections pooled per scheduler thread, as pg pools its own: every
; `mutable` global is thread-local, so each thread keeps its idle list with
; no lock; a task takes a connection, runs its command (parking on the
; socket while the scheduler runs other requests) and gives it back. A
; thread opens at most max_connections / threads of them; a task that finds
; none idle and the limit reached suspends until one is given back.
;
; The server comes from REDIS_URL (redis://host:port, the port defaulting
; to 6379; a user, password or database in the URL is not used) and the
; bound from REDIS_MAX_CONN (default 256), read once per thread.

use redis.Conn.RedisConn

define RedisPool
(
    host_name: String
    port: int
    var idle: Array[ref[RedisConn]]
    var open_count: int
    limit: int
    ; tasks suspended for a connection and what redis_release handed
    ; each, as in pg's pool
    var waiters: Array[ref[SchedTask]]
    var waiter_head: size_t
    var handed: Array[ref[RedisConn]?]
    var handed_head: size_t
)

; This thread's pool, made at its first acquire.
mutable redis_pool: ref[RedisPool]? null

procedure strlen(s: pointer[const_char]) returns size_t extern

; The environment variable name as bytes, empty when unset.
procedure redis_env(name: pointer[const_char]) returns Slice[u8]
{
    let v getenv(name)
    if v = null
        return Slice[u8](0, null)
    Slice[u8](strlen(v), v as pointer[u8])
}

; This thread's pool, made from the environment on first use.
procedure redis_pool_of_thread() returns ref[RedisPool] mutable redis_pool
{
    let existing redis_pool
    if existing <> null
        return existing as ref[RedisPool]
    let host Page.allocate_page()
    var s redis_env("REDIS_URL")
    var i: size_t 0
    while i + 2 < s.length and (s[i] <> 58 or s[i + 1] <> 47 or s[i + 2] <> 47)
        set i: i + 1
    if i + 2 < s.length
        set s: s.slice_from(i + 3)
    var at: size_t 0
    while at < s.length and s[at] <> 64
        set at: at + 1
    if at < s.length
        set s: s.slice_from(at + 1)
    var slash: size_t 0
    while slash < s.length and s[slash] <> 47
        set slash: slash + 1
    let hostport s.slice_to(slash)
    var pc: size_t 0
    while pc < hostport.length and hostport[pc] <> 58
        set pc: pc + 1
    var name hostport.slice_to(pc)
    if name.length = 0
        set name: "127.0.0.1"
    var port 6379
    if pc < hostport.length
        set port: resp_decimal(hostport.slice_from(pc + 1)) as int
    var max resp_decimal(redis_env("REDIS_MAX_CONN"))
    if max <= 0
        set max: 256
    var per max / (TaskPool.ncpu() as i64)
    if per < 1
        set per: 1
    let made &RedisPool^host(String^host(name.data as pointer[const_char], name.length), port, Array[ref[RedisConn]]^host(), 0, per as int, Array[ref[SchedTask]]^host(), 0, Array[ref[RedisConn]?]^host(), 0)
    set redis_pool: made
    made
}

; Open one connection in a place this thread's pool has counted; null
; (and the place given back) when the server cannot be reached.
procedure redis_open_one(mutable p: ref[RedisPool]) returns ref[RedisConn]?
{
    var h String(p.host_name)
    let c RedisConn.connect(h, p.port)
    if c = null
        set p.open_count: p.open_count - 1
    c
}

; A connection of this thread's pool, null when the server cannot be
; reached. Give it back with redis_release. When none is idle and the pool is
; full, the task SUSPENDS in a first-come queue until redis_release hands it one
; -- a yield loop here kept the ready queue full and starved the very
; I/O it waited for (2026-09-29, async-db at 512 connections).
procedure redis_acquire() returns ref[RedisConn]? mutable redis_pool
{
    let p redis_pool_of_thread()
    repeat
    {
        if p.idle.length > 0
        {
            let c p.idle.at(p.idle.length - 1)
            set p.idle.length: p.idle.length - 1
            return c
        }
        if p.open_count < p.limit
        {
            set p.open_count: p.open_count + 1
            return redis_open_one(p)
        }
        let me Scheduler.running()
        if me = null
        {
            ; the main context: no task runs that could give one back
            Scheduler.yield()
            continue
        }
        p.waiters.add(me)
        Scheduler.suspend()
        ; redis_release handed this task a connection, or a counted place to
        ; open one in (null)
        let got: ref[RedisConn]? p.handed.at(p.handed_head)
        set p.handed_head: p.handed_head + 1
        if p.handed_head = p.handed.length
        {
            set p.handed.length: 0
            set p.handed_head: 0
        }
        if got <> null
            return got
        return redis_open_one(p)
    }
}

; Give a connection back: to the first suspended task when one waits,
; else to the idle list. One that broke is closed; its place goes to the
; waiter, or is freed.
procedure redis_release(mutable c: ref[RedisConn]) mutable redis_pool
{
    let p redis_pool_of_thread()
    var keep: ref[RedisConn]? null
    if c.is_open()
        set keep: c
    else
        c.close()
    if p.waiter_head < p.waiters.length
    {
        let t p.waiters.at(p.waiter_head)
        set p.waiter_head: p.waiter_head + 1
        if p.waiter_head = p.waiters.length
        {
            set p.waiters.length: 0
            set p.waiter_head: 0
        }
        p.handed.add(keep)
        Scheduler.resume(t)
        return
    }
    if keep <> null
    {
        p.idle.add(keep)
        return
    }
    set p.open_count: p.open_count - 1
}
