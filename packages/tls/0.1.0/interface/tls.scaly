; tls — TLS 1.3 for a TcpStream (ROADMAP-http.md, stage D), bound to OpenSSL
; (the author's decision 1 of 2026-09-28: cryptography is bound, not
; written). Its own package, so that a program which never speaks TLS does
; not link libssl. Crypto holds the hashes and key derivations a protocol above
; it needs (SCRAM for Postgres) from the same libcrypto.

package scaly 0.1.0

; libssl and libcrypto, found and linked by the tool (OpenSSL 3)
extern ssl, crypto

define tls
{
    module Tls
    module Crypto
}
