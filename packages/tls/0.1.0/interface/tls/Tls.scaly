; TLS over a TcpStream through OpenSSL 3 (libssl, libcrypto), bound
; directly: every function used takes pointers, `int` flags and `size_t`
; counts (the `_ex` forms of read and write), so no C shim is needed
; (the containment rule) and no `long` crosses the boundary --
; the protocol-version switch is SSL_CTX_set_options, which takes and
; answers a uint64_t, not the SSL_CTX_ctrl macro behind
; SSL_CTX_set_min_proto_version. The package root declares `extern ssl,
; crypto`; the tool finds and links them.
;
; OpenSSL never touches the socket. The bytes read from the TcpStream are
; written into a MEMORY BIO that OpenSSL reads; what OpenSSL writes goes
; through a BIO of ours (tls_out_write) straight into the connection's send
; buffer, which flush hands the TcpStream in one write. So the TLS layer
; rides on the runtime's own evented I/O (io_uring or epoll, a fiber parking
; on readiness), and OpenSSL's "want read" means exactly one thing: read
; more bytes from the stream. The records went into a second memory BIO
; until 2026-09-30, and out of it again 17 KB at a time: half the copying in
; the server's profile under static-h2, and a write for every 17 KB.
;
; TLS 1.3 only: the versions below it are switched off on every context.


define SslMethodOpaque()
define SslMethod pointer[SslMethodOpaque]
define SslCtxOpaque()
define SslCtxRef pointer[SslCtxOpaque]
define SslOpaque()
define SslRef pointer[SslOpaque]
define BioMethodOpaque()
define BioMethod pointer[BioMethodOpaque]
define BioOpaque()
define BioRef pointer[BioOpaque]

; Each binding declares what it writes: a `procedure` extern writes exactly
; the parameters it marks `mutable` (an object's own state, an output buffer
; and its count), and the write census takes that as the contract.
procedure TLS_server_method() returns SslMethod extern
procedure TLS_client_method() returns SslMethod extern
procedure SSL_CTX_new(method: SslMethod) returns SslCtxRef extern
procedure SSL_CTX_free(mutable ctx: SslCtxRef) extern
procedure SSL_CTX_use_certificate_chain_file(mutable ctx: SslCtxRef, file: pointer[const_char]) returns i32 extern
procedure SSL_CTX_use_PrivateKey_file(mutable ctx: SslCtxRef, file: pointer[const_char], filetype: i32) returns i32 extern
procedure SSL_CTX_check_private_key(ctx: SslCtxRef) returns i32 extern
procedure SSL_CTX_set_options(mutable ctx: SslCtxRef, options: u64) returns u64 extern
procedure SSL_CTX_set_ciphersuites(mutable ctx: SslCtxRef, suites: pointer[const_char]) returns i32 extern
procedure SSL_CTX_set_alpn_select_cb(mutable ctx: SslCtxRef, cb: pointer[void], arg: pointer[void]) extern
procedure SSL_CTX_set_alpn_protos(mutable ctx: SslCtxRef, protos: pointer[u8], protos_len: u32) returns i32 extern
procedure SSL_get0_alpn_selected(ssl: SslRef, mutable data: pointer[pointer[u8]], mutable len: pointer[u32]) extern
procedure SSL_new(mutable ctx: SslCtxRef) returns SslRef extern
procedure SSL_free(mutable ssl: SslRef) extern
procedure SSL_set_accept_state(mutable ssl: SslRef) extern
procedure SSL_set_connect_state(mutable ssl: SslRef) extern
procedure SSL_set_bio(mutable ssl: SslRef, mutable rbio: BioRef, mutable wbio: BioRef) extern
procedure SSL_do_handshake(mutable ssl: SslRef) returns i32 extern
procedure SSL_read_ex(mutable ssl: SslRef, mutable buf: pointer[void], num: size_t, mutable readbytes: pointer[size_t]) returns i32 extern
procedure SSL_write_ex(mutable ssl: SslRef, buf: pointer[void], num: size_t, mutable written: pointer[size_t]) returns i32 extern
procedure SSL_get_error(ssl: SslRef, ret: i32) returns i32 extern
procedure SSL_shutdown(mutable ssl: SslRef) returns i32 extern
procedure BIO_s_mem() returns BioMethod extern
procedure BIO_new(method: BioMethod) returns BioRef extern
procedure BIO_write_ex(mutable bio: BioRef, data: pointer[void], dlen: size_t, mutable written: pointer[size_t]) returns i32 extern
procedure BIO_read_ex(mutable bio: BioRef, mutable data: pointer[void], dlen: size_t, mutable readbytes: pointer[size_t]) returns i32 extern
procedure BIO_ctrl_pending(mutable bio: BioRef) returns size_t extern
procedure BIO_meth_new(kind: i32, name: pointer[const_char]) returns BioMethod extern
procedure BIO_meth_free(mutable method: BioMethod) extern
procedure BIO_free(mutable bio: BioRef) returns i32 extern
procedure BIO_meth_set_write_ex(mutable method: BioMethod, write: pointer[void]) returns i32 extern
procedure BIO_meth_set_ctrl(mutable method: BioMethod, ctrl: pointer[void]) returns i32 extern
procedure BIO_set_data(mutable bio: BioRef, data: pointer[void]) extern
procedure BIO_get_data(bio: BioRef) returns pointer[void] extern
procedure BIO_set_init(mutable bio: BioRef, ready: i32) extern

define SSL_FILETYPE_PEM: i32 1
define SSL_ERROR_WANT_READ: i32 2
define SSL_ERROR_WANT_WRITE: i32 3
define SSL_ERROR_ZERO_RETURN: i32 6
define SSL_TLSEXT_ERR_OK: i32 0
define SSL_TLSEXT_ERR_NOACK: i32 3
; SSL_OP_NO_SSLv3 | SSL_OP_NO_TLSv1 | SSL_OP_NO_TLSv1_2 | SSL_OP_NO_TLSv1_1
define TLS13_ONLY: u64 0x1E000000
; SSL_OP_CIPHER_SERVER_PREFERENCE: the server's order of the suites decides
define SERVER_PREFERENCE: u64 0x400000

; What moves from the TcpStream into the read BIO at a time: a TLS record
; is at most 16 KB of payload plus its overhead.
define TLS_CHUNK: size_t 17408
; The plaintext TlsStream.write encrypts before it sends: the records of 64
; KB go out in one write, and the send buffer stays near that size.
define TLS_WRITE_SLICE: size_t 65536
; BIO_TYPE_SOURCE_SINK, and BIO_CTRL_FLUSH (the one control the write BIO
; answers: its records wait in the send buffer until TlsStream.flush)
define BIO_TYPE_SOURCE_SINK: i32 1024
define BIO_CTRL_FLUSH: i32 11

; A connection's send buffer: the records OpenSSL wrote since the last
; flush, on a page of its own (the BIO points at it; a TlsStream is a value
; and moves). Small it grows on the page, past 1 KB on exclusive pages of
; its own, the old one given back at once (ByteBuf's policy).
define TlsOut
(
    page: ref[Page]
    var data: Slice[u8]
    var length: size_t
    var owned: bool
)
{
    procedure append(mutable this, bytes: Slice[u8]) @deep true linked

    procedure grow(mutable this, n: size_t) @ret_nonlocal true @deep true linked
}

; The write BIO's write: OpenSSL's records onto the send buffer.
procedure tls_out_write(mutable bio: BioRef, data: pointer[u8], dlen: size_t, mutable written: pointer[size_t]) @ret_nonlocal true @deep true returns i32 io linked

; The write BIO's control: a flush succeeds (the send buffer is flushed by
; TlsStream.flush), every other control is not ours. OpenSSL declares larg
; and the result `long`: 32 bits on Win64, where only the low half of the
; register is read and larg is not looked at -- 0 and 1 read the same.
procedure tls_out_ctrl(mutable bio: BioRef, cmd: i32, larg: i64, mutable parg: pointer[void]) @ret_nonlocal true @deep true returns i64 linked

; ALPN on the server (RFC 7301): h2 when the context prefers it (a non-null
; `arg`, TlsContext.prefer_h2) and the client offers it, else http/1.1 when
; offered, else no protocol at all (the extension is left out and the client
; falls back) — never one the client did not offer. Called by OpenSSL during
; the handshake; `offered` is the client's list of length-prefixed names.
procedure alpn_select(ssl: SslRef, mutable selected: pointer[pointer[u8]], mutable selected_length: pointer[u8], offered: pointer[u8], offered_length: u32, arg: pointer[void]) @deep true returns i32 linked

; Select `want` from the client's ALPN list if it is there.
procedure alpn_pick(offered: pointer[u8], offered_length: u32, want: Slice[u8], mutable selected: pointer[pointer[u8]], mutable selected_length: pointer[u8]) @ret_nonlocal true @deep true returns bool linked

; A TLS context: a server's certificate chain and key, or a client's
; defaults. It is not valid() when a file could not be read or the key does
; not match the certificate.
define TlsContext(var ctx: SslCtxRef)
{
    ; A server context from a PEM certificate chain and its PEM key.
    procedure server(cert_file: String, key_file: String) @page true @direct true @ret_caller true @deep true returns TlsContext io linked

    ; A client context. It does not verify the server's certificate: its
    ; one use so far is talking to our own server in a test.
    procedure client() @page true @direct true @ret_caller true @deep true returns TlsContext io linked

    ; Offer ALPN protocols as a client: `protos` is the wire form, each name
    ; after its length byte (8, then "http/1.1"). False when OpenSSL refuses.
    procedure offer_protocols(mutable this, protos: Slice[u8]) @ret_caller true @deep true returns bool io linked

    ; Choose h2 by ALPN when the client offers it (the http package serves
    ; HTTP/2 on a connection that begins with its preface).
    procedure prefer_h2(mutable this) @ret_caller true @deep true io linked

    function valid(this) @ret_param_0 true @deep true returns bool linked

    procedure free(mutable this) @deep true io linked
}

; A TLS connection over a TcpStream. Not is_open() when the handshake
; failed; the TcpStream is closed then too.
define TlsStream(var ssl: SslRef, var rbio: BioRef, var wbio: BioRef, var tcp: TcpStream, var method: BioMethod, var out: ref[TlsOut]?)
{
    ; The server side of the handshake on tcp.
    procedure accept(mutable context: TlsContext, mutable tcp: TcpStream) @page true @direct true @deep true returns TlsStream io linked

    ; The client side of the handshake on tcp.
    procedure connect(mutable context: TlsContext, mutable tcp: TcpStream) @page true @direct true @deep true returns TlsStream io linked

    procedure start(mutable context: TlsContext, mutable tcp: TcpStream, server: bool) @page true @direct true @deep true returns TlsStream io linked

    function is_open(this) @ret_param_0 true @deep true returns bool linked

    ; The protocol ALPN settled on, empty when none was.
    procedure protocol(this) @page true @direct true @ret_nonlocal true @deep true returns Slice[u8] io linked

    ; Read up to buf.length bytes of plaintext into buf: the count, 0 at the
    ; end of the stream (a close_notify, or the peer's TCP end), -1 on an
    ; error.
    procedure read(mutable this, mutable buf: Slice[u8]) @ret_nonlocal true @deep true returns int io linked

    ; Write ALL of data, TLS_WRITE_SLICE of plaintext at a time; false on an
    ; error.
    procedure write(mutable this, data: Slice[u8]) @ret_nonlocal true @deep true returns bool io linked

    ; Send the close_notify, free the connection (the SSL frees its BIOs),
    ; the write BIO's method and the send buffer's page, close the
    ; TcpStream.
    procedure close(mutable this) @ret_nonlocal true @deep true io linked

    ; Everything OpenSSL has written since the last flush, out through the
    ; TcpStream in one write.
    procedure flush(mutable this) @ret_nonlocal true @deep true returns bool io linked

    ; One read from the TcpStream into rbio: the count, 0 at its end, -1 on
    ; an error.
    procedure feed(mutable this) @ret_nonlocal true @deep true returns int io linked
}
