; QUIC (RFC 9000) as OpenSSL 3.5+ serves it: a listener on a UDP socket,
; connections and their streams as SSL objects in non-blocking mode, driven
; by SSL_handle_events -- the transport under HTTP/3 (ROADMAP-http.md,
; stage G). The socket comes from OpenSSL's portable BIO_* calls, so no
; address-family constant (AF_INET6 is 10 on Linux, 30 on macOS) is written
; in Scaly and no C shim is needed.

procedure OSSL_QUIC_server_method() returns SslMethod extern
procedure SSL_new_listener(mutable ctx: SslCtxRef, flags: u64) returns SslRef extern
procedure SSL_listen(mutable ssl: SslRef) returns i32 extern
procedure SSL_accept_connection(mutable ssl: SslRef, flags: u64) returns SslRef extern
procedure SSL_accept_stream(mutable ssl: SslRef, flags: u64) returns SslRef extern
procedure SSL_new_stream(mutable ssl: SslRef, flags: u64) returns SslRef extern
procedure SSL_set_incoming_stream_policy(mutable ssl: SslRef, policy: i32, aec: u64) returns i32 extern
procedure SSL_set_default_stream_mode(mutable ssl: SslRef, mode: u32) returns i32 extern
procedure SSL_set_blocking_mode(mutable ssl: SslRef, blocking: i32) returns i32 extern
procedure SSL_handle_events(mutable ssl: SslRef) returns i32 extern
procedure SSL_get_stream_type(ssl: SslRef) returns i32 extern
procedure SSL_set_fd(mutable ssl: SslRef, fd: i32) returns i32 extern
procedure SSL_write_ex2(mutable ssl: SslRef, buf: pointer[void], num: size_t, flags: u64, mutable written: pointer[size_t]) returns i32 extern
procedure SSL_stream_conclude(mutable ssl: SslRef, flags: u64) returns i32 extern
procedure SSL_get_conn_close_info(ssl: SslRef, mutable info: pointer[void], info_len: size_t) returns i32 extern

define BioAddrInfoOpaque()
define BioAddrInfo pointer[BioAddrInfoOpaque]
define BioAddrOpaque()
define BioAddr pointer[BioAddrOpaque]

procedure BIO_lookup_ex(host: pointer[const_char], service: pointer[const_char], lookup_type: i32, family: i32, socktype: i32, protocol: i32, mutable res: pointer[BioAddrInfo]) returns i32 extern
procedure BIO_ADDRINFO_family(ai: BioAddrInfo) returns i32 extern
procedure BIO_ADDRINFO_address(ai: BioAddrInfo) returns BioAddr extern
procedure BIO_ADDRINFO_free(mutable ai: BioAddrInfo) extern
procedure BIO_socket(domain: i32, socktype: i32, protocol: i32, options: i32) returns i32 extern
procedure BIO_bind(sock: i32, addr: BioAddr, options: i32) returns i32 extern
procedure BIO_socket_nbio(fd: i32, mode: i32) returns i32 extern
procedure BIO_closesocket(sock: i32) returns i32 extern
; SO_REUSEPORT on a socket not bound yet (the runtime's shim, whose constant
; is the OS's): 0 when set, -1 where it cannot be.
procedure scaly_eio_reuseport(fd: i32) returns i32 extern

define SSL_ACCEPT_NO_BLOCK: u64 1
define SSL_STREAM_FLAG_UNI: u64 1
define SSL_WRITE_FLAG_CONCLUDE: u64 1
define SSL_INCOMING_STREAM_POLICY_ACCEPT: i32 1
define SSL_DEFAULT_STREAM_MODE_NONE: u32 0
define SSL_STREAM_TYPE_BIDI: i32 3
; BIO_lookup_ex: a server's address; SOCK_DGRAM (2 on Linux and macOS)
define BIO_LOOKUP_SERVER: i32 1
define SOCK_DGRAM: i32 2
define BIO_SOCK_REUSEADDR: i32 1
; sizeof(SSL_CONN_CLOSE_INFO): two u64, a pointer, a size_t, a u32, padded
define CONN_CLOSE_INFO_SIZE: size_t 40

; ALPN for HTTP/3: h3 when the client offers it, else nothing.
procedure alpn_select_h3(ssl: SslRef, mutable selected: pointer[pointer[u8]], mutable selected_length: pointer[u8], offered: pointer[u8], offered_length: u32, arg: pointer[void]) @deep true returns i32 linked

; A UDP socket bound to `port` on every interface (dual-stack where the
; system allows it), non-blocking; -1 when it cannot be made. With spread
; it takes SO_REUSEPORT, so that more of them bind the port and the kernel
; spreads the clients over them.
procedure quic_socket(port: int, spread: bool) @ret_caller true @deep true returns i32 io linked

; A QUIC server: its context (certificate, key, ALPN h3) and its listener
; on a UDP port -- one of several on it with spread (quic_socket). Not
; valid() when either could not be made.
define QuicServer(var ctx: SslCtxRef, var listener: SslRef)
{
    procedure listen(port: int, cert_file: String, key_file: String, spread: bool) @page true @direct true @ret_caller true @deep true returns QuicServer io linked

    function valid(this) @ret_param_0 true @deep true returns bool linked
}

; Has the peer or the stack closed this connection?
procedure quic_closed(conn: SslRef) @ret_caller true @deep true returns bool io linked
