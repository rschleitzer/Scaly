; Scaly Compiler - Self-hosting compiler modules
; This module contains the compiler components being ported from C++

define compiler
{
    module Syntax  ; Generated from scaly.sgm - must come first, used by other modules
    module lexer   ; Lexer - must come before parser
    module parser
    module Model
    module Modeler
    module Plan
    module ConceptIndex  ; O(1) concept-name -> registry-index map (used by Planner)
    module FunctionIndex ; O(1) name -> ordered registry-index chain (used by Planner)
    module Interface     ; --emit-interface: a package's generated interface (facts from Planner + WriteCensus)
    module Planner
    module TaskPlanner  ; Stage-3 Plan analysis pass (parallelizability), runs after Planner
    module StoreEffects ; which record types a routine overwrites whole -> noalias parameters (the aliasing rule)
    module StackVectors ; which local Vectors may live on the machine stack instead of the frame page
    module PointerCensus ; --pointer-report: raw-pointer census off the Plan (reads Planner statics)
    module WriteCensus ; --write-report: writes through parameters off the Plan (reuses PointerCensus)
    module LLVM
    module Emitter

    procedure test() returns int mutable modeler_error_count
    {
        var result lexer.test()
        if result <> 0
            return result

        result := parser.test()
        if result <> 0
            return 200 + result

        result := Planner.test()
        if result <> 0
            return 100 + result

        result := Modeler.test()
        if result <> 0
            return 400 + result

        result := Emitter.test()
        if result <> 0
            return 300 + result

        0
    }
}
