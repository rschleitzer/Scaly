; GpuMsl.scaly - a kernel of GpuKernel's, written in the Metal Shading Language.
;
; GpuKernel says which parallel `for` a graphics card could run and what it
; takes, gives and calls. This pass walks the same planned body again and
; writes it as the source of one Metal compute kernel:
;   - the round's number is the thread's position in the grid;
;   - the scalars of the environment arrive as 32-bit words in one buffer
;     (a 64-bit one as two words, low then high), followed by the element
;     count of every input buffer, which the host appends;
;   - the inputs and the outputs are buffers of their own; a put writes at
;     the thread's position and nowhere else;
;   - a called function is a function of the source, callees first;
;   - a reduction's variable is a name of the round, r<i>, started at the
;     operation's identity; what the round leaves in it goes to one more
;     output, at the thread's position. The processor folds those.
;
; The source computes what the processor computes, bit for bit, or it is
; not written at all:
;   - every value has the type the plan gives it; an integer is widened or
;     reinterpreted only where the processor's code does the same, and
;     signed arithmetic is done unsigned, where it wraps as it does there;
;   - every operation stands in a statement of its own, in the order the
;     processor runs them;
;   - what the processor would stop at -- an index out of bounds, a
;     division by zero, a shift by more than the width, a floating-point
;     number no integer holds -- sets the fault flag F. The host then throws
;     the results away and the processor's loop runs and stops as it always
;     did. Every loop of the source ends where the flag is set.
; Whatever this pass does not know how to say exactly is REFUSED, with the
; first reason kept: the loop then stays on the processor alone.
;
; The names of the source are generated: u<i> a scalar of the environment,
; n<i> the length of input i, b<i> an input, o<i> an output, v<n> a name
; the program binds, t<n> a value on its way, p<i> a parameter, f<i> a
; function, s<i> a record or a tuple (GpuKernel's kind 100 + i) and m<j>
; its field j.
;
; THE SECOND DIALECT. The same walk writes the kernel in WGSL, the shading
; language of WebGPU (m_wgsl; `kernel_source_wgsl#`). What differs is said
; in one place each: how a value is declared (`declare_value#`,
; `declare_name#`), converted (`conv#`), reinterpreted (`bits#`), chosen
; (`pick#`), and how the fault flag is named (`fault_set#`, `fault_free#`,
; `fault_arg#`) -- a function of WGSL gets it as a pointer. WGSL has no
; 64-bit integer. A kernel GpuKernel calls portable holds 64-bit values
; only where they are narrowed on the spot: the counters, scalars of the
; environment and literals, under a cast or as an index. Such a value is
; TWO words here, its low one as the atom and its high one in
; m_atom_high; every other use of a 64-bit value is refused. WGSL does not
; promise the processor's rounding: the emitter hands a kernel with
; floating point there only for a loop written `relaxed`.
;
; Consumers: `--gpu-msl` and `--gpu-wgsl` print the source per loop; the
; emitter hands both to the host under `--gpu`.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).

use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.GpuKernel
use scalyc.compiler.TaskPlanner.TaskPlanner

define GpuMsl
{
    define GpuMsl
    (
        ; One slot per `for` loop, in the TaskPlanner's walk order: file,
        ; byte offset, and the kernel's source or why there is none.
        report_files: Array[String]
        report_offsets: Array[size_t]
        report_texts: Array[String]

        ; The first thing the kernel being written could not say.
        var m_refused: bool
        var m_reason: String

        ; How many t<n> and v<n> the routine being written has.
        var m_temps: size_t
        var m_made: size_t

        ; The names bound where the walk stands, innermost last: the
        ; program's name, the source's, its kind (GpuKernel.scalar_kind) and
        ; whether it can change (1) or not (0).
        m_names: Array[String]
        m_cnames: Array[String]
        m_kinds: Array[int]
        m_mutables: Array[int]

        ; how many loops of the source enclose the walk
        var m_depth: size_t
        ; a called function is being written, and what it answers
        var m_in_function: bool
        var m_return_kind: int
        ; what was written last returns on every path: a `return`, or an
        ; `if` whose two arms do
        var m_returns: bool
        ; the 32-bit words the kernel's scalars take
        var m_uniform_words: size_t
        ; the kind of the value an expression just answered
        var m_atom_kind: int
        ; where the value of a statement in value position goes ("" for
        ; nowhere: a function's own result is returned)
        var m_sink: String
        var m_sink_kind: int
        ; the dialect: WGSL, not Metal's -- of the kernel being written,
        ; and of the report `analyze#` writes
        var m_wgsl: bool
        var report_wgsl: bool
        ; WGSL: the high word of the 64-bit value an expression just
        ; answered ("" for any other kind), and per bound name its own
        var m_atom_high: String
        m_highs: Array[String]
    )
    {
        init()
        {
            report_files := Array[String]^this()
            report_offsets := Array[size_t]^this()
            report_texts := Array[String]^this()
            m_refused := false
            m_reason := String^this("")
            m_temps := 0
            m_made := 0
            m_names := Array[String]^this()
            m_cnames := Array[String]^this()
            m_kinds := Array[int]^this()
            m_mutables := Array[int]^this()
            m_depth := 0
            m_in_function := false
            m_return_kind := 0
            m_returns := false
            m_uniform_words := 0
            m_atom_kind := 0
            m_sink := String^this("")
            m_sink_kind := 0
            m_wgsl := false
            report_wgsl := false
            m_atom_high := String^this("")
            m_highs := Array[String]^this()
        }

        ; ================================================================
        ; Entry point of the report: per loop the TaskPlanner recorded, the
        ; kernel's source, or why it has none.
        ; ================================================================
        procedure analyze(mutable this: GpuMsl, mutable gk: ref[GpuKernel.GpuKernel], plan: Plan, tp: ref[TaskPlanner])
        {
            gk.plan_functions := plan.functions
            gk.plan_globals := plan.globals
            gk.plan_structures := plan.structures
            var i: size_t 0
            while i < tp.report_fors.length
            {
                let fr_ptr tp.report_fors.get i
                let file_ptr tp.report_files.get i
                let off_ptr tp.report_offsets.get i
                let verdict_ptr tp.report_verdicts.get i
                if fr_ptr <> null and file_ptr <> null and off_ptr <> null and verdict_ptr <> null
                {
                    let file_copy String^this((*file_ptr))
                    report_files.add file_copy
                    report_offsets.add((*off_ptr))
                    if (*verdict_ptr) = "parallel"
                    {
                        gk.take_reductions(tp, i)
                        gk.classify_loop(fr_ptr.unwrap())
                        if gk.k_blocked
                        {
                            let why gk.k_reason
                            this.add_text("no kernel: `why`")
                        }
                        else if report_wgsl and gk.portable() = false
                            this.add_text("no kernel for webgpu: `gk.verdict()`")
                        else
                        {
                            var source String("")
                            if report_wgsl
                                source := this.kernel_source_wgsl(gk, fr_ptr.unwrap())
                            else
                                source := this.kernel_source(gk, fr_ptr.unwrap())
                            if m_refused
                                this.add_text("refused: `m_reason`")
                            else
                                this.add_text("kernel\n`source`")
                        }
                    }
                    else
                    {
                        let why (*verdict_ptr)
                        this.add_text("no kernel: `why`")
                    }
                }
                i := i + 1
            }
        }

        procedure add_text(mutable this: GpuMsl, text: String)
        {
            let text_copy String^this(text)
            report_texts.add text_copy
        }

        ; ================================================================
        ; The source of the loop gk just classified and did not block. ""
        ; where it is refused: m_refused and m_reason say so.
        ; ================================================================
        procedure begin_kernel(mutable this: GpuMsl, wgsl: bool)
        {
            m_wgsl := wgsl
            m_refused := false
            m_reason := String^this("")
            m_temps := 0
            m_made := 0
            m_names.length := 0
            m_cnames.length := 0
            m_kinds.length := 0
            m_mutables.length := 0
            m_highs.length := 0
            m_depth := 0
            m_in_function := false
            m_return_kind := 0
            m_returns := false
            m_uniform_words := 0
            m_atom_kind := 0
            m_atom_high := String^this("")
            m_sink := String^this("")
            m_sink_kind := 0
        }

        ; The same loop in WGSL. Bindings: 0 the words, 1 the fault word,
        ; 2.. the inputs, then the outputs, all in group 0. Behind the words
        ; of the scalars and of the inputs' lengths the host appends two
        ; more: the count of rounds, and how many rounds one row of the
        ; dispatch holds -- a card under WebGPU runs whole groups of 64, in
        ; rows of at most 65535 groups, so a round finds its number from its
        ; place and does nothing beyond the count.
        procedure kernel_source_wgsl(mutable this: GpuMsl, gk: ref[GpuKernel.GpuKernel], fr: PlannedFor) returns String
        {
            this.begin_kernel(true)
            var out StringBuilder()
            this.records(&out, gk)

            var fi: size_t 0
            while fi < gk.k_functions.length
            {
                let sym_ptr gk.k_functions.get fi
                if sym_ptr <> null
                    this.function_source(&out, gk, (*sym_ptr), fi)
                fi := fi + 1
            }
            if m_refused
                return ""

            let n_in gk.k_buffers.length
            out.append "@group(0) @binding(0) var<storage, read> U: array<u32>;\n@group(0) @binding(1) var<storage, read_write> FLT: array<atomic<u32>>;\n"
            var bi: size_t 0
            while bi < n_in
            {
                let kind GpuMsl.int_at(&gk.k_buffer_kinds, bi as int)
                if kind < 2 or kind > 4
                {
                    this.refuse("a buffer of no number webgpu has")
                    return ""
                }
                let slot bi + 2
                out.append "@group(0) @binding(`slot`) var<storage, read> b`bi`: array<`this.ty(kind)`>;\n"
                bi := bi + 1
            }
            var oi: size_t 0
            while oi < gk.k_outputs.length
            {
                let kind GpuMsl.int_at(&gk.k_output_kinds, oi as int)
                if kind < 2 or kind > 4
                {
                    this.refuse("an output of no number webgpu has")
                    return ""
                }
                let slot oi + 2 + n_in
                out.append "@group(0) @binding(`slot`) var<storage, read_write> o`oi`: array<`this.ty(kind)`>;\n"
                oi := oi + 1
            }
            let n_out gk.k_outputs.length
            var ri: size_t 0
            while ri < gk.k_red_names.length
            {
                let kind GpuMsl.int_at(&gk.k_red_kinds, ri as int)
                if kind < 2 or kind > 4
                {
                    this.refuse("a reduction of no number webgpu has")
                    return ""
                }
                let at n_out + ri
                let slot at + 2 + n_in
                out.append "@group(0) @binding(`slot`) var<storage, read_write> o`at`: array<`this.ty(kind)`>;\n"
                ri := ri + 1
            }

            ; the words the scalars take, before the head can name what
            ; follows them
            var words: size_t 0
            var ui: size_t 0
            while ui < gk.k_uniforms.length
            {
                let kind GpuMsl.int_at(&gk.k_uniform_kinds, ui as int)
                if kind = 5 or kind = 6
                    words := words + 2
                else
                    words := words + 1
                ui := ui + 1
            }
            m_uniform_words := words
            let count_at words + 2 * n_in
            let row_at count_at + 1
            out.append "@compute @workgroup_size(64)\nfn k(@builtin(global_invocation_id) id: vec3<u32>)\n{\n"
            out.append "    let gid: u32 = id.x + id.y * U[`row_at`];\n    if (gid >= U[`count_at`]) { return; }\n    var F: u32 = 0u;\n"

            var word: size_t 0
            ui := 0
            while ui < gk.k_uniforms.length
            {
                let kind GpuMsl.int_at(&gk.k_uniform_kinds, ui as int)
                let after word + 1
                if kind = 1
                    out.append "    let u`ui`: bool = U[`word`] != 0u;\n"
                else if kind = 2
                    out.append "    let u`ui`: i32 = bitcast<i32>(U[`word`]);\n"
                else if kind = 3
                    out.append "    let u`ui`: u32 = U[`word`];\n"
                else if kind = 4
                    out.append "    let u`ui`: f32 = bitcast<f32>(U[`word`]);\n"
                else if kind = 5 or kind = 6
                    out.append "    let u`ui`: u32 = U[`word`];\n    let u`ui`_h: u32 = U[`after`];\n"
                else
                {
                    this.refuse("a scalar of no kind a card has")
                    return ""
                }
                if kind = 5 or kind = 6
                    word := word + 2
                else
                    word := word + 1
                ui := ui + 1
            }

            ; the lengths of the inputs: the host hands webgpu no buffer of
            ; 2^32 elements or more
            bi := 0
            while bi < n_in
            {
                let lo word + 2 * bi
                out.append "    let n`bi`: u32 = U[`lo`];\n"
                bi := bi + 1
            }

            if fr.expr = null or fr.expr.length <> 1
            {
                this.refuse("a count of rounds that is no single value")
                return ""
            }
            let ck GpuMsl.planned_kind(gk, (*fr.expr)[0])
            if GpuKernel.GpuKernel.kind_is_integer(ck) = false
            {
                this.refuse("a count of rounds that is no integer")
                return ""
            }
            if ck = 2
                out.append "    let v0: i32 = bitcast<i32>(gid);\n"
            else
                out.append "    let v0: u32 = gid;\n"
            this.declare(fr.identifier, "v0", ck, 0)
            if ck = 5 or ck = 6
                this.set_high("0u")
            m_made := 1
            m_temps := 0
            this.begin_reductions(&out, gk)
            if m_refused
                return ""

            ; once around: a `continue` of the body ends the round
            out.append "    for (var once: u32 = 0u; once < 1u; once++)\n    {\n"
            this.body(&out, gk, fr.body, 2, false)
            out.append "    }\n"
            this.end_reductions(&out, gk)
            out.append "    if (F != 0u) { atomicStore(&FLT[0], 1u); }\n}\n"
            this.end_scope(0)
            if m_refused
                return ""
            out.to_string()
        }

        ; A reduction's variable in the kernel: a name of the round that
        ; can change, started where the processor starts a part of the fold
        ; -- at the operation's identity (GpuKernel's list; the operations
        ; are the TaskPlanner's: 1 add, 3 and, 5 or, 6 xor, 7 the largest
        ; and 8 the smallest signed, 9 and 10 unsigned, 20 a floating-point
        ; sum, 21 a product).
        procedure begin_reductions(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel])
        {
            var ri: size_t 0
            while ri < gk.k_red_names.length
            {
                let kind GpuMsl.int_at(&gk.k_red_kinds, ri as int)
                let op GpuMsl.int_at(&gk.k_red_ops, ri as int)
                if this.refuse_pair(kind, gk.k_red_names[ri])
                    return
                let start this.identity_of(op, kind)
                if m_refused
                    return
                let cname "r`ri`"
                out.append(this.declare_name("    ", kind, cname, start))
                this.declare(gk.k_red_names[ri], cname, kind, 1)
                ri := ri + 1
            }
        }

        ; ... and what the round left in each goes to its output.
        procedure end_reductions(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel])
        {
            let n_out gk.k_outputs.length
            var ri: size_t 0
            while ri < gk.k_red_names.length
            {
                let at n_out + ri
                out.append "    o`at`[gid] = r`ri`;\n"
                ri := ri + 1
            }
        }

        ; The value a part of a fold starts at: the one that leaves every
        ; other unchanged under the operation.
        procedure identity_of(mutable this: GpuMsl, op: int, kind: int) returns String
        {
            if op = 20 and kind = 4
                return "(-0.0f)"
            if op = 21 and kind = 4
                return "1.0f"
            if GpuMsl.is_int(kind) = false or op >= 20
            {
                this.refuse("a reduction of another kind than its operation")
                return ""
            }
            if op = 1 or op = 5 or op = 6 or op = 9
                return this.zero_of(kind)
            if op = 3 or op = 10
            {
                ; every bit set
                if kind = 2
                    return "-1"
                if kind = 3
                    return "4294967295u"
                if kind = 5
                    return "((long)-1)"
                return "(~((ulong)0u))"
            }
            if op = 7
            {
                if m_wgsl
                    return "(-2147483647 - 1)"
                return GpuMsl.least(kind)
            }
            if op = 8
            {
                if kind = 2
                    return "2147483647"
                return "((long)(((ulong)1u << 63) - (ulong)1u))"
            }
            this.refuse("a reduction this pass does not know")
            ""
        }

        procedure kernel_source(mutable this: GpuMsl, gk: ref[GpuKernel.GpuKernel], fr: PlannedFor) returns String
        {
            this.begin_kernel(false)

            var out StringBuilder()
            out.append "#include <metal_stdlib>\nusing namespace metal;\n#pragma METAL fp math_mode(safe)\n#pragma METAL fp contract(off)\n"
            this.records(&out, gk)

            ; the functions, a callee before its caller
            var fi: size_t 0
            while fi < gk.k_functions.length
            {
                let sym_ptr gk.k_functions.get fi
                if sym_ptr <> null
                    this.function_source(&out, gk, (*sym_ptr), fi)
                fi := fi + 1
            }
            if m_refused
                return ""

            ; the kernel's head: the words, the fault flag, inputs, outputs
            let n_in gk.k_buffers.length
            out.append "kernel void k(constant uint* U [[buffer(0)]], device atomic_uint* FLT [[buffer(1)]]"
            var bi: size_t 0
            while bi < n_in
            {
                let kind GpuMsl.int_at(&gk.k_buffer_kinds, bi as int)
                if GpuKernel.GpuKernel.kind_is_integer(kind) = false and kind <> 4
                {
                    this.refuse("a buffer of no number of a card's")
                    return ""
                }
                let slot bi + 2
                out.append ", const device `GpuMsl.type_name(kind)`* b`bi` [[buffer(`slot`)]]"
                bi := bi + 1
            }
            var oi: size_t 0
            while oi < gk.k_outputs.length
            {
                let kind GpuMsl.int_at(&gk.k_output_kinds, oi as int)
                if GpuKernel.GpuKernel.kind_is_integer(kind) = false and kind <> 4
                {
                    this.refuse("an output of no number of a card's")
                    return ""
                }
                let slot oi + 2 + n_in
                out.append ", device `GpuMsl.type_name(kind)`* o`oi` [[buffer(`slot`)]]"
                oi := oi + 1
            }
            ; one more output per reduction: each round's part of it
            let n_out gk.k_outputs.length
            var ri: size_t 0
            while ri < gk.k_red_names.length
            {
                let kind GpuMsl.int_at(&gk.k_red_kinds, ri as int)
                if GpuKernel.GpuKernel.kind_is_integer(kind) = false and kind <> 4
                {
                    this.refuse("a reduction of no number of a card's")
                    return ""
                }
                let at n_out + ri
                let slot at + 2 + n_in
                out.append ", device `GpuMsl.type_name(kind)`* o`at` [[buffer(`slot`)]]"
                ri := ri + 1
            }
            out.append ", uint gid [[thread_position_in_grid]])\n{\n    uint F = 0u;\n"

            ; the scalars of the environment, out of their words
            var word: size_t 0
            var ui: size_t 0
            while ui < gk.k_uniforms.length
            {
                let kind GpuMsl.int_at(&gk.k_uniform_kinds, ui as int)
                let after word + 1
                if kind = 1
                    out.append "    const bool u`ui` = U[`word`] != 0u;\n"
                else if kind = 2
                    out.append "    const int u`ui` = as_type<int>(U[`word`]);\n"
                else if kind = 3
                    out.append "    const uint u`ui` = U[`word`];\n"
                else if kind = 4
                    out.append "    const float u`ui` = as_type<float>(U[`word`]);\n"
                else if kind = 5
                    out.append "    const long u`ui` = (long)((ulong)U[`word`] | ((ulong)U[`after`] << 32));\n"
                else if kind = 6
                    out.append "    const ulong u`ui` = (ulong)U[`word`] | ((ulong)U[`after`] << 32);\n"
                else
                {
                    this.refuse("a scalar of no kind a card has")
                    return ""
                }
                if kind = 5 or kind = 6
                    word := word + 2
                else
                    word := word + 1
                ui := ui + 1
            }
            m_uniform_words := word

            ; the lengths of the inputs, which the host appends
            bi := 0
            while bi < n_in
            {
                let lo word + 2 * bi
                let hi lo + 1
                out.append "    const ulong n`bi` = (ulong)U[`lo`] | ((ulong)U[`hi`] << 32);\n"
                bi := bi + 1
            }

            ; the round's number
            if fr.expr = null or fr.expr.length <> 1
            {
                this.refuse("a count of rounds that is no single value")
                return ""
            }
            let ck GpuMsl.planned_kind(gk, (*fr.expr)[0])
            if GpuKernel.GpuKernel.kind_is_integer(ck) = false
            {
                this.refuse("a count of rounds that is no integer")
                return ""
            }
            let ct GpuMsl.type_name(ck)
            out.append "    const `ct` v0 = (`ct`)gid;\n"
            this.declare(fr.identifier, "v0", ck, 0)
            m_made := 1
            m_temps := 0
            this.begin_reductions(&out, gk)
            if m_refused
                return ""

            out.append "    do\n    {\n"
            this.body(&out, gk, fr.body, 2, false)
            out.append "    } while (false);\n"
            this.end_reductions(&out, gk)
            out.append "    if (F != 0u) atomic_store_explicit(FLT, 1u, memory_order_relaxed);\n}\n"
            this.end_scope(0)
            if m_refused
                return ""
            out.to_string()
        }

        ; ================================================================
        ; Verdict bookkeeping
        ; ================================================================

        ; Record the first thing that cannot be said. Later calls are no-ops.
        procedure refuse(mutable this: GpuMsl, why: String)
        {
            if m_refused
                return
            m_refused := true
            m_reason := String^this(why)
        }

        procedure refuse_named(mutable this: GpuMsl, prefix: String, name: String)
        {
            if m_refused
                return
            let msg "`prefix``name`"
            this.refuse(msg)
        }

        ; ================================================================
        ; Kinds (GpuKernel.scalar_kind): 1 bool, 2 i32, 3 u32, 4 f32, 5 a
        ; signed and 6 an unsigned 64-bit integer.
        ; ================================================================

        function type_name(kind: int) returns String
        {
            if kind >= 100
                return "s`kind - 100`"
            if kind = 1
                return "bool"
            if kind = 2
                return "int"
            if kind = 3
                return "uint"
            if kind = 4
                return "float"
            if kind = 5
                return "long"
            if kind = 6
                return "ulong"
            "void"
        }

        ; The type of a kind in the dialect being written. WGSL has no
        ; 64-bit integer: such a value is two words, each a u32.
        function ty(this: GpuMsl, kind: int) returns String
        {
            if m_wgsl = false or kind >= 100
                return GpuMsl.type_name(kind)
            if kind = 1
                return "bool"
            if kind = 2
                return "i32"
            if kind = 4
                return "f32"
            "u32"
        }

        ; A value that does not change: a line of its own.
        function declare_value(this: GpuMsl, ind: String, kind: int, name: String, value: String) returns String
        {
            if m_wgsl
                return "`ind`let `name`: `this.ty(kind)` = `value`;\n"
            "`ind`const `this.ty(kind)` `name` = `value`;\n"
        }

        ; A name that can change.
        function declare_name(this: GpuMsl, ind: String, kind: int, name: String, value: String) returns String
        {
            if m_wgsl
                return "`ind`var `name`: `this.ty(kind)` = `value`;\n"
            "`ind``this.ty(kind)` `name` = `value`;\n"
        }

        ; A value converted to a kind, as the language converts it.
        function conv(this: GpuMsl, kind: int, atom: String) returns String
        {
            if m_wgsl
                return "`this.ty(kind)`(`atom`)"
            "((`this.ty(kind)`)`atom`)"
        }

        ; The bits of a value read as another kind of the same width.
        function bits(this: GpuMsl, kind: int, atom: String) returns String
        {
            if m_wgsl
                return "bitcast<`this.ty(kind)`>(`atom`)"
            "as_type<`this.ty(kind)`>(`atom`)"
        }

        ; One of two values by a bool.
        function pick(this: GpuMsl, cond: String, yes: String, no: String) returns String
        {
            if m_wgsl
                return "select(`no`, `yes`, `cond`)"
            "(`cond`) ? `yes` : `no`"
        }

        ; The fault flag: a function of WGSL has it as a pointer.
        function fault_name(this: GpuMsl) returns String
        {
            if m_wgsl and m_in_function
                return "(*F)"
            "F"
        }

        function fault_arg(this: GpuMsl) returns String
        {
            if m_wgsl and m_in_function = false
                return "&F"
            "F"
        }

        ; `if (cond) F = 1;`, and with a statement where there is no fault
        function fault_where(this: GpuMsl, ind: String, cond: String, otherwise: String) returns String
        {
            let f this.fault_name()
            if m_wgsl
            {
                if otherwise.get_length() = 0
                    return "`ind`if (`cond`) { `f` = 1u; }\n"
                return "`ind`if (`cond`) { `f` = 1u; } else { `otherwise`; }\n"
            }
            if otherwise.get_length() = 0
                return "`ind`if (`cond`) F = 1u;\n"
            "`ind`if (`cond`) F = 1u; else `otherwise`;\n"
        }

        ; WGSL: the high word of the name declared last.
        procedure set_high(mutable this: GpuMsl, high: String)
        {
            if m_highs.length = 0
                return
            let h_copy String^this(high)
            m_highs.put(m_highs.length - 1, h_copy)
        }

        ; WGSL: is the kind a 64-bit integer, which it has only as two words?
        function is_pair(this: GpuMsl, kind: int) returns bool
        {
            if m_wgsl = false
                return false
            kind = 5 or kind = 6
        }

        ; WGSL: a 64-bit value where only a number of 32 bits can stand.
        procedure refuse_pair(mutable this: GpuMsl, kind: int, what: String) returns bool
        {
            if this.is_pair(kind) = false
                return false
            this.refuse_named("a 64-bit integer, which webgpu does not have: ", what)
            true
        }

        ; The bits of an integer kind, 0 for any other.
        function width(kind: int) returns int
        {
            if kind = 2 or kind = 3
                return 32
            if kind = 5 or kind = 6
                return 64
            0
        }

        function is_int(kind: int) returns bool
        {
            if kind = 2 or kind = 3 or kind = 5 or kind = 6
                return true
            false
        }

        function is_signed(kind: int) returns bool
        {
            if kind = 2 or kind = 5
                return true
            false
        }

        function int_kind(bits: int, signed: bool) returns int
        {
            if bits = 32
            {
                if signed
                    return 2
                return 3
            }
            if signed
                return 5
            6
        }

        function unsigned_of(kind: int) returns int
        {
            if kind = 2
                return 3
            if kind = 5
                return 6
            kind
        }

        function signed_of(kind: int) returns int
        {
            if kind = 3
                return 2
            if kind = 6
                return 5
            kind
        }

        function zero(kind: int) returns String
        {
            if kind >= 100
                return "s`kind - 100`{}"
            if kind = 1
                return "false"
            if kind = 2
                return "0"
            if kind = 3
                return "0u"
            if kind = 4
                return "0.0f"
            if kind = 5
                return "((long)0)"
            "((ulong)0u)"
        }

        ; A small number as an integer of that kind.
        function small(kind: int, n: int) returns String
        {
            if kind = 2
                return "`n`"
            if kind = 3
                return "`n`u"
            if kind = 5
                return "((long)`n`)"
            "((ulong)`n`u)"
        }

        ; The least value of a signed kind.
        function least(kind: int) returns String
        {
            if kind = 2
                return "as_type<int>(0x80000000u)"
            "((long)((ulong)1u << 63))"
        }

        ; The kind the plan gives an operand: its last member's where it
        ; reads one (the length of a buffer, a field), else its own.
        function planned_kind(gk: ref[GpuKernel.GpuKernel], op: PlannedOperand) returns int
        {
            if op.member_access <> null and op.member_access.length > 0
            {
                let ma_ptr op.member_access.get(op.member_access.length - 1)
                if ma_ptr = null
                    return 0
                let ma ma_ptr.unwrap()
                return gk.kind(ma.result_type)
            }
            gk.kind(op.result_type)
        }

        ; A kind a value of the source can have: a number, or a record.
        function is_value(kind: int) returns bool
        {
            if kind >= 100
                return true
            kind >= 1 and kind <= 6
        }

        ; The records, a field's before the record holding it: a struct
        ; each, its fields m<j>.
        procedure records(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel])
        {
            var ri: size_t 0
            while ri < gk.k_records.length
            {
                let from gk.k_record_from[ri]
                let count gk.k_record_count[ri]
                if m_wgsl
                    out.append "struct s`ri`\n{\n"
                else
                    out.append "struct s`ri`\n{\n"
                var j: size_t 0
                while j < count
                {
                    let fk gk.k_field_kinds[from + j]
                    if this.refuse_pair(fk, "a field")
                        return
                    if m_wgsl
                        out.append "    m`j`: `this.ty(fk)`,\n"
                    else
                        out.append "    `GpuMsl.type_name(fk)` m`j`;\n"
                    j := j + 1
                }
                if m_wgsl
                    out.append "}\n"
                else
                    out.append "};\n"
                ri := ri + 1
            }
        }

        ; The fields an operand reads off the record value `atom`, each a
        ; value of its own.
        procedure members(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], atom: String, op: PlannedOperand, depth: size_t) returns String
        {
            if m_refused
                return ""
            var at String(atom)
            if GpuKernel.GpuKernel.has_members(op) = false
                return at
            let ind GpuMsl.indent_of(depth)
            var i: size_t 0
            while i < op.member_access.length
            {
                let ma_ptr op.member_access.get i
                if ma_ptr = null
                    return ""
                let ma ma_ptr.unwrap()
                let f gk.field_at(m_atom_kind, ma)
                if ma.is_method or f < 0
                {
                    this.refuse_named("reads a member that is no field: ", ma.name)
                    return ""
                }
                let from gk.k_record_from[(m_atom_kind - 100) as size_t]
                let j (f as size_t) - from
                let fk gk.k_field_kinds[f as size_t]
                let t this.temp()
                out.append(this.declare_value(ind, fk, t, "`at`.m`j`"))
                at := String(t)
                m_atom_kind := fk
                i := i + 1
            }
            at
        }

        ; A record or a tuple built in the round, from its parts in the order
        ; of its fields.
        procedure construction(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], tp: PlannedTuple, depth: size_t) returns String
        {
            let rk gk.kind(tp.tuple_type)
            if rk < 100 or tp.components = null
            {
                this.refuse("builds a record the kernel does not hold")
                return ""
            }
            let from gk.k_record_from[(rk - 100) as size_t]
            let count gk.k_record_count[(rk - 100) as size_t]
            if tp.components.length <> count
            {
                this.refuse("builds a record of another count of parts")
                return ""
            }
            var parts StringBuilder()
            var i: size_t 0
            while i < count
            {
                let c_ptr tp.components.get i
                if c_ptr = null or c_ptr.value = null or c_ptr.value.length <> 1
                {
                    this.refuse("a part of a record that is no single value")
                    return ""
                }
                let c c_ptr.unwrap()
                let v this.operand(out, gk, (*c.value)[0], depth)
                if m_refused
                    return ""
                let fitted this.fit(v, m_atom_kind, gk.k_field_kinds[from + i])
                if m_refused
                    return ""
                if i > 0
                    parts.append ", "
                parts.append fitted
                i := i + 1
            }
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            let text parts.to_string()
            if m_wgsl
                out.append(this.declare_value(ind, rk, t, "s`rk - 100`(`text`)"))
            else
                out.append(this.declare_value(ind, rk, t, "s`rk - 100`{`text`}"))
            m_atom_kind := rk
            m_atom_high := String^this("")
            t
        }

        ; A count of rounds the processor can compute twice without a
        ; difference: a constant or a name, a field read off it, under casts
        ; and groupings, and a sum, a difference or a product of such whole
        ; numbers (`for p in w * h`). The emitter computes it for the card
        ; and, where the card declines, the processor's loop computes it
        ; again.
        function is_plain_count(op: PlannedOperand) returns bool
        {
            choose op.expr
                when c: Constant
                    return GpuKernel.GpuKernel.has_members(op) = false
                when g: GlobalRef
                    return GpuKernel.GpuKernel.has_members(op) = false
                when v: Variable
                {
                    if op.member_access = null
                        return true
                    var i: size_t 0
                    while i < op.member_access.length
                    {
                        let ma_ptr op.member_access.get i
                        if ma_ptr = null or ma_ptr.is_method
                            return false
                        i := i + 1
                    }
                    return true
                }
                when as_expr: As
                {
                    if GpuKernel.GpuKernel.has_members(op) or as_expr.value = null
                        return false
                    let r as_expr.value
                    return GpuMsl.is_plain_count((*r))
                }
                when tp: Tuple
                {
                    if GpuKernel.GpuKernel.has_members(op) or GpuKernel.GpuKernel.is_grouping(tp) = false
                        return false
                    let c_ptr tp.components.get 0
                    if c_ptr = null
                        return false
                    let comp c_ptr.unwrap()
                    return GpuMsl.is_plain_count((*comp.value)[0])
                }
                when call: Call
                {
                    ; the compiler's own arithmetic on two whole numbers
                    if GpuKernel.GpuKernel.has_members(op) or call.is_indirect
                        return false
                    if call.is_operator = false and call.is_intrinsic = false
                        return false
                    if call.args = null or call.args.length <> 2
                        return false
                    if call.name <> "*" and call.name <> "+" and call.name <> "-"
                        return false
                    let a_ptr call.args.get 0
                    let b_ptr call.args.get 1
                    if a_ptr = null or b_ptr = null
                        return false
                    let a a_ptr.unwrap()
                    let b b_ptr.unwrap()
                    if GpuKernel.GpuKernel.kind_is_integer(GpuKernel.GpuKernel.scalar_kind(a.result_type)) = false
                        return false
                    if GpuKernel.GpuKernel.kind_is_integer(GpuKernel.GpuKernel.scalar_kind(b.result_type)) = false
                        return false
                    return GpuMsl.is_plain_count(a) and GpuMsl.is_plain_count(b)
                }
                else
                    0
            false
        }

        function int_at(kinds: ref[Array[int]], index: int) returns int
        {
            if index < 0
                return 0
            let p kinds.get(index as size_t)
            if p = null
                return 0
            (*p)
        }

        function indent_of(depth: size_t) returns String
        {
            var sb StringBuilder()
            var i: size_t 0
            while i < depth
            {
                sb.append "    "
                i := i + 1
            }
            sb.to_string()
        }

        ; An integer of the plan as a constant of that kind: its low bits.
        function integer_literal(value: size_t, kind: int) returns String
        {
            let lo: size_t value & 0xFFFFFFFF
            let hi: size_t value >> 32
            if kind = 2
            {
                if lo < 0x80000000
                    return "`lo`"
                return "as_type<int>(`lo`u)"
            }
            if kind = 3
                return "`lo`u"
            if kind = 5
            {
                if value < 0x80000000
                    return "((long)`value`)"
                return "((long)(((ulong)`hi`u << 32) | (ulong)`lo`u))"
            }
            if value < 0x100000000
                return "((ulong)`value`u)"
            "(((ulong)`hi`u << 32) | (ulong)`lo`u)"
        }

        ; An integer constant in the dialect being written. WGSL: a 64-bit
        ; one is its low word, the high word in m_atom_high.
        procedure integer_text(mutable this: GpuMsl, value: size_t, kind: int) returns String
        {
            if m_wgsl = false
                return GpuMsl.integer_literal(value, kind)
            let lo: size_t value & 0xFFFFFFFF
            let hi: size_t value >> 32
            if kind = 2
            {
                if lo < 0x80000000
                    return "`lo`"
                return "bitcast<i32>(`lo`u)"
            }
            if kind = 5 or kind = 6
                m_atom_high := String^this("`hi`u")
            "`lo`u"
        }

        ; The zero of a kind in the dialect being written.
        function zero_of(this: GpuMsl, kind: int) returns String
        {
            if m_wgsl = false
                return GpuMsl.zero(kind)
            if kind >= 100
                return "s`kind - 100`()"
            if kind = 1
                return "false"
            if kind = 2
                return "0"
            if kind = 4
                return "0.0f"
            "0u"
        }

        ; An integer as wide as the operation it enters: widened by its OWN
        ; signedness, as the processor's code widens it.
        function widened(atom: String, kind: int, bits: int) returns String
        {
            if GpuMsl.width(kind) = bits
                return String(atom)
            let t GpuMsl.type_name(GpuMsl.int_kind(bits, GpuMsl.is_signed(kind)))
            "((`t`)`atom`)"
        }

        ; The source's spelling of an operator that wraps: "" for any other.
        function wrapping_text(nm: String) returns String
        {
            match nm
                case "+"
                    return "+"
                case "-"
                    return "-"
                case "*"
                    return "*"
                case "&"
                    return "&"
                case "|"
                    return "|"
                case "xor" case "^"
                    return "^"
            ""
        }

        ; The source's spelling of a comparison: "" for any other operator.
        function comparison_text(nm: String) returns String
        {
            match nm
                case "="
                    return "=="
                case "<>"
                    return "!="
                case "<"
                    return "<"
                case "<="
                    return "<="
                case ">"
                    return ">"
                case ">="
                    return ">="
            ""
        }

        ; ================================================================
        ; Names
        ; ================================================================

        procedure temp(mutable this: GpuMsl) returns String
        {
            let n m_temps
            m_temps := m_temps + 1
            "t`n`"
        }

        procedure fresh_local(mutable this: GpuMsl) returns String
        {
            let n m_made
            m_made := m_made + 1
            "v`n`"
        }

        procedure declare(mutable this: GpuMsl, name: String, cname: String, kind: int, changes: int)
        {
            let name_copy String^this(name)
            m_names.add name_copy
            let cname_copy String^this(cname)
            m_cnames.add cname_copy
            m_kinds.add kind
            m_mutables.add changes
            let none String^this("")
            m_highs.add none
        }

        procedure end_scope(mutable this: GpuMsl, mark: size_t)
        {
            if m_names.length <= mark
                return
            m_names.length := mark
            m_cnames.length := mark
            m_kinds.length := mark
            m_mutables.length := mark
            m_highs.length := mark
        }

        ; Where name is bound, innermost first; -1 when it comes from
        ; outside the routine being written.
        function lookup(this: GpuMsl, name: String) returns int
        {
            var i m_names.length
            while i > 0
            {
                i := i - 1
                let p m_names.get i
                if p <> null and (*p) = name
                    return i as int
            }
            0 - 1
        }

        function cname_at(this: GpuMsl, index: int) returns String
        {
            let p m_cnames.get(index as size_t)
            if p = null
                return ""
            String((*p))
        }

        ; A value of one kind where another is wanted: itself, or an integer
        ; of the same width read as the other. Anything else would be a
        ; conversion nobody wrote.
        procedure fit(mutable this: GpuMsl, atom: String, have: int, want: int) returns String
        {
            if m_refused
                return ""
            if have = want
                return String(atom)
            if GpuMsl.is_int(have) and GpuMsl.is_int(want) and GpuMsl.width(have) = GpuMsl.width(want)
            {
                ; WGSL: the two words of a 64-bit value are what they are
                if this.is_pair(have)
                    return String(atom)
                return this.conv(want, atom)
            }
            let msg "a `GpuMsl.type_name(have)` where a `GpuMsl.type_name(want)` stands"
            this.refuse(msg)
            ""
        }

        ; ================================================================
        ; Functions
        ; ================================================================

        ; Where the function of that symbol is in the plan, with a body;
        ; -1 where it is not.
        function function_index(gk: ref[GpuKernel.GpuKernel], mangled: String) returns int
        {
            let fns: ref[Vector[PlannedFunction]]? gk.plan_functions
            if fns = null
                return 0 - 1
            var i: size_t 0
            while i < fns.length
            {
                let f_ptr fns.get i
                if f_ptr <> null and f_ptr.mangled_name = mangled
                {
                    choose f_ptr.impl
                        when action: Action
                            return i as int
                        else
                            0
                }
                i := i + 1
            }
            0 - 1
        }

        procedure function_source(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], mangled: String, fi: size_t)
        {
            if m_refused
                return
            let idx GpuMsl.function_index(gk, mangled)
            let fns: ref[Vector[PlannedFunction]]? gk.plan_functions
            if idx < 0 or fns = null
            {
                this.refuse("calls a function whose body is not here")
                return
            }
            let f_ptr fns.get(idx as size_t)
            if f_ptr = null
                return
            this.function_text(out, gk, f_ptr.unwrap(), fi)
        }

        procedure function_text(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], func: PlannedFunction, fi: size_t)
        {
            if func.return_type = null
            {
                this.refuse_named(func.name, " answers nothing")
                return
            }
            let rt func.return_type
            let rk gk.kind((*rt))
            if GpuMsl.is_value(rk) = false
            {
                this.refuse_named(func.name, " answers no value of a card's")
                return
            }
            m_in_function := true
            m_return_kind := rk
            m_depth := 0
            m_temps := 0
            m_made := 0
            if this.refuse_pair(rk, func.name)
                return
            if m_wgsl
                out.append "fn f`fi`("
            else
                out.append "static `GpuMsl.type_name(rk)` f`fi`("
            if func.input <> null
            {
                var pi: size_t 0
                while pi < func.input.length
                {
                    let p_ptr func.input.get pi
                    if p_ptr <> null
                    {
                        let p p_ptr.unwrap()
                        if p.name = null or p.item_type = null
                        {
                            this.refuse("a parameter without a name or a type")
                            return
                        }
                        let pt p.item_type
                        let pk gk.kind((*pt))
                        if GpuMsl.is_value(pk) = false
                        {
                            this.refuse("a parameter that is no value of a card's")
                            return
                        }
                        let pname (*p.name)
                        let cname "p`pi`"
                        if this.refuse_pair(pk, pname)
                            return
                        if m_wgsl
                            out.append "`cname`: `this.ty(pk)`, "
                        else
                            out.append "`GpuMsl.type_name(pk)` `cname`, "
                        this.declare(pname, cname, pk, 0)
                    }
                    pi := pi + 1
                }
            }
            if m_wgsl
                out.append "F: ptr<function, u32>) -> `this.ty(rk)`\n{\n"
            else
                out.append "uint& F)\n{\n"
            m_returns := false
            choose func.impl
                when action: Action
                    this.body(out, gk, action, 1, true)
                else
                    0
            ; a body that returns on every path never comes here: WGSL's
            ; compiler says so (Tint, "code is unreachable"), so it gets the
            ; line only where a path may come; Metal's always (its text
            ; stays as pinned)
            if m_returns = false or m_wgsl = false
                out.append "    return `this.zero_of(rk)`;\n"
            out.append "}\n"
            this.end_scope(0)
            m_in_function := false
            m_return_kind := 0
        }

        ; ================================================================
        ; Statements. `tail` says the statement's value is the value of what
        ; it ends: a function's result, or a statement in value position.
        ; ================================================================

        ; The statements of a body: a block's own, without braces of its own.
        procedure body(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], act: PlannedAction, depth: size_t, tail: bool)
        {
            if m_refused
                return
            this.action(out, gk, act, depth, tail)
        }

        procedure statements(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], ss: ref[Vector[PlannedStatement]]?, depth: size_t, tail: bool)
        {
            if ss = null
                return
            let n ss.length
            ; the block's bindings end with it
            let mark m_names.length
            var i: size_t 0
            while i < n
            {
                if m_refused
                    return
                let s_ptr ss.get i
                if s_ptr <> null
                    this.statement(out, gk, s_ptr.unwrap(), depth, tail and i + 1 = n)
                i := i + 1
            }
            this.end_scope(mark)
        }

        procedure statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], stmt: PlannedStatement, depth: size_t, tail: bool)
        {
            if m_refused
                return
            let ind GpuMsl.indent_of(depth)
            m_returns := false
            choose stmt
                when action: Action
                    this.action(out, gk, action, depth, tail)
                when binding: Binding
                    this.binding(out, gk, binding, depth)
                when ret: Return
                    this.return_statement(out, gk, ret, depth)
                when throw_stmt: Throw
                    this.refuse("a throw")
                when brk: Break
                {
                    if m_depth = 0
                    {
                        this.refuse("a break outside a loop of the kernel")
                        return
                    }
                    out.append "`ind`break;\n"
                }
                when cont: Continue
                {
                    if m_in_function and m_depth = 0
                    {
                        this.refuse("a continue outside a loop of the function")
                        return
                    }
                    out.append "`ind`continue;\n"
                }
        }

        ; An action: an assignment when it has a target, else a statement or
        ; a value -- which goes where `tail` says it is wanted.
        procedure action(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], act: PlannedAction, depth: size_t, tail: bool)
        {
            if m_refused
                return
            let ind GpuMsl.indent_of(depth)
            var has_target false
            if act.target <> null and act.target.length > 0
                has_target := true
            if act.source = null or act.source.length = 0
            {
                if has_target
                    this.refuse("an assignment without a value")
                return
            }
            if act.source.length <> 1
            {
                this.refuse("an operation of several operands")
                return
            }
            let op (*act.source)[0]
            if has_target
            {
                if act.target.length <> 1
                {
                    this.refuse("a compound assignment target")
                    return
                }
                this.assignment(out, gk, (*act.target)[0], op, depth)
                return
            }
            if GpuKernel.GpuKernel.has_members(op) = false
            {
                ; control flow keeps its shape: its arms carry the tail
                choose op.expr
                    when blk: Block
                    {
                        this.statements(out, gk, blk.statements, depth, tail)
                        return
                    }
                    when iff: If
                    {
                        this.if_statement(out, gk, iff, depth, tail)
                        return
                    }
                    when wh: While
                    {
                        this.while_statement(out, gk, wh, depth)
                        m_returns := false
                        return
                    }
                    when rp: Repeat
                    {
                        this.repeat_statement(out, gk, rp, depth)
                        m_returns := false
                        return
                    }
                    when fr: For
                    {
                        this.for_statement(out, gk, fr, depth)
                        m_returns := false
                        return
                    }
                    when call: Call
                    {
                        if call.is_intrinsic = false and call.is_indirect = false and call.name = "put"
                        {
                            this.put_statement(out, gk, call, depth)
                            return
                        }
                    }
                    else
                        0
            }
            let value this.operand(out, gk, op, depth)
            if m_refused
                return
            if tail
            {
                let have m_atom_kind
                if m_sink.get_length() > 0
                {
                    let fitted this.fit(value, have, m_sink_kind)
                    out.append "`ind``m_sink` = `fitted`;\n"
                }
                else if m_in_function
                {
                    let fitted this.fit(value, have, m_return_kind)
                    out.append "`ind`return `fitted`;\n"
                    m_returns := true
                }
            }
        }

        ; `name := value` into a name of the round that can change.
        procedure assignment(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], top: PlannedOperand, op: PlannedOperand, depth: size_t)
        {
            if GpuKernel.GpuKernel.has_members(top)
            {
                this.refuse("writes a member")
                return
            }
            let ind GpuMsl.indent_of(depth)
            choose top.expr
                when v: Variable
                {
                    let li this.lookup(v.name)
                    if li < 0
                    {
                        this.refuse_named("writes a name from outside: ", v.name)
                        return
                    }
                    if GpuMsl.int_at(&m_mutables, li) = 0
                    {
                        this.refuse_named("writes a name that does not change: ", v.name)
                        return
                    }
                    let value this.operand(out, gk, op, depth)
                    if m_refused
                        return
                    let fitted this.fit(value, m_atom_kind, GpuMsl.int_at(&m_kinds, li))
                    let cname this.cname_at(li)
                    out.append "`ind``cname` = `fitted`;\n"
                }
                else
                    this.refuse("an indirect write")
        }

        ; `let x …` / `var x …`: the value first, then the name.
        procedure binding(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], b: PlannedBinding, depth: size_t)
        {
            if b.binding_item.name = null
            {
                this.refuse("a binding without a name")
                return
            }
            let name (*b.binding_item.name)
            if b.operation = null or b.operation.length <> 1
            {
                this.refuse_named("a binding without a single value: ", name)
                return
            }
            let ind GpuMsl.indent_of(depth)
            let value this.operand(out, gk, (*b.operation)[0], depth)
            if m_refused
                return
            let have m_atom_kind
            var want have
            if b.binding_item.item_type <> null
            {
                let it b.binding_item.item_type
                want := gk.kind((*it))
            }
            if GpuMsl.is_value(want) = false
            {
                this.refuse_named("a name that is no value of a card's: ", name)
                return
            }
            let fitted this.fit(value, have, want)
            if m_refused
                return
            if this.refuse_pair(want, name)
                return
            let cname this.fresh_local()
            var changes 0
            if b.binding_type = "var" or b.binding_type = "mutable"
                changes := 1
            if changes = 1
                out.append(this.declare_name(ind, want, cname, fitted))
            else
                out.append(this.declare_value(ind, want, cname, fitted))
            this.declare(name, cname, want, changes)
        }

        procedure return_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], ret: PlannedReturn, depth: size_t)
        {
            if m_in_function = false
            {
                this.refuse("a return")
                return
            }
            if ret.result = null or ret.result.length <> 1
            {
                this.refuse("a return without a single value")
                return
            }
            let ind GpuMsl.indent_of(depth)
            let value this.operand(out, gk, (*ret.result)[0], depth)
            if m_refused
                return
            let fitted this.fit(value, m_atom_kind, m_return_kind)
            out.append "`ind`return `fitted`;\n"
            m_returns := true
        }

        procedure if_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], iff: PlannedIf, depth: size_t, tail: bool)
        {
            if iff.prop <> null
            {
                this.refuse("tests for null")
                return
            }
            if iff.condition = null or iff.condition.length <> 1
            {
                this.refuse("a condition that is no single value")
                return
            }
            let ind GpuMsl.indent_of(depth)
            let c this.operand(out, gk, (*iff.condition)[0], depth)
            if m_refused
                return
            if m_atom_kind <> 1
            {
                this.refuse("a condition that is no bool")
                return
            }
            out.append "`ind`if (`c`)\n"
            this.arm(out, gk, iff.consequent, depth, tail)
            let first m_returns
            m_returns := false
            if iff.alternative <> null
            {
                out.append "`ind`else\n"
                this.arm(out, gk, iff.alternative, depth, tail)
                m_returns := first and m_returns
            }
        }

        procedure arm(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], stmt: ref[PlannedStatement]?, depth: size_t, tail: bool)
        {
            let ind GpuMsl.indent_of(depth)
            out.append "`ind`{\n"
            m_returns := false
            if stmt <> null
            {
                let s stmt
                let mark m_names.length
                this.statement(out, gk, (*s), depth + 1, tail)
                this.end_scope(mark)
            }
            out.append "`ind`}\n"
        }

        ; Every loop of the source ends where the fault flag is set: the
        ; values after a fault are not the processor's, and a loop over them
        ; need not end.
        procedure while_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], wh: PlannedWhile, depth: size_t)
        {
            if wh.cond.binding_item.name <> null
            {
                this.refuse("a while that binds a name")
                return
            }
            if wh.cond.operation = null or wh.cond.operation.length <> 1
            {
                this.refuse("a condition that is no single value")
                return
            }
            let ind GpuMsl.indent_of(depth)
            out.append "`ind`while (`this.fault_name()` == 0u)\n`ind`{\n"
            let mark m_names.length
            ; the condition is computed again each round, inside the loop
            let c this.operand(out, gk, (*wh.cond.operation)[0], depth + 1)
            if m_refused
                return
            if m_atom_kind <> 1
            {
                this.refuse("a condition that is no bool")
                return
            }
            if m_wgsl
                out.append "`ind`    if (!`c`) { break; }\n"
            else
                out.append "`ind`    if (!`c`) break;\n"
            m_depth := m_depth + 1
            this.body(out, gk, wh.body, depth + 1, false)
            m_depth := m_depth - 1
            this.end_scope(mark)
            out.append "`ind`}\n"
        }

        procedure repeat_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], rp: PlannedRepeat, depth: size_t)
        {
            let ind GpuMsl.indent_of(depth)
            out.append "`ind`while (`this.fault_name()` == 0u)\n`ind`{\n"
            let mark m_names.length
            m_depth := m_depth + 1
            this.body(out, gk, rp.body, depth + 1, false)
            m_depth := m_depth - 1
            this.end_scope(mark)
            out.append "`ind`}\n"
        }

        ; `for j in n` inside the body: 0 up to n, the counter of n's type,
        ; compared signed -- n is computed once, before the loop.
        procedure for_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], fr: PlannedFor, depth: size_t)
        {
            if fr.is_iterator_loop
            {
                this.refuse("iterates a collection")
                return
            }
            if fr.expr = null or fr.expr.length <> 1
            {
                this.refuse("a count that is no single value")
                return
            }
            let ind GpuMsl.indent_of(depth)
            let limit this.operand(out, gk, (*fr.expr)[0], depth)
            if m_refused
                return
            let ck m_atom_kind
            if GpuMsl.is_int(ck) = false
            {
                this.refuse("a count that is no integer")
                return
            }
            let limit_high String(m_atom_high)
            let cname this.fresh_local()
            let t GpuMsl.type_name(ck)
            let st GpuMsl.type_name(GpuMsl.signed_of(ck))
            let start GpuMsl.zero(ck)
            let f this.fault_name()
            if this.is_pair(ck)
            {
                ; the counter is one word: a count of 2^32 rounds or more is
                ; given back, one below zero (a signed count) is no round
                if ck = 5
                    out.append "`ind`if ((`limit_high` != 0u) && ((`limit_high` & 2147483648u) == 0u)) { `f` = 1u; }\n"
                else
                    out.append "`ind`if (`limit_high` != 0u) { `f` = 1u; }\n"
                out.append "`ind`for (var `cname`: u32 = 0u; (`f` == 0u) && (`limit_high` == 0u) && (`cname` < `limit`); `cname`++)\n`ind`{\n"
            }
            else if m_wgsl
            {
                let sk GpuMsl.signed_of(ck)
                out.append "`ind`for (var `cname`: `this.ty(ck)` = `this.zero_of(ck)`; (`f` == 0u) && (`this.conv(sk, cname)` < `this.conv(sk, limit)`); `cname`++)\n`ind`{\n"
            }
            else
                out.append "`ind`for (`t` `cname` = `start`; F == 0u && (`st`)`cname` < (`st`)`limit`; `cname`++)\n`ind`{\n"
            let mark m_names.length
            this.declare(fr.identifier, cname, ck, 0)
            if this.is_pair(ck)
                this.set_high("0u")
            m_depth := m_depth + 1
            this.body(out, gk, fr.body, depth + 1, false)
            m_depth := m_depth - 1
            this.end_scope(mark)
            out.append "`ind`}\n"
        }

        ; out.put(i, v): the round's result, at the thread's position. The
        ; index is the round's number (GpuKernel.is_own_counter) and is not
        ; computed again.
        procedure put_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t)
        {
            if call.args = null or call.args.length <> 3
            {
                this.refuse("a put")
                return
            }
            let name GpuKernel.GpuKernel.receiver_name(call)
            let k GpuKernel.GpuKernel.index_of(&gk.k_outputs, name)
            if k < 0
            {
                this.refuse_named("a put into what the kernel does not give: ", name)
                return
            }
            let ek GpuMsl.int_at(&gk.k_output_kinds, k)
            let ind GpuMsl.indent_of(depth)
            let value this.operand(out, gk, (*call.args)[2], depth)
            if m_refused
                return
            let fitted this.fit(value, m_atom_kind, ek)
            out.append "`ind`o`k`[gid] = `fitted`;\n"
        }

        ; ================================================================
        ; Values. An expression answers an ATOM -- a name or a constant of
        ; the source -- after writing the statements that compute it, and
        ; leaves its kind in m_atom_kind.
        ; ================================================================

        ; An operand where its value is used: of the kind the plan gives it.
        procedure operand(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], op: PlannedOperand, depth: size_t) returns String
        {
            if m_refused
                return ""
            let atom this.expression(out, gk, op, depth)
            if m_refused
                return ""
            let have m_atom_kind
            let want GpuMsl.planned_kind(gk, op)
            if GpuMsl.is_value(have) = false or GpuMsl.is_value(want) = false
            {
                this.refuse("a value that is no value of a card's")
                return ""
            }
            let fitted this.fit(atom, have, want)
            m_atom_kind := want
            fitted
        }

        procedure expression(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], op: PlannedOperand, depth: size_t) returns String
        {
            m_atom_kind := 0
            m_atom_high := String^this("")
            choose op.expr
                when v: Variable
                    return this.variable(out, gk, v.name, op, depth)
                when c: Constant
                {
                    if GpuKernel.GpuKernel.has_members(op)
                    {
                        this.refuse("reads a member of a constant")
                        return ""
                    }
                    return this.constant(c, GpuKernel.GpuKernel.scalar_kind(op.result_type))
                }
                when g: GlobalRef
                    return this.global_value(gk, g, op)
                when call: Call
                {
                    let got this.call_value(out, gk, call, depth)
                    return this.members(out, gk, got, op, depth)
                }
                when as_expr: As
                {
                    if GpuKernel.GpuKernel.has_members(op)
                    {
                        this.refuse("reads a member of a cast")
                        return ""
                    }
                    return this.cast(out, gk, as_expr, depth)
                }
                when tp: Tuple
                {
                    if GpuKernel.GpuKernel.is_grouping(tp) = false
                    {
                        let built this.construction(out, gk, tp, depth)
                        return this.members(out, gk, built, op, depth)
                    }
                    if GpuKernel.GpuKernel.has_members(op)
                    {
                        this.refuse("reads a member of a grouping")
                        return ""
                    }
                    let c_ptr tp.components.get 0
                    if c_ptr = null
                        return ""
                    let comp c_ptr.unwrap()
                    return this.operand(out, gk, (*comp.value)[0], depth)
                }
                when blk: Block
                    return this.value_statement(out, gk, op, depth)
                when iff: If
                    return this.value_statement(out, gk, op, depth)
                else
                    this.refuse("an expression a kernel does not say")
            ""
        }

        ; A block or an `if` in value position: its value goes to a name of
        ; its own, which its last statements write.
        procedure value_statement(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], op: PlannedOperand, depth: size_t) returns String
        {
            if GpuKernel.GpuKernel.has_members(op)
            {
                this.refuse("reads a member of a statement's value")
                return ""
            }
            let kind gk.kind(op.result_type)
            if GpuMsl.is_value(kind) = false
            {
                this.refuse("a statement whose value is no value of a card's")
                return ""
            }
            if this.refuse_pair(kind, "a statement's value")
                return ""
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            out.append(this.declare_name(ind, kind, t, this.zero_of(kind)))
            let saved_sink String(m_sink)
            let saved_kind m_sink_kind
            m_sink := String^this(t)
            m_sink_kind := kind
            choose op.expr
                when blk: Block
                    this.statements(out, gk, blk.statements, depth, true)
                when iff: If
                    this.if_statement(out, gk, iff, depth, true)
                else
                    0
            m_sink := String^this(saved_sink)
            m_sink_kind := saved_kind
            m_atom_kind := kind
            t
        }

        ; A name: one the routine binds, or a scalar of the environment. One
        ; that can change is read into a value at once -- what follows may
        ; write it before the value is used.
        procedure variable(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], name: String, op: PlannedOperand, depth: size_t) returns String
        {
            let li this.lookup(name)
            if li >= 0
            {
                let kind GpuMsl.int_at(&m_kinds, li)
                let cname this.cname_at(li)
                m_atom_kind := kind
                if GpuKernel.GpuKernel.has_members(op)
                    return this.members(out, gk, cname, op, depth)
                if this.is_pair(kind)
                {
                    let h_ptr m_highs.get(li as size_t)
                    if h_ptr <> null
                        m_atom_high := String^this((*h_ptr))
                }
                if GpuMsl.int_at(&m_mutables, li) = 1
                {
                    let ind GpuMsl.indent_of(depth)
                    let t this.temp()
                    out.append(this.declare_value(ind, kind, t, cname))
                    return t
                }
                return cname
            }
            this.external(gk, name, op)
        }

        ; A name from outside the loop: one of the kernel's scalars, by its
        ; place in GpuKernel's list -- itself, or the length of a buffer.
        procedure external(mutable this: GpuMsl, gk: ref[GpuKernel.GpuKernel], name: String, op: PlannedOperand) returns String
        {
            if m_in_function
            {
                this.refuse_named("a function reads ", name)
                return ""
            }
            var idx 0 - 1
            if GpuKernel.GpuKernel.has_members(op)
            {
                ; the length of a buffer, or a field of a record: a scalar
                ; named by the whole chain (GpuKernel.k_uniform_field#)
                var chain StringBuilder()
                chain.append name
                var mi: size_t 0
                while mi < op.member_access.length
                {
                    let ma_ptr op.member_access.get mi
                    if ma_ptr = null or ma_ptr.is_method
                    {
                        this.refuse_named("reads a member of ", name)
                        return ""
                    }
                    chain.append("." as char)
                    chain.append ma_ptr.name
                    mi := mi + 1
                }
                let lname chain.to_string()
                idx := GpuKernel.GpuKernel.index_of(&gk.k_uniforms, lname)
            }
            else
                idx := GpuKernel.GpuKernel.index_of(&gk.k_uniforms, name)
            if idx < 0
            {
                this.refuse_named("a name the kernel does not take: ", name)
                return ""
            }
            m_atom_kind := GpuMsl.int_at(&gk.k_uniform_kinds, idx)
            if this.is_pair(m_atom_kind)
                m_atom_high := String^this("u`idx`_h")
            "u`idx`"
        }

        ; A global: a constant of the program is one of the source, written
        ; where it is read; anything else is a name from outside.
        procedure global_value(mutable this: GpuMsl, gk: ref[GpuKernel.GpuKernel], g: PlannedGlobalRef, op: PlannedOperand) returns String
        {
            let gls: ref[Vector[PlannedGlobal]]? gk.plan_globals
            if gls <> null
            {
                var i: size_t 0
                while i < gls.length
                {
                    let gl_ptr gls.get i
                    if gl_ptr <> null and gl_ptr.mangled_name = g.mangled_name
                    {
                        let gl gl_ptr.unwrap()
                        if gl.is_mutable
                        {
                            this.refuse_named("reads the mutable global ", g.name)
                            return ""
                        }
                        let gkind GpuKernel.GpuKernel.scalar_kind(g.global_type)
                        if GpuKernel.GpuKernel.has_members(op) = false and gkind > 0
                            return this.kernel_constant(gl, gkind)
                    }
                    i := i + 1
                }
            }
            this.external(gk, g.name, op)
        }

        ; The value of a constant of the program, as the processor's code
        ; holds it: an integer written in another width than the global's is
        ; taken unsigned into it.
        procedure kernel_constant(mutable this: GpuMsl, gl: PlannedGlobal, gkind: int) returns String
        {
            if gl.value = null or gl.value.length <> 1
            {
                this.refuse_named("a constant without a single value: ", gl.name)
                return ""
            }
            let vop (*gl.value)[0]
            if GpuKernel.GpuKernel.has_members(vop)
            {
                this.refuse_named("a constant read off a member: ", gl.name)
                return ""
            }
            choose vop.expr
                when c: Constant
                {
                    choose c.value
                        when b: Boolean
                        {
                            if gkind = 1
                            {
                                m_atom_kind := 1
                                if b.value
                                    return "true"
                                return "false"
                            }
                        }
                        when i: Integer
                            return this.global_integer(i.value, GpuKernel.GpuKernel.scalar_kind(vop.result_type), gkind, gl.name)
                        when h: Hex
                            return this.global_integer(h.value, GpuKernel.GpuKernel.scalar_kind(vop.result_type), gkind, gl.name)
                        when f: FloatingPoint
                        {
                            if gkind = 4
                                return this.float_literal(f.value)
                        }
                        else
                            0
                }
                else
                    0
            this.refuse_named("a constant that is no plain number: ", gl.name)
            ""
        }

        procedure global_integer(mutable this: GpuMsl, value: size_t, own: int, gkind: int, name: String) returns String
        {
            if GpuMsl.is_int(own) = false or GpuMsl.is_int(gkind) = false
            {
                this.refuse_named("a constant that is no plain number: ", name)
                return ""
            }
            var v: size_t value
            if GpuMsl.width(own) = 32 and GpuMsl.width(gkind) = 64
                v := v & 0xFFFFFFFF
            m_atom_kind := gkind
            this.integer_text(v, gkind)
        }

        ; A constant where it stands, of the kind the plan gives it.
        procedure constant(mutable this: GpuMsl, c: PlannedConstant, want: int) returns String
        {
            choose c.value
                when b: Boolean
                {
                    if want = 1
                    {
                        m_atom_kind := 1
                        if b.value
                            return "true"
                        return "false"
                    }
                }
                when i: Integer
                {
                    if GpuMsl.is_int(want)
                    {
                        m_atom_kind := want
                        return this.integer_text(i.value, want)
                    }
                }
                when h: Hex
                {
                    if GpuMsl.is_int(want)
                    {
                        m_atom_kind := want
                        return this.integer_text(h.value, want)
                    }
                }
                when f: FloatingPoint
                {
                    if want = 4
                        return this.float_literal(f.value)
                }
                else
                    0
            this.refuse("a constant of another kind than its place")
            ""
        }

        procedure float_constant_of(mutable this: GpuMsl, op: PlannedOperand) returns String
        {
            choose op.expr
                when c: Constant
                {
                    choose c.value
                        when f: FloatingPoint
                            return this.float_literal(f.value)
                        else
                            0
                }
                else
                    0
            this.refuse("a constant that is no floating-point number")
            ""
        }

        ; A floating-point constant: the f32 nearest to what is written, in
        ; the shortest text that reads back as exactly that number.
        procedure float_literal(mutable this: GpuMsl, d: double) returns String
        {
            let x (d as f32) as f64
            if (x = x) = false
            {
                this.refuse("a constant that is no number")
                return ""
            }
            if x > 3.4028235e38 or x < 0.0 - 3.4028235e38
            {
                this.refuse("a constant beyond what an f32 holds")
                return ""
            }
            let text "`x`"
            var plain true
            var negative false
            let n text.get_length()
            var i: size_t 0
            while i < n
            {
                let ch text.get(i)
                if ch = ("." as char) or ch = ("e" as char)
                    plain := false
                if i = 0 and ch = ("-" as char)
                    negative := true
                i := i + 1
            }
            m_atom_kind := 4
            var sb StringBuilder()
            if negative
                sb.append "("
            sb.append text
            if plain
                sb.append ".0"
            sb.append "f"
            if negative
                sb.append ")"
            sb.to_string()
        }

        ; A cast, as the processor's code converts: between integers by the
        ; SOURCE's signedness; an integer to floating point by its own; a
        ; bool is 0 or 1; floating point to an integer where the integer
        ; holds the number cut off, a fault where it does not. Nothing is
        ; cast to a bool: the planner refuses that.
        procedure cast(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], a: PlannedAs, depth: size_t) returns String
        {
            if a.value = null
            {
                this.refuse("a cast of nothing")
                return ""
            }
            let want GpuKernel.GpuKernel.scalar_kind(a.target_type)
            if want < 1 or want > 6
            {
                this.refuse_named("casts to ", a.target_type.name)
                return ""
            }
            let r a.value
            ; `0.5 as f32`: the f32 the cast makes of the constant
            if want = 4 and GpuKernel.GpuKernel.is_float_constant((*r))
                return this.float_constant_of((*r))
            let v this.operand(out, gk, (*r), depth)
            if m_refused
                return ""
            let have m_atom_kind
            let ind GpuMsl.indent_of(depth)
            let wt GpuMsl.type_name(want)
            m_atom_kind := want
            if m_wgsl
            {
                let have_high String(m_atom_high)
                return this.cast_wgsl(out, v, have, have_high, want, depth)
            }
            if have = want
                return v
            if GpuMsl.is_int(have) and GpuMsl.is_int(want)
                return "((`wt`)`v`)"
            if have = 1 and GpuMsl.is_int(want)
                return "((`wt`)(`v` ? 1 : 0))"
            if GpuMsl.is_int(have) and want = 4
            {
                let t this.temp()
                out.append "`ind`const float `t` = (float)`v`;\n"
                return t
            }
            if have = 1 and want = 4
            {
                let t this.temp()
                out.append "`ind`const float `t` = `v` ? 1.0f : 0.0f;\n"
                return t
            }
            if have = 4 and GpuMsl.is_int(want)
            {
                ; the bounds are f32s: below the first and from the second
                ; on the integer does not hold the number cut off
                var low "-2147483648.0f"
                var high "2147483648.0f"
                var keeps_low false
                if want = 2
                    keeps_low := true
                if want = 3
                {
                    low := "-1.0f"
                    high := "4294967296.0f"
                }
                if want = 5
                {
                    low := "-9223372036854775808.0f"
                    high := "9223372036854775808.0f"
                    keeps_low := true
                }
                if want = 6
                {
                    low := "-1.0f"
                    high := "18446744073709551616.0f"
                }
                let t this.temp()
                let none GpuMsl.zero(want)
                out.append "`ind``wt` `t` = `none`;\n"
                if keeps_low
                    out.append "`ind`if (`v` >= `low` && `v` < `high`) `t` = (`wt`)`v`; else F = 1u;\n"
                else
                    out.append "`ind`if (`v` > `low` && `v` < `high`) `t` = (`wt`)`v`; else F = 1u;\n"
                return t
            }
            let msg "a cast from `GpuMsl.type_name(have)` to `wt`"
            this.refuse(msg)
            ""
        }

        ; The same cast in WGSL. A 64-bit value is two words: cut down to
        ; 32 bits it is its low one; made from 32 bits its high one is the
        ; sign's or zero; and it is a floating-point number only where its
        ; high word is zero -- anything else is given back to the processor.
        procedure cast_wgsl(mutable this: GpuMsl, mutable out: ref[StringBuilder], v: String, have: int, have_high: String, want: int, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            let f this.fault_name()
            let from_pair this.is_pair(have)
            let to_pair this.is_pair(want)
            m_atom_high := String^this("")
            if have = want
            {
                if from_pair
                    m_atom_high := String^this(have_high)
                return String(v)
            }
            if GpuMsl.is_int(have) and GpuMsl.is_int(want)
            {
                if from_pair and to_pair
                {
                    m_atom_high := String^this(have_high)
                    return String(v)
                }
                if to_pair
                {
                    if have = 2
                    {
                        m_atom_high := String^this("select(0u, 4294967295u, `v` < 0)")
                        return "u32(`v`)"
                    }
                    m_atom_high := String^this("0u")
                    return String(v)
                }
                return this.conv(want, v)
            }
            if have = 1 and GpuMsl.is_int(want)
            {
                if to_pair
                {
                    m_atom_high := String^this("0u")
                    return "u32(`v`)"
                }
                return this.conv(want, v)
            }
            if GpuMsl.is_int(have) and want = 4
            {
                if from_pair and have_high <> "0u"
                    out.append "`ind`if (`have_high` != 0u) { `f` = 1u; }\n"
                let t this.temp()
                out.append(this.declare_value(ind, 4, t, "f32(`v`)"))
                return t
            }
            if have = 1 and want = 4
            {
                let t this.temp()
                out.append(this.declare_value(ind, 4, t, "select(0.0f, 1.0f, `v`)"))
                return t
            }
            if have = 4 and GpuMsl.is_int(want)
            {
                if this.refuse_pair(want, "a floating-point number cast to one")
                    return ""
                let t this.temp()
                out.append(this.declare_name(ind, want, t, this.zero_of(want)))
                if want = 2
                    out.append "`ind`if ((`v` >= -2147483648.0f) && (`v` < 2147483648.0f)) { `t` = i32(`v`); } else { `f` = 1u; }\n"
                else
                    out.append "`ind`if ((`v` > -1.0f) && (`v` < 4294967296.0f)) { `t` = u32(`v`); } else { `f` = 1u; }\n"
                return t
            }
            let msg "a cast from `GpuMsl.type_name(have)` to `GpuMsl.type_name(want)`"
            this.refuse(msg)
            ""
        }

        ; ================================================================
        ; Calls
        ; ================================================================

        procedure call_value(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t) returns String
        {
            if call.is_indirect
            {
                this.refuse("an indirect call")
                return ""
            }
            if call.is_intrinsic and call.is_operator
            {
                if call.args <> null and call.args.length = 1
                    return this.unary(out, gk, call, depth)
                if call.args <> null and call.args.length = 2
                    return this.binary(out, gk, call, depth)
                this.refuse_named("an operator of no one or two values: ", call.name)
                return ""
            }
            if call.is_intrinsic
            {
                this.refuse_named("uses the intrinsic ", call.name)
                return ""
            }
            if call.name = "[]"
                return this.subscript(out, gk, call, depth)
            if call.name = "put"
            {
                this.refuse("a put as a value")
                return ""
            }
            if call.is_operator
            {
                this.refuse_named("uses a record's operator ", call.name)
                return ""
            }
            this.function_call(out, gk, call, depth)
        }

        ; xs[i]: an element of an input, or a fault where there is none.
        procedure subscript(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t) returns String
        {
            if call.args = null or call.args.length <> 2
            {
                this.refuse("a subscript")
                return ""
            }
            let name GpuKernel.GpuKernel.receiver_name(call)
            let k GpuKernel.GpuKernel.index_of(&gk.k_buffers, name)
            if k < 0
            {
                this.refuse_named("a subscript of what the kernel does not take: ", name)
                return ""
            }
            let ek GpuMsl.int_at(&gk.k_buffer_kinds, k)
            let idx this.operand(out, gk, (*call.args)[1], depth)
            if m_refused
                return ""
            if GpuMsl.is_int(m_atom_kind) = false
            {
                this.refuse("an index that is no integer")
                return ""
            }
            let idx_kind m_atom_kind
            let idx_high String(m_atom_high)
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            let at this.temp()
            if m_wgsl
            {
                out.append(this.declare_name(ind, ek, t, this.zero_of(ek)))
                if this.is_pair(idx_kind)
                    out.append(this.fault_where(ind, "(`idx_high` != 0u) || (`idx` >= n`k`)", "`t` = b`k`[`idx`]"))
                else
                {
                    out.append(this.declare_value(ind, 3, at, this.conv(3, idx)))
                    out.append(this.fault_where(ind, "`at` >= n`k`", "`t` = b`k`[`at`]"))
                }
            }
            else
            {
                out.append "`ind``GpuMsl.type_name(ek)` `t` = `GpuMsl.zero(ek)`;\n"
                out.append "`ind`const ulong `at` = (ulong)`idx`;\n"
                out.append "`ind`if (`at` >= n`k`) F = 1u; else `t` = b`k`[`at`];\n"
            }
            m_atom_kind := ek
            m_atom_high := String^this("")
            t
        }

        procedure function_call(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t) returns String
        {
            let builtin gk.builtin_of(call)
            if builtin.get_length() > 0
                return this.builtin_call(out, gk, call, builtin, depth)
            let fi GpuKernel.GpuKernel.index_of(&gk.k_functions, call.mangled_name)
            let idx GpuMsl.function_index(gk, call.mangled_name)
            let fns: ref[Vector[PlannedFunction]]? gk.plan_functions
            if fi < 0 or idx < 0 or fns = null
            {
                this.refuse_named("calls a function the kernel does not hold: ", call.name)
                return ""
            }
            let f_ptr fns.get(idx as size_t)
            if f_ptr = null
                return ""
            let func f_ptr.unwrap()
            if func.return_type = null
            {
                this.refuse_named(call.name, " answers nothing")
                return ""
            }
            let rt func.return_type
            let rk gk.kind((*rt))
            var n_params: size_t 0
            if func.input <> null
                n_params := func.input.length
            var n_args: size_t 0
            if call.args <> null
                n_args := call.args.length
            if n_params <> n_args
            {
                this.refuse_named("another count of arguments than parameters: ", call.name)
                return ""
            }
            var args StringBuilder()
            var ai: size_t 0
            while ai < n_args
            {
                let a this.operand(out, gk, (*call.args)[ai], depth)
                if m_refused
                    return ""
                let have m_atom_kind
                let p_ptr func.input.get ai
                if p_ptr = null
                    return ""
                let p p_ptr.unwrap()
                if p.item_type = null
                {
                    this.refuse("a parameter without a type")
                    return ""
                }
                let pt p.item_type
                let fitted this.fit(a, have, gk.kind((*pt)))
                if m_refused
                    return ""
                if this.refuse_pair(have, call.name)
                    return ""
                args.append fitted
                args.append ", "
                ai := ai + 1
            }
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            let arg_text args.to_string()
            out.append(this.declare_value(ind, rk, t, "f`fi`(`arg_text``this.fault_arg()`)"))
            m_atom_kind := rk
            m_atom_high := String^this("")
            t
        }

        ; A function of the card's own (GpuKernel.builtin_of#): `sqrtf`,
        ; which Metal's safe math and the processor round alike -- WGSL's
        ; does not promise it, and floating point goes there only relaxed.
        procedure builtin_call(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, builtin: String, depth: size_t) returns String
        {
            let a this.operand(out, gk, (*call.args)[0], depth)
            if m_refused
                return ""
            let fitted this.fit(a, m_atom_kind, 4)
            if m_refused
                return ""
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            if m_wgsl
                out.append(this.declare_value(ind, 4, t, "`builtin`(`fitted`)"))
            else
                out.append(this.declare_value(ind, 4, t, "precise::`builtin`(`fitted`)"))
            m_atom_kind := 4
            m_atom_high := String^this("")
            t
        }

        ; ================================================================
        ; Operators of the language on numbers
        ; ================================================================

        procedure unary(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t) returns String
        {
            let a this.operand(out, gk, (*call.args)[0], depth)
            if m_refused
                return ""
            let k m_atom_kind
            let nm call.name
            let ind GpuMsl.indent_of(depth)
            let tn GpuMsl.type_name(k)
            let un GpuMsl.type_name(GpuMsl.unsigned_of(k))
            let sn GpuMsl.type_name(GpuMsl.signed_of(k))
            if this.refuse_pair(k, nm)
                return ""
            if m_wgsl
                return this.unary_wgsl(out, nm, a, k, depth)
            if nm = "+" and k <> 1
                return a
            if nm = "-" and k = 4
            {
                let t this.temp()
                out.append "`ind`const float `t` = -`a`;\n"
                return t
            }
            if nm = "-" and GpuMsl.is_int(k)
            {
                let t this.temp()
                out.append "`ind`const `tn` `t` = (`tn`)((`un`)0 - (`un`)`a`);\n"
                return t
            }
            if nm = "abs" and k = 4
            {
                let t this.temp()
                out.append "`ind`const float `t` = (`a` < 0.0f) ? -`a` : `a`;\n"
                return t
            }
            if nm = "abs" and GpuMsl.is_int(k)
            {
                ; the processor's code asks the sign of an unsigned one too
                let t this.temp()
                out.append "`ind`const `tn` `t` = ((`sn`)`a` < 0) ? (`tn`)((`un`)0 - (`un`)`a`) : `a`;\n"
                return t
            }
            if nm = "!" or nm = "not" or nm = "~"
            {
                if k = 1
                {
                    let t this.temp()
                    out.append "`ind`const bool `t` = !`a`;\n"
                    return t
                }
                if GpuMsl.is_int(k)
                {
                    let t this.temp()
                    out.append "`ind`const `tn` `t` = (`tn`)(~`a`);\n"
                    return t
                }
            }
            let msg "the operator `nm` on a `tn`"
            this.refuse(msg)
            ""
        }

        procedure unary_wgsl(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, a: String, k: int, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            let uk GpuMsl.unsigned_of(k)
            let nothing this.conv(uk, "0")
            let negated this.conv(k, "`nothing` - `this.conv(uk, a)`")
            if nm = "+" and k <> 1
                return String(a)
            let t this.temp()
            if nm = "-" and k = 4
            {
                out.append(this.declare_value(ind, 4, t, "-`a`"))
                return t
            }
            if nm = "-" and GpuMsl.is_int(k)
            {
                out.append(this.declare_value(ind, k, t, negated))
                return t
            }
            if nm = "abs" and k = 4
            {
                out.append(this.declare_value(ind, 4, t, "select(`a`, -`a`, `a` < 0.0f)"))
                return t
            }
            if nm = "abs" and GpuMsl.is_int(k)
            {
                out.append(this.declare_value(ind, k, t, "select(`a`, `negated`, `this.conv(GpuMsl.signed_of(k), a)` < 0)"))
                return t
            }
            if nm = "!" or nm = "not" or nm = "~"
            {
                if k = 1
                {
                    out.append(this.declare_value(ind, 1, t, "!`a`"))
                    return t
                }
                if GpuMsl.is_int(k)
                {
                    out.append(this.declare_value(ind, k, t, this.conv(k, "~`a`")))
                    return t
                }
            }
            let msg "the operator `nm` on a `GpuMsl.type_name(k)`"
            this.refuse(msg)
            ""
        }

        procedure binary(mutable this: GpuMsl, mutable out: ref[StringBuilder], gk: ref[GpuKernel.GpuKernel], call: PlannedCall, depth: size_t) returns String
        {
            let l this.operand(out, gk, (*call.args)[0], depth)
            if m_refused
                return ""
            let lk m_atom_kind
            let r this.operand(out, gk, (*call.args)[1], depth)
            if m_refused
                return ""
            let rk m_atom_kind
            let r_high String(m_atom_high)
            let nm call.name
            m_atom_high := String^this("")
            if m_wgsl and GpuMsl.is_int(lk) and GpuMsl.is_int(rk)
            {
                ; a shift takes its count as it comes, a 64-bit literal too
                if nm = "<<" or nm = ">>"
                    return this.shift_wgsl(out, nm, l, lk, r, rk, r_high, depth)
                if this.refuse_pair(lk, nm) or this.refuse_pair(rk, nm)
                    return ""
                return this.integer_binary_wgsl(out, nm, l, lk, r, rk, depth)
            }
            if lk = 4 and rk = 4
                return this.float_binary(out, nm, l, r, depth)
            if lk = 1 and rk = 1
                return this.bool_binary(out, nm, l, r, depth)
            if GpuMsl.is_int(lk) and GpuMsl.is_int(rk)
            {
                if nm = "<<" or nm = ">>"
                    return this.shift(out, nm, l, lk, r, rk, depth)
                return this.integer_binary(out, nm, l, lk, r, rk, depth)
            }
            let msg "the operator `nm` on a `GpuMsl.type_name(lk)` and a `GpuMsl.type_name(rk)`"
            this.refuse(msg)
            ""
        }

        procedure float_binary(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, r: String, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            if nm = "+" or nm = "-" or nm = "*" or nm = "/"
            {
                let t this.temp()
                out.append(this.declare_value(ind, 4, t, "`l` `nm` `r`"))
                m_atom_kind := 4
                return t
            }
            let cmp GpuMsl.comparison_text(nm)
            if cmp.get_length() = 0
            {
                this.refuse_named("a floating-point operator: ", nm)
                return ""
            }
            let t this.temp()
            ; `<>` is false where either is no number, as on the processor
            if nm = "<>"
                out.append(this.declare_value(ind, 1, t, "(`l` < `r` || `l` > `r`)"))
            else
                out.append(this.declare_value(ind, 1, t, "`l` `cmp` `r`"))
            m_atom_kind := 1
            t
        }

        ; Both sides are computed, as the processor's code computes them:
        ; the `and` that leaves its right side alone arrives as an `if`.
        procedure bool_binary(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, r: String, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            let t this.temp()
            m_atom_kind := 1
            if nm = "&&" or nm = "and" or nm = "&"
            {
                out.append(this.declare_value(ind, 1, t, "`l` && `r`"))
                return t
            }
            if nm = "||" or nm = "or" or nm = "|"
            {
                out.append(this.declare_value(ind, 1, t, "`l` || `r`"))
                return t
            }
            if nm = "xor" or nm = "^" or nm = "<>"
            {
                out.append(this.declare_value(ind, 1, t, "`l` != `r`"))
                return t
            }
            if nm = "="
            {
                out.append(this.declare_value(ind, 1, t, "`l` == `r`"))
                return t
            }
            this.refuse_named("an operator on bools: ", nm)
            ""
        }

        procedure shift_wgsl(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, lk: int, r: String, rk: int, r_high: String, depth: size_t) returns String
        {
            if this.refuse_pair(lk, nm)
                return ""
            let ind GpuMsl.indent_of(depth)
            let c this.temp()
            let t this.temp()
            if this.is_pair(rk)
            {
                out.append(this.declare_value(ind, 3, c, r))
                out.append(this.fault_where(ind, "(`r_high` != 0u) || (`c` >= 32u)", ""))
            }
            else
            {
                out.append(this.declare_value(ind, 3, c, this.conv(3, r)))
                out.append(this.fault_where(ind, "`c` >= 32u", ""))
            }
            if nm = "<<"
                out.append(this.declare_value(ind, lk, t, this.conv(lk, "`this.conv(3, l)` << (`c` & 31u)")))
            else
                out.append(this.declare_value(ind, lk, t, "`l` >> (`c` & 31u)"))
            m_atom_kind := lk
            t
        }

        procedure integer_binary_wgsl(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, lk: int, r: String, rk: int, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            let signed GpuMsl.is_signed(lk)
            let xk GpuMsl.int_kind(32, signed)
            let wrap GpuMsl.wrapping_text(nm)
            if wrap.get_length() > 0
            {
                let t this.temp()
                out.append(this.declare_value(ind, xk, t, this.conv(xk, "`this.conv(3, l)` `wrap` `this.conv(3, r)`")))
                m_atom_kind := xk
                return t
            }
            var divides false
            var remainder false
            if nm = "/" or nm = "div"
                divides := true
            if nm = "%" or nm = "mod"
            {
                divides := true
                remainder := true
            }
            if divides
            {
                let a this.temp()
                let b this.temp()
                let t this.temp()
                out.append(this.declare_value(ind, xk, a, this.conv(xk, l)))
                out.append(this.declare_value(ind, xk, b, this.conv(xk, r)))
                out.append(this.declare_name(ind, xk, t, this.zero_of(xk)))
                var stops "`b` == 0u"
                if signed
                    stops := "(`b` == 0) || ((`a` == (-2147483647 - 1)) && (`b` == -1))"
                if remainder
                    out.append(this.fault_where(ind, stops, "`t` = `a` % `b`"))
                else
                    out.append(this.fault_where(ind, stops, "`t` = `a` / `b`"))
                m_atom_kind := xk
                return t
            }
            let cmp GpuMsl.comparison_text(nm)
            if cmp.get_length() > 0
            {
                let t this.temp()
                out.append(this.declare_value(ind, 1, t, "`this.conv(xk, l)` `cmp` `this.conv(xk, r)`"))
                m_atom_kind := 1
                return t
            }
            this.refuse_named("an operator on integers: ", nm)
            ""
        }

        ; A shift: as wide as its LEFT side; the count is taken unsigned
        ; into that width. A count of the width or more has no result on the
        ; processor: a fault.
        procedure shift(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, lk: int, r: String, rk: int, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            let ulk GpuMsl.unsigned_of(lk)
            let lt GpuMsl.type_name(lk)
            let ult GpuMsl.type_name(ulk)
            let urt GpuMsl.type_name(GpuMsl.unsigned_of(rk))
            let bits GpuMsl.width(lk)
            let full GpuMsl.small(ulk, bits)
            let mask GpuMsl.small(ulk, bits - 1)
            let c this.temp()
            let t this.temp()
            out.append "`ind`const `ult` `c` = (`ult`)(`urt`)`r`;\n"
            out.append "`ind`if (`c` >= `full`) F = 1u;\n"
            if nm = "<<"
                out.append "`ind`const `lt` `t` = (`lt`)((`ult`)`l` << (`c` & `mask`));\n"
            else if GpuMsl.is_signed(lk)
                out.append "`ind`const `lt` `t` = (`lt`)((`lt`)`l` >> (`c` & `mask`));\n"
            else
                out.append "`ind`const `lt` `t` = (`lt`)((`ult`)`l` >> (`c` & `mask`));\n"
            m_atom_kind := lk
            t
        }

        ; Integers: as wide as the wider side, each widened by its own
        ; signedness; the LEFT side's signedness says which division, which
        ; remainder and which ordering.
        procedure integer_binary(mutable this: GpuMsl, mutable out: ref[StringBuilder], nm: String, l: String, lk: int, r: String, rk: int, depth: size_t) returns String
        {
            let ind GpuMsl.indent_of(depth)
            var bits GpuMsl.width(lk)
            if GpuMsl.width(rk) > bits
                bits := GpuMsl.width(rk)
            let signed GpuMsl.is_signed(lk)
            let xk GpuMsl.int_kind(bits, signed)
            let xt GpuMsl.type_name(xk)
            let ut GpuMsl.type_name(GpuMsl.int_kind(bits, false))
            let wl GpuMsl.widened(l, lk, bits)
            let wr GpuMsl.widened(r, rk, bits)

            ; what wraps on the processor is computed unsigned here
            let wrap GpuMsl.wrapping_text(nm)
            if wrap.get_length() > 0
            {
                let t this.temp()
                out.append "`ind`const `xt` `t` = (`xt`)((`ut`)`wl` `wrap` (`ut`)`wr`);\n"
                m_atom_kind := xk
                return t
            }

            var divides false
            var remainder false
            if nm = "/" or nm = "div"
                divides := true
            if nm = "%" or nm = "mod"
            {
                divides := true
                remainder := true
            }
            if divides
            {
                let a this.temp()
                let b this.temp()
                let t this.temp()
                let nothing GpuMsl.zero(xk)
                out.append "`ind`const `xt` `a` = (`xt`)`wl`;\n"
                out.append "`ind`const `xt` `b` = (`xt`)`wr`;\n"
                out.append "`ind``xt` `t` = `nothing`;\n"
                if signed
                {
                    let low GpuMsl.least(xk)
                    out.append "`ind`if (`b` == `nothing` || (`a` == `low` && `b` == (`xt`)(-1))) F = 1u;\n"
                }
                else
                    out.append "`ind`if (`b` == `nothing`) F = 1u;\n"
                if remainder
                    out.append "`ind`else `t` = (`xt`)(`a` % `b`);\n"
                else
                    out.append "`ind`else `t` = (`xt`)(`a` / `b`);\n"
                m_atom_kind := xk
                return t
            }

            let cmp GpuMsl.comparison_text(nm)
            if cmp.get_length() > 0
            {
                let t this.temp()
                out.append "`ind`const bool `t` = (`xt`)`wl` `cmp` (`xt`)`wr`;\n"
                m_atom_kind := 1
                return t
            }
            this.refuse_named("an operator on integers: ", nm)
            ""
        }
    }
}
