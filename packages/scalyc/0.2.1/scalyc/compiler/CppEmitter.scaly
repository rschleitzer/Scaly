; CppEmitter.scaly - the plan written as C++ (scalyc --emit-cpp)
;
; The second emitter beside Emitter.scaly. It reads the same Plan and writes a
; C++ program instead of LLVM IR, for one purpose: the compiler as a program
; any C++ compiler builds, so that whoever distrusts the seed can build a
; compiler from text and let it emit the seed again (diverse double-compiling;
; the plan lives in the private notes as "trust the trustee").
;
; What the C++ must be:
;   * EXACT where the output of the compiler depends on it -- integer widths,
;     signedness, wrapping, the order of evaluation. The rules are the LLVM
;     emitter's, written out (binary_operation#): an operation is as wide as
;     its wider operand, each operand widens by its own signedness, and a
;     division, a remainder, a right shift and a comparison take the left
;     operand's signedness. Every arithmetic wraps (the LLVM emitter writes no
;     `nsw`), so the C++ is built with -fwrapv.
;   * READABLE: one C++ function per planned routine, under a name read off
;     its symbol (Planner_lookup_method), with the Scaly symbol as its link
;     name (`asm("...")`, a GNU extension gcc and clang share), so overloads
;     need no C++ overloading and two files of one program agree on every
;     name.
;
; Values: a record is a C++ struct, held and returned by value; a parameter of
; record type is a reference (the LLVM emitter passes it by pointer, so a
; procedure's write reaches the caller). A pointer and a reference are C++
; pointers, an Option of a reference the same pointer (null for None).
;
; The first slice (2026-11-06) covers what a program without the prelude
; uses; what it does not cover is written as a `#error` line naming the
; construct, so the C++ compiler refuses rather than a wrong program running.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Array
use scaly.os.File
use scaly.os.Console
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.Planner.*

define CppEmitter
(
    var skip_tests: bool
    var fn_mangled: Array[String]   ; every routine declared, by symbol ...
    var fn_names: Array[String]     ; ... and the C++ name it has here
    var temp_count: size_t          ; names of the temporaries a statement expression needs
    var errors: size_t              ; constructs written as #error
    var returns_value: bool         ; the routine being written answers a value
    var sink: String                ; where a statement in value position puts its value ("" returns it)
    var fn_kinds: Array[String]     ; per routine declared, how each parameter is passed (parameter_kinds#)
    var defined: Array[String]      ; the symbols whose body is written (the plan may list one twice)
    var template_names: Array[String] ; the generic concepts planned as templates (is_concept_template#)
    var no_prelude: bool            ; no runtime: a frame is never forced (--no-prelude, not the stdlib)
    var has_page: bool              ; the routine being written received a frame (its caller page)
    var held: Array[String]         ; locals that hold a record by its address on a page (binding#)
    var locals: Array[String]       ; the names bound in the routine being written
    var fn_ptypes: Array[String]    ; per routine declared, its parameters' C++ types, tab-separated
    var ret_type: PlannedType       ; the result type of the routine being written
    var types_header: String        ; where the standard library writes its records ("" for a program)
    var late: Array[String]         ; declarations of routines met only at a call (declare_from_call#)
    var break_sink: String          ; where `break v` puts v: the repeat in value position being written
)
{
    init()
    {
        skip_tests := false
        fn_mangled := Array[String]()
        fn_names := Array[String]()
        temp_count := 0
        errors := 0
        returns_value := false
        sink := String()
        fn_kinds := Array[String]()
        defined := Array[String]()
        template_names := Array[String]()
        no_prelude := false
        has_page := false
        held := Array[String]()
        locals := Array[String]()
        fn_ptypes := Array[String]()
        ret_type := Planner.make_void_type()
        types_header := String()
        late := Array[String]()
        break_sink := String()
    }

    ; A C++ name no routine may take (a record's).
    procedure reserve(mutable this, name: String)
    {
        if CppEmitter.contains(&this.fn_names, name)
            return
        this.fn_mangled.add(String())
        this.fn_names.add(String(name))
        this.fn_kinds.add(String())
        this.fn_ptypes.add(String())
    }

    ; Writes the plan as one C++ file to `path`. Answers whether it could.
    procedure emit(mutable this, plan: Plan, path: String) returns bool
    {
        var out StringBuilder()
        out.append "// Generated by scalyc --emit-cpp. Do not edit: change the Scaly source.\n"
        out.append "// Build: c++ -std=c++20 -fwrapv -fno-strict-aliasing -ffp-contract=off\n"
        ; no header at all: the C library's names stay Scaly's (a Scaly
        ; constant SIZE_MAX met <cstdint>'s macro), the types are the C++
        ; compiler's own
        out.append "typedef __INT8_TYPE__ int8_t;\ntypedef __INT16_TYPE__ int16_t;\ntypedef __INT32_TYPE__ int32_t;\ntypedef __INT64_TYPE__ int64_t;\n"
        out.append "typedef __UINT8_TYPE__ uint8_t;\ntypedef __UINT16_TYPE__ uint16_t;\ntypedef __UINT32_TYPE__ uint32_t;\ntypedef __UINT64_TYPE__ uint64_t;\n"
        out.append "typedef __SIZE_TYPE__ size_t;\n\n"
        out.append "template <class T> static inline T& scaly_lvalue(T&& x) { return x; }\n"
        out.append "template <class U, class V> static inline U scaly_variant(uint8_t tag, V v) { U u{}; u.tag = tag; __builtin_memcpy(u.data, &v, sizeof v); return u; }\n"
        out.append "template <class U> static inline U scaly_unit_variant(uint8_t tag) { U u{}; u.tag = tag; return u; }\n"
        out.append "template <class V, class U> static inline V scaly_payload(const U& u) { V v; __builtin_memcpy(&v, u.data, sizeof v); return v; }\n"
        out.append "template <class... T> constexpr size_t scaly_max_size() { size_t m = 0; ((m = sizeof(T) > m ? sizeof(T) : m), ...); return m; }\n"
        ; a routine's frame (root_pages.scaly, Frame): its page, made only
        ; when something is allocated on it, and the frame it received
        out.append "struct scaly_frame { void* page; scaly_frame* parent; };\n\n"
        ; a delegate value is an address (Emitter.map_type#, GAP B)
        if plan.delegates <> null
        {
            var seen Array[String]()
            for d in plan.delegates
            {
                let dn CppEmitter.identifier_of(d)
                if CppEmitter.contains(&seen, dn) = false
                {
                    seen.add(String(dn))
                    out.append "typedef void* `dn`;\n"
                }
            }
            out.append("\n" as char)
        }

        ; a program's records of the standard library: the ones its plan lays
        ; out are here, the rest (String, Page, ...) are the library's
        if this.no_prelude = false and this.types_header.get_length() = 0
            out.append "#include \"scaly_types.h\"\n\n"
        var rec StringBuilder()
        ; the records: declared first, then defined, each after the records
        ; it holds by value
        if plan.structures <> null
        {
            for st in plan.structures
            {
                if st.is_generic_placeholder = false and CppEmitter.is_uninstantiated_template(st.mangled_name) = false
                    rec.append "struct `CppEmitter.type_name_of(st.mangled_name)`;\n"
                else
                    this.template_names.add(String(st.mangled_name))
            }
        }
        if plan.unions <> null
        {
            for un in plan.unions
            {
                if un.is_generic_placeholder = false and CppEmitter.is_uninstantiated_template(un.mangled_name) = false
                    rec.append "struct `CppEmitter.type_name_of(un.mangled_name)`;\n"
                else
                    this.template_names.add(String(un.mangled_name))
            }
        }
        rec.append("\n" as char)
        var done Array[String]()
        if plan.structures <> null
        {
            for st in plan.structures
            {
                if st.is_generic_placeholder = false
                    this.define_structure(&rec, plan, st.mangled_name, &done, 0)
            }
        }
        if plan.unions <> null
        {
            for un in plan.unions
            {
                if un.is_generic_placeholder = false
                    this.define_structure(&rec, plan, un.mangled_name, &done, 0)
            }
        }

        ; the standard library's records for the programs (scaly_types.h)
        let records rec.to_string()
        if this.types_header.get_length() > 0
        {
            if File.write_from_string(this.types_header, "// Generated by scalyc --emit-cpp: the standard library's records.\n`records`") = false
            {
                Console.println "error: cannot write `this.types_header`"
                return false
            }
        }
        out.append records
        ; a routine may not be named as a record is
        if plan.structures <> null
        {
            for st in plan.structures
                this.reserve(CppEmitter.type_name_of(st.mangled_name))
        }
        if plan.unions <> null
        {
            for un in plan.unions
                this.reserve(CppEmitter.type_name_of(un.mangled_name))
        }

        ; every routine declared, so the bodies may call each other in any order
        if plan.functions <> null
        {
            for f in plan.functions
            {
                if this.wanted(f) and CppEmitter.contains(&this.fn_mangled, f.mangled_name) = false
                    this.declare_function(&out, f)
            }
            out.append("\n" as char)
        }
        this.runtime(&out, plan)
        this.globals(&out, plan)
        ; the bodies: written apart, since they may call routines the plan
        ; only names at the call (late_declarations#)
        var bodies StringBuilder()
        if plan.functions <> null
        {
            for f in plan.functions
            {
                ; a body only: a module may declare the routine ahead as an
                ; extern under its symbol, and the plan lists that first
                if this.wanted(f) and CppEmitter.has_body(f) and CppEmitter.contains(&this.defined, f.mangled_name) = false
                {
                    this.defined.add(String(f.mangled_name))
                    this.define_function(&bodies, f)
                }
            }
        }

        ; the program's own statements are its main
        if plan.statements <> null
        {
            var n: size_t 0
            for s in plan.statements
                n := n + 1
            if n > 0
            {
                bodies.append "int main(int argc, char** argv)\n{\n"
                this.has_page := false
                this.held := Array[String]()
                this.locals := Array[String]()
                this.returns_value := false
                var b StringBuilder()
                for s in plan.statements
                    this.statement(&b, s, 1, false)
                let text b.to_string()
                if text.contains("scaly_local")
                    bodies.append "    scaly_frame_guard scaly_local{{nullptr, nullptr}};\n"
                bodies.append text
                bodies.append "    return 0;\n}\n"
            }
        }
        if this.late.length > 0
        {
            out.append "// routines of other files the plan names only at their calls\n"
            for d in this.late
                out.append d
            out.append("\n" as char)
        }
        out.append(bodies.to_string())

        ; the free `get` the runtime declares, forwarding to Page.get
        ; (Emitter.ensure_free_page_get#)
        let free_get this.declared_name("_Z3getPv")
        let page_get this.declared_name("_ZN4Page3getEPv")
        if free_get.get_length() > 0 and page_get.get_length() > 0 and CppEmitter.contains(&this.defined, "_Z3getPv") = false and CppEmitter.contains(&this.defined, "_ZN4Page3getEPv")
        {
            let rt CppEmitter.first_return_ctype(plan, "_Z3getPv")
            out.append "\n`rt` `free_get`(void* address)\n{\n    return (`rt`)`page_get`(address);\n}\n"
        }
        ; a program carries its stamp, a hash of its text (Emitter.emit_build_stamp#)
        let text out.to_string()
        if CppEmitter.has_main(text)
            out.append "\nextern \"C\" int64_t scaly_build_stamp()\n{\n    return (int64_t)`CppEmitter.text_hash(text)`ULL;\n}\n"
        if File.write_from_string(path, out.to_string()) = false
        {
            Console.println "error: cannot write `path`"
            return false
        }
        if this.errors > 0
        {
            Console.println "scalyc --emit-cpp: `this.errors` constructs are not translated yet (#error lines in `path`)"
        }
        true
    }

    function has_main(text: String) returns bool
    {
        text.contains("\nint main(int argc, char** argv)")
    }

    ; FNV-1a over the bytes, 64 bits
    function text_hash(text: String) returns size_t
    {
        var h: size_t 0xcbf29ce484222325
        let n text.get_length()
        var i: size_t 0
        while i < n
        {
            h := h xor (text.get(i) as size_t)
            h := h * 0x100000001b3
            i := i + 1
        }
        if h = 0
            h := 1
        h
    }

    function first_return_ctype(plan: Plan, mangled: String) returns String
    {
        if plan.functions = null
            return "void*"
        for f in plan.functions
        {
            if f.mangled_name.equals(mangled)
                return CppEmitter.return_ctype(f)
        }
        "void*"
    }

    function contains(names: ref[Array[String]], name: String) returns bool
    {
        for n in names
        {
            if n.equals(name)
                return true
        }
        false
    }

    procedure wanted(this, f: PlannedFunction) returns bool
    {
        ; a generic routine planned as its template is never called: the
        ; LLVM emitter gives it an empty body (Emitter.is_uninstantiated_template#)
        if CppEmitter.is_uninstantiated_template(f.mangled_name) or this.is_concept_template(f.mangled_name)
            return false
        if this.names_template_type(f)
            return false
        if this.skip_tests and CppEmitter.is_test_name(f.name) and CppEmitter.param_count(f) = 0
            return false
        if f.mangled_name.get_length() = 0
            return false
        true
    }

    ; A parameter or the result of a type planned as its template (a
    ; generic concept without arguments: `Slice` in `_ZN5SliceC1Ev`).
    procedure names_template_type(this, f: PlannedFunction) returns bool
    {
        if f.return_type <> null and this.is_template_type(*f.return_type)
            return true
        if f.input = null
            return false
        for item in f.input
        {
            if item.item_type <> null and this.is_template_type(*item.item_type)
                return true
        }
        false
    }

    procedure is_template_type(this, t: PlannedType) returns bool
    {
        if CppEmitter.is_pointer_type(t)
        {
            var inner CppEmitter.first_generic(t)
            if CppEmitter.is_npo_option(t)
                inner := CppEmitter.first_generic(inner)
            return this.is_template_type(inner)
        }
        if t.mangled_name.get_length() = 0
            return false
        if CppEmitter.is_uninstantiated_template(t.mangled_name)
            return true
        CppEmitter.contains(&this.template_names, t.mangled_name)
    }

    ; Emitter.is_uninstantiated_template#, the same reading of the symbol: a
    ; one-letter type name T, K or V, or any capital letter in a type position.
    function is_uninstantiated_template(mangled: String) returns bool
    {
        let n mangled.get_length()
        if n <= 2
            return false
        var i: size_t 2
        while i < n
        {
            let c mangled.get i
            if c < 0x30 or c > 0x39
            {
                i := i + 1
                continue
            }
            let before mangled.get(i - 1)
            if before = 0x43 or before = 0x44           ; C, D
            {
                i := i + 1
                continue
            }
            var length: size_t 0
            while i < n and mangled.get(i) >= 0x30 and mangled.get(i) <= 0x39
            {
                length := length * 10 + ((mangled.get(i) - 0x30) as size_t)
                i := i + 1
            }
            if before = 0x42                            ; B
            {
                i := i + length
                continue
            }
            if length = 1 and i < n
            {
                let letter mangled.get i
                if letter = 0x54 or letter = 0x4B or letter = 0x56
                    return true
                if letter >= 0x41 and letter <= 0x5A
                {
                    if before = 0x49 or before = 0x52 or before = 0x50 or before = 0x45
                        return true
                }
            }
            i := i + length
        }
        false
    }

    ; Emitter.is_concept_template#: a routine of a generic concept planned
    ; as its template (its name carries the concept's without arguments).
    procedure is_concept_template(this, mangled: String) returns bool
    {
        if this.template_names.length = 0 or mangled.starts_with("_ZN") = false
            return false
        for symbol in this.template_names
        {
            if symbol.starts_with("_Z") and symbol.get_length() >= 3
            {
                var t symbol.substring(2, symbol.get_length() - 2)
                if symbol.starts_with("_ZN") and t.get_length() >= 2
                    t := t.substring(1, t.get_length() - 2)
                let end t.get_length() + 3
                if mangled.get_length() > end and mangled.substring(3, t.get_length()).equals(t)
                {
                    let c mangled.get end
                    if c >= 0x30 and c <= 0x39 and CppEmitter.one_name_then_end(mangled, end)
                        return true
                }
            }
        }
        false
    }

    function one_name_then_end(mangled: String, at: size_t) returns bool
    {
        let n mangled.get_length()
        var i at
        var len: size_t 0
        while i < n and mangled.get(i) >= 0x30 and mangled.get(i) <= 0x39
        {
            len := len * 10 + ((mangled.get(i) - 0x30) as size_t)
            i := i + 1
        }
        let after i + len
        after < n and mangled.get(after) = 0x45
    }

    function is_test_name(name: String) returns bool
    {
        if name = "test"
            return true
        name.starts_with("test_")
    }

    function param_count(f: PlannedFunction) returns size_t
    {
        if f.input = null
            return 0
        f.input.length
    }

    ; ------------------------------------------------------------------
    ; Names
    ; ------------------------------------------------------------------

    ; A readable C++ name off an Itanium symbol: the source names joined by
    ; `_`, `_ZN7Planner13lookup_methodE...` is Planner_lookup_method,
    ; `_Z5Point` is Point. The ABI tags (`B5alpha`) are left out; what the
    ; name does not take apart is its symbol, made a C++ identifier.
    function type_name_of(mangled: String) returns String
    {
        var sb StringBuilder()
        let n mangled.get_length()
        var i: size_t 0
        if n >= 2 and mangled.get(0) = 0x5F and mangled.get(1) = 0x5A    ; _Z
            i := 2
        if i < n and mangled.get(i) = 0x4E      ; N
            i := i + 1
        var parts 0
        repeat
        {
            if i >= n
                break
            var skip false
            if mangled.get(i) = 0x42            ; B: an ABI tag
            {
                skip := true
                i := i + 1
            }
            let c mangled.get i
            if c < 0x30 or c > 0x39
                break
            var len: size_t 0
            while i < n and mangled.get(i) >= 0x30 and mangled.get(i) <= 0x39
            {
                len := len * 10 + ((mangled.get(i) - 0x30) as size_t)
                i := i + 1
            }
            if skip = false
            {
                if parts > 0
                    sb.append("_" as char)
                var k: size_t 0
                while k < len and i + k < n
                {
                    sb.append(mangled.get(i + k) as char)
                    k := k + 1
                }
                parts := parts + 1
            }
            i := i + len
        }
        ; a generic instance or anything else the walk stopped at: its symbol
        if parts = 0 or i < n
        {
            if i < n and mangled.get(i) <> 0x45     ; E ends a nested name
                return CppEmitter.identifier_of(mangled)
            if i + 1 < n
                return CppEmitter.identifier_of(mangled)
        }
        sb.to_string()
    }

    ; The source names of a routine's symbol joined by `_`, its parameters
    ; left out: `_Z9put_digiti` is put_digit, `_ZN5Point3getEv` Point_get.
    ; A routine that is not nested has ONE name; a nested one ends at `E`.
    function routine_name_of(mangled: String) returns String
    {
        var sb StringBuilder()
        let n mangled.get_length()
        var i: size_t 2
        ; a symbol of the plan that is only its source names (a global's)
        if n > 0 and mangled.get(0) >= 0x30 and mangled.get(0) <= 0x39
            i := 0
        else if n < 3 or mangled.get(0) <> 0x5F or mangled.get(1) <> 0x5A
            return CppEmitter.identifier_of(mangled)
        var nested false
        if i < n and mangled.get(i) = 0x4E
        {
            nested := true
            i := i + 1
        }
        var parts 0
        repeat
        {
            if i >= n
                break
            var skip false
            if mangled.get(i) = 0x42            ; B: an ABI tag
            {
                skip := true
                i := i + 1
            }
            if i + 1 < n and mangled.get(i) = 0x43 and parts > 0      ; C1, C2: an initializer
            {
                sb.append "_init"
                break
            }
            if i + 1 < n and mangled.get(i) = 0x44 and mangled.get(i + 1) <> 0x76 and parts > 0      ; D0..D2
            {
                sb.append "_deinit"
                break
            }
            if i >= n or mangled.get(i) < 0x30 or mangled.get(i) > 0x39
                break
            var len: size_t 0
            while i < n and mangled.get(i) >= 0x30 and mangled.get(i) <= 0x39
            {
                len := len * 10 + ((mangled.get(i) - 0x30) as size_t)
                i := i + 1
            }
            if skip = false
            {
                if parts > 0
                    sb.append("_" as char)
                sb.append(CppEmitter.part_name(mangled.substring(i, len)))
                parts := parts + 1
            }
            i := i + len
            ; a generic instance's arguments: past them, to the next name
            if i < n and mangled.get(i) = 0x49     ; I
                i := CppEmitter.skip_arguments(mangled, i)
            if nested = false and parts > 0
                break
        }
        if parts = 0
            return CppEmitter.identifier_of(mangled)
        sb.to_string()
    }

    ; A source name as part of an identifier: an operator's characters by
    ; their names (`++` is op_plus_plus).
    function part_name(raw: String) returns String
    {
        var plain true
        let n raw.get_length()
        var i: size_t 0
        while i < n
        {
            let c raw.get i
            if (c >= 0x30 and c <= 0x39) or (c >= 0x41 and c <= 0x5A) or (c >= 0x61 and c <= 0x7A) or c = 0x5F
                0
            else
                plain := false
            i := i + 1
        }
        if plain
            return raw
        var sb StringBuilder()
        sb.append "op"
        i := 0
        while i < n
        {
            let c raw.get i
            match c
                case 0x2B
                    sb.append "_plus"
                case 0x2D
                    sb.append "_minus"
                case 0x2A
                    sb.append "_star"
                case 0x2F
                    sb.append "_slash"
                case 0x3D
                    sb.append "_eq"
                case 0x25
                    sb.append "_percent"
                case 0x26
                    sb.append "_amp"
                case 0x7C
                    sb.append "_bar"
                case 0x7E
                    sb.append "_tilde"
                case 0x3C
                    sb.append "_lt"
                case 0x3E
                    sb.append "_gt"
                case 0x5B
                    sb.append "_lbracket"
                case 0x5D
                    sb.append "_rbracket"
                case 0x21
                    sb.append "_bang"
                else
                    sb.append "_x"
            i := i + 1
        }
        sb.to_string()
    }

    ; Past one type of an Itanium symbol, starting at `i`.
    function skip_type(m: String, at: size_t) returns size_t
    {
        let n m.get_length()
        var i at
        if i >= n
            return i
        let c m.get i
        if c >= 0x30 and c <= 0x39
        {
            i := CppEmitter.skip_source_name(m, i)
            while i < n and m.get(i) = 0x42         ; B: an ABI tag
                i := CppEmitter.skip_source_name(m, i + 1)
            if i < n and m.get(i) = 0x49
                i := CppEmitter.skip_arguments(m, i)
            return i
        }
        if c = 0x50 or c = 0x52 or c = 0x4B         ; P R K
            return CppEmitter.skip_type(m, i + 1)
        if c = 0x4E                                 ; N ... E
        {
            i := i + 1
            while i < n and m.get(i) <> 0x45
            {
                if m.get(i) = 0x42
                    i := CppEmitter.skip_source_name(m, i + 1)
                else if m.get(i) = 0x49
                    i := CppEmitter.skip_arguments(m, i)
                else
                    i := CppEmitter.skip_source_name(m, i)
            }
            return i + 1
        }
        if c = 0x53 or c = 0x44                     ; S..._ and Dv<n>_<type>
        {
            while i < n and m.get(i) <> 0x5F
                i := i + 1
            if c = 0x44
                return CppEmitter.skip_type(m, i + 1)
            return i + 1
        }
        i + 1
    }

    ; Past `<length><name>` at `i` (a length of none: one character on).
    function skip_source_name(m: String, at: size_t) returns size_t
    {
        let n m.get_length()
        var i at
        var len: size_t 0
        var digits false
        while i < n and m.get(i) >= 0x30 and m.get(i) <= 0x39
        {
            len := len * 10 + ((m.get(i) - 0x30) as size_t)
            i := i + 1
            digits := true
        }
        if digits = false
            return i + 1
        i + len
    }

    ; Past `I <types> E` at `i`.
    function skip_arguments(m: String, at: size_t) returns size_t
    {
        let n m.get_length()
        var i at + 1
        while i < n and m.get(i) <> 0x45
        {
            let next CppEmitter.skip_type(m, i)
            if next <= i
                return n
            i := next
        }
        i + 1
    }

    ; A symbol made an identifier: every character that is none becomes `_`.
    function identifier_of(text: String) returns String
    {
        var sb StringBuilder()
        let n text.get_length()
        var i: size_t 0
        while i < n
        {
            let c text.get i
            if (c >= 0x30 and c <= 0x39) or (c >= 0x41 and c <= 0x5A) or (c >= 0x61 and c <= 0x7A) or c = 0x5F
                sb.append(c as char)
            else
                sb.append("_" as char)
            i := i + 1
        }
        sb.to_string()
    }

    ; A Scaly name as a C++ identifier: a keyword of C++ gains a `_`.
    function local_name(name: String) returns String
    {
        match name
            case "this" case "int" case "char" case "bool" case "float" case "double" case "long" case "short"
            case "signed" case "unsigned" case "void" case "auto" case "class" case "struct" case "union"
            case "enum" case "template" case "typename" case "namespace" case "new" case "delete" case "default"
            case "switch" case "case" case "do" case "goto" case "const" case "static" case "extern" case "register"
            case "volatile" case "inline" case "operator" case "private" case "public" case "protected"
            case "virtual" case "friend" case "explicit" case "export" case "mutable" case "typedef" case "sizeof"
            case "alignof" case "typeid" case "try" case "catch" case "throw" case "true" case "false" case "nullptr"
            case "and" case "or" case "not" case "xor" case "bitand" case "bitor" case "compl" case "main"
            case "asm" case "concept" case "requires" case "union_" case "module" case "import"
            case "int8_t" case "int16_t" case "int32_t" case "int64_t" case "uint8_t" case "uint16_t"
            case "uint32_t" case "uint64_t" case "size_t" case "nullptr_t" case "this_"
                return "`name`_"
        name
    }

    ; The C++ name of the routine with that symbol: its readable name, made
    ; unique in this file by a number (the symbol is its link name).
    procedure function_name(mutable this, mangled: String, entry: bool) returns String
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled)
                return String(this.fn_names[i])
            i := i + 1
        }
        var base CppEmitter.local_name(CppEmitter.routine_name_of(mangled))
        if entry
            base := String("scaly_main")
        var name String(base)
        var k: size_t 2
        var taken true
        while taken
        {
            taken := false
            for other in this.fn_names
            {
                if other.equals(name)
                    taken := true
            }
            if taken
            {
                name := "`base``k`"
                k := k + 1
            }
        }
        this.fn_mangled.add(String(mangled))
        this.fn_names.add(String(name))
        this.fn_kinds.add(String())
        this.fn_ptypes.add(String())
        name
    }

    procedure set_ptypes(mutable this, mangled: String, types: String)
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled)
            {
                this.fn_ptypes.put(i, String(types))
                return
            }
            i := i + 1
        }
    }

    ; The C++ type of parameter k of the routine with that symbol, "" for
    ; none known (the caller page not counted).
    procedure ptype_of(this, mangled: String, k: size_t) returns String
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled) and i < this.fn_ptypes.length
            {
                let all this.fn_ptypes[i]
                var field: size_t 0
                var start: size_t 0
                var j: size_t 0
                let n all.get_length()
                while j <= n
                {
                    if j = n or all.get(j) = 0x09
                    {
                        if field = k
                            return all.substring(start, j - start)
                        field := field + 1
                        start := j + 1
                    }
                    j := j + 1
                }
                return String()
            }
            i := i + 1
        }
        String()
    }

    ; How the routine with that symbol takes its parameters (parameter_kinds#).
    procedure set_kinds(mutable this, mangled: String, kinds: String)
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled)
            {
                this.fn_kinds.put(i, String(kinds))
                return
            }
            i := i + 1
        }
    }

    ; ------------------------------------------------------------------
    ; Types
    ; ------------------------------------------------------------------

    function first_generic(t: PlannedType) returns PlannedType
    {
        if t.generics = null
            return t
        let gs (*t.generics)
        if gs.length = 0
            return t
        gs[0]
    }

    function is_reference_name(name: String) returns bool
    {
        name = "pointer" or name = "ref"
    }

    ; An Option of a reference: the pointer itself, null for None.
    function is_npo_option(t: PlannedType) returns bool
    {
        if t.name <> "Option"
            return false
        CppEmitter.is_reference_name(CppEmitter.first_generic(t).name)
    }

    function is_pointer_type(t: PlannedType) returns bool
    {
        CppEmitter.is_reference_name(t.name) or CppEmitter.is_npo_option(t)
    }

    function is_unit(t: PlannedType) returns bool
    {
        t.name = "()" or t.name = "void" or t.name.get_length() = 0
    }

    ; The scalar C++ type of a primitive name, or "" for none.
    function primitive(name: String) returns String
    {
        match name
            case "int" case "i64"
                return "int64_t"
            case "uint" case "u64" case "size_t"
                return "uint64_t"
            case "i32"
                return "int32_t"
            case "u32"
                return "uint32_t"
            case "i16"
                return "int16_t"
            case "u16"
                return "uint16_t"
            case "i8"
                return "int8_t"
            case "u8" case "char"
                return "uint8_t"
            case "const_char"
                return "const char"
            case "c_size"
                return "size_t"
            case "bool"
                return "bool"
            case "float" case "f32"
                return "float"
            case "double" case "f64"
                return "double"
            case "()" case "void"
                return "void"
        ""
    }

    function ctype(t: PlannedType) returns String
    {
        let p CppEmitter.primitive(t.name)
        if p.get_length() > 0
            return p
        if CppEmitter.is_pointer_type(t)
        {
            var inner CppEmitter.first_generic(t)
            if CppEmitter.is_npo_option(t)
                inner := CppEmitter.first_generic(inner)
            if CppEmitter.is_unit(inner)
                return "void*"
            return "`CppEmitter.ctype(inner)`*"
        }
        if t.mangled_name.get_length() > 0
            return CppEmitter.type_name_of(t.mangled_name)
        CppEmitter.identifier_of(t.name)
    }

    ; How wide an integer of that name is, 0 for none (bool is 1).
    function int_width(name: String) returns size_t
    {
        match name
            case "int" case "i64" case "uint" case "u64" case "size_t" case "c_size"
                return 64
            case "i32" case "u32"
                return 32
            case "i16" case "u16"
                return 16
            case "i8" case "u8" case "char" case "const_char"
                return 8
            case "bool"
                return 1
        0
    }

    ; The LLVM emitter's rule (Emitter.is_signed_type#).
    function is_signed(name: String) returns bool
    {
        match name
            case "u8" case "u16" case "u32" case "u64" case "uint" case "size_t" case "c_size" case "size"
            case "usize" case "bool" case "char"
                return false
        true
    }

    function int_type(width: size_t, signed: bool) returns String
    {
        if width = 1
            return "bool"
        if signed
            return "int`width`_t"
        "uint`width`_t"
    }

    function is_float(name: String) returns bool
    {
        name = "float" or name = "f32" or name = "double" or name = "f64"
    }

    ; a pointer to bytes: what a String casts to as its text
    function is_char_pointer(t: PlannedType) returns bool
    {
        if CppEmitter.is_pointer_type(t) = false
            return false
        let inner CppEmitter.first_generic(t)
        let name inner.name
        match name
            case "char" case "const_char" case "i8" case "u8"
                return true
        false
    }

    function is_record(t: PlannedType) returns bool
    {
        if CppEmitter.primitive(t.name).get_length() > 0
            return false
        if CppEmitter.is_pointer_type(t)
            return false
        true
    }

    ; ------------------------------------------------------------------
    ; Records
    ; ------------------------------------------------------------------

    procedure define_structure(this, mutable out: ref[StringBuilder], plan: Plan, mangled: String, mutable done: ref[Array[String]], depth: size_t)
    {
        for d in done
        {
            if d.equals(mangled)
                return
        }
        if depth > 64
            return
        if plan.structures = null
            return
        for st in plan.structures
        {
            if st.mangled_name.equals(mangled) and CppEmitter.contains(&this.template_names, mangled) = false
            {
                done.add(String(mangled))
                ; first what it holds by value
                if st.properties <> null
                {
                    for p in st.properties
                    {
                        if CppEmitter.is_record(p.prop_type) and p.prop_type.mangled_name.get_length() > 0
                            this.define_structure(out, plan, p.prop_type.mangled_name, done, depth + 1)
                    }
                }
                let guard "SCALY_TYPE_`CppEmitter.identifier_of(st.mangled_name)`"
                out.append "#ifndef `guard`\n#define `guard`\n"
                out.append "struct `CppEmitter.type_name_of(st.mangled_name)`\n{\n"
                if st.properties <> null
                {
                    for p in st.properties
                        out.append "    `CppEmitter.ctype(p.prop_type)` `CppEmitter.local_name(p.name)`;\n"
                }
                out.append "};\n#endif\n\n"
                return
            }
        }
        if plan.unions = null
            return
        for un in plan.unions
        {
            if un.mangled_name.equals(mangled) and CppEmitter.contains(&this.template_names, mangled) = false
            {
                done.add(String(mangled))
                ; a union is a tag byte and its largest variant's bytes,
                ; aligned to one (Emitter.emit_union_type#)
                var sizes StringBuilder()
                if un.variants <> null
                {
                    for v in un.variants
                    {
                        if v.var_type <> null
                        {
                            let vt (*v.var_type)
                            if CppEmitter.is_unit(vt) = false
                            {
                                if CppEmitter.is_record(vt) and vt.mangled_name.get_length() > 0
                                    this.define_structure(out, plan, vt.mangled_name, done, depth + 1)
                                if sizes.get_length() > 0
                                    sizes.append ", "
                                sizes.append(CppEmitter.ctype(vt))
                            }
                        }
                    }
                }
                let guard "SCALY_TYPE_`CppEmitter.identifier_of(un.mangled_name)`"
                out.append "#ifndef `guard`\n#define `guard`\n"
                out.append "struct `CppEmitter.type_name_of(un.mangled_name)`\n{\n    uint8_t tag;\n"
                if sizes.get_length() = 0
                    out.append "    uint8_t data[0];\n"
                else
                    out.append "    uint8_t data[scaly_max_size<`sizes.to_string()`>()];\n"
                out.append "};\n#endif\n\n"
                return
            }
        }
    }

    ; ------------------------------------------------------------------
    ; Routines
    ; ------------------------------------------------------------------

    function is_extern(f: PlannedFunction) returns bool
    {
        choose f.impl
            when e: Extern
                return true
            else
                return false
        false
    }

    function has_body(f: PlannedFunction) returns bool
    {
        choose f.impl
            when a: Action
                return true
            else
                return false
        false
    }

    function is_entry(f: PlannedFunction) returns bool
    {
        f.name = "main" and f.mangled_name.starts_with("_ZN") = false
    }

    function return_ctype(f: PlannedFunction) returns String
    {
        if f.return_type = null
            return "void"
        CppEmitter.ctype(*f.return_type)
    }

    ; The parameter list: a record by reference (the LLVM emitter's pointer),
    ; anything else by value.
    function parameters(f: PlannedFunction, named: bool) returns String
    {
        var sb StringBuilder()
        var first true
        ; the caller page: a frame, first (the order is this file's own)
        if f.page_parameter <> null
        {
            sb.append "scaly_frame*"
            if named
                sb.append " scaly_rp"
            first := false
        }
        if f.input <> null
        {
            for item in f.input
            {
                if item.item_type <> null
                {
                    if first = false
                        sb.append ", "
                    first := false
                    let t (*item.item_type)
                    sb.append(CppEmitter.ctype(t))
                    if CppEmitter.is_record(t)
                        sb.append("&" as char)
                    if named
                    {
                        sb.append(" " as char)
                        if item.name <> null
                        {
                            ; a record's `this` is a reference here and a
                            ; pointer in the body (receiver_line#)
                            if (*item.name).equals("this") and CppEmitter.is_record(t)
                                sb.append "scaly_self"
                            else
                                sb.append(CppEmitter.local_name(*item.name))
                        }
                    }
                }
            }
        }
        sb.to_string()
    }

    ; The four runtime routines a frame and an allocation need, under names
    ; of their own: the plan's where it has them (the standard library's own
    ; file), else declared by their symbols; without a runtime at all, a
    ; frame is never forced.
    procedure runtime(mutable this, mutable out: ref[StringBuilder], plan: Plan)
    {
        let ff this.declared_name("_Z17scaly_force_frameP5Frame")
        let ffp CppEmitter.first_param_ctype(plan, "_Z17scaly_force_frameP5Frame")
        if ff.get_length() > 0
            out.append "static inline void* scaly_rt_force_frame(scaly_frame* f) { return (void*)`ff`((`ffp`)f); }\n"
        else if this.no_prelude
            out.append "static inline void* scaly_rt_force_frame(scaly_frame* f) { return nullptr; }\n"
        else
            out.append "void* scaly_rt_force_frame(scaly_frame* f) asm(\"_Z17scaly_force_frameP5Frame\");\n"
        let rf this.declared_name("_Z19scaly_release_frameP5Frame")
        let rfp CppEmitter.first_param_ctype(plan, "_Z19scaly_release_frameP5Frame")
        if rf.get_length() > 0
            out.append "static inline void scaly_rt_release_frame(scaly_frame* f) { `rf`((`rfp`)f); }\n"
        else if this.no_prelude
            out.append "static inline void scaly_rt_release_frame(scaly_frame* f) { }\n"
        else
            out.append "void scaly_rt_release_frame(scaly_frame* f) asm(\"_Z19scaly_release_frameP5Frame\");\n"
        let pg this.declared_name("_Z3getPv")
        let mg this.declared_name("_ZN4Page3getEPv")
        if pg.get_length() > 0
            out.append "static inline void* scaly_rt_page_get(void* a) { return (void*)`pg`(a); }\n"
        else if mg.get_length() > 0 and CppEmitter.defines(plan, "_ZN4Page3getEPv")
        {
            ; the free `get` other files call, where Page.get has its body
            ; (Emitter.ensure_free_page_get#)
            out.append "void* scaly_rt_page_get(void* a) asm(\"_Z3getPv\");\n"
            out.append "void* scaly_rt_page_get(void* a) { return (void*)`mg`(a); }\n"
        }
        else
            out.append "void* scaly_rt_page_get(void* a) asm(\"_Z3getPv\");\n"
        let sb this.declared_name("_ZN6String10get_bufferEv")
        if sb.get_length() > 0
        {
            let st CppEmitter.first_param_ctype(plan, "_ZN6String10get_bufferEv")
            out.append "static inline const char* scaly_rt_cstr(void* s) { const char* b = (const char*)`sb`(*(`st`*)s); return b ? b : \"\"; }\n"
        }
        else
        {
            out.append "uint8_t* scaly_rt_string_buffer(void* s) asm(\"_ZN6String10get_bufferEv\");\n"
            out.append "static inline const char* scaly_rt_cstr(void* s) { const char* b = (const char*)scaly_rt_string_buffer(s); return b ? b : \"\"; }\n"
        }
        let al this.declared_name("_ZN4Page8allocateEmm")
        if al.get_length() > 0
        {
            let pt CppEmitter.first_param_ctype(plan, "_ZN4Page8allocateEmm")
            out.append "static inline void* scaly_rt_allocate(void* page, uint64_t size, uint64_t align) { return (void*)`al`(*(`pt`*)page, size, align); }\n"
        }
        else
            out.append "void* scaly_rt_allocate(void* page, uint64_t size, uint64_t align) asm(\"_ZN4Page8allocateEmm\");\n"
        ; released on every way out, after the value returned is made
        ; (Emitter.emit_release_before_return#)
        out.append "struct scaly_frame_guard { scaly_frame f; ~scaly_frame_guard() { scaly_rt_release_frame(&f); } };\n\n"
    }

    procedure declared_name(this, mangled: String) returns String
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled)
                return String(this.fn_names[i])
            i := i + 1
        }
        String()
    }

    function defines(plan: Plan, mangled: String) returns bool
    {
        if plan.functions = null
            return false
        for f in plan.functions
        {
            if f.mangled_name.equals(mangled) and CppEmitter.has_body(f)
                return true
        }
        false
    }

    function first_param_ctype(plan: Plan, mangled: String) returns String
    {
        if plan.functions = null
            return "void*"
        for f in plan.functions
        {
            if f.mangled_name.equals(mangled)
                return CppEmitter.parameter_ctype(f, 0)
        }
        "void*"
    }

    ; The globals: a `mutable` one thread-local (a `shared` one process-
    ; wide), a constant internal, one of another package only declared.
    procedure globals(mutable this, mutable out: ref[StringBuilder], plan: Plan)
    {
        if plan.globals = null
            return
        for g in plan.globals
        {
            if CppEmitter.contains(&this.fn_mangled, g.mangled_name) = false
            {
                let name this.function_name(g.mangled_name, false)
                let t CppEmitter.ctype(g.global_type)
                var tls String()
                if g.is_mutable and g.is_shared = false
                    tls := String("thread_local ")
                if g.global_type.array_size.get_length() > 0
                    out.append "static const `CppEmitter.ctype(CppEmitter.first_generic(g.global_type))` `name`[] = { `this.array_elements(g)` };\n"
                else if g.is_foreign
                    out.append "extern `tls``t` `name` asm(\"`g.mangled_name`\");\n"
                else
                {
                    var initial String("{}")
                    if g.value <> null and g.value.length > 0
                        initial := this.converted(g.value, g.global_type)
                    if g.is_mutable
                        out.append "`tls``t` `name` asm(\"`g.mangled_name`\") = `initial`;\n"
                    else
                        out.append "static const `t` `name` = `initial`;\n"
                }
            }
        }
        out.append("\n" as char)
    }

    ; The elements of a constant array global: the rows of its matrix.
    procedure array_elements(mutable this, g: PlannedGlobal) returns String
    {
        var sb StringBuilder()
        if g.value = null or g.value.length = 0
            return sb.to_string()
        let et CppEmitter.first_generic(g.global_type)
        choose (*g.value)[0].expr
            when mx: Matrix
            {
                if mx.operations <> null
                {
                    var first true
                    for row in mx.operations
                    {
                        for cell in row
                        {
                            if first = false
                                sb.append ", "
                            first := false
                            sb.append "(`CppEmitter.ctype(et)`)(`this.operand(cell)`)"
                        }
                    }
                }
            }
            else
                0
        sb.to_string()
    }

    procedure declare_function(mutable this, mutable out: ref[StringBuilder], f: PlannedFunction)
    {
        ; an extern under a Scaly symbol (a module declaring a routine of
        ; another ahead of it) is that routine: linked by its symbol, as the
        ; LLVM emitter does
        if CppEmitter.is_extern(f) and f.mangled_name.equals(f.name)
        {
            ; once: the modules declare a C function each in their own words
            if CppEmitter.contains(&this.fn_names, f.name)
                return
            this.fn_mangled.add(String(f.mangled_name))
            this.fn_names.add(String(f.name))
            this.fn_kinds.add(CppEmitter.parameter_kinds(f))
            this.fn_ptypes.add(CppEmitter.parameter_ctypes(f))
            out.append "extern \"C\" `CppEmitter.return_ctype(f)` `f.name`(`CppEmitter.parameters(f, false)`);\n"
            return
        }
        let name this.function_name(f.mangled_name, CppEmitter.is_entry(f))
        this.set_kinds(f.mangled_name, CppEmitter.parameter_kinds(f))
        this.set_ptypes(f.mangled_name, CppEmitter.parameter_ctypes(f))
        out.append "`CppEmitter.return_ctype(f)` `name`(`CppEmitter.parameters(f, false)`)"
        if CppEmitter.is_entry(f) = false
            out.append " asm(\"`f.mangled_name`\")"
        out.append ";\n"
    }

    procedure define_function(mutable this, mutable out: ref[StringBuilder], f: PlannedFunction)
    {
        choose f.impl
            when a: Action
            {
                let name this.function_name(f.mangled_name, CppEmitter.is_entry(f))
                out.append "\n// `f.file`\n"
                ; a definition every file may hold (a generic instance in the
                ; library and in the program): weak, the LLVM emitter's
                ; linkonce_odr; the entry is the one strong definition
                if CppEmitter.is_entry(f) = false
                    out.append "__attribute__((weak)) "
                out.append "`CppEmitter.return_ctype(f)` `name`(`CppEmitter.parameters(f, true)`)\n{\n"
                let receiver CppEmitter.receiver_line(f)
                if receiver.get_length() > 0
                    out.append receiver
                this.has_page := f.page_parameter <> null
                this.held := Array[String]()
                this.locals := Array[String]()
                if f.input <> null
                {
                    for item in f.input
                    {
                        if item.name <> null
                            this.locals.add(String(*item.name))
                    }
                }
                var named_page String()
                if this.has_page
                {
                    ; a page parameter of a name of its own is the page itself
                    let pname String(*f.page_parameter)
                    if pname.equals("_rp") = false and pname.equals("rp") = false
                    {
                        named_page := "    void* `CppEmitter.local_name(pname)` = scaly_rt_force_frame(scaly_rp);\n"
                        this.locals.add(pname)
                    }
                }
                this.returns_value := f.return_type <> null and CppEmitter.is_unit(*f.return_type) = false
                if f.return_type <> null
                    this.ret_type := (*f.return_type)
                ; the body first: the frame is there only where the body uses
                ; it, as the LLVM emitter makes it on demand -- the runtime's
                ; own routines must have none (scaly_release_frame would
                ; release itself)
                var b StringBuilder()
                this.body(&b, a, 1, this.returns_value)
                let text b.to_string()
                if text.contains("scaly_local") or named_page.get_length() > 0
                {
                    if this.has_page
                        out.append "    scaly_frame_guard scaly_local{{nullptr, scaly_rp}};\n"
                    else
                        out.append "    scaly_frame_guard scaly_local{{nullptr, nullptr}};\n"
                }
                out.append named_page
                out.append text
                out.append "}\n"
            }
            else
                return
        if CppEmitter.is_entry(f)
        {
            out.append "\nint main(int argc, char** argv)\n{\n"
            if CppEmitter.param_count(f) = 2
                out.append "    return (int)scaly_main(argc, (`CppEmitter.parameter_ctype(f, 1)`)argv);\n"
            else
                out.append "    return (int)scaly_main();\n"
            out.append "}\n"
        }
    }

    ; A record's `this`: the body reads it as a pointer.
    function receiver_line(f: PlannedFunction) returns String
    {
        if f.input = null
            return String()
        for item in f.input
        {
            if item.name <> null and item.item_type <> null
            {
                let t (*item.item_type)
                if (*item.name).equals("this") and CppEmitter.is_record(t)
                    return "    `CppEmitter.ctype(t)`* this_ = &scaly_self;\n"
            }
        }
        String()
    }

    ; How each parameter is passed: R a record (by reference), P a pointer,
    ; V anything else.
    function parameter_kinds(f: PlannedFunction) returns String
    {
        var sb StringBuilder()
        if f.page_parameter <> null
            sb.append("F" as char)
        if f.input <> null
        {
            for item in f.input
            {
                if item.item_type <> null
                {
                    let t (*item.item_type)
                    if CppEmitter.is_record(t)
                        sb.append("R" as char)
                    else if CppEmitter.is_pointer_type(t)
                        sb.append("P" as char)
                    else
                        sb.append("V" as char)
                }
            }
        }
        sb.to_string()
    }

    function parameter_ctypes(f: PlannedFunction) returns String
    {
        var sb StringBuilder()
        if f.input <> null
        {
            var first true
            for item in f.input
            {
                if item.item_type <> null
                {
                    if first = false
                        sb.append("\t" as char)
                    first := false
                    sb.append(CppEmitter.ctype(*item.item_type))
                }
            }
        }
        sb.to_string()
    }

    function parameter_ctype(f: PlannedFunction, k: size_t) returns String
    {
        if f.input = null
            return "void*"
        let items (*f.input)
        let item items[k]
        if item.item_type = null
            return "void*"
        CppEmitter.ctype(*item.item_type)
    }

    ; ------------------------------------------------------------------
    ; Statements
    ; ------------------------------------------------------------------

    function indent_of(depth: size_t) returns String
    {
        var sb StringBuilder()
        var i: size_t 0
        while i < depth
        {
            sb.append "    "
            i := i + 1
        }
        sb.to_string()
    }

    ; An action: an assignment when it has a target, else its value --
    ; returned where `tail` says it is the routine's result.
    procedure action(mutable this, mutable out: ref[StringBuilder], a: PlannedAction, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        if a.target <> null and a.target.length > 0
        {
            let target (*a.target)[0]
            if a.source <> null and a.source.length > 0 and target.member_access = null
            {
                choose target.expr
                    when v: Variable
                    {
                        if CppEmitter.contains(&this.held, v.name)
                        {
                            let at this.storage((*a.source)[0])
                            if at.get_length() > 0
                            {
                                out.append "`ind``CppEmitter.local_name(v.name)` = `at`;\n"
                                return
                            }
                        }
                    }
                    else
                        0
            }
            let tt this.cpp_type(target)
            out.append "`ind``this.operands(a.target)` = `this.converted(a.source, tt)`;\n"
            return
        }
        if a.source = null or a.source.length = 0
            return
        let op (*a.source)[0]
        ; control flow keeps its shape: as a statement, its arms carry the tail
        choose op.expr
            when b: Block
            {
                if op.member_access = null
                {
                    this.block(out, b, depth, tail)
                    return
                }
            }
            when i: If
            {
                if op.member_access = null
                {
                    this.if_statement(out, i, depth, tail)
                    return
                }
            }
            when w: While
            {
                this.while_statement(out, w, depth)
                return
            }
            when ch: Choose
            {
                if op.member_access = null
                {
                    this.choose_statement(out, ch, depth, tail)
                    return
                }
            }
            when mt: Match
            {
                if op.member_access = null
                {
                    this.match_statement(out, mt, depth, tail)
                    return
                }
            }
            when f: For
            {
                this.for_statement(out, f, depth)
                return
            }
            when r: Repeat
            {
                if CppEmitter.is_unit(r.value_type)
                {
                    this.repeat_statement(out, r, depth)
                    return
                }
            }
            else
                0
        let text this.operand(op)
        if text.get_length() = 0
            return
        if tail and CppEmitter.is_unit(op.result_type) = false
        {
            if this.sink.get_length() > 0
                out.append "`ind``this.sink` = `text`;\n"
            else
                out.append "`ind`return `this.converted(a.source, this.ret_type)`;\n"
        }
        else
            out.append "`ind``text`;\n"
    }

    ; The statements of a body: a block's own, without a second pair of
    ; braces around them.
    procedure body(mutable this, mutable out: ref[StringBuilder], a: PlannedAction, depth: size_t, tail: bool)
    {
        if a.target = null and a.source <> null and a.source.length = 1
        {
            let op (*a.source)[0]
            if op.member_access = null
            {
                choose op.expr
                    when b: Block
                    {
                        this.statements(out, b.statements, depth, tail)
                        return
                    }
                    else
                        0
            }
        }
        this.action(out, a, depth, tail)
    }

    procedure block(mutable this, mutable out: ref[StringBuilder], b: PlannedBlock, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        out.append "`ind`{\n"
        this.statements(out, b.statements, depth + 1, tail)
        out.append "`ind`}\n"
    }

    procedure statements(mutable this, mutable out: ref[StringBuilder], ss: ref[Vector[PlannedStatement]]?, depth: size_t, tail: bool)
    {
        if ss = null
            return
        let n ss.length
        var i: size_t 0
        for s in ss
        {
            this.statement(out, s, depth, tail and i + 1 = n)
            i := i + 1
        }
    }

    procedure statement(mutable this, mutable out: ref[StringBuilder], s: PlannedStatement, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        choose s
            when a: Action
                this.action(out, a, depth, tail)
            when b: Binding
                this.binding(out, b, depth)
            when r: Return
            {
                if r.result = null or r.result.length = 0 or this.returns_value = false
                    out.append "`ind`return;\n"
                else
                    out.append "`ind`return `this.converted(r.result, this.ret_type)`;\n"
            }
            when br: Break
            {
                if br.result <> null and br.result.length > 0
                {
                    if this.break_sink.get_length() > 0
                        out.append "`ind``this.break_sink` = `this.operands(br.result)`;\n"
                    else
                    {
                        out.append "#error \"break with a value outside a repeat\"\n"
                        this.errors := this.errors + 1
                    }
                }
                out.append "`ind`break;\n"
            }
            when c: Continue
                out.append "`ind`continue;\n"
            when t: Throw
            {
                out.append "#error \"throw\"\n"
                this.errors := this.errors + 1
            }
    }

    procedure binding(mutable this, mutable out: ref[StringBuilder], b: PlannedBinding, depth: size_t)
    {
        let ind CppEmitter.indent_of(depth)
        var name String("_")
        if b.binding_item.name <> null
            name := CppEmitter.local_name(*b.binding_item.name)
        var t: PlannedType Planner.make_void_type()
        var known false
        if b.binding_item.item_type <> null
        {
            t := (*b.binding_item.item_type)
            known := true
        }
        if known = false and b.operation <> null and b.operation.length > 0
        {
            t := (*b.operation)[0].result_type
            known := true
        }
        if b.operation = null or b.operation.length = 0
        {
            ; `var buffer u8[64]`: an array on the stack, its name its start
            if t.array_size.get_length() > 0
            {
                var elem t
                if CppEmitter.is_pointer_type(t)
                    elem := CppEmitter.first_generic(t)
                out.append "`ind``CppEmitter.ctype(elem)` `name`[`t.array_size`] {};\n"
                if b.binding_item.name <> null
                    this.locals.add(String(*b.binding_item.name))
                return
            }
            out.append "`ind``CppEmitter.ctype(t)` `name` {};\n"
            return
        }
        if b.binding_item.name <> null
            this.locals.add(String(*b.binding_item.name))
        if CppEmitter.is_record(t) and b.binding_type <> "copy"
        {
            let at this.storage((*b.operation)[0])
            if at.get_length() > 0
            {
                out.append "`ind``CppEmitter.ctype(t)`* `name` = `at`;\n"
                if b.binding_item.name <> null
                    this.held.add(String(*b.binding_item.name))
                return
            }
        }
        let value this.converted(b.operation, t)
        out.append "`ind``CppEmitter.ctype(t)` `name` = `value`;\n"
    }

    procedure if_statement(mutable this, mutable out: ref[StringBuilder], i: PlannedIf, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        out.append "`ind`if (`this.operands(i.condition)`)\n"
        this.arm(out, i.consequent, depth, tail)
        if i.alternative <> null
        {
            out.append "`ind`else\n"
            this.arm(out, i.alternative, depth, tail)
        }
    }

    procedure arm(mutable this, mutable out: ref[StringBuilder], s: ref[PlannedStatement]?, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        out.append "`ind`{\n"
        if s <> null
        {
            choose *s
                when a: Action
                    this.body(out, a, depth + 1, tail)
                else
                    this.statement(out, *s, depth + 1, tail)
        }
        out.append "`ind`}\n"
    }

    procedure while_statement(mutable this, mutable out: ref[StringBuilder], w: PlannedWhile, depth: size_t)
    {
        let ind CppEmitter.indent_of(depth)
        if w.cond.binding_item.name <> null and w.cond.operation <> null and w.cond.operation.length > 0
        {
            ; `while x next()`: bound and tested, as long as it is not null
            let wn String(*w.cond.binding_item.name)
            this.locals.add(String(wn))
            let wt (*w.cond.operation)[0].result_type
            out.append "`ind`while (`CppEmitter.ctype(wt)` `CppEmitter.local_name(wn)` = `this.operands(w.cond.operation)`)\n"
        }
        else
            out.append "`ind`while (`this.operands(w.cond.operation)`)\n"
        out.append "`ind`{\n"
        this.body(out, w.body, depth + 1, false)
        out.append "`ind`}\n"
    }

    procedure repeat_statement(mutable this, mutable out: ref[StringBuilder], r: PlannedRepeat, depth: size_t)
    {
        let ind CppEmitter.indent_of(depth)
        out.append "`ind`for (;;)\n`ind`{\n"
        this.body(out, r.body, depth + 1, false)
        out.append "`ind`}\n"
    }

    ; `for i in n`: 0 up to n, compared signed in the end's width
    ; (Emitter.emit_for_integer_range#)
    procedure for_statement(mutable this, mutable out: ref[StringBuilder], f: PlannedFor, depth: size_t)
    {
        let ind CppEmitter.indent_of(depth)
        if f.is_iterator_loop
        {
            this.iterator_loop(out, f, depth)
            return
        }
        if f.expr = null or f.expr.length = 0
            return
        let end (*f.expr)[0]
        let t CppEmitter.ctype(end.result_type)
        let w CppEmitter.int_width(end.result_type.name)
        let s CppEmitter.int_type(w, true)
        let k this.temp()
        out.append "`ind`for (`t` `k` = 0, `k`_end = `this.operand(end)`; (`s`)`k` < (`s`)`k`_end; `k`++)\n"
        out.append "`ind`{\n"
        out.append "`ind`    `t` `CppEmitter.local_name(f.identifier)` = `k`;\n"
        this.body(out, f.body, depth + 1, false)
        out.append "`ind`}\n"
    }

    ; `for x in c`: get_iterator (with the frame, Emitter.emit_for_iterator#),
    ; then next until it answers null; x is the element's value for a
    ; scalar, else its address.
    procedure iterator_loop(mutable this, mutable out: ref[StringBuilder], f: PlannedFor, depth: size_t)
    {
        let ind CppEmitter.indent_of(depth)
        if f.expr = null or f.expr.length = 0
            return
        let coll (*f.expr)[0]
        let get_iter this.declared_name(f.get_iterator_method)
        let next this.declared_name(f.next_method)
        if get_iter.get_length() = 0 or next.get_length() = 0
        {
            out.append "#error \"for: iterator `f.get_iterator_method` or `f.next_method` not declared\"\n"
            this.errors := this.errors + 1
            return
        }
        let it this.temp()
        ; the element type is what next() answers, pointer[T]
        var elem f.element_type
        if CppEmitter.is_pointer_type(elem)
            elem := CppEmitter.first_generic(elem)
        let et CppEmitter.ctype(elem)
        var source this.operand(coll)
        if CppEmitter.is_pointer_type(this.cpp_type(coll))
            source := "*(`source`)"
        else if CppEmitter.is_lvalue(coll) = false
            source := "scaly_lvalue(`source`)"
        var first String()
        if this.kinds_of(f.get_iterator_method).starts_with("F")
            first := "`this.frame_of_caller()`, "
        out.append "`ind`for (auto `it` = `get_iter`(`first``source`);;)\n`ind`{\n"
        out.append "`ind`    `et`* `it`_at = (`et`*)`next`(`it`);\n"
        out.append "`ind`    if (`it`_at == nullptr)\n`ind`        break;\n"
        let x CppEmitter.local_name(f.identifier)
        this.locals.add(String(f.identifier))
        if f.element_is_scalar
            out.append "`ind`    `et` `x` = *`it`_at;\n"
        else
        {
            out.append "`ind`    `et`* `x` = `it`_at;\n"
            if CppEmitter.is_record(elem)
                this.held.add(String(f.identifier))
        }
        this.body(out, f.body, depth + 1, false)
        out.append "`ind`}\n"
    }

    procedure temp(mutable this) returns String
    {
        this.temp_count := this.temp_count + 1
        "scaly_t`this.temp_count`"
    }

    ; ------------------------------------------------------------------
    ; Expressions
    ; ------------------------------------------------------------------

    procedure operands(mutable this, ops: ref[Vector[PlannedOperand]]?) returns String
    {
        if ops = null or ops.length = 0
            return String()
        this.operand((*ops)[0])
    }

    ; The value of `ops` as type `t`: a cast where the C++ types differ and
    ; both are scalars or both pointers.
    procedure converted(mutable this, ops: ref[Vector[PlannedOperand]]?, t: PlannedType) returns String
    {
        if ops = null or ops.length = 0
            return String()
        let op (*ops)[0]
        let text this.operand(op)
        let ct this.cpp_type(op)
        let have CppEmitter.ctype(ct)
        let want CppEmitter.ctype(t)
        if have.equals(want)
            return text
        ; a record held at its address, where its address is wanted
        if CppEmitter.is_pointer_type(t) and CppEmitter.is_record(ct)
            return "(`want`)&(`text`)"
        ; a reference read where its value is wanted
        if CppEmitter.is_record(t) and CppEmitter.is_pointer_type(ct)
            return "*(`text`)"
        if CppEmitter.is_record(t) or CppEmitter.is_record(ct)
            return text
        "(`want`)(`text`)"
    }

    procedure operand(mutable this, op: PlannedOperand) returns String
    {
        var text: String this.expression(op.expr, op.result_type)
        if op.member_access <> null
        {
            var through_pointer CppEmitter.is_pointer_type(CppEmitter.expression_type(op.expr))
            for m in op.member_access
            {
                if m.is_union_value
                {
                    ; the payload of a union, read by the arm's type
                    var u text
                    if through_pointer
                        u := "*(`text`)"
                    text := "scaly_payload<`CppEmitter.ctype(m.result_type)`>(`u`)"
                }
                else if through_pointer
                    text := "`text`->`CppEmitter.local_name(m.name)`"
                else
                    text := "(`text`).`CppEmitter.local_name(m.name)`"
                through_pointer := CppEmitter.is_pointer_type(m.result_type)
            }
        }
        text
    }

    ; The type the C++ text of an operand has: the plan types a reference
    ; read as its pointee where the C++ still holds the pointer.
    procedure cpp_type(this, op: PlannedOperand) returns PlannedType
    {
        if op.member_access <> null and op.member_access.length > 0
        {
            var last op.result_type
            for m in op.member_access
                last := m.result_type
            return last
        }
        choose op.expr
            when v: Variable
            {
                if v.name = "_rp" or v.name = "rp"
                    return op.result_type
                if CppEmitter.contains(&this.held, v.name) and CppEmitter.is_pointer_type(v.variable_type) = false
                    return op.result_type
                return v.variable_type
            }
            when c: Call
            {
                if c.is_intrinsic = false
                    return c.result_type
            }
            else
                0
        op.result_type
    }

    ; the type an expression has before any member hop
    function expression_type(e: PlannedExpression) returns PlannedType
    {
        choose e
            when v: Variable
                return v.variable_type
            when c: Call
                return c.result_type
            when g: GlobalRef
                return g.global_type
            when t: Tuple
                return t.tuple_type
            when a: As
                return a.target_type
            else
                return Planner.make_void_type()
        Planner.make_void_type()
    }

    procedure expression(mutable this, e: PlannedExpression, result_type: PlannedType) returns String
    {
        choose e
            when c: Constant
                return CppEmitter.constant(c, result_type)
            when v: Variable
            {
                if v.name = "_rp" or v.name = "rp"
                    return this.frame_of_caller()
                if CppEmitter.contains(&this.held, v.name) and CppEmitter.is_pointer_type(v.variable_type) = false
                    return "(*`CppEmitter.local_name(v.name)`)"
                return CppEmitter.local_name(v.name)
            }
            when g: GlobalRef
            {
                let gn this.declared_name(g.mangled_name)
                if gn.get_length() > 0
                    return gn
                return CppEmitter.identifier_of(g.mangled_name)
            }
            when bx: Box
                return this.box(bx)
            when c: Call
                return this.call(c)
            when t: Tuple
                return this.tuple(t)
            when a: As
                return this.cast(a)
            when s: SizeOf
                return "((uint64_t)`s.size`)"
            when al: AlignOf
                return "((uint64_t)`al.alignment`)"
            when i: If
                return this.if_value(i, result_type)
            when b: Block
                return this.statement_value(e, result_type)
            when ch: Choose
                return this.statement_value(e, result_type)
            when vc: VariantConstruction
            {
                let u CppEmitter.ctype(vc.union_type)
                if vc.value = null
                    return "scaly_unit_variant<`u`>(`vc.variant_tag`)"
                return "scaly_variant<`u`>(`vc.variant_tag`, `this.operand(*vc.value)`)"
            }
            when test: Is
            {
                if test.value = null
                    return String("false")
                let v (*test.value)
                let text this.operand(v)
                if test.is_null_check
                    return "(`text` == nullptr)"
                if CppEmitter.is_pointer_type(v.result_type)
                    return "(`text`->tag == `test.variant_tag`)"
                return "((`text`).tag == `test.variant_tag`)"
            }
            when m: Match
                return this.statement_value(e, result_type)
            when tr: Try
                return this.untranslated("try")
            when l: Lambda
                return this.untranslated("lambda")
            when fr: FunctionRef
            {
                let fname this.declared_name(fr.mangled_name)
                if fname.get_length() = 0
                    return this.untranslated("function reference to an undeclared routine")
                return "((void*)&`fname`)"
            }
            when clo: Closure
                return this.untranslated("closure")
            when mx: Matrix
                return this.untranslated("matrix")
            when r: Repeat
            {
                ; `let x repeat { ... break v ... }`
                let v this.temp()
                let saved String(this.break_sink)
                this.break_sink := String(v)
                var out StringBuilder()
                out.append "({\n        `CppEmitter.ctype(r.value_type)` `v`{};\n"
                this.repeat_statement(&out, r, 2)
                this.break_sink := saved
                out.append "        `v`;\n    })"
                return out.to_string()
            }
            when f: For
                return this.untranslated("for as a value")
            when w: While
                return this.untranslated("while as a value")
            else
                return this.untranslated("expression")
        String()
    }

    procedure untranslated(mutable this, what: String) returns String
    {
        this.errors := this.errors + 1
        "SCALY_UNTRANSLATED /* `what` */"
    }

    function constant(c: PlannedConstant, t: PlannedType) returns String
    {
        choose c.value
            when b: Boolean
            {
                if b.value
                    return "true"
                return "false"
            }
            when i: Integer
                return CppEmitter.typed_integer(i.value, t)
            when h: Hex
                return CppEmitter.typed_integer(h.value, t)
            when f: FloatingPoint
                return "((`CppEmitter.ctype(t)`)`f.value as f64`)"
            when s: String
            {
                ; a String record: its bytes behind their varint length, as
                ; Emitter.emit_string_constant# lays them out
                if t.name = "String"
                {
                    if s.value.get_length() = 0
                        return "String{nullptr}"
                    return "String{(uint8_t*)\"`CppEmitter.varint_text(s.value.get_length())``CppEmitter.escaped(s.value)`\"}"
                }
                return "((`CppEmitter.ctype(t)`)\"`CppEmitter.escaped(s.value)`\")"
            }
            when ch: Character
                return "((uint8_t)\'`CppEmitter.escaped(ch.value)`\')"
            when fr: Fragment
                return "\"`CppEmitter.escaped(fr.value)`\""
            when n: Null
                return "nullptr"
        String()
    }

    ; An integer constant in the type the plan settled it on; written as an
    ; unsigned 64-bit number cast to it, so every value reads back exactly.
    function typed_integer(value: size_t, t: PlannedType) returns String
    {
        if CppEmitter.is_float(t.name)
            return "((`CppEmitter.ctype(t)`)`value`)"
        let ct CppEmitter.ctype(t)
        if CppEmitter.int_width(t.name) = 0 and CppEmitter.is_pointer_type(t) = false
        {
            if value < 0x80000000
                return "`value`"
            return "(int64_t)`value`ULL"
        }
        if ct = "int64_t" and value < 0x80000000
            return "`value`"
        if ct = "bool"
        {
            if value = 0
                return "false"
            return "true"
        }
        if ct = "uint64_t"
            return "`value`ULL"
        "(`ct`)`value`ULL"
    }

    ; A length as the varint the runtime's String reads, in octal escapes.
    function varint_text(length: size_t) returns String
    {
        var sb StringBuilder()
        var rest length
        repeat
        {
            var b: size_t rest & 0x7F
            rest := rest >> 7
            if rest > 0
                b := b | 0x80
            sb.append("\\" as char)
            sb.append((0x30 + ((b >> 6) & 7)) as char)
            sb.append((0x30 + ((b >> 3) & 7)) as char)
            sb.append((0x30 + (b & 7)) as char)
            if rest = 0
                break
        }
        sb.to_string()
    }

    ; A string's bytes (the Modeler decoded its escapes) as the inside of a
    ; C++ literal: the printable ones as they are, a quote, a backslash and
    ; every other byte by its octal escape, so nothing depends on the
    ; source character set.
    function escaped(text: String) returns String
    {
        var sb StringBuilder()
        let n text.get_length()
        var i: size_t 0
        while i < n
        {
            let c text.get i
            if c = 0x22 or c = 0x27 or c = 0x5C or c = 0x3F or c < 0x20 or c > 0x7E
            {
                sb.append("\\" as char)
                sb.append((0x30 + ((c >> 6) & 7)) as char)
                sb.append((0x30 + ((c >> 3) & 7)) as char)
                sb.append((0x30 + (c & 7)) as char)
            }
            else
                sb.append(c as char)
            i := i + 1
        }
        sb.to_string()
    }

    procedure cast(mutable this, a: PlannedAs) returns String
    {
        if a.value = null
            return String()
        let inner (*a.value)
        if CppEmitter.is_pointer_type(a.target_type) and inner.member_access = null
        {
            choose inner.expr
                when c: Constant
                {
                    choose c.value
                        when sc: String
                            return "((`CppEmitter.ctype(a.target_type)`)\"`CppEmitter.escaped(sc.value)`\")"
                        else
                            0
                }
                else
                    0
        }
        let it this.cpp_type(inner)
        if CppEmitter.is_char_pointer(a.target_type) and it.name = "String"
            return "((`CppEmitter.ctype(a.target_type)`)scaly_rt_cstr(&scaly_lvalue(`this.operand(inner)`)))"
        "((`CppEmitter.ctype(a.target_type)`)(`this.operand(inner)`))"
    }

    ; A positional construction (no init of its arity): an aggregate.
    procedure tuple(mutable this, t: PlannedTuple) returns String
    {
        if t.is_region_alloc and CppEmitter.is_record(t.tuple_type)
            return "(*`this.tuple_storage(t)`)"
        this.tuple_value(t)
    }

    procedure tuple_storage(mutable this, t: PlannedTuple) returns String
    {
        let ct CppEmitter.ctype(t.tuple_type)
        let p this.temp()
        "({ `ct`* `p` = (`ct`*)scaly_rt_allocate(`this.page_for(t.life)`, sizeof(`ct`), alignof(`ct`)); *`p` = `this.tuple_value(t)`; `p`; })"
    }

    procedure tuple_value(mutable this, t: PlannedTuple) returns String
    {
        var sb StringBuilder()
        var count: size_t 0
        if t.components <> null
            count := t.components.length
        ; a grouping is its one value
        if count = 1 and CppEmitter.is_record(t.tuple_type) = false
            return "(`this.operands((*t.components)[0].value)`)"
        if count = 1
        {
            let only (*t.components)[0]
            if only.value <> null and only.value.length > 0
            {
                let v (*only.value)[0]
                if CppEmitter.ctype(v.result_type).equals(CppEmitter.ctype(t.tuple_type))
                    return "(`this.operand(v)`)"
            }
        }
        sb.append(CppEmitter.ctype(t.tuple_type))
        sb.append("{" as char)
        if t.components <> null
        {
            var first true
            for c in t.components
            {
                if first = false
                    sb.append ", "
                first := false
                sb.append(this.operands(c.value))
            }
        }
        sb.append("}" as char)
        sb.to_string()
    }

    procedure if_value(mutable this, i: PlannedIf, t: PlannedType) returns String
    {
        ; two plain values: the conditional operator
        if i.alternative <> null and CppEmitter.is_plain_arm(i.consequent) and CppEmitter.is_plain_arm(i.alternative) and CppEmitter.is_unit(t) = false
        {
            let cond this.operands(i.condition)
            let a this.arm_value(i.consequent, t)
            let b this.arm_value(i.alternative, t)
            return "(`cond` ? `a` : `b`)"
        }
        this.statement_value(PlannedExpression.If(i), t)
    }

    function is_plain_arm(s: ref[PlannedStatement]?) returns bool
    {
        if s = null
            return false
        choose *s
            when a: Action
            {
                if a.target <> null or a.source = null or a.source.length <> 1
                    return false
                choose (*a.source)[0].expr
                    when b: Block
                        return false
                    when i: If
                        return false
                    when c: Choose
                        return false
                    when m: Match
                        return false
                    else
                        return true
            }
            else
                return false
        false
    }

    procedure arm_value(mutable this, s: ref[PlannedStatement]?, t: PlannedType) returns String
    {
        if s = null
            return String("0")
        choose *s
            when a: Action
                return this.converted(a.source, t)
            else
                0
        String("0")
    }

    ; Control flow in value position: a statement expression (GNU, gcc and
    ; clang) whose statements put their value into a temporary.
    procedure statement_value(mutable this, e: PlannedExpression, t: PlannedType) returns String
    {
        var out StringBuilder()
        let unit CppEmitter.is_unit(t)
        let saved String(this.sink)
        var name String()
        out.append "({\n"
        if unit = false
        {
            name := this.temp()
            out.append "        `CppEmitter.ctype(t)` `name`{};\n"
        }
        this.sink := String(name)
        choose e
            when i: If
                this.if_statement(&out, i, 2, unit = false)
            when b: Block
                this.block(&out, b, 2, unit = false)
            when c: Choose
                this.choose_statement(&out, c, 2, unit = false)
            when m: Match
                this.match_statement(&out, m, 2, unit = false)
            else
                0
        this.sink := saved
        if unit = false
            out.append "        `name`;\n"
        out.append "    })"
        out.to_string()
    }

    ; `choose`: a switch over the tag, each arm with its binding a copy of
    ; the payload; over an Option of a reference the null test.
    procedure choose_statement(mutable this, mutable out: ref[StringBuilder], c: PlannedChoose, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        if c.condition = null or c.condition.length = 0
            return
        let subject (*c.condition)[0]
        let st subject.result_type
        let v this.temp()
        if CppEmitter.is_npo_option(st)
        {
            out.append "`ind`if (`CppEmitter.ctype(st)` `v` = `this.operand(subject)`)\n`ind`{\n"
            if c.cases <> null
            {
                for w in c.cases
                {
                    if w.name.get_length() > 0
                        out.append "`ind`    `CppEmitter.ctype(w.variant_type)` `CppEmitter.local_name(w.name)` = `v`;\n"
                    if w.consequent <> null
                        this.arm_statements(out, *w.consequent, depth + 1, tail)
                }
            }
            out.append "`ind`}\n"
            if c.alternative <> null
            {
                out.append "`ind`else\n`ind`{\n"
                this.arm_statements(out, *c.alternative, depth + 1, tail)
                out.append "`ind`}\n"
            }
            return
        }
        var access "."
        var value this.operand(subject)
        if CppEmitter.is_pointer_type(st)
            access := "->"
        out.append "`ind`{\n`ind`    auto&& `v` = `value`;\n"
        out.append "`ind`    switch (`v``access`tag)\n`ind`    {\n"
        if c.cases <> null
        {
            for w in c.cases
            {
                out.append "`ind`    case `w.variant_index`:\n`ind`    {\n"
                if w.name.get_length() > 0 and CppEmitter.is_unit(w.variant_type) = false
                {
                    var source v
                    if CppEmitter.is_pointer_type(st)
                        source := "*`v`"
                    out.append "`ind`        `CppEmitter.ctype(w.variant_type)` `CppEmitter.local_name(w.name)` = scaly_payload<`CppEmitter.ctype(w.variant_type)`>(`source`);\n"
                }
                if w.consequent <> null
                    this.arm_statements(out, *w.consequent, depth + 2, tail)
                out.append "`ind`        break;\n`ind`    }\n"
            }
        }
        out.append "`ind`    default:\n`ind`    {\n"
        if c.alternative <> null
            this.arm_statements(out, *c.alternative, depth + 2, tail)
        out.append "`ind`        break;\n`ind`    }\n"
        out.append "`ind`    }\n`ind`}\n"
    }

    ; `match`: the scrutinee once, then each branch's cases in turn
    ; (Emitter.emit_match#, a short-circuit chain).
    procedure match_statement(mutable this, mutable out: ref[StringBuilder], m: PlannedMatch, depth: size_t, tail: bool)
    {
        let ind CppEmitter.indent_of(depth)
        if m.condition = null or m.condition.length = 0
            return
        let subject (*m.condition)[0]
        let v this.temp()
        out.append "`ind`{\n`ind`    auto&& `v` = `this.operand(subject)`;\n"
        var first true
        if m.branches <> null
        {
            for b in m.branches
            {
                var test StringBuilder()
                if b.cases <> null
                {
                    for c in b.cases
                    {
                        if test.get_length() > 0
                            test.append " || "
                        test.append "`v` == `this.operands(c.condition)`"
                    }
                }
                if test.get_length() = 0
                    test.append "false"
                if first
                    out.append "`ind`    if (`test.to_string()`)\n"
                else
                    out.append "`ind`    else if (`test.to_string()`)\n"
                first := false
                out.append "`ind`    {\n"
                if b.consequent <> null
                    this.arm_statements(out, *b.consequent, depth + 2, tail)
                out.append "`ind`    }\n"
            }
        }
        if m.alternative <> null
        {
            if first
                out.append "`ind`    {\n"
            else
                out.append "`ind`    else\n`ind`    {\n"
            this.arm_statements(out, *m.alternative, depth + 2, tail)
            out.append "`ind`    }\n"
        }
        out.append "`ind`}\n"
    }

    procedure arm_statements(mutable this, mutable out: ref[StringBuilder], s: PlannedStatement, depth: size_t, tail: bool)
    {
        choose s
            when a: Action
                this.body(out, a, depth, tail)
            else
                this.statement(out, s, depth, tail)
    }

    ; ------------------------------------------------------------------
    ; Calls and operators
    ; ------------------------------------------------------------------

    procedure call(mutable this, c: PlannedCall) returns String
    {
        if c.is_intrinsic and c.is_operator
            return this.operator_call(c)
        if c.is_indirect
            return this.indirect_call(c)
        if c.is_intrinsic
            return this.intrinsic_function(c)
        if c.mangled_name.contains("C1E")
            return this.construction(c)
        let lowered this.lowered_call(c)
        if lowered.get_length() > 0
            return lowered
        var callee String()
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(c.mangled_name)
                callee := String(this.fn_names[i])
            i := i + 1
        }
        if callee.get_length() = 0
            callee := this.declare_from_call(c, false)
        var kinds this.kinds_of(c.mangled_name)
        if kinds.starts_with("F")
            kinds := kinds.substring(1, kinds.get_length() - 1)
        let args this.arguments_to(c.args, kinds, c.mangled_name, 0)
        if c.requires_page_param
        {
            let frame this.frame_for(c.life)
            if args.get_length() = 0
                return "`callee`(`frame`)"
            return "`callee`(`frame`, `args`)"
        }
        "`callee`(`args`)"
    }

    ; ------------------------------------------------------------------
    ; Pages and frames (Emitter.region_alloc_life#, resolve_reference_*)
    ; ------------------------------------------------------------------

    ; The frame this routine hands on as its callee's caller page: the one
    ; it received, else its own.
    procedure frame_of_caller(this) returns String
    {
        if this.has_page
            return String("scaly_rp")
        String("&scaly_local.f")
    }

    ; The frame a call or a construction of that lifetime hands on: its own
    ; for Local, a named page wrapped in a frame of its own for `^name`, else
    ; the caller page.
    procedure frame_for(this, life: Lifetime) returns String
    {
        choose life
            when l: Local
                return String("&scaly_local.f")
            when r: Reference
            {
                if r.location = "_rp" or r.location = "rp"
                    return this.frame_of_caller()
                return "&scaly_lvalue(scaly_frame{`this.page_of(r.location)`, nullptr})"
            }
            else
                0
        this.frame_of_caller()
    }

    ; The page a construction of that lifetime is allocated on.
    procedure page_for(this, life: Lifetime) returns String
    {
        choose life
            when l: Local
                return String("scaly_rt_force_frame(&scaly_local.f)")
            when r: Reference
                return this.page_of(r.location)
            else
                0
        "scaly_rt_force_frame(`this.frame_of_caller()`)"
    }

    ; The page `^name` means: the caller page, the receiver's own, a page
    ; variable, else a page field of the receiver.
    procedure page_of(this, name: String) returns String
    {
        if name = "_rp" or name = "rp"
            return "scaly_rt_force_frame(`this.frame_of_caller()`)"
        if name = "this"
            return String("scaly_rt_page_get((void*)this_)")
        if CppEmitter.contains(&this.locals, name)
            return "(void*)(`CppEmitter.local_name(name)`)"
        "(void*)(this_->`CppEmitter.local_name(name)`)"
    }

    function is_region_life(life: Lifetime) returns bool
    {
        choose life
            when l: Local
                return true
            when c: Call
                return true
            when r: Reference
                return true
            else
                return false
        false
    }

    ; An operand that IS a record's address on a page: a construction there.
    ; Answers the pointer's text, or "" for any other operand.
    procedure storage(mutable this, op: PlannedOperand) returns String
    {
        if op.member_access <> null and op.member_access.length > 0
            return String()
        if CppEmitter.is_record(op.result_type) = false
            return String()
        choose op.expr
            when c: Call
            {
                if c.is_intrinsic = false and c.mangled_name.contains("C1E") and CppEmitter.is_region_life(c.life)
                    return this.construction_storage(c)
            }
            when t: Tuple
            {
                if t.is_region_alloc
                    return this.tuple_storage(t)
            }
            else
                0
        String()
    }

    ; `&^page v`: a copy of v on that page, its address.
    procedure box(mutable this, b: PlannedBox) returns String
    {
        if b.value = null
            return String("nullptr")
        let v (*b.value)
        let t CppEmitter.ctype(v.result_type)
        let p this.temp()
        "({ `t`* `p` = (`t`*)scaly_rt_allocate(`this.page_of(b.target_page)`, sizeof(`t`), alignof(`t`)); *`p` = `this.operand(v)`; `p`; })"
    }

    ; A routine of another file the plan names only where it is called (a
    ; package's routine a generic body of it reaches): declared from the
    ; call, as the LLVM emitter declares it -- the planner gave each argument
    ; its parameter's type. An init takes its record first.
    procedure declare_from_call(mutable this, c: PlannedCall, is_init: bool) returns String
    {
        if c.mangled_name.get_length() = 0
            return String(c.name)
        let name this.function_name(c.mangled_name, false)
        var params StringBuilder()
        var kinds StringBuilder()
        var types StringBuilder()
        var first true
        if c.requires_page_param
        {
            params.append "scaly_frame*"
            kinds.append("F" as char)
            first := false
        }
        if is_init
        {
            var rt c.result_type
            if CppEmitter.is_pointer_type(rt)
                rt := CppEmitter.first_generic(rt)
            if first = false
                params.append ", "
            params.append "`CppEmitter.ctype(rt)`&"
            kinds.append("R" as char)
            types.append(CppEmitter.ctype(rt))
            first := false
        }
        if c.args <> null
        {
            for a in c.args
            {
                let t this.cpp_type(a)
                if first = false
                    params.append ", "
                if types.get_length() > 0
                    types.append("\t" as char)
                first := false
                params.append(CppEmitter.ctype(t))
                types.append(CppEmitter.ctype(t))
                if CppEmitter.is_record(t)
                {
                    params.append("&" as char)
                    kinds.append("R" as char)
                }
                else if CppEmitter.is_pointer_type(t)
                    kinds.append("P" as char)
                else
                    kinds.append("V" as char)
            }
        }
        this.set_kinds(c.mangled_name, kinds.to_string())
        this.set_ptypes(c.mangled_name, types.to_string())
        var rt String("void")
        if is_init = false
            rt := CppEmitter.ctype(c.result_type)
        ; a C function by its C name (an asm label is the symbol as written,
        ; and a C symbol has a leading `_` on Darwin)
        if c.mangled_name.starts_with("_Z") = false
        {
            this.late.add("extern \"C\" `rt` `c.mangled_name`(`params.to_string()`);\n")
            return String(c.mangled_name)
        }
        this.late.add("`rt` `name`(`params.to_string()`) asm(\"`c.mangled_name`\");\n")
        name
    }

    ; A call through an address (Emitter.emit_call#, is_indirect): the
    ; address itself for the JIT's entries, a closure record's thunk else.
    procedure indirect_call(mutable this, c: PlannedCall) returns String
    {
        if c.args = null or c.args.length = 0
            return this.untranslated("indirect call without a callee")
        let all (*c.args)
        let callee this.operand(all[0])
        var types StringBuilder()
        var values StringBuilder()
        var k: size_t 1
        while k < all.length
        {
            let a all[k]
            if k > 1
            {
                types.append ", "
                values.append ", "
            }
            types.append(CppEmitter.ctype(this.cpp_type(a)))
            values.append(this.operand(a))
            k := k + 1
        }
        if c.name = "__jit_indirect"
            return "((int64_t(*)(`types.to_string()`))(`callee`))(`values.to_string()`)"
        ; a closure: the record's first word is its thunk, which takes the
        ; record before the arguments (a record argument by reference)
        var ptypes StringBuilder()
        ptypes.append "void*"
        var j: size_t 1
        while j < all.length
        {
            let pt this.cpp_type(all[j])
            ptypes.append ", `CppEmitter.ctype(pt)`"
            if CppEmitter.is_record(pt)
                ptypes.append("&" as char)
            j := j + 1
        }
        var rest String()
        if values.get_length() > 0
            rest := ", `values.to_string()`"
        let rt CppEmitter.ctype(c.result_type)
        "((`rt`(*)(`ptypes.to_string()`))(*(void**)(`callee`)))((void*)(`callee`)`rest`)"
    }

    ; The calls the LLVM emitter lowers to instructions instead of calling
    ; (Emitter.emit_atomic_call#, emit_bits_call#, emit_ptr_call#): no such
    ; symbol exists to link against.
    procedure lowered_call(mutable this, c: PlannedCall) returns String
    {
        let m c.mangled_name
        if m.starts_with("scaly_atomic_") = false and m.starts_with("scaly_bits_") = false and m <> "scaly_call_ptr"
            return String()
        if c.args = null or c.args.length = 0
            return String()
        let all (*c.args)
        let a0 this.operand(all[0])
        var a1 String()
        if all.length > 1
            a1 := this.operand(all[1])
        var a2 String()
        if all.length > 2
            a2 := this.operand(all[2])
        let rt CppEmitter.ctype(c.result_type)
        match m
            case "scaly_atomic_load_u64"
                return "((`rt`)__atomic_load_n((uint64_t*)(`a0`), __ATOMIC_SEQ_CST))"
            case "scaly_atomic_store_u64"
                return "__atomic_store_n((uint64_t*)(`a0`), (uint64_t)(`a1`), __ATOMIC_SEQ_CST)"
            case "scaly_atomic_or_u64"
                return "((`rt`)__atomic_fetch_or((uint64_t*)(`a0`), (uint64_t)(`a1`), __ATOMIC_SEQ_CST))"
            case "scaly_atomic_and_u64"
                return "((`rt`)__atomic_fetch_and((uint64_t*)(`a0`), (uint64_t)(`a1`), __ATOMIC_SEQ_CST))"
            case "scaly_atomic_add_u64"
                return "((`rt`)__atomic_fetch_add((uint64_t*)(`a0`), (uint64_t)(`a1`), __ATOMIC_SEQ_CST))"
            case "scaly_atomic_cas_u64"
            {
                ; the old value, whether it was exchanged or not
                let e this.temp()
                return "({ uint64_t `e` = (uint64_t)(`a1`); __atomic_compare_exchange_n((uint64_t*)(`a0`), &`e`, (uint64_t)(`a2`), false, __ATOMIC_SEQ_CST, __ATOMIC_SEQ_CST); (`rt`)`e`; })"
            }
            case "scaly_bits_count_ones"
                return "((`rt`)__builtin_popcountll((uint64_t)(`a0`)))"
            case "scaly_bits_trailing_zeros"
            {
                let v this.temp()
                return "({ uint64_t `v` = (uint64_t)(`a0`); (`rt`)(`v` == 0 ? 64 : __builtin_ctzll(`v`)); })"
            }
            case "scaly_bits_leading_zeros"
            {
                let v this.temp()
                return "({ uint64_t `v` = (uint64_t)(`a0`); (`rt`)(`v` == 0 ? 64 : __builtin_clzll(`v`)); })"
            }
            case "scaly_call_ptr"
                return "((void*(*)(void*))(`a0`))((void*)(`a1`))"
        String()
    }

    ; Emitter.emit_intrinsic_function#: unwrap reads the payload without
    ; looking at the tag (an Option of a reference is the reference itself);
    ; unwrap_or answers its default -- as the LLVM emitter does, whatever
    ; the Option holds.
    procedure intrinsic_function(mutable this, c: PlannedCall) returns String
    {
        if c.args = null or c.args.length = 0
            return this.untranslated("intrinsic `c.name` without arguments")
        let all (*c.args)
        if c.name = "unwrap" and all.length = 1
        {
            let o all[0]
            let ot this.cpp_type(o)
            let text this.operand(o)
            if CppEmitter.is_pointer_type(ot) and CppEmitter.is_pointer_type(c.result_type)
                return "((`CppEmitter.ctype(c.result_type)`)(`text`))"
            if CppEmitter.is_pointer_type(ot)
                return "scaly_payload<`CppEmitter.ctype(c.result_type)`>(*(`text`))"
            return "scaly_payload<`CppEmitter.ctype(c.result_type)`>(`text`)"
        }
        if c.name = "unwrap_or" and all.length = 2
            return this.operand(all[1])
        this.untranslated("intrinsic `c.name`")
    }

    procedure kinds_of(this, mangled: String) returns String
    {
        var i: size_t 0
        while i < this.fn_mangled.length
        {
            if this.fn_mangled[i].equals(mangled) and i < this.fn_kinds.length
                return String(this.fn_kinds[i])
            i := i + 1
        }
        String()
    }

    ; `T(args)` through an init: on a page its address (storage#, the
    ; operand reads `*` of it), else a temporary the init fills.
    procedure construction(mutable this, c: PlannedCall) returns String
    {
        if CppEmitter.is_region_life(c.life)
            return "(*`this.construction_storage(c)`)"
        let t CppEmitter.ctype(c.result_type)
        let v this.temp()
        "({ `t` `v`{}; `this.init_call(c, v)`; `v`; })"
    }

    procedure construction_storage(mutable this, c: PlannedCall) returns String
    {
        var rt c.result_type
        if CppEmitter.is_pointer_type(rt)
            rt := CppEmitter.first_generic(rt)
        let t CppEmitter.ctype(rt)
        let p this.temp()
        let deref "(*`p`)"
        "({ `t`* `p` = (`t`*)scaly_rt_allocate(`this.page_for(c.life)`, sizeof(`t`), alignof(`t`)); *`p` = `t`{}; `this.init_call(c, deref)`; `p`; })"
    }

    ; The init on `target`: with the frame where it takes a caller page. A
    ; generic record built from nothing is zeroed, its init not called
    ; (Emitter.emit_constructor_call_into#).
    procedure init_call(mutable this, c: PlannedCall, target: String) returns String
    {
        var callee this.declared_name(c.mangled_name)
        var count: size_t 0
        if c.args <> null
            count := c.args.length
        if count = 0 and c.requires_page_param = false and c.result_type.generics <> null and c.result_type.generics.length > 0
            return String("(void)0")
        if callee.get_length() = 0
            callee := this.declare_from_call(c, true)
        var kinds this.kinds_of(c.mangled_name)
        if kinds.starts_with("F")
            kinds := kinds.substring(1, kinds.get_length() - 1)
        var rest String()
        if kinds.get_length() > 0
            rest := kinds.substring(1, kinds.get_length() - 1)
        let args this.arguments_to(c.args, rest, c.mangled_name, 1)
        var sb StringBuilder()
        sb.append "`callee`("
        if c.requires_page_param
            sb.append "`this.frame_for(c.life)`, "
        sb.append(target)
        if args.get_length() > 0
            sb.append ", `args`"
        sb.append(")" as char)
        sb.to_string()
    }

    ; The arguments of a call, each as its parameter takes it (`kinds`, from
    ; parameter_kinds#; empty where the callee is not declared here).
    procedure arguments(mutable this, args: ref[Vector[PlannedOperand]]?, kinds: String) returns String
    {
        this.arguments_to(args, kinds, String(), 0)
    }

    ; ... with the callee's symbol: a pointer argument of another C++ type
    ; than its parameter is cast to it (a C function declared twice in two
    ; modules' words, `pointer[u8]` against `pointer[const_char]`). `first`
    ; is the parameter the first argument fills.
    procedure arguments_to(mutable this, args: ref[Vector[PlannedOperand]]?, kinds: String, callee: String, first_param: size_t) returns String
    {
        var sb StringBuilder()
        if args = null
            return sb.to_string()
        var first true
        var k: size_t 0
        for a in args
        {
            if first = false
                sb.append ", "
            first := false
            let text this.operand(a)
            let at this.cpp_type(a)
            var kind: u8 0x56      ; V
            if k < kinds.get_length()
                kind := kinds.get(k)
            if kind = 0x52 and CppEmitter.is_pointer_type(at)       ; R from a pointer
                sb.append "*(`text`)"
            else if kind = 0x50 and CppEmitter.is_record(at)        ; P from a record
                sb.append "&(`text`)"
            else if CppEmitter.is_record(a.result_type) and CppEmitter.is_lvalue(a) = false
                sb.append "scaly_lvalue(`text`)"
            else if kind = 0x50 and callee.get_length() > 0
            {
                let pt this.ptype_of(callee, first_param + k)
                if pt.get_length() > 0 and pt.equals(CppEmitter.ctype(at)) = false
                    sb.append "(`pt`)(`text`)"
                else
                    sb.append text
            }
            else
                sb.append text
            k := k + 1
        }
        sb.to_string()
    }

    function is_lvalue(a: PlannedOperand) returns bool
    {
        choose a.expr
            when v: Variable
                return true
            when g: GlobalRef
                return true
            else
                return false
        false
    }

    procedure operator_call(mutable this, c: PlannedCall) returns String
    {
        if c.args = null
            return String()
        let args (*c.args)
        if args.length = 1
            return this.prefix_operation(c.name, args[0], c.result_type)
        if args.length = 2
            return this.binary_operation(c.name, args[0], args[1], c.result_type)
        this.errors := this.errors + 1
        "SCALY_UNTRANSLATED /* operator `c.name` */"
    }

    procedure prefix_operation(mutable this, name: String, a: PlannedOperand, t: PlannedType) returns String
    {
        let v this.operand(a)
        ; `*x` on a record held at its address (binding#) is the record
        if name = "*" and CppEmitter.is_record(this.cpp_type(a))
            return v
        match name
            case "-"
                return "((`CppEmitter.ctype(t)`)(-(`v`)))"
            case "not" case "!"
                return "(!(`v`))"
            case "~"
                return "((`CppEmitter.ctype(t)`)(~(`v`)))"
            case "*"
                return "(*(`v`))"
            case "&"
                return "(&(`v`))"
        this.errors := this.errors + 1
        "SCALY_UNTRANSLATED /* prefix `name` */"
    }

    ; A binary operator on scalars, by the LLVM emitter's rules
    ; (Emitter.emit_intrinsic_binary_op#): both operands at the wider width,
    ; each widened by its own signedness, the left one's signedness for
    ; a division, a remainder, a right shift and a comparison; a shift is as
    ; wide as its left operand. Pointer + integer steps by the pointee.
    procedure binary_operation(mutable this, name: String, a: PlannedOperand, b: PlannedOperand, t: PlannedType) returns String
    {
        let l this.operand(a)
        let r this.operand(b)
        let lt a.result_type
        let rt b.result_type
        if CppEmitter.is_pointer_type(lt) and CppEmitter.int_width(rt.name) > 1 and (name = "+" or name = "-")
        {
            let inner CppEmitter.first_generic(lt)
            if CppEmitter.is_unit(inner)
                return "((void*)((uint8_t*)(`l`) `name` (int64_t)(`r`)))"
            return "((`l`) `name` (int64_t)(`r`))"
        }
        if CppEmitter.is_pointer_type(lt) or CppEmitter.is_pointer_type(rt)
            return "((`l`) `CppEmitter.cpp_operator(name)` (`r`))"
        if CppEmitter.is_float(lt.name) or CppEmitter.is_float(rt.name)
        {
            ; a float beside a double goes to the double
            var ft String("float")
            if lt.name = "double" or lt.name = "f64" or rt.name = "double" or rt.name = "f64"
                ft := String("double")
            if name = "%" or name = "mod"
                return "SCALY_UNTRANSLATED /* float remainder */"
            if CppEmitter.is_comparison(name)
                return "((`ft`)(`l`) `CppEmitter.cpp_operator(name)` (`ft`)(`r`))"
            return "((`ft`)((`ft`)(`l`) `CppEmitter.cpp_operator(name)` (`ft`)(`r`)))"
        }
        let lw CppEmitter.int_width(lt.name)
        let rw CppEmitter.int_width(rt.name)
        let ls CppEmitter.is_signed(lt.name)
        let rs CppEmitter.is_signed(rt.name)
        if lw = 0 or rw = 0
        {
            this.errors := this.errors + 1
            return "SCALY_UNTRANSLATED /* `name` on `lt.name` and `rt.name` */"
        }
        if name = "<<" or name = ">>"
        {
            ; the count takes the left's width; >> by the left's signedness
            let lty CppEmitter.int_type(lw, ls)
            return "((`lty`)((`lty`)(`l`) `name` (`CppEmitter.int_type(lw, false)`)(`r`)))"
        }
        var w lw
        if rw > w
            w := rw
        let op_name CppEmitter.cpp_operator(name)
        if w = 1
            return "((`l`) `op_name` (`r`))"
        let op_type CppEmitter.int_type(w, ls)
        let same CppEmitter.int_type(lw, ls).equals(CppEmitter.int_type(rw, rs))
        ; one type on both sides: C++ computes it so, a narrow type (which C++
        ; promotes) truncated back
        if same
        {
            if CppEmitter.is_comparison(name)
                return "(`l` `op_name` `r`)"
            if w >= 32
                return "(`l` `op_name` `r`)"
            return "((`op_type`)(`l` `op_name` `r`))"
        }
        ; else each operand at the common width by its own signedness, then
        ; as the left's
        var lx l
        if lw < w
            lx := "(`CppEmitter.int_type(w, ls)`)`l`"
        var rx r
        if rw < w
            rx := "(`CppEmitter.int_type(w, rs)`)`r`"
        if rs <> ls
            rx := "(`op_type`)`rx`"
        if CppEmitter.is_comparison(name)
            return "(`lx` `op_name` `rx`)"
        if w >= 32
            return "(`lx` `op_name` `rx`)"
        "((`op_type`)(`lx` `op_name` `rx`))"
    }

    function is_comparison(name: String) returns bool
    {
        match name
            case "=" case "<>" case "<" case ">" case "<=" case ">="
                return true
        false
    }

    function cpp_operator(name: String) returns String
    {
        match name
            case "="
                return "=="
            case "<>"
                return "!="
            case "div"
                return "/"
            case "mod"
                return "%"
            case "and" case "&&"
                return "&&"
            case "or" case "||"
                return "||"
            case "xor"
                return "^"
        String(name)
    }
}
