; cli.scaly - Command-line interface for the Scaly compiler
;
; This module handles argument parsing and drives the compilation pipeline.

; Standard library imports
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Vector
use scaly.os.File
use scaly.os.Console
use scaly.memory.runtime.system
use scaly.memory.runtime.unlink
use scaly.memory.root_pages.getenv

; s175: local extern declarations so stage-1 emits `declare` for these.
; The `use` lines above only resolve names; stage-1 doesn't walk the
; scaly package's runtime module into LLVM declarations, so emit_call's
; LLVMGetNamedFunction lookup failed and the system()/unlink() calls —
; the entire link step — silently dropped from stage-2's cli.run. Same
; in-file pattern as Planner.scaly's local `exit` extern (line 143).
function getpid() returns i32 extern
function system(command: pointer[const_char]) returns i32 extern
function unlink(path: pointer[const_char]) returns i32 extern

; Compiler module imports
use scalyc.compiler.Modeler
use scalyc.compiler.Model.Program
use scalyc.compiler.Planner
use scalyc.compiler.TaskPlanner
use scalyc.compiler.PointerCensus
use scalyc.compiler.WriteCensus
use scalyc.compiler.Plan.Plan
use scalyc.compiler.Emitter
use scalyc.compiler.Emitter.EmitterConfig
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.Planner.*

; ============================================================================
; Module declarations
; ============================================================================

; Parser module (which includes lexer)
module parser

; ============================================================================
; Command-line options
; ============================================================================

define Options
(
    input_file: String
    output_file: String
    verbose: bool
    emit_ir: bool           ; -S: emit LLVM IR
    compile_only: bool      ; -c: compile only, no link
    lex_only: bool          ; --lex: just tokenize
    parse_only: bool        ; --parse: just parse
    model_only: bool        ; --model: just build model
    plan_only: bool         ; --plan: just run planner
    show_help: bool
    no_prelude: bool        ; --no-prelude: skip auto-loading prelude
    no_tests: bool          ; --no-tests: omit test/test_* functions (seed build)
    use_vis: bool           ; --use-vis: advisory use-visibility measurement
    no_use_vis: bool        ; --no-use-vis: disable strict use visibility
    task_plan: bool         ; --task-plan: stage-3 parallelizability report
    pointer_report: bool    ; --pointer-report: raw-pointer census off the Plan
    write_report: bool      ; --write-report: writes through parameters, off the Plan
    host_report: bool       ; --host-report: named-page constructions that never leave their routine
    purity_check: bool      ; --purity-check: a function may not write what its parameters reach
    interface_facts: bool   ; --interface-facts: body-derived facts for tools/interface/geninterface.py
    debug: bool             ; -g: emit DWARF debug info
    run_mode: bool          ; --run <fn>: JIT-compile and execute <fn> in-process
    run_function: String    ; the function name to JIT-run
    jit_program: bool       ; --jit: JIT-compile and run the whole program (top-level main)
    error_message: String
    library_paths: Array[String]    ; -L<path> entries (no leading -L)
    libraries: Array[String]        ; -l<name> entries (no leading -l)
    extra_objects: Array[String]    ; positional .a / .o paths
    target_triple: String           ; --target <triple>: cross-emit object (empty = host)
    opt_level: int                  ; -O0..-O3: LLVM pipeline for object emission (default 0)
)
{
    init()
    {
        set input_file: String()
        set output_file: String()
        set verbose: false
        set emit_ir: false
        set compile_only: false
        set lex_only: false
        set parse_only: false
        set model_only: false
        set plan_only: false
        set show_help: false
        set no_prelude: false
        set no_tests: false
        set use_vis: false
        set no_use_vis: false
        set task_plan: false
        set pointer_report: false
        set write_report: false
        set host_report: false
        set purity_check: false
        set interface_facts: false
        set debug: false
        set run_mode: false
        set run_function: String()
        set jit_program: false
        set error_message: String()
        set library_paths: Array[String]()
        set libraries: Array[String]()
        set extra_objects: Array[String]()
        set target_triple: String()
        set opt_level: 0
    }

    function has_error(this) returns bool
        error_message.get_length() > 0

    function has_input(this) returns bool
        input_file.get_length() > 0
}

; ============================================================================
; Argument parsing
; ============================================================================

define cli
{
    ; Parse command-line arguments
    ; argc: argument count
    ; argv: argument vector (C-style array of char pointers)
    function parse_args(argc: int, argv: pointer[pointer[char]]) returns Options
    {
        var opts Options()

        var i 1  ; Skip program name (argv[0])
        while i < argc
        {
            let arg_ptr *(argv + i)
            var arg String(arg_ptr)

            if arg.starts_with("-")
            {
                ; Option flag
                if arg = "-h" | arg = "--help"
                {
                    set opts.show_help: true
                }
                else if arg = "-v" | arg = "--verbose"
                {
                    set opts.verbose: true
                }
                else if arg = "-S"
                {
                    set opts.emit_ir: true
                }
                else if arg = "-c"
                {
                    set opts.compile_only: true
                }
                else if arg = "-g"
                {
                    set opts.debug: true
                }
                else if arg = "--lex"
                {
                    set opts.lex_only: true
                }
                else if arg = "--parse"
                {
                    set opts.parse_only: true
                }
                else if arg = "--model"
                {
                    set opts.model_only: true
                }
                else if arg = "--plan"
                {
                    set opts.plan_only: true
                }
                else if arg = "--no-prelude"
                {
                    set opts.no_prelude: true
                }
                else if arg = "--no-tests"
                {
                    set opts.no_tests: true
                }
                else if arg = "--use-vis"
                {
                    set opts.use_vis: true
                }
                else if arg = "--no-use-vis"
                {
                    set opts.no_use_vis: true
                }
                else if arg = "--task-plan"
                {
                    set opts.task_plan: true
                }
                else if arg = "--pointer-report"
                {
                    set opts.pointer_report: true
                }
                else if arg = "--write-report"
                {
                    set opts.write_report: true
                }
                else if arg = "--host-report"
                {
                    set opts.host_report: true
                }
                else if arg = "--purity-check"
                {
                    set opts.purity_check: true
                }
                else if arg = "--interface-facts"
                {
                    set opts.interface_facts: true
                }
                else if arg = "-O0"
                {
                    set opts.opt_level: 0
                }
                else if arg = "-O1"
                {
                    set opts.opt_level: 1
                }
                else if arg = "-O2"
                {
                    set opts.opt_level: 2
                }
                else if arg = "-O3"
                {
                    set opts.opt_level: 3
                }
                else if arg = "--jit"
                {
                    set opts.jit_program: true
                }
                else if arg = "-o"
                {
                    ; Output file - next argument is the filename
                    set i: i + 1
                    if i < argc
                    {
                        let out_ptr *(argv + i)
                        set opts.output_file: String(out_ptr)
                    }
                    else
                    {
                        set opts.error_message: "-o requires a filename"
                    }
                }
                else if arg = "--run"
                {
                    ; JIT mode - next argument is the function name to execute
                    set i: i + 1
                    if i < argc
                    {
                        let fn_ptr *(argv + i)
                        set opts.run_function: String(fn_ptr)
                        set opts.run_mode: true
                    }
                    else
                    {
                        set opts.error_message: "--run requires a function name"
                    }
                }
                else if arg = "--target"
                {
                    ; Cross-emit target triple - next argument is the triple.
                    ; Object emission (-c) uses it instead of the host default;
                    ; both AArch64 and X86 backends are initialized, so any of
                    ; the LP64 "fabulous four" (arm64/x86_64, darwin/linux) works.
                    set i: i + 1
                    if i < argc
                    {
                        let triple_ptr *(argv + i)
                        set opts.target_triple: String(triple_ptr)
                    }
                    else
                    {
                        set opts.error_message: "--target requires a triple"
                    }
                }
                else if arg.starts_with("-L") & arg.get_length() > 2
                {
                    ; Library search path: -L<path> (prefix-form, like clang).
                    ; Forwarded verbatim to the clang link command.
                    opts.library_paths.add(String(arg_ptr + 2))
                }
                else if arg.starts_with("-l") & arg.get_length() > 2
                {
                    ; Library name: -l<name> (prefix-form, like clang).
                    opts.libraries.add(String(arg_ptr + 2))
                }
                else
                {
                    ; Unknown option
                    set opts.error_message: "Unknown option: "
                    ; TODO: append arg to error message
                }
            }
            else
            {
                ; Treat positional .a / .o args as extra link inputs so
                ; stage-1 self-build can pass libscalyc.a directly.
                if arg.ends_with(".a") | arg.ends_with(".o")
                {
                    opts.extra_objects.add(String(arg_ptr))
                }
                else if opts.has_input()
                {
                    set opts.error_message: "Multiple input files not yet supported"
                }
                else
                {
                    set opts.input_file: String(arg_ptr)
                }
            }

            set i: i + 1
        }

        opts
    }

    ; Print usage information
    procedure print_usage()
    {
        Console.println "Usage: scalyc [options] <input file>"
        Console.println ""
        Console.println "Options:"
        Console.println "  -h, --help     Show this help message"
        Console.println "  -v, --verbose  Verbose output"
        Console.println "  -o <file>      Output file"
        Console.println "  -S             Emit LLVM IR"
        Console.println("  -c             Compile only (no link)")
        Console.println "  -L<path>       Add library search path"
        Console.println "  -l<name>       Link library by name"
        Console.println "  <file>.a/.o    Positional link inputs"
        Console.println "  --lex          Lex input and print tokens"
        Console.println "  --parse        Parse input and validate syntax"
        Console.println "  --model        Build semantic model"
        Console.println("  --plan         Run planner (type resolution)")
        Console.println "  --no-prelude   Skip auto-loading prelude module"
        Console.println("  --no-tests     Omit test/test_* functions (seed build)")
        Console.println("  --task-plan    Report the parallelizability verdict of every for loop")
        Console.println("  --pointer-report  Report every raw-pointer site, classified off the Plan")
        Console.println("  --write-report  Report every write through a parameter, off the Plan")
        Console.println("  --purity-check  Report every function that writes what its parameters reach")
        Console.println "  --run <fn>     JIT-compile and run <fn> in-process"
        Console.println "  --jit          JIT-compile and run the whole program"
        Console.println "  --target <t>   Cross-emit object for triple <t> (use with -c)"
    }

    ; The directory for the compiler's own scratch object. POSIX has /tmp;
    ; Windows has no such directory and a native binary resolves the string
    ; "/tmp/..." against the CURRENT DRIVE root (C:\tmp\...), which does not
    ; exist — so the object write fails and the link never happens. The CRT
    ; always sets TMP, and TEMP is its long-standing twin; the current
    ; directory is the last resort so the compiler can still work rather than
    ; refuse. Forward slashes are fine: every Windows API accepts them.
    ;
    ; ★POSIX is untouched by construction — the caller only asks when the
    ; resolved target is COFF, so every existing path stays the literal
    ; "/tmp/..." string it has always been.
    procedure windows_scratch_dir() returns String
    {
        var dir getenv "TMP"
        if dir = null
            set dir: getenv("TEMP")
        if dir = null
            return "."
        var s String(dir)
        if s.get_length() = 0
            return "."
        ; The construction is the RETURN EXPRESSION, not the local `s` — a
        ; String built into a local and then handed up lands its buffer
        ; through `Page.get(this)` on the caller's return slot. Same shape as
        ; `link_compiler` two functions down, and for the same reason.
        String(dir)
    }

    ; Resolve the runtime static archive the linker pulls in. When SCALY_HOME
    ; is set (the installed `scalyc` wrapper sets it), the archive lives at a
    ; PERSISTENT path under the install tree, $SCALY_HOME/lib/libscaly.a, so it
    ; survives reboots — unlike /tmp, which is cleared on boot. With SCALY_HOME
    ; unset (CI, bootstrap, AOT harness) it stays /tmp/libscaly.a exactly as
    ; before, so those paths are byte-for-byte unchanged.
    ;
    ; ★Stage 7: on a COFF target the archive is `libscaly.lib` and the scratch
    ; directory is the one above. The suffix is not cosmetic — that is the name
    ; `llvm-ar` gives it there and the name the MSVC-driver link expects.
    procedure runtime_archive_path(coff: bool) returns String
    {
        var leaf "/libscaly.a"
        if coff
            set leaf: "/libscaly.lib"
        let home getenv "SCALY_HOME"
        var base "/tmp"
        if coff
            set base: windows_scratch_dir()
        if home <> null
        {
            var home_str String(home)
            if home_str.get_length() > 0
            {
                return "`home_str`/lib`leaf`"
            }
        }
        "`base``leaf`"
    }

    ; Resolve the C compiler used to link the final executable. Honors
    ; $SCALY_CC (the installed wrapper bakes in the compiler the installer
    ; found, e.g. clang-18 on a box that has no plain `clang`), then $CC,
    ; falling back to `clang`. Unset → `clang`, exactly as before, so CI /
    ; bootstrap / AOT linking is byte-for-byte unchanged.
    procedure link_compiler() returns String
    {
        var name getenv "SCALY_CC"
        if name = null
            set name: getenv("CC")
        if name = null
            return "clang"
        var s String(name)
        if s.get_length() = 0
            return "clang"
        String(name)
    }

    ; Run the compiler with parsed options
    ; Returns 0 on success, non-zero on error
    procedure run(mutable opts: Options) returns int mutable modeler_error_count
    {
        if opts.show_help
        {
            print_usage()
            return 0
        }

        if opts.has_error()
        {
            Console.println "Error: "
            ; TODO: print error message
            return 1
        }

        if opts.has_input() = false
        {
            Console.println "Error: No input file specified"
            print_usage()
            return 1
        }

        if opts.verbose
        {
            Console.println "Compiling: "
            ; TODO: print input file
        }

        ; Read the source file
        var source File.read_to_string(opts.input_file)
        if source.get_length() = 0
        {
            Console.println "Error: Could not read input file"
            return 1
        }

        if opts.verbose
            Console.println "Read source file successfully"

        ; ================================================================
        ; Stage 1: Parse
        ; ================================================================

        var p parser.Parser(source)

        if opts.lex_only
        {
            ; Just tokenize and print tokens
            Console.println "Tokens:"
            p.lexer.advance()
            while p.lexer.is_at_end() = false
            {
                ; TODO: Print token details
                Console.println "  <token>"
                p.lexer.advance()
            }
            return 0
        }

        ; Parse the program
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                ; s194: the thrown error now survives propagation (NPO
                ; retired), so surface the real message + location instead
                ; of a bare "Parse error". Invalid carries the parser's
                ; diagnostic (e.g. "expected Else" for a no-else `if`);
                ; Different means the top-level construct simply didn't match.
                choose err
                    when i: Invalid
                        cli.print_parse_error(opts.input_file, source, i.start, i.message)
                    when d: Different
                        Console.println "Parse error"
                return 2
            }
            when program: Success
            {
                set syntax: program
            }

        if opts.verbose
            Console.println "Parsing completed successfully"

        if opts.parse_only
        {
            Console.println "Parse successful"
            return 0
        }

        ; ================================================================
        ; Stage 2: Build semantic model
        ; ================================================================

        ; Extract program name from filename (strip path and extension)
        var program_name cli.extract_program_name(opts.input_file)

        let model Modeler.build_program(opts.input_file, program_name, syntax, opts.no_prelude = false)

        ; A sub-module (`module foo` / package / prelude) that failed to PARSE
        ; was already reported by the Modeler against its own file:line:col.
        ; Stop here (rc 2, like a main-file parse error) so the planner doesn't
        ; pile misleading "not found" diagnostics on top of the real one.
        if Modeler.had_errors()
            return 2

        if opts.verbose
            Console.println "Model built successfully"

        if opts.model_only
        {
            Console.println "Model built successfully"
            return 0
        }

        ; ================================================================
        ; Stage 3: Plan (type resolution, name mangling)
        ; ================================================================

        var planner Planner.Planner(opts.input_file)
        if opts.host_report
            set planner.host_report: true
        if opts.interface_facts
            set planner.gate.deep_facts: true
        if opts.use_vis
            set planner.use_vis_measure: true
        if opts.no_use_vis
            set planner.use_vis_enforce: false
        ; --jit / --run: dependency-package bodies are NOT planned into the
        ; program module (the old jit_dep_bodies path mis-planned large
        ; dependency bodies into corrupt plans — both the escape walker and the
        ; emitter crashed on them). Instead each non-scaly dependency package is
        ; AOT-compiled through the known-good ROOT path into an object and added
        ; to the JITDylib (cli.compile_jit_dependencies + Emitter.jit_run), so
        ; the program's extern declarations link against the real bodies. The
        ; program itself plans identically to the AOT (-c) build.
        cli.register_packages(&planner, &model)
        let plan planner.plan_program model

        if plan = null
        {
            Console.println "Planner error"
            return 4
        }

        ; --use-vis: advisory use-visibility measurement report (stage 2).
        ; Printed before the hard-diagnostics gate so measurement output
        ; survives a failing compile.
        if opts.use_vis
            cli.print_use_vis(&planner)

        ; --pointer-report: raw-pointer census (advisory, PointerCensus.scaly).
        ; Deliberately in the --use-vis slot, BEFORE the diagnostics gate: a
        ; half-converted root with one hard diagnostic must still measure,
        ; because that is exactly the root the census is for.
        if opts.pointer_report
        {
            var census PointerCensus.PointerCensus()
            census.analyze(plan, &model, opts.input_file)
            cli.print_pointer_report(&census)
        }

        ; --write-report: which bodies write through their parameters (advisory,
        ; WriteCensus.scaly), in the same slot and for the same reason.
        if opts.write_report
        {
            var wcensus PointerCensus.PointerCensus()
            var writes WriteCensus.WriteCensus()
            writes.analyze(plan, &model, &wcensus)
            cli.print_write_report(&writes)
        }

        ; --host-report: the named-page constructions whose value never
        ; leaves its routine (Planner.host_census#), advisory, same slot.
        if opts.host_report
        {
            planner.host_census()
            cli.print_host_report(&planner)
        }

        ; --purity-check: R1 step 2 as a report (WriteCensus' check mode)
        if opts.purity_check
        {
            var pcensus PointerCensus.PointerCensus()
            var purity WriteCensus.WriteCensus()
            set purity.check_mode: true
            purity.analyze(plan, &model, &pcensus)
            cli.print_purity_check(&purity)
        }

        ; s185 (roadmap Step C): hard diagnostics — constructs the
        ; planner could not resolve and the emitter would silently
        ; drop. Print each with file:line:col and fail the compile,
        ; mirroring stage-0's error behavior.
        if planner.has_diagnostics()
        {
            cli.print_diagnostics(&planner, opts.input_file, source)
            return 4
        }

        ; R1: a function writes nothing its parameters reach, a procedure only
        ; the parameters it declares `mutable` (WriteCensus' check mode, the
        ; `--purity-check` report as a gate). After the planner's own gate: a
        ; plan with hard diagnostics is not judged. The two census reports
        ; measure trees that may not obey the rule yet, so they skip it.
        if opts.write_report = false
        {
            if opts.purity_check = false
            {
                var gate_census PointerCensus.PointerCensus()
                var purity_gate WriteCensus.WriteCensus()
                set purity_gate.check_mode: true
                set purity_gate.diagnostics: true
                purity_gate.analyze(plan, &model, &gate_census)
                if purity_gate.n_violations > 0
                {
                    cli.print_located("", &purity_gate.report_files, &purity_gate.report_offsets, &purity_gate.report_texts)
                    return 4
                }
                purity_gate.mark_stub_purity(plan)
                if opts.interface_facts
                {
                    let facts planner.interface_facts(model.module_)
                    Console.print(facts.to_c_string())
                    let rfacts purity_gate.interface_reads()
                    Console.print(rfacts.to_c_string())
                    return 0
                }
            }
        }

        ; --task-plan: TaskPlanner parallelizability report (advisory —
        ; mirrors the --use-vis measurement precedent). Since 4.4 this
        ; is the only surface where parallelization is observable: a
        ; "parallel" verdict means the Emitter dispatches that loop
        ; through the adaptive engine; a blocked one runs sequentially.
        if opts.task_plan
        {
            var task_planner TaskPlanner.TaskPlanner()
            task_planner.analyze(plan, opts.input_file)
            cli.print_task_plan(&task_planner)
        }

        if opts.verbose
            Console.println "Planning completed successfully"

        if opts.plan_only
        {
            Console.println "Planning completed successfully"
            return 0
        }

        ; ================================================================
        ; --run: JIT-compile and execute a function in-process (Phase 1:
        ; zero-arg, int-returning). The function's i64 return becomes the
        ; process exit code. Prelude stays ON (the JIT module carries the
        ; RBMM runtime; libc is resolved by the ORC process generator).
        ; ================================================================
        if opts.run_mode
        {
            ; Find the mangled name of the requested function in the plan
            ; (mirrors ModuleTests.cpp's name->MangledName scan).
            var target_mangled ""
            if plan.functions <> null
            {
                for f in plan.functions
                {
                    if f.name = opts.run_function
                    {
                        if target_mangled.get_length() = 0
                            set target_mangled: f.mangled_name
                    }
                }
            }
            if target_mangled.get_length() = 0
            {
                Console.println "Error: --run function not found"
                return 10
            }

            var jit_config EmitterConfig()
            set jit_config.emit_debug_info: false
            var jit_emitter Emitter.Emitter(jit_config)
            var run_dep_objs Array[String]()
            var run_dep_syms Array[String]()
            if cli.compile_jit_dependencies(&model, &run_dep_objs, &run_dep_syms) = false
                return 4
            let jit_rc jit_emitter.jit_run(plan, program_name, target_mangled, &run_dep_objs, &run_dep_syms)
            return jit_rc as int
        }

        ; ================================================================
        ; --jit: JIT-compile and run the whole program in-process. emit()
        ; synthesizes an @main from the top-level statements; we JIT-look up
        ; "main" and call it (its return is the exit code). Used to run the
        ; literate/semantic test corpus through the self-hosted JIT (Phase 2).
        ; ================================================================
        if opts.jit_program
        {
            var prog_config EmitterConfig()
            set prog_config.emit_debug_info: false
            var prog_emitter Emitter.Emitter(prog_config)
            var prog_dep_objs Array[String]()
            var prog_dep_syms Array[String]()
            if cli.compile_jit_dependencies(&model, &prog_dep_objs, &prog_dep_syms) = false
                return 4
            let prog_rc prog_emitter.jit_run(plan, program_name, "main", &prog_dep_objs, &prog_dep_syms)
            return prog_rc as int
        }

        ; ================================================================
        ; Stage 4: Emit (LLVM IR generation)
        ; ================================================================

        var config EmitterConfig()
        set config.emit_debug_info: opts.debug
        set config.skip_tests: opts.no_tests
        set config.target_triple: opts.target_triple
        set config.opt_level: opts.opt_level
        set config.page_size: planner.page_size_constant()

        var emitter Emitter.Emitter(config)
        if opts.debug
            emitter.set_debug_source(opts.input_file, source)
        let emit_result emitter.emit(plan, program_name)

        if emit_result = false
        {
            Console.println "Emitter error"
            return 5
        }

        if opts.verbose
            Console.println "Code generation completed successfully"

        if opts.emit_ir
        {
            if opts.output_file.get_length() = 0
            {
                Console.println "Error: -S requires -o <file>"
                return 6
            }
            let ir_ok emitter.write_module_to_file opts.output_file
            if ir_ok = false
            {
                Console.println "Error: Could not write IR file"
                return 6
            }
            return 0
        }

        ; -c: compile only (write object file, no link). Mirrors stage-0
        ; main.cpp's CompileOnly branch.
        if opts.compile_only
        {
            if opts.output_file.get_length() = 0
            {
                Console.println "Error: -c requires -o <file>"
                return 6
            }
            let obj_ok emitter.write_object_to_file opts.output_file
            if obj_ok = false
            {
                Console.println "Error: Could not write object file"
                return 8
            }
            return 0
        }

        if opts.output_file.get_length() = 0
        {
            Console.println "Error: -o <file> required for linking"
            return 7
        }

        ; ★Stage 7: the link step is the one place the compiler has to know
        ; which PLATFORM it is building for, and the emitter already resolved
        ; that question once for the comdat decision. Asking it here keeps a
        ; single source of truth; every branch below leaves the POSIX command
        ; byte-for-byte as it was, because POSIX never takes one.
        let coff emitter.target_is_coff_format()

        ; Emit the object to a temp path UNIQUE PER PROCESS (the pid in the
        ; name), link with clang, then unlink it. It was ONE fixed path until
        ; 2026-09-23, which forbade two links at once on a machine — every
        ; suite and every bisection ran serially on one core because of it.
        var tb StringBuilder()
        if coff
            tb.append(windows_scratch_dir())
        else
            tb.append "/tmp"
        tb.append "/scalyc_out_"
        tb.append(getpid() as int)
        tb.append ".o"
        var tmp_obj tb.to_string()
        let obj_ok emitter.write_object_to_file tmp_obj
        if obj_ok = false
        {
            Console.println "Error: Could not write object file"
            return 8
        }

        var cmd_builder StringBuilder()
        cmd_builder.append(link_compiler())
        cmd_builder.append " "
        cmd_builder.append tmp_obj
        ; Append the scaly stdlib static archive. Provides runtime
        ; functions (Page.allocate_root_page etc.) that stage-1 emits
        ; as declarations only because it can't fully plan
        ; root_pages.scaly. Must be built with --no-prelude:
        ;     scalyc -c --no-prelude -o /tmp/libscaly.o packages/scaly/0.1.0/scaly.scaly
        ;     ar rcs /tmp/libscaly.a /tmp/libscaly.o
        ; Without --no-prelude, libscaly.o also carries print/println
        ; (which the prelude defines as wrappers around puts), and
        ; user .o's also emit those — `ld` then fails with duplicate
        ; symbols on every AOT test that pulls libscaly.o in for
        ; the runtime (s111).

        ; Forward extra positional .a / .o inputs from the user
        ; (e.g. /tmp/libscalyc.a for stage-1 self-build). Required
        ; before -l flags so static-archive resolution sees the
        ; archives' references first.
        var ei: size_t 0
        while ei < opts.extra_objects.length
        {
            let e_ptr opts.extra_objects.get ei
            if e_ptr <> null
            {
                cmd_builder.append " "
                cmd_builder.append((*e_ptr))
            }
            set ei: ei + 1
        }

        ; Runtime archive AFTER the user's extra objects: a left-to-right
        ; linker (GNU BFD/lld on Linux) pulls an archive member only to
        ; satisfy symbols undefined SO FAR. main.o references only the
        ; scalyc package (cli.main) — no runtime symbol directly — so the
        ; runtime archive must follow the package archive (libscalyc*.a),
        ; whose members reference get/Page::allocate/String. macOS ld64 is
        ; order-insensitive, so this reorder is a no-op there (fixpoint-safe).
        cmd_builder.append " "
        cmd_builder.append(runtime_archive_path(coff))

        ; Forward -L<path> entries.
        var li: size_t 0
        while li < opts.library_paths.length
        {
            let l_ptr opts.library_paths.get li
            if l_ptr <> null
            {
                cmd_builder.append " -L"
                cmd_builder.append((*l_ptr))
            }
            set li: li + 1
        }

        ; Forward -l<name> entries.
        var bi: size_t 0
        while bi < opts.libraries.length
        {
            let b_ptr opts.libraries.get bi
            if b_ptr <> null
            {
                cmd_builder.append " -l"
                cmd_builder.append((*b_ptr))
            }
            set bi: bi + 1
        }

        ; libm, last of the -l flags. The runtime archive is ONE object, so a
        ; program that needs any runtime symbol pulls in the tensor tape kernels
        ; too, and those call tanhf/expf/sqrtf/logf/powf. macOS has them in
        ; libSystem (linked by default); on Linux they live in a separate libm,
        ; where a left-to-right linker also requires the library to come AFTER
        ; the archive that references it — hence here, past the user's own -l
        ; entries. Without it every Linux AOT link that touches the runtime
        ; failed with undefined math symbols (the whole tests/aot corpus minus
        ; the few programs that pull nothing from the archive).
        ;
        ; ★Stage 7: Windows has NO libm — the MSVC CRT carries that math, so
        ; `-lm` there is not a no-op but a hard `cannot open file 'm.lib'`. What
        ; it does need instead is Winsock, because the same one-object archive
        ; drags in the IOCP backend: every `scaly_eio_*` entry point, the
        ; socket-vs-descriptor test in `close`, and the socketpair emulation
        ; live in ws2_32. Same argument, opposite library.
        if coff
            cmd_builder.append " -lws2_32"
        else
            cmd_builder.append " -lm"

        cmd_builder.append " -o "
        cmd_builder.append opts.output_file
        let cmd_str cmd_builder.to_string()
        let link_rc system(cmd_str.c_data())

        ; -g: on macOS the linker leaves DWARF in a debug map that points at
        ; the temp .o (Mach-O doesn't embed DWARF in the executable), so lldb
        ; needs a standalone .dSYM next to the binary. Run dsymutil while the
        ; .o still exists. Harmless elsewhere — on ELF the executable already
        ; carries DWARF, and an absent dsymutil just fails into 2>/dev/null.
        if opts.debug
            if link_rc = 0
            {
                let dsym_str "dsymutil `opts.output_file` 2>/dev/null"
                let dsym_rc system(dsym_str.c_data())
            }

        let unlink_rc unlink(tmp_obj.c_data())

        if link_rc <> 0
        {
            Console.println "Error: Linker failed"
            return 9
        }

        0
    }

    ; Extract program name from file path
    ; e.g., "/path/to/hello.scaly" -> "hello"
    ; Pre-register packages from the model into the planner's cache so
    ; load_package_on_demand# can resolve them. Mirrors stage-0's resolved-
    ; package wiring. We hand off Module by reference; the helper exists in
    ; procedure form so each `register` call is at function-statement
    ; granularity (avoids the same in-place Vector[Module].add codegen
    ; pitfall worked around in Modeler.scaly).
    procedure register_packages(mutable planner: ref[Planner.Planner], model: ref[Program])
    {
        var i: size_t 0
        while i < model.packages.length
        {
            let pkg_ptr model.packages.get i
            if pkg_ptr <> null
            {
                planner.register_loaded_package(pkg_ptr.name, *pkg_ptr)
                planner.register_module_concepts(*pkg_ptr)
            }
            set i: i + 1
        }
    }

    ; --jit/--run: AOT-compile every non-scaly dependency package to an object
    ; and collect the mangled names each defines. jit_run adds these objects to
    ; the JITDylib so the program module's extern declarations of dependency
    ; functions resolve to the real bodies (see Emitter.jit_run). The `scaly`
    ; stdlib is skipped — its symbols are already in the host scalyc image and
    ; resolve via the ORC process generator. Returns false on any dep failure.
    procedure compile_jit_dependencies(mutable model: ref[Program], mutable dep_objs: ref[Array[String]], mutable dep_syms: ref[Array[String]]) returns bool mutable modeler_error_count
    {
        var i: size_t 0
        while i < model.packages.length
        {
            let pkg_ptr model.packages.get i
            if pkg_ptr <> null
            {
                let pkg (*pkg_ptr)
                if pkg.name.equals("scaly") = false
                {
                    let obj_path "/tmp/scalyc_jitdep_`pkg.name`.o"
                    if cli.compile_dep_package_to_object(pkg.file, obj_path, dep_syms) = false
                    {
                        Console.println "Error: could not compile dependency package for JIT"
                        return false
                    }
                    ; Deep-copy onto the CALLER's page before handing the path
                    ; over — the same anchoring the `syms` loop below documents.
                    ; obj_path lives on this procedure's own region, which dies
                    ; at `return`, so a shallow add leaves jit_run reading a
                    ; freed buffer: it then opens a garbage path, LLVM takes its
                    ; error branch, and because the call site passes null for
                    ; LLVMCreateMemoryBufferWithContentsOfFile's OutMessage, the
                    ; failure arrives as a SIGSEGV inside libLLVM rather than as
                    ; a diagnostic. Latent for as long as nothing reused the
                    ; freed page; the lazy region frames (2026-08-01) changed the
                    ; arena layout and made it fire every run.
                    let obj_page Page.get(dep_objs)
                    let durable_obj String^obj_page(obj_path)
                    dep_objs.add durable_obj
                }
            }
            set i: i + 1
        }
        true
    }

    ; `<dir>/interface/<p>.scaly` -> `<dir>/<p>.scaly`; any other path as it is
    function source_root(file: String) returns String
    {
        let slash file.last_index_of("/" as u8)
        if slash < 0
            return file
        let dir file.substring(0, slash as size_t)
        if dir.ends_with("/interface") = false
            return file
        var sb StringBuilder()
        sb.append(dir.substring(0, dir.get_length() - 10))
        sb.append(file.substring(slash as size_t, file.get_length() - (slash as size_t)))
        sb.to_string()
    }

    ; Compile a dependency package (its entry .scaly file) through the same
    ; ROOT compilation path that builds libopensp.a/libdazzle.a — prelude OFF
    ; (its scaly-stdlib calls resolve from the host process at JIT link) — into
    ; an object at out_obj, and append the mangled names it defines to `syms`.
    ; This ROOT path plans the package's bodies correctly (unlike the retired
    ; jit_dep_bodies dependency path). Returns false on any failure.
    procedure compile_dep_package_to_object(mutable entry_file_in: String, mutable out_obj: String, mutable syms: ref[Array[String]]) returns bool mutable modeler_error_count
    {
        ; the program loaded the package through its interface; the object is
        ; built from its SOURCE root
        var entry_file cli.source_root(entry_file_in)
        var source File.read_to_string(entry_file)
        if source.get_length() = 0
        {
            Console.println "Error: could not read dependency package source"
            return false
        }
        var p parser.Parser(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
                return false
            when program: Success
                set syntax: program
        let dep_name cli.extract_program_name(entry_file)
        let dep_model Modeler.build_program(entry_file, dep_name, syntax, false)
        if Modeler.had_errors()
            return false
        var dep_planner Planner.Planner(entry_file)
        cli.register_packages(&dep_planner, &dep_model)
        let dep_plan dep_planner.plan_program dep_model
        if dep_plan = null
            return false
        if dep_planner.has_diagnostics()
            return false
        var dep_config EmitterConfig()
        set dep_config.emit_debug_info: false
        var dep_emitter Emitter.Emitter(dep_config)
        let dep_emit_ok dep_emitter.emit(dep_plan, dep_name)
        if dep_emit_ok = false
            return false
        ; This object is destined for the JITDylib, not a static link: the ORC
        ; object linker registers no TLV descriptor for a thread-local it
        ; materializes, so the first access abort()s in _tlv_bootstrap_error.
        ; Same de-TLS pass jit_run runs over the program module — a dependency
        ; package's mutable globals (scalyc's own `modeler_error_count`) hit it
        ; exactly the same way.
        dep_emitter.jit_clear_thread_locals()
        let obj_ok dep_emitter.write_object_to_file out_obj
        if obj_ok = false
            return false
        ; f.mangled_name lives on dep_plan's region, which is freed when this
        ; procedure returns — a shallow (*syms).add would leave a String handle
        ; dangling into freed memory (later overwritten; get_length then reads a
        ; corrupt varint length prefix and exit 11s during emit_jit_stubs). The
        ; caller's Array `syms` is page-hosted on the caller region that outlives
        ; jit_run, so deep-copy each name onto THAT page (Page.get(syms)) — the
        ; same page-anchoring idiom Array.add uses for its own storage.
        if dep_plan.functions <> null
        {
            let sym_page Page.get(syms)
            for f in dep_plan.functions
            {
                let durable_name String^sym_page(f.mangled_name)
                syms.add durable_name
            }
        }
        true
    }

    ; Print hard planner diagnostics in stage-0's error format:
    ;     <file>:<line>:<col>: error: <message>
    ; Line/col are computed by walking the main source text up to the
    ; recorded byte offset (mirrors stage-0 calculatePosition). NOTE:
    ; offsets of constructs from other modules of the package are
    ; attributed to the main input file — single-file accuracy first.
    ; s194: format a single parse error as `file:line:col: <message>`,
    ; mirroring print_diagnostics#'s offset→line/col walk (numeric LF
    ; compare — `"\n" as char` mis-compiles under stage-1).
    procedure print_parse_error(file_path: String, source: String, offset: size_t, message: String)
    {
        var line: size_t 1
        var col: size_t 1
        let src_len source.get_length()
        var target offset
        if target > src_len
            set target: src_len
        var off: size_t 0
        while off < target
        {
            let c source.get off
            if c = ("\n" as char)
            {
                set line: line + 1
                set col: 1
            }
            else
                set col: col + 1
            set off: off + 1
        }
        let msg_str "`file_path`:`cli.format_size(line)`:`cli.format_size(col)`: `message`"
        Console.println(msg_str.to_c_string())
    }

    procedure print_diagnostics(planner: ref[Planner.Planner], file_path: String, source: String)
    {
        var di: size_t 0
        while di < planner.diagnostics.length
        {
            let d_ptr planner.diagnostics.get di
            if d_ptr <> null
            {
                ; The diagnostic's byte offset is relative to ITS OWN source
                ; file (a sub-module lives in its own file). Format against
                ; that file, falling back to the entry file/source when the
                ; diagnostic carries no file (e.g. a post-pass check with no
                ; current-module context). Mirrors stage-0's per-error File.
                var dpath: String file_path
                var dsrc: String source
                if d_ptr.file.get_length() > 0
                {
                    set dpath: d_ptr.file
                    set dsrc: File.read_to_string(d_ptr.file)
                }
                var line: size_t 1
                var col: size_t 1
                let src_len dsrc.get_length()
                var target d_ptr.start
                if target > src_len
                    set target: src_len
                var off: size_t 0
                while off < target
                {
                    ; Numeric LF compare: `"\n" as char` compiles to a
                    ; never-true comparison under stage-1 (escape handling
                    ; in char-cast literals); 10 works in every stage.
                    let c dsrc.get off
                    if c = ("\n" as char)
                    {
                        set line: line + 1
                        set col: 1
                    }
                    else
                    {
                        set col: col + 1
                    }
                    set off: off + 1
                }
                var msg StringBuilder()
                msg.append(cli.display_path(dpath))
                msg.append ":"
                msg.append(cli.format_size(line))
                msg.append ":"
                msg.append(cli.format_size(col))
                msg.append ": error: "
                msg.append d_ptr.message
                let msg_str msg.to_string()
                Console.println(msg_str.to_c_string())
            }
            set di: di + 1
        }
    }

    ; --use-vis report: aggregate counts plus one line per distinct
    ; (concept, looking-up file) miss. A [lazy] tag marks a first
    ; sighting during lazy instantiation — those need the visibility-
    ; context switch (nested-planning trap), not a use line.
    procedure print_use_vis(planner: ref[Planner.Planner])
    {
        var head StringBuilder()
        head.append "use-vis: "
        head.append(cli.format_size(planner.use_vis_hits))
        head.append " visible, "
        head.append(cli.format_size(planner.use_vis_misses))
        head.append " invisible lookups, "
        head.append(cli.format_size(planner.use_vis_miss_idx.length))
        head.append " distinct"
        let head_str head.to_string()
        Console.println(head_str.to_c_string())

        var i: size_t 0
        while i < planner.use_vis_miss_idx.length
        {
            let ip planner.use_vis_miss_idx.get i
            if ip <> null
            {
                let cidx (*ip)
                var msg StringBuilder()
                msg.append "use-vis MISS: "
                let fp planner.use_vis_miss_files.get i
                if fp <> null
                    msg.append((*fp))
                msg.append ": "
                let kp planner.concepts.get cidx
                if kp <> null
                    msg.append kp.key
                msg.append " (origin "
                let op planner.concept_origin_paths.get cidx
                if op <> null
                    msg.append((*op))
                msg.append ")"
                let lp planner.use_vis_miss_lazy.get i
                if lp <> null
                {
                    if (*lp) = 1
                        msg.append " [lazy]"
                }
                let msg_str msg.to_string()
                Console.println(msg_str.to_c_string())
            }
            set i: i + 1
        }
    }

    ; --task-plan report (stage-3 milestone 3.0): aggregate counts plus one
    ; line per `for` loop, file:line:col like print_diagnostics — the byte
    ; offset is relative to the loop's own source file, so re-read the file
    ; when it changes (entries arrive grouped by file, one read per file).
    procedure print_task_plan(tp: ref[TaskPlanner.TaskPlanner])
    {
        var head StringBuilder()
        head.append "task-plan: "
        head.append(cli.format_size(tp.loops_total))
        head.append " for-loops, "
        head.append(cli.format_size(tp.loops_parallel))
        head.append " parallelizable"
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("task-plan: ", &tp.report_files, &tp.report_offsets, &tp.report_verdicts)
    }

    ; --host-report: the head line counts the candidates and the LOCAL
    ; verdicts, then one located line per candidate (Planner.host_census#).
    procedure print_host_report(planner: ref[Planner.Planner])
    {
        var head StringBuilder()
        head.append "host-report: "
        head.append(cli.format_size(planner.census_total))
        head.append " candidates, "
        head.append(cli.format_size(planner.census_local))
        head.append " local"
        if planner.census_pinned_count > 0
        {
            head.append " ("
            head.append(cli.format_size(planner.census_pinned_count))
            head.append " pinned)"
        }
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("host-report: ", &planner.census_files, &planner.census_offsets, &planner.census_texts)
    }

    ; --pointer-report: the head line carries one count per class, then one
    ; located line per site (PointerCensus.scaly has the class list).
    procedure print_pointer_report(pc: ref[PointerCensus.PointerCensus])
    {
        var head StringBuilder()
        head.append "pointer-report: "
        head.append(cli.format_size(pc.total()))
        head.append " sites; extern "
        head.append(cli.format_size(pc.n_extern))
        head.append ", param "
        head.append(cli.format_size(pc.n_param))
        head.append ", return "
        head.append(cli.format_size(pc.n_return))
        head.append ", field "
        head.append(cli.format_size(pc.n_field))
        head.append ", variant "
        head.append(cli.format_size(pc.n_variant))
        head.append ", local "
        head.append(cli.format_size(pc.n_local))
        head.append ", deref "
        head.append(cli.format_size(pc.n_deref))
        head.append ", deref-arith "
        head.append(cli.format_size(pc.n_deref_arith))
        head.append ", arith "
        head.append(cli.format_size(pc.n_arith))
        head.append ", cast "
        head.append(cli.format_size(pc.n_cast))
        head.append ", null-cast "
        head.append(cli.format_size(pc.n_null_cast))
        head.append ", null-test "
        head.append(cli.format_size(pc.n_null_test))
        head.append ", store "
        head.append(cli.format_size(pc.n_store))
        head.append ", arg "
        head.append(cli.format_size(pc.n_arg))
        head.append ", arg-extern "
        head.append(cli.format_size(pc.n_arg_extern))
        head.append ", arg-unresolved "
        head.append(cli.format_size(pc.n_arg_unresolved))
        head.append ", h-pointer-into-ref "
        head.append(cli.format_size(pc.n_h_ptr_ref))
        head.append ", h-slice-into-pointer "
        head.append(cli.format_size(pc.n_h_slice_ptr))
        head.append ", h-mixed-params "
        head.append(cli.format_size(pc.n_h_mixed))
        head.append ", h-store-through-ref-slot "
        head.append(cli.format_size(pc.n_h_store_slot))
        head.append "; optional-ref derefs (not listed) "
        head.append(cli.format_size(pc.n_optref_deref))
        head.append ", bodies unfiled "
        head.append(cli.format_size(pc.n_unfiled))
        head.append ", alias handles (not listed) "
        head.append(cli.format_size(pc.n_handle))
        head.append ", stack arrays (not listed) "
        head.append(cli.format_size(pc.n_stack_array))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("pointer-report: ", &pc.report_files, &pc.report_offsets, &pc.report_texts)
    }

    procedure print_write_report(wc: ref[WriteCensus.WriteCensus])
    {
        var head StringBuilder()
        head.append "write-report: "
        head.append(cli.format_size(wc.total()))
        head.append " lines; bodies "
        head.append(cli.format_size(wc.n_bodies))
        head.append ", functions "
        head.append(cli.format_size(wc.n_pure))
        head.append " (writing "
        head.append(cli.format_size(wc.n_pure_writing))
        head.append ", direct "
        head.append(cli.format_size(wc.n_pure_direct))
        head.append "), procedures "
        head.append(cli.format_size(wc.n_proc))
        head.append " (writing "
        head.append(cli.format_size(wc.n_proc_writing))
        head.append "); sites "
        head.append(cli.format_size(wc.n_sites))
        head.append ", unfiled "
        head.append(cli.format_size(wc.n_unfiled))
        head.append ", misaligned calls "
        head.append(cli.format_size(wc.n_misaligned))
        head.append ", other-root calls "
        head.append(cli.format_size(wc.n_stub_known))
        head.append " (unknown "
        head.append(cli.format_size(wc.n_stub_unknown))
        head.append ")"
        head.append ", rounds "
        head.append(cli.format_size(wc.n_rounds))
        head.append ", alias rounds "
        head.append(cli.format_size(wc.n_rp_rounds))
        if wc.frozen_mode
        {
            head.append "; FROZEN: reachable "
            head.append(cli.format_size(wc.n_reachable))
            head.append ", sites "
            head.append(cli.format_size(wc.n_frozen_sites))
            head.append " (locked "
            head.append(cli.format_size(wc.n_locked_sites))
            head.append "), provenance rounds "
            head.append(cli.format_size(wc.n_fz_rounds))
        }
        ; R2: stores into a `let` field of a published object (measurement)
        head.append "; LET: sites "
        head.append(cli.format_size(wc.n_let_sites))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("write-report: ", &wc.report_files, &wc.report_offsets, &wc.report_texts)
    }

    procedure print_purity_check(wc: ref[WriteCensus.WriteCensus])
    {
        var head StringBuilder()
        head.append "purity-check: "
        head.append(cli.format_size(wc.n_violations))
        head.append " of "
        head.append(cli.format_size(wc.n_pure))
        head.append " functions write what their parameters reach; sites "
        head.append(cli.format_size(wc.n_sites))
        head.append ", callees of unknown keyword "
        head.append(cli.format_size(wc.n_stub_unknown))
        head.append ", unfiled "
        head.append(cli.format_size(wc.n_unfiled))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("purity-check: ", &wc.report_files, &wc.report_offsets, &wc.report_texts)
    }

    ; Shared located-report printer: one `<prefix><file>:<line>:<col>: <text>`
    ; line per slot of three parallel arrays. The byte offset is relative to
    ; the slot's own source file, so re-read the file when it changes
    ; (entries arrive grouped by file, one read per file).
    procedure print_located(
        prefix: String,
        files: ref[Array[String]],
        offsets: ref[Array[size_t]],
        texts: ref[Array[String]]
    )
    {
        var cur_path String("")
        var cur_src String("")
        var have_src false
        var i: size_t 0
        while i < files.length
        {
            let fp files.get i
            let op_ offsets.get i
            let vp texts.get i
            if fp <> null
            {
                var need_read false
                if have_src = false
                    set need_read: true
                if cur_path <> (*fp)
                    set need_read: true
                if need_read
                {
                    set cur_path: String((*fp))
                    set cur_src: File.read_to_string((*fp))
                    set have_src: true
                }
                var line: size_t 1
                var col: size_t 1
                let src_len cur_src.get_length()
                var target: size_t 0
                if op_ <> null
                    set target: (*op_)
                if target > src_len
                    set target: src_len
                var off: size_t 0
                while off < target
                {
                    ; Numeric LF compare (see print_diagnostics).
                    let c cur_src.get off
                    if c = ("\n" as char)
                    {
                        set line: line + 1
                        set col: 1
                    }
                    else
                    {
                        set col: col + 1
                    }
                    set off: off + 1
                }
                var msg StringBuilder()
                msg.append prefix
                msg.append(cli.display_path((*fp)))
                msg.append ":"
                msg.append(cli.format_size(line))
                msg.append ":"
                msg.append(cli.format_size(col))
                msg.append ": "
                if vp <> null
                    msg.append((*vp))
                let msg_str msg.to_string()
                Console.println(msg_str.to_c_string())
            }
            set i: i + 1
        }
    }

    ; A file of a generated package interface is shown as its SOURCE file:
    ; the interface keeps every line where the source has it (a generic body,
    ; the usual origin of such a report, is even the same text), so the line
    ; and column computed from the interface are the source's.
    function display_path(path: String) returns String
    {
        let needle String("/interface/")
        let n path.get_length()
        let k needle.get_length()
        var i: size_t 0
        while i + k <= n
        {
            let part path.substring(i, k)
            if part.equals(needle)
            {
                return "`path.substring(0, i)``path.substring(i + 10, n - i - 10)`"
            }
            set i: i + 1
        }
        path
    }

    ; Decimal formatting for diagnostics. Local mirror of
    ; Planner.size_to_string to avoid cross-namespace call resolution
    ; risk under stage-1.
    function format_size(n: size_t) returns String
    {
        if n = 0
            return "0"
        var value n
        var digits Array[char]()
        while value > 0
        {
            let digit ((value % 10) as char) + "0" as char
            digits.add digit
            set value: value / 10
        }
        var sb StringBuilder()
        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                sb.append(*d)
        }
        sb.to_string()
    }

    function extract_program_name(file_path: String) returns String
    {
        ; Find last '/' or '\'
        var start 0
        var i 0
        while i < file_path.get_length() as int
        {
            let c file_path.get(i as size_t)
            if c = "/"
                set start: i + 1

            if c = "\\"
                set start: i + 1

            set i: i + 1
        }

        ; Find last '.'
        var end file_path.get_length() as int
        set i: end - 1
        while i >= start
        {
            let c file_path.get(i as size_t)
            if c = "."
            {
                set end: i
                ; break - just use assignment for now
                set i: -1
            }
            set i: i - 1
        }

        ; Extract substring
        if end <= start
            return file_path

        file_path.substring(start as size_t, (end - start) as size_t)
    }

    ; Main entry point
    procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int mutable modeler_error_count
    {
        var opts cli.parse_args(argc, argv)
        return cli.run(opts)
    }

    ; Test function
    procedure test() returns int mutable modeler_error_count
    {
        ; Test 1: Check Options initialization
        var opts Options()
        if opts.has_input()
            return -1

        if opts.has_error()
            return -2

        if opts.verbose
            return -3

        if opts.show_help
            return -4

        ; Test 2: Test extract_program_name
        var path1 "/path/to/hello.scaly"
        var name1 cli.extract_program_name(path1)
        if name1 <> "hello"
            return -10

        var path2 "simple.scaly"
        var name2 cli.extract_program_name(path2)
        if name2 <> "simple"
            return -11

        ; Test 3: Test pipeline on a minimal program
        var result cli.test_pipeline()
        if result <> 0
            return result - 100

        ; Test 4: Test pipeline on hello.scaly from disk
        set result: cli.test_hello_scaly()
        if result <> 0
            return result - 200

        ; All tests passed
        0
    }

    ; Test compiling hello.scaly from disk
    procedure test_hello_scaly() returns int mutable modeler_error_count
    {
        ; Path to hello.scaly (relative to scalyc/build where tests run)
        var file_path "../../hello.scaly"

        ; Read the file
        var source File.read_to_string(file_path)
        if source.get_length() = 0
            return -1  ; Could not read file

        ; Stage 1: Parse
        var p parser.Parser(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                return -2  ; Parse failed
            }
            when program: Success
            {
                set syntax: program
            }

        ; Stage 2: Build model
        var program_name "hello"
        let model Modeler.build_program(file_path, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner(file_path)
        let plan planner.plan_program model
        if plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit
        var config EmitterConfig()
        set config.emit_debug_info: false
        var emitter Emitter.Emitter(config)
        let emit_result emitter.emit(plan, program_name)
        if emit_result = false
            return -4  ; Emission failed

        ; Successfully compiled hello.scaly!
        0
    }

    ; Test the compilation pipeline on a minimal program
    procedure test_pipeline() returns int mutable modeler_error_count
    {
        ; Minimal valid Scaly program
        var source "function test_func() returns int { 42 }"

        ; Stage 1: Parse
        var p parser.Parser(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                return -1  ; Parse failed
            }
            when program: Success
            {
                set syntax: program
            }

        ; Stage 2: Build model
        var file_name "test.scaly"
        var program_name "test"
        let model Modeler.build_program(file_name, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner(file_name)
        let plan planner.plan_program model
        if plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit (just verify it doesn't crash)
        var config EmitterConfig()
        set config.emit_debug_info: false
        var emitter Emitter.Emitter(config)
        let emit_result emitter.emit(plan, program_name)
        if emit_result = false
            return -4  ; Emission failed

        ; All pipeline stages passed
        0
    }
}
