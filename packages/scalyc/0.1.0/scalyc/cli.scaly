; cli.scaly - Command-line interface for the Scaly compiler
;
; This module handles argument parsing and drives the compilation pipeline.

; Standard library imports
use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Vector
use scaly.io.File
use scaly.io.Console
use scaly.memory.runtime.system
use scaly.memory.runtime.unlink

; Compiler module imports
use scalyc.compiler.Modeler
use scalyc.compiler.Model.Program
use scalyc.compiler.Planner
use scalyc.compiler.Plan.Plan
use scalyc.compiler.Emitter
use scalyc.compiler.Emitter.EmitterConfig

; ============================================================================
; Module declarations
; ============================================================================

; Parser module (which includes lexer)
module parser

; ============================================================================
; Command-line options
; ============================================================================

define Options
(
    input_file: String
    output_file: String
    verbose: bool
    emit_ir: bool           ; -S: emit LLVM IR
    compile_only: bool      ; -c: compile only, no link
    lex_only: bool          ; --lex: just tokenize
    parse_only: bool        ; --parse: just parse
    model_only: bool        ; --model: just build model
    plan_only: bool         ; --plan: just run planner
    show_help: bool
    no_prelude: bool        ; --no-prelude: skip auto-loading prelude
    error_message: String
    library_paths: Vector[String]   ; -L<path> entries (no leading -L)
    libraries: Vector[String]       ; -l<name> entries (no leading -l)
    extra_objects: Vector[String]   ; positional .a / .o paths
)
{
    init()
    {
        set input_file: String()
        set output_file: String()
        set verbose: false
        set emit_ir: false
        set compile_only: false
        set lex_only: false
        set parse_only: false
        set model_only: false
        set plan_only: false
        set show_help: false
        set no_prelude: false
        set error_message: String()
        set library_paths: Vector[String]()
        set libraries: Vector[String]()
        set extra_objects: Vector[String]()
    }

    function has_error(this) returns bool
        error_message.get_length() > 0

    function has_input(this) returns bool
        input_file.get_length() > 0
}

; ============================================================================
; Argument parsing
; ============================================================================

define cli
{
    ; Parse command-line arguments
    ; argc: argument count
    ; argv: argument vector (C-style array of char pointers)
    function parse_args#(argc: int, argv: pointer[pointer[char]]) returns Options
    {
        var opts Options#()

        var i 1  ; Skip program name (argv[0])
        while i < argc
        {
            let arg_ptr *(argv + i)
            var arg String$(arg_ptr)

            if arg.starts_with(String$("-"))
            {
                ; Option flag
                if arg.equals(String$("-h")) | arg.equals(String$("--help"))
                {
                    set opts.show_help: true
                }
                else if arg.equals(String$("-v")) | arg.equals(String$("--verbose"))
                {
                    set opts.verbose: true
                }
                else if arg.equals(String$("-S"))
                {
                    set opts.emit_ir: true
                }
                else if arg.equals(String$("-c"))
                {
                    set opts.compile_only: true
                }
                else if arg.equals(String$("--lex"))
                {
                    set opts.lex_only: true
                }
                else if arg.equals(String$("--parse"))
                {
                    set opts.parse_only: true
                }
                else if arg.equals(String$("--model"))
                {
                    set opts.model_only: true
                }
                else if arg.equals(String$("--plan"))
                {
                    set opts.plan_only: true
                }
                else if arg.equals(String$("--no-prelude"))
                {
                    set opts.no_prelude: true
                }
                else if arg.equals(String$("-o"))
                {
                    ; Output file - next argument is the filename
                    set i: i + 1
                    if i < argc
                    {
                        let out_ptr *(argv + i)
                        set opts.output_file: String#(out_ptr)
                    }
                    else
                    {
                        set opts.error_message: String#("-o requires a filename")
                    }
                }
                else if arg.starts_with(String$("-L")) & arg.get_length() > 2
                {
                    ; Library search path: -L<path> (prefix-form, like clang).
                    ; Forwarded verbatim to the clang link command.
                    opts.library_paths.add(String#(arg_ptr + 2))
                }
                else if arg.starts_with(String$("-l")) & arg.get_length() > 2
                {
                    ; Library name: -l<name> (prefix-form, like clang).
                    opts.libraries.add(String#(arg_ptr + 2))
                }
                else
                {
                    ; Unknown option
                    set opts.error_message: String#("Unknown option: ")
                    ; TODO: append arg to error message
                }
            }
            else
            {
                ; Treat positional .a / .o args as extra link inputs so
                ; stage-1 self-build can pass libscalyc.a directly.
                if arg.ends_with(String$(".a")) | arg.ends_with(String$(".o"))
                {
                    opts.extra_objects.add(String#(arg_ptr))
                }
                else if opts.has_input()
                {
                    set opts.error_message: String#("Multiple input files not yet supported")
                }
                else
                {
                    set opts.input_file: String#(arg_ptr)
                }
            }

            set i: i + 1
        }

        opts
    }

    ; Print usage information
    function print_usage()
    {
        Console.println("Usage: scalyc [options] <input file>")
        Console.println("")
        Console.println("Options:")
        Console.println("  -h, --help     Show this help message")
        Console.println("  -v, --verbose  Verbose output")
        Console.println("  -o <file>      Output file")
        Console.println("  -S             Emit LLVM IR")
        Console.println("  -c             Compile only (no link)")
        Console.println("  -L<path>       Add library search path")
        Console.println("  -l<name>       Link library by name")
        Console.println("  <file>.a/.o    Positional link inputs")
        Console.println("  --lex          Lex input and print tokens")
        Console.println("  --parse        Parse input and validate syntax")
        Console.println("  --model        Build semantic model")
        Console.println("  --plan         Run planner (type resolution)")
        Console.println("  --no-prelude   Skip auto-loading prelude module")
    }

    ; Run the compiler with parsed options
    ; Returns 0 on success, non-zero on error
    function run#(opts: Options) returns int
    {
        guard opts.show_help
        {
            print_usage()
            return 0
        }

        guard opts.has_error()
        {
            Console.println("Error: ")
            ; TODO: print error message
            return 1
        }

        guard opts.has_input() = false
        {
            Console.println("Error: No input file specified")
            print_usage()
            return 1
        }

        guard opts.verbose
        {
            Console.println("Compiling: ")
            ; TODO: print input file
        }

        ; Read the source file
        var source File.read_to_string$(opts.input_file)
        guard source.get_length() = 0
        {
            Console.println("Error: Could not read input file")
            return 1
        }

        guard opts.verbose
            Console.println("Read source file successfully")

        ; ================================================================
        ; Stage 1: Parse
        ; ================================================================

        var p parser.Parser$(source)

        guard opts.lex_only
        {
            ; Just tokenize and print tokens
            Console.println("Tokens:")
            p.lexer.advance$()
            while p.lexer.is_at_end() = false
            {
                ; TODO: Print token details
                Console.println("  <token>")
                p.lexer.advance$()
            }
            return 0
        }

        ; Parse the program
        var syntax: parser.ProgramSyntax
        choose p.parse_program#()
            when err: Error
            {
                Console.println("Parse error")
                return 2
            }
            when program: Success
            {
                set syntax: program
            }

        guard opts.verbose
            Console.println("Parsing completed successfully")

        guard opts.parse_only
        {
            Console.println("Parse successful")
            return 0
        }

        ; ================================================================
        ; Stage 2: Build semantic model
        ; ================================================================

        ; Extract program name from filename (strip path and extension)
        var program_name cli.extract_program_name#(opts.input_file)

        let model Modeler.build_program#(opts.input_file, program_name, syntax, opts.no_prelude = false)

        guard opts.verbose
            Console.println("Model built successfully")

        guard opts.model_only
        {
            Console.println("Model built successfully")
            return 0
        }

        ; ================================================================
        ; Stage 3: Plan (type resolution, name mangling)
        ; ================================================================

        var planner Planner.Planner$(opts.input_file)
        cli.register_packages(&planner, &model)
        let plan planner.plan_program(model)

        guard plan = null
        {
            Console.println("Planner error")
            return 4
        }

        guard opts.verbose
            Console.println("Planning completed successfully")

        guard opts.plan_only
        {
            Console.println("Planning completed successfully")
            return 0
        }

        ; ================================================================
        ; Stage 4: Emit (LLVM IR generation)
        ; ================================================================

        var config EmitterConfig$()
        set config.emit_debug_info: false

        var emitter Emitter.Emitter$(config)
        let emit_result emitter.emit(plan, program_name)

        guard emit_result = false
        {
            Console.println("Emitter error")
            return 5
        }

        guard opts.verbose
            Console.println("Code generation completed successfully")

        guard opts.emit_ir
        {
            guard opts.output_file.get_length() = 0
            {
                Console.println("Error: -S requires -o <file>")
                return 6
            }
            let ir_ok emitter.write_module_to_file(opts.output_file)
            guard ir_ok = false
            {
                Console.println("Error: Could not write IR file")
                return 6
            }
            return 0
        }

        ; -c: compile only (write object file, no link). Mirrors stage-0
        ; main.cpp's CompileOnly branch.
        guard opts.compile_only
        {
            guard opts.output_file.get_length() = 0
            {
                Console.println("Error: -c requires -o <file>")
                return 6
            }
            let obj_ok emitter.write_object_to_file(opts.output_file)
            guard obj_ok = false
            {
                Console.println("Error: Could not write object file")
                return 8
            }
            return 0
        }

        guard opts.output_file.get_length() = 0
        {
            Console.println("Error: -o <file> required for linking")
            return 7
        }

        ; Emit object file to fixed temp path, link with clang, then unlink temp.
        var tmp_obj String#("/tmp/scalyc_out.o")
        let obj_ok emitter.write_object_to_file(tmp_obj)
        guard obj_ok = false
        {
            Console.println("Error: Could not write object file")
            return 8
        }

        var cmd_builder StringBuilder#()
        cmd_builder.append("clang ")
        cmd_builder.append(tmp_obj)
        ; Append the scaly stdlib static archive. Provides runtime
        ; functions (scaly_alloc_root_page etc.) that stage-1 emits
        ; as declarations only because it can't fully plan
        ; root_pages.scaly. Must be built with --no-prelude:
        ;     scalyc -c --no-prelude -o /tmp/libscaly.o packages/scaly/0.1.0/scaly.scaly
        ;     ar rcs /tmp/libscaly.a /tmp/libscaly.o
        ; Without --no-prelude, libscaly.o also carries print/println
        ; (which the prelude defines as wrappers around puts), and
        ; user .o's also emit those — `ld` then fails with duplicate
        ; symbols on every AOT test that pulls libscaly.o in for
        ; the runtime (s111).
        cmd_builder.append(" /tmp/libscaly.a")

        ; Forward extra positional .a / .o inputs from the user
        ; (e.g. /tmp/libscalyc.a for stage-1 self-build). Required
        ; before -l flags so static-archive resolution sees the
        ; archives' references first.
        var ei: size_t 0
        while ei < opts.extra_objects.length
        {
            let e_ptr opts.extra_objects.get(ei)
            guard e_ptr <> null
            {
                cmd_builder.append(" ")
                cmd_builder.append((*e_ptr))
            }
            set ei: ei + 1
        }

        ; Forward -L<path> entries.
        var li: size_t 0
        while li < opts.library_paths.length
        {
            let l_ptr opts.library_paths.get(li)
            guard l_ptr <> null
            {
                cmd_builder.append(" -L")
                cmd_builder.append((*l_ptr))
            }
            set li: li + 1
        }

        ; Forward -l<name> entries.
        var bi: size_t 0
        while bi < opts.libraries.length
        {
            let b_ptr opts.libraries.get(bi)
            guard b_ptr <> null
            {
                cmd_builder.append(" -l")
                cmd_builder.append((*b_ptr))
            }
            set bi: bi + 1
        }

        cmd_builder.append(" -o ")
        cmd_builder.append(opts.output_file)
        let cmd_str cmd_builder.to_string#()
        let link_rc system(cmd_str.c_data())

        let unlink_rc unlink(tmp_obj.c_data())

        guard link_rc <> 0
        {
            Console.println("Error: Linker failed")
            return 9
        }

        0
    }

    ; Extract program name from file path
    ; e.g., "/path/to/hello.scaly" -> "hello"
    ; Pre-register packages from the model into the planner's cache so
    ; load_package_on_demand# can resolve them. Mirrors stage-0's resolved-
    ; package wiring. We hand off Module by reference; the helper exists in
    ; procedure form so each `register` call is at function-statement
    ; granularity (avoids the same in-place Vector[Module].add codegen
    ; pitfall worked around in Modeler.scaly).
    procedure register_packages(planner: ref[Planner.Planner], model: ref[Program])
    {
        var i: size_t 0
        while i < model.packages.length
        {
            let pkg_ptr model.packages.get(i)
            guard pkg_ptr <> null
            {
                planner.register_loaded_package(pkg_ptr.name, *pkg_ptr)
                planner.register_module_concepts(*pkg_ptr)
            }
            set i: i + 1
        }
    }

    function extract_program_name#(file_path: String) returns String
    {
        ; Find last '/' or '\'
        var start 0
        var i 0
        while i < file_path.get_length() as int
        {
            let c file_path.get(i as size_t)
            guard c = "/" as char
                set start: i + 1

            guard c = "\\" as char
                set start: i + 1

            set i: i + 1
        }

        ; Find last '.'
        var end file_path.get_length() as int
        set i: end - 1
        while i >= start
        {
            let c file_path.get(i as size_t)
            guard c = "." as char
            {
                set end: i
                ; break - just use assignment for now
                set i: -1
            }
            set i: i - 1
        }

        ; Extract substring
        guard end <= start
            return file_path

        file_path.substring(rp, start as size_t, (end - start) as size_t)
    }

    ; Main entry point
    function main(argc: int, argv: pointer[pointer[char]]) returns int
    {
        var opts cli.parse_args#(argc, argv)
        return cli.run#(opts)
    }

    ; Test function
    function test() returns int
    {
        ; Test 1: Check Options initialization
        var opts Options$()
        guard opts.has_input()
            return -1

        guard opts.has_error()
            return -2

        guard opts.verbose
            return -3

        guard opts.show_help
            return -4

        ; Test 2: Test extract_program_name
        var path1 String$("/path/to/hello.scaly")
        var name1 cli.extract_program_name#(path1)
        guard name1.equals(String$("hello")) = false
            return -10

        var path2 String$("simple.scaly")
        var name2 cli.extract_program_name#(path2)
        guard name2.equals(String$("simple")) = false
            return -11

        ; Test 3: Test pipeline on a minimal program
        var result cli.test_pipeline#()
        guard result <> 0
            return result - 100

        ; Test 4: Test pipeline on hello.scaly from disk
        set result: cli.test_hello_scaly#()
        guard result <> 0
            return result - 200

        ; All tests passed
        0
    }

    ; Test compiling hello.scaly from disk
    function test_hello_scaly#() returns int
    {
        ; Path to hello.scaly (relative to scalyc/build where tests run)
        var file_path String$("../../hello.scaly")

        ; Read the file
        var source File.read_to_string$(file_path)
        guard source.get_length() = 0
            return -1  ; Could not read file

        ; Stage 1: Parse
        var p parser.Parser$(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program#()
            when err: Error
            {
                return -2  ; Parse failed
            }
            when program: Success
            {
                set syntax: program
            }

        ; Stage 2: Build model
        var program_name String$("hello")
        let model Modeler.build_program#(file_path, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner$(file_path)
        let plan planner.plan_program(model)
        guard plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit
        var config EmitterConfig$()
        set config.emit_debug_info: false
        var emitter Emitter.Emitter$(config)
        let emit_result emitter.emit(plan, program_name)
        guard emit_result = false
            return -4  ; Emission failed

        ; Successfully compiled hello.scaly!
        0
    }

    ; Test the compilation pipeline on a minimal program
    function test_pipeline#() returns int
    {
        ; Minimal valid Scaly program
        var source String$("function test_func() returns int { 42 }")

        ; Stage 1: Parse
        var p parser.Parser$(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program#()
            when err: Error
            {
                return -1  ; Parse failed
            }
            when program: Success
            {
                set syntax: program
            }

        ; Stage 2: Build model
        var file_name String$("test.scaly")
        var program_name String$("test")
        let model Modeler.build_program#(file_name, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner$(file_name)
        let plan planner.plan_program(model)
        guard plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit (just verify it doesn't crash)
        var config EmitterConfig$()
        set config.emit_debug_info: false
        var emitter Emitter.Emitter$(config)
        let emit_result emitter.emit(plan, program_name)
        guard emit_result = false
            return -4  ; Emission failed

        ; All pipeline stages passed
        0
    }
}
