        head.append(cli.format_size(pc.n_return))
        head.append ", field "
        head.append(cli.format_size(pc.n_field))
        head.append ", variant "
        head.append(cli.format_size(pc.n_variant))
        head.append ", local "
        head.append(cli.format_size(pc.n_local))
        head.append ", deref "
        head.append(cli.format_size(pc.n_deref))
        head.append ", deref-arith "
        head.append(cli.format_size(pc.n_deref_arith))
        head.append ", arith "
        head.append(cli.format_size(pc.n_arith))
        head.append ", cast "
        head.append(cli.format_size(pc.n_cast))
        head.append ", null-cast "
        head.append(cli.format_size(pc.n_null_cast))
        head.append ", null-test "
        head.append(cli.format_size(pc.n_null_test))
        head.append ", store "
        head.append(cli.format_size(pc.n_store))
        head.append ", arg "
        head.append(cli.format_size(pc.n_arg))
        head.append ", arg-extern "
        head.append(cli.format_size(pc.n_arg_extern))
        head.append ", arg-unresolved "
        head.append(cli.format_size(pc.n_arg_unresolved))
        head.append ", h-pointer-into-ref "
        head.append(cli.format_size(pc.n_h_ptr_ref))
        head.append ", h-slice-into-pointer "
        head.append(cli.format_size(pc.n_h_slice_ptr))
        head.append ", h-mixed-params "
        head.append(cli.format_size(pc.n_h_mixed))
        head.append ", h-store-through-ref-slot "
        head.append(cli.format_size(pc.n_h_store_slot))
        head.append "; optional-ref derefs (not listed) "
        head.append(cli.format_size(pc.n_optref_deref))
        head.append ", bodies unfiled "
        head.append(cli.format_size(pc.n_unfiled))
        head.append ", alias handles (not listed) "
        head.append(cli.format_size(pc.n_handle))
        head.append ", stack arrays (not listed) "
        head.append(cli.format_size(pc.n_stack_array))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("pointer-report: ", &pc.report_files, &pc.report_offsets, &pc.report_texts)
    }

    procedure print_write_report(wc: ref[WriteCensus.WriteCensus])
    {
        var head StringBuilder()
        head.append "write-report: "
        head.append(cli.format_size(wc.total()))
        head.append " lines; bodies "
        head.append(cli.format_size(wc.n_bodies))
        head.append ", functions "
        head.append(cli.format_size(wc.n_pure))
        head.append " (writing "
        head.append(cli.format_size(wc.n_pure_writing))
        head.append ", direct "
        head.append(cli.format_size(wc.n_pure_direct))
        head.append "), procedures "
        head.append(cli.format_size(wc.n_proc))
        head.append " (writing "
        head.append(cli.format_size(wc.n_proc_writing))
        head.append "); sites "
        head.append(cli.format_size(wc.n_sites))
        head.append ", unfiled "
        head.append(cli.format_size(wc.n_unfiled))
        head.append ", misaligned calls "
        head.append(cli.format_size(wc.n_misaligned))
        head.append ", other-root calls "
        head.append(cli.format_size(wc.n_stub_known))
        head.append " (unknown "
        head.append(cli.format_size(wc.n_stub_unknown))
        head.append ")"
        head.append ", rounds "
        head.append(cli.format_size(wc.n_rounds))
        head.append ", alias rounds "
        head.append(cli.format_size(wc.n_rp_rounds))
        if wc.frozen_mode
        {
            head.append "; FROZEN: reachable "
            head.append(cli.format_size(wc.n_reachable))
            head.append ", sites "
            head.append(cli.format_size(wc.n_frozen_sites))
            head.append " (locked "
            head.append(cli.format_size(wc.n_locked_sites))
            head.append "), provenance rounds "
            head.append(cli.format_size(wc.n_fz_rounds))
        }
        ; R2: stores into a `let` field of a published object (measurement)
        head.append "; LET: sites "
        head.append(cli.format_size(wc.n_let_sites))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("write-report: ", &wc.report_files, &wc.report_offsets, &wc.report_texts)
    }

    procedure print_purity_check(wc: ref[WriteCensus.WriteCensus])
    {
        var head StringBuilder()
        head.append "purity-check: "
        head.append(cli.format_size(wc.n_violations))
        head.append " of "
        head.append(cli.format_size(wc.n_pure))
        head.append " functions write what their parameters reach; sites "
        head.append(cli.format_size(wc.n_sites))
        head.append ", callees of unknown keyword "
        head.append(cli.format_size(wc.n_stub_unknown))
        head.append ", unfiled "
        head.append(cli.format_size(wc.n_unfiled))
        let head_str head.to_string()
        Console.println(head_str.to_c_string())
        cli.print_located("purity-check: ", &wc.report_files, &wc.report_offsets, &wc.report_texts)
    }

    ; Shared located-report printer: one `<prefix><file>:<line>:<col>: <text>`
    ; line per slot of three parallel arrays. The byte offset is relative to
    ; the slot's own source file, so re-read the file when it changes
    ; (entries arrive grouped by file, one read per file).
    procedure print_located(
        prefix: String,
        files: ref[Array[String]],
        offsets: ref[Array[size_t]],
        texts: ref[Array[String]]
    )
    {
        var cur_path String("")
        var cur_src String("")
        var have_src false
        var i: size_t 0
        while i < files.length
        {
            let fp files.get i
            let op_ offsets.get i
            let vp texts.get i
            if fp <> null
            {
                var need_read false
                if have_src = false
                    need_read := true
                if cur_path <> (*fp)
                    need_read := true
                if need_read
                {
                    cur_path := String((*fp))
                    cur_src := File.read_to_string((*fp))
                    have_src := true
                }
                var line: size_t 1
                var col: size_t 1
                let src_len cur_src.get_length()
                var target: size_t 0
                if op_ <> null
                    target := (*op_)
                if target > src_len
                    target := src_len
                var off: size_t 0
                while off < target
                {
                    ; Numeric LF compare (see print_diagnostics).
                    let c cur_src.get off
                    if c = ("\n" as char)
                    {
                        line := line + 1
                        col := 1
                    }
                    else
                    {
                        col := col + 1
                    }
                    off := off + 1
                }
                var msg StringBuilder()
                msg.append prefix
                msg.append((*fp))
                msg.append ":"
                msg.append(cli.format_size(line))
                msg.append ":"
                msg.append(cli.format_size(col))
                msg.append ": "
                if vp <> null
                    msg.append((*vp))
                let msg_str msg.to_string()
                Console.println(msg_str.to_c_string())
            }
            i := i + 1
        }
    }

    ; --emit-interface: the package's interface (compiler/Interface.scaly),
    ; written to <root dir>/interface or to the directory -o names.
    procedure emit_interface(root: String, output: String, mutable planner: ref[Planner.Planner], model: ref[Program], purity_gate: ref[WriteCensus.WriteCensus]) returns int
    {
        var facts Array[InterfaceFact]()
        planner.interface_facts(model.module_, &facts)
        purity_gate.interface_facts(&facts)
        var root_path root
        let pkg_dir Path.get_directory_name(root_path)
        var out_dir output
        if out_dir.get_length() = 0
            out_dir := "`pkg_dir`/interface"
        let writer Interface(pkg_dir, out_dir)
        let n writer.write(root, &facts)
        if n < 0
            return 1
        Console.println "interface: `n` files -> `out_dir`"
        0
    }

    ; Decimal formatting for diagnostics. Local mirror of
    ; Planner.size_to_string to avoid cross-namespace call resolution
    ; risk under stage-1.
    function format_size(n: size_t) returns String
    {
        if n = 0
            return "0"
        var value n
        var digits Array[char]()
        while value > 0
        {
            let digit ((value % 10) as char) + ("0" as char)
            digits.add digit
            value := value / 10
        }
        var sb StringBuilder()
        var i digits.length
        while i > 0
        {
            i := i - 1
            let d digits.get i
            if d <> null
                sb.append(*d)
        }
        sb.to_string()
    }

    function extract_program_name(file_path: String) returns String
    {
        ; Find last '/' or '\'
        var start 0
        var i 0
        while i < file_path.get_length() as int
        {
            let c file_path.get(i as size_t)
            if c = "/"
                start := i + 1

            if c = "\\"
                start := i + 1

            i := i + 1
        }

        ; Find last '.'
        var end file_path.get_length() as int
        i := end - 1
        while i >= start
        {
            let c file_path.get(i as size_t)
            if c = "."
            {
                end := i
                ; break - just use assignment for now
                i := -1
            }
            i := i - 1
        }

        ; Extract substring
        if end <= start
            return file_path

        file_path.substring(start as size_t, (end - start) as size_t)
    }

    ; Entry point of scalyc, the compiler: a command line like a C
    ; compiler's (-o, -c, -S, -O2, -L, -l) and nothing else. The REPL and the
    ; commands run, build and test belong to `scaly` (tool_main#).
    ; ★A handed-out program finds its packages BESIDE ITSELF (2026-10-03):
    ; with SCALY_HOME unset, the program `<home>/libexec/<name>` whose <home>
    ; holds `packages/scaly` takes that <home> -- it SETS the variable for
    ; this process, so every reader (the Modeler's package base, the runtime
    ; archive, the language server's, a child process) stays as it is. A
    ; program of the source tree (scalyc/build, /tmp/scalyc_stage2) has no
    ; such neighbour and resolves from the current directory as always; a
    ; SCALY_HOME that is set wins, as always. Why: on Windows there is no
    ; wrapper script to set it, and a user-wide variable would reach a
    ; developer's checkout too. Where the program is: scaly_eio_self_path.
    ; macOS and Linux answer since 2026-10-03 and have no wrapper script any
    ; more: the installer's bin/ holds links to the programs, and the link is
    ; resolved before the two names are cut off.
    ; true when a home was adopted.
    procedure adopt_home() returns bool
    {
        let given getenv "SCALY_HOME"
        if given <> null
        {
            let g String(given)
            if g.get_length() > 0
                return false
        }
        var buffer char[1024]
        let n scaly_eio_self_path(&buffer[0] as pointer[char], 1024)
        if n <= 0
            return false
        let path String(&buffer[0] as pointer[const_char])
        ; two names up: <home>/libexec/<program>
        var end path.get_length()
        var cut: int 0
        while end > 0 and cut < 2
        {
            end := end - 1
            let c path.get(end)
            if c = 92 or c = 47
                cut := cut + 1
        }
        if cut < 2
            return false
        let home path.substring(0, end)
        var probe "`home`/packages/scaly"
        if Directory.is_directory(probe) = false
            return false
        if setenv("SCALY_HOME", home.to_c_string(), 1) <> 0
            return false
        let named adopt_compiler(home)
        true
    }

    ; The C compiler of an adopted home: `<home>/CC`, one line, written by the
    ; installer where the compiler it found is not plain `clang` (clang-21 on
    ; a box without `clang`, cc, gcc) -- what the wrapper script exported
    ; until 2026-10-03. It becomes SCALY_CC for this process unless that is
    ; set, so link_compiler and the tool read it as they always did.
    ; true when a compiler was adopted.
    procedure adopt_compiler(home: String) returns bool
    {
        let given getenv "SCALY_CC"
        if given <> null
            return false
        let named "`home`/CC"
        if File.exists(named) = false
            return false
        let text File.read_to_string(named)
        var n text.get_length()
        while n > 0 and text.get(n - 1) <= 32
            n := n - 1
        if n = 0
            return false
        let cc text.substring(0, n)
        setenv("SCALY_CC", cc.to_c_string(), 0) = 0
    }

    procedure main(argc: int, mutable argv: pointer[pointer[char]]) returns int mutable modeler_error_count
    {
        let adopted adopt_home()
        if argc = 1
        {
            print_usage()
            return 1
        }
        var opts cli.parse_args(argc, argv)
        return cli.run(opts)
    }

    ; Entry point of `scaly`, the tool: alone it is the
    ; REPL, `scaly run file args`, `scaly build file [options]`, `scaly test
    ; file [filter]`. Anything else is answered with the usage -- a bare file
    ; or a flag is scalyc's command line, not this one's.
    procedure tool_main(argc: int, mutable argv: pointer[pointer[char]]) returns int mutable modeler_error_count
    {
        let adopted adopt_home()
        if argc = 1
            return repl.main()
        let command String(*(argv + 1))
        if command.equals("run")
        {
            if argc < 3
            {
                Console.println "Usage: scaly run <file> [arguments]"
                return 1
            }
            var run_seen Array[String]()
            if tool.fetch_declared(String(*(argv + 2)), &run_seen) = false
                return 1
            var run_opts Options()
            run_opts.input_file := String(*(argv + 2))
            run_opts.jit_program := true
            ; the program's argv[0] is its file, as a shell would give it
            run_opts.program_argc := argc - 2
            run_opts.program_argv := argv + 2
            return cli.run(run_opts)
        }
        if command.equals("test")
        {
            if argc < 3
            {
                Console.println "Usage: scaly test <file> [filter]"
                return 1
            }
            var test_seen Array[String]()
            if tool.fetch_declared(String(*(argv + 2)), &test_seen) = false
                return 1
            var test_opts Options()
            test_opts.input_file := String(*(argv + 2))
            test_opts.test_mode := true
            if argc > 3
                test_opts.test_filter := String(*(argv + 3))
            return cli.run(test_opts)
        }
        if command.equals("build")
        {
            var build_opts cli.parse_args(argc - 1, argv + 1)
            build_opts.tool_build := true
            var build_seen Array[String]()
            if build_opts.has_input() and tool.fetch_declared(String(build_opts.input_file), &build_seen) = false
                return 1
            if build_opts.output_file.get_length() = 0 and build_opts.has_input()
                build_opts.output_file := cli.extract_program_name(build_opts.input_file)
            return cli.run(build_opts)
        }
        if command.equals("new")
        {
            ; scaly new <name> [--lib], the flag before or after the name
            var new_name ""
            var new_lib false
            var na 2
            while na < argc
            {
                let arg String(*(argv + na))
                if arg.equals("--lib")
                    new_lib := true
                else if new_name.get_length() = 0
                    new_name := arg
                else
                    new_name := "-"
                na := na + 1
            }
            if new_name.get_length() = 0 or new_name.equals("-")
            {
                Console.println "Usage: scaly new <name> [--lib]"
                return 1
            }
            return tool.new_project(new_name, new_lib)
        }
        if command.equals("-h") or command.equals("--help") or command.equals("help")
        {
            print_tool_usage()
            return 0
        }
        Console.println("scaly: unknown command `command`")
        print_tool_usage()
        return 1
    }

    ; Test function
    procedure test() returns int mutable modeler_error_count
    {
        ; Test 1: Check Options initialization
        var opts Options()
        if opts.has_input()
            return -1

        if opts.has_error()
            return -2

        if opts.verbose
            return -3

        if opts.show_help
            return -4

        ; Test 2: Test extract_program_name
        var path1 "/path/to/hello.scaly"
        var name1 cli.extract_program_name(path1)
        if name1 <> "hello"
            return -10

        var path2 "simple.scaly"
        var name2 cli.extract_program_name(path2)
        if name2 <> "simple"
            return -11

        ; Test 3: Test pipeline on a minimal program
        var result cli.test_pipeline()
        if result <> 0
            return result - 100

        ; Test 4: Test pipeline on hello.scaly from disk
        result := cli.test_hello_scaly()
        if result <> 0
            return result - 200

        ; All tests passed
        0
    }

    ; Test compiling hello.scaly from disk
    procedure test_hello_scaly() returns int mutable modeler_error_count
    {
        ; Path to hello.scaly (relative to scalyc/build where tests run)
        var file_path "../../hello.scaly"

        ; Read the file
        var source File.read_to_string(file_path)
        if source.get_length() = 0
            return -1  ; Could not read file

        ; Stage 1: Parse
        var p parser.Parser(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                return -2  ; Parse failed
            }
            when program: Success
            {
                syntax := program
            }

        ; Stage 2: Build model
        var program_name "hello"
        let model Modeler.build_program(file_path, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner(file_path)
        let plan planner.plan_program model
        if plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit
        var config EmitterConfig()
        config.emit_debug_info := false
        var emitter Emitter.Emitter(config)
        let emit_result emitter.emit(plan, program_name)
        if emit_result = false
            return -4  ; Emission failed

        ; Successfully compiled hello.scaly!
        0
    }

    ; Test the compilation pipeline on a minimal program
    procedure test_pipeline() returns int mutable modeler_error_count
    {
        ; Minimal valid Scaly program
        var source "function test_func() returns int { 42 }"

        ; Stage 1: Parse
        var p parser.Parser(source)
        var syntax: parser.ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                return -1  ; Parse failed
            }
            when program: Success
            {
                syntax := program
            }

        ; Stage 2: Build model
        var file_name "test.scaly"
        var program_name "test"
        let model Modeler.build_program(file_name, program_name, syntax, true)

        ; Stage 3: Plan
        var planner Planner.Planner(file_name)
        let plan planner.plan_program model
        if plan = null
            return -3  ; Planning failed

        ; Stage 4: Emit (just verify it doesn't crash)
        var config EmitterConfig()
        config.emit_debug_info := false
        var emitter Emitter.Emitter(config)
        let emit_result emitter.emit(plan, program_name)
        if emit_result = false
            return -4  ; Emission failed

        ; All pipeline stages passed
        0
    }
}
