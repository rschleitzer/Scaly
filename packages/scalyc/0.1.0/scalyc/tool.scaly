; tool.scaly - the build side of the one tool (ROADMAP-public.md, stage A)
;
; `scaly build` links a program against OBJECTS of the packages it uses, each
; compiled once into a cache and found again by a key over everything that
; went into it: the compiling compiler (scaly_package_stamp, which the Emitter
; defines for this library from its own IR), the target, the flavour, and every
; file of the package. A package's C and assembly files are compiled by the
; tool as well; which of them a target takes is said by their names
; (native_name#). Nothing is written into the project, and no script is run.
;
; `scaly build --release` (stage C) takes a package as unoptimised BITCODE out
; of the same cache instead: the program's module links it in, dependents
; first, and the whole program is optimised and emitted as one module
; (Emitter.link_bitcode#, the release branch of write_object_to_file#) -- what
; tools/link-lto.sh did with llvm-link, sed, opt and llc.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.File
use scaly.os.Console
use scaly.os.Directory
use scaly.os.Directory.DirectoryEntry
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use scalyc.cli
use scalyc.cli.Options
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

; the compiler's own identity: the Emitter sets it to the hash of this
; package's IR when it compiles the compiler (emit_package_stamp#); a compiler
; that does not know the rule leaves it 0, which keys a cache of its own
shared scaly_package_stamp: u64 0
function getpid() returns i32 extern
function system(command: pointer[const_char]) returns i32 extern
function rename(old_path: pointer[const_char], new_path: pointer[const_char]) returns i32 extern
function LLVMGetDefaultTargetTriple() returns pointer[char] extern
procedure LLVMDisposeMessage(message: pointer[char]) extern

; a native file's name, read: `fcontext_x86_64_windows` is `fcontext` for
; x86_64 on Windows (tool.native_name#)
define NativeName
(
    base: String
    os: String
    arch: String
)

define tool
{
    ; where compiled packages are kept: $SCALY_CACHE, else ~/.scaly/cache
    ; (%USERPROFILE% where there is no HOME)
    procedure cache_root() returns String
    {
        let own getenv "SCALY_CACHE"
        if own <> null
        {
            let s String(own)
            if s.get_length() > 0
                return String(own)
        }
        var home getenv "HOME"
        if home = null
            set home: getenv("USERPROFILE")
        if home = null
            return String(".scaly-cache")
        let h String(home)
        "`h`/.scaly/cache"
    }

    ; create a directory and every missing one above it; true when it exists
    procedure ensure_directory(mutable path: String) returns bool
    {
        if Directory.is_directory(path)
            return true
        var i: size_t 1
        while i < path.get_length()
        {
            let c path.get i
            if c = 47 or c = 92
            {
                var prefix path.substring(0, i)
                if Directory.is_directory(prefix) = false
                    Directory.create(prefix)
            }
            set i: i + 1
        }
        Directory.create(path)
        Directory.is_directory(path)
    }

    ; every file of a package, relative to its directory: the tree without
    ; `interface/` (generated from the sources) and without a name that
    ; starts with `_` or `.` -- no module can be named so, and tscaly's
    ; `_submodules` holds another project's tree
    procedure package_files(mutable dir: String, prefix: String, mutable files: ref[Array[String]])
    {
        let entries Directory.list(dir)
        var i: size_t 0
        while i < entries.length
        {
            let e entries.at i
            set i: i + 1
            let c e.name.get(0)
            if c = 95 or c = 46
                continue
            if e.is_directory
            {
                if prefix.get_length() = 0 and e.name.equals("interface")
                    continue
                tool.package_files("`dir`/`e.name`", "`prefix``e.name`/", files)
            }
            else
                files.add("`prefix``e.name`")
        }
    }

    function fnv_string(h: u64, s: String) returns u64
    {
        var r h
        let n s.get_length()
        var i: size_t 0
        while i < n
        {
            set r: (r xor (s.get(i) as u64)) * 0x100000001b3
            set i: i + 1
        }
        r
    }

    ; the cache key of a package: the compiling compiler, the target, the
    ; flavour, and every file with its path -- summed, so the order the file
    ; system lists them in does not matter
    procedure package_key(mutable dir: String, files: ref[Array[String]], triple: String, flavour: String) returns u64
    {
        var h: u64 0xcbf29ce484222325
        set h: (h xor scaly_package_stamp) * 0x100000001b3
        set h: tool.fnv_string(h, triple)
        set h: tool.fnv_string(h, flavour)
        var sum: u64 0
        var i: size_t 0
        while i < files.length
        {
            let f files.at i
            let content File.read_to_string("`dir`/`f`")
            var fh tool.fnv_string(0xcbf29ce484222325, f)
            set fh: tool.fnv_string(fh * 0x100000001b3, content)
            set sum: sum + fh
            set i: i + 1
        }
        (h xor sum) * 0x100000001b3
    }

    function hex16(k: u64) returns String
    {
        var sb StringBuilder()
        var i: u64 0
        while i < 16
        {
            let d (k >> ((15 - i) * 4)) & 15
            if d < 10
                sb.append((48 + d) as char)
            else
                sb.append((87 + d) as char)
            set i: i + 1
        }
        sb.to_string()
    }

    ; a native file's stem read as base name and target tags: `_windows`,
    ; `_linux`, `_darwin` name the system, `_arm64` (`_aarch64`) and `_x86_64`
    ; the architecture, stripped from the end in any order
    function native_name(stem: String) returns NativeName
    {
        var base stem
        var os String()
        var arch String()
        var again true
        while again
        {
            set again: false
            let n base.get_length()
            if os.get_length() = 0 and base.ends_with("_windows")
            {
                set os: String("windows")
                set base: base.substring(0, n - 8)
                set again: true
            }
            else if os.get_length() = 0 and base.ends_with("_linux")
            {
                set os: String("linux")
                set base: base.substring(0, n - 6)
                set again: true
            }
            else if os.get_length() = 0 and base.ends_with("_darwin")
            {
                set os: String("darwin")
                set base: base.substring(0, n - 7)
                set again: true
            }
            else if arch.get_length() = 0 and base.ends_with("_x86_64")
            {
                set arch: String("x86_64")
                set base: base.substring(0, n - 7)
                set again: true
            }
            else if arch.get_length() = 0 and base.ends_with("_arm64")
            {
                set arch: String("arm64")
                set base: base.substring(0, n - 6)
                set again: true
            }
            else if arch.get_length() = 0 and base.ends_with("_aarch64")
            {
                set arch: String("arm64")
                set base: base.substring(0, n - 8)
                set again: true
            }
        }
        NativeName(base, os, arch)
    }

    function triple_arch(triple: String) returns String
    {
        if triple.starts_with("arm64") or triple.starts_with("aarch64")
            return String("arm64")
        if triple.starts_with("x86_64") or triple.starts_with("amd64")
            return String("x86_64")
        String("other")
    }

    function triple_os(triple: String) returns String
    {
        if triple.contains(String("windows"))
            return String("windows")
        if triple.contains(String("linux"))
            return String("linux")
        if triple.contains(String("darwin")) or triple.contains(String("apple"))
            return String("darwin")
        String("other")
    }

    ; the C and assembly files of a package this target takes: of the files
    ; that share a base name, the most specific one whose tags all match --
    ; eio.c everywhere but on Windows, where eio_windows.c replaces it
    procedure select_native(files: ref[Array[String]], triple: String, mutable chosen: ref[Array[String]])
    {
        let os tool.triple_os(triple)
        let arch tool.triple_arch(triple)
        var bases Array[String]()
        var scores Array[int]()
        var picks Array[String]()
        var i: size_t 0
        while i < files.length
        {
            let f files.at i
            set i: i + 1
            var ext: size_t 0
            if f.ends_with(".c") or f.ends_with(".S") or f.ends_with(".s")
                set ext: 2
            if ext = 0
                continue
            let nn tool.native_name(f.substring(0, f.get_length() - ext))
            if nn.os.get_length() > 0 and nn.os.equals(os) = false
                continue
            if nn.arch.get_length() > 0 and nn.arch.equals(arch) = false
                continue
            var score 0
            if nn.os.get_length() > 0
                set score: score + 1
            if nn.arch.get_length() > 0
                set score: score + 1
            var found false
            var j: size_t 0
            while j < bases.length
            {
                let b bases.at j
                if b.equals(nn.base)
                {
                    set found: true
                    let s scores.at j
                    if score > s
                    {
                        scores.put(j, score)
                        picks.put(j, String(f))
                    }
                }
                set j: j + 1
            }
            if found = false
            {
                bases.add(String(nn.base))
                scores.add(score)
                picks.add(String(f))
            }
        }
        var k: size_t 0
        while k < picks.length
        {
            let p picks.at k
            chosen.add(String(p))
            set k: k + 1
        }
    }

    ; the host's triple, or the one --target named
    procedure target_triple(given: String) returns String
    {
        if given.get_length() > 0
            return String(given)
        let t LLVMGetDefaultTargetTriple()
        let s String(t as pointer[const_char])
        LLVMDisposeMessage t
        String(s)
    }

    ; move a finished file into place: a second build of the same key at the
    ; same time finds either no file or a whole one
    procedure publish(mutable tmp: String, mutable final: String) returns bool
    {
        rename(tmp.to_c_string(), final.to_c_string()) = 0
    }

    ; The objects of every package a program uses, each built into the cache
    ; the first time it is needed: the package's Scaly code as one object at
    ; -O2 (library linkage, cli.run with --no-prelude --no-tests), and the C
    ; and assembly files its target takes. `names` and `roots` pair a
    ; package's name with its root file. False when one of them does not build;
    ; what went wrong is printed where it happened.
    procedure package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, given_triple: String, cpu: String, release: bool, mutable objects: ref[Array[String]], mutable bitcode: ref[Array[String]], mutable link_flags: ref[StringBuilder]) returns bool mutable modeler_error_count
    {
        var include_flags StringBuilder()
        tool.libraries_of(names, roots, program_file, link_flags, &include_flags)
        let includes include_flags.to_string()
        let cache tool.cache_root()
        if tool.ensure_directory(cache) = false
        {
            Console.println("Error: cannot create the build cache `cache`")
            return false
        }
        let triple tool.target_triple(given_triple)
        var i: size_t 0
        while i < roots.length
        {
            let rp roots.at i
            let np names.at i
            set i: i + 1
            let root String(rp)
            let slash root.last_index_of(47)
            if slash < 0
                continue
            let dir root.substring(0, slash as size_t)
            let vslash dir.last_index_of(47)
            var version String("0")
            if vslash >= 0
                set version: dir.substring((vslash + 1) as size_t, dir.get_length() - ((vslash + 1) as size_t))
            var files Array[String]()
            tool.package_files(dir, "", &files)
            ; -mcpu is part of what a package is compiled for: it reaches the
            ; IR (a SIMD operation's target form, every function's attribute)
            let key tool.package_key(dir, &files, triple, "O2`cpu`")
            let base "`cache`/`np`-`version`-`tool.hex16(key)`"
            let obj "`base`.o"
            ; --release: the package as unoptimised bitcode, which the program's
            ; module takes in whole (Emitter.link_bitcode#); its C and assembly
            ; stay objects
            if release
            {
                let bc "`base`.bc"
                if File.exists(bc) = false
                {
                    let btmp "`bc`.`getpid() as int`.tmp"
                    var bo Options()
                    set bo.input_file: String(root)
                    set bo.output_file: String(btmp)
                    set bo.compile_only: true
                    set bo.bitcode: true
                    set bo.no_prelude: true
                    set bo.no_tests: true
                    set bo.target_triple: String(given_triple)
                    set bo.target_cpu: String(cpu)
                    if cli.run(bo) <> 0
                    {
                        Console.println("Error: package `np` did not build")
                        return false
                    }
                    tool.publish(btmp, bc)
                }
                let bc_page Page.get(bitcode)
                bitcode.add(String^bc_page(bc))
                if tool.native_objects(dir, &files, triple, base, given_triple, includes, objects) = false
                    return false
                continue
            }
            if File.exists(obj) = false
            {
                let tmp "`obj`.`getpid() as int`.tmp"
                var o Options()
                set o.input_file: String(root)
                set o.output_file: String(tmp)
                set o.compile_only: true
                set o.no_prelude: true
                set o.no_tests: true
                set o.opt_level: 2
                set o.library: true
                set o.target_triple: String(given_triple)
                set o.target_cpu: String(cpu)
                if cli.run(o) <> 0
                {
                    Console.println("Error: package `np` did not build")
                    return false
                }
                tool.publish(tmp, obj)
            }
            let obj_page Page.get(objects)
            objects.add(String^obj_page(obj))
            if tool.native_objects(dir, &files, triple, base, given_triple, includes, objects) = false
                return false
        }
        true
    }

    ; the C and assembly files of a package this target takes, each compiled
    ; into the cache beside the package's object (`<base>-<path>.o`)
    procedure native_objects(mutable dir: String, files: ref[Array[String]], triple: String, base: String, given_triple: String, includes: String, mutable objects: ref[Array[String]]) returns bool
    {
        var natives Array[String]()
        tool.select_native(&files, triple, &natives)
        ; ★READY-MADE objects (ROADMAP-public.md, Windows the Rust way): what we
        ; hand out carries, per system and architecture, the object of every
        ; native file under `<package>/_native/<os>-<arch>/`, named as the cache
        ; names it without the package's key. Where one is there it is linked
        ; as it is and no C compiler is asked -- on Windows there may be none,
        ; and the assembly is GNU syntax, which no MSVC tool reads. A name
        ; beginning with `_` is no part of a package (above), so the directory
        ; moves no cache key; a source tree has none and compiles as before.
        ; Not for a file compiled against a C library's headers (`includes`):
        ; that object belongs to the library found on THIS machine.
        let ready_dir "`dir`/_native/`tool.triple_os(triple)`-`tool.triple_arch(triple)`"
        var k: size_t 0
        while k < natives.length
        {
            let nf natives.at k
            set k: k + 1
            var flat StringBuilder()
            var fi: size_t 0
            while fi < nf.get_length()
            {
                let fc nf.get fi
                if fc = 47
                    flat.append("-" as char)
                else
                    flat.append(fc as char)
                set fi: fi + 1
            }
            ; the include flags are part of what was compiled: a header
            ; directory that moves names another object
            var tag String()
            if includes.get_length() > 0
                set tag: "-i`tool.hex16(tool.fnv_string(0xcbf29ce484222325, includes))`"
            let nobj "`base`-`flat.to_string()``tag`.o"
            let ready "`ready_dir`/`flat.to_string()`.o"
            if includes.get_length() = 0 and File.exists(ready)
            {
                let ready_page Page.get(objects)
                objects.add(String^ready_page(ready))
                continue
            }
            if File.exists(nobj) = false
            {
                let ntmp "`nobj`.`getpid() as int`.tmp"
                ; cmd.exe strips the first and the last quote of a line that
                ; begins with one and holds more than two, so on a Windows
                ; host the whole line takes a pair of its own. A cross build
                ; names its triple and runs under a POSIX shell, which would
                ; read that pair as an empty argument.
                let cmd_wrap given_triple.get_length() = 0 and triple.contains(String("windows"))
                var cmd StringBuilder()
                if cmd_wrap
                    cmd.append("\"")
                cmd.append("\"")
                cmd.append(cli.link_compiler())
                cmd.append("\" -O2 -c \"")
                cmd.append(dir)
                cmd.append("/")
                cmd.append(nf)
                cmd.append("\" -o \"")
                cmd.append(ntmp)
                cmd.append("\"")
                cmd.append(includes)
                if given_triple.get_length() > 0
                {
                    cmd.append(" --target=")
                    cmd.append(given_triple)
                }
                if cmd_wrap
                    cmd.append("\"")
                let cmd_str cmd.to_string()
                if system(cmd_str.to_c_string()) <> 0
                {
                    Console.println("Error: `dir`/`nf` did not compile")
                    return false
                }
                tool.publish(ntmp, nobj)
            }
            let nobj_page Page.get(objects)
            objects.add(String^nobj_page(nobj))
        }
        true
    }

    ; `scaly run` / `scaly test`: the packages a program uses, other than the
    ; stdlib (the tool's own image carries it), as objects the JIT adds, with
    ; the mangled names each defines (so the JIT's stubs leave them alone). The
    ; objects are built once into the cache, flavour "jit" (thread-locals
    ; cleared, cli.compile_dep_package_to_object), the names beside them in
    ; `<base>.jit.syms`. Before 2026-09-30 every run compiled them anew into
    ; one fixed /tmp path, which two runs at once overwrote.
    procedure jit_package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable objects: ref[Array[String]], mutable symbols: ref[Array[String]]) returns bool mutable modeler_error_count
    {
        ; the C libraries go into this process, where the JIT looks symbols up
        var link_flags StringBuilder()
        var include_flags StringBuilder()
        let libs tool.libraries_of(names, roots, program_file, &link_flags, &include_flags)
        tool.load_libraries(&libs)
        let includes include_flags.to_string()
        let cache tool.cache_root()
        if tool.ensure_directory(cache) = false
        {
            Console.println("Error: cannot create the build cache `cache`")
            return false
        }
        let triple tool.target_triple(String())
        var i: size_t 0
        while i < roots.length
        {
            let rp roots.at i
            let np names.at i
            set i: i + 1
            let root String(rp)
            let slash root.last_index_of(47)
            if slash < 0
                continue
            let dir root.substring(0, slash as size_t)
            let vslash dir.last_index_of(47)
            var version String("0")
            if vslash >= 0
                set version: dir.substring((vslash + 1) as size_t, dir.get_length() - ((vslash + 1) as size_t))
            var files Array[String]()
            tool.package_files(dir, "", &files)
            let key tool.package_key(dir, &files, triple, "jit")
            let base "`cache`/`np`-`version`-`tool.hex16(key)`"
            let obj "`base`.jit.o"
            let syms "`base`.jit.syms"
            if File.exists(obj) = false
            {
                let tmp "`obj`.`getpid() as int`.tmp"
                let stmp "`syms`.`getpid() as int`.tmp"
                var built Array[String]()
                if cli.compile_dep_package_to_object(root, tmp, &built) = false
                {
                    Console.println("Error: package `np` did not build")
                    return false
                }
                var text StringBuilder()
                var bi: size_t 0
                while bi < built.length
                {
                    let b built.at bi
                    text.append(b)
                    text.append("\n" as char)
                    set bi: bi + 1
                }
                File.write_from_string(stmp, text.to_string())
                tool.publish(stmp, syms)
                tool.publish(tmp, obj)
            }
            let list File.read_to_string(syms)
            var from: size_t 0
            var at: size_t 0
            let n list.get_length()
            while at < n
            {
                if list.get(at) = 10
                {
                    if at > from
                    {
                        let sym_page Page.get(symbols)
                        symbols.add(String^sym_page(list.substring(from, at - from)))
                    }
                    set from: at + 1
                }
                set at: at + 1
            }
            let obj_page Page.get(objects)
            objects.add(String^obj_page(obj))
            if tool.native_objects(dir, &files, triple, base, String(), includes, objects) = false
                return false
        }
        true
    }

    ; ---- C libraries (ROADMAP-public.md, stage B) ---------------------------
    ;
    ; A package says which C libraries it uses in its root file:
    ;     extern ssl, crypto
    ; and the tool finds them: in $SCALY_LIBRARY_PATH (directories, `:`-
    ; separated, `;` on Windows), then where Homebrew puts them (every
    ; `opt/<formula>/lib` -- the highest formula name when several have it:
    ; openssl@3 before openssl@1.1 -- then its shared `lib`), else nowhere, and the linker's own
    ; search path answers (a Linux distribution's /usr/lib/<triple>). A library
    ; found in a directory adds `-L<dir>`, and `<dir>/../include` the `-I` the
    ; package's C files are compiled with.

    procedure add_library(mutable libs: ref[Array[String]], name: String)
    {
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            if l.equals(name)
                return
            set i: i + 1
        }
        let page Page.get(libs)
        libs.add(String^page(name))
    }

    ; the C libraries a source file declares, in the order it names them
    procedure declared_libraries(mutable file: String, mutable libs: ref[Array[String]])
    {
        if File.exists(file) = false
            return
        var contents File.read_to_string(file)
        if contents.get_length() = 0
            return
        var p Parser(contents)
        choose p.parse_program()
            when err: Error
                return
            when syntax: Success
            {
                if syntax.file.declarations = null
                    return
                let decls (*syntax.file.declarations)
                var i: size_t 0
                while i < decls.length
                {
                    let dp decls.get i
                    set i: i + 1
                    if dp = null
                        continue
                    choose (*dp)
                        when lib: LibrariesSyntax
                        {
                            tool.add_library(libs, lib.name)
                            if lib.more <> null
                            {
                                let more (*lib.more)
                                var k: size_t 0
                                while k < more.length
                                {
                                    let mp more.get k
                                    if mp <> null
                                        tool.add_library(libs, mp.name)
                                    set k: k + 1
                                }
                            }
                        }
                        else
                        {
                            ; not a library declaration
                        }
                }
            }
    }

    ; does `dir` hold the library `name` in a form the linker takes
    procedure dir_has_library(dir: String, name: String) returns bool
    {
        File.exists("`dir`/lib`name`.dylib") or File.exists("`dir`/lib`name`.so") or File.exists("`dir`/lib`name`.a") or File.exists("`dir`/`name`.lib")
    }

    ; the directory a library is found in, "" when only the linker's own
    ; search path can answer
    procedure find_library(name: String) returns String
    {
        let own getenv "SCALY_LIBRARY_PATH"
        if own <> null
        {
            let list String(own)
            var from: size_t 0
            var at: size_t 0
            let n list.get_length()
            while at <= n
            {
                if at = n or list.get(at) = 58 or list.get(at) = 59
                {
                    if at > from
                    {
                        let d list.substring(from, at - from)
                        if tool.dir_has_library(d, name)
                            return String(d)
                    }
                    set from: at + 1
                }
                set at: at + 1
            }
        }
        var bases Array[String]()
        bases.add(String("/opt/homebrew"))
        bases.add(String("/usr/local"))
        var bi: size_t 0
        while bi < bases.length
        {
            let b bases.at bi
            set bi: bi + 1
            var best String()
            var best_formula String()
            let entries Directory.list("`b`/opt")
            var ei: size_t 0
            while ei < entries.length
            {
                let e entries.at ei
                set ei: ei + 1
                let candidate "`b`/opt/`e.name`/lib"
                if tool.dir_has_library(candidate, name) and tool.name_after(e.name, best_formula)
                {
                    set best: String(candidate)
                    set best_formula: String(e.name)
                }
            }
            if best.get_length() > 0
                return String(best)
            ; the shared `lib` last: it holds every linked formula, and as a
            ; -L it shadows system libraries (llvm's libunwind over macOS's)
            let lib_dir "`b`/lib"
            if tool.dir_has_library(lib_dir, name)
                return String(lib_dir)
        }
        String()
    }

    ; byte order: is `a` after `b`
    function name_after(a: String, b: String) returns bool
    {
        let n a.get_length()
        let m b.get_length()
        var i: size_t 0
        while i < n and i < m
        {
            if a.get(i) <> b.get(i)
                return a.get(i) > b.get(i)
            set i: i + 1
        }
        n > m
    }

    ; the link flags (`-L<dir> -l<name>`, a directory once) and the C include
    ; flags (`-I<dir>`) of the libraries
    procedure library_flags(libs: ref[Array[String]], mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder])
    {
        var dirs Array[String]()
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            set i: i + 1
            let d tool.find_library(l)
            if d.get_length() > 0 and cli.contains_string(&dirs, d) = false
            {
                dirs.add(String(d))
                link_flags.append(" \"-L")
                link_flags.append(d)
                link_flags.append("\"")
                var inc "`d`/../include"
                if Directory.is_directory(inc)
                {
                    include_flags.append(" \"-I")
                    include_flags.append(inc)
                    include_flags.append("\"")
                }
            }
            link_flags.append(" -l")
            link_flags.append(l)
        }
    }

    ; the C libraries of a program: its own declarations first, then its
    ; packages' from the last loaded (dependents) to the first (what they
    ; use) -- the order a linker that reads left to right needs -- with the
    ; link and include flags that find them
    procedure libraries_of(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder]) returns Array[String]
    {
        var libs Array[String]()
        var pf String(program_file)
        tool.declared_libraries(pf, &libs)
        var i roots.length
        while i > 0
        {
            set i: i - 1
            let rp roots.at i
            var root String(rp)
            tool.declared_libraries(root, &libs)
        }
        tool.library_flags(&libs, link_flags, include_flags)
        libs
    }

    ; load each library into this process (scaly_eio_load_library); one that
    ; does not load is said, and the JIT then names the symbol it misses
    procedure load_libraries(libs: ref[Array[String]])
    {
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            set i: i + 1
            let d tool.find_library(l)
            var loaded false
            var candidates Array[String]()
            if d.get_length() > 0
            {
                candidates.add("`d`/lib`l`.dylib")
                candidates.add("`d`/lib`l`.so")
                candidates.add("`d`/`l`.dll")
            }
            candidates.add("lib`l`.dylib")
            candidates.add("lib`l`.so")
            candidates.add("`l`.dll")
            var k: size_t 0
            while k < candidates.length and loaded = false
            {
                let c candidates.at k
                set k: k + 1
                if scaly_eio_load_library(c.to_c_string()) = 0
                    set loaded: true
            }
            if loaded = false
                Console.println("warning: C library `l` could not be loaded")
        }
    }
}
