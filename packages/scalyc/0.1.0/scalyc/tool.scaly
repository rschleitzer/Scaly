; tool.scaly - the build side of the one tool
;
; `scaly build` links a program against OBJECTS of the packages it uses, each
; compiled once into a cache and found again by a key over everything that
; went into it: the compiling compiler (scaly_package_stamp, which the Emitter
; defines for this library from its own IR), the target, the flavour, and every
; file of the package. A package's C and assembly files are compiled by the
; tool as well; which of them a target takes is said by their names
; (native_name#). Nothing is written into the project, and no script is run.
;
; `scaly build --release` (stage C) takes a package as unoptimised BITCODE out
; of the same cache instead: the program's module links it in, dependents
; first, and the whole program is optimised and emitted as one module
; (Emitter.link_bitcode#, the release branch of write_object_to_file#) -- what
; tools/link-lto.sh did with llvm-link, sed, opt and llc.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.File
use scaly.os.Console
use scaly.os.Directory
use scaly.os.Directory.DirectoryEntry
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use scaly.memory.root_pages.scaly_eputs
use scaly.memory.runtime.unlink
use scalyc.compiler.Modeler
use scalyc.cli
use scalyc.cli.Options
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

function getpid() returns i32 extern
procedure setenv(name: pointer[const_char], value: pointer[const_char], overwrite: i32) returns i32 extern
function system(command: pointer[const_char]) returns i32 extern
function rename(old_path: pointer[const_char], new_path: pointer[const_char]) returns i32 extern
function LLVMGetDefaultTargetTriple() returns pointer[char] extern
procedure LLVMDisposeMessage(message: pointer[char]) extern

; a native file's name, read: `fcontext_x86_64_windows` is `fcontext` for
; x86_64 on Windows (tool.native_name#)
define NativeName
(
    base: String
    os: String
    arch: String
)

define tool
{
    ; where compiled packages are kept: $SCALY_CACHE, else ~/.scaly/cache
    ; (%USERPROFILE% where there is no HOME)
    procedure cache_root() returns String
        Modeler.cache_root()

    ; create a directory and every missing one above it; true when it exists
    procedure ensure_directory(mutable path: String) returns bool
    {
        if Directory.is_directory(path)
            return true
        var i: size_t 1
        while i < path.get_length()
        {
            let c path.get i
            if c = 47 or c = 92
            {
                var prefix path.substring(0, i)
                if Directory.is_directory(prefix) = false
                    Directory.create(prefix)
            }
            i := i + 1
        }
        Directory.create(path)
        Directory.is_directory(path)
    }

    ; every file of a package, relative to its directory: the tree without
    ; `interface/` (generated from the sources) and without a name that
    ; starts with `_` or `.` -- no module can be named so, and tscaly's
    ; `_submodules` holds another project's tree
    procedure package_files(mutable dir: String, prefix: String, mutable files: ref[Array[String]])
        Modeler.package_files(dir, prefix, files)

    function fnv_string(h: u64, s: String) returns u64
        Modeler.fnv_string(h, s)

    ; the cache key of a package: the compiling compiler, the target, the
    ; flavour, and every file with its path -- summed, so the order the file
    ; system lists them in does not matter
    procedure package_key(mutable dir: String, files: ref[Array[String]], triple: String, flavour: String) returns u64
    {
        var h: u64 0xcbf29ce484222325
        h := (h xor Modeler.compiler_stamp()) * 0x100000001b3
        h := tool.fnv_string(h, triple)
        h := tool.fnv_string(h, flavour)
        let sum tool.files_sum(dir, files)
        (h xor sum) * 0x100000001b3
    }

    ; every file of a package with its path, summed (the loader's, which
    ; needs it for the interface's key)
    procedure files_sum(mutable dir: String, files: ref[Array[String]]) returns u64
        Modeler.files_sum(dir, files)

    function hex16(k: u64) returns String
        Modeler.hex16(k)

    ; a native file's stem read as base name and target tags: `_windows`,
    ; `_linux`, `_darwin` name the system, `_arm64` (`_aarch64`) and `_x86_64`
    ; the architecture, stripped from the end in any order
    function native_name(stem: String) returns NativeName
    {
        var base stem
        var os String()
        var arch String()
        var again true
        while again
        {
            again := false
            let n base.get_length()
            if os.get_length() = 0 and base.ends_with("_windows")
            {
                os := String("windows")
                base := base.substring(0, n - 8)
                again := true
            }
            else if os.get_length() = 0 and base.ends_with("_linux")
            {
                os := String("linux")
                base := base.substring(0, n - 6)
                again := true
            }
            else if os.get_length() = 0 and base.ends_with("_darwin")
            {
                os := String("darwin")
                base := base.substring(0, n - 7)
                again := true
            }
            else if arch.get_length() = 0 and base.ends_with("_x86_64")
            {
                arch := String("x86_64")
                base := base.substring(0, n - 7)
                again := true
            }
            else if arch.get_length() = 0 and base.ends_with("_arm64")
            {
                arch := String("arm64")
                base := base.substring(0, n - 6)
                again := true
            }
            else if arch.get_length() = 0 and base.ends_with("_aarch64")
            {
                arch := String("arm64")
                base := base.substring(0, n - 8)
                again := true
            }
        }
        NativeName(base, os, arch)
    }

    function triple_arch(triple: String) returns String
    {
        if triple.starts_with("arm64") or triple.starts_with("aarch64")
            return String("arm64")
        if triple.starts_with("x86_64") or triple.starts_with("amd64")
            return String("x86_64")
        String("other")
    }

    function triple_os(triple: String) returns String
    {
        if triple.contains(String("windows"))
            return String("windows")
        if triple.contains(String("linux"))
            return String("linux")
        if triple.contains(String("darwin")) or triple.contains(String("apple"))
            return String("darwin")
        String("other")
    }

    ; the C and assembly files of a package this target takes: of the files
    ; that share a base name, the most specific one whose tags all match --
    ; eio.c everywhere but on Windows, where eio_windows.c replaces it
    procedure select_native(files: ref[Array[String]], triple: String, mutable chosen: ref[Array[String]])
    {
        let os tool.triple_os(triple)
        let arch tool.triple_arch(triple)
        var bases Array[String]()
        var scores Array[int]()
        var picks Array[String]()
        var i: size_t 0
        while i < files.length
        {
            let f files.at i
            i := i + 1
            var ext: size_t 0
            if f.ends_with(".c") or f.ends_with(".S") or f.ends_with(".s")
                ext := 2
            if ext = 0
                continue
            let nn tool.native_name(f.substring(0, f.get_length() - ext))
            if nn.os.get_length() > 0 and nn.os.equals(os) = false
                continue
            if nn.arch.get_length() > 0 and nn.arch.equals(arch) = false
                continue
            var score 0
            if nn.os.get_length() > 0
                score := score + 1
            if nn.arch.get_length() > 0
                score := score + 1
            var found false
            var j: size_t 0
            while j < bases.length
            {
                let b bases.at j
                if b.equals(nn.base)
                {
                    found := true
                    let s scores.at j
                    if score > s
                    {
                        scores.put(j, score)
                        picks.put(j, String(f))
                    }
                }
                j := j + 1
            }
            if found = false
            {
                bases.add(String(nn.base))
                scores.add(score)
                picks.add(String(f))
            }
        }
        var k: size_t 0
        while k < picks.length
        {
            let p picks.at k
            chosen.add(String(p))
            k := k + 1
        }
    }

    ; the host's triple, or the one --target named
    procedure target_triple(given: String) returns String
    {
        if given.get_length() > 0
            return String(given)
        let t LLVMGetDefaultTargetTriple()
        let s String(t as pointer[const_char])
        LLVMDisposeMessage t
        String(s)
    }

    ; move a finished file into place: a second build of the same key at the
    ; same time finds either no file or a whole one
    procedure publish(mutable tmp: String, mutable final: String) returns bool
    {
        rename(tmp.to_c_string(), final.to_c_string()) = 0
    }

    ; the position behind the package tags that follow an identifier ending
    ; at `at` (`B5alpha` in `_ZN3BoxB5alpha5grownEv`, Emitter.tag_packages#)
    function past_tags(sym: String, at: size_t) returns size_t
    {
        let n sym.get_length()
        var i at
        while i + 1 < n and sym.get(i) = 66 and sym.get(i + 1) >= 48 and sym.get(i + 1) <= 57
        {
            var j i + 1
            var len: size_t 0
            while j < n and sym.get(j) >= 48 and sym.get(j) <= 57
            {
                len := len * 10 + ((sym.get(j) - 48) as size_t)
                j := j + 1
            }
            if j + len > n
                return i
            i := j + len
        }
        i
    }

    ; Is `sym` an INSTANCE -- a symbol every package that uses a generic
    ; defines for itself, from one source? Template arguments in its name
    ; (`_ZN5ArrayIiE3addEi`), or the name of a generic free function with the
    ; encoded types behind it (`_Z17allocate_slice2u8...`).
    function is_instance_symbol(sym: String, generics: ref[Array[String]]) returns bool
    {
        let n sym.get_length()
        var i: size_t 2
        let nested i < n and sym.get(i) = 78
        if nested
            i := i + 1
        while i < n
        {
            var len: size_t 0
            var digits false
            while i < n and sym.get(i) >= 48 and sym.get(i) <= 57
            {
                len := len * 10 + ((sym.get(i) - 48) as size_t)
                digits := true
                i := i + 1
            }
            if digits = false or i + len > n
                return false
            let id sym.substring(i, len)
            i := tool.past_tags(sym, i + len)
            if i < n and sym.get(i) = 73
                return true
            if nested = false
            {
                var g: size_t 0
                while g < generics.length
                {
                    let name generics.at g
                    if id.get_length() > name.get_length() and id.starts_with(name)
                        return true
                    g := g + 1
                }
                return false
            }
        }
        false
    }

    ; the name in a symbol, as it is written: `helper` of `_Z6helperi`,
    ; `Box.grown` of `_ZN3Box5grownEv`
    function plain_name(sym: String) returns String
    {
        var sb StringBuilder()
        let n sym.get_length()
        var i: size_t 2
        let nested i < n and sym.get(i) = 78
        if nested
            i := i + 1
        var first true
        while i < n
        {
            var len: size_t 0
            var digits false
            while i < n and sym.get(i) >= 48 and sym.get(i) <= 57
            {
                len := len * 10 + ((sym.get(i) - 48) as size_t)
                digits := true
                i := i + 1
            }
            if digits = false or i + len > n
                break
            if first = false
                sb.append "."
            first := false
            sb.append(sym.substring(i, len))
            i := tool.past_tags(sym, i + len)
            if nested = false
                break
        }
        sb.to_string()
    }

    ; A symbol two packages each define is ONE after the link -- and which
    ; of the two depends on how the program is built (measured 2026-10-05:
    ; `scaly run`, `scaly build` and `--release` gave three different answers
    ; at rc 0). Since 2026-10-09 a package's symbols carry its name
    ; (Emitter.tag_packages#) and two packages' functions of one name no
    ; longer meet here; this stays as the net under the tag -- a symbol the
    ; tag pass could not read goes over untagged, and would meet its twin
    ; silently without it. `files`
    ; are the definition lists the compiler wrote beside each package's
    ; object (cli.run with defs_file), `owners` the packages; instances of
    ; generics, which every user defines from one source, are not judged.
    ; False, each collision named, when two packages define one symbol.
    procedure check_definitions(owners: ref[Array[String]], files: ref[Array[String]]) returns bool
    {
        var generics Array[String]()
        var syms Array[String]()
        var sym_owner Array[size_t]()
        var fi: size_t 0
        while fi < files.length
        {
            let text File.read_to_string(files.at(fi))
            let n text.get_length()
            var from: size_t 0
            var at: size_t 0
            while at < n
            {
                if text.get(at) = 10
                {
                    if at > from + 2
                    {
                        let value text.substring(from + 2, at - from - 2)
                        if text.get(from) = 103
                            generics.add value
                        else
                        {
                            syms.add value
                            sym_owner.add fi
                        }
                    }
                    from := at + 1
                }
                at := at + 1
            }
            fi := fi + 1
        }
        var cap: size_t 1024
        while cap < syms.length * 2
            cap := cap * 2
        var slots Array[size_t]()
        var z: size_t 0
        while z < cap
        {
            slots.add 0
            z := z + 1
        }
        var ok true
        var k: size_t 0
        while k < syms.length
        {
            let sym syms.at k
            if tool.is_instance_symbol(sym, &generics) = false
            {
                var idx (tool.fnv_string(0xcbf29ce484222325, sym) as size_t) & (cap - 1)
                while true
                {
                    let slot slots[idx]
                    if slot = 0
                    {
                        slots.put(idx, k + 1)
                        break
                    }
                    let other syms.at(slot - 1)
                    if other.equals(sym)
                    {
                        let a sym_owner[slot - 1]
                        let b sym_owner[k]
                        if a <> b
                        {
                            let pa owners.at a
                            let pb owners.at b
                            Console.println("Error: packages `pa` and `pb` both define `tool.plain_name(sym)` (`sym`)")
                            ok := false
                        }
                        break
                    }
                    idx := (idx + 1) & (cap - 1)
                }
            }
            k := k + 1
        }
        if ok = false
        {
            Console.println("       A symbol does not carry its package: the two would be ONE function after the link,")
            Console.println("       and which of them depends on how the program is built. One of the two needs another name.")
        }
        ok
    }

    ; What a package's object depends on beyond its own files: the versions
    ; its dependencies are taken in for THIS program (lines `name version` of
    ; the packages its root declares, out of the program's selection). Part of
    ; the cache key -- built for a program that takes a newer json, a package
    ; is another object.
    procedure dependency_versions(mutable root: String, selection: String) returns String
        Modeler.dependency_text(root, selection)

    ; The objects of every package a program uses, each built into the cache
    ; the first time it is needed: the package's Scaly code as one object at
    ; -O2 (library linkage, cli.run with --no-prelude --no-tests), and the C
    ; and assembly files its target takes. `names` and `roots` pair a
    ; package's name with its root file. False when one of them does not build;
    ; what went wrong is printed where it happened.
    procedure package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, given_triple: String, cpu: String, release: bool, mutable objects: ref[Array[String]], mutable bitcode: ref[Array[String]], mutable link_flags: ref[StringBuilder]) returns bool mutable modeler_error_count
    {
        var include_flags StringBuilder()
        tool.libraries_of(names, roots, program_file, link_flags, &include_flags)
        let includes include_flags.to_string()
        let cache tool.cache_root()
        if tool.ensure_directory(cache) = false
        {
            Console.println("Error: cannot create the build cache `cache`")
            return false
        }
        let triple tool.target_triple(given_triple)
        var program_root String(program_file)
        let selection Modeler.select_versions(program_root, false)
        var def_owners Array[String]()
        var def_files Array[String]()
        var i: size_t 0
        while i < roots.length
        {
            let rp roots.at i
            let np names.at i
            i := i + 1
            let root String(rp)
            let slash root.last_index_of(47)
            if slash < 0
                continue
            let dir root.substring(0, slash as size_t)
            let vslash dir.last_index_of(47)
            var version String("0")
            if vslash >= 0
                version := dir.substring((vslash + 1) as size_t, dir.get_length() - ((vslash + 1) as size_t))
            var files Array[String]()
            tool.package_files(dir, "", &files)
            ; -mcpu is part of what a package is compiled for: it reaches the
            ; IR (a SIMD operation's target form, every function's attribute)
            var root_for_deps String(root)
            let key tool.package_key(dir, &files, triple, "O2`cpu``tool.dependency_versions(root_for_deps, selection)`")
            let base "`cache`/`np`-`version`-`tool.hex16(key)`"
            let obj "`base`.o"
            ; what the package defines, written by whichever build comes first
            ; (check_definitions# below)
            let defs "`base`.defs"
            def_owners.add(String(np))
            def_files.add(String(defs))
            ; --release: the package as unoptimised bitcode, which the program's
            ; module takes in whole (Emitter.link_bitcode#); its C and assembly
            ; stay objects
            if release
            {
                let bc "`base`.bc"
                if File.exists(bc) = false or File.exists(defs) = false
                {
                    let btmp "`bc`.`getpid() as int`.tmp"
                    var bo Options()
                    bo.input_file := String(root)
                    bo.output_file := String(btmp)
                    bo.compile_only := true
                    bo.bitcode := true
                    bo.defs_file := String(defs)
                    bo.selected_versions := String(selection)
                    bo.no_prelude := true
                    bo.no_tests := true
                    bo.target_triple := String(given_triple)
                    bo.target_cpu := String(cpu)
                    var bi_dir String(dir)
                    var bi_home tool.interface_wanted(np, version, bi_dir, &files, root_for_deps, selection)
                    var bi_tmp "`bi_home`.`getpid() as int`.tmp"
                    if bi_home.get_length() > 0
                        bo.interface_dir := "`bi_tmp`/interface"
                    if cli.run(bo) <> 0
                    {
                        Console.println("Error: package `np` did not build")
                        return false
                    }
                    tool.publish(btmp, bc)
                    if bi_home.get_length() > 0
                        tool.publish(bi_tmp, bi_home)
                }
                let bc_page Page.get(bitcode)
                bitcode.add(String^bc_page(bc))
                if tool.native_objects(dir, &files, triple, base, given_triple, includes, objects) = false
                    return false
                continue
            }
            if File.exists(obj) = false or File.exists(defs) = false
            {
                let tmp "`obj`.`getpid() as int`.tmp"
                var o Options()
                o.defs_file := String(defs)
                o.selected_versions := String(selection)
                o.input_file := String(root)
                o.output_file := String(tmp)
                o.compile_only := true
                o.no_prelude := true
                o.no_tests := true
                o.opt_level := 2
                o.library := true
                o.target_triple := String(given_triple)
                o.target_cpu := String(cpu)
                var oi_dir String(dir)
                var oi_home tool.interface_wanted(np, version, oi_dir, &files, root_for_deps, selection)
                var oi_tmp "`oi_home`.`getpid() as int`.tmp"
                if oi_home.get_length() > 0
                    o.interface_dir := "`oi_tmp`/interface"
                if cli.run(o) <> 0
                {
                    Console.println("Error: package `np` did not build")
                    return false
                }
                tool.publish(tmp, obj)
                if oi_home.get_length() > 0
                    tool.publish(oi_tmp, oi_home)
            }
            let obj_page Page.get(objects)
            objects.add(String^obj_page(obj))
            if tool.native_objects(dir, &files, triple, base, given_triple, includes, objects) = false
                return false
        }
        tool.check_definitions(&def_owners, &def_files)
    }

    ; the C and assembly files of a package this target takes, each compiled
    ; into the cache beside the package's object (`<base>-<path>.o`)
    procedure native_objects(mutable dir: String, files: ref[Array[String]], triple: String, base: String, given_triple: String, includes: String, mutable objects: ref[Array[String]]) returns bool
    {
        var natives Array[String]()
        tool.select_native(&files, triple, &natives)
        ; ★READY-MADE objects (Windows the Rust way): what we
        ; hand out carries, per system and architecture, the object of every
        ; native file under `<package>/_native/<os>-<arch>/`, named as the cache
        ; names it without the package's key. Where one is there it is linked
        ; as it is and no C compiler is asked -- on Windows there may be none,
        ; and the assembly is GNU syntax, which no MSVC tool reads. A name
        ; beginning with `_` is no part of a package (above), so the directory
        ; moves no cache key; a source tree has none and compiles as before.
        ; Not for a file compiled against a C library's headers (`includes`):
        ; that object belongs to the library found on THIS machine.
        let ready_dir "`dir`/_native/`tool.triple_os(triple)`-`tool.triple_arch(triple)`"
        var k: size_t 0
        while k < natives.length
        {
            let nf natives.at k
            k := k + 1
            var flat StringBuilder()
            var fi: size_t 0
            while fi < nf.get_length()
            {
                let fc nf.get fi
                if fc = 47
                    flat.append("-" as char)
                else
                    flat.append(fc as char)
                fi := fi + 1
            }
            ; the include flags are part of what was compiled: a header
            ; directory that moves names another object
            var tag String()
            if includes.get_length() > 0
                tag := "-i`tool.hex16(tool.fnv_string(0xcbf29ce484222325, includes))`"
            let nobj "`base`-`flat.to_string()``tag`.o"
            let ready "`ready_dir`/`flat.to_string()`.o"
            if includes.get_length() = 0 and File.exists(ready)
            {
                let ready_page Page.get(objects)
                objects.add(String^ready_page(ready))
                continue
            }
            if File.exists(nobj) = false
            {
                if given_triple.get_length() = 0
                {
                    let missing cli.developer_tools_missing()
                    if missing <> 0
                    {
                        cli.report_developer_tools_missing(missing)
                        return false
                    }
                }
                let ntmp "`nobj`.`getpid() as int`.tmp"
                ; cmd.exe strips the first and the last quote of a line that
                ; begins with one and holds more than two, so on a Windows
                ; host the whole line takes a pair of its own. A cross build
                ; names its triple and runs under a POSIX shell, which would
                ; read that pair as an empty argument.
                let cmd_wrap given_triple.get_length() = 0 and triple.contains(String("windows"))
                var cmd StringBuilder()
                if cmd_wrap
                    cmd.append("\"")
                cmd.append("\"")
                cmd.append(cli.link_compiler())
                cmd.append("\" -O2 -c \"")
                cmd.append(dir)
                cmd.append("/")
                cmd.append(nf)
                cmd.append("\" -o \"")
                cmd.append(ntmp)
                cmd.append("\"")
                cmd.append(includes)
                if given_triple.get_length() > 0
                {
                    cmd.append(" --target=")
                    cmd.append(given_triple)
                }
                if cmd_wrap
                    cmd.append("\"")
                let cmd_str cmd.to_string()
                if system(cmd_str.to_c_string()) <> 0
                {
                    Console.println("Error: `dir`/`nf` did not compile")
                    return false
                }
                tool.publish(ntmp, nobj)
            }
            let nobj_page Page.get(objects)
            objects.add(String^nobj_page(nobj))
        }
        true
    }

    ; `scaly run` / `scaly test`: the packages a program uses, other than the
    ; stdlib (the tool's own image carries it), as objects the JIT adds, with
    ; the mangled names each defines (so the JIT's stubs leave them alone). The
    ; objects are built once into the cache, flavour "jit" (thread-locals
    ; cleared, cli.compile_dep_package_to_object), the names beside them in
    ; `<base>.jit.syms`. Before 2026-09-30 every run compiled them anew into
    ; one fixed /tmp path, which two runs at once overwrote.
    procedure jit_package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable objects: ref[Array[String]], mutable symbols: ref[Array[String]]) returns bool mutable modeler_error_count
    {
        ; the C libraries go into this process, where the JIT looks symbols up
        var link_flags StringBuilder()
        var include_flags StringBuilder()
        let libs tool.libraries_of(names, roots, program_file, &link_flags, &include_flags)
        tool.load_libraries(&libs)
        let includes include_flags.to_string()
        let cache tool.cache_root()
        if tool.ensure_directory(cache) = false
        {
            Console.println("Error: cannot create the build cache `cache`")
            return false
        }
        let triple tool.target_triple(String())
        var program_root String(program_file)
        let selection Modeler.select_versions(program_root, false)
        var def_owners Array[String]()
        var def_files Array[String]()
        var i: size_t 0
        while i < roots.length
        {
            let rp roots.at i
            let np names.at i
            i := i + 1
            let root String(rp)
            let slash root.last_index_of(47)
            if slash < 0
                continue
            let dir root.substring(0, slash as size_t)
            let vslash dir.last_index_of(47)
            var version String("0")
            if vslash >= 0
                version := dir.substring((vslash + 1) as size_t, dir.get_length() - ((vslash + 1) as size_t))
            var files Array[String]()
            tool.package_files(dir, "", &files)
            var root_for_deps String(root)
            let key tool.package_key(dir, &files, triple, "jit`tool.dependency_versions(root_for_deps, selection)`")
            let base "`cache`/`np`-`version`-`tool.hex16(key)`"
            let obj "`base`.jit.o"
            let syms "`base`.jit.syms"
            let defs "`base`.jit.defs"
            def_owners.add(String(np))
            def_files.add(String(defs))
            if File.exists(obj) = false or File.exists(defs) = false
            {
                let tmp "`obj`.`getpid() as int`.tmp"
                let stmp "`syms`.`getpid() as int`.tmp"
                var built Array[String]()
                if cli.compile_dep_package_to_object(root, tmp, defs, selection, &built) = false
                {
                    Console.println("Error: package `np` did not build")
                    return false
                }
                var text StringBuilder()
                var bi: size_t 0
                while bi < built.length
                {
                    let b built.at bi
                    text.append(b)
                    text.append("\n" as char)
                    bi := bi + 1
                }
                File.write_from_string(stmp, text.to_string())
                tool.publish(stmp, syms)
                tool.publish(tmp, obj)
            }
            let list File.read_to_string(syms)
            var from: size_t 0
            var at: size_t 0
            let n list.get_length()
            while at < n
            {
                if list.get(at) = 10
                {
                    if at > from
                    {
                        let sym_page Page.get(symbols)
                        symbols.add(String^sym_page(list.substring(from, at - from)))
                    }
                    from := at + 1
                }
                at := at + 1
            }
            let obj_page Page.get(objects)
            objects.add(String^obj_page(obj))
            if tool.native_objects(dir, &files, triple, base, String(), includes, objects) = false
                return false
        }
        tool.check_definitions(&def_owners, &def_files)
    }

    ; ---- C libraries (stage B) ----------------------------------------------
    ;
    ; A package says which C libraries it uses in its root file:
    ;     extern ssl, crypto
    ; and the tool finds them: in $SCALY_LIBRARY_PATH (directories, `:`-
    ; separated, `;` on Windows), then where Homebrew puts them (every
    ; `opt/<formula>/lib` -- the highest formula name when several have it:
    ; openssl@3 before openssl@1.1 -- then its shared `lib`), else nowhere, and the linker's own
    ; search path answers (a Linux distribution's /usr/lib/<triple>). A library
    ; found in a directory adds `-L<dir>`, and `<dir>/../include` the `-I` the
    ; package's C files are compiled with.

    procedure add_library(mutable libs: ref[Array[String]], name: String)
    {
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            if l.equals(name)
                return
            i := i + 1
        }
        let page Page.get(libs)
        libs.add(String^page(name))
    }

    ; the C libraries a source file declares, in the order it names them
    procedure declared_libraries(mutable file: String, mutable libs: ref[Array[String]])
    {
        if File.exists(file) = false
            return
        var contents File.read_to_string(file)
        if contents.get_length() = 0
            return
        var p Parser(contents)
        choose p.parse_program()
            when err: Error
                return
            when syntax: Success
            {
                if syntax.file.declarations = null
                    return
                let decls (*syntax.file.declarations)
                var i: size_t 0
                while i < decls.length
                {
                    let dp decls.get i
                    i := i + 1
                    if dp = null
                        continue
                    choose (*dp)
                        when lib: LibrariesSyntax
                        {
                            tool.add_library(libs, lib.name)
                            if lib.more <> null
                            {
                                let more (*lib.more)
                                var k: size_t 0
                                while k < more.length
                                {
                                    let mp more.get k
                                    if mp <> null
                                        tool.add_library(libs, mp.name)
                                    k := k + 1
                                }
                            }
                        }
                        else
                        {
                            ; not a library declaration
                        }
                }
            }
    }

    ; does `dir` hold the library `name` in a form the linker takes
    procedure dir_has_library(dir: String, name: String) returns bool
    {
        File.exists("`dir`/lib`name`.dylib") or File.exists("`dir`/lib`name`.so") or File.exists("`dir`/lib`name`.a") or File.exists("`dir`/`name`.lib")
    }

    ; the directory a library is found in, "" when only the linker's own
    ; search path can answer
    procedure find_library(name: String) returns String
    {
        let own getenv "SCALY_LIBRARY_PATH"
        if own <> null
        {
            let list String(own)
            var from: size_t 0
            var at: size_t 0
            let n list.get_length()
            while at <= n
            {
                if at = n or list.get(at) = 58 or list.get(at) = 59
                {
                    if at > from
                    {
                        let d list.substring(from, at - from)
                        if tool.dir_has_library(d, name)
                            return String(d)
                    }
                    from := at + 1
                }
                at := at + 1
            }
        }
        var bases Array[String]()
        bases.add(String("/opt/homebrew"))
        bases.add(String("/usr/local"))
        var bi: size_t 0
        while bi < bases.length
        {
            let b bases.at bi
            bi := bi + 1
            var best String()
            var best_formula String()
            let entries Directory.list("`b`/opt")
            var ei: size_t 0
            while ei < entries.length
            {
                let e entries.at ei
                ei := ei + 1
                let candidate "`b`/opt/`e.name`/lib"
                if tool.dir_has_library(candidate, name) and tool.name_after(e.name, best_formula)
                {
                    best := String(candidate)
                    best_formula := String(e.name)
                }
            }
            if best.get_length() > 0
                return String(best)
            ; the shared `lib` last: it holds every linked formula, and as a
            ; -L it shadows system libraries (llvm's libunwind over macOS's)
            let lib_dir "`b`/lib"
            if tool.dir_has_library(lib_dir, name)
                return String(lib_dir)
        }
        String()
    }

    ; byte order: is `a` after `b`
    function name_after(a: String, b: String) returns bool
    {
        let n a.get_length()
        let m b.get_length()
        var i: size_t 0
        while i < n and i < m
        {
            if a.get(i) <> b.get(i)
                return a.get(i) > b.get(i)
            i := i + 1
        }
        n > m
    }

    ; the link flags (`-L<dir> -l<name>`, a directory once) and the C include
    ; flags (`-I<dir>`) of the libraries
    procedure library_flags(libs: ref[Array[String]], mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder])
    {
        var dirs Array[String]()
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            i := i + 1
            let d tool.find_library(l)
            if d.get_length() > 0 and cli.contains_string(&dirs, d) = false
            {
                dirs.add(String(d))
                link_flags.append(" \"-L")
                link_flags.append(d)
                link_flags.append("\"")
                var inc "`d`/../include"
                if Directory.is_directory(inc)
                {
                    include_flags.append(" \"-I")
                    include_flags.append(inc)
                    include_flags.append("\"")
                }
            }
            link_flags.append(" -l")
            link_flags.append(l)
        }
    }

    ; the C libraries of a program: its own declarations first, then its
    ; packages' from the last loaded (dependents) to the first (what they
    ; use) -- the order a linker that reads left to right needs -- with the
    ; link and include flags that find them
    procedure libraries_of(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder]) returns Array[String]
    {
        var libs Array[String]()
        var pf String(program_file)
        tool.declared_libraries(pf, &libs)
        var i roots.length
        while i > 0
        {
            i := i - 1
            let rp roots.at i
            var root String(rp)
            tool.declared_libraries(root, &libs)
        }
        tool.library_flags(&libs, link_flags, include_flags)
        libs
    }

    ; load each library into this process (scaly_eio_load_library); one that
    ; does not load is said, and the JIT then names the symbol it misses
    procedure load_libraries(libs: ref[Array[String]])
    {
        var i: size_t 0
        while i < libs.length
        {
            let l libs.at i
            i := i + 1
            let d tool.find_library(l)
            var loaded false
            var candidates Array[String]()
            if d.get_length() > 0
            {
                candidates.add("`d`/lib`l`.dylib")
                candidates.add("`d`/lib`l`.so")
                candidates.add("`d`/`l`.dll")
            }
            candidates.add("lib`l`.dylib")
            candidates.add("lib`l`.so")
            candidates.add("`l`.dll")
            var k: size_t 0
            while k < candidates.length and loaded = false
            {
                let c candidates.at k
                k := k + 1
                if scaly_eio_load_library(c.to_c_string()) = 0
                    loaded := true
            }
            if loaded = false
                Console.println("warning: C library `l` could not be loaded")
        }
    }

    ; a name `scaly new` accepts: what a package and its root file can be
    ; called -- letters, digits and `_`, a letter first
    function is_project_name(name: String) returns bool
    {
        let n name.get_length()
        if n = 0
            return false
        var i: size_t 0
        while i < n
        {
            let c name.get i
            let letter (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
            let other (c >= 48 and c <= 57) or c = 95
            if letter = false and (i = 0 or other = false)
                return false
            i := i + 1
        }
        true
    }

    ; the function and its test every new root file starts with
    function new_body(indent: String) returns String
    {
        var sb StringBuilder()
        sb.append "`indent`function greeting(name: String) returns String\n"
        sb.append "`indent`    \"Hello, \`name\`!\"\n"
        sb.append "\n"
        sb.append "`indent`function test_greeting() returns int\n"
        sb.append "`indent`{\n"
        sb.append "`indent`    if greeting(\"Scaly\") <> \"Hello, Scaly!\"\n"
        sb.append "`indent`        return 1\n"
        sb.append "`indent`    0\n"
        sb.append "`indent`}\n"
        sb.to_string()
    }

    ; `scaly new <name> [--lib]`: a directory with a root file, nothing else.
    ; A program is <name>/<name>.scaly; a package lies where the compiler and
    ; a later fetch from git look for one, <name>/packages/<name>/0.1.0/.
    procedure new_project(name: String, library: bool) returns int
    {
        if is_project_name(name) = false
        {
            Console.println("scaly new: `name` is no name for a program or a package - letters, digits and _, a letter first")
            return 1
        }
        var top String(name)
        if Directory.exists(top) or File.exists(top)
        {
            Console.println("scaly new: `name` exists already")
            return 1
        }
        var sb StringBuilder()
        var dir String(name)
        if library
        {
            dir := "`name`/packages/`name`/0.1.0"
            sb.append "; `name` -- a Scaly package, version 0.1.0.\n"
            sb.append ";\n"
            sb.append ";   scaly test packages/`name`/0.1.0/`name`.scaly    run its test functions\n"
            sb.append ";\n"
            sb.append "; A program beside the directory packages uses it with\n"
            sb.append ";\n"
            sb.append ";   package `name` 0.1.0\n"
            sb.append "\n"
            sb.append "package scaly 0.1.0\n"
            sb.append "\n"
            sb.append "define `name`\n"
            sb.append "{\n"
            sb.append(new_body("    "))
            sb.append "}\n"
        }
        else
        {
            sb.append "; `name` -- a Scaly program.\n"
            sb.append ";\n"
            sb.append ";   scaly run `name`.scaly      compile and run it\n"
            sb.append ";   scaly test `name`.scaly     run its test functions\n"
            sb.append ";   scaly build `name`.scaly    build the executable\n"
            sb.append "\n"
            sb.append(new_body(""))
            sb.append "\n"
            sb.append "print(greeting(\"world\"))\n"
        }
        if ensure_directory(dir) = false
        {
            Console.println("scaly new: cannot create the directory `dir`")
            return 1
        }
        let file "`dir`/`name`.scaly"
        if File.write_from_string(file, sb.to_string()) = false
        {
            Console.println("scaly new: cannot write `file`")
            return 1
        }
        Console.println("created `file`")
        if library
            Console.println("  cd `name` && scaly test packages/`name`/0.1.0/`name`.scaly")
        else
            Console.println("  cd `name` && scaly run `name`.scaly")
        0
    }

    ; ---- fetching (stage D2) ------------------------------------------------

    ; A source goes into a shell command, and it comes out of a program's
    ; text: only what an address or a path is made of, and no leading `-`
    ; (git would read an option).
    function source_is_safe(source: String) returns bool
    {
        let n source.get_length()
        if n = 0 or source.get(0) = 45
            return false
        var i: size_t 0
        while i < n
        {
            let c source.get i
            let plain (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
            let mark c = 45 or c = 46 or c = 95 or c = 47 or c = 58 or c = 64 or c = 126 or c = 43 or c = 92
            if plain = false and mark = false
                return false
            i := i + 1
        }
        true
    }

    ; what git is given for a source: "github.com/x/y" is
    ; https://github.com/x/y.git; an address with a scheme, a `user@host:`
    ; address and a local path are taken as they are
    function source_url(source: String) returns String
    {
        let n source.get_length()
        if source.contains(String("://")) or source.contains(64 as u8)
            return String(source)
        let c source.get 0
        if c = 47 or c = 46 or c = 126 or c = 92
            return String(source)
        if n > 2 and source.get(1) = 58 and (source.get(2) = 47 or source.get(2) = 92)
            return String(source)
        if source.ends_with(String(".git"))
            return "https://`source`"
        "https://`source`.git"
    }

    ; run a command, what it says kept in `log`; true when it answered 0
    procedure quiet(command: String, log: String) returns bool
    {
        let line "`command` > \"`log`\" 2>&1"
        system(line.to_c_string()) = 0
    }

    ; the first line of a file, without its line feed
    procedure first_line(mutable file: String) returns String
    {
        let text File.read_to_string(file)
        let nl text.index_of(10)
        if nl < 0
            return text
        var end nl as size_t
        if end > 0 and text.get(end - 1) = 13
            end := end - 1
        text.substring(0, end)
    }

    ; the value of `key` in a record file of `key value` lines, "" without
    procedure record_value(mutable file: String, key: String) returns String
    {
        let text File.read_to_string(file)
        let n text.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                let line text.substring(from, at - from)
                if line.starts_with("`key` ")
                    return line.substring(key.get_length() + 1, line.get_length() - key.get_length() - 1)
                from := at + 1
            }
            at := at + 1
        }
        String()
    }

    ; Fetch the package `name` `version` of `source` into `dir`
    ; (Modeler.fetched_directory#): out of the commit the source's record
    ; names for the version, or out of the default branch's head for a
    ; version it does not name -- its packages/<name>/<version> laid down
    ; with its files read-only, by git and nothing else. The
    ; commit and the git tree id of that directory are remembered beside it
    ; (<version>.fetched), and a version fetched AGAIN must have the tree it
    ; had: a published version does not change. Nothing is written into the
    ; project. False, with the reason, when it cannot be done.
    procedure fetch_package(source: String, name: String, version: String, mutable dir: String) returns bool
    {
        if tool.source_is_safe(source) = false
        {
            Console.println("Error: package `name` `version`: \"`source`\" is no source - an address or a path (letters, digits and . _ - / : @ ~ +)")
            return false
        }
        let base Modeler.fetched_base()
        let home "`base`/`Modeler.source_path(source)`"
        let store "`home`/.git-store"
        let pid getpid() as int
        let log "`home`/.fetch.`pid`.log"
        let out "`home`/.fetch.`pid`.out"
        if tool.ensure_directory(home) = false
        {
            Console.println("Error: cannot create `home`")
            return false
        }
        if tool.quiet("git --version", log) = false
        {
            Console.println("Error: package `name` `version` is to be fetched from \"`source`\", and git is not on the PATH")
            return false
        }
        scaly_eputs("scaly: fetching `name` `version` from `source`\n".to_c_string())
        if Directory.is_directory(store) = false
        {
            if tool.quiet("git init --quiet --bare \"`store`\"", log) = false
            {
                Console.println("Error: git could not make `store`: `tool.first_line(log)`")
                return false
            }
        }
        let url tool.source_url(source)
        if tool.quiet("git -C \"`store`\" fetch --quiet --depth 1 \"`url`\" HEAD", log) = false
        {
            Console.println("Error: package `name` `version`: git could not fetch `url`")
            Console.println("       `tool.first_line(log)`")
            unlink(log.to_c_string())
            return false
        }
        let path "packages/`name`/`version`"
        ; A version the package's record names (packages/<name>/published,
        ; tool.publish_run#) is taken from the commit it was published at --
        ; its directory may have left the head since. One the record does not
        ; name is taken from the head, as a version still being written.
        var listed_tree ""
        if system("git -C \"`store`\" show \"FETCH_HEAD:packages/`name`/published\" > \"`out`\" 2> \"`log`\"".to_c_string()) = 0
        {
            let published File.read_to_string(out)
            let at_commit tool.published_field(published, version, 1)
            if at_commit.get_length() > 0
            {
                listed_tree := "`tool.published_field(published, version, 2)`"
                if tool.is_object_id(at_commit) = false or tool.quiet("git -C \"`store`\" fetch --quiet --depth 1 \"`url`\" `at_commit`", log) = false
                {
                    Console.println("Error: package `name` `version` was published at commit `at_commit` of \"`source`\", and git could not fetch that")
                    Console.println("       `tool.first_line(log)`")
                    unlink(log.to_c_string())
                    unlink(out.to_c_string())
                    return false
                }
            }
        }
        system("git -C \"`store`\" rev-parse FETCH_HEAD > \"`out`\" 2> \"`log`\"".to_c_string())
        let commit tool.first_line(out)
        if system("git -C \"`store`\" rev-parse FETCH_HEAD:`path` > \"`out`\" 2> \"`log`\"".to_c_string()) <> 0
        {
            Console.println("Error: \"`source`\" has no package `name` `version` - no directory `path` at its commit `commit`")
            unlink(log.to_c_string())
            unlink(out.to_c_string())
            return false
        }
        let tree tool.first_line(out)
        unlink(out.to_c_string())
        if listed_tree.get_length() > 0 and listed_tree.equals(tree) = false
        {
            Console.println("Error: package `name` `version` of \"`source`\" is not what its record says: published as tree `listed_tree`, commit `commit` holds tree `tree`")
            unlink(log.to_c_string())
            return false
        }
        let record "`dir`.fetched"
        if File.exists(record)
        {
            let had tool.record_value(record, "tree")
            if had.get_length() > 0 and had.equals(tree) = false
            {
                Console.println("Error: package `name` `version` of \"`source`\" is not what it was when it was first fetched here:")
                let had_commit tool.record_value(record, "commit")
                Console.println("       then commit `had_commit`, tree `had`")
                Console.println("       now  commit `commit`, tree `tree`")
                Console.println("       A published version does not change. If this is meant, remove `record`.")
                unlink(log.to_c_string())
                return false
            }
        }
        ; git alone lays the one directory down, into a work tree given for
        ; the occasion. ★No `git archive | tar`: in the Git Bash of Windows
        ; `tar` is GNU tar, which reads the `C:` of the archive's name as a
        ; host ("Cannot connect to C: resolve failed", 2026-10-06).
        let tmp "`home`/.fetch.`pid`"
        var laid tool.ensure_directory(tmp)
        if laid
            laid := tool.quiet("git --git-dir=\"`store`\" --work-tree=\"`tmp`\" checkout -q FETCH_HEAD -- `path`", log)
        let slash dir.last_index_of(47)
        if laid and slash > 0
            laid := tool.ensure_directory(dir.substring(0, slash as size_t))
        if laid
            laid := rename("`tmp`/`path`".to_c_string(), dir.to_c_string()) = 0
        Directory.remove("`tmp`/packages/`name`")
        Directory.remove("`tmp`/packages")
        Directory.remove(tmp)
        if laid = false
        {
            Console.println("Error: package `name` `version` of \"`source`\" could not be laid down in `dir`")
            Console.println("       `tool.first_line(log)`")
            unlink(log.to_c_string())
            return false
        }
        unlink(log.to_c_string())
        ; read-only files, where the system has chmod: what was fetched is
        ; not the place to edit (a copy under ./packages is)
        if tool.triple_os(tool.target_triple(String())).equals("windows") = false
            system("find \"`dir`\" -type f -exec chmod a-w {} + 2>/dev/null".to_c_string())
        File.write_from_string(record, "commit `commit`\ntree `tree`\nsource `source`\n")
        ; its author's C runs through this machine's compiler when it is built
        var files Array[String]()
        tool.package_files(dir, "", &files)
        var natives Array[String]()
        tool.select_native(&files, tool.target_triple(String()), &natives)
        if natives.length > 0
            scaly_eputs("scaly: `name` `version` brings native code - `natives.length` C or assembly files, compiled on this machine when the package is built\n".to_c_string())
        true
    }

    ; Fetch what `root_file` declares with a source and neither the
    ; installation nor the project has, and what those packages declare in
    ; their turn. `seen` holds the roots already read. Before a compile: the
    ; compiler itself never reaches the network (Modeler.package_directory#
    ; only looks). False when a fetch failed.
    procedure fetch_declared(mutable root_file: String, mutable seen: ref[Array[String]]) returns bool
    {
        var si: size_t 0
        while si < seen.length
        {
            let s seen.at si
            if s.equals(root_file)
                return true
            si := si + 1
        }
        let seen_page Page.get(seen)
        seen.add(String^seen_page(root_file))
        var names Array[String]()
        var versions Array[String]()
        var sources Array[String]()
        Modeler.declared_packages(root_file, &names, &versions, &sources)
        var i: size_t 0
        while i < names.length
        {
            let name names.at i
            let version versions.at i
            var source String(sources.at(i))
            ; a sibling of a fetched package: out of the same repository
            if source.get_length() = 0
                source := Modeler.inherited_source(root_file)
            i := i + 1
            var dir Modeler.package_directory(name, version, source)
            if source.get_length() > 0 and dir.starts_with(Modeler.fetched_base()) and Modeler.has_package_root(dir, name) = false
                if tool.fetch_package(source, name, version, dir) = false
                    return false
            var root "`dir`/`name`.scaly"
            if File.exists(root) and tool.fetch_declared(root, seen) = false
                return false
        }
        true
    }

    ; ---- generated interfaces in the cache -----------------------------------
    ; A package is compiled once and afterwards only READ THROUGH ITS
    ; INTERFACE and linked. Every interface lies in the cache beside the
    ; objects; where, and under which key, is the loader's to say
    ; (Modeler.interface_home#), because the compiler reads them with or
    ; without this tool. The tool's part: whenever it compiles a package
    ; whose interface is not there yet, the same compiler run writes it
    ; (package_objects#, Options.interface_dir).

    ; The packages `root_file` reaches, each once, what a package declares
    ; before the package itself: name, selected version and directory.
    procedure collect_packages(mutable root_file: String, selection: String, mutable seen: ref[Array[String]], mutable names: ref[Array[String]], mutable versions: ref[Array[String]], mutable dirs: ref[Array[String]])
    {
        if tool.holds(seen, root_file)
            return
        seen.add("`root_file`")
        var declared Array[String]()
        var asked Array[String]()
        var sources Array[String]()
        Modeler.declared_packages(root_file, &declared, &asked, &sources)
        var i: size_t 0
        while i < declared.length
        {
            let name declared.at(i)
            var version "`asked.at(i)`"
            let selected Modeler.selected_version(selection, name)
            if selected.get_length() > 0
                version := "`selected`"
            var source "`sources.at(i)`"
            if source.get_length() = 0
                source := Modeler.inherited_source(root_file)
            i := i + 1
            var dir Modeler.package_directory(name, version, source)
            var root "`dir`/`name`.scaly"
            if File.exists(root) = false
                continue
            tool.collect_packages(root, selection, seen, names, versions, dirs)
            if tool.holds(dirs, dir) = false
            {
                names.add("`name`")
                versions.add("`version`")
                dirs.add("`dir`")
            }
        }
    }

    ; "" when the package compiled now has its interface in the cache
    ; already; else where it is to go
    procedure interface_wanted(name: String, version: String, mutable dir: String, files: ref[Array[String]], mutable root: String, selection: String) returns String
    {
        let home Modeler.interface_home(dir, name, Modeler.dependency_text(root, selection))
        var written "`home`/interface/`name`.scaly"
        if File.exists(written)
            return String()
        home
    }

    ; Before a program is compiled: every file of the packages it reaches is
    ; read once, here, and each package's sum left where the keys asked
    ; later find it (Modeler.known_sum#) -- the loader's for the interface,
    ; this tool's for the objects.
    procedure prepare_interfaces(mutable root_file: String) mutable modeler_error_count
    {
        setenv("SCALY_PACKAGE_SUMS", "", 1)
        let selection Modeler.select_versions(root_file, false)
        var seen Array[String]()
        var names Array[String]()
        var versions Array[String]()
        var dirs Array[String]()
        tool.collect_packages(root_file, selection, &seen, &names, &versions, &dirs)
        var map ""
        var i: size_t 0
        while i < names.length
        {
            var dir "`dirs.at(i)`"
            i := i + 1
            var files Array[String]()
            tool.package_files(dir, "", &files)
            let sum tool.files_sum(dir, &files)
            map := "`map``dir`\n`tool.hex16(sum)`\n"
        }
        setenv("SCALY_PACKAGE_SUMS", map.to_c_string(), 1)
    }

    ; ---- scaly clean ---------------------------------------------------------
    ; Everything under `dir`, the directories last; how many files went.
    ; Each entry is tried as a file first: a link is removed as the link it
    ; is, never followed into what it points at.
    procedure remove_tree(mutable dir: String) returns int
    {
        var gone 0
        let entries Directory.list(dir)
        var i: size_t 0
        while i < entries.length
        {
            let e entries.at(i)
            i := i + 1
            var path "`dir`/`e.name`"
            if unlink(path.to_c_string()) = 0
                gone := gone + 1
            else if e.is_directory
            {
                gone := gone + tool.remove_tree(path)
                Directory.remove(path)
            }
        }
        gone
    }

    ; `scaly clean`: empty the cache. Everything there was made from sources
    ; and is made again when it is needed -- the compiled packages and their
    ; interfaces, each under a key over what went into it, so nothing there
    ; is ever wrong, only no longer asked for: every change to the compiler
    ; or to a package leaves the files of the state before. What was FETCHED
    ; (~/.scaly/packages) and what was installed (~/.scaly/bin) are not the
    ; cache and stay.
    procedure clean() returns int
    {
        var cache tool.cache_root()
        let n cache.get_length()
        ; a place that can only be a cache: named by the variable, or the
        ; directory `cache` this tool made
        let own getenv "SCALY_CACHE"
        if n < 4 or (own = null and cache.ends_with("/.scaly/cache") = false)
        {
            Console.println("Error: scaly clean: `cache` does not look like a cache")
            return 1
        }
        if Directory.is_directory(cache) = false
        {
            Console.println("clean: the cache `cache` is empty")
            return 0
        }
        let gone tool.remove_tree(cache)
        Console.println("clean: `gone` files removed from `cache`")
        0
    }

    ; ---- scaly publish (stage E) --------------------------------------------
    ; where the tool keeps a file for the length of one command
    procedure scratch_base() returns String
    {
        var dir getenv "TMPDIR"
        if dir = null
            dir := getenv("TMP")
        if dir = null
            dir := getenv("TEMP")
        if dir = null
            return String("/tmp")
        String(dir)
    }

    ; the lines of a file, each without its line end, the empty ones left out
    procedure read_lines(mutable file: String, mutable lines: ref[Array[String]])
    {
        let text File.read_to_string(file)
        let n text.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                var end at
                if end > from and text.get(end - 1) = 13
                    end := end - 1
                if end > from
                    lines.add("`text.substring(from, end - from)`")
                from := at + 1
            }
            at := at + 1
        }
    }

    ; THE RECORD. packages/<name>/published names the published versions of a
    ; package, a line each: `version commit tree` -- the commit the version's
    ; directory lay at when it was published, and that directory's git tree.
    ; PUBLISHED IS WHAT HAS A LINE THERE (the author, 2026-10-08): a version
    ; directory without one is being written and may change, a line never
    ; does. A published version's directory may leave the tree: it lives on at
    ; its commit, and fetch_package# takes it from there. `scaly publish`
    ; writes the lines; lines beginning with `;` are comments.

    ; the `index`-th word of a line (0 the first), "" where it has none
    function word_of(line: String, index: size_t) returns String
    {
        let n line.get_length()
        var word: size_t 0
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or line.get(at) = 32
            {
                if word = index
                    return line.substring(from, at - from)
                word := word + 1
                from := at + 1
            }
            at := at + 1
        }
        String()
    }

    ; the `index`-th word of the record's line for `version`, "" without one
    function published_field(text: String, version: String, index: size_t) returns String
    {
        let n text.get_length()
        let vn version.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                var end at
                if end > from and text.get(end - 1) = 13
                    end := end - 1
                let line text.substring(from, end - from)
                if line.get_length() > vn and line.starts_with(version) and line.get(vn) = 32
                    return tool.word_of(line, index)
                from := at + 1
            }
            at := at + 1
        }
        String()
    }

    ; the versions a record names
    procedure published_versions(text: String, mutable versions: ref[Array[String]])
    {
        let n text.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                if at > from and tool.is_version(text.substring(from, at - from))
                    versions.add("`tool.word_of(text.substring(from, at - from), 0)`")
                from := at + 1
            }
            at := at + 1
        }
    }

    ; a commit or tree id as git prints it: hexadecimal digits and nothing else
    function is_object_id(id: String) returns bool
    {
        let n id.get_length()
        if n < 7
            return false
        var i: size_t 0
        while i < n
        {
            let c id.get(i)
            if (c < 48 or c > 57) and (c < 97 or c > 102)
                return false
            i := i + 1
        }
        true
    }

    ; `scaly publish [--check] [remote]` (stage E), run at the root of a
    ; package's repository; the remote is `origin` unless one is named.
    ; It speaks of the packages this repository tracks (repository_has#).
    ;   1. A published version does not change: no line of the remote's
    ;      record is gone or reads differently here, and a recorded version
    ;      whose directory is still in the tree is the recorded git tree,
    ;      with nothing uncommitted in it.
    ;   2. A version directory without a line is NEW, and its number says
    ;      what it changed against the version before it (publish_compare#).
    ;   3. Without --check: each new version gets its line -- the commit is
    ;      HEAD, so the tree must be committed --, the record is committed and
    ;      both commits are pushed (publish_write#).
    ; 0: all well; 1: a rule is broken, each case named; 2: it could not be
    ; asked (no repository, the remote not reached).
    procedure publish_run(remote: String, write: bool) returns int mutable modeler_error_count
    {
        if tool.source_is_safe(remote) = false
        {
            Console.println("Error: scaly publish: \"`remote`\" is no remote - a name, an address or a path")
            return 2
        }
        let pid getpid() as int
        let base tool.scratch_base()
        var log "`base`/scaly-publish.`pid`.log"
        var out "`base`/scaly-publish.`pid`.out"
        if tool.quiet("git rev-parse --show-prefix", out) = false
        {
            Console.println("Error: scaly publish: this directory is in no git repository")
            unlink(out.to_c_string())
            return 2
        }
        if tool.first_line(out).get_length() > 0 or Directory.is_directory(String("packages")) = false
        {
            Console.println("Error: scaly publish: run it at the root of the repository, where packages/ is")
            unlink(out.to_c_string())
            return 2
        }
        if tool.quiet("git fetch --quiet \"`remote`\" HEAD", log) = false
        {
            Console.println("Error: scaly publish: git could not ask \"`remote`\" what is published: `tool.first_line(log)`")
            unlink(out.to_c_string())
            unlink(log.to_c_string())
            return 2
        }
        var kept 0
        var changed 0
        let pkgs Directory.list(String("packages"))
        var q: size_t 0
        while q < pkgs.length
        {
            let pe pkgs.at(q)
            q := q + 1
            if pe.is_directory = false or tool.repository_has("packages/`pe.name`", log) = false
                continue
            var record "packages/`pe.name`/published"
            var here ""
            if File.exists(record)
                here := File.read_to_string(record)
            var there ""
            if system("git show \"FETCH_HEAD:packages/`pe.name`/published\" > \"`out`\" 2> \"`log`\"".to_c_string()) = 0
                there := File.read_to_string(out)
            ; the remote's lines are all here, as they are
            var remote_versions Array[String]()
            tool.published_versions(there, &remote_versions)
            var r: size_t 0
            while r < remote_versions.length
            {
                let rv remote_versions.at(r)
                r := r + 1
                if tool.published_field(there, rv, 1).equals(tool.published_field(here, rv, 1)) and tool.published_field(there, rv, 2).equals(tool.published_field(here, rv, 2))
                    continue
                if changed = 0
                    Console.println("Error: scaly publish: a published version does not change.")
                changed := changed + 1
                Console.println("       `pe.name` `rv`: its line in `record` is gone or reads differently than at \"`remote`\"")
            }
            ; a recorded version that still has its directory is that tree
            var versions Array[String]()
            tool.published_versions(here, &versions)
            var v: size_t 0
            while v < versions.length
            {
                let version versions.at(v)
                v := v + 1
                var path "packages/`pe.name`/`version`"
                if Directory.is_directory(path) = false
                {
                    kept := kept + 1
                    continue
                }
                let tree tool.published_field(here, version, 2)
                var why ""
                if system("git rev-parse --verify --quiet \"HEAD:`path`\" > \"`out`\" 2> \"`log`\"".to_c_string()) <> 0
                    why := "its directory is not committed"
                else
                {
                    let now tool.first_line(out)
                    if now.equals(tree) = false
                        why := "its directory is tree `now` here"
                    else
                    {
                        system("git status --porcelain -- \"`path`\" > \"`out`\" 2> \"`log`\"".to_c_string())
                        if tool.first_line(out).get_length() > 0
                            why := "its directory has changes that are not committed"
                    }
                }
                if why.get_length() = 0
                {
                    kept := kept + 1
                    continue
                }
                if changed = 0
                    Console.println("Error: scaly publish: a published version does not change.")
                changed := changed + 1
                Console.println("       `pe.name` `version` was published as tree `tree`; `why`")
            }
        }
        if changed > 0
        {
            Console.println("       Put the change into a new version directory.")
            unlink(out.to_c_string())
            unlink(log.to_c_string())
            return 1
        }
        Console.println("publish: `kept` published version(s) unchanged")
        ; a version without a line is new: its number says what it changed
        var fresh Array[String]()
        var understated 0
        q := 0
        while q < pkgs.length
        {
            let pe pkgs.at(q)
            q := q + 1
            if pe.is_directory = false or tool.repository_has("packages/`pe.name`", log) = false
                continue
            var record "packages/`pe.name`/published"
            var here ""
            if File.exists(record)
                here := File.read_to_string(record)
            var recorded Array[String]()
            tool.published_versions(here, &recorded)
            let vs Directory.list("packages/`pe.name`")
            var w: size_t 0
            while w < vs.length
            {
                let ve vs.at(w)
                w := w + 1
                if ve.is_directory = false or tool.is_version(ve.name) = false or tool.holds(&recorded, ve.name)
                    continue
                ; the version before it: the highest lower one, in the tree or in the record
                var prev ""
                var x: size_t 0
                while x < vs.length
                {
                    let oe vs.at(x)
                    x := x + 1
                    if oe.is_directory and tool.is_version(oe.name) and Modeler.version_newer(ve.name, oe.name) and (prev.get_length() = 0 or Modeler.version_newer(oe.name, prev))
                        prev := "`oe.name`"
                }
                x := 0
                while x < recorded.length
                {
                    let ov recorded.at(x)
                    x := x + 1
                    if Modeler.version_newer(ve.name, ov) and (prev.get_length() = 0 or Modeler.version_newer(ov, prev))
                        prev := "`ov`"
                }
                if prev.get_length() = 0
                    Console.println("publish: `pe.name` `ve.name` is new, the package's first version")
                else if tool.publish_compare(pe.name, prev, ve.name, tool.published_field(here, prev, 1), "`base`/scaly-publish.`pid`") = false
                {
                    understated := understated + 1
                    continue
                }
                tool.publish_notes(pe.name, ve.name, log, out)
                fresh.add("`pe.name` `ve.name`")
            }
        }
        var answer 0
        if understated > 0
            answer := 1
        else if write
            answer := tool.publish_write(remote, &fresh, log, out)
        unlink(out.to_c_string())
        unlink(log.to_c_string())
        answer
    }

    ; The record of published versions (packages/<name>/published) a source
    ; has at its head, "" where it has none or cannot be asked.
    procedure source_record(source: String, name: String, mutable log: String, mutable out: String) returns String
    {
        if tool.source_is_safe(source) = false
            return String()
        var home "`Modeler.fetched_base()`/`Modeler.source_path(source)`"
        var store "`home`/.git-store"
        if tool.ensure_directory(home) = false
            return String()
        if Directory.is_directory(store) = false and tool.quiet("git init --quiet --bare \"`store`\"", log) = false
            return String()
        let url tool.source_url(source)
        if tool.quiet("git -C \"`store`\" fetch --quiet --depth 1 \"`url`\" HEAD", log) = false
            return String()
        if system("git -C \"`store`\" show \"FETCH_HEAD:packages/`name`/published\" > \"`out`\" 2> \"`log`\"".to_c_string()) <> 0
            return String()
        File.read_to_string(out)
    }

    ; Said where someone can act on it: a package this new version declares
    ; has a NEWER LINE published -- a version that does not stand in for the
    ; declared one (Modeler.version_compatible#), so no build takes it by
    ; itself and the declaration stays behind until its author raises it. A
    ; note, never a refusal: not everyone can follow at once. (A newer version
    ; WITHIN the line needs no word -- a build takes the highest one asked
    ; for.) The cure for dependencies nobody raises; see ROADMAP-public.md.
    procedure publish_notes(name: String, version: String, mutable log: String, mutable out: String)
    {
        var root "packages/`name`/`version`/`name`.scaly"
        var names Array[String]()
        var versions Array[String]()
        var sources Array[String]()
        Modeler.declared_packages(root, &names, &versions, &sources)
        var i: size_t 0
        while i < names.length
        {
            let dep names.at(i)
            let asked versions.at(i)
            let source sources.at(i)
            i := i + 1
            var record ""
            if source.get_length() > 0
                record := tool.source_record(source, dep, log, out)
            else
            {
                var file "packages/`dep`/published"
                if File.exists(file)
                    record := File.read_to_string(file)
            }
            var listed Array[String]()
            tool.published_versions(record, &listed)
            var top ""
            var k: size_t 0
            while k < listed.length
            {
                if top.get_length() = 0 or Modeler.version_newer(listed.at(k), top)
                    top := "`listed.at(k)`"
                k := k + 1
            }
            if top.get_length() > 0 and Modeler.version_newer(top, asked) and Modeler.version_compatible(top, asked) = false
                Console.println("note: `name` `version` declares `dep` `asked`; `dep` `top` is published, a newer line")
        }
    }

    ; Is `path` a directory of THIS repository -- does it track a file under
    ; it? A package linked into packages/ out of another checkout (and
    ; ignored) is that checkout's to publish, and one nothing of which is
    ; committed yet has no commit to be published at.
    procedure repository_has(path: String, log: String) returns bool
    {
        tool.quiet("git ls-files --error-unmatch -- \"`path`\"", log)
    }

    ; Give each new version its line, commit the records and push.
    procedure publish_write(remote: String, fresh: ref[Array[String]], mutable log: String, mutable out: String) returns int
    {
        if fresh.length = 0
        {
            Console.println("publish: nothing new to publish")
            return 0
        }
        system("git status --porcelain -- packages > \"`out`\" 2> \"`log`\"".to_c_string())
        if tool.first_line(out).get_length() > 0
        {
            Console.println("Error: scaly publish: packages/ has changes that are not committed - a version is published at a commit")
            return 1
        }
        system("git rev-parse HEAD > \"`out`\" 2> \"`log`\"".to_c_string())
        let commit tool.first_line(out)
        var what ""
        var i: size_t 0
        while i < fresh.length
        {
            let name tool.word_of(fresh.at(i), 0)
            let version tool.word_of(fresh.at(i), 1)
            if i > 0
                what := "`what`, "
            what := "`what``fresh.at(i)`"
            i := i + 1
            system("git rev-parse \"HEAD:packages/`name`/`version`\" > \"`out`\" 2> \"`log`\"".to_c_string())
            let tree tool.first_line(out)
            var record "packages/`name`/published"
            var text "; The published versions of `name`: version, commit, git tree of its directory.\n; Written by scaly publish. A line here does not change.\n"
            if File.exists(record)
                text := File.read_to_string(record)
            if text.get_length() > 0 and text.get(text.get_length() - 1) <> 10
                text := "`text`\n"
            File.write_from_string(record, "`text``version` `commit` `tree`\n")
            system("git add \"`record`\"".to_c_string())
        }
        if tool.quiet("git commit --quiet -m \"Publish `what`\"", log) = false
        {
            Console.println("Error: scaly publish: git could not commit the record: `tool.first_line(log)`")
            return 1
        }
        if tool.quiet("git push --quiet \"`remote`\" HEAD", log) = false
        {
            Console.println("Error: scaly publish: the record is committed here, but git could not push to \"`remote`\": `tool.first_line(log)`")
            Console.println("       Push it, and `what` is published.")
            return 1
        }
        Console.println("publish: `what` published at commit `commit`, pushed to \"`remote`\"")
        0
    }

    ; does a directory's name begin like a version?
    function is_version(name: String) returns bool
    {
        if name.get_length() = 0
            return false
        let c name.get(0)
        c >= 48 and c <= 57
    }

    function holds(list: ref[Array[String]], what: String) returns bool
    {
        var i: size_t 0
        while i < list.length
        {
            if list.at(i).equals(what)
                return true
            i := i + 1
        }
        false
    }

    ; ---- E2: the version rule ------------------------------------------------
    ; What a package DECLARES is its surface (compiler/Interface.scaly,
    ; --emit-surface): every routine's header, every record with its fields,
    ; every constant, global and alias -- no body. The surface of the new
    ; version is compared with the one before it, declaration by declaration:
    ;   a declaration of before that is gone or reads differently  -> breaking
    ;   one that was not there                                      -> an addition
    ;   neither                                                     -> bodies only
    ; and the number must say so (the author, 2026-10-08): from 1.0 on a
    ; breaking change takes the first number and an addition the second;
    ; below 1.0 a breaking change takes the second number and everything else
    ; the third -- 0.x has promised nothing, 1.0.0 is the promise. The same
    ; reading as Modeler.version_compatible#, which decides what may stand in
    ; for what in a build.
    ; `use`, `package` and `module` lines declare nothing a caller sees -- but a
    ; declared package that moved to ANOTHER LINE counts as a changed
    ; declaration (publish_compare#): the user's build must follow it.
    ; ★Conservative on purpose: a declaration is compared as TEXT (comments
    ; and line breaks apart), so a renamed parameter or a constant's new
    ; value counts as changed. Nothing in Scaly is private, so every
    ; declaration counts.

    ; A file of a surface as one declaration per line: comments gone, blanks
    ; run together, a parenthesis or bracket that spans lines drawn into one.
    function surface_text(text: String) returns String
    {
        var sb StringBuilder()
        let n text.get_length()
        var i: size_t 0
        var depth 0
        var quote: u8 0
        var last: u8 0          ; the last byte written on this line, 0: none
        var gap false           ; blanks seen since
        while i < n
        {
            let c text.get(i)
            i := i + 1
            if quote <> 0
            {
                sb.append(c as char)
                if c = 92 and i < n
                {
                    sb.append(text.get(i) as char)
                    i := i + 1
                }
                else if c = quote
                    quote := 0
                continue
            }
            if c = 59
            {
                if i < n and text.get(i) = 42
                {
                    i := i + 1
                    while i + 1 < n and (text.get(i) <> 42 or text.get(i + 1) <> 59)
                        i := i + 1
                    i := i + 2
                }
                else
                {
                    while i < n and text.get(i) <> 10
                        i := i + 1
                }
                continue
            }
            if (c = 10 or c = 13) and depth = 0
            {
                if last <> 0
                    sb.append("\n" as char)
                last := 0
                gap := false
                continue
            }
            if c = 10 or c = 13 or c = 32 or c = 9
            {
                gap := true
                continue
            }
            if c = 40 or c = 91
                depth := depth + 1
            if (c = 41 or c = 93) and depth > 0
                depth := depth - 1
            if gap and last <> 0 and last <> 40 and last <> 91 and c <> 41 and c <> 93 and c <> 44
                sb.append(" " as char)
            gap := false
            if c = 34 or c = 39
                quote := c
            sb.append(c as char)
            last := c
        }
        sb.to_string()
    }

    ; The declarations of one surface file, each as `file scope| text`: the
    ; scope is the chain of the `define`s whose braces enclose it.
    procedure surface_lines(rel: String, text: String, mutable lines: ref[Array[String]])
    {
        let flat tool.surface_text(text)
        var scopes Array[String]()
        var depth: size_t 0
        var pending ""
        let n flat.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or flat.get(at) = 10
            {
                if at > from
                {
                    let line flat.substring(from, at - from)
                    if line.equals("{")
                    {
                        if depth < scopes.length
                            scopes.put(depth, "`pending`")
                        else
                            scopes.add("`pending`")
                        depth := depth + 1
                        pending := ""
                    }
                    else if line.equals("}")
                    {
                        if depth > 0
                            depth := depth - 1
                        pending := ""
                    }
                    else if line.starts_with("use ") or line.starts_with("package ") or line.starts_with("module ")
                        pending := ""
                    else
                    {
                        var path ""
                        var k: size_t 0
                        while k < depth
                        {
                            path := "`path``scopes.at(k)`."
                            k := k + 1
                        }
                        ; a record's fields on the lines after its name belong to it
                        if line.starts_with("(") and pending.get_length() > 0
                        {
                            lines.add("`rel` `path`| `pending` `line`")
                            from := at + 1
                            at := at + 1
                            continue
                        }
                        lines.add("`rel` `path`| `line`")
                        pending := ""
                        if line.starts_with("define ")
                        {
                            var e: size_t 7
                            while e < line.get_length() and line.get(e) <> 32 and line.get(e) <> 40 and line.get(e) <> 91 and line.get(e) <> 58
                                e := e + 1
                            pending := "`line.substring(7, e - 7)`"
                        }
                    }
                }
                from := at + 1
            }
            at := at + 1
        }
    }

    ; byte by byte: does `a` sort before `b`?
    function text_before(a: String, b: String) returns bool
    {
        let na a.get_length()
        let nb b.get_length()
        var i: size_t 0
        while i < na and i < nb
        {
            let ca a.get(i)
            let cb b.get(i)
            if ca <> cb
                return ca < cb
            i := i + 1
        }
        na < nb
    }

    ; the indices of `lines` in sorted order (a shell sort: no sort in the
    ; standard library yet, and a surface has thousands of lines, not millions)
    procedure sorted_order(lines: ref[Array[String]], mutable order: ref[Array[size_t]])
    {
        var f: size_t 0
        while f < lines.length
        {
            order.add(f)
            f := f + 1
        }
        var gap lines.length / 2
        while gap > 0
        {
            var i gap
            while i < order.length
            {
                let moving order[i]
                var j i
                while j >= gap and tool.text_before(lines.at(moving), lines.at(order[j - gap]))
                {
                    order.put(j, order[j - gap])
                    j := j - gap
                }
                order.put(j, moving)
                i := i + 1
            }
            gap := gap / 2
        }
    }

    ; How many declarations `a` has that `b` has not (each as often as it
    ; stands there); the first three go into `examples`.
    procedure surface_missing(a: ref[Array[String]], b: ref[Array[String]], mutable examples: ref[Array[String]]) returns int
    {
        var oa Array[size_t]()
        var ob Array[size_t]()
        tool.sorted_order(a, &oa)
        tool.sorted_order(b, &ob)
        var missing 0
        var i: size_t 0
        var j: size_t 0
        while i < oa.length
        {
            let x a.at(oa[i])
            if j < ob.length and x.equals(b.at(ob[j]))
            {
                i := i + 1
                j := j + 1
            }
            else if j < ob.length and tool.text_before(b.at(ob[j]), x)
                j := j + 1
            else
            {
                missing := missing + 1
                if examples.length < 3
                    examples.add("`x`")
                i := i + 1
            }
        }
        missing
    }

    ; The surface of `tree`packages/<name>/<version> (`tree` empty: this
    ; repository's working tree), written under `dir` and read into `lines`.
    ; False when the version does not compile.
    procedure surface_of(tree: String, name: String, version: String, mutable dir: String, mutable lines: ref[Array[String]]) returns bool mutable modeler_error_count
    {
        var root "`tree`packages/`name`/`version`/`name`.scaly"
        if File.exists(root) = false
        {
            Console.println("Error: scaly publish: `name` `version` has no root file `root`")
            return false
        }
        var seen Array[String]()
        if tool.fetch_declared(root, &seen) = false
            return false
        var o Options()
        o.input_file := String(root)
        o.output_file := String(dir)
        o.emit_interface := true
        o.emit_surface := true
        o.selected_versions := Modeler.select_versions(root, false)
        if name.equals("scaly")
            o.no_prelude := true
        if cli.run(o) <> 0
        {
            Console.println("Error: scaly publish: `name` `version` does not compile")
            return false
        }
        var files Array[String]()
        tool.package_files(dir, "", &files)
        var i: size_t 0
        while i < files.length
        {
            var path "`dir`/`files.at(i)`"
            tool.surface_lines(files.at(i), File.read_to_string(path), lines)
            unlink(path.to_c_string())
            i := i + 1
        }
        true
    }

    procedure show_lines(lines: ref[Array[String]])
    {
        var e: size_t 0
        while e < lines.length
        {
            Console.println("         `lines.at(e)`")
            e := e + 1
        }
    }

    ; Does the number of `next` say what it changed against `prev`? Says what
    ; it found either way; false when the number understates it.
    procedure publish_compare(name: String, prev: String, next: String, prev_commit: String, scratch: String) returns bool mutable modeler_error_count
    {
        var old_lines Array[String]()
        var new_lines Array[String]()
        var old_dir "`scratch`.before"
        var new_dir "`scratch`.after"
        ; the version before, out of the tree -- or, when its directory has
        ; left the tree, out of the commit its line names, checked out beside
        var before ""
        var history "`scratch`.tree"
        var log "`scratch`.treelog"
        if Directory.is_directory("packages/`name`/`prev`") = false
        {
            if tool.is_object_id(prev_commit) = false
            {
                Console.println("Error: scaly publish: `name` `prev`, the version before `next`, is neither in the tree nor in the record")
                return false
            }
            if tool.quiet("git worktree add --detach \"`history`\" `prev_commit`", log) = false
            {
                Console.println("Error: scaly publish: `name` `prev` was published at commit `prev_commit`, which this repository cannot check out: `tool.first_line(log)`")
                unlink(log.to_c_string())
                return false
            }
            before := "`history`/"
        }
        let read_before tool.surface_of(before, name, prev, old_dir, &old_lines)
        ; ... and what it declared of other packages
        var old_names Array[String]()
        var old_versions Array[String]()
        var old_sources Array[String]()
        var old_root "`before`packages/`name`/`prev`/`name`.scaly"
        Modeler.declared_packages(old_root, &old_names, &old_versions, &old_sources)
        if before.get_length() > 0
        {
            tool.quiet("git worktree remove --force \"`history`\"", log)
            unlink(log.to_c_string())
        }
        if read_before = false or tool.surface_of(String(), name, next, new_dir, &new_lines) = false
            return false
        var gone_examples Array[String]()
        var added_examples Array[String]()
        var gone tool.surface_missing(&old_lines, &new_lines, &gone_examples)
        let added tool.surface_missing(&new_lines, &old_lines, &added_examples)
        ; A package this one declares, now in ANOTHER LINE, is a change of
        ; what it declares: one build takes one line of a package, so whoever
        ; uses this package beside that one must follow -- or is refused.
        ; (A dependency added or dropped is none: nothing a user had is taken.)
        var new_names Array[String]()
        var new_versions Array[String]()
        var new_sources Array[String]()
        var new_root "packages/`name`/`next`/`name`.scaly"
        Modeler.declared_packages(new_root, &new_names, &new_versions, &new_sources)
        var d: size_t 0
        while d < old_names.length
        {
            var e: size_t 0
            while e < new_names.length
            {
                if old_names.at(d).equals(new_names.at(e)) and Modeler.version_compatible(old_versions.at(d), new_versions.at(e)) = false
                {
                    gone := gone + 1
                    if gone_examples.length < 3
                        gone_examples.add("package `old_names.at(d)` `old_versions.at(d)` -> `new_versions.at(e)`: another line of a package this one declares")
                }
                e := e + 1
            }
            d := d + 1
        }
        let pm Modeler.version_part(prev, 0)
        let p1 Modeler.version_part(prev, 1)
        let nm Modeler.version_part(next, 0)
        let n1 Modeler.version_part(next, 1)
        let up_major pm + 1
        let up_minor p1 + 1
        var needs ""
        if gone > 0 and pm = 0 and nm = 0 and n1 <= p1
            needs := "0.`up_minor`.0"
        else if gone > 0 and pm > 0 and nm <= pm
            needs := "`up_major`.0.0"
        else if gone = 0 and added > 0 and pm > 0 and nm = pm and n1 <= p1
            needs := "`pm`.`up_minor`.0"
        if needs.get_length() = 0
        {
            Console.println("publish: `name` `next` is new after `prev`: `gone` declaration(s) gone or changed, `added` added")
            return true
        }
        Console.println("Error: scaly publish: `name` `next` understates what it changed since `prev`; that takes `needs` at least.")
        if gone > 0
        {
            Console.println("       `gone` declaration(s) of `prev` are gone or read differently, as (file scope| declaration):")
            tool.show_lines(&gone_examples)
        }
        else
        {
            Console.println("       `added` declaration(s) were added, as (file scope| declaration):")
            tool.show_lines(&added_examples)
        }
        if pm = 0
            Console.println("       Below 1.0 a change of what is declared takes the second number, anything else the third.")
        else
            Console.println("       A change of what is declared takes the first number, an addition the second, bodies the third.")
        false
    }

    ; ---- scaly install (stage D5) -------------------------------------------

    ; where installed programs go: $SCALY_BIN; the `bin` beside an installed
    ; toolchain (<prefix>/toolchain is its home -- it has a `libexec` --,
    ; <prefix>/bin the directory both installers put on the PATH); else
    ; ~/.scaly/bin. ★The Windows installer has no `bin` of its own (its PATH
    ; entry is toolchain\libexec, which the next install replaces), so the
    ; rule may not ask for a `scaly` IN that directory: it did, fell back to
    ; ~/.scaly/bin, and nothing had put that on the PATH (2026-10-07).
    procedure install_bin() returns String
    {
        let own getenv "SCALY_BIN"
        if own <> null
        {
            let s String(own)
            if s.get_length() > 0
                return String(own)
        }
        let base Modeler.scaly_home_base()
        var libexec "`base`libexec"
        if base.get_length() > 1 and Directory.is_directory(libexec)
        {
            ; <prefix>/toolchain/ -> <prefix>/bin: the last component goes
            var end base.get_length() - 1
            while end > 0 and base.get(end - 1) <> 47 and base.get(end - 1) <> 92
                end := end - 1
            if end > 0
                return "`base.substring(0, end)`bin"
        }
        var home getenv "HOME"
        if home = null
            home := getenv("USERPROFILE")
        if home = null
            return String("bin")
        let h String(home)
        "`h`/.scaly/bin"
    }

    ; `scaly install <source> <package> <version> [program]`: the programs a
    ; package OFFERS are the files of its `programs/` directory, each named
    ; after its file -- a package that is a library first brings as many
    ; utilities as it likes, and one may be called like the package itself.
    ; The package is fetched like any declared one (fetch_package#), each
    ; program built `--release` and laid into install_bin#. 0 when every
    ; program asked for was built.
    procedure install(source: String, name: String, version: String, only: String) returns int mutable modeler_error_count
    {
        if tool.is_project_name(name) = false
        {
            Console.println("scaly install: `name` is no package name")
            return 1
        }
        var dir Modeler.fetched_directory(source, name, version)
        if Modeler.has_package_root(dir, name) = false
            if tool.fetch_package(source, name, version, dir) = false
                return 1
        var programs_dir "`dir`/programs"
        var programs Array[String]()
        if Directory.is_directory(programs_dir)
        {
            let entries Directory.list(programs_dir)
            var e: size_t 0
            while e < entries.length
            {
                let entry entries.at e
                e := e + 1
                if entry.is_directory or entry.name.ends_with(".scaly") = false
                    continue
                let program entry.name.substring(0, entry.name.get_length() - 6)
                if only.get_length() = 0 or only.equals(program)
                    programs.add(String(program))
            }
        }
        if programs.length = 0
        {
            if only.get_length() > 0
                Console.println("scaly install: package `name` `version` of \"`source`\" offers no program `only` - its programs are the files of `programs_dir`")
            else
                Console.println("scaly install: package `name` `version` of \"`source`\" offers no programs - it has no directory programs/, it is a library")
            return 1
        }
        var bin tool.install_bin()
        if tool.ensure_directory(bin) = false
        {
            Console.println("scaly install: cannot create `bin`")
            return 1
        }
        let windows tool.triple_os(tool.target_triple(String())).equals("windows")
        var failed 0
        var k: size_t 0
        while k < programs.length
        {
            let program programs.at k
            k := k + 1
            var file "`programs_dir`/`program`.scaly"
            var seen Array[String]()
            if tool.fetch_declared(file, &seen) = false
            {
                failed := failed + 1
                continue
            }
            var out "`bin`/`program`"
            if windows
                out := "`bin`/`program`.exe"
            var o Options()
            o.input_file := String(file)
            o.output_file := String(out)
            o.tool_build := true
            o.opt_level := 2
            o.release := true
            if cli.run(o) <> 0
            {
                Console.println("scaly install: `program` did not build")
                failed := failed + 1
                continue
            }
            Console.println("installed `out`")
            tool.record_installed(bin, program, name, version, source)
        }
        if failed > 0
            return 1
        if tool.on_path(bin) = false
            Console.println("note: `bin` is not on your PATH - put it there to call what was installed by its name")
        0
    }

    ; is the directory `dir` one of $PATH's? Compared as written but for the
    ; kind of slash and, where the list is separated by `;`, the case
    procedure on_path(dir: String) returns bool
    {
        let p getenv "PATH"
        if p = null
            return false
        let path String(p)
        let windows path.contains(59 as u8)
        var sep: u8 58
        if windows
            sep := 59
        let n path.get_length()
        let dn dir.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or path.get(at) = sep
            {
                var len at - from
                ; a trailing separator on the entry does not count
                while len > 0 and (path.get(from + len - 1) = 47 or path.get(from + len - 1) = 92)
                    len := len - 1
                if len = dn
                {
                    var same true
                    var k: size_t 0
                    while k < dn and same
                    {
                        var a path.get(from + k)
                        var b dir.get(k)
                        if a = 92
                            a := 47
                        if b = 92
                            b := 47
                        if windows and a >= 65 and a <= 90
                            a := a + 32
                        if windows and b >= 65 and b <= 90
                            b := b + 32
                        if a <> b
                            same := false
                        k := k + 1
                    }
                    if same
                        return true
                }
                from := at + 1
            }
            at := at + 1
        }
        false
    }

    ; What `scaly install` put into a bin directory is written down there, in
    ; `.scaly-installed`: a line `program package version source` each. It is
    ; what `scaly install` alone lists and what `scaly uninstall` goes by --
    ; the directory holds scaly, scalyc and scalyls too, and whatever else
    ; the user put on his PATH.

    ; the record without the line of `program`, `added` behind it where it
    ; is not empty; `found` says whether there was such a line
    procedure rewrite_installed(mutable bin: String, program: String, added: String) returns bool
    {
        var record "`bin`/.scaly-installed"
        var text ""
        if File.exists(record)
            text := File.read_to_string(record)
        var found false
        var sb StringBuilder()
        let n text.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                if at > from
                {
                    let line text.substring(from, at - from)
                    if line.starts_with("`program` ")
                        found := true
                    else
                    {
                        sb.append line
                        sb.append "\n"
                    }
                }
                from := at + 1
            }
            at := at + 1
        }
        if added.get_length() > 0
        {
            sb.append added
            sb.append "\n"
        }
        File.write_from_string(record, sb.to_string())
        found
    }

    procedure record_installed(mutable bin: String, program: String, name: String, version: String, source: String)
    {
        tool.rewrite_installed(bin, program, "`program` `name` `version` `source`")
    }

    ; `scaly install` alone: what it has installed
    procedure list_installed() returns int
    {
        var bin tool.install_bin()
        var record "`bin`/.scaly-installed"
        var text ""
        if File.exists(record)
            text := File.read_to_string(record)
        if text.get_length() = 0
        {
            Console.println("scaly install has installed nothing into `bin`")
            Console.println("Usage: scaly install <source> <package> <version> [program]")
            return 0
        }
        Console.println("installed in `bin` (program, package, version, source):")
        let n text.get_length()
        var from: size_t 0
        var at: size_t 0
        while at <= n
        {
            if at = n or text.get(at) = 10
            {
                if at > from
                    Console.println("  `text.substring(from, at - from)`")
                from := at + 1
            }
            at := at + 1
        }
        0
    }

    ; `scaly uninstall <program>`: a program `scaly install` put there, and
    ; nothing else of that directory
    procedure uninstall(program: String) returns int
    {
        var bin tool.install_bin()
        var record "`bin`/.scaly-installed"
        var known false
        if File.exists(record)
        {
            let text File.read_to_string(record)
            known := text.starts_with("`program` ") or text.contains("\n`program` ")
        }
        if known = false
        {
            Console.println("scaly uninstall: `program` was not installed by scaly install into `bin` - scaly install alone lists what was")
            return 1
        }
        var file "`bin`/`program`"
        if tool.triple_os(tool.target_triple(String())).equals("windows")
            file := "`bin`/`program`.exe"
        if File.exists(file) and unlink(file.to_c_string()) <> 0
        {
            Console.println("scaly uninstall: cannot remove `file`")
            return 1
        }
        tool.rewrite_installed(bin, program, String())
        Console.println("removed `file`")
        0
    }
}
