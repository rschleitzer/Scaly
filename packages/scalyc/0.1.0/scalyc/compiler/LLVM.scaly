function LLVMBuildSelect(builder: LLVMBuilderRef, cond: LLVMValueRef, then_val: LLVMValueRef, else_val: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildExtractValue(builder: LLVMBuilderRef, agg_val: LLVMValueRef, index: int, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMBuildInsertValue(builder: LLVMBuilderRef, agg_val: LLVMValueRef, elt_val: LLVMValueRef, index: int, name: pointer[const_char]) returns LLVMValueRef extern

; ============================================================================
; Value Functions
; ============================================================================

; Get/set value name
function LLVMGetValueName2(val: LLVMValueRef, length: pointer[size_t]) returns pointer[char] extern
procedure LLVMSetValueName2(val: LLVMValueRef, name: pointer[const_char], name_len: size_t) extern

; Get type of value
function LLVMTypeOf(val: LLVMValueRef) returns LLVMTypeRef extern

; Check if value is null
function LLVMIsNull(val: LLVMValueRef) returns int extern

; Alloca instruction inspection. LLVMIsAAllocaInst returns the value if it
; is an alloca instruction, null otherwise. LLVMGetAllocatedType returns
; the type that the alloca instruction allocates (e.g., for `alloca i32`
; this returns i32). Required to distinguish ptr-typed alloca slots that
; hold a heap pointer from struct-typed alloca slots that hold a value.
function LLVMIsAAllocaInst(val: LLVMValueRef) returns LLVMValueRef extern
function LLVMGetAllocatedType(alloca: LLVMValueRef) returns LLVMTypeRef extern

; Load instruction inspection — same isa<> pattern as LLVMIsAAllocaInst.
; Used by emit_call's extern-LLVM arg unwrap (s173) to recognise a
; loaded ptr-slot value (pointer to a single-ptr wrapper struct) that
; must be dereferenced to the bare handle.
function LLVMIsALoadInst(val: LLVMValueRef) returns LLVMValueRef extern

; Function-argument inspection — same isa<> pattern. Used by emit_call's
; extern-LLVM arg unwrap to recognise a wrapper-struct PARAM (declared as
; ptr-to-struct by emit_function_decl) passed straight through to an
; extern LLVM callee, which needs the same load+extract as the s172/s173
; alloca/load cases.
function LLVMIsAArgument(val: LLVMValueRef) returns LLVMValueRef extern

; s178: use-list walking + instruction classification for the alloca
; reuse pool's escape check (Emitter.temp_value_escapes). Same isa<>
; pattern as LLVMIsAAllocaInst: returns the value when it is an
; instance of the class, null otherwise. LLVMGetOperand(store, 0) is
; the stored VALUE; operand 1 is the destination pointer.
function LLVMGetFirstUse(val: LLVMValueRef) returns LLVMUseRef extern
function LLVMGetNextUse(u: LLVMUseRef) returns LLVMUseRef extern
function LLVMGetUser(u: LLVMUseRef) returns LLVMValueRef extern
function LLVMGetOperand(val: LLVMValueRef, index: int) returns LLVMValueRef extern
function LLVMIsAStoreInst(val: LLVMValueRef) returns LLVMValueRef extern
function LLVMIsACallInst(val: LLVMValueRef) returns LLVMValueRef extern
function LLVMIsAICmpInst(val: LLVMValueRef) returns LLVMValueRef extern
function LLVMIsAGetElementPtrInst(val: LLVMValueRef) returns LLVMValueRef extern

; Operand rewriting + instruction removal, for Emitter.elide_unused_pages
; (the dead-region-frame peephole). A call's operands are its arguments
; 0..n-1 followed by the callee, so the argument count is
; LLVMGetNumOperands - 1 and LLVMGetCalledValue names the callee.
; ★The `index: int` (i64) spelling matches LLVMGetParam/LLVMGetOperand
; above rather than the i32 extern rule: all four take at most three
; arguments, so every one is register-passed and the Apple-arm64
; stack-argument corruption the rule guards against cannot arise.
; Parameter-attribute count, index 1-based over the params (0 is the return
; value). elide_unused_pages uses it as a blanket veto: a page parameter is a
; bare `ptr`, while sret/byval/noalias parameters carry attributes — and an
; unused SRET parameter (a template stub's `ret null` body never writes it) is
; exactly the one that must NOT be handed a null, since the attribute promises
; the callee a dereferenceable slot.
function LLVMGetAttributeCountAtIndex(f: LLVMValueRef, index: int) returns int extern
function LLVMGetNumOperands(val: LLVMValueRef) returns int extern
function LLVMSetOperand(user: LLVMValueRef, index: int, val: LLVMValueRef) extern
function LLVMGetCalledValue(instr: LLVMValueRef) returns LLVMValueRef extern
function LLVMInstructionEraseFromParent(inst: LLVMValueRef) extern

; s178: struct copies through memcpy instead of load+store pairs. A
; big-aggregate load materializes the whole struct as an SSA value and
; the backend allocates a spill slot for it; memcpy moves the bytes
; pointer-to-pointer with no SSA value. Bypassed loads are left in
; place (the backend prunes dead non-volatile loads for free); do NOT
; erase them — emitter-held handles may still reference the value.
function LLVMBuildMemCpy(builder: LLVMBuilderRef, dst: LLVMValueRef, dst_align: int, src: LLVMValueRef, src_align: int, size: LLVMValueRef) returns LLVMValueRef extern

; Structure type name lookup. Returns a C string (NUL-terminated) when the
; struct is named (`LLVMStructCreateNamed` + setBody), or null for anonymous
; struct types. Used in emit_tuple to discriminate source struct kinds
; (Array vs Vector vs etc.) when planning convert-constructor dispatch.
function LLVMGetStructName(struct_ty: LLVMTypeRef) returns pointer[const_char] extern

; ============================================================================
; Target Functions
; ============================================================================

; Per-target initializers (the real exported symbols).
; The convenience wrappers LLVMInitializeNativeTarget /
; LLVMInitializeAllTargets are static-inline in llvm-c/Target.h — not
; real runtime symbols, so the JIT can't resolve them. Call per-target
; initializers directly. If libLLVM was built without a given target,
; linking the extern symbol fails at link time on that host.
procedure LLVMInitializeAArch64TargetInfo() extern
procedure LLVMInitializeAArch64Target() extern
procedure LLVMInitializeAArch64TargetMC() extern
procedure LLVMInitializeAArch64AsmPrinter() extern
procedure LLVMInitializeX86TargetInfo() extern
procedure LLVMInitializeX86Target() extern
procedure LLVMInitializeX86TargetMC() extern
procedure LLVMInitializeX86AsmPrinter() extern

; Get default target triple for the host
function LLVMGetDefaultTargetTriple() returns pointer[char] extern

; Get target from triple
function LLVMGetTargetFromTriple(triple: pointer[const_char], target: pointer[LLVMTargetRef], error_message: pointer[pointer[char]]) returns int extern

; Create target machine
function LLVMCreateTargetMachine(target: LLVMTargetRef, triple: pointer[const_char], cpu: pointer[const_char], features: pointer[const_char], level: int, reloc: int, code_model: int) returns LLVMTargetMachineRef extern

; Dispose target machine
procedure LLVMDisposeTargetMachine(machine: LLVMTargetMachineRef) extern

; New-PM pass builder (llvm-c/Transforms/PassBuilder.h): run a textual
; pass pipeline (e.g. "default<O2>") over a module against a TargetMachine.
; Used by the -O flag for AOT object emission.
define LLVMPassBuilderOptionsRef(handle: pointer[void])
function LLVMCreatePassBuilderOptions() returns LLVMPassBuilderOptionsRef extern
function LLVMRunPasses(mod: LLVMModuleRef, passes: pointer[const_char], tm: LLVMTargetMachineRef, options: LLVMPassBuilderOptionsRef) returns LLVMErrorRef extern
procedure LLVMDisposePassBuilderOptions(options: LLVMPassBuilderOptionsRef) extern

; The DataLayout a target machine compiles for (caller owns the result)
function LLVMCreateTargetDataLayout(machine: LLVMTargetMachineRef) returns LLVMTargetDataRef extern

; String representation of a DataLayout (dispose with LLVMDisposeMessage)
function LLVMCopyStringRepOfTargetData(td: LLVMTargetDataRef) returns pointer[char] extern

; Dispose target data
procedure LLVMDisposeTargetData(td: LLVMTargetDataRef) extern

; Emit to file
function LLVMTargetMachineEmitToFile(machine: LLVMTargetMachineRef, mod: LLVMModuleRef, filename: pointer[const_char], codegen: int, error_message: pointer[pointer[char]]) returns int extern

