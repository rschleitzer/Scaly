; Pass Manager
; ============================================================================

; Create pass managers
function LLVMCreatePassManager() returns LLVMPassManagerRef extern
function LLVMCreateFunctionPassManagerForModule(mod: LLVMModuleRef) returns LLVMPassManagerRef extern

; Dispose pass manager
procedure LLVMDisposePassManager(pm: LLVMPassManagerRef) extern

; Run passes
function LLVMRunPassManager(pm: LLVMPassManagerRef, mod: LLVMModuleRef) returns int extern
function LLVMInitializeFunctionPassManager(fpm: LLVMPassManagerRef) returns int extern
function LLVMRunFunctionPassManager(fpm: LLVMPassManagerRef, func: LLVMValueRef) returns int extern
function LLVMFinalizeFunctionPassManager(fpm: LLVMPassManagerRef) returns int extern

; ============================================================================
; Debug Info (DWARF) — DIBuilder
; ============================================================================
;
; Bindings for the LLVM-C DebugInfo API (DebugInfo.h). Used by the Emitter
; only when EmitterConfig.emit_debug_info is true (the -g flag).
;
; C `unsigned`/`LLVMBool`/`LLVMDIFlags`/enum params are 32-bit and MUST be
; declared `i32`, NOT `int` (= i64). On Apple arm64 the stack packs 32-bit
; args into 4-byte slots; passing i64 shifts every following stack arg by
; 4 bytes, corrupting spFlags/CU flags (no DISPFlagDefinition, wrong
; splitDebugInlining). `size_t` params stay 64-bit; pointers/refs stay ptr.
; Enum values used below:
;   LLVMDWARFSourceLanguage: C89 = 1 (closest to Scaly semantics)
;   LLVMDWARFEmissionKind:   Full = 1
;   LLVMModuleFlagBehavior:  Warning = 1
;   LLVMDWARFTypeEncoding:   DW_ATE_signed = 5, DW_ATE_boolean = 2,
;                            DW_ATE_unsigned = 7
;   DEBUG_METADATA_VERSION:  3

; Module-flag plumbing (Dwarf Version / Debug Info Version).
function LLVMValueAsMetadata(val: LLVMValueRef) returns LLVMMetadataRef extern
procedure LLVMAddModuleFlag(mod: LLVMModuleRef, behavior: i32, key: pointer[const_char], key_len: size_t, val: LLVMMetadataRef) extern

; Builder lifecycle.
function LLVMCreateDIBuilder(mod: LLVMModuleRef) returns LLVMDIBuilderRef extern
procedure LLVMDIBuilderFinalize(builder: LLVMDIBuilderRef) extern

; Compile unit + file.
function LLVMDIBuilderCreateFile(builder: LLVMDIBuilderRef, filename: pointer[const_char], filename_len: size_t, directory: pointer[const_char], directory_len: size_t) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateCompileUnit(builder: LLVMDIBuilderRef, lang: i32, file_ref: LLVMMetadataRef, producer: pointer[const_char], producer_len: size_t, is_optimized: i32, flags: pointer[const_char], flags_len: size_t, runtime_ver: i32, split_name: pointer[const_char], split_name_len: size_t, kind: i32, dwo_id: i32, split_debug_inlining: i32, debug_info_for_profiling: i32, sysroot: pointer[const_char], sysroot_len: size_t, sdk: pointer[const_char], sdk_len: size_t) returns LLVMMetadataRef extern

; Functions (DISubprogram) + their subroutine type.
function LLVMDIBuilderCreateSubroutineType(builder: LLVMDIBuilderRef, file: LLVMMetadataRef, parameter_types: pointer[LLVMMetadataRef], num_parameter_types: i32, flags: i32) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateFunction(builder: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: pointer[const_char], name_len: size_t, linkage_name: pointer[const_char], linkage_name_len: size_t, file: LLVMMetadataRef, line_no: i32, ty: LLVMMetadataRef, is_local_to_unit: i32, is_definition: i32, scope_line: i32, flags: i32, is_optimized: i32) returns LLVMMetadataRef extern
procedure LLVMSetSubprogram(func: LLVMValueRef, sp: LLVMMetadataRef) extern

; Line locations.
function LLVMDIBuilderCreateDebugLocation(ctx: LLVMContextRef, line: i32, column: i32, scope: LLVMMetadataRef, inlined_at: LLVMMetadataRef) returns LLVMMetadataRef extern
procedure LLVMSetCurrentDebugLocation2(builder: LLVMBuilderRef, loc: LLVMMetadataRef) extern

; Local variables (Phase B).
function LLVMDIBuilderCreateBasicType(builder: LLVMDIBuilderRef, name: pointer[const_char], name_len: size_t, size_in_bits: size_t, encoding: i32, flags: i32) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateAutoVariable(builder: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: pointer[const_char], name_len: size_t, file: LLVMMetadataRef, line_no: i32, ty: LLVMMetadataRef, always_preserve: i32, flags: i32, align_in_bits: i32) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateExpression(builder: LLVMDIBuilderRef, addr: pointer[size_t], length: size_t) returns LLVMMetadataRef extern
function LLVMDIBuilderInsertDeclareAtEnd(builder: LLVMDIBuilderRef, storage: LLVMValueRef, var_info: LLVMMetadataRef, expr: LLVMMetadataRef, debug_loc: LLVMMetadataRef, block: LLVMBasicBlockRef) returns LLVMValueRef extern

; Aggregate types (struct/union/pointer) — for debugging struct/union locals.
; size_in_bits/offset_in_bits are uint64_t (size_t, 64-bit); line/align/flags/
; num_elements/run_time_lang/address_space/tag are 32-bit C args → i32 (see the
; Apple-arm64 packing note above). `elements` is a C array of DITypes.
function LLVMDIBuilderCreateStructType(builder: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: pointer[const_char], name_len: size_t, file: LLVMMetadataRef, line_number: i32, size_in_bits: size_t, align_in_bits: i32, flags: i32, derived_from: LLVMMetadataRef, elements: pointer[LLVMMetadataRef], num_elements: i32, run_time_lang: i32, vtable_holder: LLVMMetadataRef, unique_id: pointer[const_char], unique_id_len: size_t) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateUnionType(builder: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: pointer[const_char], name_len: size_t, file: LLVMMetadataRef, line_number: i32, size_in_bits: size_t, align_in_bits: i32, flags: i32, elements: pointer[LLVMMetadataRef], num_elements: i32, run_time_lang: i32, unique_id: pointer[const_char], unique_id_len: size_t) returns LLVMMetadataRef extern
function LLVMDIBuilderCreateMemberType(builder: LLVMDIBuilderRef, scope: LLVMMetadataRef, name: pointer[const_char], name_len: size_t, file: LLVMMetadataRef, line_no: i32, size_in_bits: size_t, align_in_bits: i32, offset_in_bits: size_t, flags: i32, ty: LLVMMetadataRef) returns LLVMMetadataRef extern
function LLVMDIBuilderCreatePointerType(builder: LLVMDIBuilderRef, pointee_ty: LLVMMetadataRef, size_in_bits: size_t, align_in_bits: i32, address_space: i32, name: pointer[const_char], name_len: size_t) returns LLVMMetadataRef extern
; Forward declaration + RAUW: breaks self-referential cycles (Node →
; pointer[Node]). Create the replaceable temp, cache it, build members
; (a back-pointer resolves to the temp), then replace it with the final type.
function LLVMDIBuilderCreateReplaceableCompositeType(builder: LLVMDIBuilderRef, tag: i32, name: pointer[const_char], name_len: size_t, scope: LLVMMetadataRef, file: LLVMMetadataRef, line: i32, runtime_lang: i32, size_in_bits: size_t, align_in_bits: i32, flags: i32, unique_id: pointer[const_char], unique_id_len: size_t) returns LLVMMetadataRef extern
procedure LLVMMetadataReplaceAllUsesWith(temp_target: LLVMMetadataRef, replacement: LLVMMetadataRef) extern

; ============================================================================
; ORC LLJIT (in-process JIT) — used by the self-hosted `--run` mode
; ============================================================================
;
; Mirrors the LLVM-C OrcEE / Orc.h API. Each handle is a single-ptr opaque
; wrapper (like LLVMContextRef etc.); LLVMOrcExecutorAddress is a bare u64
; (a runtime code address, NOT a struct). LLVMErrorRef is the LLVM-C error
; handle: a NULL handle means SUCCESS; a non-null handle is an error whose
; message is read with LLVMGetErrorMessage and which MUST be consumed with
; LLVMConsumeError (else leak/abort). See Emitter.jit_execute_int.

define LLVMOrcLLJITRef(handle: pointer[void])
define LLVMOrcLLJITBuilderRef(handle: pointer[void])
define LLVMOrcJITDylibRef(handle: pointer[void])
define LLVMOrcThreadSafeContextRef(handle: pointer[void])
define LLVMOrcThreadSafeModuleRef(handle: pointer[void])
define LLVMOrcDefinitionGeneratorRef(handle: pointer[void])
define LLVMOrcJITTargetMachineBuilderRef(handle: pointer[void])
define LLVMErrorRef(handle: pointer[void])

; ThreadSafeContext: the module being JITted MUST be built in the LLVMContext
; owned by the ThreadSafeContext, otherwise addIRModule crashes. So we create
; the TSC first, take its underlying LLVMContextRef as the emitter's context,
; build the module, then wrap it back into a ThreadSafeModule.
function LLVMOrcCreateNewThreadSafeContext() returns LLVMOrcThreadSafeContextRef extern
function LLVMOrcThreadSafeContextGetContext(tsc: LLVMOrcThreadSafeContextRef) returns LLVMContextRef extern
function LLVMOrcCreateNewThreadSafeModule(m: LLVMModuleRef, tsc: LLVMOrcThreadSafeContextRef) returns LLVMOrcThreadSafeModuleRef extern

; LLJIT lifecycle. Pass a null builder handle to LLVMOrcCreateLLJIT for the
; default builder (host target machine, -O2 codegen). Returns LLVMErrorRef.
function LLVMOrcCreateLLJIT(result: pointer[LLVMOrcLLJITRef], builder: LLVMOrcLLJITBuilderRef) returns LLVMErrorRef extern

; -O0 JIT: the default builder (null) uses -O2 codegen. To force a codegen
; opt level, build an LLJITBuilder around a JITTargetMachineBuilder made from
; an explicit TargetMachine (LLVMCreateTargetMachine with level = None = 0).
; CreateFromTargetMachine consumes the TM; SetJITTargetMachineBuilder consumes
; the JTMB; CreateLLJIT consumes the builder.
function LLVMOrcCreateLLJITBuilder() returns LLVMOrcLLJITBuilderRef extern
function LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(tm: LLVMTargetMachineRef) returns LLVMOrcJITTargetMachineBuilderRef extern
procedure LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(builder: LLVMOrcLLJITBuilderRef, jtmb: LLVMOrcJITTargetMachineBuilderRef) extern
function LLVMOrcLLJITGetMainJITDylib(j: LLVMOrcLLJITRef) returns LLVMOrcJITDylibRef extern
function LLVMOrcLLJITGetGlobalPrefix(j: LLVMOrcLLJITRef) returns char extern

; Process-symbol generator: resolves libc symbols (malloc/free/write/
; aligned_alloc/exit) referenced by the JITted RBMM runtime against the host
; process. filter/filter_ctx are null (accept all). Returns LLVMErrorRef.
function LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(result: pointer[LLVMOrcDefinitionGeneratorRef], global_prefix: char, filter: pointer[void], filter_ctx: pointer[void]) returns LLVMErrorRef extern
procedure LLVMOrcJITDylibAddGenerator(jd: LLVMOrcJITDylibRef, g: LLVMOrcDefinitionGeneratorRef) extern

; Add the module (consumes the ThreadSafeModule) + look up a symbol. Lookup
; writes the resolved address into *result; pass the IR symbol name WITHOUT a
; leading global prefix (ORC applies the prefix itself). Returns LLVMErrorRef.
function LLVMOrcLLJITAddLLVMIRModule(j: LLVMOrcLLJITRef, jd: LLVMOrcJITDylibRef, tsm: LLVMOrcThreadSafeModuleRef) returns LLVMErrorRef extern
; Add a relocatable object file (dependency package, AOT-compiled through the
; known-good root path) to a JITDylib. CONSUMES the memory buffer. The object's
; linkonce_odr/weak symbols become resolvable across the dylib, so the program
; module's extern declarations of dependency-package functions link against the
; real bodies instead of the null-returning jit stub. Returns LLVMErrorRef.
function LLVMOrcLLJITAddObjectFile(j: LLVMOrcLLJITRef, jd: LLVMOrcJITDylibRef, objbuf: LLVMMemoryBufferRef) returns LLVMErrorRef extern
; Load a file into a MemoryBuffer (used to hand a dep-package object to the
; JIT). Returns an LLVMBool (0 = success); writes the buffer to *out.
function LLVMCreateMemoryBufferWithContentsOfFile(path: pointer[const_char], out: pointer[LLVMMemoryBufferRef], msg: pointer[pointer[char]]) returns int extern
; LLVMOrcExecutorAddress is a bare u64 (a runtime code address), so the
; result is pointer[u64], NOT a wrapper-struct pointer.
function LLVMOrcLLJITLookup(j: LLVMOrcLLJITRef, result: pointer[u64], name: pointer[const_char]) returns LLVMErrorRef extern

; Error handling. A null LLVMErrorRef handle = success.
function LLVMGetErrorMessage(e: LLVMErrorRef) returns pointer[char] extern
procedure LLVMConsumeError(e: LLVMErrorRef) extern
procedure LLVMDisposeErrorMessage(msg: pointer[char]) extern

