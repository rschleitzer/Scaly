; Modeler.scaly - Syntax to semantic model transformation
; Ported from retired proto-Scaly Modeler.scaly

package scaly 0.1.0

use scaly.memory.root_pages.getenv
; scaly.io imports are load-bearing beyond visibility: the use alias
; feeds the dotted-call extern-decl gate (typed declarations for
; cross-package File./Path. calls instead of varargs fallbacks).
use scaly.os.File
use scaly.os.Path
use scaly.os.Console

use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyc.compiler.Model.*

; Count of sub-module load failures (a `module foo` / package / prelude whose
; file failed to PARSE). build_referenced_module used to swallow such a parse
; error and return an empty stub module, so the real syntax error vanished and
; re-surfaced downstream as a misleading planner "not found" in the wrong file.
; It now reports the real error against the sub-module's own file:line:col and
; bumps this counter; cli.run checks Modeler.had_errors() after build_program
; and fails the compile (rc 2) before the planner runs. Module scope (mutable
; globals are rejected inside a namespace body).
mutable modeler_error_count: size_t 0


define Modeler
{
    ; ============================================================================
    ; Literal/Constant handling
    ; ============================================================================

    ; libc float parsing for FloatingPointLiteral (exact, correctly rounded;
    ; a hand-rolled digit walk would accumulate error).
    ; `endptr` is `char **` in C, not `void *`. dazzle/Interpreter.scaly declares
    ; the same symbol `pointer[pointer[u8]]`; two declarations of one C symbol
    ; must not disagree (tests/abi/run.sh check 3 cannot see it -- both lower to
    ; a bare `ptr`).
    function strtod(nptr: pointer[const_char], endptr: pointer[pointer[u8]]) returns double extern

    ; Decode the escape sequences the lexer validated in a string literal's
    ; raw payload: \" \\ \' \n \r \t \0 and \uXXXX (UTF-8 encoded). A literal
    ; without a backslash returns the payload unchanged.
    function decode_escapes(raw: String) returns String
    {
        let len raw.get_length()
        let buf raw.as_slice()
        var has_escape false
        var scan: size_t 0
        while scan < len
        {
            if buf[scan] = 92
                set has_escape: true
            set scan: scan + 1
        }
        if has_escape = false
            return raw

        var sb StringBuilder()
        var i: size_t 0
        while i < len
        {
            let b buf[i]
            if b <> 92
            {
                sb.append(b as char)
                set i: i + 1
            }
            else
            {
                ; The lexer only emits a string token when every escape is
                ; one of " \ ' n r t 0 or \uXXXX, so buf[i + 1] exists.
                let e buf[i + 1]
                if e = 110
                    sb.append("\n" as char)
                if e = 116
                    sb.append("\t" as char)
                if e = 114
                    sb.append("\r" as char)
                if e = 48
                    sb.append(0 as char)
                if e = 34
                    sb.append("\"" as char)
                if e = 39
                    sb.append("'" as char)
                if e = 92
                    sb.append("\\" as char)
                if e = 96
                    sb.append("\`" as char)
                if e = 117
                {
                    ; \uXXXX - four lexer-validated hex digits to a code
                    ; point, then UTF-8 (plain arithmetic, no bit ops).
                    var cp: size_t 0
                    var k: size_t 0
                    while k < 4
                    {
                        let h buf[i + 2 + k]
                        var d: size_t 0
                        if h <= 57
                            set d: (h - 48) as size_t
                        if h >= 97
                            set d: ((h - 97) as size_t) + 10
                        if h >= 65
                        {
                            if h <= 70
                                set d: ((h - 65) as size_t) + 10
                        }
                        set cp: cp * 16 + d
                        set k: k + 1
                    }
                    if cp < 128
                        sb.append(cp as char)
                    else
                    {
                        if cp < 2048
                        {
                            sb.append((192 + cp / 64) as char)
                            sb.append((128 + (cp - (cp / 64) * 64)) as char)
                        }
                        else
                        {
                            sb.append((224 + cp / 4096) as char)
                            sb.append((128 + (cp / 64 - (cp / 4096) * 64)) as char)
                            sb.append((128 + (cp - (cp / 64) * 64)) as char)
                        }
                    }
                    set i: i + 4
                }
                set i: i + 2
            }
        }
        sb.to_string()
    }

    procedure handle_literal(mutable syntax: LiteralSyntax) returns Constant
    {
        let loc Span(syntax.start, syntax.end)
        choose syntax.literal
            when str: StringLiteral
                Constant.String(StringConstant(loc, decode_escapes(str.value)))
            when chr: CharacterLiteral
                Constant.Character(CharacterConstant(loc, chr.value))
            when frag: FragmentLiteral
                Constant.Fragment(FragmentConstant(loc, frag.value))
            when int_lit: IntegerLiteral
            {
                var value: size_t 0
                let buf int_lit.value.as_slice()
                let len int_lit.value.get_length()
                var i: size_t 0
                while i < len
                {
                    let byte buf[i]
                    set value: value * 10 + ((byte - 48) as size_t)
                    set i: i + 1
                }
                Constant.Integer(IntegerConstant(loc, value))
            }
            when bool_lit: BooleanLiteral
                Constant.Boolean(BooleanConstant(loc, bool_lit.value))
            when float_lit: FloatingPointLiteral
            {
                ; Parse the decimal text (was hardcoded 0.0 — every float
                ; literal in a program compiled to zero).
                let float_text float_lit.value
                let float_cstr float_text.to_c_string()
                let float_val strtod(float_cstr, null as pointer[pointer[u8]])
                Constant.FloatingPoint(FloatingPointConstant(loc, float_val))
            }
            when hex_lit: HexLiteral
            {
                ; Token includes the 0x prefix; 'x' decodes as 0 which is harmless
                ; since only a 0 has been accumulated before it (strtoull parity).
                var value: size_t 0
                let buf hex_lit.value.as_slice()
                let len hex_lit.value.get_length()
                var i: size_t 0
                while i < len
                {
                    let byte buf[i]
                    var digit: size_t 0
                    if (byte >= 48) && (byte <= 57)
                        set digit: (byte - 48) as size_t
                    if (byte >= 65) && (byte <= 70)
                        set digit: (byte - 55) as size_t
                    if (byte >= 97) && (byte <= 102)
                        set digit: (byte - 87) as size_t
                    set value: value * 16 + digit
                    set i: i + 1
                }
                Constant.Hex(HexConstant(loc, value))
            }
            else
                Constant.Integer(IntegerConstant(loc, 0))
    }

    ; ============================================================================
    ; Lifetime handling
    ; ============================================================================

    function handle_lifetime(syntax: ref[LifetimeSyntax]?) returns Lifetime
    {
        if syntax = null
            return Lifetime.Unspecified(Unspecified())

        let lifetime_syntax (*syntax)
        choose lifetime_syntax
            when call: CallSyntax
                Lifetime.Call(Call(Span(call.start, call.end)))
            when ref: ReferenceSyntax
                Lifetime.Reference(Reference(Span(ref.start, ref.end), ref.location))
            when thrown: ThrownSyntax
                Lifetime.Thrown(Thrown(Span(thrown.start, thrown.end)))
            else
                Lifetime.Unspecified(Unspecified())
    }

    ; ============================================================================
    ; Type handling
    ; ============================================================================

    function handle_type(syntax: TypeSyntax) returns ref[Type]?
    {
        ; Count extensions to determine path size
        var ext_count: size_t 0
        if syntax.name.extensions <> null
            set ext_count: (*syntax.name.extensions).length

        ; Create path with correct size
        var path Vector[String](1 + ext_count)
        path.put(0, syntax.name.name)

        ; Add extensions
        if syntax.name.extensions <> null
        {
            let exts (*syntax.name.extensions)
            var i: size_t 0
            while i < exts.length
            {
                let ext_ptr exts.get i
                if ext_ptr <> null
                {
                    let ext (*ext_ptr)
                    path.put(1 + i, ext.name)
                }
                set i: i + 1
            }
        }

        var generics: ref[Vector[Type]]? null
        if syntax.generics <> null
        {
            let gen_args_syntax (*syntax.generics)
            if gen_args_syntax.generics <> null
            {
                let gen_syns (*gen_args_syntax.generics)
                var gen_types Vector[Type](gen_syns.length)
                var gi: size_t 0
                while gi < gen_syns.length
                {
                    let ga_ptr gen_syns.get gi
                    if ga_ptr <> null
                    {
                        let ga (*ga_ptr)
                        let inner_type handle_type(ga.type)
                        if inner_type <> null
                            gen_types.put(gi, *inner_type)

                    }
                    set gi: gi + 1
                }
                var gens_holder Vector[Vector[Type]](1)
                gens_holder.put(0, gen_types)
                set generics: gens_holder.get(0)
            }
        }

        let life handle_lifetime syntax.lifetime
        let base_type Type(Span(syntax.start, syntax.end), path, generics, life)

        ; s113: wrap optional types (T?) in Option[T], mirroring stage-0
        ; Modeler.cpp:228-238. Without this, Vector.get's return type
        ; `ref[T]?` stays as Type{Name=["ref"]} — needs_implicit_return_page
        ; sees "ref" as primitive and skips the implicit page param.
        ; Stage-0 sees `Option[ref[T]]` (RetName="Option", not primitive) and
        ; adds the implicit page, producing the mangle that libscaly.a
        ; defines. Required for ref_string_item to link.
        if syntax.optional = null
            return base_type

        var inner_holder Vector[Type](1)
        inner_holder.put(0, base_type)
        var inner_path Vector[String](1)
        inner_path.put(0, "Option")
        Type(
            Span(syntax.start, syntax.end),
            inner_path,
            inner_holder,
            Lifetime.Unspecified(Unspecified())
        )
    }

    function handle_binding_annotation(annotation: BindingAnnotationSyntax) returns ref[Type]?
    {
        choose annotation.spec
            when type_syntax: TypeSyntax
                handle_type(type_syntax)
            else
                null
    }

    ; ============================================================================
    ; Object/Tuple handling
    ; ============================================================================

    procedure handle_object(mutable syntax: ObjectSyntax) returns Tuple mutable modeler_error_count
    {
        var count: size_t 0
        if syntax.components <> null
            set count: (*syntax.components).length

        var components Vector[Component](count)
        if syntax.components <> null
        {
            let comps (*syntax.components)
            var i: size_t 0
            while i < comps.length
            {
                let comp_ptr comps.get i
                if comp_ptr <> null
                {
                    let comp_syntax (*comp_ptr)
                    let component handle_component(comp_syntax)
                    components.put(i, component)
                }
                set i: i + 1
            }
        }
        Tuple(Span(syntax.start, syntax.end), components)
    }

    procedure handle_component(mutable syntax: ComponentSyntax) returns Component mutable modeler_error_count
    {
        var name: ref[String]? null
        var operands handle_operands(syntax.operands)

        if syntax.value <> null
        {
            let val_syntax (*syntax.value)
            set operands: handle_operands(val_syntax.value)

            ; Extract name from operands if present
            if syntax.operands <> null
            {
                let name_ops (*syntax.operands)
                if name_ops.length > 0
                {
                    let name_op_ptr name_ops.get 0
                    if name_op_ptr <> null
                    {
                        let name_op (*name_op_ptr)
                        ; ★★★ The arm is `Name`, not `Type`. This `choose`
                        ; asked for `TypeSyntax` from the day it was written
                        ; and a bare identifier in operand position is
                        ; `ExpressionSyntax.Name` -- so the extraction was
                        ; DEAD, every `T(field: value)` reached the planner
                        ; unnamed, and the construction path filled it
                        ; positionally without a word. Measured 2026-09-03:
                        ; `Rec(gamma: 3, alpha: 1, beta: 2)` answered `3 1 2`.
                        choose name_op.expression
                            when name_expr: NameSyntax
                                set name: String(name_expr.name)
                            else {}
                    }
                }
            }
        }

        Component(
            Span(syntax.start, syntax.end),
            name,
            operands,
            Vector[Attribute](0)
        )
    }

    ; ============================================================================
    ; Vector/Matrix handling
    ; ============================================================================

    ; wrap_row_in_option: `[<row>?]` -> the operand row for `Option[<row>]`.
    ; Two cells, which is the shape a nested generic argument already has:
    ; a bare Type naming Option, then a Matrix holding the original row as its
    ; single row. Static because it builds only from its arguments.
    function wrap_row_in_option(row: Vector[Operand], span: Span) returns Vector[Operand]
    {
        var inner_rows Vector[Vector[Operand]](1)
        inner_rows.put(0, row)
        var path Vector[String](1)
        path.put(0, "Option")
        var cells Array[Operand]()
        cells.add(Operand(
            span,
            Expression.Type(Type(span, path, null, Lifetime.Unspecified(Unspecified()))),
            null
        ))
        cells.add(Operand(
            span,
            Expression.Matrix(Matrix(span, inner_rows, Lifetime.Unspecified(Unspecified()))),
            null
        ))
        Vector[Operand](cells)
    }

    procedure handle_vector(mutable syntax: VectorSyntax) returns Matrix mutable modeler_error_count
    {
        var count: size_t 0
        if syntax.elements <> null
            set count: (*syntax.elements).length

        var operations Vector[Vector[Operand]](count)
        if syntax.elements <> null
        {
            let elems (*syntax.elements)
            var i: size_t 0
            while i < elems.length
            {
                let elem_ptr elems.get i
                if elem_ptr <> null
                {
                    let element (*elem_ptr)
                    let ops handle_operands(element.operation)
                    ; s195: a bracket element may carry the `?` sigil, so a
                    ; GENERIC ARGUMENT in expression position can name an
                    ; optional type -- `Array[ref[Leaf]?]^page()`. The parser
                    ; reads `[...]` in that position as a VECTOR LITERAL whose
                    ; elements are OPERANDS, not as a GenericArguments list
                    ; (only the planner's s107 merge turns the row back into a
                    ; Type), so the `?` had nowhere to attach and the same type
                    ; that every DECLARATION position accepts was a parse error
                    ; here -- `expected ']'`. Every other spelling worked: the
                    ; field, the parameter, the annotated local, and the
                    ; desugared `Array[Option[ref[Leaf]]]` even in this very
                    ; position, which is what made it a wart rather than a
                    ; limit.
                    ;
                    ; It desugars rather than travelling as a flag: the row
                    ; becomes `[Type(Option), Matrix([row])]`, which is exactly
                    ; the nested-generic shape extract_row_to_type# already
                    ; rebuilds. So Model, Plan and Planner need no change at
                    ; all, and this mirrors handle_type#'s own s113 wrap one
                    ; level down -- same reason, same Option, same comment
                    ; lineage.
                    if element.optional = null
                        operations.put(i, ops)
                    if element.optional <> null
                        operations.put(i, Modeler.wrap_row_in_option(ops, Span(syntax.start, syntax.end)))
                }
                set i: i + 1
            }
        }
        let life handle_lifetime syntax.lifetime
        Matrix(Span(syntax.start, syntax.end), operations, life)
    }

    ; ============================================================================
    ; Block handling
    ; ============================================================================

    procedure handle_block(mutable syntax: BlockSyntax) returns Block mutable modeler_error_count
    {
        let statements handle_statements(syntax.statements)
        Block(Span(syntax.start, syntax.end), statements)
    }

    ; ============================================================================
    ; String interpolation
    ; ============================================================================

    ; True iff a string literal's raw payload contains an unescaped backtick —
    ; the marker that embeds an expression ("The answer is `n`!"). Escape-aware:
    ; a backslash consumes the following byte, so an escaped backtick never
    ; triggers interpolation.
    function string_has_interpolation(raw: String) returns bool
    {
        let len raw.get_length()
        let buf raw.as_slice()
        var i: size_t 0
        while i < len
        {
            let b buf[i]
            if b = 96
                return true
            if b = 92
                set i: i + 2
            else
                set i: i + 1
        }
        false
    }

    ; Desugar an interpolated string literal into the block callers write by
    ; hand today:
    ;     {
    ;         let 'isb$' StringBuilder()
    ;         'isb$'.append("The answer is ")
    ;         'isb$'.append((my_answer))
    ;         'isb$'.append("!")
    ;         'isb$'.to_string()
    ;     }
    ; The synthesized source re-parses and models like user code, so embedded
    ; expressions get full planner treatment and StringBuilder.append overloads
    ; pick the conversion by type (String, char, pointer[const_char], int,
    ; size_t, bool). Literal segments embed VERBATIM — their escapes decode
    ; later when the sub-parsed literal runs through handle_literal. The builder
    ; name is a string identifier so an embedded expression can never resolve to
    ; it by accident. On a malformed payload the error is reported through
    ; modeler_error_count (cli fails the compile) and the literal is returned
    ; verbatim so modeling continues.
    procedure handle_interpolated_string(mutable syntax: LiteralSyntax, raw: String) returns Expression mutable modeler_error_count
    {
        let len raw.get_length()
        let buf raw.as_slice()

        ; Validation walk: backticks must pair up, no embedded expression is
        ; empty, and inside an expression only the \" \\ \' escapes (plus an
        ; escaped backtick) are meaningful — they decode below so embedded
        ; string literals work; \n and friends have no place in expression
        ; source.
        var in_expr false
        var seg_len: size_t 0
        var bad_escape false
        var empty_expr false
        var i: size_t 0
        while i < len
        {
            let b buf[i]
            if b = 96
            {
                if in_expr
                {
                    if seg_len = 0
                        set empty_expr: true
                    set in_expr: false
                }
                else
                    set in_expr: true
                set seg_len: 0
                set i: i + 1
            }
            else
            {
                if b = 92
                {
                    if in_expr
                    {
                        let e buf[i + 1]
                        var ok_escape false
                        if e = 34
                            set ok_escape: true
                        if e = 92
                            set ok_escape: true
                        if e = 39
                            set ok_escape: true
                        if e = 96
                            set ok_escape: true
                        if ok_escape = false
                            set bad_escape: true
                    }
                    set i: i + 2
                }
                else
                    set i: i + 1
                set seg_len: seg_len + 1
            }
        }
        if in_expr
        {
            report_load_error(String("string interpolation: unterminated embedded expression (escape a literal backtick with a backslash)"))
            return Expression.Constant(handle_literal syntax)
        }
        if empty_expr
        {
            report_load_error(String("string interpolation: empty embedded expression"))
            return Expression.Constant(handle_literal syntax)
        }
        if bad_escape
        {
            report_load_error(String("string interpolation: only quote, backslash and backtick escapes are valid inside an embedded expression"))
            return Expression.Constant(handle_literal syntax)
        }

        ; Build the block source. Boundaries are unescaped backticks plus the
        ; end of the payload; segments alternate literal/expression.
        var src StringBuilder()
        src.append("{\n")
        src.append("let 'isb$' StringBuilder()\n")

        var seg_start: size_t 0
        set in_expr: false
        set i: 0
        var done false
        while done = false
        {
            var is_end false
            if i >= len
                set is_end: true
            var is_tick false
            if is_end = false
            {
                let b buf[i]
                if b = 96
                    set is_tick: true
                else
                {
                    if b = 92
                        set i: i + 2
                    else
                        set i: i + 1
                }
            }
            var boundary is_end
            if is_tick
                set boundary: true
            if boundary
            {
                if in_expr
                {
                    src.append("'isb$'.append((")
                    var k seg_start
                    while k < i
                    {
                        let eb buf[k]
                        if eb = 92
                        {
                            ; Validated above: decode so embedded string
                            ; literals arrive unescaped in the sub-source.
                            src.append((buf[k + 1]) as char)
                            set k: k + 2
                        }
                        else
                        {
                            ; A raw newline would split the synthesized
                            ; statement — expressions are one line anyway.
                            if eb = 10
                                src.append(" " as char)
                            else
                            {
                                if eb = 13
                                    src.append(" " as char)
                                else
                                    src.append(eb as char)
                            }
                            set k: k + 1
                        }
                    }
                    src.append("))\n")
                    set in_expr: false
                }
                else
                {
                    if i > seg_start
                    {
                        src.append("'isb$'.append(\"")
                        var k seg_start
                        while k < i
                        {
                            src.append((buf[k]) as char)
                            set k: k + 1
                        }
                        ; ONE character (`/`, or one escape like `\n`) goes in
                        ; through the char overload, as a hand-written builder
                        ; spells it (`append("/" as char)`); the String overload
                        ; is the slower one (2026-09-25)
                        var one_char false
                        if i - seg_start = 1 and buf[seg_start] <> 92
                            set one_char: true
                        if i - seg_start = 2 and buf[seg_start] = 92
                            set one_char: true
                        if one_char
                            src.append("\" as char)\n")
                        else
                            src.append("\")\n")
                    }
                    set in_expr: true
                }
                if is_end
                    set done: true
                else
                {
                    set i: i + 1
                    set seg_start: i
                }
            }
        }
        src.append("'isb$'.to_string()\n}\n")

        let src_str src.to_string()
        var p Parser(src_str)
        choose p.parse_expression()
            when err: Error
            {
                report_load_error(String("string interpolation: cannot parse embedded expression"))
                return Expression.Constant(handle_literal syntax)
            }
            when node: Success
                return handle_expression(node)
        Expression.Constant(handle_literal syntax)
    }

    ; ============================================================================
    ; Expression handling
    ; ============================================================================

    procedure handle_expression(mutable syntax: ExpressionSyntax) returns Expression mutable modeler_error_count
    {
        choose syntax
            when lit: LiteralSyntax
            {
                choose lit.literal
                    when strlit: StringLiteral
                    {
                        if string_has_interpolation(strlit.value)
                            return handle_interpolated_string(lit, strlit.value)
                    }
                    else {}
                Expression.Constant(handle_literal lit)
            }
            when name_syntax: NameSyntax
            {
                ; Bare `true` / `false` identifiers (no extensions) map to
                ; Boolean constants. Mirrors stage-0 Modeler treatment: the
                ; lexer doesn't tokenize them as BooleanLiteral, so we
                ; recognise the name here.
                if name_syntax.extensions = null
                {
                    let loc Span(name_syntax.start, name_syntax.end)
                    if name_syntax.name = "true"
                        return Expression.Constant(Constant.Boolean(BooleanConstant(loc, true)))
                    if name_syntax.name = "false"
                        return Expression.Constant(Constant.Boolean(BooleanConstant(loc, false)))
                }

                ; Convert NameSyntax to Type expression
                ; Count extensions to determine path size
                var ext_count: size_t 0
                if name_syntax.extensions <> null
                    set ext_count: (*name_syntax.extensions).length

                var path Vector[String](1 + ext_count)
                path.put(0, name_syntax.name)

                if name_syntax.extensions <> null
                {
                    let exts (*name_syntax.extensions)
                    var i: size_t 0
                    while i < exts.length
                    {
                        let ext_ptr exts.get i
                        if ext_ptr <> null
                        {
                            let ext (*ext_ptr)
                            path.put(1 + i, ext.name)
                        }
                        set i: i + 1
                    }
                }

                Expression.Type(Type(
                    Span(name_syntax.start, name_syntax.end),
                    path,
                    null,
                    Lifetime.Unspecified(Unspecified())
                ))
            }
            when obj: ObjectSyntax
                Expression.Tuple(handle_object(obj))
            when vec: VectorSyntax
                Expression.Matrix(handle_vector(vec))
            when blk: BlockSyntax
                Expression.Block(handle_block(blk))
            when if_syntax: IfSyntax
                Expression.If(handle_if(if_syntax))
            when match_syntax: MatchSyntax
                Expression.Match(handle_match(match_syntax))
            when choose_syntax: ChooseSyntax
                Expression.Choose(handle_choose(choose_syntax))
            when for_syntax: ForSyntax
                Expression.For(handle_for(for_syntax))
            when while_syntax: WhileSyntax
                Expression.While(handle_while(while_syntax))
            when try_syntax: TrySyntax
                Expression.Try(handle_try(try_syntax))
            when sizeof_syntax: SizeOfSyntax
                Expression.SizeOf(handle_sizeof(sizeof_syntax))
            when alignof_syntax: AlignOfSyntax
                Expression.AlignOf(handle_alignof(alignof_syntax))
            when is_syntax: IsSyntax
                Expression.Is(handle_is(is_syntax))
            when as_syntax: AsSyntax
                Expression.As(handle_as(as_syntax))
            when lam_syntax: LambdaSyntax
                Expression.Lambda(handle_lambda(lam_syntax))
            when rep_syntax: RepeatSyntax
                Expression.Repeat(handle_repeat(rep_syntax))
            when life_syntax: LifetimeSyntax
            {
                ; Lifetime operand (`#`/`$`/`^name` written next to a
                ; preceding NameSyntax — e.g. `cli.parse_args#`). Stage-1's
                ; parser emits this as its own ExpressionSyntax variant,
                ; not baked into the preceding TypeSyntax. Mirror stage-0's
                ; `Type with empty Name and non-Unspecified Life` marker
                ; (Planner.cpp:7378-7387) so the Planner's call-detection
                ; pre-pass can recognise the pattern and strip the
                ; lifetime operand. handle_lifetime decodes the variant
                ; into a Model.Lifetime.
                var life_holder Vector[LifetimeSyntax](1)
                life_holder.put(0, life_syntax)
                let life_ref life_holder.get 0
                let model_life handle_lifetime life_ref
                Expression.Type(Type(
                    Span(0, 0),
                    Vector[String](0),
                    null,
                    model_life
                ))
            }
            else
                Expression.Constant(Constant.Integer(IntegerConstant(Span(0, 0), 0)))
    }

    function handle_as(syntax: AsSyntax) returns scaly.compiler.Model.As
    {
        let target handle_type(syntax.type)
        var target_ty: Type Type(
            Span(syntax.start, syntax.end),
            Vector[String](0),
            null,
            Lifetime.Unspecified(Unspecified())
        )
        if target <> null
            set target_ty: (*target)

        scaly.compiler.Model.As(
            Span(syntax.start, syntax.end),
            target_ty
        )
    }

    ; Lambda: each input operand should be a simple name; we build an Item
    ; per operand with no type annotation (type inferred from context).
    procedure handle_lambda(mutable syntax: LambdaSyntax) returns Lambda mutable modeler_error_count
    {
        var input Vector[Item](0)
        if syntax.input <> null
        {
            let ops (*syntax.input)
            set input: Vector[Item](ops.length)
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    var param_name: String ""
                    choose op.expression
                        when name_syn: NameSyntax
                            set param_name: String(name_syn.name)
                        else
                            set param_name: ""
                    var name_holder Vector[String](1)
                    name_holder.put(0, String(param_name))
                    input.put(i, Item(
                        Span(op.start, op.end),
                        false,
                        name_holder.get 0,
                        null,
                        Vector[Attribute](0)
                    ))
                }
                set i: i + 1
            }
        }

        let body handle_action(syntax.block)

        Lambda(
            Span(syntax.start, syntax.end),
            input,
            body
        )
    }

    procedure handle_repeat(mutable syntax: RepeatSyntax) returns Repeat mutable modeler_error_count
    {
        let body handle_action(syntax.action)
        var repeat_label: String ""
        if syntax.name <> null
            set repeat_label: (*syntax.name).name
        Repeat(
            Span(syntax.start, syntax.end),
            body,
            repeat_label
        )
    }

    ; ============================================================================
    ; Control flow handling
    ; ============================================================================

    procedure handle_if(mutable syntax: IfSyntax) returns If mutable modeler_error_count
    {
        let condition handle_operands(syntax.condition)
        let cons_stmt handle_command(syntax.consequent.statement)

        ; Else is optional: a no-else `if` is if-without-else, identical to a guard.
        var alternative: ref[Statement]? null
        if syntax.alternative <> null
        {
            let else_syntax (*syntax.alternative)
            let alt_stmt handle_command(else_syntax.alternative)
            set alternative: Statement(alt_stmt)
        }

        If(
            Span(syntax.start, syntax.end),
            condition,
            null,
            cons_stmt,
            alternative
        )
    }

    procedure handle_match(mutable syntax: MatchSyntax) returns Match mutable modeler_error_count
    {
        let scrutinee handle_operands(syntax.scrutinee)

        var branch_count: size_t 0
        if syntax.branches <> null
            set branch_count: (*syntax.branches).length

        var branches Vector[Branch](branch_count)
        if syntax.branches <> null
        {
            let brs (*syntax.branches)
            var i: size_t 0
            while i < brs.length
            {
                let br_ptr brs.get i
                if br_ptr <> null
                {
                    let branch_syntax (*br_ptr)
                    let branch handle_branch(branch_syntax)
                    branches.put(i, branch)
                }
                set i: i + 1
            }
        }

        var alternative: ref[Statement]? null
        if syntax.alternative <> null
        {
            let else_syntax (*syntax.alternative)
            let alt_stmt handle_command(else_syntax.alternative)
            set alternative: Statement(alt_stmt)
        }

        Match(
            Span(syntax.start, syntax.end),
            scrutinee,
            branches,
            alternative
        )
    }

    procedure handle_branch(mutable syntax: BranchSyntax) returns Branch mutable modeler_error_count
    {
        var case_count: size_t 0
        if syntax.cases <> null
            set case_count: (*syntax.cases).length

        var cases Vector[Case](case_count)
        if syntax.cases <> null
        {
            let cs (*syntax.cases)
            var i: size_t 0
            while i < cs.length
            {
                let case_ptr cs.get i
                if case_ptr <> null
                {
                    let case_syntax (*case_ptr)
                    let case_ handle_case(case_syntax)
                    cases.put(i, case_)
                }
                set i: i + 1
            }
        }

        let stmt handle_statement(syntax.consequent)
        Branch(Span(syntax.start, syntax.end), cases, stmt)
    }

    procedure handle_case(mutable syntax: CaseSyntax) returns Case mutable modeler_error_count
    {
        let condition handle_operands(syntax.condition)
        Case(Span(syntax.start, syntax.end), condition)
    }

    procedure handle_choose(mutable syntax: ChooseSyntax) returns Choose mutable modeler_error_count
    {
        let condition handle_operands(syntax.condition)

        var case_count: size_t 0
        if syntax.cases <> null
            set case_count: (*syntax.cases).length

        var cases Vector[When](case_count)
        if syntax.cases <> null
        {
            let cs (*syntax.cases)
            var i: size_t 0
            while i < cs.length
            {
                let when_ptr cs.get i
                if when_ptr <> null
                {
                    let when_syntax (*when_ptr)
                    let when_ handle_when(when_syntax)
                    cases.put(i, when_)
                }
                set i: i + 1
            }
        }

        var alternative: ref[Statement]? null
        if syntax.alternative <> null
        {
            let else_syntax (*syntax.alternative)
            let alt_stmt handle_command(else_syntax.alternative)
            set alternative: Statement(alt_stmt)
        }

        Choose(
            Span(syntax.start, syntax.end),
            condition,
            cases,
            alternative
        )
    }

    procedure handle_when(mutable syntax: WhenSyntax) returns When mutable modeler_error_count
    {
        ; syntax.variant is a NameSyntax — build the full variant_path
        ; including extensions so dotted paths (`when u: a.b.Union`) keep
        ; the variant name as the last segment. Mirrors Modeler.cpp
        ; handleWhen (lines 903-909); same idiom as handle_type# above.
        var ext_count: size_t 0
        if syntax.variant.extensions <> null
            set ext_count: (*syntax.variant.extensions).length

        var variant_path Vector[String](1 + ext_count)
        variant_path.put(0, syntax.variant.name)

        if syntax.variant.extensions <> null
        {
            let exts (*syntax.variant.extensions)
            var i: size_t 0
            while i < exts.length
            {
                let ext_ptr exts.get i
                if ext_ptr <> null
                {
                    let ext (*ext_ptr)
                    variant_path.put(1 + i, ext.name)
                }
                set i: i + 1
            }
        }

        let stmt handle_command(syntax.statement)
        When(
            Span(syntax.start, syntax.end),
            syntax.name,
            variant_path,
            stmt
        )
    }

    procedure handle_action(mutable syntax: ActionSyntax) returns Action mutable modeler_error_count
    {
        choose syntax
            when op: OperationSyntax
                Action(handle_operands(op.operands), Vector[Operand](0))
            when set_syntax: SetSyntax
                Action(handle_operands(set_syntax.source), handle_operands(set_syntax.target))
            else
                Action(Vector[Operand](0), Vector[Operand](0))
    }

    procedure handle_for(mutable syntax: ForSyntax) returns For mutable modeler_error_count
    {
        let expr handle_operands(syntax.operation)
        let body handle_action(syntax.action)
        var for_label: String ""
        if syntax.name <> null
            set for_label: (*syntax.name).name

        For(
            Span(syntax.start, syntax.end),
            syntax.variable,
            expr,
            body,
            for_label
        )
    }

    procedure handle_while(mutable syntax: WhileSyntax) returns While mutable modeler_error_count
    {
        let cond handle_condition(syntax.condition)
        let body handle_action(syntax.action)
        var while_label: String ""
        if syntax.name <> null
            set while_label: (*syntax.name).name

        While(
            Span(syntax.start, syntax.end),
            cond,
            body,
            while_label
        )
    }

    procedure handle_condition(mutable syntax: ConditionSyntax) returns Binding mutable modeler_error_count
    {
        choose syntax
            when op: OperationSyntax
            {
                let operands handle_operands(op.operands)
                Binding(
                    Span(op.start, op.end),
                    "const",
                    Item(Span(op.start, op.end), false, null, null, Vector[Attribute](0)),
                    operands
                )
            }
            when let_syntax: LetSyntax
            {
                let item handle_binding_item(let_syntax.binding)
                let operation handle_operands(let_syntax.binding.operation)
                Binding(
                    Span(let_syntax.start, let_syntax.end),
                    "const",
                    item,
                    operation
                )
            }
            else
                Binding(Span(0, 0), "const", Item(Span(0, 0), false, null, null, Vector[Attribute](0)), Vector[Operand](0))
    }

    procedure handle_try(mutable syntax: TrySyntax) returns Try mutable modeler_error_count
    {
        let cond handle_condition(syntax.condition)

        var catch_count: size_t 0
        if syntax.cases <> null
            set catch_count: (*syntax.cases).length

        var catches Vector[When](catch_count)
        if syntax.cases <> null
        {
            let cs (*syntax.cases)
            var i: size_t 0
            while i < cs.length
            {
                let when_ptr cs.get i
                if when_ptr <> null
                {
                    let when_syntax (*when_ptr)
                    let when_ handle_when(when_syntax)
                    catches.put(i, when_)
                }
                set i: i + 1
            }
        }

        var dropper: ref[Statement]? null
        if syntax.dropper <> null
        {
            let else_syntax (*syntax.dropper)
            let drop_stmt handle_command(else_syntax.alternative)
            set dropper: Statement(drop_stmt)
        }

        Try(
            Span(syntax.start, syntax.end),
            cond,
            catches,
            dropper
        )
    }

    ; ============================================================================
    ; Type operation handling
    ; ============================================================================

    function handle_sizeof(syntax: SizeOfSyntax) returns SizeOf
    {
        let sized_type handle_type(syntax.type)
        SizeOf(Span(syntax.start, syntax.end), *sized_type)
    }

    function handle_alignof(syntax: AlignOfSyntax) returns scaly.compiler.Model.AlignOf
    {
        let aligned_type handle_type(syntax.type)
        scaly.compiler.Model.AlignOf(Span(syntax.start, syntax.end), *aligned_type)
    }

    function handle_is(syntax: IsSyntax) returns Is
    {
        ; Count extensions
        var ext_count: size_t 0
        if syntax.name.extensions <> null
            set ext_count: (*syntax.name.extensions).length

        var name Vector[String](1 + ext_count)
        name.put(0, syntax.name.name)

        if syntax.name.extensions <> null
        {
            let exts (*syntax.name.extensions)
            var i: size_t 0
            while i < exts.length
            {
                let ext_ptr exts.get i
                if ext_ptr <> null
                {
                    let ext (*ext_ptr)
                    name.put(1 + i, ext.name)
                }
                set i: i + 1
            }
        }
        Is(Span(syntax.start, syntax.end), name)
    }

    ; ============================================================================
    ; Operand handling
    ; ============================================================================

    procedure handle_operand(mutable syntax: OperandSyntax) returns Operand mutable modeler_error_count
    {
        let expr handle_expression(syntax.expression)

        var member_access: ref[Vector[String]]? null
        if syntax.members <> null
        {
            let members (*syntax.members)
            ; s177: a MemberAccessSyntax carries a dotted NameSyntax —
            ; `(*p).name.equals(x)` parses as ONE member whose name is
            ; "name" with extensions ["equals"]. Flatten name + extensions
            ; into individual hops. Mirrors Modeler.cpp nameToType (Path =
            ; name + extensions); without this the trailing method hop is
            ; dropped and the whole statement silently vanishes. Array+add
            ; (no pre-count) — a counting pass with nested derefs read
            ; garbage lengths under stage-2.
            var path_arr Array[String]()
            var i: size_t 0
            while i < members.length
            {
                let member_ptr members.get i
                if member_ptr <> null
                {
                    let member (*member_ptr)
                    path_arr.add member.name.name
                    if member.name.extensions <> null
                    {
                        let exts (*member.name.extensions)
                        var ei: size_t 0
                        while ei < exts.length
                        {
                            let ext_ptr exts.get ei
                            if ext_ptr <> null
                            {
                                let ext (*ext_ptr)
                                path_arr.add ext.name
                            }
                            set ei: ei + 1
                        }
                    }
                }
                set i: i + 1
            }
            var path Vector[String](path_arr)
            var path_holder Vector[Vector[String]](1)
            path_holder.put(0, path)
            set member_access: path_holder.get(0)
        }

        Operand(Span(syntax.start, syntax.end), expr, member_access)
    }

    procedure handle_operands(mutable syntax: ref[Vector[OperandSyntax]]?) returns Vector[Operand] mutable modeler_error_count
    {
        if syntax = null
            return Vector[Operand](0)

        let syn (*syntax)
        var result Vector[Operand](syn.length)
        var i: size_t 0
        while i < syn.length
        {
            let op_ptr syn.get i
            if op_ptr <> null
            {
                let operand_syntax (*op_ptr)
                let operand handle_operand(operand_syntax)
                result.put(i, operand)
            }
            set i: i + 1
        }
        result
    }

    procedure handle_operation(mutable syntax: OperationSyntax) returns Vector[Operand] mutable modeler_error_count
        handle_operands(syntax.operands)

    ; ============================================================================
    ; Statement handling
    ; ============================================================================

    function handle_binding_item(syntax: BindingSyntax) returns Item
    {
        var item_type: ref[Type]? null
        if syntax.annotation <> null
        {
            let annotation (*syntax.annotation)
            set item_type: handle_binding_annotation(annotation)
        }

        var name_holder Vector[String](1)
        name_holder.put(0, String(syntax.name))
        Item(
            Span(syntax.start, syntax.end),
            false,
            name_holder.get 0,
            item_type,
            Vector[Attribute](0)
        )
    }

    procedure handle_command(mutable syntax: StatementSyntax) returns Statement mutable modeler_error_count
    {
        choose syntax
            when op: OperationSyntax
            {
                let operands handle_operands(op.operands)
                Statement.Action(Action(operands, Vector[Operand](0)))
            }
            when let_syntax: LetSyntax
            {
                let item handle_binding_item(let_syntax.binding)
                let operation handle_operands(let_syntax.binding.operation)
                Statement.Binding(Binding(
                    Span(let_syntax.start, let_syntax.end),
                    "const",
                    item,
                    operation
                ))
            }
            when var_syntax: VarSyntax
            {
                let item handle_binding_item(var_syntax.binding)
                let operation handle_operands(var_syntax.binding.operation)
                Statement.Binding(Binding(
                    Span(var_syntax.start, var_syntax.end),
                    "var",
                    item,
                    operation
                ))
            }
            when mut_syntax: MutableSyntax
            {
                let item handle_binding_item(mut_syntax.binding)
                let operation handle_operands(mut_syntax.binding.operation)
                Statement.Binding(Binding(
                    Span(mut_syntax.start, mut_syntax.end),
                    "mutable",
                    item,
                    operation
                ))
            }
            when set_syntax: SetSyntax
            {
                let target handle_operands(set_syntax.target)
                let source handle_operands(set_syntax.source)
                Statement.Action(Action(source, target))
            }
            when break_syntax: BreakSyntax
            {
                let result handle_operands(break_syntax.result)
                var break_label: String ""
                if break_syntax.name <> null
                    set break_label: (*break_syntax.name).name
                Statement.Break(Break(Span(break_syntax.start, break_syntax.end), result, break_label))
            }
            when continue_syntax: ContinueSyntax
            {
                var continue_label: String ""
                if continue_syntax.name <> null
                    set continue_label: (*continue_syntax.name).name
                Statement.Continue(Continue(Span(continue_syntax.start, continue_syntax.end), continue_label))
            }
            when return_syntax: ReturnSyntax
            {
                let result handle_operands(return_syntax.result)
                Statement.Return(Return(Span(return_syntax.start, return_syntax.end), result))
            }
            when throw_syntax: ThrowSyntax
            {
                let result handle_operands(throw_syntax.result)
                Statement.Throw(Throw(Span(throw_syntax.start, throw_syntax.end), result))
            }
            else
                Statement.Action(Action(Vector[Operand](0), Vector[Operand](0)))
    }

    procedure handle_statement(mutable syntax: StatementSyntax) returns Statement mutable modeler_error_count
        handle_command(syntax)

    procedure handle_statements(mutable syntax: ref[Vector[StatementSyntax]]?) returns Vector[Statement] mutable modeler_error_count
    {
        if syntax = null
            return Vector[Statement](0)

        let stmts (*syntax)

        ; EmptySyntax is a blank-line marker the parser emits between real
        ; statements; it carries no value, and admitting it as a trailing void
        ; Action would clobber the block's last-value tracking. Mirrors
        ; Modeler.cpp:564-565. OperationSyntax with embedded statement-like
        ; operands may also produce multiple Actions, so the final count is
        ; unknown — collect into an Array, freeze to a Vector at the end.
        var result Array[Statement]()
        var i: size_t 0
        while i < stmts.length
        {
            let stmt_ptr stmts.get i
            if stmt_ptr <> null
            {
                let stmt_syntax (*stmt_ptr)
                choose stmt_syntax
                    when e: EmptySyntax {}
                    when op: OperationSyntax
                    {
                        var did_split: bool false
                        if op.operands <> null
                        {
                            let ops_ref op.operands
                            let ops_val (*ops_ref)
                            if ops_val.length > 1
                            {
                                var stmt_like_count: size_t 0
                                var c: size_t 0
                                while c < ops_val.length
                                {
                                    let op_ptr ops_val.get c
                                    if op_ptr <> null
                                    {
                                        let oe (*op_ptr)
                                        if is_statement_like_expression(oe.expression)
                                            set stmt_like_count: stmt_like_count + 1
                                    }
                                    set c: c + 1
                                }
                                if stmt_like_count > 0
                                {
                                    ; Pre-model all operands once.
                                    var all_operands Vector[Operand](ops_val.length)
                                    var ai: size_t 0
                                    while ai < ops_val.length
                                    {
                                        let op_ptr2 ops_val.get ai
                                        if op_ptr2 <> null
                                        {
                                            let oe2 (*op_ptr2)
                                            let modelled handle_operand(oe2)
                                            all_operands.put(ai, modelled)
                                        }
                                        set ai: ai + 1
                                    }
                                    ; Group: each stmt-like operand closes its
                                    ; group. Operands after the last stmt-like
                                    ; form a tail group.
                                    var groups_emitted: size_t 0
                                    var group_start: size_t 0
                                    var bi: size_t 0
                                    while bi < ops_val.length
                                    {
                                        let op_ptr3 ops_val.get bi
                                        if op_ptr3 <> null
                                        {
                                            let oe3 (*op_ptr3)
                                            if is_statement_like_expression(oe3.expression)
                                            {
                                                let group_size bi - group_start + 1
                                                var group_ops Vector[Operand](group_size)
                                                var gi: size_t 0
                                                while gi < group_size
                                                {
                                                    let opp all_operands.get(group_start + gi)
                                                    if opp <> null
                                                        group_ops.put(gi, *opp)
                                                    set gi: gi + 1
                                                }
                                                result.add(Statement.Action(Action(group_ops, Vector[Operand](0))))
                                                set groups_emitted: groups_emitted + 1
                                                set group_start: bi + 1
                                            }
                                        }
                                        set bi: bi + 1
                                    }
                                    if group_start < ops_val.length
                                    {
                                        let tail_size ops_val.length - group_start
                                        var tail_ops Vector[Operand](tail_size)
                                        var ti: size_t 0
                                        while ti < tail_size
                                        {
                                            let opp2 all_operands.get(group_start + ti)
                                            if opp2 <> null
                                                tail_ops.put(ti, *opp2)
                                            set ti: ti + 1
                                        }
                                        result.add(Statement.Action(Action(tail_ops, Vector[Operand](0))))
                                        set groups_emitted: groups_emitted + 1
                                    }
                                    if groups_emitted > 1
                                        set did_split: true
                                }
                            }
                        }
                        if did_split = false
                        {
                            let stmt handle_statement(stmt_syntax)
                            result.add stmt
                        }
                    }
                    else
                    {
                        let stmt handle_statement(stmt_syntax)
                        result.add stmt
                    }
            }
            set i: i + 1
        }
        Vector[Statement](result)
    }

    function is_statement_like_expression(expr: ExpressionSyntax) returns bool
    {
        choose expr
            when c: ChooseSyntax true
                when ifs: IfSyntax true
                    when m: MatchSyntax true
                        when w: WhileSyntax true
                            when f: ForSyntax true
                                when t: TrySyntax true
                                    when r: RepeatSyntax true
                                        when b: BlockSyntax true
                                            else false
    }

    ; ============================================================================
    ; Item and Property handling
    ; ============================================================================

    function handle_item(is_private: bool, syntax: ItemSyntax) returns Item
    {
        var item_type: ref[Type]? null
        if syntax.annotation <> null
        {
            let annotation (*syntax.annotation)
            set item_type: handle_type(annotation.type)
        }

        var name_holder Vector[String](1)
        name_holder.put(0, String(syntax.name))
        ; `mutable` before a parameter (R1): the procedure may write what it
        ; reaches. Carried as an attribute, so no Item consumer changes shape.
        if syntax.writable <> null
        {
            let w (*syntax.writable)
            var marks Vector[Attribute](1)
            marks.put(0, Attribute(Span(w.start, w.end), String("mutable"), Model.Constant(Constant.Boolean(BooleanConstant(Span(w.start, w.end), true)))))
            return Item(
                Span(syntax.start, syntax.end),
                is_private,
                name_holder.get 0,
                item_type,
                marks
            )
        }
        Item(
            Span(syntax.start, syntax.end),
            is_private,
            name_holder.get 0,
            item_type,
            Vector[Attribute](0)
        )
    }

    procedure handle_property(is_private: bool, mutable syntax: PropertySyntax) returns Property mutable modeler_error_count
    {
        let prop_type handle_type(syntax.annotation.type)

        var initializer: ref[Vector[Operand]]? null
        if syntax.initializer <> null
        {
            let init_syntax (*syntax.initializer)
            let ops handle_operands(init_syntax.operands)
            var holder Vector[Vector[Operand]](1)
            holder.put(0, ops)
            set initializer: holder.get(0)
        }

        ; `var` before a property (R2, 2026-09-20): the field may be written
        ; after its object is published. Without it a property is `let`: set
        ; in `init`, and while the object is still the constructing frame's
        ; own. Carried as an attribute named "var", so no Property consumer
        ; changes shape; an explicit `let` is the default spelled out.
        if syntax.mutability <> null
        {
            let mu (*syntax.mutability)
            choose mu
                when v: VariableSyntax
                {
                    var marks Vector[Attribute](1)
                    marks.put(0, Attribute(Span(v.start, v.end), String("var"), Model.Constant(Constant.Boolean(BooleanConstant(Span(v.start, v.end), true)))))
                    return Property(
                        Span(syntax.start, syntax.end),
                        is_private,
                        syntax.name,
                        prop_type,
                        initializer,
                        marks
                    )
                }
                else
                    0
        }
        Property(
            Span(syntax.start, syntax.end),
            is_private,
            syntax.name,
            prop_type,
            initializer,
            Vector[Attribute](0)
        )
    }

    ; ============================================================================
    ; Attribute handling
    ; ============================================================================

    procedure handle_attribute(mutable syntax: AttributeSyntax) returns Attribute mutable modeler_error_count
    {
        let model_result handle_model(syntax.model)

        Attribute(
            Span(syntax.start, syntax.end),
            syntax.name,
            model_result
        )
    }

    procedure handle_model(mutable syntax: ModelSyntax) returns Model mutable modeler_error_count
    {
        choose syntax
            when lit: LiteralSyntax
                Model.Constant(handle_literal lit)
            when name: NameSyntax
                Model.Variable name.name
            when obj: ObjectSyntax
                Model.Tuple(handle_object(obj))
            when vec: VectorSyntax
                Model.Matrix(handle_vector(vec))
            else
                Model.Variable ""
    }

    ; ============================================================================
    ; Use handling
    ; ============================================================================

    function handle_use(syntax: UseSyntax) returns Use
    {
        ; Count extensions
        var ext_count: size_t 0
        if syntax.name.extensions <> null
            set ext_count: (*syntax.name.extensions).length

        var path Vector[String](1 + ext_count)
        path.put(0, syntax.name.name)

        if syntax.name.extensions <> null
        {
            let exts (*syntax.name.extensions)
            var i: size_t 0
            while i < exts.length
            {
                let ext_ptr exts.get i
                if ext_ptr <> null
                {
                    let ext (*ext_ptr)
                    path.put(1 + i, ext.name)
                }
                set i: i + 1
            }
        }

        Use(Span(syntax.start, syntax.end), path)
    }

    ; ============================================================================
    ; Generic parameter handling
    ; ============================================================================

    function handle_generic_parameter(syntax: GenericParameterSyntax) returns GenericParameter
    {
        GenericParameter(
            Span(syntax.start, syntax.end),
            syntax.name,
            Vector[Attribute](0)
        )
    }

    ; ============================================================================
    ; Parameter handling
    ; ============================================================================

    ; Model a `define NAME delegate(params) returns T throws E` concept (GAP B).
    ; The delegate names a function (closure) type; the parameter Items and the
    ; return type drive both lambda monomorphization against this signature and the
    ; LLVM function type used at indirect call sites.
    function handle_delegate(name: String, syntax: DelegateSyntax) returns Delegate
    {
        let loc Span(syntax.start, syntax.end)
        var input Vector[Item](0)
        if syntax.parameters <> null
        {
            let params (*syntax.parameters)
            set input: handle_parameter_set(params)
        }
        var return_type: ref[Type]? null
        if syntax.result <> null
        {
            let returns_syntax (*syntax.result)
            set return_type: handle_type(returns_syntax.type)
        }
        var throws_type: ref[Type]? null
        if syntax.error <> null
        {
            let throws_syntax (*syntax.error)
            set throws_type: handle_type(throws_syntax.type)
        }
        Delegate(loc, String(name), input, return_type, throws_type)
    }

    function handle_parameter_set(syntax: ParameterSetSyntax) returns Vector[Item]
    {
        choose syntax
            when params: ParametersSyntax
            {
                if params.items = null
                    return Vector[Item](0)

                let items (*params.items)
                var result Vector[Item](items.length)
                var i: size_t 0
                while i < items.length
                {
                    let item_ptr items.get i
                    if item_ptr <> null
                    {
                        let item_syn (*item_ptr)
                        let item handle_item(false, item_syn)
                        result.put(i, item)
                    }
                    set i: i + 1
                }
                result
            }
            when type_syn: TypeSyntax
            {
                let type_result handle_type(type_syn)
                var result Vector[Item](1)
                result.put(0, Item(
                    Span(type_syn.start, type_syn.end),
                    false,
                    null,
                    type_result,
                    Vector[Attribute](0)
                ))
                result
            }
            else
                Vector[Item](0)
    }

    ; ============================================================================
    ; Implementation handling
    ; ============================================================================

    procedure handle_implementation(mutable syntax: ImplementationSyntax) returns Implementation mutable modeler_error_count
    {
        choose syntax
            when act: ActionSyntax
                Implementation.Action(handle_action(act))
            when ext: ExternSyntax
                Implementation.Extern(Extern(Span(ext.start, ext.end)))
            when inst: InstructionSyntax
                Implementation.Instruction(Instruction(Span(inst.start, inst.end)))
            when intr: IntrinsicSyntax
                Implementation.Intrinsic(Intrinsic(Span(intr.start, intr.end)))
            when lk: LinkedSyntax
                Implementation.Linked(Linked(Span(lk.start, lk.end)))
            else
                Implementation.Action(Action(Vector[Operand](0), Vector[Operand](0)))
    }

    ; ============================================================================
    ; Function building
    ; ============================================================================

    procedure build_function(start: size_t, end_pos: size_t, mutable syntax: TargetSyntax, is_private: bool, pure: bool) returns Function mutable modeler_error_count
    {
        choose syntax
            when named: NamedSyntax
            {
                var input Vector[Item](0)
                if named.routine.parameters <> null
                {
                    let params (*named.routine.parameters)
                    set input: handle_parameter_set(params)
                }

                var return_type: ref[Type]? null
                if named.routine.returns_ <> null
                {
                    let returns_syntax (*named.routine.returns_)
                    set return_type: handle_type(returns_syntax.type)
                }

                var throws_type: ref[Type]? null
                if named.routine.throws_ <> null
                {
                    let throws_syntax (*named.routine.throws_)
                    set throws_type: handle_type(throws_syntax.type)
                }

                let life handle_lifetime named.routine.lifetime
                let impl handle_implementation(named.routine.implementation)

                ; function# (Lifetime=Call): the routine takes the caller's
                ; page, IMPLICITLY -- the slot is `_rp` (a leading `_` cannot
                ; start an identifier, so user code can never name it). The
                ; caller page never interferes with the explicit parameters
                ; (2026-09-25): a first parameter named `page`/`rp` is not
                ; peeled any more, with the sigil or without it; a typeless one
                ; is reported by the planner (report_declared_caller_page#).
                var page_param: ref[String]? null
                var final_input: Vector[Item] input
                choose life
                    when c: Call
                    {
                        var holder Vector[String](1)
                        holder.put(0, "_rp")
                        set page_param: holder.get(0)
                    }
                    else
                        0

                ; Extract generic parameter names from syntax.generics if
                ; present. Each GenericArgument's TypeSyntax is a bare
                ; name — we pull it out and build a GenericParameter.
                var gen_params Vector[GenericParameter](0)
                if named.routine.generics <> null
                {
                    let g_syn (*named.routine.generics)
                    if g_syn.generics <> null
                    {
                        let g_list (*g_syn.generics)
                        var gp_arr Vector[GenericParameter](g_list.length)
                        var gi: size_t 0
                        while gi < g_list.length
                        {
                            let ga_ptr g_list.get gi
                            if ga_ptr <> null
                            {
                                let ga (*ga_ptr)
                                gp_arr.put(gi, GenericParameter(
                                    Span(ga.start, ga.end),
                                    ga.type.name.name,
                                    Vector[Attribute](0)
                                ))
                            }
                            set gi: gi + 1
                        }
                        set gen_params: gp_arr
                    }
                }

                ; `mutable g1, g2` after the signature: the globals it writes.
                ; `io` before it -- the procedure talks to the world outside the
                ; program -- joins the list as the name `io`, which no global
                ; can carry because `io` is a keyword: the check treats the
                ; outside world as one more global
                var writes Vector[String](0)
                var n_io: size_t 0
                if named.routine.io_mark <> null
                    set n_io: 1
                var n_named: size_t 0
                var n_more: size_t 0
                if named.routine.writes <> null
                {
                    set n_named: 1
                    let w_more (*named.routine.writes).more
                    if w_more <> null
                        set n_more: w_more.length
                }
                if n_io + n_named > 0
                {
                    var w_arr Vector[String](n_io + n_named + n_more)
                    if n_io > 0
                        w_arr.put(0, String("io"))
                    if named.routine.writes <> null
                    {
                        let w_syn (*named.routine.writes)
                        w_arr.put(n_io, String(w_syn.name))
                        var wi: size_t 0
                        while wi < n_more
                        {
                            let wg_ptr w_syn.more.get wi
                            if wg_ptr <> null
                                w_arr.put(n_io + wi + 1, String((*wg_ptr).name))
                            set wi: wi + 1
                        }
                    }
                    set writes: w_arr
                }

                ; `@page true` and friends after the parameter list: the facts a
                ; generated interface declares for a `linked` routine
                var routine_attrs Vector[Attribute](0)
                if named.routine.attributes <> null
                {
                    let ra_vec (*named.routine.attributes)
                    set routine_attrs: Vector[Attribute](ra_vec.length)
                    var rai: size_t 0
                    while rai < ra_vec.length
                    {
                        let ra_ptr ra_vec.get rai
                        if ra_ptr <> null
                        {
                            let ra_syntax (*ra_ptr)
                            routine_attrs.put(rai, handle_attribute(ra_syntax))
                        }
                        set rai: rai + 1
                    }
                }

                ; `reads g1, g2`: the changeable globals it reads (an
                ; interface declares it for a `linked` procedure)
                var read_list Vector[String](0)
                if named.routine.reads_clause <> null
                {
                    let r_syn (*named.routine.reads_clause)
                    var r_more: size_t 0
                    if r_syn.more <> null
                        set r_more: r_syn.more.length
                    var r_arr Vector[String](r_more + 1)
                    r_arr.put(0, String(r_syn.name))
                    var ri: size_t 0
                    while ri < r_more
                    {
                        let rg_ptr r_syn.more.get ri
                        if rg_ptr <> null
                            r_arr.put(ri + 1, String((*rg_ptr).name))
                        set ri: ri + 1
                    }
                    set read_list: r_arr
                }

                Function(
                    Span(start, end_pos),
                    is_private,
                    pure,
                    named.name,
                    gen_params,
                    page_param,
                    final_input,
                    return_type,
                    throws_type,
                    life,
                    impl,
                    writes,
                    read_list,
                    routine_attrs
                )
            }
            else
                Function(
                    Span(start, end_pos),
                    is_private,
                    pure,
                    "",
                    Vector[GenericParameter](0),
                    null,
                    Vector[Item](0),
                    null,
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    Implementation.Action(Action(Vector[Operand](0), Vector[Operand](0))),
                    Vector[String](0),
                    Vector[String](0),
                    Vector[Attribute](0)
                )
    }

    ; ============================================================================
    ; Operator handling
    ; ============================================================================

    procedure handle_operator(mutable syntax: OperatorSyntax, is_private: bool) returns Operator mutable modeler_error_count
    {
        choose syntax.target
            when named: NamedSyntax
            {
                var input Vector[Item](0)
                if named.routine.parameters <> null
                {
                    let params (*named.routine.parameters)
                    set input: handle_parameter_set(params)
                }

                var return_type: ref[Type]? null
                if named.routine.returns_ <> null
                {
                    let returns_syntax (*named.routine.returns_)
                    set return_type: handle_type(returns_syntax.type)
                }

                var throws_type: ref[Type]? null
                if named.routine.throws_ <> null
                {
                    let throws_syntax (*named.routine.throws_)
                    set throws_type: handle_type(throws_syntax.type)
                }

                let impl handle_implementation(named.routine.implementation)

                ; Extract generic parameters from named.routine.generics.
                var op_gen_params Vector[GenericParameter](0)
                if named.routine.generics <> null
                {
                    let g_syn (*named.routine.generics)
                    if g_syn.generics <> null
                    {
                        let g_list (*g_syn.generics)
                        var gp_arr Vector[GenericParameter](g_list.length)
                        var gi: size_t 0
                        while gi < g_list.length
                        {
                            let ga_ptr g_list.get gi
                            if ga_ptr <> null
                            {
                                let ga (*ga_ptr)
                                gp_arr.put(gi, GenericParameter(
                                    Span(ga.start, ga.end),
                                    ga.type.name.name,
                                    Vector[Attribute](0)
                                ))
                            }
                            set gi: gi + 1
                        }
                        set op_gen_params: gp_arr
                    }
                }

                Operator(
                    Span(syntax.start, syntax.end),
                    is_private,
                    named.name,
                    op_gen_params,
                    input,
                    return_type,
                    throws_type,
                    impl
                )
            }
            when routine: RoutineSyntax
            {
                ; Handle index operator []
                var input Vector[Item](0)
                if routine.parameters <> null
                {
                    let params (*routine.parameters)
                    set input: handle_parameter_set(params)
                }

                var return_type: ref[Type]? null
                if routine.returns_ <> null
                {
                    let returns_syntax (*routine.returns_)
                    set return_type: handle_type(returns_syntax.type)
                }

                var throws_type: ref[Type]? null
                if routine.throws_ <> null
                {
                    let throws_syntax (*routine.throws_)
                    set throws_type: handle_type(throws_syntax.type)
                }

                let impl handle_implementation(routine.implementation)

                Operator(
                    Span(syntax.start, syntax.end),
                    is_private,
                    "[]",
                    Vector[GenericParameter](0),
                    input,
                    return_type,
                    throws_type,
                    impl
                )
            }
            else
                Operator(
                    Span(syntax.start, syntax.end),
                    is_private,
                    "",
                    Vector[GenericParameter](0),
                    Vector[Item](0),
                    null,
                    null,
                    Implementation.Action(Action(Vector[Operand](0), Vector[Operand](0)))
                )
    }

    ; ============================================================================
    ; Initializer handling
    ; ============================================================================

    procedure handle_initializer(mutable syntax: InitSyntax, is_private: bool) returns Initializer mutable modeler_error_count
    {
        var input Vector[Item](0)
        if syntax.parameters <> null
        {
            let params (*syntax.parameters)
            set input: handle_parameter_set(params)
        }

        ; init# (Lifetime=Call): the implicit caller page `_rp`, and no
        ; parameter is peeled -- see handle_function's note (2026-09-25).
        var page_param: ref[String]? null
        var final_input: Vector[Item] input
        if syntax.lifetime <> null
        {
            let lt_syn (*syntax.lifetime)
            choose lt_syn
                when cs: CallSyntax
                {
                    var holder Vector[String](1)
                    holder.put(0, "_rp")
                    set page_param: holder.get(0)
                }
                else
                    0
        }

        let impl handle_implementation(syntax.implementation)

        Initializer(
            Span(syntax.start, syntax.end),
            is_private,
            page_param,
            final_input,
            impl
        )
    }

    procedure handle_deinitializer(mutable syntax: DeInitSyntax) returns ref[DeInitializer]? mutable modeler_error_count
    {
        let impl handle_implementation(syntax.implementation)

        DeInitializer(
            Span(syntax.start, syntax.end),
            impl
        )
    }

    ; ============================================================================
    ; Variant handling (for unions)
    ; ============================================================================

    function handle_variant(syntax: VariantSyntax) returns Variant
    {
        var variant_type: ref[Type]? null
        if syntax.annotation <> null
        {
            let annotation (*syntax.annotation)
            set variant_type: handle_type(annotation.type)
        }

        Variant(
            Span(syntax.start, syntax.end),
            syntax.name,
            variant_type,
            Vector[Attribute](0)
        )
    }

    ; ============================================================================
    ; Class/Structure handling
    ; ============================================================================

    procedure handle_class(name: String, mutable path: String, mutable syntax: ClassSyntax, is_private: bool) returns Structure mutable modeler_error_count
    {
        var symbols_builder HashMapBuilder[String, Nameable]()

        ; Handle parts (fields/properties)
        var property_count: size_t 0
        if syntax.structure.parts <> null
            set property_count: (*syntax.structure.parts).length

        var properties Vector[Property](property_count)
        if syntax.structure.parts <> null
        {
            let parts (*syntax.structure.parts)
            var i: size_t 0
            while i < parts.length
            {
                let part_ptr parts.get i
                if part_ptr <> null
                {
                    let part (*part_ptr)
                    choose part
                        when field: FieldSyntax
                        {
                            let property handle_property(true, field.property)
                            symbols_builder.add(property.name, Nameable.Property property)
                            properties.put(i, property)
                        }
                        when prop: PropertySyntax
                        {
                            let property handle_property(false, prop)
                            symbols_builder.add(property.name, Nameable.Property property)
                            properties.put(i, property)
                        }
                        else {}
                }
                set i: i + 1
            }
        }

        ; Handle body (inits, deinit, functions, etc.)
        var modules Vector[Module](0)
        var uses Vector[Use](0)
        var initializers Vector[Initializer](0)
        var members Vector[Member](0)
        var deinitializer: ref[DeInitializer]? null

        if syntax.body <> null
        {
            let body (*syntax.body)

            ; Handle uses
            if body.uses <> null
            {
                let use_syns (*body.uses)
                set uses: Vector[Use](use_syns.length)
                var i: size_t 0
                while i < use_syns.length
                {
                    let use_ptr use_syns.get i
                    if use_ptr <> null
                    {
                        let use_syntax (*use_ptr)
                        let use_ handle_use(use_syntax)
                        uses.put(i, use_)
                    }
                    set i: i + 1
                }
            }

            ; Handle members (inits, deinit, and other members are all in body.members)
            if body.members <> null
            {
                let member_syns (*body.members)
                let total member_syns.length
                set initializers: Vector[Initializer](total)
                set members: Vector[Member](total)
                var i: size_t 0
                var init_idx: size_t 0
                var member_idx: size_t 0
                while i < total
                {
                    let member_ptr member_syns.get i
                    if member_ptr <> null
                    {
                        let member_syntax (*member_ptr)
                        choose member_syntax
                            when init_syntax: InitSyntax
                            {
                                let init_ handle_initializer(init_syntax, false)
                                initializers.put(init_idx, init_)
                                set init_idx: init_idx + 1
                            }
                            when deinit_syntax: DeInitSyntax
                                set deinitializer: handle_deinitializer(deinit_syntax)
                            else
                            {
                                let member handle_constituent(path, member_syntax, &symbols_builder)
                                members.put(member_idx, member)
                                set member_idx: member_idx + 1
                            }
                    }
                    set i: i + 1
                }
                ; Both vectors were sized to the TOTAL member count — the split
                ; between inits, the deinit and everything else is only known
                ; while walking. Cut them back to what was actually filled: the
                ; tail slots hold uninitialized memory, and every consumer walks
                ; `length`. The initializers tail in particular was planned as a
                ; real zero-argument init, so every concept without one got a
                ; synthesized empty `C1Ev` and its constructions were diverted to
                ; the ctor path (2026-08-02).
                set initializers.length: init_idx
                set members.length: member_idx
            }
        }

        let symbols HashMap[String, Nameable](symbols_builder)

        Structure(
            Span(syntax.start, syntax.end),
            is_private,
            properties,
            modules,
            uses,
            initializers,
            deinitializer,
            members,
            symbols
        )
    }

    procedure handle_constituent(mutable path: String, mutable syntax: MemberSyntax, mutable symbols_builder: ref[HashMapBuilder[String, Nameable]]) returns Member mutable modeler_error_count
    {
        choose syntax
            when def: DefinitionSyntax
            {
                let concept handle_definition(path, def, false)
                symbols_builder.add(concept.name, Nameable.Concept concept)
                Member.Concept concept
            }
            when func: FunctionSyntax
            {
                let fn build_function(func.start, func.end, func.target, false, true)
                var fns Vector[Function](1)
                fns.put(0, fn)
                symbols_builder.add(fn.name, Nameable.Functions fns)
                Member.Function fn
            }
            when proc: ProcedureSyntax
            {
                let proc_fn build_function(proc.start, proc.end, proc.target, false, false)
                var fns Vector[Function](1)
                fns.put(0, proc_fn)
                symbols_builder.add(proc_fn.name, Nameable.Functions fns)
                Member.Function proc_fn
            }
            when op: OperatorSyntax
            {
                ; Routine-target operators (`operator [](i)` with a body) were
                ; historically DROPPED here — a stage-1-era workaround for a
                ; by-value union-variant-construction miscompile that has since
                ; been fixed. Model them like the sibling member arms so
                ; subscript dispatch (find_subscript_operator) can see them.
                let operator_ handle_operator(op, false)
                symbols_builder.add(operator_.name, Nameable.Operator operator_)
                Member.Operator operator_
            }
            when mod: ModuleSyntax
            {
                ; Modules are handled separately
                Member.Package(Vector[Module](0))
            }
            else
                Member.Package(Vector[Module](0))
    }

    ; ============================================================================
    ; Namespace handling
    ; ============================================================================

    procedure handle_namespace(name: String, mutable path: String, mutable syntax: NamespaceSyntax, is_private: bool) returns Namespace mutable modeler_error_count
    {
        var symbols_builder HashMapBuilder[String, Nameable]()
        var modules Array[Module]()
        var members Vector[Member](0)

        ; `define <ns> { module foo }` resolves to <path>/<ns>/foo.scaly so
        ; sub-modules live under a directory matching the namespace name
        ; (e.g. packages/scaly/0.1.0/scaly.scaly's `define scaly { module
        ; memory }` resolves to packages/scaly/0.1.0/scaly/memory.scaly).
        ; Skip the append when path's last component already equals name —
        ; happens when build_module# loaded a file whose define matches its
        ; own filename. Mirrors stage-0 Modeler.cpp:1864-1868.
        let last_seg Path.get_file_name(path)
        var ns_path: String path
        if last_seg <> name
            set ns_path: Path.join(path, name)

        if syntax.declarations <> null
        {
            let decl_syns (*syntax.declarations)
            set members: Vector[Member](decl_syns.length)
            var i: size_t 0
            var member_idx: size_t 0
            while i < decl_syns.length
            {
                let decl_ptr decl_syns.get i
                if decl_ptr <> null
                {
                    let decl_syntax (*decl_ptr)
                    choose decl_syntax
                        when mod_syntax: ModuleSyntax
                            handle_module_decl(ns_path, mod_syntax, is_private, &modules)
                        else
                        {
                            let member handle_declaration(ns_path, decl_syntax, &symbols_builder)
                            members.put(member_idx, member)
                            set member_idx: member_idx + 1
                        }
                }
                set i: i + 1
            }
            ; sized to the declaration count, filled only with the non-module
            ; ones — cut back to what was written (see handle_structure).
            set members.length: member_idx
        }

        let symbols HashMap[String, Nameable](symbols_builder)

        let ns_modules Vector[Module](modules)
        Namespace(
            Span(syntax.start, syntax.end),
            ns_modules,
            members,
            symbols
        )
    }

    ; global_type_or_empty: a module global's annotation, or an EMPTY type (no
    ; name) where the annotation names none — plan_untyped_global# reports it
    ; at the declaration instead of the declaration vanishing here.
    function global_type_or_empty(t: ref[Type]?, at: Span) returns Type
    {
        if t <> null
            return *t
        Type(at, Vector[String](0), null, Lifetime.Unspecified(Unspecified()))
    }

    procedure handle_declaration(mutable path: String, mutable syntax: DeclarationSyntax, mutable symbols_builder: ref[HashMapBuilder[String, Nameable]]) returns Member mutable modeler_error_count
    {
        choose syntax
            when private_syntax: PrivateSyntax
                handle_export(path, private_syntax.export_, true, symbols_builder)
            when def: DefinitionSyntax
            {
                let concept handle_definition(path, def, false)
                symbols_builder.add(concept.name, Nameable.Concept concept)
                Member.Concept concept
            }
            when func: FunctionSyntax
            {
                let fn build_function(func.start, func.end, func.target, false, true)
                var fns Vector[Function](1)
                fns.put(0, fn)
                symbols_builder.add(fn.name, Nameable.Functions fns)
                Member.Function fn
            }
            when proc: ProcedureSyntax
            {
                let proc_fn build_function(proc.start, proc.end, proc.target, false, false)
                var fns Vector[Function](1)
                fns.put(0, proc_fn)
                symbols_builder.add(proc_fn.name, Nameable.Functions fns)
                Member.Function proc_fn
            }
            when op: OperatorSyntax
            {
                let operator_ handle_operator(op, false)
                symbols_builder.add(operator_.name, Nameable.Operator operator_)
                Member.Operator operator_
            }
            when mut: MutableSyntax
            {
                ; Module-level mutable global: `mutable NAME: T init`. Modeled
                ; as a Concept wrapping a mutable Global so it flows through
                ; plan_concept → plan_global# and is emitted as a real @global
                ; with load/store reads (s189). An annotation that names no type
                ; is handed on EMPTY, and plan_global# reports it at the
                ; declaration — it used to be dropped here, rc 0.
                var mg_type_ref: ref[Type]? null
                if mut.binding.annotation <> null
                    set mg_type_ref: handle_binding_annotation(*mut.binding.annotation)
                let mg_value handle_operands(mut.binding.operation)
                let mg_global Global(Span(mut.start, mut.end), global_type_or_empty(mg_type_ref, Span(mut.start, mut.end)), mg_value, true, false, false, mut.linked_mark <> null)
                let mg_concept Concept(
                    Span(mut.start, mut.end),
                    String(mut.binding.name),
                    Vector[GenericParameter](0),
                    Vector[Attribute](0),
                    Definition.Global mg_global
                )
                symbols_builder.add(mg_concept.name, Nameable.Concept mg_concept)
                Member.Concept mg_concept
            }
            when sh: SharedSyntax
            {
                ; Module-level shared global: `shared NAME: T init`. Same shape
                ; as `mutable`, but the Global is marked is_shared — the Emitter
                ; leaves it PROCESS-global instead of thread_local. A deliberate
                ; cross-thread cell; the declarer owns the race discipline
                ; (initialize while single-threaded or mutate via scaly_atomic_*).
                var sg_type_ref: ref[Type]? null
                if sh.binding.annotation <> null
                    set sg_type_ref: handle_binding_annotation(*sh.binding.annotation)
                let sg_value handle_operands(sh.binding.operation)
                var sg_atomic false
                if sh.atomic_mark <> null
                    set sg_atomic: true
                let sg_global Global(Span(sh.start, sh.end), global_type_or_empty(sg_type_ref, Span(sh.start, sh.end)), sg_value, true, true, sg_atomic, sh.linked_mark <> null)
                let sg_concept Concept(
                    Span(sh.start, sh.end),
                    String(sh.binding.name),
                    Vector[GenericParameter](0),
                    Vector[Attribute](0),
                    Definition.Global sg_global
                )
                symbols_builder.add(sg_concept.name, Nameable.Concept sg_concept)
                Member.Concept sg_concept
            }
            when mod: ModuleSyntax
                Member.Package(Vector[Module](0))
            else
                Member.Package(Vector[Module](0))
    }

    procedure handle_export(mutable path: String, mutable syntax: ExportSyntax, is_private: bool, mutable symbols_builder: ref[HashMapBuilder[String, Nameable]]) returns Member mutable modeler_error_count
    {
        choose syntax
            when def: DefinitionSyntax
            {
                let concept handle_definition(path, def, is_private)
                symbols_builder.add(concept.name, Nameable.Concept concept)
                Member.Concept concept
            }
            when func: FunctionSyntax
            {
                let fn build_function(func.start, func.end, func.target, is_private, true)
                var fns Vector[Function](1)
                fns.put(0, fn)
                symbols_builder.add(fn.name, Nameable.Functions fns)
                Member.Function fn
            }
            when proc: ProcedureSyntax
            {
                let proc_fn build_function(proc.start, proc.end, proc.target, is_private, false)
                var fns Vector[Function](1)
                fns.put(0, proc_fn)
                symbols_builder.add(proc_fn.name, Nameable.Functions fns)
                Member.Function proc_fn
            }
            when op: OperatorSyntax
            {
                let operator_ handle_operator(op, is_private)
                symbols_builder.add(operator_.name, Nameable.Operator operator_)
                Member.Operator operator_
            }
            when mod: ModuleSyntax
                Member.Package(Vector[Module](0))
            else
                Member.Package(Vector[Module](0))
    }

    ; ============================================================================
    ; Union handling
    ; ============================================================================

    procedure handle_union(name: String, mutable path: String, mutable syntax: UnionSyntax, is_private: bool) returns Union mutable modeler_error_count
    {
        var symbols_builder HashMapBuilder[String, Nameable]()

        ; Handle variants
        var variant_count: size_t 0
        if syntax.variants <> null
            set variant_count: (*syntax.variants).length

        var variants Vector[Variant](variant_count)
        if syntax.variants <> null
        {
            let var_syns (*syntax.variants)
            var i: size_t 0
            while i < var_syns.length
            {
                let var_ptr var_syns.get i
                if var_ptr <> null
                {
                    let var_syntax (*var_ptr)
                    let variant handle_variant(var_syntax)
                    symbols_builder.add(variant.name, Nameable.Variant variant)
                    variants.put(i, variant)
                }
                set i: i + 1
            }
        }

        ; Handle body
        var members Vector[Member](0)
        if syntax.body <> null
        {
            let body (*syntax.body)
            if body.members <> null
            {
                let member_syns (*body.members)
                set members: Vector[Member](member_syns.length)
                var i: size_t 0
                while i < member_syns.length
                {
                    let member_ptr member_syns.get i
                    if member_ptr <> null
                    {
                        let member_syntax (*member_ptr)
                        let member handle_constituent(path, member_syntax, &symbols_builder)
                        members.put(i, member)
                    }
                    set i: i + 1
                }
            }
        }

        let symbols HashMap[String, Nameable](symbols_builder)

        Union(
            Span(syntax.start, syntax.end),
            is_private,
            variants,
            members,
            symbols
        )
    }

    ; ============================================================================
    ; Definition handling
    ; ============================================================================

    procedure handle_definition(mutable path: String, mutable syntax: DefinitionSyntax, is_private: bool) returns Concept mutable modeler_error_count
    {
        let name syntax.name
        let loc Span(syntax.start, syntax.end)

        ; Handle generic parameters
        var parameters Vector[GenericParameter](0)
        if syntax.parameters <> null
        {
            let params_syntax (*syntax.parameters)
            if params_syntax.parameters <> null
            {
                let param_vec (*params_syntax.parameters)
                set parameters: Vector[GenericParameter](param_vec.length)
                var i: size_t 0
                while i < param_vec.length
                {
                    let param_ptr param_vec.get i
                    if param_ptr <> null
                    {
                        let param_syntax (*param_ptr)
                        let param handle_generic_parameter(param_syntax)
                        parameters.put(i, param)
                    }
                    set i: i + 1
                }
            }
        }

        ; Handle attributes
        var attributes Vector[Attribute](0)
        if syntax.attributes <> null
        {
            let attr_vec (*syntax.attributes)
            set attributes: Vector[Attribute](attr_vec.length)
            var i: size_t 0
            while i < attr_vec.length
            {
                let attr_ptr attr_vec.get i
                if attr_ptr <> null
                {
                    let attr_syntax (*attr_ptr)
                    let attr handle_attribute(attr_syntax)
                    attributes.put(i, attr)
                }
                set i: i + 1
            }
        }

        ; Create the Definition variant based on concept type
        let definition choose syntax.concept_
        when class_syntax: ClassSyntax
        {
            let structure handle_class(name, path, class_syntax, is_private)
            Definition.Structure structure
        }
        when namespace_syntax: NamespaceSyntax
        {
            let namespace_ handle_namespace(name, path, namespace_syntax, is_private)
            Definition.Namespace namespace_
        }
        when union_syntax: UnionSyntax
        {
            let union_ handle_union(name, path, union_syntax, is_private)
            Definition.Union union_
        }
        when constant_syntax: ConstantSyntax
        {
            if constant_syntax.operation = null
            {
                ; Type alias
                let type_ref handle_type(constant_syntax.type)
                Definition.Type(*type_ref)
            }
            else
            {
                ; Global constant
                let operation handle_operands(constant_syntax.operation)
                let const_type handle_type(constant_syntax.type)
                Definition.Global(Global(loc, *const_type, operation, false, false, false, false))
            }
        }
        when intrinsic_syntax: IntrinsicSyntax
            Definition.Intrinsic(Intrinsic(Span(intrinsic_syntax.start, intrinsic_syntax.end)))
        when delegate_syntax: DelegateSyntax
        {
            let del handle_delegate(name, delegate_syntax)
            Definition.Delegate del
        }
        else
            Definition.Intrinsic(Intrinsic loc)

        Concept(loc, name, parameters, attributes, definition)
    }

    ; ============================================================================
    ; Module building
    ; ============================================================================

    ; Append a child module loaded from <path>/<name>.scaly to `modules`. The
    ; helper exists in procedure form so the choose-arm in build_module# is a
    ; single call (works around a stage-0 codegen issue where an in-place
    ; collection .add inside a choose-arm corrupts the caller's frame).
    procedure handle_module_decl(path: String, mod_syntax: ModuleSyntax, is_private: bool, mutable modules: ref[Array[Module]]) mutable modeler_error_count
    {
        let loaded build_referenced_module(path, mod_syntax.name, is_private)
        modules.add loaded
    }

    ; Format a VersionSyntax payload as "<majorMinor>.<patch>". The lexer
    ; already formatted majorMinor as "0.1" (FloatingPoint) or "0" (Integer).
    function format_version(version_ref: ref[VersionSyntax]) returns String
    {
        let v: VersionSyntax version_ref
        var sb StringBuilder()
        choose v.majorMinor
            when fp: FloatingPoint
                sb.append fp.value
            when i: Integer
                sb.append i.value
            else
                sb.append "0.1"
        sb.append("." as char)
        choose v.patch
            when i: Integer
                sb.append i.value
            else
                sb.append "0"
        sb.to_string()
    }

    ; Resolve the base directory that the `packages/` tree lives under. When the
    ; SCALY_HOME environment variable is set and non-empty, returns "<home>/" so
    ; the prelude and package modules are found relative to an installed location
    ; (the `scalyc` wrapper sets SCALY_HOME); otherwise returns "" so resolution
    ; stays relative to the current directory exactly as before. Keeping the empty
    ; case byte-identical is what makes the seed self-compile reproduce unchanged.
    procedure scaly_home_base() returns String
    {
        let home getenv "SCALY_HOME"
        if home = null
            return ""
        var home_str String(home)
        if home_str.get_length() = 0
            return ""
        "`home_str`/"
    }

    ; Try `<base>/<name>/<version>/<name>.scaly`. Returns true and writes the
    ; loaded module to `out` on success; false otherwise. Out parameter avoids
    ; constructing an "empty" Module that the caller would have to filter.
    ; A package with a generated interface (`<dir>/interface/<name>.scaly`,
    ; tools/interfaces.sh) is loaded through it: every declaration a caller
    ; needs, generic bodies included, while the other bodies are in the
    ; package's archive -- what AOT compilation used from the sources anyway.
    procedure interface_or_source(pkg_path: String, pkg_name: String) returns String
    {
        let iface_dir "`pkg_path`/interface"
        var root_path "`iface_dir`/`pkg_name`.scaly"
        if File.exists(root_path)
            return iface_dir
        pkg_path
    }

    ; A package's root file declares the packages it uses; they are loaded
    ; before it, so a program names only the packages it uses itself
    ; (ROADMAP-public.md, stage A). A root that does not parse is left to
    ; build_referenced_module#, which reports it with its location.
    procedure load_package_dependencies(mutable root_file: String, mutable packages: ref[Array[Module]], mutable versions: ref[Array[String]]) mutable modeler_error_count
    {
        if File.exists(root_file) = false
            return
        var contents File.read_to_string(root_file)
        if contents.get_length() = 0
            return
        var p Parser(contents)
        choose p.parse_program()
            when err: Error
                return
            when syntax: Success
            {
                if syntax.file.declarations = null
                    return
                let decl_syns (*syntax.file.declarations)
                var i: size_t 0
                while i < decl_syns.length
                {
                    let decl_ptr decl_syns.get i
                    if decl_ptr <> null
                    {
                        let decl_syntax (*decl_ptr)
                        choose decl_syntax
                            when pkg_syntax: PackageSyntax
                                handle_package_decl(pkg_syntax, packages, versions)
                            else
                            {
                                ; not a package
                            }
                    }
                    set i: i + 1
                }
            }
    }

    procedure handle_package_decl(pkg_syntax: PackageSyntax, mutable packages: ref[Array[Module]], mutable versions: ref[Array[String]]) mutable modeler_error_count
    {
        ; the name lives on the page of the parser that read it -- for a
        ; dependency's root (load_package_dependencies#) a page released when
        ; that root is done -- and the module keeps it, so it is copied onto
        ; the page the module goes to
        let pkg_name String#(pkg_syntax.name.name)
        var version_str "0.1.0"
        if pkg_syntax.version <> null
            set version_str: format_version(pkg_syntax.version.unwrap())

        ; A package reached twice -- declared by the program and by a package
        ; it uses -- is loaded once. `versions` holds "name version" for every
        ; package loaded or being loaded, so a cycle ends here as well. Two
        ; versions of one package cannot share a compilation: the version
        ; selects the directory only, and no mangled name carries it.
        let key "`pkg_name` `version_str`"
        var vi: size_t 0
        while vi < versions.length
        {
            let v versions.get vi
            if v <> null and v.starts_with("`pkg_name` ")
            {
                if v.equals(key) = false
                    report_load_error("error: package `pkg_name` is required in two versions, `v.substring(pkg_name.get_length() + 1, v.get_length() - pkg_name.get_length() - 1)` and `version_str`; one compilation takes one version of a package")
                return
            }
            set vi: vi + 1
        }
        versions.add key

        ; Search path: <SCALY_HOME/>packages/<name>/<version>/
        let pkg_path "`scaly_home_base()`packages/`pkg_name`/`version_str`"
        let root_dir interface_or_source(pkg_path, pkg_name)
        load_package_dependencies("`root_dir`/`pkg_name`.scaly", packages, versions)

        let loaded build_referenced_module(root_dir, pkg_name, false)
        ; A declared package whose root loaded to a fully empty stub was not
        ; found (a PARSE failure inside an existing root reports its own
        ; file:line:col error and lands here too — the extra line is harmless).
        if loaded.members.length = 0
            if loaded.modules.length = 0
            {
                var perr StringBuilder()
                perr.append "error: package not found: "
                perr.append pkg_name
                perr.append " "
                perr.append version_str
                perr.append ": "
                perr.append pkg_path
                perr.append("/" as char)
                perr.append pkg_name
                perr.append ".scaly - run from a directory containing packages/, or set SCALY_HOME"
                let perr_str perr.to_string()
                report_load_error(perr_str)
            }
        packages.add loaded
    }

    ; True when any sub-module failed to load. cli.run gates on this after
    ; build_program and fails the compile before the planner emits misleading
    ; downstream diagnostics.
    procedure had_errors() returns bool
        modeler_error_count > 0

    ; Reset at the start of each program build (harmless in a fresh process; keeps
    ; the counter honest if build_program is ever called more than once).
    procedure reset_errors() mutable modeler_error_count
        set modeler_error_count: 0

    ; size_t -> decimal String (self-contained; the Planner has its own copy but
    ; the Modeler must not depend on the Planner).
    function num_to_string(n: size_t) returns String
    {
        if n = 0
            return "0"
        let result StringBuilder()
        var value n
        var digits Array[char]()
        while value > 0
        {
            let digit ((value % 10) as char) + "0" as char
            digits.add digit
            set value: value / 10
        }
        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                result.append(*d)
        }
        result.to_string()
    }

    ; Report a sub-module load failure at its real file:line:col and bump the
    ; error counter. `offset` is a byte offset into `source` (the sub-module's own
    ; contents); the line/col walk mirrors cli.print_parse_error's numeric-LF scan.
    procedure report_module_error(file_path: String, source: String, offset: size_t, message: String) mutable modeler_error_count
    {
        var line: size_t 1
        var col: size_t 1
        let src_len source.get_length()
        var target offset
        if target > src_len
            set target: src_len
        var off: size_t 0
        while off < target
        {
            let c source.get off
            if c = ("\n" as char)
            {
                set line: line + 1
                set col: 1
            }
            else
                set col: col + 1
            set off: off + 1
        }
        let line_str num_to_string(line)
        let col_str num_to_string(col)
        let msg_str "`file_path`:`line_str`:`col_str`: `message`"
        Console.println(msg_str.to_c_string())
        set modeler_error_count: modeler_error_count + 1
    }

    ; A required module file (the prelude, or a declared package's root) could not
    ; be loaded. Print the message and fail the compile via had_errors() — the
    ; silent path compiled WITHOUT the standard library and every later use
    ; surfaced as a misleading "function not found: print" / "unknown identifier".
    ; Resolution has exactly one base (SCALY_HOME when set, else the current
    ; directory), so nothing downstream could still find the file.
    procedure report_load_error(message: String) mutable modeler_error_count
    {
        Console.println(message.to_c_string())
        set modeler_error_count: modeler_error_count + 1
    }

    ; Load and model a sibling module file at <path>/<name>.scaly. On a genuine
    ; PARSE error the real syntax error is reported (file:line:col) and an empty
    ; stub is returned so modeling can continue; cli.run then fails the compile via
    ; had_errors(). A missing/empty file still returns an empty stub silently (an
    ; absent optional module is not itself an error at this layer).
    procedure build_referenced_module(path: String, name: String, is_private: bool) returns Module mutable modeler_error_count
    {
        ; Compute file path: <path>/<name>.scaly
        var sb StringBuilder()
        if path.get_length() > 0
        {
            sb.append path
            sb.append("/" as char)
        }
        sb.append name
        sb.append ".scaly"
        let file_path sb.to_string()

        ; Empty stub for failure cases (still has a valid name so lookups don't crash).
        var empty_symbols HashMapBuilder[String, Nameable]()
        let empty_module Module(
            is_private,
            file_path,
            name,
            Vector[Module](0),
            Vector[Use](0),
            Vector[Member](0),
            HashMap[String, Nameable](empty_symbols)
        )

        if File.exists(file_path) = false
            return empty_module

        var contents File.read_to_string(file_path)
        if contents.get_length() = 0
            return empty_module

        ; A file of a generated package interface is read, but the module
        ; carries its SOURCE file: the lexer takes the source's positions from
        ; the package's interface/positions (compiler/Interface.scaly), so every
        ; span is an offset into the source and a location computed from it
        ; names the source's line and column.
        var module_file file_path
        let source_file interface_source_file(file_path)
        var p Parser(contents)
        var pairs Array[size_t]()
        if source_file.get_length() > 0
        {
            set module_file: source_file
            interface_positions(file_path, &pairs)
            p.lexer.use_positions(pairs.as_slice())
        }
        var syntax: ProgramSyntax
        choose p.parse_program()
            when err: Error
            {
                ; Don't swallow the real syntax error: report it against the
                ; sub-module's own file:line:col, then continue with an empty stub
                ; so downstream modeling doesn't crash. cli.run fails the compile.
                var error_text contents
                if source_file.get_length() > 0
                    set error_text: File.read_to_string(source_file)
                choose err
                    when inv: Invalid
                        report_module_error(module_file, error_text, inv.start, inv.message)
                    when d: Different
                        report_module_error(module_file, error_text, 0, "parse error")
                return empty_module
            }
            when prog: Success
                set syntax: prog

        ; Sub-path for nested modules: <path>/<name>
        var sub_sb StringBuilder()
        if path.get_length() > 0
        {
            sub_sb.append path
            sub_sb.append("/" as char)
        }
        sub_sb.append name
        let sub_path sub_sb.to_string()

        build_module(sub_path, module_file, name, syntax.file, is_private)
    }

    ; Where `/interface/` starts in the path of a file of a generated package
    ; interface, or -1 for any other path.
    function interface_dir_at(path: String) returns int
    {
        let needle String("/interface/")
        let k needle.get_length()
        let n path.get_length()
        var i: size_t 0
        while i + k <= n
        {
            if path.substring(i, k).equals(needle)
                return i as int
            set i: i + 1
        }
        0 - 1
    }

    ; `<dir>/interface/<rest>` -> `<dir>/<rest>` for a file of a generated
    ; package interface; "" for any other path
    function interface_source_file(path: String) returns String
    {
        let at interface_dir_at(path)
        if at < 0
            return String()
        let i at as size_t
        let n path.get_length()
        "`path.substring(0, i)``path.substring(i + 10, n - i - 10)`"
    }

    ; The position pairs of an interface file: its section of the package's
    ; `<dir>/interface/positions` -- the line `<rest>`, then one line
    ; `<interface byte> <source byte>` per pair (compiler/Interface.scaly).
    ; A file without replacements has no section and gets no pairs.
    procedure interface_positions(path: String, mutable pairs: ref[Array[size_t]])
    {
        let i interface_dir_at(path) as size_t
        let n path.get_length()
        let table File.read_to_string("`path.substring(0, i + 10)`/positions")
        let rel path.substring(i + 11, n - i - 11)
        let m table.get_length()
        var in_section false
        var start: size_t 0
        while start < m
        {
            var stop start
            while stop < m and table.get(stop) <> 10
                set stop: stop + 1
            let first table.get(start)
            if first >= 48 and first <= 57
            {
                if in_section
                {
                    var k start
                    var a: size_t 0
                    while k < stop and table.get(k) <> 32
                    {
                        set a: a * 10 + ((table.get(k) - 48) as size_t)
                        set k: k + 1
                    }
                    set k: k + 1
                    var b: size_t 0
                    while k < stop
                    {
                        set b: b * 10 + ((table.get(k) - 48) as size_t)
                        set k: k + 1
                    }
                    pairs.add a
                    pairs.add b
                }
            }
            else if first <> 59     ; not a comment: a file's path
            {
                if in_section
                    return
                set in_section: table.substring(start, stop - start).equals(rel)
            }
            set start: stop + 1
        }
    }

    procedure build_module(mutable path: String, file_name: String, name: String, mutable syntax: FileSyntax, is_private: bool) returns Module mutable modeler_error_count
    {
        var symbols_builder HashMapBuilder[String, Nameable]()

        ; Handle declarations (uses are now part of declarations)
        var uses Vector[Use](0)
        var modules Array[Module]()
        var members Vector[Member](0)
        if syntax.declarations <> null
        {
            let decl_syns (*syntax.declarations)
            let total decl_syns.length
            set uses: Vector[Use](total)
            set members: Vector[Member](total)
            var i: size_t 0
            var use_idx: size_t 0
            var member_idx: size_t 0
            while i < total
            {
                let decl_ptr decl_syns.get i
                if decl_ptr <> null
                {
                    let decl_syntax (*decl_ptr)
                    choose decl_syntax
                        when use_syntax: UseSyntax
                        {
                            let use_ handle_use(use_syntax)
                            uses.put(use_idx, use_)
                            set use_idx: use_idx + 1
                        }
                        when mod_syntax: ModuleSyntax
                            handle_module_decl(path, mod_syntax, is_private, &modules)
                        else
                        {
                            let member handle_declaration(path, decl_syntax, &symbols_builder)
                            members.put(member_idx, member)
                            set member_idx: member_idx + 1
                        }
                }
                set i: i + 1
            }
            ; both sized to the declaration count, each filled with its own
            ; share — cut back to what was written (see handle_structure).
            set uses.length: use_idx
            set members.length: member_idx
        }

        let symbols HashMap[String, Nameable](symbols_builder)

        let mod_modules Vector[Module](modules)
        Module(
            is_private,
            file_name,
            name,
            mod_modules,
            uses,
            members,
            symbols
        )
    }

    ; ============================================================================
    ; Program building
    ; ============================================================================

    procedure build_program(mutable file_name: String, program_name: String, mutable syntax: ProgramSyntax, enable_prelude: bool) returns Program mutable modeler_error_count
    {
        reset_errors()
        var packages Array[Module]()
        var versions Array[String]()
        if syntax.file.declarations <> null
        {
            let decl_syns (*syntax.file.declarations)
            var i: size_t 0
            while i < decl_syns.length
            {
                let decl_ptr decl_syns.get i
                if decl_ptr <> null
                {
                    let decl_syntax (*decl_ptr)
                    choose decl_syntax
                        when pkg_syntax: PackageSyntax
                            handle_package_decl(pkg_syntax, &packages, &versions)
                        else
                        {
                            ; not a package
                        }
                }
                set i: i + 1
            }
        }

        ; Build main module — base path is the directory containing the source
        ; file, so sibling `module foo` decls resolve to <dir>/foo.scaly (mirrors
        ; stage-0 Modeler::buildProgram).
        let path Path.get_directory_name(file_name)
        let initial_module build_module(path, file_name, program_name, syntax.file, false)

        ; Load prelude.scaly and add it as a sub-module of the main module so
        ; user code can call print / println / puts without explicit
        ; declarations. Stage-0 instead inserts prelude members directly into
        ; the main module's Members list; we attach as a sub-module so the
        ; Planner / Emitter walk it via plan_module#'s modules recursion and
        ; the existing Modeler tests that count main_module.members.length
        ; stay valid. Skipped when enable_prelude=false (--no-prelude) so libs
        ; built via -c don't carry duplicate prelude bodies.
        var main_module: Module initial_module
        if enable_prelude
        {
            let prelude_path "`scaly_home_base()`packages/scaly/0.1.0/scaly"
            let prelude_module build_referenced_module(prelude_path, "prelude", false)

            if prelude_module.members.length > 0
            {
                let init_mods_len initial_module.modules.length
                var combined_modules Vector[Module](init_mods_len + 1)
                var mi: size_t 0
                while mi < init_mods_len
                {
                    let mp initial_module.modules.get mi
                    if mp <> null
                        combined_modules.put(mi, *mp)
                    set mi: mi + 1
                }
                combined_modules.put(init_mods_len, prelude_module)
                set main_module: Module(
                    initial_module.private_,
                    initial_module.file,
                    initial_module.name,
                    combined_modules,
                    initial_module.uses,
                    initial_module.members,
                    initial_module.symbols
                )
            }
            else
            {
                var perr StringBuilder()
                perr.append "error: prelude not found: "
                perr.append prelude_path
                perr.append "/prelude.scaly - run from a directory containing packages/scaly, set SCALY_HOME (tools/install.sh does), or pass --no-prelude to compile without the standard library"
                let perr_str perr.to_string()
                report_load_error(perr_str)
            }
        }

        ; Implicit stdlib: auto-load the scaly package so its types (String,
        ; Vector, Option, Result, HashMap, …) are usable WITHOUT an explicit
        ; `package scaly 0.1.0` — the prelude.scaly submodule above only
        ; supplies print/println/puts. Loaded exactly like handle_package_decl#
        ; (same path/name), so register_packages# registers its concepts and
        ; the used ones instantiate on demand (unused ones are never emitted;
        ; the runtime bodies link from libscaly.a — identical to the explicit
        ; form). SKIPPED when the program already declares `package scaly`
        ; (dedup below → byte-identical emission for the compiler's own roots,
        ; which all declare it) and when the prelude is disabled (--no-prelude:
        ; the libscaly build + bare-metal targets).
        if enable_prelude
        {
            var has_scaly: bool false
            var pk: size_t 0
            while pk < packages.length
            {
                let pkp packages.get pk
                if pkp <> null and pkp.name = "scaly"
                    set has_scaly: true
                set pk: pk + 1
            }
            if has_scaly = false
            {
                let std_path "`scaly_home_base()`packages/scaly/0.1.0"
                let std_module build_referenced_module(interface_or_source(std_path, String("scaly")), "scaly", false)
                if std_module.members.length > 0
                    packages.add std_module
            }
        }

        ; Handle top-level statements
        let statements handle_statements(syntax.statements)

        let prog_packages Vector[Module](packages)
        Program(
            prog_packages,
            main_module,
            statements
        )
    }

    ; ============================================================================
    ; Test function
    ; ============================================================================

    procedure test() returns int mutable modeler_error_count
    {
        ; Test 200: Boolean constant - "true" maps to BooleanConstant with value=true
        var parser Parser("true")
        choose parser.parse_program()
            when err: Error
                return 200
            when syntax: Success
            {
                let program build_program("t1.scaly", "t1", syntax, true)
                if program.statements.length <> 1
                    return 201

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 202

                let stmt (*stmt_ptr)
                choose stmt
                    when action: Action
                    {
                        if action.source.length <> 1
                            return 203

                        let op_ptr action.source.get 0
                        if op_ptr = null
                            return 204

                        let op (*op_ptr)
                        choose op.expression
                            when const: Constant
                                choose const
                                    when b: Boolean
                                    {
                                        if b.value = false
                                            return 205

                                    }
                                    else
                                        return 206
                                    else
                                        return 207
                    }
                    else
                        return 208
            }

        ; Test 210: Integer literal - "42" maps to IntegerConstant
        set parser: Parser("42")
        choose parser.parse_program()
            when err: Error
                return 210
            when syntax: Success
            {
                let program build_program("t2.scaly", "t2", syntax, true)
                if program.statements.length <> 1
                    return 211

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 212

                let stmt (*stmt_ptr)
                choose stmt
                    when action: Action
                    {
                        let op_ptr action.source.get 0
                        if op_ptr = null
                            return 213

                        let op (*op_ptr)
                        choose op.expression
                            when const: Constant
                                choose const
                                    when i: Integer {}
                                    else
                                        return 214
                                    else
                                        return 215
                    }
                    else
                        return 216
            }

        ; Test 220: String literal - "\"hello\"" maps to StringConstant
        set parser: Parser("\"hello\"")
        choose parser.parse_program()
            when err: Error
                return 220
            when syntax: Success
            {
                let program build_program("t3.scaly", "t3", syntax, true)
                if program.statements.length <> 1
                    return 221

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 222

                let stmt (*stmt_ptr)
                choose stmt
                    when action: Action
                    {
                        let op_ptr action.source.get 0
                        if op_ptr = null
                            return 223

                        let op (*op_ptr)
                        choose op.expression
                            when const: Constant
                                choose const
                                    when s: String {}
                                    else
                                        return 224
                                    else
                                        return 225
                    }
                    else
                        return 226
            }

        ; Test 230: Let binding - binding_type="const", item.name="x"
        set parser: Parser("let x 42")
        choose parser.parse_program()
            when err: Error
                return 230
            when syntax: Success
            {
                let program build_program("t4.scaly", "t4", syntax, true)
                if program.statements.length <> 1
                    return 231

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 232

                let stmt (*stmt_ptr)
                choose stmt
                    when binding: Binding
                    {
                        if binding.binding_type <> "const"
                            return 233

                        if binding.item.name = null
                            return 234

                        if (*binding.item.name) <> "x"
                            return 235

                    }
                    else
                        return 236
            }

        ; Test 240: Var binding with type - binding_type="var", name="y", type path=["int"]
        set parser: Parser("var y: int 0")
        choose parser.parse_program()
            when err: Error
                return 240
            when syntax: Success
            {
                let program build_program("t5.scaly", "t5", syntax, true)
                if program.statements.length <> 1
                    return 241

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 242

                let stmt (*stmt_ptr)
                choose stmt
                    when binding: Binding
                    {
                        if binding.binding_type <> "var"
                            return 243

                        if binding.item.name = null
                            return 244

                        if (*binding.item.name) <> "y"
                            return 245

                        if binding.item.type = null
                            return 246

                        let item_type (*binding.item.type)
                        if item_type.name.length <> 1
                            return 247

                        let type_name_ptr item_type.name.get 0
                        if type_name_ptr = null
                            return 248

                        if (*type_name_ptr) <> "int"
                            return 249

                    }
                    else
                        return 238
            }

        ; Test 250: Name expression - "foo" maps to Expression.Type with path=["foo"]
        set parser: Parser("foo")
        choose parser.parse_program()
            when err: Error
                return 250
            when syntax: Success
            {
                let program build_program("t6.scaly", "t6", syntax, true)
                if program.statements.length <> 1
                    return 251

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 252

                let stmt (*stmt_ptr)
                choose stmt
                    when action: Action
                    {
                        let op_ptr action.source.get 0
                        if op_ptr = null
                            return 253

                        let op (*op_ptr)
                        choose op.expression
                            when type_expr: Type
                            {
                                if type_expr.name.length <> 1
                                    return 254

                                let name_ptr type_expr.name.get 0
                                if name_ptr = null
                                    return 255

                                if (*name_ptr) <> "foo"
                                    return 256

                            }
                            else
                                return 257
                    }
                    else
                        return 258
            }

        ; Test 260: If expression - top-level if produces Expression.If
        set parser: Parser("if true\n    1\nelse\n    0")
        choose parser.parse_program()
            when err: Error
                return 260
            when syntax: Success
            {
                let program build_program("t7.scaly", "t7", syntax, true)
                if program.statements.length <> 1
                    return 261

                let stmt_ptr program.statements.get 0
                if stmt_ptr = null
                    return 262

                let stmt (*stmt_ptr)
                choose stmt
                    when action: Action
                    {
                        let op_ptr action.source.get 0
                        if op_ptr = null
                            return 263

                        let op (*op_ptr)
                        choose op.expression
                            when if_expr: If {}
                            else
                                return 264
                    }
                    else
                        return 265
            }

        ; Test 270: Function definition - pure=true, name="answer"
        set parser: Parser("function answer() returns int\n    42")
        choose parser.parse_program()
            when err: Error
                return 270
            when syntax: Success
            {
                let program build_program("t8.scaly", "t8", syntax, true)
                if program.module_.members.length <> 1
                    return 271

                let member_ptr program.module_.members.get 0
                if member_ptr = null
                    return 272

                let member (*member_ptr)
                choose member
                    when fn: Function
                    {
                        if fn.name <> "answer"
                            return 273

                        if fn.pure = false
                            return 274

                    }
                    else
                        return 275
            }

        ; Test 280: Procedure definition - pure=false, name="mutate"
        set parser: Parser("procedure mutate(this)\n    0")
        choose parser.parse_program()
            when err: Error
                return 280
            when syntax: Success
            {
                let program build_program("t9.scaly", "t9", syntax, true)
                if program.module_.members.length <> 1
                    return 281

                let member_ptr program.module_.members.get 0
                if member_ptr = null
                    return 282

                let member (*member_ptr)
                choose member
                    when fn: Function
                    {
                        if fn.name <> "mutate"
                            return 283

                        if fn.pure = true
                            return 284

                    }
                    else
                        return 285
            }

        ; Test 290: Structure definition - Concept with Definition.Structure
        set parser: Parser("define Point(x: int, y: int)")
        choose parser.parse_program()
            when err: Error
                return 290
            when syntax: Success
            {
                let program build_program("t10.scaly", "t10", syntax, true)
                if program.module_.members.length <> 1
                    return 291

                let member_ptr program.module_.members.get 0
                if member_ptr = null
                    return 292

                let member (*member_ptr)
                choose member
                    when concept: Concept
                    {
                        if concept.name <> "Point"
                            return 293

                        choose concept.definition
                            when struct: Structure
                            {
                                if struct.properties.length <> 2
                                    return 294

                            }
                            else
                                return 295
                    }
                    else
                        return 296
            }

        ; Test 297: Union definition - Concept with Definition.Union and 2 variants
        set parser: Parser("define Option union(Some: int, None)")
        choose parser.parse_program()
            when err: Error
                return 297
            when syntax: Success
            {
                let program build_program("t11.scaly", "t11", syntax, true)
                if program.module_.members.length <> 1
                    return 298

                let member_ptr program.module_.members.get 0
                if member_ptr = null
                    return 299

                let member (*member_ptr)
                choose member
                    when concept: Concept
                    {
                        if concept.name <> "Option"
                            return 300

                        choose concept.definition
                            when union_: Union
                            {
                                if union_.variants.length <> 2
                                    return 301

                            }
                            else
                                return 302
                    }
                    else
                        return 303
            }

        0
    }
}
