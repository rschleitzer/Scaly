        ; get_readable_name - generic: Vector[int] -> "Vector[int]".
        var vec_gens Vector[PlannedType]$(1)
        vec_gens.put(0, int_ty)
        let vec_ty PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_gens,
            Lifetime.Unspecified(Unspecified()),
