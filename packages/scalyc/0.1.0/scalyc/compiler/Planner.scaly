                        let first (*first_ptr)
                        if first.name <> null
                        {
                            let pname (*first.name)
                            if pname.equals("this")
                                set start_idx: 1
                        }
                    }
                }
            }
        }

        var has_params: bool false
        if params <> null
        {
            let ps (*params)
            var i: size_t start_idx
            while i < ps.length
            {
                let param_ptr ps.get i
                if param_ptr <> null
                {
                    let param (*param_ptr)
                    if param.item_type <> null
                    {
                        let pty (*param.item_type)
                        sb.append(Planner.encode_type#(pty))
                        set has_params: true
                    }
                }
                set i: i + 1
            }
        }

