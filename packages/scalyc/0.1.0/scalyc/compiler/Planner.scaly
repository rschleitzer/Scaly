        {
            let ps (*params)
            var i: size_t 0
            while i < ps.length
            {
                let param_ptr ps.get i
                if param_ptr <> null
                {
                    let param (*param_ptr)
                    var is_this: bool false
                    if param.name <> null
                    {
                        let pname (*param.name)
                        set is_this: pname.equals("this")
                    }
                    if is_this = false
                    {
