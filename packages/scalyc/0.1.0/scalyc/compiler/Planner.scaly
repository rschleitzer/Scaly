; Planner.scaly - Generic resolution, type inference, and name mangling.
; Transforms Model (generics) into Plan (concrete types, mangled names).
;
; Ported afresh from scalyc/Planner.cpp (~13K LOC, ~97 methods).
; Covers the full planning pipeline — plan_program → plan_module →
; plan_namespace/plan_concept → plan_structure/plan_union/plan_global
; /plan_function/plan_operator/plan_initializer/plan_deinitializer —
; HM type inference (unify, solve_constraints, apply_substitution),
; Itanium ABI name mangling, overload resolution with generic
; inference, member-access + method-chain resolution, iterator
; protocol, and branch-result unification.
;
; The only paths that abort via not_implemented are the package
; loader's parse+model steps, which need Scaly-side access to the
; Parser and Modeler as callable modules.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.containers.Vector
use scaly.containers.KeyValuePair
use scaly.containers.HashMap
use scaly.containers.HashMapBuilder
use scaly.io.File
use scaly.io.Path

use scalyc.compiler.Model.Program
use scalyc.compiler.Model.Span
use scalyc.compiler.Model.Lifetime
use scalyc.compiler.Model.Unspecified
use scalyc.compiler.Model.Constant
use scalyc.compiler.Model.BooleanConstant
use scalyc.compiler.Model.IntegerConstant
use scalyc.compiler.Model.HexConstant
use scalyc.compiler.Model.FloatingPointConstant
use scalyc.compiler.Model.StringConstant
use scalyc.compiler.Model.CharacterConstant
use scalyc.compiler.Model.FragmentConstant
use scalyc.compiler.Model.NullConstant
use scalyc.compiler.Model.Function
use scalyc.compiler.Model.Implementation
use scalyc.compiler.Model.Extern
use scalyc.compiler.Model.Intrinsic
use scalyc.compiler.Model.Type
use scalyc.compiler.Model.Item
use scalyc.compiler.Model.Attribute
use scalyc.compiler.Model.Operand
use scalyc.compiler.Model.Expression
use scaly.containers.Array

use scalyc.compiler.Plan.Plan
use scalyc.compiler.Plan.PlannedType
use scalyc.compiler.Plan.PlannedItem
use scalyc.compiler.Plan.TypeVariable
use scalyc.compiler.Plan.PlannedProperty
use scalyc.compiler.Plan.PlannedVariant
use scalyc.compiler.Plan.TypeConstraint
use scalyc.compiler.Plan.EqualityConstraint
use scalyc.compiler.Plan.InstanceConstraint
use scalyc.compiler.Plan.TypeScheme
use scalyc.compiler.Plan.PlannedBinding
use scalyc.compiler.Plan.PlannedAction
use scalyc.compiler.Plan.PlannedReturn
use scalyc.compiler.Plan.PlannedBreak
use scalyc.compiler.Plan.PlannedContinue
use scalyc.compiler.Plan.PlannedThrow
use scalyc.compiler.Plan.PlannedStatement
use scalyc.compiler.Plan.PlannedBlock
use scalyc.compiler.Plan.PlannedExternImpl
use scalyc.compiler.Plan.PlannedInstructionImpl
use scalyc.compiler.Plan.PlannedIntrinsicImpl
use scalyc.compiler.Plan.PlannedImplementation
use scalyc.compiler.Plan.PlannedFunction
use scalyc.compiler.Model.Binding
use scalyc.compiler.Model.Instruction
use scalyc.compiler.Model.Structure
use scalyc.compiler.Model.Initializer
use scalyc.compiler.Model.DeInitializer
use scalyc.compiler.Model.Operator
use scalyc.compiler.Plan.PlannedStructure
use scalyc.compiler.Plan.PlannedInitializer
use scalyc.compiler.Plan.PlannedDeInitializer
use scalyc.compiler.Plan.PlannedOperator
use scalyc.compiler.Plan.PlannedNamespace
use scalyc.compiler.Plan.PlannedConcept
use scalyc.compiler.Plan.PlannedDefinition
use scalyc.compiler.Plan.PlannedGlobal
use scalyc.compiler.Plan.PlannedModule
use scalyc.compiler.Model.Namespace
use scalyc.compiler.Model.Concept
use scalyc.compiler.Model.Global
use scalyc.compiler.Model.Member
use scalyc.compiler.Model.Module
use scalyc.compiler.Model.SizeOf
use scalyc.compiler.Model.Is
use scalyc.compiler.Model.New
use scalyc.compiler.Model.If
use scalyc.compiler.Model.While
use scalyc.compiler.Model.For
use scalyc.compiler.Model.Try
use scalyc.compiler.Model.Match
use scalyc.compiler.Model.Choose
use scalyc.compiler.Model.When
use scalyc.compiler.Model.Case
use scalyc.compiler.Model.Branch
use scalyc.compiler.Model.Tuple
use scalyc.compiler.Model.Matrix
use scalyc.compiler.Model.Component
use scalyc.compiler.Plan.PlannedSizeOf
use scalyc.compiler.Plan.PlannedAlignOf
use scalyc.compiler.Plan.PlannedIs
use scalyc.compiler.Plan.PlannedAs
use scalyc.compiler.Plan.PlannedIf
use scalyc.compiler.Plan.PlannedWhile
use scalyc.compiler.Plan.PlannedFor
use scalyc.compiler.Plan.PlannedTry
use scalyc.compiler.Plan.PlannedMatch
use scalyc.compiler.Plan.PlannedChoose
use scalyc.compiler.Plan.PlannedWhen
use scalyc.compiler.Plan.PlannedCase
use scalyc.compiler.Plan.PlannedBranch
use scalyc.compiler.Plan.PlannedCall
use scalyc.compiler.Plan.PlannedVariable
use scalyc.compiler.Plan.PlannedGlobalRef
use scalyc.compiler.Plan.PlannedVariantConstruction
use scalyc.compiler.Plan.MethodMatch
use scalyc.compiler.Plan.OperatorMatch
use scalyc.compiler.Model.Action
use scalyc.compiler.Model.Return
use scalyc.compiler.Model.Break
use scalyc.compiler.Model.Continue
use scalyc.compiler.Model.Throw
use scalyc.compiler.Model.Statement
use scalyc.compiler.Model.Block
use scalyc.compiler.Model.Property
use scalyc.compiler.Model.Variant
use scalyc.compiler.Model.GenericParameter
use scalyc.compiler.Plan.PlannedOperand
use scalyc.compiler.Plan.PlannedExpression
use scalyc.compiler.Plan.PlannedTuple
use scalyc.compiler.Plan.PlannedComponent

; libc extern for loud-failing stubs.
function exit(code: int) extern

; ============================================================================
; Scope / binding machinery.
;
; Defined at module scope so callers outside `define Planner` can construct
; them (scope state will eventually live inside the Planner struct; for now
; every scope-aware helper takes the stack as an explicit parameter).
; ============================================================================

; One local variable's entry. is_on_page tracks RBMM lifetime — true for
; values allocated with $, #, or ^name so the code generator can emit
; appropriate page-cleanup hooks.
define LocalBinding
(
    binding_type: scalyc.compiler.Plan.PlannedType
    is_mutable: bool
    is_on_page: bool
)

define Planner
{
    ; ========================================================================
    ; Not-yet-ported marker.
    ;
    ; Every stub in this file funnels through here. Prints the method name
    ; to stderr and exits with code 111 so a caller that touches unported
    ; logic gets a precise, visible failure (not a silent null).
    ; ========================================================================

    function not_implemented(method_name: pointer[const_char]) returns int
    {
        scaly_eputs("scalyc Planner stub not implemented: ")
        scaly_eputs(method_name)
        scaly_eputs("\n")
        exit(111)
        0
    }

    ; Typed unreachable shim for functions that return PlannedOperand.
    ; The exit() in not_implemented terminates the process, so the dummy
    ; PlannedOperand below is never observed — it exists only so Scaly's
    ; type checker accepts the call site.
    function not_implemented_operand(method_name: pointer[const_char]) returns PlannedOperand
    {
        Planner.not_implemented(method_name)
        PlannedOperand(
            Span(0, 0),
            PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant(
                Constant.Null(NullConstant(Span(0, 0)))
            )),
            null,
            PlannedType(
                Span(0, 0),
                String$("void"),
                String$("v"),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String$(""),
                null
            )
        )
    }

    ; ========================================================================
    ; Planner - the per-compilation-unit state.
    ;
    ; Mirrors the private fields of scalyc/Planner.h: scope stack, type
    ; substitutions, HM constraints + solution, concept registry,
    ; instantiation caches, function/operator registries, package
    ; search paths, loaded-package cache, and error accumulator.
    ; ========================================================================

    define Planner
    (
        file: String

        ; Scope stack — stored as one flat Array of bindings with a
        ; parallel Array of scope boundaries (indices where each scope
        ; begins). This avoids the Array-of-Array memory-model problem
        ; where a nested Array would lose its `Page.get(this)` anchor
        ; after being copied into the outer Array's exclusive page.
        ;
        ; push_scope    → boundaries.add(bindings.length)
        ; pop_scope     → bindings.length = last boundary, drop boundary
        ; define_local  → bindings.add(...)
        ; lookup_local  → reverse linear scan of bindings
        scope_bindings: Array[KeyValuePair[String, LocalBinding]]
        scope_boundaries: Array[size_t]

        ; Generic parameter substitutions active while planning a
        ; specific struct/function instantiation. Name-keyed
        ; (e.g. "T" → PlannedType for int).
        type_substitutions: Array[KeyValuePair[String, PlannedType]]

        ; Fresh type-variable id counter for the Hindley-Milner
        ; constraint solver; see fresh_type_var below.
        next_type_var_id: size_t

        ; Pending constraints (grow as the planner encounters equalities
        ; it can't resolve yet) and the accumulated solution from the
        ; most recent solve_and_apply call.
        constraints: Array[TypeConstraint]
        solution: Array[KeyValuePair[size_t, PlannedType]]

        ; Concept registry — maps a readable name (e.g. "Vector") to the
        ; Model.Concept that owns it. Populated by register_concept; used
        ; by lookup_concept during type resolution and method dispatch.
        concepts: Array[KeyValuePair[String, Concept]]

        ; Instantiation caches. Every PlannedStructure / PlannedUnion /
        ; PlannedFunction / PlannedGlobal a call into the planner
        ; produces is appended here so the final Plan can carry the
        ; complete list for emission.
        instantiated_structures: Array[PlannedStructure]
        instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]
        instantiated_functions: Array[PlannedFunction]
        instantiated_globals: Array[PlannedGlobal]

        ; s116: cycle detection for instantiate_generic#. Holds the
        ; mangled names of generics currently being planned but not yet
        ; recorded in instantiated_structures/_unions. Without this,
        ; cross-module nested-generic chains (e.g. scalyc.scaly compile)
        ; recurse plan_type# → instantiate_generic# → plan_structure# →
        ; plan_function# → plan_type# without bound and blow the stack
        ; in resolve_type_base#. Mirrors stage-0's FunctionsBeingPlanned
        ; set (Planner.cpp:11685).
        instantiating_structures: Array[String]

        ; Free-function registry. Entries are appended for every
        ; top-level Function encountered during the concept-registration
        ; pass. A single name can appear multiple times for overloads —
        ; lookup_functions returns all matches.
        model_functions: Array[KeyValuePair[String, Function]]

        ; Operator registry (same shape as model_functions; separate
        ; keyspace because an operator is identified by its symbol).
        model_operators: Array[KeyValuePair[String, Operator]]

        ; Package search paths (e.g. "packages", user -I paths). Probed
        ; by load_package_on_demand when a package isn't already in
        ; loaded_packages.
        search_paths: Array[String]

        ; Loaded-package cache — name → root Module. Populated lazily
        ; once a package is found and parsed.
        loaded_packages: Array[KeyValuePair[String, Module]]

        ; Intra-package module cache keyed by full file path.
        ; Pre-populated by the outer driver via
        ; register_loaded_module; load_intra_package_module#
        ; consults it on demand.
        loaded_module_paths: Array[KeyValuePair[String, Module]]

        ; Collected diagnostic messages. Planner paths that can't
        ; resolve a name / method / type push descriptive strings
        ; here instead of (or in addition to) falling back to a
        ; fresh type variable. The caller (cli.scaly, tests) can
        ; inspect errors.length > 0 to detect problems without
        ; plumbing Result[T, E] through every helper.
        errors: Array[String]

        ; Sibling programs: Model.Programs belonging to the same
        ; compilation unit but loaded from separate source files.
        ; Mirrors Planner.cpp's SiblingPrograms — main.scaly may
        ; reference cli.scaly, which references compiler.scaly;
        ; once each has been parsed+modelled the result is stashed
        ; here so concepts/functions/operators from every sibling
        ; populate the same registries as the primary program.
        sibling_programs: Array[Program]

        ; Currently-active namespace context. Pushed when
        ; plan_namespace enters a `define cli { … }`-style block,
        ; popped on exit. Used by mangle_function to prefix
        ; namespace-scoped functions with the namespace name
        ; (Itanium `_ZN3cli4mainE…` shape) and by
        ; is_namespace_sibling_function to detect unqualified
        ; calls to peer functions of the enclosing namespace.
        current_namespace: ref[Namespace]?
        current_namespace_name: ref[String]?

        ; Last-segment names of every `use a.b.c` clause in the
        ; program's main module. Consulted by the dotted-call
        ; namespace override to decide whether a `prefix.suffix(...)`
        ; call should emit a real extern declaration even when
        ; planning is happening inside a loaded-package namespace
        ; body. Mirrors stage-0's Use-alias check at
        ; Planner.cpp:7752-7789. Populated once at plan_program#
        ; entry, stays empty until then.
        program_use_aliases: Array[String]

        ; Monotonic counter for synthesizing unique lambda names.
        next_lambda_id: size_t
    )
    {
        init#(page, filename: String)
        {
            set file: String^page(filename)
            set scope_bindings: Array[KeyValuePair[String, LocalBinding]]^page()
            set scope_boundaries: Array[size_t]^page()
            set type_substitutions: Array[KeyValuePair[String, PlannedType]]^page()
            set next_type_var_id: 0
            set constraints: Array[TypeConstraint]^page()
            set solution: Array[KeyValuePair[size_t, PlannedType]]^page()
            set concepts: Array[KeyValuePair[String, Concept]]^page()
            set instantiated_structures: Array[PlannedStructure]^page()
            set instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]^page()
            set instantiated_functions: Array[PlannedFunction]^page()
            set instantiated_globals: Array[PlannedGlobal]^page()
            set instantiating_structures: Array[String]^page()
            set model_functions: Array[KeyValuePair[String, Function]]^page()
            set model_operators: Array[KeyValuePair[String, Operator]]^page()
            set search_paths: Array[String]^page()
            set loaded_packages: Array[KeyValuePair[String, Module]]^page()
            set loaded_module_paths: Array[KeyValuePair[String, Module]]^page()
            set errors: Array[String]^page()
            set sibling_programs: Array[Program]^page()
            set current_namespace: null
            set current_namespace_name: null
            set program_use_aliases: Array[String]^page()
            set next_lambda_id: 0

            ; Seed the function registry with C-runtime externs so name
            ; lookups for aligned_alloc/free/exit succeed from day one.
            ; Use `^page` to put runtime Function records on the Planner's
            ; owning page; `$` (default) would put them on the call's
            ; local page and dangle on return (s100).
            this.register_runtime_functions^page()
        }

        ; ================================================================
        ; Scope management (mirrors Planner::pushScope etc. in C++).
        ; ================================================================

        function push_scope(this: Planner)
        {
            scope_boundaries.add(scope_bindings.length)
        }

        function pop_scope(this: Planner)
        {
            guard scope_boundaries.length = 0
                return

            let last_idx scope_boundaries.length - 1
            let boundary_ptr scope_boundaries.get(last_idx)
            guard boundary_ptr <> null
                set scope_bindings.length: *boundary_ptr

            set scope_boundaries.length: last_idx
        }

        function define_local(
            this: Planner,
            name: String,
            t: PlannedType,
            is_mutable: bool,
            is_on_page: bool
        )
        {
            scope_bindings.add(
                KeyValuePair[String, LocalBinding](
                    name,
                    LocalBinding(t, is_mutable, is_on_page)
                )
            )
        }

        ; lookup_local_binding: innermost-first reverse scan. Returns
        ; null if no binding with this name is live in any current scope.
        function lookup_local_binding(this: Planner, name: String) returns ref[LocalBinding]?
        {
            guard scope_bindings.length = 0
                return null

            var i scope_bindings.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr scope_bindings.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
            }
            null
        }

        function lookup_local(this: Planner, name: String) returns ref[PlannedType]?
        {
            let binding this.lookup_local_binding(name)
            guard binding = null
                return null

            &binding.binding_type
        }

        ; ================================================================
        ; Generic type-parameter substitutions.
        ; ================================================================

        function define_type_substitution(this: Planner, name: String, t: PlannedType)
        {
            type_substitutions.add(KeyValuePair[String, PlannedType](name, t))
        }

        function clear_type_substitutions(this: Planner)
        {
            set type_substitutions.length: 0
        }

        function lookup_type_substitution(this: Planner, name: String) returns ref[PlannedType]?
        {
            var i: size_t 0
            while i < type_substitutions.length
            {
                let kvp_ptr type_substitutions.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Fresh type variables for HM inference.
        ; ================================================================

        function fresh_type_var_id(this: Planner) returns size_t
        {
            let id next_type_var_id
            set next_type_var_id: id + 1
            id
        }

        ; ================================================================
        ; Concept registry.
        ; ================================================================

        function register_concept(this: Planner, c: Concept)
        {
            concepts.add(KeyValuePair[String, Concept](c.name, c))
        }

        function lookup_concept(this: Planner, name: String) returns ref[Concept]?
        {
            ; Scan backward so the most-recently-registered concept wins.
            ; `define Planner { struct Planner ( ... ) ... }` registers
            ; the outer Namespace concept first, then the inner Structure
            ; concept under the same name. Stage-0 uses a std::map keyed
            ; by name where the second insert overwrites the first; stage-1
            ; uses a Vector and previously linear-scanned forward, returning
            ; the OUTER Namespace and breaking find_initializer# /
            ; lookup_property / lookup_method# / is_struct_ctor — which
            ; all `choose c.definition when s: Structure ...` and fall
            ; through to else when handed a Namespace concept. Reverse
            ; scan = stage-0-faithful last-write-wins. (s95)
            guard concepts.length = 0
                return null
            var i: size_t concepts.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr concepts.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
            }
            null
        }

        function has_concept(this: Planner, name: String) returns bool
        {
            this.lookup_concept(name) <> null
        }

        ; Instantiation-cache recording helpers. Called as each planned
        ; aggregate is produced so the final Plan lists everything the
        ; emitter needs to lower.
        function record_structure(this: Planner, s: PlannedStructure)
        {
            instantiated_structures.add(s)
        }

        function record_union(this: Planner, u: scalyc.compiler.Plan.PlannedUnion)
        {
            instantiated_unions.add(u)
        }

        ; Lookups against the instantiation caches, keyed by mangled
        ; name. Used by instantiate_generic to avoid re-planning an
        ; already-instantiated concept.
        function has_instantiated_structure(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_structures.length
            {
                let s_ptr instantiated_structures.get(i)
                guard s_ptr <> null
                {
                    guard s_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function has_instantiated_union(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_unions.length
            {
                let u_ptr instantiated_unions.get(i)
                guard u_ptr <> null
                {
                    guard u_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function record_function(this: Planner, f: PlannedFunction)
        {
            instantiated_functions.add(f)
        }

        ; Has a function with this mangled name already been recorded in
        ; instantiated_functions? Used by the dotted-call namespace
        ; override to avoid re-declaring an extern stub for a function
        ; that was already planned (or already extern-declared).
        function has_recorded_function(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_functions.length
            {
                let f_ptr instantiated_functions.get(i)
                guard f_ptr <> null
                {
                    guard f_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function record_global(this: Planner, g: PlannedGlobal)
        {
            instantiated_globals.add(g)
        }

        ; lookup_global: locate a previously planned PlannedGlobal by name.
        ; Used by plan_type_operand#'s constant-folding path so a bare
        ; identifier like F_OK / SEEK_END resolves to its define value
        ; instead of falling through to PlannedExpression.Type (which
        ; emit_call drops as an arg, silently dropping the whole
        ; statement). Mirrors Planner.cpp:6950-6995.
        function lookup_global(this: Planner, name: String) returns ref[PlannedGlobal]?
        {
            var i: size_t 0
            while i < instantiated_globals.length
            {
                let g_ptr instantiated_globals.get(i)
                guard g_ptr <> null
                {
                    guard g_ptr.name.equals(name)
                        return g_ptr
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Package search paths + on-demand module loading.
        ;
        ; The Scaly Planner cannot yet drive the Scaly Parser +
        ; Modeler from its own body (would require threading a
        ; Parser instance or reifying a free-function parse entry
        ; point). Instead we take the pre-parsed-cache approach:
        ; an outer driver (cli.scaly, test harness) parses and
        ; models the required packages / sibling modules, then
        ; hands the resulting Module roots to the Planner via
        ; register_loaded_package / register_loaded_module. The
        ; load_* helpers are pure cache lookups.
        ;
        ; build_package_search_paths# / build_package_file_path#
        ; stay for callers that need to locate candidate files
        ; before parsing them.
        ; ================================================================

        function add_package_search_path(this: Planner, path: String)
        {
            search_paths.add(path)
        }

        ; add_sibling_program: register another Program (typically
        ; built from a peer source file) whose top-level concepts,
        ; functions and operators should be visible during planning
        ; of the primary program. The sibling is stashed here and
        ; later surfaced by register_sibling_programs right before
        ; the main-module registration pass.
        function add_sibling_program(this: Planner, prog: Program)
        {
            sibling_programs.add(prog)
        }

        ; record_program_uses: walk the program's main module Use
        ; clauses and store each clause's last path segment in
        ; program_use_aliases. Called once from plan_program# before
        ; plan_module# runs. The resulting alias list lets the
        ; dotted-call extern-decl gate fire for `prefix.suffix(...)`
        ; calls even when planning a loaded-package namespace body,
        ; provided the prefix names a Use-imported alias of the main
        ; program. Mirrors stage-0's Use-alias filter at
        ; Planner.cpp:7752-7789.
        function record_program_uses(this: Planner, prog: Program)
        {
            let uses prog.module_.uses
            var i: size_t 0
            while i < uses.length
            {
                let u_ptr uses.get(i)
                guard u_ptr <> null
                {
                    let path u_ptr.path
                    guard path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        guard last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                    }
                }
                set i: i + 1
            }
        }

        ; is_program_use_alias: linear scan of program_use_aliases.
        function is_program_use_alias(this: Planner, name: String) returns bool
        {
            var i: size_t 0
            while i < program_use_aliases.length
            {
                let a_ptr program_use_aliases.get(i)
                guard a_ptr <> null
                {
                    guard a_ptr.equals(name)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; plan_loaded_packages: extracted helper so plan_program's
        ; body stays small and a discarded plan_module# return value
        ; doesn't sit in plan_program's struct-by-value chain. The
        ; returned PlannedModule is dropped here intentionally —
        ; what we care about is the side effect of plan_function#
        ; calling record_function on every package-defined Function,
        ; which lands in instantiated_functions and is then emitted
        ; by the Emitter as both declaration and definition.
        function plan_loaded_packages#(rp, this: Planner)
        {
            var pi: size_t 0
            while pi < loaded_packages.length
            {
                let pk_ptr loaded_packages.get(pi)
                guard pk_ptr <> null
                {
                    let pk_mod (*pk_ptr).value
                    let planned this.plan_module#(pk_mod)
                }
                set pi: pi + 1
            }
        }

        ; register_sibling_programs: walk every stashed sibling
        ; Program and populate the shared registries (concepts,
        ; model_functions, model_operators) from each one. The same
        ; register_module_concepts helper is reused so nested
        ; namespaces, sub-modules, and struct-internal concepts are
        ; all flattened into the flat maps that lookup_concept /
        ; lookup_functions / lookup_operators consult.
        function register_sibling_programs(this: Planner)
        {
            var i: size_t 0
            while i < sibling_programs.length
            {
                let prog_ptr sibling_programs.get(i)
                guard prog_ptr <> null
                {
                    let prog (*prog_ptr)
                    this.register_module_concepts(prog.module_)
                }
                set i: i + 1
            }
        }

        ; Record a diagnostic. Callers don't need to format the message
        ; further — just describe what failed ("function not found: foo",
        ; "no matching initializer for Bar(int, String)", etc.).
        function add_error(this: Planner, message: String)
        {
            errors.add(message)
        }

        function has_errors(this: Planner) returns bool
        {
            errors.length > 0
        }

        ; Look up a previously loaded package in the cache.
        function lookup_loaded_package(this: Planner, name: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_packages.length
            {
                let kvp_ptr loaded_packages.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Look up a previously loaded intra-package module by its full
        ; file path.
        function lookup_loaded_module_path(this: Planner, path: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_module_paths.length
            {
                let kvp_ptr loaded_module_paths.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(path)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Build the list of directories to probe for a named package.
        ; Mirrors Planner.cpp's loadPackageOnDemand search list: cwd's
        ; packages/, then any user-provided -I paths. Walking the
        ; source file's parent chain is omitted here — the call sites
        ; that need it can push additional entries via
        ; add_package_search_path.
        function build_package_search_paths#(rp, this: Planner) returns Vector[String]
        {
            var paths Array[String]$()
            paths.add(String^rp("packages"))

            var i: size_t 0
            while i < search_paths.length
            {
                let p_ptr search_paths.get(i)
                guard p_ptr <> null
                    paths.add((*p_ptr))
                set i: i + 1
            }

            Vector[String]^rp(paths)
        }

        ; Compose "base/<name>/<version>/<name>.scaly" using Path.join#.
        function build_package_file_path#(
            rp,
            this: Planner,
            base: String,
            name: String,
            version: String
        ) returns String
        {
            let step1 Path.join^rp(base, name)
            let step2 Path.join^rp(step1, version)
            var file_sb StringBuilder^rp()
            file_sb.append(name)
            file_sb.append(".scaly")
            let file_part file_sb.to_string^rp()
            Path.join^rp(step2, file_part)
        }

        ; register_loaded_package: pre-populate the package cache.
        ; Callers (cli.scaly, test harnesses) parse a package source
        ; file externally, build a Model.Module for it, then hand
        ; the root Module here keyed by package name.
        ;
        ; This is the pre-parsed-cache wiring: the Scaly Planner
        ; can't drive the Scaly Parser + Modeler from its own body
        ; yet, so the orchestration of "find the .scaly file, parse
        ; it, model it" happens one level up. The Planner just asks
        ; "do you have package X for me?" via load_package_on_demand#.
        function register_loaded_package(this: Planner, name: String, mod: Module)
        {
            loaded_packages.add(KeyValuePair[String, Module](name, mod))
        }

        ; register_loaded_module: pre-populate the intra-package
        ; module cache keyed by full file path. Same contract as
        ; register_loaded_package — parsing + modelling happens
        ; outside the Planner; the Planner consults this cache when
        ; a `use` statement references a peer module file.
        function register_loaded_module(this: Planner, path: String, mod: Module)
        {
            loaded_module_paths.add(KeyValuePair[String, Module](path, mod))
        }

        ; load_package_on_demand: cache-only lookup of a package by
        ; name. Returns the pre-registered root Module if one is
        ; cached, otherwise null. Pre-registration happens via
        ; register_loaded_package. The filesystem probing helpers
        ; (build_package_search_paths#, build_package_file_path#)
        ; are retained for callers that want to discover candidate
        ; files before parsing them externally.
        function load_package_on_demand#(
            rp,
            this: Planner,
            name: String
        ) returns ref[Module]?
        {
            this.lookup_loaded_package(name)
        }

        ; load_intra_package_module: cache-only lookup of a peer
        ; module inside an already-mounted package, keyed by the
        ; full file path ("BasePath/ModuleName.scaly"). Callers
        ; pre-populate via register_loaded_module.
        function load_intra_package_module#(
            rp,
            this: Planner,
            base_path: String,
            module_name: String
        ) returns ref[Module]?
        {
            var name_sb StringBuilder^rp()
            name_sb.append(module_name)
            name_sb.append(".scaly")
            let file_part name_sb.to_string^rp()
            let mod_path Path.join^rp(base_path, file_part)

            this.lookup_loaded_module_path(mod_path)
        }

        ; ================================================================
        ; Model-function and operator registries.
        ; ================================================================

        function register_function(this: Planner, f: Function)
        {
            model_functions.add(KeyValuePair[String, Function](f.name, f))
        }

        function register_operator(this: Planner, o: Operator)
        {
            model_operators.add(KeyValuePair[String, Operator](o.name, o))
        }

        ; lookup_functions: return every Function in the registry whose
        ; name matches. Overloads are preserved — the caller picks by
        ; argument-type compatibility.
        function lookup_functions#(rp, this: Planner, name: String) returns Vector[Function]
        {
            var matches Array[Function]$()
            var i: size_t 0
            while i < model_functions.length
            {
                let kvp_ptr model_functions.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        matches.add(kvp_ptr.value)
                }
                set i: i + 1
            }
            Vector[Function]^rp(matches)
        }

        function lookup_operators#(rp, this: Planner, name: String) returns Vector[Operator]
        {
            var matches Array[Operator]$()
            var i: size_t 0
            while i < model_operators.length
            {
                let kvp_ptr model_operators.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        matches.add(kvp_ptr.value)
                }
                set i: i + 1
            }
            Vector[Operator]^rp(matches)
        }

        function is_function(this: Planner, name: String) returns bool
        {
            var i: size_t 0
            while i < model_functions.length
            {
                let kvp_ptr model_functions.get(i)
                guard kvp_ptr <> null
                {
                    guard kvp_ptr.key.equals(name)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; ================================================================
        ; register_runtime_functions: synthesize Function entries for the
        ; C runtime functions the RBMM lowering needs (aligned_alloc,
        ; free, exit, …). Matches Planner.cpp's static table.
        ;
        ; Idempotent — call as many times as desired; the registry is
        ; appended to, and duplicates are tolerated by lookup_functions
        ; (it walks every entry anyway).
        ;
        ; Parameter items and return types are built with Type.name
        ; Vectors so resolve_type_base recognises them correctly.
        ; ================================================================
        function register_runtime_functions#(rp, this: Planner)
        {
            ; All Vector / String / Type containers must live on `rp`
            ; (the Planner's owning page) — `$` would put them on this
            ; function's local page, which is freed on return, leaving
            ; every Item.type and Type.generics ref dangling. Symptom
            ; (s100): later `lookup_functions("exit")` returns a Function
            ; whose param Type.generics reads as a tiny non-null bogus
            ; pointer (e.g. 0x8), and resolve_type_base# crashes on
            ; deref.
            ;
            ; Type itself is a value-defined struct (no init#) so we
            ; can't write `Type^rp(...)`. Instead, hold each Type in a
            ; Vector[Type]^rp(1) and take a ref via `vec.get(0)` —
            ; mirrors handle_type# in Modeler.scaly.

            ; aligned_alloc(alignment: size_t, size: size_t) -> pointer[void]
            var aa_size_path Vector[String]^rp(1)
            aa_size_path.put(0, String^rp("size_t"))
            var aa_size_holder Vector[Type]^rp(1)
            aa_size_holder.put(0, Type(
                Span(0, 0), aa_size_path, null,
                Lifetime.Unspecified(Unspecified())
            ))
            let aa_size_ref aa_size_holder.get(0)

            var aa_void_path Vector[String]^rp(1)
            aa_void_path.put(0, String^rp("void"))
            var aa_void_holder Vector[Type]^rp(1)
            aa_void_holder.put(0, Type(
                Span(0, 0), aa_void_path, null,
                Lifetime.Unspecified(Unspecified())
            ))

            var aa_ptr_gens_holder Vector[Vector[Type]]^rp(1)
            aa_ptr_gens_holder.put(0, aa_void_holder)
            let aa_ptr_gens_ref aa_ptr_gens_holder.get(0)

            var aa_ptr_path Vector[String]^rp(1)
            aa_ptr_path.put(0, String^rp("pointer"))
            var aa_ptr_void_holder Vector[Type]^rp(1)
            aa_ptr_void_holder.put(0, Type(
                Span(0, 0), aa_ptr_path, aa_ptr_gens_ref,
                Lifetime.Unspecified(Unspecified())
            ))
            let aa_ptr_void_ref aa_ptr_void_holder.get(0)

            var aa_alignment_name Vector[String]^rp(1)
            aa_alignment_name.put(0, String^rp("alignment"))
            var aa_size_name Vector[String]^rp(1)
            aa_size_name.put(0, String^rp("size"))

            var aa_inputs Vector[Item]^rp(2)
            aa_inputs.put(0, Item(
                Span(0, 0), false,
                aa_alignment_name.get(0),
                aa_size_ref,
                Vector[Attribute]^rp(0)
            ))
            aa_inputs.put(1, Item(
                Span(0, 0), false,
                aa_size_name.get(0),
                aa_size_ref,
                Vector[Attribute]^rp(0)
            ))
            let aligned_alloc_fn Function(
                Span(0, 0), false, false,
                String^rp("aligned_alloc"),
                Vector[GenericParameter]^rp(0),
                null,
                aa_inputs,
                aa_ptr_void_ref,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(aligned_alloc_fn)

            ; free(ptr: pointer[void])
            var free_ptr_name Vector[String]^rp(1)
            free_ptr_name.put(0, String^rp("ptr"))
            var free_inputs Vector[Item]^rp(1)
            free_inputs.put(0, Item(
                Span(0, 0), false,
                free_ptr_name.get(0),
                aa_ptr_void_ref,
                Vector[Attribute]^rp(0)
            ))
            let free_fn Function(
                Span(0, 0), false, false,
                String^rp("free"),
                Vector[GenericParameter]^rp(0),
                null,
                free_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(free_fn)

            ; exit(code: int)
            var int_path Vector[String]^rp(1)
            int_path.put(0, String^rp("int"))
            var int_holder Vector[Type]^rp(1)
            int_holder.put(0, Type(
                Span(0, 0), int_path, null,
                Lifetime.Unspecified(Unspecified())
            ))
            let int_ref int_holder.get(0)

            var exit_code_name Vector[String]^rp(1)
            exit_code_name.put(0, String^rp("code"))
            var exit_inputs Vector[Item]^rp(1)
            exit_inputs.put(0, Item(
                Span(0, 0), false,
                exit_code_name.get(0),
                int_ref,
                Vector[Attribute]^rp(0)
            ))
            let exit_fn Function(
                Span(0, 0), false, false,
                String^rp("exit"),
                Vector[GenericParameter]^rp(0),
                null,
                exit_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(exit_fn)
        }

        ; ================================================================
        ; Method / initializer / property lookup on user types.
        ; ================================================================

        ; collect_methods_in: linear scan of a members Vector, appending
        ; every Function whose name matches. Shared by lookup_methods
        ; across Structure and Union variants.
        function collect_methods_in(
            this: Planner,
            members: Vector[Member],
            method_name: String,
            acc: Array[Function]
        )
        {
            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get(i)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            guard f.name.equals(method_name)
                                acc.add(f)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
        }

        function lookup_methods#(
            rp,
            this: Planner,
            struct_name: String,
            method_name: String
        ) returns Vector[Function]
        {
            var matches Array[Function]$()
            ; s106: when struct_name is namespaced under "scaly." or
            ; "scalyc.", retry with the bare type name if the qualified
            ; name doesn't match. Mirrors Planner.cpp:1447-1453.
            ; Without this, init#'s implicit `page` parameter (typed
            ; pointer[scaly.memory.Page]) never resolves
            ; `page.allocate(...)` against the user's `define Page`, and
            ; the entire `set X: page.allocate(...)` action is dropped.
            var concept_ref this.lookup_concept(struct_name)
            guard concept_ref = null
            {
                var should_strip: bool false
                guard struct_name.starts_with("scaly.")
                    set should_strip: true
                guard struct_name.starts_with("scalyc.")
                    set should_strip: true
                guard should_strip
                {
                    let last_dot struct_name.last_index_of("." as u8)
                    guard last_dot >= 0
                    {
                        let start (last_dot as size_t) + 1
                        let len struct_name.get_length() - start
                        let bare struct_name.substring(rp, start, len)
                        set concept_ref: this.lookup_concept(bare)
                    }
                }
            }
            guard concept_ref = null
                return Vector[Function]^rp(matches)

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    this.collect_methods_in(s.members, method_name, matches)
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    this.collect_methods_in(u.members, method_name, matches)
                    0
                }
                else
                    0

            Vector[Function]^rp(matches)
        }

        ; lookup_property: find a struct field by name. Returns a
        ; reference into the Structure's properties Vector — valid as
        ; long as the underlying Concept is live in the registry.
        function lookup_property(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns ref[Property]?
        {
            let concept_ref this.lookup_concept(struct_name)
            guard concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get(i)
                        guard p_ptr <> null
                        {
                            guard p_ptr.name.equals(property_name)
                                return p_ptr
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; find_initializer: locate an Initializer on a Struct-shaped
        ; concept whose parameter types are pairwise compatible with
        ; `arg_types`. Returns null when no match. Deliberately linear —
        ; matching against the first compatible overload.
        ; check_initializer_match: returns the Initializer pointer if
        ; its input matches arg_types (after skipping any implicit
        ; page parameter, which is already excluded from input by the
        ; Modeler). `exact_only` selects types_equal vs types_compatible.
        function check_initializer_match#(
            rp,
            this: Planner,
            ini: Initializer,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            guard ini.input.length <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr ini.input.get(j)
                let a_ptr arg_types.get(j)
                guard p_ptr = null
                    return false
                guard a_ptr = null
                    return false
                guard p_ptr.type <> null
                {
                    let pt (*p_ptr.type)
                    let planned_pt this.plan_type#(pt)
                    let arg (*a_ptr)
                    var ok: bool false
                    guard exact_only
                        set ok: Planner.types_equal(planned_pt, arg)
                    guard exact_only = false
                        set ok: Planner.types_compatible(planned_pt, arg)
                    guard ok = false
                        return false
                }
                set j: j + 1
            }

            true
        }

        function find_initializer#(
            rp,
            this: Planner,
            struct_name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[Initializer]?
        {
            let concept_ref this.lookup_concept(struct_name)
            guard concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    ; Pass 1: exact match.
                    var i: size_t 0
                    while i < s.initializers.length
                    {
                        let init_ptr s.initializers.get(i)
                        guard init_ptr <> null
                        {
                            let ini (*init_ptr)
                            guard this.check_initializer_match#(ini, arg_types, true)
                                return init_ptr
                        }
                        set i: i + 1
                    }
                    ; Pass 2: compatible match.
                    var k: size_t 0
                    while k < s.initializers.length
                    {
                        let init_ptr s.initializers.get(k)
                        guard init_ptr <> null
                        {
                            let ini (*init_ptr)
                            guard this.check_initializer_match#(ini, arg_types, false)
                                return init_ptr
                        }
                        set k: k + 1
                    }

                    ; Pass 3: generic inference. For each initializer,
                    ; plan the parameter types, infer generic bindings
                    ; against arg_types, and accept if the concept's
                    ; parameters are fully bound.
                    guard c.parameters.length > 0
                    {
                        var g: size_t 0
                        while g < s.initializers.length
                        {
                            let init_ptr s.initializers.get(g)
                            guard init_ptr <> null
                            {
                                let ini (*init_ptr)
                                guard ini.input.length = arg_types.length
                                {
                                    var param_types_arr Array[PlannedType]$()
                                    var pi: size_t 0
                                    while pi < ini.input.length
                                    {
                                        let p_ptr ini.input.get(pi)
                                        guard p_ptr <> null
                                        {
                                            guard p_ptr.type <> null
                                            {
                                                let pt (*p_ptr.type)
                                                param_types_arr.add(this.plan_type#(pt))
                                            }
                                        }
                                        set pi: pi + 1
                                    }
                                    var param_types_vec Vector[PlannedType]^rp(param_types_arr)
                                    let bindings this.infer_type_arguments#(
                                        param_types_vec, arg_types
                                    )
                                    guard bindings.length >= c.parameters.length
                                        return init_ptr
                                }
                            }
                            set g: g + 1
                        }
                    }

                    null
                }
                else
                    null
        }

        ; get_property_index: position of a named property in the struct.
        ; Returns -1 if the type isn't a struct or the property is missing.
        function get_property_index(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(struct_name)
            guard concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get(i)
                        guard p_ptr <> null
                        {
                            guard p_ptr.name.equals(property_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant: find a union variant by name and return its tag.
        ; Returns -1 if the concept is missing or not a Union, or if the
        ; variant name is not present.
        function lookup_variant_tag(
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(union_name)
            guard concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get(i)
                        guard v_ptr <> null
                        {
                            guard v_ptr.name.equals(variant_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant_type: fetch the payload PlannedType for a named
        ; variant. Returns null when the concept isn't a union, the
        ; variant doesn't exist, or the variant has no payload (tag-only
        ; variants like Option.None).
        function lookup_variant_type#(
            rp,
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns ref[PlannedType]?
        {
            let concept_ref this.lookup_concept(union_name)
            guard concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get(i)
                        guard v_ptr <> null
                        {
                            guard v_ptr.name.equals(variant_name)
                            {
                                guard v_ptr.type = null
                                    return null
                                let vt (*v_ptr.type)
                                var holder Vector[PlannedType]^rp(1)
                                holder.put(0, this.plan_type#(vt))
                                return holder.get(0)
                            }
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; match_type_pattern: walk `pattern` and `actual` in parallel,
        ; collecting generic-parameter → concrete-type bindings.
        ; Recursion handles nested generics (e.g. matching `Vector[T]`
        ; against `Vector[int]` yields `T -> int`).
        ;
        ; Runs purely — returns a fresh Vector each call rather than
        ; mutating a caller-supplied accumulator, because passing a
        ; mutable Array as a parameter doesn't propagate in Scaly's
        ; value-semantics model.
        function match_type_pattern#(
            rp,
            this: Planner,
            pattern: PlannedType,
            actual: PlannedType
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]$()

            guard Planner.is_generic_type_param_name(pattern.name)
            {
                result.add(KeyValuePair[String, PlannedType](pattern.name, actual))
                return Vector[KeyValuePair[String, PlannedType]]^rp(result)
            }

            guard pattern.generics <> null
            {
                guard actual.generics <> null
                {
                    let pg (*pattern.generics)
                    let ag (*actual.generics)
                    guard pg.length = ag.length
                    {
                        var i: size_t 0
                        while i < pg.length
                        {
                            let pp_ptr pg.get(i)
                            let ap_ptr ag.get(i)
                            guard pp_ptr <> null
                            {
                                guard ap_ptr <> null
                                {
                                    let inner this.match_type_pattern#(
                                        (*pp_ptr), (*ap_ptr)
                                    )
                                    var j: size_t 0
                                    while j < inner.length
                                    {
                                        let kv_ptr inner.get(j)
                                        guard kv_ptr <> null
                                            result.add((*kv_ptr))
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
            }

            Vector[KeyValuePair[String, PlannedType]]^rp(result)
        }

        ; infer_type_arguments: given a function's parameter types
        ; (possibly containing generic parameters like T, K) and the
        ; actual argument types at a call site, infer the concrete type
        ; assignments. Returns a flat Vector of name→type pairs; may
        ; contain duplicates for a generic parameter inferred from
        ; multiple positions (all should agree — agreement is checked
        ; downstream during substitution).
        function infer_type_arguments#(
            rp,
            this: Planner,
            param_types: Vector[PlannedType],
            arg_types: Vector[PlannedType]
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]$()
            guard param_types.length = arg_types.length
                return Vector[KeyValuePair[String, PlannedType]]^rp(result)

            var i: size_t 0
            while i < param_types.length
            {
                let p_ptr param_types.get(i)
                let a_ptr arg_types.get(i)
                guard p_ptr <> null
                {
                    guard a_ptr <> null
                    {
                        let matches this.match_type_pattern#(
                            (*p_ptr), (*a_ptr)
                        )
                        var j: size_t 0
                        while j < matches.length
                        {
                            let kv_ptr matches.get(j)
                            guard kv_ptr <> null
                                result.add((*kv_ptr))
                            set j: j + 1
                        }
                    }
                }
                set i: i + 1
            }

            Vector[KeyValuePair[String, PlannedType]]^rp(result)
        }

        ; instantiate_generic_function: monomorphise a generic function
        ; (one whose parameter types reference type-parameter names like
        ; T / K / V) against a substitution mapping those names to
        ; concrete types. The resulting PlannedFunction has each use of
        ; T replaced with its concrete binding, and is recorded in the
        ; instantiation cache via plan_function.
        function instantiate_generic_function#(
            rp,
            this: Planner,
            f: Function,
            args: Vector[KeyValuePair[String, PlannedType]]
        ) returns PlannedFunction
        {
            let saved_len type_substitutions.length

            var i: size_t 0
            while i < args.length
            {
                let kv_ptr args.get(i)
                guard kv_ptr <> null
                    this.define_type_substitution(kv_ptr.key, kv_ptr.value)
                set i: i + 1
            }

            let result this.plan_function#(f, null)
            set type_substitutions.length: saved_len
            result
        }

        ; ================================================================
        ; instantiate_generic: monomorphise a generic Concept against a
        ; concrete type-argument list. Binds each GenericParameter name
        ; to its corresponding argument in `type_substitutions`, plans
        ; the concept's definition so the struct-layout cache gets the
        ; instantiated version, then restores the substitution stack.
        ;
        ; Returns the resulting PlannedType with `generics` populated
        ; and `mangled_name` set via mangle_structure. Missing concepts
        ; fall back to a fresh type variable — keeps the planner
        ; productive on incomplete programs.
        ; ================================================================
        function instantiate_generic#(
            rp,
            this: Planner,
            concept_name: String,
            args: Vector[PlannedType],
            loc: Span
        ) returns PlannedType
        {
            let concept_ref this.lookup_concept(concept_name)
            guard concept_ref = null
                return this.fresh_type_var#(concept_name)

            let c (*concept_ref)

            ; Compute the mangled name upfront so we can short-circuit
            ; repeat instantiations (e.g. Vector[int] used from two
            ; sites). Without this, each call would re-plan the
            ; definition and re-append to instantiated_{structures,
            ; unions}.
            var args_holder Vector[PlannedType]^rp(args)
            let mangled Planner.mangle_structure#(concept_name, &args_holder)

            var already_cached: bool false
            guard this.has_instantiated_structure(mangled)
                set already_cached: true
            guard already_cached = false
                guard this.has_instantiated_union(mangled)
                    set already_cached: true

            ; s116: cycle detection. Re-entry during cross-module
            ; nested-generic planning (plan_structure# walks members →
            ; plan_function# → plan_type# → instantiate_generic#) was
            ; blowing the stack in resolve_type_base# before the outer
            ; struct landed in instantiated_structures. If `mangled` is
            ; already in instantiating_structures, return the shell
            ; PlannedType without re-planning. The outer call eventually
            ; completes and records the structure.
            guard already_cached = false
            {
                var i: size_t 0
                while i < instantiating_structures.length
                {
                    let im_ptr instantiating_structures.get(i)
                    guard im_ptr <> null
                    {
                        guard im_ptr.equals(mangled)
                            set already_cached: true
                    }
                    set i: i + 1
                }
            }

            guard already_cached = false
            {
                instantiating_structures.add(mangled)

                let saved_subst_len type_substitutions.length

                ; Bind each generic parameter name to its concrete argument.
                var i: size_t 0
                while i < c.parameters.length
                {
                    guard i < args.length
                    {
                        let p_ptr c.parameters.get(i)
                        let a_ptr args.get(i)
                        guard p_ptr <> null
                        {
                            guard a_ptr <> null
                                this.define_type_substitution(p_ptr.name, (*a_ptr))
                        }
                    }
                    set i: i + 1
                }

                ; Plan the underlying definition so the cache records
                ; the instantiated struct/union. The returned planned
                ; value is unused — we rebuild the PlannedType shell
                ; below with the correct generics/mangled_name.
                choose c.definition
                    when s: Structure
                    {
                        let pl this.plan_structure#(s, concept_name)
                        0
                    }
                    when u: scalyc.compiler.Model.Union
                    {
                        let pl this.plan_union#(u, concept_name)
                        0
                    }
                    else
                        0

                ; Pop substitutions back to what the caller had.
                set type_substitutions.length: saved_subst_len

                ; Pop instantiating-marker. Length-based pop matches the
                ; type_substitutions discipline above; the add() above
                ; was the only push for this frame.
                guard instantiating_structures.length > 0
                    set instantiating_structures.length: instantiating_structures.length - 1
            }

            PlannedType(
                loc,
                String^rp(concept_name),
                mangled,
                &args_holder,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            )
        }

        ; ================================================================
        ; check_function_match: test a single Function candidate against
        ; argument types. Returns a ref to the return type if it matches,
        ; null otherwise. `exact_only` selects types_equal (true) vs
        ; types_compatible (false) for parameter/argument comparison.
        ; 'this' parameters are skipped implicitly.
        ; ================================================================
        function check_function_match#(
            rp,
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[MethodMatch]?
        {
            var param_start: size_t 0
            guard f.input.length > 0
            {
                let first_ptr f.input.get(0)
                guard first_ptr <> null
                {
                    guard first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        guard fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            guard expected_arity <> arg_types.length
                return null

            var planned_params_arr Array[PlannedType]$()
            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get(j)
                guard p_ptr = null
                    return null
                guard a_ptr = null
                    return null
                guard p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    guard exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    guard exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    guard ok = false
                        return null
                    planned_params_arr.add(planned_p)
                }
                set j: j + 1
            }
            var params_holder Vector[PlannedType]^rp(planned_params_arr)

            var return_type: PlannedType Planner.make_void_type#()
            guard f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type#(rt)
            }

            var has_page: bool false
            guard f.page_parameter <> null
                set has_page: true
            guard Planner.needs_implicit_return_page(f)
                set has_page: true

            ; Extern C functions use their unmangled name so the linker
            ; finds them in libc / system libraries. Mirrors
            ; Planner.cpp:9714-9716.
            var mangled: String String^rp(f.name)
            guard Planner.is_extern_impl(f.implementation) = false
            {
                ; s101: Namespace sibling call. When the call is being
                ; planned inside a namespace's body and `f` is a member
                ; of that namespace, mangle with the namespace prefix
                ; (e.g. `_ZN6helper5greetEv`) instead of the free-function
                ; encoding (`_Z5greetv`). Mirrors stage-0 Planner.cpp:
                ; 9653-9665 (sibling detection) + 9788-9793 (mangling).
                ; Without this, sibling calls from inside `define helper
                ; { function greet() ... function test() greet() }` link
                ; against a non-existent `_Z5greetv` symbol, the call
                ; falls through to lookup-fail in emit_call, returns
                ; null, and stage-1 silently drops the entire body.
                var is_namespace_sibling: bool false
                guard current_namespace <> null
                {
                    guard current_namespace_name <> null
                    {
                        let ns (*current_namespace)
                        var mi: size_t 0
                        while mi < ns.members.length
                        {
                            let m_ptr ns.members.get(mi)
                            guard m_ptr <> null
                            {
                                let mem (*m_ptr)
                                choose mem
                                    when nf: Function
                                    {
                                        guard nf.name.equals(f.name)
                                        {
                                            guard nf.input.length = f.input.length
                                                set is_namespace_sibling: true
                                        }
                                    }
                                    else
                                        0
                            }
                            set mi: mi + 1
                        }
                    }
                }

                guard is_namespace_sibling = false
                    set mangled: Planner.mangle_free_function_from_types#(
                        f.name, params_holder, has_page
                    )

                guard is_namespace_sibling
                {
                    ; Build a PlannedType for the namespace and items
                    ; for params, then call mangle_function# with parent.
                    let cnsn (*current_namespace_name)
                    var ns_parent_holder Vector[PlannedType]^rp(1)
                    ns_parent_holder.put(0, PlannedType(
                        Span(0, 0),
                        String^rp(cnsn),
                        Planner.encode_name(cnsn),
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        String^rp(""),
                        null
                    ))
                    let ns_parent_ref ns_parent_holder.get(0)
                    var items_arr Array[PlannedItem]$()
                    var pi2: size_t 0
                    while pi2 < params_holder.length
                    {
                        let p_ptr2 params_holder.get(pi2)
                        guard p_ptr2 <> null
                        {
                            var ity_holder Vector[PlannedType]^rp(1)
                            ity_holder.put(0, (*p_ptr2))
                            items_arr.add(PlannedItem(
                                Span(0, 0),
                                false,
                                null,
                                ity_holder.get(0),
                                null
                            ))
                        }
                        set pi2: pi2 + 1
                    }
                    var items_holder Vector[PlannedItem]^rp(items_arr)
                    set mangled: Planner.mangle_function#(
                        f.name, &items_holder, ns_parent_ref, has_page
                    )
                }
            }

            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            guard f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                var th_holder Vector[PlannedType]^rp(1)
                th_holder.put(0, this.plan_type#(tt))
                set throws_ref: th_holder.get(0)
            }

            var match_holder Vector[MethodMatch]^rp(1)
            match_holder.put(0, MethodMatch(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false
            ))
            match_holder.get(0)
        }

        ; ================================================================
        ; resolve_function_call: return a MethodMatch describing the
        ; chosen overload of `name` for the given argument types. Two-pass
        ; overload resolution: exact matches first, then compatible
        ; (widened), then generic instantiation. 'this' parameters are
        ; implicitly skipped.
        ;
        ; Returns null when no overload matches; callers fall back to a
        ; fresh type variable so the constraint solver can recover.
        ; ================================================================
        function resolve_function_call#(
            rp,
            this: Planner,
            name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            let candidates this.lookup_functions#(name)
            guard candidates.length = 0
            {
                var sb StringBuilder$()
                sb.append("function not found: ")
                sb.append(name)
                this.add_error(sb.to_string^rp())
                return null
            }

            ; Pass 1: exact matches (types_equal).
            var i: size_t 0
            while i < candidates.length
            {
                let f_ptr candidates.get(i)
                guard f_ptr <> null
                {
                    let f (*f_ptr)
                    let m this.check_function_match#(f, arg_types, true)
                    guard m <> null
                        return m
                }
                set i: i + 1
            }

            ; Pass 2: compatible matches (types_compatible, allows widening).
            var k: size_t 0
            while k < candidates.length
            {
                let f_ptr candidates.get(k)
                guard f_ptr <> null
                {
                    let f (*f_ptr)
                    let m this.check_function_match#(f, arg_types, false)
                    guard m <> null
                        return m
                }
                set k: k + 1
            }

            ; Pass 3: generic overload. For candidates declaring type
            ; parameters, plan the declared parameter types and run
            ; pattern inference against the argument types. On a
            ; successful inference, instantiate the generic and build a
            ; MethodMatch from the instantiated PlannedFunction.
            var g: size_t 0
            while g < candidates.length
            {
                let f_ptr candidates.get(g)
                guard f_ptr <> null
                {
                    let f (*f_ptr)
                    guard f.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        guard f.input.length > 0
                        {
                            let fi0 f.input.get(0)
                            guard fi0 <> null
                            {
                                guard fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    guard fname.equals(String$("this"))
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity f.input.length - param_start2
                        guard expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]$()
                            var pi: size_t param_start2
                            while pi < f.input.length
                            {
                                let p_ptr f.input.get(pi)
                                guard p_ptr <> null
                                {
                                    guard p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type#(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType]^rp(param_types_arr)

                            let bindings this.infer_type_arguments#(
                                param_types_vec, arg_types
                            )
                            guard bindings.length >= f.parameters.length
                            {
                                let inst this.instantiate_generic_function#(f, bindings)
                                var inst_return: PlannedType Planner.make_void_type#()
                                guard inst.return_type <> null
                                    set inst_return: (*inst.return_type)

                                var match_holder Vector[MethodMatch]^rp(1)
                                match_holder.put(0, MethodMatch(
                                    null,
                                    inst.mangled_name,
                                    inst_return,
                                    &param_types_vec,
                                    inst.page_parameter <> null,
                                    inst.can_throw,
                                    inst.throws_type,
                                    false
                                ))
                                return match_holder.get(0)
                            }
                        }
                    }
                }
                set g: g + 1
            }

            var sb StringBuilder$()
            sb.append("no matching overload for function: ")
            sb.append(name)
            this.add_error(sb.to_string^rp())
            null
        }

        ; mangle_binary_operator: convenience wrapper that constructs
        ; the PlannedItem list mangle_operator expects from two
        ; PlannedType arguments. Holder Vectors keep both types alive
        ; on rp so their refs are stable for the Item construction.
        function mangle_binary_operator#(
            rp,
            this: Planner,
            op_name: String,
            left: PlannedType,
            right: PlannedType
        ) returns String
        {
            var left_holder Vector[PlannedType]^rp(1)
            left_holder.put(0, left)
            var right_holder Vector[PlannedType]^rp(1)
            right_holder.put(0, right)

            var items Vector[PlannedItem]^rp(2)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, left_holder.get(0), null
            ))
            items.put(1, PlannedItem(
                Span(0, 0), false, null, right_holder.get(0), null
            ))

            Planner.mangle_operator#(op_name, &items, null)
        }

        ; mangle_unary_operator: same idea for prefix/unary operators.
        function mangle_unary_operator#(
            rp,
            this: Planner,
            op_name: String,
            operand: PlannedType
        ) returns String
        {
            var holder Vector[PlannedType]^rp(1)
            holder.put(0, operand)

            var items Vector[PlannedItem]^rp(1)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, holder.get(0), null
            ))

            Planner.mangle_operator#(op_name, &items, null)
        }

        ; make_planned_call: assemble a PlannedCall for a resolved call
        ; site. Callers provide the mangled symbol, result type, and
        ; planned argument list; flags default to the common
        ; "non-intrinsic, non-operator, non-throwing, no-page" case.
        function make_planned_call#(
            rp,
            this: Planner,
            loc: Span,
            name: String,
            mangled_name: String,
            result_type: PlannedType,
            args: Vector[PlannedOperand]
        ) returns PlannedCall
        {
            var args_holder Vector[PlannedOperand]^rp(args)
            PlannedCall(
                loc,
                name,
                mangled_name,
                false,
                false,
                false,
                false,
                &args_holder,
                result_type,
                Lifetime.Unspecified(Unspecified())
            )
        }

        ; collapse_operand_sequence: fold a flat operand list of the
        ; shape [lhs, op, rhs, op, rhs, ...] into a single PlannedOperand
        ; representing the combined expression. LEFT-ASSOCIATIVE — this
        ; drops operator precedence; a full precedence-climbing version
        ; is a later refactor. Empty and single-element inputs pass
        ; through unchanged.
        function collapse_operand_sequence#(
            rp,
            this: Planner,
            ops: Vector[PlannedOperand]
        ) returns PlannedOperand
        {
            guard ops.length = 0
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type(void_ty),
                    null,
                    void_ty
                )
            }
            guard ops.length = 1
            {
                let only_ptr ops.get(0)
                guard only_ptr = null
                {
                    let void_ty Planner.make_void_type#()
                    return PlannedOperand(
                        Span(0, 0),
                        PlannedExpression.Type(void_ty),
                        null,
                        void_ty
                    )
                }
                return (*only_ptr)
            }

            ; s107: pre-pass — combine `Type + Matrix` into a generic
            ; Type with concrete generic args. The Modeler emits
            ; `Box[int](42)` as three operands [Type(Box), Matrix([int]),
            ; Tuple((42))] because NameSyntax has no generics field
            ; (parser puts the bracket part as a separate VectorSyntax
            ; → Matrix in the operand list). Without this merger,
            ; the struct-ctor branch below sees `Box` (no generics) and
            ; can't instantiate Box[int]. Mirrors stage-0
            ; Planner.cpp:7170-7247.
            ;
            ; Restricted to the common simple shape: Type with no
            ; existing generics + Matrix where each row is a single
            ; Type operand. Nested generics like Box[Box[int]] need
            ; the recursive extractor stage-0 has — leave that for a
            ; later port.
            var has_gen_combo: bool false
            var gci: size_t 0
            while gci + 1 < ops.length
            {
                let cur_ptr ops.get(gci)
                let nxt_ptr ops.get(gci + 1)
                guard cur_ptr <> null
                {
                    guard nxt_ptr <> null
                    {
                        let cur_op (*cur_ptr)
                        let nxt_op (*nxt_ptr)
                        var cur_is_bare_type: bool false
                        choose cur_op.expr
                            when ct: PlannedType
                            {
                                guard ct.name.get_length() > 0
                                    guard ct.generics = null
                                        set cur_is_bare_type: true
                            }
                            else
                                0
                        guard cur_is_bare_type
                        {
                            choose nxt_op.expr
                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                    set has_gen_combo: true
                                else
                                    0
                        }
                    }
                }
                set gci: gci + 1
            }

            guard has_gen_combo
            {
                var merged_arr2 Array[PlannedOperand]$()
                var ci2: size_t 0
                while ci2 < ops.length
                {
                    let cp_ptr ops.get(ci2)
                    guard cp_ptr = null
                    {
                        set ci2: ci2 + 1
                        continue
                    }
                    let cp_op (*cp_ptr)

                    ; Try to merge with the next operand if it's a Matrix.
                    var did_merge2: bool false
                    guard ci2 + 1 < ops.length
                    {
                        let np_ptr ops.get(ci2 + 1)
                        guard np_ptr <> null
                        {
                            let np_op (*np_ptr)
                            choose cp_op.expr
                                when ct2: PlannedType
                                {
                                    guard ct2.name.get_length() > 0
                                    {
                                        guard ct2.generics = null
                                        {
                                            choose np_op.expr
                                                when nm2: scalyc.compiler.Plan.PlannedMatrix
                                                {
                                                    ; Extract one Type from each row using the
                                                    ; recursive helper so nested generics like
                                                    ; Box[Box[int]] (row.length==2: [Type, Matrix])
                                                    ; resolve correctly. Mirrors stage-0
                                                    ; Planner.cpp:7180-7214 (extractTypeFromRow).
                                                    var ok_extract: bool true
                                                    var gens_arr Array[Type]$()
                                                    guard nm2.operations <> null
                                                    {
                                                        let rows (*nm2.operations)
                                                        var ri: size_t 0
                                                        while ri < rows.length
                                                        {
                                                            let row_ptr rows.get(ri)
                                                            guard row_ptr <> null
                                                            {
                                                                let row (*row_ptr)
                                                                let extracted Planner.extract_row_to_type#(row)
                                                                guard extracted = null
                                                                    set ok_extract: false
                                                                guard extracted <> null
                                                                    gens_arr.add((*extracted))
                                                            }
                                                            set ri: ri + 1
                                                        }
                                                    }
                                                    guard ok_extract
                                                    {
                                                        guard gens_arr.length > 0
                                                        {
                                                            var name_path Vector[String]^rp(1)
                                                            name_path.put(0, ct2.name)
                                                            var model_gens Vector[Type]^rp(gens_arr)
                                                            ; Use the Matrix's lifetime when set —
                                                            ; `Vector[T]^rp` parses [T]^rp as a Matrix
                                                            ; carrying the lifetime, not the bare Type
                                                            ; that precedes it. Mirrors stage-0
                                                            ; Planner.cpp:7235-7237.
                                                            var final_life: Lifetime ct2.life
                                                            choose nm2.life
                                                                when u: Unspecified
                                                                    0
                                                                else
                                                                    set final_life: nm2.life
                                                            let merged_type this.plan_type#(Type(
                                                                ct2.loc,
                                                                name_path,
                                                                &model_gens,
                                                                final_life
                                                            ))
                                                            let merged_op PlannedOperand(
                                                                cp_op.loc,
                                                                PlannedExpression.Type(merged_type),
                                                                np_op.member_access,
                                                                merged_type
                                                            )
                                                            merged_arr2.add(merged_op)
                                                            set did_merge2: true
                                                        }
                                                    }
                                                    0
                                                }
                                                else
                                                    0
                                        }
                                    }
                                    0
                                }
                                else
                                    0
                        }
                    }

                    guard did_merge2
                    {
                        set ci2: ci2 + 2
                        continue
                    }

                    merged_arr2.add(cp_op)
                    set ci2: ci2 + 1
                }
                var merged_vec2 Vector[PlannedOperand]^rp(merged_arr2)
                ; s138: progress guard. If the rebuild produced the
                ; same length (no actual merges — e.g.,
                ; extract_row_to_type# returned null for every row),
                ; recursing would loop forever. Fall through to the
                ; rest of the function instead.
                guard merged_vec2.length < ops.length
                    return this.collapse_operand_sequence#(merged_vec2)
            }

            ; Pre-pass: merge lifetime-marker operands into the
            ; preceding Type operand. Runs AFTER the s107 generic
            ; merger so that `Vector[String]^rp(1)` (parsed as
            ; [Type(Vector), Matrix([String]), Marker(^rp), Tuple])
            ; first becomes [Type(Vector,[String]), Marker, Tuple]
            ; and then [Type(Vector,[String], life=Reference("rp")),
            ; Tuple]. With the original ordering (lifetime first),
            ; the marker would be dropped because the previous op is
            ; a Matrix, not a Type — silently losing the lifetime.
            ; Mirrors stage-0 Planner.cpp:7378-7387.
            var has_life_marker: bool false
            var lim_idx: size_t 0
            while lim_idx < ops.length
            {
                let lim_ptr ops.get(lim_idx)
                guard lim_ptr <> null
                {
                    let lim_op (*lim_ptr)
                    choose lim_op.expr
                        when ty: PlannedType
                        {
                            guard ty.name.get_length() = 0
                            {
                                ; A PlannedType with empty name is
                                ; the lifetime marker.
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                        set has_life_marker: true
                            }
                            0
                        }
                        else
                            0
                }
                set lim_idx: lim_idx + 1
            }

            guard has_life_marker
            {
                ; Build a fresh ops Vector that drops the markers and
                ; merges each one's lifetime into the preceding
                ; PlannedType operand (if any). Look ahead from each
                ; current op: if it is a Type AND the next op is a
                ; lifetime marker, append the merged Type and skip
                ; both. Otherwise append unmodified.
                var merged_arr Array[PlannedOperand]$()
                var mi: size_t 0
                while mi < ops.length
                {
                    let mp_ptr ops.get(mi)
                    guard mp_ptr = null
                    {
                        set mi: mi + 1
                        continue
                    }
                    let mp_op (*mp_ptr)

                    ; If THIS op is a marker (no prior Type to merge
                    ; into), drop it.
                    var is_marker: bool false
                    choose mp_op.expr
                        when ty: PlannedType
                        {
                            guard ty.name.get_length() = 0
                            {
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                        set is_marker: true
                            }
                            0
                        }
                        else
                            0
                    guard is_marker
                    {
                        set mi: mi + 1
                        continue
                    }

                    ; Look ahead: if the next op is a marker AND
                    ; current op is a Type, merge the lifetime in
                    ; before appending and advance past both.
                    var did_merge: bool false
                    guard mi + 1 < ops.length
                    {
                        let next_ptr ops.get(mi + 1)
                        guard next_ptr <> null
                        {
                            let next_op (*next_ptr)
                            var next_is_marker: bool false
                            var marker_life: Lifetime Lifetime.Unspecified(Unspecified())
                            choose next_op.expr
                                when ty2: PlannedType
                                {
                                    guard ty2.name.get_length() = 0
                                    {
                                        choose ty2.life
                                            when u: Unspecified
                                                0
                                            else
                                            {
                                                set next_is_marker: true
                                                set marker_life: ty2.life
                                            }
                                    }
                                    0
                                }
                                else
                                    0

                            guard next_is_marker
                            {
                                choose mp_op.expr
                                    when prev_ty: PlannedType
                                    {
                                        let new_ty PlannedType(
                                            prev_ty.loc,
                                            prev_ty.name,
                                            prev_ty.mangled_name,
                                            prev_ty.generics,
                                            marker_life,
                                            prev_ty.origin,
                                            prev_ty.array_size,
                                            prev_ty.variable
                                        )
                                        let new_op PlannedOperand(
                                            mp_op.loc,
                                            PlannedExpression.Type(new_ty),
                                            mp_op.member_access,
                                            new_ty
                                        )
                                        merged_arr.add(new_op)
                                        set did_merge: true
                                        0
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    guard did_merge
                    {
                        ; Advance past current Type AND the marker.
                        set mi: mi + 2
                        continue
                    }

                    merged_arr.add(mp_op)
                    set mi: mi + 1
                }
                var merged_vec Vector[PlannedOperand]^rp(merged_arr)
                ; s138: progress guard. Same as the s107 merge above:
                ; if no marker was actually merged or dropped, avoid
                ; infinite recursion.
                guard merged_vec.length < ops.length
                    return this.collapse_operand_sequence#(merged_vec)
            }

            let first_ptr ops.get(0)
            guard first_ptr = null
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type(void_ty),
                    null,
                    void_ty
                )
            }
            var result: PlannedOperand (*first_ptr)

            ; Prefix operator: first operand is a Type whose name is an
            ; operator (`-x`, `!flag`, `*ptr`, etc.). Recurse on the
            ; rest, resolve against the rest's result type, and wrap in
            ; a single PlannedCall. The whole sequence is consumed.
            choose result.expr
                when ty: PlannedType
                {
                    guard Planner.is_operator_name(ty.name)
                    {
                        let prefix_name ty.name
                        var rest_arr Array[PlannedOperand]$()
                        var r: size_t 1
                        while r < ops.length
                        {
                            let p_ptr ops.get(r)
                            guard p_ptr <> null
                            {
                                let p_op (*p_ptr)
                                ; If a prefix operator is followed by a
                                ; single-component anonymous Tuple (a
                                ; grouping `(...)`), expand the Tuple's
                                ; interior operands so the inner sequence
                                ; collapses (e.g. `*(data + index)` →
                                ; `*` applied to the collapsed
                                ; `data + index` PlannedCall). Without
                                ; this, emit_tuple's grouping shortcut
                                ; emits only `data` and the GEP for
                                ; pointer-arith deref vanishes. Mirrors
                                ; stage-0 Planner.cpp:4178-4181 where the
                                ; Tuple is consumed as-is because its
                                ; interior was already collapsed during
                                ; planTuple (Planner.cpp:10507).
                                var expanded: bool false
                                guard r = 1
                                {
                                    guard ops.length = 2
                                    {
                                        choose p_op.expr
                                            when tup: PlannedTuple
                                            {
                                                guard tup.components <> null
                                                {
                                                    let comps (*tup.components)
                                                    guard comps.length = 1
                                                    {
                                                        let c0_ptr comps.get(0)
                                                        guard c0_ptr <> null
                                                        {
                                                            let c0 (*c0_ptr)
                                                            guard c0.name = null
                                                            {
                                                                guard c0.value <> null
                                                                {
                                                                    let inner (*c0.value)
                                                                    guard inner.length > 0
                                                                    {
                                                                        var ii: size_t 0
                                                                        while ii < inner.length
                                                                        {
                                                                            let ip_ptr inner.get(ii)
                                                                            guard ip_ptr <> null
                                                                                rest_arr.add((*ip_ptr))
                                                                            set ii: ii + 1
                                                                        }
                                                                        set expanded: true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                                0
                                    }
                                }
                                guard expanded = false
                                    rest_arr.add(p_op)
                            }
                            set r: r + 1
                        }
                        var rest_vec Vector[PlannedOperand]^rp(rest_arr)
                        let rest_result this.collapse_operand_sequence#(rest_vec)

                        let rt_ref this.resolve_prefix_operator_call#(
                            prefix_name, rest_result.result_type
                        )
                        ; For built-in primitive prefix ops the operator
                        ; isn't in the registry — derive the result type
                        ; from the operator. Mirrors Planner.cpp:4138-4157.
                        var rt: PlannedType rest_result.result_type
                        guard rt_ref <> null
                            set rt: (*rt_ref)
                        guard rt_ref = null
                        {
                            guard prefix_name.equals(String$("!"))
                                set rt: Planner.make_bool_type#()
                            guard prefix_name.equals(String$("not"))
                                set rt: Planner.make_bool_type#()
                            guard prefix_name.equals(String$("*"))
                            {
                                ; Dereference: result is the pointer's
                                ; element type (first generic parameter).
                                guard rest_result.result_type.generics <> null
                                {
                                    let gens (*rest_result.result_type.generics)
                                    guard gens.length > 0
                                    {
                                        let g_ptr gens.get(0)
                                        guard g_ptr <> null
                                            set rt: (*g_ptr)
                                    }
                                }
                            }
                            ; s96: address-of — wrap operand in pointer[T].
                            ; Mirrors stage-0 Planner.cpp:3877 (resolvePrefix
                            ; OperatorCall: Name=="pointer", Generics=[Operand],
                            ; MangledName="P"+Operand.MangledName). Without
                            ; this, `&x` falls through to rt=operand_type,
                            ; meaning callers see the bare T and downstream
                            ; resolve_function_call# arity-checks against
                            ; ref[T] / pointer[T] params using the wrong
                            ; argument type — fails, drops the call.
                            ; types_compatible (s96 part 2) extends the
                            ; rule set so pointer[T] flows into ref[T] /
                            ; pointer[T] params.
                            guard prefix_name.equals(String$("&"))
                                set rt: Planner.make_pointer_type#(rest_result.result_type)
                        }

                        let mangled this.mangle_unary_operator#(
                            prefix_name, rest_result.result_type
                        )
                        var args_v Vector[PlannedOperand]^rp(1)
                        args_v.put(0, rest_result)
                        ; Mirrors Planner.cpp:4131-4132 — prefix operators on
                        ; primitive types are intrinsic (is_intrinsic=true,
                        ; is_operator=true). emit_call dispatches to
                        ; emit_intrinsic_operator instead of looking up a
                        ; non-existent library function.
                        var args_holder_p Vector[PlannedOperand]^rp(args_v)
                        let call PlannedCall(
                            result.loc,
                            prefix_name,
                            mangled,
                            true,
                            true,
                            false,
                            false,
                            &args_holder_p,
                            rt,
                            Lifetime.Unspecified(Unspecified())
                        )
                        return PlannedOperand(
                            result.loc,
                            PlannedExpression.Call(call),
                            null,
                            rt
                        )
                    }
                    0
                }
                else
                    0

            ; Call detection: first operand followed by a Tuple. Two
            ; shapes accepted:
            ;   - free function: first operand's expr is a Type (name
            ;     reference);
            ;   - method call: first operand has a member_access chain
            ;     whose last hop is_method=true (from resolve_member_access).
            guard ops.length >= 2
            {
                let second_ptr ops.get(1)
                guard second_ptr <> null
                {
                    let second (*second_ptr)
                    var is_call: bool false
                    var fn_name: String String^rp("")

                    ; Method-call branch FIRST: a PlannedType operand
                    ; carrying a method member_access (e.g. `cli.main`,
                    ; where `cli` resolves to a namespace concept and
                    ; `main` is the trailing method) must dispatch on
                    ; the method name, not the namespace name. Without
                    ; this, the next branch grabs `t.name` ("cli") and
                    ; resolve_function_call hunts for a function called
                    ; "cli" which doesn't exist, leaving the call un-
                    ; emitted and the body collapsing to ret void.
                    guard result.member_access <> null
                    {
                        let ma (*result.member_access)
                        guard ma.length > 0
                        {
                            let last_ptr ma.get(ma.length - 1)
                            guard last_ptr <> null
                            {
                                let last_ma (*last_ptr)
                                guard last_ma.is_method
                                {
                                    var tuple_second: bool false
                                    choose second.expr
                                        when tp: PlannedTuple
                                            set tuple_second: true
                                        else
                                            0
                                    guard tuple_second
                                    {
                                        set is_call: true
                                        set fn_name: last_ma.name
                                    }
                                }
                            }
                        }
                    }

                    guard is_call = false
                    {
                        choose result.expr
                            when t: PlannedType
                            {
                                set fn_name: t.name
                                choose second.expr
                                    when tp: PlannedTuple
                                        set is_call: true
                                    else
                                        0
                                0
                            }
                            else
                                0
                    }

                    guard is_call
                    {
                        ; Struct/Union value construction. When fn_name
                        ; resolves to a registered Concept, treat
                        ; Type(args) as construction rather than a free
                        ; function call. Mirrors Planner.cpp:8810+
                        ; (struct) and 9086+ (union variant).
                        var is_struct_ctor: bool false
                        var is_variant_ctor: bool false
                        var ctor_struct_type: PlannedType Planner.make_void_type#()
                        var ctor_union_type: PlannedType Planner.make_void_type#()
                        var ctor_variant_name: String String^rp("")
                        var ctor_variant_tag: size_t 0

                        ; Resolve struct construction regardless of lifetime.
                        ; The reshape below force-sets Lifetime.Unspecified on
                        ; the result PlannedTuple so stage-1 stack-alloca's the
                        ; struct (heap $/#/^ ctor support is deferred — would
                        ; need scaly_page_alloc + RBMM wiring). Without lifting
                        ; this guard, every `T$(args)` / `T#(args)` for a
                        ; registered struct (e.g. `Options#()`,
                        ; `String$(arg_ptr)`, `Vector[T]#(0)`) silently dropped:
                        ; lookup_concept finds the Structure but the gate stays
                        ; shut, the call falls through to resolve_function_call
                        ; which returns null, mangled_name stays empty, and
                        ; emit_call returns null — taking the binding and any
                        ; downstream reference (e.g. `arg.starts_with(...)`)
                        ; with it. parse_args body went from full option-
                        ; parsing to a bare `let arg_ptr; set i: i+1`.
                        let conc_ref this.lookup_concept(fn_name)
                        guard conc_ref <> null
                        {
                            let conc (*conc_ref)
                            choose conc.definition
                                when s: Structure
                                {
                                    set is_struct_ctor: true
                                    choose result.expr
                                        when t: PlannedType
                                            set ctor_struct_type: t
                                        else
                                            0
                                }
                                else
                                    0
                        }

                        ; Dotted union variant: Union.Variant(args). Split
                        ; on last '.', look up the prefix as a Union, the
                        ; suffix as a variant.
                        guard is_struct_ctor = false
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            guard dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let union_ref this.lookup_concept(prefix)
                                guard union_ref <> null
                                {
                                    let uconc (*union_ref)
                                    var is_union_def: bool false
                                    choose uconc.definition
                                        when u: scalyc.compiler.Model.Union
                                            set is_union_def: true
                                        else
                                            0
                                    guard is_union_def
                                    {
                                        let tag this.lookup_variant_tag(prefix, suffix)
                                        guard tag >= 0
                                        {
                                            set is_variant_ctor: true
                                            set ctor_union_type: PlannedType(
                                                result.loc,
                                                prefix,
                                                Planner.mangle_structure#(prefix, null),
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                String^rp(""),
                                                null
                                            )
                                            set ctor_variant_name: suffix
                                            set ctor_variant_tag: tag as size_t
                                        }
                                    }
                                }
                            }
                        }

                        guard is_struct_ctor
                        {
                            ; s81: ctor-call diversion. When find_initializer#
                            ; matches an init# overload (page_parameter set),
                            ; build a PlannedCall with C1 mangling and divert
                            ; to emit_constructor_call (Page::allocate + ctor
                            ; call). Without this, every T$/T#/T^ goes
                            ; through the stack-alloc reshape below, which
                            ; only works for "data class" structs without
                            ; custom init# logic. Heavy users like String,
                            ; Vector, StringBuilder rely on init# for proper
                            ; internal state (varint length, etc.). The
                            ; init# bodies are emitted by the synthesized
                            ; PlannedFunction wrapper in plan_initializer#.
                            let ctor_arg_types Planner.extract_arg_types#(second)
                            let init_match this.find_initializer#(fn_name, ctor_arg_types)
                            guard init_match <> null
                            {
                                let ini_match (*init_match)
                                ; s84: the page_parameter guard was load-bearing
                                ; under s81 because the `requires_page_param=true`
                                ; field below was hard-coded — without page on the
                                ; init, emit_constructor_call would still pass an
                                ; extra page arg, mismatching the C1 ABI.
                                ; Now we propagate `init# vs init` into
                                ; `requires_page_param`, enabling `Options#()`
                                ; (where Options has only `init()` (no #)) to
                                ; route through emit_constructor_call: heap-
                                ; allocate via Page::allocate, call C1 with
                                ; `this` only. Mirrors stage-0's
                                ; cli.test() IR for `var opts Options$()`.
                                {
                                    let has_page_param ini_match.page_parameter <> null
                                    let init_input_items this.plan_items#(ini_match.input)
                                    var init_input_holder Vector[PlannedItem]^rp(init_input_items)

                                    var parent_holder Vector[PlannedType]^rp(1)
                                    parent_holder.put(0, ctor_struct_type)
                                    let parent_ref parent_holder.get(0)

                                    let c1_mangled Planner.mangle_function#(
                                        String$("init"), &init_input_holder, parent_ref, has_page_param
                                    )

                                    var ctor_call_args Array[PlannedOperand]$()
                                    choose second.expr
                                        when tp_args: PlannedTuple
                                        {
                                            guard tp_args.components <> null
                                            {
                                                let comps_args (*tp_args.components)
                                                var ai: size_t 0
                                                while ai < comps_args.length
                                                {
                                                    let cap_ptr comps_args.get(ai)
                                                    guard cap_ptr <> null
                                                    {
                                                        let cap (*cap_ptr)
                                                        guard cap.value <> null
                                                        {
                                                            let cvals (*cap.value)
                                                            let collapsed_arg this.collapse_operand_sequence#(cvals)
                                                            ctor_call_args.add(collapsed_arg)
                                                        }
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                        }
                                        else
                                            0
                                    var ctor_args_vec Vector[PlannedOperand]^rp(ctor_call_args)

                                    let ctor_call PlannedCall(
                                        second.loc,
                                        String^rp("init"),
                                        c1_mangled,
                                        false,
                                        false,
                                        false,
                                        has_page_param,
                                        &ctor_args_vec,
                                        ctor_struct_type,
                                        ctor_struct_type.life
                                    )
                                    set result: PlannedOperand(
                                        second.loc,
                                        PlannedExpression.Call(ctor_call),
                                        second.member_access,
                                        ctor_struct_type
                                    )
                                    guard ops.length > 2
                                    {
                                        var remaining_c Array[PlannedOperand]$()
                                        remaining_c.add(result)
                                        var rrc: size_t 2
                                        while rrc < ops.length
                                        {
                                            let prc_ptr ops.get(rrc)
                                            guard prc_ptr <> null
                                                remaining_c.add((*prc_ptr))
                                            set rrc: rrc + 1
                                        }
                                        var remaining_cv Vector[PlannedOperand]^rp(remaining_c)
                                        return this.collapse_operand_sequence#(remaining_cv)
                                    }
                                    return result
                                }
                            }

                            ; Reshape the tuple to set tuple_type to the
                            ; struct type. Stack allocation only for now
                            ; (Lifetime.Unspecified — heap $/#/^ deferred).
                            ; Falls through here when find_initializer#
                            ; didn't match (data classes without init#) or
                            ; when init has no page_parameter (stack-only
                            ; init, currently unused).
                            var components_holder: ref[Vector[PlannedComponent]]? null
                            ; Collapse each component's operand sequence so
                            ; nested struct/union ctors and other multi-
                            ; operand expressions become a single planned
                            ; operand. emit_operands only walks the first
                            ; operand of a component value, so without
                            ; collapsing, `Parser(Lexer(7))` would drop the
                            ; inner Tuple and emit only the bare `Type(Lexer)`
                            ; operand — SEGV at LLVMTypeOf on null.
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    guard tp.components <> null
                                    {
                                        let comps_in (*tp.components)
                                        var new_comps Array[PlannedComponent]$()
                                        var ci: size_t 0
                                        while ci < comps_in.length
                                        {
                                            let cp comps_in.get(ci)
                                            guard cp <> null
                                            {
                                                let cc (*cp)
                                                var nc_value: ref[Vector[PlannedOperand]]? cc.value
                                                guard cc.value <> null
                                                {
                                                    let vals (*cc.value)
                                                    guard vals.length > 1
                                                    {
                                                        let collapsed this.collapse_operand_sequence#(vals)
                                                        var one_arr Array[PlannedOperand]^rp()
                                                        one_arr.add(collapsed)
                                                        var one_vec Vector[PlannedOperand]^rp(one_arr)
                                                        set nc_value: &one_vec
                                                    }
                                                }
                                                new_comps.add(PlannedComponent(
                                                    cc.loc, cc.name, nc_value, cc.attributes
                                                ))
                                            }
                                            set ci: ci + 1
                                        }
                                        var new_comps_holder Vector[PlannedComponent]^rp(new_comps)
                                        set components_holder: &new_comps_holder
                                    }
                                }
                                else
                                    0
                            ; Propagate the type's lifetime into the tuple.
                            ; ctor_struct_type carries the lifetime from the
                            ; lifetime marker merge (above) — `Plan#(...)` has
                            ; life=Call; `String$(...)` has life=Local; etc.
                            ; Non-Unspecified life ⇒ heap allocation
                            ; (emit_tuple respects is_region_alloc by calling
                            ; Page::allocate on the appropriate page).
                            var is_region: bool false
                            choose ctor_struct_type.life
                                when u: Unspecified
                                    0
                                else
                                    set is_region: true

                            let reshaped PlannedTuple(
                                second.loc,
                                components_holder,
                                ctor_struct_type,
                                is_region,
                                ctor_struct_type.life,
                                null
                            )
                            set result: PlannedOperand(
                                second.loc,
                                PlannedExpression.Tuple(reshaped),
                                second.member_access,
                                ctor_struct_type
                            )
                            guard ops.length > 2
                            {
                                var remaining Array[PlannedOperand]$()
                                remaining.add(result)
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get(rr)
                                    guard p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand]^rp(remaining)
                                return this.collapse_operand_sequence#(remaining_vec)
                            }
                            return result
                        }

                        guard is_variant_ctor
                        {
                            ; Build a PlannedVariantConstruction. The
                            ; tuple's first component carries the payload
                            ; for variants like Some(int); empty `()`
                            ; produces a payload-less variant.
                            var payload_holder: ref[PlannedOperand]? null
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    guard tp.components <> null
                                    {
                                        let comps (*tp.components)
                                        guard comps.length > 0
                                        {
                                            let c_ptr comps.get(0)
                                            guard c_ptr <> null
                                            {
                                                let c (*c_ptr)
                                                guard c.value <> null
                                                {
                                                    let v (*c.value)
                                                    let collapsed this.collapse_operand_sequence#(v)
                                                    var v_holder Vector[PlannedOperand]^rp(1)
                                                    v_holder.put(0, collapsed)
                                                    set payload_holder: v_holder.get(0)
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                    0

                            let vc PlannedVariantConstruction(
                                second.loc,
                                ctor_union_type,
                                ctor_variant_name,
                                ctor_variant_tag,
                                payload_holder
                            )
                            set result: PlannedOperand(
                                second.loc,
                                PlannedExpression.VariantConstruction(vc),
                                null,
                                ctor_union_type
                            )
                            guard ops.length > 2
                            {
                                var remaining Array[PlannedOperand]$()
                                remaining.add(result)
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get(rr)
                                    guard p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand]^rp(remaining)
                                return this.collapse_operand_sequence#(remaining_vec)
                            }
                            return result
                        }

                        ; s90: collapse each tuple component's operand
                        ; sequence before reading result_type so binary
                        ; operators in args (e.g. `f(a, x = y)`) yield
                        ; one type per component, matching the function
                        ; arity. Mirrors stage-0's planTuple at
                        ; Planner.cpp:10506-10511 (which always collapses).
                        ; Stage-1's plan_component# only collapses on
                        ; specific shapes; the tuple-arg path slipped
                        ; through. Without collapse here, an arg-list
                        ; component with a bool-comparison operand sees
                        ; `extract_arg_types#` flatten 3 operands into 3
                        ; arg types, resolve_function_call# arity-mismatches,
                        ; match_ref stays null, mangled="", emit_call drops
                        ; the call, and the entire `let X = f(...)` binding
                        ; plus any `guard X = ...` follower silently
                        ; vanish from the IR.
                        var arg_types_arr_s90 Array[PlannedType]$()
                        choose second.expr
                            when tp_s90: PlannedTuple
                            {
                                guard tp_s90.components <> null
                                {
                                    let comps_s90 (*tp_s90.components)
                                    var ai_s90: size_t 0
                                    while ai_s90 < comps_s90.length
                                    {
                                        let cp_s90 comps_s90.get(ai_s90)
                                        guard cp_s90 <> null
                                        {
                                            let c_s90 (*cp_s90)
                                            guard c_s90.value <> null
                                            {
                                                let v_s90 (*c_s90.value)
                                                guard v_s90.length > 0
                                                {
                                                    let collapsed_s90 this.collapse_operand_sequence#(v_s90)
                                                    arg_types_arr_s90.add(collapsed_s90.result_type)
                                                }
                                            }
                                        }
                                        set ai_s90: ai_s90 + 1
                                    }
                                }
                            }
                            else
                                arg_types_arr_s90.add(second.result_type)
                        let arg_types Vector[PlannedType]^rp(arg_types_arr_s90)
                        var match_ref this.resolve_function_call#(fn_name, arg_types)

                        ; First-hop method dispatch (s75): when fn_name
                        ; is a dotted name `arg.starts_with` and `arg`
                        ; resolves to a local binding (not a Concept),
                        ; treat the call as a method on the receiver.
                        ; Without this, free-function lookup on the full
                        ; dotted name fails, the dotted-namespace
                        ; fallback below skips because `arg` isn't a
                        ; Concept, and the call drops with mangled="".
                        ; The receiver is prepended to the args list
                        ; below when is_method_dispatch is true.
                        ; Mirrors stage-0 Planner.cpp:7920-7940 method-
                        ; on-local-variable resolution.
                        var is_method_dispatch: bool false
                        var receiver_op: PlannedOperand result
                        guard match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            guard dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let local_ref this.lookup_local_binding(prefix)
                                guard local_ref <> null
                                {
                                    let local (*local_ref)
                                    ; s109: dispatch on generic receivers
                                    ; (Container[int], Box[int]). encode_type#
                                    ; handles `Name[args]` → `<len><name>I<args>E`,
                                    ; so mangle_method# already produces the
                                    ; specialised symbol (e.g. `_ZN9ContainerIiE`
                                    ; `8set_itemEmi`). The previous skip was
                                    ; written before encode_type# learned
                                    ; generics; lifting it lets user-defined
                                    ; `Container[int].set_item(...)` resolve
                                    ; against the spec'd body emitted via
                                    ; instantiate_generic#. Stdlib generics
                                    ; (Vector / HashMap / etc.) are still
                                    ; excluded because their bodies aren't
                                    ; specialised in the planner walk — keep
                                    ; them on the unspec'd dispatch path so
                                    ; the existing extern-decl shim continues
                                    ; to work.
                                    var skip_dispatch: bool false
                                    guard local.binding_type.generics <> null
                                    {
                                        guard local.binding_type.name.equals(String$("pointer")) = false
                                        {
                                            guard local.binding_type.name.equals(String$("ref")) = false
                                            {
                                                ; s137-INVESTIGATE: Vector removed
                                                guard local.binding_type.name.equals(String$("HashMap"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("HashMapBuilder"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("HashSet"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("HashSetBuilder"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Array"))
                                                    set skip_dispatch: true
                                                ; s148: List removed alongside the is_stdlib_generic lift.
                                                ; Specialised List<T>::add/count/get_iterator bodies are
                                                ; now emitted via instantiate_generic#, so dispatch can
                                                ; route through the s109 extern-decl + record_function
                                                ; path the same way Vector does (skip_dispatch on Vector
                                                ; was lifted in s137, no regression there).
                                                ; guard local.binding_type.name.equals(String$("List"))
                                                ;     set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("ListIterator"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("BuilderList"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("BuilderListIterator"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Option"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Result"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Slice"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Slot"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("Node"))
                                                    set skip_dispatch: true
                                                guard local.binding_type.name.equals(String$("KeyValuePair"))
                                                    set skip_dispatch: true
                                            }
                                        }
                                    }
                                    guard skip_dispatch = false
                                    {
                                    let mm_ref this.lookup_method#(local.binding_type, suffix)
                                    guard mm_ref <> null
                                    {
                                        let mm (*mm_ref)
                                        ; Build receiver as Variable(prefix).
                                        let recv PlannedOperand(
                                            result.loc,
                                            PlannedExpression.Variable(PlannedVariable(
                                                result.loc,
                                                prefix,
                                                local.binding_type,
                                                local.is_mutable
                                            )),
                                            null,
                                            local.binding_type
                                        )
                                        set receiver_op: recv
                                        set is_method_dispatch: true

                                        ; s78: record an extern PlannedFunction
                                        ; for the dispatched method so
                                        ; emit_function_decl emits an LLVM
                                        ; declare and emit_call's
                                        ; LLVMGetNamedFunction resolves it.
                                        ; Same-package methods (Options.*) are
                                        ; declared via the regular plan path;
                                        ; cross-package methods (String.*,
                                        ; Vector.*) need this. Skipped when
                                        ; already recorded (mirrors the
                                        ; dotted-namespace dedup at line ~2949).
                                        guard this.has_recorded_function(mm.mangled_name) = false
                                        {
                                            var items_arr Array[PlannedItem]$()
                                            var this_type_holder Vector[PlannedType]^rp(1)
                                            this_type_holder.put(0, local.binding_type)
                                            items_arr.add(PlannedItem(
                                                result.loc,
                                                false,
                                                null,
                                                this_type_holder.get(0),
                                                null
                                            ))
                                            guard mm.parameter_types <> null
                                            {
                                                let pt_vec_ref mm.parameter_types
                                                let pt_vec (*pt_vec_ref)
                                                var ai: size_t 0
                                                while ai < pt_vec.length
                                                {
                                                    let p_ptr pt_vec.get(ai)
                                                    guard p_ptr <> null
                                                    {
                                                        var pty_holder Vector[PlannedType]^rp(1)
                                                        pty_holder.put(0, (*p_ptr))
                                                        items_arr.add(PlannedItem(
                                                            result.loc,
                                                            false,
                                                            null,
                                                            pty_holder.get(0),
                                                            null
                                                        ))
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                            var items_holder Vector[PlannedItem]^rp(items_arr)
                                            var rt_holder Vector[PlannedType]^rp(1)
                                            rt_holder.put(0, mm.return_type)
                                            let extern_impl PlannedImplementation.Extern(
                                                PlannedExternImpl(result.loc)
                                            )
                                            ; s119: honor mm.requires_page_param so cross-package /
                                            ; recursive-mid-planning stub IR signature matches the
                                            ; proper PlannedFunction emitted later. Without this,
                                            ; an early stub locks in a no-page-slot LLVM signature
                                            ; for any function whose body recursively calls itself
                                            ; (or is called before plan_function# records it).
                                            var pp_ref_a: ref[String]? null
                                            guard mm.requires_page_param
                                            {
                                                var pp_h_a Vector[String]^rp(1)
                                                pp_h_a.put(0, String^rp("rp"))
                                                set pp_ref_a: pp_h_a.get(0)
                                            }
                                            this.record_function(PlannedFunction(
                                                result.loc,
                                                false,
                                                false,
                                                suffix,
                                                mm.mangled_name,
                                                pp_ref_a,
                                                &items_holder,
                                                rt_holder.get(0),
                                                mm.throws_type,
                                                Lifetime.Unspecified(Unspecified()),
                                                extern_impl,
                                                null,
                                                false,
                                                mm.can_throw,
                                                null
                                            ))
                                        }
                                        set match_ref: mm_ref
                                    }
                                    }
                                }
                            }
                        }

                        ; Method-on-chain dispatch (s83): when the first
                        ; operand has a member_access chain whose last hop
                        ; is_method=true, the call is an instance method on
                        ; the chain's truncated receiver. Truncate the chain
                        ; (drop the method hop), use last_acc.parent_type as
                        ; the receiver type, and look up the method.
                        ; Mirrors stage-0 Planner.cpp:4534-4607. Required
                        ; for `inner.get_value()` and `input_file.get_length()`
                        ; in method bodies (after the implicit-this
                        ; multi-segment fallback in plan_type_operand# returns
                        ; a chain ending in a method hop).
                        guard match_ref = null
                        {
                            guard result.member_access <> null
                            {
                                let ma_outer (*result.member_access)
                                guard ma_outer.length > 0
                                {
                                    let last_p ma_outer.get(ma_outer.length - 1)
                                    guard last_p <> null
                                    {
                                        let last_acc (*last_p)
                                        guard last_acc.is_method
                                        {
                                            let recv_type last_acc.parent_type
                                            let mm_ref this.lookup_method#(recv_type, last_acc.name)
                                            guard mm_ref <> null
                                            {
                                                let mm3 (*mm_ref)
                                                ; Build truncated chain (drop last hop).
                                                var trunc_arr Array[PlannedMemberAccess]$()
                                                var ti: size_t 0
                                                while ti + 1 < ma_outer.length
                                                {
                                                    let mp ma_outer.get(ti)
                                                    guard mp <> null
                                                        trunc_arr.add((*mp))
                                                    set ti: ti + 1
                                                }
                                                if trunc_arr.length > 0
                                                {
                                                    var trunc_holder Vector[PlannedMemberAccess]^rp(trunc_arr)
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        &trunc_holder,
                                                        recv_type
                                                    )
                                                }
                                                else
                                                {
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        null,
                                                        recv_type
                                                    )
                                                }

                                                ; Record extern PlannedFunction so
                                                ; emit_function_decl emits an LLVM
                                                ; declare and emit_call resolves it
                                                ; via LLVMGetNamedFunction. Mirrors
                                                ; the s78 record at the s75 site
                                                ; (line ~2794). Skipped if already
                                                ; recorded.
                                                guard this.has_recorded_function(mm3.mangled_name) = false
                                                {
                                                    var items_arr2 Array[PlannedItem]$()
                                                    var this_type_holder2 Vector[PlannedType]^rp(1)
                                                    this_type_holder2.put(0, recv_type)
                                                    items_arr2.add(PlannedItem(
                                                        result.loc,
                                                        false,
                                                        null,
                                                        this_type_holder2.get(0),
                                                        null
                                                    ))
                                                    guard mm3.parameter_types <> null
                                                    {
                                                        let pt_vec_ref2 mm3.parameter_types
                                                        let pt_vec2 (*pt_vec_ref2)
                                                        var ai2: size_t 0
                                                        while ai2 < pt_vec2.length
                                                        {
                                                            let p_ptr2 pt_vec2.get(ai2)
                                                            guard p_ptr2 <> null
                                                            {
                                                                var pty_holder2 Vector[PlannedType]^rp(1)
                                                                pty_holder2.put(0, (*p_ptr2))
                                                                items_arr2.add(PlannedItem(
                                                                    result.loc,
                                                                    false,
                                                                    null,
                                                                    pty_holder2.get(0),
                                                                    null
                                                                ))
                                                            }
                                                            set ai2: ai2 + 1
                                                        }
                                                    }
                                                    var items_holder2 Vector[PlannedItem]^rp(items_arr2)
                                                    var rt_holder2 Vector[PlannedType]^rp(1)
                                                    rt_holder2.put(0, mm3.return_type)
                                                    let extern_impl2 PlannedImplementation.Extern(
                                                        PlannedExternImpl(result.loc)
                                                    )
                                                    ; s119: see stub-A site above.
                                                    var pp_ref_b: ref[String]? null
                                                    guard mm3.requires_page_param
                                                    {
                                                        var pp_h_b Vector[String]^rp(1)
                                                        pp_h_b.put(0, String^rp("rp"))
                                                        set pp_ref_b: pp_h_b.get(0)
                                                    }
                                                    this.record_function(PlannedFunction(
                                                        result.loc,
                                                        false,
                                                        false,
                                                        last_acc.name,
                                                        mm3.mangled_name,
                                                        pp_ref_b,
                                                        &items_holder2,
                                                        rt_holder2.get(0),
                                                        mm3.throws_type,
                                                        Lifetime.Unspecified(Unspecified()),
                                                        extern_impl2,
                                                        null,
                                                        false,
                                                        mm3.can_throw,
                                                        null
                                                    ))
                                                }

                                                set match_ref: mm_ref
                                                set is_method_dispatch: true
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; Dotted call fallback: `cli.main(args)` arrives
                        ; with fn_name="cli.main"; the function is registered
                        ; in model_functions under its short name "main"
                        ; (register_concept_recursive flattens namespace
                        ; members; register_module_concepts recurses into
                        ; sub-modules with register_function). Retry with
                        ; the suffix; if the prefix resolves to a Namespace
                        ; concept, also override mangled_name to
                        ; `_ZN<prefix><name>E<args>` so the call links to
                        ; the namespaced function (otherwise
                        ; check_function_match's mangle_free_function path
                        ; produces the bare `_Z<name>` and collides with
                        ; the program's own free function of the same
                        ; name). Plain modules don't add a namespace
                        ; segment to the mangled name, so the suffix-only
                        ; resolve already returns the right MethodMatch
                        ; for `compiler.test()` etc.
                        var ns_mangled: String String^rp("")
                        var has_ns_mangled: bool false
                        guard match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            guard dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                set match_ref: this.resolve_function_call#(suffix, arg_types)
                                guard match_ref <> null
                                {
                                    let ns_ref this.lookup_concept(prefix)
                                    guard ns_ref <> null
                                    {
                                        let nsc (*ns_ref)
                                        var is_ns: bool false
                                        choose nsc.definition
                                            when n: Namespace
                                                set is_ns: true
                                            else
                                                0
                                        guard is_ns
                                        {
                                            ; Build PlannedType for the
                                            ; namespace as a parent and
                                            ; rebuild the mangled name.
                                            var ns_parent_holder Vector[PlannedType]^rp(1)
                                            ns_parent_holder.put(0, PlannedType(
                                                result.loc,
                                                String^rp(prefix),
                                                Planner.encode_name(prefix),
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                String^rp(""),
                                                null
                                            ))
                                            let ns_parent_ref ns_parent_holder.get(0)

                                            ; Build items from the matched
                                            ; function's declared parameter
                                            ; types (not arg_types). Stage-0
                                            ; mangles using the declared
                                            ; param types — e.g. Console.println's
                                            ; signature is
                                            ; `(text: pointer[const_char])`,
                                            ; so the mangled name is
                                            ; `_ZN7Console7printlnEP10const_char`.
                                            ; Using arg_types instead would
                                            ; produce `_ZN7Console7printlnEP2i8`
                                            ; (string-literal type) which
                                            ; doesn't match libscaly's symbol.
                                            ;
                                            ; s129: when the prefix is a
                                            ; Namespace concept, look up the
                                            ; function within ITS members
                                            ; first. resolve_function_call#
                                            ; uses the global model_functions
                                            ; registry (keyed by bare name),
                                            ; so for Console.println it can
                                            ; resolve to the PRELUDE's
                                            ; `println(pointer[i8])` via
                                            ; exact-match — even though we're
                                            ; trying to dispatch to
                                            ; Console.println(pointer[const_char]).
                                            ; Without this carve-out, the
                                            ; rebuild produces
                                            ; `_ZN7Console7printlnEP2i8` (using
                                            ; prelude's `pointer[i8]`) rather
                                            ; than `...P10const_char`, and
                                            ; the link fails against
                                            ; libscaly's `..P10const_char`.
                                            var items_arr Array[PlannedItem]$()
                                            var used_ns_local: bool false
                                            choose nsc.definition
                                                when ns_def: Namespace
                                                {
                                                    var mi_ns: size_t 0
                                                    while mi_ns < ns_def.members.length
                                                    {
                                                        let m_ptr ns_def.members.get(mi_ns)
                                                        guard m_ptr <> null
                                                        {
                                                            let mem (*m_ptr)
                                                            choose mem
                                                                when nf: Function
                                                                {
                                                                    guard used_ns_local = false
                                                                    {
                                                                        guard nf.name.equals(suffix)
                                                                        {
                                                                            ; Skip leading 'this'.
                                                                            var pstart: size_t 0
                                                                            guard nf.input.length > 0
                                                                            {
                                                                                let fi0 nf.input.get(0)
                                                                                guard fi0 <> null
                                                                                {
                                                                                    guard fi0.name <> null
                                                                                    {
                                                                                        let fname (*fi0.name)
                                                                                        guard fname.equals(String$("this"))
                                                                                            set pstart: 1
                                                                                    }
                                                                                }
                                                                            }
                                                                            let expected_arity nf.input.length - pstart
                                                                            guard expected_arity = arg_types.length
                                                                            {
                                                                                var pi_ns: size_t pstart
                                                                                while pi_ns < nf.input.length
                                                                                {
                                                                                    let p_ptr nf.input.get(pi_ns)
                                                                                    guard p_ptr <> null
                                                                                    {
                                                                                        guard p_ptr.type <> null
                                                                                        {
                                                                                            let pt (*p_ptr.type)
                                                                                            let planned_p this.plan_type#(pt)
                                                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                                                            ity_holder.put(0, planned_p)
                                                                                            items_arr.add(PlannedItem(
                                                                                                result.loc,
                                                                                                false,
                                                                                                null,
                                                                                                ity_holder.get(0),
                                                                                                null
                                                                                            ))
                                                                                        }
                                                                                    }
                                                                                    set pi_ns: pi_ns + 1
                                                                                }
                                                                                set used_ns_local: true
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                    0
                                                        }
                                                        set mi_ns: mi_ns + 1
                                                    }
                                                }
                                                else
                                                    0
                                            let mm_for_params (*match_ref)
                                            let param_types_ref mm_for_params.parameter_types
                                            guard used_ns_local = false
                                            {
                                                guard param_types_ref <> null
                                                {
                                                    let pts (*param_types_ref)
                                                    var ai: size_t 0
                                                    while ai < pts.length
                                                    {
                                                        let pt_ptr pts.get(ai)
                                                        guard pt_ptr <> null
                                                        {
                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                            ity_holder.put(0, (*pt_ptr))
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                ity_holder.get(0),
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                                guard param_types_ref = null
                                                {
                                                    var ai: size_t 0
                                                    while ai < arg_types.length
                                                    {
                                                        let at_ptr arg_types.get(ai)
                                                        guard at_ptr <> null
                                                        {
                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                            ity_holder.put(0, (*at_ptr))
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                ity_holder.get(0),
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                            }
                                            var items_holder Vector[PlannedItem]^rp(items_arr)
                                            ; Honor the matched function's
                                            ; page-param flag in the mangled
                                            ; name. parse_args# in cli.scaly
                                            ; has has_page=true so the symbol
                                            ; needs `PN4scaly6memory4PageE`
                                            ; after the function name; without
                                            ; this stage-1 produced
                                            ; `_ZN3cli10parse_argsEiPPc` which
                                            ; doesn't match libscalyc's real
                                            ; `_ZN3cli10parse_argsEPN4scaly6memory4PageEiPPc`.
                                            let mm_pp (*match_ref)
                                            set ns_mangled: Planner.mangle_function#(
                                                suffix, &items_holder, ns_parent_ref, mm_pp.requires_page_param
                                            )
                                            set has_ns_mangled: true

                                            ; Declare the namespaced
                                            ; function as extern in the
                                            ; instantiation cache so the
                                            ; Emitter generates an LLVM
                                            ; declaration that emit_call
                                            ; can resolve via
                                            ; LLVMGetNamedFunction. The
                                            ; function's body comes from
                                            ; the linked package binary
                                            ; (libscalyc / libscaly) at
                                            ; link time. plan_namespace#
                                            ; itself doesn't recurse
                                            ; into ns.modules — calling
                                            ; plan_module# on stdlib
                                            ; modules crashes stage-1
                                            ; on body-level features it
                                            ; doesn't yet support, but
                                            ; an extern declaration
                                            ; needs only types we've
                                            ; already resolved here.
                                            ;
                                            ; Skip the declaration when
                                            ; we're inside a loaded
                                            ; package's namespace body
                                            ; (current_namespace is set)
                                            ; UNLESS the prefix matches
                                            ; a Use-imported alias of
                                            ; the program's main module.
                                            ; Without the gate, externs
                                            ; emitted from e.g.
                                            ; scaly.test()'s body for
                                            ; memory.test/containers.test/
                                            ; io.test break AOT tests
                                            ; that don't link libscaly.
                                            ; The Use-alias carve-out
                                            ; lets explicitly imported
                                            ; namespaces (e.g.
                                            ; main.scaly's
                                            ; `use scalyc.cli` -> "cli")
                                            ; emit real call
                                            ; instructions; the linker
                                            ; resolves them against the
                                            ; package binary at link
                                            ; time. Mirrors stage-0's
                                            ; check at
                                            ; Planner.cpp:7752-7789.
                                            ; Gate now relies solely on
                                            ; the program's Use aliases.
                                            ; Previously this also opened
                                            ; on `current_namespace = null`
                                            ; to handle top-level call
                                            ; sites in the main program;
                                            ; that was load-bearing only
                                            ; while libscaly wasn't linked
                                            ; into the AOT pipeline. Now
                                            ; that cli.run links libscaly
                                            ; unconditionally, the
                                            ; current_namespace clause is
                                            ; no longer required: any
                                            ; legitimate top-level call
                                            ; into a loaded package goes
                                            ; through a Use-imported
                                            ; alias. main.scaly's
                                            ; `use scalyc.cli` puts "cli"
                                            ; in program_use_aliases, so
                                            ; `cli.main(...)` still opens
                                            ; the gate.
                                            ; Also opens the gate when the
                                            ; prefix matches the currently-
                                            ; active namespace (sibling call
                                            ; like cli.parse_args# from
                                            ; inside cli.main). Mirrors
                                            ; stage-0's flatten-current-
                                            ; namespace pre-pass at
                                            ; Planner.cpp:7313-7327.
                                            var prefix_is_current_ns: bool false
                                            guard current_namespace_name <> null
                                            {
                                                let cnsn (*current_namespace_name)
                                                guard cnsn.equals(prefix)
                                                    set prefix_is_current_ns: true
                                            }
                                            var gate_open: bool false
                                            guard this.is_program_use_alias(prefix)
                                                set gate_open: true
                                            guard prefix_is_current_ns
                                                set gate_open: true
                                            guard gate_open
                                            guard this.has_recorded_function(ns_mangled) = false
                                            {
                                                let mm (*match_ref)
                                                var rt_holder Vector[PlannedType]^rp(1)
                                                rt_holder.put(0, mm.return_type)
                                                let extern_impl PlannedImplementation.Extern(
                                                    PlannedExternImpl(result.loc)
                                                )
                                                ; s78: propagate page_parameter when the
                                                ; matched function has has_page=true.
                                                ; Without this, function# callees recorded
                                                ; via the dotted fallback get null
                                                ; page_parameter, so emit_function_decl
                                                ; emits a 1-param signature for what
                                                ; should be 2-param (Page* + user param).
                                                ; A later call that goes through the body
                                                ; uses LLVMGetParam(func, 1) on a 1-param
                                                ; function and gets a bogus pointer.
                                                var pp_ref: ref[String]? null
                                                guard mm.requires_page_param
                                                {
                                                    var pp_h Vector[String]^rp(1)
                                                    pp_h.put(0, String^rp("rp"))
                                                    set pp_ref: pp_h.get(0)
                                                }
                                                this.record_function(PlannedFunction(
                                                    result.loc,
                                                    false,
                                                    false,
                                                    suffix,
                                                    ns_mangled,
                                                    pp_ref,
                                                    &items_holder,
                                                    rt_holder.get(0),
                                                    mm.throws_type,
                                                    Lifetime.Unspecified(Unspecified()),
                                                    extern_impl,
                                                    null,
                                                    false,
                                                    mm.can_throw,
                                                    null
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; s101: Implicit-this sibling method dispatch.
                        ; When the standard lookup didn't find `fn_name`
                        ; and `this: pointer[T]` is in scope, try resolving
                        ; as T's method. Mirrors stage-0 Planner.cpp:1257-
                        ; 1277 (lookupFunction's struct-member walk) +
                        ; 9747-9786 (mangleFunction with parent = struct).
                        ; Required for `define T { fn a() ... fn b() a() }`
                        ; where `a()` from inside `b()` is a sibling method.
                        ; Without this, sibling method calls fall through
                        ; to mangled="" and the call drops out of the IR.
                        guard match_ref = null
                        {
                            guard has_ns_mangled = false
                            {
                                let this_ref this.lookup_local(String#("this"))
                                guard this_ref <> null
                                {
                                    let this_ty (*this_ref)
                                    guard this_ty.name.equals(String$("pointer"))
                                    {
                                        guard this_ty.generics <> null
                                        {
                                            let gens_t (*this_ty.generics)
                                            guard gens_t.length > 0
                                            {
                                                let inner_ptr gens_t.get(0)
                                                guard inner_ptr <> null
                                                {
                                                    let inner_t (*inner_ptr)
                                                    let mm_ref this.lookup_method#(inner_t, fn_name)
                                                    guard mm_ref <> null
                                                    {
                                                        ; Build receiver_op as `this`.
                                                        set receiver_op: PlannedOperand(
                                                            result.loc,
                                                            PlannedExpression.Variable(PlannedVariable(
                                                                result.loc,
                                                                String^rp("this"),
                                                                this_ty,
                                                                false
                                                            )),
                                                            null,
                                                            this_ty
                                                        )
                                                        set match_ref: mm_ref
                                                        set is_method_dispatch: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        var rt: PlannedType this.fresh_type_var#(String$(""))
                        var mangled: String String^rp("")
                        guard match_ref <> null
                        {
                            let m (*match_ref)
                            set rt: m.return_type
                            set mangled: m.mangled_name
                        }
                        guard has_ns_mangled
                            set mangled: ns_mangled

                        ; Flatten the tuple argument into a list of
                        ; individual PlannedOperand values so the emitter
                        ; can treat each call argument separately. An
                        ; empty `()` produces an empty list. When the
                        ; call is a method dispatch on a local-variable
                        ; receiver (s75), prepend the receiver as
                        ; argument 0; the callee declared `this` as the
                        ; first param.
                        var args_arr Array[PlannedOperand]$()
                        guard is_method_dispatch
                            args_arr.add(receiver_op)
                        choose second.expr
                            when tp: PlannedTuple
                            {
                                guard tp.components <> null
                                {
                                    let comps (*tp.components)
                                    var ci: size_t 0
                                    while ci < comps.length
                                    {
                                        let c_ptr comps.get(ci)
                                        guard c_ptr <> null
                                        {
                                            let c (*c_ptr)
                                            guard c.value <> null
                                            {
                                                let v (*c.value)
                                                args_arr.add(this.collapse_operand_sequence#(v))
                                            }
                                        }
                                        set ci: ci + 1
                                    }
                                }
                            }
                            else
                                args_arr.add(second)
                        var call_args Vector[PlannedOperand]^rp(args_arr)
                        ; Propagate the matched function's page-param
                        ; requirement to the PlannedCall so emit_call
                        ; prepends the rp arg. Required for in-namespace
                        ; sibling calls to `function#` callees (e.g.
                        ; cli.main → cli.parse_args#).
                        var call_requires_page: bool false
                        guard match_ref <> null
                        {
                            let mm_for_pp (*match_ref)
                            guard mm_for_pp.requires_page_param
                                set call_requires_page: true
                        }
                        ; s143: propagate the matched function's can_throw
                        ; flag so plan_choose# can recognise this as a
                        ; throws-call when planning a choose over its
                        ; result. Without this, cli.run's
                        ; `choose p.parse_program#() when err: Error / when
                        ; program: Success` doesn't get distinct
                        ; variant_indices and the Error arm always wins via
                        ; the s142 default-redirect.
                        var call_can_throw: bool false
                        guard match_ref <> null
                        {
                            let mm_for_ct (*match_ref)
                            guard mm_for_ct.can_throw
                                set call_can_throw: true
                        }
                        var call_args_holder Vector[PlannedOperand]^rp(call_args)
                        let call PlannedCall(
                            result.loc,
                            fn_name,
                            mangled,
                            false,
                            false,
                            call_can_throw,
                            call_requires_page,
                            &call_args_holder,
                            rt,
                            Lifetime.Unspecified(Unspecified())
                        )
                        set result: PlannedOperand(
                            result.loc,
                            PlannedExpression.Call(call),
                            null,
                            rt
                        )

                        ; Chained method calls: a.b().c().d(). The parser
                        ; attaches the NEXT method's member_access to the
                        ; current tuple operand. After the first call is
                        ; built, inspect the consumed tuple for a pending
                        ; method name, resolve against result.result_type,
                        ; and fold in another call if a following Tuple
                        ; supplies args. Repeat until the chain breaks.
                        var prev_tuple: PlannedOperand second
                        var next_idx: size_t 2
                        var keep_chaining: bool true
                        while keep_chaining
                        {
                            set keep_chaining: false
                            guard prev_tuple.member_access <> null
                            {
                                let prev_ma (*prev_tuple.member_access)
                                guard prev_ma.length > 0
                                {
                                    let last_ptr prev_ma.get(prev_ma.length - 1)
                                    guard last_ptr <> null
                                    {
                                        let method_name (*last_ptr).name
                                        guard next_idx < ops.length
                                        {
                                            let next_args_ptr ops.get(next_idx)
                                            guard next_args_ptr <> null
                                            {
                                                let next_args (*next_args_ptr)
                                                var is_tuple: bool false
                                                choose next_args.expr
                                                    when tp: PlannedTuple
                                                        set is_tuple: true
                                                    else
                                                        0
                                                guard is_tuple
                                                {
                                                    let match_ref this.lookup_method#(
                                                        result.result_type, method_name
                                                    )
                                                    guard match_ref <> null
                                                    {
                                                        let m (*match_ref)
                                                        ; s112: build the chained
                                                        ; PlannedCall's args list as
                                                        ; [receiver, ...flattened tuple
                                                        ; components]. Old code passed
                                                        ; [receiver, tuple_operand] —
                                                        ; emit_call then treated the
                                                        ; tuple as a second user arg
                                                        ; and the LLVMBuildCall2 arg
                                                        ; count didn't match the
                                                        ; method's `(this)` arity,
                                                        ; so emit_operand on an empty
                                                        ; Tuple returned null and
                                                        ; the entire outer call
                                                        ; dropped. Mirror the non-
                                                        ; chained call branch at
                                                        ; line ~3815.
                                                        var chained_args_arr Array[PlannedOperand]$()
                                                        chained_args_arr.add(result)
                                                        choose next_args.expr
                                                            when chained_tp: PlannedTuple
                                                            {
                                                                guard chained_tp.components <> null
                                                                {
                                                                    let chained_comps (*chained_tp.components)
                                                                    var chained_ci: size_t 0
                                                                    while chained_ci < chained_comps.length
                                                                    {
                                                                        let chained_c_ptr chained_comps.get(chained_ci)
                                                                        guard chained_c_ptr <> null
                                                                        {
                                                                            let chained_c (*chained_c_ptr)
                                                                            guard chained_c.value <> null
                                                                            {
                                                                                let chained_v (*chained_c.value)
                                                                                chained_args_arr.add(this.collapse_operand_sequence#(chained_v))
                                                                            }
                                                                        }
                                                                        set chained_ci: chained_ci + 1
                                                                    }
                                                                }
                                                            }
                                                            else
                                                                0
                                                        var new_args Vector[PlannedOperand]^rp(chained_args_arr)
                                                        let chained this.make_planned_call#(
                                                            next_args.loc,
                                                            method_name,
                                                            m.mangled_name,
                                                            m.return_type,
                                                            new_args
                                                        )
                                                        set result: PlannedOperand(
                                                            next_args.loc,
                                                            PlannedExpression.Call(chained),
                                                            null,
                                                            m.return_type
                                                        )
                                                        set prev_tuple: next_args
                                                        set next_idx: next_idx + 1
                                                        set keep_chaining: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; Splice the remaining ops into a fresh vector
                        ; and recurse.
                        guard next_idx < ops.length
                        {
                            var remaining Array[PlannedOperand]$()
                            remaining.add(result)
                            var r: size_t next_idx
                            while r < ops.length
                            {
                                let p_ptr ops.get(r)
                                guard p_ptr <> null
                                    remaining.add((*p_ptr))
                                set r: r + 1
                            }
                            var remaining_vec Vector[PlannedOperand]^rp(remaining)
                            return this.collapse_operand_sequence#(remaining_vec)
                        }
                        return result
                    }
                }
            }

            var i: size_t 1
            while i < ops.length
            {
                let op_ptr ops.get(i)
                guard op_ptr = null
                {
                    set i: i + 1
                    continue
                }
                let op (*op_ptr)

                ; Postfix `is Type` — stitch the accumulated result in as
                ; the value operand, recompute the variant tag from the
                ; value's union type, and advance by 1.
                var handled_unary: bool false
                choose op.expr
                    when pis: PlannedIs
                    {
                        var value_holder Vector[PlannedOperand]^rp(1)
                        value_holder.put(0, result)

                        var new_tag: size_t pis.variant_tag
                        guard pis.is_null_check = false
                        {
                            let tag this.lookup_variant_tag(
                                result.result_type.name, pis.test_type.name
                            )
                            guard tag >= 0
                                set new_tag: tag as size_t
                        }

                        let stitched PlannedIs(
                            pis.loc,
                            pis.test_type,
                            new_tag,
                            result.result_type.name,
                            value_holder.get(0),
                            pis.is_null_check
                        )
                        set result: PlannedOperand(
                            op.loc,
                            PlannedExpression.Is(stitched),
                            null,
                            Planner.make_bool_type#()
                        )
                        set handled_unary: true
                    }
                    when pas: PlannedAs
                    {
                        var value_holder Vector[PlannedOperand]^rp(1)
                        value_holder.put(0, result)
                        let stitched PlannedAs(
                            pas.loc,
                            pas.target_type,
                            value_holder.get(0)
                        )
                        set result: PlannedOperand(
                            op.loc,
                            PlannedExpression.As(stitched),
                            null,
                            pas.target_type
                        )
                        set handled_unary: true
                    }
                    else
                        0

                guard handled_unary
                {
                    set i: i + 1
                    continue
                }

                ; Binary operator: op followed by rhs.
                ; guard runs the break when the condition is TRUE (Scaly
                ; semantics, NOT Swift-inverted). Bail out when no rhs is
                ; available.
                guard i + 1 >= ops.length
                    break

                let rhs_ptr ops.get(i + 1)
                var consumed_rest: bool false
                var rhs_call_consumed: bool false
                guard rhs_ptr <> null
                {
                    var rhs: PlannedOperand (*rhs_ptr)

                    ; Extract operator name from the op operand.
                    let op_name choose op.expr
                        when ty: PlannedType
                            ty.name
                        else
                            String^rp("")

                    ; If rhs is a non-operator Type immediately followed by
                    ; a Tuple, treat it as an ungrouped call (`A | f()` →
                    ; rhs = Call(f), not Type(f)). Stage-0's planOperands
                    ; pre-processes this in scalyc/Planner.cpp:7359+ before
                    ; collapseOperandSequence runs; stage-1's plan_operands
                    ; is a flat per-operand pass, so we fold here. Without
                    ; this, `f1() | f2()` builds Call(|, [Call(f1),
                    ; Type(f2)]) and drops the trailing `()`, then the
                    ; entire `if cond { ... }` collapses because emit_call
                    ; on Type(f2) returns null and the binary call is
                    ; rejected upstream — observed in cli.parse_args's
                    ; chained-if branches.
                    guard i + 2 < ops.length
                    {
                        choose rhs.expr
                            when rty: PlannedType
                            {
                                guard Planner.is_operator_name(rty.name) = false
                                {
                                    let after_ptr ops.get(i + 2)
                                    guard after_ptr <> null
                                    {
                                        let after_op (*after_ptr)
                                        var is_tuple_after: bool false
                                        choose after_op.expr
                                            when tp_after: PlannedTuple
                                                set is_tuple_after: true
                                            else
                                                0
                                        guard is_tuple_after
                                        {
                                            var sub_arr Array[PlannedOperand]$()
                                            sub_arr.add(rhs)
                                            sub_arr.add(after_op)
                                            var sub_vec Vector[PlannedOperand]^rp(sub_arr)
                                            set rhs: this.collapse_operand_sequence#(sub_vec)
                                            set rhs_call_consumed: true
                                        }
                                    }
                                }
                            }
                            else
                                0
                    }

                    ; Precedence look-ahead. If ops[i+2] is an operator with
                    ; HIGHER precedence than op_name, recursively collapse
                    ; [rhs, ops[i+2], ops[i+3], ...] first so the binary
                    ; call uses the precedence-correct right side. Without
                    ; this, the left-associative fold turns
                    ; `A <> X & B <> Y` into `((A <> X) & B) <> Y` rather
                    ; than `(A <> X) & (B <> Y)`. Mirrors
                    ; Planner.cpp:4298-4322. Sets consumed_rest so the outer
                    ; loop breaks after this iteration since the entire
                    ; right side has been folded into rhs.
                    let current_prec Planner.get_operator_precedence(op_name)
                    guard current_prec > 0
                    {
                        guard i + 2 < ops.length
                        {
                            let next_op_ptr ops.get(i + 2)
                            guard next_op_ptr <> null
                            {
                                let next_op (*next_op_ptr)
                                choose next_op.expr
                                    when nty: PlannedType
                                    {
                                        guard Planner.is_operator_name(nty.name)
                                        {
                                            let next_prec Planner.get_operator_precedence(nty.name)
                                            guard next_prec > current_prec
                                            {
                                                var right_arr Array[PlannedOperand]$()
                                                right_arr.add(rhs)
                                                var rr: size_t i + 2
                                                while rr < ops.length
                                                {
                                                    let p_ptr ops.get(rr)
                                                    guard p_ptr <> null
                                                        right_arr.add((*p_ptr))
                                                    set rr: rr + 1
                                                }
                                                var right_vec Vector[PlannedOperand]^rp(right_arr)
                                                set rhs: this.collapse_operand_sequence#(right_vec)
                                                set consumed_rest: true
                                            }
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    let resolved this.resolve_operator_call#(
                        op_name, result.result_type, rhs.result_type
                    )
                    var combined_type: PlannedType this.fresh_type_var#(String$(""))
                    guard resolved <> null
                        set combined_type: (*resolved)

                    ; Pointer arithmetic fallback: pointer[T] +/- integer
                    ; resolves to pointer[T]. resolve_operator_call# only
                    ; sees registered operators, so primitive ptr-arith
                    ; falls through with a fresh type var — emit_intrinsic
                    ; _binary_op then has no element type to derive and the
                    ; GEP fallback uses i8 (byte stride). Mirrors
                    ; Planner.cpp:3135-3155 (findOperator's IsPointerType +
                    ; IsIntegerType branch) — result type = LHS pointer type.
                    guard resolved = null
                    {
                        guard result.result_type.name.equals(String$("pointer"))
                        {
                            guard Planner.is_integer_type(rhs.result_type.name)
                            {
                                guard op_name.equals(String$("+"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("-"))
                                    set combined_type: result.result_type
                            }
                        }

                        ; s90: built-in comparison operators on primitive
                        ; types return bool. Without this, the fresh type
                        ; var from above leaks into upstream arg_types,
                        ; resolve_function_call# then arity-matches but
                        ; type-mismatches against the formal `bool` parameter
                        ; (fresh-name "" vs "bool"), match_ref stays null,
                        ; mangled="", and `let X f(a, p = q)` silently drops.
                        ; Mirrors Planner.cpp's findOperator returning bool
                        ; for primitive comparison.
                        guard op_name.equals(String$("="))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$("<>"))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$("<"))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$(">"))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$("<="))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$(">="))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$("&&"))
                            set combined_type: Planner.make_bool_type#()
                        guard op_name.equals(String$("||"))
                            set combined_type: Planner.make_bool_type#()

                        ; s101: built-in arithmetic / bitwise operators on
                        ; primitive integer types return the left operand's
                        ; type. Without this, `n - 1` (and any int op)
                        ; resolves to a fresh type var (empty name) — which
                        ; then leaks into resolve_function_call#'s arg_types,
                        ; arity matches but type comparison fails against
                        ; the formal `int` parameter, match_ref stays null,
                        ; mangled="", and the entire surrounding call
                        ; silently drops. Mirrors stage-0 Planner.cpp:
                        ; findOperator's primitive arithmetic passthrough
                        ; at lines 3073-3112.
                        guard Planner.is_integer_type(result.result_type.name)
                        {
                            guard Planner.is_integer_type(rhs.result_type.name)
                            {
                                guard op_name.equals(String$("+"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("-"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("*"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("/"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("%"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("&"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("|"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("^"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$("<<"))
                                    set combined_type: result.result_type
                                guard op_name.equals(String$(">>"))
                                    set combined_type: result.result_type
                            }
                        }
                    }

                    var two_args Vector[PlannedOperand]^rp(2)
                    two_args.put(0, result)
                    two_args.put(1, rhs)
                    var two_args_holder Vector[PlannedOperand]^rp(two_args)
                    ; Mirrors Planner.cpp:4378-4379 — built-in binary
                    ; operators on primitive types are intrinsic.
                    let call PlannedCall(
                        result.loc,
                        op_name,
                        this.mangle_binary_operator#(op_name, result.result_type, rhs.result_type),
                        true,
                        true,
                        false,
                        false,
                        &two_args_holder,
                        combined_type,
                        Lifetime.Unspecified(Unspecified())
                    )
                    set result: PlannedOperand(
                        result.loc,
                        PlannedExpression.Call(call),
                        null,
                        combined_type
                    )
                }
                guard consumed_rest
                    break
                guard rhs_call_consumed
                {
                    set i: i + 3
                    continue
                }
                set i: i + 2
            }

            result
        }

        ; check_operator_match: test a single Operator candidate against
        ; argument types. Same shape as check_function_match.
        function check_operator_match#(
            rp,
            this: Planner,
            o: Operator,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[PlannedType]?
        {
            var param_start: size_t 0
            guard o.input.length > 0
            {
                let first_ptr o.input.get(0)
                guard first_ptr <> null
                {
                    guard first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        guard fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity o.input.length - param_start
            guard expected_arity <> arg_types.length
                return null

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr o.input.get(j + param_start)
                let a_ptr arg_types.get(j)
                guard p_ptr = null
                    return null
                guard a_ptr = null
                    return null
                guard p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    guard exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    guard exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    guard ok = false
                        return null
                }
                set j: j + 1
            }

            var holder Vector[PlannedType]^rp(1)
            guard o.returns_ <> null
            {
                let rt (*o.returns_)
                holder.put(0, this.plan_type#(rt))
            }
            guard o.returns_ = null
                holder.put(0, Planner.make_void_type#())
            holder.get(0)
        }

        ; resolve_prefix_operator_call: for unary prefix operators like
        ; `-x` or `!flag`. Two-pass: exact matches first, then compatible.
        function resolve_prefix_operator_call#(
            rp,
            this: Planner,
            name: String,
            operand: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators#(name)
            guard candidates.length = 0
                return null

            var arg_types Vector[PlannedType]^rp(1)
            arg_types.put(0, operand)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get(i)
                guard o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, true)
                    guard rt <> null
                        return rt
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get(k)
                guard o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, false)
                    guard rt <> null
                        return rt
                }
                set k: k + 1
            }
            null
        }

        ; resolve_operator_call: two-pass overload resolution for binary
        ; operators keyed on the operator symbol registry.
        function resolve_operator_call#(
            rp,
            this: Planner,
            name: String,
            left: PlannedType,
            right: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators#(name)
            guard candidates.length = 0
                return null

            var arg_types Vector[PlannedType]^rp(2)
            arg_types.put(0, left)
            arg_types.put(1, right)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get(i)
                guard o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, true)
                    guard rt <> null
                        return rt
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get(k)
                guard o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, false)
                    guard rt <> null
                        return rt
                }
                set k: k + 1
            }

            ; Pass 3: generic operator. Plan parameter types, infer
            ; generic bindings against arg_types, seed type_substitutions
            ; and plan the operator's declared return type under those
            ; bindings.
            var g: size_t 0
            while g < candidates.length
            {
                let o_ptr candidates.get(g)
                guard o_ptr <> null
                {
                    let o (*o_ptr)
                    guard o.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        guard o.input.length > 0
                        {
                            let fi0 o.input.get(0)
                            guard fi0 <> null
                            {
                                guard fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    guard fname.equals(String$("this"))
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity o.input.length - param_start2
                        guard expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]$()
                            var pi: size_t param_start2
                            while pi < o.input.length
                            {
                                let p_ptr o.input.get(pi)
                                guard p_ptr <> null
                                {
                                    guard p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type#(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType]^rp(param_types_arr)

                            let bindings this.infer_type_arguments#(
                                param_types_vec, arg_types
                            )
                            guard bindings.length >= o.parameters.length
                            {
                                let saved_len type_substitutions.length
                                var bi: size_t 0
                                while bi < bindings.length
                                {
                                    let kv_ptr bindings.get(bi)
                                    guard kv_ptr <> null
                                        this.define_type_substitution(
                                            kv_ptr.key, kv_ptr.value
                                        )
                                    set bi: bi + 1
                                }

                                var holder Vector[PlannedType]^rp(1)
                                guard o.returns_ <> null
                                {
                                    let rt_model (*o.returns_)
                                    holder.put(0, this.plan_type#(rt_model))
                                }
                                guard o.returns_ = null
                                    holder.put(0, Planner.make_void_type#())

                                set type_substitutions.length: saved_len
                                return holder.get(0)
                            }
                        }
                    }
                }
                set g: g + 1
            }

            null
        }

        ; mangle_method: build `_ZN<parent>methodEparam*` without the
        ; PlannedItem ceremony that mangle_function requires. Just takes
        ; a parent PlannedType and a Vector of param PlannedTypes.
        function mangle_method#(
            rp,
            this: Planner,
            method_name: String,
            parent: PlannedType,
            params: Vector[PlannedType],
            has_page_param: bool
        ) returns String
        {
            var sb StringBuilder$()
            sb.append("_ZN")
            sb.append(Planner.encode_type#(parent))
            sb.append(Planner.encode_name(method_name))
            sb.append("E")

            ; Implicit page parameter for `function foo#(...)` methods —
            ; matches mangle_function's handling of has_page_param.
            var has_explicit: bool false
            guard has_page_param
            {
                sb.append("PN4scaly6memory4PageE")
                set has_explicit: true
            }

            guard params.length = 0
            {
                guard has_explicit = false
                    sb.append("v")
                return sb.to_string^rp()
            }

            var i: size_t 0
            while i < params.length
            {
                let p_ptr params.get(i)
                guard p_ptr <> null
                {
                    let p (*p_ptr)
                    sb.append(Planner.encode_type#(p))
                }
                set i: i + 1
            }

            sb.to_string^rp()
        }

        ; lookup_method: more-detailed method lookup that returns a
        ; MethodMatch with mangled name, return type, and parameter
        ; types pre-computed. The `method` field of MethodMatch points
        ; at a PlannedFunction — we leave it null for now; wiring it up
        ; requires caching planned methods per struct, which we don't
        ; do yet.
        function lookup_method#(
            rp,
            this: Planner,
            struct_type: PlannedType,
            method_name: String
        ) returns ref[MethodMatch]?
        {
            ; s106: auto-deref pointer[T] / ref[T] before lookup. Mirrors
            ; getInnerTypeIfPointerLike at Planner.cpp:1441. Without this,
            ; method dispatch on a pointer-typed local (e.g. init#'s
            ; implicit `page: pointer[scaly.memory.Page]`) silently fails
            ; because lookup walks the outer "pointer" name.
            var lookup_st: PlannedType struct_type
            guard struct_type.name.equals(String$("pointer"))
            {
                guard struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    guard gens.length > 0
                    {
                        let inner_ptr gens.get(0)
                        guard inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            guard struct_type.name.equals(String$("ref"))
            {
                guard struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    guard gens.length > 0
                    {
                        let inner_ptr gens.get(0)
                        guard inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            let candidates this.lookup_methods#(lookup_st.name, method_name)
            guard candidates.length = 0
                return null

            ; Take the first match. Overload resolution by arg types
            ; happens in resolve_function_call / resolve_operator_call;
            ; this simpler lookup picks-by-name only.
            let f_ptr candidates.get(0)
            guard f_ptr = null
                return null
            let f (*f_ptr)

            ; Set up type substitutions for the struct's type parameters.
            ; Mirrors Planner.cpp:1660-1664 / 2004-2007. Without this, when
            ; resolving the param/return Types of a generic method (e.g.
            ; Array.add(this, item: T)) the bound `T` doesn't substitute to
            ; the concrete generic argument (Program), so the mangled name
            ; comes out as `_ZN5ArrayI7ProgramE3addE1T` instead of
            ; `_ZN5ArrayI7ProgramE3addE7Program` and the link fails.
            ; s132: bind substitutions against the auto-deref'd `lookup_st`,
            ; not the raw `struct_type`. For a `ref[Vector[Module]]` receiver,
            ; struct_type.name="ref" and lookup_concept("ref")=null — the
            ; substitution loop silently no-ops and `T` stays unbound, so
            ; mangle_method emits `_ZN6VectorI6ModuleE3addE1T` instead of
            ; `..3addE6Module`. Mirrors the auto-deref above this block
            ; (lookup_st = struct_type.generics[0] when struct_type is
            ; pointer/ref).
            let saved_subst_len_lm type_substitutions.length
            let conc_ref this.lookup_concept(lookup_st.name)
            guard conc_ref <> null
            {
                let conc (*conc_ref)
                guard conc.parameters.length > 0
                {
                    guard lookup_st.generics <> null
                    {
                        let gens_ref (*lookup_st.generics)
                        var pi: size_t 0
                        while pi < conc.parameters.length
                        {
                            guard pi >= gens_ref.length
                                set pi: conc.parameters.length
                            guard pi < conc.parameters.length
                            {
                                let cp_ptr conc.parameters.get(pi)
                                let gen_ptr gens_ref.get(pi)
                                guard cp_ptr <> null
                                {
                                    guard gen_ptr <> null
                                    {
                                        this.define_type_substitution(cp_ptr.name, (*gen_ptr))
                                    }
                                }
                                set pi: pi + 1
                            }
                        }
                    }
                }
            }

            var return_type: PlannedType Planner.make_void_type#()
            guard f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type#(rt)
            }

            ; Skip leading 'this' in the parameter list.
            var param_start: size_t 0
            guard f.input.length > 0
            {
                let first_ptr f.input.get(0)
                guard first_ptr <> null
                {
                    guard first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        guard fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            ; Collect planned parameter types (excluding this).
            var params_arr Array[PlannedType]$()
            var i: size_t param_start
            while i < f.input.length
            {
                let p_ptr f.input.get(i)
                guard p_ptr <> null
                {
                    guard p_ptr.type <> null
                    {
                        let pt (*p_ptr.type)
                        params_arr.add(this.plan_type#(pt))
                    }
                }
                set i: i + 1
            }
            var params_holder Vector[PlannedType]^rp(params_arr)
            set type_substitutions.length: saved_subst_len_lm

            var has_page: bool false
            guard f.page_parameter <> null
                set has_page: true
            ; Implicit return-page: a function whose return type is a
            ; user-defined struct/union gets an `_rp` page parameter
            ; injected at planFunction time (Planner.cpp:11697). Mirror
            ; that here so the mangled name matches the emitted function.
            guard Planner.needs_implicit_return_page(f)
                set has_page: true
            ; s106: mangle against the auto-derefed receiver type.
            ; struct_type may be pointer[Foo] / ref[Foo]; the Itanium
            ; method symbol uses the bare receiver Foo so it matches
            ; the body emitted under planStructure(Foo).
            let mangled this.mangle_method#(method_name, lookup_st, params_holder, has_page)

            ; Throws type (optional).
            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            guard f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                var th_holder Vector[PlannedType]^rp(1)
                th_holder.put(0, this.plan_type#(tt))
                set throws_ref: th_holder.get(0)
            }

            ; s88: propagate has_page (set when the resolved method takes
            ; an explicit `page` param OR when it returns a struct/union
            ; that triggers the implicit-return-page injection) into the
            ; MethodMatch's requires_page_param. collapse_operand_sequence#
            ; reads this field on the resolved match and threads it onto
            ; the PlannedCall so emit_call prepends `rp` as arg0. Without
            ; it, every call to a `function#` method (e.g. String.to_c_string#,
            ; File.read_to_string#) emits only the explicit args and the
            ; callee reads garbage in the rp slot — observed as the empty
            ; cli.run "Could not read input file" path before s88.
            var match_holder Vector[MethodMatch]^rp(1)
            match_holder.put(0, MethodMatch(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false
            ))
            match_holder.get(0)
        }

        ; generate_page_get_this: synthesize a `Page.get(this)` call,
        ; returned as a PlannedOperand whose result_type is
        ; `pointer[Page]`. Used when lowering a `^this` lifetime
        ; annotation — the emitter needs the page that currently owns
        ; `this` to allocate a sibling value.
        ;
        ; `this` must be a local in the current scope; the unreachable
        ; fallback returns a void placeholder so the type checker still
        ; threads a value through.
        function generate_page_get_this#(rp, this: Planner, loc: Span) returns PlannedOperand
        {
            let this_ty_ref this.lookup_local(String$("this"))
            guard this_ty_ref = null
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    loc,
                    PlannedExpression.Type(void_ty),
                    null,
                    void_ty
                )
            }

            let this_ty (*this_ty_ref)

            ; Build the result type: pointer[Page].
            let page_ty PlannedType(
                loc,
                String^rp("Page"),
                String^rp(""),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            )
            let result_type Planner.make_pointer_type#(page_ty)

            ; Plan the `this` variable operand to pass as the argument.
            let this_var PlannedVariable(loc, String^rp("this"), this_ty, false)
            let this_operand PlannedOperand(
                loc,
                PlannedExpression.Variable(this_var),
                null,
                this_ty
            )

            var args_vec Vector[PlannedOperand]^rp(1)
            args_vec.put(0, this_operand)

            ; Mangle as a call to Page.get(pointer[void]).
            let call this.make_planned_call#(
                loc,
                String^rp("get"),
                String^rp("_ZN4scaly6memory4Page3getEPv"),
                result_type,
                args_vec
            )

            PlannedOperand(
                loc,
                PlannedExpression.Call(call),
                null,
                result_type
            )
        }

        ; ================================================================
        ; resolve_member_access: walk a chain of member names against
        ; `base_type`, producing a PlannedMemberAccess for each hop.
        ;
        ; At each step:
        ;   - if the name is a property, record the planned PropertyType
        ;     and continue the chain from that type;
        ;   - else if the name is a method, record the planned return
        ;     type and continue from that type;
        ;   - else record a placeholder with void result (caller will
        ;     surface this as an error when emission is attempted).
        ;
        ; The produced access chain feeds `PlannedOperand.member_access`.
        ; ================================================================
        function resolve_member_access#(
            rp,
            this: Planner,
            base_type: PlannedType,
            members: Vector[String]
        ) returns Vector[PlannedMemberAccess]
        {
            var result Array[PlannedMemberAccess]$()
            var current: PlannedType base_type

            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get(i)
                guard m_ptr <> null
                {
                    let m (*m_ptr)

                    var matched: bool false

                    ; s106: auto-deref pointer[T] / ref[T] for member lookup.
                    ; Mirrors stage-0's getInnerTypeIfPointerLike at
                    ; Planner.cpp:1441. Without this, a pointer-typed local
                    ; (e.g. init#'s implicit `page: pointer[scaly.memory.Page]`)
                    ; never finds methods because lookup walks the outer
                    ; "pointer" name.
                    var lookup_type: PlannedType current
                    guard current.name.equals(String$("pointer"))
                    {
                        guard current.generics <> null
                        {
                            let gens (*current.generics)
                            guard gens.length > 0
                            {
                                let inner_ptr gens.get(0)
                                guard inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }
                    guard current.name.equals(String$("ref"))
                    {
                        guard current.generics <> null
                        {
                            let gens (*current.generics)
                            guard gens.length > 0
                            {
                                let inner_ptr gens.get(0)
                                guard inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }

                    ; Property lookup.
                    let prop_ref this.lookup_property(lookup_type.name, m)
                    guard prop_ref <> null
                    {
                        set matched: true
                        let prop (*prop_ref)
                        var prop_type: PlannedType this.fresh_type_var#(String$(""))
                        guard prop.type <> null
                        {
                            let t (*prop.type)
                            set prop_type: this.plan_type#(t)
                        }
                        let idx this.get_property_index(lookup_type.name, m)
                        result.add(PlannedMemberAccess(
                            m, idx as size_t, false, false, current, prop_type
                        ))
                        set current: prop_type
                    }

                    ; Method lookup as fallback.
                    guard matched = false
                    {
                        let methods this.lookup_methods#(lookup_type.name, m)
                        guard methods.length > 0
                        {
                            set matched: true
                            let first_ptr methods.get(0)
                            guard first_ptr <> null
                            {
                                let f (*first_ptr)
                                var return_ty: PlannedType this.fresh_type_var#(String$(""))
                                guard f.returns_ <> null
                                {
                                    let rt (*f.returns_)
                                    set return_ty: this.plan_type#(rt)
                                }
                                result.add(PlannedMemberAccess(
                                    m, 0, true, false, current, return_ty
                                ))
                                set current: return_ty
                            }
                        }
                    }

                    ; Union-variant lookup for the remaining case
                    ; (e.g. `opt.Some` as a variant construction). The
                    ; result type of a variant access is the owning union
                    ; itself — construction stays within the same type.
                    guard matched = false
                    {
                        let tag this.lookup_variant_tag(lookup_type.name, m)
                        guard tag >= 0
                        {
                            set matched: true
                            result.add(PlannedMemberAccess(
                                m, tag as size_t, false, true, current,
                                current
                            ))
                        }
                    }

                    ; s103: Union `.value` accessor — extracts the
                    ; payload of the union's first non-unit variant.
                    ; Mirrors stage-0 Planner.cpp:5198-5226. The result
                    ; type is the variant's payload type. is_union_value
                    ; is set so emit_member_access_chain takes the
                    ; alloca + GEP-to-data + bitcast + load path
                    ; instead of a plain extractvalue at field_index.
                    guard matched = false
                    {
                        guard m.equals(String$("value"))
                        {
                            let conc_ref_for_value this.lookup_concept(lookup_type.name)
                            guard conc_ref_for_value <> null
                            {
                                let conc_for_value (*conc_ref_for_value)
                                choose conc_for_value.definition
                                    when uv: scalyc.compiler.Model.Union
                                    {
                                        var found_payload: bool false
                                        var payload_type: PlannedType Planner.make_void_type#()
                                        var vi: size_t 0
                                        while vi < uv.variants.length
                                        {
                                            guard found_payload = false
                                            {
                                                let v_ptr uv.variants.get(vi)
                                                guard v_ptr <> null
                                                {
                                                    let var_def (*v_ptr)
                                                    guard var_def.type <> null
                                                    {
                                                        let vt (*var_def.type)
                                                        set payload_type: this.plan_type#(vt)
                                                        set found_payload: true
                                                    }
                                                }
                                            }
                                            set vi: vi + 1
                                        }
                                        guard found_payload
                                        {
                                            set matched: true
                                            result.add(PlannedMemberAccess(
                                                m, 1, false, true, current,
                                                payload_type
                                            ))
                                            set current: payload_type
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    ; Unresolved — record placeholder with void result.
                    guard matched = false
                    {
                        var sb StringBuilder$()
                        sb.append("member '")
                        sb.append(m)
                        sb.append("' not found in type ")
                        sb.append(current.name)
                        this.add_error(sb.to_string^rp())
                        result.add(PlannedMemberAccess(
                            m, 0, false, false, current, Planner.make_void_type#()
                        ))
                    }
                }
                set i: i + 1
            }

            Vector[PlannedMemberAccess]^rp(result)
        }

        ; fresh_type_var: allocate a new type variable as a PlannedType
        ; wrapper with `variable` populated. Equivalent to Planner.cpp's
        ; freshTypeVar. `debug_name` is stored on the TypeVariable for
        ; error messages ("expected T, got int").
        function fresh_type_var#(rp, this: Planner, debug_name: String) returns PlannedType
        {
            let id this.fresh_type_var_id()
            ; Allocate the TypeVariable in a one-element Vector on rp so
            ; its address outlives this function.
            var holder Vector[TypeVariable]^rp(1)
            holder.put(0, TypeVariable(id, String^rp(debug_name)))
            let tv_ref holder.get(0)
            PlannedType(
                Span(0, 0),
                String^rp(debug_name),
                String^rp(""),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                tv_ref
            )
        }

        ; ================================================================
        ; Constraint management.
        ; ================================================================

        function add_equality_constraint(
            this: Planner,
            left: PlannedType,
            right: PlannedType,
            loc: Span
        )
        {
            constraints.add(TypeConstraint.Equality(
                EqualityConstraint(left, right, loc, String$(file))
            ))
        }

        ; solve_and_apply: drain the constraint queue, unify everything,
        ; stash the result in `solution`. Returns true on success, false
        ; if any constraint failed to unify. Constraints are cleared on
        ; success so subsequent add_equality_constraint / solve cycles
        ; start fresh.
        function solve_and_apply#(rp, this: Planner) returns bool
        {
            guard constraints.length = 0
                return true

            ; Run the stateless solver.
            var cs_vec Vector[TypeConstraint]^rp(constraints)
            let result Planner.solve_constraints#(&cs_vec)
            guard result = null
                return false

            ; Snapshot the substitution into the Planner's persistent
            ; `solution` array, overwriting any previous solution.
            set solution.length: 0
            let result_v (*result)
            var i: size_t 0
            while i < result_v.length
            {
                let kvp_ptr result_v.get(i)
                guard kvp_ptr <> null
                    solution.add(*kvp_ptr)

                set i: i + 1
            }

            ; Constraints are consumed.
            set constraints.length: 0
            true
        }

        ; apply_current_substitution: rewrite `t` using the current
        ; `solution`. Convenience wrapper around apply_substitution so
        ; callers don't have to marshal the Array-as-Vector themselves.
        function apply_current_substitution#(rp, this: Planner, t: PlannedType) returns PlannedType
        {
            guard solution.length = 0
                return t

            var sol_vec Vector[KeyValuePair[size_t, PlannedType]]^rp(solution)
            Planner.apply_substitution#(t, &sol_vec)
        }

        ; ================================================================
        ; plan_type: Model.Type → PlannedType using the active generic
        ; substitutions. Pulls together resolve_type_base (Model → Plan
        ; skeleton), apply_name_substitution (T → int, etc.), and the
        ; concept registry to fill in mangled_name for registered types.
        ; ================================================================
        function plan_type#(rp, this: Planner, t: Type) returns PlannedType
        {
            let base Planner.resolve_type_base#(t)

            var after_subst: PlannedType base
            var subst_fired: bool false
            guard type_substitutions.length > 0
            {
                var sub_vec Vector[KeyValuePair[String, PlannedType]]^rp(type_substitutions)
                set after_subst: Planner.apply_name_substitution#(base, &sub_vec)
                ; If substitution actually replaced the name (T → Concrete),
                ; the result is already a concrete type — skip the dotted-name
                ; canonicalization that would shorten qualified names like
                ; `scalyc.compiler.Plan.PlannedUnion` → `PlannedUnion`. Stage-0
                ; preserves the full name in this case (encodeType uses the
                ; pre-set MangledName shortcut at Planner.cpp:518); without
                ; this guard stage-1 emits an inconsistent mangling — the
                ; container generic uses `33scalyc.compiler.Plan.PlannedUnion`
                ; (full) while the arg substitutes to `12PlannedUnion` (short),
                ; producing a method symbol that no other side defines (s100).
                guard after_subst.name.equals(base.name) = false
                    set subst_fired: true
            }
            guard subst_fired
                return after_subst

            ; s96: Recursively canonicalize inner generics for ref[T] /
            ; pointer[T]. resolve_type_base# only recurses via itself
            ; (no Planner state, no has_concept access), so an inner
            ; type written as `Planner.Planner` (joined dotted name)
            ; stays in that form even when stage-1's concept registry
            ; has it under the canonical short name `Planner`. Without
            ; this, `ref[Planner.Planner]` mangles its inner as
            ; `15Planner.Planner` while a same-source-but-canonicalized
            ; `Planner` argument would mangle as `7Planner` — types_equal
            ; on the inner names returns false, types_compatible
            ; (s96 part 2) bails, the call is dropped. Mirrors stage-0
            ; Planner.cpp's resolveType which calls itself recursively
            ; on generic args (via resolveType, not the static helper).
            guard after_subst.mangled_name.get_length() > 0
            {
                guard t.generics <> null
                {
                    let model_gens (*t.generics)
                    guard model_gens.length > 0
                    {
                        var canon_gens Vector[PlannedType]^rp(model_gens.length)
                        var gi: size_t 0
                        while gi < model_gens.length
                        {
                            let g_ptr model_gens.get(gi)
                            guard g_ptr <> null
                            {
                                let g (*g_ptr)
                                let canon_inner this.plan_type#(g)
                                canon_gens.put(gi, canon_inner)
                            }
                            set gi: gi + 1
                        }
                        ; Rebuild outer mangled name with canonicalized inner.
                        var sb StringBuilder$()
                        guard after_subst.name.equals("pointer")
                            sb.append("P")
                        guard after_subst.name.equals("ref")
                            sb.append("R")
                        let inner0_ptr canon_gens.get(0)
                        guard inner0_ptr <> null
                        {
                            let inner0 (*inner0_ptr)
                            sb.append(inner0.mangled_name)
                        }
                        return PlannedType(
                            after_subst.loc,
                            after_subst.name,
                            sb.to_string^rp(),
                            &canon_gens,
                            after_subst.life,
                            after_subst.origin,
                            after_subst.array_size,
                            after_subst.variable
                        )
                    }
                }
                return after_subst
            }

            ; Otherwise consult the concept table: a registered user type
            ; mangles as "_Z"-length-prefix-with-optional-generic-block.
            ;
            ; Dotted-name canonicalization: when the joined name (e.g.
            ; "parser.ProgramSyntax") doesn't resolve, try the last
            ; segment alone ("ProgramSyntax"). This makes a parameter
            ; type written as `parser.ProgramSyntax` (qualified by use
            ; alias) match a function declaring `syntax: ProgramSyntax`
            ; (unqualified). Mirrors stage-0 Planner.cpp:5619-5648
            ; (lookupConcept dotted) and 6263-6311 (resolveType module
            ; stack fallback).
            var canonical_name: String String^rp(after_subst.name)
            guard this.has_concept(canonical_name) = false
            {
                let last_dot canonical_name.last_index_of("." as u8)
                guard last_dot >= 0
                {
                    let start (last_dot as size_t) + 1
                    let total canonical_name.get_length()
                    guard total > start
                    {
                        let suffix canonical_name.substring(rp, start, total - start)
                        guard this.has_concept(suffix)
                            set canonical_name: suffix
                    }
                }
            }
            guard this.has_concept(canonical_name) = false
                return after_subst

            ; s107: when the concept is a generic data class (Structure
            ; with no members/initializers) used with concrete type args,
            ; route through instantiate_generic# so the specialised body
            ; gets recorded in instantiated_structures. Restricted to
            ; data classes — generics with method bodies (Vector,
            ; HashMap, etc.) drag in cross-package references that
            ; stage-1 cannot fully plan, exhausting the rp page during
            ; the deep plan_function# walk and SEGVing in LLVM codegen.
            ; The restriction means user-defined `define Box[T](value: T)`
            ; types instantiate cleanly, while stdlib generics fall
            ; through to the empty-mangled fallback below as before.
            let conc_ref this.lookup_concept(canonical_name)
            guard conc_ref <> null
            {
                let conc (*conc_ref)
                guard conc.parameters.length > 0
                {
                    ; s109: relax to any generic Structure. stdlib generics
                    ; (Vector / HashMap / Array / etc.) historically SEGV
                    ; when their bodies are walked with substitutions
                    ; bound — keep them on the empty-mangled fallback
                    ; path. User-defined generics with methods/inits
                    ; (e.g. nested_generic's Box, generic_lifetime's
                    ; Container) get specialised here so the spec'd
                    ; bodies (`_ZN3BoxIiE3getEv`, `_ZN9ContainerIiE...`)
                    ; reach the emitter.
                    var is_struct: bool false
                    choose conc.definition
                        when s: Structure
                            set is_struct: true
                        else
                            0
                    var is_stdlib_generic: bool false
                    ; s129: Vector + Array routed through instantiate_generic#
                    ; (removed from the data-class restriction). The s107 gate
                    ; originally excluded all stdlib generics because their
                    ; bodies were "drag[ging] in cross-package references" —
                    ; with s109..s127 (generic spec'd methods, intrinsic
                    ; map_type, page_param stub, deref-load, receiver-load,
                    ; emit_choose IR guards, empty-args ctor field-init, scope
                    ; push/pop, LinkOnceODR linkage) all in place, stage-1 can
                    ; now plan + emit those bodies. Removing Vector + Array
                    ; from this list cuts Step-7 stage-2 link undef refs from
                    ; 106 → 4. The matching skip_dispatch denylist site
                    ; (~line 3240) is intentionally kept: `vec.add(x)` style
                    ; method dispatch still routes via the extern-decl shim
                    ; rather than the spec'd `_ZN6VectorI...E3addE...` lookup.
                    guard canonical_name.equals("HashMap")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("HashMapBuilder")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("HashSet")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("HashSetBuilder")
                        set is_stdlib_generic: true
                    ; s129: Array removed alongside Vector (see comment above).
                    ; s148: List + ListIterator + Node removed analogous to
                    ; the s129 Vector/Array lift. Without this, stage-1's
                    ; planner doesn't run instantiate_generic# for
                    ; List<StatementSyntax>/etc., so `list.add$(node)` calls
                    ; emitted via the skip_dispatch (still kept) extern-decl
                    ; shim have no body to link against. Specialised bodies
                    ; (`_ZN4ListIxxxE3addExxx`) are needed because Itanium
                    ; mangling makes each T-instantiation a distinct symbol
                    ; and libscaly.a only provides List<int> (used by tests
                    ; in scaly.scaly itself).
                    ; guard canonical_name.equals("List")
                    ;     set is_stdlib_generic: true
                    ; guard canonical_name.equals("ListIterator")
                    ;     set is_stdlib_generic: true
                    guard canonical_name.equals("BuilderList")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("BuilderListIterator")
                        set is_stdlib_generic: true
                    ; s148: Node removed alongside List (see comment above).
                    ; List<T>::add allocates Node<T>; with Node in the
                    ; stdlib-generic skip list it falls through to the
                    ; abstract `{ptr, ptr}` placeholder (16 bytes for any
                    ; T) instead of `{T, ptr}` (sizeof(T) + 8). Lifting
                    ; lets instantiate_generic# produce a properly sized
                    ; named struct per concrete T.
                    ; guard canonical_name.equals("Node")
                    ;     set is_stdlib_generic: true
                    guard canonical_name.equals("Slot")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("Slice")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("Option")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("Result")
                        set is_stdlib_generic: true
                    guard canonical_name.equals("KeyValuePair")
                        set is_stdlib_generic: true
                    guard is_struct
                        guard is_stdlib_generic = false
                        {
                            guard after_subst.generics <> null
                            {
                                let g (*after_subst.generics)
                                guard g.length = conc.parameters.length
                                {
                                    ; s110: recursively plan each generic arg
                                    ; before instantiation, so nested generics
                                    ; like Box[Box[int]] propagate inner
                                    ; mangled names. Without this, inner args
                                    ; from resolve_type_base# carry empty
                                    ; mangled names and the spec'd struct's
                                    ; property type bottoms out with empty
                                    ; mangled — map_type's struct_cache miss
                                    ; emits the outer's field as opaque ptr.
                                    ; s115: skip the recursion when the inner
                                    ; arg is already a struct (has non-empty
                                    ; mangled_name) — the s110 case only
                                    ; needs to fire for raw model types from
                                    ; resolve_type_base#. Recursing on every
                                    ; arg in instantiate_generic#'s loop
                                    ; triggered deep stack growth in
                                    ; scalyc.scaly self-compile because
                                    ; nested-generic method bodies kept
                                    ; re-entering plan_type# → instantiate_
                                    ; generic# before the outer hit the
                                    ; instantiated_structures cache.
                                    ; s133: refine the s115 short-circuit. Using `gp`
                                    ; directly when its mangled is non-empty is safe
                                    ; for inner args that are already fully specialised
                                    ; (e.g. `Box[int]` arriving via type substitution).
                                    ; But when the model side `mp` has generics yet
                                    ; `gp.generics` is null, `gp` is the ABSTRACT
                                    ; template (mangled looks like `_Z12KeyValuePair`,
                                    ; no `I...E` suffix) and reusing it propagates the
                                    ; truncated mangling through every nesting layer.
                                    ; Concretely: HashMap[String, LocalBinding] uses
                                    ; Slot[KeyValuePair[K, V]] internally; without this
                                    ; carve-out, Vector<Vector<KeyValuePair<String,
                                    ; LocalBinding>>>::ctor ends up named
                                    ; `_ZN6VectorI6VectorI12KeyValuePairEEC1...`,
                                    ; dropping the inner `I6String12LocalBindingE`.
                                    ; Re-plan via plan_type# in this case so the
                                    ; current substitutions (K → String, V →
                                    ; LocalBinding) drive the inner mangling.
                                    var canon_gens_inst Vector[PlannedType]^rp(g.length)
                                    var ggi: size_t 0
                                    while ggi < g.length
                                    {
                                        let gp_ptr g.get(ggi)
                                        guard gp_ptr <> null
                                        {
                                            let gp (*gp_ptr)
                                            var need_replan: bool false
                                            guard gp.mangled_name.get_length() = 0
                                                set need_replan: true
                                            guard gp.generics = null
                                            {
                                                guard t.generics <> null
                                                {
                                                    let mg_check (*t.generics)
                                                    guard ggi < mg_check.length
                                                    {
                                                        let mp_check_ptr mg_check.get(ggi)
                                                        guard mp_check_ptr <> null
                                                        {
                                                            guard mp_check_ptr.generics <> null
                                                                set need_replan: true
                                                        }
                                                    }
                                                }
                                            }
                                            guard need_replan = false
                                                canon_gens_inst.put(ggi, gp)
                                            guard need_replan
                                            {
                                                guard t.generics <> null
                                                {
                                                    let mg (*t.generics)
                                                    guard ggi < mg.length
                                                    {
                                                        let mp_ptr mg.get(ggi)
                                                        guard mp_ptr <> null
                                                        {
                                                            let mp (*mp_ptr)
                                                            let cgi this.plan_type#(mp)
                                                            canon_gens_inst.put(ggi, cgi)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        set ggi: ggi + 1
                                    }

                                    ; s109: preserve the call-site lifetime
                                    ; (^page / $ / #) on the specialised
                                    ; PlannedType. instantiate_generic#
                                    ; returns Lifetime.Unspecified by
                                    ; default; without overlaying the
                                    ; original after_subst.life,
                                    ; `Container[int]^page_ptr(...)` loses
                                    ; the page-pointer arg at the ctor
                                    ; call site (`<null operand!>`).
                                    let inst this.instantiate_generic#(canonical_name, canon_gens_inst, after_subst.loc)
                                    return PlannedType(
                                        inst.loc,
                                        inst.name,
                                        inst.mangled_name,
                                        inst.generics,
                                        after_subst.life,
                                        after_subst.origin,
                                        after_subst.array_size,
                                        after_subst.variable
                                    )
                                }
                            }
                        }
                }
            }

            let mangled Planner.mangle_structure#(canonical_name, after_subst.generics)
            PlannedType(
                after_subst.loc,
                canonical_name,
                mangled,
                after_subst.generics,
                after_subst.life,
                after_subst.origin,
                after_subst.array_size,
                after_subst.variable
            )
        }

        ; ================================================================
        ; plan_item: Model.Item → PlannedItem.
        ;
        ; Handles the optional name and type annotation. Attributes are
        ; dropped for now — the PlannedItem carries `null` in that slot
        ; until attribute planning is ported.
        ;
        ; Returns-by-value copies the PlannedItem to the caller; the refs
        ; inside (name, item_type) point into single-element holder Vectors
        ; allocated on this function's rp, so they survive the caller's
        ; use of the returned PlannedItem.
        ; ================================================================
        function plan_item#(rp, this: Planner, i: Item) returns PlannedItem
        {
            var planned_name: ref[String]? null
            guard i.name <> null
            {
                let n (*i.name)
                var name_holder Vector[String]^rp(1)
                name_holder.put(0, String^rp(n))
                set planned_name: name_holder.get(0)
            }

            var planned_type: ref[PlannedType]? null
            guard i.type <> null
            {
                let model_type (*i.type)
                let planned this.plan_type#(model_type)
                var type_holder Vector[PlannedType]^rp(1)
                type_holder.put(0, planned)
                set planned_type: type_holder.get(0)
            }

            PlannedItem(
                i.span,
                i.private_,
                planned_name,
                planned_type,
                null
            )
        }

        ; plan_items: batch version of plan_item over a Vector[Item].
        ; Pre-allocates the result Vector at the correct size so we can
        ; use `put(i, ...)` instead of Array.add + copy.
        function plan_items#(rp, this: Planner, items: Vector[Item]) returns Vector[PlannedItem]
        {
            var result Vector[PlannedItem]^rp(items.length)
            var i: size_t 0
            while i < items.length
            {
                let item_ptr items.get(i)
                guard item_ptr <> null
                {
                    let item (*item_ptr)
                    let pl this.plan_item#(item)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; plan_constant_operand: wrap a Constant literal as a PlannedOperand
        ; with its inferred type populated. The result_type is whatever
        ; infer_constant_type says at pre-solver time (e.g. IntegerConstant
        ; → "int", StringConstant → pointer[i8]).
        function plan_constant_operand#(
            rp,
            this: Planner,
            c: Constant,
            loc: Span
        ) returns PlannedOperand
        {
            let ty Planner.infer_constant_type#(c)
            PlannedOperand(
                loc,
                PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant(c)),
                null,
                ty
            )
        }

        ; ================================================================
        ; Simple Expression planners.
        ; ================================================================

        ; plan_sizeof: SizeOf(type) → PlannedSizeOf with computed byte
        ; size. get_primitive_alignment doubles as size for primitives
        ; but returns the catch-all 8 for any non-primitive — wrong for
        ; struct types like Module (80 B). Look the Concept up in the
        ; registry (set up during plan_program's namespace walk, before
        ; generic instantiation runs) and compute the size from its
        ; Model.Property list. Each property's contribution is either a
        ; primitive byte size or a hardcoded stdlib-container shape:
        ; Vector = 16 (length + data), String/HashMap = 8 (single ptr).
        ; That gives Module = 1 (bool) + 7 (pad) + 2*8 + 3*16 + 8 = 80,
        ; matching the LLVM struct layout. Without this, Vector#(rp,len)
        ; for Vector[Module] allocates len*8 instead of len*80, and
        ; put(i, m) overruns and SEGVs build_program.
        function plan_sizeof#(rp, this: Planner, s: SizeOf) returns PlannedSizeOf
        {
            let sized this.plan_type#(s.type)
            var size: size_t Planner.get_primitive_alignment(sized.name)
            let c_ref this.lookup_concept(sized.name)
            guard c_ref <> null
            {
                let c (*c_ref)
                choose c.definition
                    when st: Structure
                    {
                        var offset: size_t 0
                        var max_align: size_t 1
                        var pi: size_t 0
                        while pi < st.properties.length
                        {
                            let p_ptr st.properties.get(pi)
                            guard p_ptr <> null
                            {
                                let p (*p_ptr)
                                guard p.type <> null
                                {
                                    let pt (*p.type)
                                    guard pt.name.length > 0
                                    {
                                        let last_ptr pt.name.get(pt.name.length - 1)
                                        guard last_ptr <> null
                                        {
                                            let prop_name (*last_ptr)
                                            var fld_size: size_t Planner.get_primitive_alignment(prop_name)
                                            var fld_align: size_t fld_size
                                            guard prop_name.equals(String$("Vector"))
                                            {
                                                set fld_size: 16
                                                set fld_align: 8
                                            }
                                            guard prop_name.equals(String$("Array"))
                                            {
                                                set fld_size: 16
                                                set fld_align: 8
                                            }
                                            guard prop_name.equals(String$("String"))
                                            {
                                                set fld_size: 8
                                                set fld_align: 8
                                            }
                                            guard prop_name.equals(String$("HashMap"))
                                            {
                                                set fld_size: 8
                                                set fld_align: 8
                                            }
                                            guard prop_name.equals(String$("HashSet"))
                                            {
                                                set fld_size: 8
                                                set fld_align: 8
                                            }
                                            set offset: Planner.align_offset(offset, fld_align) + fld_size
                                            guard fld_align > max_align
                                                set max_align: fld_align
                                        }
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                        let total Planner.align_offset(offset, max_align)
                        guard total > 0
                            set size: total
                    }
                    else
                    {
                        0
                    }
            }
            PlannedSizeOf(s.span, sized, size)
        }

        ; plan_is: Is(name) is a runtime variant-tag test. At this site
        ; we resolve the test type and (best-effort) the union_name; the
        ; `variant_tag` and `value` fields get stitched in at the
        ; operand-sequence collapse site, which has the value operand.
        function plan_is#(rp, this: Planner, i: Is) returns PlannedIs
        {
            ; `x is null` — single-segment "null" name. Skip type
            ; resolution; the emitter compares the pointer to zero.
            guard i.name.length = 1
            {
                let first_ptr i.name.get(0)
                guard first_ptr <> null
                {
                    guard (*first_ptr).equals(String$("null"))
                        return PlannedIs(
                            i.span,
                            Planner.make_void_type#(),
                            0,
                            String^rp(""),
                            null,
                            true
                        )
                }
            }

            ; Resolve the dotted path as a Type so nested variant names
            ; like Option.Some pick up the full planned type. The
            ; variant_tag itself is filled in by the call site that
            ; pairs a PlannedIs with its value operand (needs the
            ; operand's union type, which plan_is doesn't see).
            let ty_path Vector[String]^rp(i.name)
            let ty Type(i.span, ty_path, null, Lifetime.Unspecified(Unspecified()))
            let test_type this.plan_type#(ty)
            let union_name Planner.join_dotted_name#(i.name)

            PlannedIs(
                i.span,
                test_type,
                0,
                union_name,
                null,
                false
            )
        }

        ; plan_as: `x as TargetType` — explicit cast. Resolves the
        ; target type; the value operand is stitched in at the use site
        ; (typically during collapse, like PlannedIs).
        function plan_as#(rp, this: Planner, a: scaly.compiler.Model.As) returns PlannedAs
        {
            let target this.plan_type#(a.target_type)
            PlannedAs(a.span, target, null)
        }

        ; plan_alignof: alignof(Type) → size_t. Mirrors plan_sizeof.
        ; s106: take the alignment from get_primitive_alignment instead
        ; of hardcoding 0. Without this, every `alignof T` lowers to a
        ; literal 0 — observed first as init_lifetime's
        ; `page.allocate(sizeof int, alignof int)` passing align=0.
        function plan_alignof#(
            rp,
            this: Planner,
            a: scaly.compiler.Model.AlignOf
        ) returns PlannedAlignOf
        {
            let planned this.plan_type#(a.type)
            let align Planner.get_primitive_alignment(planned.name)
            PlannedAlignOf(a.span, planned, align)
        }

        ; plan_type_operand: a Model.Type used as an operand can mean
        ; different things depending on whether the name resolves to:
        ;   - a local variable in scope → PlannedVariable with its type
        ;   - a top-level function name → keep as Type, result is a
        ;     function reference (return-type filled in later during
        ;     call resolution)
        ;   - an actual type name → PlannedExpression.Type with the
        ;     planned type
        function plan_type_operand#(rp, this: Planner, t: Type, loc: Span) returns PlannedOperand
        {
            ; Single-name references are candidates for local-variable
            ; resolution. Dotted names always go to plan_type.
            guard t.name.length = 1
            {
                let n_ptr t.name.get(0)
                guard n_ptr <> null
                {
                    let name (*n_ptr)

                    ; Bare null/true/false at expression position parse as
                    ; Type names; rewrite them as Constant operands so the
                    ; emitter sees the right shape. Mirrors
                    ; Planner.cpp:10148-10160.
                    guard name.equals(String$("null"))
                    {
                        let c Constant.Null(NullConstant(loc))
                        return this.plan_constant_operand#(c, loc)
                    }
                    guard name.equals(String$("true"))
                    {
                        let c Constant.Boolean(BooleanConstant(loc, true))
                        return this.plan_constant_operand#(c, loc)
                    }
                    guard name.equals(String$("false"))
                    {
                        let c Constant.Boolean(BooleanConstant(loc, false))
                        return this.plan_constant_operand#(c, loc)
                    }

                    ; Local variable lookup.
                    let local this.lookup_local_binding(name)
                    guard local <> null
                    {
                        let lb (*local)
                        return PlannedOperand(
                            loc,
                            PlannedExpression.Variable(PlannedVariable(
                                loc, name, lb.binding_type, lb.is_mutable
                            )),
                            null,
                            lb.binding_type
                        )
                    }

                    ; s88: sibling-global constant-fold. `define X: int K`
                    ; references like F_OK / SEEK_END must resolve to
                    ; their value or every caller silently drops the
                    ; whole statement (plan_type_operand# returning
                    ; PlannedExpression.Type → emit_call ignores it →
                    ; trailing `f(.., NAME) = K` becomes a no-op so the
                    ; function body emits only the default return).
                    ; Mirrors Planner.cpp:6950-6995. Single scalar
                    ; PlannedConstant inlines directly; non-constant or
                    ; multi-operand value falls back to PlannedGlobalRef.
                    let g_ref this.lookup_global(name)
                    guard g_ref <> null
                    {
                        let g (*g_ref)
                        guard g.value <> null
                        {
                            let val_vec (*g.value)
                            guard val_vec.length = 1
                            {
                                let v_ptr val_vec.get(0)
                                guard v_ptr <> null
                                {
                                    let v (*v_ptr)
                                    choose v.expr
                                        when c: scalyc.compiler.Plan.PlannedConstant
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Constant(c),
                                                null,
                                                g.global_type
                                            )
                                        else
                                        {
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.GlobalRef(PlannedGlobalRef(
                                                    loc,
                                                    g.name,
                                                    g.mangled_name,
                                                    g.global_type
                                                )),
                                                null,
                                                g.global_type
                                            )
                                        }
                                }
                            }
                        }
                        return PlannedOperand(
                            loc,
                            PlannedExpression.GlobalRef(PlannedGlobalRef(
                                loc,
                                g.name,
                                g.mangled_name,
                                g.global_type
                            )),
                            null,
                            g.global_type
                        )
                    }

                    ; Implicit property access: when `name` matches a
                    ; field on T and `this: pointer[T]` is in scope,
                    ; rewrite as Variable("this") + member_access [name].
                    ; Mirrors Planner.cpp:7055-7097. Strings used in the
                    ; returned operand must live on rp, not the local
                    ; page — otherwise their data is freed when the
                    ; function returns.
                    let this_ref this.lookup_local(String#("this"))
                    guard this_ref <> null
                    {
                        let this_ty (*this_ref)
                        guard this_ty.name.equals(String$("pointer"))
                        {
                            guard this_ty.generics <> null
                            {
                                let gens (*this_ty.generics)
                                guard gens.length > 0
                                {
                                    let inner_ptr gens.get(0)
                                    guard inner_ptr <> null
                                    {
                                        let inner (*inner_ptr)
                                        let prop_ref this.lookup_property(inner.name, name)
                                        guard prop_ref <> null
                                        {
                                            let prop (*prop_ref)
                                            var prop_type: PlannedType this.fresh_type_var#(String#(""))
                                            guard prop.type <> null
                                            {
                                                let pt2 (*prop.type)
                                                set prop_type: this.plan_type#(pt2)
                                            }
                                            let idx this.get_property_index(inner.name, name)
                                            var ma_arr Array[PlannedMemberAccess]^rp()
                                            ma_arr.add(PlannedMemberAccess(
                                                name, idx as size_t, false, false,
                                                inner, prop_type
                                            ))
                                            var ma_holder Vector[PlannedMemberAccess]^rp(ma_arr)
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, String#("this"), this_ty, false
                                                )),
                                                &ma_holder,
                                                prop_type
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; Multi-element name: if the first segment is a local binding,
            ; treat the rest as a member-access chain. Mirrors
            ; Planner.cpp:6805-6826. Skip when the chain contains any
            ; method hop — stage-1's call resolution doesn't yet wire
            ; instance method dispatch, and forcing this path would
            ; surface emit_call SEGVs on the receiver.
            guard t.name.length > 1
            {
                let first_ptr t.name.get(0)
                guard first_ptr <> null
                {
                    let first_name (*first_ptr)
                    let local this.lookup_local_binding(first_name)
                    guard local <> null
                    {
                        let lb (*local)
                        var rest_arr Array[String]$()
                        var k: size_t 1
                        while k < t.name.length
                        {
                            let seg_ptr t.name.get(k)
                            guard seg_ptr <> null
                                rest_arr.add((*seg_ptr))
                            set k: k + 1
                        }
                        var rest_vec Vector[String]^rp(rest_arr)
                        ; Auto-deref pointer[T] / ref[T]: use the inner
                        ; generic as the base for member resolution.
                        var base_for_chain lb.binding_type
                        guard lb.binding_type.name.equals(String$("pointer"))
                        {
                            guard lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                guard g.length > 0
                                {
                                    let ip g.get(0)
                                    guard ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        guard lb.binding_type.name.equals(String$("ref"))
                        {
                            guard lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                guard g.length > 0
                                {
                                    let ip g.get(0)
                                    guard ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        let access_chain this.resolve_member_access#(
                            base_for_chain, rest_vec
                        )
                        var has_method: bool false
                        var ci: size_t 0
                        while ci < access_chain.length
                        {
                            let mp access_chain.get(ci)
                            guard mp <> null
                            {
                                guard (*mp).is_method
                                    set has_method: true
                            }
                            set ci: ci + 1
                        }
                        guard has_method = false
                        {
                            var access_holder Vector[PlannedMemberAccess]^rp(access_chain)
                            var final_type lb.binding_type
                            guard access_chain.length > 0
                            {
                                let last_ptr access_chain.get(access_chain.length - 1)
                                guard last_ptr <> null
                                    set final_type: (*last_ptr).result_type
                            }
                            return PlannedOperand(
                                loc,
                                PlannedExpression.Variable(PlannedVariable(
                                    loc, first_name, lb.binding_type, lb.is_mutable
                                )),
                                &access_holder,
                                final_type
                            )
                        }
                    }

                    ; Implicit-this multi-segment fallback: when first_name
                    ; matches a property of T (where this: pointer[T]),
                    ; build a chain starting from `this` with all segments
                    ; resolved against T. Mirrors Planner.cpp:7055-7097 +
                    ; chain-building from 6805-6826. Skip when the chain
                    ; contains any method hop — same constraint as the
                    ; local-binding branch above.
                    let this_ref2 this.lookup_local(String#("this"))
                    guard this_ref2 <> null
                    {
                        let this_ty2 (*this_ref2)
                        guard this_ty2.name.equals(String$("pointer"))
                        {
                            guard this_ty2.generics <> null
                            {
                                let gens2 (*this_ty2.generics)
                                guard gens2.length > 0
                                {
                                    let inner_ptr2 gens2.get(0)
                                    guard inner_ptr2 <> null
                                    {
                                        let inner2 (*inner_ptr2)
                                        let prop_ref2 this.lookup_property(inner2.name, first_name)
                                        guard prop_ref2 <> null
                                        {
                                            var all_arr Array[String]$()
                                            var k2: size_t 0
                                            while k2 < t.name.length
                                            {
                                                let sp t.name.get(k2)
                                                guard sp <> null
                                                    all_arr.add((*sp))
                                                set k2: k2 + 1
                                            }
                                            var all_vec Vector[String]^rp(all_arr)
                                            let chain2 this.resolve_member_access#(inner2, all_vec)
                                            ; s87: skip removed (was `var has_method2 / while /
                                            ; guard has_method2 = false` wrapper preserved through
                                            ; s83-s86). With s87's emit_variable struct/ptr-alloca
                                            ; fix and s86's heap-copy in MemberAssignment, the
                                            ; method-on-chain dispatch now works at runtime.
                                            var holder2 Vector[PlannedMemberAccess]^rp(chain2)
                                            var ft2 inner2
                                            guard chain2.length > 0
                                            {
                                                let lp2 chain2.get(chain2.length - 1)
                                                guard lp2 <> null
                                                    set ft2: (*lp2).result_type
                                            }
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, String#("this"), this_ty2, false
                                                )),
                                                &holder2,
                                                ft2
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            let pt this.plan_type#(t)
            PlannedOperand(
                loc,
                PlannedExpression.Type(pt),
                null,
                pt
            )
        }

        ; ================================================================
        ; Control-flow planners.
        ; ================================================================

        ; statement_result_type: extract the PlannedType produced by a
        ; statement used as an expression. Covers the Action case (the
        ; common `if cond x else y` shape); non-value statements
        ; (Return/Throw/Break/Continue/Binding) return void.
        function statement_result_type(s: PlannedStatement) returns PlannedType
        {
            choose s
                when a: PlannedAction
                    a.result_type
                else
                    Planner.make_void_type#()
        }

        ; plan_if: plans the condition (a Vector[Operand]), the consequent
        ; statement, and optionally the alternative. Emits a bool
        ; constraint on the condition and (when an alternative exists)
        ; unifies the two branches' result types.
        function plan_if#(rp, this: Planner, f: If) returns PlannedIf
        {
            let planned_cond_flat this.plan_operands#(f.condition)
            let planned_cond_collapsed this.collapse_operand_sequence#(planned_cond_flat)
            let bool_ty Planner.make_bool_type#()
            this.add_equality_constraint(bool_ty, planned_cond_collapsed.result_type, f.span)

            let planned_consequent this.plan_statement#(f.consequent)
            var consequent_holder Vector[PlannedStatement]^rp(1)
            consequent_holder.put(0, planned_consequent)

            var alternative_ref: ref[PlannedStatement]? null
            guard f.alternative <> null
            {
                let alt (*f.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)

                ; Unify the consequent and alternative result types so an
                ; `if` used as an expression has a single type. Skips
                ; voids (pure statements contribute no constraint).
                let cons_ty Planner.statement_result_type(planned_consequent)
                let alt_ty Planner.statement_result_type(planned_alt)
                guard cons_ty.name.equals(String$("void")) = false
                    and alt_ty.name.equals(String$("void")) = false
                    this.add_equality_constraint(cons_ty, alt_ty, f.span)
            }

            var cond_holder Vector[PlannedOperand]^rp(1)
            cond_holder.put(0, planned_cond_collapsed)
            PlannedIf(
                f.span,
                &cond_holder,
                null,
                consequent_holder.get(0),
                alternative_ref
            )
        }

        ; plan_lambda: anonymous function literal. Opens a fresh scope,
        ; seeds each parameter with a fresh type variable (lambdas omit
        ; parameter type annotations), plans the body Action, and
        ; synthesizes a unique mangled name. Captures are the set of
        ; variable names referenced in the body that aren't lambda
        ; parameters — a best-effort over-approximation (inner bindings
        ; may leak in) that the emitter can intersect with the real
        ; outer scope.
        ; collect_free_names: walk a PlannedOperand's expression tree
        ; and accumulate the names of every PlannedVariable reference
        ; encountered. Recurses into Call args, Tuple components, and
        ; If/Match/Block/Choose sub-statements. Used by plan_lambda's
        ; capture-discovery pass — captures are this set minus any
        ; lambda-local names (params + inner bindings).
        function collect_free_names(
            this: Planner,
            op: PlannedOperand,
            acc: Array[String]
        )
        {
            choose op.expr
                when v: PlannedVariable
                    acc.add(v.name)
                when call: PlannedCall
                {
                    guard call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get(i)
                            guard a_ptr <> null
                                this.collect_free_names((*a_ptr), acc)
                            set i: i + 1
                        }
                    }
                    0
                }
                when tup: PlannedTuple
                {
                    guard tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get(i)
                            guard c_ptr <> null
                            {
                                let c (*c_ptr)
                                guard c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get(j)
                                        guard v_ptr <> null
                                            this.collect_free_names((*v_ptr), acc)
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0
        }

        function plan_lambda#(rp, this: Planner, lam: Lambda) returns PlannedLambda
        {
            this.push_scope()

            var planned_items Vector[PlannedItem]^rp(lam.input.length)
            var i: size_t 0
            while i < lam.input.length
            {
                let it_ptr lam.input.get(i)
                guard it_ptr <> null
                {
                    let it (*it_ptr)
                    let pi this.plan_item#(it)
                    planned_items.put(i, pi)

                    var param_type: PlannedType Planner.make_void_type#()
                    guard pi.item_type <> null
                        set param_type: (*pi.item_type)
                    guard pi.item_type = null
                    {
                        ; Lambda parameters omit type annotations; give
                        ; each a fresh type variable that the solver
                        ; later unifies against the call site.
                        var pname: String String$("")
                        guard it.name <> null
                            set pname: (*it.name)
                        set param_type: this.fresh_type_var#(pname)
                    }

                    guard it.name <> null
                    {
                        let n (*it.name)
                        this.define_local(n, param_type, false, false)
                    }
                }
                set i: i + 1
            }

            let planned_body this.plan_action#(lam.body)

            ; Capture discovery: walk the body operands collecting all
            ; variable-name references, then filter out names that match
            ; one of the lambda's own parameters. The remainder is the
            ; captures set (best-effort: inner bindings declared inside
            ; the body can leak in, but it's a safe over-approximation
            ; that the emitter can intersect with the real scope).
            var free_names Array[String]$()
            guard planned_body.source <> null
            {
                let src (*planned_body.source)
                var si: size_t 0
                while si < src.length
                {
                    let s_ptr src.get(si)
                    guard s_ptr <> null
                        this.collect_free_names((*s_ptr), free_names)
                    set si: si + 1
                }
            }

            var captures_arr Array[String]$()
            var fi: size_t 0
            while fi < free_names.length
            {
                let nm_ptr free_names.get(fi)
                guard nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    var is_param: bool false
                    var pj: size_t 0
                    while pj < lam.input.length
                    {
                        let p_ptr lam.input.get(pj)
                        guard p_ptr <> null
                        {
                            guard p_ptr.name <> null
                            {
                                let pn (*p_ptr.name)
                                guard pn.equals(nm)
                                    set is_param: true
                            }
                        }
                        set pj: pj + 1
                    }
                    var already: bool false
                    var di: size_t 0
                    while di < captures_arr.length
                    {
                        let d_ptr captures_arr.get(di)
                        guard d_ptr <> null
                        {
                            guard (*d_ptr).equals(nm)
                                set already: true
                        }
                        set di: di + 1
                    }
                    guard is_param = false and already = false
                        captures_arr.add(String^rp(nm))
                }
                set fi: fi + 1
            }

            this.pop_scope()

            let lam_id next_lambda_id
            set next_lambda_id: lam_id + 1
            var name_sb StringBuilder^rp()
            name_sb.append("_ZN6lambda")
            name_sb.append(Planner.size_to_string(lam_id))
            name_sb.append("Ev")
            let mangled name_sb.to_string^rp()

            var items_holder Vector[PlannedItem]^rp(planned_items)
            var captures_holder Vector[String]^rp(captures_arr)
            var captures_ref: ref[Vector[String]]? null
            guard captures_holder.length > 0
                set captures_ref: &captures_holder

            PlannedLambda(
                lam.span,
                mangled,
                &items_holder,
                planned_body,
                planned_body.result_type,
                captures_ref
            )
        }

        ; plan_repeat: do-while body runs at least once; the terminating
        ; condition lives inside the body action via `break` or an
        ; embedded if. Nothing else to constrain at this level.
        function plan_repeat#(rp, this: Planner, r: Repeat) returns PlannedRepeat
        {
            this.push_scope()
            let planned_body this.plan_action#(r.action)
            this.pop_scope()
            PlannedRepeat(r.span, planned_body)
        }

        ; plan_while: Binding condition + Action body. The binding opens
        ; a short-lived scope for the loop variable. Emits a constraint
        ; that the planned binding's type is bool (the solver promotes
        ; `while let maybe_x = ...` through Option's None sentinel, so
        ; this is a reasonable approximation today).
        function plan_while#(rp, this: Planner, w: While) returns PlannedWhile
        {
            this.push_scope()
            let planned_cond this.plan_binding#(w.condition)
            let planned_body this.plan_action#(w.action)
            this.pop_scope()

            ; Two shapes reach this point:
            ;   `while cond`          — binding has no name; we constrain
            ;                           its declared type to bool.
            ;   `while let x = opt`   — binding has a name; x takes the
            ;                           Option's Some payload. If the
            ;                           operation's result type is
            ;                           Option[T] we constrain x to T, so
            ;                           the solver sees the unwrapped
            ;                           type.
            let bool_ty Planner.make_bool_type#()
            guard planned_cond.binding_item.name = null
            {
                ; Plain `while cond` — bool constraint applies if the
                ; binding's item_type is explicit.
                guard planned_cond.binding_item.item_type <> null
                {
                    let bt (*planned_cond.binding_item.item_type)
                    this.add_equality_constraint(bool_ty, bt, w.span)
                }
            }
            guard planned_cond.binding_item.name <> null
            {
                guard planned_cond.binding_item.item_type <> null
                {
                    guard planned_cond.operation <> null
                    {
                        let ops (*planned_cond.operation)
                        guard ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            guard last_ptr <> null
                            {
                                let op_ty (*last_ptr).result_type
                                guard op_ty.name.equals(String$("Option"))
                                {
                                    guard op_ty.generics <> null
                                    {
                                        let gens (*op_ty.generics)
                                        guard gens.length > 0
                                        {
                                            let payload_ptr gens.get(0)
                                            guard payload_ptr <> null
                                            {
                                                let bt (*planned_cond.binding_item.item_type)
                                                this.add_equality_constraint(
                                                    bt, (*payload_ptr), w.span
                                                )
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            PlannedWhile(w.span, planned_cond, planned_body)
        }

        ; plan_for: loop variable bound to each element of `expression`.
        ; Two shapes are supported, matching the C++ Planner:
        ;   1. Integer range: `for i in N` — element type == N's type.
        ;   2. Iterator protocol: `for x in collection` — resolve
        ;      `get_iterator` on the collection type, then `next` on the
        ;      iterator type; the element type is what `next` returns.
        ; Option[T] and ref/pointer wrappers on the collection type are
        ; peeled before the dispatch.
        function plan_for#(rp, this: Planner, f: For) returns PlannedFor
        {
            this.push_scope()
            let planned_expr this.plan_operands#(f.expression)
            let collapsed_expr this.collapse_operand_sequence#(planned_expr)

            var coll_type: PlannedType collapsed_expr.result_type

            ; Auto-unwrap Option[T] → T on the collection side.
            guard coll_type.name.equals(String$("Option"))
            {
                guard coll_type.generics <> null
                {
                    let gens (*coll_type.generics)
                    guard gens.length > 0
                    {
                        let g_ptr gens.get(0)
                        guard g_ptr <> null
                            set coll_type: (*g_ptr)
                    }
                }
            }

            ; Peel ref[T] / pointer[T] to reach the underlying struct.
            ; Stage-1 multi-line `or` chains in a guard condition do not
            ; short-circuit correctly (the LF continuation surfaces `set`
            ; as a top-level statement). Mirror the C++ Planner using
            ; per-name guards.
            var iter_type: PlannedType coll_type
            var is_pointer_like: bool false
            guard iter_type.name.equals(String$("ref"))
                set is_pointer_like: true
            guard iter_type.name.equals(String$("pointer"))
                set is_pointer_like: true
            guard is_pointer_like
            {
                guard iter_type.generics <> null
                {
                    let gens (*iter_type.generics)
                    guard gens.length > 0
                    {
                        let g_ptr gens.get(0)
                        guard g_ptr <> null
                            set iter_type: (*g_ptr)
                    }
                }
            }

            ; Stage-1 multi-line `or` chains do not short-circuit (LF
            ; continuation surfaces `set` as a top-level statement, which
            ; runs unconditionally). Use per-name guards so each one
            ; matches its own primitive name.
            var is_integer: bool false
            guard iter_type.name.equals(String$("int"))
                set is_integer: true
            guard iter_type.name.equals(String$("int8"))
                set is_integer: true
            guard iter_type.name.equals(String$("int16"))
                set is_integer: true
            guard iter_type.name.equals(String$("int32"))
                set is_integer: true
            guard iter_type.name.equals(String$("int64"))
                set is_integer: true
            guard iter_type.name.equals(String$("size_t"))
                set is_integer: true
            guard iter_type.name.equals(String$("uint8"))
                set is_integer: true
            guard iter_type.name.equals(String$("uint16"))
                set is_integer: true
            guard iter_type.name.equals(String$("uint32"))
                set is_integer: true
            guard iter_type.name.equals(String$("uint64"))
                set is_integer: true

            var is_iterator_loop: bool false
            var iterator_type: PlannedType Planner.make_void_type#()
            var element_type: PlannedType Planner.make_void_type#()
            var get_iter_name: String String^rp("")
            var next_name: String String^rp("")

            guard is_integer
            {
                set element_type: iter_type
            }
            guard is_integer = false
            {
                let get_iter_match this.lookup_method#(iter_type, String$("get_iterator"))
                guard get_iter_match <> null
                {
                    let gm (*get_iter_match)
                    set is_iterator_loop: true
                    set iterator_type: gm.return_type
                    set get_iter_name: gm.mangled_name

                    let next_match this.lookup_method#(iterator_type, String$("next"))
                    guard next_match <> null
                    {
                        let nm (*next_match)
                        set next_name: nm.mangled_name
                        set element_type: nm.return_type
                    }
                }
                guard get_iter_match = null
                {
                    ; No get_iterator: fall back to the iterable's first
                    ; generic (what Vec[T] / List[T] would yield), or
                    ; the iter_type itself if no generics.
                    var fell_back: bool false
                    guard iter_type.generics <> null
                    {
                        let gens (*iter_type.generics)
                        guard gens.length > 0
                        {
                            let g_ptr gens.get(0)
                            guard g_ptr <> null
                            {
                                set element_type: (*g_ptr)
                                set fell_back: true
                            }
                        }
                    }
                    guard fell_back = false
                        set element_type: iter_type
                }
            }

            this.define_local(f.identifier, element_type, false, false)

            let planned_body this.plan_action#(f.action)
            this.pop_scope()

            var expr_holder Vector[PlannedOperand]^rp(planned_expr)
            PlannedFor(
                f.span,
                f.identifier,
                &expr_holder,
                planned_body,
                is_iterator_loop,
                coll_type,
                iterator_type,
                element_type,
                get_iter_name,
                next_name
            )
        }

        ; plan_try: try { binding } catch WhenPatterns else alt.
        function plan_try#(rp, this: Planner, t: Try) returns PlannedTry
        {
            this.push_scope()
            let planned_bind this.plan_binding#(t.binding)

            ; The exception union for catches is the result type of the
            ; binding's last (call) operand — the call's throws_ flows
            ; back into the operand's result_type at resolve time (C++
            ; reference: planTry uses Operation[0].ResultType). When the
            ; binding has no operands we fall back to void so plan_when
            ; uses fresh type vars.
            var exc_union_type: PlannedType Planner.make_void_type#()
            guard planned_bind.operation <> null
            {
                let ops (*planned_bind.operation)
                guard ops.length > 0
                {
                    let last_ptr ops.get(ops.length - 1)
                    guard last_ptr <> null
                        set exc_union_type: (*last_ptr).result_type
                }
            }

            var catches_arr Array[PlannedWhen]$()
            var ci: size_t 0
            while ci < t.catches.length
            {
                let w_ptr t.catches.get(ci)
                guard w_ptr <> null
                {
                    let w (*w_ptr)
                    catches_arr.add(this.plan_when#(w, exc_union_type, false))
                }
                set ci: ci + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            guard t.alternative <> null
            {
                let alt (*t.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }
            this.pop_scope()

            var catches_holder Vector[PlannedWhen]^rp(catches_arr)
            PlannedTry(t.span, planned_bind, &catches_holder, alternative_ref)
        }

        ; plan_when: one pattern arm of choose/try. When `union_type` is
        ; non-null and names a registered union concept, the variant's
        ; payload type and tag index are resolved so the Emitter can
        ; extract the payload and compare tags correctly. When union_type
        ; is void (the fallback from plan_try with no exception type),
        ; the arm still plans but variant_type stays void and tag stays 0.
        function plan_when#(
            rp,
            this: Planner,
            w: When,
            union_type: PlannedType,
            is_throws_call: bool
        ) returns PlannedWhen
        {
            this.push_scope()

            ; Resolve the variant's payload type and tag against the
            ; enclosing union. `w.name` is the binding identifier
            ; (e.g. `s` in `when s: Some`); the variant *type* name
            ; lives in `w.variant` (last segment for dotted paths).
            ; Fall back to a fresh type variable when the union isn't
            ; resolvable (e.g. when called from plan_try before
            ; exception types land).
            var binding_ty: PlannedType this.fresh_type_var#(String$(""))
            var variant_type: PlannedType Planner.make_void_type#()
            var variant_tag: size_t 0

            var variant_name: String String^rp("")
            guard w.variant.length > 0
            {
                let last_ptr w.variant.get(w.variant.length - 1)
                guard last_ptr <> null
                    set variant_name: (*last_ptr)
            }

            guard union_type.name.equals("void") = false
            {
                let payload_ref this.lookup_variant_type#(
                    union_type.name, variant_name
                )
                guard payload_ref <> null
                {
                    set binding_ty: (*payload_ref)
                    set variant_type: (*payload_ref)
                }
                let tag this.lookup_variant_tag(union_type.name, variant_name)
                guard tag >= 0
                    set variant_tag: tag as size_t
            }

            ; s143: throws-call synthetic Error/Success variant assignment.
            ; Mirrors stage-0 Planner.cpp:11363-11382. When the surrounding
            ; choose's condition is a throwing call AND the union lookup
            ; failed (variant_type still void), recognise the synthetic
            ; "Error"/"err"/"error" and "Success"/"Ok"/"ok"/"value"/"node"
            ; case names and assign variant_index 1 / 0 respectively.
            ; Without this, emit_choose's seen_tags dedup collapses both
            ; cases on variant_index=0, the second case body gets dropped,
            ; and the s142 default-redirect picks whichever arm comes first
            ; in source order — so cli.run's `choose parse_program#() when
            ; err: Error / when program: Success` always takes the err arm
            ; on hello.scaly and prints "Parse error" even when parsing
            ; succeeds. Distinct variant_indices unblock the natural
            ; first-byte-of-sret-slot dispatch: parse_X#'s emit_return
            ; stores the struct (start.size_t low byte = 0 for hello.scaly
            ; → Success arm); emit_throw stores tag=1 at offset 0 → Error
            ; arm. Result union wrapping is the proper fix (1-2 day
            ; refactor) but isn't required for hello.scaly's narrow path.
            guard variant_type.name.equals("void")
            {
                guard is_throws_call
                {
                    let is_error variant_name.equals(String$("Error"))
                    var is_err: bool is_error
                    guard is_err = false
                        set is_err: variant_name.equals(String$("err"))
                    guard is_err = false
                        set is_err: variant_name.equals(String$("error"))
                    guard is_err
                        set variant_tag: 1
                    guard is_err = false
                    {
                        let is_success variant_name.equals(String$("Success"))
                        var is_ok: bool is_success
                        guard is_ok = false
                            set is_ok: variant_name.equals(String$("Ok"))
                        guard is_ok = false
                            set is_ok: variant_name.equals(String$("ok"))
                        guard is_ok = false
                            set is_ok: variant_name.equals(String$("value"))
                        guard is_ok = false
                            set is_ok: variant_name.equals(String$("node"))
                        guard is_ok
                            set variant_tag: 0
                    }
                }
            }

            this.define_local(w.name, binding_ty, false, false)

            let planned_cons this.plan_statement#(w.consequent)
            this.pop_scope()

            var cons_holder Vector[PlannedStatement]^rp(1)
            cons_holder.put(0, planned_cons)
            PlannedWhen(
                w.span,
                w.name,
                variant_type,
                variant_tag,
                cons_holder.get(0)
            )
        }

        ; plan_choose: Scaly's choose/when pattern match.
        function plan_choose#(rp, this: Planner, c: Choose) returns PlannedChoose
        {
            let planned_cond this.plan_operands#(c.condition)
            ; Fold the choose condition down to a single value to
            ; recover its type — that's the union each `when` pattern
            ; selects a variant of.
            let collapsed_cond this.collapse_operand_sequence#(planned_cond)
            let union_type collapsed_cond.result_type

            ; s143: detect a throws-call as the choose condition. plan_when#
            ; needs this so it can assign distinct variant_index to the
            ; synthetic "Error" / "Success" arms, otherwise both collide on
            ; variant_index=0 and emit_choose's seen_tags dedup drops the
            ; second arm. See plan_when# comment for the full rationale.
            var is_throws_call: bool false
            choose collapsed_cond.expr
                when call: Call
                    set is_throws_call: call.can_throw
                else
                    0

            var cases_arr Array[PlannedWhen]$()
            var i: size_t 0
            while i < c.cases.length
            {
                let w_ptr c.cases.get(i)
                guard w_ptr <> null
                {
                    let w (*w_ptr)
                    cases_arr.add(this.plan_when#(w, union_type, is_throws_call))
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            guard c.alternative <> null
            {
                let alt (*c.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }

            ; Unify each when-arm's consequent result type (plus the
            ; optional alternative) so choose-as-expression has a single
            ; type. Voids are skipped — statement-only arms contribute
            ; no constraint.
            guard cases_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type#()
                var have_first: bool false
                var wi: size_t 0
                while wi < cases_arr.length
                {
                    let w_ptr cases_arr.get(wi)
                    guard w_ptr <> null
                    {
                        let pw (*w_ptr)
                        guard pw.consequent <> null
                        {
                            let cons_ref (*pw.consequent)
                            let arm_ty Planner.statement_result_type(cons_ref)
                            guard arm_ty.name.equals(String$("void")) = false
                            {
                                guard have_first = false
                                {
                                    set first_ty: arm_ty
                                    set have_first: true
                                }
                                guard have_first
                                    this.add_equality_constraint(
                                        first_ty, arm_ty, pw.loc
                                    )
                            }
                        }
                    }
                    set wi: wi + 1
                }
                guard alternative_ref <> null
                {
                    guard have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        guard alt_ty.name.equals(String$("void")) = false
                            this.add_equality_constraint(first_ty, alt_ty, c.span)
                    }
                }
            }

            ; Store the COLLAPSED single operand, not the flat list.
            ; emit_operands only emits the first operand (assuming
            ; callers have already collapsed); storing the flat
            ; `[get_color, ()]` would emit only `get_color` and miss
            ; the call. plan_if has this same shape (~line 5096).
            var cond_holder Vector[PlannedOperand]^rp(1)
            cond_holder.put(0, collapsed_cond)
            var cases_holder Vector[PlannedWhen]^rp(cases_arr)
            PlannedChoose(c.span, &cond_holder, &cases_holder, alternative_ref)
        }

        ; plan_case / plan_branch / plan_match: the full match-expression form.
        function plan_case#(rp, this: Planner, cs: Case) returns PlannedCase
        {
            let planned_cond this.plan_operands#(cs.condition)
            var cond_holder Vector[PlannedOperand]^rp(planned_cond)
            PlannedCase(cs.span, &cond_holder)
        }

        function plan_branch#(rp, this: Planner, b: Branch) returns PlannedBranch
        {
            var cases_arr Array[PlannedCase]$()
            var i: size_t 0
            while i < b.cases.length
            {
                let cs_ptr b.cases.get(i)
                guard cs_ptr <> null
                {
                    let cs (*cs_ptr)
                    cases_arr.add(this.plan_case#(cs))
                }
                set i: i + 1
            }

            let planned_cons this.plan_statement#(b.consequent)
            var cons_holder Vector[PlannedStatement]^rp(1)
            cons_holder.put(0, planned_cons)

            var cases_holder Vector[PlannedCase]^rp(cases_arr)
            PlannedBranch(b.span, &cases_holder, cons_holder.get(0))
        }

        function plan_match#(rp, this: Planner, m: Match) returns PlannedMatch
        {
            let planned_cond this.plan_operands#(m.condition)
            ; Fold the match condition so its result_type is
            ; comparable against each case's collapsed condition type.
            let collapsed_cond this.collapse_operand_sequence#(planned_cond)
            let cond_type collapsed_cond.result_type

            var branches_arr Array[PlannedBranch]$()
            var i: size_t 0
            while i < m.branches.length
            {
                let b_ptr m.branches.get(i)
                guard b_ptr <> null
                {
                    let b (*b_ptr)
                    let planned_branch this.plan_branch#(b)

                    ; Each case's condition must be the same type as the
                    ; match condition. Emit an equality constraint so
                    ; the HM solver rejects mismatches.
                    guard planned_branch.cases <> null
                    {
                        let cases (*planned_branch.cases)
                        var ci: size_t 0
                        while ci < cases.length
                        {
                            let case_ptr cases.get(ci)
                            guard case_ptr <> null
                            {
                                let case_cond (*case_ptr)
                                guard case_cond.condition <> null
                                {
                                    let cond_list (*case_cond.condition)
                                    let collapsed_case this.collapse_operand_sequence#(cond_list)
                                    this.add_equality_constraint(
                                        cond_type,
                                        collapsed_case.result_type,
                                        case_cond.loc
                                    )
                                }
                            }
                            set ci: ci + 1
                        }
                    }

                    branches_arr.add(planned_branch)
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            guard m.alternative <> null
            {
                let alt (*m.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }

            ; Unify all branch consequent result types (and the
            ; alternative when present) so the match-as-expression has
            ; a single type. Voids are skipped — pure-statement
            ; branches contribute no constraint.
            guard branches_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type#()
                var have_first: bool false
                var bi: size_t 0
                while bi < branches_arr.length
                {
                    let br_ptr branches_arr.get(bi)
                    guard br_ptr <> null
                    {
                        let br (*br_ptr)
                        guard br.consequent <> null
                        {
                            let cons (*br.consequent)
                            let br_ty Planner.statement_result_type(cons)
                            guard br_ty.name.equals(String$("void")) = false
                            {
                                guard have_first = false
                                {
                                    set first_ty: br_ty
                                    set have_first: true
                                }
                                guard have_first
                                    this.add_equality_constraint(
                                        first_ty, br_ty, br.loc
                                    )
                            }
                        }
                    }
                    set bi: bi + 1
                }
                guard alternative_ref <> null
                {
                    guard have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        guard alt_ty.name.equals(String$("void")) = false
                            this.add_equality_constraint(first_ty, alt_ty, m.span)
                    }
                }
            }

            var cond_holder Vector[PlannedOperand]^rp(planned_cond)
            var branches_holder Vector[PlannedBranch]^rp(branches_arr)
            PlannedMatch(m.span, &cond_holder, &branches_holder, alternative_ref)
        }

        ; ================================================================
        ; Tuples and matrices.
        ; ================================================================

        ; plan_component: Model.Component → PlannedComponent.
        ; Mirrors Planner.cpp:10499-10512 — each component's operand
        ; sequence is collapsed so prefix ops like `*p` and method-call
        ; arguments resolve against the collapsed result rather than the
        ; raw operand sequence. emit_tuple's grouping shortcut emits
        ; comp.value[0], so without this collapse `(*p).field` would
        ; emit only the leading `Type("*")` operand and produce null.
        function plan_component#(rp, this: Planner, c: Component) returns PlannedComponent
        {
            let planned_value this.plan_operands#(c.value)
            var name_ref: ref[String]? null
            guard c.name <> null
            {
                let n (*c.name)
                var holder Vector[String]^rp(1)
                holder.put(0, String^rp(n))
                set name_ref: holder.get(0)
            }
            ; Collapse when the operand sequence either starts with a
            ; prefix operator (`*p`, `-x`, `!flag`, ...) or contains a
            ; postfix `as`/`is` operand (`x as T`, `y is V`). emit_tuple's
            ; grouping shortcut emits comp.value[0]; without collapse,
            ; `(*p).field` would emit only the leading `Type("*")`
            ; operand and `f(x as T)` would surface as two args to f
            ; (`extract_tuple_arg_types` reads each operand's
            ; result_type), failing arity match. Other shapes are left
            ; untouched — running them through collapse_operand_sequence#
            ; adds String allocations that surface a latent
            ; dangling-String bug in resolve_function_call when stage-1
            ; self-compiles.
            var should_collapse: bool false
            guard planned_value.length > 1
            {
                let f0_ptr planned_value.get(0)
                guard f0_ptr <> null
                {
                    let f0 (*f0_ptr)
                    choose f0.expr
                        when ty: PlannedType
                        {
                            guard Planner.is_operator_name(ty.name)
                                set should_collapse: true
                        }
                        else
                            0
                }
                guard should_collapse = false
                {
                    var k: size_t 1
                    while k < planned_value.length
                    {
                        let op_ptr planned_value.get(k)
                        guard op_ptr <> null
                        {
                            let op (*op_ptr)
                            choose op.expr
                                when a: PlannedAs
                                    set should_collapse: true
                                when i: PlannedIs
                                    set should_collapse: true
                                when ty: PlannedType
                                {
                                    ; s90: binary operator at k>=1 (e.g.
                                    ; `x = y`, `a + b`, `p <> null`) means
                                    ; the operand sequence must collapse to
                                    ; a single PlannedCall. Without this,
                                    ; tuple components carrying a binary
                                    ; comparison as a function arg leave
                                    ; planned_value as a 3-operand sequence,
                                    ; emit_tuple's per-component arg path
                                    ; only sees the first operand, the call
                                    ; arity-mismatches, returns null, and
                                    ; the entire `let X = f(...arg-with-cmp...)`
                                    ; binding plus its `guard X = false`
                                    ; follower silently drop. Mirrors stage-
                                    ; 0's planTuple at Planner.cpp:10506-10511
                                    ; (unconditional collapse on every
                                    ; component value).
                                    guard Planner.is_operator_name(ty.name)
                                        set should_collapse: true
                                }
                                else
                                    0
                        }
                        set k: k + 1
                    }
                }
            }
            var value_holder Vector[PlannedOperand]^rp(planned_value)
            guard should_collapse
            {
                let collapsed this.collapse_operand_sequence#(planned_value)
                var collapsed_arr Array[PlannedOperand]^rp()
                collapsed_arr.add(collapsed)
                set value_holder: Vector[PlannedOperand]^rp(collapsed_arr)
            }
            PlannedComponent(c.span, name_ref, &value_holder, null)
        }

        function plan_tuple#(rp, this: Planner, t: Tuple) returns PlannedTuple
        {
            var comps_arr Array[PlannedComponent]$()
            var i: size_t 0
            while i < t.components.length
            {
                let c_ptr t.components.get(i)
                guard c_ptr <> null
                {
                    let c (*c_ptr)
                    comps_arr.add(this.plan_component#(c))
                }
                set i: i + 1
            }

            ; Single anonymous component = grouping parens. Lift the
            ; component's collapsed result_type into tuple_type so callers
            ; that consume the tuple as a value (resolve_member_access on
            ; `(*p).field`, ...) see the inner expression's type instead of
            ; `void`. Mirrors Planner.cpp:10497-10501. Multi-component
            ; tuples and named components keep tuple_type=void to avoid
            ; disturbing the struct-construction and function-argument
            ; paths.
            var tuple_ty: PlannedType Planner.make_void_type#()
            guard comps_arr.length = 1
            {
                let only_ptr_initial comps_arr.get(0)
                guard only_ptr_initial <> null
                {
                    let only_initial (*only_ptr_initial)
                    guard only_initial.name = null
                    {
                        guard only_initial.value <> null
                        {
                            let vals_initial (*only_initial.value)
                            guard vals_initial.length > 0
                            {
                                let collapsed this.collapse_operand_sequence#(vals_initial)
                                set tuple_ty: collapsed.result_type
                            }
                        }
                    }
                }
            }

            var comps_holder Vector[PlannedComponent]^rp(comps_arr)
            PlannedTuple(
                t.span,
                &comps_holder,
                tuple_ty,
                false,
                Lifetime.Unspecified(Unspecified()),
                null
            )
        }

        function plan_matrix#(rp, this: Planner, m: Matrix) returns scalyc.compiler.Plan.PlannedMatrix
        {
            var rows_arr Array[Vector[PlannedOperand]]$()
            var i: size_t 0
            while i < m.operations.length
            {
                let row_ptr m.operations.get(i)
                guard row_ptr <> null
                {
                    let row (*row_ptr)
                    let planned_row this.plan_operands#(row)
                    rows_arr.add(planned_row)
                }
                set i: i + 1
            }

            var rows_holder Vector[Vector[PlannedOperand]]^rp(rows_arr)
            scalyc.compiler.Plan.PlannedMatrix(
                m.span,
                &rows_holder,
                Planner.make_void_type#(),
                m.life
            )
        }

        ; plan_new: `new Foo(args)` — object construction. The mangled
        ; initializer and resolved struct type depend on the concept
        ; table, so we plan the type skeleton and arguments and leave
        ; the call layout for later resolution. For now we model it as
        ; a PlannedTuple carrying the argument list and the planned type.
        function plan_new#(rp, this: Planner, n: New) returns PlannedTuple
        {
            let planned_ty this.plan_type#(n.type)
            let planned_args this.plan_tuple#(n.arguments)

            ; Verify the target type has a matching initializer. A New
            ; with no matching init is a hard error — record it so the
            ; emitter doesn't silently produce an empty struct value.
            var arg_types_arr Array[PlannedType]$()
            guard planned_args.components <> null
            {
                let comps (*planned_args.components)
                var ci: size_t 0
                while ci < comps.length
                {
                    let c_ptr comps.get(ci)
                    guard c_ptr <> null
                    {
                        let c (*c_ptr)
                        guard c.value <> null
                        {
                            let vops (*c.value)
                            guard vops.length > 0
                            {
                                let last_ptr vops.get(vops.length - 1)
                                guard last_ptr <> null
                                    arg_types_arr.add((*last_ptr).result_type)
                            }
                        }
                    }
                    set ci: ci + 1
                }
            }
            var arg_types_vec Vector[PlannedType]^rp(arg_types_arr)
            let init_ref this.find_initializer#(planned_ty.name, arg_types_vec)
            guard init_ref = null
            {
                var sb StringBuilder$()
                sb.append("no matching initializer for `new ")
                sb.append(planned_ty.name)
                sb.append("`")
                this.add_error(sb.to_string^rp())
            }

            PlannedTuple(
                n.span,
                planned_args.components,
                planned_ty,
                true,
                planned_ty.life,
                null
            )
        }

        ; ================================================================
        ; plan_operand: dispatch by Expression variant, then wrap with
        ; any member-access chain declared on the operand.
        ; ================================================================
        function plan_operand#(rp, this: Planner, op: scalyc.compiler.Model.Operand) returns PlannedOperand
        {
            let base choose op.expression
                when c: Constant
                    this.plan_constant_operand#(c, op.span)
                when ty: Type
                    this.plan_type_operand#(ty, op.span)
                when tp: Tuple
                {
                    let pt this.plan_tuple#(tp)
                    PlannedOperand(op.span, PlannedExpression.Tuple(pt), null, pt.tuple_type)
                }
                when mx: Matrix
                {
                    let pm this.plan_matrix#(mx)
                    PlannedOperand(op.span, PlannedExpression.Matrix(pm), null, pm.element_type)
                }
                when bk: Block
                {
                    let pb this.plan_block#(bk)
                    ; Block-as-expression takes its type from the last
                    ; statement (typically an Action whose source is the
                    ; trailing expression). Empty blocks remain void.
                    var block_type: PlannedType Planner.make_void_type#()
                    guard pb.statements <> null
                    {
                        let stmts (*pb.statements)
                        guard stmts.length > 0
                        {
                            let last_ptr stmts.get(stmts.length - 1)
                            guard last_ptr <> null
                                set block_type: Planner.statement_result_type((*last_ptr))
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Block(pb), null, block_type)
                }
                when ife: If
                {
                    let pi this.plan_if#(ife)
                    ; Result type is the consequent's — branch unification
                    ; already equated it with the alternative via the
                    ; solver.
                    var if_type: PlannedType Planner.make_void_type#()
                    guard pi.consequent <> null
                    {
                        let cons (*pi.consequent)
                        set if_type: Planner.statement_result_type(cons)
                    }
                    PlannedOperand(op.span, PlannedExpression.If(pi), null, if_type)
                }
                when mt: Match
                {
                    let pm this.plan_match#(mt)
                    var match_type: PlannedType Planner.make_void_type#()
                    guard pm.branches <> null
                    {
                        let brs (*pm.branches)
                        guard brs.length > 0
                        {
                            let first_br_ptr brs.get(0)
                            guard first_br_ptr <> null
                            {
                                let first_br (*first_br_ptr)
                                guard first_br.consequent <> null
                                    set match_type: Planner.statement_result_type(
                                        (*first_br.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Match(pm), null, match_type)
                }
                when ch: Choose
                {
                    let pc this.plan_choose#(ch)
                    var choose_type: PlannedType Planner.make_void_type#()
                    guard pc.cases <> null
                    {
                        let cases (*pc.cases)
                        guard cases.length > 0
                        {
                            let first_ptr cases.get(0)
                            guard first_ptr <> null
                            {
                                let first_case (*first_ptr)
                                guard first_case.consequent <> null
                                    set choose_type: Planner.statement_result_type(
                                        (*first_case.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Choose(pc), null, choose_type)
                }
                when fr: For
                {
                    let pf this.plan_for#(fr)
                    PlannedOperand(op.span, PlannedExpression.For(pf), null, Planner.make_void_type#())
                }
                when wh: While
                {
                    let pw this.plan_while#(wh)
                    PlannedOperand(op.span, PlannedExpression.While(pw), null, Planner.make_void_type#())
                }
                when tr: Try
                {
                    let pt this.plan_try#(tr)
                    ; Try-as-expression takes the happy-path value's
                    ; type — that's the binding's operation result.
                    var try_type: PlannedType Planner.make_void_type#()
                    guard pt.cond.operation <> null
                    {
                        let ops (*pt.cond.operation)
                        guard ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            guard last_ptr <> null
                                set try_type: (*last_ptr).result_type
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Try(pt), null, try_type)
                }
                when so: SizeOf
                {
                    let ps this.plan_sizeof#(so)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.SizeOf(ps),
                        null,
                        Planner.make_size_type#()
                    )
                }
                when ao: scaly.compiler.Model.AlignOf
                {
                    let pa this.plan_alignof#(ao)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.AlignOf(pa),
                        null,
                        Planner.make_size_type#()
                    )
                }
                when isx: Is
                {
                    let pi this.plan_is#(isx)
                    PlannedOperand(op.span, PlannedExpression.Is(pi), null, Planner.make_bool_type#())
                }
                when asx: scaly.compiler.Model.As
                {
                    let pa this.plan_as#(asx)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.As(pa),
                        null,
                        pa.target_type
                    )
                }
                when nw: New
                {
                    let pt this.plan_new#(nw)
                    PlannedOperand(op.span, PlannedExpression.Tuple(pt), null, pt.tuple_type)
                }
                when lam: Lambda
                {
                    let pl this.plan_lambda#(lam)
                    PlannedOperand(op.span, PlannedExpression.Lambda(pl), null, pl.return_type)
                }
                when rep: Repeat
                {
                    let pr this.plan_repeat#(rep)
                    PlannedOperand(op.span, PlannedExpression.Repeat(pr), null, Planner.make_void_type#())
                }

            guard op.member_access = null
                return base

            let members (*op.member_access)
            let access_chain this.resolve_member_access#(base.result_type, members)
            var access_holder Vector[PlannedMemberAccess]^rp(access_chain)
            var final_type: PlannedType base.result_type
            guard access_chain.length > 0
            {
                let last_ptr access_chain.get(access_chain.length - 1)
                guard last_ptr <> null
                    set final_type: (*last_ptr).result_type
            }
            PlannedOperand(base.loc, base.expr, &access_holder, final_type)
        }

        ; plan_operands: batch plan_operand over a Vector.
        function plan_operands#(
            rp,
            this: Planner,
            ops: Vector[scalyc.compiler.Model.Operand]
        ) returns Vector[PlannedOperand]
        {
            var result Vector[PlannedOperand]^rp(ops.length)
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get(i)
                guard op_ptr <> null
                {
                    let op (*op_ptr)
                    let pl this.plan_operand#(op)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_binding: Model.Binding → Plan.PlannedBinding.
        ;
        ; Responsibilities:
        ;   1. Plan the initializer operands (by calling plan_operands).
        ;   2. Plan the binding's annotated item, which yields the
        ;      PlannedItem with an optional PlannedType.
        ;   3. Register the binding in the current scope so later uses
        ;      resolve by name.
        ;
        ; plan_binding now collapses the operation sequence. Stack-array
        ; type detection (`[T, N]` at binding site) and skip-leading-`=`
        ; folding are deferred.
        ; ================================================================
        function plan_binding#(rp, this: Planner, b: Binding) returns PlannedBinding
        {
            let planned_ops_flat this.plan_operands#(b.operation)
            let orig_item this.plan_item#(b.item)

            ; s135: support `var NAME TYPE INIT` (no colon). When the
            ; Modeler produces a Binding with no annotation but >=2
            ; operands AND the first is a bare PlannedType (not Matrix/
            ; Tuple-followed and not an operator), treat the first as
            ; the item_type and the remaining as the initializer.
            ; Without this, collapse_operand_sequence#'s binary loop
            ; sees [Type, Const] as a would-be binary op, bails when
            ; there's no rhs, returns just the Type, and emit_binding
            ; drops the alloca entirely.
            var peeled_idx: size_t 0
            var has_peeled_type: bool false
            var peeled_holder Vector[PlannedType]^rp(1)
            guard orig_item.item_type = null
            {
                guard planned_ops_flat.length >= 2
                {
                    let first_ptr planned_ops_flat.get(0)
                    guard first_ptr <> null
                    {
                        let first_op (*first_ptr)
                        choose first_op.expr
                            when ft: PlannedType
                            {
                                guard ft.name.get_length() > 0
                                {
                                    guard Planner.is_operator_name(ft.name) = false
                                    {
                                        let next_ptr planned_ops_flat.get(1)
                                        guard next_ptr <> null
                                        {
                                            let next_op (*next_ptr)
                                            var next_is_continuation: bool false
                                            choose next_op.expr
                                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                                    set next_is_continuation: true
                                                when nt: PlannedTuple
                                                    set next_is_continuation: true
                                                when nty: PlannedType
                                                {
                                                    ; Lifetime markers (^name, $, #) are
                                                    ; modeled as Expression.Type with an
                                                    ; empty name path. Such markers
                                                    ; participate in the same call/ctor
                                                    ; collapse as Matrix/Tuple — don't
                                                    ; peel.
                                                    guard nty.name.get_length() = 0
                                                        set next_is_continuation: true
                                                }
                                                else
                                                    0
                                            guard next_is_continuation = false
                                            {
                                                set has_peeled_type: true
                                                set peeled_idx: 1
                                                peeled_holder.put(0, ft)
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                    }
                }
            }

            ; Build the actual ops vector to collapse: either all of
            ; planned_ops_flat or just the tail starting at peeled_idx.
            var rest_arr Array[PlannedOperand]^rp()
            var ri: size_t peeled_idx
            while ri < planned_ops_flat.length
            {
                let p_ptr planned_ops_flat.get(ri)
                guard p_ptr <> null
                    rest_arr.add((*p_ptr))
                set ri: ri + 1
            }
            let ops_to_collapse Vector[PlannedOperand]^rp(rest_arr)
            let collapsed this.collapse_operand_sequence#(ops_to_collapse)

            ; Rebuild PlannedItem with the peeled type if any.
            var planned_item: PlannedItem orig_item
            guard has_peeled_type
                set planned_item: PlannedItem(
                    orig_item.loc,
                    orig_item.is_private,
                    orig_item.name,
                    peeled_holder.get(0),
                    orig_item.attributes
                )

            ; Use the annotated type if present; otherwise infer from the
            ; initializer's result type so emit_variable can map_type the
            ; binding without waiting for constraint resolution. Mirrors
            ; Planner.cpp:10950-10974.
            var binding_type: PlannedType collapsed.result_type
            guard planned_item.item_type <> null
                set binding_type: (*planned_item.item_type)

            ; Emit an equality constraint between the declared binding
            ; type and the collapsed initializer's result type. Solvable
            ; cases either confirm the annotation or fix the fresh var.
            this.add_equality_constraint(binding_type, collapsed.result_type, b.span)

            ; Register the local in the current scope.
            guard planned_item.name <> null
            {
                let n (*planned_item.name)
                this.define_local(n, binding_type, b.binding_type.equals("var"), false)
            }

            ; s93: only include the collapsed operand when there's an
            ; actual initializer. For typed-no-init `var X: T`, an empty
            ; b.operation produces a void-type placeholder from
            ; collapse_operand_sequence#; passing it through made
            ; emit_binding's `length > 0` gate true and emit_operands
            ; return null on the placeholder, which then bailed out
            ; without allocating the binding's slot. Skipping the put
            ; lets emit_binding fall through to the type-only alloca
            ; path. Mirrors stage-0 Planner.cpp:10947 where empty
            ; ValueOps produce a null `Init` field on the Binding.
            var ops_holder Vector[PlannedOperand]^rp(0)
            guard rest_arr.length > 0
                ops_holder.add(collapsed)
            PlannedBinding(
                b.span,
                b.binding_type,
                planned_item,
                &ops_holder
            )
        }

        ; ================================================================
        ; plan_action / plan_return / plan_break / plan_throw.
        ;
        ; Each wraps a Vector[Operand] into the appropriate Planned*
        ; variant. plan_action collapses its source + target operand
        ; sequences via collapse_operand_sequence (which folds binary
        ; ops, method chains, is/as, and prefix ops); result_type takes
        ; the collapsed source's type.
        ; ================================================================

        function plan_action#(rp, this: Planner, a: Action) returns PlannedAction
        {
            let planned_source_flat this.plan_operands#(a.source)
            let planned_source_collapsed this.collapse_operand_sequence#(planned_source_flat)

            let planned_target_flat this.plan_operands#(a.target)
            let planned_target_collapsed this.collapse_operand_sequence#(planned_target_flat)

            let result_type planned_source_collapsed.result_type

            var source_holder Vector[PlannedOperand]^rp(1)
            source_holder.put(0, planned_source_collapsed)

            var target_holder: ref[Vector[PlannedOperand]]? null
            guard a.target.length > 0
            {
                var target_vec Vector[PlannedOperand]^rp(1)
                target_vec.put(0, planned_target_collapsed)
                set target_holder: &target_vec
            }

            PlannedAction(
                &source_holder,
                target_holder,
                result_type
            )
        }

        function plan_return#(rp, this: Planner, r: Return) returns PlannedReturn
        {
            let planned_flat this.plan_operands#(r.result)
            let planned_collapsed this.collapse_operand_sequence#(planned_flat)

            var holder Vector[PlannedOperand]^rp(1)
            guard planned_flat.length > 0
                holder.put(0, planned_collapsed)
            PlannedReturn(r.span, &holder)
        }

        function plan_break#(rp, this: Planner, b: Break) returns PlannedBreak
        {
            let planned this.plan_operands#(b.result)
            var holder Vector[PlannedOperand]^rp(planned)
            PlannedBreak(b.span, &holder)
        }

        function plan_throw#(rp, this: Planner, t: Throw) returns PlannedThrow
        {
            let planned this.plan_operands#(t.result)
            var holder Vector[PlannedOperand]^rp(planned)
            PlannedThrow(t.span, &holder)
        }

        ; ================================================================
        ; plan_statement: Model.Statement → Plan.PlannedStatement.
        ; Dispatches over the Statement union and delegates to the
        ; variant-specific plan_* method. `Continue` is trivial — just
        ; carries the location.
        ; ================================================================
        function plan_statement#(rp, this: Planner, s: Statement) returns PlannedStatement
        {
            choose s
                when a: Action
                    PlannedStatement.Action(this.plan_action#(a))
                when b: Binding
                    PlannedStatement.Binding(this.plan_binding#(b))
                when br: Break
                    PlannedStatement.Break(this.plan_break#(br))
                when c: Continue
                    PlannedStatement.Continue(PlannedContinue(c.span))
                when r: Return
                    PlannedStatement.Return(this.plan_return#(r))
                when t: Throw
                    PlannedStatement.Throw(this.plan_throw#(t))
        }

        ; plan_statements: batch plan_statement over a Model.Block's statements.
        function plan_statements#(
            rp,
            this: Planner,
            stmts: Vector[Statement]
        ) returns Vector[PlannedStatement]
        {
            var result Vector[PlannedStatement]^rp(stmts.length)
            var i: size_t 0
            while i < stmts.length
            {
                let s_ptr stmts.get(i)
                guard s_ptr <> null
                {
                    let s (*s_ptr)
                    let pl this.plan_statement#(s)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_block: push a fresh scope, plan every statement, pop.
        ; After planning, scan the planned statements for any operand
        ; carrying a Local lifetime — that's the signal that a `$`
        ; allocation happened in this block and the emitter must emit
        ; page-cleanup on exit.
        ; ================================================================
        function plan_block#(rp, this: Planner, b: Block) returns PlannedBlock
        {
            this.push_scope()
            let planned_stmts this.plan_statements#(b.statements)
            this.pop_scope()

            var has_local: bool false
            var si: size_t 0
            while si < planned_stmts.length
            {
                let s_ptr planned_stmts.get(si)
                guard s_ptr <> null
                {
                    guard Planner.statement_has_local_lifetime((*s_ptr))
                        set has_local: true
                }
                set si: si + 1
            }

            var stmts_holder Vector[PlannedStatement]^rp(planned_stmts)
            PlannedBlock(b.span, &stmts_holder, has_local)
        }

        ; has_local_lifetime: true iff `t` is a $-allocation marker
        ; (Lifetime.Local). Value types with Unspecified lifetime stay
        ; stack-resident and don't need page cleanup.
        function has_local_lifetime(t: PlannedType) returns bool
        {
            choose t.life
                when l: Local
                    true
                else
                    false
        }

        ; operand_has_local_lifetime: true iff the operand's own type or
        ; any of its planned call args / tuple components carries a
        ; Local lifetime. Does not descend into nested blocks — those
        ; own their own needs_local_page_cleanup flag.
        function operand_has_local_lifetime(op: PlannedOperand) returns bool
        {
            guard Planner.has_local_lifetime(op.result_type)
                return true

            choose op.expr
                when call: PlannedCall
                {
                    guard call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get(i)
                            guard a_ptr <> null
                            {
                                guard Planner.operand_has_local_lifetime((*a_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when tup: PlannedTuple
                {
                    guard Planner.has_local_lifetime(tup.tuple_type)
                        return true
                    guard tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get(i)
                            guard c_ptr <> null
                            {
                                let c (*c_ptr)
                                guard c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get(j)
                                        guard v_ptr <> null
                                        {
                                            guard Planner.operand_has_local_lifetime((*v_ptr))
                                                return true
                                        }
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; statement_has_local_lifetime: scan the operands inside a
        ; PlannedStatement for any Local-lifetime marker.
        function statement_has_local_lifetime(s: PlannedStatement) returns bool
        {
            choose s
                when a: PlannedAction
                {
                    guard a.source <> null
                    {
                        let src (*a.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get(i)
                            guard op_ptr <> null
                            {
                                guard Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when b: PlannedBinding
                {
                    guard b.operation <> null
                    {
                        let ops (*b.operation)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get(i)
                            guard op_ptr <> null
                            {
                                guard Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when r: PlannedReturn
                {
                    guard r.result <> null
                    {
                        let ops (*r.result)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get(i)
                            guard op_ptr <> null
                            {
                                guard Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; ================================================================
        ; plan_property: Model.Property → Plan.PlannedProperty.
        ;
        ; `mangled_name` is left empty here — the planner enclosing the
        ; struct sets it once the struct's own mangled name is known.
        ; `offset` is 0 until compute_property_offsets runs as part of
        ; the enclosing struct's layout pass.
        ; ================================================================
        function plan_property#(rp, this: Planner, p: Property) returns PlannedProperty
        {
            var prop_type: PlannedType this.fresh_type_var#(String$(""))
            guard p.type <> null
            {
                let t (*p.type)
                set prop_type: this.plan_type#(t)
            }

            var initializer_ref: ref[Vector[PlannedOperand]]? null
            guard p.initializer <> null
            {
                let init_ops (*p.initializer)
                let planned_init this.plan_operands#(init_ops)
                var init_holder Vector[PlannedOperand]^rp(planned_init)
                set initializer_ref: &init_holder
            }

            let mangled Planner.encode_name(p.name)

            PlannedProperty(
                p.span,
                p.private_,
                p.name,
                mangled,
                prop_type,
                initializer_ref,
                null,
                0
            )
        }

        ; plan_implementation: Implementation variant → PlannedImplementation.
        ; Extern/Instruction/Intrinsic are trivially tagged wrappers;
        ; Action delegates to plan_action which in turn plans its source
        ; and target operand lists.
        function plan_implementation#(rp, this: Planner, impl: Implementation) returns PlannedImplementation
        {
            choose impl
                when a: Action
                    PlannedImplementation.Action(this.plan_action#(a))
                when e: Extern
                    PlannedImplementation.Extern(PlannedExternImpl(e.span))
                when i: Instruction
                    PlannedImplementation.Instruction(PlannedInstructionImpl(i.span))
                when n: Intrinsic
                    PlannedImplementation.Intrinsic(PlannedIntrinsicImpl(n.span))
        }

        ; ================================================================
        ; plan_function: Model.Function → Plan.PlannedFunction.
        ;
        ; Opens a new scope, registers each parameter as a local, plans
        ; the return/throws types, and plans the implementation.
        ; Computes:
        ;   - mangled_name (Itanium ABI via mangle_function)
        ;   - can_throw (set iff throws_type is present)
        ;   - needs_local_page (scan body for Local-lifetime ops)
        ;   - has_page (page parameter present or implicit return alloc)
        ; `origin` (instantiation source) and `scheme` (post-solver
        ; type scheme) remain null for now.
        ; ================================================================
        function plan_function#(
            rp,
            this: Planner,
            f: Function,
            parent: ref[PlannedType]?
        ) returns PlannedFunction
        {
            this.push_scope()

            ; For generic functions with no explicit instantiation,
            ; seed each type parameter with a fresh type variable so
            ; plan_type can resolve `T` etc. to something unifiable.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < f.parameters.length
            {
                let gp_ptr f.parameters.get(gi)
                guard gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    guard existing = null
                    {
                        let fresh this.fresh_type_var#(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items#(f.input)

            ; Patch `this` parameter to carry the enclosing type. The Modeler
            ; produces an Item with no explicit type for `this`, so plan_item#
            ; returns a PlannedItem with item_type=null. Without this patch,
            ; emit_function_decl skips `this` (no item_type → no LLVMTypeRef
            ; pushed) and LLVMGetParam later crashes on a null Argument type.
            ; Mirrors Planner.cpp:11765-11778.
            guard parent <> null
            {
                var ti: size_t 0
                while ti < planned_input.length
                {
                    let item_ptr planned_input.get(ti)
                    guard item_ptr <> null
                    {
                        let item (*item_ptr)
                        guard item.name <> null
                        {
                            guard item.item_type = null
                            {
                                let n (*item.name)
                                guard n.equals(String$("this"))
                                {
                                    let p (*parent)
                                    var type_holder Vector[PlannedType]^rp(1)
                                    type_holder.put(0, p)
                                    var patched item
                                    set patched.item_type: type_holder.get(0)
                                    planned_input.put(ti, patched)
                                }
                            }
                        }
                    }
                    set ti: ti + 1
                }
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get(i)
                guard item_ptr <> null
                {
                    let item (*item_ptr)
                    guard item.name <> null
                    {
                        guard item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            ; For 'this', the local-scope binding should be
                            ; pointer[T] (struct-by-pointer ABI), so field
                            ; access auto-derefs. Mirrors Planner.cpp:11781-11790.
                            guard n.equals(String$("this"))
                            {
                                let ptr_t Planner.make_pointer_type#(t)
                                this.define_local(n, ptr_t, false, false)
                            }
                            guard n.equals(String$("this")) = false
                                this.define_local(n, t, false, false)
                        }
                    }
                }
                set i: i + 1
            }

            var return_type: ref[PlannedType]? null
            guard f.returns_ <> null
            {
                let rt (*f.returns_)
                let planned_rt this.plan_type#(rt)
                var rt_holder Vector[PlannedType]^rp(1)
                rt_holder.put(0, planned_rt)
                set return_type: rt_holder.get(0)
            }

            var throws_type: ref[PlannedType]? null
            guard f.throws_ <> null
            {
                let tt (*f.throws_)
                let planned_tt this.plan_type#(tt)
                var tt_holder Vector[PlannedType]^rp(1)
                tt_holder.put(0, planned_tt)
                set throws_type: tt_holder.get(0)
            }

            let planned_impl this.plan_implementation#(f.implementation)

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            var input_holder Vector[PlannedItem]^rp(planned_input)

            ; Compute the Itanium mangled name. For a free function this
            ; is `_Z<name-len><name><params>`; for methods (parent
            ; non-null) it's `_ZN<parent><name>E<params>`. function#
            ; sites prepend an implicit page parameter; functions that
            ; return a user-defined type also need the caller's page to
            ; allocate the result (needs_implicit_return_page).
            var has_page: bool false
            guard f.page_parameter <> null
                set has_page: true
            guard Planner.needs_implicit_return_page(f)
                set has_page: true

            ; Extern C functions keep their unmangled name so LLVM can
            ; resolve them against libc / system libraries. Mirrors
            ; Planner.cpp:11806-11808's IsExtern ? Func.Name : mangle.
            var mangled_holder Vector[String]^rp(1)
            guard Planner.is_extern_impl(f.implementation)
                mangled_holder.put(0, String#(f.name))
            guard Planner.is_extern_impl(f.implementation) = false
                mangled_holder.put(0, Planner.mangle_function#(f.name, &input_holder, parent, has_page))
            let mangled (*mangled_holder.get(0))

            var can_throw: bool false
            guard throws_type <> null
                set can_throw: true

            ; needs_local_page: true iff the Action body contains any $
            ; allocation (Lifetime.Local on some operand's type). Used
            ; by the Emitter to emit page-cleanup on function exit.
            var needs_local_page: bool false
            choose planned_impl
                when ia: PlannedAction
                {
                    guard ia.source <> null
                    {
                        let src (*ia.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get(i)
                            guard op_ptr <> null
                            {
                                guard Planner.operand_has_local_lifetime((*op_ptr))
                                    set needs_local_page: true
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0

            ; Propagate the page_parameter ref so emit_function_decl can
            ; prepend the implicit `rp: pointer[Page]` LLVM arg. Without
            ; this, `function#(x: T)` mangles correctly (PN4scaly...) but
            ; the LLVM signature drops the rp slot and stage-1 callers
            ; that pass `rp` first end up loading the wrong arg.
            ;
            ; s131: also set page_param_ref when needs_implicit_return_page
            ; is true (return-by-page allocation injects an implicit page
            ; arg the same way `#` does). Without this, the mangled name
            ; includes `PN4scaly6memory4PageE` (via has_page above) but the
            ; PlannedFunction's page_parameter stays null. emit_function_decl
            ; then computes page_offset=0 and emits 3 LLVM params instead
            ; of 4 — emit_function_body's variable-binding loop then maps
            ; user params (this, i) to LLVMGetParam(1, 2), which actually
            ; correspond to the page + this slots in the 4-arg LLVM
            ; signature created by the s78/s83 extern-decl path (which
            ; sees requires_page_param=true via MethodMatch). Symptom:
            ; `Vector.get` body's `data + i` emits `add ptr %data, %2`
            ; where %2 is the this-ptr slot, not the i index.
            var page_param_ref: ref[String]? null
            guard f.page_parameter <> null
            {
                var pp_holder Vector[String]^rp(1)
                pp_holder.put(0, String^rp((*f.page_parameter)))
                set page_param_ref: pp_holder.get(0)
            }
            guard f.page_parameter = null
            {
                guard Planner.needs_implicit_return_page(f)
                {
                    var pp_holder Vector[String]^rp(1)
                    pp_holder.put(0, String^rp("rp"))
                    set page_param_ref: pp_holder.get(0)
                }
            }

            let result PlannedFunction(
                f.span,
                f.private_,
                f.pure,
                f.name,
                mangled,
                page_param_ref,
                &input_holder,
                return_type,
                throws_type,
                f.lifetime,
                planned_impl,
                null,
                needs_local_page,
                can_throw,
                null
            )
            this.record_function(result)
            result
        }

        ; plan_initializer: Model.Initializer → Plan.PlannedInitializer.
        ; An initializer is like a function without name / returns_ / throws_ /
        ; lifetime. Parameters open a new scope, implementation is planned,
        ; scope closed.
        ;
        ; s81: also synthesizes a PlannedFunction wrapper for the init
        ; body and records it in instantiated_functions so emit_function_decl
        ; / emit_function_body produce the C1 ctor body. The wrapper's
        ; LLVM signature is [this: parent, page (if init#), ...user_args]
        ; — page_parameter on the wrapper is left null to avoid the
        ; emit_function_decl page-prepend; the page slot is just a
        ; regular input item.
        function plan_initializer#(
            rp,
            this: Planner,
            ini: Initializer,
            parent: ref[PlannedType]?
        ) returns PlannedInitializer
        {
            this.push_scope()

            let planned_input this.plan_items#(ini.input)

            ; s81: define `page` as `pointer[scaly.memory.Page]` so
            ; bare `page.allocate(...)` in the init body resolves.
            ; Mirrors Planner.cpp:12048-12061.
            guard ini.page_parameter <> null
            {
                let page_struct_ty PlannedType(
                    ini.span,
                    String^rp("scaly.memory.Page"),
                    String^rp("N4scaly6memory4PageE"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
                let page_ptr_ty Planner.make_pointer_type#(page_struct_ty)
                this.define_local((*ini.page_parameter), page_ptr_ty, false, false)
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get(i)
                guard item_ptr <> null
                {
                    let item (*item_ptr)
                    guard item.name <> null
                    {
                        guard item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            this.define_local(n, t, false, false)
                        }
                    }
                }
                set i: i + 1
            }

            ; s81: define `this` as `pointer[parent]` so bare-field
            ; access in the init body (`set data: ...`) is rewritten
            ; via the implicit-property-access path at Planner.scaly
            ; line ~4347. Mirrors Planner.cpp:12082-12088.
            guard parent <> null
            {
                let p (*parent)
                let this_ptr_ty Planner.make_pointer_type#(p)
                this.define_local(String$("this"), this_ptr_ty, false, false)
            }

            let planned_impl this.plan_implementation#(ini.implementation)

            this.pop_scope()

            var input_holder Vector[PlannedItem]^rp(planned_input)

            ; init#(page, ...) requires the mangled symbol to carry a
            ; leading size_t "page" parameter so LLVM signatures match
            ; what emit-site call resolution expects. When parent is
            ; non-null the initializer mangles as a method of that type
            ; (Itanium `_ZN<parent>initE<params>`).
            var has_page: bool false
            guard ini.page_parameter <> null
                set has_page: true

            let mangled Planner.mangle_function#(
                String$("init"), &input_holder, parent, has_page
            )

            ; Clone the page_parameter name into rp so the resulting
            ; PlannedInitializer owns a stable reference.
            var page_ref: ref[String]? null
            guard ini.page_parameter <> null
            {
                var holder Vector[String]^rp(1)
                holder.put(0, String^rp((*ini.page_parameter)))
                set page_ref: holder.get(0)
            }

            let result_ini PlannedInitializer(
                ini.span,
                ini.private_,
                page_ref,
                mangled,
                &input_holder,
                planned_impl
            )

            ; s81: synthesize a PlannedFunction body wrapper and record
            ; it so emit_function_decl/body produce the C1 ctor body.
            ; Skip when impl is Extern/Intrinsic (no body to emit) or
            ; when parent is null (free-floating init# isn't a thing).
            choose planned_impl
                when ia: PlannedAction
                {
                    guard parent <> null
                    {
                        let p (*parent)
                        var synth_items Array[PlannedItem]$()

                        var this_name_holder Vector[String]^rp(1)
                        this_name_holder.put(0, String^rp("this"))
                        var this_ty_holder Vector[PlannedType]^rp(1)
                        this_ty_holder.put(0, p)
                        synth_items.add(PlannedItem(
                            ini.span,
                            false,
                            this_name_holder.get(0),
                            this_ty_holder.get(0),
                            null
                        ))

                        guard ini.page_parameter <> null
                        {
                            let page_struct_ty PlannedType(
                                ini.span,
                                String^rp("scaly.memory.Page"),
                                String^rp("N4scaly6memory4PageE"),
                                null,
                                Lifetime.Unspecified(Unspecified()),
                                null,
                                String^rp(""),
                                null
                            )
                            let page_ptr_ty Planner.make_pointer_type#(page_struct_ty)
                            var page_ty_holder Vector[PlannedType]^rp(1)
                            page_ty_holder.put(0, page_ptr_ty)

                            var page_name_holder Vector[String]^rp(1)
                            page_name_holder.put(0, String^rp((*ini.page_parameter)))

                            synth_items.add(PlannedItem(
                                ini.span,
                                false,
                                page_name_holder.get(0),
                                page_ty_holder.get(0),
                                null
                            ))
                        }

                        var ui: size_t 0
                        while ui < planned_input.length
                        {
                            let pi_ptr planned_input.get(ui)
                            guard pi_ptr <> null
                                synth_items.add((*pi_ptr))
                            set ui: ui + 1
                        }

                        var synth_input_holder Vector[PlannedItem]^rp(synth_items)

                        let synth_fn PlannedFunction(
                            ini.span,
                            ini.private_,
                            false,
                            String^rp("init"),
                            mangled,
                            null,
                            &synth_input_holder,
                            null,
                            null,
                            Lifetime.Unspecified(Unspecified()),
                            planned_impl,
                            null,
                            false,
                            false,
                            null
                        )
                        this.record_function(synth_fn)
                    }
                    0
                }
                else
                    0

            result_ini
        }

        ; plan_deinitializer: Model.DeInitializer → Plan.PlannedDeInitializer.
        ; Even simpler than plan_initializer — no parameters.
        function plan_deinitializer#(
            rp,
            this: Planner,
            dei: DeInitializer,
            parent: ref[PlannedType]?
        ) returns PlannedDeInitializer
        {
            let planned_impl this.plan_implementation#(dei.implementation)
            ; Mangle as a method of `parent` named "deinit" (Itanium
            ; `_ZN<parent>6deinitEv`); bare deinit for a free context.
            let mangled Planner.mangle_function#(
                String$("deinit"), null, parent, false
            )
            PlannedDeInitializer(
                dei.span,
                mangled,
                planned_impl
            )
        }

        ; plan_operator: Model.Operator → Plan.PlannedOperator.
        ; Structurally identical to plan_function modulo the two missing
        ; fields (no `pure`, no `lifetime`).
        function plan_operator#(
            rp,
            this: Planner,
            op: Operator,
            parent: ref[PlannedType]?
        ) returns PlannedOperator
        {
            this.push_scope()

            ; Seed generic type parameters with fresh type variables.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < op.parameters.length
            {
                let gp_ptr op.parameters.get(gi)
                guard gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    guard existing = null
                    {
                        let fresh this.fresh_type_var#(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items#(op.input)

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get(i)
                guard item_ptr <> null
                {
                    let item (*item_ptr)
                    guard item.name <> null
                    {
                        guard item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            this.define_local(n, t, false, false)
                        }
                    }
                }
                set i: i + 1
            }

            var return_type: ref[PlannedType]? null
            guard op.returns_ <> null
            {
                let rt (*op.returns_)
                let planned_rt this.plan_type#(rt)
                var rt_holder Vector[PlannedType]^rp(1)
                rt_holder.put(0, planned_rt)
                set return_type: rt_holder.get(0)
            }

            var throws_type: ref[PlannedType]? null
            guard op.throws_ <> null
            {
                let tt (*op.throws_)
                let planned_tt this.plan_type#(tt)
                var tt_holder Vector[PlannedType]^rp(1)
                tt_holder.put(0, planned_tt)
                set throws_type: tt_holder.get(0)
            }

            let planned_impl this.plan_implementation#(op.implementation)

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            var input_holder Vector[PlannedItem]^rp(planned_input)
            let mangled Planner.mangle_operator#(op.name, &input_holder, parent)
            PlannedOperator(
                op.span,
                op.private_,
                op.name,
                mangled,
                &input_holder,
                return_type,
                throws_type,
                planned_impl,
                null,
                null
            )
        }

        ; plan_variant: Model.Variant → Plan.PlannedVariant.
        ; The tag is assigned by the caller (variants need sequential tags
        ; within the union; we can't see sibling variants from here).
        ; `mangled_name` is left empty for the same reason as
        ; plan_property.
        function plan_variant#(rp, this: Planner, v: Variant, tag: int) returns PlannedVariant
        {
            var var_type: ref[PlannedType]? null
            guard v.type <> null
            {
                let t (*v.type)
                let planned this.plan_type#(t)
                var holder Vector[PlannedType]^rp(1)
                holder.put(0, planned)
                set var_type: holder.get(0)
            }

            let mangled Planner.encode_name(v.name)

            PlannedVariant(
                v.span,
                v.name,
                mangled,
                var_type,
                null,
                tag
            )
        }

        ; ================================================================
        ; plan_structure: Model.Structure → Plan.PlannedStructure.
        ;
        ; Plans every property, computes struct size/alignment (simple
        ; "size == alignment per primitive" model), then plans all
        ; members: methods (Function), operators, initializers, and the
        ; deinitializer. mangled_name is built via mangle_structure so
        ; method/operator mangling can reference the parent.
        ; ================================================================
        function plan_structure#(rp, this: Planner, s: Structure, name: String) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]$()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get(i)
                guard p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property#(p))
                }
                set i: i + 1
            }

            ; First-pass layout on properties with offset=0 to obtain the
            ; per-property offsets.
            var props_initial Vector[PlannedProperty]^rp(planned_props)
            let offsets Planner.compute_property_offsets#(&props_initial)

            ; Re-emit each PlannedProperty with the computed offset
            ; written back. (PlannedProperty is stored by value in the
            ; Vector; in-place mutation would require reaching through
            ; the heap, so a copy-with-new-offset is cleaner.)
            var props_with_offsets Array[PlannedProperty]$()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get(j)
                let o_ptr offsets.get(j)
                guard p_ptr <> null
                {
                    guard o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty]^rp(props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)

            ; Build the struct's own PlannedType (name + resolved
            ; generics) before planning methods so method mangling
            ; can encode the parent.
            var gens_arr Array[PlannedType]$()
            let c_for_gens_ref this.lookup_concept(name)
            guard c_for_gens_ref <> null
            {
                let c_for_gens (*c_for_gens_ref)
                var pi: size_t 0
                while pi < c_for_gens.parameters.length
                {
                    let p_ptr c_for_gens.parameters.get(pi)
                    guard p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        guard ts_ref <> null
                            gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var gens_holder Vector[PlannedType]^rp(gens_arr)
            var gens_ref: ref[Vector[PlannedType]]? null
            guard gens_holder.length > 0
                set gens_ref: &gens_holder
            let mangled Planner.mangle_structure#(name, gens_ref)

            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                s.span,
                String^rp(name),
                mangled,
                gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get(0)

            ; Plan methods, operators, initializers, deinitializer.
            var planned_methods Array[PlannedFunction]$()
            var planned_operators Array[PlannedOperator]$()
            var planned_initializers Array[PlannedInitializer]$()
            var deinit_ref: ref[PlannedDeInitializer]? null

            var mi: size_t 0
            while mi < s.members.length
            {
                let m_ptr s.members.get(mi)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            planned_methods.add(this.plan_function#(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            planned_operators.add(this.plan_operator#(o, parent_ref))
                            0
                        }
                        else
                            0
                }
                set mi: mi + 1
            }

            var ii: size_t 0
            while ii < s.initializers.length
            {
                let ii_ptr s.initializers.get(ii)
                guard ii_ptr <> null
                {
                    let ini (*ii_ptr)
                    planned_initializers.add(this.plan_initializer#(ini, parent_ref))
                }
                set ii: ii + 1
            }

            guard s.deinitializer <> null
            {
                let di (*s.deinitializer)
                var dei_holder Vector[PlannedDeInitializer]^rp(1)
                dei_holder.put(0, this.plan_deinitializer#(di, parent_ref))
                set deinit_ref: dei_holder.get(0)
            }

            var methods_holder Vector[PlannedFunction]^rp(planned_methods)
            var ops_holder Vector[PlannedOperator]^rp(planned_operators)
            var inits_holder Vector[PlannedInitializer]^rp(planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String^rp(name),
                mangled,
                &props_holder,
                &inits_holder,
                deinit_ref,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; plan_structure_layout#: register a Structure's layout (properties,
        ; offsets, size, alignment) into instantiated_structures WITHOUT
        ; planning its methods, operators, initializers, or deinitializer.
        ;
        ; Used by register_struct_layouts# to import cross-module struct
        ; layouts so map_type / emit_struct_type / emit_member_assignment
        ; have a real struct type available, even when the module's
        ; function bodies aren't planned in the current compilation unit.
        ; Skipping methods avoids the planner-side crashes (null this in
        ; check_function_match → String::get_buffer) that would otherwise
        ; happen when walking generic/cross-module method bodies.
        function plan_structure_layout#(rp, this: Planner, s: Structure, name: String) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]$()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get(i)
                guard p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property#(p))
                }
                set i: i + 1
            }

            var props_initial Vector[PlannedProperty]^rp(planned_props)
            let offsets Planner.compute_property_offsets#(&props_initial)

            var props_with_offsets Array[PlannedProperty]$()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get(j)
                let o_ptr offsets.get(j)
                guard p_ptr <> null
                {
                    guard o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty]^rp(props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)
            let mangled Planner.mangle_structure#(name, null)

            ; Build the parent type (struct's own PlannedType) so
            ; plan_initializer can encode the parent in the
            ; mangled C1/C2 names.
            var gens_holder Vector[PlannedType]^rp(0)
            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                s.span,
                String^rp(name),
                mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get(0)

            ; Plan only initializers (constructor bodies). Method
            ; bodies and operators are skipped — those frequently
            ; reference cross-module/generic types that the planner
            ; can't resolve outside their normal walk and would crash
            ; mid-emit. Initializers are simpler (just `set field: ...`
            ; over the struct's own fields) and safe to walk here.
            var planned_initializers Array[PlannedInitializer]$()
            var ii: size_t 0
            while ii < s.initializers.length
            {
                let ii_ptr s.initializers.get(ii)
                guard ii_ptr <> null
                {
                    let ini (*ii_ptr)
                    planned_initializers.add(this.plan_initializer#(ini, parent_ref))
                }
                set ii: ii + 1
            }

            var methods_holder Vector[PlannedFunction]^rp(0)
            var ops_holder Vector[PlannedOperator]^rp(0)
            var inits_holder Vector[PlannedInitializer]^rp(planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String^rp(name),
                mangled,
                &props_holder,
                &inits_holder,
                null,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; register_struct_layouts_in_module#: walk a module's tree and
        ; register layout-only PlannedStructures for every Concept whose
        ; definition is a Structure. Skips the Concept if its name is
        ; already in instantiated_structures (avoids duplicate entries
        ; when the same module is also walked by the full planner).
        function register_struct_layouts_in_module#(rp, this: Planner, m: Module)
        {
            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get(i)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_struct_layouts_in_concept#(c)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get(mi)
                guard sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_struct_layouts_in_module#(sub)
                }
                set mi: mi + 1
            }
        }

        ; register_struct_layouts_in_concept#: if the concept's
        ; definition is a Structure, register its layout. If it's a
        ; Namespace, recurse into namespace members and modules.
        function register_struct_layouts_in_concept#(rp, this: Planner, c: Concept)
        {
            ; Only handle parameterless concepts here — generic
            ; structures get planned per-instantiation by the existing
            ; lookup_concept path in plan_type#.
            guard c.parameters.length > 0
                return

            ; Skip if already recorded.
            let m_check Planner.mangle_structure#(c.name, null)
            guard this.has_instantiated_structure(m_check)
                return

            choose c.definition
                when s: Structure
                {
                    let pl this.plan_structure_layout#(s, c.name)
                    0
                }
                when ns: Namespace
                {
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get(i)
                        guard m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_struct_layouts_in_concept#(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get(mi)
                        guard sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_struct_layouts_in_module#(sub)
                        }
                        set mi: mi + 1
                    }
                    0
                }
                else
                    0
        }

        ; plan_global: Model.Global → Plan.PlannedGlobal.
        ; The `name` comes from the enclosing Concept — Global itself has
        ; no name field.
        function plan_global#(rp, this: Planner, g: Global, name: String) returns PlannedGlobal
        {
            let planned_type this.plan_type#(g.type)
            let planned_value this.plan_operands#(g.value)
            var value_holder Vector[PlannedOperand]^rp(planned_value)
            let mangled Planner.encode_name(name)
            let result PlannedGlobal(
                g.span,
                String^rp(name),
                mangled,
                planned_type,
                &value_holder
            )
            this.record_global(result)
            result
        }

        ; plan_namespace: Model.Namespace → Plan.PlannedNamespace.
        ; Dispatches each Member to the appropriate plan_* method and
        ; collects the results into the per-kind vectors the planned
        ; representation expects.
        ;
        ; Pushes the namespace onto the current-namespace context so
        ; nested plan_function / plan_operator calls pick up the
        ; namespace as their mangling parent (Itanium
        ; `_ZN<NSName><FnName>E…`) and so is_namespace_sibling_function
        ; can resolve unqualified intra-namespace calls. The old
        ; context is restored before returning, giving nested
        ; namespaces correct save/restore semantics.
        function plan_namespace#(rp, this: Planner, ns: Namespace, name: String) returns PlannedNamespace
        {
            ; Build the parent PlannedType that tags every Function /
            ; Operator inside this namespace for mangling. Name alone
            ; drives the Itanium segment; encode_type length-prefixes
            ; it to emit `_ZN<NSName><FnName>E…`.
            let ns_mangled Planner.encode_name(name)
            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                ns.span,
                String^rp(name),
                ns_mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get(0)

            ; Save outer context and activate this namespace.
            let old_ns this.current_namespace
            let old_ns_name this.current_namespace_name
            set current_namespace: &ns
            var name_box Vector[String]^rp(1)
            name_box.put(0, name)
            set current_namespace_name: name_box.get(0)

            var functions Array[PlannedFunction]$()
            var operators Array[PlannedOperator]$()
            var concepts Array[PlannedConcept]$()

            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get(i)
                guard m_ptr <> null
                {
                    let m (*m_ptr)
                    choose m
                        when f: Function
                        {
                            functions.add(this.plan_function#(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            operators.add(this.plan_operator#(o, parent_ref))
                            0
                        }
                        when c: Concept
                        {
                            concepts.add(this.plan_concept#(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            ; Walk loaded sub-modules from `define ns { module foo }`
            ; so their concepts/functions get planned (and recorded
            ; into instantiated_functions for emission). Side effect
            ; only — return value of plan_module# is intentionally
            ; discarded (mirrors session 43's plan_loaded_packages#).
            ; Mixing the struct-by-value return into plan_namespace#'s
            ; own struct construction corrupts the frame on stage-0
            ; codegen; the helper isolates the call.
            this.plan_namespace_modules#(ns)

            ; Restore outer namespace context.
            set current_namespace: old_ns
            set current_namespace_name: old_ns_name

            var funcs_holder Vector[PlannedFunction]^rp(functions)
            var ops_holder Vector[PlannedOperator]^rp(operators)
            var concs_holder Vector[PlannedConcept]^rp(concepts)

            PlannedNamespace(
                ns.span,
                String^rp(name),
                ns_mangled,
                null,
                &funcs_holder,
                &ops_holder,
                &concs_holder
            )
        }

        ; plan_namespace_module_one#: route a single sub-module through
        ; plan_module# only when its name is on the safe-walk list
        ; (top-level package namespaces). Inner generic sub-modules of
        ; the scaly stdlib (containers/Vector, containers/HashMap, etc.)
        ; carry generic struct definitions whose body planning hits an
        ; unresolved Type.name walk in join_dotted_name → crashes
        ; mid-emit. Until that gap is closed, restrict the walk to the
        ; outer package namespaces.
        ;
        ; Functions inside the skipped inner sub-modules still resolve
        ; via register_concept_recursive (which walks ns.modules and
        ; registers concepts/functions globally) plus the
        ; collapse_operand_sequence# extern-decl gate; bodies come from
        ; libscaly / libscalyc at link time.
        ;
        ; Positive enumeration of safe names — the negation form
        ; `equals("X") = false` triggers a stage-0 codegen issue
        ; (silent rc=139 SEGV in the helper after IR is emitted).
        function plan_namespace_module_one#(rp, this: Planner, sub: Module)
        {
            guard sub.name.equals("memory")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("io")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("containers")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("compiler")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("cli")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Vector")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("HashMap")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Array")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("BuilderList")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("BuilderListIterator")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("HashMapBuilder")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("HashSet")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("HashSetBuilder")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("KeyValuePair")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("List")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("ListIterator")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Node")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Slot")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Slice")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Option")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Result")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("StringIterator")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("StringBuilder")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("String")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Page")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("PageList")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("PageNode")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("PageListIterator")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("BlockWatermark")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("runtime")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("root_pages")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Console")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("File")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Directory")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Path")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("FileError")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Model")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Plan")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("LLVM")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Syntax")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("lexer")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("parser")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Modeler")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Emitter")
            {
                let planned this.plan_module#(sub)
            }
            guard sub.name.equals("Planner")
            {
                let planned this.plan_module#(sub)
            }
            ; Layout-only fallback: even when this sub-module isn't on
            ; the safe-walk list (or when it was walked but its struct
            ; was already cached), register layouts for any concrete
            ; (parameterless) Structures it defines. has_instantiated_structure
            ; in register_struct_layouts_in_concept# guards against
            ; duplicate entries. This makes cross-module struct types
            ; (e.g. EmitterConfig referenced from cli.scaly) map_type-
            ; resolvable without walking the module's method bodies.
            this.register_struct_layouts_in_module#(sub)
        }

        ; Helper for plan_namespace#: walk ns.modules and route each
        ; through plan_namespace_module_one# (which applies the
        ; safe-walk filter). Side effect only — plan_module# returns
        ; a struct-by-value PlannedModule that's intentionally
        ; discarded inside the inner helper. Mixing that struct
        ; return into plan_namespace#'s own struct construction
        ; corrupts the frame on stage-0 codegen (session-43 pattern);
        ; the helper isolates the call.
        function plan_namespace_modules#(rp, this: Planner, ns: Namespace)
        {
            var mi: size_t 0
            while mi < ns.modules.length
            {
                let sub_ptr ns.modules.get(mi)
                guard sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.plan_namespace_module_one#(sub)
                }
                set mi: mi + 1
            }
        }

        ; is_namespace_sibling_function: true iff `name` refers to a
        ; Function defined directly in the currently-active
        ; namespace's members list. Used to decide whether an
        ; unqualified call inside a namespace body should route to
        ; the namespace-scoped peer or fall back to the global
        ; registry. Returns false whenever no namespace is active.
        function is_namespace_sibling_function(this: Planner, name: String) returns bool
        {
            guard current_namespace <> null
                return false

            let ns (*current_namespace)
            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get(i)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            guard f.name.equals(name)
                                return true
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
            false
        }

        ; register_concept_recursive: register `c` and, if its Definition
        ; is a Namespace, recurse into the namespace's members so inner
        ; Concepts / Functions / Operators are all visible by
        ; unqualified name during later planning.
        function register_concept_recursive(this: Planner, c: Concept)
        {
            this.register_concept(c)
            choose c.definition
                when ns: Namespace
                {
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get(i)
                        guard m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                when f: Function
                                {
                                    this.register_function(f)
                                    0
                                }
                                when o: Operator
                                {
                                    this.register_operator(o)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }

                    ; Sub-modules of a namespace (`define ns { module foo }`)
                    ; flatten just like top-level `module foo` decls so
                    ; nested function names resolve under the namespace
                    ; via short-name fallback in collapse_operand_sequence#.
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get(mi)
                        guard sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_module_concepts(sub)
                        }
                        set mi: mi + 1
                    }
                    0
                }
                when s: Structure
                {
                    ; Nested concepts inside a struct's members block
                    ; register under their own name. This lets
                    ; `struct Outer { struct Inner { ... } }` resolve
                    ; `Inner` by its short name.
                    var i: size_t 0
                    while i < s.members.length
                    {
                        let m_ptr s.members.get(i)
                        guard m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.members.length
                    {
                        let m_ptr u.members.get(i)
                        guard m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    0
                }
                else
                    0
        }

        ; register_module_concepts: walk a Model.Module's members and
        ; register every Concept, Function and Operator in the relevant
        ; registry. Done as a first pass so forward references work
        ; (A referencing B below, or main() calling helper() declared
        ; later in the file). Recurses into sub-modules and into
        ; namespace-shaped concepts so deeply nested definitions are
        ; reachable by their short name.
        function register_module_concepts(this: Planner, m: Module)
        {
            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get(i)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_concept_recursive(c)
                            0
                        }
                        when f: Function
                        {
                            this.register_function(f)
                            0
                        }
                        when o: Operator
                        {
                            this.register_operator(o)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get(mi)
                guard sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_module_concepts(sub)
                }
                set mi: mi + 1
            }
        }

        ; plan_module: Model.Module → Plan.PlannedModule.
        ;
        ; Two-pass: first register every concept reachable through this
        ; module's tree, then plan sub-modules and members. This makes
        ; forward references resolve — `struct A { b: B }` works even
        ; when B is defined later in the same module.
        function plan_module#(rp, this: Planner, m: Module) returns PlannedModule
        {
            ; Propagate this module's Use clauses into program_use_aliases
            ; so the dotted-call extern-decl gate fires for prefixes
            ; imported from sub-modules (e.g. cli.scaly's `use scaly.io.Console`
            ; → "Console") in addition to the main program's own uses.
            ; Without this, calls like `Console.println(...)` inside cli.run
            ; resolve at planning time but never reach the gate, so no
            ; extern declaration is emitted and emit_call returns null
            ; → empty function bodies.
            var uu: size_t 0
            while uu < m.uses.length
            {
                let u_ptr m.uses.get(uu)
                guard u_ptr <> null
                {
                    let path u_ptr.path
                    guard path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        guard last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                    }
                }
                set uu: uu + 1
            }

            this.register_module_concepts(m)

            var functions Array[PlannedFunction]$()
            var operators Array[PlannedOperator]$()
            var pl_concepts Array[PlannedConcept]$()
            var sub_modules Array[PlannedModule]$()

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get(mi)
                guard sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    sub_modules.add(this.plan_module#(sub))
                }
                set mi: mi + 1
            }

            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get(i)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            functions.add(this.plan_function#(f, null))
                            0
                        }
                        when o: Operator
                        {
                            operators.add(this.plan_operator#(o, null))
                            0
                        }
                        when c: Concept
                        {
                            pl_concepts.add(this.plan_concept#(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mods_holder Vector[PlannedModule]^rp(sub_modules)
            var concs_holder Vector[PlannedConcept]^rp(pl_concepts)
            var funcs_holder Vector[PlannedFunction]^rp(functions)
            var ops_holder Vector[PlannedOperator]^rp(operators)

            PlannedModule(
                m.file,
                m.name,
                &mods_holder,
                &concs_holder,
                &funcs_holder,
                &ops_holder
            )
        }

        ; plan_concept: wrap a Model.Concept (definition + generics) into
        ; PlannedConcept. Generic parameters are not instantiated here —
        ; that's the job of the separate instantiate-generic pass (TODO).
        ; For now we just drop the parameters on the floor and plan the
        ; underlying definition as-is.
        ;
        ; Intrinsic concepts (built-in types) are represented by a Type
        ; variant carrying a void placeholder until a proper Intrinsic
        ; variant is added to PlannedDefinition.
        function plan_concept#(rp, this: Planner, c: Concept) returns PlannedConcept
        {
            ; s107: generic data-class concepts (Structure with no
            ; members/initializers) defer body planning to
            ; instantiate_generic# at use sites. Pre-planning the
            ; unspecialised template here would record a struct named
            ; the same as every later instance (Box, etc.) — and
            ; emit_struct_type's name-keyed cache short-circuits the
            ; second emission, leaving %_Z3BoxIiE undefined while a
            ; ptr-typed property over the unbound `T` reaches map_type
            ; and gets lowered to opaque pointer, breaking field
            ; alignment. Mirrors stage-0 Planner.cpp:1613,1953,2131
            ; which only call planConcept when Parameters.empty().
            ; Stdlib generics (Vector etc.) have members/initializers
            ; and fall through to plan_structure# as before — the s107
            ; plan_type# guard mirrors this same data-class restriction.
            let pl_def choose c.definition
                when s: Structure
                {
                    var skip: bool false
                    guard c.parameters.length > 0
                        guard s.members.length = 0
                            guard s.initializers.length = 0
                                set skip: true
                    guard skip
                        return PlannedConcept(
                            c.span,
                            c.name,
                            Planner.encode_name(c.name),
                            null,
                            PlannedDefinition.Type(Planner.make_void_type#()),
                            null
                        )
                    PlannedDefinition.Structure(this.plan_structure#(s, c.name))
                }
                when u: scalyc.compiler.Model.Union
                    PlannedDefinition.Union(this.plan_union#(u, c.name))
                when ns: Namespace
                    PlannedDefinition.Namespace(this.plan_namespace#(ns, c.name))
                when g: Global
                    PlannedDefinition.Global(this.plan_global#(g, c.name))
                when t: Type
                    PlannedDefinition.Type(this.plan_type#(t))
                when intr: Intrinsic
                    PlannedDefinition.Type(Planner.make_void_type#())

            ; Generic concepts get a simple length-prefixed name; fully
            ; instantiated concepts get the full `_Z<name-len><name>`.
            var mangled: String String$("")
            guard c.parameters.length > 0
                set mangled: Planner.encode_name(c.name)
            guard c.parameters.length = 0
                set mangled: Planner.mangle_structure#(c.name, null)

            PlannedConcept(
                c.span,
                c.name,
                mangled,
                null,
                pl_def,
                null
            )
        }

        ; s148: byte size of a type referenced by name (variant payload
        ; or struct property). Knows about primitives, stdlib container
        ; shapes (Vector/Array = 16, String/HashMap/HashSet = 8), and
        ; walks registered Concept Structures' property lists when
        ; the name is a struct. Default 8 (matches the catch-all in
        ; get_primitive_alignment for unknown names).
        function compute_payload_size(this: Planner, name: String) returns size_t
        {
            var size: size_t Planner.get_primitive_alignment(name)
            guard name.equals(String$("Vector"))
                return 16
            guard name.equals(String$("Array"))
                return 16
            guard name.equals(String$("String"))
                return 8
            guard name.equals(String$("HashMap"))
                return 8
            guard name.equals(String$("HashSet"))
                return 8
            guard name.equals(String$("HashMapBuilder"))
                return 8
            guard name.equals(String$("HashSetBuilder"))
                return 8
            let c_ref this.lookup_concept(name)
            guard c_ref <> null
            {
                let c (*c_ref)
                choose c.definition
                    when st: Structure
                    {
                        var offset: size_t 0
                        var sa: size_t 1
                        var pi: size_t 0
                        while pi < st.properties.length
                        {
                            let p_ptr st.properties.get(pi)
                            guard p_ptr <> null
                            {
                                let p (*p_ptr)
                                guard p.type <> null
                                {
                                    let pt (*p.type)
                                    guard pt.name.length > 0
                                    {
                                        let last_p pt.name.get(pt.name.length - 1)
                                        guard last_p <> null
                                        {
                                            let pn (*last_p)
                                            let fs this.compute_payload_size(pn)
                                            let fa Planner.get_primitive_alignment(pn)
                                            set offset: Planner.align_offset(offset, fa) + fs
                                            guard fa > sa
                                                set sa: fa
                                        }
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                        let total Planner.align_offset(offset, sa)
                        guard total > 0
                            set size: total
                    }
                    else
                        0
            }
            size
        }

        ; plan_union: Model.Union → Plan.PlannedUnion.
        ; Similar scope to plan_structure: plans variants and computes
        ; size/alignment; skips methods/operators for now.
        function plan_union#(rp, this: Planner, u: scalyc.compiler.Model.Union, name: String) returns scalyc.compiler.Plan.PlannedUnion
        {
            var planned_vs Array[PlannedVariant]$()
            var tag: int 0
            var i: size_t 0
            while i < u.variants.length
            {
                let v_ptr u.variants.get(i)
                guard v_ptr <> null
                {
                    let v (*v_ptr)
                    planned_vs.add(this.plan_variant#(v, tag))
                    set tag: tag + 1
                }
                set i: i + 1
            }

            var vs_holder Vector[PlannedVariant]^rp(planned_vs)

            ; s148: compute size with concept-aware variant sizing. The
            ; static `Planner.compute_union_size` uses
            ; `get_primitive_alignment(name)` for each variant's payload,
            ; which returns the catch-all 8 for any non-primitive (so
            ; e.g. OperationSyntax / LetSyntax all contributed 8 bytes
            ; regardless of their real layout). StatementSyntax came out
            ; as 16B instead of stage-0's ~64B → List<StatementSyntax>::add
            ; allocated 16B Nodes that couldn't hold the value, so even
            ; with calls now emitted the list never accumulated. Fix:
            ; walk the registered Concept (Structure case) and sum
            ; property sizes the same way plan_sizeof# does (s144).
            var max_payload_size: size_t 0
            var max_payload_align: size_t 1
            var vi: size_t 0
            while vi < planned_vs.length
            {
                let vp_ptr planned_vs.get(vi)
                guard vp_ptr <> null
                {
                    let vp (*vp_ptr)
                    guard vp.var_type <> null
                    {
                        let vt (*vp.var_type)
                        let vsz this.compute_payload_size(vt.name)
                        let val Planner.get_primitive_alignment(vt.name)
                        guard vsz > max_payload_size
                            set max_payload_size: vsz
                        guard val > max_payload_align
                            set max_payload_align: val
                    }
                }
                set vi: vi + 1
            }
            var tag_sz: size_t 1
            guard planned_vs.length > 256
                set tag_sz: 4
            let u_size Planner.align_offset(max_payload_size + tag_sz, max_payload_align)
            let u_align Planner.compute_union_alignment(&vs_holder)

            ; Build the union's own PlannedType + mangled_name upfront
            ; so method planning can mangle methods with this as parent.
            var u_gens_arr Array[PlannedType]$()
            let u_concept_ref this.lookup_concept(name)
            guard u_concept_ref <> null
            {
                let u_concept (*u_concept_ref)
                var pi: size_t 0
                while pi < u_concept.parameters.length
                {
                    let p_ptr u_concept.parameters.get(pi)
                    guard p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        guard ts_ref <> null
                            u_gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var u_gens_holder Vector[PlannedType]^rp(u_gens_arr)
            var u_gens_ref: ref[Vector[PlannedType]]? null
            guard u_gens_holder.length > 0
                set u_gens_ref: &u_gens_holder
            let u_mangled Planner.mangle_structure#(name, u_gens_ref)

            var u_parent_holder Vector[PlannedType]^rp(1)
            u_parent_holder.put(0, PlannedType(
                u.span,
                String^rp(name),
                u_mangled,
                u_gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let u_parent_ref u_parent_holder.get(0)

            ; Plan methods and operators declared on the union.
            var planned_methods Array[PlannedFunction]$()
            var planned_operators Array[PlannedOperator]$()
            var mi: size_t 0
            while mi < u.members.length
            {
                let m_ptr u.members.get(mi)
                guard m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            planned_methods.add(this.plan_function#(f, u_parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            planned_operators.add(this.plan_operator#(o, u_parent_ref))
                            0
                        }
                        else
                            0
                }
                set mi: mi + 1
            }

            var methods_holder Vector[PlannedFunction]^rp(planned_methods)
            var ops_holder Vector[PlannedOperator]^rp(planned_operators)

            let result scalyc.compiler.Plan.PlannedUnion(
                u.span,
                u.private_,
                String^rp(name),
                u_mangled,
                &vs_holder,
                &methods_holder,
                &ops_holder,
                u_size,
                u_align,
                null
            )
            this.record_union(result)
            result
        }

        ; plan_program: top-level entry point.
        ;
        ; Walks the Model.Program:
        ;   - plan the main Module (recursively plans sub-modules and
        ;     members)
        ;   - plan top-level statements (executed before main())
        ;
        ; Instantiation caches (structures / unions / functions / globals)
        ; are left null — the per-kind planned data lives inside the
        ; PlannedModule tree for now. The separate caches come online
        ; once the instantiate-generic pass is ported.
        function plan_program#(rp, this: Planner, prog: Program) returns ref[Plan]?
        {
            ; Stash the program's main-module Use aliases up front
            ; so the dotted-call extern-decl gate can consult them
            ; while planning loaded-package namespace bodies.
            this.record_program_uses(prog)

            ; Seed the concept/function/operator registries with
            ; every sibling program's top-level definitions first.
            ; This way plan_module's lookups see cross-file
            ; references (main.scaly -> cli.scaly etc.) before it
            ; starts planning the primary module's members.
            this.register_sibling_programs()

            ; plan_loaded_packages# is intentionally NOT called here.
            ; If invoked, it walks each loaded package and records every
            ; top-level Function via plan_function# -> instantiated_functions
            ; -> Emitter emits the function body. For functions whose
            ; bodies stage-1 cannot fully plan (every dotted call inside
            ; the body collapses to nothing because the gate / lookup
            ; doesn't fire), this produces ret-stub definitions that
            ; collide with the real bodies in libscaly.a / libscalyc.a
            ; at link time ("duplicate symbol _ZN5scaly4testEv").
            ; Skipping the walk lets the dotted-call extern-decl gate
            ; emit declarations only, with libscaly/libscalyc providing
            ; the bodies at link time. Functions still resolve at
            ; planning time via register_module_concepts (called by
            ; cli.run::register_packages).

            let planned_main this.plan_module#(prog.module_)
            let planned_stmts this.plan_statements#(prog.statements)

            var stmts_holder Vector[PlannedStatement]^rp(planned_stmts)
            var structs_holder Vector[PlannedStructure]^rp(instantiated_structures)
            var unions_holder Vector[scalyc.compiler.Plan.PlannedUnion]^rp(instantiated_unions)
            var funcs_holder Vector[PlannedFunction]^rp(instantiated_functions)
            var globals_holder Vector[PlannedGlobal]^rp(instantiated_globals)
            var constraints_holder Vector[TypeConstraint]^rp(constraints)

            Plan#(
                planned_main,
                &stmts_holder,
                &structs_holder,
                &unions_holder,
                &funcs_holder,
                &globals_holder,
                next_type_var_id,
                &constraints_holder
            )
        }
    }

    ; ========================================================================
    ; Itanium ABI name encoding helpers.
    ; These are the smallest independent units of Planner.cpp; worth
    ; porting in full so Planner.test() can exercise them end-to-end.
    ; ========================================================================

    ; encode_name: "foo" -> "3foo" (length prefix + raw name)
    function encode_name(name: String) returns String
    {
        let len name.length
        let len_str size_to_string(len)
        let result StringBuilder#()
        result.append(len_str)
        result.append(name)
        result.to_string#()
    }

    ; strip_package_prefix: "scaly.containers.String" -> "String".
    ; Matches stripPackagePrefix in Planner.cpp: only strips when the full
    ; name begins with "scaly.". Anything else (e.g. "scalyc.compiler.Foo")
    ; is returned unchanged so user types keep their qualified identity.
    function strip_package_prefix#(rp, name: String) returns String
    {
        guard name.starts_with("scaly.") = false
            return String^rp(name)

        let last_dot name.last_index_of("." as u8)
        guard last_dot < 0
            return String^rp(name)

        let start (last_dot as size_t) + 1
        let len name.get_length() - start
        name.substring(rp, start, len)
    }

    ; encode_type: Itanium ABI type code.
    ;
    ; Recurses for pointer[T], ref[T] and generic instantiations. The
    ; optimized "use pre-computed mangled_name" shortcut from the C++
    ; implementation is deliberately omitted here — every PlannedType we
    ; construct from scratch will end up with an empty mangled_name, and
    ; the shortcut only saves work in a later pass we do not implement yet.
    function encode_type#(rp, type_value: PlannedType) returns String
    {
        ; Built-in primitive types.
        guard type_value.name.equals("void")
            return String^rp("v")
        guard type_value.name.equals("bool")
            return String^rp("b")
        guard type_value.name.equals("char")
            return String^rp("c")
        guard type_value.name.equals("int")
            return String^rp("i")
        guard type_value.name.equals("uint")
            return String^rp("j")
        guard type_value.name.equals("long")
            return String^rp("l")
        guard type_value.name.equals("ulong")
            return String^rp("m")
        guard type_value.name.equals("float")
            return String^rp("f")
        guard type_value.name.equals("double")
            return String^rp("d")
        guard type_value.name.equals("size")
            return String^rp("m")
        guard type_value.name.equals("size_t")
            return String^rp("m")

        ; pointer[T] -> "P" + encode_type(T)
        guard type_value.name.equals("pointer")
        {
            guard type_value.generics <> null
            {
                let gens (*type_value.generics)
                guard gens.length = 1
                {
                    let arg_ptr gens.get(0)
                    guard arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let inner Planner.encode_type#(arg)
                        var sb StringBuilder$()
                        sb.append("P" as char)
                        sb.append(inner)
                        return sb.to_string^rp()
                    }
                }
            }
        }

        ; ref[T] -> "R" + encode_type(T)   (non-owning reference)
        guard type_value.name.equals("ref")
        {
            guard type_value.generics <> null
            {
                let gens (*type_value.generics)
                guard gens.length = 1
                {
                    let arg_ptr gens.get(0)
                    guard arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let inner Planner.encode_type#(arg)
                        var sb StringBuilder$()
                        sb.append("R" as char)
                        sb.append(inner)
                        return sb.to_string^rp()
                    }
                }
            }
        }

        ; Generic instantiation: Name + "I" + args + "E".
        ; Strip any "Base.arg" instantiation suffix so we encode the template name.
        guard type_value.generics <> null
        {
            let gens (*type_value.generics)
            guard gens.length > 0
            {
                let dot_pos type_value.name.index_of("." as u8)
                var base_name: String type_value.name
                guard dot_pos >= 0
                    set base_name: type_value.name.substring(rp, 0, dot_pos as size_t)

                var sb StringBuilder$()
                sb.append(Planner.encode_name(base_name))
                sb.append("I" as char)
                var i: size_t 0
                while i < gens.length
                {
                    let arg_ptr gens.get(i)
                    guard arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let enc Planner.encode_type#(arg)
                        sb.append(enc)
                    }
                    set i: i + 1
                }
                sb.append("E" as char)
                return sb.to_string^rp()
            }
        }

        ; User-defined type: length-prefixed, with "scaly.*" stripped.
        let normalized Planner.strip_package_prefix#(type_value.name)
        Planner.encode_name(normalized)
    }

    ; mangle_type: "_Z" + encode_type(T). The "_Z" prefix marks this as a
    ; (fake) C++-compatible Itanium symbol so external tools like c++filt
    ; can demangle our names for humans.
    function mangle_type#(rp, type_value: PlannedType) returns String
    {
        let encoded Planner.encode_type#(type_value)
        var sb StringBuilder$()
        sb.append("_Z")
        sb.append(encoded)
        sb.to_string^rp()
    }

    ; mangle_structure: "_Z" + name-with-length-prefix + optional "I...E" generic block.
    ; Used for symbol-mangling concrete struct / union / trait definitions.
    function mangle_structure#(rp, name: String, generic_args: ref[Vector[PlannedType]]?) returns String
    {
        guard generic_args <> null
        {
            let args (*generic_args)
            guard args.length > 0
            {
                var sb StringBuilder$()
                sb.append("_Z")
                sb.append(Planner.encode_name(name))
                sb.append("I")
                var i: size_t 0
                while i < args.length
                {
                    let arg_ptr args.get(i)
                    guard arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let enc Planner.encode_type#(arg)
                        sb.append(enc)
                    }
                    set i: i + 1
                }
                sb.append("E")
                return sb.to_string^rp()
            }
        }

        var sb StringBuilder$()
        sb.append("_Z")
        sb.append(Planner.encode_name(name))
        sb.to_string^rp()
    }

    ; mangle_function: Itanium symbol for a function / method.
    ;
    ;   free function   -> _Z + encode_name + params
    ;   method          -> _Z + "N" + encode_type(parent) + encode_name + "E" + params
    ;
    ; A 'this' parameter (implicit receiver) is skipped in the mangled
    ; name — Itanium treats it as implicit. If has_page_param is set the
    ; implicit page parameter (`pointer[Page]`) is encoded first; this is
    ; how "function foo#" lowers on the ABI side.
    function mangle_function#(
        rp,
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?,
        has_page_param: bool
    ) returns String
    {
        var sb StringBuilder$()
        sb.append("_Z")

        guard parent <> null
        {
            let p (*parent)
            sb.append("N")
            sb.append(Planner.encode_type#(p))
            ; Itanium ABI: methods named "init" on a struct are constructors;
            ; emit C1 (complete-object ctor) instead of "<len>init". Mirrors
            ; stage-0 Planner.cpp:12100-12103. Required so constructor call-
            ; sites and the def-site (plan_initializer) agree on the symbol
            ; (`_ZN<T>C1E<args>`) which libscaly.a exports from stage-0.
            guard name.equals(String$("init"))
                sb.append("C1")
            guard name.equals(String$("init")) = false
                sb.append(Planner.encode_name(name))
            sb.append("E")
        }
        guard parent = null
            sb.append(Planner.encode_name(name))

        var has_explicit_params: bool false

        ; Implicit page parameter for `function foo#(…)` lowerings.
        ; Hard-coded mangling matches scaly::memory::Page in the C++ impl.
        guard has_page_param
        {
            sb.append("PN4scaly6memory4PageE")
            set has_explicit_params: true
        }

        guard params <> null
        {
            let ps (*params)
            var i: size_t 0
            while i < ps.length
            {
                let param_ptr ps.get(i)
                guard param_ptr <> null
                {
                    let param (*param_ptr)
                    var is_this: bool false
                    guard param.name <> null
                    {
                        let pname (*param.name)
                        set is_this: pname.equals("this")
                    }
                    guard is_this = false
                    {
                        guard param.item_type <> null
                        {
                            let pty (*param.item_type)
                            sb.append(Planner.encode_type#(pty))
                            set has_explicit_params: true
                        }
                    }
                }
                set i: i + 1
            }
        }

        guard has_explicit_params = false
            sb.append("v")

        sb.to_string^rp()
    }

    ; mangle_free_function_from_types: build a free-function Itanium
    ; symbol directly from PlannedTypes, skipping the PlannedItem
    ; ceremony mangle_function requires. Shape matches mangle_function
    ; with parent=null.
    function mangle_free_function_from_types#(
        rp,
        name: String,
        params: Vector[PlannedType],
        has_page_param: bool
    ) returns String
    {
        var sb StringBuilder$()
        sb.append("_Z")
        sb.append(Planner.encode_name(name))

        var has_explicit: bool false
        guard has_page_param
        {
            sb.append("PN4scaly6memory4PageE")
            set has_explicit: true
        }

        var i: size_t 0
        while i < params.length
        {
            let p_ptr params.get(i)
            guard p_ptr <> null
            {
                let p (*p_ptr)
                sb.append(Planner.encode_type#(p))
                set has_explicit: true
            }
            set i: i + 1
        }

        guard has_explicit = false
            sb.append("v")

        sb.to_string^rp()
    }

    ; operator_code: map a Scaly operator name to its Itanium ABI two-letter
    ; code. Unknown operators fall back to the `v0` vendor extension,
    ; followed by the length-prefixed operator identifier.
    function operator_code#(rp, name: String) returns String
    {
        guard name.equals("+")
            return String^rp("pl")
        guard name.equals("-")
            return String^rp("mi")
        guard name.equals("*")
            return String^rp("ml")
        guard name.equals("/")
            return String^rp("dv")
        guard name.equals("%")
            return String^rp("rm")
        guard name.equals("==")
            return String^rp("eq")
        guard name.equals("!=")
            return String^rp("ne")
        guard name.equals("<")
            return String^rp("lt")
        guard name.equals(">")
            return String^rp("gt")
        guard name.equals("<=")
            return String^rp("le")
        guard name.equals(">=")
            return String^rp("ge")
        guard name.equals("&&")
            return String^rp("aa")
        guard name.equals("||")
            return String^rp("oo")
        guard name.equals("!")
            return String^rp("nt")
        guard name.equals("&")
            return String^rp("an")
        guard name.equals("|")
            return String^rp("or")
        guard name.equals("^")
            return String^rp("eo")
        guard name.equals("~")
            return String^rp("co")
        guard name.equals("<<")
            return String^rp("ls")
        guard name.equals(">>")
            return String^rp("rs")
        guard name.equals("[]")
            return String^rp("ix")
        guard name.equals("()")
            return String^rp("cl")

        ; Vendor extension for operators without a dedicated code.
        var sb StringBuilder$()
        sb.append("v0")
        sb.append(Planner.encode_name(name))
        sb.to_string^rp()
    }

    ; mangle_operator: Itanium ABI symbol for an operator definition.
    ; Mirrors mangle_function but substitutes the two-letter op code for
    ; the operator name and skips an explicit 'this' parameter when the
    ; operator is declared as a member.
    function mangle_operator#(
        rp,
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?
    ) returns String
    {
        let op_code Planner.operator_code#(name)
        var sb StringBuilder$()
        sb.append("_Z")

        guard parent <> null
        {
            let p (*parent)
            sb.append("N")
            sb.append(Planner.encode_type#(p))
            sb.append(op_code)
            sb.append("E")
        }
        guard parent = null
            sb.append(op_code)

        ; Skip 'this' on member operators (param[0] with name "this").
        var start_idx: size_t 0
        guard parent <> null
        {
            guard params <> null
            {
                let ps (*params)
                guard ps.length > 0
                {
                    let first_ptr ps.get(0)
                    guard first_ptr <> null
                    {
                        let first (*first_ptr)
                        guard first.name <> null
                        {
                            let pname (*first.name)
                            guard pname.equals("this")
                                set start_idx: 1
                        }
                    }
                }
            }
        }

        var has_params: bool false
        guard params <> null
        {
            let ps (*params)
            var i: size_t start_idx
            while i < ps.length
            {
                let param_ptr ps.get(i)
                guard param_ptr <> null
                {
                    let param (*param_ptr)
                    guard param.item_type <> null
                    {
                        let pty (*param.item_type)
                        sb.append(Planner.encode_type#(pty))
                        set has_params: true
                    }
                }
                set i: i + 1
            }
        }

        guard has_params = false
            sb.append("v")

        sb.to_string^rp()
    }

    ; ========================================================================
    ; Type utilities.
    ; Used by the expression/statement planner for type checks and readable
    ; diagnostics. Ported from the "Type Utilities" section of Planner.cpp.
    ; ========================================================================

    ; get_readable_name: human-facing representation, e.g. "Vector[int]".
    function get_readable_name#(rp, type_value: PlannedType) returns String
    {
        guard type_value.generics <> null
        {
            let gens (*type_value.generics)
            guard gens.length > 0
            {
                var sb StringBuilder$()
                sb.append(type_value.name)
                sb.append("[")
                var i: size_t 0
                while i < gens.length
                {
                    guard i > 0
                        sb.append(", ")

                    let g_ptr gens.get(i)
                    guard g_ptr <> null
                    {
                        let g (*g_ptr)
                        let inner Planner.get_readable_name#(g)
                        sb.append(inner)
                    }
                    set i: i + 1
                }
                sb.append("]")
                return sb.to_string^rp()
            }
        }
        String^rp(type_value.name)
    }

    ; normalize_type_name: canonicalise builtin aliases.
    ; "scaly.*" packages collapse to their last component so "scaly.containers.String"
    ; compares equal to "String", matching Planner.cpp's normalizeTypeName. Integer
    ; aliases fold onto their sized form so int/size_t/char compare structurally.
    function normalize_type_name#(rp, name: String) returns String
    {
        var base: String name
        guard name.starts_with("scaly.")
        {
            let last_dot name.last_index_of("." as u8)
            guard last_dot >= 0
            {
                let start (last_dot as size_t) + 1
                let len name.get_length() - start
                set base: name.substring(rp, start, len)
            }
        }

        guard base.equals("int")
            return String^rp("i64")
        guard base.equals("i64")
            return String^rp("i64")
        guard base.equals("i32")
            return String^rp("i32")
        guard base.equals("i16")
            return String^rp("i16")
        guard base.equals("i8")
            return String^rp("i8")
        guard base.equals("size_t")
            return String^rp("u64")
        guard base.equals("size")
            return String^rp("u64")
        guard base.equals("u64")
            return String^rp("u64")
        guard base.equals("usize")
            return String^rp("u64")
        guard base.equals("u32")
            return String^rp("u32")
        guard base.equals("u16")
            return String^rp("u16")
        guard base.equals("u8")
            return String^rp("u8")
        guard base.equals("char")
            return String^rp("u8")
        guard base.equals("double")
            return String^rp("f64")
        guard base.equals("f64")
            return String^rp("f64")
        guard base.equals("float")
            return String^rp("f32")
        guard base.equals("f32")
            return String^rp("f32")

        String^rp(base)
    }

    ; is_integer_type: is a normalized type name one of the integer family?
    ; Called post-normalization so both "int" and "i64" answer true.
    function is_integer_type(normalized: String) returns bool
    {
        guard normalized.equals("i64")
            return true
        guard normalized.equals("i32")
            return true
        guard normalized.equals("i16")
            return true
        guard normalized.equals("i8")
            return true
        guard normalized.equals("u64")
            return true
        guard normalized.equals("u32")
            return true
        guard normalized.equals("u16")
            return true
        guard normalized.equals("u8")
            return true
        guard normalized.equals("size_t")
            return true
        guard normalized.equals("int")
            return true
        guard normalized.equals("uint")
            return true
        guard normalized.equals("char")
            return true
        false
    }

    ; is_char_like_cross_compatible: decide whether two pointer-inner types
    ; can freely substitute for each other. Mirrors the unwieldy pointer
    ; rules in Planner.cpp's typesCompatible exactly — in particular the
    ; one-way (param=const_char, arg=char) rule; the reverse is rejected
    ; because you must not silently assign immutable data to mutable storage.
    function is_char_like_cross_compatible(param_inner: String, arg_inner: String) returns bool
    {
        guard param_inner.equals("const_char")
        {
            guard arg_inner.equals("i8")
                return true
            guard arg_inner.equals("char")
                return true
        }
        guard param_inner.equals("i8")
        {
            guard arg_inner.equals("const_char")
                return true
            guard arg_inner.equals("char")
                return true
        }
        guard param_inner.equals("char")
        {
            guard arg_inner.equals("i8")
                return true
        }

        ; u8 is ABI-identical to the 1-byte char family.
        guard param_inner.equals("u8")
        {
            guard arg_inner.equals("char")
                return true
            guard arg_inner.equals("const_char")
                return true
            guard arg_inner.equals("i8")
                return true
            guard arg_inner.equals("u8")
                return true
        }
        guard arg_inner.equals("u8")
        {
            guard param_inner.equals("char")
                return true
            guard param_inner.equals("const_char")
                return true
            guard param_inner.equals("i8")
                return true
        }

        false
    }

    ; types_equal: structural equality after alias normalisation.
    ; Recurses pairwise through the generics list; mismatched arities
    ; are unequal. Null/empty generics are treated uniformly as arity 0.
    function types_equal(a: PlannedType, b: PlannedType) returns bool
    {
        let norm_a Planner.normalize_type_name$(a.name)
        let norm_b Planner.normalize_type_name$(b.name)
        guard norm_a.equals(norm_b) = false
            return false

        var a_len: size_t 0
        var b_len: size_t 0
        guard a.generics <> null
        {
            let ag (*a.generics)
            set a_len: ag.length
        }
        guard b.generics <> null
        {
            let bg (*b.generics)
            set b_len: bg.length
        }

        guard a_len <> b_len
            return false

        guard a_len = 0
            return true

        guard a.generics <> null
        {
            guard b.generics <> null
            {
                let ag (*a.generics)
                let bg (*b.generics)
                var i: size_t 0
                while i < a_len
                {
                    let a_ptr ag.get(i)
                    let b_ptr bg.get(i)
                    guard a_ptr <> null
                    {
                        guard b_ptr <> null
                        {
                            let av (*a_ptr)
                            let bv (*b_ptr)
                            guard Planner.types_equal(av, bv) = false
                                return false
                        }
                    }
                    set i: i + 1
                }
            }
        }
        true
    }

    ; types_compatible: decide whether an argument of ArgType can be passed
    ; to a parameter of ParamType without an explicit cast. Order of rules
    ; matches Planner.cpp — earlier rules short-circuit, later rules remain
    ; authoritative for their specific cases (pointer-to-void, Option-null).
    function types_compatible(param_type: PlannedType, arg_type: PlannedType) returns bool
    {
        ; Rule 1: exact equality (post-normalisation).
        guard Planner.types_equal(param_type, arg_type)
            return true

        ; Rule 2: any integer type is compatible with any other. The Emitter
        ; inserts the appropriate zext/sext/trunc at the call site.
        let norm_p Planner.normalize_type_name$(param_type.name)
        let norm_a Planner.normalize_type_name$(arg_type.name)
        guard Planner.is_integer_type(norm_p)
        {
            guard Planner.is_integer_type(norm_a)
                return true
        }

        ; Rule 3: arg is pointer[T], param is T — implicit deref. Handles
        ; passing `this` (a pointer) to a function expecting the value type.
        guard arg_type.name.equals("pointer")
        {
            guard arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                guard ag.length > 0
                {
                    let inner_ptr ag.get(0)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        guard Planner.types_equal(param_type, inner)
                            return true
                    }
                }
            }
        }

        ; Rule 4: ref[T] implicitly derefs to T.
        guard arg_type.name.equals("ref")
        {
            guard arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                guard ag.length > 0
                {
                    let inner_ptr ag.get(0)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        guard Planner.types_equal(param_type, inner)
                            return true
                    }
                }
            }
        }

        ; s96: pointer[T] is compatible with ref[T] (and vice versa). Both
        ; lower to `ptr` in LLVM, and `&local` produces pointer[T] while
        ; ref params expect ref[T]. Stage-0's typesCompatible doesn't have
        ; this rule (it falls through and works only via the qualified-
        ; call name-only fallback at Planner.cpp:7912 for namespace.fn
        ; sites); extending the rule here lets free-function `f(&x)` for
        ; `f(p: ref[T])` work too. Symmetric: pointer[T] passed to ref[T]
        ; param, OR ref[T] passed to pointer[T] param.
        guard param_type.name.equals("ref")
        {
            guard arg_type.name.equals("pointer")
            {
                guard param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    guard pg.length > 0
                    {
                        let p0_ptr pg.get(0)
                        guard p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            guard arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                guard ag.length > 0
                                {
                                    let a0_ptr ag.get(0)
                                    guard a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        guard Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        guard param_type.name.equals("pointer")
        {
            guard arg_type.name.equals("ref")
            {
                guard param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    guard pg.length > 0
                    {
                        let p0_ptr pg.get(0)
                        guard p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            guard arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                guard ag.length > 0
                                {
                                    let a0_ptr ag.get(0)
                                    guard a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        guard Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 5 & 6 both require both sides to be pointer[T] with a generic arg.
        guard param_type.name.equals("pointer")
        {
            guard arg_type.name.equals("pointer")
            {
                guard param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    guard pg.length > 0
                    {
                        let p0_ptr pg.get(0)
                        guard p0_ptr <> null
                        {
                            let p0 (*p0_ptr)

                            ; Rule 6: any pointer[T] coerces to pointer[void].
                            guard p0.name.equals("void")
                                return true

                            ; Rule 5: char-family pointer cross-compatibility.
                            guard arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                guard ag.length > 0
                                {
                                    let a0_ptr ag.get(0)
                                    guard a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        guard Planner.is_char_like_cross_compatible(p0.name, a0.name)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 7 & 8: null (typed as pointer[void]) is the None for Option types.
        guard arg_type.name.equals("pointer")
        {
            guard arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                guard ag.length > 0
                {
                    let a0_ptr ag.get(0)
                    guard a0_ptr <> null
                    {
                        let a0 (*a0_ptr)
                        guard a0.name.equals("void")
                        {
                            guard param_type.name.equals("Option")
                                return true
                            guard param_type.name.starts_with("Option.")
                                return true
                        }
                    }
                }
            }
        }

        false
    }

    ; ========================================================================
    ; Struct-layout arithmetic.
    ; ========================================================================

    ; is_primitive_type_name: matches the set the C++ Planner treats as not
    ; requiring an implicit return-page parameter. Used both for layout
    ; decisions and for the needs_implicit_return_page check.
    function is_primitive_type_name(name: String) returns bool
    {
        guard name.equals("void")
            return true
        guard name.equals("bool")
            return true
        guard name.equals("int")
            return true
        guard name.equals("uint")
            return true
        guard name.equals("char")
            return true
        guard name.equals("i8")
            return true
        guard name.equals("i16")
            return true
        guard name.equals("i32")
            return true
        guard name.equals("i64")
            return true
        guard name.equals("u8")
            return true
        guard name.equals("u16")
            return true
        guard name.equals("u32")
            return true
        guard name.equals("u64")
            return true
        guard name.equals("f32")
            return true
        guard name.equals("f64")
            return true
        guard name.equals("float")
            return true
        guard name.equals("double")
            return true
        guard name.equals("size_t")
            return true
        guard name.equals("size")
            return true
        guard name.equals("pointer")
            return true
        guard name.equals("ref")
            return true
        false
    }

    ; get_primitive_alignment: bytes of alignment required by a primitive.
    ; Mirrors the simplified model in Planner.cpp's computeStructLayout —
    ; size is always equal to alignment here (no padding for subword
    ; fields), which is good enough for Phase-2 layout decisions. Unknown
    ; or non-primitive types default to 8-byte alignment.
    function get_primitive_alignment(type_name: String) returns size_t
    {
        guard type_name.equals("bool")
            return 1
        guard type_name.equals("char")
            return 1
        guard type_name.equals("i8")
            return 1
        guard type_name.equals("u8")
            return 1
        guard type_name.equals("i16")
            return 2
        guard type_name.equals("u16")
            return 2
        guard type_name.equals("i32")
            return 4
        guard type_name.equals("u32")
            return 4
        guard type_name.equals("float")
            return 4
        guard type_name.equals("f32")
            return 4
        ; s103: int/uint are 8 bytes (i64) to match stage-0
        ; (Planner.cpp:960). Stage-1 previously returned 4 here,
        ; making sizeof(int) = 4 vs stage-0's 8 — sizeof_ops AOT
        ; test compared 4 = 8 → false → printed WRONG.
        8
    }

    ; align_offset: round `offset` up to the next multiple of `align`.
    ; `align` must be a power of two (standard struct-layout precondition).
    function align_offset(offset: size_t, align: size_t) returns size_t
    {
        (offset + align - 1) & (~(align - 1))
    }

    ; compute_struct_alignment: the maximum alignment demanded by any
    ; property in `props`, with a floor of 1 (empty struct).
    function compute_struct_alignment(props: ref[Vector[PlannedProperty]]?) returns size_t
    {
        guard props = null
            return 1

        let ps (*props)
        var max_align: size_t 1
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get(i)
            guard p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                guard align > max_align
                    set max_align: align
            }
            set i: i + 1
        }
        max_align
    }

    ; compute_struct_size: total byte size needed for a struct with these
    ; properties, assuming size == alignment per field (the simplified
    ; model from Planner.cpp). The final size is rounded up to the
    ; struct's own alignment.
    function compute_struct_size(props: ref[Vector[PlannedProperty]]?) returns size_t
    {
        guard props = null
            return 0

        let ps (*props)
        var offset: size_t 0
        var max_align: size_t 1
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get(i)
            guard p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                set offset: Planner.align_offset(offset, align)
                set offset: offset + align
                guard align > max_align
                    set max_align: align
            }
            set i: i + 1
        }
        Planner.align_offset(offset, max_align)
    }

    ; compute_property_offsets: per-property byte offsets in struct order.
    ; Split out as a separate pass (rather than mutating PlannedProperty in
    ; place) because Scaly's Vector stores by value and we don't yet have
    ; a clean mutation pattern for nested struct fields.
    function compute_property_offsets#(rp, props: ref[Vector[PlannedProperty]]?) returns Vector[size_t]
    {
        guard props = null
            return Vector[size_t]^rp(0)

        let ps (*props)
        var result Vector[size_t]^rp(ps.length)
        var offset: size_t 0
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get(i)
            guard p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                set offset: Planner.align_offset(offset, align)
                result.put(i, offset)
                set offset: offset + align
            }
            set i: i + 1
        }
        result
    }

    ; compute_union_size: max-variant-size plus a 1-byte (or 4-byte for
    ; very large unions) tag, aligned to the widest variant's alignment.
    ; Ignores variants with no payload type; a tag-only variant contributes
    ; nothing to the size calculation beyond the tag itself.
    function compute_union_size(variants: ref[Vector[PlannedVariant]]?) returns size_t
    {
        guard variants = null
            return 0

        let vs (*variants)
        var max_size: size_t 0
        var max_align: size_t 1
        var i: size_t 0
        while i < vs.length
        {
            let v_ptr vs.get(i)
            guard v_ptr <> null
            {
                let v (*v_ptr)
                guard v.var_type <> null
                {
                    let vt (*v.var_type)
                    let align Planner.get_primitive_alignment(vt.name)
                    guard align > max_size
                        set max_size: align
                    guard align > max_align
                        set max_align: align
                }
            }
            set i: i + 1
        }

        ; Tag: 1 byte for ≤256 variants, 4 bytes beyond.
        var tag_size: size_t 1
        guard vs.length > 256
            set tag_size: 4

        Planner.align_offset(max_size + tag_size, max_align)
    }

    ; compute_union_alignment: max alignment across all variant payload
    ; types; tag-only variants contribute the 1-byte tag alignment.
    function compute_union_alignment(variants: ref[Vector[PlannedVariant]]?) returns size_t
    {
        guard variants = null
            return 1

        let vs (*variants)
        var max_align: size_t 1
        var i: size_t 0
        while i < vs.length
        {
            let v_ptr vs.get(i)
            guard v_ptr <> null
            {
                let v (*v_ptr)
                guard v.var_type <> null
                {
                    let vt (*v.var_type)
                    let align Planner.get_primitive_alignment(vt.name)
                    guard align > max_align
                        set max_align: align
                }
            }
            set i: i + 1
        }

        max_align
    }

    ; ========================================================================
    ; Constraint-solver helpers.
    ; The main Hindley-Milner machinery (unify, solveConstraints,
    ; freshTypeVar) touches Plan-global state, but the "occurs check"
    ; and compatible-integer predicate are pure and can be ported now.
    ; ========================================================================

    ; substitution_lookup: linear scan for a type-var id in a substitution.
    ; The `Substitution` type in Planner.cpp is a map<uint64_t, PlannedType>.
    ; In Scaly we represent it as Vector[KeyValuePair[size_t, PlannedType]]
    ; because primitive size_t lacks a `.hash()` method — HashMap requires
    ; `key.hash()` / `key.equals()` which are only defined on String today.
    ; At the scale of substitutions during a single function body (a few
    ; dozen entries at most) O(n) lookup is fine.
    function substitution_lookup(
        subst: Vector[KeyValuePair[size_t, PlannedType]],
        id: size_t
    ) returns ref[PlannedType]?
    {
        var i: size_t 0
        while i < subst.length
        {
            let kvp_ptr subst.get_ptr(i)
            guard kvp_ptr <> null
            {
                guard kvp_ptr.key = id
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; apply_substitution: replace every type variable in `t` with its binding
    ; in `subst`, recursing to handle chains (T0 -> T1 -> int). Concrete
    ; types get rebuilt with substituted generic arguments; everything
    ; else (loc / life / origin / mangled_name / array_size / variable) is
    ; preserved from the input. Returns the input unchanged when subst is
    ; null (i.e. empty substitution).
    function apply_substitution#(
        rp,
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    ) returns PlannedType
    {
        guard t.variable <> null
        {
            guard subst <> null
            {
                let s (*subst)
                let tv (*t.variable)
                let found Planner.substitution_lookup(s, tv.id)
                guard found <> null
                {
                    let found_ty (*found)
                    return Planner.apply_substitution#(found_ty, subst)
                }
            }
            ; Unresolved variable — return as-is.
            return t
        }

        guard t.generics <> null
        {
            let gens (*t.generics)
            var new_gens Vector[PlannedType]^rp(gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get(i)
                guard g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub_g Planner.apply_substitution#(g, subst)
                    new_gens.put(i, sub_g)
                }
                set i: i + 1
            }
            return PlannedType(
                t.loc,
                t.name,
                t.mangled_name,
                &new_gens,
                t.life,
                t.origin,
                t.array_size,
                t.variable
            )
        }

        t
    }

    ; free_type_vars_with_dups: depth-first collection of every type-var
    ; id reachable through the generics tree. May contain duplicates —
    ; the public free_type_vars wrapper dedupes.
    function free_type_vars_with_dups#(rp, t: PlannedType) returns Vector[size_t]
    {
        var acc Array[size_t]$()
        guard t.variable <> null
        {
            let tv (*t.variable)
            acc.add(tv.id)
        }
        guard t.generics <> null
        {
            let gens (*t.generics)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get(i)
                guard g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub Planner.free_type_vars_with_dups#(g)
                    var j: size_t 0
                    while j < sub.length
                    {
                        let id_ptr sub.get(j)
                        guard id_ptr <> null
                            acc.add(*id_ptr)

                        set j: j + 1
                    }
                }
                set i: i + 1
            }
        }
        Vector[size_t]^rp(acc)
    }

    ; free_type_vars: distinct type-var ids in `t`, in first-seen order.
    ; Used for generalization (promoting a type to a type scheme).
    function free_type_vars#(rp, t: PlannedType) returns Vector[size_t]
    {
        let with_dups Planner.free_type_vars_with_dups#(t)
        var acc Array[size_t]$()
        var i: size_t 0
        while i < with_dups.length
        {
            let id_ptr with_dups.get(i)
            guard id_ptr <> null
            {
                let id *id_ptr
                var found: bool false
                var j: size_t 0
                while j < acc.length
                {
                    let existing acc.get(j)
                    guard existing <> null
                    {
                        guard *existing = id
                            set found: true
                    }
                    set j: j + 1
                }
                guard found = false
                    acc.add(id)
            }
            set i: i + 1
        }
        Vector[size_t]^rp(acc)
    }

    ; name_substitution_lookup: linear scan by String key. Distinct from
    ; substitution_lookup (which keys on size_t type-var ids).
    function name_substitution_lookup(
        subst: Vector[KeyValuePair[String, PlannedType]],
        name: String
    ) returns ref[PlannedType]?
    {
        var i: size_t 0
        while i < subst.length
        {
            let kvp_ptr subst.get_ptr(i)
            guard kvp_ptr <> null
            {
                guard kvp_ptr.key.equals(name)
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; planned_type_to_model_type: deep-convert PlannedType → Model.Type,
    ; preserving nested generics. Used by extract_row_to_type# to rebuild
    ; an outer Model.Type with proper inner generic structure.
    function planned_type_to_model_type#(rp, pt: PlannedType) returns Type
    {
        var name_path Vector[String]^rp(1)
        name_path.put(0, pt.name)
        var maybe_gens: ref[Vector[Type]]? null
        guard pt.generics <> null
        {
            let pgens (*pt.generics)
            guard pgens.length > 0
            {
                var conv Vector[Type]^rp(pgens.length)
                var i: size_t 0
                while i < pgens.length
                {
                    let inner_ptr pgens.get(i)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        conv.put(i, Planner.planned_type_to_model_type#(inner))
                    }
                    set i: i + 1
                }
                set maybe_gens: &conv
            }
        }
        Type(pt.loc, name_path, maybe_gens, pt.life)
    }

    ; apply_name_substitution: substitute type-parameter names (e.g. "T",
    ; "K") with concrete types. Used by generic instantiation — the C++
    ; `TypeSubstitutions` is a name-keyed map populated before resolving
    ; each method in an instantiated struct.
    ;
    ; Preserves the caller's `loc` on the substituted type so error
    ; messages point at the use-site, matching Planner.cpp.
    function apply_name_substitution#(
        rp,
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[String, PlannedType]]]?
    ) returns PlannedType
    {
        guard subst <> null
        {
            let s (*subst)
            let hit Planner.name_substitution_lookup(s, t.name)
            guard hit <> null
            {
                let replacement (*hit)
                return PlannedType(
                    t.loc,
                    replacement.name,
                    replacement.mangled_name,
                    replacement.generics,
                    replacement.life,
                    replacement.origin,
                    replacement.array_size,
                    replacement.variable
                )
            }
        }

        guard t.generics <> null
        {
            let gens (*t.generics)
            var new_gens Vector[PlannedType]^rp(gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get(i)
                guard g_ptr <> null
                {
                    let g (*g_ptr)
                    let new_g Planner.apply_name_substitution#(g, subst)
                    new_gens.put(i, new_g)
                }
                set i: i + 1
            }
            return PlannedType(
                t.loc,
                t.name,
                t.mangled_name,
                &new_gens,
                t.life,
                t.origin,
                t.array_size,
                t.variable
            )
        }

        t
    }

    ; ========================================================================
    ; Primitive-type factories.
    ;
    ; The C++ Planner implicitly knows the Itanium one-letter codes for
    ; every built-in type. Until we have a Concepts table populated with
    ; pre-registered primitives, callers that need to synthesize a
    ; primitive PlannedType (e.g. for `return type of null = pointer[void]`)
    ; go through these factories so the codes stay consistent everywhere.
    ; ========================================================================

    function make_primitive_type#(rp, name: pointer[const_char], mangled: pointer[const_char]) returns PlannedType
    {
        PlannedType(
            Span(0, 0),
            String^rp(name),
            String^rp(mangled),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
    }

    function make_void_type#(rp) returns PlannedType
        Planner.make_primitive_type#("void", "v")

    function make_bool_type#(rp) returns PlannedType
        Planner.make_primitive_type#("bool", "b")

    function make_int_type#(rp) returns PlannedType
        Planner.make_primitive_type#("int", "i")

    function make_char_type#(rp) returns PlannedType
        Planner.make_primitive_type#("char", "c")

    function make_size_type#(rp) returns PlannedType
        Planner.make_primitive_type#("size_t", "m")

    function make_double_type#(rp) returns PlannedType
        Planner.make_primitive_type#("double", "d")

    ; make_pointer_type: wrap `inner` as pointer[inner], with Itanium "P..."
    ; mangled name. `inner.mangled_name` must be populated.
    function make_pointer_type#(rp, inner: PlannedType) returns PlannedType
    {
        var gens Vector[PlannedType]^rp(1)
        gens.put(0, inner)
        var sb StringBuilder$()
        sb.append("P")
        sb.append(inner.mangled_name)
        PlannedType(
            Span(0, 0),
            String^rp("pointer"),
            sb.to_string^rp(),
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
    }

    ; extract_row_to_type#: convert one row of a parsed VectorSyntax /
    ; Matrix into a Model.Type, recursively handling nested generics.
    ; Mirrors stage-0 Planner.cpp:7180-7214 (extractTypeFromRow lambda).
    ;
    ; row.length == 1: cell must be a PlannedType — wrap it as Model.Type.
    ; row.length >= 2: first cell is bare PlannedType (no generics) AND
    ;   second cell is PlannedMatrix → recurse into each nested row,
    ;   build Model.Type with generics filled in.
    ; Otherwise: return null (caller treats this as extraction failure).
    function extract_row_to_type#(rp, row: Vector[PlannedOperand]) returns ref[Type]?
    {
        guard row.length = 0
            return null

        ; Nested generic pattern: [Type, Matrix, ...]. Check before the
        ; single-cell branch since row.length>=2 with bare-Type first +
        ; Matrix second is the signature for `Box[int]` / `Pair[A,B]` /
        ; etc. inside an outer generic argument list.
        guard row.length >= 2
        {
            let cell0_ptr row.get(0)
            guard cell0_ptr <> null
            {
                let cell0 (*cell0_ptr)
                choose cell0.expr
                    when name_type: PlannedType
                    {
                        guard name_type.name.get_length() > 0
                        {
                            guard name_type.generics = null
                            {
                                let cell1_ptr row.get(1)
                                guard cell1_ptr <> null
                                {
                                    let cell1 (*cell1_ptr)
                                    choose cell1.expr
                                        when nested_matrix: scalyc.compiler.Plan.PlannedMatrix
                                        {
                                            var nested_gens Array[Type]$()
                                            var ok: bool true
                                            guard nested_matrix.operations <> null
                                            {
                                                let nested_rows (*nested_matrix.operations)
                                                var nri: size_t 0
                                                while nri < nested_rows.length
                                                {
                                                    let nrow_ptr nested_rows.get(nri)
                                                    guard nrow_ptr <> null
                                                    {
                                                        let nrow (*nrow_ptr)
                                                        let inner_t Planner.extract_row_to_type#(nrow)
                                                        guard inner_t = null
                                                            set ok: false
                                                        guard inner_t <> null
                                                            nested_gens.add((*inner_t))
                                                    }
                                                    set nri: nri + 1
                                                }
                                            }
                                            guard ok
                                            {
                                                guard nested_gens.length > 0
                                                {
                                                    var name_path Vector[String]^rp(1)
                                                    name_path.put(0, name_type.name)
                                                    var gens_vec Vector[Type]^rp(nested_gens)
                                                    var holder Vector[Type]^rp(1)
                                                    holder.put(0, Type(
                                                        name_type.loc,
                                                        name_path,
                                                        &gens_vec,
                                                        name_type.life
                                                    ))
                                                    return holder.get(0)
                                                }
                                            }
                                        }
                                        else
                                            0
                                }
                            }
                        }
                    }
                    else
                        0
            }
        }

        ; Single-cell row: PlannedType → Model.Type. Use the recursive
        ; helper so nested generics survive the round-trip. s134: the
        ; previous implementation built each inner generic as
        ; `Type(name=[pt.name], generics=null)`, stripping deeper
        ; generic information. For PT_Vector<KVP<S, LB>> this turned
        ; the inner KVP into `Type("KeyValuePair", null)` — plan_type#
        ; later fell through to `mangle_structure#("KeyValuePair", null)`
        ; and produced the truncated `_Z12KeyValuePair` that broke
        ; Step-7 link with `_ZN6VectorI6VectorI12KeyValuePairEE...`
        ; calls.
        guard row.length = 1
        {
            let cell_ptr row.get(0)
            guard cell_ptr <> null
            {
                let cell (*cell_ptr)
                choose cell.expr
                    when et: PlannedType
                    {
                        var holder Vector[Type]^rp(1)
                        holder.put(0, Planner.planned_type_to_model_type#(et))
                        return holder.get(0)
                    }
                    else
                        return null
            }
        }

        null
    }

    ; resolve_type_base: convert a Model.Type into a PlannedType skeleton.
    ;
    ; Handles everything the non-stateful part of Planner.cpp's
    ; `resolveType` does:
    ;   - joins the dotted name (["scaly","containers","String"] -> "scaly.containers.String")
    ;   - recursively resolves generic arguments
    ;   - sets the Itanium mangled_name for the intrinsic pointer[T] / ref[T]
    ;     forms ("P…" / "R…")
    ;
    ; Deliberately skipped:
    ;   - TypeSubstitutions lookup (requires Planner state)
    ;   - Concepts table lookup for user-defined types' mangled_name
    ;     (leaves mangled_name empty for non-intrinsic names; the caller
    ;     fills that in once the Concepts table is available)
    function resolve_type_base#(rp, t: Type) returns PlannedType
    {
        let joined Planner.join_dotted_name#(t.name)

        var resolved_gens: ref[Vector[PlannedType]]? null
        guard t.generics <> null
        {
            let gens (*t.generics)
            var result Vector[PlannedType]^rp(gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get(i)
                guard g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub Planner.resolve_type_base#(g)
                    result.put(i, sub)
                }
                set i: i + 1
            }
            set resolved_gens: &result
        }

        var mangled String^rp("")
        guard joined.equals("pointer")
        {
            guard resolved_gens <> null
            {
                let rg (*resolved_gens)
                guard rg.length = 1
                {
                    let inner_ptr rg.get(0)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        var sb StringBuilder$()
                        sb.append("P")
                        sb.append(inner.mangled_name)
                        set mangled: sb.to_string^rp()
                    }
                }
            }
        }
        guard joined.equals("ref")
        {
            guard resolved_gens <> null
            {
                let rg (*resolved_gens)
                guard rg.length = 1
                {
                    let inner_ptr rg.get(0)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        var sb StringBuilder$()
                        sb.append("R")
                        sb.append(inner.mangled_name)
                        set mangled: sb.to_string^rp()
                    }
                }
            }
        }

        PlannedType(
            t.span,
            joined,
            mangled,
            resolved_gens,
            t.lifetime,
            null,
            String^rp(""),
            null
        )
    }

    ; lookup_local_in_scope: linear scan of one scope's bindings by name.
    ; Returned reference points into the scope's KeyValuePair storage.
    function lookup_local_in_scope(
        scope: Vector[KeyValuePair[String, LocalBinding]],
        name: String
    ) returns ref[LocalBinding]?
    {
        var i: size_t 0
        while i < scope.length
        {
            let kvp_ptr scope.get_ptr(i)
            guard kvp_ptr <> null
            {
                guard kvp_ptr.key.equals(name)
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; lookup_local_in_stack: searches innermost (top of the stack) to
    ; outermost — matches the reverse iteration in Planner.cpp's
    ; lookupLocal. A name shadowed in a newer scope hides the older
    ; binding.
    function lookup_local_in_stack(
        scopes: Vector[Vector[KeyValuePair[String, LocalBinding]]],
        name: String
    ) returns ref[LocalBinding]?
    {
        guard scopes.length = 0
            return null

        var i scopes.length
        while i > 0
        {
            set i: i - 1
            let scope_ptr scopes.get_ptr(i)
            guard scope_ptr <> null
            {
                let found Planner.lookup_local_in_scope(*scope_ptr, name)
                guard found <> null
                    return found
            }
        }
        null
    }

    ; is_on_page_lifetime: everything except `Unspecified` is a page-backed
    ; allocation in Scaly's RBMM (local / caller / named / thrown all live
    ; on a page). Matches the static helper in Planner.cpp.
    function is_on_page_lifetime(life: Lifetime) returns bool
    {
        choose life
            when u: Unspecified
                false
            else
                true
    }

    ; decode_utf8_to_code_point: decode exactly one UTF-8 code point from
    ; `s`. Returns -1 for empty input, malformed sequences, overlong
    ; encodings, surrogates/out-of-range, or any trailing bytes past the
    ; first character. Matches the static helper in Planner.cpp.
    function decode_utf8_to_code_point(s: String) returns int
    {
        let len s.get_length()
        guard len = 0
            return -1

        let buf s.get_buffer()
        let b0 *buf

        var code_point: int -1
        var char_len: size_t 0

        ; ASCII: 0xxxxxxx
        guard (b0 & (0x80 as u8)) = (0 as u8)
        {
            set code_point: b0 as int
            set char_len: 1
        }

        ; 2-byte: 110xxxxx 10xxxxxx
        guard char_len = 0
        {
            guard (b0 & (0xE0 as u8)) = (0xC0 as u8)
            {
                guard len >= 2
                {
                    let b1 *(buf + 1)
                    guard (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        let cp (((b0 & (0x1F as u8)) as int) << 6) | ((b1 & (0x3F as u8)) as int)
                        guard cp >= 0x80
                        {
                            set code_point: cp
                            set char_len: 2
                        }
                    }
                }
            }
        }

        ; 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
        guard char_len = 0
        {
            guard (b0 & (0xF0 as u8)) = (0xE0 as u8)
            {
                guard len >= 3
                {
                    let b1 *(buf + 1)
                    let b2 *(buf + 2)
                    guard (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        guard (b2 & (0xC0 as u8)) = (0x80 as u8)
                        {
                            let cp (((b0 & (0x0F as u8)) as int) << 12) | (((b1 & (0x3F as u8)) as int) << 6) | ((b2 & (0x3F as u8)) as int)
                            guard cp >= 0x800
                            {
                                set code_point: cp
                                set char_len: 3
                            }
                        }
                    }
                }
            }
        }

        ; 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        guard char_len = 0
        {
            guard (b0 & (0xF8 as u8)) = (0xF0 as u8)
            {
                guard len >= 4
                {
                    let b1 *(buf + 1)
                    let b2 *(buf + 2)
                    let b3 *(buf + 3)
                    guard (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        guard (b2 & (0xC0 as u8)) = (0x80 as u8)
                        {
                            guard (b3 & (0xC0 as u8)) = (0x80 as u8)
                            {
                                let cp (((b0 & (0x07 as u8)) as int) << 18) | (((b1 & (0x3F as u8)) as int) << 12) | (((b2 & (0x3F as u8)) as int) << 6) | ((b3 & (0x3F as u8)) as int)
                                guard cp >= 0x10000
                                {
                                    guard cp <= 0x10FFFF
                                    {
                                        set code_point: cp
                                        set char_len: 4
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        guard char_len = 0
            return -1

        guard char_len <> len
            return -1

        code_point
    }

    ; id_list_contains: linear scan for a size_t id in a Vector[size_t].
    function id_list_contains(ids: Vector[size_t], needle: size_t) returns bool
    {
        var i: size_t 0
        while i < ids.length
        {
            let p ids.get(i)
            guard p <> null
            {
                guard *p = needle
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; instantiate: dual of generalize. Replace every universally quantified
    ; variable in a TypeScheme with a freshly generated type variable so
    ; the scheme can be used polymorphically at a single call site.
    ;
    ; The C++ Planner gets fresh ids from the owning Plan's counter. Here
    ; we take `next_id_start` as a parameter and allocate sequential ids
    ; from there; the caller is responsible for advancing its counter by
    ; `scheme.quantified.length`.
    function instantiate#(
        rp,
        scheme: TypeScheme,
        next_id_start: size_t
    ) returns PlannedType
    {
        guard scheme.scheme_type = null
            return Planner.make_void_type#()

        let ty (*scheme.scheme_type)

        guard scheme.quantified = null
            return ty

        let quants (*scheme.quantified)
        guard quants.length = 0
            return ty

        ; Allocate stable storage for the fresh TypeVariables so their
        ; addresses can be embedded in the substitution-target PlannedTypes.
        var fresh_vars Vector[TypeVariable]^rp(quants.length)
        var subst_arr Array[KeyValuePair[size_t, PlannedType]]$()
        var i: size_t 0
        while i < quants.length
        {
            let q_ptr quants.get(i)
            guard q_ptr <> null
            {
                let q (*q_ptr)
                fresh_vars.put(i, TypeVariable(next_id_start + i, String^rp("")))
                let fresh_ptr fresh_vars.get(i)
                guard fresh_ptr <> null
                {
                    let new_var_ty PlannedType(
                        Span(0, 0),
                        String^rp(""),
                        String^rp(""),
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        String^rp(""),
                        fresh_ptr
                    )
                    subst_arr.add(KeyValuePair[size_t, PlannedType](q.id, new_var_ty))
                }
            }
            set i: i + 1
        }

        var subst Vector[KeyValuePair[size_t, PlannedType]]^rp(subst_arr)
        Planner.apply_substitution#(ty, &subst)
    }

    ; generalize: promote a type to a type scheme by universally
    ; quantifying every free var that is NOT already free in the
    ; surrounding type environment. This is the operation behind
    ; `let`-polymorphism (ML / Haskell).
    function generalize#(
        rp,
        t: PlannedType,
        free_in_env: Vector[size_t]
    ) returns TypeScheme
    {
        let all_free Planner.free_type_vars#(t)
        var quantified_arr Array[TypeVariable]$()
        var i: size_t 0
        while i < all_free.length
        {
            let id_ptr all_free.get(i)
            guard id_ptr <> null
            {
                let id *id_ptr
                guard Planner.id_list_contains(free_in_env, id) = false
                    quantified_arr.add(TypeVariable(id, String^rp("")))
            }
            set i: i + 1
        }

        var quantified Vector[TypeVariable]^rp(quantified_arr)
        let scheme_t PlannedType#(
            t.loc,
            t.name,
            t.mangled_name,
            t.generics,
            t.life,
            t.origin,
            t.array_size,
            t.variable
        )
        TypeScheme(&quantified, scheme_t)
    }

    ; is_option_vs_void_pointer: does `left` name an Option family type
    ; while `right` is `pointer[void]`? Used by unify to treat the null
    ; literal as the None constructor of any Option type.
    function is_option_vs_void_pointer(left: PlannedType, right: PlannedType) returns bool
    {
        var is_option: bool false
        guard left.name.equals("Option")
            set is_option: true
        guard left.name.starts_with("Option.")
            set is_option: true

        guard is_option = false
            return false

        guard right.name.equals("pointer") = false
            return false

        guard right.generics = null
            return false

        let rg (*right.generics)
        guard rg.length = 0
            return false

        let g0 rg.get(0)
        guard g0 = null
            return false

        (*g0).name.equals("void")
    }

    ; unify: produce the most-general substitution that makes `left` and
    ; `right` structurally equal. Returns null on any failure (occurs
    ; check, name mismatch, arity mismatch). The error channel intentionally
    ; drops the specific reason for now — adding a proper Result/Expected
    ; type is a separate refactor.
    ;
    ; Special cases preserved from Planner.cpp:
    ;   - same variable id                       → empty subst
    ;   - variable vs T (or vice versa)          → bind (with occurs check)
    ;   - void vs anything                       → empty subst
    ;   - compatible integer families            → empty subst
    ;   - Option family vs pointer[void]         → empty subst
    ;   - concrete names equal, arities equal    → recurse on generics
    function unify#(
        rp,
        left: PlannedType,
        right: PlannedType
    ) returns ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    {
        let left_embed left.variable
        let right_embed right.variable

        ; Case 1: both point to the same variable id.
        guard left_embed <> null
        {
            guard right_embed <> null
            {
                let lv (*left_embed)
                let rv (*right_embed)
                guard lv.id = rv.id
                {
                    var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
                    return &empty
                }
            }
        }

        ; Case 2: left is a type variable — bind it to right.
        guard left_embed <> null
        {
            let lv (*left_embed)
            guard Planner.occurs_in(lv.id, right)
                return null
            var s Vector[KeyValuePair[size_t, PlannedType]]^rp(1)
            s.put(0, KeyValuePair[size_t, PlannedType](lv.id, right))
            return &s
        }

        ; Case 3: right is a type variable (left is concrete) — bind it to left.
        guard right_embed <> null
        {
            let rv (*right_embed)
            guard Planner.occurs_in(rv.id, left)
                return null
            var s Vector[KeyValuePair[size_t, PlannedType]]^rp(1)
            s.put(0, KeyValuePair[size_t, PlannedType](rv.id, left))
            return &s
        }

        ; Case 4: both concrete.

        ; `void` unifies with anything (null literal compatibility).
        guard left.name.equals("void")
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
            return &empty
        }
        guard right.name.equals("void")
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
            return &empty
        }

        ; Any pair of integer families unify trivially (the Emitter
        ; inserts the cast).
        guard Planner.are_compatible_integer_types(left.name, right.name)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
            return &empty
        }

        ; null literal (pointer[void]) as the None of any Option type.
        guard Planner.is_option_vs_void_pointer(left, right)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
            return &empty
        }
        guard Planner.is_option_vs_void_pointer(right, left)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
            return &empty
        }

        ; Names must match.
        guard left.name.equals(right.name) = false
            return null

        ; Arities must match.
        var l_len: size_t 0
        var r_len: size_t 0
        guard left.generics <> null
        {
            let lg (*left.generics)
            set l_len: lg.length
        }
        guard right.generics <> null
        {
            let rg (*right.generics)
            set r_len: rg.length
        }
        guard l_len <> r_len
            return null

        ; Unify generic args pairwise, composing substitutions.
        var result Vector[KeyValuePair[size_t, PlannedType]]^rp(0)
        guard left.generics <> null
        {
            guard right.generics <> null
            {
                let lg (*left.generics)
                let rg (*right.generics)
                var i: size_t 0
                while i < l_len
                {
                    let lg_ptr lg.get(i)
                    let rg_ptr rg.get(i)
                    guard lg_ptr <> null
                    {
                        guard rg_ptr <> null
                        {
                            let lgv (*lg_ptr)
                            let rgv (*rg_ptr)
                            let sub Planner.unify#(lgv, rgv)
                            guard sub = null
                                return null

                            set result: Planner.compose_substitutions#(result, (*sub))
                        }
                    }
                    set i: i + 1
                }
            }
        }

        &result
    }

    ; solve_constraints: classical HM solver. Walk the constraint list
    ; in order, applying the current solution to each constraint's sides,
    ; unifying them, and composing the new substitution into the solution.
    ; Instance (trait) constraints are skipped — matches the TODO in
    ; Planner.cpp. Returns null on any unification failure.
    function solve_constraints#(
        rp,
        constraints: ref[Vector[TypeConstraint]]?
    ) returns ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    {
        var solution Vector[KeyValuePair[size_t, PlannedType]]^rp(0)

        guard constraints = null
            return &solution

        let cs (*constraints)
        var i: size_t 0
        while i < cs.length
        {
            let c_ptr cs.get(i)
            guard c_ptr <> null
            {
                let c (*c_ptr)
                let new_solution choose c
                    when eq: EqualityConstraint
                    {
                        let left_applied Planner.apply_substitution#(eq.left, &solution)
                        let right_applied Planner.apply_substitution#(eq.right, &solution)
                        let sub Planner.unify#(left_applied, right_applied)
                        guard sub = null
                            return null

                        Planner.compose_substitutions#(solution, (*sub))
                    }
                    when inst: InstanceConstraint
                        solution
                set solution: new_solution
            }
            set i: i + 1
        }

        &solution
    }

    ; compose_substitutions: S2 ∘ S1 — apply S1 first, then S2.
    ; Equivalent to the C++ `composeSubstitutions`:
    ;   Result = S2 ⊎ { (id, apply(T, S2)) | (id, T) ∈ S1 }
    ; with S1's entries winning on duplicate ids (since the C++ map
    ; assignment overwrites). We implement the dedup by first emitting
    ; every S1 entry with its S2-applied value, then appending only the
    ; S2 entries whose id did not already appear in S1.
    function compose_substitutions#(
        rp,
        s1: Vector[KeyValuePair[size_t, PlannedType]],
        s2: Vector[KeyValuePair[size_t, PlannedType]]
    ) returns Vector[KeyValuePair[size_t, PlannedType]]
    {
        var temp Array[KeyValuePair[size_t, PlannedType]]$()

        var i: size_t 0
        while i < s1.length
        {
            let ptr s1.get(i)
            guard ptr <> null
            {
                let kvp (*ptr)
                let applied Planner.apply_substitution#(kvp.value, &s2)
                temp.add(KeyValuePair[size_t, PlannedType](kvp.key, applied))
            }
            set i: i + 1
        }

        var j: size_t 0
        while j < s2.length
        {
            let ptr s2.get(j)
            guard ptr <> null
            {
                let kvp (*ptr)
                let already Planner.substitution_lookup(s1, kvp.key)
                guard already = null
                    temp.add(kvp)
            }
            set j: j + 1
        }

        Vector[KeyValuePair[size_t, PlannedType]]^rp(temp)
    }

    ; occurs_in: does a type variable with the given id appear anywhere in
    ; `t` (or its recursive generic arguments)? The occurs check prevents
    ; the unifier from constructing infinite types like T ~ List[T].
    function occurs_in(var_id: size_t, t: PlannedType) returns bool
    {
        guard t.variable <> null
        {
            let tv (*t.variable)
            guard tv.id = var_id
                return true
        }
        guard t.generics <> null
        {
            let gens (*t.generics)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get(i)
                guard g_ptr <> null
                {
                    let g (*g_ptr)
                    guard Planner.occurs_in(var_id, g)
                        return true
                }
                set i: i + 1
            }
        }
        false
    }

    ; are_compatible_integer_types: trivial wrapper around is_integer_type.
    ; Kept as a named predicate so call sites read like their C++ counterparts.
    function are_compatible_integer_types(left: String, right: String) returns bool
    {
        guard Planner.is_integer_type(left) = false
            return false
        Planner.is_integer_type(right)
    }

    ; ========================================================================
    ; Operator identification.
    ; ========================================================================

    ; is_operator_name: does this identifier look like an operator definition?
    ; Mirrors Planner.cpp — the one "name-shaped" exception is `abs`, which
    ; the grammar exposes as a unary prefix operator despite being spelled
    ; alphabetically. Everything else keys off the first byte.
    function is_operator_name(name: String) returns bool
    {
        guard name.get_length() = 0
            return false

        guard name.equals("abs")
            return true

        let first name.get(0)
        guard first = ("+" as u8)
            return true
        guard first = ("-" as u8)
            return true
        guard first = ("*" as u8)
            return true
        guard first = ("/" as u8)
            return true
        guard first = ("%" as u8)
            return true
        guard first = ("=" as u8)
            return true
        guard first = ("<" as u8)
            return true
        guard first = (">" as u8)
            return true
        guard first = ("!" as u8)
            return true
        guard first = ("&" as u8)
            return true
        guard first = ("|" as u8)
            return true
        guard first = ("^" as u8)
            return true
        guard first = ("~" as u8)
            return true
        guard first = ("[" as u8)
            return true
        guard first = ("(" as u8)
            return true
        false
    }

    ; get_operator_precedence: higher = binds tighter. Mirrors
    ; Planner.cpp:1418-1431 exactly. Used by collapse_operand_sequence#
    ; to climb precedence so `A <> X & B <> Y` collapses as
    ; `(A <> X) & (B <> Y)` rather than `((A <> X) & B) <> Y`.
    function get_operator_precedence(name: String) returns int
    {
        guard name.equals("||")
            return 1
        guard name.equals("&&")
            return 2
        guard name.equals("|")
            return 3
        guard name.equals("^")
            return 4
        guard name.equals("&")
            return 5
        guard name.equals("=")
            return 6
        guard name.equals("<>")
            return 6
        guard name.equals("<")
            return 7
        guard name.equals(">")
            return 7
        guard name.equals("<=")
            return 7
        guard name.equals(">=")
            return 7
        guard name.equals("<<")
            return 8
        guard name.equals(">>")
            return 8
        guard name.equals("+")
            return 9
        guard name.equals("-")
            return 9
        guard name.equals("*")
            return 10
        guard name.equals("/")
            return 10
        guard name.equals("%")
            return 10
        guard name.equals("div")
            return 10
        guard name.equals("mod")
            return 10
        0
    }

    ; ========================================================================
    ; Function-signature helpers.
    ; ========================================================================

    ; join_dotted_name: "scaly" / "containers" / "String" -> "scaly.containers.String".
    ; Matches the Planner.cpp logic that collapses a Type.Name Vector into
    ; one canonical dotted identifier for primitive/generic-param checks.
    function join_dotted_name#(rp, parts: Vector[String]) returns String
    {
        var sb StringBuilder$()
        ; Defensive: bail early if the Vector layout is corrupted —
        ; length>0 with data=null. Some Type.name vectors picked up
        ; via plan_type → resolve_type_base end up in this state once
        ; stage-1 walks Planner.scaly, and Vector.get computes
        ; data + i, returning a non-null but invalid 0x8 pointer for
        ; i>0 (caller's null-check passes, then the deref SEGVs).
        guard parts.length > 0
        {
            guard parts.data = null
                return sb.to_string^rp()
        }
        var i: size_t 0
        while i < parts.length
        {
            guard i > 0
                sb.append(".")

            let p_ptr parts.get(i)
            guard p_ptr <> null
                sb.append((*p_ptr))

            set i: i + 1
        }
        sb.to_string^rp()
    }

    ; is_extern_impl: detect the Extern variant of Implementation without
    ; leaking a bare choose into the caller's control flow.
    function is_extern_impl(impl: Implementation) returns bool
    {
        choose impl
            when e: Extern
                true
            else
                false
    }

    ; is_generic_type_param_name: single ASCII uppercase letter — how the
    ; grammar encodes a type parameter like `T`, `K`, `V`. Such names
    ; don't get an implicit return page because the instantiator picks
    ; the real type later.
    function is_generic_type_param_name(name: String) returns bool
    {
        guard name.get_length() = 1
        {
            let c name.get(0)
            guard c >= (65 as u8)
            {
                guard c <= (90 as u8)
                    return true
            }
        }
        false
    }

    ; needs_implicit_return_page: does a function whose return type is
    ; known-non-primitive need an implicit page parameter so the caller
    ; can allocate the returned struct?
    ;
    ; Matches Planner.cpp exactly except for the leading `PageParameter`
    ; check — Scaly's Model.Function does not (yet) record whether a
    ; function was declared with `#`; treat every function uniformly for
    ; now. Extern functions bail early because they don't participate in
    ; RBMM.
    function needs_implicit_return_page(func: Function) returns bool
    {
        guard Planner.is_extern_impl(func.implementation)
            return false

        guard func.returns_ = null
            return false

        let ret_type (*func.returns_)
        guard ret_type.name.length = 0
            return false

        let joined Planner.join_dotted_name$(ret_type.name)
        guard Planner.is_primitive_type_name(joined)
            return false

        guard Planner.is_generic_type_param_name(joined)
            return false

        true
    }

    ; ========================================================================
    ; Argument-list helpers.
    ; ========================================================================

    ; Collect the result_type of every operand inside a tuple-shaped operand.
    ; Split out so extract_arg_types can dispatch via a simple choose without
    ; a nested side-effecting match expression.
    function extract_tuple_arg_types#(rp, tuple_val: PlannedTuple) returns Vector[PlannedType]
    {
        var temp Array[PlannedType]$()
        guard tuple_val.components <> null
        {
            let comps (*tuple_val.components)
            var i: size_t 0
            while i < comps.length
            {
                let c_ptr comps.get(i)
                guard c_ptr <> null
                {
                    let c (*c_ptr)
                    guard c.value <> null
                    {
                        let vals (*c.value)
                        var j: size_t 0
                        while j < vals.length
                        {
                            let v_ptr vals.get(j)
                            guard v_ptr <> null
                            {
                                let v (*v_ptr)
                                temp.add(v.result_type)
                            }
                            set j: j + 1
                        }
                    }
                }
                set i: i + 1
            }
        }
        Vector[PlannedType]^rp(temp)
    }

    ; extract_arg_types: flatten a function-call argument list (modelled as a
    ; tuple of components) into a plain Vector of argument result types.
    ; A non-tuple operand falls back to its own result_type as a single arg —
    ; the parser may elide the tuple around a single-argument call like
    ; `f(x)` where `x` is already a complete operand.
    function extract_arg_types#(rp, args_op: PlannedOperand) returns Vector[PlannedType]
    {
        choose args_op.expr
            when t: PlannedTuple
                Planner.extract_tuple_arg_types#(t)
            else
                Vector[PlannedType](null as pointer[PlannedType], 0 as size_t)
    }

    ; ========================================================================
    ; Constant type inference.
    ; ========================================================================

    ; Helper: build a pointer[i8]-typed PlannedType — the representation of
    ; C-style string literals. Shared by StringConstant and FragmentConstant.
    function make_cstring_type#(rp, sp: Span) returns PlannedType
    {
        var gens Vector[PlannedType]^rp(1)
        let i8_ty PlannedType(
            sp,
            String^rp("i8"),
            String^rp("a"),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
        gens.put(0, i8_ty)
        PlannedType(
            sp,
            String^rp("pointer"),
            String^rp("Pa"),
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
    }

    ; Helper: pointer[void] for the null literal. The constraint solver is
    ; expected to unify this with whatever pointer-like type is required
    ; at the use-site.
    function make_null_type#(rp, sp: Span) returns PlannedType
    {
        var gens Vector[PlannedType]^rp(1)
        let void_ty PlannedType(
            sp,
            String^rp("void"),
            String^rp("v"),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
        gens.put(0, void_ty)
        PlannedType(
            sp,
            String^rp("pointer"),
            String^rp("Pv"),
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String^rp(""),
            null
        )
    }

    ; infer_constant_type: map a Constant variant to the PlannedType assigned
    ; to that literal before the constraint solver runs. Primitive families
    ; carry the Itanium one-letter codes directly; string/fragment/null
    ; delegate to the helpers above.
    function infer_constant_type#(rp, c: Constant) returns PlannedType
    {
        choose c
            when b: BooleanConstant
                PlannedType(
                    b.span,
                    String^rp("bool"),
                    String^rp("b"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
            when i: IntegerConstant
                PlannedType(
                    i.span,
                    String^rp("int"),
                    String^rp("i"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
            when h: HexConstant
                PlannedType(
                    h.span,
                    String^rp("u64"),
                    String^rp("u64"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
            when f: FloatingPointConstant
                PlannedType(
                    f.span,
                    String^rp("f64"),
                    String^rp("f64"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
            when ch: CharacterConstant
                PlannedType(
                    ch.span,
                    String^rp("char"),
                    String^rp("c"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
            when s: StringConstant
                Planner.make_cstring_type#(s.span)
            when fr: FragmentConstant
                Planner.make_cstring_type#(fr.span)
            when n: NullConstant
                Planner.make_null_type#(n.span)
    }

    ; get_pointer_element_type: return the element type T for pointer[T],
    ; ref[T], Option[pointer[T]], or Option[ref[T]]. Everything else
    ; yields null.
    ;
    ; Planner.cpp also has a "flattened" Option.ref.X fast path to cope
    ; with how monomorphisation mangles nested generics into the name.
    ; That path is a fragile heuristic; leaving it out until we actually
    ; hit a case that needs it.
    function get_pointer_element_type(ptr_type: PlannedType) returns ref[PlannedType]?
    {
        guard ptr_type.name.equals("pointer")
        {
            guard ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                guard gens.length > 0
                    return gens.get(0)
            }
        }
        guard ptr_type.name.equals("ref")
        {
            guard ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                guard gens.length > 0
                    return gens.get(0)
            }
        }
        guard ptr_type.name.equals("Option")
        {
            guard ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                guard gens.length > 0
                {
                    let inner_ptr gens.get(0)
                    guard inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        guard inner.name.equals("pointer")
                        {
                            guard inner.generics <> null
                            {
                                let ig (*inner.generics)
                                guard ig.length > 0
                                    return ig.get(0)
                            }
                        }
                        guard inner.name.equals("ref")
                        {
                            guard inner.generics <> null
                            {
                                let ig (*inner.generics)
                                guard ig.length > 0
                                    return ig.get(0)
                            }
                        }
                    }
                }
            }
        }
        null
    }

    ; get_operator_precedence: higher wins. Returns 0 for unknown operators
    ; so the caller can distinguish "unbound" from explicit parenthesisation.
    ; Scaly uses `=` / `<>` (equal / not-equal) instead of C's `==` / `!=`.
    function get_operator_precedence(op: String) returns int
    {
        guard op.equals("||")
            return 1
        guard op.equals("&&")
            return 2
        guard op.equals("|")
            return 3
        guard op.equals("^")
            return 4
        guard op.equals("&")
            return 5
        guard op.equals("=")
            return 6
        guard op.equals("<>")
            return 6
        guard op.equals("<")
            return 7
        guard op.equals(">")
            return 7
        guard op.equals("<=")
            return 7
        guard op.equals(">=")
            return 7
        guard op.equals("<<")
            return 8
        guard op.equals(">>")
            return 8
        guard op.equals("+")
            return 9
        guard op.equals("-")
            return 9
        guard op.equals("*")
            return 10
        guard op.equals("/")
            return 10
        guard op.equals("%")
            return 10
        guard op.equals("div")
            return 10
        guard op.equals("mod")
            return 10
        0
    }

    ; size_to_string: decimal representation of a size_t.
    ; Classic divide-by-10 with digit buffer and reversal.
    function size_to_string(n: size_t) returns String
    {
        guard n = 0
            return String#("0")

        let result StringBuilder#()
        var value n
        var digits Array[char]$()

        while value > 0
        {
            let digit ((value % 10) as char) + 48 as char
            digits.add(digit)
            set value: value / 10
        }

        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get(i)
            guard d <> null
                result.append(*d)

        }

        result.to_string#()
    }

    ; ========================================================================
    ; Test entry point, exercised by compiler.test().
    ; Returns 0 on pass, non-zero diagnostic code on failure.
    ; Only touches real helpers — never calls a stub (that would exit 111).
    ; ========================================================================

    function test() returns int
    {
        ; size_to_string - smallest self-contained helper.
        let str0 Planner.size_to_string(0)
        guard str0.equals(String$("0")) = false
            return 1

        let str4 Planner.size_to_string(4)
        guard str4.equals(String$("4")) = false
            return 2

        let str42 Planner.size_to_string(42)
        guard str42.equals(String$("42")) = false
            return 3

        ; encode_name - depends on size_to_string.
        let encoded Planner.encode_name(String$("test"))
        guard encoded.equals(String$("4test")) = false
            return 4

        let encoded2 Planner.encode_name(String$(""))
        guard encoded2.equals(String$("0")) = false
            return 5

        ; strip_package_prefix - only strips when it starts with "scaly."
        let stripped Planner.strip_package_prefix$(String$("scaly.containers.String"))
        guard stripped.equals(String$("String")) = false
            return 6

        let unstripped Planner.strip_package_prefix$(String$("scalyc.compiler.Planner"))
        guard unstripped.equals(String$("scalyc.compiler.Planner")) = false
            return 7

        ; encode_type - built-in primitive codes.
        let int_ty PlannedType(
            Span(0, 0),
            String$("int"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let enc_int Planner.encode_type$(int_ty)
        guard enc_int.equals(String$("i")) = false
            return 8

        let bool_ty PlannedType(
            Span(0, 0),
            String$("bool"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let enc_bool Planner.encode_type$(bool_ty)
        guard enc_bool.equals(String$("b")) = false
            return 9

        ; encode_type - user-defined falls through to encode_name.
        let foo_ty PlannedType(
            Span(0, 0),
            String$("Foo"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let enc_foo Planner.encode_type$(foo_ty)
        guard enc_foo.equals(String$("3Foo")) = false
            return 10

        ; encode_type - "scaly.containers.String" -> "6String" (prefix stripped).
        let sstr_ty PlannedType(
            Span(0, 0),
            String$("scaly.containers.String"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let enc_sstr Planner.encode_type$(sstr_ty)
        guard enc_sstr.equals(String$("6String")) = false
            return 11

        ; mangle_type - "_Z" prefix + encoded type.
        let mangled_int Planner.mangle_type$(int_ty)
        guard mangled_int.equals(String$("_Zi")) = false
            return 12

        let mangled_foo Planner.mangle_type$(foo_ty)
        guard mangled_foo.equals(String$("_Z3Foo")) = false
            return 13

        ; mangle_structure - no generics falls back to encode_name.
        let mangled_s Planner.mangle_structure$(String$("String"), null)
        guard mangled_s.equals(String$("_Z6String")) = false
            return 14

        ; mangle_structure with one int generic arg: Vector[int] -> _Z6VectorIiE.
        var gens_vec Vector[PlannedType]$(1)
        gens_vec.put(0, int_ty)
        let mangled_vec Planner.mangle_structure$(String$("Vector"), &gens_vec)
        guard mangled_vec.equals(String$("_Z6VectorIiE")) = false
            return 15

        ; mangle_function - free, no params -> _Z3foov.
        let mf_free Planner.mangle_function$(String$("foo"), null, null, false)
        guard mf_free.equals(String$("_Z3foov")) = false
            return 16

        ; mangle_function - method on Foo, no params -> _ZN3Foo3fooEv.
        let mf_method Planner.mangle_function$(String$("foo"), null, &foo_ty, false)
        guard mf_method.equals(String$("_ZN3Foo3fooEv")) = false
            return 17

        ; mangle_function - 'this' is implicit; drops out of the name.
        let this_name String$("this")
        var this_only Vector[PlannedItem]$(1)
        this_only.put(0, PlannedItem(Span(0, 0), false, &this_name, &foo_ty, null))
        let mf_this Planner.mangle_function$(String$("bar"), &this_only, &foo_ty, false)
        guard mf_this.equals(String$("_ZN3Foo3barEv")) = false
            return 18

        ; mangle_function with implicit page param.
        let mf_page Planner.mangle_function$(String$("foo"), null, null, true)
        guard mf_page.equals(String$("_Z3fooPN4scaly6memory4PageE")) = false
            return 19

        ; mangle_function - free with int param -> _Z3fooi.
        let x_name String$("x")
        var one_int Vector[PlannedItem]$(1)
        one_int.put(0, PlannedItem(Span(0, 0), false, &x_name, &int_ty, null))
        let mf_i Planner.mangle_function$(String$("foo"), &one_int, null, false)
        guard mf_i.equals(String$("_Z3fooi")) = false
            return 20

        ; operator_code - a few known codes plus vendor extension.
        let op_plus Planner.operator_code$(String$("+"))
        guard op_plus.equals(String$("pl")) = false
            return 21

        let op_index Planner.operator_code$(String$("[]"))
        guard op_index.equals(String$("ix")) = false
            return 22

        let op_vendor Planner.operator_code$(String$("??"))
        guard op_vendor.equals(String$("v02??")) = false
            return 23

        ; mangle_operator - free + with int param -> _Zpli.
        let mop_plus Planner.mangle_operator$(String$("+"), &one_int, null)
        guard mop_plus.equals(String$("_Zpli")) = false
            return 24

        ; mangle_operator - member + on Foo with (this, int) -> _ZN3FooplEi.
        var this_int Vector[PlannedItem]$(2)
        this_int.put(0, PlannedItem(Span(0, 0), false, &this_name, &foo_ty, null))
        this_int.put(1, PlannedItem(Span(0, 0), false, &x_name, &int_ty, null))
        let mop_member Planner.mangle_operator$(String$("+"), &this_int, &foo_ty)
        guard mop_member.equals(String$("_ZN3FooplEi")) = false
            return 25

        ; mangle_operator - member with only 'this' -> _ZN3FooneEv (the 'this' skip).
        let mop_this Planner.mangle_operator$(String$("!="), &this_only, &foo_ty)
        guard mop_this.equals(String$("_ZN3FooneEv")) = false
            return 26

        ; get_readable_name - plain type, no generics.
        let rn_int Planner.get_readable_name$(int_ty)
        guard rn_int.equals(String$("int")) = false
            return 27

        ; get_readable_name - generic: Vector[int] -> "Vector[int]".
        var vec_gens Vector[PlannedType]$(1)
        vec_gens.put(0, int_ty)
        let vec_ty PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let rn_vec Planner.get_readable_name$(vec_ty)
        guard rn_vec.equals(String$("Vector[int]")) = false
            return 28

        ; normalize_type_name - builtin aliases collapse.
        let nm_int Planner.normalize_type_name$(String$("int"))
        guard nm_int.equals(String$("i64")) = false
            return 29

        let nm_size Planner.normalize_type_name$(String$("size_t"))
        guard nm_size.equals(String$("u64")) = false
            return 30

        let nm_char Planner.normalize_type_name$(String$("char"))
        guard nm_char.equals(String$("u8")) = false
            return 31

        ; normalize_type_name - "scaly.containers.String" -> "String".
        let nm_sstr Planner.normalize_type_name$(String$("scaly.containers.String"))
        guard nm_sstr.equals(String$("String")) = false
            return 32

        ; normalize_type_name - user types pass through.
        let nm_user Planner.normalize_type_name$(String$("scalyc.compiler.Planner"))
        guard nm_user.equals(String$("scalyc.compiler.Planner")) = false
            return 33

        ; types_equal - identical primitives.
        guard Planner.types_equal(int_ty, int_ty) = false
            return 34

        ; types_equal - int == i64 via normalization.
        let i64_ty PlannedType(
            Span(0, 0),
            String$("i64"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_equal(int_ty, i64_ty) = false
            return 35

        ; types_equal - different primitives.
        guard Planner.types_equal(int_ty, bool_ty)
            return 36

        ; types_equal - structurally equal generics.
        var vec_gens2 Vector[PlannedType]$(1)
        vec_gens2.put(0, int_ty)
        let vec_ty2 PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_gens2,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_equal(vec_ty, vec_ty2) = false
            return 37

        ; types_equal - same outer name, different generic arg.
        var vec_gens_b Vector[PlannedType]$(1)
        vec_gens_b.put(0, bool_ty)
        let vec_bool_ty PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_gens_b,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_equal(vec_ty, vec_bool_ty)
            return 38

        ; is_integer_type - a couple of positive and negative cases.
        guard Planner.is_integer_type(String$("i64")) = false
            return 39
        guard Planner.is_integer_type(String$("bool"))
            return 40

        ; types_compatible - exact equality.
        guard Planner.types_compatible(int_ty, int_ty) = false
            return 41

        ; types_compatible - integer coercion (int <-> i64 is already equal,
        ;                                      so pair a distinct integer family).
        let u32_ty PlannedType(
            Span(0, 0),
            String$("u32"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_compatible(int_ty, u32_ty) = false
            return 42

        ; types_compatible - non-integer mismatch is rejected.
        guard Planner.types_compatible(int_ty, bool_ty)
            return 43

        ; types_compatible - pointer[int] arg can pass where int expected (implicit deref).
        var ptr_int_gens Vector[PlannedType]$(1)
        ptr_int_gens.put(0, int_ty)
        let ptr_int_ty PlannedType(
            Span(0, 0),
            String$("pointer"),
            String$(""),
            &ptr_int_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_compatible(int_ty, ptr_int_ty) = false
            return 44

        ; types_compatible - pointer[void] accepts any pointer.
        let void_ty PlannedType(
            Span(0, 0),
            String$("void"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        var ptr_void_gens Vector[PlannedType]$(1)
        ptr_void_gens.put(0, void_ty)
        let ptr_void_ty PlannedType(
            Span(0, 0),
            String$("pointer"),
            String$(""),
            &ptr_void_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_compatible(ptr_void_ty, ptr_int_ty) = false
            return 45

        ; types_compatible - pointer[const_char] <- pointer[i8] (Rule 5).
        let const_char_ty PlannedType(
            Span(0, 0),
            String$("const_char"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let i8_ty PlannedType(
            Span(0, 0),
            String$("i8"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        var ptr_cc_gens Vector[PlannedType]$(1)
        ptr_cc_gens.put(0, const_char_ty)
        let ptr_cc_ty PlannedType(
            Span(0, 0),
            String$("pointer"),
            String$(""),
            &ptr_cc_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        var ptr_i8_gens Vector[PlannedType]$(1)
        ptr_i8_gens.put(0, i8_ty)
        let ptr_i8_ty PlannedType(
            Span(0, 0),
            String$("pointer"),
            String$(""),
            &ptr_i8_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_compatible(ptr_cc_ty, ptr_i8_ty) = false
            return 46

        ; types_compatible - Option accepts null (pointer[void]).
        let option_ty PlannedType(
            Span(0, 0),
            String$("Option"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.types_compatible(option_ty, ptr_void_ty) = false
            return 47

        ; is_operator_name - operator chars and 'abs' are operators.
        guard Planner.is_operator_name(String$("+")) = false
            return 48
        guard Planner.is_operator_name(String$("abs")) = false
            return 49
        guard Planner.is_operator_name(String$("foo"))
            return 50
        guard Planner.is_operator_name(String$(""))
            return 51

        ; get_operator_precedence - canonical ranks plus the 'unknown' zero.
        guard Planner.get_operator_precedence(String$("||")) <> 1
            return 52
        guard Planner.get_operator_precedence(String$("*")) <> 10
            return 53
        guard Planner.get_operator_precedence(String$("<>")) <> 6
            return 54
        guard Planner.get_operator_precedence(String$("???")) <> 0
            return 55

        ; get_pointer_element_type - pointer[int] -> int.
        let pe_int Planner.get_pointer_element_type(ptr_int_ty)
        guard pe_int = null
            return 56
        let pe_int_v (*pe_int)
        guard pe_int_v.name.equals("int") = false
            return 57

        ; get_pointer_element_type - non-pointer returns null.
        let pe_none Planner.get_pointer_element_type(int_ty)
        guard pe_none <> null
            return 58

        ; get_pointer_element_type - Option[pointer[int]] -> int.
        var opt_gens Vector[PlannedType]$(1)
        opt_gens.put(0, ptr_int_ty)
        let opt_ptr_int_ty PlannedType(
            Span(0, 0),
            String$("Option"),
            String$(""),
            &opt_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let pe_opt Planner.get_pointer_element_type(opt_ptr_int_ty)
        guard pe_opt = null
            return 59
        let pe_opt_v (*pe_opt)
        guard pe_opt_v.name.equals("int") = false
            return 60

        ; infer_constant_type - booleans yield "bool".
        let c_bool Constant.Boolean(BooleanConstant(Span(0, 0), true))
        let t_bool Planner.infer_constant_type$(c_bool)
        guard t_bool.name.equals("bool") = false
            return 61

        ; infer_constant_type - integer literal is "int" (pre-solver).
        let c_int Constant.Integer(IntegerConstant(Span(0, 0), 42))
        let t_int Planner.infer_constant_type$(c_int)
        guard t_int.name.equals("int") = false
            return 62
        guard t_int.mangled_name.equals("i") = false
            return 63

        ; infer_constant_type - hex literal is u64.
        let c_hex Constant.Hex(HexConstant(Span(0, 0), 255))
        let t_hex Planner.infer_constant_type$(c_hex)
        guard t_hex.name.equals("u64") = false
            return 64

        ; infer_constant_type - string literal is pointer[i8] (Itanium "Pa").
        let c_str Constant.String(StringConstant(Span(0, 0), String$("hi")))
        let t_str Planner.infer_constant_type$(c_str)
        guard t_str.name.equals("pointer") = false
            return 65
        guard t_str.mangled_name.equals("Pa") = false
            return 66
        guard t_str.generics = null
            return 67

        ; infer_constant_type - null literal is pointer[void].
        let c_null Constant.Null(NullConstant(Span(0, 0)))
        let t_null Planner.infer_constant_type$(c_null)
        guard t_null.name.equals("pointer") = false
            return 68
        guard t_null.mangled_name.equals("Pv") = false
            return 69

        ; extract_arg_types - non-tuple operand yields empty Vector.
        let plain_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type(int_ty),
            null,
            int_ty
        )
        let empty_types Planner.extract_arg_types$(plain_op)
        guard empty_types.length <> 0
            return 70

        ; extract_arg_types - tuple of two components (int, bool) yields [int, bool].
        let int_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type(int_ty),
            null,
            int_ty
        )
        let bool_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type(bool_ty),
            null,
            bool_ty
        )
        var v1 Vector[PlannedOperand]$(1)
        v1.put(0, int_op)
        var v2 Vector[PlannedOperand]$(1)
        v2.put(0, bool_op)
        var comps Vector[PlannedComponent]$(2)
        comps.put(0, PlannedComponent(Span(0, 0), null, &v1, null))
        comps.put(1, PlannedComponent(Span(0, 0), null, &v2, null))
        let tpl PlannedTuple(
            Span(0, 0),
            &comps,
            int_ty,
            false,
            Lifetime.Unspecified(Unspecified()),
            null
        )
        let tuple_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Tuple(tpl),
            null,
            int_ty
        )
        let two_types Planner.extract_arg_types$(tuple_op)
        guard two_types.length <> 2
            return 71
        let t0 two_types.get(0)
        guard t0 = null
            return 72
        let t0v (*t0)
        guard t0v.name.equals("int") = false
            return 73
        let t1 two_types.get(1)
        guard t1 = null
            return 74
        let t1v (*t1)
        guard t1v.name.equals("bool") = false
            return 75

        ; is_primitive_type_name - representative cases.
        guard Planner.is_primitive_type_name(String$("int")) = false
            return 76
        guard Planner.is_primitive_type_name(String$("pointer")) = false
            return 77
        guard Planner.is_primitive_type_name(String$("Foo"))
            return 78

        ; get_primitive_alignment - bool/char -> 1, int -> 8 (i64),
        ; default 8. Matches stage-0 (Planner.cpp:960) for sizeof
        ; consistency.
        guard Planner.get_primitive_alignment(String$("bool")) <> 1
            return 79
        guard Planner.get_primitive_alignment(String$("int")) <> 8
            return 80
        guard Planner.get_primitive_alignment(String$("String")) <> 8
            return 81

        ; align_offset - round up to nearest power-of-two multiple.
        guard Planner.align_offset(0, 8) <> 0
            return 82
        guard Planner.align_offset(1, 8) <> 8
            return 83
        guard Planner.align_offset(9, 4) <> 12
            return 84
        guard Planner.align_offset(16, 8) <> 16
            return 85

        ; occurs_in - a var id not present in a concrete type.
        guard Planner.occurs_in(7, int_ty)
            return 86

        ; occurs_in - direct hit on the top-level variable.
        let tv7 TypeVariable(7, String$("T"))
        let var_ty PlannedType(
            Span(0, 0),
            String$("T"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            &tv7
        )
        guard Planner.occurs_in(7, var_ty) = false
            return 87

        ; occurs_in - hidden inside a generic argument.
        var vec_with_var Vector[PlannedType]$(1)
        vec_with_var.put(0, var_ty)
        let vec_of_t_ty PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_with_var,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.occurs_in(7, vec_of_t_ty) = false
            return 88
        guard Planner.occurs_in(99, vec_of_t_ty)
            return 89

        ; are_compatible_integer_types - both integer -> true, one not -> false.
        guard Planner.are_compatible_integer_types(String$("int"), String$("u64")) = false
            return 90
        guard Planner.are_compatible_integer_types(String$("int"), String$("bool"))
            return 91

        ; join_dotted_name - joins a Vector[String] with dots.
        var parts Vector[String]$(3)
        parts.put(0, String$("scaly"))
        parts.put(1, String$("containers"))
        parts.put(2, String$("String"))
        let joined Planner.join_dotted_name$(parts)
        guard joined.equals(String$("scaly.containers.String")) = false
            return 92

        ; is_generic_type_param_name - single uppercase letter.
        guard Planner.is_generic_type_param_name(String$("T")) = false
            return 93
        guard Planner.is_generic_type_param_name(String$("Foo"))
            return 94
        guard Planner.is_generic_type_param_name(String$("t"))
            return 95

        ; needs_implicit_return_page - extern returns false regardless.
        let extern_func Function(
            Span(0, 0),
            false,
            false,
            String$("foo"),
            Vector[GenericParameter]$(0),
            null,
            Vector[Item]$(0),
            null,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Extern(Extern(Span(0, 0)))
        )
        guard Planner.needs_implicit_return_page(extern_func)
            return 96

        ; needs_implicit_return_page - void return (null) -> false.
        let void_func Function(
            Span(0, 0),
            false,
            false,
            String$("bar"),
            Vector[GenericParameter]$(0),
            null,
            Vector[Item]$(0),
            null,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        guard Planner.needs_implicit_return_page(void_func)
            return 97

        ; needs_implicit_return_page - returns primitive "int" -> false.
        var int_return_parts Vector[String]$(1)
        int_return_parts.put(0, String$("int"))
        let int_return_ty Type(
            Span(0, 0),
            int_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let int_ret_func Function(
            Span(0, 0),
            false,
            false,
            String$("baz"),
            Vector[GenericParameter]$(0),
            null,
            Vector[Item]$(0),
            &int_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        guard Planner.needs_implicit_return_page(int_ret_func)
            return 98

        ; needs_implicit_return_page - returns generic param "T" -> false.
        var t_return_parts Vector[String]$(1)
        t_return_parts.put(0, String$("T"))
        let t_return_ty Type(
            Span(0, 0),
            t_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let t_ret_func Function(
            Span(0, 0),
            false,
            false,
            String$("qux"),
            Vector[GenericParameter]$(0),
            null,
            Vector[Item]$(0),
            &t_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        guard Planner.needs_implicit_return_page(t_ret_func)
            return 99

        ; needs_implicit_return_page - returns "Foo" (user type) -> true.
        var foo_return_parts Vector[String]$(1)
        foo_return_parts.put(0, String$("Foo"))
        let foo_return_ty Type(
            Span(0, 0),
            foo_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let foo_ret_func Function(
            Span(0, 0),
            false,
            false,
            String$("make_foo"),
            Vector[GenericParameter]$(0),
            null,
            Vector[Item]$(0),
            &foo_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        guard Planner.needs_implicit_return_page(foo_ret_func) = false
            return 100

        ; apply_substitution - null substitution leaves type unchanged.
        let sub_int Planner.apply_substitution$(int_ty, null)
        guard sub_int.name.equals("int") = false
            return 101

        ; apply_substitution - unbound variable stays as-is.
        var empty_sub Vector[KeyValuePair[size_t, PlannedType]]$(0)
        let sub_var Planner.apply_substitution$(var_ty, &empty_sub)
        guard sub_var.variable = null
            return 102

        ; apply_substitution - bound variable gets replaced.
        var sub1 Vector[KeyValuePair[size_t, PlannedType]]$(1)
        sub1.put(0, KeyValuePair[size_t, PlannedType](7, int_ty))
        let sub_hit Planner.apply_substitution$(var_ty, &sub1)
        guard sub_hit.name.equals("int") = false
            return 103

        ; apply_substitution - substitutes inside generic arguments.
        let sub_vec Planner.apply_substitution$(vec_of_t_ty, &sub1)
        guard sub_vec.name.equals("Vector") = false
            return 104
        guard sub_vec.generics = null
            return 105
        let sub_vec_gens (*sub_vec.generics)
        guard sub_vec_gens.length <> 1
            return 106
        let sub_vec_g0 sub_vec_gens.get(0)
        guard sub_vec_g0 = null
            return 107
        let sub_vec_g0v (*sub_vec_g0)
        guard sub_vec_g0v.name.equals("int") = false
            return 108

        ; apply_substitution - follows chains T7 -> T8 -> int.
        let tv8 TypeVariable(8, String$("U"))
        let var_ty8 PlannedType(
            Span(0, 0),
            String$("U"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            &tv8
        )
        var sub_chain Vector[KeyValuePair[size_t, PlannedType]]$(2)
        sub_chain.put(0, KeyValuePair[size_t, PlannedType](7, var_ty8))
        sub_chain.put(1, KeyValuePair[size_t, PlannedType](8, int_ty))
        let sub_chained Planner.apply_substitution$(var_ty, &sub_chain)
        guard sub_chained.name.equals("int") = false
            return 109

        ; compose_substitutions - S2 ∘ S1: S1={T7 -> T8}, S2={T8 -> int}
        ; Expected: T7 -> int (applied), T8 -> int (carried over from S2).
        var s1_vec Vector[KeyValuePair[size_t, PlannedType]]$(1)
        s1_vec.put(0, KeyValuePair[size_t, PlannedType](7, var_ty8))
        var s2_vec Vector[KeyValuePair[size_t, PlannedType]]$(1)
        s2_vec.put(0, KeyValuePair[size_t, PlannedType](8, int_ty))
        let composed Planner.compose_substitutions$(s1_vec, s2_vec)
        guard composed.length <> 2
            return 110

        ; Look up T7 in the composed substitution - should be int.
        let comp7 Planner.substitution_lookup(composed, 7)
        guard comp7 = null
            return 111
        let comp7v (*comp7)
        guard comp7v.name.equals("int") = false
            return 112

        ; T8 should still be present.
        let comp8 Planner.substitution_lookup(composed, 8)
        guard comp8 = null
            return 113

        ; compose with duplicate key: S1 wins.
        var s1_dup Vector[KeyValuePair[size_t, PlannedType]]$(1)
        s1_dup.put(0, KeyValuePair[size_t, PlannedType](7, int_ty))
        var s2_dup Vector[KeyValuePair[size_t, PlannedType]]$(1)
        s2_dup.put(0, KeyValuePair[size_t, PlannedType](7, bool_ty))
        let dup_comp Planner.compose_substitutions$(s1_dup, s2_dup)
        guard dup_comp.length <> 1
            return 114
        let dup7 Planner.substitution_lookup(dup_comp, 7)
        guard dup7 = null
            return 115
        let dup7v (*dup7)
        guard dup7v.name.equals("int") = false
            return 116

        ; compute_struct_size / compute_struct_alignment - empty and simple.
        guard Planner.compute_struct_size(null) <> 0
            return 117
        guard Planner.compute_struct_alignment(null) <> 1
            return 118

        ; Struct with two int properties: offsets 0, 8; size 16; align 8
        ; (int is 8 bytes per s103).
        var two_ints Vector[PlannedProperty]$(2)
        two_ints.put(0, PlannedProperty(
            Span(0, 0), false, String$("x"), String$(""),
            int_ty, null, null, 0
        ))
        two_ints.put(1, PlannedProperty(
            Span(0, 0), false, String$("y"), String$(""),
            int_ty, null, null, 0
        ))
        guard Planner.compute_struct_size(&two_ints) <> 16
            return 119
        guard Planner.compute_struct_alignment(&two_ints) <> 8
            return 120

        let offsets Planner.compute_property_offsets$(&two_ints)
        guard offsets.length <> 2
            return 121
        let o0 offsets.get(0)
        guard o0 = null
            return 122
        guard *o0 <> 0
            return 123
        let o1 offsets.get(1)
        guard o1 = null
            return 124
        guard *o1 <> 8
            return 125

        ; Mixed struct: bool then int — padding puts int at offset 8
        ; (8-byte alignment for int per s103).
        var bool_then_int Vector[PlannedProperty]$(2)
        bool_then_int.put(0, PlannedProperty(
            Span(0, 0), false, String$("flag"), String$(""),
            bool_ty, null, null, 0
        ))
        bool_then_int.put(1, PlannedProperty(
            Span(0, 0), false, String$("count"), String$(""),
            int_ty, null, null, 0
        ))
        guard Planner.compute_struct_size(&bool_then_int) <> 16
            return 126
        let bi_offsets Planner.compute_property_offsets$(&bool_then_int)
        let bi0 bi_offsets.get(0)
        guard bi0 = null
            return 127
        guard *bi0 <> 0
            return 128
        let bi1 bi_offsets.get(1)
        guard bi1 = null
            return 129
        guard *bi1 <> 8
            return 130

        ; unify - identical concrete types → empty substitution.
        let u1 Planner.unify$(int_ty, int_ty)
        guard u1 = null
            return 131
        guard (*u1).length <> 0
            return 132

        ; unify - incompatible primitives → null.
        guard Planner.unify$(int_ty, bool_ty) <> null
            return 133

        ; unify - left variable, right concrete → binds.
        let u2 Planner.unify$(var_ty, int_ty)
        guard u2 = null
            return 134
        guard (*u2).length <> 1
            return 135
        let u2_lookup Planner.substitution_lookup((*u2), 7)
        guard u2_lookup = null
            return 136
        guard (*u2_lookup).name.equals("int") = false
            return 137

        ; unify - right variable, left concrete → also binds.
        let u3 Planner.unify$(int_ty, var_ty)
        guard u3 = null
            return 138
        guard (*u3).length <> 1
            return 139

        ; unify - same variable → empty.
        let u4 Planner.unify$(var_ty, var_ty)
        guard u4 = null
            return 140
        guard (*u4).length <> 0
            return 141

        ; unify - void unifies with anything.
        guard Planner.unify$(void_ty, int_ty) = null
            return 142

        ; unify - integer compatibility (u64 vs int).
        let i64_try Planner.unify$(int_ty, u32_ty)
        guard i64_try = null
            return 143

        ; unify - Option[T] vs pointer[void] → empty.
        guard Planner.unify$(option_ty, ptr_void_ty) = null
            return 144

        ; unify - recurse on generics: Vector[T7] vs Vector[int] → [(7, int)].
        let u_vec Planner.unify$(vec_of_t_ty, vec_ty)
        guard u_vec = null
            return 145
        guard (*u_vec).length <> 1
            return 146
        let u_vec_lookup Planner.substitution_lookup((*u_vec), 7)
        guard u_vec_lookup = null
            return 147
        guard (*u_vec_lookup).name.equals("int") = false
            return 148

        ; unify - occurs check: T7 vs Vector[T7] → null.
        guard Planner.unify$(var_ty, vec_of_t_ty) <> null
            return 149

        ; unify - name mismatch with matching arity → null.
        var list_gens Vector[PlannedType]$(1)
        list_gens.put(0, int_ty)
        let list_int_ty PlannedType(
            Span(0, 0),
            String$("List"),
            String$(""),
            &list_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        guard Planner.unify$(vec_ty, list_int_ty) <> null
            return 150

        ; solve_constraints - null list → empty substitution.
        let sc_null Planner.solve_constraints$(null)
        guard sc_null = null
            return 151
        guard (*sc_null).length <> 0
            return 152

        ; solve_constraints - single T7 = int → binds T7 to int.
        var one_eq Vector[TypeConstraint]$(1)
        one_eq.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, int_ty, Span(0, 0), String$(""))
        ))
        let sc_one Planner.solve_constraints$(&one_eq)
        guard sc_one = null
            return 153
        let sc_one_lookup Planner.substitution_lookup((*sc_one), 7)
        guard sc_one_lookup = null
            return 154
        guard (*sc_one_lookup).name.equals("int") = false
            return 155

        ; solve_constraints - chain T7 = T8, T8 = int → T7 resolves to int.
        var chain Vector[TypeConstraint]$(2)
        chain.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, var_ty8, Span(0, 0), String$(""))
        ))
        chain.put(1, TypeConstraint.Equality(
            EqualityConstraint(var_ty8, int_ty, Span(0, 0), String$(""))
        ))
        let sc_chain Planner.solve_constraints$(&chain)
        guard sc_chain = null
            return 156
        let sc_chain_t7 Planner.apply_substitution$(var_ty, sc_chain)
        guard sc_chain_t7.name.equals("int") = false
            return 157

        ; solve_constraints - conflicting: T7 = int, T7 = bool → null.
        var conflict Vector[TypeConstraint]$(2)
        conflict.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, int_ty, Span(0, 0), String$(""))
        ))
        conflict.put(1, TypeConstraint.Equality(
            EqualityConstraint(var_ty, bool_ty, Span(0, 0), String$(""))
        ))
        guard Planner.solve_constraints$(&conflict) <> null
            return 158

        ; free_type_vars - concrete type yields empty list.
        let fv_int Planner.free_type_vars$(int_ty)
        guard fv_int.length <> 0
            return 159

        ; free_type_vars - standalone variable yields [id].
        let fv_var Planner.free_type_vars$(var_ty)
        guard fv_var.length <> 1
            return 160
        let fv_var_0 fv_var.get(0)
        guard fv_var_0 = null
            return 161
        guard *fv_var_0 <> 7
            return 162

        ; free_type_vars - Vector[T7] yields [7].
        let fv_vec Planner.free_type_vars$(vec_of_t_ty)
        guard fv_vec.length <> 1
            return 163

        ; free_type_vars - dedupes repeated variables inside nested generics.
        var two_t Vector[PlannedType]$(2)
        two_t.put(0, var_ty)
        two_t.put(1, var_ty)
        let pair_of_t_ty PlannedType(
            Span(0, 0),
            String$("Pair"),
            String$(""),
            &two_t,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let fv_pair Planner.free_type_vars$(pair_of_t_ty)
        guard fv_pair.length <> 1
            return 164

        ; id_list_contains - basic sanity checks.
        var ids_37 Vector[size_t]$(2)
        ids_37.put(0, 3)
        ids_37.put(1, 7)
        guard Planner.id_list_contains(ids_37, 3) = false
            return 165
        guard Planner.id_list_contains(ids_37, 5)
            return 166

        ; generalize - concrete type has no quantified vars.
        var empty_env Vector[size_t]$(0)
        let sch_int Planner.generalize$(int_ty, empty_env)
        guard sch_int.quantified = null
            return 167
        let sch_int_q (*sch_int.quantified)
        guard sch_int_q.length <> 0
            return 168

        ; generalize - standalone type variable is quantified when not in env.
        let sch_var Planner.generalize$(var_ty, empty_env)
        guard sch_var.quantified = null
            return 169
        let sch_var_q (*sch_var.quantified)
        guard sch_var_q.length <> 1
            return 170
        let sch_var_tv sch_var_q.get(0)
        guard sch_var_tv = null
            return 171
        guard (*sch_var_tv).id <> 7
            return 172

        ; generalize - variable present in env is NOT quantified.
        var env_with_7 Vector[size_t]$(1)
        env_with_7.put(0, 7)
        let sch_in_env Planner.generalize$(var_ty, env_with_7)
        guard sch_in_env.quantified = null
            return 173
        guard (*sch_in_env.quantified).length <> 0
            return 174

        ; is_on_page_lifetime - Unspecified is the only "on-stack" lifetime.
        guard Planner.is_on_page_lifetime(Lifetime.Unspecified(Unspecified()))
            return 175
        guard Planner.is_on_page_lifetime(Lifetime.Local(
            scalyc.compiler.Model.Local(Span(0, 0))
        )) = false
            return 176

        ; decode_utf8_to_code_point - ASCII "A" -> 65.
        guard Planner.decode_utf8_to_code_point(String$("A")) <> 65
            return 177

        ; decode_utf8_to_code_point - empty string -> -1.
        guard Planner.decode_utf8_to_code_point(String$("")) <> -1
            return 178

        ; decode_utf8_to_code_point - "AB" (trailing byte) -> -1.
        guard Planner.decode_utf8_to_code_point(String$("AB")) <> -1
            return 179

        ; lookup_local_in_scope - hit, miss.
        let lb_x LocalBinding(int_ty, false, false)
        let lb_y LocalBinding(bool_ty, true, true)
        var scope1 Vector[KeyValuePair[String, LocalBinding]]$(2)
        scope1.put(0, KeyValuePair[String, LocalBinding](String$("x"), lb_x))
        scope1.put(1, KeyValuePair[String, LocalBinding](String$("y"), lb_y))
        let hit_x Planner.lookup_local_in_scope(scope1, String$("x"))
        guard hit_x = null
            return 180
        guard (*hit_x).is_mutable
            return 181
        guard Planner.lookup_local_in_scope(scope1, String$("z")) <> null
            return 182

        ; lookup_local_in_stack - innermost shadows outer.
        let lb_x_outer LocalBinding(int_ty, false, false)
        let lb_x_inner LocalBinding(bool_ty, true, false)
        var outer_scope Vector[KeyValuePair[String, LocalBinding]]$(1)
        outer_scope.put(0, KeyValuePair[String, LocalBinding](String$("x"), lb_x_outer))
        var inner_scope Vector[KeyValuePair[String, LocalBinding]]$(1)
        inner_scope.put(0, KeyValuePair[String, LocalBinding](String$("x"), lb_x_inner))
        var stack Vector[Vector[KeyValuePair[String, LocalBinding]]]$(2)
        stack.put(0, outer_scope)
        stack.put(1, inner_scope)
        let resolved Planner.lookup_local_in_stack(stack, String$("x"))
        guard resolved = null
            return 183
        guard (*resolved).is_mutable = false
            return 184

        ; resolve_type_base - simple path.
        var int_name_vec Vector[String]$(1)
        int_name_vec.put(0, String$("int"))
        let int_type Type(
            Span(0, 0),
            int_name_vec,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_int Planner.resolve_type_base$(int_type)
        guard rt_int.name.equals("int") = false
            return 185
        guard rt_int.generics <> null
            return 186

        ; resolve_type_base - dotted name.
        var str_name_vec Vector[String]$(3)
        str_name_vec.put(0, String$("scaly"))
        str_name_vec.put(1, String$("containers"))
        str_name_vec.put(2, String$("String"))
        let str_type Type(
            Span(0, 0),
            str_name_vec,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_str Planner.resolve_type_base$(str_type)
        guard rt_str.name.equals("scaly.containers.String") = false
            return 187

        ; resolve_type_base - pointer[int] gets "P" mangled prefix.
        var ptr_name_vec Vector[String]$(1)
        ptr_name_vec.put(0, String$("pointer"))
        var ptr_inner_gens Vector[Type]$(1)
        ptr_inner_gens.put(0, int_type)
        let ptr_type Type(
            Span(0, 0),
            ptr_name_vec,
            &ptr_inner_gens,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_ptr Planner.resolve_type_base$(ptr_type)
        guard rt_ptr.name.equals("pointer") = false
            return 188
        guard rt_ptr.generics = null
            return 189
        let rt_ptr_gens (*rt_ptr.generics)
        guard rt_ptr_gens.length <> 1
            return 190
        let rt_ptr_inner rt_ptr_gens.get(0)
        guard rt_ptr_inner = null
            return 191
        guard (*rt_ptr_inner).name.equals("int") = false
            return 192
        ; Inner primitive has no mangled_name set here (set by caller after
        ; concept-table lookup), so outer just becomes "P" + "".
        guard rt_ptr.mangled_name.equals("P") = false
            return 193

        ; name_substitution_lookup - hit/miss.
        var t_subst Vector[KeyValuePair[String, PlannedType]]$(1)
        t_subst.put(0, KeyValuePair[String, PlannedType](String$("T"), int_ty))
        let hit_t Planner.name_substitution_lookup(t_subst, String$("T"))
        guard hit_t = null
            return 194
        guard (*hit_t).name.equals("int") = false
            return 195
        guard Planner.name_substitution_lookup(t_subst, String$("K")) <> null
            return 196

        ; apply_name_substitution - standalone "T" replaced by int.
        let t_ty PlannedType(
            Span(0, 0),
            String$("T"),
            String$(""),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let subst_t Planner.apply_name_substitution$(t_ty, &t_subst)
        guard subst_t.name.equals("int") = false
            return 197

        ; apply_name_substitution - Vector[T] → Vector[int].
        var vec_t_gens_ns Vector[PlannedType]$(1)
        vec_t_gens_ns.put(0, t_ty)
        let vec_t_ns_ty PlannedType(
            Span(0, 0),
            String$("Vector"),
            String$(""),
            &vec_t_gens_ns,
            Lifetime.Unspecified(Unspecified()),
            null,
            String$(""),
            null
        )
        let subst_vec Planner.apply_name_substitution$(vec_t_ns_ty, &t_subst)
        guard subst_vec.name.equals("Vector") = false
            return 198
        guard subst_vec.generics = null
            return 199
        let subst_vec_g0 (*subst_vec.generics).get(0)
        guard subst_vec_g0 = null
            return 200
        guard (*subst_vec_g0).name.equals("int") = false
            return 201

        ; apply_name_substitution - null substitution, no change.
        let no_subst Planner.apply_name_substitution$(vec_t_ns_ty, null)
        guard no_subst.name.equals("Vector") = false
            return 202

        ; Primitive factories set the Itanium one-letter codes.
        let mk_int Planner.make_int_type$()
        guard mk_int.name.equals("int") = false
            return 203
        guard mk_int.mangled_name.equals("i") = false
            return 204

        let mk_void Planner.make_void_type$()
        guard mk_void.mangled_name.equals("v") = false
            return 205

        ; make_pointer_type wraps "P" + inner.mangled_name.
        let mk_ptr_int Planner.make_pointer_type$(mk_int)
        guard mk_ptr_int.name.equals("pointer") = false
            return 206
        guard mk_ptr_int.mangled_name.equals("Pi") = false
            return 207
        guard mk_ptr_int.generics = null
            return 208
        let mk_ptr_int_gens (*mk_ptr_int.generics)
        guard mk_ptr_int_gens.length <> 1
            return 209

        ; instantiate - no quantified vars: return scheme type unchanged.
        let inst_int Planner.instantiate$(sch_int, 100)
        guard inst_int.name.equals("int") = false
            return 210

        ; instantiate - scheme with quantified T7 gets fresh id 100.
        let inst_var Planner.instantiate$(sch_var, 100)
        guard inst_var.variable = null
            return 211
        guard (*inst_var.variable).id <> 100
            return 212

        ; ====================================================================
        ; Planner-instance (scope stack) tests. Exercises the struct surgery
        ; added in this session — `Planner.Planner$(...)` constructor, plus
        ; push_scope / define_local / lookup_local / pop_scope sequencing.
        ; ====================================================================

        var p Planner.Planner$(String$("test.scaly"))

        ; Empty stack → no local named "x".
        guard p.lookup_local(String$("x")) <> null
            return 213

        ; Push a scope, define "x" = int, lookup → hits.
        p.push_scope()
        p.define_local(String$("x"), int_ty, false, false)
        let px1 p.lookup_local(String$("x"))
        guard px1 = null
            return 214
        guard (*px1).name.equals("int") = false
            return 215

        ; Push inner scope, shadow "x" with bool.
        p.push_scope()
        p.define_local(String$("x"), bool_ty, true, false)
        let px2 p.lookup_local(String$("x"))
        guard px2 = null
            return 216
        guard (*px2).name.equals("bool") = false
            return 217

        ; Lookup binding flags on inner "x".
        let pxb2 p.lookup_local_binding(String$("x"))
        guard pxb2 = null
            return 218
        guard (*pxb2).is_mutable = false
            return 219

        ; Pop inner scope, outer "x" reappears.
        p.pop_scope()
        let px3 p.lookup_local(String$("x"))
        guard px3 = null
            return 220
        guard (*px3).name.equals("int") = false
            return 221

        ; Pop outer scope, no locals remain.
        p.pop_scope()
        guard p.lookup_local(String$("x")) <> null
            return 222

        ; ====================================================================
        ; Type-substitution tests.
        ; ====================================================================

        guard p.lookup_type_substitution(String$("T")) <> null
            return 223

        p.define_type_substitution(String$("T"), int_ty)
        let ps_t p.lookup_type_substitution(String$("T"))
        guard ps_t = null
            return 224
        guard (*ps_t).name.equals("int") = false
            return 225

        p.clear_type_substitutions()
        guard p.lookup_type_substitution(String$("T")) <> null
            return 226

        ; ====================================================================
        ; Fresh type-variable id counter.
        ; ====================================================================

        guard p.fresh_type_var_id() <> 0
            return 227
        guard p.fresh_type_var_id() <> 1
            return 228
        guard p.fresh_type_var_id() <> 2
            return 229

        ; ====================================================================
        ; fresh_type_var + constraint-solver methods on the Planner instance.
        ; ====================================================================

        let fv1 p.fresh_type_var$(String$("T"))
        guard fv1.variable = null
            return 230
        guard (*fv1.variable).id <> 3
            return 231

        ; Add a solvable constraint: fv1 = int, solve → success.
        p.add_equality_constraint(fv1, int_ty, Span(0, 0))
        guard p.solve_and_apply$() = false
            return 232

        ; Applying the current substitution to fv1 should now yield int.
        let rewritten p.apply_current_substitution$(fv1)
        guard rewritten.name.equals("int") = false
            return 233

        ; Constraints are cleared after a successful solve — adding an
        ; unrelated constraint and solving again should still succeed.
        let fv2 p.fresh_type_var$(String$("U"))
        p.add_equality_constraint(fv2, bool_ty, Span(0, 0))
        guard p.solve_and_apply$() = false
            return 234

        ; Add a conflicting pair: fv3 = int, fv3 = bool. Expect failure.
        let fv3 p.fresh_type_var$(String$("V"))
        p.add_equality_constraint(fv3, int_ty, Span(0, 0))
        p.add_equality_constraint(fv3, bool_ty, Span(0, 0))
        guard p.solve_and_apply$()
            return 235

        ; ====================================================================
        ; plan_type on the Planner instance.
        ; ====================================================================

        ; A clean Planner — no active substitutions — resolves "int" plainly.
        var p2 Planner.Planner$(String$("test2.scaly"))
        let pt_int p2.plan_type$(int_type)
        guard pt_int.name.equals("int") = false
            return 236

        ; With T → int substitution active, Vector[T] becomes Vector[int].
        p2.define_type_substitution(String$("T"), int_ty)
        var vec_t_path Vector[String]$(1)
        vec_t_path.put(0, String$("Vector"))
        var vec_t_generics Vector[Type]$(1)
        var t_path Vector[String]$(1)
        t_path.put(0, String$("T"))
        vec_t_generics.put(0, Type(
            Span(0, 0),
            t_path,
            null,
            Lifetime.Unspecified(Unspecified())
        ))
        let vec_t_model Type(
            Span(0, 0),
            vec_t_path,
            &vec_t_generics,
            Lifetime.Unspecified(Unspecified())
        )
        let pt_vec_t p2.plan_type$(vec_t_model)
        guard pt_vec_t.name.equals("Vector") = false
            return 237
        guard pt_vec_t.generics = null
            return 238
        let pt_vec_t_g0 (*pt_vec_t.generics).get(0)
        guard pt_vec_t_g0 = null
            return 239
        guard (*pt_vec_t_g0).name.equals("int") = false
            return 240

        ; ====================================================================
        ; plan_item: Model.Item (name + optional type) → PlannedItem.
        ; ====================================================================

        ; Item { name: "x", type: int } → PlannedItem with planned int type.
        let model_item Item(
            Span(0, 0),
            false,
            &(String$("x")),
            &int_type,
            Vector[Attribute]$(0)
        )
        let pl_item p2.plan_item$(model_item)
        guard pl_item.name = null
            return 241
        guard (*pl_item.name).equals(String$("x")) = false
            return 242
        guard pl_item.item_type = null
            return 243
        guard (*pl_item.item_type).name.equals("int") = false
            return 244

        ; Item { name: null, type: null } → PlannedItem with nulls propagated.
        let bare_item Item(
            Span(0, 0),
            true,
            null,
            null,
            Vector[Attribute]$(0)
        )
        let pl_bare p2.plan_item$(bare_item)
        guard pl_bare.name <> null
            return 245
        guard pl_bare.item_type <> null
            return 246
        guard pl_bare.is_private = false
            return 247

        ; plan_items: batch over a two-Item Vector.
        var model_items Vector[Item]$(2)
        model_items.put(0, model_item)
        model_items.put(1, bare_item)
        let pl_items p2.plan_items$(model_items)
        guard pl_items.length <> 2
            return 248
        let pi0 pl_items.get(0)
        guard pi0 = null
            return 249
        guard (*pi0).item_type = null
            return 250

        ; plan_constant_operand: literal 42 → PlannedOperand with result_type = int.
        let plan_c42 p2.plan_constant_operand$(
            Constant.Integer(IntegerConstant(Span(0, 0), 42)),
            Span(0, 0)
        )
        guard plan_c42.result_type.name.equals("int") = false
            return 251

        ; plan_operand / plan_operands over Constant-only operands.
        let op_42 Operand(
            Span(0, 0),
            Expression.Constant(Constant.Integer(IntegerConstant(Span(0, 0), 42))),
            null
        )
        let po_42 p2.plan_operand$(op_42)
        guard po_42.result_type.name.equals("int") = false
            return 252

        let op_true Operand(
            Span(0, 0),
            Expression.Constant(Constant.Boolean(BooleanConstant(Span(0, 0), true))),
            null
        )
        var model_ops Vector[Operand]$(2)
        model_ops.put(0, op_42)
        model_ops.put(1, op_true)
        let po_batch p2.plan_operands$(model_ops)
        guard po_batch.length <> 2
            return 253
        let po_batch_1 po_batch.get(1)
        guard po_batch_1 = null
            return 254
        guard (*po_batch_1).result_type.name.equals("bool") = false
            return 255

        ; plan_binding - `let x: int = 42`:
        ;   - produces PlannedBinding with PlannedItem.name = "x"
        ;   - registers x in the current scope
        var p3 Planner.Planner$(String$("test3.scaly"))
        p3.push_scope()
        var init_ops Vector[Operand]$(1)
        init_ops.put(0, op_42)
        let model_bind Binding(
            Span(0, 0),
            String$("let"),
            Item(
                Span(0, 0),
                false,
                &(String$("x")),
                &int_type,
                Vector[Attribute]$(0)
            ),
            init_ops
        )
        let pb p3.plan_binding$(model_bind)
        guard pb.binding_type.equals("let") = false
            return 256
        guard pb.binding_item.name = null
            return 257
        guard (*pb.binding_item.name).equals(String$("x")) = false
            return 258

        ; After plan_binding, x should be a local in p3's scope.
        let plocal_x p3.lookup_local(String$("x"))
        guard plocal_x = null
            return 259
        guard (*plocal_x).name.equals("int") = false
            return 260

        ; The equality constraint binding_type = init_type should be solvable.
        guard p3.solve_and_apply$() = false
            return 261

        ; ====================================================================
        ; Statement dispatch: plan_action, plan_return, plan_statement.
        ; ====================================================================

        ; An Action: source = [42], target = [] → PlannedAction with result_type int.
        let model_action Action(init_ops, Vector[Operand]$(0))
        let pl_act p3.plan_action$(model_action)
        guard pl_act.result_type.name.equals("int") = false
            return 262

        ; A Return with one operand.
        let model_return Return(Span(0, 0), init_ops)
        let pl_ret p3.plan_return$(model_return)
        guard pl_ret.result = null
            return 263
        guard (*pl_ret.result).length <> 1
            return 264

        ; plan_statement over the Action above.
        let stmt_action Statement.Action(model_action)
        let pl_stmt p3.plan_statement$(stmt_action)
        let stmt_is_action choose pl_stmt
            when a: PlannedAction
                true
            else
                false
        guard stmt_is_action = false
            return 265

        ; plan_statement over a Continue.
        let stmt_continue Statement.Continue(Continue(Span(0, 0)))
        let pl_cont p3.plan_statement$(stmt_continue)
        let stmt_is_continue choose pl_cont
            when c: PlannedContinue
                true
            else
                false
        guard stmt_is_continue = false
            return 266

        ; plan_block: a block with one Action statement.
        var stmts_vec Vector[Statement]$(1)
        stmts_vec.put(0, stmt_action)
        let model_block Block(Span(0, 0), stmts_vec)
        let pl_block p3.plan_block$(model_block)
        guard pl_block.statements = null
            return 267
        guard (*pl_block.statements).length <> 1
            return 268

        ; plan_property - Property { name: "x", type: int, no initializer }.
        let model_prop Property(
            Span(0, 0),
            false,
            String$("x"),
            &int_type,
            null,
            Vector[Attribute]$(0)
        )
        let pl_prop p3.plan_property$(model_prop)
        guard pl_prop.name.equals(String$("x")) = false
            return 269
        guard pl_prop.prop_type.name.equals("int") = false
            return 270
        guard pl_prop.offset <> 0
            return 271

        ; plan_variant - Variant { name: "Some", type: int, tag=1 }.
        let model_variant Variant(
            Span(0, 0),
            String$("Some"),
            &int_type,
            Vector[Attribute]$(0)
        )
        let pl_variant p3.plan_variant$(model_variant, 1)
        guard pl_variant.name.equals(String$("Some")) = false
            return 272
        guard pl_variant.tag <> 1
            return 273
        guard pl_variant.var_type = null
            return 274

        ; plan_function - extern "foo(x: int) returns int".
        var x_params Vector[Item]$(1)
        x_params.put(0, Item(
            Span(0, 0),
            false,
            &(String$("x")),
            &int_type,
            Vector[Attribute]$(0)
        ))
        let model_fn Function(
            Span(0, 0),
            false,
            true,
            String$("foo"),
            Vector[GenericParameter]$(0),
            null,
            x_params,
            &int_type,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Extern(Extern(Span(0, 0)))
        )
        let pl_fn p3.plan_function$(model_fn, null)
        guard pl_fn.name.equals(String$("foo")) = false
            return 275
        guard pl_fn.input = null
            return 276
        guard (*pl_fn.input).length <> 1
            return 277
        guard pl_fn.return_type = null
            return 278
        guard (*pl_fn.return_type).name.equals("int") = false
            return 279

        ; plan_structure - empty Structure: size 0, alignment 1.
        var empty_kvps Vector[KeyValuePair[String, scalyc.compiler.Model.Nameable]]$(0)
        var empty_builder HashMapBuilder[String, scalyc.compiler.Model.Nameable]$(empty_kvps)
        var empty_symbols HashMap[String, scalyc.compiler.Model.Nameable]$(empty_builder)
        let empty_struct Structure(
            Span(0, 0),
            false,
            Vector[Property]$(0),
            Vector[scalyc.compiler.Model.Module]$(0),
            Vector[scalyc.compiler.Model.Use]$(0),
            Vector[scalyc.compiler.Model.Initializer]$(0),
            null,
            Vector[scalyc.compiler.Model.Member]$(0),
            empty_symbols
        )
        let pl_struct p3.plan_structure$(empty_struct, String$("Foo"))
        guard pl_struct.name.equals(String$("Foo")) = false
            return 280
        guard pl_struct.size <> 0
            return 281
        guard pl_struct.alignment <> 1
            return 282

        ; plan_initializer - Initializer with one parameter.
        let model_init Initializer(
            Span(0, 0),
            false,
            null,
            x_params,
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        let pl_init p3.plan_initializer$(model_init, null)
        guard pl_init.input = null
            return 283
        guard (*pl_init.input).length <> 1
            return 284

        ; plan_operator - operator + with (this, int) parameters.
        var plus_params Vector[Item]$(2)
        plus_params.put(0, Item(
            Span(0, 0),
            false,
            &(String$("this")),
            null,
            Vector[Attribute]$(0)
        ))
        plus_params.put(1, Item(
            Span(0, 0),
            false,
            &(String$("other")),
            &int_type,
            Vector[Attribute]$(0)
        ))
        let model_op Operator(
            Span(0, 0),
            false,
            String$("+"),
            Vector[GenericParameter]$(0),
            plus_params,
            &int_type,
            null,
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        let pl_op p3.plan_operator$(model_op, null)
        guard pl_op.name.equals(String$("+")) = false
            return 285
        guard pl_op.input = null
            return 286
        guard (*pl_op.input).length <> 2
            return 287
        guard pl_op.return_type = null
            return 288

        ; ====================================================================
        ; Lambda: `\: 42` — no params, body is an Action returning 42.
        ; ====================================================================
        var p4 Planner.Planner$(String$("test_lambda.scaly"))
        let lam_body Action(init_ops, Vector[Operand]$(0))
        let model_lam Lambda(
            Span(0, 0),
            Vector[Item]$(0),
            lam_body
        )
        let pl_lam p4.plan_lambda$(model_lam)
        guard pl_lam.mangled_name.equals(String$("_ZN6lambda0Ev")) = false
            return 289
        guard pl_lam.return_type.name.equals(String$("int")) = false
            return 290

        ; A second lambda bumps the counter to 1.
        let pl_lam2 p4.plan_lambda$(model_lam)
        guard pl_lam2.mangled_name.equals(String$("_ZN6lambda1Ev")) = false
            return 291

        ; ====================================================================
        ; Repeat: a do-while whose body is the same trivial Action.
        ; ====================================================================
        let model_rep Repeat(Span(0, 0), lam_body)
        let pl_rep p4.plan_repeat$(model_rep)
        guard pl_rep.body.result_type.name.equals(String$("int")) = false
            return 292

        0
    }
}
