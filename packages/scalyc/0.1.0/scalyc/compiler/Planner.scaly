                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 7 & 8: null (typed as pointer[void]) is the None for Option types.
        if arg_type.name.equals("pointer")
        {
            if arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                if ag.length > 0
                {
                    let a0_ptr ag.get 0
                    if a0_ptr <> null
                    {
                        let a0 (*a0_ptr)
                        if a0.name.equals("void")
                        {
                            if param_type.name.equals("Option")
                                return true
