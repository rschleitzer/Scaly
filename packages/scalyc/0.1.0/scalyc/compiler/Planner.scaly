; libc extern for loud-failing stubs.
function exit(code: int) extern

; ============================================================================
; Scope / binding machinery.
;
; Defined at module scope so callers outside `define Planner` can construct
; them (scope state will eventually live inside the Planner struct; for now
; every scope-aware helper takes the stack as an explicit parameter).
; ============================================================================

; One local variable's entry. is_on_page tracks RBMM lifetime — true for
; values allocated with $, #, or ^name so the code generator can emit
; appropriate page-cleanup hooks.
define LocalBinding
(
    binding_type: scalyc.compiler.Plan.PlannedType
    is_mutable: bool
    is_on_page: bool
    is_parameter: bool
)

; One HARD diagnostic: a construct the planner could not resolve and that
; would otherwise be silently dropped from the emitted IR. `start` is the
; byte offset of the construct in its source file (Span.start); cli.run
; formats it as file:line:col like stage-0's formatErrorHeader and fails
; the compile.
define PlannerDiagnostic
(
    start: size_t
    message: String
    ; Source file the `start` byte offset is relative to. Multi-file
    ; compiles put each module's nodes in their own file's coordinate
    ; space, so a diagnostic must carry its file or cli.run formats the
    ; offset against the wrong (entry) file. Mirrors stage-0's per-error
    ; File capture (Planner.cpp planModule's `File = Mod.File`).
    file: String
)

; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
; One summary entry: the function at instantiated_functions[callee_fn_index]
; STORES its parameter #param_index into frame-external memory. dest_kind 0 =
; the destination is that callee's parameter #dest_index (e.g. `this.field`);
; dest_kind 1 = the destination is a module global or a pointer deref (@ext,
; always frame-external). callee_param_count is the callee's Input length, used
; to align a call's args from the right (skipping any leading page arg).
; Indices are computed at collect time so the per-call check needs no signature
; lookup. Mirrors Planner.cpp's EscapeSummary/CalleeParamNames.
define EscapeRecord
(
    callee_fn_index: size_t
    callee_param_count: size_t
    param_index: size_t
    dest_kind: size_t
    dest_index: size_t
)

define Planner
{
    ; ========================================================================
    ; Not-yet-ported marker.
    ;
    ; Every stub in this file funnels through here. Prints the method name
    ; to stderr and exits with code 111 so a caller that touches unported
    ; logic gets a precise, visible failure (not a silent null).
    ; ========================================================================

    function not_implemented(method_name: pointer[const_char]) returns int
    {
        scaly_eputs "scalyc Planner stub not implemented: "
        scaly_eputs method_name
        scaly_eputs "\n"
        exit 111
        0
    }

    ; Typed unreachable shim for functions that return PlannedOperand.
    ; The exit() in not_implemented terminates the process, so the dummy
    ; PlannedOperand below is never observed — it exists only so Scaly's
    ; type checker accepts the call site.
    function not_implemented_operand(method_name: pointer[const_char]) returns PlannedOperand
    {
        Planner.not_implemented method_name
        PlannedOperand(
            Span(0, 0),
            PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant(
                Constant.Null(NullConstant(Span(0, 0)))
            )),
            null,
            PlannedType(
                Span(0, 0),
                String$("void"),
                String$("v"),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String$(""),
                null
            )
        )
    }

    ; ========================================================================
    ; Planner - the per-compilation-unit state.
    ;
    ; Mirrors the private fields of scalyc/Planner.h: scope stack, type
    ; substitutions, HM constraints + solution, concept registry,
    ; instantiation caches, function/operator registries, package
    ; search paths, loaded-package cache, and error accumulator.
    ; ========================================================================

    define Planner
    (
        file: String

        ; Scope stack — stored as one flat Array of bindings with a
        ; parallel Array of scope boundaries (indices where each scope
        ; begins). This avoids the Array-of-Array memory-model problem
        ; where a nested Array would lose its `Page.get(this)` anchor
        ; after being copied into the outer Array's exclusive page.
        ;
        ; push_scope    → boundaries.add(bindings.length)
        ; pop_scope     → bindings.length = last boundary, drop boundary
        ; define_local  → bindings.add(...)
        ; lookup_local  → reverse linear scan of bindings
        scope_bindings: Array[KeyValuePair[String, LocalBinding]]
        scope_boundaries: Array[size_t]

        ; Generic parameter substitutions active while planning a
        ; specific struct/function instantiation. Name-keyed
        ; (e.g. "T" → PlannedType for int).
        type_substitutions: Array[KeyValuePair[String, PlannedType]]

        ; Fresh type-variable id counter for the Hindley-Milner
        ; constraint solver; see fresh_type_var below.
        next_type_var_id: size_t

        ; Pending constraints (grow as the planner encounters equalities
        ; it can't resolve yet) and the accumulated solution from the
        ; most recent solve_and_apply call.
        constraints: Array[TypeConstraint]
        solution: Array[KeyValuePair[size_t, PlannedType]]

        ; Concept registry — maps a readable name (e.g. "Vector") to the
        ; Model.Concept that owns it. Populated by register_concept; used
        ; by lookup_concept during type resolution and method dispatch.
        concepts: Array[KeyValuePair[String, Concept]]

        ; O(1) name -> index map over `concepts`, maintained in lockstep at the
        ; single register_concept insertion site. Replaces lookup_concept's
        ; backward linear scan (the hottest planner function). Stores indices,
        ; not pointers, because `concepts` reallocates as it grows. Concrete,
        ; malloc'd, open-addressing — sidesteps the s188 RBMM-HashMap bug.
        concept_index: ConceptIndex

        ; Instantiation caches. Every PlannedStructure / PlannedUnion /
        ; PlannedFunction / PlannedGlobal a call into the planner
        ; produces is appended here so the final Plan can carry the
        ; complete list for emission.
        instantiated_structures: Array[PlannedStructure]
        instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]
        ; Names of every `delegate` (function-pointer) concept registered.
        ; Flows to Plan.delegates so the emitter's map_type lowers a
        ; delegate-typed value to an LLVM ptr (GAP B). Empty for the scaly
        ; package (no delegates) → map_type byte-identical, fixpoint-safe.
        delegate_names: Array[String]
        ; The enclosing function's planned return type during body planning
        ; (GAP B): a lambda returned where this is a delegate type becomes an
        ; ESCAPING closure (env on the caller page `#`). Null outside a function
        ; body or when the function has no declared return type.
        current_return_type: ref[PlannedType]?
        ; Names bound to a stack (non-escaping, Lifetime.Local) closure in the
        ; current function (GAP B escape checking). Returning one is an escape
        ; (the record lives on this frame) — flagged as a hard diagnostic.
        ; Truncated to its entry length at each function boundary.
        local_closure_names: Array[String]
        instantiated_functions: Array[PlannedFunction]
        ; O(1) membership index over instantiated_functions' mangled names,
        ; maintained in lockstep at the single record_function add site.
        ; has_recorded_function was an O(n) linear scan called from 4 hot
        ; collapse_operand_sequence call-resolution sites -> O(n^2) over a
        ; -c scalyc compile (same pattern as lookup_concept / the emitter
        ; caches). lookup(mangled) >= 0 means present. Pure membership ->
        ; same bool -> identical Plan -> identical IR (fixpoint-safe).
        function_name_index: ConceptIndex
        instantiated_globals: Array[PlannedGlobal]

        ; s116: cycle detection for instantiate_generic#. Holds the
        ; mangled names of generics currently being planned but not yet
        ; recorded in instantiated_structures/_unions. Without this,
        ; cross-module nested-generic chains (e.g. scalyc.scaly compile)
        ; recurse plan_type# → instantiate_generic# → plan_structure# →
        ; plan_function# → plan_type# without bound and blow the stack
        ; in resolve_type_base#. Mirrors stage-0's FunctionsBeingPlanned
        ; set (Planner.cpp:11685).
        instantiating_structures: Array[String]

        ; s188: structure mangled names already lazily full-instantiated by
        ; lookup_method#'s call-site hook, so a re-entrant resolution of the
        ; same concept's method during its own body planning is a no-op.
        instantiating_methods: Array[String]

        ; Free-function registry. Entries are appended for every
        ; top-level Function encountered during the concept-registration
        ; pass. A single name can appear multiple times for overloads —
        ; lookup_functions returns all matches.
        model_functions: Array[KeyValuePair[String, Function]]

        ; Phase-1 lambdas: `let f \params: body` records the lambda model
        ; keyed by the binding name; calls to `f` monomorphize the body at
        ; the call site (see collapse_operand_sequence#). No runtime value
        ; is emitted for the binding.
        lambda_models: Array[KeyValuePair[String, Lambda]]

        ; O(1) name -> ordered registry-index chain over model_functions,
        ; maintained in lockstep at the single register_function add site.
        ; Replaces lookup_functions / is_function's O(n) linear scan (O(n^2)
        ; over a -c scalyc compile). Walks in insertion order -> identical
        ; overload-resolution input -> identical Plan -> identical IR.
        model_function_index: FunctionIndex

        ; Operator registry (same shape as model_functions; separate
        ; keyspace because an operator is identified by its symbol).
        model_operators: Array[KeyValuePair[String, Operator]]

        ; O(1) name -> ordered registry-index chain over model_operators,
        ; maintained in lockstep at the single register_operator add site.
        model_operator_index: FunctionIndex

        ; Set by resolve_operator_call# / resolve_prefix_operator_call# to the
        ; matched operator's intrinsic-ness (true iff its implementation is
        ; Intrinsic). Read by the operator-call construction in
        ; collapse_operand_sequence# ONLY when the resolve returned non-null,
        ; so a user-defined (Action-bodied) operator emits a real call to its
        ; mangled function instead of being routed to emit_intrinsic_*_op.
        ; Mirrors stage-0's OperatorMatch.IsIntrinsic (Planner.cpp:3118/4470).
        resolved_op_is_intrinsic: bool

        ; Package search paths (e.g. "packages", user -I paths). Probed
        ; by load_package_on_demand when a package isn't already in
        ; loaded_packages.
        search_paths: Array[String]

        ; Loaded-package cache — name → root Module. Populated lazily
        ; once a package is found and parsed.
        loaded_packages: Array[KeyValuePair[String, Module]]

        ; Intra-package module cache keyed by full file path.
        ; Pre-populated by the outer driver via
        ; register_loaded_module; load_intra_package_module#
        ; consults it on demand.
        loaded_module_paths: Array[KeyValuePair[String, Module]]

        ; Collected diagnostic messages. Planner paths that can't
        ; resolve a name / method / type push descriptive strings
        ; here instead of (or in addition to) falling back to a
        ; fresh type variable. The caller (cli.scaly, tests) can
        ; inspect errors.length > 0 to detect problems without
        ; plumbing Result[T, E] through every helper.
        errors: Array[String]

        ; HARD diagnostics. Unlike `errors` (advisory — speculative
        ; lookup misses land there thousands of times during a clean
        ; self-compile), an entry here means a construct WOULD be
        ; dropped from the emitted IR. cli.run prints these with
        ; file:line:col and fails the compile (s185, roadmap Step C).
        diagnostics: Array[PlannerDiagnostic]

        ; Sibling programs: Model.Programs belonging to the same
        ; compilation unit but loaded from separate source files.
        ; Mirrors Planner.cpp's SiblingPrograms — main.scaly may
        ; reference cli.scaly, which references compiler.scaly;
        ; once each has been parsed+modelled the result is stashed
        ; here so concepts/functions/operators from every sibling
        ; populate the same registries as the primary program.
        sibling_programs: Array[Program]

        ; Currently-active namespace context. Pushed when
        ; plan_namespace enters a `define cli { … }`-style block,
        ; popped on exit. Used by mangle_function to prefix
        ; namespace-scoped functions with the namespace name
        ; (Itanium `_ZN3cli4mainE…` shape) and by
        ; is_namespace_sibling_function to detect unqualified
        ; calls to peer functions of the enclosing namespace.
        current_namespace: ref[Namespace]?
        current_namespace_name: ref[String]?

        ; Last-segment names of every `use a.b.c` clause in the
        ; program's main module. Consulted by the dotted-call
        ; namespace override to decide whether a `prefix.suffix(...)`
        ; call should emit a real extern declaration even when
        ; planning is happening inside a loaded-package namespace
        ; body. Mirrors stage-0's Use-alias check at
        ; Planner.cpp:7752-7789. Populated once at plan_program#
        ; entry, stays empty until then.
        program_use_aliases: Array[String]

        ; Parallel to program_use_aliases: the second-to-last segment of
        ; each `use a.b.c` clause (the enclosing-namespace name for
        ; mangling), or empty when the clause has only one segment.
        ; Lets a bare call to a use-imported namespace member mangle as
        ; `_ZN<ns><fn>E…` (matching the member's definition) instead of
        ; the free `_Z<fn>…` (which would be undefined at link).
        program_use_namespaces: Array[String]

        ; Monotonic counter for synthesizing unique lambda names.
        next_lambda_id: size_t

        ; Escape checker (RBMM blocker C), Vector 3 — interprocedural
        ; pass-to-storing-callee. Built by check_interprocedural_escapes#
        ; as a post-pass Plan-tree walk over instantiated_functions.
        ; escape_records is the summary (see EscapeRecord); escape_checking
        ; gates collect (false) vs check (true) mode; escape_fn_index names
        ; the function currently being walked (re-fetched via
        ; instantiated_functions.get to avoid storing its ref/String fields,
        ; which corrupt — s34); escape_found short-circuits once a violation
        ; has been reported.
        escape_records: Array[EscapeRecord]
        escape_checking: bool
        escape_found: bool
        escape_fn_index: size_t
    )
    {
        init#(page, filename: String)
        {
            set file: String^page(filename)
            set scope_bindings: Array[KeyValuePair[String, LocalBinding]]^page()
            set scope_boundaries: Array[size_t]^page()
            set type_substitutions: Array[KeyValuePair[String, PlannedType]]^page()
            set next_type_var_id: 0
            set constraints: Array[TypeConstraint]^page()
            set solution: Array[KeyValuePair[size_t, PlannedType]]^page()
            set concepts: Array[KeyValuePair[String, Concept]]^page()
            set concept_index: ConceptIndex.create#(65536 as size_t)
            set instantiated_structures: Array[PlannedStructure]^page()
            set instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]^page()
            set delegate_names: Array[String]^page()
            set current_return_type: null
            set local_closure_names: Array[String]^page()
            set instantiated_functions: Array[PlannedFunction]^page()
            set function_name_index: ConceptIndex.create#(262144 as size_t)
            set instantiated_globals: Array[PlannedGlobal]^page()
            set instantiating_structures: Array[String]^page()
            set instantiating_methods: Array[String]^page()
            set model_functions: Array[KeyValuePair[String, Function]]^page()
            set lambda_models: Array[KeyValuePair[String, Lambda]]^page()
            set model_function_index: FunctionIndex.create#(65536 as size_t, 262144 as size_t)
            set model_operators: Array[KeyValuePair[String, Operator]]^page()
            set model_operator_index: FunctionIndex.create#(65536 as size_t, 262144 as size_t)
            set resolved_op_is_intrinsic: false
            set search_paths: Array[String]^page()
            set loaded_packages: Array[KeyValuePair[String, Module]]^page()
            set loaded_module_paths: Array[KeyValuePair[String, Module]]^page()
            set errors: Array[String]^page()
            set diagnostics: Array[PlannerDiagnostic]^page()
            set sibling_programs: Array[Program]^page()
            set current_namespace: null
            set current_namespace_name: null
            set program_use_aliases: Array[String]^page()
            set program_use_namespaces: Array[String]^page()
            set next_lambda_id: 0
            set escape_records: Array[EscapeRecord]^page()
            set escape_checking: false
            set escape_found: false
            set escape_fn_index: 0

            ; Seed the function registry with C-runtime externs so name
            ; lookups for aligned_alloc/free/exit succeed from day one.
            ; Use `^page` to put runtime Function records on the Planner's
            ; owning page; `$` (default) would put them on the call's
            ; local page and dangle on return (s100).
            this.register_runtime_functions^page()
        }

        ; ================================================================
        ; Scope management (mirrors Planner::pushScope etc. in C++).
        ; ================================================================

        function push_scope(this: Planner)
        {
            scope_boundaries.add scope_bindings.length
        }

        function pop_scope(this: Planner)
        {
            if scope_boundaries.length = 0
                return

            let last_idx scope_boundaries.length - 1
            let boundary_ptr scope_boundaries.get last_idx
            if boundary_ptr <> null
                set scope_bindings.length: *boundary_ptr

            set scope_boundaries.length: last_idx
        }

        function define_local(
            this: Planner,
            name: String,
            t: PlannedType,
            is_mutable: bool,
            is_on_page: bool
        )
        {
            scope_bindings.add(
                KeyValuePair[String, LocalBinding](
                    name,
                    LocalBinding(t, is_mutable, is_on_page, false)
                )
            )
        }

        ; Define a function/init/operator parameter (or `this`/page receiver).
        ; Like define_local but marks the binding frame-EXTERNAL for the escape
        ; checker: a struct/pointer parameter is passed by pointer, so writing
        ; `param.field` stores into the CALLER's object (which outlives this
        ; frame's local page). Mirrors Planner.cpp::defineParameter.
        function define_parameter(this: Planner, name: String, t: PlannedType)
        {
            scope_bindings.add(
                KeyValuePair[String, LocalBinding](
                    name,
                    LocalBinding(t, false, false, true)
                )
            )
        }

        ; lookup_local_binding: innermost-first reverse scan. Returns
        ; null if no binding with this name is live in any current scope.
        function lookup_local_binding(this: Planner, name: String) returns ref[LocalBinding]?
        {
            if scope_bindings.length = 0
                return null

            var i scope_bindings.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr scope_bindings.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
            }
            null
        }

        function lookup_local(this: Planner, name: String) returns ref[PlannedType]?
        {
            let binding this.lookup_local_binding(name)
            if binding = null
                return null

            &binding.binding_type
        }

        ; ================================================================
        ; Generic type-parameter substitutions.
        ; ================================================================

        function define_type_substitution(this: Planner, name: String, t: PlannedType)
        {
            type_substitutions.add(KeyValuePair[String, PlannedType](name, t))
        }

        function clear_type_substitutions(this: Planner)
        {
            set type_substitutions.length: 0
        }

        function lookup_type_substitution(this: Planner, name: String) returns ref[PlannedType]?
        {
            var i: size_t 0
            while i < type_substitutions.length
            {
                let kvp_ptr type_substitutions.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Fresh type variables for HM inference.
        ; ================================================================

        function fresh_type_var_id(this: Planner) returns size_t
        {
            let id next_type_var_id
            set next_type_var_id: id + 1
            id
        }

        ; ================================================================
        ; Concept registry.
        ; ================================================================

        function register_concept(this: Planner, c: Concept)
        {
            ; Track delegate (function-pointer type) names for the emitter's
            ; map_type lowering (GAP B).
            choose c.definition
                when d: Delegate
                    delegate_names.add(String^this(c.name))
                else
                    0
            concepts.add(KeyValuePair[String, Concept](c.name, c))
            ; Maintain the O(1) index in lockstep. insert OVERWRITES on a
            ; duplicate key so the LAST-registered index wins — matching
            ; lookup_concept's backward-scan semantics (s95). This is the ONLY
            ; mutation site of `concepts` (the .add's elsewhere are to LOCAL
            ; shadowed PlannedConcept arrays), so the index stays correct even
            ; when lazy instantiation registers concepts during planning.
            concept_index.insert(c.name, concepts.length - 1)
        }

        function lookup_concept(this: Planner, name: String) returns ref[Concept]?
        {
            ; O(1) hashed lookup over concept_index, which returns the LAST
            ; index registered for `name` (insert overwrites on duplicate key).
            ; This is the stage-0-faithful last-write-wins semantics the old
            ; backward linear scan provided: `define Planner { struct Planner
            ; ( ... ) ... }` registers the outer Namespace concept first, then
            ; the inner Structure under the same name, and downstream
            ; find_initializer# / lookup_property / lookup_method# /
            ; is_struct_ctor all `choose c.definition when s: Structure ...`
            ; and need the LATER (Structure) entry. (s95)
            let idx concept_index.lookup name
            if idx >= 0
            {
                let kvp_ptr concepts.get(idx as size_t)
                if kvp_ptr <> null
                    return &kvp_ptr.value
            }
            null
        }

        ; s177: like lookup_concept but only matches a concept whose
        ; definition is a Namespace. `define Planner { define Planner(...) }`
        ; registers both under one name, and lookup_concept's backward
        ; scan (s95) returns the inner Structure. Qualified calls
        ; (`Planner.make_void_type#()` from Emitter) need the OUTER
        ; Namespace to mangle with the namespace parent — without it the
        ; whole binding statement silently drops. Mirrors stage-0's
        ; qualified-call path (Planner.cpp:8604), whose concept cache
        ; holds the Namespace for the colliding name.
        function lookup_namespace_concept(this: Planner, name: String) returns ref[Concept]?
        {
            ; Stays a backward linear scan: it filters by definition == Namespace,
            ; so concept_index's single last-index-per-name can't serve it (the
            ; last entry for a name may be a Structure). A future multi-index
            ; (name -> all indices) could serve this.
            if concepts.length = 0
                return null
            var i: size_t concepts.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr concepts.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                    {
                        var is_ns: bool false
                        choose kvp_ptr.value.definition
                            when n: Namespace
                                set is_ns: true
                            else
                                0
                        if is_ns
                            return &kvp_ptr.value
                    }
                }
            }
            null
        }

        function has_concept(this: Planner, name: String) returns bool
        {
            this.lookup_concept(name) <> null
        }

        ; GAP B delegate (function-pointer type) helpers. A delegate concept
        ; `define Cb delegate(A, B) returns R` names a function type; a lambda
        ; or function whose signature matches is assignable to a Cb-typed
        ; binding/parameter, and a Cb-typed value is callable indirectly.
        function is_delegate_type(this: Planner, name: String) returns bool
        {
            let c this.lookup_concept(name)
            if c = null
                return false
            var result: bool false
            choose (*c).definition
                when d: Delegate
                    set result: true
                else
                    0
            result
        }

        ; The delegate's parameter types as planned types (drives lambda
        ; monomorphization against the declared signature).
        function delegate_param_types#(rp, this: Planner, name: String) returns Vector[PlannedType]
        {
            var result Array[PlannedType]$()
            let c this.lookup_concept(name)
            if c <> null
                choose (*c).definition
                    when d: Delegate
                    {
                        var i: size_t 0
                        while i < d.input.length
                        {
                            let it_ptr d.input.get i
                            if it_ptr <> null
                            {
                                let it (*it_ptr)
                                if it.type <> null
                                {
                                    let pt this.plan_type#((*it.type))
                                    result.add pt
                                }
                                else
                                {
                                    ; `delegate(int)`: a bare type is modeled as a
                                    ; param NAMED "int" with no type — the name is
                                    ; the parameter's type. (`delegate(x: int)`
                                    ; takes the it.type branch above.)
                                    if it.name <> null
                                    {
                                        var nm_path Vector[String]^rp(1)
                                        nm_path.put(0, String^rp((*it.name)))
                                        let synth_ty Type(it.span, nm_path, null, scaly.compiler.Model.Lifetime.Unspecified(scaly.compiler.Model.Unspecified()))
                                        let synth_pt this.plan_type#(synth_ty)
                                        result.add synth_pt
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    else
                        0
            Vector[PlannedType]^rp(result)
        }

        function delegate_return_type#(rp, this: Planner, name: String) returns PlannedType
        {
            let c this.lookup_concept(name)
            if c <> null
                choose (*c).definition
                    when d: Delegate
                    {
                        if d.returns_ <> null
                            return this.plan_type#((*d.returns_))
                    }
                    else
                        0
            Planner.make_void_type#()
        }

        ; Instantiation-cache recording helpers. Called as each planned
        ; aggregate is produced so the final Plan lists everything the
        ; emitter needs to lower.
        function record_structure(this: Planner, s: PlannedStructure)
        {
            instantiated_structures.add s
        }

        function record_union(this: Planner, u: scalyc.compiler.Plan.PlannedUnion)
        {
            instantiated_unions.add u
        }

        ; Lookups against the instantiation caches, keyed by mangled
        ; name. Used by instantiate_generic to avoid re-planning an
        ; already-instantiated concept.
        function has_instantiated_structure(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_structures.length
            {
                let s_ptr instantiated_structures.get i
                if s_ptr <> null
                {
                    if s_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function has_instantiated_union(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_unions.length
            {
                let u_ptr instantiated_unions.get i
                if u_ptr <> null
                {
                    if u_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function record_function(this: Planner, f: PlannedFunction)
        {
            let entry_idx instantiated_functions.length
            instantiated_functions.add f
            function_name_index.insert_if_absent(f.mangled_name, entry_idx)
        }

        ; Has a function with this mangled name already been recorded in
        ; instantiated_functions? Used by the dotted-call namespace
        ; override to avoid re-declaring an extern stub for a function
        ; that was already planned (or already extern-declared).
        function has_recorded_function(this: Planner, mangled: String) returns bool
        {
            function_name_index.lookup(mangled) >= 0
        }

        function record_global(this: Planner, g: PlannedGlobal)
        {
            instantiated_globals.add g
        }

        ; lookup_global: locate a previously planned PlannedGlobal by name.
        ; Used by plan_type_operand#'s constant-folding path so a bare
        ; identifier like F_OK / SEEK_END resolves to its define value
        ; instead of falling through to PlannedExpression.Type (which
        ; emit_call drops as an arg, silently dropping the whole
        ; statement). Mirrors Planner.cpp:6950-6995.
        function lookup_global(this: Planner, name: String) returns ref[PlannedGlobal]?
        {
            var i: size_t 0
            while i < instantiated_globals.length
            {
                let g_ptr instantiated_globals.get i
                if g_ptr <> null
                {
                    if g_ptr.name.equals(name)
                        return g_ptr
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Package search paths + on-demand module loading.
        ;
        ; The Scaly Planner cannot yet drive the Scaly Parser +
        ; Modeler from its own body (would require threading a
        ; Parser instance or reifying a free-function parse entry
        ; point). Instead we take the pre-parsed-cache approach:
        ; an outer driver (cli.scaly, test harness) parses and
        ; models the required packages / sibling modules, then
        ; hands the resulting Module roots to the Planner via
        ; register_loaded_package / register_loaded_module. The
        ; load_* helpers are pure cache lookups.
        ;
        ; build_package_search_paths# / build_package_file_path#
        ; stay for callers that need to locate candidate files
        ; before parsing them.
        ; ================================================================

        function add_package_search_path(this: Planner, path: String)
        {
            search_paths.add path
        }

        ; add_sibling_program: register another Program (typically
        ; built from a peer source file) whose top-level concepts,
        ; functions and operators should be visible during planning
        ; of the primary program. The sibling is stashed here and
        ; later surfaced by register_sibling_programs right before
        ; the main-module registration pass.
        function add_sibling_program(this: Planner, prog: Program)
        {
            sibling_programs.add prog
        }

        ; record_program_uses: walk the program's main module Use
        ; clauses and store each clause's last path segment in
        ; program_use_aliases. Called once from plan_program# before
        ; plan_module# runs. The resulting alias list lets the
        ; dotted-call extern-decl gate fire for `prefix.suffix(...)`
        ; calls even when planning a loaded-package namespace body,
        ; provided the prefix names a Use-imported alias of the main
        ; program. Mirrors stage-0's Use-alias filter at
        ; Planner.cpp:7752-7789.
        function record_program_uses(this: Planner, prog: Program)
        {
            let uses prog.module_.uses
            var i: size_t 0
            while i < uses.length
            {
                let u_ptr uses.get i
                if u_ptr <> null
                {
                    let path u_ptr.path
                    if path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        if last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                        var ns_name String^this("")
                        if path.length > 1
                        {
                            let ns_ptr path.get(path.length - 2)
                            if ns_ptr <> null
                                set ns_name: String^this((*ns_ptr))
                        }
                        program_use_namespaces.add ns_name
                    }
                }
                set i: i + 1
            }
        }

        ; lookup_use_alias_namespace: scan program_use_aliases in parallel
        ; with program_use_namespaces; return the namespace segment of the
        ; use clause whose last segment equals `name`, or empty if none.
        function lookup_use_alias_namespace#(rp, this: Planner, name: String) returns String
        {
            var i: size_t 0
            while i < program_use_aliases.length
            {
                let a_ptr program_use_aliases.get i
                if a_ptr <> null
                {
                    if a_ptr.equals(name)
                    {
                        let ns_ptr program_use_namespaces.get i
                        if ns_ptr <> null
                            return String^rp((*ns_ptr))
                    }
                }
                set i: i + 1
            }
            String^rp("")
        }

        ; is_program_use_alias: linear scan of program_use_aliases.
        function is_program_use_alias(this: Planner, name: String) returns bool
        {
            var i: size_t 0
            while i < program_use_aliases.length
            {
                let a_ptr program_use_aliases.get i
                if a_ptr <> null
                {
                    if a_ptr.equals(name)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; plan_loaded_packages: extracted helper so plan_program's
        ; body stays small and a discarded plan_module# return value
        ; doesn't sit in plan_program's struct-by-value chain. The
        ; returned PlannedModule is dropped here intentionally —
        ; what we care about is the side effect of plan_function#
        ; calling record_function on every package-defined Function,
        ; which lands in instantiated_functions and is then emitted
        ; by the Emitter as both declaration and definition.
        function plan_loaded_packages#(rp, this: Planner)
        {
            var pi: size_t 0
            while pi < loaded_packages.length
            {
                let pk_ptr loaded_packages.get pi
                if pk_ptr <> null
                {
                    let pk_mod (*pk_ptr).value
                    let planned this.plan_module#(pk_mod)
                }
                set pi: pi + 1
            }
        }

        ; register_sibling_programs: walk every stashed sibling
        ; Program and populate the shared registries (concepts,
        ; model_functions, model_operators) from each one. The same
        ; register_module_concepts helper is reused so nested
        ; namespaces, sub-modules, and struct-internal concepts are
        ; all flattened into the flat maps that lookup_concept /
        ; lookup_functions / lookup_operators consult.
        function register_sibling_programs(this: Planner)
        {
            var i: size_t 0
            while i < sibling_programs.length
            {
                let prog_ptr sibling_programs.get i
                if prog_ptr <> null
                {
                    let prog (*prog_ptr)
                    this.register_module_concepts(prog.module_)
                }
                set i: i + 1
            }
        }

        ; Record a diagnostic. Callers don't need to format the message
        ; further — just describe what failed ("function not found: foo",
        ; "no matching initializer for Bar(int, String)", etc.).
        function add_error(this: Planner, message: String)
        {
            errors.add message
        }

        function has_errors(this: Planner) returns bool
        {
            errors.length > 0
        }

        ; Record a HARD diagnostic with the construct's source position.
        ; Use this only on paths where the construct is certain to be
        ; dropped from the IR — cli.run fails the compile on these.
        function add_diagnostic(this: Planner, loc: Span, message: String)
        {
            diagnostics.add(PlannerDiagnostic(loc.start, message, this.file))
        }

        function has_diagnostics(this: Planner) returns bool
        {
            diagnostics.length > 0
        }

        ; Look up a previously loaded package in the cache.
        function lookup_loaded_package(this: Planner, name: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_packages.length
            {
                let kvp_ptr loaded_packages.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Phase-1 lambda registry: record the model lambda bound to `name`.
        function record_lambda_model(this: Planner, name: String, lam: Lambda)
            lambda_models.add(KeyValuePair[String, Lambda](name, lam))

        ; Return the lambda model bound to `name`, or null. Forward scan
        ; (first binding wins) — Phase-1 lambdas are not scope-shadowed.
        function lookup_lambda_model(this: Planner, name: String) returns ref[Lambda]?
        {
            var i: size_t 0
            while i < lambda_models.length
            {
                let kvp_ptr lambda_models.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Look up a previously loaded intra-package module by its full
        ; file path.
        function lookup_loaded_module_path(this: Planner, path: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_module_paths.length
            {
                let kvp_ptr loaded_module_paths.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(path)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Build the list of directories to probe for a named package.
        ; Mirrors Planner.cpp's loadPackageOnDemand search list: cwd's
        ; packages/, then any user-provided -I paths. Walking the
        ; source file's parent chain is omitted here — the call sites
        ; that need it can push additional entries via
        ; add_package_search_path.
        function build_package_search_paths#(rp, this: Planner) returns Vector[String]
        {
            var paths Array[String]$()
            paths.add(String^rp("packages"))

            var i: size_t 0
            while i < search_paths.length
            {
                let p_ptr search_paths.get i
                if p_ptr <> null
                    paths.add((*p_ptr))
                set i: i + 1
            }

            Vector[String]^rp(paths)
        }

        ; Compose "base/<name>/<version>/<name>.scaly" using Path.join#.
        function build_package_file_path#(
            rp,
            this: Planner,
            base: String,
            name: String,
            version: String
        ) returns String
        {
            let step1 Path.join^rp(base, name)
            let step2 Path.join^rp(step1, version)
            var file_sb StringBuilder^rp()
            file_sb.append name
            file_sb.append ".scaly"
            let file_part file_sb.to_string^rp()
            Path.join^rp(step2, file_part)
        }

        ; register_loaded_package: pre-populate the package cache.
        ; Callers (cli.scaly, test harnesses) parse a package source
        ; file externally, build a Model.Module for it, then hand
        ; the root Module here keyed by package name.
        ;
        ; This is the pre-parsed-cache wiring: the Scaly Planner
        ; can't drive the Scaly Parser + Modeler from its own body
        ; yet, so the orchestration of "find the .scaly file, parse
        ; it, model it" happens one level up. The Planner just asks
        ; "do you have package X for me?" via load_package_on_demand#.
        function register_loaded_package(this: Planner, name: String, mod: Module)
        {
            loaded_packages.add(KeyValuePair[String, Module](name, mod))
        }

        ; register_loaded_module: pre-populate the intra-package
        ; module cache keyed by full file path. Same contract as
        ; register_loaded_package — parsing + modelling happens
        ; outside the Planner; the Planner consults this cache when
        ; a `use` statement references a peer module file.
        function register_loaded_module(this: Planner, path: String, mod: Module)
        {
            loaded_module_paths.add(KeyValuePair[String, Module](path, mod))
        }

        ; load_package_on_demand: cache-only lookup of a package by
        ; name. Returns the pre-registered root Module if one is
        ; cached, otherwise null. Pre-registration happens via
        ; register_loaded_package. The filesystem probing helpers
        ; (build_package_search_paths#, build_package_file_path#)
        ; are retained for callers that want to discover candidate
        ; files before parsing them externally.
        function load_package_on_demand#(
            rp,
            this: Planner,
            name: String
        ) returns ref[Module]?
        {
            this.lookup_loaded_package(name)
        }

        ; load_intra_package_module: cache-only lookup of a peer
        ; module inside an already-mounted package, keyed by the
        ; full file path ("BasePath/ModuleName.scaly"). Callers
        ; pre-populate via register_loaded_module.
        function load_intra_package_module#(
            rp,
            this: Planner,
            base_path: String,
            module_name: String
        ) returns ref[Module]?
        {
            var name_sb StringBuilder^rp()
            name_sb.append module_name
            name_sb.append ".scaly"
            let file_part name_sb.to_string^rp()
            let mod_path Path.join^rp(base_path, file_part)

            this.lookup_loaded_module_path(mod_path)
        }

        ; ================================================================
        ; Model-function and operator registries.
        ; ================================================================

        function register_function(this: Planner, f: Function)
        {
            model_functions.add(KeyValuePair[String, Function](f.name, f))
            model_function_index.insert(f.name, model_functions.length - 1)
        }

        function register_operator(this: Planner, o: Operator)
        {
            model_operators.add(KeyValuePair[String, Operator](o.name, o))
            model_operator_index.insert(o.name, model_operators.length - 1)
        }

        ; lookup_functions: return every Function in the registry whose
        ; name matches. Overloads are preserved — the caller picks by
        ; argument-type compatibility.
        function lookup_functions#(rp, this: Planner, name: String) returns Vector[Function]
        {
            var matches Array[Function]$()
            var cur model_function_index.lookup_head name
            while cur <> (0 - 1) as i64
            {
                let kvp_ptr model_functions.get(cur as size_t)
                if kvp_ptr <> null
                    matches.add kvp_ptr.value
                set cur: model_function_index.next_of(cur as size_t)
            }
            Vector[Function]^rp(matches)
        }

        function lookup_operators#(rp, this: Planner, name: String) returns Vector[Operator]
        {
            var matches Array[Operator]$()
            var cur model_operator_index.lookup_head name
            while cur <> (0 - 1) as i64
            {
                let kvp_ptr model_operators.get(cur as size_t)
                if kvp_ptr <> null
                    matches.add kvp_ptr.value
                set cur: model_operator_index.next_of(cur as size_t)
            }
            Vector[Operator]^rp(matches)
        }

        function is_function(this: Planner, name: String) returns bool
        {
            model_function_index.lookup_head(name) <> (0 - 1) as i64
        }

        ; True iff `name` is a declared operator (in the operator-symbol
        ; registry). Used to give text-named operators a precedence and, in
        ; stage-0, to recognise them in infix position.
        function is_operator(this: Planner, name: String) returns bool
        {
            model_operator_index.lookup_head(name) <> (0 - 1) as i64
        }

        ; ================================================================
        ; register_runtime_functions: synthesize Function entries for the
        ; C runtime functions the RBMM lowering needs (aligned_alloc,
        ; free, exit, …). Matches Planner.cpp's static table.
        ;
        ; Idempotent — call as many times as desired; the registry is
        ; appended to, and duplicates are tolerated by lookup_functions
        ; (it walks every entry anyway).
        ;
        ; Parameter items and return types are built with Type.name
        ; Vectors so resolve_type_base recognises them correctly.
        ; ================================================================
        function register_runtime_functions#(rp, this: Planner)
        {
            ; All Vector / String / Type containers must live on `rp`
            ; (the Planner's owning page) — `$` would put them on this
            ; function's local page, which is freed on return, leaving
            ; every Item.type and Type.generics ref dangling. Symptom
            ; (s100): later `lookup_functions("exit")` returns a Function
            ; whose param Type.generics reads as a tiny non-null bogus
            ; pointer (e.g. 0x8), and resolve_type_base# crashes on
            ; deref.
            ;
            ; Type itself is a value-defined struct (no init#) so we
            ; can't write `Type^rp(...)`. Instead, hold each Type in a
            ; Vector[Type]^rp(1) and take a ref via `vec.get(0)` —
            ; mirrors handle_type# in Modeler.scaly.

            ; aligned_alloc(alignment: size_t, size: size_t) -> pointer[void]
            var aa_size_path Vector[String]^rp(1)
            aa_size_path.put(0, String^rp("size_t"))
            var aa_size_holder Vector[Type]^rp(1)
            aa_size_holder.put(0, Type(
                Span(0, 0), aa_size_path, null,
                Lifetime.Unspecified(Unspecified())
            ))
            let aa_size_ref aa_size_holder.get 0

            var aa_void_path Vector[String]^rp(1)
            aa_void_path.put(0, String^rp("void"))
            var aa_void_holder Vector[Type]^rp(1)
            aa_void_holder.put(0, Type(
                Span(0, 0), aa_void_path, null,
                Lifetime.Unspecified(Unspecified())
            ))

            var aa_ptr_gens_holder Vector[Vector[Type]]^rp(1)
            aa_ptr_gens_holder.put(0, aa_void_holder)
            let aa_ptr_gens_ref aa_ptr_gens_holder.get 0

            var aa_ptr_path Vector[String]^rp(1)
            aa_ptr_path.put(0, String^rp("pointer"))
            var aa_ptr_void_holder Vector[Type]^rp(1)
            aa_ptr_void_holder.put(0, Type(
                Span(0, 0), aa_ptr_path, aa_ptr_gens_ref,
                Lifetime.Unspecified(Unspecified())
            ))
            let aa_ptr_void_ref aa_ptr_void_holder.get 0

            var aa_alignment_name Vector[String]^rp(1)
            aa_alignment_name.put(0, String^rp("alignment"))
            var aa_size_name Vector[String]^rp(1)
            aa_size_name.put(0, String^rp("size"))

            var aa_inputs Vector[Item]^rp(2)
            aa_inputs.put(0, Item(
                Span(0, 0), false,
                aa_alignment_name.get 0,
                aa_size_ref,
                Vector[Attribute]^rp(0)
            ))
            aa_inputs.put(1, Item(
                Span(0, 0), false,
                aa_size_name.get 0,
                aa_size_ref,
                Vector[Attribute]^rp(0)
            ))
            let aligned_alloc_fn Function(
                Span(0, 0), false, false,
                String^rp("aligned_alloc"),
                Vector[GenericParameter]^rp(0),
                null,
                aa_inputs,
                aa_ptr_void_ref,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(aligned_alloc_fn)

            ; free(ptr: pointer[void])
            var free_ptr_name Vector[String]^rp(1)
            free_ptr_name.put(0, String^rp("ptr"))
            var free_inputs Vector[Item]^rp(1)
            free_inputs.put(0, Item(
                Span(0, 0), false,
                free_ptr_name.get 0,
                aa_ptr_void_ref,
                Vector[Attribute]^rp(0)
            ))
            let free_fn Function(
                Span(0, 0), false, false,
                String^rp("free"),
                Vector[GenericParameter]^rp(0),
                null,
                free_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(free_fn)

            ; exit(code: int)
            var int_path Vector[String]^rp(1)
            int_path.put(0, String^rp("int"))
            var int_holder Vector[Type]^rp(1)
            int_holder.put(0, Type(
                Span(0, 0), int_path, null,
                Lifetime.Unspecified(Unspecified())
            ))
            let int_ref int_holder.get 0

            var exit_code_name Vector[String]^rp(1)
            exit_code_name.put(0, String^rp("code"))
            var exit_inputs Vector[Item]^rp(1)
            exit_inputs.put(0, Item(
                Span(0, 0), false,
                exit_code_name.get 0,
                int_ref,
                Vector[Attribute]^rp(0)
            ))
            let exit_fn Function(
                Span(0, 0), false, false,
                String^rp("exit"),
                Vector[GenericParameter]^rp(0),
                null,
                exit_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(exit_fn)
        }

        ; ================================================================
        ; Method / initializer / property lookup on user types.
        ; ================================================================

        ; collect_methods_in: linear scan of a members Vector, appending
        ; every Function whose name matches. Shared by lookup_methods
        ; across Structure and Union variants.
        function collect_methods_in(
            this: Planner,
            members: Vector[Member],
            method_name: String,
            acc: Array[Function]
        )
        {
            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            if f.name.equals(method_name)
                                acc.add f
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
        }

        function lookup_methods#(
            rp,
            this: Planner,
            struct_name: String,
            method_name: String
        ) returns Vector[Function]
        {
            var matches Array[Function]$()
            ; s106: when struct_name is namespaced under "scaly." or
            ; "scalyc.", retry with the bare type name if the qualified
            ; name doesn't match. Mirrors Planner.cpp:1447-1453.
            ; Without this, init#'s implicit `page` parameter (typed
            ; pointer[scaly.memory.Page]) never resolves
            ; `page.allocate(...)` against the user's `define Page`, and
            ; the entire `set X: page.allocate(...)` action is dropped.
            var concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
            {
                var should_strip: bool false
                if struct_name.starts_with("scaly.")
                    set should_strip: true
                if struct_name.starts_with("scalyc.")
                    set should_strip: true
                if should_strip
                {
                    let last_dot struct_name.last_index_of("." as u8)
                    if last_dot >= 0
                    {
                        let start (last_dot as size_t) + 1
                        let len struct_name.get_length() - start
                        let bare struct_name.substring(rp, start, len)
                        set concept_ref: this.lookup_concept(bare)
                    }
                }
            }
            if concept_ref = null
                return Vector[Function]^rp(matches)

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    this.collect_methods_in(s.members, method_name, matches)
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    this.collect_methods_in(u.members, method_name, matches)
                    0
                }
                else
                    0

            Vector[Function]^rp(matches)
        }

        ; lookup_property: find a struct field by name. Returns a
        ; reference into the Structure's properties Vector — valid as
        ; long as the underlying Concept is live in the registry.
        function lookup_property(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns ref[Property]?
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get i
                        if p_ptr <> null
                        {
                            if p_ptr.name.equals(property_name)
                                return p_ptr
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; find_initializer: locate an Initializer on a Struct-shaped
        ; concept whose parameter types are pairwise compatible with
        ; `arg_types`. Returns null when no match. Deliberately linear —
        ; matching against the first compatible overload.
        ; check_initializer_match: returns the Initializer pointer if
        ; its input matches arg_types (after skipping any implicit
        ; page parameter, which is already excluded from input by the
        ; Modeler). `exact_only` selects types_equal vs types_compatible.
        function check_initializer_match#(
            rp,
            this: Planner,
            ini: Initializer,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            if ini.input.length <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr ini.input.get j
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let pt (*p_ptr.type)
                    let planned_pt this.plan_type#(pt)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_pt, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_pt, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }

            true
        }

        function find_initializer#(
            rp,
            this: Planner,
            struct_name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[Initializer]?
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    ; Pass 1: exact match.
                    var i: size_t 0
                    while i < s.initializers.length
                    {
                        let init_ptr s.initializers.get i
                        if init_ptr <> null
                        {
                            let ini (*init_ptr)
                            if this.check_initializer_match#(ini, arg_types, true)
                                return init_ptr
                        }
                        set i: i + 1
                    }
                    ; Pass 2: compatible match.
                    var k: size_t 0
                    while k < s.initializers.length
                    {
                        let init_ptr s.initializers.get k
                        if init_ptr <> null
                        {
                            let ini (*init_ptr)
                            if this.check_initializer_match#(ini, arg_types, false)
                                return init_ptr
                        }
                        set k: k + 1
                    }

                    ; Pass 3: generic inference. For each initializer,
                    ; plan the parameter types, infer generic bindings
                    ; against arg_types, and accept if the concept's
                    ; parameters are fully bound.
                    if c.parameters.length > 0
                    {
                        var g: size_t 0
                        while g < s.initializers.length
                        {
                            let init_ptr s.initializers.get g
                            if init_ptr <> null
                            {
                                let ini (*init_ptr)
                                if ini.input.length = arg_types.length
                                {
                                    var param_types_arr Array[PlannedType]$()
                                    var pi: size_t 0
                                    while pi < ini.input.length
                                    {
                                        let p_ptr ini.input.get pi
                                        if p_ptr <> null
                                        {
                                            if p_ptr.type <> null
                                            {
                                                let pt (*p_ptr.type)
                                                param_types_arr.add(this.plan_type#(pt))
                                            }
                                        }
                                        set pi: pi + 1
                                    }
                                    var param_types_vec Vector[PlannedType]^rp(param_types_arr)
                                    let bindings this.infer_type_arguments#(
                                        param_types_vec, arg_types
                                    )
                                    if bindings.length >= c.parameters.length
                                        return init_ptr
                                }
                            }
                            set g: g + 1
                        }
                    }

                    null
                }
                else
                    null
        }

        ; get_property_index: position of a named property in the struct.
        ; Returns -1 if the type isn't a struct or the property is missing.
        function get_property_index(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get i
                        if p_ptr <> null
                        {
                            if p_ptr.name.equals(property_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant: find a union variant by name and return its tag.
        ; Returns -1 if the concept is missing or not a Union, or if the
        ; variant name is not present.
        function lookup_variant_tag(
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(union_name)
            if concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get i
                        if v_ptr <> null
                        {
                            ; Scaly `when TypeName: x` matches by the
                            ; variant's TYPE name (last dotted segment),
                            ; not its declared field name. `Empty: EmptySyntax`
                            ; has name="Empty" but the when-arm reads
                            ; "EmptySyntax". Fall back to the field name for
                            ; Result-style `when err: Error`. Mirrors stage-0
                            ; Planner.cpp:11291-11313.
                            if v_ptr.type <> null
                            {
                                let type_ptr v_ptr.type
                                let type_val (*type_ptr)
                                if type_val.name.length > 0
                                {
                                    let last_ptr type_val.name.get(type_val.name.length - 1)
                                    if last_ptr <> null
                                        if last_ptr.equals(variant_name)
                                            return i as int
                                }
                            }
                            if v_ptr.name.equals(variant_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant_type: fetch the payload PlannedType for a named
        ; variant. Returns null when the concept isn't a union, the
        ; variant doesn't exist, or the variant has no payload (tag-only
        ; variants like Option.None).
        function lookup_variant_type#(
            rp,
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns ref[PlannedType]?
        {
            let concept_ref this.lookup_concept(union_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get i
                        if v_ptr <> null
                        {
                            ; Match by variant TYPE name (last dotted
                            ; segment) first, then fall back to field name.
                            ; Mirrors lookup_variant_tag / stage-0
                            ; Planner.cpp:11291-11313.
                            var matched: bool false
                            if v_ptr.type <> null
                            {
                                let type_ptr v_ptr.type
                                let type_val (*type_ptr)
                                if type_val.name.length > 0
                                {
                                    let last_ptr type_val.name.get(type_val.name.length - 1)
                                    if last_ptr <> null
                                        if last_ptr.equals(variant_name)
                                            set matched: true
                                }
                            }
                            if matched = false
                                if v_ptr.name.equals(variant_name)
                                    set matched: true
                            if matched = true
                            {
                                if v_ptr.type = null
                                    return null
                                let vt (*v_ptr.type)
                                var holder Vector[PlannedType]^rp(1)
                                holder.put(0, this.plan_type#(vt))
                                return holder.get 0
                            }
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; match_type_pattern: walk `pattern` and `actual` in parallel,
        ; collecting generic-parameter → concrete-type bindings.
        ; Recursion handles nested generics (e.g. matching `Vector[T]`
        ; against `Vector[int]` yields `T -> int`).
        ;
        ; Runs purely — returns a fresh Vector each call rather than
        ; mutating a caller-supplied accumulator, because passing a
        ; mutable Array as a parameter doesn't propagate in Scaly's
        ; value-semantics model.
        function match_type_pattern#(
            rp,
            this: Planner,
            pattern: PlannedType,
            actual: PlannedType
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]$()

            if Planner.is_generic_type_param_name(pattern.name)
            {
                result.add(KeyValuePair[String, PlannedType](pattern.name, actual))
                return Vector[KeyValuePair[String, PlannedType]]^rp(result)
            }

            ; s167: the outer type constructors must match before recursing
            ; into generics. Without this, `Vector[T]` matched `Array[String]`
            ; (binding T=String from the inner generic), so find_initializer#
            ; Pass 3 picked Vector's copy ctor `init#(other: Vector[T])` (which
            ; precedes `init#(array: Array[T])`) for `Vector[String]#(an Array)`
            ; — emitting a Vector(Vector) call passed an Array struct, whose
            ; vector-ptr field was read as the data ptr → garbage String
            ; elements → String::hash SIGSEGV.
            if pattern.name.equals(actual.name) = false
                return Vector[KeyValuePair[String, PlannedType]]^rp(result)

            if pattern.generics <> null
            {
                if actual.generics <> null
                {
                    let pg (*pattern.generics)
                    let ag (*actual.generics)
                    if pg.length = ag.length
                    {
                        var i: size_t 0
                        while i < pg.length
                        {
                            let pp_ptr pg.get i
                            let ap_ptr ag.get i
                            if pp_ptr <> null
                            {
                                if ap_ptr <> null
                                {
                                    let inner this.match_type_pattern#(
                                        (*pp_ptr), (*ap_ptr)
                                    )
                                    var j: size_t 0
                                    while j < inner.length
                                    {
                                        let kv_ptr inner.get j
                                        if kv_ptr <> null
                                            result.add((*kv_ptr))
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
            }

            Vector[KeyValuePair[String, PlannedType]]^rp(result)
        }

        ; infer_type_arguments: given a function's parameter types
        ; (possibly containing generic parameters like T, K) and the
        ; actual argument types at a call site, infer the concrete type
        ; assignments. Returns a flat Vector of name→type pairs; may
        ; contain duplicates for a generic parameter inferred from
        ; multiple positions (all should agree — agreement is checked
        ; downstream during substitution).
        function infer_type_arguments#(
            rp,
            this: Planner,
            param_types: Vector[PlannedType],
            arg_types: Vector[PlannedType]
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]$()
            if param_types.length <> arg_types.length
                return Vector[KeyValuePair[String, PlannedType]]^rp(result)

            var i: size_t 0
            while i < param_types.length
            {
                let p_ptr param_types.get i
                let a_ptr arg_types.get i
                if p_ptr <> null
                {
                    if a_ptr <> null
                    {
                        let matches this.match_type_pattern#(
                            (*p_ptr), (*a_ptr)
                        )
                        var j: size_t 0
                        while j < matches.length
                        {
                            let kv_ptr matches.get j
                            if kv_ptr <> null
                                result.add((*kv_ptr))
                            set j: j + 1
                        }
                    }
                }
                set i: i + 1
            }

            Vector[KeyValuePair[String, PlannedType]]^rp(result)
        }

        ; instantiate_generic_function: monomorphise a generic function
        ; (one whose parameter types reference type-parameter names like
        ; T / K / V) against a substitution mapping those names to
        ; concrete types. The resulting PlannedFunction has each use of
        ; T replaced with its concrete binding, and is recorded in the
        ; instantiation cache via plan_function.
        function instantiate_generic_function#(
            rp,
            this: Planner,
            f: Function,
            args: Vector[KeyValuePair[String, PlannedType]]
        ) returns PlannedFunction
        {
            let saved_len type_substitutions.length

            var i: size_t 0
            while i < args.length
            {
                let kv_ptr args.get i
                if kv_ptr <> null
                    this.define_type_substitution(kv_ptr.key, kv_ptr.value)
                set i: i + 1
            }

            let result this.plan_function#(f, null)
            set type_substitutions.length: saved_len
            result
        }

        ; ================================================================
        ; instantiate_generic: monomorphise a generic Concept against a
        ; concrete type-argument list. Binds each GenericParameter name
        ; to its corresponding argument in `type_substitutions`, plans
        ; the concept's definition so the struct-layout cache gets the
        ; instantiated version, then restores the substitution stack.
        ;
        ; Returns the resulting PlannedType with `generics` populated
        ; and `mangled_name` set via mangle_structure. Missing concepts
        ; fall back to a fresh type variable — keeps the planner
        ; productive on incomplete programs.
        ; ================================================================
        function instantiate_generic#(
            rp,
            this: Planner,
            concept_name: String,
            args: Vector[PlannedType],
            loc: Span
        ) returns PlannedType
        {
            let concept_ref this.lookup_concept(concept_name)
            if concept_ref = null
                return this.fresh_type_var#(concept_name)

            let c (*concept_ref)

            ; Compute the mangled name upfront so we can short-circuit
            ; repeat instantiations (e.g. Vector[int] used from two
            ; sites). Without this, each call would re-plan the
            ; definition and re-append to instantiated_{structures,
            ; unions}.
            var args_holder Vector[PlannedType]^rp(args)
            let mangled Planner.mangle_structure#(concept_name, &args_holder)

            var already_cached: bool false
            if this.has_instantiated_structure(mangled)
                set already_cached: true
            if already_cached = false
                if this.has_instantiated_union(mangled)
                    set already_cached: true

            ; s116: cycle detection. Re-entry during cross-module
            ; nested-generic planning (plan_structure# walks members →
            ; plan_function# → plan_type# → instantiate_generic#) was
            ; blowing the stack in resolve_type_base# before the outer
            ; struct landed in instantiated_structures. If `mangled` is
            ; already in instantiating_structures, return the shell
            ; PlannedType without re-planning. The outer call eventually
            ; completes and records the structure.
            if already_cached = false
            {
                var i: size_t 0
                while i < instantiating_structures.length
                {
                    let im_ptr instantiating_structures.get i
                    if im_ptr <> null
                    {
                        if im_ptr.equals(mangled)
                            set already_cached: true
                    }
                    set i: i + 1
                }
            }

            if already_cached = false
            {
                instantiating_structures.add mangled

                let saved_subst_len type_substitutions.length

                ; Bind each generic parameter name to its concrete argument.
                var i: size_t 0
                while i < c.parameters.length
                {
                    if i < args.length
                    {
                        let p_ptr c.parameters.get i
                        let a_ptr args.get i
                        if p_ptr <> null
                        {
                            if a_ptr <> null
                                this.define_type_substitution(p_ptr.name, (*a_ptr))
                        }
                    }
                    set i: i + 1
                }

                ; Plan the underlying definition so the cache records
                ; the instantiated struct/union. The returned planned
                ; value is unused — we rebuild the PlannedType shell
                ; below with the correct generics/mangled_name.
                choose c.definition
                    when s: Structure
                    {
                        let pl this.plan_structure#(s, concept_name)
                        0
                    }
                    when u: scalyc.compiler.Model.Union
                    {
                        let pl this.plan_union#(u, concept_name)
                        0
                    }
                    else
                        0

                ; Pop substitutions back to what the caller had.
                set type_substitutions.length: saved_subst_len

                ; Pop instantiating-marker. Length-based pop matches the
                ; type_substitutions discipline above; the add() above
                ; was the only push for this frame.
                if instantiating_structures.length > 0
                    set instantiating_structures.length: instantiating_structures.length - 1
            }

            PlannedType(
                loc,
                String^rp(concept_name),
                mangled,
                &args_holder,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            )
        }

        ; ================================================================
        ; check_function_match: test a single Function candidate against
        ; argument types. Returns a ref to the return type if it matches,
        ; null otherwise. `exact_only` selects types_equal (true) vs
        ; types_compatible (false) for parameter/argument comparison.
        ; 'this' parameters are skipped implicitly.
        ; ================================================================
        ; Pure match predicate for overload resolution passes 1 (exact) and
        ; 2 (compatible). NON-`#` on purpose: a #-subcall like plan_type#
        ; allocates on THIS function's local page (not the caller's rp), so
        ; the candidate parameter types planned only to compare against the
        ; args are reclaimed when this returns — instead of accumulating on
        ; the persistent region for every losing candidate of every call
        ; (the dominant transient in -c, measured ~1.2-1.9 MB/LOC of planner
        ; allocation). resolve_function_call# rebuilds the WINNER on rp via
        ; check_function_match#; only the winner's types persist. Mirrors
        ; check_function_match#'s arity + per-param comparison exactly so the
        ; rebuild always agrees. plan_type# is side-effect-free (no
        ; instantiation — pass 3 keeps using check_function_match# directly).
        function candidate_matches(
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }
            true
        }

        function check_function_match#(
            rp,
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[MethodMatch]?
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return null

            var planned_params_arr Array[PlannedType]$()
            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return null
                if a_ptr = null
                    return null
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return null
                    planned_params_arr.add planned_p
                }
                set j: j + 1
            }
            var params_holder Vector[PlannedType]^rp(planned_params_arr)

            var return_type: PlannedType Planner.make_void_type#()
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type#(rt)
            }

            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            if Planner.needs_implicit_return_page(f)
                set has_page: true

            ; Extern C functions use their unmangled name so the linker
            ; finds them in libc / system libraries. Mirrors
            ; Planner.cpp:9714-9716.
            var mangled: String String^rp(f.name)
            if Planner.is_extern_impl(f.implementation) = false
            {
                ; s101: Namespace sibling call. When the call is being
                ; planned inside a namespace's body and `f` is a member
                ; of that namespace, mangle with the namespace prefix
                ; (e.g. `_ZN6helper5greetEv`) instead of the free-function
                ; encoding (`_Z5greetv`). Mirrors stage-0 Planner.cpp:
                ; 9653-9665 (sibling detection) + 9788-9793 (mangling).
                ; Without this, sibling calls from inside `define helper
                ; { function greet() ... function test() greet() }` link
                ; against a non-existent `_Z5greetv` symbol, the call
                ; falls through to lookup-fail in emit_call, returns
                ; null, and stage-1 silently drops the entire body.
                var is_namespace_sibling: bool false
                if current_namespace <> null
                {
                    if current_namespace_name <> null
                    {
                        let ns (*current_namespace)
                        var mi: size_t 0
                        while mi < ns.members.length
                        {
                            let m_ptr ns.members.get mi
                            if m_ptr <> null
                            {
                                let mem (*m_ptr)
                                choose mem
                                    when nf: Function
                                    {
                                        if nf.name.equals(f.name)
                                        {
                                            if nf.input.length = f.input.length
                                                set is_namespace_sibling: true
                                        }
                                    }
                                    else
                                        0
                            }
                            set mi: mi + 1
                        }
                    }
                }

                ; Determine the namespace to mangle with: the current
                ; namespace for a sibling call, otherwise the namespace of
                ; a use-imported alias matching f.name (s192 — use-aliased
                ; bare calls must mangle `_ZN<ns><fn>E…` like the member's
                ; definition, not the free `_Z<fn>…` which links nowhere).
                var ns_for_mangle String^rp("")
                if is_namespace_sibling
                {
                    let cnsn (*current_namespace_name)
                    set ns_for_mangle: String^rp(cnsn)
                }
                if is_namespace_sibling = false
                    set ns_for_mangle: this.lookup_use_alias_namespace#(f.name)

                if ns_for_mangle.get_length() = 0
                    set mangled: Planner.mangle_free_function_from_types#(
                        f.name, params_holder, has_page
                    )

                if ns_for_mangle.get_length() > 0
                {
                    ; Build a PlannedType for the namespace and items
                    ; for params, then call mangle_function# with parent.
                    let cnsn ns_for_mangle
                    var ns_parent_holder Vector[PlannedType]^rp(1)
                    ns_parent_holder.put(0, PlannedType(
                        Span(0, 0),
                        String^rp(cnsn),
                        Planner.encode_name cnsn,
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        String^rp(""),
                        null
                    ))
                    let ns_parent_ref ns_parent_holder.get 0
                    var items_arr Array[PlannedItem]$()
                    var pi2: size_t 0
                    while pi2 < params_holder.length
                    {
                        let p_ptr2 params_holder.get pi2
                        if p_ptr2 <> null
                        {
                            var ity_holder Vector[PlannedType]^rp(1)
                            ity_holder.put(0, (*p_ptr2))
                            items_arr.add(PlannedItem(
                                Span(0, 0),
                                false,
                                null,
                                ity_holder.get 0,
                                null
                            ))
                        }
                        set pi2: pi2 + 1
                    }
                    var items_holder Vector[PlannedItem]^rp(items_arr)
                    set mangled: Planner.mangle_function#(
                        f.name, &items_holder, ns_parent_ref, has_page
                    )
                }
            }

            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                var th_holder Vector[PlannedType]^rp(1)
                th_holder.put(0, this.plan_type#(tt))
                set throws_ref: th_holder.get(0)
            }

            var match_holder Vector[MethodMatch]^rp(1)
            match_holder.put(0, MethodMatch(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false,
                false
            ))
            match_holder.get 0
        }

        ; s-LSP: is `prefix` a namespace declaring a member function named
        ; `suffix` whose first parameter is `this`? Used by the dotted-call
        ; fallback to recognise a namespace this-method invoked qualified
        ; with an explicit receiver (`NS.f(recv, ...)`). Mirrors the member
        ; scan in stage-0's name-only Namespace path (Planner.cpp:8663-8674).
        ; Kept out of collapse_operand_sequence# (its frame is the heaviest
        ; in the compiler) so stage-1 emits it correctly into stage-2.
        function is_namespace_this_method#(rp, this: Planner, prefix: String, suffix: String) returns bool
        {
            let ns_chk this.lookup_namespace_concept(prefix)
            if ns_chk <> null
            {
                let nsc_chk (*ns_chk)
                choose nsc_chk.definition
                    when nd_chk: Namespace
                    {
                        var mci: size_t 0
                        while mci < nd_chk.members.length
                        {
                            let mcp nd_chk.members.get mci
                            if mcp <> null
                            {
                                let mc (*mcp)
                                choose mc
                                    when ncf: Function
                                    {
                                        if ncf.name.equals(suffix)
                                        {
                                            if ncf.input.length > 0
                                            {
                                                let nmi0 ncf.input.get 0
                                                if nmi0 <> null
                                                {
                                                    if nmi0.name <> null
                                                    {
                                                        if (*nmi0.name).equals(String$("this"))
                                                            return true
                                                    }
                                                }
                                            }
                                        }
                                        0
                                    }
                                    else
                                        0
                            }
                            set mci: mci + 1
                        }
                    }
                    else
                        0
            }
            false
        }

        ; s-LSP: resolve `NS.f(recv, ...)` where `f(this: T, ...)` is a
        ; namespace this-method invoked qualified with an explicit receiver.
        ; Returns the MethodMatch (this-implicit, so `_ZN<ns><fn>E…`) or null.
        ; Builds the receiver-dropped argument list in ITS OWN frame and
        ; resolves the this-implicit overload; the caller's namespace-mangling
        ; block then rebuilds the namespaced mangled name. Kept whole here so
        ; collapse_operand_sequence# adds no locals (its s178 alloca pool
        ; mis-aliases any added there — see the call site).
        function resolve_namespace_this_method#(
            rp,
            this: Planner,
            prefix: String,
            suffix: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            if arg_types.length > 0
            {
                if this.is_namespace_this_method#(prefix, suffix)
                {
                    var tail_arr Array[PlannedType]$()
                    var tci: size_t 1
                    while tci < arg_types.length
                    {
                        let tap arg_types.get tci
                        if tap <> null
                            tail_arr.add((*tap))
                        set tci: tci + 1
                    }
                    var tail_vec Vector[PlannedType]^rp(tail_arr)
                    return this.resolve_function_call#(suffix, tail_vec)
                }
            }
            null
        }

        ; s-LSP: the dotted-call fallback's resolution, as ONE call so the
        ; caller (collapse_operand_sequence#) keeps a single `set match_ref:`
        ; statement — adding a branch there perturbed its s178 alloca pool.
        ; Try the normal this-implicit overload first; if that misses, try the
        ; namespace this-method-with-explicit-receiver form.
        function resolve_dotted_call#(
            rp,
            this: Planner,
            prefix: String,
            suffix: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            let m this.resolve_function_call#(suffix, arg_types)
            if m <> null
                return m
            this.resolve_namespace_this_method#(prefix, suffix, arg_types)
        }

        ; ================================================================
        ; resolve_function_call: return a MethodMatch describing the
        ; chosen overload of `name` for the given argument types. Two-pass
        ; overload resolution: exact matches first, then compatible
        ; (widened), then generic instantiation. 'this' parameters are
        ; implicitly skipped.
        ;
        ; Returns null when no overload matches; callers fall back to a
        ; fresh type variable so the constraint solver can recover.
        ; ================================================================
        function resolve_function_call#(
            rp,
            this: Planner,
            name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            let candidates this.lookup_functions#(name)
            if candidates.length = 0
            {
                var sb StringBuilder$()
                sb.append "function not found: "
                sb.append name
                this.add_error(sb.to_string^rp())
                return null
            }

            ; Pass 1: exact matches (types_equal).
            var i: size_t 0
            while i < candidates.length
            {
                let f_ptr candidates.get i
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if this.candidate_matches(f, arg_types, true)
                        return this.check_function_match#(f, arg_types, true)
                }
                set i: i + 1
            }

            ; Pass 2: compatible matches (types_compatible, allows widening).
            var k: size_t 0
            while k < candidates.length
            {
                let f_ptr candidates.get k
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if this.candidate_matches(f, arg_types, false)
                        return this.check_function_match#(f, arg_types, false)
                }
                set k: k + 1
            }

            ; Pass 3: generic overload. For candidates declaring type
            ; parameters, plan the declared parameter types and run
            ; pattern inference against the argument types. On a
            ; successful inference, instantiate the generic and build a
            ; MethodMatch from the instantiated PlannedFunction.
            var g: size_t 0
            while g < candidates.length
            {
                let f_ptr candidates.get g
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if f.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        if f.input.length > 0
                        {
                            let fi0 f.input.get 0
                            if fi0 <> null
                            {
                                if fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    if fname.equals(String$("this"))
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity f.input.length - param_start2
                        if expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]$()
                            var pi: size_t param_start2
                            while pi < f.input.length
                            {
                                let p_ptr f.input.get pi
                                if p_ptr <> null
                                {
                                    if p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type#(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType]^rp(param_types_arr)

                            let bindings this.infer_type_arguments#(
                                param_types_vec, arg_types
                            )
                            if bindings.length >= f.parameters.length
                            {
                                let inst this.instantiate_generic_function#(f, bindings)
                                var inst_return: PlannedType Planner.make_void_type#()
                                if inst.return_type <> null
                                    set inst_return: (*inst.return_type)

                                var gm_takes_this: bool false
                                if param_start2 > 0
                                    set gm_takes_this: true
                                var match_holder Vector[MethodMatch]^rp(1)
                                match_holder.put(0, MethodMatch(
                                    null,
                                    inst.mangled_name,
                                    inst_return,
                                    &param_types_vec,
                                    inst.page_parameter <> null,
                                    inst.can_throw,
                                    inst.throws_type,
                                    false,
                                    gm_takes_this
                                ))
                                return match_holder.get 0
                            }
                        }
                    }
                }
                set g: g + 1
            }

            var sb StringBuilder$()
            sb.append "no matching overload for function: "
            sb.append name
            this.add_error(sb.to_string^rp())
            null
        }

        ; mangle_binary_operator: convenience wrapper that constructs
        ; the PlannedItem list mangle_operator expects from two
        ; PlannedType arguments. Holder Vectors keep both types alive
        ; on rp so their refs are stable for the Item construction.
        function mangle_binary_operator#(
            rp,
            this: Planner,
            op_name: String,
            left: PlannedType,
            right: PlannedType
        ) returns String
        {
            var left_holder Vector[PlannedType]^rp(1)
            left_holder.put(0, left)
            var right_holder Vector[PlannedType]^rp(1)
            right_holder.put(0, right)

            var items Vector[PlannedItem]^rp(2)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, left_holder.get 0, null
            ))
            items.put(1, PlannedItem(
                Span(0, 0), false, null, right_holder.get 0, null
            ))

            Planner.mangle_operator#(op_name, &items, null)
        }

        ; mangle_unary_operator: same idea for prefix/unary operators.
        function mangle_unary_operator#(
            rp,
            this: Planner,
            op_name: String,
            operand: PlannedType
        ) returns String
        {
            var holder Vector[PlannedType]^rp(1)
            holder.put(0, operand)

            var items Vector[PlannedItem]^rp(1)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, holder.get 0, null
            ))

            Planner.mangle_operator#(op_name, &items, null)
        }

        ; make_planned_call: assemble a PlannedCall for a resolved call
        ; site. Callers provide the mangled symbol, result type, and
        ; planned argument list; flags default to the common
        ; "non-intrinsic, non-operator, non-throwing, no-page" case.
        function make_planned_call#(
            rp,
            this: Planner,
            loc: Span,
            name: String,
            mangled_name: String,
            result_type: PlannedType,
            args: Vector[PlannedOperand]
        ) returns PlannedCall
        {
            var args_holder Vector[PlannedOperand]^rp(args)
            PlannedCall(
                loc,
                name,
                mangled_name,
                false,
                false,
                false,
                false,
                &args_holder,
                result_type,
                Lifetime.Unspecified(Unspecified()),
                null,
                false
            )
        }

        ; If `op` is a Phase-1 lambda binding name used as a callable head (a
        ; bare PlannedType with no generics, or an unresolved Variable, with no
        ; member-access chain), return that lambda name; otherwise the empty
        ; string. The lambda binding emits no runtime value, so the name arrives
        ; here unresolved — this is how a lambda call is recognized.
        function lambda_head_name#(rp, this: Planner, op: PlannedOperand) returns String
        {
            if op.member_access <> null
                return String^rp("")
            var nm String^rp("")
            choose op.expr
                when lht: PlannedType
                {
                    if lht.generics = null
                        set nm: lht.name
                }
                when lhv: Variable
                    set nm: lhv.name
                else
                    0
            if nm.get_length() = 0
                return String^rp("")
            if this.lookup_lambda_model(nm) <> null
                return nm
            String^rp("")
        }

        ; Resolve a Phase-1 lambda call `name(args)` into a direct call to the
        ; monomorphized function. `head_loc` is the call-site span, `lc_name`
        ; the lambda binding name, `lc_lam` its recorded model, `lc_tp` the
        ; argument Tuple. monomorphize_lambda# plans the body with the call's
        ; argument types and synthesizes a concrete top-level function; the
        ; captures it discovers are looked up at the call site (where they are
        ; in scope) and prepended as leading arguments (capture by value).
        function resolve_lambda_call#(rp, this: Planner, head_loc: Span, lc_name: String, lc_lam: Lambda, lc_tp: PlannedTuple) returns PlannedOperand
        {
            var lc_arg_ops Array[PlannedOperand]$()
            var lc_arg_types Array[PlannedType]$()
            if lc_tp.components <> null
            {
                let lc_comps (*lc_tp.components)
                var lc_ci: size_t 0
                while lc_ci < lc_comps.length
                {
                    let lc_cp lc_comps.get lc_ci
                    if lc_cp <> null
                    {
                        if (*lc_cp).value <> null
                        {
                            let lc_vals (*(*lc_cp).value)
                            if lc_vals.length > 0
                            {
                                let lc_collapsed this.collapse_operand_sequence#(lc_vals)
                                lc_arg_ops.add lc_collapsed
                                lc_arg_types.add lc_collapsed.result_type
                            }
                        }
                    }
                    set lc_ci: lc_ci + 1
                }
            }
            var lc_at_vec Vector[PlannedType]^rp(lc_arg_types)
            let lc_mono this.monomorphize_lambda#(lc_name, lc_lam, lc_at_vec)
            let lc_mangled lc_mono.mangled
            ; Prepend the captured values (looked up at the call site, where they
            ; are in scope) as leading arguments — they map to the synthesized
            ; function's leading capture parameters.
            var lc_full_args Array[PlannedOperand]$()
            if lc_mono.captures <> null
            {
                let lc_caps (*lc_mono.captures)
                var lc_capi: size_t 0
                while lc_capi < lc_caps.length
                {
                    let lc_cap_ptr lc_caps.get lc_capi
                    if lc_cap_ptr <> null
                    {
                        let lc_capn (*lc_cap_ptr)
                        let lc_cap_lb this.lookup_local_binding(lc_capn)
                        if lc_cap_lb <> null
                        {
                            let lc_cap_ty (*lc_cap_lb).binding_type
                            let lc_cap_mut (*lc_cap_lb).is_mutable
                            let lc_cap_var PlannedVariable(head_loc, String^rp(lc_capn), lc_cap_ty, lc_cap_mut)
                            lc_full_args.add(PlannedOperand(head_loc, PlannedExpression.Variable lc_cap_var, null, lc_cap_ty))
                        }
                    }
                    set lc_capi: lc_capi + 1
                }
            }
            var lc_afi: size_t 0
            while lc_afi < lc_arg_ops.length
            {
                let lc_ao_ptr lc_arg_ops.get lc_afi
                if lc_ao_ptr <> null
                    lc_full_args.add((*lc_ao_ptr))
                set lc_afi: lc_afi + 1
            }
            var lc_ret Planner.make_void_type#()
            let lc_fidx function_name_index.lookup(lc_mangled)
            if lc_fidx >= 0
            {
                let lc_fptr instantiated_functions.get lc_fidx
                if lc_fptr <> null
                {
                    if (*lc_fptr).return_type <> null
                        set lc_ret: (*(*lc_fptr).return_type)
                }
            }
            var lc_call_args Vector[PlannedOperand]^rp(lc_full_args)
            let lc_pc this.make_planned_call#(head_loc, lc_name, lc_mangled, lc_ret, lc_call_args)
            PlannedOperand(head_loc, PlannedExpression.Call lc_pc, null, lc_ret)
        }

        ; collapse_operand_sequence: fold a flat operand list of the
        ; shape [lhs, op, rhs, op, rhs, ...] into a single PlannedOperand
        ; representing the combined expression. LEFT-ASSOCIATIVE — this
        ; drops operator precedence; a full precedence-climbing version
        ; is a later refactor. Empty and single-element inputs pass
        ; through unchanged.
        function collapse_operand_sequence#(
            rp,
            this: Planner,
            ops: Vector[PlannedOperand]
        ) returns PlannedOperand
        {
            if ops.length = 0
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }
            if ops.length = 1
            {
                let only_ptr ops.get 0
                if only_ptr = null
                {
                    let void_ty Planner.make_void_type#()
                    return PlannedOperand(
                        Span(0, 0),
                        PlannedExpression.Type void_ty,
                        null,
                        void_ty
                    )
                }
                ; Parenless zero-arg method call: a lone operand whose
                ; member_access chain ends in an is_method hop (e.g.
                ; `name.length`, `sb.get_length`). The ops>=2 method-on-
                ; chain dispatch only fires when an args Tuple follows, so
                ; a parenless trailing method would otherwise be returned
                ; as-is and emit_member_access_chain treats it as a field
                ; access — silently dropping the binding (encode_name's
                ; `let len name.length` cascade). Synthesize an empty `()`
                ; Tuple as a second operand and recurse, reusing the same
                ; machinery that already handles `name.length()`. Mirrors
                ; stage-0's IsZeroArgMethodCall auto-call (Planner.cpp:5117).
                let only_op (*only_ptr)
                if only_op.member_access <> null
                {
                    let ma (*only_op.member_access)
                    if ma.length > 0
                    {
                        let last_ptr ma.get(ma.length - 1)
                        if last_ptr <> null
                        {
                            let last_hop (*last_ptr)
                            if last_hop.is_method
                            {
                                let void_ty Planner.make_void_type#()
                                let empty_tuple PlannedTuple(
                                    only_op.loc,
                                    null,
                                    void_ty,
                                    false,
                                    Lifetime.Unspecified(Unspecified()),
                                    null
                                )
                                let tuple_op PlannedOperand(
                                    only_op.loc,
                                    PlannedExpression.Tuple empty_tuple,
                                    null,
                                    void_ty
                                )
                                var two_arr Array[PlannedOperand]$()
                                two_arr.add only_op
                                two_arr.add tuple_op
                                var two_vec Vector[PlannedOperand]^rp(two_arr)
                                return this.collapse_operand_sequence#(two_vec)
                            }
                        }
                    }
                }
                return (*only_ptr)
            }

            ; Indirect call through a function pointer (Phase-1 JIT): `f()`
            ; where f is a local binding of type pointer[void] and `()` is
            ; empty. The self-hosted JIT (cli --run) invokes an ORC-resolved
            ; address this way. No existing construct calls a pointer[void]
            ; local (it would be a hard "function not found"), so this can't
            ; shadow real code. Returns i64. Mirrors stage-0's planOperands
            ; indirect-call intercept (Planner.cpp).
            if ops.length = 2
            {
                let ic_head_ptr ops.get 0
                let ic_tail_ptr ops.get 1
                if ic_head_ptr <> null
                {
                    if ic_tail_ptr <> null
                    {
                        let ic_head (*ic_head_ptr)
                        let ic_tail (*ic_tail_ptr)
                        var ic_is_empty_tuple: bool false
                        choose ic_tail.expr
                            when t: PlannedTuple
                            {
                                if t.components = null
                                    set ic_is_empty_tuple: true
                                if t.components <> null
                                {
                                    if (*t.components).length = 0
                                        set ic_is_empty_tuple: true
                                }
                            }
                            else
                                0
                        var ic_is_void_ptr: bool false
                        choose ic_head.expr
                            when v: Variable
                            {
                                let vt v.variable_type
                                if vt.name.equals(String$("pointer"))
                                {
                                    if vt.generics <> null
                                    {
                                        if (*vt.generics).length = 1
                                        {
                                            let g0_ptr (*vt.generics).get(0)
                                            if g0_ptr <> null
                                            {
                                                if (*g0_ptr).name.equals(String$("void"))
                                                    set ic_is_void_ptr: true
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                        if ic_is_empty_tuple
                        {
                            if ic_is_void_ptr
                            {
                                let i64_ty Planner.make_i64_type#()
                                var ic_args Vector[PlannedOperand]^rp(1)
                                ic_args.put(0, ic_head)
                                var ic_args_holder Vector[PlannedOperand]^rp(ic_args)
                                let ic_call PlannedCall(
                                    ic_head.loc,
                                    String^rp("__jit_indirect"),
                                    String^rp(""),
                                    false,
                                    false,
                                    false,
                                    false,
                                    &ic_args_holder,
                                    i64_ty,
                                    Lifetime.Unspecified(Unspecified()),
                                    null,
                                    true
                                )
                                return PlannedOperand(
                                    ic_head.loc,
                                    PlannedExpression.Call ic_call,
                                    null,
                                    i64_ty
                                )
                            }
                        }

                        ; GAP B: indirect call through a delegate-typed value
                        ; `f(args)` where f is a Variable of a delegate type.
                        ; Build an is_indirect PlannedCall whose args are
                        ; [callee, arg0, arg1, ...]; the emitter reconstructs
                        ; the LLVM function type from the planned arg types +
                        ; the delegate's return type.
                        var ic_del_name String^rp("")
                        choose ic_head.expr
                            when v: Variable
                                if this.is_delegate_type(v.variable_type.name)
                                    set ic_del_name: v.variable_type.name
                            else
                                0
                        if ic_del_name.get_length() > 0
                        {
                            var dcall_is_tuple: bool false
                            choose ic_tail.expr
                                when dtp: PlannedTuple
                                    set dcall_is_tuple: true
                                else
                                    0
                            if dcall_is_tuple
                            {
                                var dc_args Array[PlannedOperand]$()
                                dc_args.add ic_head
                                choose ic_tail.expr
                                    when dtp: PlannedTuple
                                    {
                                        if dtp.components <> null
                                        {
                                            let dcomps (*dtp.components)
                                            var dci: size_t 0
                                            while dci < dcomps.length
                                            {
                                                let dcp dcomps.get dci
                                                if dcp <> null
                                                    if (*dcp).value <> null
                                                    {
                                                        let dvals (*(*dcp).value)
                                                        if dvals.length > 0
                                                        {
                                                            let dca this.collapse_operand_sequence#(dvals)
                                                            dc_args.add dca
                                                        }
                                                    }
                                                set dci: dci + 1
                                            }
                                        }
                                    }
                                    else
                                        0
                                let dc_ret this.delegate_return_type#(ic_del_name)
                                var dc_args_holder Vector[PlannedOperand]^rp(dc_args)
                                let dc_call PlannedCall(
                                    ic_head.loc,
                                    String^rp("indirect"),
                                    String^rp(""),
                                    false,
                                    false,
                                    false,
                                    false,
                                    &dc_args_holder,
                                    dc_ret,
                                    Lifetime.Unspecified(Unspecified()),
                                    null,
                                    true
                                )
                                return PlannedOperand(
                                    ic_head.loc,
                                    PlannedExpression.Call dc_call,
                                    null,
                                    dc_ret
                                )
                            }
                        }
                    }
                }
            }

            ; Phase-1 lambda call: resolve any adjacent `[lambdaName, Tuple]`
            ; pair anywhere in the flat operand list into a single direct call
            ; to the monomorphized lambda function — BEFORE the precedence /
            ; binary loop runs — so lambda calls embedded in larger expressions
            ; work (`a + inc(5)`, `inc(5) + add(3, 4)`), not only when the call
            ; is the whole operand sequence. lambdaName is recognized by
            ; lambda_head_name# (a bare PlannedType/Variable in lambda_models).
            ; The pair is replaced by the resolved call operand and the shorter
            ; list re-collapsed; the strictly-decreasing length terminates.
            if ops.length >= 2
            {
                var lp_i: size_t 0
                var lp_found: bool false
                var lp_at: size_t 0
                while lp_i + 1 < ops.length
                {
                    if lp_found = false
                    {
                        let lp_h_ptr ops.get lp_i
                        let lp_t_ptr ops.get(lp_i + 1)
                        if lp_h_ptr <> null
                        {
                            if lp_t_ptr <> null
                            {
                                let lp_name this.lambda_head_name#((*lp_h_ptr))
                                if lp_name.get_length() > 0
                                {
                                    var lp_is_tuple: bool false
                                    choose (*lp_t_ptr).expr
                                        when lp_tp_chk: PlannedTuple
                                            set lp_is_tuple: true
                                        else
                                            0
                                    if lp_is_tuple
                                    {
                                        set lp_found: true
                                        set lp_at: lp_i
                                    }
                                }
                            }
                        }
                    }
                    set lp_i: lp_i + 1
                }
                if lp_found
                {
                    let lp_h_ptr ops.get lp_at
                    let lp_t_ptr ops.get(lp_at + 1)
                    let lp_head (*lp_h_ptr)
                    let lp_name this.lambda_head_name#(lp_head)
                    let lp_lam_ref this.lookup_lambda_model(lp_name)
                    if lp_lam_ref <> null
                    {
                        choose (*lp_t_ptr).expr
                            when lp_tp: PlannedTuple
                            {
                                let lp_call this.resolve_lambda_call#(lp_head.loc, lp_name, (*lp_lam_ref), lp_tp)
                                ; Rebuild the operand list with the [name, Tuple]
                                ; pair replaced by the single resolved call
                                ; operand, then recurse on the strictly-shorter
                                ; list.
                                var lp_new Array[PlannedOperand]$()
                                var lp_k: size_t 0
                                while lp_k < ops.length
                                {
                                    if lp_k = lp_at
                                        lp_new.add lp_call
                                    else
                                    {
                                        if lp_k <> lp_at + 1
                                        {
                                            let lp_op_ptr ops.get lp_k
                                            if lp_op_ptr <> null
                                                lp_new.add (*lp_op_ptr)
                                        }
                                    }
                                    set lp_k: lp_k + 1
                                }
                                var lp_new_vec Vector[PlannedOperand]^rp(lp_new)
                                return this.collapse_operand_sequence#(lp_new_vec)
                            }
                            else
                                0
                    }
                }
            }

            ; s107: pre-pass — combine `Type + Matrix` into a generic
            ; Type with concrete generic args. The Modeler emits
            ; `Box[int](42)` as three operands [Type(Box), Matrix([int]),
            ; Tuple((42))] because NameSyntax has no generics field
            ; (parser puts the bracket part as a separate VectorSyntax
            ; → Matrix in the operand list). Without this merger,
            ; the struct-ctor branch below sees `Box` (no generics) and
            ; can't instantiate Box[int]. Mirrors stage-0
            ; Planner.cpp:7170-7247.
            ;
            ; Restricted to the common simple shape: Type with no
            ; existing generics + Matrix where each row is a single
            ; Type operand. Nested generics like Box[Box[int]] need
            ; the recursive extractor stage-0 has — leave that for a
            ; later port.
            var has_gen_combo: bool false
            var gci: size_t 0
            while gci + 1 < ops.length
            {
                let cur_ptr ops.get gci
                let nxt_ptr ops.get(gci + 1)
                if cur_ptr <> null
                {
                    if nxt_ptr <> null
                    {
                        let cur_op (*cur_ptr)
                        let nxt_op (*nxt_ptr)
                        var cur_is_bare_type: bool false
                        choose cur_op.expr
                            when ct: PlannedType
                            {
                                if ct.name.get_length() > 0
                                    if ct.generics = null
                                        set cur_is_bare_type: true
                            }
                            else
                                0
                        if cur_is_bare_type
                        {
                            choose nxt_op.expr
                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                    set has_gen_combo: true
                                else
                                    0
                        }
                    }
                }
                set gci: gci + 1
            }

            if has_gen_combo
            {
                var merged_arr2 Array[PlannedOperand]$()
                var ci2: size_t 0
                while ci2 < ops.length
                {
                    let cp_ptr ops.get ci2
                    if cp_ptr = null
                    {
                        set ci2: ci2 + 1
                        continue
                    }
                    let cp_op (*cp_ptr)

                    ; Try to merge with the next operand if it's a Matrix.
                    var did_merge2: bool false
                    if ci2 + 1 < ops.length
                    {
                        let np_ptr ops.get(ci2 + 1)
                        if np_ptr <> null
                        {
                            let np_op (*np_ptr)
                            choose cp_op.expr
                                when ct2: PlannedType
                                {
                                    if ct2.name.get_length() > 0
                                    {
                                        if ct2.generics = null
                                        {
                                            choose np_op.expr
                                                when nm2: scalyc.compiler.Plan.PlannedMatrix
                                                {
                                                    ; Extract one Type from each row using the
                                                    ; recursive helper so nested generics like
                                                    ; Box[Box[int]] (row.length==2: [Type, Matrix])
                                                    ; resolve correctly. Mirrors stage-0
                                                    ; Planner.cpp:7180-7214 (extractTypeFromRow).
                                                    var ok_extract: bool true
                                                    var gens_arr Array[Type]$()
                                                    if nm2.operations <> null
                                                    {
                                                        let rows (*nm2.operations)
                                                        var ri: size_t 0
                                                        while ri < rows.length
                                                        {
                                                            let row_ptr rows.get ri
                                                            if row_ptr <> null
                                                            {
                                                                let row (*row_ptr)
                                                                let extracted Planner.extract_row_to_type#(row)
                                                                if extracted = null
                                                                    set ok_extract: false
                                                                if extracted <> null
                                                                    gens_arr.add((*extracted))
                                                            }
                                                            set ri: ri + 1
                                                        }
                                                    }
                                                    if ok_extract
                                                    {
                                                        if gens_arr.length > 0
                                                        {
                                                            var name_path Vector[String]^rp(1)
                                                            name_path.put(0, ct2.name)
                                                            var model_gens Vector[Type]^rp(gens_arr)
                                                            ; Use the Matrix's lifetime when set —
                                                            ; `Vector[T]^rp` parses [T]^rp as a Matrix
                                                            ; carrying the lifetime, not the bare Type
                                                            ; that precedes it. Mirrors stage-0
                                                            ; Planner.cpp:7235-7237.
                                                            var final_life: Lifetime ct2.life
                                                            choose nm2.life
                                                                when u: Unspecified
                                                                    0
                                                                else
                                                                    set final_life: nm2.life
                                                            let merged_type this.plan_type#(Type(
                                                                ct2.loc,
                                                                name_path,
                                                                &model_gens,
                                                                final_life
                                                            ))
                                                            ; s184: the Matrix operand's member
                                                            ; chain was resolved against the
                                                            ; matrix ELEMENT type (garbage for
                                                            ; `Option[int].None`) — re-resolve
                                                            ; it against the merged generic
                                                            ; type. A lone variant hop with no
                                                            ; argument tuple following becomes
                                                            ; a unit VariantConstruction
                                                            ; (stage-0 Planner.cpp:9342); with
                                                            ; a tuple it stays a Type operand
                                                            ; carrying the resolved variant hop
                                                            ; for the construction gate.
                                                            var merged_op PlannedOperand(
                                                                cp_op.loc,
                                                                PlannedExpression.Type merged_type,
                                                                np_op.member_access,
                                                                merged_type
                                                            )
                                                            if np_op.member_access <> null
                                                            {
                                                                let raw_ma (*np_op.member_access)
                                                                if raw_ma.length > 0
                                                                {
                                                                    var ma_names Vector[String]^rp(raw_ma.length)
                                                                    var mni: size_t 0
                                                                    while mni < raw_ma.length
                                                                    {
                                                                        let mn_ptr raw_ma.get mni
                                                                        if mn_ptr <> null
                                                                            ma_names.put(mni, (*mn_ptr).name)
                                                                        set mni: mni + 1
                                                                    }
                                                                    let re_chain this.resolve_member_access#(merged_type, ma_names)
                                                                    if re_chain.length = 1
                                                                    {
                                                                        let rc0_ptr re_chain.get 0
                                                                        if rc0_ptr <> null
                                                                        {
                                                                            let rc0 (*rc0_ptr)
                                                                            if rc0.is_union_value
                                                                            {
                                                                                var next_is_tuple: bool false
                                                                                if ci2 + 2 < ops.length
                                                                                {
                                                                                    let t2_ptr ops.get(ci2 + 2)
                                                                                    if t2_ptr <> null
                                                                                    {
                                                                                        choose (*t2_ptr).expr
                                                                                            when mt2: PlannedTuple
                                                                                                set next_is_tuple: true
                                                                                            else
                                                                                                0
                                                                                    }
                                                                                }
                                                                                if next_is_tuple = false
                                                                                {
                                                                                    let unit_vc2 PlannedVariantConstruction(
                                                                                        cp_op.loc,
                                                                                        merged_type,
                                                                                        rc0.name,
                                                                                        rc0.field_index,
                                                                                        null
                                                                                    )
                                                                                    set merged_op: PlannedOperand(
                                                                                        cp_op.loc,
                                                                                        PlannedExpression.VariantConstruction unit_vc2,
                                                                                        null,
                                                                                        merged_type
                                                                                    )
                                                                                }
                                                                                if next_is_tuple
                                                                                {
                                                                                    var rh_holder Vector[PlannedMemberAccess]^rp(re_chain)
                                                                                    set merged_op: PlannedOperand(
                                                                                        cp_op.loc,
                                                                                        PlannedExpression.Type merged_type,
                                                                                        &rh_holder,
                                                                                        merged_type
                                                                                    )
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            merged_arr2.add merged_op
                                                            set did_merge2: true
                                                        }
                                                    }
                                                    ; s192: stack-array pattern
                                                    ; `primitive[N]`. The generic
                                                    ; extraction above fails (the
                                                    ; row is an integer Constant,
                                                    ; not a Type), so build a
                                                    ; size-as-generic model Type and
                                                    ; let plan_type# rewrite it to
                                                    ; pointer[T] with array_size set.
                                                    ; Mirrors stage-0
                                                    ; Planner.cpp:7249-7289.
                                                    if did_merge2 = false
                                                    {
                                                        if Planner.is_primitive_type_name(ct2.name)
                                                        {
                                                            let sz Planner.matrix_single_int_size#(nm2)
                                                            if sz.get_length() > 0
                                                            {
                                                                var sz_path Vector[String]^rp(1)
                                                                sz_path.put(0, sz)
                                                                var sz_gens Vector[Type]^rp(1)
                                                                sz_gens.put(0, Type(
                                                                    ct2.loc,
                                                                    sz_path,
                                                                    null,
                                                                    Lifetime.Unspecified(Unspecified())
                                                                ))
                                                                var arr_name_path Vector[String]^rp(1)
                                                                arr_name_path.put(0, ct2.name)
                                                                let arr_type this.plan_type#(Type(
                                                                    ct2.loc,
                                                                    arr_name_path,
                                                                    &sz_gens,
                                                                    ct2.life
                                                                ))
                                                                merged_arr2.add(PlannedOperand(
                                                                    cp_op.loc,
                                                                    PlannedExpression.Type arr_type,
                                                                    null,
                                                                    arr_type
                                                                ))
                                                                set did_merge2: true
                                                            }
                                                        }
                                                    }
                                                    0
                                                }
                                                else
                                                    0
                                        }
                                    }
                                    0
                                }
                                else
                                    0
                        }
                    }

                    if did_merge2
                    {
                        set ci2: ci2 + 2
                        continue
                    }

                    merged_arr2.add cp_op
                    set ci2: ci2 + 1
                }
                var merged_vec2 Vector[PlannedOperand]^rp(merged_arr2)
                ; s138: progress guard. If the rebuild produced the
                ; same length (no actual merges — e.g.,
                ; extract_row_to_type# returned null for every row),
                ; recursing would loop forever. Fall through to the
                ; rest of the function instead.
                if merged_vec2.length < ops.length
                    return this.collapse_operand_sequence#(merged_vec2)
            }

            ; Pre-pass: merge lifetime-marker operands into the
            ; preceding Type operand. Runs AFTER the s107 generic
            ; merger so that `Vector[String]^rp(1)` (parsed as
            ; [Type(Vector), Matrix([String]), Marker(^rp), Tuple])
            ; first becomes [Type(Vector,[String]), Marker, Tuple]
            ; and then [Type(Vector,[String], life=Reference("rp")),
            ; Tuple]. With the original ordering (lifetime first),
            ; the marker would be dropped because the previous op is
            ; a Matrix, not a Type — silently losing the lifetime.
            ; Mirrors stage-0 Planner.cpp:7378-7387.
            var has_life_marker: bool false
            var lim_idx: size_t 0
            while lim_idx < ops.length
            {
                let lim_ptr ops.get lim_idx
                if lim_ptr <> null
                {
                    let lim_op (*lim_ptr)
                    choose lim_op.expr
                        when ty: PlannedType
                        {
                            if ty.name.get_length() = 0
                            {
                                ; A PlannedType with empty name is
                                ; the lifetime marker.
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                        set has_life_marker: true
                            }
                            0
                        }
                        else
                            0
                }
                set lim_idx: lim_idx + 1
            }

            if has_life_marker
            {
                ; Build a fresh ops Vector that drops the markers and
                ; merges each one's lifetime into the preceding
                ; PlannedType operand (if any). Look ahead from each
                ; current op: if it is a Type AND the next op is a
                ; lifetime marker, append the merged Type and skip
                ; both. Otherwise append unmodified.
                var merged_arr Array[PlannedOperand]$()
                var mi: size_t 0
                while mi < ops.length
                {
                    let mp_ptr ops.get mi
                    if mp_ptr = null
                    {
                        set mi: mi + 1
                        continue
                    }
                    let mp_op (*mp_ptr)

                    ; If THIS op is a marker (no prior Type to merge
                    ; into), drop it.
                    var is_marker: bool false
                    var this_marker_life: Lifetime Lifetime.Unspecified(Unspecified())
                    choose mp_op.expr
                        when ty: PlannedType
                        {
                            if ty.name.get_length() = 0
                            {
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                    {
                                        set is_marker: true
                                        set this_marker_life: ty.life
                                    }
                            }
                            0
                        }
                        else
                            0
                    if is_marker
                    {
                        ; s196: a STANDALONE marker — the preceding op was
                        ; not a PlannedType to merge into (e.g. a method
                        ; receiver planned as Variable+chain, as in
                        ; `slot_list.add^own_page(Slot(...))`). If the NEXT
                        ; op is the method's args PlannedTuple, merge the
                        ; `^name` lifetime into that tuple's `life` so the
                        ; method-dispatch call-construction site can
                        ; propagate it onto PlannedCall.life. Without this
                        ; the marker is dropped and the call's allocations
                        ; land on the function-local page (released on exit)
                        ; instead of the named region — corrupting escaping
                        ; HashSet nodes once the local page is released.
                        ; Otherwise (no following tuple) drop the marker as
                        ; before.
                        if mi + 1 < ops.length
                        {
                            let mtp_ptr ops.get(mi + 1)
                            if mtp_ptr <> null
                            {
                                let mtp_op (*mtp_ptr)
                                var merged_tuple_done: bool false
                                choose mtp_op.expr
                                    when tp: PlannedTuple
                                    {
                                        let new_tp PlannedTuple(
                                            tp.loc,
                                            tp.components,
                                            tp.tuple_type,
                                            tp.is_region_alloc,
                                            this_marker_life,
                                            tp.region_arg
                                        )
                                        merged_arr.add(PlannedOperand(
                                            mtp_op.loc,
                                            PlannedExpression.Tuple new_tp,
                                            mtp_op.member_access,
                                            mtp_op.result_type
                                        ))
                                        set merged_tuple_done: true
                                        0
                                    }
                                    else
                                        0
                                if merged_tuple_done
                                {
                                    set mi: mi + 2
                                    continue
                                }
                            }
                        }
                        set mi: mi + 1
                        continue
                    }

                    ; Look ahead: if the next op is a marker AND
                    ; current op is a Type, merge the lifetime in
                    ; before appending and advance past both.
                    var did_merge: bool false
                    if mi + 1 < ops.length
                    {
                        let next_ptr ops.get(mi + 1)
                        if next_ptr <> null
                        {
                            let next_op (*next_ptr)
                            var next_is_marker: bool false
                            var marker_life: Lifetime Lifetime.Unspecified(Unspecified())
                            choose next_op.expr
                                when ty2: PlannedType
                                {
                                    if ty2.name.get_length() = 0
                                    {
                                        choose ty2.life
                                            when u: Unspecified
                                                0
                                            else
                                            {
                                                set next_is_marker: true
                                                set marker_life: ty2.life
                                            }
                                    }
                                    0
                                }
                                else
                                    0

                            if next_is_marker
                            {
                                choose mp_op.expr
                                    when prev_ty: PlannedType
                                    {
                                        let new_ty PlannedType(
                                            prev_ty.loc,
                                            prev_ty.name,
                                            prev_ty.mangled_name,
                                            prev_ty.generics,
                                            marker_life,
                                            prev_ty.origin,
                                            prev_ty.array_size,
                                            prev_ty.variable
                                        )
                                        let new_op PlannedOperand(
                                            mp_op.loc,
                                            PlannedExpression.Type new_ty,
                                            mp_op.member_access,
                                            new_ty
                                        )
                                        merged_arr.add new_op
                                        set did_merge: true
                                        0
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    if did_merge
                    {
                        ; Advance past current Type AND the marker.
                        set mi: mi + 2
                        continue
                    }

                    merged_arr.add mp_op
                    set mi: mi + 1
                }
                var merged_vec Vector[PlannedOperand]^rp(merged_arr)
                ; s138: progress guard. Same as the s107 merge above:
                ; if no marker was actually merged or dropped, avoid
                ; infinite recursion.
                if merged_vec.length < ops.length
                    return this.collapse_operand_sequence#(merged_vec)
            }

            let first_ptr ops.get 0
            if first_ptr = null
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }
            var result: PlannedOperand (*first_ptr)

            ; Prefix operator: first operand is a Type whose name is an
            ; operator (`-x`, `!flag`, `*ptr`, etc.). Recurse on the
            ; rest, resolve against the rest's result type, and wrap in
            ; a single PlannedCall. The whole sequence is consumed.
            choose result.expr
                when ty: PlannedType
                {
                    ; An opchar-named declared FUNCTION (not a declared
                    ; operator) — e.g. `function ++(n)` — is a function call,
                    ; not a prefix operator. Skip the prefix-operator path so
                    ; it falls through to call resolution; stage-0 mangles such
                    ; a name as a function (`_Z2++i`). The source declares no
                    ; opchar-named functions, so this is fixpoint-safe.
                    var ty_is_prefix_op: bool false
                    if Planner.is_operator_name(ty.name)
                        set ty_is_prefix_op: true
                    if ty_is_prefix_op
                        if this.is_function(ty.name)
                            if this.is_operator(ty.name) = false
                                set ty_is_prefix_op: false
                    if ty_is_prefix_op
                    {
                        let prefix_name ty.name

                        ; s174: a prefix operator consumes exactly ONE
                        ; operand — the immediately following one — unless
                        ; that operand is itself a prefix operator (chained
                        ; `*-x`: collapse the whole tail as the operand).
                        ; The old code collapsed ops[1..end] wholesale, so
                        ; `*p <> 42` planned as `*(p <> 42)` (deref of a
                        ; bool) — emit_operands returned null and the whole
                        ; surrounding if/if silently dropped (lexer
                        ; comment dispatch, prelude load). After the prefix
                        ; call is built, the remaining operands continue
                        ; through a recursive collapse. Mirrors stage-0
                        ; Planner.cpp:4098-4283.
                        var consumed: size_t 2
                        var chained: bool false
                        if ops.length > 1
                        {
                            let chk_ptr ops.get 1
                            if chk_ptr <> null
                            {
                                choose (*chk_ptr).expr
                                    when cty: PlannedType
                                    {
                                        if Planner.is_operator_name(cty.name)
                                            set chained: true
                                    }
                                    else
                                        0
                            }
                        }
                        if chained
                            set consumed: ops.length

                        ; s174: a call operand keeps its argument Tuple —
                        ; consume [callee, Tuple] together so
                        ; `~lexer.parse_punctuation#(CHAR_DOT())` keeps its
                        ; argument. Stage-0 pre-groups calls in planOperands
                        ; (Planner.cpp:7361+) so its consume-one never
                        ; splits them; stage-1 groups during collapse, so
                        ; the prefix branch must widen its bite here.
                        ; Callable = non-operator Type (free function) or a
                        ; member-access chain ending in an is_method hop.
                        if chained = false
                        {
                            if ops.length > 2
                            {
                                let cal_ptr ops.get 1
                                let arg_ptr ops.get 2
                                if cal_ptr <> null
                                {
                                    if arg_ptr <> null
                                    {
                                        var arg_is_tuple: bool false
                                        choose (*arg_ptr).expr
                                            when t_arg: PlannedTuple
                                                set arg_is_tuple: true
                                            else
                                                0
                                        if arg_is_tuple
                                        {
                                            var cal_callable: bool false
                                            choose (*cal_ptr).expr
                                                when cal_ty: PlannedType
                                                {
                                                    if Planner.is_operator_name(cal_ty.name) = false
                                                        set cal_callable: true
                                                }
                                                else
                                                    0
                                            if cal_callable = false
                                            {
                                                if (*cal_ptr).member_access <> null
                                                {
                                                    let cal_ma (*(*cal_ptr).member_access)
                                                    if cal_ma.length > 0
                                                    {
                                                        let cal_last cal_ma.get(cal_ma.length - 1)
                                                        if cal_last <> null
                                                        {
                                                            if (*cal_last).is_method
                                                                set cal_callable: true
                                                        }
                                                    }
                                                }
                                            }
                                            if cal_callable
                                                set consumed: 3
                                        }
                                    }
                                }
                            }
                        }

                        var rest_arr Array[PlannedOperand]$()
                        var r: size_t 1
                        while r < consumed
                        {
                            let p_ptr ops.get r
                            if p_ptr <> null
                            {
                                let p_op (*p_ptr)
                                ; If a prefix operator is followed by a
                                ; single-component anonymous Tuple (a
                                ; grouping `(...)`), expand the Tuple's
                                ; interior operands so the inner sequence
                                ; collapses (e.g. `*(data + index)` →
                                ; `*` applied to the collapsed
                                ; `data + index` PlannedCall). Without
                                ; this, emit_tuple's grouping shortcut
                                ; emits only `data` and the GEP for
                                ; pointer-arith deref vanishes. Mirrors
                                ; stage-0 Planner.cpp:4178-4181 where the
                                ; Tuple is consumed as-is because its
                                ; interior was already collapsed during
                                ; planTuple (Planner.cpp:10507).
                                var expanded: bool false
                                if r = 1
                                {
                                    if chained = false
                                    {
                                        ; s177: keep a grouped operand intact
                                        ; when it carries a member-access
                                        ; chain. Expanding the interior drops
                                        ; the chain — `(*(*p).items)` lost
                                        ; its .items hop and the outer deref
                                        ; re-deref'd the base struct (length
                                        ; read field 0 of the wrong struct).
                                        ; The operand is already fully planned
                                        ; with the chain's final result_type.
                                        var p_has_chain: bool false
                                        if p_op.member_access <> null
                                        {
                                            let pma (*p_op.member_access)
                                            if pma.length > 0
                                                set p_has_chain: true
                                        }
                                        if p_has_chain = false
                                        {
                                        choose p_op.expr
                                            when tup: PlannedTuple
                                            {
                                                if tup.components <> null
                                                {
                                                    let comps (*tup.components)
                                                    if comps.length = 1
                                                    {
                                                        let c0_ptr comps.get 0
                                                        if c0_ptr <> null
                                                        {
                                                            let c0 (*c0_ptr)
                                                            if c0.name = null
                                                            {
                                                                if c0.value <> null
                                                                {
                                                                    let inner (*c0.value)
                                                                    if inner.length > 0
                                                                    {
                                                                        var ii: size_t 0
                                                                        while ii < inner.length
                                                                        {
                                                                            let ip_ptr inner.get ii
                                                                            if ip_ptr <> null
                                                                                rest_arr.add((*ip_ptr))
                                                                            set ii: ii + 1
                                                                        }
                                                                        set expanded: true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                                0
                                        }
                                    }
                                }
                                if expanded = false
                                    rest_arr.add p_op
                            }
                            set r: r + 1
                        }
                        var rest_vec Vector[PlannedOperand]^rp(rest_arr)
                        let rest_result this.collapse_operand_sequence#(rest_vec)

                        let rt_ref this.resolve_prefix_operator_call#(
                            prefix_name, rest_result.result_type
                        )
                        ; For built-in primitive prefix ops the operator
                        ; isn't in the registry — derive the result type
                        ; from the operator. Mirrors Planner.cpp:4138-4157.
                        var rt: PlannedType rest_result.result_type
                        if rt_ref <> null
                            set rt: (*rt_ref)
                        if rt_ref = null
                        {
                            if prefix_name.equals(String$("!"))
                                set rt: Planner.make_bool_type#()
                            if prefix_name.equals(String$("not"))
                                set rt: Planner.make_bool_type#()
                            if prefix_name.equals(String$("*"))
                            {
                                ; Dereference: result is the pointer's
                                ; element type. Use get_pointer_element_type
                                ; so Option[ref[T]] / Option[pointer[T]]
                                ; unwrap to T (NOT ref[T] / pointer[T]).
                                ; Without this, choose-on-dereffed-union
                                ; sees result_type=ref[T] and emit_choose's
                                ; NPO heuristic dispatches via null check
                                ; instead of tag dispatch — silently dropping
                                ; all but one when-arm. Mirrors stage-0
                                ; Planner.cpp:3866-3870.
                                let elem_ref Planner.get_pointer_element_type(rest_result.result_type)
                                if elem_ref <> null
                                    set rt: (*elem_ref)
                            }
                            ; s96: address-of — wrap operand in pointer[T].
                            ; Mirrors stage-0 Planner.cpp:3877 (resolvePrefix
                            ; OperatorCall: Name=="pointer", Generics=[Operand],
                            ; MangledName="P"+Operand.MangledName). Without
                            ; this, `&x` falls through to rt=operand_type,
                            ; meaning callers see the bare T and downstream
                            ; resolve_function_call# arity-checks against
                            ; ref[T] / pointer[T] params using the wrong
                            ; argument type — fails, drops the call.
                            ; types_compatible (s96 part 2) extends the
                            ; rule set so pointer[T] flows into ref[T] /
                            ; pointer[T] params.
                            if prefix_name.equals(String$("&"))
                                set rt: Planner.make_pointer_type#(rest_result.result_type)
                        }

                        let mangled this.mangle_unary_operator#(
                            prefix_name, rest_result.result_type
                        )
                        var args_v Vector[PlannedOperand]^rp(1)
                        args_v.put(0, rest_result)
                        ; Mirrors Planner.cpp:4131-4132 — prefix operators on
                        ; primitive types are intrinsic (is_intrinsic=true,
                        ; is_operator=true). emit_call dispatches to
                        ; emit_intrinsic_operator instead of looking up a
                        ; non-existent library function.
                        var args_holder_p Vector[PlannedOperand]^rp(args_v)
                        let call PlannedCall(
                            result.loc,
                            prefix_name,
                            mangled,
                            true,
                            true,
                            false,
                            false,
                            &args_holder_p,
                            rt,
                            Lifetime.Unspecified(Unspecified()),
                            null,
                            false
                        )
                        let prefix_op PlannedOperand(
                            result.loc,
                            PlannedExpression.Call call,
                            null,
                            rt
                        )
                        ; s174: binary continuation — `*p <> 42` leaves
                        ; [<>, 42] after the consumed [*, p]; re-collapse
                        ; with the prefix call as the new first operand.
                        if consumed >= ops.length
                            return prefix_op
                        var cont_arr Array[PlannedOperand]$()
                        cont_arr.add prefix_op
                        var cc: size_t consumed
                        while cc < ops.length
                        {
                            let c_ptr ops.get cc
                            if c_ptr <> null
                                cont_arr.add((*c_ptr))
                            set cc: cc + 1
                        }
                        var cont_vec Vector[PlannedOperand]^rp(cont_arr)
                        return this.collapse_operand_sequence#(cont_vec)
                    }
                    0
                }
                else
                    0

            ; Single argument without parentheses: `print "Hello"`,
            ; `sb.append text`, `Box 5`, `ns.fn x`. Any one-argument routine
            ; — free function, procedure, method, intrinsic, extern, sibling
            ; method, or single-arg constructor — applied prefix to ONE plain
            ; value operand. Synthesize a one-component arg Tuple and recurse
            ; so the same [head, Tuple] machinery below resolves it. Mirrors
            ; stage-0 planOperands' parenless single-arg pre-pass.
            if ops.length = 2
            {
                var head_is_callable: bool false
                if result.member_access = null
                {
                    choose result.expr
                        when ht: PlannedType
                        {
                            ; Any non-operator, non-empty name head is
                            ; callable — matching the parenful [Type, Tuple]
                            ; gate below, which fires for ANY Type head and
                            ; lets resolve_function_call# sort out free fn /
                            ; sibling method / construction.
                            if ht.name.get_length() > 0
                            {
                                if Planner.is_operator_name(ht.name) = false
                                    set head_is_callable: true
                            }
                        }
                        else
                            0
                }
                if result.member_access <> null
                {
                    let ma (*result.member_access)
                    if ma.length > 0
                    {
                        let last_ptr ma.get(ma.length - 1)
                        if last_ptr <> null
                        {
                            if (*last_ptr).is_method
                                set head_is_callable: true
                        }
                    }
                }
                if head_is_callable
                {
                    let sa_arg_ptr ops.get 1
                    if sa_arg_ptr <> null
                    {
                        let sa_arg_op (*sa_arg_ptr)
                        ; Any single value operand is a valid argument
                        ; (Constant, Variable, GlobalRef, Call, ...).
                        ; Exclude only the structural operands the [Name, X]
                        ; machinery already owns: a Tuple (parenful args), a
                        ; Matrix (generic [T] args), an operator-named Type
                        ; (infix/prefix operator), an empty-name Type
                        ; (lifetime marker), or an As/Is operand — `X as Y`
                        ; is modeled [X, As] and the As consumes the preceding
                        ; operand, so it is a cast, not a call.
                        var arg_is_value: bool true
                        choose sa_arg_op.expr
                            when at: PlannedType
                            {
                                if at.name.get_length() = 0
                                    set arg_is_value: false
                                if Planner.is_operator_name(at.name)
                                    set arg_is_value: false
                            }
                            when atp: PlannedTuple
                                set arg_is_value: false
                            when amx: scalyc.compiler.Plan.PlannedMatrix
                                set arg_is_value: false
                            when aas: scalyc.compiler.Plan.PlannedAs
                                set arg_is_value: false
                            when ais: scalyc.compiler.Plan.PlannedIs
                                set arg_is_value: false
                            else
                                0
                        if arg_is_value
                        {
                            var sa_arg_vec Vector[PlannedOperand]^rp(1)
                            sa_arg_vec.put(0, sa_arg_op)
                            var sa_comps Vector[PlannedComponent]^rp(1)
                            sa_comps.put(0, PlannedComponent(
                                sa_arg_op.loc,
                                null,
                                &sa_arg_vec,
                                null
                            ))
                            let sa_tuple PlannedTuple(
                                sa_arg_op.loc,
                                &sa_comps,
                                sa_arg_op.result_type,
                                false,
                                Lifetime.Unspecified(Unspecified()),
                                null
                            )
                            let sa_tuple_op PlannedOperand(
                                sa_arg_op.loc,
                                PlannedExpression.Tuple sa_tuple,
                                null,
                                sa_arg_op.result_type
                            )
                            var sa_arr Array[PlannedOperand]$()
                            sa_arr.add result
                            sa_arr.add sa_tuple_op
                            var sa_vec Vector[PlannedOperand]^rp(sa_arr)
                            return this.collapse_operand_sequence#(sa_vec)
                        }
                    }
                }
            }

            ; Call detection: first operand followed by a Tuple. Two
            ; shapes accepted:
            ;   - free function: first operand's expr is a Type (name
            ;     reference);
            ;   - method call: first operand has a member_access chain
            ;     whose last hop is_method=true (from resolve_member_access).
            if ops.length >= 2
            {
                let second_ptr ops.get 1
                if second_ptr <> null
                {
                    let second (*second_ptr)
                    var is_call: bool false
                    var fn_name: String String^rp("")

                    ; Method-call branch FIRST: a PlannedType operand
                    ; carrying a method member_access (e.g. `cli.main`,
                    ; where `cli` resolves to a namespace concept and
                    ; `main` is the trailing method) must dispatch on
                    ; the method name, not the namespace name. Without
                    ; this, the next branch grabs `t.name` ("cli") and
                    ; resolve_function_call hunts for a function called
                    ; "cli" which doesn't exist, leaving the call un-
                    ; emitted and the body collapsing to ret void.
                    if result.member_access <> null
                    {
                        let ma (*result.member_access)
                        if ma.length > 0
                        {
                            let last_ptr ma.get(ma.length - 1)
                            if last_ptr <> null
                            {
                                let last_ma (*last_ptr)
                                if last_ma.is_method
                                {
                                    var tuple_second: bool false
                                    choose second.expr
                                        when tp: PlannedTuple
                                            set tuple_second: true
                                        else
                                            0
                                    if tuple_second
                                    {
                                        set is_call: true
                                        set fn_name: last_ma.name
                                    }
                                }
                            }
                        }
                    }

                    if is_call = false
                    {
                        choose result.expr
                            when t: PlannedType
                            {
                                set fn_name: t.name
                                choose second.expr
                                    when tp: PlannedTuple
                                        set is_call: true
                                    else
                                        0
                                0
                            }
                            else
                                0
                    }

                    if is_call
                    {
                        ; Struct/Union value construction. When fn_name
                        ; resolves to a registered Concept, treat
                        ; Type(args) as construction rather than a free
                        ; function call. Mirrors Planner.cpp:8810+
                        ; (struct) and 9086+ (union variant).
                        var is_struct_ctor: bool false
                        var is_variant_ctor: bool false
                        var ctor_struct_type: PlannedType Planner.make_void_type#()
                        var ctor_union_type: PlannedType Planner.make_void_type#()
                        var ctor_variant_name: String String^rp("")
                        var ctor_variant_tag: size_t 0

                        ; Resolve struct construction regardless of lifetime.
                        ; The reshape below force-sets Lifetime.Unspecified on
                        ; the result PlannedTuple so stage-1 stack-alloca's the
                        ; struct (heap $/#/^ ctor support is deferred — would
                        ; need scaly_page_alloc + RBMM wiring). Without lifting
                        ; this guard, every `T$(args)` / `T#(args)` for a
                        ; registered struct (e.g. `Options#()`,
                        ; `String$(arg_ptr)`, `Vector[T]#(0)`) silently dropped:
                        ; lookup_concept finds the Structure but the gate stays
                        ; shut, the call falls through to resolve_function_call
                        ; which returns null, mangled_name stays empty, and
                        ; emit_call returns null — taking the binding and any
                        ; downstream reference (e.g. `arg.starts_with(...)`)
                        ; with it. parse_args body went from full option-
                        ; parsing to a bare `let arg_ptr; set i: i+1`.
                        let conc_ref this.lookup_concept(fn_name)
                        if conc_ref <> null
                        {
                            let conc (*conc_ref)
                            choose conc.definition
                                when s: Structure
                                {
                                    set is_struct_ctor: true
                                    choose result.expr
                                        when t: PlannedType
                                            set ctor_struct_type: t
                                        else
                                            0
                                }
                                when un: scalyc.compiler.Model.Union
                                {
                                    ; s172: Union#(value) copy-construction —
                                    ; e.g. `set parameters: ParameterSetSyntax#(
                                    ; success)` in parse_routine. Mirrors
                                    ; stage-0's Union-with-lifetime branch
                                    ; (Planner.cpp:9086): reshape the args
                                    ; tuple with tuple_type = the union so
                                    ; emit_tuple's whole-struct short-circuit
                                    ; copies the value. find_initializer#
                                    ; returns null for unions, so this always
                                    ; takes the reshape fallback below.
                                    ; Without it the construction falls
                                    ; through to function lookup, resolves
                                    ; nothing, and the whole `set` silently
                                    ; drops — stage-2 modeled every function
                                    ; with zero parameters (_Z3addv).
                                    ;
                                    ; s184: generic union variant ctor —
                                    ; `Option[int].Some(42)`. The planned
                                    ; Type operand names the union and
                                    ; carries the variant as its first
                                    ; resolved member-access hop (stage-0
                                    ; Case 2, Planner.cpp:8279). Divert to
                                    ; the variant-ctor branch; the s172
                                    ; copy-construction applies only when
                                    ; no variant hop is present.
                                    var has_variant_hop: bool false
                                    if result.member_access <> null
                                    {
                                        let vma (*result.member_access)
                                        if vma.length > 0
                                        {
                                            let vh_ptr vma.get 0
                                            if vh_ptr <> null
                                            {
                                                let vhop (*vh_ptr)
                                                if vhop.is_union_value
                                                {
                                                    set has_variant_hop: true
                                                    set is_variant_ctor: true
                                                    set ctor_variant_name: vhop.name
                                                    set ctor_variant_tag: vhop.field_index
                                                    choose result.expr
                                                        when t: PlannedType
                                                            set ctor_union_type: t
                                                        else
                                                            0
                                                }
                                            }
                                        }
                                    }
                                    if has_variant_hop = false
                                    {
                                        set is_struct_ctor: true
                                        choose result.expr
                                            when t: PlannedType
                                                set ctor_struct_type: t
                                            else
                                                0
                                    }
                                }
                                else
                                    0
                        }

                        ; Dotted union variant: Union.Variant(args). Split
                        ; on last '.', look up the prefix as a Union, the
                        ; suffix as a variant.
                        if is_struct_ctor = false
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let union_ref this.lookup_concept(prefix)
                                if union_ref <> null
                                {
                                    let uconc (*union_ref)
                                    var is_union_def: bool false
                                    choose uconc.definition
                                        when u: scalyc.compiler.Model.Union
                                            set is_union_def: true
                                        else
                                            0
                                    if is_union_def
                                    {
                                        let tag this.lookup_variant_tag(prefix, suffix)
                                        if tag >= 0
                                        {
                                            set is_variant_ctor: true
                                            set ctor_union_type: PlannedType(
                                                result.loc,
                                                prefix,
                                                Planner.mangle_structure#(prefix, null),
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                String^rp(""),
                                                null
                                            )
                                            set ctor_variant_name: suffix
                                            set ctor_variant_tag: tag as size_t
                                        }
                                    }
                                }
                            }
                        }

                        if is_struct_ctor
                        {
                            ; s81: ctor-call diversion. When find_initializer#
                            ; matches an init# overload (page_parameter set),
                            ; build a PlannedCall with C1 mangling and divert
                            ; to emit_constructor_call (Page::allocate + ctor
                            ; call). Without this, every T$/T#/T^ goes
                            ; through the stack-alloc reshape below, which
                            ; only works for "data class" structs without
                            ; custom init# logic. Heavy users like String,
                            ; Vector, StringBuilder rely on init# for proper
                            ; internal state (varint length, etc.). The
                            ; init# bodies are emitted by the synthesized
                            ; PlannedFunction wrapper in plan_initializer#.
                            let ctor_arg_types Planner.extract_arg_types#(second)
                            let init_match this.find_initializer#(fn_name, ctor_arg_types)
                            if init_match <> null
                            {
                                let ini_match (*init_match)
                                ; s84: the page_parameter if was load-bearing
                                ; under s81 because the `requires_page_param=true`
                                ; field below was hard-coded — without page on the
                                ; init, emit_constructor_call would still pass an
                                ; extra page arg, mismatching the C1 ABI.
                                ; Now we propagate `init# vs init` into
                                ; `requires_page_param`, enabling `Options#()`
                                ; (where Options has only `init()` (no #)) to
                                ; route through emit_constructor_call: heap-
                                ; allocate via Page::allocate, call C1 with
                                ; `this` only. Mirrors stage-0's
                                ; cli.test() IR for `var opts Options$()`.
                                {
                                    let has_page_param ini_match.page_parameter <> null
                                    let saved_subst_ctor type_substitutions.length
                                    if ctor_struct_type.generics <> null
                                    {
                                        let cgens (*ctor_struct_type.generics)
                                        let cc_ref this.lookup_concept(fn_name)
                                        if cc_ref <> null
                                        {
                                            let cc (*cc_ref)
                                            var pgi: size_t 0
                                            while pgi < cc.parameters.length
                                            {
                                                if pgi < cgens.length
                                                {
                                                    let gp_ptr cc.parameters.get pgi
                                                    let cg_ptr cgens.get pgi
                                                    if gp_ptr <> null
                                                    {
                                                        if cg_ptr <> null
                                                            this.define_type_substitution(gp_ptr.name, (*cg_ptr))
                                                    }
                                                }
                                                set pgi: pgi + 1
                                            }
                                        }
                                    }
                                    let init_input_items this.plan_items#(ini_match.input)
                                    set type_substitutions.length: saved_subst_ctor
                                    var init_input_holder Vector[PlannedItem]^rp(init_input_items)

                                    var parent_holder Vector[PlannedType]^rp(1)
                                    parent_holder.put(0, ctor_struct_type)
                                    let parent_ref parent_holder.get 0

                                    let c1_mangled Planner.mangle_function#(
                                        String$("init"), &init_input_holder, parent_ref, has_page_param
                                    )

                                    var ctor_call_args Array[PlannedOperand]$()
                                    choose second.expr
                                        when tp_args: PlannedTuple
                                        {
                                            if tp_args.components <> null
                                            {
                                                let comps_args (*tp_args.components)
                                                var ai: size_t 0
                                                while ai < comps_args.length
                                                {
                                                    let cap_ptr comps_args.get ai
                                                    if cap_ptr <> null
                                                    {
                                                        let cap (*cap_ptr)
                                                        if cap.value <> null
                                                        {
                                                            let cvals (*cap.value)
                                                            let collapsed_arg this.collapse_operand_sequence#(cvals)
                                                            ctor_call_args.add collapsed_arg
                                                        }
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                        }
                                        else
                                            0
                                    var ctor_args_vec Vector[PlannedOperand]^rp(ctor_call_args)

                                    let ctor_call PlannedCall(
                                        second.loc,
                                        String^rp("init"),
                                        c1_mangled,
                                        false,
                                        false,
                                        false,
                                        has_page_param,
                                        &ctor_args_vec,
                                        ctor_struct_type,
                                        ctor_struct_type.life,
                                        null,
                                        false
                                    )
                                    set result: this.rebind_trailing_chain#(PlannedOperand(
                                        second.loc,
                                        PlannedExpression.Call ctor_call,
                                        second.member_access,
                                        ctor_struct_type
                                    ))
                                    if ops.length > 2
                                    {
                                        var remaining_c Array[PlannedOperand]$()
                                        remaining_c.add result
                                        var rrc: size_t 2
                                        while rrc < ops.length
                                        {
                                            let prc_ptr ops.get rrc
                                            if prc_ptr <> null
                                                remaining_c.add((*prc_ptr))
                                            set rrc: rrc + 1
                                        }
                                        var remaining_cv Vector[PlannedOperand]^rp(remaining_c)
                                        return this.collapse_operand_sequence#(remaining_cv)
                                    }
                                    return result
                                }
                            }

                            ; Reshape the tuple to set tuple_type to the
                            ; struct type. Stack allocation only for now
                            ; (Lifetime.Unspecified — heap $/#/^ deferred).
                            ; Falls through here when find_initializer#
                            ; didn't match (data classes without init#) or
                            ; when init has no page_parameter (stack-only
                            ; init, currently unused).
                            var components_holder: ref[Vector[PlannedComponent]]? null
                            ; Collapse each component's operand sequence so
                            ; nested struct/union ctors and other multi-
                            ; operand expressions become a single planned
                            ; operand. emit_operands only walks the first
                            ; operand of a component value, so without
                            ; collapsing, `Parser(Lexer 7)` would drop the
                            ; inner Tuple and emit only the bare `Type(Lexer)`
                            ; operand — SEGV at LLVMTypeOf on null.
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    if tp.components <> null
                                    {
                                        let comps_in (*tp.components)
                                        var new_comps Array[PlannedComponent]$()
                                        var ci: size_t 0
                                        while ci < comps_in.length
                                        {
                                            let cp comps_in.get ci
                                            if cp <> null
                                            {
                                                let cc (*cp)
                                                var nc_value: ref[Vector[PlannedOperand]]? cc.value
                                                if cc.value <> null
                                                {
                                                    let vals (*cc.value)
                                                    if vals.length > 1
                                                    {
                                                        let collapsed this.collapse_operand_sequence#(vals)
                                                        var one_arr Array[PlannedOperand]^rp()
                                                        one_arr.add collapsed
                                                        var one_vec Vector[PlannedOperand]^rp(one_arr)
                                                        set nc_value: &one_vec
                                                    }
                                                }
                                                new_comps.add(PlannedComponent(
                                                    cc.loc, cc.name, nc_value, cc.attributes
                                                ))
                                            }
                                            set ci: ci + 1
                                        }
                                        var new_comps_holder Vector[PlannedComponent]^rp(new_comps)
                                        set components_holder: &new_comps_holder
                                    }
                                }
                                else
                                    0
                            ; Propagate the type's lifetime into the tuple.
                            ; ctor_struct_type carries the lifetime from the
                            ; lifetime marker merge (above) — `Plan#(...)` has
                            ; life=Call; `String$(...)` has life=Local; etc.
                            ; Non-Unspecified life ⇒ heap allocation
                            ; (emit_tuple respects is_region_alloc by calling
                            ; Page::allocate on the appropriate page).
                            var is_region: bool false
                            choose ctor_struct_type.life
                                when u: Unspecified
                                    0
                                else
                                    set is_region: true

                            let reshaped PlannedTuple(
                                second.loc,
                                components_holder,
                                ctor_struct_type,
                                is_region,
                                ctor_struct_type.life,
                                null
                            )
                            set result: this.rebind_trailing_chain#(PlannedOperand(
                                second.loc,
                                PlannedExpression.Tuple reshaped,
                                second.member_access,
                                ctor_struct_type
                            ))
                            if ops.length > 2
                            {
                                var remaining Array[PlannedOperand]$()
                                remaining.add result
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get rr
                                    if p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand]^rp(remaining)
                                return this.collapse_operand_sequence#(remaining_vec)
                            }
                            return result
                        }

                        if is_variant_ctor
                        {
                            ; Build a PlannedVariantConstruction. The
                            ; tuple's first component carries the payload
                            ; for variants like Some(int); empty `()`
                            ; produces a payload-less variant.
                            var payload_holder: ref[PlannedOperand]? null
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    if tp.components <> null
                                    {
                                        let comps (*tp.components)
                                        if comps.length > 0
                                        {
                                            let c_ptr comps.get 0
                                            if c_ptr <> null
                                            {
                                                let c (*c_ptr)
                                                if c.value <> null
                                                {
                                                    let v (*c.value)
                                                    let collapsed this.collapse_operand_sequence#(v)
                                                    var v_holder Vector[PlannedOperand]^rp(1)
                                                    v_holder.put(0, collapsed)
                                                    set payload_holder: v_holder.get(0)
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                    0

                            let vc PlannedVariantConstruction(
                                second.loc,
                                ctor_union_type,
                                ctor_variant_name,
                                ctor_variant_tag,
                                payload_holder
                            )
                            ; s184: keep a trailing member chain on the
                            ; construction result (`Option.Some(5).value`)
                            ; — same rule as the struct-ctor sites.
                            set result: this.rebind_trailing_chain#(PlannedOperand(
                                second.loc,
                                PlannedExpression.VariantConstruction vc,
                                second.member_access,
                                ctor_union_type
                            ))
                            if ops.length > 2
                            {
                                var remaining Array[PlannedOperand]$()
                                remaining.add result
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get rr
                                    if p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand]^rp(remaining)
                                return this.collapse_operand_sequence#(remaining_vec)
                            }
                            return result
                        }

                        ; s90: collapse each tuple component's operand
                        ; sequence before reading result_type so binary
                        ; operators in args (e.g. `f(a, x = y)`) yield
                        ; one type per component, matching the function
                        ; arity. Mirrors stage-0's planTuple at
                        ; Planner.cpp:10506-10511 (which always collapses).
                        ; Stage-1's plan_component# only collapses on
                        ; specific shapes; the tuple-arg path slipped
                        ; through. Without collapse here, an arg-list
                        ; component with a bool-comparison operand sees
                        ; `extract_arg_types#` flatten 3 operands into 3
                        ; arg types, resolve_function_call# arity-mismatches,
                        ; match_ref stays null, mangled="", emit_call drops
                        ; the call, and the entire `let X = f(...)` binding
                        ; plus any `if X = ...` follower silently
                        ; vanish from the IR.
                        var arg_types_arr_s90 Array[PlannedType]$()
                        choose second.expr
                            when tp_s90: PlannedTuple
                            {
                                if tp_s90.components <> null
                                {
                                    let comps_s90 (*tp_s90.components)
                                    var ai_s90: size_t 0
                                    while ai_s90 < comps_s90.length
                                    {
                                        let cp_s90 comps_s90.get ai_s90
                                        if cp_s90 <> null
                                        {
                                            let c_s90 (*cp_s90)
                                            if c_s90.value <> null
                                            {
                                                let v_s90 (*c_s90.value)
                                                if v_s90.length > 0
                                                {
                                                    let collapsed_s90 this.collapse_operand_sequence#(v_s90)
                                                    arg_types_arr_s90.add collapsed_s90.result_type
                                                }
                                            }
                                        }
                                        set ai_s90: ai_s90 + 1
                                    }
                                }
                            }
                            else
                                arg_types_arr_s90.add second.result_type
                        let arg_types Vector[PlannedType]^rp(arg_types_arr_s90)
                        var match_ref this.resolve_function_call#(fn_name, arg_types)

                        ; First-hop method dispatch (s75): when fn_name
                        ; is a dotted name `arg.starts_with` and `arg`
                        ; resolves to a local binding (not a Concept),
                        ; treat the call as a method on the receiver.
                        ; Without this, free-function lookup on the full
                        ; dotted name fails, the dotted-namespace
                        ; fallback below skips because `arg` isn't a
                        ; Concept, and the call drops with mangled="".
                        ; The receiver is prepended to the args list
                        ; below when is_method_dispatch is true.
                        ; Mirrors stage-0 Planner.cpp:7920-7940 method-
                        ; on-local-variable resolution.
                        var is_method_dispatch: bool false
                        var receiver_op: PlannedOperand result
                        if match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let local_ref this.lookup_local_binding(prefix)
                                if local_ref <> null
                                {
                                    let local (*local_ref)
                                    ; s109: dispatch on generic receivers
                                    ; (Container[int], Box[int]). encode_type#
                                    ; handles `Name[args]` → `<len><name>I<args>E`,
                                    ; so mangle_method# already produces the
                                    ; specialised symbol (e.g. `_ZN9ContainerIiE`
                                    ; `8set_itemEmi`). The previous skip was
                                    ; written before encode_type# learned
                                    ; generics; lifting it lets user-defined
                                    ; `Container[int].set_item(...)` resolve
                                    ; against the spec'd body emitted via
                                    ; instantiate_generic#. Stdlib generics
                                    ; (Vector / HashMap / etc.) are still
                                    ; excluded because their bodies aren't
                                    ; specialised in the planner walk — keep
                                    ; them on the unspec'd dispatch path so
                                    ; the existing extern-decl shim continues
                                    ; to work.
                                    var skip_dispatch: bool false
                                    if local.binding_type.generics <> null
                                    {
                                        if local.binding_type.name.equals(String$("pointer")) = false
                                        {
                                            if local.binding_type.name.equals(String$("ref")) = false
                                            {
                                                ; s137-INVESTIGATE: Vector removed
                                                if local.binding_type.name.equals(String$("HashMap"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("HashMapBuilder"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("HashSet"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("HashSetBuilder"))
                                                    set skip_dispatch: true
                                                ; s154: Array removed from skip_dispatch, mirroring
                                                ; the s137 Vector lift. Array[T] is specialised via
                                                ; instantiate_generic# (s129), so the s109 method-
                                                ; dispatch path (lookup_method# + extern-decl record)
                                                ; produces the right `_ZN5ArrayI<T>E3addE<T>` symbol.
                                                ; Without this, `functions.add(this.plan_function#(f,
                                                ; null))` in plan_module#'s member loop skipped
                                                ; dispatch entirely and the whole statement dropped —
                                                ; so plan_function# was never called, instantiated_
                                                ; functions stayed empty, and stage-2 emitted zero
                                                ; functions.
                                                ; s148: List removed alongside the is_stdlib_generic lift.
                                                ; Specialised List<T>::add/count/get_iterator bodies are
                                                ; now emitted via instantiate_generic#, so dispatch can
                                                ; route through the s109 extern-decl + record_function
                                                ; path the same way Vector does (skip_dispatch on Vector
                                                ; was lifted in s137, no regression there).
                                                ; if local.binding_type.name.equals(String$("List"))
                                                ;     set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("ListIterator"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("BuilderList"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("BuilderListIterator"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("Option"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("Result"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("Slice"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("Slot"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("Node"))
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals(String$("KeyValuePair"))
                                                    set skip_dispatch: true
                                            }
                                        }
                                    }
                                    if skip_dispatch = false
                                    {
                                    let mm_ref this.lookup_method#(local.binding_type, suffix, arg_types)
                                    if mm_ref <> null
                                    {
                                        let mm (*mm_ref)
                                        ; Build receiver as Variable(prefix).
                                        let recv PlannedOperand(
                                            result.loc,
                                            PlannedExpression.Variable(PlannedVariable(
                                                result.loc,
                                                prefix,
                                                local.binding_type,
                                                local.is_mutable
                                            )),
                                            null,
                                            local.binding_type
                                        )
                                        set receiver_op: recv
                                        set is_method_dispatch: true

                                        ; s78: record an extern PlannedFunction
                                        ; for the dispatched method so
                                        ; emit_function_decl emits an LLVM
                                        ; declare and emit_call's
                                        ; LLVMGetNamedFunction resolves it.
                                        ; Same-package methods (Options.*) are
                                        ; declared via the regular plan path;
                                        ; cross-package methods (String.*,
                                        ; Vector.*) need this. Skipped when
                                        ; already recorded (mirrors the
                                        ; dotted-namespace dedup at line ~2949).
                                        if this.has_recorded_function(mm.mangled_name) = false
                                        {
                                            var items_arr Array[PlannedItem]$()
                                            var this_type_holder Vector[PlannedType]^rp(1)
                                            this_type_holder.put(0, local.binding_type)
                                            items_arr.add(PlannedItem(
                                                result.loc,
                                                false,
                                                null,
                                                this_type_holder.get 0,
                                                null
                                            ))
                                            if mm.parameter_types <> null
                                            {
                                                let pt_vec_ref mm.parameter_types
                                                let pt_vec (*pt_vec_ref)
                                                var ai: size_t 0
                                                while ai < pt_vec.length
                                                {
                                                    let p_ptr pt_vec.get ai
                                                    if p_ptr <> null
                                                    {
                                                        var pty_holder Vector[PlannedType]^rp(1)
                                                        pty_holder.put(0, (*p_ptr))
                                                        items_arr.add(PlannedItem(
                                                            result.loc,
                                                            false,
                                                            null,
                                                            pty_holder.get 0,
                                                            null
                                                        ))
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                            var items_holder Vector[PlannedItem]^rp(items_arr)
                                            var rt_holder Vector[PlannedType]^rp(1)
                                            rt_holder.put(0, mm.return_type)
                                            let extern_impl PlannedImplementation.Extern(
                                                PlannedExternImpl result.loc
                                            )
                                            ; s119: honor mm.requires_page_param so cross-package /
                                            ; recursive-mid-planning stub IR signature matches the
                                            ; proper PlannedFunction emitted later. Without this,
                                            ; an early stub locks in a no-page-slot LLVM signature
                                            ; for any function whose body recursively calls itself
                                            ; (or is called before plan_function# records it).
                                            var pp_ref_a: ref[String]? null
                                            if mm.requires_page_param
                                            {
                                                var pp_h_a Vector[String]^rp(1)
                                                pp_h_a.put(0, String^rp("rp"))
                                                set pp_ref_a: pp_h_a.get(0)
                                            }
                                            this.record_function(PlannedFunction(
                                                result.loc,
                                                false,
                                                false,
                                                suffix,
                                                mm.mangled_name,
                                                pp_ref_a,
                                                &items_holder,
                                                rt_holder.get 0,
                                                mm.throws_type,
                                                Lifetime.Unspecified(Unspecified()),
                                                extern_impl,
                                                null,
                                                false,
                                                mm.can_throw,
                                                null,
                                                this.file
                                            ))
                                        }
                                        set match_ref: mm_ref
                                    }
                                    }
                                }
                            }
                        }

                        ; Method-on-chain dispatch (s83): when the first
                        ; operand has a member_access chain whose last hop
                        ; is_method=true, the call is an instance method on
                        ; the chain's truncated receiver. Truncate the chain
                        ; (drop the method hop), use last_acc.parent_type as
                        ; the receiver type, and look up the method.
                        ; Mirrors stage-0 Planner.cpp:4534-4607. Required
                        ; for `inner.get_value()` and `input_file.get_length()`
                        ; in method bodies (after the implicit-this
                        ; multi-segment fallback in plan_type_operand# returns
                        ; a chain ending in a method hop).
                        if match_ref = null
                        {
                            if result.member_access <> null
                            {
                                let ma_outer (*result.member_access)
                                if ma_outer.length > 0
                                {
                                    let last_p ma_outer.get(ma_outer.length - 1)
                                    if last_p <> null
                                    {
                                        let last_acc (*last_p)
                                        if last_acc.is_method
                                        {
                                            let recv_type last_acc.parent_type
                                            let mm_ref this.lookup_method#(recv_type, last_acc.name, arg_types)
                                            if mm_ref <> null
                                            {
                                                let mm3 (*mm_ref)
                                                ; Build truncated chain (drop last hop).
                                                var trunc_arr Array[PlannedMemberAccess]$()
                                                var ti: size_t 0
                                                while ti + 1 < ma_outer.length
                                                {
                                                    let mp ma_outer.get ti
                                                    if mp <> null
                                                        trunc_arr.add((*mp))
                                                    set ti: ti + 1
                                                }
                                                if trunc_arr.length > 0
                                                {
                                                    var trunc_holder Vector[PlannedMemberAccess]^rp(trunc_arr)
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        &trunc_holder,
                                                        recv_type
                                                    )
                                                }
                                                else
                                                {
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        null,
                                                        recv_type
                                                    )
                                                }

                                                ; Record extern PlannedFunction so
                                                ; emit_function_decl emits an LLVM
                                                ; declare and emit_call resolves it
                                                ; via LLVMGetNamedFunction. Mirrors
                                                ; the s78 record at the s75 site
                                                ; (line ~2794). Skipped if already
                                                ; recorded.
                                                if this.has_recorded_function(mm3.mangled_name) = false
                                                {
                                                    var items_arr2 Array[PlannedItem]$()
                                                    var this_type_holder2 Vector[PlannedType]^rp(1)
                                                    this_type_holder2.put(0, recv_type)
                                                    items_arr2.add(PlannedItem(
                                                        result.loc,
                                                        false,
                                                        null,
                                                        this_type_holder2.get 0,
                                                        null
                                                    ))
                                                    if mm3.parameter_types <> null
                                                    {
                                                        let pt_vec_ref2 mm3.parameter_types
                                                        let pt_vec2 (*pt_vec_ref2)
                                                        var ai2: size_t 0
                                                        while ai2 < pt_vec2.length
                                                        {
                                                            let p_ptr2 pt_vec2.get ai2
                                                            if p_ptr2 <> null
                                                            {
                                                                var pty_holder2 Vector[PlannedType]^rp(1)
                                                                pty_holder2.put(0, (*p_ptr2))
                                                                items_arr2.add(PlannedItem(
                                                                    result.loc,
                                                                    false,
                                                                    null,
                                                                    pty_holder2.get 0,
                                                                    null
                                                                ))
                                                            }
                                                            set ai2: ai2 + 1
                                                        }
                                                    }
                                                    var items_holder2 Vector[PlannedItem]^rp(items_arr2)
                                                    var rt_holder2 Vector[PlannedType]^rp(1)
                                                    rt_holder2.put(0, mm3.return_type)
                                                    let extern_impl2 PlannedImplementation.Extern(
                                                        PlannedExternImpl result.loc
                                                    )
                                                    ; s119: see stub-A site above.
                                                    var pp_ref_b: ref[String]? null
                                                    if mm3.requires_page_param
                                                    {
                                                        var pp_h_b Vector[String]^rp(1)
                                                        pp_h_b.put(0, String^rp("rp"))
                                                        set pp_ref_b: pp_h_b.get(0)
                                                    }
                                                    this.record_function(PlannedFunction(
                                                        result.loc,
                                                        false,
                                                        false,
                                                        last_acc.name,
                                                        mm3.mangled_name,
                                                        pp_ref_b,
                                                        &items_holder2,
                                                        rt_holder2.get 0,
                                                        mm3.throws_type,
                                                        Lifetime.Unspecified(Unspecified()),
                                                        extern_impl2,
                                                        null,
                                                        false,
                                                        mm3.can_throw,
                                                        null,
                                                        this.file
                                                    ))
                                                }

                                                set match_ref: mm_ref
                                                set is_method_dispatch: true
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; Dotted call fallback: `cli.main(args)` arrives
                        ; with fn_name="cli.main"; the function is registered
                        ; in model_functions under its short name "main"
                        ; (register_concept_recursive flattens namespace
                        ; members; register_module_concepts recurses into
                        ; sub-modules with register_function). Retry with
                        ; the suffix; if the prefix resolves to a Namespace
                        ; concept, also override mangled_name to
                        ; `_ZN<prefix><name>E<args>` so the call links to
                        ; the namespaced function (otherwise
                        ; check_function_match's mangle_free_function path
                        ; produces the bare `_Z<name>` and collides with
                        ; the program's own free function of the same
                        ; name). Plain modules don't add a namespace
                        ; segment to the mangled name, so the suffix-only
                        ; resolve already returns the right MethodMatch
                        ; for `compiler.test()` etc.
                        var ns_mangled: String String^rp("")
                        var has_ns_mangled: bool false
                        if match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(rp, 0, dot_pos)
                                let suffix fn_name.substring(
                                    rp,
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                ; s-LSP: resolve the dotted call. resolve_dotted_call#
                                ; first tries the normal this-implicit overload,
                                ; then — for a namespace this-method invoked
                                ; qualified with an EXPLICIT receiver
                                ; (`NS.f(recv, ...)` for `f(this: T, ...)`, where
                                ; `recv` is in arg_types but the this-implicit
                                ; matcher skips `this` and arity-fails) — retries
                                ; with the receiver arg dropped. Mirrors stage-0's
                                ; name-only Namespace path (Planner.cpp:8663); the
                                ; namespace-mangling block below then drops `this`
                                ; from the name (`_ZN<ns><fn>Ev`) and the call
                                ; still passes every explicit arg, so `recv` fills
                                ; `this`. This stays ONE statement — one call, one
                                ; store to match_ref, exactly as the old single
                                ; resolve_function_call# — so collapse_operand_
                                ; sequence#'s s178 alloca pool keeps match_ref in a
                                ; stable slot. An earlier two-statement form (a
                                ; `if match_ref = null { set match_ref: ... }`
                                ; diamond) perturbed the pool's liveness and aliased
                                ; match_ref onto a recycled slot (two_vec), losing
                                ; the value before the final mangled-name read.
                                set match_ref: this.resolve_dotted_call#(prefix, suffix, arg_types)

                                if match_ref <> null
                                {
                                    ; s177: prefer the Namespace concept for the
                                    ; prefix. lookup_concept returns the inner
                                    ; same-named Structure for `define Planner {
                                    ; define Planner(...) }`, so `Planner.x#()`
                                    ; from another namespace never took the
                                    ; namespace-mangling branch and the whole
                                    ; statement dropped.
                                    let ns_ref this.lookup_namespace_concept(prefix)
                                    if ns_ref <> null
                                    {
                                        let nsc (*ns_ref)
                                        var is_ns: bool false
                                        choose nsc.definition
                                            when n: Namespace
                                                set is_ns: true
                                            else
                                                0
                                        if is_ns
                                        {
                                            ; Build PlannedType for the
                                            ; namespace as a parent and
                                            ; rebuild the mangled name.
                                            var ns_parent_holder Vector[PlannedType]^rp(1)
                                            ns_parent_holder.put(0, PlannedType(
                                                result.loc,
                                                String^rp(prefix),
                                                Planner.encode_name prefix,
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                String^rp(""),
                                                null
                                            ))
                                            let ns_parent_ref ns_parent_holder.get 0

                                            ; Build items from the matched
                                            ; function's declared parameter
                                            ; types (not arg_types). Stage-0
                                            ; mangles using the declared
                                            ; param types — e.g. Console.println's
                                            ; signature is
                                            ; `(text: pointer[const_char])`,
                                            ; so the mangled name is
                                            ; `_ZN7Console7printlnEP10const_char`.
                                            ; Using arg_types instead would
                                            ; produce `_ZN7Console7printlnEP2i8`
                                            ; (string-literal type) which
                                            ; doesn't match libscaly's symbol.
                                            ;
                                            ; s129: when the prefix is a
                                            ; Namespace concept, look up the
                                            ; function within ITS members
                                            ; first. resolve_function_call#
                                            ; uses the global model_functions
                                            ; registry (keyed by bare name),
                                            ; so for Console.println it can
                                            ; resolve to the PRELUDE's
                                            ; `println(pointer[i8])` via
                                            ; exact-match — even though we're
                                            ; trying to dispatch to
                                            ; Console.println(pointer[const_char]).
                                            ; Without this carve-out, the
                                            ; rebuild produces
                                            ; `_ZN7Console7printlnEP2i8` (using
                                            ; prelude's `pointer[i8]`) rather
                                            ; than `...P10const_char`, and
                                            ; the link fails against
                                            ; libscaly's `..P10const_char`.
                                            var items_arr Array[PlannedItem]$()
                                            var used_ns_local: bool false
                                            choose nsc.definition
                                                when ns_def: Namespace
                                                {
                                                    var mi_ns: size_t 0
                                                    while mi_ns < ns_def.members.length
                                                    {
                                                        let m_ptr ns_def.members.get mi_ns
                                                        if m_ptr <> null
                                                        {
                                                            let mem (*m_ptr)
                                                            choose mem
                                                                when nf: Function
                                                                {
                                                                    if used_ns_local = false
                                                                    {
                                                                        if nf.name.equals(suffix)
                                                                        {
                                                                            ; Skip leading 'this'.
                                                                            var pstart: size_t 0
                                                                            if nf.input.length > 0
                                                                            {
                                                                                let fi0 nf.input.get 0
                                                                                if fi0 <> null
                                                                                {
                                                                                    if fi0.name <> null
                                                                                    {
                                                                                        let fname (*fi0.name)
                                                                                        if fname.equals(String$("this"))
                                                                                            set pstart: 1
                                                                                    }
                                                                                }
                                                                            }
                                                                            let expected_arity nf.input.length - pstart
                                                                            ; Two callable forms for a namespace function
                                                                            ; with an explicit `this` receiver param:
                                                                            ;   (a) receiver-separate: arg_types holds the
                                                                            ;       non-`this` args (expected_arity match);
                                                                            ;   (b) this-inclusive: the receiver is passed
                                                                            ;       as the first arg (json.stringify#(v)),
                                                                            ;       so arg_types.length == nf.input.length.
                                                                            ; For (b) build from the FULL input (build_start
                                                                            ; 0) so the recorded stub's param list MATCHES
                                                                            ; the real PlannedFunction (plan_function# keeps
                                                                            ; `this` in input; mangle_function# skips the
                                                                            ; `this`-named item). Without this, a function
                                                                            ; whose ONLY param is `this` got an empty-input
                                                                            ; extern stub recorded first, locking in a
                                                                            ; signature missing the `this` LLVM arg.
                                                                            var build_start: size_t pstart
                                                                            var arity_ok: bool false
                                                                            if expected_arity = arg_types.length
                                                                                set arity_ok: true
                                                                            if pstart > 0
                                                                            {
                                                                                if nf.input.length = arg_types.length
                                                                                {
                                                                                    set arity_ok: true
                                                                                    set build_start: 0
                                                                                }
                                                                            }
                                                                            if arity_ok
                                                                            {
                                                                                var pi_ns: size_t build_start
                                                                                while pi_ns < nf.input.length
                                                                                {
                                                                                    let p_ptr nf.input.get pi_ns
                                                                                    if p_ptr <> null
                                                                                    {
                                                                                        if p_ptr.type <> null
                                                                                        {
                                                                                            let pt (*p_ptr.type)
                                                                                            let planned_p this.plan_type#(pt)
                                                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                                                            ity_holder.put(0, planned_p)
                                                                                            ; Preserve the param NAME so the
                                                                                            ; `this` item is recognised and
                                                                                            ; skipped by mangle_function#.
                                                                                            items_arr.add(PlannedItem(
                                                                                                result.loc,
                                                                                                false,
                                                                                                p_ptr.name,
                                                                                                ity_holder.get 0,
                                                                                                null
                                                                                            ))
                                                                                        }
                                                                                    }
                                                                                    set pi_ns: pi_ns + 1
                                                                                }
                                                                                set used_ns_local: true
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                    0
                                                        }
                                                        set mi_ns: mi_ns + 1
                                                    }
                                                }
                                                else
                                                    0
                                            let mm_for_params (*match_ref)
                                            let param_types_ref mm_for_params.parameter_types
                                            if used_ns_local = false
                                            {
                                                if param_types_ref <> null
                                                {
                                                    let pts (*param_types_ref)
                                                    var ai: size_t 0
                                                    while ai < pts.length
                                                    {
                                                        let pt_ptr pts.get ai
                                                        if pt_ptr <> null
                                                        {
                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                            ity_holder.put(0, (*pt_ptr))
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                ity_holder.get 0,
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                                if param_types_ref = null
                                                {
                                                    var ai: size_t 0
                                                    while ai < arg_types.length
                                                    {
                                                        let at_ptr arg_types.get ai
                                                        if at_ptr <> null
                                                        {
                                                            var ity_holder Vector[PlannedType]^rp(1)
                                                            ity_holder.put(0, (*at_ptr))
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                ity_holder.get 0,
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                            }
                                            var items_holder Vector[PlannedItem]^rp(items_arr)
                                            ; Honor the matched function's
                                            ; page-param flag in the mangled
                                            ; name. parse_args# in cli.scaly
                                            ; has has_page=true so the symbol
                                            ; needs `PN4scaly6memory4PageE`
                                            ; after the function name; without
                                            ; this stage-1 produced
                                            ; `_ZN3cli10parse_argsEiPPc` which
                                            ; doesn't match libscalyc's real
                                            ; `_ZN3cli10parse_argsEPN4scaly6memory4PageEiPPc`.
                                            let mm_pp (*match_ref)
                                            set ns_mangled: Planner.mangle_function#(
                                                suffix, &items_holder, ns_parent_ref, mm_pp.requires_page_param
                                            )
                                            set has_ns_mangled: true

                                            ; Declare the namespaced
                                            ; function as extern in the
                                            ; instantiation cache so the
                                            ; Emitter generates an LLVM
                                            ; declaration that emit_call
                                            ; can resolve via
                                            ; LLVMGetNamedFunction. The
                                            ; function's body comes from
                                            ; the linked package binary
                                            ; (libscalyc / libscaly) at
                                            ; link time. plan_namespace#
                                            ; itself doesn't recurse
                                            ; into ns.modules — calling
                                            ; plan_module# on stdlib
                                            ; modules crashes stage-1
                                            ; on body-level features it
                                            ; doesn't yet support, but
                                            ; an extern declaration
                                            ; needs only types we've
                                            ; already resolved here.
                                            ;
                                            ; Skip the declaration when
                                            ; we're inside a loaded
                                            ; package's namespace body
                                            ; (current_namespace is set)
                                            ; UNLESS the prefix matches
                                            ; a Use-imported alias of
                                            ; the program's main module.
                                            ; Without the gate, externs
                                            ; emitted from e.g.
                                            ; scaly.test()'s body for
                                            ; memory.test/containers.test/
                                            ; io.test break AOT tests
                                            ; that don't link libscaly.
                                            ; The Use-alias carve-out
                                            ; lets explicitly imported
                                            ; namespaces (e.g.
                                            ; main.scaly's
                                            ; `use scalyc.cli` -> "cli")
                                            ; emit real call
                                            ; instructions; the linker
                                            ; resolves them against the
                                            ; package binary at link
                                            ; time. Mirrors stage-0's
                                            ; check at
                                            ; Planner.cpp:7752-7789.
                                            ; Gate now relies solely on
                                            ; the program's Use aliases.
                                            ; Previously this also opened
                                            ; on `current_namespace = null`
                                            ; to handle top-level call
                                            ; sites in the main program;
                                            ; that was load-bearing only
                                            ; while libscaly wasn't linked
                                            ; into the AOT pipeline. Now
                                            ; that cli.run links libscaly
                                            ; unconditionally, the
                                            ; current_namespace clause is
                                            ; no longer required: any
                                            ; legitimate top-level call
                                            ; into a loaded package goes
                                            ; through a Use-imported
                                            ; alias. main.scaly's
                                            ; `use scalyc.cli` puts "cli"
                                            ; in program_use_aliases, so
                                            ; `cli.main(...)` still opens
                                            ; the gate.
                                            ; Also opens the gate when the
                                            ; prefix matches the currently-
                                            ; active namespace (sibling call
                                            ; like cli.parse_args# from
                                            ; inside cli.main). Mirrors
                                            ; stage-0's flatten-current-
                                            ; namespace pre-pass at
                                            ; Planner.cpp:7313-7327.
                                            var prefix_is_current_ns: bool false
                                            if current_namespace_name <> null
                                            {
                                                let cnsn (*current_namespace_name)
                                                if cnsn.equals(prefix)
                                                    set prefix_is_current_ns: true
                                            }
                                            var gate_open: bool false
                                            if this.is_program_use_alias(prefix)
                                                set gate_open: true
                                            if prefix_is_current_ns
                                                set gate_open: true
                                            if gate_open
                                            if this.has_recorded_function(ns_mangled) = false
                                            {
                                                let mm (*match_ref)
                                                var rt_holder Vector[PlannedType]^rp(1)
                                                rt_holder.put(0, mm.return_type)
                                                let extern_impl PlannedImplementation.Extern(
                                                    PlannedExternImpl result.loc
                                                )
                                                ; s78: propagate page_parameter when the
                                                ; matched function has has_page=true.
                                                ; Without this, function# callees recorded
                                                ; via the dotted fallback get null
                                                ; page_parameter, so emit_function_decl
                                                ; emits a 1-param signature for what
                                                ; should be 2-param (Page* + user param).
                                                ; A later call that goes through the body
                                                ; uses LLVMGetParam(func, 1) on a 1-param
                                                ; function and gets a bogus pointer.
                                                var pp_ref: ref[String]? null
                                                if mm.requires_page_param
                                                {
                                                    var pp_h Vector[String]^rp(1)
                                                    pp_h.put(0, String^rp("rp"))
                                                    set pp_ref: pp_h.get(0)
                                                }
                                                this.record_function(PlannedFunction(
                                                    result.loc,
                                                    false,
                                                    false,
                                                    suffix,
                                                    ns_mangled,
                                                    pp_ref,
                                                    &items_holder,
                                                    rt_holder.get 0,
                                                    mm.throws_type,
                                                    Lifetime.Unspecified(Unspecified()),
                                                    extern_impl,
                                                    null,
                                                    false,
                                                    mm.can_throw,
                                                    null,
                                                    this.file
                                                ))
                                            }
                                        }
                                    }
                                }

                                ; s155: Static method call `Type.method(args)`
                                ; where Type is a Structure concept and method
                                ; is a this-less function member. Mirrors stage-0
                                ; Planner.cpp:8421-8517. resolve_function_call#
                                ; (suffix) above misses these because struct
                                ; static methods aren't in the free-function
                                ; registry. Without this, `Page.get(this as
                                ; pointer[void])` inside Vector/Array.add resolves
                                ; to null and the whole `let own_page` binding
                                ; plus every downstream statement (allocate, the
                                ; item store, `set data`) silently drops — leaving
                                ; container .add() bodies that only bump `length`.
                                if match_ref = null
                                {
                                    let smc_ref this.lookup_concept(prefix)
                                    if smc_ref <> null
                                    {
                                        let smc (*smc_ref)
                                        var static_fn: ref[Function]? null
                                        choose smc.definition
                                            when sst: Structure
                                            {
                                                var smi: size_t 0
                                                while smi < sst.members.length
                                                {
                                                    let sm_ptr sst.members.get smi
                                                    if sm_ptr <> null
                                                    {
                                                        let sm (*sm_ptr)
                                                        choose sm
                                                            when sf: Function
                                                            {
                                                                if static_fn = null
                                                                {
                                                                    if sf.name.equals(suffix)
                                                                    {
                                                                        var is_static: bool true
                                                                        if sf.input.length > 0
                                                                        {
                                                                            let i0 sf.input.get 0
                                                                            if i0 <> null
                                                                            {
                                                                                if i0.name <> null
                                                                                {
                                                                                    if (*i0.name).equals(String$("this"))
                                                                                        set is_static: false
                                                                                }
                                                                            }
                                                                        }
                                                                        if is_static
                                                                        {
                                                                            var sfh Vector[Function]^rp(1)
                                                                            sfh.put(0, sf)
                                                                            set static_fn: sfh.get(0)
                                                                        }
                                                                    }
                                                                }
                                                                0
                                                            }
                                                            else
                                                                0
                                                    }
                                                    set smi: smi + 1
                                                }
                                            }
                                            else
                                                0

                                        if static_fn <> null
                                        {
                                            let sfn (*static_fn)
                                            var sparent_holder Vector[PlannedType]^rp(1)
                                            sparent_holder.put(0, PlannedType(
                                                result.loc,
                                                String^rp(prefix),
                                                Planner.encode_name prefix,
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                String^rp(""),
                                                null
                                            ))
                                            let sparent_ref sparent_holder.get 0
                                            var sitems_arr Array[PlannedItem]$()
                                            var spi: size_t 0
                                            while spi < sfn.input.length
                                            {
                                                let p_ptr sfn.input.get spi
                                                if p_ptr <> null
                                                {
                                                    if p_ptr.type <> null
                                                    {
                                                        let pt (*p_ptr.type)
                                                        let planned_p this.plan_type#(pt)
                                                        var sity Vector[PlannedType]^rp(1)
                                                        sity.put(0, planned_p)
                                                        sitems_arr.add(PlannedItem(
                                                            result.loc, false, null, sity.get 0, null
                                                        ))
                                                    }
                                                }
                                                set spi: spi + 1
                                            }
                                            var sitems_holder Vector[PlannedItem]^rp(sitems_arr)
                                            ; Page-param flag mirrors plan_function#'s
                                            ; has_page: explicit page_parameter OR an
                                            ; implicit return-page (struct-returning fns
                                            ; like statement_result_type get an rp arg in
                                            ; the mangled name even with no `#`). Without
                                            ; the implicit check, the call site mangles
                                            ; `...E16PlannedStatement` while the def is
                                            ; `...PageE16PlannedStatement` → link failure.
                                            var s_pp: bool false
                                            if sfn.page_parameter <> null
                                                set s_pp: true
                                            if Planner.needs_implicit_return_page(sfn)
                                                set s_pp: true
                                            let smangled Planner.mangle_function#(
                                                suffix, &sitems_holder, sparent_ref, s_pp
                                            )
                                            var s_rt: PlannedType Planner.make_void_type#()
                                            if sfn.returns_ <> null
                                                set s_rt: this.plan_type#((*sfn.returns_))
                                            var s_throws: ref[PlannedType]? null
                                            var s_can_throw: bool false
                                            if sfn.throws_ <> null
                                            {
                                                set s_can_throw: true
                                                var sth Vector[PlannedType]^rp(1)
                                                sth.put(0, this.plan_type#((*sfn.throws_)))
                                                set s_throws: sth.get(0)
                                            }
                                            var srt_holder Vector[PlannedType]^rp(1)
                                            srt_holder.put(0, s_rt)
                                            var smm_holder Vector[MethodMatch]^rp(1)
                                            smm_holder.put(0, MethodMatch(
                                                null,
                                                smangled,
                                                s_rt,
                                                null,
                                                s_pp,
                                                s_can_throw,
                                                s_throws,
                                                false,
                                                false
                                            ))
                                            set match_ref: smm_holder.get(0)
                                            if this.has_recorded_function(smangled) = false
                                            {
                                                var spp_ref: ref[String]? null
                                                if s_pp
                                                {
                                                    var spph Vector[String]^rp(1)
                                                    spph.put(0, String^rp("rp"))
                                                    set spp_ref: spph.get(0)
                                                }
                                                let sextern PlannedImplementation.Extern(
                                                    PlannedExternImpl result.loc
                                                )
                                                this.record_function(PlannedFunction(
                                                    result.loc,
                                                    false,
                                                    false,
                                                    suffix,
                                                    smangled,
                                                    spp_ref,
                                                    &sitems_holder,
                                                    srt_holder.get 0,
                                                    s_throws,
                                                    Lifetime.Unspecified(Unspecified()),
                                                    sextern,
                                                    null,
                                                    false,
                                                    s_can_throw,
                                                    null,
                                                    this.file
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; s101: Implicit-this sibling method dispatch.
                        ; When the standard lookup didn't find `fn_name`
                        ; and `this: pointer[T]` is in scope, try resolving
                        ; as T's method. Mirrors stage-0 Planner.cpp:1257-
                        ; 1277 (lookupFunction's struct-member walk) +
                        ; 9747-9786 (mangleFunction with parent = struct).
                        ; Required for `define T { fn a() ... fn b() a() }`
                        ; where `a()` from inside `b()` is a sibling method.
                        ; Without this, sibling method calls fall through
                        ; to mangled="" and the call drops out of the IR.
                        if match_ref = null
                        {
                            if has_ns_mangled = false
                            {
                                let this_ref this.lookup_local(String#("this"))
                                if this_ref <> null
                                {
                                    let this_ty (*this_ref)
                                    if this_ty.name.equals(String$("pointer"))
                                    {
                                        if this_ty.generics <> null
                                        {
                                            let gens_t (*this_ty.generics)
                                            if gens_t.length > 0
                                            {
                                                let inner_ptr gens_t.get 0
                                                if inner_ptr <> null
                                                {
                                                    let inner_t (*inner_ptr)
                                                    let mm_ref this.lookup_method#(inner_t, fn_name, arg_types)
                                                    if mm_ref <> null
                                                    {
                                                        set match_ref: mm_ref
                                                        ; Prepend the `this` receiver ONLY for instance
                                                        ; methods. A STATIC sibling method (Page::get,
                                                        ; Page::allocate_page) takes no `this` — prepending
                                                        ; it passes the wrong arg0 (s189: `get(object)` →
                                                        ; `get(this, object)` → current_page self-loop).
                                                        if (*mm_ref).takes_this
                                                        {
                                                            ; Build receiver_op as `this`.
                                                            set receiver_op: PlannedOperand(
                                                                result.loc,
                                                                PlannedExpression.Variable(PlannedVariable(
                                                                    result.loc,
                                                                    String^rp("this"),
                                                                    this_ty,
                                                                    false
                                                                )),
                                                                null,
                                                                this_ty
                                                            )
                                                            set is_method_dispatch: true
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        var rt: PlannedType this.fresh_type_var#(String$(""))
                        var mangled: String String^rp("")
                        if match_ref <> null
                        {
                            let m (*match_ref)
                            set rt: m.return_type
                            set mangled: m.mangled_name
                        }
                        if has_ns_mangled
                            set mangled: ns_mangled

                        ; Flatten the tuple argument into a list of
                        ; individual PlannedOperand values so the emitter
                        ; can treat each call argument separately. An
                        ; empty `()` produces an empty list. When the
                        ; call is a method dispatch on a local-variable
                        ; receiver (s75), prepend the receiver as
                        ; argument 0; the callee declared `this` as the
                        ; first param.
                        var args_arr Array[PlannedOperand]$()
                        if is_method_dispatch
                            args_arr.add receiver_op
                        choose second.expr
                            when tp: PlannedTuple
                            {
                                if tp.components <> null
                                {
                                    let comps (*tp.components)
                                    var ci: size_t 0
                                    while ci < comps.length
                                    {
                                        let c_ptr comps.get ci
                                        if c_ptr <> null
                                        {
                                            let c (*c_ptr)
                                            if c.value <> null
                                            {
                                                let v (*c.value)
                                                args_arr.add(this.collapse_operand_sequence#(v))
                                            }
                                        }
                                        set ci: ci + 1
                                    }
                                }
                            }
                            else
                                args_arr.add second
                        var call_args Vector[PlannedOperand]^rp(args_arr)
                        ; Propagate the matched function's page-param
                        ; requirement to the PlannedCall so emit_call
                        ; prepends the rp arg. Required for in-namespace
                        ; sibling calls to `function#` callees (e.g.
                        ; cli.main → cli.parse_args#).
                        var call_requires_page: bool false
                        if match_ref <> null
                        {
                            let mm_for_pp (*match_ref)
                            if mm_for_pp.requires_page_param
                                set call_requires_page: true
                        }
                        ; s143: propagate the matched function's can_throw
                        ; flag so plan_choose# can recognise this as a
                        ; throws-call when planning a choose over its
                        ; result. Without this, cli.run's
                        ; `choose p.parse_program#() when err: Error / when
                        ; program: Success` doesn't get distinct
                        ; variant_indices and the Error arm always wins via
                        ; the s142 default-redirect.
                        var call_can_throw: bool false
                        var call_throws_ty: ref[PlannedType]? null
                        if match_ref <> null
                        {
                            let mm_for_ct (*match_ref)
                            if mm_for_ct.can_throw
                                set call_can_throw: true
                            ; s149: propagate throws error type for Result-wrapper
                            if mm_for_ct.throws_type <> null
                                set call_throws_ty: mm_for_ct.throws_type
                        }
                        var call_args_holder Vector[PlannedOperand]^rp(call_args)
                        ; Option::unwrap / unwrap_or are intrinsics: the
                        ; emitter inlines them (NPO load / payload extract)
                        ; rather than calling a library function. Marking
                        ; them is_intrinsic here routes emit_call to
                        ; emit_intrinsic_function. Without this, a `.unwrap()`
                        ; reached via the multi-hop method-on-chain path
                        ; emits `call _ZN6OptionIR<T>E6unwrapEv` for scalyc
                        ; type args (PlannedType&, PlannedOperand&, ...) that
                        ; libscaly.a (Option over scaly types only) can't
                        ; provide → stage-2 link failure.
                        var call_is_intrinsic: bool false
                        if fn_name.equals(String$("unwrap"))
                            set call_is_intrinsic: true
                        if fn_name.equals(String$("unwrap_or"))
                            set call_is_intrinsic: true
                        ; s184: only Option's OWN unwrap/unwrap_or are
                        ; intrinsic. A user-defined free function named
                        ; `unwrap` resolves via match_ref without a
                        ; receiver and must emit as a plain call —
                        ; marking it intrinsic routed it through
                        ; emit_intrinsic_function, which returned null
                        ; and silently dropped the whole statement.
                        if call_is_intrinsic
                        {
                            if match_ref <> null
                            {
                                var recv_is_option: bool false
                                if is_method_dispatch
                                {
                                    if receiver_op.result_type.name.equals(String$("Option"))
                                        set recv_is_option: true
                                }
                                if recv_is_option = false
                                    set call_is_intrinsic: false
                            }
                        }
                        ; s185 (roadmap Step C): resolution exhausted —
                        ; mangled stays "". emit_call cannot look up such
                        ; a call; it would be SILENTLY dropped from the
                        ; IR. Two rescues replace the drop:
                        ; (a) bare variant construction `Some(5)`: scan
                        ;     the registered unions for a variant named
                        ;     fn_name and divert to a
                        ;     PlannedVariantConstruction. Stage-0's JIT
                        ;     path plans this shape (its AOT path dropped
                        ;     it too). First matching union wins. The
                        ;     scan is O(concepts^2) but only runs after
                        ;     resolution failure — never on a clean
                        ;     self-compile. (Out of scope for the concept_index
                        ;     Step-1 speedup: it scans variant names, not
                        ;     concept names; a future multi-index could serve
                        ;     it.)
                        ; (b) otherwise a HARD diagnostic with source
                        ;     position; cli.run prints it and fails the
                        ;     compile instead of emitting truncated IR.
                        if mangled.get_length() = 0
                        {
                            if call_is_intrinsic = false
                            {
                                if fn_name.last_index_of(46 as u8) < 0
                                {
                                    var bv_found: bool false
                                    var bv_tag: size_t 0
                                    var bv_union_name String^rp("")
                                    var bvi: size_t 0
                                    while bvi < concepts.length
                                    {
                                        if bv_found = false
                                        {
                                            let bv_kvp concepts.get bvi
                                            if bv_kvp <> null
                                            {
                                                let bv_t this.lookup_variant_tag(bv_kvp.key, fn_name)
                                                if bv_t >= 0
                                                {
                                                    set bv_found: true
                                                    set bv_tag: bv_t as size_t
                                                    set bv_union_name: bv_kvp.key
                                                }
                                            }
                                        }
                                        set bvi: bvi + 1
                                    }
                                    if bv_found
                                    {
                                        let bv_union_ty PlannedType(
                                            result.loc,
                                            bv_union_name,
                                            Planner.mangle_structure#(bv_union_name, null),
                                            null,
                                            Lifetime.Unspecified(Unspecified()),
                                            null,
                                            String^rp(""),
                                            null
                                        )
                                        var bv_payload: ref[PlannedOperand]? null
                                        if call_args_holder.length > 0
                                            set bv_payload: call_args_holder.get(0)
                                        let bv_vc PlannedVariantConstruction(
                                            result.loc,
                                            bv_union_ty,
                                            fn_name,
                                            bv_tag,
                                            bv_payload
                                        )
                                        ; Keep a trailing member chain on the
                                        ; construction result and early-return,
                                        ; mirroring the gate's variant-ctor
                                        ; branch (s184).
                                        set result: this.rebind_trailing_chain#(PlannedOperand(
                                            result.loc,
                                            PlannedExpression.VariantConstruction bv_vc,
                                            second.member_access,
                                            bv_union_ty
                                        ))
                                        if ops.length > 2
                                        {
                                            var bv_remaining Array[PlannedOperand]$()
                                            bv_remaining.add result
                                            var bv_rr: size_t 2
                                            while bv_rr < ops.length
                                            {
                                                let bv_ptr ops.get bv_rr
                                                if bv_ptr <> null
                                                    bv_remaining.add((*bv_ptr))
                                                set bv_rr: bv_rr + 1
                                            }
                                            var bv_vec Vector[PlannedOperand]^rp(bv_remaining)
                                            return this.collapse_operand_sequence#(bv_vec)
                                        }
                                        return result
                                    }
                                }
                                var dsb StringBuilder$()
                                dsb.append "function not found: "
                                dsb.append fn_name
                                this.add_diagnostic(result.loc, dsb.to_string^rp())
                            }
                        }
                        ; s196: propagate a `^name`/`#`/`$` lifetime onto the
                        ; PlannedCall. emit_call reads call.life inside its
                        ; requires_page_param branch: a Reference life routes
                        ; the page argument through resolve_reference_page(name)
                        ; (e.g. own_page) rather than the function-local page.
                        ; Mirrors stage-0 Planner.cpp:7444 (CallLifeRef =
                        ; HasLifetimeThenArgs ? MethodLifetime : TypeExpr->Life).
                        ; The marker pre-pass merges the `^name` either into the
                        ; receiver TYPE (`slot_list.add^own_page` — receiver is
                        ; a multi-segment PlannedType) or into the args TUPLE
                        ; (receiver planned as Variable+chain). Read both.
                        var call_life: Lifetime Lifetime.Unspecified(Unspecified())
                        choose result.expr
                            when ty_life: PlannedType
                            {
                                choose ty_life.life
                                    when u: Unspecified
                                        0
                                    else
                                        set call_life: ty_life.life
                                0
                            }
                            else
                                0
                        choose second.expr
                            when tp_life: PlannedTuple
                            {
                                choose tp_life.life
                                    when u: Unspecified
                                        0
                                    else
                                        set call_life: tp_life.life
                                0
                            }
                            else
                                0
                        ; Design-B "default-to-local" flip (NARROWED): an
                        ; un-sigiled heap-returning call defaults to the caller's
                        ; rp, which makes its result outlive the call
                        ; automatically (the inverse of Ralf's intent that rp be
                        ; used only DELIBERATELY via #/^rp). Flip the default to
                        ; THIS function's local page so transient scratch is
                        ; reclaimed at exit; the escape checker then forces a #
                        ; wherever the result actually escapes. ONLY for calls
                        ; whose result genuinely owns guts on the passed page
                        ; (result_owns_page_guts) — borrows/handles (pointer/ref,
                        ; ref[T]?, LLVM* wrappers) point elsewhere, so stamping
                        ; them Local is a false escape (the coarse
                        ; call_requires_page gate alone over-stamps them).
                        if call_requires_page
                        {
                            choose call_life
                                when u: Unspecified
                                    if Planner.result_owns_page_guts(rt)
                                        set call_life: Lifetime.Local(scalyc.compiler.Model.Local(Span(0, 0)))
                                else
                                    0
                        }
                        ; Design-B step 1 (mirror of stage-0 stampValueResultLifetime):
                        ; a value-returning init# method (requires_page_param)
                        ; produces a value whose internal pointers live on the
                        ; call-site page. Stamp call_life onto the result type so
                        ; the escape checker can see a $-local value escape. The
                        ; emitter reads call.life for page selection, not
                        ; result_type.life, so this is codegen-neutral.
                        if call_requires_page
                        {
                            choose call_life
                                when u: Unspecified
                                    0
                                else
                                    set rt: PlannedType(rt.loc, rt.name, rt.mangled_name, rt.generics, call_life, rt.origin, rt.array_size, rt.variable)
                        }
                        let call PlannedCall(
                            result.loc,
                            fn_name,
                            mangled,
                            call_is_intrinsic,
                            false,
                            call_can_throw,
                            call_requires_page,
                            &call_args_holder,
                            rt,
                            call_life,
                            call_throws_ty,
                            false
                        )
                        set result: PlannedOperand(
                            result.loc,
                            PlannedExpression.Call call,
                            null,
                            rt
                        )

                        ; Chained method calls: a.b().c().d(). The parser
                        ; attaches the NEXT method's member_access to the
                        ; current tuple operand. After the first call is
                        ; built, inspect the consumed tuple for a pending
                        ; method name, resolve against result.result_type,
                        ; and fold in another call if a following Tuple
                        ; supplies args. Repeat until the chain breaks.
                        var prev_tuple: PlannedOperand second
                        var next_idx: size_t 2
                        var keep_chaining: bool true
                        while keep_chaining
                        {
                            set keep_chaining: false
                            if prev_tuple.member_access <> null
                            {
                                let prev_ma (*prev_tuple.member_access)
                                if prev_ma.length > 0
                                {
                                    let last_ptr prev_ma.get(prev_ma.length - 1)
                                    if last_ptr <> null
                                    {
                                        let method_name (*last_ptr).name
                                        if next_idx < ops.length
                                        {
                                            let next_args_ptr ops.get next_idx
                                            if next_args_ptr <> null
                                            {
                                                let next_args (*next_args_ptr)
                                                var is_tuple: bool false
                                                choose next_args.expr
                                                    when tp: PlannedTuple
                                                        set is_tuple: true
                                                    else
                                                        0
                                                if is_tuple
                                                {
                                                    let match_ref this.lookup_method#(
                                                        result.result_type, method_name,
                                                        Planner.extract_arg_types#(next_args)
                                                    )
                                                    if match_ref <> null
                                                    {
                                                        let m (*match_ref)
                                                        ; s112: build the chained
                                                        ; PlannedCall's args list as
                                                        ; [receiver, ...flattened tuple
                                                        ; components]. Old code passed
                                                        ; [receiver, tuple_operand] —
                                                        ; emit_call then treated the
                                                        ; tuple as a second user arg
                                                        ; and the LLVMBuildCall2 arg
                                                        ; count didn't match the
                                                        ; method's `(this)` arity,
                                                        ; so emit_operand on an empty
                                                        ; Tuple returned null and
                                                        ; the entire outer call
                                                        ; dropped. Mirror the non-
                                                        ; chained call branch at
                                                        ; line ~3815.
                                                        var chained_args_arr Array[PlannedOperand]$()
                                                        chained_args_arr.add result
                                                        choose next_args.expr
                                                            when chained_tp: PlannedTuple
                                                            {
                                                                if chained_tp.components <> null
                                                                {
                                                                    let chained_comps (*chained_tp.components)
                                                                    var chained_ci: size_t 0
                                                                    while chained_ci < chained_comps.length
                                                                    {
                                                                        let chained_c_ptr chained_comps.get chained_ci
                                                                        if chained_c_ptr <> null
                                                                        {
                                                                            let chained_c (*chained_c_ptr)
                                                                            if chained_c.value <> null
                                                                            {
                                                                                let chained_v (*chained_c.value)
                                                                                chained_args_arr.add(this.collapse_operand_sequence#(chained_v))
                                                                            }
                                                                        }
                                                                        set chained_ci: chained_ci + 1
                                                                    }
                                                                }
                                                            }
                                                            else
                                                                0
                                                        var new_args Vector[PlannedOperand]^rp(chained_args_arr)
                                                        let chained this.make_planned_call#(
                                                            next_args.loc,
                                                            method_name,
                                                            m.mangled_name,
                                                            m.return_type,
                                                            new_args
                                                        )
                                                        set result: PlannedOperand(
                                                            next_args.loc,
                                                            PlannedExpression.Call chained,
                                                            null,
                                                            m.return_type
                                                        )
                                                        set prev_tuple: next_args
                                                        set next_idx: next_idx + 1
                                                        set keep_chaining: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; s175: trailing FIELD access on a call result —
                        ; `LLVMTypeOf(ret_val).handle <> llvm_rt.handle`.
                        ; The chaining loop above only consumes a tuple's
                        ; member_access when its last hop is a method
                        ; followed by an args Tuple; a plain field hop on
                        ; the call result was silently dropped, so the
                        ; operand kept the callee's struct result_type,
                        ; the following binary operator failed to resolve,
                        ; and the whole statement vanished — stage-2's
                        ; prelude print/println implicit return (`if
                        ; LLVMTypeOf(ret_val).handle <> llvm_rt.handle ...
                        ; LLVMBuildRet`) collapsed to `unreachable`.
                        ; Re-resolve the hop names against the call's
                        ; result type and attach the chain, but ONLY when
                        ; every hop resolves as a property — method hops
                        ; (chained calls, parenless methods) keep the
                        ; existing paths unchanged.
                        if prev_tuple.member_access <> null
                        {
                            let tail_ma (*prev_tuple.member_access)
                            if tail_ma.length > 0
                            {
                                var tail_names Vector[String]^rp(tail_ma.length)
                                var tni: size_t 0
                                while tni < tail_ma.length
                                {
                                    let tn_ptr tail_ma.get tni
                                    if tn_ptr <> null
                                        tail_names.put(tni, (*tn_ptr).name)
                                    set tni: tni + 1
                                }
                                let tail_chain this.resolve_member_access#(result.result_type, tail_names)
                                var all_props: bool false
                                if tail_chain.length > 0
                                    set all_props: true
                                var tci: size_t 0
                                while tci < tail_chain.length
                                {
                                    let tc_ptr tail_chain.get tci
                                    if tc_ptr = null
                                        set all_props: false
                                    if tc_ptr <> null
                                    {
                                        let tc (*tc_ptr)
                                        if tc.is_method
                                            set all_props: false
                                        if tc.result_type.name.equals(String$("void"))
                                            set all_props: false
                                    }
                                    set tci: tci + 1
                                }
                                if all_props
                                {
                                    var tail_holder Vector[PlannedMemberAccess]^rp(tail_chain)
                                    var tail_final: PlannedType result.result_type
                                    let tl_ptr tail_chain.get(tail_chain.length - 1)
                                    if tl_ptr <> null
                                        set tail_final: (*tl_ptr).result_type
                                    set result: PlannedOperand(
                                        result.loc,
                                        result.expr,
                                        &tail_holder,
                                        tail_final
                                    )
                                }
                            }
                        }

                        ; Splice the remaining ops into a fresh vector
                        ; and recurse.
                        if next_idx < ops.length
                        {
                            var remaining Array[PlannedOperand]$()
                            remaining.add result
                            var r: size_t next_idx
                            while r < ops.length
                            {
                                let p_ptr ops.get r
                                if p_ptr <> null
                                    remaining.add((*p_ptr))
                                set r: r + 1
                            }
                            var remaining_vec Vector[PlannedOperand]^rp(remaining)
                            return this.collapse_operand_sequence#(remaining_vec)
                        }
                        return result
                    }
                }
            }

            ; s176: parenless zero-arg method call as the lhs of a binary
            ; operator (`when_case.name.length > 0`) or before a postfix
            ; `as` (`fr.value.length as int`). The s171 lone-operand path
            ; only fires at ops.length==1 and the call detection above
            ; requires a following Tuple, so this shape reached the binary
            ; loop as a field access — the chain failed to resolve and the
            ; whole statement silently dropped (emit_choose/emit_try
            ; variant-binding guards vanished from stage-2). Synthesize
            ; the empty `()` Tuple and fold result into the zero-arg call
            ; before entering the loop. Mirrors stage-0's
            ; IsZeroArgMethodCall auto-call (Planner.cpp:5117).
            if result.member_access <> null
            {
                let lhs_ma (*result.member_access)
                if lhs_ma.length > 0
                {
                    let lhs_last_ptr lhs_ma.get(lhs_ma.length - 1)
                    if lhs_last_ptr <> null
                    {
                        if (*lhs_last_ptr).is_method
                        {
                            let void_ty_l Planner.make_void_type#()
                            let empty_tuple_l PlannedTuple(
                                result.loc,
                                null,
                                void_ty_l,
                                false,
                                Lifetime.Unspecified(Unspecified()),
                                null
                            )
                            let tuple_op_l PlannedOperand(
                                result.loc,
                                PlannedExpression.Tuple empty_tuple_l,
                                null,
                                void_ty_l
                            )
                            var two_arr_l Array[PlannedOperand]$()
                            two_arr_l.add result
                            two_arr_l.add tuple_op_l
                            var two_vec_l Vector[PlannedOperand]^rp(two_arr_l)
                            set result: this.collapse_operand_sequence#(two_vec_l)
                        }
                    }
                }
            }

            var i: size_t 1
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr = null
                {
                    set i: i + 1
                    continue
                }
                let op (*op_ptr)

                ; Postfix `is Type` — stitch the accumulated result in as
                ; the value operand, recompute the variant tag from the
                ; value's union type, and advance by 1.
                var handled_unary: bool false
                choose op.expr
                    when pis: PlannedIs
                    {
                        var value_holder Vector[PlannedOperand]^rp(1)
                        value_holder.put(0, result)

                        var new_tag: size_t pis.variant_tag
                        if pis.is_null_check = false
                        {
                            let tag this.lookup_variant_tag(
                                result.result_type.name, pis.test_type.name
                            )
                            if tag >= 0
                                set new_tag: tag as size_t
                        }

                        let stitched PlannedIs(
                            pis.loc,
                            pis.test_type,
                            new_tag,
                            result.result_type.name,
                            value_holder.get 0,
                            pis.is_null_check
                        )
                        set result: PlannedOperand(
                            op.loc,
                            PlannedExpression.Is stitched,
                            null,
                            Planner.make_bool_type#()
                        )
                        set handled_unary: true
                    }
                    when pas: PlannedAs
                    {
                        ; s152: compile-time fold `<string literal> as char`
                        ; → CharacterConstant and `as u8` → IntegerConstant
                        ; (first byte). Without this the string literal stays
                        ; a ptr (@.str) and emit_as ptrtoint's the ADDRESS to
                        ; i8 (garbage low byte), so `c = "/" as char` reduces
                        ; to a constant comparison that folds to false — every
                        ; such if in cli/lexer/parser is silently dropped.
                        ; Mirrors stage-0 Planner.cpp:4470-4517.
                        var folded: bool false
                        if pas.target_type.name.equals(String$("char"))
                        {
                            choose result.expr
                                when pc: scalyc.compiler.Plan.PlannedConstant
                                {
                                    choose pc.value
                                        when s: StringConstant
                                        {
                                            let cc Constant.Character(CharacterConstant(s.span, s.value))
                                            set result: PlannedOperand(
                                                op.loc,
                                                PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant cc),
                                                null,
                                                pas.target_type
                                            )
                                            set folded: true
                                        }
                                        else
                                            0
                                }
                                else
                                    0
                        }
                        if pas.target_type.name.equals(String$("u8"))
                        {
                            if folded = false
                            {
                                choose result.expr
                                    when pc: scalyc.compiler.Plan.PlannedConstant
                                    {
                                        choose pc.value
                                            when s: StringConstant
                                            {
                                                if s.value.get_length() > 0
                                                {
                                                    let bv s.value.get 0
                                                    let ic Constant.Integer(IntegerConstant(s.span, bv as size_t))
                                                    set result: PlannedOperand(
                                                        op.loc,
                                                        PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant ic),
                                                        null,
                                                        pas.target_type
                                                    )
                                                    set folded: true
                                                }
                                            }
                                            else
                                                0
                                    }
                                    else
                                        0
                            }
                        }
                        if folded = false
                        {
                            var value_holder Vector[PlannedOperand]^rp(1)
                            value_holder.put(0, result)
                            let stitched PlannedAs(
                                pas.loc,
                                pas.target_type,
                                value_holder.get 0
                            )
                            set result: PlannedOperand(
                                op.loc,
                                PlannedExpression.As stitched,
                                null,
                                pas.target_type
                            )
                        }
                        set handled_unary: true
                    }
                    else
                        0

                if handled_unary
                {
                    set i: i + 1
                    continue
                }

                ; Binary operator: op followed by rhs.
                ; if runs the break when the condition is TRUE (Scaly
                ; semantics, NOT Swift-inverted). Bail out when no rhs is
                ; available.
                if i + 1 >= ops.length
                    break

                let rhs_ptr ops.get(i + 1)
                var consumed_rest: bool false
                var rhs_call_consumed: bool false
                ; When the precedence look-ahead climbs, this records the
                ; operator position the right side stopped at (the precedence
                ; boundary). ops.length means it ran to the end. Read after the
                ; call is built to either break (boundary = end) or continue the
                ; outer loop from the boundary.
                var climb_to: size_t 0
                if rhs_ptr <> null
                {
                    var rhs: PlannedOperand (*rhs_ptr)

                    ; Extract operator name from the op operand.
                    let op_name choose op.expr
                        when ty: PlannedType
                            ty.name
                        else
                            String^rp("")

                    ; s189: rhs is itself a prefix operator (`x & ~y`,
                    ; `b.bitmap & ~((1 as u64) << slot)`). Grab the prefix
                    ; operator plus its single following operand and collapse
                    ; them into one operand so the binary op sees `~y`, not a
                    ; bare `~`. Without this the prefix RHS dropped and the
                    ; whole `&`/`|` expression vanished (stack_bucket_of's
                    ; `& ~BUCKET_MASK`, scaly_alloc_page's bitmap clear).
                    ; Advances i by 3 via rhs_call_consumed (op, ~, operand).
                    if i + 2 < ops.length
                    {
                        var rhs_is_prefix: bool false
                        choose rhs.expr
                            when rpty: PlannedType
                            {
                                if Planner.is_operator_name(rpty.name)
                                    set rhs_is_prefix: true
                            }
                            else
                                0
                        if rhs_is_prefix
                        {
                            let pfx_operand_ptr ops.get(i + 2)
                            if pfx_operand_ptr <> null
                            {
                                var pfx_arr Array[PlannedOperand]$()
                                pfx_arr.add rhs
                                pfx_arr.add((*pfx_operand_ptr))
                                var pfx_vec Vector[PlannedOperand]^rp(pfx_arr)
                                set rhs: this.collapse_operand_sequence#(pfx_vec)
                                set rhs_call_consumed: true
                            }
                        }
                    }

                    ; If rhs is a non-operator Type immediately followed by
                    ; a Tuple, treat it as an ungrouped call (`A | f()` →
                    ; rhs = Call(f), not Type(f)). Stage-0's planOperands
                    ; pre-processes this in scalyc/Planner.cpp:7359+ before
                    ; collapseOperandSequence runs; stage-1's plan_operands
                    ; is a flat per-operand pass, so we fold here. Without
                    ; this, `f1() | f2()` builds Call(|, [Call(f1),
                    ; Type(f2)]) and drops the trailing `()`, then the
                    ; entire `if cond { ... }` collapses because emit_call
                    ; on Type(f2) returns null and the binary call is
                    ; rejected upstream — observed in cli.parse_args's
                    ; chained-if branches.
                    if i + 2 < ops.length
                    {
                        var rhs_callable: bool false
                        choose rhs.expr
                            when rty: PlannedType
                            {
                                if Planner.is_operator_name(rty.name) = false
                                    set rhs_callable: true
                            }
                            else
                                0

                        ; s174: rhs with a member-access chain ending in a
                        ; method hop is callable too (`i < path.get_length()`).
                        ; Without this the Tuple after rhs is never consumed,
                        ; the chain plans as a field access (extractvalue),
                        ; and the comparison + branch drop — every
                        ; `while i < x.method()` loop became dead code in
                        ; stage-2 (extract_program_name, prelude path build).
                        if rhs_callable = false
                        {
                            if rhs.member_access <> null
                            {
                                let rma (*rhs.member_access)
                                if rma.length > 0
                                {
                                    let rlast_ptr rma.get(rma.length - 1)
                                    if rlast_ptr <> null
                                    {
                                        if (*rlast_ptr).is_method
                                            set rhs_callable: true
                                    }
                                }
                            }
                        }

                        if rhs_callable
                        {
                            let after_ptr ops.get(i + 2)
                            if after_ptr <> null
                            {
                                let after_op (*after_ptr)
                                var is_tuple_after: bool false
                                choose after_op.expr
                                    when tp_after: PlannedTuple
                                        set is_tuple_after: true
                                    else
                                        0
                                if is_tuple_after
                                {
                                    var sub_arr Array[PlannedOperand]$()
                                    sub_arr.add rhs
                                    sub_arr.add after_op
                                    var sub_vec Vector[PlannedOperand]^rp(sub_arr)
                                    set rhs: this.collapse_operand_sequence#(sub_vec)
                                    set rhs_call_consumed: true
                                }
                            }
                        }
                    }

                    ; rhs followed by an `as` cast: the postfix `as` binds
                    ; tighter than a binary operator, so fold [rhs, As] into
                    ; rhs first. Without this, `x = "/" as char` builds
                    ; (x = "/") and casts the whole comparison — the
                    ; string→char fold in the PlannedAs arm never sees the
                    ; string and the comparison degenerates to a constant.
                    ; Collapsing [rhs, As] lets that fold fire on the rhs.
                    if rhs_call_consumed = false
                    {
                        if i + 2 < ops.length
                        {
                            let as_ptr ops.get(i + 2)
                            if as_ptr <> null
                            {
                                let as_op (*as_ptr)
                                var is_as_after: bool false
                                choose as_op.expr
                                    when pa_after: PlannedAs
                                        set is_as_after: true
                                    else
                                        0
                                if is_as_after
                                {
                                    var as_arr Array[PlannedOperand]$()
                                    as_arr.add rhs
                                    as_arr.add as_op
                                    var as_vec Vector[PlannedOperand]^rp(as_arr)
                                    set rhs: this.collapse_operand_sequence#(as_vec)
                                    set rhs_call_consumed: true
                                }
                            }
                        }
                    }

                    ; s176: parenless zero-arg method call as the rhs
                    ; (`0 < x.name.length`). The Tuple-fold above only
                    ; fires when ops[i+2] is a Tuple; with no Tuple the
                    ; chain stayed a field access and the comparison
                    ; dropped. Fold rhs into the zero-arg call via the
                    ; same empty-Tuple synthesis. Consumes NO extra
                    ; operand, so rhs_call_consumed stays false (the
                    ; precedence look-ahead below keeps using i+2).
                    if rhs_call_consumed = false
                    {
                        if rhs.member_access <> null
                        {
                            let pma (*rhs.member_access)
                            if pma.length > 0
                            {
                                let plast_ptr pma.get(pma.length - 1)
                                if plast_ptr <> null
                                {
                                    if (*plast_ptr).is_method
                                    {
                                        let void_ty_r Planner.make_void_type#()
                                        let empty_tuple_r PlannedTuple(
                                            rhs.loc,
                                            null,
                                            void_ty_r,
                                            false,
                                            Lifetime.Unspecified(Unspecified()),
                                            null
                                        )
                                        let tuple_op_r PlannedOperand(
                                            rhs.loc,
                                            PlannedExpression.Tuple empty_tuple_r,
                                            null,
                                            void_ty_r
                                        )
                                        var two_arr_r Array[PlannedOperand]$()
                                        two_arr_r.add rhs
                                        two_arr_r.add tuple_op_r
                                        var two_vec_r Vector[PlannedOperand]^rp(two_arr_r)
                                        set rhs: this.collapse_operand_sequence#(two_vec_r)
                                    }
                                }
                            }
                        }
                    }

                    ; Precedence look-ahead. If ops[i+2] is an operator with
                    ; HIGHER precedence than op_name, recursively collapse
                    ; [rhs, ops[i+2], ops[i+3], ...] first so the binary
                    ; call uses the precedence-correct right side. Without
                    ; this, the left-associative fold turns
                    ; `A <> X & B <> Y` into `((A <> X) & B) <> Y` rather
                    ; than `(A <> X) & (B <> Y)`. Mirrors
                    ; Planner.cpp:4298-4322. Sets consumed_rest so the outer
                    ; loop breaks after this iteration since the entire
                    ; right side has been folded into rhs.
                    ; s175: when the rhs call-fold (or as-fold) above
                    ; consumed ops[i+2], the next operator sits at i+3 —
                    ; checking i+2 saw the consumed Tuple, never an
                    ; operator, so `starts_with(p) & len() > 2` left-
                    ; folded to `(bool & len) > 2` = `1 > 2` = false and
                    ; stage-2's parse_args rejected every -L/-l arg as
                    ; "Unknown option".
                    var prec_next: size_t i + 2
                    if rhs_call_consumed
                        set prec_next: i + 3
                    ; A text-named (non-operator-char) declared operator binds
                    ; weakest — precedence 1, like ||. Gated on NOT
                    ; is_operator_name so opchar operators (incl. source `==`
                    ; / `[]`, deliberately left at their table/0 precedence)
                    ; are unaffected — fixpoint-safe. The source has no
                    ; text-named operators, so this never fires during
                    ; self-compile.
                    var current_prec Planner.get_operator_precedence(op_name)
                    if current_prec = 0
                        if Planner.is_operator_name(op_name) = false
                            if this.is_operator(op_name)
                                set current_prec: 1
                    if current_prec > 0
                    {
                        if prec_next < ops.length
                        {
                            let next_op_ptr ops.get prec_next
                            if next_op_ptr <> null
                            {
                                let next_op (*next_op_ptr)
                                choose next_op.expr
                                    when nty: PlannedType
                                    {
                                        var next_is_op: bool false
                                        if Planner.is_operator_name(nty.name)
                                            set next_is_op: true
                                        if Planner.is_operator_name(nty.name) = false
                                            if this.is_operator(nty.name)
                                                set next_is_op: true
                                        if next_is_op
                                        {
                                            var next_prec Planner.get_operator_precedence(nty.name)
                                            if next_prec = 0
                                                if Planner.is_operator_name(nty.name) = false
                                                    if this.is_operator(nty.name)
                                                        set next_prec: 1
                                            if next_prec > current_prec
                                            {
                                                ; Bound the right-side collapse to
                                                ; the precedence boundary — the
                                                ; first LATER operator whose
                                                ; precedence is <= current_prec.
                                                ; Collapsing to the end would
                                                ; swallow a following lower-prec
                                                ; operator: `a = 0 - 5 && b`
                                                ; (`=`6, `-`9, `&&`2) must stop the
                                                ; `=` right side at `&&`, giving
                                                ; `(a = (0-5)) && b`, not
                                                ; `a = ((0-5) && b)`. Operators sit
                                                ; every 2 positions from prec_next.
                                                var climb_b: size_t ops.length
                                                var bnd: size_t prec_next
                                                var found_b: bool false
                                                while found_b = false
                                                {
                                                    if bnd >= ops.length
                                                        set found_b: true
                                                    else
                                                    {
                                                        let bp ops.get bnd
                                                        var bnd_prec: int 0
                                                        if bp <> null
                                                            choose (*bp).expr
                                                                when bty: PlannedType
                                                                {
                                                                    set bnd_prec: Planner.get_operator_precedence(bty.name)
                                                                    if bnd_prec = 0
                                                                        if Planner.is_operator_name(bty.name) = false
                                                                            if this.is_operator(bty.name)
                                                                                set bnd_prec: 1
                                                                }
                                                                else
                                                                    0
                                                        var is_b: bool false
                                                        if bnd_prec > 0
                                                            if bnd_prec <= current_prec
                                                                set is_b: true
                                                        if is_b
                                                        {
                                                            set climb_b: bnd
                                                            set found_b: true
                                                        }
                                                        else
                                                            set bnd: bnd + 2
                                                    }
                                                }
                                                var right_arr Array[PlannedOperand]$()
                                                right_arr.add rhs
                                                var rr: size_t prec_next
                                                while rr < climb_b
                                                {
                                                    let p_ptr ops.get rr
                                                    if p_ptr <> null
                                                        right_arr.add((*p_ptr))
                                                    set rr: rr + 1
                                                }
                                                var right_vec Vector[PlannedOperand]^rp(right_arr)
                                                set rhs: this.collapse_operand_sequence#(right_vec)
                                                set consumed_rest: true
                                                set climb_to: climb_b
                                            }
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    let resolved this.resolve_operator_call#(
                        op_name, result.result_type, rhs.result_type
                    )
                    var combined_type: PlannedType this.fresh_type_var#(String$(""))
                    if resolved <> null
                        set combined_type: (*resolved)

                    ; Pointer arithmetic fallback: pointer[T] +/- integer
                    ; resolves to pointer[T]. resolve_operator_call# only
                    ; sees registered operators, so primitive ptr-arith
                    ; falls through with a fresh type var — emit_intrinsic
                    ; _binary_op then has no element type to derive and the
                    ; GEP fallback uses i8 (byte stride). Mirrors
                    ; Planner.cpp:3135-3155 (findOperator's IsPointerType +
                    ; IsIntegerType branch) — result type = LHS pointer type.
                    if resolved = null
                    {
                        if result.result_type.name.equals(String$("pointer"))
                        {
                            if Planner.is_integer_type(rhs.result_type.name)
                            {
                                if op_name.equals(String$("+"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("-"))
                                    set combined_type: result.result_type
                            }
                        }

                        ; s90: built-in comparison operators on primitive
                        ; types return bool. Without this, the fresh type
                        ; var from above leaks into upstream arg_types,
                        ; resolve_function_call# then arity-matches but
                        ; type-mismatches against the formal `bool` parameter
                        ; (fresh-name "" vs "bool"), match_ref stays null,
                        ; mangled="", and `let X f(a, p = q)` silently drops.
                        ; Mirrors Planner.cpp's findOperator returning bool
                        ; for primitive comparison.
                        if op_name.equals(String$("="))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$("<>"))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$("<"))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$(">"))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$("<="))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$(">="))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$("&&"))
                            set combined_type: Planner.make_bool_type#()
                        if op_name.equals(String$("||"))
                            set combined_type: Planner.make_bool_type#()

                        ; s101: built-in arithmetic / bitwise operators on
                        ; primitive integer types return the left operand's
                        ; type. Without this, `n - 1` (and any int op)
                        ; resolves to a fresh type var (empty name) — which
                        ; then leaks into resolve_function_call#'s arg_types,
                        ; arity matches but type comparison fails against
                        ; the formal `int` parameter, match_ref stays null,
                        ; mangled="", and the entire surrounding call
                        ; silently drops. Mirrors stage-0 Planner.cpp:
                        ; findOperator's primitive arithmetic passthrough
                        ; at lines 3073-3112.
                        if Planner.is_integer_type(result.result_type.name)
                        {
                            if Planner.is_integer_type(rhs.result_type.name)
                            {
                                if op_name.equals(String$("+"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("-"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("*"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("/"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("%"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("div"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("mod"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("&"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("|"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("^"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$("<<"))
                                    set combined_type: result.result_type
                                if op_name.equals(String$(">>"))
                                    set combined_type: result.result_type
                            }
                        }
                    }

                    var two_args Vector[PlannedOperand]^rp(2)
                    two_args.put(0, result)
                    two_args.put(1, rhs)
                    var two_args_holder Vector[PlannedOperand]^rp(two_args)
                    ; Built-in binary operators on primitive types are
                    ; intrinsic (Planner.cpp:4378-4379). A user-defined
                    ; operator (resolve returned non-null AND its impl is not
                    ; Intrinsic) is NOT intrinsic — emit_call then emits a real
                    ; call to its mangled function. resolved=null keeps the
                    ; primitive-fallback intrinsic=true. Mirrors stage-0
                    ; Call.IsIntrinsic = OpMatch->IsIntrinsic (Planner.cpp:4470).
                    var bin_is_intrinsic: bool true
                    if resolved <> null
                        set bin_is_intrinsic: this.resolved_op_is_intrinsic
                    let call PlannedCall(
                        result.loc,
                        op_name,
                        this.mangle_binary_operator#(op_name, result.result_type, rhs.result_type),
                        bin_is_intrinsic,
                        true,
                        false,
                        false,
                        &two_args_holder,
                        combined_type,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        false
                    )
                    set result: PlannedOperand(
                        result.loc,
                        PlannedExpression.Call call,
                        null,
                        combined_type
                    )
                }
                if consumed_rest
                {
                    ; Whole tail folded into rhs (boundary = end): done.
                    ; Otherwise the bounded climb stopped at a lower-precedence
                    ; operator — continue the outer loop from that boundary with
                    ; the just-built call as the new left side.
                    if climb_to >= ops.length
                        break
                    set i: climb_to
                    continue
                }
                if rhs_call_consumed
                {
                    set i: i + 3
                    continue
                }
                set i: i + 2
            }

            result
        }

        ; check_operator_match: test a single Operator candidate against
        ; argument types. Same shape as check_function_match.
        function check_operator_match#(
            rp,
            this: Planner,
            o: Operator,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[PlannedType]?
        {
            var param_start: size_t 0
            if o.input.length > 0
            {
                let first_ptr o.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity o.input.length - param_start
            if expected_arity <> arg_types.length
                return null

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr o.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return null
                if a_ptr = null
                    return null
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return null
                }
                set j: j + 1
            }

            var holder Vector[PlannedType]^rp(1)
            if o.returns_ <> null
            {
                let rt (*o.returns_)
                holder.put(0, this.plan_type#(rt))
            }
            if o.returns_ = null
                holder.put(0, Planner.make_void_type#())
            holder.get 0
        }

        ; resolve_prefix_operator_call: for unary prefix operators like
        ; `-x` or `!flag`. Two-pass: exact matches first, then compatible.
        ; True iff an operator's implementation is Intrinsic (built-in
        ; primitive op, emitted inline by emit_intrinsic_*_op). A user-defined
        ; operator carries an Action body and must be emitted/called as a real
        ; function. Mirrors stage-0's holds_alternative<IntrinsicImpl>(Op->Impl).
        function operator_is_intrinsic(o: Operator) returns bool
        {
            var r: bool false
            choose o.implementation
                when oi: Intrinsic
                    set r: true
                else
                    0
            r
        }

        function resolve_prefix_operator_call#(
            rp,
            this: Planner,
            name: String,
            operand: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators#(name)
            if candidates.length = 0
                return null

            var arg_types Vector[PlannedType]^rp(1)
            arg_types.put(0, operand)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get i
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, true)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get k
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, false)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set k: k + 1
            }
            null
        }

        ; resolve_operator_call: two-pass overload resolution for binary
        ; operators keyed on the operator symbol registry.
        function resolve_operator_call#(
            rp,
            this: Planner,
            name: String,
            left: PlannedType,
            right: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators#(name)
            if candidates.length = 0
                return null

            var arg_types Vector[PlannedType]^rp(2)
            arg_types.put(0, left)
            arg_types.put(1, right)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get i
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, true)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get k
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match#(o, arg_types, false)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set k: k + 1
            }

            ; Pass 3: generic operator. Plan parameter types, infer
            ; generic bindings against arg_types, seed type_substitutions
            ; and plan the operator's declared return type under those
            ; bindings.
            var g: size_t 0
            while g < candidates.length
            {
                let o_ptr candidates.get g
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    if o.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        if o.input.length > 0
                        {
                            let fi0 o.input.get 0
                            if fi0 <> null
                            {
                                if fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    if fname.equals(String$("this"))
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity o.input.length - param_start2
                        if expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]$()
                            var pi: size_t param_start2
                            while pi < o.input.length
                            {
                                let p_ptr o.input.get pi
                                if p_ptr <> null
                                {
                                    if p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type#(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType]^rp(param_types_arr)

                            let bindings this.infer_type_arguments#(
                                param_types_vec, arg_types
                            )
                            if bindings.length >= o.parameters.length
                            {
                                let saved_len type_substitutions.length
                                var bi: size_t 0
                                while bi < bindings.length
                                {
                                    let kv_ptr bindings.get bi
                                    if kv_ptr <> null
                                        this.define_type_substitution(
                                            kv_ptr.key, kv_ptr.value
                                        )
                                    set bi: bi + 1
                                }

                                var holder Vector[PlannedType]^rp(1)
                                if o.returns_ <> null
                                {
                                    let rt_model (*o.returns_)
                                    holder.put(0, this.plan_type#(rt_model))
                                }
                                if o.returns_ = null
                                    holder.put(0, Planner.make_void_type#())

                                set type_substitutions.length: saved_len
                                set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                                return holder.get 0
                            }
                        }
                    }
                }
                set g: g + 1
            }

            null
        }

        ; mangle_method: build `_ZN<parent>methodEparam*` without the
        ; PlannedItem ceremony that mangle_function requires. Just takes
        ; a parent PlannedType and a Vector of param PlannedTypes.
        function mangle_method#(
            rp,
            this: Planner,
            method_name: String,
            parent: PlannedType,
            params: Vector[PlannedType],
            has_page_param: bool
        ) returns String
        {
            var sb StringBuilder$()
            sb.append "_ZN"
            sb.append(Planner.encode_type#(parent))
            sb.append(Planner.encode_name method_name)
            sb.append "E"

            ; Implicit page parameter for `function foo#(...)` methods —
            ; matches mangle_function's handling of has_page_param.
            var has_explicit: bool false
            if has_page_param
            {
                sb.append "PN4scaly6memory4PageE"
                set has_explicit: true
            }

            if params.length = 0
            {
                if has_explicit = false
                    sb.append "v"
                return sb.to_string^rp()
            }

            var i: size_t 0
            while i < params.length
            {
                let p_ptr params.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    sb.append(Planner.encode_type#(p))
                }
                set i: i + 1
            }

            sb.to_string^rp()
        }

        ; method_params_match: does method `f`'s declared parameter list
        ; (after skipping a leading `this`) match `arg_types`? Mirrors the
        ; per-arg comparison in check_function_match#, but returns only a
        ; bool so lookup_method# can pick the right overload among several
        ; same-named methods. `exact_only` selects types_equal (pass 1) vs
        ; types_compatible (pass 2).
        function method_params_match#(
            rp,
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type#(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }
            true
        }

        ; lookup_method: more-detailed method lookup that returns a
        ; MethodMatch with mangled name, return type, and parameter
        ; types pre-computed. The `method` field of MethodMatch points
        ; at a PlannedFunction — we leave it null for now; wiring it up
        ; requires caching planned methods per struct, which we don't
        ; do yet.
        function lookup_method#(
            rp,
            this: Planner,
            struct_type: PlannedType,
            method_name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            ; s106: auto-deref pointer[T] / ref[T] before lookup. Mirrors
            ; getInnerTypeIfPointerLike at Planner.cpp:1441. Without this,
            ; method dispatch on a pointer-typed local (e.g. init#'s
            ; implicit `page: pointer[scaly.memory.Page]`) silently fails
            ; because lookup walks the outer "pointer" name.
            var lookup_st: PlannedType struct_type
            if struct_type.name.equals(String$("pointer"))
            {
                if struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            if struct_type.name.equals(String$("ref"))
            {
                if struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            ; s172: Option[ref[T]] / Option[pointer[T]] unwrap — mirrors
            ; stage-0 lookupMethod's Option fallback (Planner.cpp:1730-
            ; 1737). Method calls through nullable ref fields
            ; (`names.add(n)` where names: ref[Vector[String]]?) carry
            ; parent_type Option[ref[Vector[String]]]; without the
            ; unwrap, lookup walks "Option", finds nothing, and the s83
            ; dispatch drops the whole call. Option's own methods are
            ; exempt so NPO unwrap dispatch keeps resolving.
            var mn_is_opt: bool false
            if method_name.equals(String$("unwrap"))
                set mn_is_opt: true
            if method_name.equals(String$("unwrap_or"))
                set mn_is_opt: true
            if method_name.equals(String$("is_some"))
                set mn_is_opt: true
            if method_name.equals(String$("is_none"))
                set mn_is_opt: true
            if mn_is_opt = false
            {
                if lookup_st.name.equals(String$("Option"))
                {
                    if lookup_st.generics <> null
                    {
                        let ogens (*lookup_st.generics)
                        if ogens.length > 0
                        {
                            let og_ptr ogens.get 0
                            if og_ptr <> null
                            {
                                var inner_o (*og_ptr)
                                if inner_o.name.equals(String$("ref"))
                                {
                                    if inner_o.generics <> null
                                    {
                                        let igens (*inner_o.generics)
                                        if igens.length > 0
                                        {
                                            let iip igens.get 0
                                            if iip <> null
                                                set inner_o: (*iip)
                                        }
                                    }
                                }
                                if inner_o.name.equals(String$("pointer"))
                                {
                                    if inner_o.generics <> null
                                    {
                                        let pgens (*inner_o.generics)
                                        if pgens.length > 0
                                        {
                                            let pip pgens.get 0
                                            if pip <> null
                                                set inner_o: (*pip)
                                        }
                                    }
                                }
                                set lookup_st: inner_o
                            }
                        }
                    }
                }
            }
            let candidates this.lookup_methods#(lookup_st.name, method_name)
            if candidates.length = 0
                return null

            ; s163: arg-type-aware overload selection. When a struct has
            ; several same-named methods (e.g. String.equals(String) /
            ; equals(pointer[const_char]) / equals(Vector[char])), pick the
            ; overload whose declared parameter types match the call's
            ; argument types — two passes (exact via types_equal, then
            ; compatible) mirroring resolve_function_call#. Without this,
            ; `joined.equals("pointer")` (arg pointer[const_char]) always
            ; resolved to equals(String)[0], mangled _ZN6String6equalsE6String,
            ; and a raw char* was passed where a String is expected →
            ; get_length deref'd the literal bytes → SIGSEGV in
            ; resolve_type_base#. A single candidate, or no arg-type match,
            ; falls back to the first by-name candidate (prior behaviour).
            var f_ptr: ref[Function]? candidates.get(0)
            if candidates.length > 1
            {
                let saved_subst_sel type_substitutions.length
                ; Bind the receiver concept's generic parameters to the
                ; concrete generics of lookup_st before matching, so a
                ; candidate's declared `T` param plans to the concrete
                ; type (e.g. Array[char].add: T→char). Without this,
                ; method_params_match# plans `plan_type#(T)` as an
                ; unbound type var that types_equal() treats as matching
                ; anything, so `buffer.add(Vector[char](...))` resolved
                ; to add(item: T) [= add(char)] instead of
                ; add(items: Vector[T]) — the Vector pointer was passed
                ; where an i8 was expected (s190). Stage-0 sidesteps this
                ; by collecting candidates from the already-instantiated
                ; structure's monomorphised methods.
                if lookup_st.generics <> null
                {
                    let mm_conc this.lookup_concept(lookup_st.name)
                    if mm_conc <> null
                    {
                        let mm_c (*mm_conc)
                        let mm_gens (*lookup_st.generics)
                        var mm_pi: size_t 0
                        while mm_pi < mm_c.parameters.length
                        {
                            if mm_pi < mm_gens.length
                            {
                                let mm_p mm_c.parameters.get mm_pi
                                let mm_a mm_gens.get mm_pi
                                if mm_p <> null
                                {
                                    if mm_a <> null
                                        this.define_type_substitution(mm_p.name, (*mm_a))
                                }
                            }
                            set mm_pi: mm_pi + 1
                        }
                    }
                }
                var chosen: ref[Function]? null
                var ci: size_t 0
                while ci < candidates.length
                {
                    if chosen = null
                    {
                        let c_ptr candidates.get ci
                        if c_ptr <> null
                        {
                            if this.method_params_match#((*c_ptr), arg_types, true)
                                set chosen: c_ptr
                        }
                    }
                    set ci: ci + 1
                }
                if chosen = null
                {
                    var ck: size_t 0
                    while ck < candidates.length
                    {
                        if chosen = null
                        {
                            let c_ptr candidates.get ck
                            if c_ptr <> null
                            {
                                if this.method_params_match#((*c_ptr), arg_types, false)
                                    set chosen: c_ptr
                            }
                        }
                        set ck: ck + 1
                    }
                }
                set type_substitutions.length: saved_subst_sel
                if chosen <> null
                    set f_ptr: chosen
            }
            if f_ptr = null
                return null
            let f (*f_ptr)

            ; ── s188: lazy full instantiation of a HashSet-machinery generic
            ; concept reached via a method CALL rather than a type annotation.
            ; plan_type#'s instantiate_generic# only fires for generic types
            ; written as annotations; methods called transitively from another
            ; generic's body (BuilderList<Slot<String>>::add from
            ; HashSetBuilder::add_internal, the Vector<BuilderList<…>> bucket
            ; ops, the iterator next() chain) are reached only as calls, so
            ; their owning structure was never instantiated — declared, never
            ; defined → undefined at seed link. Instantiate the WHOLE structure
            ; here (layout + ctor + ALL methods, consistent — a per-method hook
            ; is wrong: it makes the method real while the ctor stays a stub →
            ; null-field deref) the first time any method resolves.
            ; instantiate_generic# self-dedups (has_instantiated_structure) and
            ; self-guards cycles; its bodies resolve further machinery calls →
            ; recursion to fixed point. GATED to the data-structure plumbing
            ; HashSet<String> needs: firing for every generic concept also
            ; makes HashMap/HashMapBuilder<String,Nameable> (Modeler symbol
            ; table) real, which activates a latent-broken reallocate→page
            ; path the baseline masks with a no-op stub (runtime SIGSEGV).
            ; Ambient substitutions are cleared first: instantiate_generic#
            ; binds the concept params to the explicit concrete args, and a
            ; same-named ambient binding would win under first-wins lookup.
            if Planner.is_lazy_machinery_generic(lookup_st.name)
            {
                if lookup_st.generics <> null
                {
                    let li_gens (*lookup_st.generics)
                    if li_gens.length > 0
                    {
                        let li_smangled Planner.mangle_structure#(lookup_st.name, lookup_st.generics)
                        var li_need: bool true
                        if this.has_instantiated_structure(li_smangled)
                            set li_need: false
                        if li_need
                            if this.has_instantiated_union(li_smangled)
                                set li_need: false
                        var li_ip: size_t 0
                        while li_ip < instantiating_methods.length
                        {
                            let li_mp instantiating_methods.get li_ip
                            if li_mp <> null
                                if li_mp.equals(li_smangled)
                                    set li_need: false
                            set li_ip: li_ip + 1
                        }
                        if li_need
                        {
                            let li_conc this.lookup_concept(lookup_st.name)
                            if li_conc <> null
                            {
                                if (*li_conc).parameters.length > 0
                                {
                                    instantiating_methods.add li_smangled
                                    var li_args_holder Vector[PlannedType]^rp(li_gens)
                                    var li_snap Array[KeyValuePair[String, PlannedType]]$()
                                    var li_si: size_t 0
                                    while li_si < type_substitutions.length
                                    {
                                        let li_sp type_substitutions.get li_si
                                        if li_sp <> null
                                            li_snap.add((*li_sp))
                                        set li_si: li_si + 1
                                    }
                                    set type_substitutions.length: 0
                                    let li_pt this.instantiate_generic#(lookup_st.name, li_args_holder, lookup_st.loc)
                                    set type_substitutions.length: 0
                                    var li_ri: size_t 0
                                    while li_ri < li_snap.length
                                    {
                                        let li_rp li_snap.get li_ri
                                        if li_rp <> null
                                            type_substitutions.add((*li_rp))
                                        set li_ri: li_ri + 1
                                    }
                                    if instantiating_methods.length > 0
                                        set instantiating_methods.length: instantiating_methods.length - 1
                                }
                            }
                        }
                    }
                }
            }

            ; Set up type substitutions for the struct's type parameters.
            ; Mirrors Planner.cpp:1660-1664 / 2004-2007. Without this, when
            ; resolving the param/return Types of a generic method (e.g.
            ; Array.add(this, item: T)) the bound `T` doesn't substitute to
            ; the concrete generic argument (Program), so the mangled name
            ; comes out as `_ZN5ArrayI7ProgramE3addE1T` instead of
            ; `_ZN5ArrayI7ProgramE3addE7Program` and the link fails.
            ; s132: bind substitutions against the auto-deref'd `lookup_st`,
            ; not the raw `struct_type`. For a `ref[Vector[Module]]` receiver,
            ; struct_type.name="ref" and lookup_concept("ref")=null — the
            ; substitution loop silently no-ops and `T` stays unbound, so
            ; mangle_method emits `_ZN6VectorI6ModuleE3addE1T` instead of
            ; `..3addE6Module`. Mirrors the auto-deref above this block
            ; (lookup_st = struct_type.generics[0] when struct_type is
            ; pointer/ref).
            ; s167: plan the method's return/param types with the RECEIVER's
            ; generic bindings OVERRIDING any same-named ambient binding
            ; (mirrors stage-0's TypeSubstitutions map-overwrite). For a
            ; Vector<Vector<String>> receiver inside an instantiated
            ; HashSet[String], Vector's `T` must bind to Vector<String>,
            ; shadowing the ambient HashSet `T -> String`. Appending the
            ; receiver binding doesn't help — name_substitution_lookup is
            ; first-wins and a global last-wins flip breaks -c. So rebuild
            ; the substitution list: keep ambient entries whose key is NOT a
            ; receiver param, then append the receiver bindings; restore the
            ; full ambient list afterward.
            var rb_names Array[String]$()
            var rb_vals Array[PlannedType]$()
            let conc_ref this.lookup_concept(lookup_st.name)
            if conc_ref <> null
            {
                let conc (*conc_ref)
                if conc.parameters.length > 0
                {
                    if lookup_st.generics <> null
                    {
                        let gens_ref (*lookup_st.generics)
                        var pi: size_t 0
                        while pi < conc.parameters.length
                        {
                            if pi < gens_ref.length
                            {
                                let cp_ptr conc.parameters.get pi
                                let gen_ptr gens_ref.get pi
                                if cp_ptr <> null
                                {
                                    if gen_ptr <> null
                                    {
                                        rb_names.add cp_ptr.name
                                        rb_vals.add((*gen_ptr))
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                    }
                }
            }
            ; Snapshot ambient substitutions for restore.
            var subst_snapshot Array[KeyValuePair[String, PlannedType]]$()
            var ssi: size_t 0
            while ssi < type_substitutions.length
            {
                let sp type_substitutions.get ssi
                if sp <> null
                    subst_snapshot.add((*sp))
                set ssi: ssi + 1
            }
            ; Rebuild: ambient entries not shadowed by a receiver param,
            ; then the receiver bindings (so they resolve under first-wins).
            set type_substitutions.length: 0
            var rsi: size_t 0
            while rsi < subst_snapshot.length
            {
                let ep subst_snapshot.get rsi
                if ep <> null
                {
                    let e (*ep)
                    var shadowed: bool false
                    var ri: size_t 0
                    while ri < rb_names.length
                    {
                        let rn_ptr rb_names.get ri
                        if rn_ptr <> null
                            if rn_ptr.equals(e.key)
                                set shadowed: true
                        set ri: ri + 1
                    }
                    if shadowed = false
                        type_substitutions.add e
                }
                set rsi: rsi + 1
            }
            var rbi: size_t 0
            while rbi < rb_names.length
            {
                let rn_ptr rb_names.get rbi
                let rv_ptr rb_vals.get rbi
                if rn_ptr <> null
                {
                    if rv_ptr <> null
                        this.define_type_substitution((*rn_ptr), (*rv_ptr))
                }
                set rbi: rbi + 1
            }

            var return_type: PlannedType Planner.make_void_type#()
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type#(rt)
            }

            ; Skip leading 'this' in the parameter list.
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals(String$("this"))
                            set param_start: 1
                    }
                }
            }

            ; Collect planned parameter types (excluding this).
            var params_arr Array[PlannedType]$()
            var i: size_t param_start
            while i < f.input.length
            {
                let p_ptr f.input.get i
                if p_ptr <> null
                {
                    if p_ptr.type <> null
                    {
                        let pt (*p_ptr.type)
                        params_arr.add(this.plan_type#(pt))
                    }
                }
                set i: i + 1
            }
            var params_holder Vector[PlannedType]^rp(params_arr)
            ; s167: restore the full ambient substitution list.
            set type_substitutions.length: 0
            var rst: size_t 0
            while rst < subst_snapshot.length
            {
                let ep2 subst_snapshot.get rst
                if ep2 <> null
                    type_substitutions.add((*ep2))
                set rst: rst + 1
            }

            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            ; Implicit return-page: a function whose return type is a
            ; user-defined struct/union gets an `_rp` page parameter
            ; injected at planFunction time (Planner.cpp:11697). Mirror
            ; that here so the mangled name matches the emitted function.
            if Planner.needs_implicit_return_page(f)
                set has_page: true
            ; s106: mangle against the auto-derefed receiver type.
            ; struct_type may be pointer[Foo] / ref[Foo]; the Itanium
            ; method symbol uses the bare receiver Foo so it matches
            ; the body emitted under planStructure(Foo).
            let mangled this.mangle_method#(method_name, lookup_st, params_holder, has_page)

            ; Throws type (optional).
            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                var th_holder Vector[PlannedType]^rp(1)
                th_holder.put(0, this.plan_type#(tt))
                set throws_ref: th_holder.get(0)
            }

            ; s88: propagate has_page (set when the resolved method takes
            ; an explicit `page` param OR when it returns a struct/union
            ; that triggers the implicit-return-page injection) into the
            ; MethodMatch's requires_page_param. collapse_operand_sequence#
            ; reads this field on the resolved match and threads it onto
            ; the PlannedCall so emit_call prepends `rp` as arg0. Without
            ; it, every call to a `function#` method (e.g. String.to_c_string#,
            ; File.read_to_string#) emits only the explicit args and the
            ; callee reads garbage in the rp slot — observed as the empty
            ; cli.run "Could not read input file" path before s88.
            ; takes_this distinguishes instance methods (param_start=1, a
            ; leading `this`) from STATIC methods (param_start=0, e.g.
            ; Page::get / Page::allocate_page). The sibling-dispatch site
            ; (s101) prepends the `this` receiver only when this is true —
            ; a static method called unqualified from a sibling method must
            ; NOT get `this` prepended (s189: `get(object)` was emitted as
            ; `get(this, object)`, returning this's page → current_page
            ; self-loop → infinite recursion in Page::allocate).
            var mm_takes_this: bool false
            if param_start > 0
                set mm_takes_this: true
            var match_holder Vector[MethodMatch]^rp(1)
            match_holder.put(0, MethodMatch(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false,
                mm_takes_this
            ))
            match_holder.get 0
        }

        ; generate_page_get_this: synthesize a `Page.get(this)` call,
        ; returned as a PlannedOperand whose result_type is
        ; `pointer[Page]`. Used when lowering a `^this` lifetime
        ; annotation — the emitter needs the page that currently owns
        ; `this` to allocate a sibling value.
        ;
        ; `this` must be a local in the current scope; the unreachable
        ; fallback returns a void placeholder so the type checker still
        ; threads a value through.
        function generate_page_get_this#(rp, this: Planner, loc: Span) returns PlannedOperand
        {
            let this_ty_ref this.lookup_local(String$("this"))
            if this_ty_ref = null
            {
                let void_ty Planner.make_void_type#()
                return PlannedOperand(
                    loc,
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }

            let this_ty (*this_ty_ref)

            ; Build the result type: pointer[Page].
            let page_ty PlannedType(
                loc,
                String^rp("Page"),
                String^rp(""),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            )
            let result_type Planner.make_pointer_type#(page_ty)

            ; Plan the `this` variable operand to pass as the argument.
            let this_var PlannedVariable(loc, String^rp("this"), this_ty, false)
            let this_operand PlannedOperand(
                loc,
                PlannedExpression.Variable this_var,
                null,
                this_ty
            )

            var args_vec Vector[PlannedOperand]^rp(1)
            args_vec.put(0, this_operand)

            ; Mangle as a call to Page.get(pointer[void]).
            let call this.make_planned_call#(
                loc,
                String^rp("get"),
                String^rp("_ZN4scaly6memory4Page3getEPv"),
                result_type,
                args_vec
            )

            PlannedOperand(
                loc,
                PlannedExpression.Call call,
                null,
                result_type
            )
        }

        ; s184: a construction result can carry a trailing member chain
        ; (`Point(3, 4).x`). The construction gate attaches the chain raw
        ; and keeps result_type = the struct type, so plan_tuple's
        ; single-component lift typed the whole group as the struct and
        ; emit_tuple rebuilt the struct from the extracted field. Resolve
        ; the hops against the operand's result type and rewrite chain +
        ; result_type when every hop resolves as a property — the same
        ; rule as the s175 call-branch fix. Returns the operand
        ; unchanged when the chain is absent or not all-property.
        function rebind_trailing_chain#(
            rp,
            this: Planner,
            operand: PlannedOperand
        ) returns PlannedOperand
        {
            if operand.member_access = null
                return operand
            let tail_ma (*operand.member_access)
            if tail_ma.length = 0
                return operand
            var tail_names Vector[String]^rp(tail_ma.length)
            var tni: size_t 0
            while tni < tail_ma.length
            {
                let tn_ptr tail_ma.get tni
                if tn_ptr <> null
                    tail_names.put(tni, (*tn_ptr).name)
                set tni: tni + 1
            }
            let tail_chain this.resolve_member_access#(operand.result_type, tail_names)
            var all_props: bool false
            if tail_chain.length > 0
                set all_props: true
            var tci: size_t 0
            while tci < tail_chain.length
            {
                let tc_ptr tail_chain.get tci
                if tc_ptr = null
                    set all_props: false
                if tc_ptr <> null
                {
                    let tc (*tc_ptr)
                    if tc.is_method
                        set all_props: false
                    if tc.result_type.name.equals(String$("void"))
                        set all_props: false
                }
                set tci: tci + 1
            }
            if all_props = false
                return operand
            var tail_holder Vector[PlannedMemberAccess]^rp(tail_chain)
            var tail_final: PlannedType operand.result_type
            let tl_ptr tail_chain.get(tail_chain.length - 1)
            if tl_ptr <> null
                set tail_final: (*tl_ptr).result_type
            PlannedOperand(
                operand.loc,
                operand.expr,
                &tail_holder,
                tail_final
            )
        }

        ; ================================================================
        ; resolve_member_access: walk a chain of member names against
        ; `base_type`, producing a PlannedMemberAccess for each hop.
        ;
        ; At each step:
        ;   - if the name is a property, record the planned PropertyType
        ;     and continue the chain from that type;
        ;   - else if the name is a method, record the planned return
        ;     type and continue from that type;
        ;   - else record a placeholder with void result (caller will
        ;     surface this as an error when emission is attempted).
        ;
        ; The produced access chain feeds `PlannedOperand.member_access`.
        ; ================================================================
        function resolve_member_access#(
            rp,
            this: Planner,
            base_type: PlannedType,
            members: Vector[String]
        ) returns Vector[PlannedMemberAccess]
        {
            var result Array[PlannedMemberAccess]$()
            var current: PlannedType base_type

            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    let m (*m_ptr)

                    var matched: bool false

                    ; s106: auto-deref pointer[T] / ref[T] for member lookup.
                    ; Mirrors stage-0's getInnerTypeIfPointerLike at
                    ; Planner.cpp:1441. Without this, a pointer-typed local
                    ; (e.g. init#'s implicit `page: pointer[scaly.memory.Page]`)
                    ; never finds methods because lookup walks the outer
                    ; "pointer" name.
                    var lookup_type: PlannedType current
                    if current.name.equals(String$("pointer"))
                    {
                        if current.generics <> null
                        {
                            let gens (*current.generics)
                            if gens.length > 0
                            {
                                let inner_ptr gens.get 0
                                if inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }
                    if current.name.equals(String$("ref"))
                    {
                        if current.generics <> null
                        {
                            let gens (*current.generics)
                            if gens.length > 0
                            {
                                let inner_ptr gens.get 0
                                if inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }

                    ; s172: Option[ref[T]] / Option[pointer[T]] auto-deref —
                    ; mirrors stage-0 lookupMethod's Option-unwrap fallback
                    ; (Planner.cpp:1730-1737). A nullable ref field like
                    ; `function_cache_names: ref[Vector[String]]?` is
                    ; Option[ref[Vector[String]]]; without unwrapping,
                    ; lookup_property/lookup_methods search "Option", find
                    ; nothing, and the call (`names.add(n)`) silently
                    ; drops — stage-2's function cache stayed empty and
                    ; every body bailed at the cache miss. Option's own
                    ; methods (is_some/is_none/unwrap/unwrap_or) are
                    ; exempt so NPO unwrap dispatch keeps resolving on
                    ; the Option itself.
                    var m_is_opt_method: bool false
                    if m.equals(String$("unwrap"))
                        set m_is_opt_method: true
                    if m.equals(String$("unwrap_or"))
                        set m_is_opt_method: true
                    if m.equals(String$("is_some"))
                        set m_is_opt_method: true
                    if m.equals(String$("is_none"))
                        set m_is_opt_method: true
                    ; s184: variant names resolve on the union itself
                    ; (`Option[int].None` after the generic merge) —
                    ; unwrapping would look "None" up on the payload
                    ; type and produce a void placeholder hop.
                    if this.lookup_variant_tag(lookup_type.name, m) >= 0
                        set m_is_opt_method: true
                    if m_is_opt_method = false
                    {
                        if lookup_type.name.equals(String$("Option"))
                        {
                            if lookup_type.generics <> null
                            {
                                let ogens (*lookup_type.generics)
                                if ogens.length > 0
                                {
                                    let og_ptr ogens.get 0
                                    if og_ptr <> null
                                    {
                                        var inner_o (*og_ptr)
                                        if inner_o.name.equals(String$("ref"))
                                        {
                                            if inner_o.generics <> null
                                            {
                                                let igens (*inner_o.generics)
                                                if igens.length > 0
                                                {
                                                    let iip igens.get 0
                                                    if iip <> null
                                                        set inner_o: (*iip)
                                                }
                                            }
                                        }
                                        if inner_o.name.equals(String$("pointer"))
                                        {
                                            if inner_o.generics <> null
                                            {
                                                let pgens (*inner_o.generics)
                                                if pgens.length > 0
                                                {
                                                    let pip pgens.get 0
                                                    if pip <> null
                                                        set inner_o: (*pip)
                                                }
                                            }
                                        }
                                        set lookup_type: inner_o
                                    }
                                }
                            }
                        }
                    }

                    ; Property lookup.
                    let prop_ref this.lookup_property(lookup_type.name, m)
                    if prop_ref <> null
                    {
                        set matched: true
                        let prop (*prop_ref)
                        var prop_type: PlannedType this.fresh_type_var#(String$(""))
                        if prop.type <> null
                        {
                            let t (*prop.type)
                            ; s173: bind the concept's type parameters to
                            ; lookup_type's generic args before planning
                            ; the property type — mirrors stage-0
                            ; Planner.cpp:5078-5084. Without this,
                            ; KeyValuePair[String, LocalBinding].key
                            ; planned as bare "K", the next hop (.equals)
                            ; failed to resolve, and the whole guard
                            ; statement was dropped — stage-2's
                            ; lookup_local_binding compare loop vanished,
                            ; so every function param read planned as a
                            ; Type expression and bodies emitted const 0.
                            ; Receiver bindings shadow ambient same-named
                            ; entries (s167 first-wins rebuild pattern
                            ; from lookup_method#).
                            var ps_names Array[String]$()
                            var ps_vals Array[PlannedType]$()
                            let pconc_ref this.lookup_concept(lookup_type.name)
                            if pconc_ref <> null
                            {
                                let pconc (*pconc_ref)
                                if pconc.parameters.length > 0
                                {
                                    if lookup_type.generics <> null
                                    {
                                        let pgens (*lookup_type.generics)
                                        var ppi: size_t 0
                                        while ppi < pconc.parameters.length
                                        {
                                            if ppi < pgens.length
                                            {
                                                let pcp pconc.parameters.get ppi
                                                let pgp pgens.get ppi
                                                if pcp <> null
                                                {
                                                    if pgp <> null
                                                    {
                                                        ps_names.add pcp.name
                                                        ps_vals.add((*pgp))
                                                    }
                                                }
                                            }
                                            set ppi: ppi + 1
                                        }
                                    }
                                }
                            }
                            var did_subst: bool false
                            var ps_snapshot Array[KeyValuePair[String, PlannedType]]$()
                            if ps_names.length > 0
                            {
                                var psi: size_t 0
                                while psi < type_substitutions.length
                                {
                                    let sp2 type_substitutions.get psi
                                    if sp2 <> null
                                        ps_snapshot.add((*sp2))
                                    set psi: psi + 1
                                }
                                set type_substitutions.length: 0
                                var psr: size_t 0
                                while psr < ps_snapshot.length
                                {
                                    let ep3 ps_snapshot.get psr
                                    if ep3 <> null
                                    {
                                        let e3 (*ep3)
                                        var shadowed2: bool false
                                        var pri: size_t 0
                                        while pri < ps_names.length
                                        {
                                            let prn ps_names.get pri
                                            if prn <> null
                                                if prn.equals(e3.key)
                                                    set shadowed2: true
                                            set pri: pri + 1
                                        }
                                        if shadowed2 = false
                                            type_substitutions.add e3
                                    }
                                    set psr: psr + 1
                                }
                                var prb: size_t 0
                                while prb < ps_names.length
                                {
                                    let prn2 ps_names.get prb
                                    let prv2 ps_vals.get prb
                                    if prn2 <> null
                                    {
                                        if prv2 <> null
                                            this.define_type_substitution((*prn2), (*prv2))
                                    }
                                    set prb: prb + 1
                                }
                                set did_subst: true
                            }
                            set prop_type: this.plan_type#(t)
                            if did_subst
                            {
                                set type_substitutions.length: 0
                                var prr: size_t 0
                                while prr < ps_snapshot.length
                                {
                                    let ep4 ps_snapshot.get prr
                                    if ep4 <> null
                                        type_substitutions.add((*ep4))
                                    set prr: prr + 1
                                }
                            }
                        }
                        let idx this.get_property_index(lookup_type.name, m)
                        ; s173: record the UNWRAPPED lookup_type as the
                        ; hop's parent (mirrors stage-0 Planner.cpp:5104
                        ; "Use dereferenced type for auto-deref").
                        ; field_index is computed against lookup_type's
                        ; layout; recording the pre-unwrap Option[ref[T]]
                        ; made emit_member_access_chain's deref-load use
                        ; the wrong struct type and bail — `ret.result
                        ; .length > 0` in emit_return silently dropped,
                        ; every stage-2 body returned const 0/null.
                        result.add(PlannedMemberAccess(
                            m, idx as size_t, false, false, lookup_type, prop_type
                        ))
                        set current: prop_type
                    }

                    ; Method lookup as fallback.
                    if matched = false
                    {
                        let methods this.lookup_methods#(lookup_type.name, m)
                        if methods.length > 0
                        {
                            set matched: true
                            let first_ptr methods.get 0
                            if first_ptr <> null
                            {
                                let f (*first_ptr)
                                var return_ty: PlannedType this.fresh_type_var#(String$(""))
                                if f.returns_ <> null
                                {
                                    let rt (*f.returns_)
                                    set return_ty: this.plan_type#(rt)
                                }
                                ; s173: parent = unwrapped lookup_type
                                ; (stage-0 Planner.cpp:5142).
                                result.add(PlannedMemberAccess(
                                    m, 0, true, false, lookup_type, return_ty
                                ))
                                set current: return_ty
                            }
                        }
                    }

                    ; Union-variant lookup for the remaining case
                    ; (e.g. `opt.Some` as a variant construction). The
                    ; result type of a variant access is the owning union
                    ; itself — construction stays within the same type.
                    if matched = false
                    {
                        let tag this.lookup_variant_tag(lookup_type.name, m)
                        if tag >= 0
                        {
                            set matched: true
                            ; s173: parent = unwrapped lookup_type
                            ; (stage-0 Planner.cpp:5159).
                            result.add(PlannedMemberAccess(
                                m, tag as size_t, false, true, lookup_type,
                                current
                            ))
                        }
                    }

                    ; s103: Union `.value` accessor — extracts the
                    ; payload of the union's first non-unit variant.
                    ; Mirrors stage-0 Planner.cpp:5198-5226. The result
                    ; type is the variant's payload type. is_union_value
                    ; is set so emit_member_access_chain takes the
                    ; alloca + GEP-to-data + bitcast + load path
                    ; instead of a plain extractvalue at field_index.
                    if matched = false
                    {
                        if m.equals(String$("value"))
                        {
                            let conc_ref_for_value this.lookup_concept(lookup_type.name)
                            if conc_ref_for_value <> null
                            {
                                let conc_for_value (*conc_ref_for_value)
                                choose conc_for_value.definition
                                    when uv: scalyc.compiler.Model.Union
                                    {
                                        var found_payload: bool false
                                        var payload_type: PlannedType Planner.make_void_type#()
                                        var vi: size_t 0
                                        while vi < uv.variants.length
                                        {
                                            if found_payload = false
                                            {
                                                let v_ptr uv.variants.get vi
                                                if v_ptr <> null
                                                {
                                                    let var_def (*v_ptr)
                                                    if var_def.type <> null
                                                    {
                                                        let vt (*var_def.type)
                                                        set payload_type: this.plan_type#(vt)
                                                        set found_payload: true
                                                    }
                                                }
                                            }
                                            set vi: vi + 1
                                        }
                                        if found_payload
                                        {
                                            set matched: true
                                            ; s173: parent = unwrapped
                                            ; lookup_type (stage-0
                                            ; Planner.cpp:5224).
                                            result.add(PlannedMemberAccess(
                                                m, 1, false, true, lookup_type,
                                                payload_type
                                            ))
                                            set current: payload_type
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    ; Unresolved — record placeholder with void result.
                    if matched = false
                    {
                        var sb StringBuilder$()
                        sb.append "member '"
                        sb.append m
                        sb.append "' not found in type "
                        sb.append current.name
                        this.add_error(sb.to_string^rp())
                        result.add(PlannedMemberAccess(
                            m, 0, false, false, current, Planner.make_void_type#()
                        ))
                    }
                }
                set i: i + 1
            }

            Vector[PlannedMemberAccess]^rp(result)
        }

        ; fresh_type_var: allocate a new type variable as a PlannedType
        ; wrapper with `variable` populated. Equivalent to Planner.cpp's
        ; freshTypeVar. `debug_name` is stored on the TypeVariable for
        ; error messages ("expected T, got int").
        function fresh_type_var#(rp, this: Planner, debug_name: String) returns PlannedType
        {
            let id this.fresh_type_var_id()
            ; Allocate the TypeVariable in a one-element Vector on rp so
            ; its address outlives this function.
            var holder Vector[TypeVariable]^rp(1)
            holder.put(0, TypeVariable(id, String^rp(debug_name)))
            let tv_ref holder.get 0
            PlannedType(
                Span(0, 0),
                String^rp(debug_name),
                String^rp(""),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                tv_ref
            )
        }

        ; ================================================================
        ; Constraint management.
        ; ================================================================

        function add_equality_constraint(
            this: Planner,
            left: PlannedType,
            right: PlannedType,
            loc: Span
        )
        {
            constraints.add(TypeConstraint.Equality(
                EqualityConstraint(left, right, loc, String$(file))
            ))
        }

        ; solve_and_apply: drain the constraint queue, unify everything,
        ; stash the result in `solution`. Returns true on success, false
        ; if any constraint failed to unify. Constraints are cleared on
        ; success so subsequent add_equality_constraint / solve cycles
        ; start fresh.
        function solve_and_apply#(rp, this: Planner) returns bool
        {
            if constraints.length = 0
                return true

            ; Run the stateless solver.
            var cs_vec Vector[TypeConstraint]^rp(constraints)
            let result Planner.solve_constraints#(&cs_vec)
            if result = null
                return false

            ; Snapshot the substitution into the Planner's persistent
            ; `solution` array, overwriting any previous solution.
            set solution.length: 0
            let result_v (*result)
            var i: size_t 0
            while i < result_v.length
            {
                let kvp_ptr result_v.get i
                if kvp_ptr <> null
                    solution.add(*kvp_ptr)

                set i: i + 1
            }

            ; Constraints are consumed.
            set constraints.length: 0
            true
        }

        ; apply_current_substitution: rewrite `t` using the current
        ; `solution`. Convenience wrapper around apply_substitution so
        ; callers don't have to marshal the Array-as-Vector themselves.
        function apply_current_substitution#(rp, this: Planner, t: PlannedType) returns PlannedType
        {
            if solution.length = 0
                return t

            var sol_vec Vector[KeyValuePair[size_t, PlannedType]]^rp(solution)
            Planner.apply_substitution#(t, &sol_vec)
        }

        ; ================================================================
        ; plan_type: Model.Type → PlannedType using the active generic
        ; substitutions. Pulls together resolve_type_base (Model → Plan
        ; skeleton), apply_name_substitution (T → int, etc.), and the
        ; concept registry to fill in mangled_name for registered types.
        ; ================================================================
        function plan_type#(rp, this: Planner, t: Type) returns PlannedType
        {
            let base Planner.resolve_type_base#(t)

            var after_subst: PlannedType base
            var subst_fired: bool false
            if type_substitutions.length > 0
            {
                var sub_vec Vector[KeyValuePair[String, PlannedType]]^rp(type_substitutions)
                set after_subst: Planner.apply_name_substitution#(base, &sub_vec)
                ; If substitution actually replaced the name (T → Concrete),
                ; the result is already a concrete type — skip the dotted-name
                ; canonicalization that would shorten qualified names like
                ; `scalyc.compiler.Plan.PlannedUnion` → `PlannedUnion`. Stage-0
                ; preserves the full name in this case (encodeType uses the
                ; pre-set MangledName shortcut at Planner.cpp:518); without
                ; this if stage-1 emits an inconsistent mangling — the
                ; container generic uses `33scalyc.compiler.Plan.PlannedUnion`
                ; (full) while the arg substitutes to `12PlannedUnion` (short),
                ; producing a method symbol that no other side defines (s100).
                if after_subst.name.equals(base.name) = false
                    set subst_fired: true
            }
            if subst_fired
                return after_subst

            ; s96: Recursively canonicalize inner generics for ref[T] /
            ; pointer[T]. resolve_type_base# only recurses via itself
            ; (no Planner state, no has_concept access), so an inner
            ; type written as `Planner.Planner` (joined dotted name)
            ; stays in that form even when stage-1's concept registry
            ; has it under the canonical short name `Planner`. Without
            ; this, `ref[Planner.Planner]` mangles its inner as
            ; `15Planner.Planner` while a same-source-but-canonicalized
            ; `Planner` argument would mangle as `7Planner` — types_equal
            ; on the inner names returns false, types_compatible
            ; (s96 part 2) bails, the call is dropped. Mirrors stage-0
            ; Planner.cpp's resolveType which calls itself recursively
            ; on generic args (via resolveType, not the static helper).
            if after_subst.mangled_name.get_length() > 0
            {
                if t.generics <> null
                {
                    let model_gens (*t.generics)
                    if model_gens.length > 0
                    {
                        var canon_gens Vector[PlannedType]^rp(model_gens.length)
                        var gi: size_t 0
                        while gi < model_gens.length
                        {
                            let g_ptr model_gens.get gi
                            if g_ptr <> null
                            {
                                let g (*g_ptr)
                                let canon_inner this.plan_type#(g)
                                canon_gens.put(gi, canon_inner)
                            }
                            set gi: gi + 1
                        }
                        ; Rebuild outer mangled name with canonicalized inner.
                        var sb StringBuilder$()
                        if after_subst.name.equals("pointer")
                            sb.append "P"
                        if after_subst.name.equals("ref")
                            sb.append "R"
                        let inner0_ptr canon_gens.get 0
                        if inner0_ptr <> null
                        {
                            let inner0 (*inner0_ptr)
                            sb.append inner0.mangled_name
                        }
                        return PlannedType(
                            after_subst.loc,
                            after_subst.name,
                            sb.to_string^rp(),
                            &canon_gens,
                            after_subst.life,
                            after_subst.origin,
                            after_subst.array_size,
                            after_subst.variable
                        )
                    }
                }
                return after_subst
            }

            ; s192: fixed-size array type `T[N]` where T is a primitive.
            ; The model carries the size N as a "generic argument" of the
            ; primitive. Rewrite to pointer[T] with array_size set so
            ; emit_binding allocas `[N x T]` on the stack and decays it to
            ; a pointer. Without this the primitive-with-generic falls
            ; through to the concept path, the binding gets a bogus scalar
            ; type, and the whole enclosing body is dropped (e.g.
            ; `var buffer char[64]`). Mirrors stage-0 Planner.cpp:6193-6255.
            if Planner.is_primitive_type_name(after_subst.name)
            {
                if after_subst.generics <> null
                {
                    let arr_gens (*after_subst.generics)
                    if arr_gens.length > 0
                    {
                        let size_ptr arr_gens.get 0
                        if size_ptr <> null
                        {
                            let size_name (*size_ptr).name
                            ; Build the element pointer type pointer[T].
                            var probe_holder Vector[PlannedType]^rp(1)
                            probe_holder.put(0, PlannedType(
                                after_subst.loc,
                                after_subst.name,
                                String^rp(""),
                                null,
                                after_subst.life,
                                null,
                                String^rp(""),
                                null
                            ))
                            let elem_mangled Planner.encode_type#((*probe_holder.get(0)))
                            var elem_holder Vector[PlannedType]^rp(1)
                            elem_holder.put(0, PlannedType(
                                after_subst.loc,
                                after_subst.name,
                                elem_mangled,
                                null,
                                after_subst.life,
                                null,
                                String^rp(""),
                                null
                            ))
                            var ptr_sb StringBuilder$()
                            ptr_sb.append "P"
                            ptr_sb.append elem_mangled
                            return PlannedType(
                                after_subst.loc,
                                String^rp("pointer"),
                                ptr_sb.to_string^rp(),
                                &elem_holder,
                                after_subst.life,
                                null,
                                String^rp(size_name),
                                null
                            )
                        }
                    }
                }
            }

            ; Otherwise consult the concept table: a registered user type
            ; mangles as "_Z"-length-prefix-with-optional-generic-block.
            ;
            ; Dotted-name canonicalization: when the joined name (e.g.
            ; "parser.ProgramSyntax") doesn't resolve, try the last
            ; segment alone ("ProgramSyntax"). This makes a parameter
            ; type written as `parser.ProgramSyntax` (qualified by use
            ; alias) match a function declaring `syntax: ProgramSyntax`
            ; (unqualified). Mirrors stage-0 Planner.cpp:5619-5648
            ; (lookupConcept dotted) and 6263-6311 (resolveType module
            ; stack fallback).
            var canonical_name: String String^rp(after_subst.name)

            ; Union.Variant pattern: a dotted name like `Member.Function`
            ; where the prefix is a Union concept and the suffix is one of
            ; its variants must KEEP its dotted form so that
            ; collapse_operand_sequence#'s variant-ctor path (which splits
            ; on '.' and looks the prefix up as a union) fires. The suffix-
            ; canonicalization below would otherwise rewrite it to the bare
            ; suffix when the variant name collides with a registered type
            ; (e.g. `Concept`/`Function` are both Member variants AND Model
            ; types), so `Member.Function(fn)` would be planned as a bare
            ; `Function(fn)` construction and the union wrapper dropped —
            ; every top-level function/concept member then gets an undef
            ; tag and the planner's member loop skips it. Stage-0 resolves
            ; the variant before resolveType ever sees it.
            if this.has_concept(canonical_name) = false
            {
                let vc_dot canonical_name.last_index_of("." as u8)
                if vc_dot > 0
                {
                    let vc_start (vc_dot as size_t) + 1
                    let vc_total canonical_name.get_length()
                    if vc_total > vc_start
                    {
                        let vc_prefix canonical_name.substring(rp, 0, vc_dot as size_t)
                        let vc_suffix canonical_name.substring(rp, vc_start, vc_total - vc_start)
                        let vc_union_ref this.lookup_concept(vc_prefix)
                        if vc_union_ref <> null
                        {
                            let vc_uconc (*vc_union_ref)
                            var vc_is_union: bool false
                            choose vc_uconc.definition
                                when u: scalyc.compiler.Model.Union
                                    set vc_is_union: true
                                else
                                    0
                            if vc_is_union
                            {
                                let vc_tag this.lookup_variant_tag(vc_prefix, vc_suffix)
                                if vc_tag >= 0
                                    return after_subst
                            }
                        }
                    }
                }
            }

            if this.has_concept(canonical_name) = false
            {
                let last_dot canonical_name.last_index_of("." as u8)
                if last_dot >= 0
                {
                    let start (last_dot as size_t) + 1
                    let total canonical_name.get_length()
                    if total > start
                    {
                        let suffix canonical_name.substring(rp, start, total - start)
                        ; s182: Namespace-function pattern. A dotted name
                        ; like `NS.Thing` where the prefix is a Namespace
                        ; concept declaring a FUNCTION named `Thing` must
                        ; KEEP its dotted form. Canonicalizing to the bare
                        ; suffix whenever the function name collides with
                        ; a registered concept (the s179 class:
                        ; `LLVMTypeKind.Array()` planned as a zero-init
                        ; `Array` construction, call + enclosing comparison
                        ; silently dropped) hands the construction gate a
                        ; false match. With the dotted form kept, the
                        ; gate's lookup_concept misses and the dotted-call
                        ; fallback resolves the namespace function.
                        ; Mirrors stage-0's ordering: the qualified-call
                        ; branch runs BEFORE the construction check
                        ; (Planner.cpp:8604 vs 8754).
                        var nf_keep_dotted: bool false
                        let nf_ns_ref this.lookup_namespace_concept(
                            canonical_name.substring(rp, 0, last_dot as size_t))
                        if nf_ns_ref <> null
                        {
                            let nf_conc (*nf_ns_ref)
                            choose nf_conc.definition
                                when nf_ns: Namespace
                                {
                                    var nf_mi: size_t 0
                                    while nf_mi < nf_ns.members.length
                                    {
                                        let nf_m_ptr nf_ns.members.get nf_mi
                                        if nf_m_ptr <> null
                                        {
                                            let nf_mem (*nf_m_ptr)
                                            choose nf_mem
                                                when nff: Function
                                                {
                                                    if nff.name.equals(suffix)
                                                        set nf_keep_dotted: true
                                                    0
                                                }
                                                else
                                                    0
                                        }
                                        set nf_mi: nf_mi + 1
                                    }
                                    0
                                }
                                else
                                    0
                        }
                        if nf_keep_dotted
                            return after_subst
                        if this.has_concept(suffix)
                            set canonical_name: suffix
                    }
                }
            }
            if this.has_concept(canonical_name) = false
                return after_subst

            ; s107: when the concept is a generic data class (Structure
            ; with no members/initializers) used with concrete type args,
            ; route through instantiate_generic# so the specialised body
            ; gets recorded in instantiated_structures. Restricted to
            ; data classes — generics with method bodies (Vector,
            ; HashMap, etc.) drag in cross-package references that
            ; stage-1 cannot fully plan, exhausting the rp page during
            ; the deep plan_function# walk and SEGVing in LLVM codegen.
            ; The restriction means user-defined `define Box[T](value: T)`
            ; types instantiate cleanly, while stdlib generics fall
            ; through to the empty-mangled fallback below as before.
            let conc_ref this.lookup_concept(canonical_name)
            if conc_ref <> null
            {
                let conc (*conc_ref)
                if conc.parameters.length > 0
                {
                    ; s109: relax to any generic Structure. stdlib generics
                    ; (Vector / HashMap / Array / etc.) historically SEGV
                    ; when their bodies are walked with substitutions
                    ; bound — keep them on the empty-mangled fallback
                    ; path. User-defined generics with methods/inits
                    ; (e.g. nested_generic's Box, generic_lifetime's
                    ; Container) get specialised here so the spec'd
                    ; bodies (`_ZN3BoxIiE3getEv`, `_ZN9ContainerIiE...`)
                    ; reach the emitter.
                    var is_struct: bool false
                    choose conc.definition
                        when s: Structure
                            set is_struct: true
                        else
                            0
                    var is_stdlib_generic: bool false
                    ; s129: Vector + Array routed through instantiate_generic#
                    ; (removed from the data-class restriction). The s107 gate
                    ; originally excluded all stdlib generics because their
                    ; bodies were "drag[ging] in cross-package references" —
                    ; with s109..s127 (generic spec'd methods, intrinsic
                    ; map_type, page_param stub, deref-load, receiver-load,
                    ; emit_choose IR guards, empty-args ctor field-init, scope
                    ; push/pop, LinkOnceODR linkage) all in place, stage-1 can
                    ; now plan + emit those bodies. Removing Vector + Array
                    ; from this list cuts Step-7 stage-2 link undef refs from
                    ; 106 → 4. The matching skip_dispatch denylist site
                    ; (~line 3240) is intentionally kept: `vec.add(x)` style
                    ; method dispatch still routes via the extern-decl shim
                    ; rather than the spec'd `_ZN6VectorI...E3addE...` lookup.
                    if canonical_name.equals("HashMap")
                        set is_stdlib_generic: true
                    if canonical_name.equals("HashMapBuilder")
                        set is_stdlib_generic: true
                    ; s166: HashSet/HashSetBuilder lifted so
                    ; instantiate_generic# emits their init# bodies.
                    ; if canonical_name.equals("HashSet")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("HashSetBuilder")
                    ;     set is_stdlib_generic: true
                    ; s129: Array removed alongside Vector (see comment above).
                    ; s148: List + ListIterator + Node removed analogous to
                    ; the s129 Vector/Array lift. Without this, stage-1's
                    ; planner doesn't run instantiate_generic# for
                    ; List<StatementSyntax>/etc., so `list.add$(node)` calls
                    ; emitted via the skip_dispatch (still kept) extern-decl
                    ; shim have no body to link against. Specialised bodies
                    ; (`_ZN4ListIxxxE3addExxx`) are needed because Itanium
                    ; mangling makes each T-instantiation a distinct symbol
                    ; and libscaly.a only provides List<int> (used by tests
                    ; in scaly.scaly itself).
                    ; if canonical_name.equals("List")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("ListIterator")
                    ;     set is_stdlib_generic: true
                    ; s188: BuilderList + BuilderListIterator lifted (like
                    ; s129 Vector/Array, s148 List/Node, s166 HashSet).
                    ; HashSetBuilder<String> (un-denylisted) holds buckets:
                    ; Vector[BuilderList[Slot[String]]] and its real
                    ; add_internal/reallocate call BuilderList<Slot<String>>::
                    ; {add,get_iterator} + the iterator next() chain. With
                    ; these denylisted, plan_type# resolved them to a mangled
                    ; name only (declare, never define → undefined at seed
                    ; link). instantiate_generic# plans layout + ctor + ALL
                    ; methods consistently. This handles the type-annotation
                    ; path; lookup_method#'s s188 lazy hook handles the
                    ; call-reached path (BuilderList::add etc. are reached
                    ; only as calls from inside another generic's body).
                    ; if canonical_name.equals("BuilderList")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("BuilderListIterator")
                    ;     set is_stdlib_generic: true
                    ; s148: Node removed alongside List (see comment above).
                    ; List<T>::add allocates Node<T>; with Node in the
                    ; stdlib-generic skip list it falls through to the
                    ; abstract `{ptr, ptr}` placeholder (16 bytes for any
                    ; T) instead of `{T, ptr}` (sizeof(T) + 8). Lifting
                    ; lets instantiate_generic# produce a properly sized
                    ; named struct per concrete T.
                    ; if canonical_name.equals("Node")
                    ;     set is_stdlib_generic: true
                    ; s188: Slot lifted — element type of BuilderList<Slot<T>>,
                    ; a pure data class (plan_structure# just records layout).
                    ; if canonical_name.equals("Slot")
                    ;     set is_stdlib_generic: true
                    if canonical_name.equals("Slice")
                        set is_stdlib_generic: true
                    if canonical_name.equals("Option")
                        set is_stdlib_generic: true
                    if canonical_name.equals("Result")
                        set is_stdlib_generic: true
                    ; s173: KeyValuePair lifted (like s129 Vector/Array,
                    ; s148 List). It's a pure data class — no methods, no
                    ; init bodies, nothing to drag in. With it denylisted,
                    ; KeyValuePair[String, LocalBinding] never reached
                    ; instantiate_generic#, the emitter had no struct
                    ; layout, and every member hop through a KVP element
                    ; (lookup_local_binding's `kvp_ptr.key.equals(name)`)
                    ; bailed at map_type → the whole if statement
                    ; dropped → stage-2 resolved NO local variables.
                    ; if canonical_name.equals("KeyValuePair")
                    ;     set is_stdlib_generic: true
                    if is_struct
                        if is_stdlib_generic = false
                        {
                            if after_subst.generics <> null
                            {
                                let g (*after_subst.generics)
                                if g.length = conc.parameters.length
                                {
                                    ; s110: recursively plan each generic arg
                                    ; before instantiation, so nested generics
                                    ; like Box[Box[int]] propagate inner
                                    ; mangled names. Without this, inner args
                                    ; from resolve_type_base# carry empty
                                    ; mangled names and the spec'd struct's
                                    ; property type bottoms out with empty
                                    ; mangled — map_type's struct_cache miss
                                    ; emits the outer's field as opaque ptr.
                                    ; s115: skip the recursion when the inner
                                    ; arg is already a struct (has non-empty
                                    ; mangled_name) — the s110 case only
                                    ; needs to fire for raw model types from
                                    ; resolve_type_base#. Recursing on every
                                    ; arg in instantiate_generic#'s loop
                                    ; triggered deep stack growth in
                                    ; scalyc.scaly self-compile because
                                    ; nested-generic method bodies kept
                                    ; re-entering plan_type# → instantiate_
                                    ; generic# before the outer hit the
                                    ; instantiated_structures cache.
                                    ; s133: refine the s115 short-circuit. Using `gp`
                                    ; directly when its mangled is non-empty is safe
                                    ; for inner args that are already fully specialised
                                    ; (e.g. `Box[int]` arriving via type substitution).
                                    ; But when the model side `mp` has generics yet
                                    ; `gp.generics` is null, `gp` is the ABSTRACT
                                    ; template (mangled looks like `_Z12KeyValuePair`,
                                    ; no `I...E` suffix) and reusing it propagates the
                                    ; truncated mangling through every nesting layer.
                                    ; Concretely: HashMap[String, LocalBinding] uses
                                    ; Slot[KeyValuePair[K, V]] internally; without this
                                    ; carve-out, Vector<Vector<KeyValuePair<String,
                                    ; LocalBinding>>>::ctor ends up named
                                    ; `_ZN6VectorI6VectorI12KeyValuePairEEC1...`,
                                    ; dropping the inner `I6String12LocalBindingE`.
                                    ; Re-plan via plan_type# in this case so the
                                    ; current substitutions (K → String, V →
                                    ; LocalBinding) drive the inner mangling.
                                    var canon_gens_inst Vector[PlannedType]^rp(g.length)
                                    var ggi: size_t 0
                                    while ggi < g.length
                                    {
                                        let gp_ptr g.get ggi
                                        if gp_ptr <> null
                                        {
                                            let gp (*gp_ptr)
                                            var need_replan: bool false
                                            if gp.mangled_name.get_length() = 0
                                                set need_replan: true
                                            if gp.generics = null
                                            {
                                                if t.generics <> null
                                                {
                                                    let mg_check (*t.generics)
                                                    if ggi < mg_check.length
                                                    {
                                                        let mp_check_ptr mg_check.get ggi
                                                        if mp_check_ptr <> null
                                                        {
                                                            if mp_check_ptr.generics <> null
                                                                set need_replan: true
                                                        }
                                                    }
                                                }
                                            }
                                            if need_replan = false
                                                canon_gens_inst.put(ggi, gp)
                                            if need_replan
                                            {
                                                if t.generics <> null
                                                {
                                                    let mg (*t.generics)
                                                    if ggi < mg.length
                                                    {
                                                        let mp_ptr mg.get ggi
                                                        if mp_ptr <> null
                                                        {
                                                            let mp (*mp_ptr)
                                                            let cgi this.plan_type#(mp)
                                                            canon_gens_inst.put(ggi, cgi)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        set ggi: ggi + 1
                                    }

                                    ; s109: preserve the call-site lifetime
                                    ; (^page / $ / #) on the specialised
                                    ; PlannedType. instantiate_generic#
                                    ; returns Lifetime.Unspecified by
                                    ; default; without overlaying the
                                    ; original after_subst.life,
                                    ; `Container[int]^page_ptr(...)` loses
                                    ; the page-pointer arg at the ctor
                                    ; call site (`<null operand!>`).
                                    let inst this.instantiate_generic#(canonical_name, canon_gens_inst, after_subst.loc)
                                    return PlannedType(
                                        inst.loc,
                                        inst.name,
                                        inst.mangled_name,
                                        inst.generics,
                                        after_subst.life,
                                        after_subst.origin,
                                        after_subst.array_size,
                                        after_subst.variable
                                    )
                                }
                            }
                        }
                }
            }

            let mangled Planner.mangle_structure#(canonical_name, after_subst.generics)
            PlannedType(
                after_subst.loc,
                canonical_name,
                mangled,
                after_subst.generics,
                after_subst.life,
                after_subst.origin,
                after_subst.array_size,
                after_subst.variable
            )
        }

        ; ================================================================
        ; plan_item: Model.Item → PlannedItem.
        ;
        ; Handles the optional name and type annotation. Attributes are
        ; dropped for now — the PlannedItem carries `null` in that slot
        ; until attribute planning is ported.
        ;
        ; Returns-by-value copies the PlannedItem to the caller; the refs
        ; inside (name, item_type) point into single-element holder Vectors
        ; allocated on this function's rp, so they survive the caller's
        ; use of the returned PlannedItem.
        ; ================================================================
        function plan_item#(rp, this: Planner, i: Item) returns PlannedItem
        {
            var planned_name: ref[String]? null
            if i.name <> null
            {
                let n (*i.name)
                var name_holder Vector[String]^rp(1)
                name_holder.put(0, String^rp(n))
                set planned_name: name_holder.get(0)
            }

            var planned_type: ref[PlannedType]? null
            if i.type <> null
            {
                let model_type (*i.type)
                let planned this.plan_type#(model_type)
                var type_holder Vector[PlannedType]^rp(1)
                type_holder.put(0, planned)
                set planned_type: type_holder.get(0)
            }

            PlannedItem(
                i.span,
                i.private_,
                planned_name,
                planned_type,
                null
            )
        }

        ; plan_items: batch version of plan_item over a Vector[Item].
        ; Pre-allocates the result Vector at the correct size so we can
        ; use `put(i, ...)` instead of Array.add + copy.
        function plan_items#(rp, this: Planner, items: Vector[Item]) returns Vector[PlannedItem]
        {
            var result Vector[PlannedItem]^rp(items.length)
            var i: size_t 0
            while i < items.length
            {
                let item_ptr items.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    let pl this.plan_item#(item)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; plan_constant_operand: wrap a Constant literal as a PlannedOperand
        ; with its inferred type populated. The result_type is whatever
        ; infer_constant_type says at pre-solver time (e.g. IntegerConstant
        ; → "int", StringConstant → pointer[i8]).
        function plan_constant_operand#(
            rp,
            this: Planner,
            c: Constant,
            loc: Span
        ) returns PlannedOperand
        {
            let ty Planner.infer_constant_type#(c)
            PlannedOperand(
                loc,
                PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant c),
                null,
                ty
            )
        }

        ; ================================================================
        ; Simple Expression planners.
        ; ================================================================

        ; plan_sizeof: SizeOf(type) → PlannedSizeOf with computed byte
        ; size. get_primitive_alignment doubles as size for primitives
        ; but returns the catch-all 8 for any non-primitive — wrong for
        ; struct types like Module (80 B). Look the Concept up in the
        ; registry (set up during plan_program's namespace walk, before
        ; generic instantiation runs) and compute the size from its
        ; Model.Property list. Each property's contribution is either a
        ; primitive byte size or a hardcoded stdlib-container shape:
        ; Vector = 16 (length + data), String/HashMap = 8 (single ptr).
        ; That gives Module = 1 (bool) + 7 (pad) + 2*8 + 3*16 + 8 = 80,
        ; matching the LLVM struct layout. Without this, Vector#(rp,len)
        ; for Vector[Module] allocates len*8 instead of len*80, and
        ; put(i, m) overruns and SEGVs build_program.
        function plan_sizeof#(rp, this: Planner, s: SizeOf) returns PlannedSizeOf
        {
            let sized this.plan_type#(s.type)
            ; Delegate to compute_payload_size, which sizes primitives,
            ; the stdlib container shapes (Vector/Array/String/HashMap/...),
            ; Structures (recursing into each field) AND Unions (tag + max
            ; variant payload). The earlier inline Structure arm here sized
            ; each field via get_primitive_alignment, which returns the
            ; default 8 for a nested struct/union-typed field — so e.g.
            ; OperandSyntax (start+end+expression:ExpressionSyntax(232B)+
            ; postfixes) came out 32 not 256, and Vector[OperandSyntax].add
            ; under-allocated 32 bytes/element, truncating every operand's
            ; embedded expression to its first 16 bytes. compute_payload_size
            ; recurses, so nested struct/union fields are sized correctly.
            let size this.compute_payload_size(sized.name)
            PlannedSizeOf(s.span, sized, size)
        }

        ; plan_is: Is(name) is a runtime variant-tag test. At this site
        ; we resolve the test type and (best-effort) the union_name; the
        ; `variant_tag` and `value` fields get stitched in at the
        ; operand-sequence collapse site, which has the value operand.
        function plan_is#(rp, this: Planner, i: Is) returns PlannedIs
        {
            ; `x is null` — single-segment "null" name. Skip type
            ; resolution; the emitter compares the pointer to zero.
            if i.name.length = 1
            {
                let first_ptr i.name.get 0
                if first_ptr <> null
                {
                    if (*first_ptr).equals(String$("null"))
                        return PlannedIs(
                            i.span,
                            Planner.make_void_type#(),
                            0,
                            String^rp(""),
                            null,
                            true
                        )
                }
            }

            ; Resolve the dotted path as a Type so nested variant names
            ; like Option.Some pick up the full planned type. The
            ; variant_tag itself is filled in by the call site that
            ; pairs a PlannedIs with its value operand (needs the
            ; operand's union type, which plan_is doesn't see).
            let ty_path Vector[String]^rp(i.name)
            let ty Type(i.span, ty_path, null, Lifetime.Unspecified(Unspecified()))
            let test_type this.plan_type#(ty)
            let union_name Planner.join_dotted_name#(i.name)

            PlannedIs(
                i.span,
                test_type,
                0,
                union_name,
                null,
                false
            )
        }

        ; plan_as: `x as TargetType` — explicit cast. Resolves the
        ; target type; the value operand is stitched in at the use site
        ; (typically during collapse, like PlannedIs).
        function plan_as#(rp, this: Planner, a: scaly.compiler.Model.As) returns PlannedAs
        {
            let target this.plan_type#(a.target_type)
            PlannedAs(a.span, target, null)
        }

        ; plan_alignof: alignof(Type) → size_t. Mirrors plan_sizeof.
        ; s106: take the alignment from get_primitive_alignment instead
        ; of hardcoding 0. Without this, every `alignof T` lowers to a
        ; literal 0 — observed first as init_lifetime's
        ; `page.allocate(sizeof int, alignof int)` passing align=0.
        function plan_alignof#(
            rp,
            this: Planner,
            a: scaly.compiler.Model.AlignOf
        ) returns PlannedAlignOf
        {
            let planned this.plan_type#(a.type)
            let align Planner.get_primitive_alignment(planned.name)
            PlannedAlignOf(a.span, planned, align)
        }

        ; plan_type_operand: a Model.Type used as an operand can mean
        ; different things depending on whether the name resolves to:
        ;   - a local variable in scope → PlannedVariable with its type
        ;   - a top-level function name → keep as Type, result is a
        ;     function reference (return-type filled in later during
        ;     call resolution)
        ;   - an actual type name → PlannedExpression.Type with the
        ;     planned type
        function plan_type_operand#(rp, this: Planner, t: Type, loc: Span) returns PlannedOperand
        {
            ; Single-name references are candidates for local-variable
            ; resolution. Dotted names always go to plan_type.
            if t.name.length = 1
            {
                let n_ptr t.name.get 0
                if n_ptr <> null
                {
                    let name (*n_ptr)

                    ; Bare null/true/false at expression position parse as
                    ; Type names; rewrite them as Constant operands so the
                    ; emitter sees the right shape. Mirrors
                    ; Planner.cpp:10148-10160.
                    if name.equals(String$("null"))
                    {
                        let c Constant.Null(NullConstant loc)
                        return this.plan_constant_operand#(c, loc)
                    }
                    if name.equals(String$("true"))
                    {
                        let c Constant.Boolean(BooleanConstant(loc, true))
                        return this.plan_constant_operand#(c, loc)
                    }
                    if name.equals(String$("false"))
                    {
                        let c Constant.Boolean(BooleanConstant(loc, false))
                        return this.plan_constant_operand#(c, loc)
                    }

                    ; Local variable lookup.
                    let local this.lookup_local_binding(name)
                    if local <> null
                    {
                        let lb (*local)
                        return PlannedOperand(
                            loc,
                            PlannedExpression.Variable(PlannedVariable(
                                loc, name, lb.binding_type, lb.is_mutable
                            )),
                            null,
                            lb.binding_type
                        )
                    }

                    ; s88: sibling-global constant-fold. `define X: int K`
                    ; references like F_OK / SEEK_END must resolve to
                    ; their value or every caller silently drops the
                    ; whole statement (plan_type_operand# returning
                    ; PlannedExpression.Type → emit_call ignores it →
                    ; trailing `f(.., NAME) = K` becomes a no-op so the
                    ; function body emits only the default return).
                    ; Mirrors Planner.cpp:6950-6995. Single scalar
                    ; PlannedConstant inlines directly; non-constant or
                    ; multi-operand value falls back to PlannedGlobalRef.
                    let g_ref this.lookup_global(name)
                    if g_ref <> null
                    {
                        let g (*g_ref)
                        ; Mutable module globals must LOAD the current value on
                        ; every read — never inline the initializer constant.
                        ; Emit a GlobalRef; emit_global_ref loads it (s189).
                        if g.is_mutable
                            return PlannedOperand(
                                loc,
                                PlannedExpression.GlobalRef(PlannedGlobalRef(
                                    loc,
                                    g.name,
                                    g.mangled_name,
                                    g.global_type
                                )),
                                null,
                                g.global_type
                            )
                        if g.value <> null
                        {
                            let val_vec (*g.value)
                            if val_vec.length = 1
                            {
                                let v_ptr val_vec.get 0
                                if v_ptr <> null
                                {
                                    let v (*v_ptr)
                                    choose v.expr
                                        when c: scalyc.compiler.Plan.PlannedConstant
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Constant c,
                                                null,
                                                g.global_type
                                            )
                                        else
                                        {
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.GlobalRef(PlannedGlobalRef(
                                                    loc,
                                                    g.name,
                                                    g.mangled_name,
                                                    g.global_type
                                                )),
                                                null,
                                                g.global_type
                                            )
                                        }
                                }
                            }
                        }
                        return PlannedOperand(
                            loc,
                            PlannedExpression.GlobalRef(PlannedGlobalRef(
                                loc,
                                g.name,
                                g.mangled_name,
                                g.global_type
                            )),
                            null,
                            g.global_type
                        )
                    }

                    ; Implicit property access: when `name` matches a
                    ; field on T and `this: pointer[T]` is in scope,
                    ; rewrite as Variable("this") + member_access [name].
                    ; Mirrors Planner.cpp:7055-7097. Strings used in the
                    ; returned operand must live on rp, not the local
                    ; page — otherwise their data is freed when the
                    ; function returns.
                    let this_ref this.lookup_local(String#("this"))
                    if this_ref <> null
                    {
                        let this_ty (*this_ref)
                        if this_ty.name.equals(String$("pointer"))
                        {
                            if this_ty.generics <> null
                            {
                                let gens (*this_ty.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                    {
                                        let inner (*inner_ptr)
                                        let prop_ref this.lookup_property(inner.name, name)
                                        if prop_ref <> null
                                        {
                                            let prop (*prop_ref)
                                            var prop_type: PlannedType this.fresh_type_var#(String#(""))
                                            if prop.type <> null
                                            {
                                                let pt2 (*prop.type)
                                                set prop_type: this.plan_type#(pt2)
                                            }
                                            let idx this.get_property_index(inner.name, name)
                                            var ma_arr Array[PlannedMemberAccess]^rp()
                                            ma_arr.add(PlannedMemberAccess(
                                                name, idx as size_t, false, false,
                                                inner, prop_type
                                            ))
                                            var ma_holder Vector[PlannedMemberAccess]^rp(ma_arr)
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, String#("this"), this_ty, false
                                                )),
                                                &ma_holder,
                                                prop_type
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; Multi-element name: if the first segment is a local binding,
            ; treat the rest as a member-access chain. Mirrors
            ; Planner.cpp:6805-6826. Skip when the chain contains any
            ; method hop — stage-1's call resolution doesn't yet wire
            ; instance method dispatch, and forcing this path would
            ; surface emit_call SEGVs on the receiver.
            if t.name.length > 1
            {
                let first_ptr t.name.get 0
                if first_ptr <> null
                {
                    let first_name (*first_ptr)
                    let local this.lookup_local_binding(first_name)
                    if local <> null
                    {
                        let lb (*local)
                        var rest_arr Array[String]$()
                        var k: size_t 1
                        while k < t.name.length
                        {
                            let seg_ptr t.name.get k
                            if seg_ptr <> null
                                rest_arr.add((*seg_ptr))
                            set k: k + 1
                        }
                        var rest_vec Vector[String]^rp(rest_arr)
                        ; Auto-deref pointer[T] / ref[T]: use the inner
                        ; generic as the base for member resolution.
                        var base_for_chain lb.binding_type
                        if lb.binding_type.name.equals(String$("pointer"))
                        {
                            if lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                if g.length > 0
                                {
                                    let ip g.get 0
                                    if ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        if lb.binding_type.name.equals(String$("ref"))
                        {
                            if lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                if g.length > 0
                                {
                                    let ip g.get 0
                                    if ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        let access_chain this.resolve_member_access#(
                            base_for_chain, rest_vec
                        )
                        var has_method: bool false
                        var ci: size_t 0
                        while ci < access_chain.length
                        {
                            let mp access_chain.get ci
                            if mp <> null
                            {
                                if (*mp).is_method
                                    set has_method: true
                            }
                            set ci: ci + 1
                        }
                        if has_method = false
                        {
                            var access_holder Vector[PlannedMemberAccess]^rp(access_chain)
                            var final_type lb.binding_type
                            if access_chain.length > 0
                            {
                                let last_ptr access_chain.get(access_chain.length - 1)
                                if last_ptr <> null
                                    set final_type: (*last_ptr).result_type
                            }
                            return PlannedOperand(
                                loc,
                                PlannedExpression.Variable(PlannedVariable(
                                    loc, first_name, lb.binding_type, lb.is_mutable
                                )),
                                &access_holder,
                                final_type
                            )
                        }

                        ; Trailing-method chain on a local (e.g.
                        ; `o.inner.val()`): the chain has one or more
                        ; field hops followed by a method hop. Return the
                        ; Variable operand carrying the FULL chain so
                        ; collapse_operand_sequence#'s method-on-chain
                        ; dispatch (s83) truncates to the receiver
                        ; (last_acc.parent_type) and resolves the method.
                        ; Restricted to chains longer than one hop — the
                        ; 1-hop `local.method()` case keeps its existing
                        ; dotted-name qualified-call path to avoid
                        ; regressing it. Without this, multi-hop method
                        ; calls fell through to plan_type# (a dotted Type
                        ; operand whose `()` looked like a free call to a
                        ; non-existent function) and the whole call was
                        ; dropped — breaking every `m.members.get(i)` /
                        ; `m.modules.get(i)` loop body in plan_module# and
                        ; register_module_concepts.
                        ; s171: relaxed from `> 1` to `> 0`. A single-hop
                        ; method chain on a local (e.g. parenless
                        ; `name.length`, `sb.get_length`) must also return
                        ; the Variable+chain operand so collapse_operand_
                        ; sequence# can build the call — with a trailing
                        ; Tuple via the s83 method-on-chain dispatch, or
                        ; without one via the s171 parenless-zero-arg path
                        ; (ops.length==1 synthesizes an empty `()` Tuple).
                        ; Previously single-hop fell through to plan_type#
                        ; as a dotted Type "s.length", which the parenless
                        ; case can't resolve, dropping encode_name's
                        ; `let len name.length` and corrupting every mangled
                        ; name. Only local-variable receivers reach here
                        ; (namespaces aren't locals → still take the
                        ; qualified-call path), so rerouting 1-hop method
                        ; calls is safe.
                        if has_method
                        {
                            if access_chain.length > 0
                            {
                                let last_ptr access_chain.get(access_chain.length - 1)
                                if last_ptr <> null
                                {
                                    if (*last_ptr).is_method
                                    {
                                        var access_holder_m Vector[PlannedMemberAccess]^rp(access_chain)
                                        let final_type_m (*last_ptr).result_type
                                        return PlannedOperand(
                                            loc,
                                            PlannedExpression.Variable(PlannedVariable(
                                                loc, first_name, lb.binding_type, lb.is_mutable
                                            )),
                                            &access_holder_m,
                                            final_type_m
                                        )
                                    }
                                }
                            }
                        }
                    }

                    ; Implicit-this multi-segment fallback: when first_name
                    ; matches a property of T (where this: pointer[T]),
                    ; build a chain starting from `this` with all segments
                    ; resolved against T. Mirrors Planner.cpp:7055-7097 +
                    ; chain-building from 6805-6826. Skip when the chain
                    ; contains any method hop — same constraint as the
                    ; local-binding branch above.
                    let this_ref2 this.lookup_local(String#("this"))
                    if this_ref2 <> null
                    {
                        let this_ty2 (*this_ref2)
                        if this_ty2.name.equals(String$("pointer"))
                        {
                            if this_ty2.generics <> null
                            {
                                let gens2 (*this_ty2.generics)
                                if gens2.length > 0
                                {
                                    let inner_ptr2 gens2.get 0
                                    if inner_ptr2 <> null
                                    {
                                        let inner2 (*inner_ptr2)
                                        let prop_ref2 this.lookup_property(inner2.name, first_name)
                                        if prop_ref2 <> null
                                        {
                                            var all_arr Array[String]$()
                                            var k2: size_t 0
                                            while k2 < t.name.length
                                            {
                                                let sp t.name.get k2
                                                if sp <> null
                                                    all_arr.add((*sp))
                                                set k2: k2 + 1
                                            }
                                            var all_vec Vector[String]^rp(all_arr)
                                            let chain2 this.resolve_member_access#(inner2, all_vec)
                                            ; s87: skip removed (was `var has_method2 / while /
                                            ; if has_method2 = false` wrapper preserved through
                                            ; s83-s86). With s87's emit_variable struct/ptr-alloca
                                            ; fix and s86's heap-copy in MemberAssignment, the
                                            ; method-on-chain dispatch now works at runtime.
                                            var holder2 Vector[PlannedMemberAccess]^rp(chain2)
                                            var ft2 inner2
                                            if chain2.length > 0
                                            {
                                                let lp2 chain2.get(chain2.length - 1)
                                                if lp2 <> null
                                                    set ft2: (*lp2).result_type
                                            }
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, String#("this"), this_ty2, false
                                                )),
                                                &holder2,
                                                ft2
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            let pt this.plan_type#(t)
            PlannedOperand(
                loc,
                PlannedExpression.Type pt,
                null,
                pt
            )
        }

        ; ================================================================
        ; Control-flow planners.
        ; ================================================================

        ; statement_result_type: extract the PlannedType produced by a
        ; statement used as an expression. Covers the Action case (the
        ; common `if cond x else y` shape); non-value statements
        ; (Return/Throw/Break/Continue/Binding) return void.
        function statement_result_type(s: PlannedStatement) returns PlannedType
        {
            choose s
                when a: PlannedAction
                    a.result_type
                else
                    Planner.make_void_type#()
        }

        ; plan_if: plans the condition (a Vector[Operand]), the consequent
        ; statement, and optionally the alternative. Emits a bool
        ; constraint on the condition and (when an alternative exists)
        ; unifies the two branches' result types.
        function plan_if#(rp, this: Planner, f: If) returns PlannedIf
        {
            let planned_cond_flat this.plan_operands#(f.condition)
            let planned_cond_collapsed this.collapse_operand_sequence#(planned_cond_flat)
            let bool_ty Planner.make_bool_type#()
            this.add_equality_constraint(bool_ty, planned_cond_collapsed.result_type, f.span)

            let planned_consequent this.plan_statement#(f.consequent)
            var consequent_holder Vector[PlannedStatement]^rp(1)
            consequent_holder.put(0, planned_consequent)

            var alternative_ref: ref[PlannedStatement]? null
            if f.alternative <> null
            {
                let alt (*f.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)

                ; Unify the consequent and alternative result types so an
                ; `if` used as an expression has a single type. Skips
                ; voids (pure statements contribute no constraint).
                let cons_ty Planner.statement_result_type(planned_consequent)
                let alt_ty Planner.statement_result_type(planned_alt)
                if cons_ty.name.equals(String$("void")) = false
                    and alt_ty.name.equals(String$("void")) = false
                    this.add_equality_constraint(cons_ty, alt_ty, f.span)
            }

            var cond_holder Vector[PlannedOperand]^rp(1)
            cond_holder.put(0, planned_cond_collapsed)
            PlannedIf(
                f.span,
                &cond_holder,
                null,
                consequent_holder.get 0,
                alternative_ref
            )
        }

        ; plan_lambda: anonymous function literal. Opens a fresh scope,
        ; seeds each parameter with a fresh type variable (lambdas omit
        ; parameter type annotations), plans the body Action, and
        ; synthesizes a unique mangled name. Captures are the set of
        ; variable names referenced in the body that aren't lambda
        ; parameters — a best-effort over-approximation (inner bindings
        ; may leak in) that the emitter can intersect with the real
        ; outer scope.
        ; collect_free_names: walk a PlannedOperand's expression tree
        ; and accumulate the names of every PlannedVariable reference
        ; encountered. Recurses into Call args, Tuple components, and
        ; If/Match/Block/Choose sub-statements. Used by plan_lambda's
        ; capture-discovery pass — captures are this set minus any
        ; lambda-local names (params + inner bindings).
        function collect_free_names(
            this: Planner,
            op: PlannedOperand,
            acc: Array[String]
        )
        {
            choose op.expr
                when v: PlannedVariable
                    acc.add v.name
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                                this.collect_free_names((*a_ptr), acc)
                            set i: i + 1
                        }
                    }
                    0
                }
                when tup: PlannedTuple
                {
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                if c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get j
                                        if v_ptr <> null
                                            this.collect_free_names((*v_ptr), acc)
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0
        }

        ; Recursive lambda-body name walkers used by monomorphize_lambda#'s
        ; capture discovery. Unlike collect_free_names (which only reaches
        ; Variable/Call/Tuple, so a block-bodied lambda's captures were missed
        ; entirely), these recurse through every compound expression and
        ; statement, accumulating into `uses` every PlannedVariable name
        ; referenced and into `bound` every name a body PlannedBinding (or a
        ; for-loop identifier) introduces. A name in `bound` is shadowed by a
        ; body-local binding and is NOT captured — flow-insensitive: any body
        ; binding of a name suppresses its capture (the pathological same-name
        ; use-before-bind, `let n n + 1` over an enclosing `n`, is unsupported).
        function collect_lambda_names_ops(this: Planner, ops_ref: ref[Vector[PlannedOperand]]?, uses: Array[String], bound: Array[String])
        {
            if ops_ref = null
                return
            let ops (*ops_ref)
            var i: size_t 0
            while i < ops.length
            {
                let p ops.get i
                if p <> null
                    this.collect_lambda_names((*p), uses, bound)
                set i: i + 1
            }
        }

        function collect_lambda_names_action(this: Planner, act: PlannedAction, uses: Array[String], bound: Array[String])
        {
            this.collect_lambda_names_ops(act.source, uses, bound)
            this.collect_lambda_names_ops(act.target, uses, bound)
        }

        function collect_lambda_names_stmt(this: Planner, stmt: PlannedStatement, uses: Array[String], bound: Array[String])
        {
            choose stmt
                when a: PlannedAction
                    this.collect_lambda_names_action(a, uses, bound)
                when b: PlannedBinding
                {
                    if b.binding_item.name <> null
                        bound.add (*b.binding_item.name)
                    this.collect_lambda_names_ops(b.operation, uses, bound)
                }
                when r: PlannedReturn
                    this.collect_lambda_names_ops(r.result, uses, bound)
                when th: PlannedThrow
                    this.collect_lambda_names_ops(th.result, uses, bound)
                when brk: PlannedBreak
                    this.collect_lambda_names_ops(brk.result, uses, bound)
                else
                    0
        }

        function collect_lambda_names_stmts(this: Planner, stmts_ref: ref[Vector[PlannedStatement]]?, uses: Array[String], bound: Array[String])
        {
            if stmts_ref = null
                return
            let stmts (*stmts_ref)
            var i: size_t 0
            while i < stmts.length
            {
                let p stmts.get i
                if p <> null
                    this.collect_lambda_names_stmt((*p), uses, bound)
                set i: i + 1
            }
        }

        function collect_lambda_names_stmt_opt(this: Planner, stmt_ref: ref[PlannedStatement]?, uses: Array[String], bound: Array[String])
        {
            if stmt_ref = null
                return
            this.collect_lambda_names_stmt((*stmt_ref), uses, bound)
        }

        function collect_lambda_names(this: Planner, op: PlannedOperand, uses: Array[String], bound: Array[String])
        {
            choose op.expr
                when v: PlannedVariable
                    uses.add v.name
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                                this.collect_lambda_names((*a_ptr), uses, bound)
                            set i: i + 1
                        }
                    }
                    0
                }
                when tup: PlannedTuple
                {
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                this.collect_lambda_names_ops(c.value, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                when blk: PlannedBlock
                {
                    this.collect_lambda_names_stmts(blk.statements, uses, bound)
                    0
                }
                when iff: PlannedIf
                {
                    this.collect_lambda_names_ops(iff.condition, uses, bound)
                    this.collect_lambda_names_stmt_opt(iff.consequent, uses, bound)
                    this.collect_lambda_names_stmt_opt(iff.alternative, uses, bound)
                    0
                }
                when ch: PlannedChoose
                {
                    this.collect_lambda_names_ops(ch.condition, uses, bound)
                    if ch.cases <> null
                    {
                        let whens (*ch.cases)
                        var i: size_t 0
                        while i < whens.length
                        {
                            let w_ptr whens.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                if w.name.get_length() > 0
                                    bound.add w.name
                                this.collect_lambda_names_stmt_opt(w.consequent, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    this.collect_lambda_names_stmt_opt(ch.alternative, uses, bound)
                    0
                }
                when mt: PlannedMatch
                {
                    this.collect_lambda_names_ops(mt.condition, uses, bound)
                    if mt.branches <> null
                    {
                        let brs (*mt.branches)
                        var i: size_t 0
                        while i < brs.length
                        {
                            let b_ptr brs.get i
                            if b_ptr <> null
                            {
                                let br (*b_ptr)
                                if br.cases <> null
                                {
                                    let cs (*br.cases)
                                    var j: size_t 0
                                    while j < cs.length
                                    {
                                        let cp cs.get j
                                        if cp <> null
                                            this.collect_lambda_names_ops((*cp).condition, uses, bound)
                                        set j: j + 1
                                    }
                                }
                                this.collect_lambda_names_stmt_opt(br.consequent, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    this.collect_lambda_names_stmt_opt(mt.alternative, uses, bound)
                    0
                }
                when fr: PlannedFor
                {
                    this.collect_lambda_names_ops(fr.expr, uses, bound)
                    if fr.identifier.get_length() > 0
                        bound.add fr.identifier
                    this.collect_lambda_names_action(fr.body, uses, bound)
                    0
                }
                when wh: PlannedWhile
                {
                    if wh.cond.binding_item.name <> null
                        bound.add (*wh.cond.binding_item.name)
                    this.collect_lambda_names_ops(wh.cond.operation, uses, bound)
                    this.collect_lambda_names_action(wh.body, uses, bound)
                    0
                }
                when rp: PlannedRepeat
                {
                    this.collect_lambda_names_action(rp.body, uses, bound)
                    0
                }
                when as_e: scalyc.compiler.Plan.PlannedAs
                {
                    if as_e.value <> null
                        this.collect_lambda_names((*as_e.value), uses, bound)
                    0
                }
                when is_e: scalyc.compiler.Plan.PlannedIs
                {
                    if is_e.value <> null
                        this.collect_lambda_names((*is_e.value), uses, bound)
                    0
                }
                when tr: PlannedTry
                {
                    this.collect_lambda_names_ops(tr.cond.operation, uses, bound)
                    if tr.catches <> null
                    {
                        let cats (*tr.catches)
                        var i: size_t 0
                        while i < cats.length
                        {
                            let w_ptr cats.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                if w.name.get_length() > 0
                                    bound.add w.name
                                this.collect_lambda_names_stmt_opt(w.consequent, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    this.collect_lambda_names_stmt_opt(tr.alternative, uses, bound)
                    0
                }
                else
                    0
        }

        function plan_lambda#(rp, this: Planner, lam: Lambda) returns PlannedLambda
        {
            this.push_scope()

            var planned_items Vector[PlannedItem]^rp(lam.input.length)
            var i: size_t 0
            while i < lam.input.length
            {
                let it_ptr lam.input.get i
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    let pi this.plan_item#(it)
                    planned_items.put(i, pi)

                    var param_type: PlannedType Planner.make_void_type#()
                    if pi.item_type <> null
                        set param_type: (*pi.item_type)
                    if pi.item_type = null
                    {
                        ; Lambda parameters omit type annotations; give
                        ; each a fresh type variable that the solver
                        ; later unifies against the call site.
                        var pname: String String$("")
                        if it.name <> null
                            set pname: (*it.name)
                        set param_type: this.fresh_type_var#(pname)
                    }

                    if it.name <> null
                    {
                        let n (*it.name)
                        this.define_parameter(n, param_type)
                    }
                }
                set i: i + 1
            }

            let planned_body this.plan_action#(lam.body)

            ; Capture discovery: walk the body operands collecting all
            ; variable-name references, then filter out names that match
            ; one of the lambda's own parameters. The remainder is the
            ; captures set (best-effort: inner bindings declared inside
            ; the body can leak in, but it's a safe over-approximation
            ; that the emitter can intersect with the real scope).
            var free_names Array[String]$()
            if planned_body.source <> null
            {
                let src (*planned_body.source)
                var si: size_t 0
                while si < src.length
                {
                    let s_ptr src.get si
                    if s_ptr <> null
                        this.collect_free_names((*s_ptr), free_names)
                    set si: si + 1
                }
            }

            var captures_arr Array[String]$()
            var fi: size_t 0
            while fi < free_names.length
            {
                let nm_ptr free_names.get fi
                if nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    var is_param: bool false
                    var pj: size_t 0
                    while pj < lam.input.length
                    {
                        let p_ptr lam.input.get pj
                        if p_ptr <> null
                        {
                            if p_ptr.name <> null
                            {
                                let pn (*p_ptr.name)
                                if pn.equals(nm)
                                    set is_param: true
                            }
                        }
                        set pj: pj + 1
                    }
                    var already: bool false
                    var di: size_t 0
                    while di < captures_arr.length
                    {
                        let d_ptr captures_arr.get di
                        if d_ptr <> null
                        {
                            if (*d_ptr).equals(nm)
                                set already: true
                        }
                        set di: di + 1
                    }
                    if is_param = false and already = false
                        captures_arr.add(String^rp(nm))
                }
                set fi: fi + 1
            }

            this.pop_scope()

            let lam_id next_lambda_id
            set next_lambda_id: lam_id + 1
            var name_sb StringBuilder^rp()
            name_sb.append "_ZN6lambda"
            name_sb.append(Planner.size_to_string lam_id)
            name_sb.append "Ev"
            let mangled name_sb.to_string^rp()

            var items_holder Vector[PlannedItem]^rp(planned_items)
            var captures_holder Vector[String]^rp(captures_arr)
            var captures_ref: ref[Vector[String]]? null
            if captures_holder.length > 0
                set captures_ref: &captures_holder

            PlannedLambda(
                lam.span,
                mangled,
                &items_holder,
                planned_body,
                planned_body.result_type,
                captures_ref
            )
        }

        ; Phase-1 lambda monomorphization: given a lambda model and the
        ; call-site argument types, synthesize (and record, once) a concrete
        ; top-level function whose parameters take those arg types, plan its
        ; body, and return the function's mangled name. The call site then
        ; resolves to a direct call to this function (see the lambda-call
        ; intercept in collapse_operand_sequence#). Cached per mangled name
        ; via has_recorded_function so repeated calls with identical arg
        ; types reuse the same function.
        function monomorphize_lambda#(rp, this: Planner, base_name: String, lam: Lambda, arg_types: Vector[PlannedType]) returns LambdaMonoResult
        {
            ; ---- Pass 1: discover captures. Plan the body in a scope with the
            ; lambda's own params defined; the enclosing scope is still on the
            ; stack so a captured `n` resolves there. A captured name is a free
            ; variable that, AFTER popping (params + body-locals gone), still
            ; resolves via lookup_local_binding — i.e. it lives in an enclosing
            ; scope. Captures become leading parameters; the call site passes
            ; the captured VALUES as leading args (capture by value).
            this.push_scope()
            var pnames Array[String]$()
            var p1i: size_t 0
            while p1i < lam.input.length
            {
                let it_ptr lam.input.get p1i
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    var pty1: PlannedType this.fresh_type_var#(String$(""))
                    if p1i < arg_types.length
                    {
                        let at_ptr arg_types.get p1i
                        if at_ptr <> null
                            set pty1: (*at_ptr)
                    }
                    if it.name <> null
                    {
                        let pn (*it.name)
                        pnames.add(String^rp(pn))
                        this.define_parameter(pn, pty1)
                    }
                }
                set p1i: p1i + 1
            }
            let body1 this.plan_action#(lam.body)
            var free Array[String]$()
            var body_bound Array[String]$()
            this.collect_lambda_names_ops(body1.source, free, body_bound)
            this.collect_lambda_names_ops(body1.target, free, body_bound)
            this.pop_scope()

            var cap_names Array[String]$()
            var cap_types Array[PlannedType]$()
            var fi: size_t 0
            while fi < free.length
            {
                let nm_ptr free.get fi
                if nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    var is_param: bool false
                    var pj: size_t 0
                    while pj < pnames.length
                    {
                        let pn_ptr pnames.get pj
                        if pn_ptr <> null
                            if (*pn_ptr).equals(nm)
                                set is_param: true
                        set pj: pj + 1
                    }
                    var already: bool false
                    var dj: size_t 0
                    while dj < cap_names.length
                    {
                        let d_ptr cap_names.get dj
                        if d_ptr <> null
                            if (*d_ptr).equals(nm)
                                set already: true
                        set dj: dj + 1
                    }
                    ; A name bound by a body-local let/var/for/when shadows the
                    ; enclosing one — it is the local, not a capture.
                    var is_shadowed: bool false
                    var bk: size_t 0
                    while bk < body_bound.length
                    {
                        let bn_ptr body_bound.get bk
                        if bn_ptr <> null
                            if (*bn_ptr).equals(nm)
                                set is_shadowed: true
                        set bk: bk + 1
                    }
                    if is_param = false
                        if already = false
                            if is_shadowed = false
                            {
                                let lb this.lookup_local_binding(nm)
                                if lb <> null
                                {
                                    cap_names.add(String^rp(nm))
                                    cap_types.add((*lb).binding_type)
                                }
                            }
                }
                set fi: fi + 1
            }

            ; ---- mangled name = base + capture type mangles + arg type mangles
            var ml_sb StringBuilder^rp()
            ml_sb.append "_ZN6lambdaN"
            ml_sb.append base_name
            ml_sb.append "E"
            var cmi: size_t 0
            while cmi < cap_types.length
            {
                let ct_ptr cap_types.get cmi
                if ct_ptr <> null
                {
                    let ct (*ct_ptr)
                    ml_sb.append "_c"
                    if ct.mangled_name.get_length() > 0
                        ml_sb.append ct.mangled_name
                    else
                        ml_sb.append ct.name
                }
                set cmi: cmi + 1
            }
            var mi: size_t 0
            while mi < arg_types.length
            {
                let mat_ptr arg_types.get mi
                if mat_ptr <> null
                {
                    let mat (*mat_ptr)
                    ml_sb.append "_"
                    if mat.mangled_name.get_length() > 0
                        ml_sb.append mat.mangled_name
                    else
                        ml_sb.append mat.name
                }
                set mi: mi + 1
            }
            ml_sb.append "Ev"
            let mangled ml_sb.to_string^rp()

            var caps_holder Vector[String]^rp(cap_names)
            var caps_ref: ref[Vector[String]]? null
            if caps_holder.length > 0
                set caps_ref: &caps_holder

            ; Already synthesized for this (captures, arg types) — reuse.
            if this.has_recorded_function(mangled)
                return LambdaMonoResult(mangled, caps_ref)

            ; ---- Pass 2: plan with captures + params as parameters.
            this.push_scope()
            var item_arr Array[PlannedItem]$()
            var ci: size_t 0
            while ci < cap_names.length
            {
                let cn_ptr cap_names.get ci
                let ct_ptr cap_types.get ci
                if cn_ptr <> null
                    if ct_ptr <> null
                    {
                        let cn (*cn_ptr)
                        let ct (*ct_ptr)
                        var ct_holder Vector[PlannedType]^rp(1)
                        ct_holder.put(0, ct)
                        var cn_holder Vector[String]^rp(1)
                        cn_holder.put(0, String^rp(cn))
                        this.define_parameter(cn, ct)
                        item_arr.add(PlannedItem(lam.span, false, cn_holder.get(0), ct_holder.get(0), null))
                    }
                set ci: ci + 1
            }
            var pi2: size_t 0
            while pi2 < lam.input.length
            {
                let it_ptr lam.input.get pi2
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    var pty: PlannedType this.fresh_type_var#(String$(""))
                    if pi2 < arg_types.length
                    {
                        let at_ptr arg_types.get pi2
                        if at_ptr <> null
                            set pty: (*at_ptr)
                    }
                    var pty_holder Vector[PlannedType]^rp(1)
                    pty_holder.put(0, pty)
                    var pname_ref: ref[String]? null
                    if it.name <> null
                    {
                        let pn (*it.name)
                        var name_holder Vector[String]^rp(1)
                        name_holder.put(0, String^rp(pn))
                        set pname_ref: name_holder.get(0)
                        this.define_parameter(pn, pty)
                    }
                    item_arr.add(PlannedItem(it.span, false, pname_ref, pty_holder.get(0), null))
                }
                set pi2: pi2 + 1
            }
            let planned_body this.plan_action#(lam.body)
            this.pop_scope()

            var items_holder Vector[PlannedItem]^rp(item_arr)
            var rt_holder Vector[PlannedType]^rp(1)
            rt_holder.put(0, planned_body.result_type)
            let synth_fn PlannedFunction(
                lam.span,
                false,
                false,
                mangled,
                mangled,
                null,
                &items_holder,
                rt_holder.get(0),
                null,
                Lifetime.Unspecified(Unspecified()),
                PlannedImplementation.Action(planned_body),
                null,
                false,
                false,
                null,
                this.file
            )
            this.record_function(synth_fn)
            LambdaMonoResult(mangled, caps_ref)
        }

        ; GAP B substep 2: build a closure VALUE for a lambda assigned to a
        ; delegate type. Monomorphizes the real lambda against the delegate's
        ; parameter types (captures become leading params, reused from
        ; monomorphize_lambda#), then packages a PlannedClosure carrying the
        ; real symbol, a generated thunk symbol, the closure record type name,
        ; and the captured VALUES (looked up here, where they are in scope) +
        ; their types. The emitter lowers it to a heap `{ptr thunk, caps...}`
        ; record; the thunk bridges the uniform `R(ptr self, params)` call
        ; shape to `real(caps..., params)`. `life` is the record's allocation
        ; lifetime (local region, or `#` caller page when the closure escapes).
        function make_closure#(rp, this: Planner, base_name: String, lam: Lambda, dparams: Vector[PlannedType], dret: PlannedType, del_pt: PlannedType, life: Lifetime) returns PlannedClosure
        {
            let mono this.monomorphize_lambda#(base_name, lam, dparams)
            var cap_ops Array[PlannedOperand]$()
            var cap_tys Array[PlannedType]$()
            if mono.captures <> null
            {
                let caps (*mono.captures)
                var ci: size_t 0
                while ci < caps.length
                {
                    let cn_ptr caps.get ci
                    if cn_ptr <> null
                    {
                        let cn (*cn_ptr)
                        let lb this.lookup_local_binding(cn)
                        if lb <> null
                        {
                            let cty (*lb).binding_type
                            let cmut (*lb).is_mutable
                            let cvar PlannedVariable(lam.span, String^rp(cn), cty, cmut)
                            let cop PlannedOperand(lam.span, PlannedExpression.Variable cvar, null, cty)
                            cap_ops.add cop
                            cap_tys.add cty
                        }
                    }
                    set ci: ci + 1
                }
            }
            var thunk_sb StringBuilder^rp()
            thunk_sb.append mono.mangled
            thunk_sb.append "_thunk"
            let thunk_name thunk_sb.to_string^rp()
            var clo_sb StringBuilder^rp()
            clo_sb.append "clo_"
            clo_sb.append mono.mangled
            let clo_type_name clo_sb.to_string^rp()
            var cap_ops_holder Vector[PlannedOperand]^rp(cap_ops)
            var cap_tys_holder Vector[PlannedType]^rp(cap_tys)
            var dparams_holder Vector[PlannedType]^rp(dparams)
            PlannedClosure(
                lam.span,
                thunk_name,
                mono.mangled,
                clo_type_name,
                &cap_ops_holder,
                &cap_tys_holder,
                &dparams_holder,
                dret,
                del_pt,
                life
            )
        }

        ; plan_repeat: do-while body runs at least once; the terminating
        ; condition lives inside the body action via `break` or an
        ; embedded if. Nothing else to constrain at this level.
        function plan_repeat#(rp, this: Planner, r: Repeat) returns PlannedRepeat
        {
            this.push_scope()
            let planned_body this.plan_action#(r.action)
            this.pop_scope()
            ; A `repeat` is an infinite loop exiting only via break. Its value
            ; (for `let x repeat { ... break v ... }`) is the type of the first
            ; break-with-value targeting this repeat; void when none.
            let value_type this.find_break_type_in_operands#(planned_body.source)
            PlannedRepeat(r.span, planned_body, r.loop_label, value_type)
        }

        ; Recursive break-value-type finder. Descends through if/choose/match
        ; consequents and nested blocks, but NOT into nested while/for/repeat
        ; bodies (an unlabeled break there targets the inner loop, not this
        ; repeat). Returns void when no break-with-value is found.
        function find_break_type_in_operands#(rp, this: Planner, ops: ref[Vector[PlannedOperand]]?) returns PlannedType
        {
            if ops = null
                return Planner.make_void_type#()
            let v (*ops)
            var i: size_t 0
            while i < v.length
            {
                let op_ptr v.get i
                if op_ptr <> null
                {
                    let t this.find_break_type_in_expr#((*op_ptr).expr)
                    if t.name.equals(String$("void")) = false
                        return t
                }
                set i: i + 1
            }
            Planner.make_void_type#()
        }

        function find_break_type_in_statement#(rp, this: Planner, s: PlannedStatement) returns PlannedType
        {
            choose s
                when br: PlannedBreak
                {
                    if br.result = null
                        return Planner.make_void_type#()
                    let res (*br.result)
                    if res.length = 0
                        return Planner.make_void_type#()
                    let op_ptr res.get 0
                    if op_ptr = null
                        return Planner.make_void_type#()
                    (*op_ptr).result_type
                }
                when a: PlannedAction
                    this.find_break_type_in_operands#(a.source)
                else
                    Planner.make_void_type#()
        }

        function find_break_type_in_stmt_ref#(rp, this: Planner, s: ref[PlannedStatement]?) returns PlannedType
        {
            if s = null
                return Planner.make_void_type#()
            this.find_break_type_in_statement#(*s)
        }

        function find_break_type_in_expr#(rp, this: Planner, e: PlannedExpression) returns PlannedType
        {
            choose e
                when blk: PlannedBlock
                {
                    if blk.statements = null
                        return Planner.make_void_type#()
                    let stmts (*blk.statements)
                    var i: size_t 0
                    while i < stmts.length
                    {
                        let sp stmts.get i
                        if sp <> null
                        {
                            let t this.find_break_type_in_statement#(*sp)
                            if t.name.equals(String$("void")) = false
                                return t
                        }
                        set i: i + 1
                    }
                    Planner.make_void_type#()
                }
                when ife: PlannedIf
                {
                    let tc this.find_break_type_in_stmt_ref#(ife.consequent)
                    if tc.name.equals(String$("void")) = false
                        return tc
                    this.find_break_type_in_stmt_ref#(ife.alternative)
                }
                when ch: PlannedChoose
                {
                    if ch.cases <> null
                    {
                        let cases (*ch.cases)
                        var i: size_t 0
                        while i < cases.length
                        {
                            let cp cases.get i
                            if cp <> null
                            {
                                let t this.find_break_type_in_stmt_ref#((*cp).consequent)
                                if t.name.equals(String$("void")) = false
                                    return t
                            }
                            set i: i + 1
                        }
                    }
                    this.find_break_type_in_stmt_ref#(ch.alternative)
                }
                when mt: PlannedMatch
                {
                    if mt.branches <> null
                    {
                        let brs (*mt.branches)
                        var i: size_t 0
                        while i < brs.length
                        {
                            let bp brs.get i
                            if bp <> null
                            {
                                let t this.find_break_type_in_stmt_ref#((*bp).consequent)
                                if t.name.equals(String$("void")) = false
                                    return t
                            }
                            set i: i + 1
                        }
                    }
                    this.find_break_type_in_stmt_ref#(mt.alternative)
                }
                else
                    Planner.make_void_type#()
        }

        ; plan_while: Binding condition + Action body. The binding opens
        ; a short-lived scope for the loop variable. Emits a constraint
        ; that the planned binding's type is bool (the solver promotes
        ; `while let maybe_x = ...` through Option's None sentinel, so
        ; this is a reasonable approximation today).
        function plan_while#(rp, this: Planner, w: While) returns PlannedWhile
        {
            this.push_scope()
            let planned_cond this.plan_binding#(w.condition)
            let planned_body this.plan_action#(w.action)
            this.pop_scope()

            ; Two shapes reach this point:
            ;   `while cond`          — binding has no name; we constrain
            ;                           its declared type to bool.
            ;   `while let x = opt`   — binding has a name; x takes the
            ;                           Option's Some payload. If the
            ;                           operation's result type is
            ;                           Option[T] we constrain x to T, so
            ;                           the solver sees the unwrapped
            ;                           type.
            let bool_ty Planner.make_bool_type#()
            if planned_cond.binding_item.name = null
            {
                ; Plain `while cond` — bool constraint applies if the
                ; binding's item_type is explicit.
                if planned_cond.binding_item.item_type <> null
                {
                    let bt (*planned_cond.binding_item.item_type)
                    this.add_equality_constraint(bool_ty, bt, w.span)
                }
            }
            if planned_cond.binding_item.name <> null
            {
                if planned_cond.binding_item.item_type <> null
                {
                    if planned_cond.operation <> null
                    {
                        let ops (*planned_cond.operation)
                        if ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            if last_ptr <> null
                            {
                                let op_ty (*last_ptr).result_type
                                if op_ty.name.equals(String$("Option"))
                                {
                                    if op_ty.generics <> null
                                    {
                                        let gens (*op_ty.generics)
                                        if gens.length > 0
                                        {
                                            let payload_ptr gens.get 0
                                            if payload_ptr <> null
                                            {
                                                let bt (*planned_cond.binding_item.item_type)
                                                this.add_equality_constraint(
                                                    bt, (*payload_ptr), w.span
                                                )
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            PlannedWhile(w.span, planned_cond, planned_body, w.loop_label)
        }

        ; plan_for: loop variable bound to each element of `expression`.
        ; Two shapes are supported, matching the C++ Planner:
        ;   1. Integer range: `for i in N` — element type == N's type.
        ;   2. Iterator protocol: `for x in collection` — resolve
        ;      `get_iterator` on the collection type, then `next` on the
        ;      iterator type; the element type is what `next` returns.
        ; Option[T] and ref/pointer wrappers on the collection type are
        ; peeled before the dispatch.
        function plan_for#(rp, this: Planner, f: For) returns PlannedFor
        {
            this.push_scope()
            let planned_expr this.plan_operands#(f.expression)
            let collapsed_expr this.collapse_operand_sequence#(planned_expr)

            var coll_type: PlannedType collapsed_expr.result_type

            ; Auto-unwrap Option[T] → T on the collection side.
            if coll_type.name.equals(String$("Option"))
            {
                if coll_type.generics <> null
                {
                    let gens (*coll_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set coll_type: (*g_ptr)
                    }
                }
            }

            ; Peel ref[T] / pointer[T] to reach the underlying struct.
            ; Stage-1 multi-line `or` chains in a if condition do not
            ; short-circuit correctly (the LF continuation surfaces `set`
            ; as a top-level statement). Mirror the C++ Planner using
            ; per-name guards.
            var iter_type: PlannedType coll_type
            var is_pointer_like: bool false
            if iter_type.name.equals(String$("ref"))
                set is_pointer_like: true
            if iter_type.name.equals(String$("pointer"))
                set is_pointer_like: true
            if is_pointer_like
            {
                if iter_type.generics <> null
                {
                    let gens (*iter_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set iter_type: (*g_ptr)
                    }
                }
            }

            ; Stage-1 multi-line `or` chains do not short-circuit (LF
            ; continuation surfaces `set` as a top-level statement, which
            ; runs unconditionally). Use per-name guards so each one
            ; matches its own primitive name.
            var is_integer: bool false
            if iter_type.name.equals(String$("int"))
                set is_integer: true
            if iter_type.name.equals(String$("int8"))
                set is_integer: true
            if iter_type.name.equals(String$("int16"))
                set is_integer: true
            if iter_type.name.equals(String$("int32"))
                set is_integer: true
            if iter_type.name.equals(String$("int64"))
                set is_integer: true
            if iter_type.name.equals(String$("size_t"))
                set is_integer: true
            if iter_type.name.equals(String$("uint8"))
                set is_integer: true
            if iter_type.name.equals(String$("uint16"))
                set is_integer: true
            if iter_type.name.equals(String$("uint32"))
                set is_integer: true
            if iter_type.name.equals(String$("uint64"))
                set is_integer: true

            var is_iterator_loop: bool false
            var iterator_type: PlannedType Planner.make_void_type#()
            var element_type: PlannedType Planner.make_void_type#()
            var get_iter_name: String String^rp("")
            var next_name: String String^rp("")

            if is_integer
            {
                set element_type: iter_type
            }
            if is_integer = false
            {
                ; get_iterator / next are zero-arg (only `this`), so an
                ; empty arg_types list drives lookup_method#'s overload
                ; selection.
                var no_args_arr Array[PlannedType]$()
                let no_args Vector[PlannedType]^rp(no_args_arr)
                let get_iter_match this.lookup_method#(iter_type, String$("get_iterator"), no_args)
                if get_iter_match <> null
                {
                    let gm (*get_iter_match)
                    set is_iterator_loop: true
                    set iterator_type: gm.return_type
                    set get_iter_name: gm.mangled_name

                    let next_match this.lookup_method#(iterator_type, String$("next"), no_args)
                    if next_match <> null
                    {
                        let nm (*next_match)
                        set next_name: nm.mangled_name
                        set element_type: nm.return_type
                    }
                }
                if get_iter_match = null
                {
                    ; No get_iterator: fall back to the iterable's first
                    ; generic (what Vec[T] / List[T] would yield), or
                    ; the iter_type itself if no generics.
                    var fell_back: bool false
                    if iter_type.generics <> null
                    {
                        let gens (*iter_type.generics)
                        if gens.length > 0
                        {
                            let g_ptr gens.get 0
                            if g_ptr <> null
                            {
                                set element_type: (*g_ptr)
                                set fell_back: true
                            }
                        }
                    }
                    if fell_back = false
                        set element_type: iter_type
                }
            }

            this.define_local(f.identifier, element_type, false, false)

            let planned_body this.plan_action#(f.action)
            this.pop_scope()

            var expr_holder Vector[PlannedOperand]^rp(planned_expr)
            PlannedFor(
                f.span,
                f.identifier,
                &expr_holder,
                planned_body,
                is_iterator_loop,
                coll_type,
                iterator_type,
                element_type,
                get_iter_name,
                next_name,
                f.loop_label
            )
        }

        ; plan_try: try { binding } catch WhenPatterns else alt.
        function plan_try#(rp, this: Planner, t: Try) returns PlannedTry
        {
            ; The try-bound variable (e.g. `try let q ...`) leaks into the
            ; ENCLOSING scope: the success path is the only way execution
            ; falls through past the try block, where the binding is in
            ; scope. So plan the binding in the current scope — do NOT push
            ; a scope around it. plan_when# scopes each catch arm; the else
            ; arm gets its own scope below.
            let planned_bind this.plan_binding#(t.binding)

            ; Detect a throwing-call condition. A throws function returns the
            ; Result wrapper { i8 status, [N x i8] data }; on error the data
            ; field holds the thrown error union INLINE. The catch arms select
            ; error variants of the function's `throws T` union (NOT the
            ; success type), so resolve them against the throws union.
            var is_throwing: bool false
            var throws_type: PlannedType Planner.make_void_type#()
            var union_for_catches: PlannedType Planner.make_void_type#()
            if planned_bind.operation <> null
            {
                let ops (*planned_bind.operation)
                if ops.length > 0
                {
                    let last_ptr ops.get(ops.length - 1)
                    if last_ptr <> null
                    {
                        let last_op (*last_ptr)
                        set union_for_catches: last_op.result_type
                        choose last_op.expr
                            when call: Call
                            {
                                if call.can_throw
                                {
                                    set is_throwing: true
                                    if call.throws_type <> null
                                    {
                                        set throws_type: (*call.throws_type)
                                        set union_for_catches: (*call.throws_type)
                                    }
                                }
                            }
                            else
                                0
                    }
                }
            }

            var catches_arr Array[PlannedWhen]$()
            var ci: size_t 0
            while ci < t.catches.length
            {
                let w_ptr t.catches.get ci
                if w_ptr <> null
                {
                    let w (*w_ptr)
                    catches_arr.add(this.plan_when#(w, union_for_catches, false, null))
                }
                set ci: ci + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if t.alternative <> null
            {
                this.push_scope()
                let alt (*t.alternative)
                let planned_alt this.plan_statement#(alt)
                this.pop_scope()
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }

            var catches_holder Vector[PlannedWhen]^rp(catches_arr)
            PlannedTry(t.span, planned_bind, &catches_holder, alternative_ref, throws_type, is_throwing)
        }

        ; plan_when: one pattern arm of choose/try. When `union_type` is
        ; non-null and names a registered union concept, the variant's
        ; payload type and tag index are resolved so the Emitter can
        ; extract the payload and compare tags correctly. When union_type
        ; is void (the fallback from plan_try with no exception type),
        ; the arm still plans but variant_type stays void and tag stays 0.
        function plan_when#(
            rp,
            this: Planner,
            w: When,
            union_type: PlannedType,
            is_throws_call: bool,
            throws_ty: ref[PlannedType]?
        ) returns PlannedWhen
        {
            this.push_scope()

            ; Resolve the variant's payload type and tag against the
            ; enclosing union. `w.name` is the binding identifier
            ; (e.g. `s` in `when s: Some`); the variant *type* name
            ; lives in `w.variant` (last segment for dotted paths).
            ; Fall back to a fresh type variable when the union isn't
            ; resolvable (e.g. when called from plan_try before
            ; exception types land).
            var binding_ty: PlannedType this.fresh_type_var#(String$(""))
            var variant_type: PlannedType Planner.make_void_type#()
            var variant_tag: size_t 0

            var variant_name: String String^rp("")
            if w.variant.length > 0
            {
                let last_ptr w.variant.get(w.variant.length - 1)
                if last_ptr <> null
                    set variant_name: (*last_ptr)
            }

            if union_type.name.equals("void") = false
            {
                ; s184: bind the union's generic parameters to the
                ; scrutinee's generic args before planning the payload
                ; type — `when v: Some` over Option[int] must type v as
                ; int, not T (which maps to ptr and drops the implicit
                ; return). Same pattern as the s81 ctor-diversion site.
                let saved_subst_when type_substitutions.length
                if union_type.generics <> null
                {
                    let wgens (*union_type.generics)
                    let wconc_ref this.lookup_concept(union_type.name)
                    if wconc_ref <> null
                    {
                        let wconc (*wconc_ref)
                        var wpi: size_t 0
                        while wpi < wconc.parameters.length
                        {
                            if wpi < wgens.length
                            {
                                let wp_ptr wconc.parameters.get wpi
                                let wg_ptr wgens.get wpi
                                if wp_ptr <> null
                                {
                                    if wg_ptr <> null
                                        this.define_type_substitution(wp_ptr.name, (*wg_ptr))
                                }
                            }
                            set wpi: wpi + 1
                        }
                    }
                }
                let payload_ref this.lookup_variant_type#(
                    union_type.name, variant_name
                )
                set type_substitutions.length: saved_subst_when
                if payload_ref <> null
                {
                    set binding_ty: (*payload_ref)
                    set variant_type: (*payload_ref)
                }
                let tag this.lookup_variant_tag(union_type.name, variant_name)
                if tag >= 0
                    set variant_tag: tag as size_t
            }

            ; s143: throws-call synthetic Error/Success variant assignment.
            ; Mirrors stage-0 Planner.cpp:11363-11382. When the surrounding
            ; choose's condition is a throwing call AND the union lookup
            ; failed (variant_type still void), recognise the synthetic
            ; "Error"/"err"/"error" and "Success"/"Ok"/"ok"/"value"/"node"
            ; case names and assign variant_index 1 / 0 respectively.
            ; Without this, emit_choose's seen_tags dedup collapses both
            ; cases on variant_index=0, the second case body gets dropped,
            ; and the s142 default-redirect picks whichever arm comes first
            ; in source order — so cli.run's `choose parse_program#() when
            ; err: Error / when program: Success` always takes the err arm
            ; on hello.scaly and prints "Parse error" even when parsing
            ; succeeds. Distinct variant_indices unblock the natural
            ; first-byte-of-sret-slot dispatch: parse_X#'s emit_return
            ; stores the struct (start.size_t low byte = 0 for hello.scaly
            ; → Success arm); emit_throw stores tag=1 at offset 0 → Error
            ; arm. Result union wrapping is the proper fix (1-2 day
            ; refactor) but isn't required for hello.scaly's narrow path.
            if variant_type.name.equals("void")
            {
                if is_throws_call
                {
                    let is_error variant_name.equals(String$("Error"))
                    var is_err: bool is_error
                    if is_err = false
                        set is_err: variant_name.equals(String$("err"))
                    if is_err = false
                        set is_err: variant_name.equals(String$("error"))
                    if is_err
                    {
                        set variant_tag: 1
                        if throws_ty <> null
                        {
                            let tt (*throws_ty)
                            set binding_ty: tt
                            set variant_type: tt
                        }
                    }
                    if is_err = false
                    {
                        let is_success variant_name.equals(String$("Success"))
                        var is_ok: bool is_success
                        if is_ok = false
                            set is_ok: variant_name.equals(String$("Ok"))
                        if is_ok = false
                            set is_ok: variant_name.equals(String$("ok"))
                        if is_ok = false
                            set is_ok: variant_name.equals(String$("value"))
                        if is_ok = false
                            set is_ok: variant_name.equals(String$("node"))
                        if is_ok
                        {
                            ; s172: bind the success arm to the call's
                            ; result type (stage-0 Planner.cpp:11377-11380
                            ; PW.VariantType = ValueType). Without this,
                            ; binding_ty stays a fresh no-name type var,
                            ; resolve_member_access# finds no properties
                            ; on `success.field`, every hop defaults to
                            ; field_index 0, and parse_routine's
                            ; ReturnsSyntax#(success.start, success.end,
                            ; success.type, ...) rebuilds the syntax with
                            ; field 0 in every slot — stage-2 then sees
                            ; empty type names ("int" → "", mangling
                            ; _Z3addPN4scaly6memory4PageE, no bodies).
                            set variant_tag: 0
                            set binding_ty: union_type
                            set variant_type: union_type
                        }
                    }
                }
            }

            this.define_local(w.name, binding_ty, false, false)

            let planned_cons this.plan_statement#(w.consequent)
            this.pop_scope()

            var cons_holder Vector[PlannedStatement]^rp(1)
            cons_holder.put(0, planned_cons)
            PlannedWhen(
                w.span,
                w.name,
                variant_type,
                variant_tag,
                cons_holder.get 0
            )
        }

        ; plan_choose: Scaly's choose/when pattern match.
        function plan_choose#(rp, this: Planner, c: Choose) returns PlannedChoose
        {
            let planned_cond this.plan_operands#(c.condition)
            ; Fold the choose condition down to a single value to
            ; recover its type — that's the union each `when` pattern
            ; selects a variant of.
            let collapsed_cond this.collapse_operand_sequence#(planned_cond)
            ; s173: peel ref[T]/pointer[T] off the condition type so
            ; plan_when# can resolve the union's variants. A for-in loop
            ; variable is typed ref[T] (the iterator's next() return),
            ; so `choose stmt` over Vector[PlannedStatement] otherwise
            ; looks up variants on "ref" — every arm keeps tag 0 plus a
            ; fresh binding type, emit_choose's seen_tags dedup drops all
            ; but the first arm, and the NPO null-check path hijacks the
            ; dispatch. Mirrors stage-0 Planner.cpp:11247-11250.
            var union_type: PlannedType collapsed_cond.result_type
            var peel_cond: bool false
            if union_type.name.equals(String$("ref"))
                set peel_cond: true
            if union_type.name.equals(String$("pointer"))
                set peel_cond: true
            if peel_cond
            {
                if union_type.generics <> null
                {
                    let gens (*union_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set union_type: (*g_ptr)
                    }
                }
            }

            ; s143: detect a throws-call as the choose condition. plan_when#
            ; needs this so it can assign distinct variant_index to the
            ; synthetic "Error" / "Success" arms, otherwise both collide on
            ; variant_index=0 and emit_choose's seen_tags dedup drops the
            ; second arm. See plan_when# comment for the full rationale.
            var is_throws_call: bool false
            var throws_ty_ref: ref[PlannedType]? null
            choose collapsed_cond.expr
                when call: Call
                {
                    set is_throws_call: call.can_throw
                    if call.throws_type <> null
                        set throws_ty_ref: call.throws_type
                }
                else
                    0

            var cases_arr Array[PlannedWhen]$()
            var i: size_t 0
            while i < c.cases.length
            {
                let w_ptr c.cases.get i
                if w_ptr <> null
                {
                    let w (*w_ptr)
                    cases_arr.add(this.plan_when#(w, union_type, is_throws_call, throws_ty_ref))
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if c.alternative <> null
            {
                let alt (*c.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }

            ; Unify each when-arm's consequent result type (plus the
            ; optional alternative) so choose-as-expression has a single
            ; type. Voids are skipped — statement-only arms contribute
            ; no constraint.
            if cases_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type#()
                var have_first: bool false
                var wi: size_t 0
                while wi < cases_arr.length
                {
                    let w_ptr cases_arr.get wi
                    if w_ptr <> null
                    {
                        let pw (*w_ptr)
                        if pw.consequent <> null
                        {
                            let cons_ref (*pw.consequent)
                            let arm_ty Planner.statement_result_type(cons_ref)
                            if arm_ty.name.equals(String$("void")) = false
                            {
                                if have_first = false
                                {
                                    set first_ty: arm_ty
                                    set have_first: true
                                }
                                if have_first
                                    this.add_equality_constraint(
                                        first_ty, arm_ty, pw.loc
                                    )
                            }
                        }
                    }
                    set wi: wi + 1
                }
                if alternative_ref <> null
                {
                    if have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        if alt_ty.name.equals(String$("void")) = false
                            this.add_equality_constraint(first_ty, alt_ty, c.span)
                    }
                }
            }

            ; Store the COLLAPSED single operand, not the flat list.
            ; emit_operands only emits the first operand (assuming
            ; callers have already collapsed); storing the flat
            ; `[get_color, ()]` would emit only `get_color` and miss
            ; the call. plan_if has this same shape (~line 5096).
            var cond_holder Vector[PlannedOperand]^rp(1)
            cond_holder.put(0, collapsed_cond)
            var cases_holder Vector[PlannedWhen]^rp(cases_arr)
            PlannedChoose(c.span, &cond_holder, &cases_holder, alternative_ref)
        }

        ; plan_case / plan_branch / plan_match: the full match-expression form.
        function plan_case#(rp, this: Planner, cs: Case) returns PlannedCase
        {
            let planned_cond this.plan_operands#(cs.condition)
            var cond_holder Vector[PlannedOperand]^rp(planned_cond)
            PlannedCase(cs.span, &cond_holder)
        }

        function plan_branch#(rp, this: Planner, b: Branch) returns PlannedBranch
        {
            var cases_arr Array[PlannedCase]$()
            var i: size_t 0
            while i < b.cases.length
            {
                let cs_ptr b.cases.get i
                if cs_ptr <> null
                {
                    let cs (*cs_ptr)
                    cases_arr.add(this.plan_case#(cs))
                }
                set i: i + 1
            }

            let planned_cons this.plan_statement#(b.consequent)
            var cons_holder Vector[PlannedStatement]^rp(1)
            cons_holder.put(0, planned_cons)

            var cases_holder Vector[PlannedCase]^rp(cases_arr)
            PlannedBranch(b.span, &cases_holder, cons_holder.get 0)
        }

        function plan_match#(rp, this: Planner, m: Match) returns PlannedMatch
        {
            let planned_cond this.plan_operands#(m.condition)
            ; Fold the match condition so its result_type is
            ; comparable against each case's collapsed condition type.
            let collapsed_cond this.collapse_operand_sequence#(planned_cond)
            let cond_type collapsed_cond.result_type

            var branches_arr Array[PlannedBranch]$()
            var i: size_t 0
            while i < m.branches.length
            {
                let b_ptr m.branches.get i
                if b_ptr <> null
                {
                    let b (*b_ptr)
                    let planned_branch this.plan_branch#(b)

                    ; Each case's condition must be the same type as the
                    ; match condition. Emit an equality constraint so
                    ; the HM solver rejects mismatches.
                    if planned_branch.cases <> null
                    {
                        let cases (*planned_branch.cases)
                        var ci: size_t 0
                        while ci < cases.length
                        {
                            let case_ptr cases.get ci
                            if case_ptr <> null
                            {
                                let case_cond (*case_ptr)
                                if case_cond.condition <> null
                                {
                                    let cond_list (*case_cond.condition)
                                    let collapsed_case this.collapse_operand_sequence#(cond_list)
                                    this.add_equality_constraint(
                                        cond_type,
                                        collapsed_case.result_type,
                                        case_cond.loc
                                    )
                                }
                            }
                            set ci: ci + 1
                        }
                    }

                    branches_arr.add planned_branch
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if m.alternative <> null
            {
                let alt (*m.alternative)
                let planned_alt this.plan_statement#(alt)
                var alt_holder Vector[PlannedStatement]^rp(1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)
            }

            ; Unify all branch consequent result types (and the
            ; alternative when present) so the match-as-expression has
            ; a single type. Voids are skipped — pure-statement
            ; branches contribute no constraint.
            if branches_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type#()
                var have_first: bool false
                var bi: size_t 0
                while bi < branches_arr.length
                {
                    let br_ptr branches_arr.get bi
                    if br_ptr <> null
                    {
                        let br (*br_ptr)
                        if br.consequent <> null
                        {
                            let cons (*br.consequent)
                            let br_ty Planner.statement_result_type(cons)
                            if br_ty.name.equals(String$("void")) = false
                            {
                                if have_first = false
                                {
                                    set first_ty: br_ty
                                    set have_first: true
                                }
                                if have_first
                                    this.add_equality_constraint(
                                        first_ty, br_ty, br.loc
                                    )
                            }
                        }
                    }
                    set bi: bi + 1
                }
                if alternative_ref <> null
                {
                    if have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        if alt_ty.name.equals(String$("void")) = false
                            this.add_equality_constraint(first_ty, alt_ty, m.span)
                    }
                }
            }

            var cond_holder Vector[PlannedOperand]^rp(planned_cond)
            var branches_holder Vector[PlannedBranch]^rp(branches_arr)
            PlannedMatch(m.span, &cond_holder, &branches_holder, alternative_ref)
        }

        ; ================================================================
        ; Tuples and matrices.
        ; ================================================================

        ; plan_component: Model.Component → PlannedComponent.
        ; Mirrors Planner.cpp:10499-10512 — each component's operand
        ; sequence is collapsed so prefix ops like `*p` and method-call
        ; arguments resolve against the collapsed result rather than the
        ; raw operand sequence. emit_tuple's grouping shortcut emits
        ; comp.value[0], so without this collapse `(*p).field` would
        ; emit only the leading `Type("*")` operand and produce null.
        function plan_component#(rp, this: Planner, c: Component) returns PlannedComponent
        {
            let planned_value this.plan_operands#(c.value)
            var name_ref: ref[String]? null
            if c.name <> null
            {
                let n (*c.name)
                var holder Vector[String]^rp(1)
                holder.put(0, String^rp(n))
                set name_ref: holder.get(0)
            }
            ; Collapse when the operand sequence either starts with a
            ; prefix operator (`*p`, `-x`, `!flag`, ...) or contains a
            ; postfix `as`/`is` operand (`x as T`, `y is V`). emit_tuple's
            ; grouping shortcut emits comp.value[0]; without collapse,
            ; `(*p).field` would emit only the leading `Type("*")`
            ; operand and `f(x as T)` would surface as two args to f
            ; (`extract_tuple_arg_types` reads each operand's
            ; result_type), failing arity match. Other shapes are left
            ; untouched — running them through collapse_operand_sequence#
            ; adds String allocations that surface a latent
            ; dangling-String bug in resolve_function_call when stage-1
            ; self-compiles.
            var should_collapse: bool false
            if planned_value.length > 1
            {
                let f0_ptr planned_value.get 0
                if f0_ptr <> null
                {
                    let f0 (*f0_ptr)
                    choose f0.expr
                        when ty: PlannedType
                        {
                            if Planner.is_operator_name(ty.name)
                                set should_collapse: true
                        }
                        else
                            0
                }
                if should_collapse = false
                {
                    var k: size_t 1
                    while k < planned_value.length
                    {
                        let op_ptr planned_value.get k
                        if op_ptr <> null
                        {
                            let op (*op_ptr)
                            choose op.expr
                                when a: PlannedAs
                                    set should_collapse: true
                                when i: PlannedIs
                                    set should_collapse: true
                                when tp: PlannedTuple
                                {
                                    ; Call/construction shape: a Tuple at
                                    ; k>=1 is an argument list following a
                                    ; callee/concept (`f(x)`, `Point(3, 4)`,
                                    ; `abs (- 5)`). Without collapse the
                                    ; grouped form `(f x)` keeps the raw
                                    ; 2-operand sequence and emit_tuple's
                                    ; grouping shortcut emits only the
                                    ; callee operand — the whole statement
                                    ; silently drops.
                                    set should_collapse: true
                                }
                                when ty: PlannedType
                                {
                                    ; s90: binary operator at k>=1 (e.g.
                                    ; `x = y`, `a + b`, `p <> null`) means
                                    ; the operand sequence must collapse to
                                    ; a single PlannedCall. Without this,
                                    ; tuple components carrying a binary
                                    ; comparison as a function arg leave
                                    ; planned_value as a 3-operand sequence,
                                    ; emit_tuple's per-component arg path
                                    ; only sees the first operand, the call
                                    ; arity-mismatches, returns null, and
                                    ; the entire `let X = f(...arg-with-cmp...)`
                                    ; binding plus its `if X = false`
                                    ; follower silently drop. Mirrors stage-
                                    ; 0's planTuple at Planner.cpp:10506-10511
                                    ; (unconditional collapse on every
                                    ; component value).
                                    if Planner.is_operator_name(ty.name)
                                        set should_collapse: true
                                    ; Named infix operators (`div`, `mod`)
                                    ; are not operator-shaped names, but a
                                    ; name WITH a precedence at k>=1 sits in
                                    ; operator position — collapse so the
                                    ; binary loop can build the call.
                                    if Planner.get_operator_precedence(ty.name) > 0
                                        set should_collapse: true
                                    ; A declared text-named operator (e.g.
                                    ; `'minus'`) is neither operator-shaped nor
                                    ; in the precedence table, but still sits in
                                    ; operator position — collapse so a
                                    ; parenthesized `(a 'op' b)` (e.g. a binding
                                    ; init or the literate-test wrapper) folds
                                    ; into the call instead of dropping to its
                                    ; RHS. Stage-0 collapses unconditionally
                                    ; (Planner.cpp:10506).
                                    if this.is_operator(ty.name)
                                        set should_collapse: true
                                }
                                else
                                    0
                        }
                        set k: k + 1
                    }
                }
            }
            if should_collapse = false
            {
                var mc: size_t 0
                while mc < planned_value.length
                {
                    let mop_ptr planned_value.get mc
                    if mop_ptr <> null
                    {
                        let mop (*mop_ptr)
                        if mop.member_access <> null
                        {
                            let mma (*mop.member_access)
                            if mma.length > 0
                            {
                                let mh_ptr mma.get(mma.length - 1)
                                if mh_ptr <> null
                                {
                                    if (*mh_ptr).is_method
                                        set should_collapse: true
                                }
                            }
                        }
                    }
                    set mc: mc + 1
                }
            }
            ; s184: generic-argument shape — a bare Type followed by a
            ; Matrix (`Option[int].None` as a lone argument). Collapse
            ; runs the s107 [Type, Matrix] merge; without it the raw
            ; pair reaches emit_tuple, which emits only the bare Type
            ; operand and the statement silently drops.
            if should_collapse = false
            {
                if planned_value.length > 1
                {
                    let g0_ptr planned_value.get 0
                    let g1_ptr planned_value.get 1
                    if g0_ptr <> null
                    {
                        if g1_ptr <> null
                        {
                            var g0_bare_type: bool false
                            choose (*g0_ptr).expr
                                when g0t: PlannedType
                                {
                                    if g0t.generics = null
                                        set g0_bare_type: true
                                }
                                else
                                    0
                            if g0_bare_type
                            {
                                choose (*g1_ptr).expr
                                    when g1m: scalyc.compiler.Plan.PlannedMatrix
                                        set should_collapse: true
                                    else
                                        0
                            }
                        }
                    }
                }
            }
            var value_holder Vector[PlannedOperand]^rp(planned_value)
            if should_collapse
            {
                let collapsed this.collapse_operand_sequence#(planned_value)
                var collapsed_arr Array[PlannedOperand]^rp()
                collapsed_arr.add collapsed
                set value_holder: Vector[PlannedOperand]^rp(collapsed_arr)
            }
            PlannedComponent(c.span, name_ref, &value_holder, null)
        }

        function plan_tuple#(rp, this: Planner, t: Tuple) returns PlannedTuple
        {
            var comps_arr Array[PlannedComponent]$()
            var i: size_t 0
            while i < t.components.length
            {
                let c_ptr t.components.get i
                if c_ptr <> null
                {
                    let c (*c_ptr)
                    comps_arr.add(this.plan_component#(c))
                }
                set i: i + 1
            }

            ; Single anonymous component = grouping parens. Lift the
            ; component's collapsed result_type into tuple_type so callers
            ; that consume the tuple as a value (resolve_member_access on
            ; `(*p).field`, ...) see the inner expression's type instead of
            ; `void`. Mirrors Planner.cpp:10497-10501. Multi-component
            ; tuples and named components keep tuple_type=void to avoid
            ; disturbing the struct-construction and function-argument
            ; paths.
            var tuple_ty: PlannedType Planner.make_void_type#()
            if comps_arr.length = 1
            {
                let only_ptr_initial comps_arr.get 0
                if only_ptr_initial <> null
                {
                    let only_initial (*only_ptr_initial)
                    if only_initial.name = null
                    {
                        if only_initial.value <> null
                        {
                            let vals_initial (*only_initial.value)
                            if vals_initial.length > 0
                            {
                                let collapsed this.collapse_operand_sequence#(vals_initial)
                                set tuple_ty: collapsed.result_type
                            }
                        }
                    }
                }
            }

            var comps_holder Vector[PlannedComponent]^rp(comps_arr)
            PlannedTuple(
                t.span,
                &comps_holder,
                tuple_ty,
                false,
                Lifetime.Unspecified(Unspecified()),
                null
            )
        }

        function plan_matrix#(rp, this: Planner, m: Matrix) returns scalyc.compiler.Plan.PlannedMatrix
        {
            var rows_arr Array[Vector[PlannedOperand]]$()
            var i: size_t 0
            while i < m.operations.length
            {
                let row_ptr m.operations.get i
                if row_ptr <> null
                {
                    let row (*row_ptr)
                    let planned_row this.plan_operands#(row)
                    rows_arr.add planned_row
                }
                set i: i + 1
            }

            var rows_holder Vector[Vector[PlannedOperand]]^rp(rows_arr)
            scalyc.compiler.Plan.PlannedMatrix(
                m.span,
                &rows_holder,
                Planner.make_void_type#(),
                m.life
            )
        }

        ; plan_new: `new Foo(args)` — object construction. The mangled
        ; initializer and resolved struct type depend on the concept
        ; table, so we plan the type skeleton and arguments and leave
        ; the call layout for later resolution. For now we model it as
        ; a PlannedTuple carrying the argument list and the planned type.
        function plan_new#(rp, this: Planner, n: New) returns PlannedTuple
        {
            let planned_ty this.plan_type#(n.type)
            let planned_args this.plan_tuple#(n.arguments)

            ; Verify the target type has a matching initializer. A New
            ; with no matching init is a hard error — record it so the
            ; emitter doesn't silently produce an empty struct value.
            var arg_types_arr Array[PlannedType]$()
            if planned_args.components <> null
            {
                let comps (*planned_args.components)
                var ci: size_t 0
                while ci < comps.length
                {
                    let c_ptr comps.get ci
                    if c_ptr <> null
                    {
                        let c (*c_ptr)
                        if c.value <> null
                        {
                            let vops (*c.value)
                            if vops.length > 0
                            {
                                let last_ptr vops.get(vops.length - 1)
                                if last_ptr <> null
                                    arg_types_arr.add((*last_ptr).result_type)
                            }
                        }
                    }
                    set ci: ci + 1
                }
            }
            var arg_types_vec Vector[PlannedType]^rp(arg_types_arr)
            let init_ref this.find_initializer#(planned_ty.name, arg_types_vec)
            if init_ref = null
            {
                var sb StringBuilder$()
                sb.append "no matching initializer for `new "
                sb.append planned_ty.name
                sb.append "`"
                this.add_error(sb.to_string^rp())
            }

            PlannedTuple(
                n.span,
                planned_args.components,
                planned_ty,
                true,
                planned_ty.life,
                null
            )
        }

        ; ================================================================
        ; plan_operand: dispatch by Expression variant, then wrap with
        ; any member-access chain declared on the operand.
        ; ================================================================
        function plan_operand#(rp, this: Planner, op: scalyc.compiler.Model.Operand) returns PlannedOperand
        {
            let base choose op.expression
                when c: Constant
                    this.plan_constant_operand#(c, op.span)
                when ty: Type
                    this.plan_type_operand#(ty, op.span)
                when tp: Tuple
                {
                    let pt this.plan_tuple#(tp)
                    PlannedOperand(op.span, PlannedExpression.Tuple pt, null, pt.tuple_type)
                }
                when mx: Matrix
                {
                    let pm this.plan_matrix#(mx)
                    PlannedOperand(op.span, PlannedExpression.Matrix pm, null, pm.element_type)
                }
                when bk: Block
                {
                    let pb this.plan_block#(bk)
                    ; Block-as-expression takes its type from the last
                    ; statement (typically an Action whose source is the
                    ; trailing expression). Empty blocks remain void.
                    var block_type: PlannedType Planner.make_void_type#()
                    if pb.statements <> null
                    {
                        let stmts (*pb.statements)
                        if stmts.length > 0
                        {
                            let last_ptr stmts.get(stmts.length - 1)
                            if last_ptr <> null
                                set block_type: Planner.statement_result_type((*last_ptr))
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Block pb, null, block_type)
                }
                when ife: If
                {
                    let pi this.plan_if#(ife)
                    ; Result type is the consequent's — branch unification
                    ; already equated it with the alternative via the
                    ; solver.
                    var if_type: PlannedType Planner.make_void_type#()
                    if pi.consequent <> null
                    {
                        let cons (*pi.consequent)
                        set if_type: Planner.statement_result_type(cons)
                    }
                    PlannedOperand(op.span, PlannedExpression.If pi, null, if_type)
                }
                when mt: Match
                {
                    let pm this.plan_match#(mt)
                    var match_type: PlannedType Planner.make_void_type#()
                    if pm.branches <> null
                    {
                        let brs (*pm.branches)
                        if brs.length > 0
                        {
                            let first_br_ptr brs.get 0
                            if first_br_ptr <> null
                            {
                                let first_br (*first_br_ptr)
                                if first_br.consequent <> null
                                    set match_type: Planner.statement_result_type(
                                        (*first_br.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Match pm, null, match_type)
                }
                when ch: Choose
                {
                    let pc this.plan_choose#(ch)
                    var choose_type: PlannedType Planner.make_void_type#()
                    if pc.cases <> null
                    {
                        let cases (*pc.cases)
                        if cases.length > 0
                        {
                            let first_ptr cases.get 0
                            if first_ptr <> null
                            {
                                let first_case (*first_ptr)
                                if first_case.consequent <> null
                                    set choose_type: Planner.statement_result_type(
                                        (*first_case.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Choose pc, null, choose_type)
                }
                when fr: For
                {
                    let pf this.plan_for#(fr)
                    PlannedOperand(op.span, PlannedExpression.For pf, null, Planner.make_void_type#())
                }
                when wh: While
                {
                    let pw this.plan_while#(wh)
                    PlannedOperand(op.span, PlannedExpression.While pw, null, Planner.make_void_type#())
                }
                when tr: Try
                {
                    let pt this.plan_try#(tr)
                    ; Try-as-expression takes the happy-path value's
                    ; type — that's the binding's operation result.
                    var try_type: PlannedType Planner.make_void_type#()
                    if pt.cond.operation <> null
                    {
                        let ops (*pt.cond.operation)
                        if ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            if last_ptr <> null
                                set try_type: (*last_ptr).result_type
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Try pt, null, try_type)
                }
                when so: SizeOf
                {
                    let ps this.plan_sizeof#(so)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.SizeOf ps,
                        null,
                        Planner.make_size_type#()
                    )
                }
                when ao: scaly.compiler.Model.AlignOf
                {
                    let pa this.plan_alignof#(ao)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.AlignOf pa,
                        null,
                        Planner.make_size_type#()
                    )
                }
                when isx: Is
                {
                    let pi this.plan_is#(isx)
                    PlannedOperand(op.span, PlannedExpression.Is pi, null, Planner.make_bool_type#())
                }
                when asx: scaly.compiler.Model.As
                {
                    let pa this.plan_as#(asx)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.As pa,
                        null,
                        pa.target_type
                    )
                }
                when nw: New
                {
                    let pt this.plan_new#(nw)
                    PlannedOperand(op.span, PlannedExpression.Tuple pt, null, pt.tuple_type)
                }
                when lam: Lambda
                {
                    let pl this.plan_lambda#(lam)
                    PlannedOperand(op.span, PlannedExpression.Lambda pl, null, pl.return_type)
                }
                when rep: Repeat
                {
                    let pr this.plan_repeat#(rep)
                    PlannedOperand(op.span, PlannedExpression.Repeat pr, null, pr.value_type)
                }

            ; s164: bind member_access to a local BEFORE the guard. A
            ; `guard`/`if`/... statement placed immediately after a
            ; `let X choose {...}` binding is absorbed into the binding's
            ; initializer operation by the parser (the choose's trailing
            ; newline is consumed, so the operand list keeps collecting),
            ; and since the Expression union has no Guard variant the
            ; absorbed if is silently dropped — stage-1 then emitted no
            ; null-check and dereferenced a null op.member_access. A
            ; non-stmt-like binding (`let ma ...`) closes the choose
            ; binding's operation, so the following if survives as its
            ; own statement. (Stage-0's parser doesn't collapse this, so it
            ; was never exercised there.)
            let ma op.member_access
            if ma = null
                return base

            let members (*ma)
            let access_chain this.resolve_member_access#(base.result_type, members)
            var access_holder Vector[PlannedMemberAccess]^rp(access_chain)
            var final_type: PlannedType base.result_type
            if access_chain.length > 0
            {
                let last_ptr access_chain.get(access_chain.length - 1)
                if last_ptr <> null
                    set final_type: (*last_ptr).result_type
            }
            PlannedOperand(base.loc, base.expr, &access_holder, final_type)
        }

        ; plan_operands: batch plan_operand over a Vector.
        ; s184: unit variant referenced without an argument tuple —
        ; `Option.None` as a value. Mirrors stage-0's planOperands
        ; Case 3 (Planner.cpp:8376-8419): a two-segment name whose
        ; first segment is a registered union and whose second a
        ; payload-less variant plans as a PlannedVariantConstruction
        ; with no value. Returns null when the shape doesn't match so
        ; the caller falls back to plan_operand#. Locals win — a
        ; shadowing local binding disqualifies the union lookup.
        function try_plan_unit_variant#(
            rp,
            this: Planner,
            t: Type,
            loc: Span
        ) returns ref[PlannedOperand]?
        {
            if t.name.length <> 2
                return null
            let u_ptr t.name.get 0
            let v_ptr t.name.get 1
            if u_ptr = null
                return null
            if v_ptr = null
                return null
            let union_name (*u_ptr)
            let variant_name (*v_ptr)
            if this.lookup_local_binding(union_name) <> null
                return null
            let uconc_ref this.lookup_concept(union_name)
            if uconc_ref = null
                return null
            let uconc (*uconc_ref)
            var unit_variant: bool false
            choose uconc.definition
                when uvd: scalyc.compiler.Model.Union
                {
                    var uvi: size_t 0
                    while uvi < uvd.variants.length
                    {
                        let var_ptr uvd.variants.get uvi
                        if var_ptr <> null
                        {
                            let var_def (*var_ptr)
                            if var_def.name.equals(variant_name)
                            {
                                if var_def.type = null
                                    set unit_variant: true
                            }
                        }
                        set uvi: uvi + 1
                    }
                }
                else
                    0
            if unit_variant = false
                return null
            let unit_tag this.lookup_variant_tag(union_name, variant_name)
            if unit_tag < 0
                return null
            let unit_union_ty PlannedType(
                loc,
                union_name,
                Planner.mangle_structure#(union_name, null),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            )
            let unit_vc PlannedVariantConstruction(
                loc,
                unit_union_ty,
                variant_name,
                unit_tag as size_t,
                null
            )
            var holder Vector[PlannedOperand]^rp(1)
            holder.put(0, PlannedOperand(
                loc,
                PlannedExpression.VariantConstruction unit_vc,
                null,
                unit_union_ty
            ))
            holder.get 0
        }

        function plan_operands#(
            rp,
            this: Planner,
            ops: Vector[scalyc.compiler.Model.Operand]
        ) returns Vector[PlannedOperand]
        {
            var result Vector[PlannedOperand]^rp(ops.length)
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    ; s184 unit-variant lookahead: only a Type operand
                    ; NOT followed by an argument Tuple and carrying no
                    ; member chain qualifies — `Union.Unit()` (with
                    ; parens) must keep flowing through the collapse
                    ; construction gate as [Type, Tuple].
                    var unit_ref: ref[PlannedOperand]? null
                    if op.member_access = null
                    {
                        var followed_by_tuple: bool false
                        if i + 1 < ops.length
                        {
                            let next_ptr ops.get(i + 1)
                            if next_ptr <> null
                            {
                                choose (*next_ptr).expression
                                    when nt: Tuple
                                        set followed_by_tuple: true
                                    else
                                        0
                            }
                        }
                        if followed_by_tuple = false
                        {
                            choose op.expression
                                when uty: Type
                                    set unit_ref: this.try_plan_unit_variant#(uty, op.span)
                                else
                                    0
                        }
                    }
                    if unit_ref <> null
                    {
                        result.put(i, (*unit_ref))
                    }
                    if unit_ref = null
                    {
                        let pl this.plan_operand#(op)
                        result.put(i, pl)
                    }
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_binding: Model.Binding → Plan.PlannedBinding.
        ;
        ; Responsibilities:
        ;   1. Plan the initializer operands (by calling plan_operands).
        ;   2. Plan the binding's annotated item, which yields the
        ;      PlannedItem with an optional PlannedType.
        ;   3. Register the binding in the current scope so later uses
        ;      resolve by name.
        ;
        ; plan_binding now collapses the operation sequence. Stack-array
        ; type detection (`[T, N]` at binding site) is deferred.
        ; ================================================================

        ; Drop a LEADING `=` from a binding initializer (the assignment
        ; form `let x = value` → operands `[=, value]`). `=` is also the
        ; comparison operator, so a NON-leading `=` (`let r a = b`) must be
        ; kept — it collapses to the comparison `r = (a == b)`. Mirrors the
        ; stage-0 index-0 if in Planner.cpp::planBinding.
        function strip_leading_eq#(rp, ops: Vector[PlannedOperand]) returns Vector[PlannedOperand]
        {
            if ops.length > (0 as size_t)
            {
                let f0 ops.get 0
                if f0 <> null
                {
                    let f0v (*f0)
                    choose f0v.expr
                        when e0: PlannedType
                        {
                            if e0.name.equals("=")
                            {
                                var arr Array[PlannedOperand]^rp()
                                var i: size_t 1
                                while i < ops.length
                                {
                                    let p ops.get i
                                    if p <> null
                                        arr.add((*p))
                                    set i: i + 1
                                }
                                return Vector[PlannedOperand]^rp(arr)
                            }
                        }
                        else
                            0
                }
            }
            ops
        }

        function plan_binding#(rp, this: Planner, b: Binding) returns PlannedBinding
        {
            ; GAP B: a delegate-typed binding initialized by a lambda literal —
            ; `let g: Callback \x: x + 1` — becomes a function-pointer VALUE (the
            ; address of the lambda monomorphized against the delegate's declared
            ; signature), so g can be passed around and called indirectly. This
            ; must run BEFORE the Phase-1 model-record intercept below, which
            ; would otherwise treat it as a call-site-monomorphized binding and
            ; emit no value.
            if b.operation.length = 1
            {
                var del_name String^rp("")
                if b.item.type <> null
                {
                    let ann (*b.item.type)
                    let nm Planner.join_dotted_name#(ann.name)
                    if this.is_delegate_type(nm)
                        set del_name: nm
                }
                if del_name.get_length() > 0
                {
                    let dop_ptr b.operation.get 0
                    if dop_ptr <> null
                        choose (*dop_ptr).expression
                            when dl: Lambda
                            {
                                var dparams this.delegate_param_types#(del_name)
                                var base_name String^rp("lam")
                                if b.item.name <> null
                                    set base_name: String^rp((*b.item.name))
                                let del_pt this.plan_type#((*b.item.type))
                                let dret this.delegate_return_type#(del_name)
                                let clo this.make_closure#(base_name, dl, dparams, dret, del_pt, Lifetime.Local(scalyc.compiler.Model.Local(b.span)))
                                let fref_op PlannedOperand(b.span, PlannedExpression.Closure clo, null, del_pt)
                                var op_arr Array[PlannedOperand]$()
                                op_arr.add fref_op
                                var op_vec Vector[PlannedOperand]^rp(op_arr)
                                var name_ref: ref[String]? null
                                if b.item.name <> null
                                {
                                    var nh Vector[String]^rp(1)
                                    nh.put(0, String^rp((*b.item.name)))
                                    set name_ref: nh.get(0)
                                }
                                var pt_h Vector[PlannedType]^rp(1)
                                pt_h.put(0, del_pt)
                                let pitem PlannedItem(b.span, false, name_ref, pt_h.get(0), null)
                                ; Register the local so later references resolve
                                ; to the delegate type (e.g. passing g to apply,
                                ; or calling g(...) indirectly).
                                if b.item.name <> null
                                {
                                    this.define_local((*b.item.name), del_pt, b.binding_type.equals("var"), false)
                                    ; Track it as a stack closure for escape
                                    ; checking (returning it would dangle).
                                    local_closure_names.add(String^rp((*b.item.name)))
                                }
                                return PlannedBinding(b.span, b.binding_type, pitem, &op_vec)
                            }
                            else
                                0
                }
            }

            ; Phase-1 lambda binding: `let f \params: body`. Record the lambda
            ; model under the binding name and emit no runtime value — calls to
            ; `f` monomorphize the body at the call site (collapse_operand_sequence#).
            if b.operation.length = 1
            {
                let lb_op0_ptr b.operation.get 0
                if lb_op0_ptr <> null
                {
                    if b.item.name <> null
                    {
                        choose (*lb_op0_ptr).expression
                            when lb_lam: Lambda
                            {
                                this.record_lambda_model((*b.item.name), lb_lam)
                                ; skip-binding: null item name + null operation
                                ; → emit_binding is a no-op for this binding.
                                return PlannedBinding(
                                    b.span,
                                    b.binding_type,
                                    PlannedItem(b.span, false, null, null, null),
                                    null
                                )
                            }
                            else
                                0
                    }
                }
            }

            let raw_ops_flat this.plan_operands#(b.operation)
            let planned_ops_flat Planner.strip_leading_eq#(raw_ops_flat)
            let orig_item this.plan_item#(b.item)

            ; s135: support `var NAME TYPE INIT` (no colon). When the
            ; Modeler produces a Binding with no annotation but >=2
            ; operands AND the first is a bare PlannedType (not Matrix/
            ; Tuple-followed and not an operator), treat the first as
            ; the item_type and the remaining as the initializer.
            ; Without this, collapse_operand_sequence#'s binary loop
            ; sees [Type, Const] as a would-be binary op, bails when
            ; there's no rhs, returns just the Type, and emit_binding
            ; drops the alloca entirely.
            var peeled_idx: size_t 0
            var has_peeled_type: bool false
            var peeled_holder Vector[PlannedType]^rp(1)
            if orig_item.item_type = null
            {
                if planned_ops_flat.length >= 2
                {
                    let first_ptr planned_ops_flat.get 0
                    if first_ptr <> null
                    {
                        let first_op (*first_ptr)
                        ; A type annotation never carries a member-access
                        ; chain. A first operand WITH a chain is a qualified
                        ; or method call (`ns.fn y`, `obj.m y`) — don't peel
                        ; it as a type; let collapse resolve the parenless
                        ; call.
                        if first_op.member_access = null
                        choose first_op.expr
                            when ft: PlannedType
                            {
                                if ft.name.get_length() > 0
                                {
                                    if Planner.is_operator_name(ft.name) = false
                                    {
                                        let next_ptr planned_ops_flat.get 1
                                        if next_ptr <> null
                                        {
                                            let next_op (*next_ptr)
                                            var next_is_continuation: bool false
                                            choose next_op.expr
                                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                                    set next_is_continuation: true
                                                when nt: PlannedTuple
                                                    set next_is_continuation: true
                                                when nty: PlannedType
                                                {
                                                    ; Lifetime markers (^name, $, #) are
                                                    ; modeled as Expression.Type with an
                                                    ; empty name path. Such markers
                                                    ; participate in the same call/ctor
                                                    ; collapse as Matrix/Tuple — don't
                                                    ; peel.
                                                    if nty.name.get_length() = 0
                                                        set next_is_continuation: true
                                                }
                                                else
                                                    0
                                            ; Don't peel a callable head: a free
                                            ; function or unqualified sibling
                                            ; method (`let t triple 10`, `let p
                                            ; get x`) is a parenless single-arg
                                            ; call, NOT a typed binding. A dotted
                                            ; non-concept name (`let r ns.fn x`)
                                            ; is likewise a qualified call. A
                                            ; genuine type head (primitive or
                                            ; concept) still peels.
                                            var head_is_call: bool false
                                            if this.is_function(ft.name)
                                                set head_is_call: true
                                            if this.is_namespace_sibling_function(ft.name)
                                                set head_is_call: true
                                            if this.has_this_method#(ft.name)
                                                set head_is_call: true
                                            ; A Phase-1 lambda binding name is callable,
                                            ; not a type — `let r inc(5)` must collapse
                                            ; to the lambda call, not peel `inc` as r's type.
                                            if this.lookup_lambda_model(ft.name) <> null
                                                set head_is_call: true
                                            if ft.name.last_index_of("." as u8) >= 0
                                            {
                                                if this.lookup_concept(ft.name) = null
                                                    set head_is_call: true
                                            }
                                            if next_is_continuation = false
                                            {
                                                if head_is_call = false
                                                {
                                                    set has_peeled_type: true
                                                    set peeled_idx: 1
                                                    peeled_holder.put(0, ft)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                    }
                }
            }

            ; Build the actual ops vector to collapse: either all of
            ; planned_ops_flat or just the tail starting at peeled_idx.
            var rest_arr Array[PlannedOperand]^rp()
            var ri: size_t peeled_idx
            while ri < planned_ops_flat.length
            {
                let p_ptr planned_ops_flat.get ri
                if p_ptr <> null
                    rest_arr.add((*p_ptr))
                set ri: ri + 1
            }
            let ops_to_collapse Vector[PlannedOperand]^rp(rest_arr)
            let collapsed this.collapse_operand_sequence#(ops_to_collapse)

            ; s192: stack array declaration `var buffer char[64]` (no
            ; init). The single operand collapses to a PlannedType that
            ; plan_type# rewrote to pointer[T] with array_size set; treat
            ; it as the item TYPE (no initializer), not a value operand.
            ; Mirrors stage-0 Planner.cpp:10953-10978. Without this the
            ; lone-type operand is kept as an init, emit_operands returns
            ; null on it, and emit_binding drops the slot.
            var is_stack_array_decl: bool false
            var stack_array_holder Vector[PlannedType]^rp(1)
            if has_peeled_type = false
            {
                if orig_item.item_type = null
                {
                    choose collapsed.expr
                        when ct: PlannedType
                        {
                            if ct.array_size.get_length() > 0
                            {
                                if ct.name.equals("pointer")
                                {
                                    set is_stack_array_decl: true
                                    stack_array_holder.put(0, ct)
                                }
                            }
                        }
                        else
                            0
                }
            }

            ; Rebuild PlannedItem with the peeled type if any.
            var planned_item: PlannedItem orig_item
            if has_peeled_type
                set planned_item: PlannedItem(
                    orig_item.loc,
                    orig_item.is_private,
                    orig_item.name,
                    peeled_holder.get 0,
                    orig_item.attributes
                )
            if is_stack_array_decl
                set planned_item: PlannedItem(
                    orig_item.loc,
                    orig_item.is_private,
                    orig_item.name,
                    stack_array_holder.get 0,
                    orig_item.attributes
                )

            ; Use the annotated type if present; otherwise infer from the
            ; initializer's result type so emit_variable can map_type the
            ; binding without waiting for constraint resolution. Mirrors
            ; Planner.cpp:10950-10974.
            var binding_type: PlannedType collapsed.result_type
            if planned_item.item_type <> null
                set binding_type: (*planned_item.item_type)

            ; Emit an equality constraint between the declared binding
            ; type and the collapsed initializer's result type. Solvable
            ; cases either confirm the annotation or fix the fresh var.
            ; Skipped for a stack-array decl: there is no initializer —
            ; the "collapsed" operand IS the type.
            if is_stack_array_decl = false
                this.add_equality_constraint(binding_type, collapsed.result_type, b.span)

            ; Register the local in the current scope.
            if planned_item.name <> null
            {
                let n (*planned_item.name)
                this.define_local(n, binding_type, b.binding_type.equals "var", false)
            }

            ; s93: only include the collapsed operand when there's an
            ; actual initializer. For typed-no-init `var X: T`, an empty
            ; b.operation produces a void-type placeholder from
            ; collapse_operand_sequence#; passing it through made
            ; emit_binding's `length > 0` gate true and emit_operands
            ; return null on the placeholder, which then bailed out
            ; without allocating the binding's slot. Skipping the put
            ; lets emit_binding fall through to the type-only alloca
            ; path. Mirrors stage-0 Planner.cpp:10947 where empty
            ; ValueOps produce a null `Init` field on the Binding.
            var ops_holder Vector[PlannedOperand]^rp(0)
            if rest_arr.length > 0
            {
                if is_stack_array_decl = false
                {
                    set ops_holder: Vector[PlannedOperand]^rp(1)
                    ops_holder.put(0, collapsed)
                }
            }
            PlannedBinding(
                b.span,
                b.binding_type,
                planned_item,
                &ops_holder
            )
        }

        ; ================================================================
        ; plan_action / plan_return / plan_break / plan_throw.
        ;
        ; Each wraps a Vector[Operand] into the appropriate Planned*
        ; variant. plan_action collapses its source + target operand
        ; sequences via collapse_operand_sequence (which folds binary
        ; ops, method chains, is/as, and prefix ops); result_type takes
        ; the collapsed source's type.
        ; ================================================================

        function plan_action#(rp, this: Planner, a: Action) returns PlannedAction
        {
            let planned_source_flat this.plan_operands#(a.source)
            let planned_source_collapsed this.collapse_operand_sequence#(planned_source_flat)

            let planned_target_flat this.plan_operands#(a.target)
            let planned_target_collapsed this.collapse_operand_sequence#(planned_target_flat)

            let result_type planned_source_collapsed.result_type

            var source_holder Vector[PlannedOperand]^rp(1)
            source_holder.put(0, planned_source_collapsed)

            var target_holder: ref[Vector[PlannedOperand]]? null
            if a.target.length > 0
            {
                var target_vec Vector[PlannedOperand]^rp(1)
                target_vec.put(0, planned_target_collapsed)
                set target_holder: &target_vec
            }

            ; For -g line info: take the location from the FIRST flat source
            ; operand, which carries the authoritative source span. The
            ; collapsed operand's loc is sometimes synthesized (start 0),
            ; which would emit a useless DILocation at line 0.
            var action_loc planned_source_collapsed.loc
            if planned_source_flat.length > 0
            {
                let first_op_ptr planned_source_flat.get 0
                if first_op_ptr <> null
                    set action_loc: (*first_op_ptr).loc
            }

            ; STORE vector: a ref/pointer into a Local ($) page stored into
            ; FRAME-EXTERNAL memory is a use-after-free. Frame-external = a
            ; parameter/receiver's field (`this.field`/`param.field` writes into
            ; the CALLER's object), a module global, or through a pointer deref.
            ; A same-frame local's field (`var`/`let`) dies WITH the ref -> safe.
            ; Mirrors Planner.cpp planAction store check.
            if a.target.length > 0
                if Planner.is_reference_to_local_page(planned_source_collapsed.result_type)
                {
                    var has_member false
                    if planned_target_collapsed.member_access <> null
                    {
                        let ma (*planned_target_collapsed.member_access)
                        if ma.length > (0 as size_t)
                            set has_member: true
                    }
                    var external false
                    choose planned_target_collapsed.expr
                        when v: Variable
                        {
                            if has_member
                            {
                                let lb this.lookup_local_binding(v.name)
                                if lb <> null
                                    if lb.is_parameter
                                        set external: true
                            }
                        }
                        when g: GlobalRef
                            set external: true
                        when c: Call
                            set external: true
                        else
                            0
                    if external
                        this.add_diagnostic(action_loc, String^rp("reference into a local ($) page escapes via store - allocate the target with '#' (caller page) or '^name' (region) so it outlives the use"))
                }

            PlannedAction(
                action_loc,
                &source_holder,
                target_holder,
                result_type
            )
        }

        ; Escape checker (RBMM blocker C): true for two escaping shapes:
        ;  (1) a ref[T]/pointer[T] whose POINTEE lives on a Local ($) page — the
        ;      `&` operator and resolve_type keep the pointee (with its life) in
        ;      generics[0];
        ;  (2) a VALUE whose OWN life is Local (design-B item 3) — String$()/etc
        ;      carry an internal `data` pointer into the local page, so returning
        ;      the value by copy still hands out a dangling internal pointer.
        ; A Local pointee/value dies at scope exit, so returning/storing it is a
        ; use-after-free. Call (#) and Reference (^name) lifetimes outlive the
        ; function and are fine. Mirrors Planner.cpp::isReferenceToLocalPage.
        function is_reference_to_local_page(t: PlannedType) returns bool
        {
            choose t.life
                when loc: Local
                    return true
                else
                    0
            let ptr_name String$("pointer")
            let ref_name String$("ref")
            var is_ref_like false
            if t.name.equals(ptr_name)
                set is_ref_like: true
            if is_ref_like = false
                if t.name.equals(ref_name)
                    set is_ref_like: true
            if is_ref_like
            {
                if t.generics <> null
                {
                    let gens (*t.generics)
                    if gens.length > (0 as size_t)
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            choose inner.life
                                when loc: Local
                                    return true
                                else
                                    0
                        }
                    }
                }
            }
            false
        }

        ; ================================================================
        ; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
        ;
        ; A reference into a Local ($) page passed to a callee that STORES
        ; it into frame-external memory (its `this`/param field, a global,
        ; or a pointer deref) is a use-after-free once the local page is
        ; freed at scope exit. Implemented as a POST-PASS Plan-tree walker
        ; (call discovery in ONE place rather than the many scattered
        ; PlannedCall construction sites in collapse_operand_sequence#).
        ;
        ; Two passes over every planned function body:
        ;   Pass 0 (collect): record which parameter a function stores
        ;                     frame-external, and into which destination.
        ;   Pass 1 (check):   at each call, if a local-page-ref arg is bound
        ;                     to such a param AND the destination outlives
        ;                     the arg -> hard diagnostic.
        ; Non-transitive (a param escaping only via a deeper escaping callee
        ; is not chased) — documented limitation, mirrors Planner.cpp.
        ;
        ; The walk mirrors the Emitter's body walk EXACTLY (emit_function_body
        ; -> emit_action -> emit_operands -> emit_operand / emit_statement),
        ; the only shape proven not to corrupt under stage-0 codegen.
        ; ================================================================

        ; True when `t` is a bare reference-like type (pointer[T]/ref[T]),
        ; regardless of pointee lifetime. Used at collect time on a callee's
        ; stored parameter; the local-page determination happens at the call
        ; site via is_reference_to_local_page. Mirrors isReferenceLikeType.
        function is_reference_like(t: PlannedType) returns bool
        {
            let ptr_name String$("pointer")
            if t.name.equals(ptr_name)
                return true
            let ref_name String$("ref")
            if t.name.equals(ref_name)
                return true
            false
        }

        ; True when a call's RESULT genuinely owns heap guts allocated on the
        ; passed page — i.e. the only return shape the default-to-local flip
        ; should stamp Local. Borrows/handles are EXCLUDED: pointer[T]/ref[T]
        ; (and ref[T]?/pointer[T]? under NPO, which resolve to name "ref"/
        ; "pointer") point into memory the callee already owns elsewhere, and
        ; extern LLVM-C wrapper structs (LLVMValueRef/TypeRef/MetadataRef/...)
        ; wrap LLVM-context-owned memory, not a Scaly page. Stamping any of
        ; these Local is a false escape (the flip's coarse `call_requires_page`
        ; gate fired on every class/union/wrapper return).
        function result_owns_page_guts(t: PlannedType) returns bool
        {
            if Planner.is_reference_like(t)
                return false
            if t.name.starts_with("LLVM")
                return false
            ; ref[T]?/pointer[T]? are modeled as Option[ref[T]]/Option[pointer[T]]
            ; (Modeler.handle_type# wraps an optional in Option[..]); under NPO
            ; that is a nullable borrow — exclude when the Option's inner is
            ; reference-like. Option[value] (e.g. String?) DOES own guts -> keep.
            if t.name.equals("Option")
            {
                if t.generics <> null
                {
                    let gens (*t.generics)
                    if gens.length > (0 as size_t)
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            if Planner.is_reference_like(inner)
                                return false
                        }
                    }
                }
            }
            true
        }

        ; Index of a parameter named `name` in the CURRENT function's Input
        ; (re-fetched via escape_fn_index), or -1. Excludes the page param
        ; (which is not part of the arg<->param mapping), matching the C++
        ; CalleeParamNames (Input only).
        function escape_param_index_current(this: Planner, name: String) returns int
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return -1
            if fp.input = null
                return -1
            var i: size_t 0
            while i < fp.input.length
            {
                let it_ptr fp.input.get i
                if it_ptr <> null
                {
                    let nm_ptr it_ptr.name
                    if nm_ptr <> null
                    {
                        let nm (*nm_ptr)
                        if nm.equals(name)
                            return (i as int)
                    }
                }
                set i: i + 1
            }
            -1
        }

        ; The current function's Input length (the callee param count recorded
        ; in a summary entry; used to right-align a call's args).
        function escape_current_param_count(this: Planner) returns size_t
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return 0
            if fp.input = null
                return 0
            fp.input.length
        }

        ; True when `name` is a parameter (or page receiver) of the CURRENT
        ; function — i.e. caller-provided memory that outlives this frame.
        ; Mirrors the EscapeFnParams membership test (Input + PageParam).
        function escape_name_is_current_param(this: Planner, name: String) returns bool
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return false
            if fp.page_parameter <> null
            {
                let pp (*fp.page_parameter)
                if pp.equals(name)
                    return true
            }
            if fp.input = null
                return false
            var i: size_t 0
            while i < fp.input.length
            {
                let it_ptr fp.input.get i
                if it_ptr <> null
                {
                    let nm_ptr it_ptr.name
                    if nm_ptr <> null
                    {
                        let nm (*nm_ptr)
                        if nm.equals(name)
                            return true
                    }
                }
                set i: i + 1
            }
            false
        }

        ; A destination arg outlives the (local-page) arg passed alongside it
        ; when it refers to memory living beyond the current frame: a parameter
        ; of the current function, or a #/^ allocated value, or a module
        ; global. A same-frame $/stack local dies WITH the arg -> safe.
        ; Mirrors Planner.cpp::escapeDestArgOutlives.
        function escape_dest_arg_outlives(this: Planner, op: PlannedOperand) returns bool
        {
            choose op.expr
                when v: Variable
                {
                    if this.escape_name_is_current_param(v.name)
                        return true
                    choose op.result_type.life
                        when c: Call
                            return true
                        when r: Reference
                            return true
                        else
                            0
                    choose v.variable_type.life
                        when c: Call
                            return true
                        when r: Reference
                            return true
                        else
                            0
                    return false
                }
                when g: GlobalRef
                    return true
                else
                    0
            false
        }

        ; Pass 0: at a frame-external store of a current-function parameter
        ; reference, record a summary entry. Reuses the Vector-2 store shape
        ; (value = a bare reference-like param; target = param.field / global
        ; / deref). Runs only in collect mode.
        function escape_handle_store(this: Planner, act: PlannedAction)
        {
            if escape_checking
                return
            if act.source = null
                return
            if act.target = null
                return
            if act.source.length = 0
                return
            if act.target.length = 0
                return
            let val_ptr act.source.get 0
            if val_ptr = null
                return
            let tgt_ptr act.target.get 0
            if tgt_ptr = null
                return
            let val val_ptr.unwrap()
            let tgt tgt_ptr.unwrap()

            ; Value must be a bare reference-like PARAMETER of the current fn.
            var stored_param_index: int -1
            choose val.expr
                when v: Variable
                {
                    var val_has_member false
                    if val.member_access <> null
                    {
                        let vma (*val.member_access)
                        if vma.length > (0 as size_t)
                            set val_has_member: true
                    }
                    if val_has_member = false
                    {
                        if Planner.is_reference_like(val.result_type)
                            set stored_param_index: this.escape_param_index_current(v.name)
                    }
                }
                else
                    0
            if stored_param_index < 0
                return

            ; Destination: a param's `.field` (dest_kind 0) / global / deref
            ; (dest_kind 1). A bare reassignment or same-frame local.field is
            ; not frame-external -> skip.
            var dest_kind: int -1
            var dest_index: int 0
            choose tgt.expr
                when tv: Variable
                {
                    var tgt_has_member false
                    if tgt.member_access <> null
                    {
                        let tma (*tgt.member_access)
                        if tma.length > (0 as size_t)
                            set tgt_has_member: true
                    }
                    if tgt_has_member
                    {
                        let ti this.escape_param_index_current(tv.name)
                        if ti >= 0
                        {
                            set dest_kind: 0
                            set dest_index: ti
                        }
                    }
                }
                when g: GlobalRef
                    set dest_kind: 1
                when c: Call
                    set dest_kind: 1
                else
                    0
            if dest_kind < 0
                return

            let cpc this.escape_current_param_count()
            escape_records.add(EscapeRecord(
                escape_fn_index,
                cpc,
                (stored_param_index as size_t),
                (dest_kind as size_t),
                (dest_index as size_t)
            ))
        }

        ; Pass 1: check one call against one summary entry.
        function escape_check_call_record(this: Planner, call: PlannedCall, rec: EscapeRecord)
        {
            if escape_found
                return
            let callee instantiated_functions.get rec.callee_fn_index
            if callee = null
                return
            if callee.mangled_name.equals(call.mangled_name) = false
                return
            if call.args = null
                return
            if call.args.length < rec.callee_param_count
                return
            let off call.args.length - rec.callee_param_count
            let arg_idx off + rec.param_index
            if arg_idx >= call.args.length
                return
            let arg_ptr call.args.get arg_idx
            if arg_ptr = null
                return
            let arg arg_ptr.unwrap()
            if Planner.is_reference_to_local_page(arg.result_type)
            {
                var violates false
                if rec.dest_kind = 1
                    set violates: true
                if rec.dest_kind = 0
                {
                    let dest_idx off + rec.dest_index
                    if dest_idx < call.args.length
                    {
                        let dest_ptr call.args.get dest_idx
                        if dest_ptr <> null
                            set violates: this.escape_dest_arg_outlives(dest_ptr.unwrap())
                    }
                }
                if violates
                {
                    ; The post-pass runs after plan_module# restored this.file,
                    ; so set it to the calling function's own file (re-fetched
                    ; via escape_fn_index) before reporting — else the offset is
                    ; formatted against the stale entry file.
                    let cur_fn instantiated_functions.get escape_fn_index
                    if cur_fn <> null
                        set this.file: String^this(cur_fn.file)
                    this.add_diagnostic(call.loc, String^this("reference into a local ($) page escapes via call - the callee stores it into memory that outlives this frame; allocate with '#' (caller page) or '^name' (region)"))
                    set escape_found: true
                }
            }
        }

        ; Pass 1: a call may match several summary entries (e.g. two escaping
        ; params); check each.
        function escape_handle_call(this: Planner, call: PlannedCall)
        {
            if escape_checking = false
                return
            if escape_found
                return
            if call.args = null
                return
            var ri: size_t 0
            while ri < escape_records.length
            {
                if escape_found
                    return
                let rec_ptr escape_records.get ri
                if rec_ptr <> null
                    this.escape_check_call_record(call, (*rec_ptr))
                set ri: ri + 1
            }
        }

        ; Walk all operands in a (nullable) operand vector. Takes the
        ; ref[Vector]? field directly + auto-derefs (a by-value Vector param
        ; corrupts .length). Element passed by value via .unwrap(), mirroring
        ; emit_operands -> emit_operand(first.unwrap()).
        function escape_walk_operands(this: Planner, ops: ref[Vector[PlannedOperand]]?)
        {
            if escape_found
                return
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                if escape_found
                    return
                let op_ptr ops.get i
                if op_ptr <> null
                    this.escape_walk_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        ; Walk one statement reached through a ref[PlannedStatement]? field.
        function escape_walk_statement_ref(this: Planner, stmt: ref[PlannedStatement]?)
        {
            if escape_found
                return
            if stmt <> null
            {
                let s stmt
                this.escape_walk_statement((*s))
            }
        }

        ; Walk one operand by value. choose op.expr mirrors emit_operand;
        ; the recursive arms mirror Planner.cpp::escapeWalkOperand.
        function escape_walk_operand(this: Planner, op: PlannedOperand)
        {
            if escape_found
                return
            choose op.expr
                when call: Call
                {
                    this.escape_handle_call(call)
                    this.escape_walk_operands(call.args)
                }
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.escape_walk_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.escape_walk_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.escape_walk_operands(iff.condition)
                    this.escape_walk_statement_ref(iff.consequent)
                    this.escape_walk_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.escape_walk_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.escape_walk_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.escape_walk_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.escape_walk_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.escape_walk_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.escape_walk_operands(fr.expr)
                    this.escape_walk_action(fr.body)
                }
                when wh: While
                {
                    this.escape_walk_operands(wh.cond.operation)
                    this.escape_walk_action(wh.body)
                }
                when tr: Try
                {
                    this.escape_walk_operands(tr.cond.operation)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.escape_walk_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(tr.alternative)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.escape_walk_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.escape_walk_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.escape_walk_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.escape_walk_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                else
                    0
        }

        ; Walk one statement by value. choose stmt mirrors emit_statement.
        function escape_walk_statement(this: Planner, stmt: PlannedStatement)
        {
            if escape_found
                return
            choose stmt
                when action: Action
                    this.escape_walk_action(action)
                when binding: Binding
                    this.escape_walk_operands(binding.operation)
                when ret: Return
                    this.escape_walk_operands(ret.result)
                when throw_stmt: Throw
                    this.escape_walk_operands(throw_stmt.result)
                when brk: Break
                    this.escape_walk_operands(brk.result)
                when cont: Continue
                    0
        }

        ; Walk one action by value (the whole PlannedAction, mirroring
        ; emit_action(action)). Handle the store first, then recurse into
        ; the source/target operand vectors.
        function escape_walk_action(this: Planner, act: PlannedAction)
        {
            if escape_found
                return
            this.escape_handle_store(act)
            this.escape_walk_operands(act.source)
            this.escape_walk_operands(act.target)
        }

        ; Walk one function body. Mirrors emit_function_body: choose func.impl
        ; and feed the whole Action by value to escape_walk_action.
        function escape_walk_function_body(this: Planner, func: PlannedFunction)
        {
            choose func.impl
                when action: Action
                    this.escape_walk_action(action)
                else
                    0
        }

        ; Post-pass entry: two passes over instantiated_functions.
        function check_interprocedural_escapes(this: Planner)
        {
            ; Pass 0: build the escape summary.
            set escape_checking: false
            set escape_found: false
            var i: size_t 0
            for func in instantiated_functions
            {
                set escape_fn_index: i
                this.escape_walk_function_body(func)
                set i: i + 1
            }

            ; Clean code records nothing -> nothing to check.
            if escape_records.length = 0
                return

            ; Pass 1: check every call against the summary.
            set escape_checking: true
            var j: size_t 0
            for func in instantiated_functions
            {
                if escape_found = false
                {
                    set escape_fn_index: j
                    this.escape_walk_function_body(func)
                }
                set j: j + 1
            }
        }

        function plan_return#(rp, this: Planner, r: Return) returns PlannedReturn
        {
            ; GAP B: `return \x: …` where the function's return type is a delegate
            ; yields an ESCAPING closure — env on the caller page (`#`) so it
            ; outlives this frame. Mirrors the typed-binding closure path, but
            ; with Lifetime.Call instead of Local.
            if this.current_return_type <> null
            {
                let crt (*this.current_return_type)
                if this.is_delegate_type(crt.name)
                    if r.result.length = 1
                    {
                        let r0_ptr r.result.get 0
                        if r0_ptr <> null
                            choose (*r0_ptr).expression
                                when rl: Lambda
                                {
                                    let dparams this.delegate_param_types#(crt.name)
                                    let dret this.delegate_return_type#(crt.name)
                                    let rlam_id next_lambda_id
                                    set next_lambda_id: rlam_id + 1
                                    var rb_sb StringBuilder^rp()
                                    rb_sb.append "ret"
                                    rb_sb.append size_to_string(rlam_id)
                                    let rbase rb_sb.to_string^rp()
                                    let rclo this.make_closure#(rbase, rl, dparams, dret, crt, Lifetime.Call(scalyc.compiler.Model.Call(r.span)))
                                    let rclo_op PlannedOperand(r.span, PlannedExpression.Closure rclo, null, crt)
                                    var rh Vector[PlannedOperand]^rp(1)
                                    rh.put(0, rclo_op)
                                    return PlannedReturn(r.span, &rh)
                                }
                                else
                                    0
                    }
            }

            ; GAP B escape check: returning a local (stack) closure dangles —
            ; its record lives on this frame. Flag it (mirrors the design's
            ; escape-as-compile-error) and point at the working alternative:
            ; return the lambda DIRECTLY so it allocates on the caller page.
            if r.result.length = 1
            {
                let er0_ptr r.result.get 0
                if er0_ptr <> null
                    choose (*er0_ptr).expression
                        when ev: scalyc.compiler.Model.Type
                        {
                            if ev.name.length = 1
                            {
                                let evn_ptr ev.name.get 0
                                if evn_ptr <> null
                                {
                                    var is_stack_closure: bool false
                                    var lci: size_t 0
                                    while lci < local_closure_names.length
                                    {
                                        let lcn_ptr local_closure_names.get lci
                                        if lcn_ptr <> null
                                            if (*lcn_ptr).equals((*evn_ptr))
                                                set is_stack_closure: true
                                        set lci: lci + 1
                                    }
                                    if is_stack_closure
                                        this.add_diagnostic(r.span, String^rp("a closure bound to a local lives on the stack frame and cannot be returned - return the lambda directly (return \\x: ...) so it is allocated on the caller's region"))
                                }
                            }
                        }
                        else
                            0
            }

            let planned_flat this.plan_operands#(r.result)
            let planned_collapsed this.collapse_operand_sequence#(planned_flat)

            ; A returned ref/pointer into a Local ($) page escapes -> hard error.
            if planned_flat.length > 0
                if Planner.is_reference_to_local_page(planned_collapsed.result_type)
                    this.add_diagnostic(r.span, String^rp("reference into a local ($) page escapes via return - allocate the target with '#' (caller page) or '^name' (region) so it outlives the use"))

            var holder Vector[PlannedOperand]^rp(1)
            if planned_flat.length > 0
                holder.put(0, planned_collapsed)
            PlannedReturn(r.span, &holder)
        }

        function plan_break#(rp, this: Planner, b: Break) returns PlannedBreak
        {
            ; Collapse the operand sequence so a break value like `break -1`
            ; or `break parse(line)` folds into a single typed operand (same
            ; reason plan_throw# collapses) — emit_break stores result[0] and
            ; the repeat's value type is read from result[0].result_type.
            let planned_flat this.plan_operands#(b.result)
            if planned_flat.length = 0
            {
                var empty_holder Vector[PlannedOperand]^rp(planned_flat)
                return PlannedBreak(b.span, &empty_holder, b.loop_label)
            }
            let planned_collapsed this.collapse_operand_sequence#(planned_flat)
            var holder Vector[PlannedOperand]^rp(1)
            holder.put(0, planned_collapsed)
            PlannedBreak(b.span, &holder, b.loop_label)
        }

        function plan_throw#(rp, this: Planner, t: Throw) returns PlannedThrow
        {
            ; Collapse the operand sequence the same way plan_return# does.
            ; A thrown value like `MyError.Different(DifferentSyntax())` arrives
            ; as multiple flat operands ([MyError.Different, (DifferentSyntax())])
            ; that must be folded into a single PlannedCall (variant
            ; construction). emit_operands only emits ops.get(0), so without
            ; the collapse only the bare type reference survives and emit_throw
            ; drops the error value entirely (status byte stored, data left
            ; uninitialised → caller reads a garbage variant tag).
            let planned_flat this.plan_operands#(t.result)
            let planned_collapsed this.collapse_operand_sequence#(planned_flat)
            var holder Vector[PlannedOperand]^rp(1)
            if planned_flat.length > 0
                holder.put(0, planned_collapsed)
            PlannedThrow(t.span, &holder)
        }

        ; ================================================================
        ; plan_statement: Model.Statement → Plan.PlannedStatement.
        ; Dispatches over the Statement union and delegates to the
        ; variant-specific plan_* method. `Continue` is trivial — just
        ; carries the location.
        ; ================================================================
        function plan_statement#(rp, this: Planner, s: Statement) returns PlannedStatement
        {
            choose s
                when a: Action
                    PlannedStatement.Action(this.plan_action#(a))
                when b: Binding
                    PlannedStatement.Binding(this.plan_binding#(b))
                when br: Break
                    PlannedStatement.Break(this.plan_break#(br))
                when c: Continue
                    PlannedStatement.Continue(PlannedContinue(c.span, c.loop_label))
                when r: Return
                    PlannedStatement.Return(this.plan_return#(r))
                when t: Throw
                    PlannedStatement.Throw(this.plan_throw#(t))
        }

        ; plan_statements: batch plan_statement over a Model.Block's statements.
        function plan_statements#(
            rp,
            this: Planner,
            stmts: Vector[Statement]
        ) returns Vector[PlannedStatement]
        {
            var result Vector[PlannedStatement]^rp(stmts.length)
            var i: size_t 0
            while i < stmts.length
            {
                let s_ptr stmts.get i
                if s_ptr <> null
                {
                    let s (*s_ptr)
                    let pl this.plan_statement#(s)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_block: push a fresh scope, plan every statement, pop.
        ; After planning, scan the planned statements for any operand
        ; carrying a Local lifetime — that's the signal that a `$`
        ; allocation happened in this block and the emitter must emit
        ; page-cleanup on exit.
        ; ================================================================
        function plan_block#(rp, this: Planner, b: Block) returns PlannedBlock
        {
            this.push_scope()
            let planned_stmts this.plan_statements#(b.statements)
            this.pop_scope()

            var has_local: bool false
            var si: size_t 0
            while si < planned_stmts.length
            {
                let s_ptr planned_stmts.get si
                if s_ptr <> null
                {
                    if Planner.statement_has_local_lifetime((*s_ptr))
                        set has_local: true
                }
                set si: si + 1
            }

            var stmts_holder Vector[PlannedStatement]^rp(planned_stmts)
            PlannedBlock(b.span, &stmts_holder, has_local)
        }

        ; has_local_lifetime: true iff `t` is a $-allocation marker
        ; (Lifetime.Local). Value types with Unspecified lifetime stay
        ; stack-resident and don't need page cleanup.
        function has_local_lifetime(t: PlannedType) returns bool
        {
            choose t.life
                when l: Local
                    true
                else
                    false
        }

        ; operand_has_local_lifetime: true iff the operand's own type or
        ; any of its planned call args / tuple components carries a
        ; Local lifetime. Does not descend into nested blocks — those
        ; own their own needs_local_page_cleanup flag.
        function operand_has_local_lifetime(op: PlannedOperand) returns bool
        {
            if Planner.has_local_lifetime(op.result_type)
                return true

            choose op.expr
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*a_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when tup: PlannedTuple
                {
                    if Planner.has_local_lifetime(tup.tuple_type)
                        return true
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                if c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get j
                                        if v_ptr <> null
                                        {
                                            if Planner.operand_has_local_lifetime((*v_ptr))
                                                return true
                                        }
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; statement_has_local_lifetime: scan the operands inside a
        ; PlannedStatement for any Local-lifetime marker.
        function statement_has_local_lifetime(s: PlannedStatement) returns bool
        {
            choose s
                when a: PlannedAction
                {
                    if a.source <> null
                    {
                        let src (*a.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when b: PlannedBinding
                {
                    if b.operation <> null
                    {
                        let ops (*b.operation)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when r: PlannedReturn
                {
                    if r.result <> null
                    {
                        let ops (*r.result)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; ================================================================
        ; plan_property: Model.Property → Plan.PlannedProperty.
        ;
        ; `mangled_name` is left empty here — the planner enclosing the
        ; struct sets it once the struct's own mangled name is known.
        ; `offset` is 0 until compute_property_offsets runs as part of
        ; the enclosing struct's layout pass.
        ; ================================================================
        function plan_property#(rp, this: Planner, p: Property) returns PlannedProperty
        {
            var prop_type: PlannedType this.fresh_type_var#(String$(""))
            if p.type <> null
            {
                let t (*p.type)
                set prop_type: this.plan_type#(t)
            }

            var initializer_ref: ref[Vector[PlannedOperand]]? null
            if p.initializer <> null
            {
                let init_ops (*p.initializer)
                let planned_init this.plan_operands#(init_ops)
                var init_holder Vector[PlannedOperand]^rp(planned_init)
                set initializer_ref: &init_holder
            }

            let mangled Planner.encode_name(p.name)

            PlannedProperty(
                p.span,
                p.private_,
                p.name,
                mangled,
                prop_type,
                initializer_ref,
                null,
                0
            )
        }

        ; plan_implementation: Implementation variant → PlannedImplementation.
        ; Extern/Instruction/Intrinsic are trivially tagged wrappers;
        ; Action delegates to plan_action which in turn plans its source
        ; and target operand lists.
        function plan_implementation#(rp, this: Planner, impl: Implementation) returns PlannedImplementation
        {
            choose impl
                when a: Action
                    PlannedImplementation.Action(this.plan_action#(a))
                when e: Extern
                    PlannedImplementation.Extern(PlannedExternImpl e.span)
                when i: Instruction
                    PlannedImplementation.Instruction(PlannedInstructionImpl i.span)
                when n: Intrinsic
                    PlannedImplementation.Intrinsic(PlannedIntrinsicImpl n.span)
        }

        ; ================================================================
        ; plan_function: Model.Function → Plan.PlannedFunction.
        ;
        ; Opens a new scope, registers each parameter as a local, plans
        ; the return/throws types, and plans the implementation.
        ; Computes:
        ;   - mangled_name (Itanium ABI via mangle_function)
        ;   - can_throw (set iff throws_type is present)
        ;   - needs_local_page (scan body for Local-lifetime ops)
        ;   - has_page (page parameter present or implicit return alloc)
        ; `origin` (instantiation source) and `scheme` (post-solver
        ; type scheme) remain null for now.
        ; ================================================================
        function plan_function#(
            rp,
            this: Planner,
            f: Function,
            parent: ref[PlannedType]?
        ) returns PlannedFunction
        {
            this.push_scope()

            ; For generic functions with no explicit instantiation,
            ; seed each type parameter with a fresh type variable so
            ; plan_type can resolve `T` etc. to something unifiable.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < f.parameters.length
            {
                let gp_ptr f.parameters.get gi
                if gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    if existing = null
                    {
                        let fresh this.fresh_type_var#(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items#(f.input)

            ; Patch `this` parameter to carry the enclosing type. The Modeler
            ; produces an Item with no explicit type for `this`, so plan_item#
            ; returns a PlannedItem with item_type=null. Without this patch,
            ; emit_function_decl skips `this` (no item_type → no LLVMTypeRef
            ; pushed) and LLVMGetParam later crashes on a null Argument type.
            ; Mirrors Planner.cpp:11765-11778.
            if parent <> null
            {
                var ti: size_t 0
                while ti < planned_input.length
                {
                    let item_ptr planned_input.get ti
                    if item_ptr <> null
                    {
                        let item (*item_ptr)
                        if item.name <> null
                        {
                            if item.item_type = null
                            {
                                let n (*item.name)
                                if n.equals(String$("this"))
                                {
                                    let p (*parent)
                                    var type_holder Vector[PlannedType]^rp(1)
                                    type_holder.put(0, p)
                                    var patched item
                                    set patched.item_type: type_holder.get(0)
                                    planned_input.put(ti, patched)
                                }
                            }
                        }
                    }
                    set ti: ti + 1
                }
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            ; For 'this', the local-scope binding should be
                            ; pointer[T] (struct-by-pointer ABI), so field
                            ; access auto-derefs. Mirrors Planner.cpp:11781-11790.
                            if n.equals(String$("this"))
                            {
                                let ptr_t Planner.make_pointer_type#(t)
                                this.define_parameter(n, ptr_t)
                            }
                            if n.equals(String$("this")) = false
                                this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            ; s152: register the implicit page parameter (function#'s `rp`)
            ; as a pointer[Page] local so the body can pass it as an explicit
            ; value argument — e.g. `file_path.substring(rp, start, length)`.
            ; Without this `rp` doesn't resolve as a variable,
            ; plan_type_operand# mis-plans the operand, and emit_call drops
            ; the entire call (its arg emits a null handle, line ~3285).
            ; Symptom: extract_program_name#'s implicit-return substring was
            ; silently elided (bare `ret void`). Mirrors stage-0's page-param
            ; binding in planFunction (Planner.cpp implicit `rp`).
            if f.page_parameter <> null
            {
                let pp_ref f.page_parameter
                let pp_name (*pp_ref)
                let pp_page_ty PlannedType(
                    f.span,
                    String^rp("Page"),
                    String^rp(""),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
                let pp_ptr_ty Planner.make_pointer_type#(pp_page_ty)
                this.define_parameter(pp_name, pp_ptr_ty)
            }

            var return_type: ref[PlannedType]? null
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                let planned_rt this.plan_type#(rt)
                var rt_holder Vector[PlannedType]^rp(1)
                rt_holder.put(0, planned_rt)
                set return_type: rt_holder.get(0)
            }

            var throws_type: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                let planned_tt this.plan_type#(tt)
                var tt_holder Vector[PlannedType]^rp(1)
                tt_holder.put(0, planned_tt)
                set throws_type: tt_holder.get(0)
            }

            ; GAP B: expose the return type to the body so a returned lambda
            ; becomes an escaping closure (env on the caller page). Track stack
            ; closures bound in this function for the return-escape check; the
            ; set is truncated back at the boundary so nested functions are
            ; isolated.
            let saved_return_type this.current_return_type
            set this.current_return_type: return_type
            let saved_lcn local_closure_names.length
            let planned_impl this.plan_implementation#(f.implementation)
            set local_closure_names.length: saved_lcn
            set this.current_return_type: saved_return_type

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            var input_holder Vector[PlannedItem]^rp(planned_input)

            ; Compute the Itanium mangled name. For a free function this
            ; is `_Z<name-len><name><params>`; for methods (parent
            ; non-null) it's `_ZN<parent><name>E<params>`. function#
            ; sites prepend an implicit page parameter; functions that
            ; return a user-defined type also need the caller's page to
            ; allocate the result (needs_implicit_return_page).
            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            if Planner.needs_implicit_return_page(f)
                set has_page: true

            ; Extern C functions keep their unmangled name so LLVM can
            ; resolve them against libc / system libraries. Mirrors
            ; Planner.cpp:11806-11808's IsExtern ? Func.Name : mangle.
            var mangled_holder Vector[String]^rp(1)
            if Planner.is_extern_impl(f.implementation)
                mangled_holder.put(0, String#(f.name))
            if Planner.is_extern_impl(f.implementation) = false
                mangled_holder.put(0, Planner.mangle_function#(f.name, &input_holder, parent, has_page))
            let mangled (*mangled_holder.get(0))

            var can_throw: bool false
            if throws_type <> null
                set can_throw: true

            ; needs_local_page: true iff the Action body contains any $
            ; allocation (Lifetime.Local on some operand's type). Used
            ; by the Emitter to emit page-cleanup on function exit.
            var needs_local_page: bool false
            choose planned_impl
                when ia: PlannedAction
                {
                    if ia.source <> null
                    {
                        let src (*ia.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    set needs_local_page: true
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0

            ; Propagate the page_parameter ref so emit_function_decl can
            ; prepend the implicit `rp: pointer[Page]` LLVM arg. Without
            ; this, `function#(x: T)` mangles correctly (PN4scaly...) but
            ; the LLVM signature drops the rp slot and stage-1 callers
            ; that pass `rp` first end up loading the wrong arg.
            ;
            ; s131: also set page_param_ref when needs_implicit_return_page
            ; is true (return-by-page allocation injects an implicit page
            ; arg the same way `#` does). Without this, the mangled name
            ; includes `PN4scaly6memory4PageE` (via has_page above) but the
            ; PlannedFunction's page_parameter stays null. emit_function_decl
            ; then computes page_offset=0 and emits 3 LLVM params instead
            ; of 4 — emit_function_body's variable-binding loop then maps
            ; user params (this, i) to LLVMGetParam(1, 2), which actually
            ; correspond to the page + this slots in the 4-arg LLVM
            ; signature created by the s78/s83 extern-decl path (which
            ; sees requires_page_param=true via MethodMatch). Symptom:
            ; `Vector.get` body's `data + i` emits `add ptr %data, %2`
            ; where %2 is the this-ptr slot, not the i index.
            var page_param_ref: ref[String]? null
            if f.page_parameter <> null
            {
                var pp_holder Vector[String]^rp(1)
                pp_holder.put(0, String^rp((*f.page_parameter)))
                set page_param_ref: pp_holder.get(0)
            }
            if f.page_parameter = null
            {
                if Planner.needs_implicit_return_page(f)
                {
                    var pp_holder Vector[String]^rp(1)
                    pp_holder.put(0, String^rp("rp"))
                    set page_param_ref: pp_holder.get(0)
                }
            }

            let result PlannedFunction(
                f.span,
                f.private_,
                f.pure,
                f.name,
                mangled,
                page_param_ref,
                &input_holder,
                return_type,
                throws_type,
                f.lifetime,
                planned_impl,
                null,
                needs_local_page,
                can_throw,
                null,
                this.file
            )
            this.record_function(result)
            result
        }

        ; plan_initializer: Model.Initializer → Plan.PlannedInitializer.
        ; An initializer is like a function without name / returns_ / throws_ /
        ; lifetime. Parameters open a new scope, implementation is planned,
        ; scope closed.
        ;
        ; s81: also synthesizes a PlannedFunction wrapper for the init
        ; body and records it in instantiated_functions so emit_function_decl
        ; / emit_function_body produce the C1 ctor body. The wrapper's
        ; LLVM signature is [this: parent, page (if init#), ...user_args]
        ; — page_parameter on the wrapper is left null to avoid the
        ; emit_function_decl page-prepend; the page slot is just a
        ; regular input item.
        function plan_initializer#(
            rp,
            this: Planner,
            ini: Initializer,
            parent: ref[PlannedType]?
        ) returns PlannedInitializer
        {
            this.push_scope()

            let planned_input this.plan_items#(ini.input)

            ; s81: define `page` as `pointer[scaly.memory.Page]` so
            ; bare `page.allocate(...)` in the init body resolves.
            ; Mirrors Planner.cpp:12048-12061.
            if ini.page_parameter <> null
            {
                let page_struct_ty PlannedType(
                    ini.span,
                    String^rp("scaly.memory.Page"),
                    String^rp("N4scaly6memory4PageE"),
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    String^rp(""),
                    null
                )
                let page_ptr_ty Planner.make_pointer_type#(page_struct_ty)
                this.define_parameter((*ini.page_parameter), page_ptr_ty)
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            ; s81: define `this` as `pointer[parent]` so bare-field
            ; access in the init body (`set data: ...`) is rewritten
            ; via the implicit-property-access path at Planner.scaly
            ; line ~4347. Mirrors Planner.cpp:12082-12088.
            if parent <> null
            {
                let p (*parent)
                let this_ptr_ty Planner.make_pointer_type#(p)
                this.define_parameter(String$("this"), this_ptr_ty)
            }

            let planned_impl this.plan_implementation#(ini.implementation)

            this.pop_scope()

            var input_holder Vector[PlannedItem]^rp(planned_input)

            ; init#(page, ...) requires the mangled symbol to carry a
            ; leading size_t "page" parameter so LLVM signatures match
            ; what emit-site call resolution expects. When parent is
            ; non-null the initializer mangles as a method of that type
            ; (Itanium `_ZN<parent>initE<params>`).
            var has_page: bool false
            if ini.page_parameter <> null
                set has_page: true

            let mangled Planner.mangle_function#(
                String$("init"), &input_holder, parent, has_page
            )

            ; Clone the page_parameter name into rp so the resulting
            ; PlannedInitializer owns a stable reference.
            var page_ref: ref[String]? null
            if ini.page_parameter <> null
            {
                var holder Vector[String]^rp(1)
                holder.put(0, String^rp((*ini.page_parameter)))
                set page_ref: holder.get(0)
            }

            let result_ini PlannedInitializer(
                ini.span,
                ini.private_,
                page_ref,
                mangled,
                &input_holder,
                planned_impl
            )

            ; s81: synthesize a PlannedFunction body wrapper and record
            ; it so emit_function_decl/body produce the C1 ctor body.
            ; Skip when impl is Extern/Intrinsic (no body to emit) or
            ; when parent is null (free-floating init# isn't a thing).
            choose planned_impl
                when ia: PlannedAction
                {
                    if parent <> null
                    {
                        let p (*parent)
                        var synth_items Array[PlannedItem]$()

                        var this_name_holder Vector[String]^rp(1)
                        this_name_holder.put(0, String^rp("this"))
                        var this_ty_holder Vector[PlannedType]^rp(1)
                        this_ty_holder.put(0, p)
                        synth_items.add(PlannedItem(
                            ini.span,
                            false,
                            this_name_holder.get 0,
                            this_ty_holder.get 0,
                            null
                        ))

                        if ini.page_parameter <> null
                        {
                            let page_struct_ty PlannedType(
                                ini.span,
                                String^rp("scaly.memory.Page"),
                                String^rp("N4scaly6memory4PageE"),
                                null,
                                Lifetime.Unspecified(Unspecified()),
                                null,
                                String^rp(""),
                                null
                            )
                            let page_ptr_ty Planner.make_pointer_type#(page_struct_ty)
                            var page_ty_holder Vector[PlannedType]^rp(1)
                            page_ty_holder.put(0, page_ptr_ty)

                            var page_name_holder Vector[String]^rp(1)
                            page_name_holder.put(0, String^rp((*ini.page_parameter)))

                            synth_items.add(PlannedItem(
                                ini.span,
                                false,
                                page_name_holder.get 0,
                                page_ty_holder.get 0,
                                null
                            ))
                        }

                        var ui: size_t 0
                        while ui < planned_input.length
                        {
                            let pi_ptr planned_input.get ui
                            if pi_ptr <> null
                                synth_items.add((*pi_ptr))
                            set ui: ui + 1
                        }

                        var synth_input_holder Vector[PlannedItem]^rp(synth_items)

                        let synth_fn PlannedFunction(
                            ini.span,
                            ini.private_,
                            false,
                            String^rp("init"),
                            mangled,
                            null,
                            &synth_input_holder,
                            null,
                            null,
                            Lifetime.Unspecified(Unspecified()),
                            planned_impl,
                            null,
                            false,
                            false,
                            null,
                            this.file
                        )
                        this.record_function(synth_fn)
                    }
                    0
                }
                else
                    0

            result_ini
        }

        ; plan_deinitializer: Model.DeInitializer → Plan.PlannedDeInitializer.
        ; Even simpler than plan_initializer — no parameters.
        function plan_deinitializer#(
            rp,
            this: Planner,
            dei: DeInitializer,
            parent: ref[PlannedType]?
        ) returns PlannedDeInitializer
        {
            let planned_impl this.plan_implementation#(dei.implementation)
            ; Mangle as a method of `parent` named "deinit" (Itanium
            ; `_ZN<parent>6deinitEv`); bare deinit for a free context.
            let mangled Planner.mangle_function#(
                String$("deinit"), null, parent, false
            )
            PlannedDeInitializer(
                dei.span,
                mangled,
                planned_impl
            )
        }

        ; plan_operator: Model.Operator → Plan.PlannedOperator.
        ; Structurally identical to plan_function modulo the two missing
        ; fields (no `pure`, no `lifetime`).
        function plan_operator#(
            rp,
            this: Planner,
            op: Operator,
            parent: ref[PlannedType]?
        ) returns PlannedOperator
        {
            this.push_scope()

            ; Seed generic type parameters with fresh type variables.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < op.parameters.length
            {
                let gp_ptr op.parameters.get gi
                if gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    if existing = null
                    {
                        let fresh this.fresh_type_var#(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items#(op.input)

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            var return_type: ref[PlannedType]? null
            if op.returns_ <> null
            {
                let rt (*op.returns_)
                let planned_rt this.plan_type#(rt)
                var rt_holder Vector[PlannedType]^rp(1)
                rt_holder.put(0, planned_rt)
                set return_type: rt_holder.get(0)
            }

            var throws_type: ref[PlannedType]? null
            if op.throws_ <> null
            {
                let tt (*op.throws_)
                let planned_tt this.plan_type#(tt)
                var tt_holder Vector[PlannedType]^rp(1)
                tt_holder.put(0, planned_tt)
                set throws_type: tt_holder.get(0)
            }

            let planned_impl this.plan_implementation#(op.implementation)

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            var input_holder Vector[PlannedItem]^rp(planned_input)
            let mangled Planner.mangle_operator#(op.name, &input_holder, parent)
            PlannedOperator(
                op.span,
                op.private_,
                op.name,
                mangled,
                &input_holder,
                return_type,
                throws_type,
                planned_impl,
                null,
                null
            )
        }

        ; plan_variant: Model.Variant → Plan.PlannedVariant.
        ; The tag is assigned by the caller (variants need sequential tags
        ; within the union; we can't see sibling variants from here).
        ; `mangled_name` is left empty for the same reason as
        ; plan_property.
        function plan_variant#(rp, this: Planner, v: Variant, tag: int) returns PlannedVariant
        {
            var var_type: ref[PlannedType]? null
            if v.type <> null
            {
                let t (*v.type)
                let planned this.plan_type#(t)
                var holder Vector[PlannedType]^rp(1)
                holder.put(0, planned)
                set var_type: holder.get(0)
            }

            let mangled Planner.encode_name(v.name)

            PlannedVariant(
                v.span,
                v.name,
                mangled,
                var_type,
                null,
                tag
            )
        }

        ; ================================================================
        ; plan_structure: Model.Structure → Plan.PlannedStructure.
        ;
        ; Plans every property, computes struct size/alignment (simple
        ; "size == alignment per primitive" model), then plans all
        ; members: methods (Function), operators, initializers, and the
        ; deinitializer. mangled_name is built via mangle_structure so
        ; method/operator mangling can reference the parent.
        ; ================================================================
        function plan_structure#(rp, this: Planner, s: Structure, name: String) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]$()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property#(p))
                }
                set i: i + 1
            }

            ; First-pass layout on properties with offset=0 to obtain the
            ; per-property offsets.
            var props_initial Vector[PlannedProperty]^rp(planned_props)
            let offsets Planner.compute_property_offsets#(&props_initial)

            ; Re-emit each PlannedProperty with the computed offset
            ; written back. (PlannedProperty is stored by value in the
            ; Vector; in-place mutation would require reaching through
            ; the heap, so a copy-with-new-offset is cleaner.)
            var props_with_offsets Array[PlannedProperty]$()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get j
                let o_ptr offsets.get j
                if p_ptr <> null
                {
                    if o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty]^rp(props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)

            ; Build the struct's own PlannedType (name + resolved
            ; generics) before planning methods so method mangling
            ; can encode the parent.
            var gens_arr Array[PlannedType]$()
            let c_for_gens_ref this.lookup_concept(name)
            if c_for_gens_ref <> null
            {
                let c_for_gens (*c_for_gens_ref)
                var pi: size_t 0
                while pi < c_for_gens.parameters.length
                {
                    let p_ptr c_for_gens.parameters.get pi
                    if p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        if ts_ref <> null
                            gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var gens_holder Vector[PlannedType]^rp(gens_arr)
            var gens_ref: ref[Vector[PlannedType]]? null
            if gens_holder.length > 0
                set gens_ref: &gens_holder
            let mangled Planner.mangle_structure#(name, gens_ref)

            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                s.span,
                String^rp(name),
                mangled,
                gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get 0

            ; Plan methods, operators, initializers, deinitializer.
            var planned_methods Array[PlannedFunction]$()
            var planned_operators Array[PlannedOperator]$()
            var planned_initializers Array[PlannedInitializer]$()
            var deinit_ref: ref[PlannedDeInitializer]? null

            var mi: size_t 0
            while mi < s.members.length
            {
                let m_ptr s.members.get mi
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            planned_methods.add(this.plan_function#(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            planned_operators.add(this.plan_operator#(o, parent_ref))
                            0
                        }
                        else
                            0
                }
                set mi: mi + 1
            }

            var ii: size_t 0
            while ii < s.initializers.length
            {
                let ii_ptr s.initializers.get ii
                if ii_ptr <> null
                {
                    let ini (*ii_ptr)
                    planned_initializers.add(this.plan_initializer#(ini, parent_ref))
                }
                set ii: ii + 1
            }

            if s.deinitializer <> null
            {
                let di (*s.deinitializer)
                var dei_holder Vector[PlannedDeInitializer]^rp(1)
                dei_holder.put(0, this.plan_deinitializer#(di, parent_ref))
                set deinit_ref: dei_holder.get(0)
            }

            var methods_holder Vector[PlannedFunction]^rp(planned_methods)
            var ops_holder Vector[PlannedOperator]^rp(planned_operators)
            var inits_holder Vector[PlannedInitializer]^rp(planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String^rp(name),
                mangled,
                &props_holder,
                &inits_holder,
                deinit_ref,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; plan_structure_layout#: register a Structure's layout (properties,
        ; offsets, size, alignment) into instantiated_structures WITHOUT
        ; planning its methods, operators, initializers, or deinitializer.
        ;
        ; Used by register_struct_layouts# to import cross-module struct
        ; layouts so map_type / emit_struct_type / emit_member_assignment
        ; have a real struct type available, even when the module's
        ; function bodies aren't planned in the current compilation unit.
        ; Skipping methods avoids the planner-side crashes (null this in
        ; check_function_match → String::get_buffer) that would otherwise
        ; happen when walking generic/cross-module method bodies.
        function plan_structure_layout#(rp, this: Planner, s: Structure, name: String) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]$()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property#(p))
                }
                set i: i + 1
            }

            var props_initial Vector[PlannedProperty]^rp(planned_props)
            let offsets Planner.compute_property_offsets#(&props_initial)

            var props_with_offsets Array[PlannedProperty]$()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get j
                let o_ptr offsets.get j
                if p_ptr <> null
                {
                    if o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty]^rp(props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)
            let mangled Planner.mangle_structure#(name, null)

            ; Build the parent type (struct's own PlannedType) so
            ; plan_initializer can encode the parent in the
            ; mangled C1/C2 names.
            var gens_holder Vector[PlannedType]^rp(0)
            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                s.span,
                String^rp(name),
                mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get 0

            ; Plan only initializers (constructor bodies). Method
            ; bodies and operators are skipped — those frequently
            ; reference cross-module/generic types that the planner
            ; can't resolve outside their normal walk and would crash
            ; mid-emit. Initializers are simpler (just `set field: ...`
            ; over the struct's own fields) and safe to walk here.
            var planned_initializers Array[PlannedInitializer]$()
            var ii: size_t 0
            while ii < s.initializers.length
            {
                let ii_ptr s.initializers.get ii
                if ii_ptr <> null
                {
                    let ini (*ii_ptr)
                    planned_initializers.add(this.plan_initializer#(ini, parent_ref))
                }
                set ii: ii + 1
            }

            var methods_holder Vector[PlannedFunction]^rp(0)
            var ops_holder Vector[PlannedOperator]^rp(0)
            var inits_holder Vector[PlannedInitializer]^rp(planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String^rp(name),
                mangled,
                &props_holder,
                &inits_holder,
                null,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; register_struct_layouts_in_module#: walk a module's tree and
        ; register layout-only PlannedStructures for every Concept whose
        ; definition is a Structure. Skips the Concept if its name is
        ; already in instantiated_structures (avoids duplicate entries
        ; when the same module is also walked by the full planner).
        function register_struct_layouts_in_module#(rp, this: Planner, m: Module)
        {
            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_struct_layouts_in_concept#(c)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_struct_layouts_in_module#(sub)
                }
                set mi: mi + 1
            }
        }

        ; register_struct_layouts_in_concept#: if the concept's
        ; definition is a Structure, register its layout. If it's a
        ; Namespace, recurse into namespace members and modules.
        function register_struct_layouts_in_concept#(rp, this: Planner, c: Concept)
        {
            ; Only handle parameterless concepts here — generic
            ; structures get planned per-instantiation by the existing
            ; lookup_concept path in plan_type#.
            if c.parameters.length > 0
                return

            ; Skip if already recorded.
            let m_check Planner.mangle_structure#(c.name, null)
            if this.has_instantiated_structure(m_check)
                return

            choose c.definition
                when s: Structure
                {
                    let pl this.plan_structure_layout#(s, c.name)
                    0
                }
                when ns: Namespace
                {
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_struct_layouts_in_concept#(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get mi
                        if sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_struct_layouts_in_module#(sub)
                        }
                        set mi: mi + 1
                    }
                    0
                }
                else
                    0
        }

        ; plan_global: Model.Global → Plan.PlannedGlobal.
        ; The `name` comes from the enclosing Concept — Global itself has
        ; no name field.
        function plan_global#(rp, this: Planner, g: Global, name: String) returns PlannedGlobal
        {
            let planned_type this.plan_type#(g.type)
            let planned_value this.plan_operands#(g.value)
            var value_holder Vector[PlannedOperand]^rp(planned_value)
            ; Module-level mutable globals (stack_head etc.) keep their bare
            ; name as the LLVM symbol, matching stage-0 (@stack_head). Const
            ; defines stay Itanium-length-prefixed via encode_name (s189).
            var mangled Planner.encode_name#(name)
            if g.is_mutable
                set mangled: String^rp(name)
            let result PlannedGlobal(
                g.span,
                String^rp(name),
                mangled,
                planned_type,
                &value_holder,
                g.is_mutable
            )
            this.record_global(result)
            result
        }

        ; plan_namespace: Model.Namespace → Plan.PlannedNamespace.
        ; Dispatches each Member to the appropriate plan_* method and
        ; collects the results into the per-kind vectors the planned
        ; representation expects.
        ;
        ; Pushes the namespace onto the current-namespace context so
        ; nested plan_function / plan_operator calls pick up the
        ; namespace as their mangling parent (Itanium
        ; `_ZN<NSName><FnName>E…`) and so is_namespace_sibling_function
        ; can resolve unqualified intra-namespace calls. The old
        ; context is restored before returning, giving nested
        ; namespaces correct save/restore semantics.
        function plan_namespace#(rp, this: Planner, ns: Namespace, name: String) returns PlannedNamespace
        {
            ; Build the parent PlannedType that tags every Function /
            ; Operator inside this namespace for mangling. Name alone
            ; drives the Itanium segment; encode_type length-prefixes
            ; it to emit `_ZN<NSName><FnName>E…`.
            let ns_mangled Planner.encode_name(name)
            var parent_holder Vector[PlannedType]^rp(1)
            parent_holder.put(0, PlannedType(
                ns.span,
                String^rp(name),
                ns_mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let parent_ref parent_holder.get 0

            ; Save outer context and activate this namespace.
            let old_ns this.current_namespace
            let old_ns_name this.current_namespace_name
            set current_namespace: &ns
            var name_box Vector[String]^rp(1)
            name_box.put(0, name)
            set current_namespace_name: name_box.get(0)

            var functions Array[PlannedFunction]$()
            var operators Array[PlannedOperator]$()
            var concepts Array[PlannedConcept]$()

            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get i
                if m_ptr <> null
                {
                    let m (*m_ptr)
                    choose m
                        when f: Function
                        {
                            functions.add(this.plan_function#(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            operators.add(this.plan_operator#(o, parent_ref))
                            0
                        }
                        when c: Concept
                        {
                            concepts.add(this.plan_concept#(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            ; Walk loaded sub-modules from `define ns { module foo }`
            ; so their concepts/functions get planned (and recorded
            ; into instantiated_functions for emission). Side effect
            ; only — return value of plan_module# is intentionally
            ; discarded (mirrors session 43's plan_loaded_packages#).
            ; Mixing the struct-by-value return into plan_namespace#'s
            ; own struct construction corrupts the frame on stage-0
            ; codegen; the helper isolates the call.
            this.plan_namespace_modules#(ns)

            ; Restore outer namespace context.
            set current_namespace: old_ns
            set current_namespace_name: old_ns_name

            var funcs_holder Vector[PlannedFunction]^rp(functions)
            var ops_holder Vector[PlannedOperator]^rp(operators)
            var concs_holder Vector[PlannedConcept]^rp(concepts)

            PlannedNamespace(
                ns.span,
                String^rp(name),
                ns_mangled,
                null,
                &funcs_holder,
                &ops_holder,
                &concs_holder
            )
        }

        ; plan_namespace_module_one#: route a single sub-module through
        ; plan_module# only when its name is on the safe-walk list
        ; (top-level package namespaces). Inner generic sub-modules of
        ; the scaly stdlib (containers/Vector, containers/HashMap, etc.)
        ; carry generic struct definitions whose body planning hits an
        ; unresolved Type.name walk in join_dotted_name → crashes
        ; mid-emit. Until that gap is closed, restrict the walk to the
        ; outer package namespaces.
        ;
        ; Functions inside the skipped inner sub-modules still resolve
        ; via register_concept_recursive (which walks ns.modules and
        ; registers concepts/functions globally) plus the
        ; collapse_operand_sequence# extern-decl gate; bodies come from
        ; libscaly / libscalyc at link time.
        ;
        ; Positive enumeration of safe names — the negation form
        ; `equals("X") = false` triggers a stage-0 codegen issue
        ; (silent rc=139 SEGV in the helper after IR is emitted).
        function plan_namespace_module_one#(rp, this: Planner, sub: Module)
        {
            if sub.name.equals("memory")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("io")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("containers")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("compiler")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("cli")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Vector")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("HashMap")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Array")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("BuilderList")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("BuilderListIterator")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("HashMapBuilder")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("HashSet")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("HashSetBuilder")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("KeyValuePair")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("List")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("ListIterator")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Node")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Slot")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Slice")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Option")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Result")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("StringIterator")
            {
                let planned this.plan_module#(sub)
            }
            ; s188: hashing namespace (hash FNV-1a + is_prime + get_prime).
            ; Now walkable after the sqrt/fixed-array removals in hashing.scaly.
            ; Needed real for the seed: HashSetBuilder<String>::reallocate
            ; calls get_prime, String::hash calls hash — declare-only (→
            ; undefined at link) until the namespace is walked.
            if sub.name.equals("hashing")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("StringBuilder")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("String")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Page")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("PageList")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("PageNode")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("PageListIterator")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("BlockWatermark")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("runtime")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("root_pages")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Console")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("File")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Directory")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Path")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("FileError")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Model")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Plan")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("ConceptIndex")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("FunctionIndex")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("LLVM")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Syntax")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("lexer")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("parser")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Modeler")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Emitter")
            {
                let planned this.plan_module#(sub)
            }
            if sub.name.equals("Planner")
            {
                let planned this.plan_module#(sub)
            }
            ; scalyls modules (self-host effort) — added one at a time.
            if sub.name.equals("json")
            {
                let planned this.plan_module#(sub)
            }
            ; Layout-only fallback: even when this sub-module isn't on
            ; the safe-walk list (or when it was walked but its struct
            ; was already cached), register layouts for any concrete
            ; (parameterless) Structures it defines. has_instantiated_structure
            ; in register_struct_layouts_in_concept# guards against
            ; duplicate entries. This makes cross-module struct types
            ; (e.g. EmitterConfig referenced from cli.scaly) map_type-
            ; resolvable without walking the module's method bodies.
            this.register_struct_layouts_in_module#(sub)
        }

        ; Helper for plan_namespace#: walk ns.modules and route each
        ; through plan_namespace_module_one# (which applies the
        ; safe-walk filter). Side effect only — plan_module# returns
        ; a struct-by-value PlannedModule that's intentionally
        ; discarded inside the inner helper. Mixing that struct
        ; return into plan_namespace#'s own struct construction
        ; corrupts the frame on stage-0 codegen (session-43 pattern);
        ; the helper isolates the call.
        function plan_namespace_modules#(rp, this: Planner, ns: Namespace)
        {
            var mi: size_t 0
            while mi < ns.modules.length
            {
                let sub_ptr ns.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.plan_namespace_module_one#(sub)
                }
                set mi: mi + 1
            }
        }

        ; has_this_method: true when `this` is in scope and its struct/
        ; union type declares a method named `name`. Detects unqualified
        ; implicit-this sibling METHOD calls in BINDING position
        ; (`let p get x` inside a method) so s135 doesn't mis-peel the
        ; method name as a type. A FIELD named `name` is not a method, so
        ; this stays false for casts like `data as pointer[u8]`.
        function has_this_method#(rp, this: Planner, name: String) returns bool
        {
            let this_ref this.lookup_local(String#("this"))
            if this_ref = null
                return false
            let this_ty (*this_ref)
            var struct_name String^rp(this_ty.name)
            if this_ty.generics <> null
            {
                var is_ptr_like: bool false
                if this_ty.name.equals(String$("pointer"))
                    set is_ptr_like: true
                if this_ty.name.equals(String$("ref"))
                    set is_ptr_like: true
                if is_ptr_like
                {
                    let gens (*this_ty.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set struct_name: String^rp((*inner_ptr).name)
                    }
                }
            }
            let methods this.lookup_methods#(struct_name, name)
            methods.length > 0
        }

        ; is_namespace_sibling_function: true iff `name` refers to a
        ; Function defined directly in the currently-active
        ; namespace's members list. Used to decide whether an
        ; unqualified call inside a namespace body should route to
        ; the namespace-scoped peer or fall back to the global
        ; registry. Returns false whenever no namespace is active.
        function is_namespace_sibling_function(this: Planner, name: String) returns bool
        {
            if current_namespace = null
                return false

            let ns (*current_namespace)
            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            if f.name.equals(name)
                                return true
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
            false
        }

        ; register_concept_recursive: register `c` and, if its Definition
        ; is a Namespace, recurse into the namespace's members so inner
        ; Concepts / Functions / Operators are all visible by
        ; unqualified name during later planning.
        function register_concept_recursive(this: Planner, c: Concept)
        {
            this.register_concept(c)
            choose c.definition
                when ns: Namespace
                {
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                when f: Function
                                {
                                    this.register_function(f)
                                    0
                                }
                                when o: Operator
                                {
                                    this.register_operator(o)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }

                    ; Sub-modules of a namespace (`define ns { module foo }`)
                    ; flatten just like top-level `module foo` decls so
                    ; nested function names resolve under the namespace
                    ; via short-name fallback in collapse_operand_sequence#.
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get mi
                        if sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_module_concepts(sub)
                        }
                        set mi: mi + 1
                    }
                    0
                }
                when s: Structure
                {
                    ; Nested concepts inside a struct's members block
                    ; register under their own name. This lets
                    ; `struct Outer { struct Inner { ... } }` resolve
                    ; `Inner` by its short name.
                    var i: size_t 0
                    while i < s.members.length
                    {
                        let m_ptr s.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.members.length
                    {
                        let m_ptr u.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    0
                }
                else
                    0
        }

        ; register_module_concepts: walk a Model.Module's members and
        ; register every Concept, Function and Operator in the relevant
        ; registry. Done as a first pass so forward references work
        ; (A referencing B below, or main() calling helper() declared
        ; later in the file). Recurses into sub-modules and into
        ; namespace-shaped concepts so deeply nested definitions are
        ; reachable by their short name.
        function register_module_concepts(this: Planner, m: Module)
        {
            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_concept_recursive(c)
                            0
                        }
                        when f: Function
                        {
                            this.register_function(f)
                            0
                        }
                        when o: Operator
                        {
                            this.register_operator(o)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_module_concepts(sub)
                }
                set mi: mi + 1
            }
        }

        ; plan_module: Model.Module → Plan.PlannedModule.
        ;
        ; Two-pass: first register every concept reachable through this
        ; module's tree, then plan sub-modules and members. This makes
        ; forward references resolve — `struct A { b: B }` works even
        ; when B is defined later in the same module.
        function plan_module#(rp, this: Planner, m: Module) returns PlannedModule
        {
            ; Track the current source file for diagnostics (mirrors stage-0
            ; planModule: `OldFile = File; if (!Mod.File.empty()) File = Mod.File`).
            ; Sub-modules live in their own files; without this every escape /
            ; hard diagnostic from a sub-module is formatted against the entry
            ; file and reports a bogus line. Restored at the single return below.
            let saved_file this.file
            if m.file.get_length() > 0
                set this.file: String^this(m.file)

            ; Propagate this module's Use clauses into program_use_aliases
            ; so the dotted-call extern-decl gate fires for prefixes
            ; imported from sub-modules (e.g. cli.scaly's `use scaly.io.Console`
            ; → "Console") in addition to the main program's own uses.
            ; Without this, calls like `Console.println(...)` inside cli.run
            ; resolve at planning time but never reach the gate, so no
            ; extern declaration is emitted and emit_call returns null
            ; → empty function bodies.
            var uu: size_t 0
            while uu < m.uses.length
            {
                let u_ptr m.uses.get uu
                if u_ptr <> null
                {
                    let path u_ptr.path
                    if path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        if last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                        var ns_name String^this("")
                        if path.length > 1
                        {
                            let ns_ptr path.get(path.length - 2)
                            if ns_ptr <> null
                                set ns_name: String^this((*ns_ptr))
                        }
                        program_use_namespaces.add ns_name
                    }
                }
                set uu: uu + 1
            }

            this.register_module_concepts(m)

            var functions Array[PlannedFunction]$()
            var operators Array[PlannedOperator]$()
            var pl_concepts Array[PlannedConcept]$()
            var sub_modules Array[PlannedModule]$()

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    sub_modules.add(this.plan_module#(sub))
                }
                set mi: mi + 1
            }

            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            functions.add(this.plan_function#(f, null))
                            0
                        }
                        when o: Operator
                        {
                            let po this.plan_operator#(o, null)
                            operators.add po
                            ; A free (top-level) operator needs a real
                            ; emitted body. emit() walks instantiated_functions
                            ; only; struct operators reach it via call-site
                            ; resolution, but a free operator is planned here
                            ; and would otherwise never be recorded — the call
                            ; site (resolve_operator_call#) emits a reference to
                            ; its OPERATOR-mangled name, so the body must be
                            ; emitted under that same name. Record an
                            ; Action-bodied free operator as a PlannedFunction
                            ; carrying po.mangled_name. Extern/Intrinsic/
                            ; Instruction operators have no Scaly body to emit.
                            var op_has_body: bool false
                            choose o.implementation
                                when oa: Action
                                    set op_has_body: true
                                else
                                    0
                            if op_has_body
                            {
                                let synth_fn Function(
                                    o.span,
                                    o.private_,
                                    true,
                                    o.name,
                                    o.parameters,
                                    null,
                                    o.input,
                                    o.returns_,
                                    o.throws_,
                                    Lifetime.Unspecified(Unspecified()),
                                    o.implementation
                                )
                                var op_page_param: ref[String]? null
                                if Planner.needs_implicit_return_page(synth_fn)
                                {
                                    var pp_holder Vector[String]^rp(1)
                                    pp_holder.put(0, String^rp("rp"))
                                    set op_page_param: pp_holder.get(0)
                                }
                                var op_can_throw: bool false
                                if po.throws_type <> null
                                    set op_can_throw: true
                                this.record_function(PlannedFunction(
                                    po.loc,
                                    po.is_private,
                                    true,
                                    po.name,
                                    po.mangled_name,
                                    op_page_param,
                                    po.input,
                                    po.return_type,
                                    po.throws_type,
                                    Lifetime.Unspecified(Unspecified()),
                                    po.impl,
                                    null,
                                    false,
                                    op_can_throw,
                                    null,
                                    this.file
                                ))
                            }
                            0
                        }
                        when c: Concept
                        {
                            pl_concepts.add(this.plan_concept#(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mods_holder Vector[PlannedModule]^rp(sub_modules)
            var concs_holder Vector[PlannedConcept]^rp(pl_concepts)
            var funcs_holder Vector[PlannedFunction]^rp(functions)
            var ops_holder Vector[PlannedOperator]^rp(operators)

            set this.file: saved_file

            PlannedModule(
                m.file,
                m.name,
                &mods_holder,
                &concs_holder,
                &funcs_holder,
                &ops_holder
            )
        }

        ; plan_concept: wrap a Model.Concept (definition + generics) into
        ; PlannedConcept. Generic parameters are not instantiated here —
        ; that's the job of the separate instantiate-generic pass (TODO).
        ; For now we just drop the parameters on the floor and plan the
        ; underlying definition as-is.
        ;
        ; Intrinsic concepts (built-in types) are represented by a Type
        ; variant carrying a void placeholder until a proper Intrinsic
        ; variant is added to PlannedDefinition.
        function plan_concept#(rp, this: Planner, c: Concept) returns PlannedConcept
        {
            ; s107: generic data-class concepts (Structure with no
            ; members/initializers) defer body planning to
            ; instantiate_generic# at use sites. Pre-planning the
            ; unspecialised template here would record a struct named
            ; the same as every later instance (Box, etc.) — and
            ; emit_struct_type's name-keyed cache short-circuits the
            ; second emission, leaving %_Z3BoxIiE undefined while a
            ; ptr-typed property over the unbound `T` reaches map_type
            ; and gets lowered to opaque pointer, breaking field
            ; alignment. Mirrors stage-0 Planner.cpp:1613,1953,2131
            ; which only call planConcept when Parameters.empty().
            ; Stdlib generics (Vector etc.) have members/initializers
            ; and fall through to plan_structure# as before — the s107
            ; plan_type# if mirrors this same data-class restriction.
            let pl_def choose c.definition
                when s: Structure
                {
                    var skip: bool false
                    if c.parameters.length > 0
                        if s.members.length = 0
                            if s.initializers.length = 0
                                set skip: true
                    if skip
                        return PlannedConcept(
                            c.span,
                            c.name,
                            Planner.encode_name c.name,
                            null,
                            PlannedDefinition.Type(Planner.make_void_type#()),
                            null
                        )
                    PlannedDefinition.Structure(this.plan_structure#(s, c.name))
                }
                when u: scalyc.compiler.Model.Union
                    PlannedDefinition.Union(this.plan_union#(u, c.name))
                when ns: Namespace
                    PlannedDefinition.Namespace(this.plan_namespace#(ns, c.name))
                when g: Global
                    PlannedDefinition.Global(this.plan_global#(g, c.name))
                when t: Type
                    PlannedDefinition.Type(this.plan_type#(t))
                when intr: Intrinsic
                    PlannedDefinition.Type(Planner.make_void_type#())

            ; Generic concepts get a simple length-prefixed name; fully
            ; instantiated concepts get the full `_Z<name-len><name>`.
            var mangled: String String$("")
            if c.parameters.length > 0
                set mangled: Planner.encode_name(c.name)
            if c.parameters.length = 0
                set mangled: Planner.mangle_structure#(c.name, null)

            PlannedConcept(
                c.span,
                c.name,
                mangled,
                null,
                pl_def,
                null
            )
        }

        ; s148: byte size of a type referenced by name (variant payload
        ; or struct property). Knows about primitives, stdlib container
        ; shapes (Vector/Array = 16, String/HashMap/HashSet = 8), and
        ; walks registered Concept Structures' property lists when
        ; the name is a struct. Default 8 (matches the catch-all in
        ; get_primitive_alignment for unknown names).
        function compute_payload_size(this: Planner, name: String) returns size_t
        {
            var size: size_t Planner.get_primitive_alignment(name)
            if name.equals(String$("Vector"))
                return 16
            if name.equals(String$("Array"))
                return 16
            if name.equals(String$("String"))
                return 8
            if name.equals(String$("HashMap"))
                return 8
            if name.equals(String$("HashSet"))
                return 8
            if name.equals(String$("HashMapBuilder"))
                return 8
            if name.equals(String$("HashSetBuilder"))
                return 8
            let c_ref this.lookup_concept(name)
            if c_ref <> null
            {
                let c (*c_ref)
                choose c.definition
                    when st: Structure
                    {
                        var offset: size_t 0
                        var sa: size_t 1
                        var pi: size_t 0
                        while pi < st.properties.length
                        {
                            let p_ptr st.properties.get pi
                            if p_ptr <> null
                            {
                                let p (*p_ptr)
                                if p.type <> null
                                {
                                    let pt (*p.type)
                                    if pt.name.length > 0
                                    {
                                        let last_p pt.name.get(pt.name.length - 1)
                                        if last_p <> null
                                        {
                                            let pn (*last_p)
                                            let fs this.compute_payload_size(pn)
                                            let fa Planner.get_primitive_alignment(pn)
                                            set offset: Planner.align_offset(offset, fa) + fs
                                            if fa > sa
                                                set sa: fa
                                        }
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                        let total Planner.align_offset(offset, sa)
                        if total > 0
                            set size: total
                    }
                    when un: scalyc.compiler.Model.Union
                    {
                        ; s161: size a nested UNION field. Without this arm a
                        ; union-typed property (e.g. RoutineSyntax's
                        ; `implementation: ImplementationSyntax`, 24B) fell to
                        ; the get_primitive_alignment default of 8 — so
                        ; compute_payload_size(RoutineSyntax)=72 not 88,
                        ; NamedSyntax=96 not 112, and plan_union# emitted
                        ; TargetSyntax as {i8,[103xi8]}=104 (too small to hold
                        ; its own 112B NamedSyntax variant). build_function#'s
                        ; `load NamedSyntax` from the union payload then read
                        ; past the allocation → garbage routine.parameters →
                        ; SIGSEGV. Mirrors the plan_sizeof# union arm.
                        var max_payload: size_t 0
                        var max_palign: size_t 1
                        var ui: size_t 0
                        while ui < un.variants.length
                        {
                            let uv_ptr un.variants.get ui
                            if uv_ptr <> null
                            {
                                let uv (*uv_ptr)
                                if uv.type <> null
                                {
                                    let uvt (*uv.type)
                                    if uvt.name.length > 0
                                    {
                                        let uvn_ptr uvt.name.get(uvt.name.length - 1)
                                        if uvn_ptr <> null
                                        {
                                            let uvn (*uvn_ptr)
                                            let uvsz this.compute_payload_size(uvn)
                                            let uval Planner.get_primitive_alignment(uvn)
                                            if uvsz > max_payload
                                                set max_payload: uvsz
                                            if uval > max_palign
                                                set max_palign: uval
                                        }
                                    }
                                }
                            }
                            set ui: ui + 1
                        }
                        var u_tag_sz: size_t 1
                        if un.variants.length > 256
                            set u_tag_sz: 4
                        let u_total Planner.align_offset(max_payload + u_tag_sz, max_palign)
                        if u_total > 0
                            set size: u_total
                    }
                    else
                        0
            }
            size
        }

        ; plan_union: Model.Union → Plan.PlannedUnion.
        ; Similar scope to plan_structure: plans variants and computes
        ; size/alignment; skips methods/operators for now.
        function plan_union#(rp, this: Planner, u: scalyc.compiler.Model.Union, name: String) returns scalyc.compiler.Plan.PlannedUnion
        {
            var planned_vs Array[PlannedVariant]$()
            var tag: int 0
            var i: size_t 0
            while i < u.variants.length
            {
                let v_ptr u.variants.get i
                if v_ptr <> null
                {
                    let v (*v_ptr)
                    planned_vs.add(this.plan_variant#(v, tag))
                    set tag: tag + 1
                }
                set i: i + 1
            }

            var vs_holder Vector[PlannedVariant]^rp(planned_vs)

            var max_payload_size: size_t 0
            var max_payload_align: size_t 1
            var vi: size_t 0
            while vi < planned_vs.length
            {
                let vp_ptr planned_vs.get vi
                if vp_ptr <> null
                {
                    let vp (*vp_ptr)
                    if vp.var_type <> null
                    {
                        let vt (*vp.var_type)
                        let vsz this.compute_payload_size(vt.name)
                        let val Planner.get_primitive_alignment(vt.name)
                        if vsz > max_payload_size
                            set max_payload_size: vsz
                        if val > max_payload_align
                            set max_payload_align: val
                    }
                }
                set vi: vi + 1
            }
            var tag_sz: size_t 1
            if planned_vs.length > 256
                set tag_sz: 4
            let u_size Planner.align_offset(max_payload_size + tag_sz, max_payload_align)
            let u_align Planner.compute_union_alignment(&vs_holder)

            ; Build the union's own PlannedType + mangled_name upfront
            ; so method planning can mangle methods with this as parent.
            var u_gens_arr Array[PlannedType]$()
            let u_concept_ref this.lookup_concept(name)
            if u_concept_ref <> null
            {
                let u_concept (*u_concept_ref)
                var pi: size_t 0
                while pi < u_concept.parameters.length
                {
                    let p_ptr u_concept.parameters.get pi
                    if p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        if ts_ref <> null
                            u_gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var u_gens_holder Vector[PlannedType]^rp(u_gens_arr)
            var u_gens_ref: ref[Vector[PlannedType]]? null
            if u_gens_holder.length > 0
                set u_gens_ref: &u_gens_holder
            let u_mangled Planner.mangle_structure#(name, u_gens_ref)

            var u_parent_holder Vector[PlannedType]^rp(1)
            u_parent_holder.put(0, PlannedType(
                u.span,
                String^rp(name),
                u_mangled,
                u_gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                String^rp(""),
                null
            ))
            let u_parent_ref u_parent_holder.get 0

            ; Plan methods and operators declared on the union.
            var planned_methods Array[PlannedFunction]$()
            var planned_operators Array[PlannedOperator]$()
            var mi: size_t 0
            while mi < u.members.length
            {
                let m_ptr u.members.get mi
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            planned_methods.add(this.plan_function#(f, u_parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            planned_operators.add(this.plan_operator#(o, u_parent_ref))
                            0
                        }
                        else
                            0
                }
                set mi: mi + 1
            }

            var methods_holder Vector[PlannedFunction]^rp(planned_methods)
            var ops_holder Vector[PlannedOperator]^rp(planned_operators)

            let result scalyc.compiler.Plan.PlannedUnion(
                u.span,
                u.private_,
                String^rp(name),
                u_mangled,
                &vs_holder,
                &methods_holder,
                &ops_holder,
                u_size,
                u_align,
                null
            )
            this.record_union(result)
            result
        }

        ; plan_program: top-level entry point.
        ;
        ; Walks the Model.Program:
        ;   - plan the main Module (recursively plans sub-modules and
        ;     members)
        ;   - plan top-level statements (executed before main())
        ;
        ; Instantiation caches (structures / unions / functions / globals)
        ; are left null — the per-kind planned data lives inside the
        ; PlannedModule tree for now. The separate caches come online
        ; once the instantiate-generic pass is ported.
        function plan_program#(rp, this: Planner, prog: Program) returns ref[Plan]?
        {
            ; Stash the program's main-module Use aliases up front
            ; so the dotted-call extern-decl gate can consult them
            ; while planning loaded-package namespace bodies.
            this.record_program_uses(prog)

            ; Seed the concept/function/operator registries with
            ; every sibling program's top-level definitions first.
            ; This way plan_module's lookups see cross-file
            ; references (main.scaly -> cli.scaly etc.) before it
            ; starts planning the primary module's members.
            this.register_sibling_programs()

            ; NOTE (s176): registering struct layouts for loaded-package
            ; concrete structures here (register_struct_layouts_in_module#
            ; over loaded_packages) fixes map_type's ptr fallback for
            ; StringBuilder but flips String/Page/PageList from ptr to
            ; real struct types throughout, changing ABI decisions in
            ; everything stage-1 emits — stage-2 went to empty modules.
            ; The under-sizing harm is instead contained in
            ; emit_constructor_call's region-size fallback.

            ; plan_loaded_packages# is intentionally NOT called here.
            ; If invoked, it walks each loaded package and records every
            ; top-level Function via plan_function# -> instantiated_functions
            ; -> Emitter emits the function body. For functions whose
            ; bodies stage-1 cannot fully plan (every dotted call inside
            ; the body collapses to nothing because the gate / lookup
            ; doesn't fire), this produces ret-stub definitions that
            ; collide with the real bodies in libscaly.a / libscalyc.a
            ; at link time ("duplicate symbol _ZN5scaly4testEv").
            ; Skipping the walk lets the dotted-call extern-decl gate
            ; emit declarations only, with libscaly/libscalyc providing
            ; the bodies at link time. Functions still resolve at
            ; planning time via register_module_concepts (called by
            ; cli.run::register_packages).

            let planned_main this.plan_module#(prog.module_)
            let planned_stmts this.plan_statements#(prog.statements)

            ; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
            ; Runs once instantiated_functions is fully populated; appends a
            ; hard diagnostic (failed at cli.run) on a detected escape.
            this.check_interprocedural_escapes()

            var stmts_holder Vector[PlannedStatement]^rp(planned_stmts)
            var structs_holder Vector[PlannedStructure]^rp(instantiated_structures)
            var unions_holder Vector[scalyc.compiler.Plan.PlannedUnion]^rp(instantiated_unions)
            var funcs_holder Vector[PlannedFunction]^rp(instantiated_functions)
            var globals_holder Vector[PlannedGlobal]^rp(instantiated_globals)
            var delegates_holder Vector[String]^rp(delegate_names)
            var constraints_holder Vector[TypeConstraint]^rp(constraints)

            Plan#(
                planned_main,
                &stmts_holder,
                &structs_holder,
                &unions_holder,
                &funcs_holder,
                &globals_holder,
                &delegates_holder,
                next_type_var_id,
                &constraints_holder
            )
        }
    }

    ; ========================================================================
    ; Itanium ABI name encoding helpers.
    ; These are the smallest independent units of Planner.cpp; worth
    ; porting in full so Planner.test() can exercise them end-to-end.
    ; ========================================================================

    ; encode_name: "foo" -> "3foo" (length prefix + raw name)
    function encode_name(name: String) returns String
    {
        let len name.length
        let len_str size_to_string len
        let result StringBuilder#()
        result.append len_str
        result.append name
        result.to_string#()
    }

    ; strip_package_prefix: "scaly.containers.String" -> "String".
    ; Matches stripPackagePrefix in Planner.cpp: only strips when the full
    ; name begins with "scaly.". Anything else (e.g. "scalyc.compiler.Foo")
    ; is returned unchanged so user types keep their qualified identity.
    function strip_package_prefix#(rp, name: String) returns String
    {
        if name.starts_with("scaly.") = false
            return String^rp(name)

        let last_dot name.last_index_of("." as u8)
        if last_dot < 0
            return String^rp(name)

        let start (last_dot as size_t) + 1
        let len name.get_length() - start
        name.substring(rp, start, len)
    }

    ; encode_type: Itanium ABI type code.
    ;
    ; Recurses for pointer[T], ref[T] and generic instantiations. The
    ; optimized "use pre-computed mangled_name" shortcut from the C++
    ; implementation is deliberately omitted here — every PlannedType we
    ; construct from scratch will end up with an empty mangled_name, and
    ; the shortcut only saves work in a later pass we do not implement yet.
    function encode_type#(rp, type_value: PlannedType) returns String
    {
        ; Built-in primitive types.
        if type_value.name.equals("void")
            return String^rp("v")
        if type_value.name.equals("bool")
            return String^rp("b")
        if type_value.name.equals("char")
            return String^rp("c")
        if type_value.name.equals("int")
            return String^rp("i")
        if type_value.name.equals("uint")
            return String^rp("j")
        if type_value.name.equals("long")
            return String^rp("l")
        if type_value.name.equals("ulong")
            return String^rp("m")
        if type_value.name.equals("float")
            return String^rp("f")
        if type_value.name.equals("double")
            return String^rp("d")
        if type_value.name.equals("size")
            return String^rp("m")
        if type_value.name.equals("size_t")
            return String^rp("m")

        ; pointer[T] -> "P" + encode_type(T)
        if type_value.name.equals("pointer")
        {
            if type_value.generics <> null
            {
                let gens (*type_value.generics)
                if gens.length = 1
                {
                    let arg_ptr gens.get 0
                    if arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let inner Planner.encode_type#(arg)
                        var sb StringBuilder$()
                        sb.append("P" as char)
                        sb.append inner
