; Planner.scaly - Generic resolution, type inference, and name mangling.
; Transforms Model (generics) into Plan (concrete types, mangled names).
;
; Ported afresh from scalyc/Planner.cpp (~13K LOC, ~97 methods).
; Covers the full planning pipeline — plan_program → plan_module →
; plan_namespace/plan_concept → plan_structure/plan_union/plan_global
; /plan_function/plan_operator/plan_initializer/plan_deinitializer —
; HM type inference (unify, solve_constraints, apply_substitution),
; Itanium ABI name mangling, overload resolution with generic
; inference, member-access + method-chain resolution, iterator
; protocol, and branch-result unification.
;
; The only paths that abort via not_implemented are the package
; loader's parse+model steps, which need Scaly-side access to the
; Parser and Modeler as callable modules.

; scaly.io imports are load-bearing beyond visibility: the use alias
; feeds the dotted-call extern-decl gate (typed declarations for
; cross-package File./Path. calls instead of varargs fallbacks).
use scaly.io.File
use scaly.io.Path

use scalyc.compiler.ConceptIndex.ConceptIndex
use scalyc.compiler.FunctionIndex.FunctionIndex
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*

; libc extern for loud-failing stubs.
function exit(code: int) extern

; ============================================================================
; Scope / binding machinery.
;
; Defined at module scope so callers outside `define Planner` can construct
; them (scope state will eventually live inside the Planner struct; for now
; every scope-aware helper takes the stack as an explicit parameter).
; ============================================================================

; One local variable's entry. is_on_page tracks RBMM lifetime — true for
; values allocated with $, #, or ^name so the code generator can emit
; appropriate page-cleanup hooks.
define LocalBinding
(
    binding_type: scalyc.compiler.Plan.PlannedType
    is_mutable: bool
    is_on_page: bool
    is_parameter: bool
)

; One HARD diagnostic: a construct the planner could not resolve and that
; would otherwise be silently dropped from the emitted IR. `start` is the
; byte offset of the construct in its source file (Span.start); cli.run
; formats it as file:line:col like stage-0's formatErrorHeader and fails
; the compile.
define PlannerDiagnostic
(
    start: size_t
    message: String
    ; Source file the `start` byte offset is relative to. Multi-file
    ; compiles put each module's nodes in their own file's coordinate
    ; space, so a diagnostic must carry its file or cli.run formats the
    ; offset against the wrong (entry) file. Mirrors stage-0's per-error
    ; File capture (Planner.cpp planModule's `File = Mod.File`).
    file: String
)

; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
; One summary entry: the function at instantiated_functions[callee_fn_index]
; STORES its parameter #param_index into frame-external memory. dest_kind 0 =
; the destination is that callee's parameter #dest_index (e.g. `this.field`);
; dest_kind 1 = the destination is a module global or a pointer deref (@ext,
; always frame-external). callee_param_count is the callee's Input length, used
; to align a call's args from the right (skipping any leading page arg).
; Indices are computed at collect time so the per-call check needs no signature
; lookup. Mirrors Planner.cpp's EscapeSummary/CalleeParamNames.
define EscapeRecord
(
    callee_fn_index: size_t
    callee_param_count: size_t
    param_index: size_t
    dest_kind: size_t
    dest_index: size_t
)

define Planner
{
    ; ========================================================================
    ; Not-yet-ported marker.
    ;
    ; Every stub in this file funnels through here. Prints the method name
    ; to stderr and exits with code 111 so a caller that touches unported
    ; logic gets a precise, visible failure (not a silent null).
    ; ========================================================================

    function not_implemented(method_name: pointer[const_char]) returns int
    {
        scaly_eputs "scalyc Planner stub not implemented: "
        scaly_eputs method_name
        scaly_eputs "\n"
        exit 111
        0
    }

    ; Typed unreachable shim for functions that return PlannedOperand.
    ; The exit() in not_implemented terminates the process, so the dummy
    ; PlannedOperand below is never observed — it exists only so Scaly's
    ; type checker accepts the call site.
    function not_implemented_operand(method_name: pointer[const_char]) returns PlannedOperand
    {
        Planner.not_implemented method_name
        PlannedOperand(
            Span(0, 0),
            PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant(
                Constant.Null(NullConstant(Span(0, 0)))
            )),
            null,
            PlannedType(
                Span(0, 0),
                "void",
                "v",
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )
        )
    }

    ; ========================================================================
    ; Planner - the per-compilation-unit state.
    ;
    ; Mirrors the private fields of scalyc/Planner.h: scope stack, type
    ; substitutions, HM constraints + solution, concept registry,
    ; instantiation caches, function/operator registries, package
    ; search paths, loaded-package cache, and error accumulator.
    ; ========================================================================

    define Planner
    (
        file: String

        ; Scope stack — stored as one flat Array of bindings with a
        ; parallel Array of scope boundaries (indices where each scope
        ; begins). This avoids the Array-of-Array memory-model problem
        ; where a nested Array would lose its `Page.get(this)` anchor
        ; after being copied into the outer Array's exclusive page.
        ;
        ; push_scope    → boundaries.add(bindings.length)
        ; pop_scope     → bindings.length = last boundary, drop boundary
        ; define_local  → bindings.add(...)
        ; lookup_local  → reverse linear scan of bindings
        scope_bindings: Array[KeyValuePair[String, LocalBinding]]
        scope_boundaries: Array[size_t]

        ; Generic parameter substitutions active while planning a
        ; specific struct/function instantiation. Name-keyed
        ; (e.g. "T" → PlannedType for int).
        type_substitutions: Array[KeyValuePair[String, PlannedType]]

        ; Fresh type-variable id counter for the Hindley-Milner
        ; constraint solver; see fresh_type_var below.
        next_type_var_id: size_t

        ; Pending constraints (grow as the planner encounters equalities
        ; it can't resolve yet) and the accumulated solution from the
        ; most recent solve_and_apply call.
        constraints: Array[TypeConstraint]
        solution: Array[KeyValuePair[size_t, PlannedType]]

        ; Concept registry — maps a readable name (e.g. "Vector") to the
        ; Model.Concept that owns it. Populated by register_concept; used
        ; by lookup_concept during type resolution and method dispatch.
        concepts: Array[KeyValuePair[String, Concept]]

        ; O(1) name -> index map over `concepts`, maintained in lockstep at the
        ; single register_concept insertion site. Replaces lookup_concept's
        ; backward linear scan (the hottest planner function). Stores indices,
        ; not pointers, because `concepts` reallocates as it grows. Concrete,
        ; malloc'd, open-addressing — sidesteps the s188 RBMM-HashMap bug.
        concept_index: ConceptIndex

        ; Instantiation caches. Every PlannedStructure / PlannedUnion /
        ; PlannedFunction / PlannedGlobal a call into the planner
        ; produces is appended here so the final Plan can carry the
        ; complete list for emission.
        instantiated_structures: Array[PlannedStructure]
        instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]
        ; Names of every `delegate` (function-pointer) concept registered.
        ; Flows to Plan.delegates so the emitter's map_type lowers a
        ; delegate-typed value to an LLVM ptr (GAP B). Empty for the scaly
        ; package (no delegates) → map_type byte-identical, fixpoint-safe.
        delegate_names: Array[String]
        ; The enclosing function's planned return type during body planning
        ; (GAP B): a lambda returned where this is a delegate type becomes an
        ; ESCAPING closure (env on the caller page `#`). Null outside a function
        ; body or when the function has no declared return type.
        current_return_type: ref[PlannedType]?
        ; Names bound to a stack (non-escaping, Lifetime.Local) closure in the
        ; current function (GAP B escape checking). Returning one is an escape
        ; (the record lives on this frame) — flagged as a hard diagnostic.
        ; Truncated to its entry length at each function boundary.
        local_closure_names: Array[String]
        ; Page inference (let-bound box escape): names bound to a `&^this`/`&^rp`
        ; box (`let r &^this <call>`). The box places its value on a SURVIVING
        ; page (the borrowed receiver / caller rp), so such a local may be
        ; returned/stored/passed even though its binding_type carries the boxed
        ; value's stale Local inner. region_of_operand# ranks a use of one Caller.
        ; Covers the bind-then-escape shape where intervening statements (e.g. a
        ; type_substitutions restore) prevent inlining the box into the sink.
        ; Truncated per function boundary.
        local_box_names: Array[String]
        ; Page inference, gap 1 (backward binding promotion). escaping_return_
        ; locals: names a pre-scan found returned bare (`return x`) somewhere in
        ; the current function body — their `let x <alloc>` binding's allocation
        ; must live on the CALLER's page, not the local page. promoted_binding_
        ; names: the subset actually promoted at the binding (init was a
        ; relocatable allocation), consulted at the return site to skip the
        ; escape diagnostic. Both truncated at each function boundary.
        escaping_return_locals: Array[String]
        promoted_binding_names: Array[String]
        ; Hole-1 field provenance (escape soundness): names of frame-local
        ; VALUE-struct bindings constructed with a Local-ref argument
        ; (`let h Holder(&b)` where &b points into this frame). A later
        ; `return h.field` / store / pass of a reference-like field of such a
        ; binding hands out a frame address -> rejected. Coarse (taints the
        ; whole binding, not a specific field); truncated per function.
        local_tainted_struct_bindings: Array[String]
        ; deep-R2 store-escape: locals bound with an escaping init lifetime
        ; (`^name`/`#`) or already-promoted, into which a put/add stores a value
        ; that must therefore also live on a non-local page.
        escaping_targets: Array[String]
        ; Page inference (address-taken rule): names a pre-scan found taken by
        ; address (`&NAME`) somewhere in the current function body. A frame-local
        ; Vector binding whose address is taken and referenced into an escaping
        ; structure (a PlannedCall/PlannedItem/PlannedFunction field) must live on
        ; the CALLER's page (rp), not the local page — exactly what an explicit
        ; `^rp` did. plan_binding# promotes such bindings; truncated per function.
        address_taken_locals: Array[String]
        ; Ref-flow provenance (2026-07-02f): per-function set of holder-style
        ; locals whose INTERIOR references (`H.get(i)` / `H.get_ptr(i)`)
        ; reach an argument or return position un-dereferenced — directly or
        ; via a `let r H.get(i)` / `set r: H.get(i)` alias (the two parallel
        ; alias arrays map alias name -> receiver). Such a reference lands in
        ; a structure that outlives the frame (record_function's
        ; PlannedFunction, MethodMatch^this), so plan_binding# promotes H's
        ; construction to the caller page exactly like the address-taken
        ; rule above (same gates). A DEREFERENCED read `*H.get(i)` copies
        ; the value out — benign, not recorded. Truncated per function.
        getref_arg_locals: Array[String]
        getref_alias_names: Array[String]
        getref_alias_receivers: Array[String]
        ; Option B (2026-07-02h checker net): per-function set of container
        ; holder locals whose page-owning construction REMAINED on the frame's
        ; local page after every promotion pass above (defaulted-Local life;
        ; not a parameter, not #/^ — those carry Call/Reference life — and not
        ; in promoted_binding_names). A `.get(i)`/`.get_ptr(i)` ref out of such
        ; a holder points into the local page; collapse_operand_sequence#'s
        ; method dispatch stamps those results Local-pointee (stamp_getref_
        ; local_pointee#) so the return/store/pass escape checks reject an
        ; escaping use instead of silently dangling. Truncated per function.
        ;
        ; The *_base fields index the CURRENT function's first entry: the
        ; name arrays are entry-truncated per function, NOT cleared, so a
        ; generic method lazily instantiated MID-function (lookup_method#'s
        ; s188 hook — e.g. VectorIterator[int].next during test_vector) sees
        ; the outer function's entries. A whole-array name scan then false-
        ; matches an outer holder (next's `vector` FIELD vs test_vector's
        ; `vector` local). The stamp and the no-rp gate consult only entries
        ; at index >= base; the pre-existing sets (promoted_binding_names,
        ; getref promotion) keep their whole-array scans — promotion is
        ; placement-only, and narrowing them would change emission.
        local_frame_holder_names: Array[String]
        local_frame_holder_base: size_t
        getref_arg_base: size_t
        ; Set true while planning the IMPLICIT-RETURN (tail) action of a
        ; function whose return value owns page guts (needs_implicit_return_
        ; page). plan_action# reads-and-clears it so only the OUTERMOST body
        ; action promotes; promote_tail_operand# then re-stamps the tail
        ; expression (and recurses into choose/if/match arms + variant
        ; payloads) to the caller page. Closes the implicit-return-of-a-
        ; construction/call gap that R2 (explicit `return` only) misses.
        promote_tail_return: bool
        ; Set true while planning the IMPLICIT-RETURN (tail) action of ANY
        ; function with a return type (independent of promote_tail_return,
        ; which fires only for page-owning-value returns). plan_action# reads-
        ; and-clears it and runs check_tail_ref_escape# — the DIAGNOSTIC
        ; mirror of plan_return#'s reference-escape check. Closes hole 1
        ; (2026-07-02f): `return &local` was hard-errored but the same
        ; expression as a body tail (`{ ...; &result }`, unify) compiled
        ; clean and dangled.
        check_tail_escape: bool
        instantiated_functions: Array[PlannedFunction]
        ; O(1) membership index over instantiated_functions' mangled names,
        ; maintained in lockstep at the single record_function add site.
        ; has_recorded_function was an O(n) linear scan called from 4 hot
        ; collapse_operand_sequence call-resolution sites -> O(n^2) over a
        ; -c scalyc compile (same pattern as lookup_concept / the emitter
        ; caches). lookup(mangled) >= 0 means present. Pure membership ->
        ; same bool -> identical Plan -> identical IR (fixpoint-safe).
        function_name_index: ConceptIndex
        instantiated_globals: Array[PlannedGlobal]

        ; s116: cycle detection for instantiate_generic#. Holds the
        ; mangled names of generics currently being planned but not yet
        ; recorded in instantiated_structures/_unions. Without this,
        ; cross-module nested-generic chains (e.g. scalyc.scaly compile)
        ; recurse plan_type# → instantiate_generic# → plan_structure# →
        ; plan_function# → plan_type# without bound and blow the stack
        ; in resolve_type_base#. Mirrors stage-0's FunctionsBeingPlanned
        ; set (Planner.cpp:11685).
        instantiating_structures: Array[String]

        ; s188: structure mangled names already lazily full-instantiated by
        ; lookup_method#'s call-site hook, so a re-entrant resolution of the
        ; same concept's method during its own body planning is a no-op.
        instantiating_methods: Array[String]

        ; Free-function registry. Entries are appended for every
        ; top-level Function encountered during the concept-registration
        ; pass. A single name can appear multiple times for overloads —
        ; lookup_functions returns all matches.
        model_functions: Array[KeyValuePair[String, Function]]

        ; Phase-1 lambdas: `let f \params: body` records the lambda model
        ; keyed by the binding name; calls to `f` monomorphize the body at
        ; the call site (see collapse_operand_sequence#). No runtime value
        ; is emitted for the binding.
        lambda_models: Array[KeyValuePair[String, Lambda]]

        ; O(1) name -> ordered registry-index chain over model_functions,
        ; maintained in lockstep at the single register_function add site.
        ; Replaces lookup_functions / is_function's O(n) linear scan (O(n^2)
        ; over a -c scalyc compile). Walks in insertion order -> identical
        ; overload-resolution input -> identical Plan -> identical IR.
        model_function_index: FunctionIndex

        ; Operator registry (same shape as model_functions; separate
        ; keyspace because an operator is identified by its symbol).
        model_operators: Array[KeyValuePair[String, Operator]]

        ; O(1) name -> ordered registry-index chain over model_operators,
        ; maintained in lockstep at the single register_operator add site.
        model_operator_index: FunctionIndex

        ; Set by resolve_operator_call# / resolve_prefix_operator_call# to the
        ; matched operator's intrinsic-ness (true iff its implementation is
        ; Intrinsic). Read by the operator-call construction in
        ; collapse_operand_sequence# ONLY when the resolve returned non-null,
        ; so a user-defined (Action-bodied) operator emits a real call to its
        ; mangled function instead of being routed to emit_intrinsic_*_op.
        ; Mirrors stage-0's OperatorMatch.IsIntrinsic (Planner.cpp:3118/4470).
        resolved_op_is_intrinsic: bool

        ; Package search paths (e.g. "packages", user -I paths). Probed
        ; by load_package_on_demand when a package isn't already in
        ; loaded_packages.
        search_paths: Array[String]

        ; Loaded-package cache — name → root Module. Populated lazily
        ; once a package is found and parsed.
        loaded_packages: Array[KeyValuePair[String, Module]]

        ; Intra-package module cache keyed by full file path.
        ; Pre-populated by the outer driver via
        ; register_loaded_module; load_intra_package_module#
        ; consults it on demand.
        loaded_module_paths: Array[KeyValuePair[String, Module]]

        ; Collected diagnostic messages. Planner paths that can't
        ; resolve a name / method / type push descriptive strings
        ; here instead of (or in addition to) falling back to a
        ; fresh type variable. The caller (cli.scaly, tests) can
        ; inspect errors.length > 0 to detect problems without
        ; plumbing Result[T, E] through every helper.
        errors: Array[String]

        ; HARD diagnostics. Unlike `errors` (advisory — speculative
        ; lookup misses land there thousands of times during a clean
        ; self-compile), an entry here means a construct WOULD be
        ; dropped from the emitted IR. cli.run prints these with
        ; file:line:col and fails the compile (s185, roadmap Step C).
        diagnostics: Array[PlannerDiagnostic]

        ; Sibling programs: Model.Programs belonging to the same
        ; compilation unit but loaded from separate source files.
        ; Mirrors Planner.cpp's SiblingPrograms — main.scaly may
        ; reference cli.scaly, which references compiler.scaly;
        ; once each has been parsed+modelled the result is stashed
        ; here so concepts/functions/operators from every sibling
        ; populate the same registries as the primary program.
        sibling_programs: Array[Program]

        ; Currently-active namespace context. Pushed when
        ; plan_namespace enters a `define cli { … }`-style block,
        ; popped on exit. Used by mangle_function to prefix
        ; namespace-scoped functions with the namespace name
        ; (Itanium `_ZN3cli4mainE…` shape) and by
        ; is_namespace_sibling_function to detect unqualified
        ; calls to peer functions of the enclosing namespace.
        current_namespace: ref[Namespace]?
        current_namespace_name: ref[String]?

        ; Last-segment names of every `use a.b.c` clause in the
        ; program's main module. Consulted by the dotted-call
        ; namespace override to decide whether a `prefix.suffix(...)`
        ; call should emit a real extern declaration even when
        ; planning is happening inside a loaded-package namespace
        ; body. Mirrors stage-0's Use-alias check at
        ; Planner.cpp:7752-7789. Populated once at plan_program#
        ; entry, stays empty until then.
        program_use_aliases: Array[String]

        ; Parallel to program_use_aliases: the second-to-last segment of
        ; each `use a.b.c` clause (the enclosing-namespace name for
        ; mangling), or empty when the clause has only one segment.
        ; Lets a bare call to a use-imported namespace member mangle as
        ; `_ZN<ns><fn>E…` (matching the member's definition) instead of
        ; the free `_Z<fn>…` (which would be undefined at link).
        program_use_namespaces: Array[String]

        ; Monotonic counter for synthesizing unique lambda names.
        next_lambda_id: size_t

        ; Escape checker (RBMM blocker C), Vector 3 — interprocedural
        ; pass-to-storing-callee. Built by check_interprocedural_escapes#
        ; as a post-pass Plan-tree walk over instantiated_functions.
        ; escape_records is the summary (see EscapeRecord); escape_checking
        ; gates collect (false) vs check (true) mode; escape_fn_index names
        ; the function currently being walked (re-fetched via
        ; instantiated_functions.get to avoid storing its ref/String fields,
        ; which corrupt — s34); escape_found short-circuits once a violation
        ; has been reported.
        escape_records: Array[EscapeRecord]
        escape_checking: bool
        escape_found: bool
        escape_fn_index: size_t

        ; Transitive Vector-3 (interprocedural pass-to-storing-callee closure).
        ; The direct pass records only functions that STORE a parameter frame-
        ; external; a function that merely FORWARDS its parameter on to a storing
        ; callee (forward(p) calls store(p)) gets no direct record, so
        ; forward(&local) is silently accepted (the one known soundness hole).
        ; escape_forwarding gates a fixpoint pass (between collect and check)
        ; that, at each call passing a bare reference-like/delegate PARAMETER
        ; into a callee's persisting slot, records that the current function
        ; persists that parameter too — repeated until no new fact appears.
        escape_forwarding: bool

        ; CLOSURE Vector-3 support: names bound to a stack (Lifetime.Local)
        ; closure in the function CURRENTLY being walked by the escape
        ; post-pass. Rebuilt from the Plan tree (each function's PlannedBinding
        ; whose init is a Local Closure) at every escape_walk_function_body
        ; entry — NOT from the plan-time local_closure_names, which is
        ; truncated per function and stale by post-pass time. Lets the call
        ; check flag a stack closure passed to a storing callee.
        current_fn_closure_names: Array[String]

        ; Transitive page-need set (interprocedural escape forwarding). Names
        ; of functions that need the caller's page ONLY because their body
        ; forwards rp to a sibling that needs one (the escape-machinery
        ; dispatchers: collect_flow_stmt, collect_returns_*, scan_top_level_
        ; returns — void, no own ^rp, but they thread rp down to a void ^rp
        ; storer like add_escaping_*). Computed once by build_transitive_page_
        ; set after registration; consulted by function_needs_caller_page.
        transitive_page_names: Array[String]
        transitive_page_built: bool

        ; Phase-5 class 1 (value-guts persist summary memo): mangled name ->
        ; does the function's body store a parameter's VALUE into state that
        ; outlives its frame (this-field/global putadd of a bare param, or a
        ; param embedded in a bare-lifetime construction —
        ; `errors.add message`, `diagnostics.add(PlannerDiagnostic(...,
        ; message, ...))`)? Consulted at call resolution ONLY when an
        ; argument's planned type carries Local life (a Design-B
        ; local-flipped call result), so the model walk runs rarely and the
        ; memo stays small. Planner-lived, append-only, NEVER truncated —
        ; summaries are global facts about function bodies, not per-function
        ; scan state (the s02i base-scope trap does not apply). Declared
        ; LAST so the field indices of everything before stay stable.
        persist_summary_names: Array[String]
        persist_summary_vals: Array[size_t]

        ; ===== use-visibility infrastructure (stage 1: recording only) =====
        ; Rust-style strict `use` visibility for concepts. Stage 1 only
        ; RECORDS — no lookup consults these yet, so behavior/emission is
        ; unchanged. The function-alias machinery (program_use_aliases/
        ; _namespaces) stays untouched; this is the parallel CONCEPT
        ; structure.
        ; concept_origin_files/paths run in LOCKSTEP with `concepts` (same
        ; index): the defining module's file and dotted container path
        ; (module chain + enclosing namespaces, e.g. "scaly.containers"
        ; for Vector). registering_file/path are the save/switch/restore
        ; context maintained by register_module_concepts /
        ; register_concept_recursive during registration walks (empty =
        ; unknown origin).
        ; use_vis_files/names/paths are flat per-use-clause triples: the
        ; recording module's file, the clause's last path segment ("*"
        ; marks a glob — `use ns.*` parses with a trailing "*" segment),
        ; and the dotted prefix (segments before the last — the namespace
        ; the name is imported from). use_vis_recorded_files dedups
        ; modules walked more than once (register_packages + plan_module).
        ; Declared LAST (field-index stability, persist_summary lesson).
        concept_origin_files: Array[String]
        concept_origin_paths: Array[String]
        registering_file: String
        registering_path: String
        use_vis_files: Array[String]
        use_vis_names: Array[String]
        use_vis_paths: Array[String]
        use_vis_recorded_files: Array[String]

        ; Stage 2 (advisory measurement, cli --use-vis): every
        ; lookup_concept hit is classified against the would-be strict
        ; visibility rules (local > explicit use > glob > prelude;
        ; unknown origin = lenient) and counted — NO behavior change.
        ; Misses dedup by (concept index, current file);
        ; use_vis_miss_lazy notes whether the first sighting happened
        ; during lazy instantiation (instantiating_structures/methods
        ; non-empty) — those point at the visibility-context switch
        ; (nested-planning trap), not at a missing use line.
        use_vis_measure: bool
        use_vis_hits: size_t
        use_vis_misses: size_t
        use_vis_miss_idx: Array[size_t]
        use_vis_miss_files: Array[String]
        use_vis_miss_lazy: Array[size_t]

        ; Anchored container path per recorded module file, in LOCKSTEP
        ; with use_vis_recorded_files. A registration walk starting
        ; mid-tree (plan_module(sub) re-walks with an empty inherited
        ; prefix) looks its file up here so re-registered concepts keep
        ; root-anchored origins.
        use_vis_recorded_paths: Array[String]

        ; Stage 4 (enforcement, default ON — cli --no-use-vis disables):
        ; an INVISIBLE concept behaves as NOT FOUND (lookup_concept
        ; returns null) so the existing not-found machinery fires; the
        ; exhaustion diagnostic appends an "add: use ..." hint via
        ; use_vis_hint/lookup_concept_any. LENIENT during lazy
        ; instantiation (nested-planning trap: a generic's body planned
        ; mid-module must see its OWN module's names; the context switch
        ; is unimplemented — stdlib machinery is prelude-visible anyway).
        ; The verdict is memoized per (concept index, current file) in
        ; the two lockstep-with-`concepts` arrays below (verdict_file
        ; empty = uncomputed; ok 1 = visible).
        use_vis_enforce: bool
        use_vis_verdict_file: Array[String]
        use_vis_verdict_ok: Array[size_t]

        ; Membership set of names registered by ≥2 concepts from DIFFERENT
        ; origin files — the glob-type-disambiguation fast path. Maintained
        ; incrementally in register_concept (a cross-origin duplicate is the
        ; only case an explicit `use ns.Name` can change resolution). O(1)
        ; hashed (same ConceptIndex as concept_index) so lookup_concept's hot
        ; path pays only one hash probe per call; the explicit-use scan runs
        ; ONLY for the few genuinely cross-origin-duplicated names. The
        ; compiler shares several such names (Model/Plan/Syntax Call, Type,
        ; Lifetime, Span, …) but explicitly uses none of them.
        ambiguous_index: ConceptIndex

        ; Cache of the current file's EXPLICIT (non-glob) use names. `file` is
        ; set once (init) and never changes, so this stays valid; rebuilt only
        ; when use_vis_files grows. Turns the per-call explicit-use test (for
        ; the cross-origin-duplicated names that pass ambiguous_index) from an
        ; O(all-use-clauses) linear scan into an O(this-file's-explicit-uses)
        ; one. Rebuilt INLINE (a nested procedure call did not persist the
        ; mutation; inline mutation from a function does — cf. use_vis_check's
        ; verdict memo).
        file_explicit_names: Array[String]

        ; TRUE iff some name is BOTH cross-origin-ambiguous AND explicitly
        ; used in the main file — the only situation where glob-type-
        ; disambiguation changes a result. Set once during registration (both
        ; add-sites), so lookup_concept's hot path pays just a single bool read
        ; and skips the disambiguation entirely otherwise. FALSE for the
        ; compiler's own source (its cross-origin names — Model/Plan/Syntax
        ; Call/Type/… — are never explicitly used), so the self-compile hot
        ; path is unchanged.
        disambiguation_active: bool

        ; s200: scope-isolation floor for nested lazy instantiation.
        ; lookup_local_binding's reverse scan stops HERE instead of 0.
        ; instantiate_generic sets it to scope_bindings.length while
        ; planning an instantiation's bodies (save/restore discipline),
        ; so a generic method's bare member names can NEVER resolve to
        ; the ENCLOSING function's same-named locals — the s02i nested-
        ; planning scope leak. Concretely: planning VectorIterator[BL]'s
        ; next() nested under a user main that has a local named
        ; `vector` resolved the body's bare `vector` (a PROPERTY) to
        ; main's local → unplannable in the method → statements silently
        ; dropped → the recorded instantiation had a degenerate next()
        ; (rehash lost all entries; HashMapBuilder.add after init).
        ; Lambdas are unaffected (planned in-function, not through
        ; instantiate_generic — capture discovery still sees the
        ; enclosing scope). Declared LAST (field-index stability).
        scope_isolation_base: size_t
    )
    {
        init(filename: String)
        {
            set file: String^this(filename)
            set scope_bindings: Array[KeyValuePair[String, LocalBinding]]^this()
            set scope_boundaries: Array[size_t]^this()
            set type_substitutions: Array[KeyValuePair[String, PlannedType]]^this()
            set next_type_var_id: 0
            set constraints: Array[TypeConstraint]^this()
            set solution: Array[KeyValuePair[size_t, PlannedType]]^this()
            set concepts: Array[KeyValuePair[String, Concept]]^this()
            set concept_index: ConceptIndex.create(65536 as size_t)
            set instantiated_structures: Array[PlannedStructure]^this()
            set instantiated_unions: Array[scalyc.compiler.Plan.PlannedUnion]^this()
            set delegate_names: Array[String]^this()
            set current_return_type: null
            set local_closure_names: Array[String]^this()
            set local_box_names: Array[String]^this()
            set escaping_return_locals: Array[String]^this()
            set promoted_binding_names: Array[String]^this()
            set local_tainted_struct_bindings: Array[String]^this()
            set escaping_targets: Array[String]^this()
            set address_taken_locals: Array[String]^this()
            set getref_arg_locals: Array[String]^this()
            set persist_summary_names: Array[String]^this()
            set persist_summary_vals: Array[size_t]^this()
            set getref_alias_names: Array[String]^this()
            set getref_alias_receivers: Array[String]^this()
            set local_frame_holder_names: Array[String]^this()
            set local_frame_holder_base: 0
            set getref_arg_base: 0
            set promote_tail_return: false
            set check_tail_escape: false
            set instantiated_functions: Array[PlannedFunction]^this()
            set function_name_index: ConceptIndex.create(262144 as size_t)
            set instantiated_globals: Array[PlannedGlobal]^this()
            set instantiating_structures: Array[String]^this()
            set instantiating_methods: Array[String]^this()
            set model_functions: Array[KeyValuePair[String, Function]]^this()
            set lambda_models: Array[KeyValuePair[String, Lambda]]^this()
            set model_function_index: FunctionIndex.create(65536 as size_t, 262144 as size_t)
            set model_operators: Array[KeyValuePair[String, Operator]]^this()
            set model_operator_index: FunctionIndex.create(65536 as size_t, 262144 as size_t)
            set resolved_op_is_intrinsic: false
            set search_paths: Array[String]^this()
            set loaded_packages: Array[KeyValuePair[String, Module]]^this()
            set loaded_module_paths: Array[KeyValuePair[String, Module]]^this()
            set errors: Array[String]^this()
            set diagnostics: Array[PlannerDiagnostic]^this()
            set sibling_programs: Array[Program]^this()
            set current_namespace: null
            set current_namespace_name: null
            set program_use_aliases: Array[String]^this()
            set program_use_namespaces: Array[String]^this()
            set next_lambda_id: 0
            set escape_records: Array[EscapeRecord]^this()
            set escape_checking: false
            set escape_found: false
            set escape_fn_index: 0
            set escape_forwarding: false
            set current_fn_closure_names: Array[String]^this()
            set transitive_page_names: Array[String]^this()
            set transitive_page_built: false
            set concept_origin_files: Array[String]^this()
            set concept_origin_paths: Array[String]^this()
            set ambiguous_index: ConceptIndex.create(4096 as size_t)
            set file_explicit_names: Array[String]^this()
            set disambiguation_active: false
            set scope_isolation_base: 0
            set registering_file: String^this("")
            set registering_path: String^this("")
            set use_vis_files: Array[String]^this()
            set use_vis_names: Array[String]^this()
            set use_vis_paths: Array[String]^this()
            set use_vis_recorded_files: Array[String]^this()
            set use_vis_measure: false
            set use_vis_hits: 0
            set use_vis_misses: 0
            set use_vis_miss_idx: Array[size_t]^this()
            set use_vis_miss_files: Array[String]^this()
            set use_vis_miss_lazy: Array[size_t]^this()
            set use_vis_recorded_paths: Array[String]^this()
            set use_vis_enforce: true
            set use_vis_verdict_file: Array[String]^this()
            set use_vis_verdict_ok: Array[size_t]^this()

            ; Seed the function registry with C-runtime externs so name
            ; lookups for aligned_alloc/free/exit succeed from day one.
            ; Use `^this` to put runtime Function records on the Planner's
            ; own page (Page.get(this)); the default local page would
            ; dangle on return (s100).
            this.register_runtime_functions^this()
        }

        ; ================================================================
        ; Scope management (mirrors Planner::pushScope etc. in C++).
        ; ================================================================

        function push_scope(this: Planner)
        {
            scope_boundaries.add scope_bindings.length
        }

        function pop_scope(this: Planner)
        {
            if scope_boundaries.length = 0
                return

            let last_idx scope_boundaries.length - 1
            let boundary_ptr scope_boundaries.get last_idx
            if boundary_ptr <> null
                set scope_bindings.length: *boundary_ptr

            set scope_boundaries.length: last_idx
        }

        function define_local(
            this: Planner,
            name: String,
            t: PlannedType,
            is_mutable: bool,
            is_on_page: bool
        )
        {
            scope_bindings.add(
                KeyValuePair[String, LocalBinding](
                    name,
                    LocalBinding(t, is_mutable, is_on_page, false)
                )
            )
        }

        ; Define a function/init/operator parameter (or `this`/page receiver).
        ; Like define_local but marks the binding frame-EXTERNAL for the escape
        ; checker: a struct/pointer parameter is passed by pointer, so writing
        ; `param.field` stores into the CALLER's object (which outlives this
        ; frame's local page). Mirrors Planner.cpp::defineParameter.
        function define_parameter(this: Planner, name: String, t: PlannedType)
        {
            scope_bindings.add(
                KeyValuePair[String, LocalBinding](
                    name,
                    LocalBinding(t, false, false, true)
                )
            )
        }

        ; lookup_local_binding: innermost-first reverse scan. Returns
        ; null if no binding with this name is live in any current scope.
        ; The scan floor is scope_isolation_base (0 normally): while an
        ; instantiate_generic body plan is active, bindings BELOW the
        ; floor belong to the enclosing function and must be invisible
        ; (s200 — see the field comment).
        function lookup_local_binding(this: Planner, name: String) returns ref[LocalBinding]?
        {
            if scope_bindings.length = 0
                return null

            var i scope_bindings.length
            while i > scope_isolation_base
            {
                set i: i - 1
                let kvp_ptr scope_bindings.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
            }
            null
        }

        function lookup_local(this: Planner, name: String) returns ref[PlannedType]?
        {
            let binding this.lookup_local_binding(name)
            if binding = null
                return null

            &binding.binding_type
        }

        ; ================================================================
        ; Generic type-parameter substitutions.
        ; ================================================================

        function define_type_substitution(this: Planner, name: String, t: PlannedType)
        {
            type_substitutions.add(KeyValuePair[String, PlannedType](name, t))
        }

        function clear_type_substitutions(this: Planner)
        {
            set type_substitutions.length: 0
        }

        function lookup_type_substitution(this: Planner, name: String) returns ref[PlannedType]?
        {
            var i: size_t 0
            while i < type_substitutions.length
            {
                let kvp_ptr type_substitutions.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Fresh type variables for HM inference.
        ; ================================================================

        function fresh_type_var_id(this: Planner) returns size_t
        {
            let id next_type_var_id
            set next_type_var_id: id + 1
            id
        }

        ; ================================================================
        ; Concept registry.
        ; ================================================================

        function register_concept(this: Planner, c: Concept)
        {
            ; Track delegate (function-pointer type) names for the emitter's
            ; map_type lowering (GAP B).
            choose c.definition
                when d: Delegate
                    delegate_names.add(String^this(c.name))
                else
                    0
            ; Record the concept's origin (use-visibility stage 1) in
            ; LOCKSTEP with `concepts` — one entry per add, same index.
            ; Empty registering_file means the registration happened
            ; outside a module walk (unknown origin — treated leniently
            ; by later stages). FIRST origin wins on a re-registration
            ; from the same file: module trees are walked more than once
            ; (register_packages + plan_module, plan_module(sub) again),
            ; and later walks start mid-tree, so their container path
            ; lacks the root anchor.
            var origin_path String^this(registering_path)
            let prev_idx concept_index.lookup(c.name)
            if prev_idx >= 0
            {
                let prev_of concept_origin_files.get(prev_idx as size_t)
                if prev_of <> null
                {
                    if prev_of.equals(registering_file)
                    {
                        let prev_op concept_origin_paths.get(prev_idx as size_t)
                        if prev_op <> null
                            set origin_path: String^this((*prev_op))
                    }
                    else
                    {
                        ; A same-named concept already exists from a DIFFERENT
                        ; origin file — this name is glob-ambiguous. Record it
                        ; so lookup_concept knows to honour an explicit
                        ; `use ns.Name` here. Same-file re-registration (the
                        ; namespace+struct s95 pair, or re-walks) takes the
                        ; branch above and is NOT recorded. Empty origin files
                        ; (unknown origin) are left lenient. insert overwrites,
                        ; so it is naturally idempotent (membership only).
                        if registering_file.get_length() > 0
                            if prev_of.get_length() > 0
                            {
                                ambiguous_index.insert(c.name, 1 as size_t)
                                ; If the main file also explicitly uses this
                                ; now-ambiguous name, disambiguation matters.
                                if this.array_contains_name(file_explicit_names, c.name)
                                    set disambiguation_active: true
                            }
                    }
                }
            }
            concepts.add(KeyValuePair[String, Concept](c.name, c))
            let origin_file String^this(registering_file)
            concept_origin_files.add origin_file
            concept_origin_paths.add origin_path
            ; Visibility-verdict memo slots (stage 4), same lockstep.
            let vslot String()
            use_vis_verdict_file.add vslot
            var vzero: size_t 0
            use_vis_verdict_ok.add vzero
            ; Maintain the O(1) index in lockstep. insert OVERWRITES on a
            ; duplicate key so the LAST-registered index wins — matching
            ; lookup_concept's backward-scan semantics (s95). This is the ONLY
            ; mutation site of `concepts` (the .add's elsewhere are to LOCAL
            ; shadowed PlannedConcept arrays), so the index stays correct even
            ; when lazy instantiation registers concepts during planning.
            concept_index.insert(c.name, concepts.length - 1)
        }

        function lookup_concept(this: Planner, name: String) returns ref[Concept]?
        {
            ; O(1) hashed lookup over concept_index, which returns the LAST
            ; index registered for `name` (insert overwrites on duplicate key).
            ; This is the stage-0-faithful last-write-wins semantics the old
            ; backward linear scan provided: `define Planner { struct Planner
            ; ( ... ) ... }` registers the outer Namespace concept first, then
            ; the inner Structure under the same name, and downstream
            ; find_initializer# / lookup_property / lookup_method# /
            ; is_struct_ctor all `choose c.definition when s: Structure ...`
            ; and need the LATER (Structure) entry. (s95)
            let idx concept_index.lookup name
            if idx >= 0
            {
                let kvp_ptr concepts.get(idx as size_t)
                if kvp_ptr <> null
                {
                    ; Use-visibility stage 2: advisory classification of
                    ; this hit against the strict rules (counting only).
                    if use_vis_measure
                        this.use_vis_count(name, idx as size_t)
                    ; Stage 4: strict visibility — an invisible concept
                    ; is NOT FOUND here (memoized check).
                    if use_vis_enforce
                    {
                        ; Glob-type-disambiguation: an explicit `use ns.Name`
                        ; names the winner among same-named concepts (explicit
                        ; > glob). concept_index is last-write-wins, so when a
                        ; glob also pulls a DIFFERENT-origin same-named concept
                        ; that registered later, the last entry may be the
                        ; wrong one. If this file explicitly uses `name` and the
                        ; last-registered entry does NOT match that explicit
                        ; use, return the same-named entry whose origin DOES.
                        ; Three cheap gates, cheapest first: (1) the
                        ; disambiguation_active bool (FALSE for the compiler's
                        ; own source → hot path is one bool read); (2) O(1)
                        ; ambiguous_index membership; (3) the cached per-file
                        ; explicit-use list. Only when all three hold does the
                        ; backward origin-matching scan run — the genuine
                        ; ambiguity case. Single-concept / explicit-matches-
                        ; last / no-explicit lookups keep the same result.
                        if disambiguation_active
                        if ambiguous_index.lookup(name) >= 0
                        if this.file_has_explicit_cached(name)
                        {
                            var last_matches: bool false
                            let last_op concept_origin_paths.get(idx as size_t)
                            if last_op <> null
                                if this.origin_matches_explicit_use(name, *last_op)
                                    set last_matches: true
                            if last_matches = false
                            {
                                let dis this.lookup_concept_explicit_scan(name)
                                if dis <> null
                                    return dis
                            }
                        }
                        if this.use_vis_check(name, idx as size_t) = false
                            return null
                    }
                    return &kvp_ptr.value
                }
            }
            null
        }

        ; lookup_concept_any: raw registry lookup WITHOUT the strict
        ; visibility gate — for diagnostics ("exists but not visible")
        ; and tooling.
        function lookup_concept_any(this: Planner, name: String) returns ref[Concept]?
        {
            let idx concept_index.lookup name
            if idx >= 0
            {
                let kvp_ptr concepts.get(idx as size_t)
                if kvp_ptr <> null
                    return &kvp_ptr.value
            }
            null
        }

        ; s177: like lookup_concept but only matches a concept whose
        ; definition is a Namespace. `define Planner { define Planner(...) }`
        ; registers both under one name, and lookup_concept's backward
        ; scan (s95) returns the inner Structure. Qualified calls
        ; (`Planner.make_void_type()` from Emitter) need the OUTER
        ; Namespace to mangle with the namespace parent — without it the
        ; whole binding statement silently drops. Mirrors stage-0's
        ; qualified-call path (Planner.cpp:8604), whose concept cache
        ; holds the Namespace for the colliding name.
        function lookup_namespace_concept(this: Planner, name: String) returns ref[Concept]?
        {
            ; Stays a backward linear scan: it filters by definition == Namespace,
            ; so concept_index's single last-index-per-name can't serve it (the
            ; last entry for a name may be a Structure). A future multi-index
            ; (name -> all indices) could serve this.
            if concepts.length = 0
                return null
            var i: size_t concepts.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr concepts.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                    {
                        var is_ns: bool false
                        choose kvp_ptr.value.definition
                            when n: Namespace
                                set is_ns: true
                            else
                                0
                        if is_ns
                            return &kvp_ptr.value
                    }
                }
            }
            null
        }

        function has_concept(this: Planner, name: String) returns bool
        {
            this.lookup_concept(name) <> null
        }

        ; GAP B delegate (function-pointer type) helpers. A delegate concept
        ; `define Cb delegate(A, B) returns R` names a function type; a lambda
        ; or function whose signature matches is assignable to a Cb-typed
        ; binding/parameter, and a Cb-typed value is callable indirectly.
        function is_delegate_type(this: Planner, name: String) returns bool
        {
            let c this.lookup_concept(name)
            if c = null
                return false
            var result: bool false
            choose (*c).definition
                when d: Delegate
                    set result: true
                else
                    0
            result
        }

        ; The delegate's parameter types as planned types (drives lambda
        ; monomorphization against the declared signature).
        function delegate_param_types(this: Planner, name: String) returns Vector[PlannedType]
        {
            var result Array[PlannedType]()
            let c this.lookup_concept(name)
            if c <> null
                choose (*c).definition
                    when d: Delegate
                    {
                        var i: size_t 0
                        while i < d.input.length
                        {
                            let it_ptr d.input.get i
                            if it_ptr <> null
                            {
                                let it (*it_ptr)
                                if it.type <> null
                                {
                                    let pt this.plan_type((*it.type))
                                    result.add pt
                                }
                                else
                                {
                                    ; `delegate(int)`: a bare type is modeled as a
                                    ; param NAMED "int" with no type — the name is
                                    ; the parameter's type. (`delegate(x: int)`
                                    ; takes the it.type branch above.)
                                    if it.name <> null
                                    {
                                        var nm_path Vector[String](1)
                                        nm_path.put(0, String((*it.name)))
                                        let synth_ty Type(it.span, nm_path, null, scaly.compiler.Model.Lifetime.Unspecified(scaly.compiler.Model.Unspecified()))
                                        let synth_pt this.plan_type(synth_ty)
                                        result.add synth_pt
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    else
                        0
            Vector[PlannedType](result)
        }

        function delegate_return_type(this: Planner, name: String) returns PlannedType
        {
            let c this.lookup_concept(name)
            if c <> null
                choose (*c).definition
                    when d: Delegate
                    {
                        if d.returns_ <> null
                            return this.plan_type((*d.returns_))
                    }
                    else
                        0
            Planner.make_void_type()
        }

        ; Instantiation-cache recording helpers. Called as each planned
        ; aggregate is produced so the final Plan lists everything the
        ; emitter needs to lower.
        function record_structure(this: Planner, s: PlannedStructure)
        {
            instantiated_structures.add s
        }

        function record_union(this: Planner, u: scalyc.compiler.Plan.PlannedUnion)
        {
            instantiated_unions.add u
        }

        ; Lookups against the instantiation caches, keyed by mangled
        ; name. Used by instantiate_generic to avoid re-planning an
        ; already-instantiated concept.
        function has_instantiated_structure(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_structures.length
            {
                let s_ptr instantiated_structures.get i
                if s_ptr <> null
                {
                    if s_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function has_instantiated_union(this: Planner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < instantiated_unions.length
            {
                let u_ptr instantiated_unions.get i
                if u_ptr <> null
                {
                    if u_ptr.mangled_name.equals(mangled)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function record_function(this: Planner, f: PlannedFunction)
        {
            let entry_idx instantiated_functions.length
            instantiated_functions.add f
            function_name_index.insert_if_absent(f.mangled_name, entry_idx)
        }

        ; Has a function with this mangled name already been recorded in
        ; instantiated_functions? Used by the dotted-call namespace
        ; override to avoid re-declaring an extern stub for a function
        ; that was already planned (or already extern-declared).
        function has_recorded_function(this: Planner, mangled: String) returns bool
        {
            function_name_index.lookup(mangled) >= 0
        }

        function record_global(this: Planner, g: PlannedGlobal)
        {
            instantiated_globals.add g
        }

        ; lookup_global: locate a previously planned PlannedGlobal by name.
        ; Used by plan_type_operand#'s constant-folding path so a bare
        ; identifier like F_OK / SEEK_END resolves to its define value
        ; instead of falling through to PlannedExpression.Type (which
        ; emit_call drops as an arg, silently dropping the whole
        ; statement). Mirrors Planner.cpp:6950-6995.
        function lookup_global(this: Planner, name: String) returns ref[PlannedGlobal]?
        {
            var i: size_t 0
            while i < instantiated_globals.length
            {
                let g_ptr instantiated_globals.get i
                if g_ptr <> null
                {
                    if g_ptr.name.equals(name)
                        return g_ptr
                }
                set i: i + 1
            }
            null
        }

        ; ================================================================
        ; Package search paths + on-demand module loading.
        ;
        ; The Scaly Planner cannot yet drive the Scaly Parser +
        ; Modeler from its own body (would require threading a
        ; Parser instance or reifying a free-function parse entry
        ; point). Instead we take the pre-parsed-cache approach:
        ; an outer driver (cli.scaly, test harness) parses and
        ; models the required packages / sibling modules, then
        ; hands the resulting Module roots to the Planner via
        ; register_loaded_package / register_loaded_module. The
        ; load_* helpers are pure cache lookups.
        ;
        ; build_package_search_paths# / build_package_file_path#
        ; stay for callers that need to locate candidate files
        ; before parsing them.
        ; ================================================================

        function add_package_search_path(this: Planner, path: String)
        {
            search_paths.add path
        }

        ; add_sibling_program: register another Program (typically
        ; built from a peer source file) whose top-level concepts,
        ; functions and operators should be visible during planning
        ; of the primary program. The sibling is stashed here and
        ; later surfaced by register_sibling_programs right before
        ; the main-module registration pass.
        function add_sibling_program(this: Planner, prog: Program)
        {
            sibling_programs.add prog
        }

        ; record_program_uses: walk the program's main module Use
        ; clauses and store each clause's last path segment in
        ; program_use_aliases. Called once from plan_program# before
        ; plan_module# runs. The resulting alias list lets the
        ; dotted-call extern-decl gate fire for `prefix.suffix(...)`
        ; calls even when planning a loaded-package namespace body,
        ; provided the prefix names a Use-imported alias of the main
        ; program. Mirrors stage-0's Use-alias filter at
        ; Planner.cpp:7752-7789.
        function record_program_uses(this: Planner, prog: Program)
        {
            let uses prog.module_.uses
            var i: size_t 0
            while i < uses.length
            {
                let u_ptr uses.get i
                if u_ptr <> null
                {
                    let path u_ptr.path
                    if path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        if last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                        var ns_name ""
                        if path.length > 1
                        {
                            let ns_ptr path.get(path.length - 2)
                            if ns_ptr <> null
                                set ns_name: String^this((*ns_ptr))
                        }
                        program_use_namespaces.add ns_name
                    }
                }
                set i: i + 1
            }
        }

        ; lookup_use_alias_namespace: scan program_use_aliases in parallel
        ; with program_use_namespaces; return the namespace segment of the
        ; use clause whose last segment equals `name`, or empty if none.
        function lookup_use_alias_namespace(this: Planner, name: String) returns String
        {
            var i: size_t 0
            while i < program_use_aliases.length
            {
                let a_ptr program_use_aliases.get i
                if a_ptr <> null
                {
                    if a_ptr.equals(name)
                    {
                        let ns_ptr program_use_namespaces.get i
                        if ns_ptr <> null
                            return String((*ns_ptr))
                    }
                }
                set i: i + 1
            }
            ""
        }

        ; is_program_use_alias: linear scan of program_use_aliases.
        function is_program_use_alias(this: Planner, name: String) returns bool
        {
            var i: size_t 0
            while i < program_use_aliases.length
            {
                let a_ptr program_use_aliases.get i
                if a_ptr <> null
                {
                    if a_ptr.equals(name)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; ===== use-visibility recording (stage 1, advisory) =====
        ; Parallel CONCEPT-visibility structure — the function-alias
        ; machinery above (record_program_uses etc.) stays untouched.

        ; use_vis_file_recorded: has this module file's use clauses
        ; already been recorded? Modules are walked more than once
        ; (cli.register_packages + plan_module both call
        ; register_module_concepts on the same trees).
        function use_vis_file_recorded(this: Planner, f: String) returns bool
        {
            var i: size_t 0
            while i < use_vis_recorded_files.length
            {
                let p use_vis_recorded_files.get i
                if p <> null
                {
                    if p.equals(f)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; use_vis_lookup_file_path: the anchored container path recorded
        ; at this file's first registration walk ("" when unknown).
        function use_vis_lookup_file_path(this: Planner, f: String) returns String
        {
            var i: size_t 0
            while i < use_vis_recorded_files.length
            {
                let p use_vis_recorded_files.get i
                if p <> null
                {
                    if p.equals(f)
                    {
                        let pp use_vis_recorded_paths.get i
                        if pp <> null
                            return String((*pp))
                    }
                }
                set i: i + 1
            }
            ""
        }

        ; dotted_use_prefix: join a use clause's path segments EXCEPT the
        ; last with "." — the namespace prefix the name (or glob) is
        ; imported from. `use scaly.containers.String` -> "scaly.containers";
        ; single-segment clauses -> "".
        function dotted_use_prefix(this: Planner, path: Vector[String]) returns String
        {
            if path.length < 2
                return String^this("")
            var sb StringBuilder()
            var i: size_t 0
            while i < path.length - 1
            {
                let s_ptr path.get i
                if s_ptr <> null
                {
                    if i > 0
                        sb.append "."
                    sb.append((*s_ptr))
                }
                set i: i + 1
            }
            let joined sb.to_string()
            String^this(joined)
        }

        ; extend_dotted_path: append `name` to a dotted container path.
        ; Used to maintain registering_path while descending modules and
        ; namespace-shaped concepts during registration. A name equal to
        ; the path's LAST segment is collapsed — the module-named-after-
        ; namespace idiom (module Modeler containing `define Modeler`,
        ; `define scalyc` in the program module scalyc) is addressed
        ; once, matching how use paths spell it.
        function extend_dotted_path(this: Planner, prefix: String, name: String) returns String
        {
            if name.get_length() = 0
                return String^this(prefix)
            if prefix.get_length() = 0
                return String^this(name)
            if prefix.equals(name)
                return String^this(prefix)
            var dsb StringBuilder()
            dsb.append "."
            dsb.append name
            let dotted dsb.to_string()
            if prefix.ends_with(dotted)
                return String^this(prefix)
            var sb StringBuilder()
            sb.append prefix
            sb.append "."
            sb.append name
            let joined sb.to_string()
            String^this(joined)
        }

        ; record_module_uses: record one module's use clauses into the
        ; use-visibility triples (file, last segment, dotted prefix).
        ; A trailing "*" segment is a glob import of the prefix namespace
        ; and is stored with name "*". Dedup'd per module file; NOT
        ; recursive — register_module_concepts' own recursion reaches
        ; every sub-module (including namespace-hosted ones).
        function record_module_uses(this: Planner, m: Module)
        {
            if m.file.get_length() = 0
                return
            if this.use_vis_file_recorded(m.file)
                return
            let rec_file String^this(m.file)
            use_vis_recorded_files.add rec_file
            ; Snapshot the anchored container path for this file so
            ; later mid-tree re-walks can restore the root anchor.
            let rec_path String^this(registering_path)
            use_vis_recorded_paths.add rec_path

            var i: size_t 0
            while i < m.uses.length
            {
                let u_ptr m.uses.get i
                if u_ptr <> null
                {
                    let path u_ptr.path
                    if path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        if last_ptr <> null
                        {
                            let vis_file String^this(m.file)
                            use_vis_files.add vis_file
                            let vis_name String^this((*last_ptr))
                            use_vis_names.add vis_name
                            let vis_path this.dotted_use_prefix(path)
                            use_vis_paths.add vis_path
                            ; Feed lookup_concept's fast explicit-use cache:
                            ; only the MAIN file's EXPLICIT (non-glob) use
                            ; names. Populated here (persisting context) and
                            ; read-only in lookup_concept.
                            if m.file.equals(file)
                                if (*last_ptr).equals("*") = false
                                {
                                    file_explicit_names.add(String^this((*last_ptr)))
                                    ; If this explicitly-used name is already
                                    ; cross-origin-ambiguous, disambiguation
                                    ; matters (covers explicit-use-recorded-
                                    ; after the ambiguity).
                                    if ambiguous_index.lookup((*last_ptr)) >= 0
                                        set disambiguation_active: true
                                }
                        }
                    }
                }
                set i: i + 1
            }
        }

        ; ===== use-visibility measurement (stage 2, advisory) =====

        ; use_vis_count: classify a lookup_concept hit against the strict
        ; visibility rules and count. Called only under --use-vis; never
        ; changes lookup behavior.
        function use_vis_count(this: Planner, name: String, idx: size_t)
        {
            if idx >= concept_origin_files.length
                return
            let of_ptr concept_origin_files.get idx
            if of_ptr = null
                return
            let op_ptr concept_origin_paths.get idx
            if op_ptr = null
                return
            if this.use_vis_visible(name, *of_ptr, *op_ptr)
            {
                set use_vis_hits: use_vis_hits + 1
                return
            }
            set use_vis_misses: use_vis_misses + 1

            ; Dedup the miss list by (concept index, current file).
            var i: size_t 0
            while i < use_vis_miss_idx.length
            {
                let ip use_vis_miss_idx.get i
                if ip <> null
                {
                    if (*ip) = idx
                    {
                        let fp use_vis_miss_files.get i
                        if fp <> null
                        {
                            if fp.equals(file)
                                return
                        }
                    }
                }
                set i: i + 1
            }
            use_vis_miss_idx.add idx
            let f_copy String^this(file)
            use_vis_miss_files.add f_copy
            var lazy_flag: size_t 0
            if instantiating_structures.length > 0
                set lazy_flag: 1
            if instantiating_methods.length > 0
                set lazy_flag: 1
            use_vis_miss_lazy.add lazy_flag
        }

        ; use_vis_visible: the strict-visibility predicate (advisory).
        ; Visible when: origin unknown (registered outside a module
        ; walk), module-local (origin file = current file), prelude
        ; (scaly stdlib package or the attached prelude module),
        ; explicit `use ns.Name`, or glob `use ns.*` whose prefix
        ; addresses the origin container.
        function use_vis_visible(
            this: Planner,
            name: String,
            origin_file: String,
            origin_path: String
        ) returns bool
        {
            if origin_file.get_length() = 0
                return true
            if origin_file.equals(file)
                return true
            if this.use_vis_origin_is_prelude(origin_path, origin_file)
                return true
            ; A concept whose origin is a DIRECT child of the current
            ; file's own container path, named like that child, is a
            ; declared child module's namespace (`module lexer` in
            ; compiler.scaly) — visible without use, Rust's `mod foo;`
            ; semantics. The genuine-extension guard skips the collapse
            ; case (name = the path's own last segment).
            let cur_path this.use_vis_lookup_file_path(file)
            if cur_path.get_length() > 0
            {
                let child this.extend_dotted_path(cur_path, name)
                if child.get_length() > cur_path.get_length()
                {
                    if origin_path.equals(child)
                        return true
                }
            }
            var i: size_t 0
            while i < use_vis_files.length
            {
                let uf use_vis_files.get i
                if uf <> null
                {
                    if uf.equals(file)
                    {
                        let un use_vis_names.get i
                        let up use_vis_paths.get i
                        if un <> null
                        {
                            if up <> null
                            {
                                var name_hit false
                                if un.equals(name)
                                    set name_hit: true
                                if un.equals("*")
                                    set name_hit: true
                                if name_hit
                                {
                                    if this.use_vis_target_match(origin_path, *up, name)
                                        return true
                                }
                            }
                        }
                    }
                }
                set i: i + 1
            }
            false
        }

        ; use_vis_target_match: does a use clause with dotted prefix
        ; `prefix` import the concept whose container path is
        ; `origin_path` under `name`? Two layouts match: the concept
        ; defined directly in the container the prefix addresses
        ; (origin = prefix), and the module-named-after-concept idiom
        ; (origin = prefix + "." + name — `use scalyc.compiler.Modeler`
        ; reaching namespace Modeler inside module Modeler).
        function use_vis_target_match(
            this: Planner,
            origin_path: String,
            prefix: String,
            name: String
        ) returns bool
        {
            if prefix.get_length() = 0
                return true
            if origin_path.equals(prefix)
                return true
            var sb StringBuilder()
            sb.append prefix
            sb.append "."
            sb.append name
            let full sb.to_string()
            origin_path.equals(full)
        }

        ; use_vis_origin_is_prelude: the scaly stdlib package (origin
        ; path rooted at "scaly") stays auto-visible like Rust's
        ; prelude; the prelude module itself attaches under the main
        ; module and is recognized by its file name.
        function use_vis_origin_is_prelude(
            this: Planner,
            origin_path: String,
            origin_file: String
        ) returns bool
        {
            if origin_path.equals("scaly")
                return true
            if origin_path.starts_with("scaly.")
                return true
            if origin_file.ends_with("/prelude.scaly")
                return true
            origin_file.equals("prelude.scaly")
        }

        ; ===== use-visibility enforcement (stage 4) =====

        ; use_vis_check: the enforcement predicate behind lookup_concept.
        ; Same rules as use_vis_visible, plus: LENIENT during lazy
        ; instantiation (the nested-planning trap — a generic's body is
        ; planned mid-module and must see its OWN module's names), and
        ; memoized per (concept index, current file) since lookup_concept
        ; is the hottest planner function.
        function use_vis_check(this: Planner, name: String, idx: size_t) returns bool
        {
            if instantiating_structures.length > 0
                return true
            if instantiating_methods.length > 0
                return true
            if idx >= concept_origin_files.length
                return true
            if idx < use_vis_verdict_file.length
            {
                let vf use_vis_verdict_file.get idx
                if vf <> null
                {
                    if vf.get_length() > 0
                    {
                        if vf.equals(file)
                        {
                            let vo use_vis_verdict_ok.get idx
                            if vo <> null
                                return (*vo) = 1
                        }
                    }
                }
            }
            let of_ptr concept_origin_files.get idx
            if of_ptr = null
                return true
            let op_ptr concept_origin_paths.get idx
            if op_ptr = null
                return true
            let ok this.use_vis_visible(name, *of_ptr, *op_ptr)
            if idx < use_vis_verdict_file.length
            {
                let vfile String^this(file)
                use_vis_verdict_file.put(idx, vfile)
                var vok: size_t 0
                if ok
                    set vok: 1
                use_vis_verdict_ok.put(idx, vok)
            }
            ok
        }

        ; use_vis_hint: when `name` exists in the registry but is not
        ; visible from the current file, a "; add: use <path>" hint for
        ; the not-found diagnostic — empty otherwise. Diagnostic paths
        ; only (never hot).
        function use_vis_hint(this: Planner, name: String) returns String
        {
            if use_vis_enforce = false
                return ""
            let idx concept_index.lookup name
            if idx < 0
                return ""
            if (idx as size_t) >= concept_origin_paths.length
                return ""
            if this.use_vis_check(name, idx as size_t)
                return ""
            let op_ptr concept_origin_paths.get(idx as size_t)
            if op_ptr = null
                return ""
            var sb StringBuilder()
            sb.append " - defined in "
            sb.append((*op_ptr))
            sb.append " but not visible here; add: use "
            let full this.extend_dotted_path((*op_ptr), name)
            sb.append full
            let hint sb.to_string()
            String^this(hint)
        }

        ; plan_loaded_packages: extracted helper so plan_program's
        ; body stays small and a discarded plan_module# return value
        ; doesn't sit in plan_program's struct-by-value chain. The
        ; returned PlannedModule is dropped here intentionally —
        ; what we care about is the side effect of plan_function#
        ; calling record_function on every package-defined Function,
        ; which lands in instantiated_functions and is then emitted
        ; by the Emitter as both declaration and definition.
        function plan_loaded_packages(this: Planner)
        {
            var pi: size_t 0
            while pi < loaded_packages.length
            {
                let pk_ptr loaded_packages.get pi
                if pk_ptr <> null
                {
                    let pk_mod (*pk_ptr).value
                    let planned this.plan_module(pk_mod)
                }
                set pi: pi + 1
            }
        }

        ; register_sibling_programs: walk every stashed sibling
        ; Program and populate the shared registries (concepts,
        ; model_functions, model_operators) from each one. The same
        ; register_module_concepts helper is reused so nested
        ; namespaces, sub-modules, and struct-internal concepts are
        ; all flattened into the flat maps that lookup_concept /
        ; lookup_functions / lookup_operators consult.
        function register_sibling_programs(this: Planner)
        {
            var i: size_t 0
            while i < sibling_programs.length
            {
                let prog_ptr sibling_programs.get i
                if prog_ptr <> null
                {
                    let prog (*prog_ptr)
                    this.register_module_concepts(prog.module_)
                }
                set i: i + 1
            }
        }

        ; Record a diagnostic. Callers don't need to format the message
        ; further — just describe what failed ("function not found: foo",
        ; "no matching initializer for Bar(int, String)", etc.).
        function add_error(this: Planner, message: String)
        {
            errors.add message
        }

        function has_errors(this: Planner) returns bool
        {
            errors.length > 0
        }

        ; Record a HARD diagnostic with the construct's source position.
        ; Use this only on paths where the construct is certain to be
        ; dropped from the IR — cli.run fails the compile on these.
        function add_diagnostic(this: Planner, loc: Span, message: String)
        {
            diagnostics.add(PlannerDiagnostic(loc.start, message, this.file))
        }

        function has_diagnostics(this: Planner) returns bool
        {
            diagnostics.length > 0
        }

        ; ===== glob-ambiguity diagnostic (use-visibility, hard) =====
        ;
        ; Two glob imports in one file (`use a.*` and `use b.*`) that BOTH
        ; supply a concept of the same name make a bare reference to that
        ; name ambiguous: which concept it binds would depend on the
        ; registry's last-write-wins order, not on the source. That is a
        ; hard error at the use site. An explicit `use a.Name` in the same
        ; file names the winner and suppresses the error (explicit > glob).
        ; Runs once after registration, only when enforcement is on; the
        ; tree carries no such collision (the lexer/Syntax Literal families
        ; were unified), so this fires only on a genuine new clash.

        ; use_vis_file_has_explicit: does file `f` carry a non-glob use
        ; clause naming `name` (which disambiguates a glob collision)?
        function use_vis_file_has_explicit(this: Planner, f: String, name: String) returns bool
        {
            var i: size_t 0
            while i < use_vis_files.length
            {
                let uf use_vis_files.get i
                let un use_vis_names.get i
                if uf <> null
                {
                    if un <> null
                    {
                        if uf.equals(f)
                        {
                            if un.equals(name)
                                return true
                        }
                    }
                }
                set i: i + 1
            }
            false
        }

        ; file_has_explicit_cached: O(this-file's-explicit-uses) replacement
        ; for use_vis_file_has_explicit(file, name) on lookup_concept's hot
        ; path. A PURE READ — the list is populated incrementally in
        ; record_module_uses (a persisting context; lookup_concept's `this` is
        ; effectively a copy so a mutation THERE is lost). `file` is fixed
        ; after init, so the cached list covers the whole compile.
        function file_has_explicit_cached(this: Planner, name: String) returns bool
            this.array_contains_name(file_explicit_names, name)

        ; origin_matches_explicit_use: does some EXPLICIT (non-"*") use clause
        ; `use P.name` in the CURRENT file name an origin matching origin_path?
        ; Reuses use_vis_target_match (origin = P, or P.name — the module-named-
        ; after-concept idiom). Drives glob-type-disambiguation in lookup_concept.
        function origin_matches_explicit_use(this: Planner, name: String, origin_path: String) returns bool
        {
            var i: size_t 0
            while i < use_vis_files.length
            {
                let uf use_vis_files.get i
                let un use_vis_names.get i
                let up use_vis_paths.get i
                if uf <> null
                    if un <> null
                        if up <> null
                            if uf.equals(file)
                                if un.equals(name)
                                    if this.use_vis_target_match(origin_path, *up, name)
                                        return true
                set i: i + 1
            }
            false
        }

        ; lookup_concept_explicit_scan: scan `concepts` BACKWARD for a same-named
        ; entry whose ORIGIN matches an explicit use clause for `name` in the
        ; current file. Backward so the s95 same-file namespace+struct pair still
        ; yields the later Structure entry (both share the file's origin, so both
        ; match; the last one wins). Only called from lookup_concept when the
        ; last-write-wins entry does NOT match the explicit use — the genuine
        ; glob-ambiguity case (`use a.Widget` while a glob also pulls b.Widget).
        function lookup_concept_explicit_scan(this: Planner, name: String) returns ref[Concept]?
        {
            if concepts.length = 0
                return null
            var i: size_t concepts.length
            while i > 0
            {
                set i: i - 1
                let kvp_ptr concepts.get i
                if kvp_ptr <> null
                    if kvp_ptr.key.equals(name)
                    {
                        let op_ptr concept_origin_paths.get i
                        if op_ptr <> null
                            if this.origin_matches_explicit_use(name, *op_ptr)
                                return &kvp_ptr.value
                    }
            }
            null
        }

        ; use_vis_file_glob_supplies: does a glob clause in `f` import the
        ; concept named `name` from container `origin`?
        function use_vis_file_glob_supplies(this: Planner, f: String, name: String, origin: String) returns bool
        {
            var i: size_t 0
            while i < use_vis_files.length
            {
                let uf use_vis_files.get i
                let un use_vis_names.get i
                let up use_vis_paths.get i
                if uf <> null
                {
                    if un <> null
                    {
                        if up <> null
                        {
                            if uf.equals(f)
                            {
                                if un.equals("*")
                                {
                                    if this.use_vis_target_match(origin, *up, name)
                                        return true
                                }
                            }
                        }
                    }
                }
                set i: i + 1
            }
            false
        }

        ; check_glob_ambiguities: the enforcement entry, called once from
        ; plan_program. For each distinct file that declared a glob, and
        ; each concept name, count the DISTINCT origin modules that supply
        ; it into that file via a glob (skipping same-file and prelude
        ; origins, and names an explicit use already disambiguates). Two or
        ; more distinct glob origins for one name is a hard diagnostic.
        function check_glob_ambiguities(this: Planner)
        {
            if use_vis_enforce = false
                return

            var seen_files Array[String]()
            var fi: size_t 0
            while fi < use_vis_files.length
            {
                let un_ptr use_vis_names.get fi
                let uf_ptr use_vis_files.get fi
                if un_ptr <> null
                {
                    if uf_ptr <> null
                    {
                        if un_ptr.equals("*")
                        {
                            let cur_file (*uf_ptr)
                            var already false
                            var si: size_t 0
                            while si < seen_files.length
                            {
                                let sp seen_files.get si
                                if sp <> null
                                {
                                    if sp.equals(cur_file)
                                        set already: true
                                }
                                set si: si + 1
                            }
                            if already = false
                            {
                                let cf_copy String(cur_file)
                                seen_files.add cf_copy
                                this.check_file_glob_ambiguities(cur_file)
                            }
                        }
                    }
                }
                set fi: fi + 1
            }
        }

        function check_file_glob_ambiguities(this: Planner, f: String)
        {
            var seen_names Array[String]()
            var ci: size_t 0
            while ci < concepts.length
            {
                let kp concepts.get ci
                if kp <> null
                {
                    let name kp.key
                    var dup false
                    var di: size_t 0
                    while di < seen_names.length
                    {
                        let sp seen_names.get di
                        if sp <> null
                        {
                            if sp.equals(name)
                                set dup: true
                        }
                        set di: di + 1
                    }
                    if dup = false
                    {
                        let nm_copy String(name)
                        seen_names.add nm_copy
                        if this.use_vis_file_has_explicit(f, name) = false
                        {
                            var origins Array[String]()
                            var cj: size_t 0
                            while cj < concepts.length
                            {
                                let kp2 concepts.get cj
                                if kp2 <> null
                                {
                                    if kp2.key.equals(name)
                                    {
                                        let of_ptr concept_origin_files.get cj
                                        let op_ptr concept_origin_paths.get cj
                                        if of_ptr <> null
                                        {
                                            if op_ptr <> null
                                            {
                                                var counts false
                                                if (*of_ptr).equals(f) = false
                                                {
                                                    if this.use_vis_origin_is_prelude(*op_ptr, *of_ptr) = false
                                                    {
                                                        if this.use_vis_file_glob_supplies(f, name, *op_ptr)
                                                            set counts: true
                                                    }
                                                }
                                                if counts
                                                {
                                                    var have false
                                                    var oi: size_t 0
                                                    while oi < origins.length
                                                    {
                                                        let ep origins.get oi
                                                        if ep <> null
                                                        {
                                                            if ep.equals(*op_ptr)
                                                                set have: true
                                                        }
                                                        set oi: oi + 1
                                                    }
                                                    if have = false
                                                    {
                                                        let og_copy String((*op_ptr))
                                                        origins.add og_copy
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                set cj: cj + 1
                            }
                            if origins.length >= 2
                            {
                                var sb StringBuilder()
                                sb.append "ambiguous glob import in "
                                sb.append f
                                sb.append ": "
                                sb.append name
                                sb.append " is supplied by "
                                sb.append(Planner.size_to_string(origins.length))
                                sb.append " globbed modules ("
                                var mi: size_t 0
                                while mi < origins.length
                                {
                                    if mi > 0
                                        sb.append ", "
                                    let ep origins.get mi
                                    if ep <> null
                                        sb.append((*ep))
                                    set mi: mi + 1
                                }
                                sb.append "); add an explicit use to disambiguate"
                                ; The message is stored in this.diagnostics
                                ; beyond this frame, so allocate it on this's
                                ; region (this function takes no caller page).
                                let amb_local sb.to_string()
                                let amb_msg String^this(amb_local)
                                this.add_diagnostic(Span(0 as size_t, 0 as size_t), amb_msg)
                            }
                        }
                    }
                }
                set ci: ci + 1
            }
        }

        ; Look up a previously loaded package in the cache.
        function lookup_loaded_package(this: Planner, name: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_packages.length
            {
                let kvp_ptr loaded_packages.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Phase-1 lambda registry: record the model lambda bound to `name`.
        function record_lambda_model(this: Planner, name: String, lam: Lambda)
            lambda_models.add(KeyValuePair[String, Lambda](name, lam))

        ; Return the lambda model bound to `name`, or null. Forward scan
        ; (first binding wins) — Phase-1 lambdas are not scope-shadowed.
        function lookup_lambda_model(this: Planner, name: String) returns ref[Lambda]?
        {
            var i: size_t 0
            while i < lambda_models.length
            {
                let kvp_ptr lambda_models.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(name)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Look up a previously loaded intra-package module by its full
        ; file path.
        function lookup_loaded_module_path(this: Planner, path: String) returns ref[Module]?
        {
            var i: size_t 0
            while i < loaded_module_paths.length
            {
                let kvp_ptr loaded_module_paths.get i
                if kvp_ptr <> null
                {
                    if kvp_ptr.key.equals(path)
                        return &kvp_ptr.value
                }
                set i: i + 1
            }
            null
        }

        ; Build the list of directories to probe for a named package.
        ; Mirrors Planner.cpp's loadPackageOnDemand search list: cwd's
        ; packages/, then any user-provided -I paths. Walking the
        ; source file's parent chain is omitted here — the call sites
        ; that need it can push additional entries via
        ; add_package_search_path.
        function build_package_search_paths(this: Planner) returns Vector[String]
        {
            var paths Array[String]()
            paths.add("packages")

            var i: size_t 0
            while i < search_paths.length
            {
                let p_ptr search_paths.get i
                if p_ptr <> null
                    paths.add((*p_ptr))
                set i: i + 1
            }

            Vector[String](paths)
        }

        ; Compose "base/<name>/<version>/<name>.scaly" using Path.join#.
        function build_package_file_path(
            this: Planner,
            base: String,
            name: String,
            version: String
        ) returns String
        {
            let step1 Path.join(base, name)
            let step2 Path.join(step1, version)
            var file_sb StringBuilder()
            file_sb.append name
            file_sb.append ".scaly"
            let file_part file_sb.to_string()
            Path.join(step2, file_part)
        }

        ; register_loaded_package: pre-populate the package cache.
        ; Callers (cli.scaly, test harnesses) parse a package source
        ; file externally, build a Model.Module for it, then hand
        ; the root Module here keyed by package name.
        ;
        ; This is the pre-parsed-cache wiring: the Scaly Planner
        ; can't drive the Scaly Parser + Modeler from its own body
        ; yet, so the orchestration of "find the .scaly file, parse
        ; it, model it" happens one level up. The Planner just asks
        ; "do you have package X for me?" via load_package_on_demand#.
        function register_loaded_package(this: Planner, name: String, mod: Module)
        {
            loaded_packages.add(KeyValuePair[String, Module](name, mod))
        }

        ; register_loaded_module: pre-populate the intra-package
        ; module cache keyed by full file path. Same contract as
        ; register_loaded_package — parsing + modelling happens
        ; outside the Planner; the Planner consults this cache when
        ; a `use` statement references a peer module file.
        function register_loaded_module(this: Planner, path: String, mod: Module)
        {
            loaded_module_paths.add(KeyValuePair[String, Module](path, mod))
        }

        ; load_package_on_demand: cache-only lookup of a package by
        ; name. Returns the pre-registered root Module if one is
        ; cached, otherwise null. Pre-registration happens via
        ; register_loaded_package. The filesystem probing helpers
        ; (build_package_search_paths#, build_package_file_path#)
        ; are retained for callers that want to discover candidate
        ; files before parsing them externally.
        function load_package_on_demand(
            this: Planner,
            name: String
        ) returns ref[Module]?
        {
            this.lookup_loaded_package(name)
        }

        ; load_intra_package_module: cache-only lookup of a peer
        ; module inside an already-mounted package, keyed by the
        ; full file path ("BasePath/ModuleName.scaly"). Callers
        ; pre-populate via register_loaded_module.
        function load_intra_package_module(
            this: Planner,
            base_path: String,
            module_name: String
        ) returns ref[Module]?
        {
            var name_sb StringBuilder()
            name_sb.append module_name
            name_sb.append ".scaly"
            let file_part name_sb.to_string()
            let mod_path Path.join(base_path, file_part)

            this.lookup_loaded_module_path(mod_path)
        }

        ; ================================================================
        ; Model-function and operator registries.
        ; ================================================================

        function register_function(this: Planner, f: Function)
        {
            model_functions.add(KeyValuePair[String, Function](f.name, f))
            model_function_index.insert(f.name, model_functions.length - 1)
        }

        function register_operator(this: Planner, o: Operator)
        {
            model_operators.add(KeyValuePair[String, Operator](o.name, o))
            model_operator_index.insert(o.name, model_operators.length - 1)
        }

        ; lookup_functions: return every Function in the registry whose
        ; name matches. Overloads are preserved — the caller picks by
        ; argument-type compatibility.
        function lookup_functions(this: Planner, name: String) returns Vector[Function]
        {
            var matches Array[Function]()
            var cur model_function_index.lookup_head name
            while cur <> (0 - 1) as i64
            {
                let kvp_ptr model_functions.get(cur as size_t)
                if kvp_ptr <> null
                    matches.add kvp_ptr.value
                set cur: model_function_index.next_of(cur as size_t)
            }
            Vector[Function](matches)
        }

        function lookup_operators(this: Planner, name: String) returns Vector[Operator]
        {
            var matches Array[Operator]()
            var cur model_operator_index.lookup_head name
            while cur <> (0 - 1) as i64
            {
                let kvp_ptr model_operators.get(cur as size_t)
                if kvp_ptr <> null
                    matches.add kvp_ptr.value
                set cur: model_operator_index.next_of(cur as size_t)
            }
            Vector[Operator](matches)
        }

        function is_function(this: Planner, name: String) returns bool
        {
            model_function_index.lookup_head(name) <> (0 - 1) as i64
        }

        ; True iff `name` is a declared operator (in the operator-symbol
        ; registry). Used to give text-named operators a precedence and, in
        ; stage-0, to recognise them in infix position.
        function is_operator(this: Planner, name: String) returns bool
        {
            model_operator_index.lookup_head(name) <> (0 - 1) as i64
        }

        ; ================================================================
        ; register_runtime_functions: synthesize Function entries for the
        ; C runtime functions the RBMM lowering needs (aligned_alloc,
        ; free, exit, …). Matches Planner.cpp's static table.
        ;
        ; Idempotent — call as many times as desired; the registry is
        ; appended to, and duplicates are tolerated by lookup_functions
        ; (it walks every entry anyway).
        ;
        ; Parameter items and return types are built with Type.name
        ; Vectors so resolve_type_base recognises them correctly.
        ; ================================================================
        function register_runtime_functions(this: Planner)
        {
            ; All Vector / String / Type containers must live on `^this`
            ; (the Planner's OWN page, Page.get(this)) — a no-sigil local
            ; would put them on this function's local page, which is freed
            ; on return, leaving every Item.type and Type.generics ref
            ; dangling. Symptom (s100): later `lookup_functions("exit")`
            ; returns a Function whose param Type.generics reads as a tiny
            ; non-null bogus pointer (e.g. 0x8), and resolve_type_base#
            ; crashes on deref.
            ;
            ; `^this` (not the old threaded `^rp`) is correct AND
            ; interface-honest: this procedure MUTATES `this` — its built
            ; Function objects belong to `this` and outlive the frame iff
            ; `this` does, so they live on `this`'s own page. Page.get(this)
            ; is a stable page of the same long-lived region the Planner and
            ; its Array backings already occupy (the struct never moves), so
            ; nothing dangles; the region flows through the declared `this`
            ; parameter, not a hidden injected page.
            ;
            ; Type itself is a value-defined struct (no init#) so we
            ; can't write `Type^this(...)`. Instead, hold each Type in a
            ; Vector[Type]^this(1) and take a ref via `vec.get(0)` —
            ; mirrors handle_type# in Modeler.scaly.

            ; aligned_alloc(alignment: size_t, size: size_t) -> pointer[void]
            var aa_size_path Vector[String]^this(1)
            aa_size_path.put(0, "size_t")
            let aa_size_ref Type^this(
                Span(0, 0), aa_size_path, null,
                Lifetime.Unspecified(Unspecified())
            )

            var aa_void_path Vector[String]^this(1)
            aa_void_path.put(0, "void")
            var aa_void_holder Vector[Type]^this(1)
            aa_void_holder.put(0, Type(
                Span(0, 0), aa_void_path, null,
                Lifetime.Unspecified(Unspecified())
            ))

            var aa_ptr_gens_holder Vector[Vector[Type]]^this(1)
            aa_ptr_gens_holder.put(0, aa_void_holder)
            let aa_ptr_gens_ref aa_ptr_gens_holder.get 0

            var aa_ptr_path Vector[String]^this(1)
            aa_ptr_path.put(0, "pointer")
            let aa_ptr_void_ref Type^this(
                Span(0, 0), aa_ptr_path, aa_ptr_gens_ref,
                Lifetime.Unspecified(Unspecified())
            )

            var aa_alignment_name Vector[String]^this(1)
            aa_alignment_name.put(0, "alignment")
            var aa_size_name Vector[String]^this(1)
            aa_size_name.put(0, "size")

            var aa_inputs Vector[Item]^this(2)
            aa_inputs.put(0, Item(
                Span(0, 0), false,
                aa_alignment_name.get 0,
                aa_size_ref,
                Vector[Attribute](0)
            ))
            aa_inputs.put(1, Item(
                Span(0, 0), false,
                aa_size_name.get 0,
                aa_size_ref,
                Vector[Attribute](0)
            ))
            let aligned_alloc_fn Function(
                Span(0, 0), false, false,
                "aligned_alloc",
                Vector[GenericParameter]^this(0),
                null,
                aa_inputs,
                aa_ptr_void_ref,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(aligned_alloc_fn)

            ; free(ptr: pointer[void])
            var free_ptr_name Vector[String]^this(1)
            free_ptr_name.put(0, "ptr")
            var free_inputs Vector[Item]^this(1)
            free_inputs.put(0, Item(
                Span(0, 0), false,
                free_ptr_name.get 0,
                aa_ptr_void_ref,
                Vector[Attribute](0)
            ))
            let free_fn Function(
                Span(0, 0), false, false,
                "free",
                Vector[GenericParameter]^this(0),
                null,
                free_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(free_fn)

            ; exit(code: int)
            var int_path Vector[String]^this(1)
            int_path.put(0, "int")
            let int_ref Type^this(
                Span(0, 0), int_path, null,
                Lifetime.Unspecified(Unspecified())
            )

            var exit_code_name Vector[String]^this(1)
            exit_code_name.put(0, "code")
            var exit_inputs Vector[Item]^this(1)
            exit_inputs.put(0, Item(
                Span(0, 0), false,
                exit_code_name.get 0,
                int_ref,
                Vector[Attribute](0)
            ))
            let exit_fn Function(
                Span(0, 0), false, false,
                "exit",
                Vector[GenericParameter]^this(0),
                null,
                exit_inputs,
                null,
                null,
                Lifetime.Unspecified(Unspecified()),
                Implementation.Extern(Extern(Span(0, 0)))
            )
            this.register_function(exit_fn)
        }

        ; ================================================================
        ; Method / initializer / property lookup on user types.
        ; ================================================================

        ; collect_methods_in: linear scan of a members Vector, appending
        ; every Function whose name matches. Shared by lookup_methods
        ; across Structure and Union variants.
        function collect_methods_in(
            this: Planner,
            members: Vector[Member],
            method_name: String,
            acc: Array[Function]
        )
        {
            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            if f.name.equals(method_name)
                                acc.add f
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
        }

        function lookup_methods(
            this: Planner,
            struct_name: String,
            method_name: String
        ) returns Vector[Function]
        {
            var matches Array[Function]()
            ; s106: when struct_name is namespaced under "scaly." or
            ; "scalyc.", retry with the bare type name if the qualified
            ; name doesn't match. Mirrors Planner.cpp:1447-1453.
            ; Without this, init#'s implicit `page` parameter (typed
            ; pointer[scaly.memory.Page]) never resolves
            ; `page.allocate(...)` against the user's `define Page`, and
            ; the entire `set X: page.allocate(...)` action is dropped.
            var concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
            {
                var should_strip: bool false
                if struct_name.starts_with("scaly.")
                    set should_strip: true
                if struct_name.starts_with("scalyc.")
                    set should_strip: true
                if should_strip
                {
                    let last_dot struct_name.last_index_of("." as u8)
                    if last_dot >= 0
                    {
                        let start (last_dot as size_t) + 1
                        let len struct_name.get_length() - start
                        let bare struct_name.substring(start, len)
                        set concept_ref: this.lookup_concept(bare)
                    }
                }
            }
            if concept_ref = null
                return Vector[Function](matches)

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    this.collect_methods_in(s.members, method_name, matches)
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    this.collect_methods_in(u.members, method_name, matches)
                    0
                }
                else
                    0

            Vector[Function](matches)
        }

        ; lookup_property: find a struct field by name. Returns a
        ; reference into the Structure's properties Vector — valid as
        ; long as the underlying Concept is live in the registry.
        function lookup_property(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns ref[Property]?
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get i
                        if p_ptr <> null
                        {
                            if p_ptr.name.equals(property_name)
                                return p_ptr
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; find_initializer: locate an Initializer on a Struct-shaped
        ; concept whose parameter types are pairwise compatible with
        ; `arg_types`. Returns null when no match. Deliberately linear —
        ; matching against the first compatible overload.
        ; check_initializer_match: returns the Initializer pointer if
        ; its input matches arg_types (after skipping any implicit
        ; page parameter, which is already excluded from input by the
        ; Modeler). `exact_only` selects types_equal vs types_compatible.
        function check_initializer_match(
            this: Planner,
            ini: Initializer,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            if ini.input.length <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr ini.input.get j
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let pt (*p_ptr.type)
                    let planned_pt this.plan_type(pt)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_pt, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_pt, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }

            true
        }

        ; (The former concept_is_heap_backed NAME ALLOWLIST lived here. It is
        ; gone: residency is now DERIVED from the concept's own bodies by
        ; concept_needs_this_residency below — see its comment. Vector and
        ; String still classify as stack-safe values by construction: their
        ; bodies contain no `^this` and no `Page.get(this)`.)

        ; concept_needs_this_residency: true iff the named concept derives a
        ; page from its own address anywhere in its bodies — a `^this`
        ; construction (Type or Matrix life) or a `Page.get(this ...)` call,
        ; in any init, method, operator, or the deinit. Such an instance MUST
        ; live on a page; a stack instance would compute a garbage page
        ; header. SOURCE-DRIVEN: this replaced the concept_is_heap_backed
        ; name allowlist (Array/List/builders/HashSet/HashMap/StringBuilder
        ; all classify via their own bodies — Array/builders through the
        ; two-step `let own_page Page.get(this as pointer[void])`, List
        ; through `Node[T]^this` in add, HashSet/HashMap/StringBuilder
        ; through generic `^this` inits). Consulted on the fall-through
        ; construction paths (Unspecified life) in collapse_operand_sequence;
        ; explicit #/^ constructions never reach it.
        function concept_needs_this_residency(this: Planner, name: String) returns bool
        {
            let concept_ref this.lookup_concept(name)
            if concept_ref = null
                return false
            let c (*concept_ref)
            var found: bool false
            choose c.definition
                when s: Structure
                {
                    set found: this.structure_init_has_this_alloc(s)
                    if found = false
                        set found: this.structure_members_have_this_alloc(s)
                }
                else
                    0
            found
        }

        function structure_members_have_this_alloc(this: Planner, s: Structure) returns bool
        {
            var i: size_t 0
            while i < s.members.length
            {
                let mp s.members.get i
                if mp <> null
                {
                    let m (*mp)
                    var found: bool false
                    choose m
                        when f: Function
                            set found: this.impl_has_this_alloc(f.implementation)
                        when o: Operator
                            set found: this.impl_has_this_alloc(o.implementation)
                        else
                            0
                    if found
                        return true
                }
                set i: i + 1
            }
            if s.deinitializer <> null
            {
                let dr s.deinitializer
                let di (*dr)
                if this.impl_has_this_alloc(di.implementation)
                    return true
            }
            false
        }

        function structure_init_has_this_alloc(this: Planner, s: Structure) returns bool
        {
            var i: size_t 0
            while i < s.initializers.length
            {
                let ip s.initializers.get i
                if ip <> null
                {
                    let ini (*ip)
                    if this.impl_has_this_alloc(ini.implementation)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function impl_has_this_alloc(this: Planner, impl: Implementation) returns bool
        {
            var found: bool false
            choose impl
                when a: Action
                    set found: this.action_has_this_alloc(a)
                else
                    0
            found
        }

        function action_has_this_alloc(this: Planner, a: Action) returns bool
        {
            if this.operands_have_this_alloc(a.source)
                return true
            this.operands_have_this_alloc(a.target)
        }

        function operands_have_this_alloc(this: Planner, ops: Vector[Operand]) returns bool
        {
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    if this.operand_has_this_alloc(op)
                        return true
                    ; `Page.get(this ...)` — the concept derives a page from
                    ; its own address (the Array/builder two-step shape
                    ; `let own_page Page.get(this as pointer[void])`), so an
                    ; instance must be page-resident even when no literal
                    ; `^this` construction appears anywhere.
                    if Planner.operand_is_page_get(op)
                    {
                        if i + 1 < ops.length
                        {
                            let np ops.get(i + 1)
                            if np <> null
                            {
                                let nop (*np)
                                if Planner.operand_leads_with_this(nop)
                                    return true
                            }
                        }
                    }
                }
                set i: i + 1
            }
            false
        }

        function operand_is_page_get(op: Operand) returns bool
        {
            var found: bool false
            choose op.expression
                when ty: Type
                {
                    if ty.name.length = 2
                    {
                        let s0 ty.name.get 0
                        let s1 ty.name.get 1
                        if s0 <> null
                        {
                            if s1 <> null
                            {
                                let seg0 (*s0)
                                let seg1 (*s1)
                                if seg0.equals("Page")
                                {
                                    if seg1.equals("get")
                                        set found: true
                                }
                            }
                        }
                    }
                }
                else
                    0
            found
        }

        ; True when the operand is the argument shape of a `this`-receiving
        ; call: a Tuple whose first component's value leads with `this`
        ; (`Page.get(this as pointer[void])`), or a bare `this` (parenless).
        function operand_leads_with_this(op: Operand) returns bool
        {
            var found: bool false
            choose op.expression
                when tp: Tuple
                {
                    if tp.components.length > 0
                    {
                        let cp tp.components.get 0
                        if cp <> null
                        {
                            let comp (*cp)
                            if comp.value.length > 0
                            {
                                let vp comp.value.get 0
                                if vp <> null
                                {
                                    let vop (*vp)
                                    set found: Planner.operand_is_bare_this(vop)
                                }
                            }
                        }
                    }
                }
                when ty: Type
                    set found: Planner.type_is_bare_this(ty)
                else
                    0
            found
        }

        function operand_is_bare_this(op: Operand) returns bool
        {
            var found: bool false
            choose op.expression
                when ty: Type
                    set found: Planner.type_is_bare_this(ty)
                else
                    0
            found
        }

        function type_is_bare_this(ty: Type) returns bool
        {
            if ty.name.length <> 1
                return false
            let s0 ty.name.get 0
            if s0 = null
                return false
            let seg (*s0)
            seg.equals("this")
        }

        ; Exhaustive Expression walker, mirroring operand_references_rp /
        ; operand_has_call_life below: a `^this` construction or a
        ; `Page.get(this)` call nested inside a control-flow operand
        ; (if/choose/match/for/while/repeat/try/lambda) must be visible, else
        ; the concept silently classifies stack-safe and bare constructions
        ; stack-alloc an instance whose Page.get(this) then reads a garbage
        ; page header.
        function operand_has_this_alloc(this: Planner, op: Operand) returns bool
        {
            choose op.expression
                when ty: Type
                    if Planner.type_life_is_this(ty)
                        return true
                when tp: Tuple
                    if this.tuple_has_this_alloc(tp)
                        return true
                when bk: Block
                    if this.block_has_this_alloc(bk)
                        return true
                when mx: Matrix
                    if this.matrix_has_this_alloc(mx)
                        return true
                when iff: scalyc.compiler.Model.If
                {
                    if this.operands_have_this_alloc(iff.condition)
                        return true
                    if this.statement_has_this_alloc(iff.consequent)
                        return true
                    if iff.alternative <> null
                        if this.statement_has_this_alloc((*iff.alternative))
                            return true
                }
                when ch: Choose
                {
                    if this.operands_have_this_alloc(ch.condition)
                        return true
                    var i: size_t 0
                    while i < ch.cases.length
                    {
                        let wp ch.cases.get i
                        if wp <> null
                            if this.statement_has_this_alloc((*wp).consequent)
                                return true
                        set i: i + 1
                    }
                    if ch.alternative <> null
                        if this.statement_has_this_alloc((*ch.alternative))
                            return true
                }
                when m: Match
                {
                    if this.operands_have_this_alloc(m.condition)
                        return true
                    var i: size_t 0
                    while i < m.branches.length
                    {
                        let bp m.branches.get i
                        if bp <> null
                            if this.statement_has_this_alloc((*bp).consequent)
                                return true
                        set i: i + 1
                    }
                    if m.alternative <> null
                        if this.statement_has_this_alloc((*m.alternative))
                            return true
                }
                when fo: For
                {
                    if this.operands_have_this_alloc(fo.expression)
                        return true
                    if this.action_has_this_alloc(fo.action)
                        return true
                }
                when wh: While
                {
                    if this.operands_have_this_alloc(wh.condition.operation)
                        return true
                    if this.action_has_this_alloc(wh.action)
                        return true
                }
                when rep: Repeat
                    if this.action_has_this_alloc(rep.action)
                        return true
                when tr: Try
                {
                    if this.operands_have_this_alloc(tr.binding.operation)
                        return true
                    var i: size_t 0
                    while i < tr.catches.length
                    {
                        let wp tr.catches.get i
                        if wp <> null
                            if this.statement_has_this_alloc((*wp).consequent)
                                return true
                        set i: i + 1
                    }
                    if tr.alternative <> null
                        if this.statement_has_this_alloc((*tr.alternative))
                            return true
                }
                when nw: New
                {
                    if Planner.type_life_is_this(nw.type)
                        return true
                    if this.tuple_has_this_alloc(nw.arguments)
                        return true
                }
                when az: As
                    if Planner.type_life_is_this(az.target_type)
                        return true
                when so: SizeOf
                    if Planner.type_life_is_this(so.type)
                        return true
                when ao: AlignOf
                    if Planner.type_life_is_this(ao.type)
                        return true
                when lam: Lambda
                    if this.action_has_this_alloc(lam.body)
                        return true
                else
                    0
            false
        }

        function tuple_has_this_alloc(this: Planner, tp: Tuple) returns bool
        {
            var i: size_t 0
            while i < tp.components.length
            {
                let cp tp.components.get i
                if cp <> null
                {
                    let comp (*cp)
                    if this.operands_have_this_alloc(comp.value)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function block_has_this_alloc(this: Planner, bk: Block) returns bool
        {
            var i: size_t 0
            while i < bk.statements.length
            {
                let sp bk.statements.get i
                if sp <> null
                {
                    let st (*sp)
                    if this.statement_has_this_alloc(st)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function matrix_has_this_alloc(this: Planner, mx: Matrix) returns bool
        {
            ; The ^this on a GENERIC construction (`Vector[T]^this(...)`)
            ; rides the Matrix operand's life, not an inner Type — the same
            ; Matrix.life asymmetry the `^rp` and `#` scans already handle
            ; (lifetime_is_rp / lifetime_is_call both check mx.life). Without
            ; this, a generic-only `^this` init (HashSet/HashMap/StringBuilder)
            ; is invisible to the residency scan.
            if Planner.lifetime_is_this(mx.life)
                return true
            var i: size_t 0
            while i < mx.operations.length
            {
                let rowp mx.operations.get i
                if rowp <> null
                {
                    let row (*rowp)
                    if this.operands_have_this_alloc(row)
                        return true
                }
                set i: i + 1
            }
            false
        }

        function statement_has_this_alloc(this: Planner, st: Statement) returns bool
        {
            choose st
                when a: Action
                    if this.action_has_this_alloc(a)
                        return true
                when b: Binding
                    if this.operands_have_this_alloc(b.operation)
                        return true
                when r: Return
                    if this.operands_have_this_alloc(r.result)
                        return true
                when th: Throw
                    if this.operands_have_this_alloc(th.result)
                        return true
                when br: Break
                    if this.operands_have_this_alloc(br.result)
                        return true
                else
                    0
            false
        }

        function type_life_is_this(t: Type) returns bool
            Planner.lifetime_is_this(t.lifetime)

        function lifetime_is_this(lt: Lifetime) returns bool
        {
            var found: bool false
            choose lt
                when r: Reference
                {
                    if r.location.equals("this")
                        set found: true
                }
                else
                    0
            found
        }

        function find_initializer(
            this: Planner,
            struct_name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[Initializer]?
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    ; Pass 1: exact match.
                    var i: size_t 0
                    while i < s.initializers.length
                    {
                        let init_ptr s.initializers.get i
                        if init_ptr <> null
                        {
                            let ini (*init_ptr)
                            if this.check_initializer_match(ini, arg_types, true)
                                return init_ptr
                        }
                        set i: i + 1
                    }
                    ; Pass 2: compatible match.
                    var k: size_t 0
                    while k < s.initializers.length
                    {
                        let init_ptr s.initializers.get k
                        if init_ptr <> null
                        {
                            let ini (*init_ptr)
                            if this.check_initializer_match(ini, arg_types, false)
                                return init_ptr
                        }
                        set k: k + 1
                    }

                    ; Pass 3: generic inference. For each initializer,
                    ; plan the parameter types, infer generic bindings
                    ; against arg_types, and accept if the concept's
                    ; parameters are fully bound.
                    if c.parameters.length > 0
                    {
                        var g: size_t 0
                        while g < s.initializers.length
                        {
                            let init_ptr s.initializers.get g
                            if init_ptr <> null
                            {
                                let ini (*init_ptr)
                                if ini.input.length = arg_types.length
                                {
                                    var param_types_arr Array[PlannedType]()
                                    var pi: size_t 0
                                    while pi < ini.input.length
                                    {
                                        let p_ptr ini.input.get pi
                                        if p_ptr <> null
                                        {
                                            if p_ptr.type <> null
                                            {
                                                let pt (*p_ptr.type)
                                                param_types_arr.add(this.plan_type(pt))
                                            }
                                        }
                                        set pi: pi + 1
                                    }
                                    var param_types_vec Vector[PlannedType](param_types_arr)
                                    let bindings this.infer_type_arguments(
                                        param_types_vec, arg_types
                                    )
                                    if bindings.length >= c.parameters.length
                                        return init_ptr
                                }
                            }
                            set g: g + 1
                        }
                    }

                    null
                }
                else
                    null
        }

        ; get_property_index: position of a named property in the struct.
        ; Returns -1 if the type isn't a struct or the property is missing.
        function get_property_index(
            this: Planner,
            struct_name: String,
            property_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(struct_name)
            if concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when s: Structure
                {
                    var i: size_t 0
                    while i < s.properties.length
                    {
                        let p_ptr s.properties.get i
                        if p_ptr <> null
                        {
                            if p_ptr.name.equals(property_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant: find a union variant by name and return its tag.
        ; Returns -1 if the concept is missing or not a Union, or if the
        ; variant name is not present.
        function lookup_variant_tag(
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns int
        {
            let concept_ref this.lookup_concept(union_name)
            if concept_ref = null
                return -1

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get i
                        if v_ptr <> null
                        {
                            ; Scaly `when TypeName: x` matches by the
                            ; variant's TYPE name (last dotted segment),
                            ; not its declared field name. `Empty: EmptySyntax`
                            ; has name="Empty" but the when-arm reads
                            ; "EmptySyntax". Fall back to the field name for
                            ; Result-style `when err: Error`. Mirrors stage-0
                            ; Planner.cpp:11291-11313.
                            if v_ptr.type <> null
                            {
                                let type_ptr v_ptr.type
                                let type_val (*type_ptr)
                                if type_val.name.length > 0
                                {
                                    let last_ptr type_val.name.get(type_val.name.length - 1)
                                    if last_ptr <> null
                                        if last_ptr.equals(variant_name)
                                            return i as int
                                }
                            }
                            if v_ptr.name.equals(variant_name)
                                return i as int
                        }
                        set i: i + 1
                    }
                    -1
                }
                else
                    -1
        }

        ; lookup_variant_type: fetch the payload PlannedType for a named
        ; variant. Returns null when the concept isn't a union, the
        ; variant doesn't exist, or the variant has no payload (tag-only
        ; variants like Option.None).
        function lookup_variant_type(
            this: Planner,
            union_name: String,
            variant_name: String
        ) returns ref[PlannedType]?
        {
            let concept_ref this.lookup_concept(union_name)
            if concept_ref = null
                return null

            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    var i: size_t 0
                    while i < u.variants.length
                    {
                        let v_ptr u.variants.get i
                        if v_ptr <> null
                        {
                            ; Match by variant TYPE name (last dotted
                            ; segment) first, then fall back to field name.
                            ; Mirrors lookup_variant_tag / stage-0
                            ; Planner.cpp:11291-11313.
                            var matched: bool false
                            if v_ptr.type <> null
                            {
                                let type_ptr v_ptr.type
                                let type_val (*type_ptr)
                                if type_val.name.length > 0
                                {
                                    let last_ptr type_val.name.get(type_val.name.length - 1)
                                    if last_ptr <> null
                                        if last_ptr.equals(variant_name)
                                            set matched: true
                                }
                            }
                            if matched = false
                                if v_ptr.name.equals(variant_name)
                                    set matched: true
                            if matched = true
                            {
                                if v_ptr.type = null
                                    return null
                                let vt (*v_ptr.type)
                                return &^this this.plan_type(vt)
                            }
                        }
                        set i: i + 1
                    }
                    null
                }
                else
                    null
        }

        ; match_type_pattern: walk `pattern` and `actual` in parallel,
        ; collecting generic-parameter → concrete-type bindings.
        ; Recursion handles nested generics (e.g. matching `Vector[T]`
        ; against `Vector[int]` yields `T -> int`).
        ;
        ; Runs purely — returns a fresh Vector each call rather than
        ; mutating a caller-supplied accumulator, because passing a
        ; mutable Array as a parameter doesn't propagate in Scaly's
        ; value-semantics model.
        function match_type_pattern(
            this: Planner,
            pattern: PlannedType,
            actual: PlannedType
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]()

            if Planner.is_generic_type_param_name(pattern.name)
            {
                result.add(KeyValuePair[String, PlannedType](pattern.name, actual))
                return Vector[KeyValuePair[String, PlannedType]](result)
            }

            ; s167: the outer type constructors must match before recursing
            ; into generics. Without this, `Vector[T]` matched `Array[String]`
            ; (binding T=String from the inner generic), so find_initializer#
            ; Pass 3 picked Vector's copy ctor `init#(other: Vector[T])` (which
            ; precedes `init#(array: Array[T])`) for `Vector[String](an Array)`
            ; — emitting a Vector(Vector) call passed an Array struct, whose
            ; vector-ptr field was read as the data ptr → garbage String
            ; elements → String::hash SIGSEGV.
            if pattern.name.equals(actual.name) = false
                return Vector[KeyValuePair[String, PlannedType]](result)

            if pattern.generics <> null
            {
                if actual.generics <> null
                {
                    let pg (*pattern.generics)
                    let ag (*actual.generics)
                    if pg.length = ag.length
                    {
                        var i: size_t 0
                        while i < pg.length
                        {
                            let pp_ptr pg.get i
                            let ap_ptr ag.get i
                            if pp_ptr <> null
                            {
                                if ap_ptr <> null
                                {
                                    let inner this.match_type_pattern(
                                        (*pp_ptr), (*ap_ptr)
                                    )
                                    var j: size_t 0
                                    while j < inner.length
                                    {
                                        let kv_ptr inner.get j
                                        if kv_ptr <> null
                                            result.add((*kv_ptr))
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
            }

            Vector[KeyValuePair[String, PlannedType]](result)
        }

        ; infer_type_arguments: given a function's parameter types
        ; (possibly containing generic parameters like T, K) and the
        ; actual argument types at a call site, infer the concrete type
        ; assignments. Returns a flat Vector of name→type pairs; may
        ; contain duplicates for a generic parameter inferred from
        ; multiple positions (all should agree — agreement is checked
        ; downstream during substitution).
        function infer_type_arguments(
            this: Planner,
            param_types: Vector[PlannedType],
            arg_types: Vector[PlannedType]
        ) returns Vector[KeyValuePair[String, PlannedType]]
        {
            var result Array[KeyValuePair[String, PlannedType]]()
            if param_types.length <> arg_types.length
                return Vector[KeyValuePair[String, PlannedType]](result)

            var i: size_t 0
            while i < param_types.length
            {
                let p_ptr param_types.get i
                let a_ptr arg_types.get i
                if p_ptr <> null
                {
                    if a_ptr <> null
                    {
                        let matches this.match_type_pattern(
                            (*p_ptr), (*a_ptr)
                        )
                        var j: size_t 0
                        while j < matches.length
                        {
                            let kv_ptr matches.get j
                            if kv_ptr <> null
                                result.add((*kv_ptr))
                            set j: j + 1
                        }
                    }
                }
                set i: i + 1
            }

            Vector[KeyValuePair[String, PlannedType]](result)
        }

        ; instantiate_generic_function: monomorphise a generic function
        ; (one whose parameter types reference type-parameter names like
        ; T / K / V) against a substitution mapping those names to
        ; concrete types. The resulting PlannedFunction has each use of
        ; T replaced with its concrete binding, and is recorded in the
        ; instantiation cache via plan_function.
        function instantiate_generic_function(
            this: Planner,
            f: Function,
            args: Vector[KeyValuePair[String, PlannedType]]
        ) returns PlannedFunction
        {
            let saved_len type_substitutions.length

            var i: size_t 0
            while i < args.length
            {
                let kv_ptr args.get i
                if kv_ptr <> null
                    this.define_type_substitution(kv_ptr.key, kv_ptr.value)
                set i: i + 1
            }

            let result this.plan_function(f, null)
            set type_substitutions.length: saved_len
            result
        }

        ; ================================================================
        ; instantiate_generic: monomorphise a generic Concept against a
        ; concrete type-argument list. Binds each GenericParameter name
        ; to its corresponding argument in `type_substitutions`, plans
        ; the concept's definition so the struct-layout cache gets the
        ; instantiated version, then restores the substitution stack.
        ;
        ; Returns the resulting PlannedType with `generics` populated
        ; and `mangled_name` set via mangle_structure. Missing concepts
        ; fall back to a fresh type variable — keeps the planner
        ; productive on incomplete programs.
        ; ================================================================
        function instantiate_generic(
            this: Planner,
            concept_name: String,
            args: Vector[PlannedType],
            loc: Span
        ) returns PlannedType
        {
            let concept_ref this.lookup_concept(concept_name)
            if concept_ref = null
                return this.fresh_type_var(concept_name)

            let c (*concept_ref)

            ; Compute the mangled name upfront so we can short-circuit
            ; repeat instantiations (e.g. Vector[int] used from two
            ; sites). Without this, each call would re-plan the
            ; definition and re-append to instantiated_{structures,
            ; unions}.
            var args_holder Vector[PlannedType](args)
            let mangled Planner.mangle_structure(concept_name, &args_holder)

            var already_cached: bool false
            if this.has_instantiated_structure(mangled)
                set already_cached: true
            if already_cached = false
                if this.has_instantiated_union(mangled)
                    set already_cached: true

            ; s116: cycle detection. Re-entry during cross-module
            ; nested-generic planning (plan_structure# walks members →
            ; plan_function# → plan_type# → instantiate_generic#) was
            ; blowing the stack in resolve_type_base# before the outer
            ; struct landed in instantiated_structures. If `mangled` is
            ; already in instantiating_structures, return the shell
            ; PlannedType without re-planning. The outer call eventually
            ; completes and records the structure.
            if already_cached = false
            {
                var i: size_t 0
                while i < instantiating_structures.length
                {
                    let im_ptr instantiating_structures.get i
                    if im_ptr <> null
                    {
                        if im_ptr.equals(mangled)
                            set already_cached: true
                    }
                    set i: i + 1
                }
            }

            if already_cached = false
            {
                instantiating_structures.add mangled

                let saved_subst_len type_substitutions.length

                ; The Planner's OWNING page (persistent for the whole
                ; compile). Everything recorded for this instantiation —
                ; the structure AND the generic-argument types substituted
                ; into its properties/methods — must live here, not on the
                ; threaded `rp` (which may be a transient sub-computation
                ; page; see the s100 note at the plan_structure^own_page
                ; call below).

                ; Bind each generic parameter name to its concrete argument.
                ; Rehome the argument onto own_page first: a lazily reached
                ; instantiation (s188 hook) receives args built on a
                ; transient rp; the substituted property types would dangle
                ; (read as garbage in emit's String hash).
                var i: size_t 0
                while i < c.parameters.length
                {
                    if i < args.length
                    {
                        let p_ptr c.parameters.get i
                        let a_ptr args.get i
                        if p_ptr <> null
                        {
                            if a_ptr <> null
                            {
                                ; Ensure a cross-package by-value generic
                                ; ARGUMENT's layout before it is substituted
                                ; into the instantiation's properties. A
                                ; Node[Use] / KeyValuePair[String, Concept]
                                ; embeds the argument (Use / Concept) BY VALUE;
                                ; if its layout is the s114 { ptr } placeholder
                                ; here the instantiation is laid out with an 8B
                                ; ptr where the dependency object has the real
                                ; struct, so a List[Use] / HashMap walked by
                                ; value across the boundary corrupts. No-op for
                                ; in-package args (already laid out) → fixpoint-
                                ; safe.
                                this.ensure_type_layout((*a_ptr))
                                this.define_type_substitution(p_ptr.name, Planner.rehome_type^this((*a_ptr)))
                            }
                        }
                    }
                    set i: i + 1
                }

                ; Plan the underlying definition so the cache records
                ; the instantiated struct/union. The returned planned
                ; value is unused — we rebuild the PlannedType shell
                ; below with the correct generics/mangled_name.
                ;
                ; Instantiate onto the Planner's OWNING page (not the
                ; threaded `rp`): a generic reached via the s188 lazy
                ; method hook (e.g. Vector[PlannedStatement] from a
                ; scalyls `semantic` walk) can be called with a transient
                ; `rp` — a planner sub-computation's page that is freed
                ; before emission. The recorded PlannedStructure lives in
                ; the persistent `instantiated_structures` field, but its
                ; name/mangled/property/method Strings were built on `rp`
                ; and dangled (read as garbage in emit_struct_type →
                ; String::hash). Pinning to `this.owning_page` makes the
                ; whole instantiation outlive the Planner, matching the
                ; s100 `register_runtime_functions^page()` pattern. Content
                ; is identical to the rp build, so emission is byte-
                ; identical and the bootstrap fixpoint holds.
                ; s200: isolate the scope stack while planning the
                ; instantiation's bodies — bare member names in a generic
                ; method must not resolve to the ENCLOSING function's
                ; same-named locals (see the scope_isolation_base field
                ; comment). Save/restore so nesting composes.
                let saved_iso_base scope_isolation_base
                set scope_isolation_base: scope_bindings.length

                choose c.definition
                    when s: Structure
                    {
                        let pl this.plan_structure^this(s, concept_name)
                        0
                    }
                    when u: scalyc.compiler.Model.Union
                    {
                        let pl this.plan_union^this(u, concept_name)
                        0
                    }
                    else
                        0

                set scope_isolation_base: saved_iso_base

                ; Pop substitutions back to what the caller had.
                set type_substitutions.length: saved_subst_len

                ; Pop instantiating-marker. Length-based pop matches the
                ; type_substitutions discipline above; the add() above
                ; was the only push for this frame.
                if instantiating_structures.length > 0
                    set instantiating_structures.length: instantiating_structures.length - 1
            }

            PlannedType(
                loc,
                String(concept_name),
                mangled,
                &args_holder,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )
        }

        ; ================================================================
        ; check_function_match: test a single Function candidate against
        ; argument types. Returns a ref to the return type if it matches,
        ; null otherwise. `exact_only` selects types_equal (true) vs
        ; types_compatible (false) for parameter/argument comparison.
        ; 'this' parameters are skipped implicitly.
        ; ================================================================
        ; Pure match predicate for overload resolution passes 1 (exact) and
        ; 2 (compatible). NON-`#` on purpose: a #-subcall like plan_type#
        ; allocates on THIS function's local page (not the caller's rp), so
        ; the candidate parameter types planned only to compare against the
        ; args are reclaimed when this returns — instead of accumulating on
        ; the persistent region for every losing candidate of every call
        ; (the dominant transient in -c, measured ~1.2-1.9 MB/LOC of planner
        ; allocation). resolve_function_call# rebuilds the WINNER on rp via
        ; check_function_match#; only the winner's types persist. Mirrors
        ; check_function_match#'s arity + per-param comparison exactly so the
        ; rebuild always agrees. plan_type# is side-effect-free (no
        ; instantiation — pass 3 keeps using check_function_match# directly).
        ; candidate_matches_string_i8: a String argument prefers a
        ; pointer[i8] parameter — the pre-feature representation of a string
        ; literal (before string literals became real String values). Matches
        ; only when EVERY argument is either exactly the parameter type OR a
        ; String against a pointer[i8] parameter, AND at least one String→i8
        ; substitution occurs. Used as a resolution tie-break between the
        ; exact pass (which still picks a real String-parameter overload like
        ; `append(String)`) and the general compatible pass (which would let a
        ; namespace member like Console.print(pointer[const_char]) win for a
        ; bare `print("x")` and then free-mangle to a phantom symbol).
        function candidate_matches_string_i8(
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType]
        ) returns bool
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
            }
            if f.input.length - param_start <> arg_types.length
                return false
            var any_string_i8: bool false
            var all_ok: bool true
            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let planned_p this.plan_type((*p_ptr.type))
                    let arg (*a_ptr)
                    var ok: bool Planner.types_equal(planned_p, arg)
                    if ok = false
                        if arg.name.equals("String")
                            if Planner.type_is_i8_pointer(planned_p)
                            {
                                set ok: true
                                set any_string_i8: true
                            }
                    if ok = false
                        set all_ok: false
                }
                set j: j + 1
            }
            if all_ok = false
                return false
            any_string_i8
        }

        ; type_is_i8_pointer: pointer[i8] specifically (the canonical string
        ; literal target). Distinct from type_is_cstr_pointer, which also
        ; accepts const_char/char/u8.
        function type_is_i8_pointer(t: PlannedType) returns bool
        {
            var result: bool false
            if t.name.equals("pointer")
                if t.generics <> null
                {
                    let gs (*t.generics)
                    if gs.length > 0
                    {
                        let ip gs.get 0
                        if ip <> null
                            if (*ip).name.equals("i8")
                                set result: true
                    }
                }
            result
        }

        function candidate_matches(
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }
            true
        }

        ; Phase-5 class 1: a persist into a receiver that is itself a
        ; frame-local, non-escaping binding does not outlive the frame —
        ; receiver and argument share the frame's lifetime, so promoting
        ; the argument (or hard-erroring on a missing rp) would be a false
        ; positive. The Planner-instance test code hits exactly this shape
        ; (a local Planner collecting constraints built from local-page
        ; types). `this`, parameters, and escaping/promoted locals all
        ; outlive the frame -> not frame-local.
        function persist_receiver_is_frame_local(this: Planner, is_method: bool, recv: PlannedOperand) returns bool
        {
            if is_method = false
                return false
            if recv.member_access <> null
                return false
            choose recv.expr
                when v: Variable
                {
                    if v.name.equals("this")
                        return false
                    let lb this.lookup_local_binding(v.name)
                    if lb = null
                        return false
                    if (*lb).is_parameter
                        return false
                    if this.array_contains_name(escaping_return_locals, v.name)
                        return false
                    if this.array_contains_name(escaping_targets, v.name)
                        return false
                    if this.array_contains_name(promoted_binding_names, v.name)
                        return false
                    return true
                }
                else
                    return false
            false
        }

        ; Phase-5 class 1: memoized persist summary. Key = the callee's
        ; mangled name; value = function_persists_param_guts over the model
        ; body, computed once. Only consulted when a call argument carries
        ; Local life (see the resolution sites), so the walk runs rarely.
        function persists_args_for(this: Planner, mangled: String, f: Function) returns bool
        {
            var idx: size_t 0
            while idx < persist_summary_names.length
            {
                let np persist_summary_names.get idx
                if np <> null
                    if (*np).equals(mangled)
                    {
                        let vp persist_summary_vals.get idx
                        if vp <> null
                            return (*vp) = 1
                        return false
                    }
                set idx: idx + 1
            }
            let computed Planner.function_persists_param_guts(f)
            persist_summary_names.add(String^this(mangled))
            var pv: size_t 0
            if computed
                set pv: 1
            persist_summary_vals.add pv
            computed
        }

        ; Phase-5 class 1 gate: does any argument type carry Local life —
        ; the Design-B local-flip stamp on a call result whose guts live on
        ; THIS frame's local page? Only such calls can need the persist
        ; promotion; sigiled (`#`) arguments carry Call life, so the gate
        ; keeps the summary walk off every sigiled call site (neutrality).
        function args_have_local_life(arg_types: Vector[PlannedType]) returns bool
        {
            var i: size_t 0
            while i < arg_types.length
            {
                let ap arg_types.get i
                if ap <> null
                    if Planner.lifetime_is_local((*ap).life)
                        return true
                set i: i + 1
            }
            false
        }

        function check_function_match(
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[MethodMatch]?
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return null

            var planned_params_arr Array[PlannedType]()
            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return null
                if a_ptr = null
                    return null
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return null
                    ; Ensure a by-value cross-package param type's layout so the
                    ; arg slot is sized correctly (not the { ptr } placeholder).
                    this.ensure_type_layout(planned_p)
                    planned_params_arr.add planned_p
                }
                set j: j + 1
            }
            var params_holder Vector[PlannedType](planned_params_arr)

            var return_type: PlannedType Planner.make_void_type()
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type(rt)
                ; Ensure a by-value cross-package sret return type's layout.
                this.ensure_type_layout(return_type)
            }

            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            if Planner.function_needs_caller_page(this, f)
                set has_page: true

            ; Extern C functions use their unmangled name so the linker
            ; finds them in libc / system libraries. Mirrors
            ; Planner.cpp:9714-9716.
            var mangled: String String(f.name)
            if Planner.is_extern_impl(f.implementation) = false
            {
                ; s101: Namespace sibling call. When the call is being
                ; planned inside a namespace's body and `f` is a member
                ; of that namespace, mangle with the namespace prefix
                ; (e.g. `_ZN6helper5greetEv`) instead of the free-function
                ; encoding (`_Z5greetv`). Mirrors stage-0 Planner.cpp:
                ; 9653-9665 (sibling detection) + 9788-9793 (mangling).
                ; Without this, sibling calls from inside `define helper
                ; { function greet() ... function test() greet() }` link
                ; against a non-existent `_Z5greetv` symbol, the call
                ; falls through to lookup-fail in emit_call, returns
                ; null, and stage-1 silently drops the entire body.
                var is_namespace_sibling: bool false
                if current_namespace <> null
                {
                    if current_namespace_name <> null
                    {
                        let ns (*current_namespace)
                        var mi: size_t 0
                        while mi < ns.members.length
                        {
                            let m_ptr ns.members.get mi
                            if m_ptr <> null
                            {
                                let mem (*m_ptr)
                                choose mem
                                    when nf: Function
                                    {
                                        if nf.name.equals(f.name)
                                        {
                                            if nf.input.length = f.input.length
                                                set is_namespace_sibling: true
                                        }
                                    }
                                    else
                                        0
                            }
                            set mi: mi + 1
                        }
                    }
                }

                ; Determine the namespace to mangle with: the current
                ; namespace for a sibling call, otherwise the namespace of
                ; a use-imported alias matching f.name (s192 — use-aliased
                ; bare calls must mangle `_ZN<ns><fn>E…` like the member's
                ; definition, not the free `_Z<fn>…` which links nowhere).
                var ns_for_mangle ""
                if is_namespace_sibling
                {
                    let cnsn (*current_namespace_name)
                    set ns_for_mangle: String(cnsn)
                }
                if is_namespace_sibling = false
                    set ns_for_mangle: this.lookup_use_alias_namespace(f.name)

                if ns_for_mangle.get_length() = 0
                    set mangled: Planner.mangle_free_function_from_types(
                        f.name, params_holder, has_page
                    )

                if ns_for_mangle.get_length() > 0
                {
                    ; Build a PlannedType for the namespace and items
                    ; for params, then call mangle_function# with parent.
                    let cnsn ns_for_mangle
                    let ns_parent_ref &^this PlannedType(
                        Span(0, 0),
                        String(cnsn),
                        Planner.encode_name cnsn,
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        "",
                        null
                    )
                    var items_arr Array[PlannedItem]()
                    var pi2: size_t 0
                    while pi2 < params_holder.length
                    {
                        let p_ptr2 params_holder.get pi2
                        if p_ptr2 <> null
                        {
                            items_arr.add(PlannedItem(
                                Span(0, 0),
                                false,
                                null,
                                &^this (*p_ptr2),
                                null
                            ))
                        }
                        set pi2: pi2 + 1
                    }
                    var items_holder Vector[PlannedItem](items_arr)
                    set mangled: Planner.mangle_function(
                        f.name, &items_holder, ns_parent_ref, has_page
                    )
                }
            }

            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                set throws_ref: &^this this.plan_type(tt)
            }

            ; Phase-5 class 1: flag the match when a Local-life argument is
            ; passed to a body that persists a parameter's value guts.
            var cfm_persists: bool false
            if Planner.args_have_local_life(arg_types)
            {
                if this.persists_args_for(mangled, f)
                    set cfm_persists: true
            }

            MethodMatch^this(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false,
                false,
                cfm_persists
            )
        }

        ; s-LSP: is `prefix` a namespace declaring a member function named
        ; `suffix` whose first parameter is `this`? Used by the dotted-call
        ; fallback to recognise a namespace this-method invoked qualified
        ; with an explicit receiver (`NS.f(recv, ...)`). Mirrors the member
        ; scan in stage-0's name-only Namespace path (Planner.cpp:8663-8674).
        ; Kept out of collapse_operand_sequence# (its frame is the heaviest
        ; in the compiler) so stage-1 emits it correctly into stage-2.
        function is_namespace_this_method(this: Planner, prefix: String, suffix: String) returns bool
        {
            let ns_chk this.lookup_namespace_concept(prefix)
            if ns_chk <> null
            {
                let nsc_chk (*ns_chk)
                choose nsc_chk.definition
                    when nd_chk: Namespace
                    {
                        var mci: size_t 0
                        while mci < nd_chk.members.length
                        {
                            let mcp nd_chk.members.get mci
                            if mcp <> null
                            {
                                let mc (*mcp)
                                choose mc
                                    when ncf: Function
                                    {
                                        if ncf.name.equals(suffix)
                                        {
                                            if ncf.input.length > 0
                                            {
                                                let nmi0 ncf.input.get 0
                                                if nmi0 <> null
                                                {
                                                    if nmi0.name <> null
                                                    {
                                                        if (*nmi0.name).equals("this")
                                                            return true
                                                    }
                                                }
                                            }
                                        }
                                        0
                                    }
                                    else
                                        0
                            }
                            set mci: mci + 1
                        }
                    }
                    else
                        0
            }
            false
        }

        ; s-LSP: resolve `NS.f(recv, ...)` where `f(this: T, ...)` is a
        ; namespace this-method invoked qualified with an explicit receiver.
        ; Returns the MethodMatch (this-implicit, so `_ZN<ns><fn>E…`) or null.
        ; Builds the receiver-dropped argument list in ITS OWN frame and
        ; resolves the this-implicit overload; the caller's namespace-mangling
        ; block then rebuilds the namespaced mangled name. Kept whole here so
        ; collapse_operand_sequence# adds no locals (its s178 alloca pool
        ; mis-aliases any added there — see the call site).
        function resolve_namespace_this_method(
            this: Planner,
            prefix: String,
            suffix: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            if arg_types.length > 0
            {
                if this.is_namespace_this_method(prefix, suffix)
                {
                    var tail_arr Array[PlannedType]()
                    var tci: size_t 1
                    while tci < arg_types.length
                    {
                        let tap arg_types.get tci
                        if tap <> null
                            tail_arr.add((*tap))
                        set tci: tci + 1
                    }
                    var tail_vec Vector[PlannedType](tail_arr)
                    return this.resolve_function_call(suffix, tail_vec)
                }
            }
            null
        }

        ; s-LSP: the dotted-call fallback's resolution, as ONE call so the
        ; caller (collapse_operand_sequence#) keeps a single `set match_ref:`
        ; statement — adding a branch there perturbed its s178 alloca pool.
        ; Try the normal this-implicit overload first; if that misses, try the
        ; namespace this-method-with-explicit-receiver form.
        function resolve_dotted_call(
            this: Planner,
            prefix: String,
            suffix: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            let m this.resolve_function_call(suffix, arg_types)
            if m <> null
                return m
            this.resolve_namespace_this_method(prefix, suffix, arg_types)
        }

        ; ================================================================
        ; resolve_function_call: return a MethodMatch describing the
        ; chosen overload of `name` for the given argument types. Two-pass
        ; overload resolution: exact matches first, then compatible
        ; (widened), then generic instantiation. 'this' parameters are
        ; implicitly skipped.
        ;
        ; Returns null when no overload matches; callers fall back to a
        ; fresh type variable so the constraint solver can recover.
        ; ================================================================
        function resolve_function_call(
            this: Planner,
            name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            let candidates this.lookup_functions(name)
            if candidates.length = 0
            {
                var sb StringBuilder()
                sb.append "function not found: "
                sb.append name
                this.add_error(sb.to_string())
                return null
            }

            ; Pass 1: exact matches (types_equal).
            var i: size_t 0
            while i < candidates.length
            {
                let f_ptr candidates.get i
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if this.candidate_matches(f, arg_types, true)
                        return this.check_function_match(f, arg_types, true)
                }
                set i: i + 1
            }

            ; Pass 1.5: a String argument prefers a pointer[i8] overload (its
            ; pre-feature representation) over a pointer[const_char] one. Keeps
            ; `print("x")` resolving to the prelude print(pointer[i8]) instead
            ; of a namespace member Console.print(pointer[const_char]) that the
            ; general compatible pass would otherwise pick and free-mangle to a
            ; phantom `_Z5printP10const_char`. A real String-parameter overload
            ; already won in Pass 1, so this never displaces e.g. append(String).
            var i15: size_t 0
            while i15 < candidates.length
            {
                let f_ptr candidates.get i15
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if this.candidate_matches_string_i8(f, arg_types)
                        return this.check_function_match(f, arg_types, false)
                }
                set i15: i15 + 1
            }

            ; Pass 2: compatible matches (types_compatible, allows widening).
            var k: size_t 0
            while k < candidates.length
            {
                let f_ptr candidates.get k
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if this.candidate_matches(f, arg_types, false)
                        return this.check_function_match(f, arg_types, false)
                }
                set k: k + 1
            }

            ; Pass 3: generic overload. For candidates declaring type
            ; parameters, plan the declared parameter types and run
            ; pattern inference against the argument types. On a
            ; successful inference, instantiate the generic and build a
            ; MethodMatch from the instantiated PlannedFunction.
            var g: size_t 0
            while g < candidates.length
            {
                let f_ptr candidates.get g
                if f_ptr <> null
                {
                    let f (*f_ptr)
                    if f.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        if f.input.length > 0
                        {
                            let fi0 f.input.get 0
                            if fi0 <> null
                            {
                                if fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    if fname.equals("this")
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity f.input.length - param_start2
                        if expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]()
                            var pi: size_t param_start2
                            while pi < f.input.length
                            {
                                let p_ptr f.input.get pi
                                if p_ptr <> null
                                {
                                    if p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType](param_types_arr)

                            let bindings this.infer_type_arguments(
                                param_types_vec, arg_types
                            )
                            if bindings.length >= f.parameters.length
                            {
                                let inst this.instantiate_generic_function(f, bindings)
                                var inst_return: PlannedType Planner.make_void_type()
                                if inst.return_type <> null
                                    set inst_return: (*inst.return_type)

                                var gm_takes_this: bool false
                                if param_start2 > 0
                                    set gm_takes_this: true
                                return MethodMatch^this(
                                    null,
                                    inst.mangled_name,
                                    inst_return,
                                    &param_types_vec,
                                    inst.page_parameter <> null,
                                    inst.can_throw,
                                    inst.throws_type,
                                    false,
                                    gm_takes_this,
                                    false
                                )
                            }
                        }
                    }
                }
                set g: g + 1
            }

            var sb StringBuilder()
            sb.append "no matching overload for function: "
            sb.append name
            this.add_error(sb.to_string())
            null
        }

        ; mangle_binary_operator: convenience wrapper that constructs
        ; the PlannedItem list mangle_operator expects from two
        ; PlannedType arguments. Holder Vectors keep both types alive
        ; on rp so their refs are stable for the Item construction.
        function mangle_binary_operator(
            this: Planner,
            op_name: String,
            left: PlannedType,
            right: PlannedType
        ) returns String
        {
            var items Vector[PlannedItem](2)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, &^this left, null
            ))
            items.put(1, PlannedItem(
                Span(0, 0), false, null, &^this right, null
            ))

            Planner.mangle_operator(op_name, &items, null)
        }

        ; mangle_unary_operator: same idea for prefix/unary operators.
        function mangle_unary_operator(
            this: Planner,
            op_name: String,
            operand: PlannedType
        ) returns String
        {
            var items Vector[PlannedItem](1)
            items.put(0, PlannedItem(
                Span(0, 0), false, null, &^this operand, null
            ))

            Planner.mangle_operator(op_name, &items, null)
        }

        ; make_planned_call: assemble a PlannedCall for a resolved call
        ; site. Callers provide the mangled symbol, result type, and
        ; planned argument list; flags default to the common
        ; "non-intrinsic, non-operator, non-throwing, no-page" case.
        function make_planned_call(
            this: Planner,
            loc: Span,
            name: String,
            mangled_name: String,
            result_type: PlannedType,
            args: Vector[PlannedOperand]
        ) returns PlannedCall
        {
            ; Ensure by-value cross-package struct/union layouts (sret return +
            ; each by-value arg) so map_type emits the real type, not the s114
            ; { ptr } placeholder — see ensure_type_layout#.
            this.ensure_type_layout(result_type)
            var at_i: size_t 0
            while at_i < args.length
            {
                let ao args.get at_i
                if ao <> null
                    this.ensure_type_layout((*ao).result_type)
                set at_i: at_i + 1
            }
            var args_holder Vector[PlannedOperand](args)
            PlannedCall(
                loc,
                name,
                mangled_name,
                false,
                false,
                false,
                false,
                &args_holder,
                result_type,
                Lifetime.Unspecified(Unspecified()),
                null,
                false
            )
        }

        ; True when t is pointer[const_char] / pointer[i8] / pointer[char] /
        ; pointer[u8] — a C-string parameter position. A String argument bound
        ; to such a parameter must be lowered to its c_data content pointer.
        function type_is_cstr_pointer(t: PlannedType) returns bool
        {
            var result: bool false
            if t.name.equals("pointer")
                if t.generics <> null
                {
                    let gs (*t.generics)
                    if gs.length > 0
                    {
                        let ip gs.get 0
                        if ip <> null
                        {
                            let inner (*ip)
                            if inner.name.equals("const_char")
                                set result: true
                            if inner.name.equals("i8")
                                set result: true
                            if inner.name.equals("char")
                                set result: true
                            if inner.name.equals("u8")
                                set result: true
                        }
                    }
                }
            result
        }

        ; coerce_string_args_to_cstr: for a resolved call, wrap each String
        ; argument whose matched parameter is a pointer[const_char]-like type
        ; in a PlannedAs(target = param_type). emit_as then lowers the String
        ; to its NUL-terminated c_data pointer (a constant to the plain .str
        ; global; a variable via get_buffer). This decision MUST live in the
        ; planner: at the LLVM level a by-value String parameter and a
        ; const_char parameter are both `ptr`, and a generic instantiated
        ; method's parameter is not present in current_plan.functions — so the
        ; emitter cannot tell them apart. Here the substituted parameter type
        ; is known. param_types excludes `this` in every resolution path, so
        ; the user arguments are tail-aligned (a prepended receiver, present
        ; for an instance-method dispatch, is absorbed by the offset).
        function coerce_string_args_to_cstr(
            this: Planner,
            args: Vector[PlannedOperand],
            param_types: Vector[PlannedType]
        ) returns Vector[PlannedOperand]
        {
            if param_types.length = 0
                return Vector[PlannedOperand](args)
            if args.length < param_types.length
                return Vector[PlannedOperand](args)
            let offset args.length - param_types.length
            var out Array[PlannedOperand]()
            var ai: size_t 0
            while ai < args.length
            {
                let ap args.get ai
                if ap <> null
                {
                    let a (*ap)
                    var wrapped: bool false
                    if ai >= offset
                    {
                        let pp param_types.get(ai - offset)
                        if pp <> null
                        {
                            let pt (*pp)
                            if a.result_type.name.equals("String")
                                if Planner.type_is_cstr_pointer(pt)
                                {
                                    let casted PlannedAs(a.loc, pt, &^this a)
                                    out.add(PlannedOperand(
                                        a.loc,
                                        PlannedExpression.As casted,
                                        null,
                                        pt
                                    ))
                                    set wrapped: true
                                }
                        }
                    }
                    if wrapped = false
                        out.add a
                }
                set ai: ai + 1
            }
            Vector[PlannedOperand](out)
        }

        ; If `op` is a Phase-1 lambda binding name used as a callable head (a
        ; bare PlannedType with no generics, or an unresolved Variable, with no
        ; member-access chain), return that lambda name; otherwise the empty
        ; string. The lambda binding emits no runtime value, so the name arrives
        ; here unresolved — this is how a lambda call is recognized.
        function lambda_head_name(this: Planner, op: PlannedOperand) returns String
        {
            if op.member_access <> null
                return ""
            var nm ""
            choose op.expr
                when lht: PlannedType
                {
                    if lht.generics = null
                        set nm: lht.name
                }
                when lhv: Variable
                    set nm: lhv.name
                else
                    0
            if nm.get_length() = 0
                return ""
            if this.lookup_lambda_model(nm) <> null
                return nm
            ""
        }

        ; Resolve a Phase-1 lambda call `name(args)` into a direct call to the
        ; monomorphized function. `head_loc` is the call-site span, `lc_name`
        ; the lambda binding name, `lc_lam` its recorded model, `lc_tp` the
        ; argument Tuple. monomorphize_lambda# plans the body with the call's
        ; argument types and synthesizes a concrete top-level function; the
        ; captures it discovers are looked up at the call site (where they are
        ; in scope) and prepended as leading arguments (capture by value).
        function resolve_lambda_call(this: Planner, head_loc: Span, lc_name: String, lc_lam: Lambda, lc_tp: PlannedTuple) returns PlannedOperand
        {
            var lc_arg_ops Array[PlannedOperand]()
            var lc_arg_types Array[PlannedType]()
            if lc_tp.components <> null
            {
                let lc_comps (*lc_tp.components)
                var lc_ci: size_t 0
                while lc_ci < lc_comps.length
                {
                    let lc_cp lc_comps.get lc_ci
                    if lc_cp <> null
                    {
                        if (*lc_cp).value <> null
                        {
                            let lc_vals (*(*lc_cp).value)
                            if lc_vals.length > 0
                            {
                                let lc_collapsed this.collapse_operand_sequence(lc_vals)
                                lc_arg_ops.add lc_collapsed
                                lc_arg_types.add lc_collapsed.result_type
                            }
                        }
                    }
                    set lc_ci: lc_ci + 1
                }
            }
            var lc_at_vec Vector[PlannedType](lc_arg_types)
            let lc_mono this.monomorphize_lambda(lc_name, lc_lam, lc_at_vec)
            let lc_mangled lc_mono.mangled
            ; Prepend the captured values (looked up at the call site, where they
            ; are in scope) as leading arguments — they map to the synthesized
            ; function's leading capture parameters.
            var lc_full_args Array[PlannedOperand]()
            if lc_mono.captures <> null
            {
                let lc_caps (*lc_mono.captures)
                var lc_capi: size_t 0
                while lc_capi < lc_caps.length
                {
                    let lc_cap_ptr lc_caps.get lc_capi
                    if lc_cap_ptr <> null
                    {
                        let lc_capn (*lc_cap_ptr)
                        let lc_cap_lb this.lookup_local_binding(lc_capn)
                        if lc_cap_lb <> null
                        {
                            let lc_cap_ty (*lc_cap_lb).binding_type
                            let lc_cap_mut (*lc_cap_lb).is_mutable
                            let lc_cap_var PlannedVariable(head_loc, String(lc_capn), lc_cap_ty, lc_cap_mut)
                            lc_full_args.add(PlannedOperand(head_loc, PlannedExpression.Variable lc_cap_var, null, lc_cap_ty))
                        }
                    }
                    set lc_capi: lc_capi + 1
                }
            }
            var lc_afi: size_t 0
            while lc_afi < lc_arg_ops.length
            {
                let lc_ao_ptr lc_arg_ops.get lc_afi
                if lc_ao_ptr <> null
                    lc_full_args.add((*lc_ao_ptr))
                set lc_afi: lc_afi + 1
            }
            var lc_ret Planner.make_void_type()
            let lc_fidx function_name_index.lookup(lc_mangled)
            if lc_fidx >= 0
            {
                let lc_fptr instantiated_functions.get lc_fidx
                if lc_fptr <> null
                {
                    if (*lc_fptr).return_type <> null
                        set lc_ret: (*(*lc_fptr).return_type)
                }
            }
            var lc_call_args Vector[PlannedOperand](lc_full_args)
            let lc_pc this.make_planned_call(head_loc, lc_name, lc_mangled, lc_ret, lc_call_args)
            PlannedOperand(head_loc, PlannedExpression.Call lc_pc, null, lc_ret)
        }

        ; collapse_operand_sequence: fold a flat operand list of the
        ; shape [lhs, op, rhs, op, rhs, ...] into a single PlannedOperand
        ; representing the combined expression. LEFT-ASSOCIATIVE — this
        ; drops operator precedence; a full precedence-climbing version
        ; is a later refactor. Empty and single-element inputs pass
        ; through unchanged.
        function collapse_operand_sequence(
            this: Planner,
            ops: Vector[PlannedOperand]
        ) returns PlannedOperand
        {
            if ops.length = 0
            {
                let void_ty Planner.make_void_type()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }
            if ops.length = 1
            {
                let only_ptr ops.get 0
                if only_ptr = null
                {
                    let void_ty Planner.make_void_type()
                    return PlannedOperand(
                        Span(0, 0),
                        PlannedExpression.Type void_ty,
                        null,
                        void_ty
                    )
                }
                ; Parenless zero-arg method call: a lone operand whose
                ; member_access chain ends in an is_method hop (e.g.
                ; `name.length`, `sb.get_length`). The ops>=2 method-on-
                ; chain dispatch only fires when an args Tuple follows, so
                ; a parenless trailing method would otherwise be returned
                ; as-is and emit_member_access_chain treats it as a field
                ; access — silently dropping the binding (encode_name's
                ; `let len name.length` cascade). Synthesize an empty `()`
                ; Tuple as a second operand and recurse, reusing the same
                ; machinery that already handles `name.length()`. Mirrors
                ; stage-0's IsZeroArgMethodCall auto-call (Planner.cpp:5117).
                let only_op (*only_ptr)
                if only_op.member_access <> null
                {
                    let ma (*only_op.member_access)
                    if ma.length > 0
                    {
                        let last_ptr ma.get(ma.length - 1)
                        if last_ptr <> null
                        {
                            let last_hop (*last_ptr)
                            if last_hop.is_method
                            {
                                let void_ty Planner.make_void_type()
                                let empty_tuple PlannedTuple(
                                    only_op.loc,
                                    null,
                                    void_ty,
                                    false,
                                    Lifetime.Unspecified(Unspecified()),
                                    null
                                )
                                let tuple_op PlannedOperand(
                                    only_op.loc,
                                    PlannedExpression.Tuple empty_tuple,
                                    null,
                                    void_ty
                                )
                                var two_arr Array[PlannedOperand]()
                                two_arr.add only_op
                                two_arr.add tuple_op
                                var two_vec Vector[PlannedOperand](two_arr)
                                return this.collapse_operand_sequence(two_vec)
                            }
                        }
                    }
                }
                return (*only_ptr)
            }

            ; Indirect call through a function pointer (Phase-1 JIT): `f()`
            ; where f is a local binding of type pointer[void] and `()` is
            ; empty. The self-hosted JIT (cli --run) invokes an ORC-resolved
            ; address this way. No existing construct calls a pointer[void]
            ; local (it would be a hard "function not found"), so this can't
            ; shadow real code. Returns i64. Mirrors stage-0's planOperands
            ; indirect-call intercept (Planner.cpp).
            if ops.length = 2
            {
                let ic_head_ptr ops.get 0
                let ic_tail_ptr ops.get 1
                if ic_head_ptr <> null
                {
                    if ic_tail_ptr <> null
                    {
                        let ic_head (*ic_head_ptr)
                        let ic_tail (*ic_tail_ptr)
                        var ic_is_empty_tuple: bool false
                        choose ic_tail.expr
                            when t: PlannedTuple
                            {
                                if t.components = null
                                    set ic_is_empty_tuple: true
                                if t.components <> null
                                {
                                    if (*t.components).length = 0
                                        set ic_is_empty_tuple: true
                                }
                            }
                            else
                                0
                        var ic_is_void_ptr: bool false
                        choose ic_head.expr
                            when v: Variable
                            {
                                let vt v.variable_type
                                if vt.name.equals("pointer")
                                {
                                    if vt.generics <> null
                                    {
                                        if (*vt.generics).length = 1
                                        {
                                            let g0_ptr (*vt.generics).get(0)
                                            if g0_ptr <> null
                                            {
                                                if (*g0_ptr).name.equals("void")
                                                    set ic_is_void_ptr: true
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                        if ic_is_empty_tuple
                        {
                            if ic_is_void_ptr
                            {
                                let i64_ty Planner.make_i64_type()
                                var ic_args Vector[PlannedOperand](1)
                                ic_args.put(0, ic_head)
                                var ic_args_holder Vector[PlannedOperand](ic_args)
                                let ic_call PlannedCall(
                                    ic_head.loc,
                                    "__jit_indirect",
                                    "",
                                    false,
                                    false,
                                    false,
                                    false,
                                    &ic_args_holder,
                                    i64_ty,
                                    Lifetime.Unspecified(Unspecified()),
                                    null,
                                    true
                                )
                                return PlannedOperand(
                                    ic_head.loc,
                                    PlannedExpression.Call ic_call,
                                    null,
                                    i64_ty
                                )
                            }
                        }

                        ; GAP B: indirect call through a delegate-typed value
                        ; `f(args)` where f is a Variable of a delegate type.
                        ; Build an is_indirect PlannedCall whose args are
                        ; [callee, arg0, arg1, ...]; the emitter reconstructs
                        ; the LLVM function type from the planned arg types +
                        ; the delegate's return type.
                        var ic_del_name ""
                        choose ic_head.expr
                            when v: Variable
                                if this.is_delegate_type(v.variable_type.name)
                                    set ic_del_name: v.variable_type.name
                            else
                                0
                        if ic_del_name.get_length() > 0
                        {
                            var dcall_is_tuple: bool false
                            choose ic_tail.expr
                                when dtp: PlannedTuple
                                    set dcall_is_tuple: true
                                else
                                    0
                            if dcall_is_tuple
                            {
                                var dc_args Array[PlannedOperand]()
                                dc_args.add ic_head
                                choose ic_tail.expr
                                    when dtp: PlannedTuple
                                    {
                                        if dtp.components <> null
                                        {
                                            let dcomps (*dtp.components)
                                            var dci: size_t 0
                                            while dci < dcomps.length
                                            {
                                                let dcp dcomps.get dci
                                                if dcp <> null
                                                    if (*dcp).value <> null
                                                    {
                                                        let dvals (*(*dcp).value)
                                                        if dvals.length > 0
                                                        {
                                                            let dca this.collapse_operand_sequence(dvals)
                                                            dc_args.add dca
                                                        }
                                                    }
                                                set dci: dci + 1
                                            }
                                        }
                                    }
                                    else
                                        0
                                let dc_ret this.delegate_return_type(ic_del_name)
                                var dc_args_holder Vector[PlannedOperand](dc_args)
                                let dc_call PlannedCall(
                                    ic_head.loc,
                                    "indirect",
                                    "",
                                    false,
                                    false,
                                    false,
                                    false,
                                    &dc_args_holder,
                                    dc_ret,
                                    Lifetime.Unspecified(Unspecified()),
                                    null,
                                    true
                                )
                                return PlannedOperand(
                                    ic_head.loc,
                                    PlannedExpression.Call dc_call,
                                    null,
                                    dc_ret
                                )
                            }
                        }
                    }
                }
            }

            ; Phase-1 lambda call: resolve any adjacent `[lambdaName, Tuple]`
            ; pair anywhere in the flat operand list into a single direct call
            ; to the monomorphized lambda function — BEFORE the precedence /
            ; binary loop runs — so lambda calls embedded in larger expressions
            ; work (`a + inc(5)`, `inc(5) + add(3, 4)`), not only when the call
            ; is the whole operand sequence. lambdaName is recognized by
            ; lambda_head_name# (a bare PlannedType/Variable in lambda_models).
            ; The pair is replaced by the resolved call operand and the shorter
            ; list re-collapsed; the strictly-decreasing length terminates.
            if ops.length >= 2
            {
                var lp_i: size_t 0
                var lp_found: bool false
                var lp_at: size_t 0
                while lp_i + 1 < ops.length
                {
                    if lp_found = false
                    {
                        let lp_h_ptr ops.get lp_i
                        let lp_t_ptr ops.get(lp_i + 1)
                        if lp_h_ptr <> null
                        {
                            if lp_t_ptr <> null
                            {
                                let lp_name this.lambda_head_name((*lp_h_ptr))
                                if lp_name.get_length() > 0
                                {
                                    var lp_is_tuple: bool false
                                    choose (*lp_t_ptr).expr
                                        when lp_tp_chk: PlannedTuple
                                            set lp_is_tuple: true
                                        else
                                            0
                                    if lp_is_tuple
                                    {
                                        set lp_found: true
                                        set lp_at: lp_i
                                    }
                                }
                            }
                        }
                    }
                    set lp_i: lp_i + 1
                }
                if lp_found
                {
                    let lp_h_ptr ops.get lp_at
                    let lp_t_ptr ops.get(lp_at + 1)
                    let lp_head (*lp_h_ptr)
                    let lp_name this.lambda_head_name(lp_head)
                    let lp_lam_ref this.lookup_lambda_model(lp_name)
                    if lp_lam_ref <> null
                    {
                        choose (*lp_t_ptr).expr
                            when lp_tp: PlannedTuple
                            {
                                let lp_call this.resolve_lambda_call(lp_head.loc, lp_name, (*lp_lam_ref), lp_tp)
                                ; Rebuild the operand list with the [name, Tuple]
                                ; pair replaced by the single resolved call
                                ; operand, then recurse on the strictly-shorter
                                ; list.
                                var lp_new Array[PlannedOperand]()
                                var lp_k: size_t 0
                                while lp_k < ops.length
                                {
                                    if lp_k = lp_at
                                        lp_new.add lp_call
                                    else
                                    {
                                        if lp_k <> lp_at + 1
                                        {
                                            let lp_op_ptr ops.get lp_k
                                            if lp_op_ptr <> null
                                                lp_new.add (*lp_op_ptr)
                                        }
                                    }
                                    set lp_k: lp_k + 1
                                }
                                var lp_new_vec Vector[PlannedOperand](lp_new)
                                return this.collapse_operand_sequence(lp_new_vec)
                            }
                            else
                                0
                    }
                }
            }

            ; s107: pre-pass — combine `Type + Matrix` into a generic
            ; Type with concrete generic args. The Modeler emits
            ; `Box[int](42)` as three operands [Type(Box), Matrix([int]),
            ; Tuple((42))] because NameSyntax has no generics field
            ; (parser puts the bracket part as a separate VectorSyntax
            ; → Matrix in the operand list). Without this merger,
            ; the struct-ctor branch below sees `Box` (no generics) and
            ; can't instantiate Box[int]. Mirrors stage-0
            ; Planner.cpp:7170-7247.
            ;
            ; Restricted to the common simple shape: Type with no
            ; existing generics + Matrix where each row is a single
            ; Type operand. Nested generics like Box[Box[int]] need
            ; the recursive extractor stage-0 has — leave that for a
            ; later port.
            var has_gen_combo: bool false
            var gci: size_t 0
            while gci + 1 < ops.length
            {
                let cur_ptr ops.get gci
                let nxt_ptr ops.get(gci + 1)
                if cur_ptr <> null
                {
                    if nxt_ptr <> null
                    {
                        let cur_op (*cur_ptr)
                        let nxt_op (*nxt_ptr)
                        var cur_is_bare_type: bool false
                        choose cur_op.expr
                            when ct: PlannedType
                            {
                                if ct.name.get_length() > 0
                                    if ct.generics = null
                                        set cur_is_bare_type: true
                            }
                            else
                                0
                        if cur_is_bare_type
                        {
                            choose nxt_op.expr
                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                    set has_gen_combo: true
                                else
                                    0
                        }
                    }
                }
                set gci: gci + 1
            }

            if has_gen_combo
            {
                var merged_arr2 Array[PlannedOperand]()
                var ci2: size_t 0
                while ci2 < ops.length
                {
                    let cp_ptr ops.get ci2
                    if cp_ptr = null
                    {
                        set ci2: ci2 + 1
                        continue
                    }
                    let cp_op (*cp_ptr)

                    ; Try to merge with the next operand if it's a Matrix.
                    var did_merge2: bool false
                    if ci2 + 1 < ops.length
                    {
                        let np_ptr ops.get(ci2 + 1)
                        if np_ptr <> null
                        {
                            let np_op (*np_ptr)
                            choose cp_op.expr
                                when ct2: PlannedType
                                {
                                    if ct2.name.get_length() > 0
                                    {
                                        if ct2.generics = null
                                        {
                                            choose np_op.expr
                                                when nm2: scalyc.compiler.Plan.PlannedMatrix
                                                {
                                                    ; Extract one Type from each row using the
                                                    ; recursive helper so nested generics like
                                                    ; Box[Box[int]] (row.length==2: [Type, Matrix])
                                                    ; resolve correctly. Mirrors stage-0
                                                    ; Planner.cpp:7180-7214 (extractTypeFromRow).
                                                    var ok_extract: bool true
                                                    var gens_arr Array[Type]()
                                                    if nm2.operations <> null
                                                    {
                                                        let rows (*nm2.operations)
                                                        var ri: size_t 0
                                                        while ri < rows.length
                                                        {
                                                            let row_ptr rows.get ri
                                                            if row_ptr <> null
                                                            {
                                                                let row (*row_ptr)
                                                                let extracted Planner.extract_row_to_type(row)
                                                                if extracted = null
                                                                    set ok_extract: false
                                                                if extracted <> null
                                                                    gens_arr.add((*extracted))
                                                            }
                                                            set ri: ri + 1
                                                        }
                                                    }
                                                    if ok_extract
                                                    {
                                                        if gens_arr.length > 0
                                                        {
                                                            var name_path Vector[String](1)
                                                            name_path.put(0, ct2.name)
                                                            var model_gens Vector[Type](gens_arr)
                                                            ; Use the Matrix's lifetime when set —
                                                            ; `Vector[T]^rp` parses [T]^rp as a Matrix
                                                            ; carrying the lifetime, not the bare Type
                                                            ; that precedes it. Mirrors stage-0
                                                            ; Planner.cpp:7235-7237.
                                                            var final_life: Lifetime ct2.life
                                                            choose nm2.life
                                                                when u: Unspecified
                                                                    0
                                                                else
                                                                    set final_life: nm2.life
                                                            let merged_type this.plan_type(Type(
                                                                ct2.loc,
                                                                name_path,
                                                                &model_gens,
                                                                final_life
                                                            ))
                                                            ; s184: the Matrix operand's member
                                                            ; chain was resolved against the
                                                            ; matrix ELEMENT type (garbage for
                                                            ; `Option[int].None`) — re-resolve
                                                            ; it against the merged generic
                                                            ; type. A lone variant hop with no
                                                            ; argument tuple following becomes
                                                            ; a unit VariantConstruction
                                                            ; (stage-0 Planner.cpp:9342); with
                                                            ; a tuple it stays a Type operand
                                                            ; carrying the resolved variant hop
                                                            ; for the construction gate.
                                                            var merged_op PlannedOperand(
                                                                cp_op.loc,
                                                                PlannedExpression.Type merged_type,
                                                                np_op.member_access,
                                                                merged_type
                                                            )
                                                            if np_op.member_access <> null
                                                            {
                                                                let raw_ma (*np_op.member_access)
                                                                if raw_ma.length > 0
                                                                {
                                                                    var ma_names Vector[String](raw_ma.length)
                                                                    var mni: size_t 0
                                                                    while mni < raw_ma.length
                                                                    {
                                                                        let mn_ptr raw_ma.get mni
                                                                        if mn_ptr <> null
                                                                            ma_names.put(mni, (*mn_ptr).name)
                                                                        set mni: mni + 1
                                                                    }
                                                                    let re_chain this.resolve_member_access(merged_type, ma_names)
                                                                    if re_chain.length = 1
                                                                    {
                                                                        let rc0_ptr re_chain.get 0
                                                                        if rc0_ptr <> null
                                                                        {
                                                                            let rc0 (*rc0_ptr)
                                                                            if rc0.is_union_value
                                                                            {
                                                                                var next_is_tuple: bool false
                                                                                if ci2 + 2 < ops.length
                                                                                {
                                                                                    let t2_ptr ops.get(ci2 + 2)
                                                                                    if t2_ptr <> null
                                                                                    {
                                                                                        choose (*t2_ptr).expr
                                                                                            when mt2: PlannedTuple
                                                                                                set next_is_tuple: true
                                                                                            else
                                                                                                0
                                                                                    }
                                                                                }
                                                                                if next_is_tuple = false
                                                                                {
                                                                                    let unit_vc2 PlannedVariantConstruction(
                                                                                        cp_op.loc,
                                                                                        merged_type,
                                                                                        rc0.name,
                                                                                        rc0.field_index,
                                                                                        null
                                                                                    )
                                                                                    set merged_op: PlannedOperand(
                                                                                        cp_op.loc,
                                                                                        PlannedExpression.VariantConstruction unit_vc2,
                                                                                        null,
                                                                                        merged_type
                                                                                    )
                                                                                }
                                                                                if next_is_tuple
                                                                                {
                                                                                    var rh_holder Vector[PlannedMemberAccess](re_chain)
                                                                                    set merged_op: PlannedOperand(
                                                                                        cp_op.loc,
                                                                                        PlannedExpression.Type merged_type,
                                                                                        &rh_holder,
                                                                                        merged_type
                                                                                    )
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                            merged_arr2.add merged_op
                                                            set did_merge2: true
                                                        }
                                                    }
                                                    ; s192: stack-array pattern
                                                    ; `primitive[N]`. The generic
                                                    ; extraction above fails (the
                                                    ; row is an integer Constant,
                                                    ; not a Type), so build a
                                                    ; size-as-generic model Type and
                                                    ; let plan_type# rewrite it to
                                                    ; pointer[T] with array_size set.
                                                    ; Mirrors stage-0
                                                    ; Planner.cpp:7249-7289.
                                                    if did_merge2 = false
                                                    {
                                                        if Planner.is_primitive_type_name(ct2.name)
                                                        {
                                                            let sz Planner.matrix_single_int_size(nm2)
                                                            if sz.get_length() > 0
                                                            {
                                                                var sz_path Vector[String](1)
                                                                sz_path.put(0, sz)
                                                                var sz_gens Vector[Type](1)
                                                                sz_gens.put(0, Type(
                                                                    ct2.loc,
                                                                    sz_path,
                                                                    null,
                                                                    Lifetime.Unspecified(Unspecified())
                                                                ))
                                                                var arr_name_path Vector[String](1)
                                                                arr_name_path.put(0, ct2.name)
                                                                let arr_type this.plan_type(Type(
                                                                    ct2.loc,
                                                                    arr_name_path,
                                                                    &sz_gens,
                                                                    ct2.life
                                                                ))
                                                                merged_arr2.add(PlannedOperand(
                                                                    cp_op.loc,
                                                                    PlannedExpression.Type arr_type,
                                                                    null,
                                                                    arr_type
                                                                ))
                                                                set did_merge2: true
                                                            }
                                                        }
                                                    }
                                                    0
                                                }
                                                else
                                                    0
                                        }
                                    }
                                    0
                                }
                                else
                                    0
                        }
                    }

                    if did_merge2
                    {
                        set ci2: ci2 + 2
                        continue
                    }

                    merged_arr2.add cp_op
                    set ci2: ci2 + 1
                }
                var merged_vec2 Vector[PlannedOperand](merged_arr2)
                ; s138: progress guard. If the rebuild produced the
                ; same length (no actual merges — e.g.,
                ; extract_row_to_type# returned null for every row),
                ; recursing would loop forever. Fall through to the
                ; rest of the function instead.
                if merged_vec2.length < ops.length
                    return this.collapse_operand_sequence(merged_vec2)
            }

            ; Pre-pass: merge lifetime-marker operands into the
            ; preceding Type operand. Runs AFTER the s107 generic
            ; merger so that `Vector[String]^rp(1)` (parsed as
            ; [Type(Vector), Matrix([String]), Marker(^rp), Tuple])
            ; first becomes [Type(Vector,[String]), Marker, Tuple]
            ; and then [Type(Vector,[String], life=Reference("rp")),
            ; Tuple]. With the original ordering (lifetime first),
            ; the marker would be dropped because the previous op is
            ; a Matrix, not a Type — silently losing the lifetime.
            ; Mirrors stage-0 Planner.cpp:7378-7387.
            var has_life_marker: bool false
            var lim_idx: size_t 0
            while lim_idx < ops.length
            {
                let lim_ptr ops.get lim_idx
                if lim_ptr <> null
                {
                    let lim_op (*lim_ptr)
                    choose lim_op.expr
                        when ty: PlannedType
                        {
                            if ty.name.get_length() = 0
                            {
                                ; A PlannedType with empty name is
                                ; the lifetime marker.
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                        set has_life_marker: true
                            }
                            0
                        }
                        else
                            0
                }
                set lim_idx: lim_idx + 1
            }

            if has_life_marker
            {
                ; Build a fresh ops Vector that drops the markers and
                ; merges each one's lifetime into the preceding
                ; PlannedType operand (if any). Look ahead from each
                ; current op: if it is a Type AND the next op is a
                ; lifetime marker, append the merged Type and skip
                ; both. Otherwise append unmodified.
                var merged_arr Array[PlannedOperand]()
                var mi: size_t 0
                while mi < ops.length
                {
                    let mp_ptr ops.get mi
                    if mp_ptr = null
                    {
                        set mi: mi + 1
                        continue
                    }
                    let mp_op (*mp_ptr)

                    ; If THIS op is a marker (no prior Type to merge
                    ; into), drop it.
                    var is_marker: bool false
                    var this_marker_life: Lifetime Lifetime.Unspecified(Unspecified())
                    choose mp_op.expr
                        when ty: PlannedType
                        {
                            if ty.name.get_length() = 0
                            {
                                choose ty.life
                                    when u: Unspecified
                                        0
                                    else
                                    {
                                        set is_marker: true
                                        set this_marker_life: ty.life
                                    }
                            }
                            0
                        }
                        else
                            0
                    if is_marker
                    {
                        ; s196: a STANDALONE marker — the preceding op was
                        ; not a PlannedType to merge into (e.g. a method
                        ; receiver planned as Variable+chain, as in
                        ; `slot_list.add^own_page(Slot(...))`). If the NEXT
                        ; op is the method's args PlannedTuple, merge the
                        ; `^name` lifetime into that tuple's `life` so the
                        ; method-dispatch call-construction site can
                        ; propagate it onto PlannedCall.life. Without this
                        ; the marker is dropped and the call's allocations
                        ; land on the function-local page (released on exit)
                        ; instead of the named region — corrupting escaping
                        ; HashSet nodes once the local page is released.
                        ; Otherwise (no following tuple) drop the marker as
                        ; before.
                        if mi + 1 < ops.length
                        {
                            let mtp_ptr ops.get(mi + 1)
                            if mtp_ptr <> null
                            {
                                let mtp_op (*mtp_ptr)
                                var merged_tuple_done: bool false
                                choose mtp_op.expr
                                    when tp: PlannedTuple
                                    {
                                        let new_tp PlannedTuple(
                                            tp.loc,
                                            tp.components,
                                            tp.tuple_type,
                                            tp.is_region_alloc,
                                            this_marker_life,
                                            tp.region_arg
                                        )
                                        merged_arr.add(PlannedOperand(
                                            mtp_op.loc,
                                            PlannedExpression.Tuple new_tp,
                                            mtp_op.member_access,
                                            mtp_op.result_type
                                        ))
                                        set merged_tuple_done: true
                                        0
                                    }
                                    else
                                        0
                                if merged_tuple_done
                                {
                                    set mi: mi + 2
                                    continue
                                }
                            }
                        }
                        set mi: mi + 1
                        continue
                    }

                    ; Look ahead: if the next op is a marker AND
                    ; current op is a Type, merge the lifetime in
                    ; before appending and advance past both.
                    var did_merge: bool false
                    if mi + 1 < ops.length
                    {
                        let next_ptr ops.get(mi + 1)
                        if next_ptr <> null
                        {
                            let next_op (*next_ptr)
                            var next_is_marker: bool false
                            var marker_life: Lifetime Lifetime.Unspecified(Unspecified())
                            choose next_op.expr
                                when ty2: PlannedType
                                {
                                    if ty2.name.get_length() = 0
                                    {
                                        choose ty2.life
                                            when u: Unspecified
                                                0
                                            else
                                            {
                                                set next_is_marker: true
                                                set marker_life: ty2.life
                                            }
                                    }
                                    0
                                }
                                else
                                    0

                            if next_is_marker
                            {
                                choose mp_op.expr
                                    when prev_ty: PlannedType
                                    {
                                        let new_ty PlannedType(
                                            prev_ty.loc,
                                            prev_ty.name,
                                            prev_ty.mangled_name,
                                            prev_ty.generics,
                                            marker_life,
                                            prev_ty.origin,
                                            prev_ty.array_size,
                                            prev_ty.variable
                                        )
                                        let new_op PlannedOperand(
                                            mp_op.loc,
                                            PlannedExpression.Type new_ty,
                                            mp_op.member_access,
                                            new_ty
                                        )
                                        merged_arr.add new_op
                                        set did_merge: true
                                        0
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    if did_merge
                    {
                        ; Advance past current Type AND the marker.
                        set mi: mi + 2
                        continue
                    }

                    merged_arr.add mp_op
                    set mi: mi + 1
                }
                var merged_vec Vector[PlannedOperand](merged_arr)
                ; s138: progress guard. Same as the s107 merge above:
                ; if no marker was actually merged or dropped, avoid
                ; infinite recursion.
                if merged_vec.length < ops.length
                    return this.collapse_operand_sequence(merged_vec)
            }

            ; Subscript pre-pass: fuse `[value, Matrix]` pairs into a `[]`
            ; operator call BEFORE the prefix/binary machinery runs, so
            ; `base[index] <op> rhs` collapses as call-then-binary instead
            ; of the operator falling into the prefix branch (the long-
            ; latent subscript mis-collapse; the old containers workaround
            ; was to pre-group in parens). Mirrors stage-0's planOperands
            ; subscript detection (Planner.cpp:10323). Gated to VALUE
            ; receivers (Variable/Call/Tuple — a bare PlannedType base is
            ; a generic instantiation, owned by the s107 merge above) and
            ; to a single-row Matrix with no member_access whose first
            ; operand is not itself a Type/Matrix. find_subscript_operator
            ; misses (no `[]` on the receiver's concept) leave the pair
            ; untouched via the progress guard.
            var has_subscript: bool false
            var sci: size_t 0
            while sci + 1 < ops.length
            {
                let sc_ptr ops.get sci
                let sn_ptr ops.get(sci + 1)
                if sc_ptr <> null
                {
                    if sn_ptr <> null
                    {
                        let sc_op (*sc_ptr)
                        let sn_op (*sn_ptr)
                        var sc_is_value: bool false
                        choose sc_op.expr
                            when sv: PlannedVariable
                                set sc_is_value: true
                            when sc: PlannedCall
                                set sc_is_value: true
                            when st: PlannedTuple
                                set sc_is_value: true
                            when sty: PlannedType
                            {
                                ; A bare name that resolves to a LOCAL is a
                                ; value receiver — names stay PlannedType
                                ; through collapse until resolution.
                                if sty.name.get_length() > 0
                                    if sc_op.member_access = null
                                        if this.lookup_local_binding(sty.name) <> null
                                            set sc_is_value: true
                                0
                            }
                            else
                                0
                        if sc_is_value
                        {
                            choose sn_op.expr
                                when sm: scalyc.compiler.Plan.PlannedMatrix
                                    set has_subscript: true
                                else
                                    0
                        }
                    }
                }
                set sci: sci + 1
            }

            if has_subscript
            {
                var sub_arr Array[PlannedOperand]()
                var si: size_t 0
                while si < ops.length
                {
                    let sp_ptr ops.get si
                    if sp_ptr = null
                    {
                        set si: si + 1
                        continue
                    }
                    let s_op (*sp_ptr)
                    var fused: bool false
                    if si + 1 < ops.length
                    {
                        let sx_ptr ops.get(si + 1)
                        if sx_ptr <> null
                        {
                            let sx_op (*sx_ptr)
                            var base_is_value: bool false
                            ; A bare local name arrives as PlannedType —
                            ; resolve it to a PlannedVariable receiver
                            ; (mirror of plan_type_operand's local path).
                            var recv_holder Array[PlannedOperand]()
                            recv_holder.add s_op
                            choose s_op.expr
                                when sv2: PlannedVariable
                                    set base_is_value: true
                                when sc2: PlannedCall
                                    set base_is_value: true
                                when st2: PlannedTuple
                                    set base_is_value: true
                                when sty2: PlannedType
                                {
                                    if sty2.name.get_length() > 0
                                    {
                                        if s_op.member_access = null
                                        {
                                            let lb_ref this.lookup_local_binding(sty2.name)
                                            if lb_ref <> null
                                            {
                                                let lb (*lb_ref)
                                                let recv_var PlannedVariable(
                                                    s_op.loc,
                                                    String(sty2.name),
                                                    lb.binding_type,
                                                    lb.is_mutable
                                                )
                                                recv_holder.put(0, PlannedOperand(
                                                    s_op.loc,
                                                    PlannedExpression.Variable recv_var,
                                                    null,
                                                    lb.binding_type
                                                ))
                                                set base_is_value: true
                                            }
                                        }
                                    }
                                    0
                                }
                                else
                                    0
                            if base_is_value
                            {
                                if sx_op.member_access = null
                                {
                                    choose sx_op.expr
                                        when smx: scalyc.compiler.Plan.PlannedMatrix
                                        {
                                            if smx.operations <> null
                                            {
                                                let rows (*smx.operations)
                                                if rows.length = 1
                                                {
                                                    let row_ptr rows.get 0
                                                    if row_ptr <> null
                                                    {
                                                        let row (*row_ptr)
                                                        if row.length > 0
                                                        {
                                                            var idx_is_value: bool true
                                                            let r0_ptr row.get 0
                                                            if r0_ptr <> null
                                                            {
                                                                choose (*r0_ptr).expr
                                                                    when rt0: PlannedType
                                                                        set idx_is_value: false
                                                                    when rm0: scalyc.compiler.Plan.PlannedMatrix
                                                                        set idx_is_value: false
                                                                    else
                                                                        0
                                                            }
                                                            let recv_ptr recv_holder.get 0
                                                            if recv_ptr = null
                                                                set idx_is_value: false
                                                            if idx_is_value
                                                            {
                                                                let recv_op (*recv_ptr)
                                                                let sm_ref this.find_member_operator(recv_op.result_type, String("[]"), sx_op.loc)
                                                                if sm_ref <> null
                                                                {
                                                                    let m (*sm_ref)
                                                                    let idx_op this.collapse_operand_sequence(row)
                                                                    this.ensure_type_layout(recv_op.result_type)
                                                                    this.ensure_type_layout(m.return_type)
                                                                    var sub_args Vector[PlannedOperand](2)
                                                                    sub_args.put(0, recv_op)
                                                                    sub_args.put(1, idx_op)
                                                                    let sub_call PlannedCall(
                                                                        sx_op.loc,
                                                                        String("[]"),
                                                                        m.mangled_name,
                                                                        false,
                                                                        true,
                                                                        m.can_throw,
                                                                        m.requires_page_param,
                                                                        &sub_args,
                                                                        m.return_type,
                                                                        Lifetime.Unspecified(Unspecified()),
                                                                        m.throws_type,
                                                                        false
                                                                    )
                                                                    sub_arr.add(PlannedOperand(
                                                                        s_op.loc,
                                                                        PlannedExpression.Call sub_call,
                                                                        null,
                                                                        m.return_type
                                                                    ))
                                                                    set fused: true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            0
                                        }
                                        else
                                            0
                                }
                            }
                        }
                    }
                    if fused
                    {
                        set si: si + 2
                        continue
                    }
                    sub_arr.add s_op
                    set si: si + 1
                }
                var sub_vec Vector[PlannedOperand](sub_arr)
                ; s138 progress guard: no pair actually fused (e.g. no
                ; `[]` operator on any receiver) — fall through.
                if sub_vec.length < ops.length
                    return this.collapse_operand_sequence(sub_vec)
            }

            let first_ptr ops.get 0
            if first_ptr = null
            {
                let void_ty Planner.make_void_type()
                return PlannedOperand(
                    Span(0, 0),
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }
            var result: PlannedOperand (*first_ptr)

            ; Prefix operator: first operand is a Type whose name is an
            ; operator (`-x`, `!flag`, `*ptr`, etc.). Recurse on the
            ; rest, resolve against the rest's result type, and wrap in
            ; a single PlannedCall. The whole sequence is consumed.
            choose result.expr
                when ty: PlannedType
                {
                    ; An opchar-named declared FUNCTION (not a declared
                    ; operator) — e.g. `function ++(n)` — is a function call,
                    ; not a prefix operator. Skip the prefix-operator path so
                    ; it falls through to call resolution; stage-0 mangles such
                    ; a name as a function (`_Z2++i`). The source declares no
                    ; opchar-named functions, so this is fixpoint-safe.
                    var ty_is_prefix_op: bool false
                    if Planner.is_operator_name(ty.name)
                        set ty_is_prefix_op: true
                    if ty_is_prefix_op
                        if this.is_function(ty.name)
                            if this.is_operator(ty.name) = false
                                set ty_is_prefix_op: false
                    if ty_is_prefix_op
                    {
                        let prefix_name ty.name

                        ; s174: a prefix operator consumes exactly ONE
                        ; operand — the immediately following one — unless
                        ; that operand is itself a prefix operator (chained
                        ; `*-x`: collapse the whole tail as the operand).
                        ; The old code collapsed ops[1..end] wholesale, so
                        ; `*p <> 42` planned as `*(p <> 42)` (deref of a
                        ; bool) — emit_operands returned null and the whole
                        ; surrounding if/if silently dropped (lexer
                        ; comment dispatch, prelude load). After the prefix
                        ; call is built, the remaining operands continue
                        ; through a recursive collapse. Mirrors stage-0
                        ; Planner.cpp:4098-4283.
                        var consumed: size_t 2
                        var chained: bool false
                        if ops.length > 1
                        {
                            let chk_ptr ops.get 1
                            if chk_ptr <> null
                            {
                                choose (*chk_ptr).expr
                                    when cty: PlannedType
                                    {
                                        if Planner.is_operator_name(cty.name)
                                            set chained: true
                                    }
                                    else
                                        0
                            }
                        }
                        if chained
                            set consumed: ops.length

                        ; s174: a call operand keeps its argument Tuple —
                        ; consume [callee, Tuple] together so
                        ; `~lexer.parse_punctuation(CHAR_DOT())` keeps its
                        ; argument. Stage-0 pre-groups calls in planOperands
                        ; (Planner.cpp:7361+) so its consume-one never
                        ; splits them; stage-1 groups during collapse, so
                        ; the prefix branch must widen its bite here.
                        ; Callable = non-operator Type (free function) or a
                        ; member-access chain ending in an is_method hop.
                        if chained = false
                        {
                            if ops.length > 2
                            {
                                let cal_ptr ops.get 1
                                let arg_ptr ops.get 2
                                if cal_ptr <> null
                                {
                                    if arg_ptr <> null
                                    {
                                        var arg_is_tuple: bool false
                                        choose (*arg_ptr).expr
                                            when t_arg: PlannedTuple
                                                set arg_is_tuple: true
                                            else
                                                0
                                        if arg_is_tuple
                                        {
                                            var cal_callable: bool false
                                            choose (*cal_ptr).expr
                                                when cal_ty: PlannedType
                                                {
                                                    if Planner.is_operator_name(cal_ty.name) = false
                                                        set cal_callable: true
                                                }
                                                else
                                                    0
                                            if cal_callable = false
                                            {
                                                if (*cal_ptr).member_access <> null
                                                {
                                                    let cal_ma (*(*cal_ptr).member_access)
                                                    if cal_ma.length > 0
                                                    {
                                                        let cal_last cal_ma.get(cal_ma.length - 1)
                                                        if cal_last <> null
                                                        {
                                                            if (*cal_last).is_method
                                                                set cal_callable: true
                                                        }
                                                    }
                                                }
                                            }
                                            if cal_callable
                                                set consumed: 3
                                        }
                                    }
                                }
                            }
                        }

                        var rest_arr Array[PlannedOperand]()
                        var r: size_t 1
                        while r < consumed
                        {
                            let p_ptr ops.get r
                            if p_ptr <> null
                            {
                                let p_op (*p_ptr)
                                ; If a prefix operator is followed by a
                                ; single-component anonymous Tuple (a
                                ; grouping `(...)`), expand the Tuple's
                                ; interior operands so the inner sequence
                                ; collapses (e.g. `*(data + index)` →
                                ; `*` applied to the collapsed
                                ; `data + index` PlannedCall). Without
                                ; this, emit_tuple's grouping shortcut
                                ; emits only `data` and the GEP for
                                ; pointer-arith deref vanishes. Mirrors
                                ; stage-0 Planner.cpp:4178-4181 where the
                                ; Tuple is consumed as-is because its
                                ; interior was already collapsed during
                                ; planTuple (Planner.cpp:10507).
                                var expanded: bool false
                                if r = 1
                                {
                                    if chained = false
                                    {
                                        ; s177: keep a grouped operand intact
                                        ; when it carries a member-access
                                        ; chain. Expanding the interior drops
                                        ; the chain — `(*(*p).items)` lost
                                        ; its .items hop and the outer deref
                                        ; re-deref'd the base struct (length
                                        ; read field 0 of the wrong struct).
                                        ; The operand is already fully planned
                                        ; with the chain's final result_type.
                                        var p_has_chain: bool false
                                        if p_op.member_access <> null
                                        {
                                            let pma (*p_op.member_access)
                                            if pma.length > 0
                                                set p_has_chain: true
                                        }
                                        if p_has_chain = false
                                        {
                                        choose p_op.expr
                                            when tup: PlannedTuple
                                            {
                                                if tup.components <> null
                                                {
                                                    let comps (*tup.components)
                                                    if comps.length = 1
                                                    {
                                                        let c0_ptr comps.get 0
                                                        if c0_ptr <> null
                                                        {
                                                            let c0 (*c0_ptr)
                                                            if c0.name = null
                                                            {
                                                                if c0.value <> null
                                                                {
                                                                    let inner (*c0.value)
                                                                    if inner.length > 0
                                                                    {
                                                                        var ii: size_t 0
                                                                        while ii < inner.length
                                                                        {
                                                                            let ip_ptr inner.get ii
                                                                            if ip_ptr <> null
                                                                                rest_arr.add((*ip_ptr))
                                                                            set ii: ii + 1
                                                                        }
                                                                        set expanded: true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                                0
                                        }
                                    }
                                }
                                if expanded = false
                                    rest_arr.add p_op
                            }
                            set r: r + 1
                        }
                        var rest_vec Vector[PlannedOperand](rest_arr)
                        let rest_result this.collapse_operand_sequence(rest_vec)

                        let rt_ref this.resolve_prefix_operator_call(
                            prefix_name, rest_result.result_type
                        )
                        ; For built-in primitive prefix ops the operator
                        ; isn't in the registry — derive the result type
                        ; from the operator. Mirrors Planner.cpp:4138-4157.
                        var rt: PlannedType rest_result.result_type
                        if rt_ref <> null
                            set rt: (*rt_ref)
                        if rt_ref = null
                        {
                            if prefix_name.equals("!")
                                set rt: Planner.make_bool_type()
                            if prefix_name.equals("not")
                                set rt: Planner.make_bool_type()
                            if prefix_name.equals("*")
                            {
                                ; Dereference: result is the pointer's
                                ; element type. Use get_pointer_element_type
                                ; so Option[ref[T]] / Option[pointer[T]]
                                ; unwrap to T (NOT ref[T] / pointer[T]).
                                ; Without this, choose-on-dereffed-union
                                ; sees result_type=ref[T] and emit_choose's
                                ; NPO heuristic dispatches via null check
                                ; instead of tag dispatch — silently dropping
                                ; all but one when-arm. Mirrors stage-0
                                ; Planner.cpp:3866-3870.
                                let elem_ref Planner.get_pointer_element_type(rest_result.result_type)
                                if elem_ref <> null
                                    set rt: (*elem_ref)
                            }
                            ; s96: address-of — wrap operand in pointer[T].
                            ; Mirrors stage-0 Planner.cpp:3877 (resolvePrefix
                            ; OperatorCall: Name=="pointer", Generics=[Operand],
                            ; MangledName="P"+Operand.MangledName). Without
                            ; this, `&x` falls through to rt=operand_type,
                            ; meaning callers see the bare T and downstream
                            ; resolve_function_call# arity-checks against
                            ; ref[T] / pointer[T] params using the wrong
                            ; argument type — fails, drops the call.
                            ; types_compatible (s96 part 2) extends the
                            ; rule set so pointer[T] flows into ref[T] /
                            ; pointer[T] params.
                            ; Escape soundness steps 1+2: when `&<operand>`
                            ; produces a pointer into THIS frame (bare frame
                            ; local, frame value-struct field chain, or a frame
                            ; temporary construction) stamp the pointee Local
                            ; (make_pointer_to_local#) — the existing return/
                            ; store/pass checks then promote-or-reject it,
                            ; matching what `$` provided via the binding's Local
                            ; life. Other `&` operands (pointer/ref bases that
                            ; auto-deref out of the frame, #/^-allocated values)
                            ; keep the plain pointer so value uses stay sound.
                            if prefix_name.equals("&")
                            {
                                if this.operand_addr_is_frame_local(rest_result)
                                    set rt: Planner.make_pointer_to_local(rest_result.result_type)
                                else
                                    set rt: Planner.make_pointer_type(rest_result.result_type)
                            }
                        }

                        ; Box-value: `&^obj v`. The marker-merge above folded the
                        ; `^obj` Reference lifetime onto this `&` operator's
                        ; PlannedType.life (ops became [&(life=Reference), value]).
                        ; Instead of a frame address-of, box a COPY of the
                        ; collapsed operand onto obj's page (Page.get(obj)) and
                        ; yield a pointer[X] that outlives the frame — replacing
                        ; the `var H Vector[X]#(1); H.put(0,v); H.get(0)` holder.
                        ; Reading ty.life (not a separate ops[1] marker scan) is
                        ; what makes it fire for ANY value, incl. call results.
                        if prefix_name.equals("&")
                        {
                            var is_box: bool false
                            var box_loc: String ""
                            choose ty.life
                                when rf: Reference
                                {
                                    set is_box: true
                                    set box_loc: rf.location
                                }
                                else
                                    0
                            if is_box
                            {
                                let box_ty Planner.make_pointer_type(rest_result.result_type)
                                ; Call-result page promotion: when the boxed value
                                ; is DIRECTLY a call (`&^this this.plan_type(tt)`),
                                ; the callee allocates its sret result's heap
                                ; internals (Strings/Vectors) on whatever page it
                                ; receives. By default a plain function gets this
                                ; frame's local page (freed at exit) → the box's
                                ; shallow header copy would reference dead internals.
                                ; Re-stamp the call's life to Reference(box page) so
                                ; emit_call routes its page arg to Page.get(obj):
                                ; the result's internals then live on the box's
                                ; surviving page, matching what the `^rp` holder did
                                ; (it passed the caller page). Only fires for a bare
                                ; call value (a let-bound var's call already ran with
                                ; its own page; box those only when their internals
                                ; outlive the frame).
                                var value_to_box rest_result
                                choose rest_result.expr
                                    when bcall: Call
                                    {
                                        let promoted_call PlannedCall(
                                            bcall.loc,
                                            bcall.name,
                                            bcall.mangled_name,
                                            bcall.is_intrinsic,
                                            bcall.is_operator,
                                            bcall.can_throw,
                                            bcall.requires_page_param,
                                            bcall.args,
                                            bcall.result_type,
                                            Lifetime.Reference(scalyc.compiler.Model.Reference(bcall.loc, box_loc)),
                                            bcall.throws_type,
                                            bcall.is_indirect
                                        )
                                        set value_to_box: PlannedOperand(
                                            rest_result.loc,
                                            PlannedExpression.Call promoted_call,
                                            rest_result.member_access,
                                            rest_result.result_type
                                        )
                                    }
                                    when btup: PlannedTuple
                                    {
                                        ; Construction-literal promotion: boxing
                                        ; `&^obj T(String(x), f(y), …)` shallow-
                                        ; copies the constructed struct's header
                                        ; onto obj's page, but the construction's
                                        ; String/Vector ARGUMENTS allocate their
                                        ; heap buffers on this frame's local page
                                        ; by default → they are freed at return
                                        ; and the boxed struct's String.data
                                        ; dangles (the same hazard the call-result
                                        ; promotion above closes for a bare call).
                                        ; Re-stamp the construction AND, recursively,
                                        ; its inline-construction/call arguments to
                                        ; the box page so their buffers live on the
                                        ; surviving page. restamp_operand_life# self-
                                        ; gates on Local/Unspecified life + page-
                                        ; owning guts, so a pure-POD construction or
                                        ; an explicitly-placed arg is kept verbatim.
                                        let tup_life Lifetime.Reference(scalyc.compiler.Model.Reference(rest_result.loc, box_loc))
                                        let tup_promoted this.restamp_operand_life(rest_result, tup_life)
                                        if tup_promoted <> null
                                            set value_to_box: (*tup_promoted)
                                    }
                                    else
                                        0
                                var bval_holder Vector[PlannedOperand](1)
                                bval_holder.put(0, value_to_box)
                                let box PlannedBox(result.loc, bval_holder.get 0, box_loc, box_ty)
                                let box_op PlannedOperand(result.loc, PlannedExpression.Box box, null, box_ty)
                                if consumed >= ops.length
                                    return box_op
                                var bcont_arr Array[PlannedOperand]()
                                bcont_arr.add box_op
                                var bcc: size_t consumed
                                while bcc < ops.length
                                {
                                    let bc_ptr ops.get bcc
                                    if bc_ptr <> null
                                        bcont_arr.add((*bc_ptr))
                                    set bcc: bcc + 1
                                }
                                var bcont_vec Vector[PlannedOperand](bcont_arr)
                                return this.collapse_operand_sequence(bcont_vec)
                            }
                        }

                        let mangled this.mangle_unary_operator(
                            prefix_name, rest_result.result_type
                        )
                        var args_v Vector[PlannedOperand](1)
                        args_v.put(0, rest_result)
                        ; Mirrors Planner.cpp:4131-4132 — prefix operators on
                        ; primitive types are intrinsic (is_intrinsic=true,
                        ; is_operator=true). emit_call dispatches to
                        ; emit_intrinsic_operator instead of looking up a
                        ; non-existent library function.
                        var args_holder_p Vector[PlannedOperand](args_v)
                        let call PlannedCall(
                            result.loc,
                            prefix_name,
                            mangled,
                            true,
                            true,
                            false,
                            false,
                            &args_holder_p,
                            rt,
                            Lifetime.Unspecified(Unspecified()),
                            null,
                            false
                        )
                        let prefix_op PlannedOperand(
                            result.loc,
                            PlannedExpression.Call call,
                            null,
                            rt
                        )
                        ; s174: binary continuation — `*p <> 42` leaves
                        ; [<>, 42] after the consumed [*, p]; re-collapse
                        ; with the prefix call as the new first operand.
                        if consumed >= ops.length
                            return prefix_op
                        var cont_arr Array[PlannedOperand]()
                        cont_arr.add prefix_op
                        var cc: size_t consumed
                        while cc < ops.length
                        {
                            let c_ptr ops.get cc
                            if c_ptr <> null
                                cont_arr.add((*c_ptr))
                            set cc: cc + 1
                        }
                        var cont_vec Vector[PlannedOperand](cont_arr)
                        return this.collapse_operand_sequence(cont_vec)
                    }
                    0
                }
                else
                    0

            ; Single argument without parentheses: `print "Hello"`,
            ; `sb.append text`, `Box 5`, `ns.fn x`. Any one-argument routine
            ; — free function, procedure, method, intrinsic, extern, sibling
            ; method, or single-arg constructor — applied prefix to ONE plain
            ; value operand. Synthesize a one-component arg Tuple and recurse
            ; so the same [head, Tuple] machinery below resolves it. Mirrors
            ; stage-0 planOperands' parenless single-arg pre-pass.
            if ops.length = 2
            {
                var head_is_callable: bool false
                if result.member_access = null
                {
                    choose result.expr
                        when ht: PlannedType
                        {
                            ; Any non-operator, non-empty name head is
                            ; callable — matching the parenful [Type, Tuple]
                            ; gate below, which fires for ANY Type head and
                            ; lets resolve_function_call# sort out free fn /
                            ; sibling method / construction.
                            if ht.name.get_length() > 0
                            {
                                if Planner.is_operator_name(ht.name) = false
                                    set head_is_callable: true
                            }
                        }
                        else
                            0
                }
                if result.member_access <> null
                {
                    let ma (*result.member_access)
                    if ma.length > 0
                    {
                        let last_ptr ma.get(ma.length - 1)
                        if last_ptr <> null
                        {
                            if (*last_ptr).is_method
                                set head_is_callable: true
                        }
                    }
                }
                if head_is_callable
                {
                    let sa_arg_ptr ops.get 1
                    if sa_arg_ptr <> null
                    {
                        let sa_arg_op (*sa_arg_ptr)
                        ; Any single value operand is a valid argument
                        ; (Constant, Variable, GlobalRef, Call, ...).
                        ; Exclude only the structural operands the [Name, X]
                        ; machinery already owns: a Tuple (parenful args), a
                        ; Matrix (generic [T] args), an operator-named Type
                        ; (infix/prefix operator), an empty-name Type
                        ; (lifetime marker), or an As/Is operand — `X as Y`
                        ; is modeled [X, As] and the As consumes the preceding
                        ; operand, so it is a cast, not a call.
                        var arg_is_value: bool true
                        choose sa_arg_op.expr
                            when at: PlannedType
                            {
                                if at.name.get_length() = 0
                                    set arg_is_value: false
                                if Planner.is_operator_name(at.name)
                                    set arg_is_value: false
                            }
                            when atp: PlannedTuple
                                set arg_is_value: false
                            when amx: scalyc.compiler.Plan.PlannedMatrix
                                set arg_is_value: false
                            when aas: scalyc.compiler.Plan.PlannedAs
                                set arg_is_value: false
                            when ais: scalyc.compiler.Plan.PlannedIs
                                set arg_is_value: false
                            else
                                0
                        if arg_is_value
                        {
                            var sa_arg_vec Vector[PlannedOperand](1)
                            sa_arg_vec.put(0, sa_arg_op)
                            var sa_comps Vector[PlannedComponent](1)
                            sa_comps.put(0, PlannedComponent(
                                sa_arg_op.loc,
                                null,
                                &sa_arg_vec,
                                null
                            ))
                            let sa_tuple PlannedTuple(
                                sa_arg_op.loc,
                                &sa_comps,
                                sa_arg_op.result_type,
                                false,
                                Lifetime.Unspecified(Unspecified()),
                                null
                            )
                            let sa_tuple_op PlannedOperand(
                                sa_arg_op.loc,
                                PlannedExpression.Tuple sa_tuple,
                                null,
                                sa_arg_op.result_type
                            )
                            var sa_arr Array[PlannedOperand]()
                            sa_arr.add result
                            sa_arr.add sa_tuple_op
                            var sa_vec Vector[PlannedOperand](sa_arr)
                            return this.collapse_operand_sequence(sa_vec)
                        }
                    }
                }
            }

            ; Call detection: first operand followed by a Tuple. Two
            ; shapes accepted:
            ;   - free function: first operand's expr is a Type (name
            ;     reference);
            ;   - method call: first operand has a member_access chain
            ;     whose last hop is_method=true (from resolve_member_access).
            if ops.length >= 2
            {
                let second_ptr ops.get 1
                if second_ptr <> null
                {
                    let second (*second_ptr)
                    var is_call: bool false
                    var fn_name: String ""

                    ; Method-call branch FIRST: a PlannedType operand
                    ; carrying a method member_access (e.g. `cli.main`,
                    ; where `cli` resolves to a namespace concept and
                    ; `main` is the trailing method) must dispatch on
                    ; the method name, not the namespace name. Without
                    ; this, the next branch grabs `t.name` ("cli") and
                    ; resolve_function_call hunts for a function called
                    ; "cli" which doesn't exist, leaving the call un-
                    ; emitted and the body collapsing to ret void.
                    if result.member_access <> null
                    {
                        let ma (*result.member_access)
                        if ma.length > 0
                        {
                            let last_ptr ma.get(ma.length - 1)
                            if last_ptr <> null
                            {
                                let last_ma (*last_ptr)
                                if last_ma.is_method
                                {
                                    var tuple_second: bool false
                                    choose second.expr
                                        when tp: PlannedTuple
                                            set tuple_second: true
                                        else
                                            0
                                    if tuple_second
                                    {
                                        set is_call: true
                                        set fn_name: last_ma.name
                                    }
                                }
                            }
                        }
                    }

                    if is_call = false
                    {
                        choose result.expr
                            when t: PlannedType
                            {
                                set fn_name: t.name
                                choose second.expr
                                    when tp: PlannedTuple
                                        set is_call: true
                                    else
                                        0
                                0
                            }
                            else
                                0
                    }

                    if is_call
                    {
                        ; Struct/Union value construction. When fn_name
                        ; resolves to a registered Concept, treat
                        ; Type(args) as construction rather than a free
                        ; function call. Mirrors Planner.cpp:8810+
                        ; (struct) and 9086+ (union variant).
                        var is_struct_ctor: bool false
                        var is_variant_ctor: bool false
                        var ctor_struct_type: PlannedType Planner.make_void_type()
                        var ctor_union_type: PlannedType Planner.make_void_type()
                        var ctor_variant_name: String ""
                        var ctor_variant_tag: size_t 0

                        ; Resolve struct construction regardless of lifetime.
                        ; The reshape below force-sets Lifetime.Unspecified on
                        ; the result PlannedTuple so stage-1 stack-alloca's the
                        ; struct (heap $/#/^ ctor support is deferred — would
                        ; need scaly_page_alloc + RBMM wiring). Without lifting
                        ; this guard, every `T(args)` / `T(args)` for a
                        ; registered struct (e.g. `Options()`,
                        ; `String(arg_ptr)`, `Vector[T](0)`) silently dropped:
                        ; lookup_concept finds the Structure but the gate stays
                        ; shut, the call falls through to resolve_function_call
                        ; which returns null, mangled_name stays empty, and
                        ; emit_call returns null — taking the binding and any
                        ; downstream reference (e.g. `arg.starts_with(...)`)
                        ; with it. parse_args body went from full option-
                        ; parsing to a bare `let arg_ptr; set i: i+1`.
                        let conc_ref this.lookup_concept(fn_name)
                        if conc_ref <> null
                        {
                            let conc (*conc_ref)
                            choose conc.definition
                                when s: Structure
                                {
                                    set is_struct_ctor: true
                                    choose result.expr
                                        when t: PlannedType
                                            set ctor_struct_type: t
                                        else
                                            0
                                }
                                when un: scalyc.compiler.Model.Union
                                {
                                    ; s172: Union(value) copy-construction —
                                    ; e.g. `set parameters: ParameterSetSyntax(
                                    ; success)` in parse_routine. Mirrors
                                    ; stage-0's Union-with-lifetime branch
                                    ; (Planner.cpp:9086): reshape the args
                                    ; tuple with tuple_type = the union so
                                    ; emit_tuple's whole-struct short-circuit
                                    ; copies the value. find_initializer#
                                    ; returns null for unions, so this always
                                    ; takes the reshape fallback below.
                                    ; Without it the construction falls
                                    ; through to function lookup, resolves
                                    ; nothing, and the whole `set` silently
                                    ; drops — stage-2 modeled every function
                                    ; with zero parameters (_Z3addv).
                                    ;
                                    ; s184: generic union variant ctor —
                                    ; `Option[int].Some(42)`. The planned
                                    ; Type operand names the union and
                                    ; carries the variant as its first
                                    ; resolved member-access hop (stage-0
                                    ; Case 2, Planner.cpp:8279). Divert to
                                    ; the variant-ctor branch; the s172
                                    ; copy-construction applies only when
                                    ; no variant hop is present.
                                    var has_variant_hop: bool false
                                    if result.member_access <> null
                                    {
                                        let vma (*result.member_access)
                                        if vma.length > 0
                                        {
                                            let vh_ptr vma.get 0
                                            if vh_ptr <> null
                                            {
                                                let vhop (*vh_ptr)
                                                if vhop.is_union_value
                                                {
                                                    set has_variant_hop: true
                                                    set is_variant_ctor: true
                                                    set ctor_variant_name: vhop.name
                                                    set ctor_variant_tag: vhop.field_index
                                                    choose result.expr
                                                        when t: PlannedType
                                                            set ctor_union_type: t
                                                        else
                                                            0
                                                }
                                            }
                                        }
                                    }
                                    if has_variant_hop = false
                                    {
                                        set is_struct_ctor: true
                                        choose result.expr
                                            when t: PlannedType
                                                set ctor_struct_type: t
                                            else
                                                0
                                    }
                                }
                                else
                                    0
                        }

                        ; Dotted union variant: Union.Variant(args). Split
                        ; on last '.', look up the prefix as a Union, the
                        ; suffix as a variant.
                        if is_struct_ctor = false
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(0, dot_pos)
                                let suffix fn_name.substring(
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let union_ref this.lookup_concept(prefix)
                                if union_ref <> null
                                {
                                    let uconc (*union_ref)
                                    var is_union_def: bool false
                                    choose uconc.definition
                                        when u: scalyc.compiler.Model.Union
                                            set is_union_def: true
                                        else
                                            0
                                    if is_union_def
                                    {
                                        let tag this.lookup_variant_tag(prefix, suffix)
                                        if tag >= 0
                                        {
                                            set is_variant_ctor: true
                                            set ctor_union_type: PlannedType(
                                                result.loc,
                                                prefix,
                                                Planner.mangle_structure(prefix, null),
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                "",
                                                null
                                            )
                                            set ctor_variant_name: suffix
                                            set ctor_variant_tag: tag as size_t
                                        }
                                    }
                                }
                            }
                        }

                        if is_struct_ctor
                        {
                            ; s81: ctor-call diversion. When find_initializer#
                            ; matches an init# overload (page_parameter set),
                            ; build a PlannedCall with C1 mangling and divert
                            ; to emit_constructor_call (Page::allocate + ctor
                            ; call). Without this, every T/T#/T^ goes
                            ; through the stack-alloc reshape below, which
                            ; only works for "data class" structs without
                            ; custom init# logic. Heavy users like String,
                            ; Vector, StringBuilder rely on init# for proper
                            ; internal state (varint length, etc.). The
                            ; init# bodies are emitted by the synthesized
                            ; PlannedFunction wrapper in plan_initializer#.
                            let ctor_arg_types Planner.extract_arg_types(second)
                            let init_match this.find_initializer(fn_name, ctor_arg_types)
                            if init_match <> null
                            {
                                let ini_match (*init_match)
                                ; s84: the page_parameter if was load-bearing
                                ; under s81 because the `requires_page_param=true`
                                ; field below was hard-coded — without page on the
                                ; init, emit_constructor_call would still pass an
                                ; extra page arg, mismatching the C1 ABI.
                                ; Now we propagate `init# vs init` into
                                ; `requires_page_param`, enabling `Options()`
                                ; (where Options has only `init()` (no #)) to
                                ; route through emit_constructor_call: heap-
                                ; allocate via Page::allocate, call C1 with
                                ; `this` only. Mirrors stage-0's
                                ; cli.test() IR for `var opts Options()`.
                                {
                                    let has_page_param ini_match.page_parameter <> null
                                    let saved_subst_ctor type_substitutions.length
                                    if ctor_struct_type.generics <> null
                                    {
                                        let cgens (*ctor_struct_type.generics)
                                        let cc_ref this.lookup_concept(fn_name)
                                        if cc_ref <> null
                                        {
                                            let cc (*cc_ref)
                                            var pgi: size_t 0
                                            while pgi < cc.parameters.length
                                            {
                                                if pgi < cgens.length
                                                {
                                                    let gp_ptr cc.parameters.get pgi
                                                    let cg_ptr cgens.get pgi
                                                    if gp_ptr <> null
                                                    {
                                                        if cg_ptr <> null
                                                            this.define_type_substitution(gp_ptr.name, (*cg_ptr))
                                                    }
                                                }
                                                set pgi: pgi + 1
                                            }
                                        }
                                    }
                                    let init_input_items this.plan_items(ini_match.input)
                                    set type_substitutions.length: saved_subst_ctor
                                    var init_input_holder Vector[PlannedItem](init_input_items)

                                    let parent_ref &^this ctor_struct_type

                                    let c1_mangled Planner.mangle_function(
                                        "init", &init_input_holder, parent_ref, has_page_param
                                    )

                                    var ctor_call_args Array[PlannedOperand]()
                                    choose second.expr
                                        when tp_args: PlannedTuple
                                        {
                                            if tp_args.components <> null
                                            {
                                                let comps_args (*tp_args.components)
                                                var ai: size_t 0
                                                while ai < comps_args.length
                                                {
                                                    let cap_ptr comps_args.get ai
                                                    if cap_ptr <> null
                                                    {
                                                        let cap (*cap_ptr)
                                                        if cap.value <> null
                                                        {
                                                            let cvals (*cap.value)
                                                            let collapsed_arg this.collapse_operand_sequence(cvals)
                                                            ctor_call_args.add collapsed_arg
                                                        }
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                        }
                                        else
                                            0
                                    var ctor_args_vec Vector[PlannedOperand](ctor_call_args)

                                    ; Page inference, rule 1 (default-to-local
                                    ; construction): a no-sigil construction of
                                    ; a heap-backed type (its init takes a page —
                                    ; `has_page_param`) carries Unspecified life,
                                    ; which leaves emit_constructor_call with no
                                    ; page to allocate on (garbage page → SIGSEGV).
                                    ; Default it to the function's local page,
                                    ; exactly as an explicit `$` would. The escape
                                    ; checker promotes it to the caller page when
                                    ; the result escapes (return/store). This is
                                    ; the first step of abolishing the `$`/`#`
                                    ; sigils: the programmer writes `StringBuilder()`
                                    ; and the compiler picks the page.
                                    ; Default to Local also when the matched
                                    ; init has no page param (has_page_param
                                    ; false) but the concept's own bodies derive
                                    ; a page from `this` (^this constructions or
                                    ; Page.get(this) — Array/List/builders/...):
                                    ; its no-arg init() leaves life Unspecified,
                                    ; which would stack-allocate, but the instance
                                    ; must live on a page. Mirrors the reshape-path
                                    ; rule 1. Only fires for Unspecified life, so
                                    ; explicit #/^ constructions are unchanged.
                                    var ctor_heap_default: bool has_page_param
                                    if has_page_param = false
                                        if this.concept_needs_this_residency(fn_name)
                                            set ctor_heap_default: true
                                    var eff_ctor_life: Lifetime ctor_struct_type.life
                                    if ctor_heap_default
                                        choose ctor_struct_type.life
                                            when u: Unspecified
                                                set eff_ctor_life: Lifetime.Local(scalyc.compiler.Model.Local(second.loc))
                                            else
                                                0
                                    ; Page inference, step-D adoption (ctor
                                    ; path): an explicit-^ ctor's defaulted args
                                    ; adopt the ctor's page — an inline
                                    ; construction in an arg position of
                                    ; `T^page(...)` becomes a field of the ^page
                                    ; aggregate, so its guts must live there
                                    ; too. restamp_args keeps borrows/explicit-
                                    ; lifetime args verbatim, so sigiled source
                                    ; is unchanged. NOTE the ref-reassign shape
                                    ; is LOAD-BEARING: `set ctor_args_vec:
                                    ; (*adopted)` — a deref-copy into the
                                    ; promoted Vector binding — hits a latent
                                    ; emit_action gap (ptr slot + ptr deref.tmp
                                    ; source -> raw pointer store to a pooled
                                    ; STACK temp) and dangles nondeterministically.
                                    var ctor_args_ref: ref[Vector[PlannedOperand]]? &ctor_args_vec
                                    choose eff_ctor_life
                                        when adopt_r: Reference
                                        {
                                            let adopted this.restamp_args(ctor_args_vec, eff_ctor_life)
                                            if adopted <> null
                                                set ctor_args_ref: adopted
                                        }
                                        else
                                            0

                                    let ctor_call PlannedCall(
                                        second.loc,
                                        "init",
                                        c1_mangled,
                                        false,
                                        false,
                                        false,
                                        has_page_param,
                                        ctor_args_ref,
                                        ctor_struct_type,
                                        eff_ctor_life,
                                        null,
                                        false
                                    )
                                    set result: this.rebind_trailing_chain(PlannedOperand(
                                        second.loc,
                                        PlannedExpression.Call ctor_call,
                                        second.member_access,
                                        ctor_struct_type
                                    ))
                                    if ops.length > 2
                                    {
                                        var remaining_c Array[PlannedOperand]()
                                        remaining_c.add result
                                        var rrc: size_t 2
                                        while rrc < ops.length
                                        {
                                            let prc_ptr ops.get rrc
                                            if prc_ptr <> null
                                                remaining_c.add((*prc_ptr))
                                            set rrc: rrc + 1
                                        }
                                        var remaining_cv Vector[PlannedOperand](remaining_c)
                                        return this.collapse_operand_sequence(remaining_cv)
                                    }
                                    return result
                                }
                            }

                            ; Reshape the tuple to set tuple_type to the
                            ; struct type. Stack allocation only for now
                            ; (Lifetime.Unspecified — heap $/#/^ deferred).
                            ; Falls through here when find_initializer#
                            ; didn't match (data classes without init#) or
                            ; when init has no page_parameter (stack-only
                            ; init, currently unused).
                            var components_holder: ref[Vector[PlannedComponent]]? null
                            ; Collapse each component's operand sequence so
                            ; nested struct/union ctors and other multi-
                            ; operand expressions become a single planned
                            ; operand. emit_operands only walks the first
                            ; operand of a component value, so without
                            ; collapsing, `Parser(Lexer 7)` would drop the
                            ; inner Tuple and emit only the bare `Type(Lexer)`
                            ; operand — SEGV at LLVMTypeOf on null.
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    if tp.components <> null
                                    {
                                        let comps_in (*tp.components)
                                        var new_comps Array[PlannedComponent]()
                                        var ci: size_t 0
                                        while ci < comps_in.length
                                        {
                                            let cp comps_in.get ci
                                            if cp <> null
                                            {
                                                let cc (*cp)
                                                var nc_value: ref[Vector[PlannedOperand]]? cc.value
                                                if cc.value <> null
                                                {
                                                    let vals (*cc.value)
                                                    if vals.length > 1
                                                    {
                                                        let collapsed this.collapse_operand_sequence(vals)
                                                        var one_arr Array[PlannedOperand]()
                                                        one_arr.add collapsed
                                                        var one_vec Vector[PlannedOperand](one_arr)
                                                        set nc_value: &one_vec
                                                    }
                                                }
                                                new_comps.add(PlannedComponent(
                                                    cc.loc, cc.name, nc_value, cc.attributes
                                                ))
                                            }
                                            set ci: ci + 1
                                        }
                                        var new_comps_holder Vector[PlannedComponent](new_comps)
                                        set components_holder: &new_comps_holder
                                    }
                                }
                                else
                                    0
                            ; Propagate the type's lifetime into the tuple.
                            ; ctor_struct_type carries the lifetime from the
                            ; lifetime marker merge (above) — `Plan(...)` has
                            ; life=Call; `String(...)` has life=Local; etc.
                            ; Non-Unspecified life ⇒ heap allocation
                            ; (emit_tuple respects is_region_alloc by calling
                            ; Page::allocate on the appropriate page).
                            ; Page inference rule 1 (reshape path): a no-sigil
                            ; construction of a residency-needing type (its own
                            ; bodies derive a page from `this`) that matched no
                            ; init# here carries Unspecified life and would
                            ; stack-allocate — but the instance MUST live on a
                            ; page (a stack base gives a garbage page). Default
                            ; it to the function's local page; the escape checker
                            ; promotes to the caller page on escape. Plain value
                            ; structs stay Unspecified -> stack. Existing #/^
                            ; constructions already carry a non-Unspecified
                            ; life, so this only fires for de-sigiled sources
                            ; (emission-neutral otherwise).
                            var reshape_life: Lifetime ctor_struct_type.life
                            choose ctor_struct_type.life
                                when u: Unspecified
                                    if this.concept_needs_this_residency(fn_name)
                                        set reshape_life: Lifetime.Local(scalyc.compiler.Model.Local(second.loc))
                                else
                                    0

                            ; Page inference, step-D adoption (reshape path): a
                            ; data-class construction with an explicit ^ life
                            ; adopts its defaulted component constructions onto
                            ; the same page — `TypeVariable^this(id,
                            ; String(name))`'s String must live where the
                            ; TypeVariable lives, not on the released local
                            ; page. Ref-reassign shape (see the ctor-path note).
                            choose reshape_life
                                when adopt_r2: Reference
                                {
                                    if components_holder <> null
                                    {
                                        let adopted_comps this.restamp_components((*components_holder), reshape_life)
                                        if adopted_comps <> null
                                            set components_holder: adopted_comps
                                    }
                                }
                                else
                                    0

                            var is_region: bool false
                            choose reshape_life
                                when u: Unspecified
                                    0
                                else
                                    set is_region: true

                            let reshaped PlannedTuple(
                                second.loc,
                                components_holder,
                                ctor_struct_type,
                                is_region,
                                reshape_life,
                                null
                            )
                            set result: this.rebind_trailing_chain(PlannedOperand(
                                second.loc,
                                PlannedExpression.Tuple reshaped,
                                second.member_access,
                                ctor_struct_type
                            ))
                            if ops.length > 2
                            {
                                var remaining Array[PlannedOperand]()
                                remaining.add result
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get rr
                                    if p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand](remaining)
                                return this.collapse_operand_sequence(remaining_vec)
                            }
                            return result
                        }

                        if is_variant_ctor
                        {
                            ; A CROSS-PACKAGE generic union constructed here
                            ; (Option[int].Some(7), Result[int,bool].Ok(x))
                            ; is never reached by the module walk that lays
                            ; out in-package unions, so lay it out on demand —
                            ; otherwise emit_variant_construction misses the
                            ; struct cache and silently returns null, dropping
                            ; the whole binding. No-op for in-package unions
                            ; (already instantiated) and opaque stdlib types.
                            this.ensure_union_layout(ctor_union_type.name)
                            ; Build a PlannedVariantConstruction. The
                            ; tuple's first component carries the payload
                            ; for variants like Some(int); empty `()`
                            ; produces a payload-less variant.
                            var payload_holder: ref[PlannedOperand]? null
                            choose second.expr
                                when tp: PlannedTuple
                                {
                                    if tp.components <> null
                                    {
                                        let comps (*tp.components)
                                        if comps.length > 0
                                        {
                                            let c_ptr comps.get 0
                                            if c_ptr <> null
                                            {
                                                let c (*c_ptr)
                                                if c.value <> null
                                                {
                                                    let v (*c.value)
                                                    let collapsed this.collapse_operand_sequence(v)
                                                    set payload_holder: &^this collapsed
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                    0

                            let vc PlannedVariantConstruction(
                                second.loc,
                                ctor_union_type,
                                ctor_variant_name,
                                ctor_variant_tag,
                                payload_holder
                            )
                            ; s184: keep a trailing member chain on the
                            ; construction result (`Option.Some(5).value`)
                            ; — same rule as the struct-ctor sites.
                            set result: this.rebind_trailing_chain(PlannedOperand(
                                second.loc,
                                PlannedExpression.VariantConstruction vc,
                                second.member_access,
                                ctor_union_type
                            ))
                            if ops.length > 2
                            {
                                var remaining Array[PlannedOperand]()
                                remaining.add result
                                var rr: size_t 2
                                while rr < ops.length
                                {
                                    let p_ptr ops.get rr
                                    if p_ptr <> null
                                        remaining.add((*p_ptr))
                                    set rr: rr + 1
                                }
                                var remaining_vec Vector[PlannedOperand](remaining)
                                return this.collapse_operand_sequence(remaining_vec)
                            }
                            return result
                        }

                        ; s90: collapse each tuple component's operand
                        ; sequence before reading result_type so binary
                        ; operators in args (e.g. `f(a, x = y)`) yield
                        ; one type per component, matching the function
                        ; arity. Mirrors stage-0's planTuple at
                        ; Planner.cpp:10506-10511 (which always collapses).
                        ; Stage-1's plan_component# only collapses on
                        ; specific shapes; the tuple-arg path slipped
                        ; through. Without collapse here, an arg-list
                        ; component with a bool-comparison operand sees
                        ; `extract_arg_types#` flatten 3 operands into 3
                        ; arg types, resolve_function_call# arity-mismatches,
                        ; match_ref stays null, mangled="", emit_call drops
                        ; the call, and the entire `let X = f(...)` binding
                        ; plus any `if X = ...` follower silently
                        ; vanish from the IR.
                        var arg_types_arr_s90 Array[PlannedType]()
                        choose second.expr
                            when tp_s90: PlannedTuple
                            {
                                if tp_s90.components <> null
                                {
                                    let comps_s90 (*tp_s90.components)
                                    var ai_s90: size_t 0
                                    while ai_s90 < comps_s90.length
                                    {
                                        let cp_s90 comps_s90.get ai_s90
                                        if cp_s90 <> null
                                        {
                                            let c_s90 (*cp_s90)
                                            if c_s90.value <> null
                                            {
                                                let v_s90 (*c_s90.value)
                                                if v_s90.length > 0
                                                {
                                                    let collapsed_s90 this.collapse_operand_sequence(v_s90)
                                                    arg_types_arr_s90.add collapsed_s90.result_type
                                                }
                                            }
                                        }
                                        set ai_s90: ai_s90 + 1
                                    }
                                }
                            }
                            else
                                arg_types_arr_s90.add second.result_type
                        let arg_types Vector[PlannedType](arg_types_arr_s90)
                        var match_ref this.resolve_function_call(fn_name, arg_types)

                        ; First-hop method dispatch (s75): when fn_name
                        ; is a dotted name `arg.starts_with` and `arg`
                        ; resolves to a local binding (not a Concept),
                        ; treat the call as a method on the receiver.
                        ; Without this, free-function lookup on the full
                        ; dotted name fails, the dotted-namespace
                        ; fallback below skips because `arg` isn't a
                        ; Concept, and the call drops with mangled="".
                        ; The receiver is prepended to the args list
                        ; below when is_method_dispatch is true.
                        ; Mirrors stage-0 Planner.cpp:7920-7940 method-
                        ; on-local-variable resolution.
                        var is_method_dispatch: bool false
                        var receiver_op: PlannedOperand result
                        ; Option B (2026-07-02h): set when the resolved call is
                        ; a container get/get_ptr whose receiver holder's guts
                        ; live on the frame's LOCAL page (local_frame_holder_
                        ; names, recorded by plan_binding#). The result type is
                        ; then stamped Local-pointee below (where rt is read
                        ; from the match) so the escape checks see the frame-
                        ; bound reference.
                        var stamp_getref_local: bool false
                        if match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(0, dot_pos)
                                let suffix fn_name.substring(
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                let local_ref this.lookup_local_binding(prefix)
                                if local_ref <> null
                                {
                                    let local (*local_ref)
                                    ; s109: dispatch on generic receivers
                                    ; (Container[int], Box[int]). encode_type#
                                    ; handles `Name[args]` → `<len><name>I<args>E`,
                                    ; so mangle_method# already produces the
                                    ; specialised symbol (e.g. `_ZN9ContainerIiE`
                                    ; `8set_itemEmi`). The previous skip was
                                    ; written before encode_type# learned
                                    ; generics; lifting it lets user-defined
                                    ; `Container[int].set_item(...)` resolve
                                    ; against the spec'd body emitted via
                                    ; instantiate_generic#. Stdlib generics
                                    ; (Vector / HashMap / etc.) are still
                                    ; excluded because their bodies aren't
                                    ; specialised in the planner walk — keep
                                    ; them on the unspec'd dispatch path so
                                    ; the existing extern-decl shim continues
                                    ; to work.
                                    var skip_dispatch: bool false
                                    if local.binding_type.generics <> null
                                    {
                                        if local.binding_type.name.equals("pointer") = false
                                        {
                                            if local.binding_type.name.equals("ref") = false
                                            {
                                                ; s137-INVESTIGATE: Vector removed
                                                if local.binding_type.name.equals("HashMap")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("HashMapBuilder")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("HashSet")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("HashSetBuilder")
                                                    set skip_dispatch: true
                                                ; s154: Array removed from skip_dispatch, mirroring
                                                ; the s137 Vector lift. Array[T] is specialised via
                                                ; instantiate_generic# (s129), so the s109 method-
                                                ; dispatch path (lookup_method# + extern-decl record)
                                                ; produces the right `_ZN5ArrayI<T>E3addE<T>` symbol.
                                                ; Without this, `functions.add(this.plan_function#(f,
                                                ; null))` in plan_module#'s member loop skipped
                                                ; dispatch entirely and the whole statement dropped —
                                                ; so plan_function# was never called, instantiated_
                                                ; functions stayed empty, and stage-2 emitted zero
                                                ; functions.
                                                ; s148: List removed alongside the is_stdlib_generic lift.
                                                ; Specialised List<T>::add/count/get_iterator bodies are
                                                ; now emitted via instantiate_generic#, so dispatch can
                                                ; route through the s109 extern-decl + record_function
                                                ; path the same way Vector does (skip_dispatch on Vector
                                                ; was lifted in s137, no regression there).
                                                ; if local.binding_type.name.equals("List")
                                                ;     set skip_dispatch: true
                                                if local.binding_type.name.equals("ListIterator")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("BuilderList")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("BuilderListIterator")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("Option")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("Result")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("Slice")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("Slot")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("Node")
                                                    set skip_dispatch: true
                                                if local.binding_type.name.equals("KeyValuePair")
                                                    set skip_dispatch: true
                                            }
                                        }
                                    }
                                    if skip_dispatch = false
                                    {
                                    let mm_ref this.lookup_method(local.binding_type, suffix, arg_types)
                                    if mm_ref <> null
                                    {
                                        let mm (*mm_ref)
                                        ; Build receiver as Variable(prefix).
                                        let recv PlannedOperand(
                                            result.loc,
                                            PlannedExpression.Variable(PlannedVariable(
                                                result.loc,
                                                prefix,
                                                local.binding_type,
                                                local.is_mutable
                                            )),
                                            null,
                                            local.binding_type
                                        )
                                        set receiver_op: recv
                                        set is_method_dispatch: true

                                        ; s78: record an extern PlannedFunction
                                        ; for the dispatched method so
                                        ; emit_function_decl emits an LLVM
                                        ; declare and emit_call's
                                        ; LLVMGetNamedFunction resolves it.
                                        ; Same-package methods (Options.*) are
                                        ; declared via the regular plan path;
                                        ; cross-package methods (String.*,
                                        ; Vector.*) need this. Skipped when
                                        ; already recorded (mirrors the
                                        ; dotted-namespace dedup at line ~2949).
                                        if this.has_recorded_function(mm.mangled_name) = false
                                        {
                                            var items_arr Array[PlannedItem]()
                                            items_arr.add(PlannedItem(
                                                result.loc,
                                                false,
                                                null,
                                                &^this local.binding_type,
                                                null
                                            ))
                                            if mm.parameter_types <> null
                                            {
                                                let pt_vec_ref mm.parameter_types
                                                let pt_vec (*pt_vec_ref)
                                                var ai: size_t 0
                                                while ai < pt_vec.length
                                                {
                                                    let p_ptr pt_vec.get ai
                                                    if p_ptr <> null
                                                    {
                                                        items_arr.add(PlannedItem(
                                                            result.loc,
                                                            false,
                                                            null,
                                                            &^this (*p_ptr),
                                                            null
                                                        ))
                                                    }
                                                    set ai: ai + 1
                                                }
                                            }
                                            var items_holder Vector[PlannedItem](items_arr)
                                            let extern_impl PlannedImplementation.Extern(
                                                PlannedExternImpl result.loc
                                            )
                                            ; s119: honor mm.requires_page_param so cross-package /
                                            ; recursive-mid-planning stub IR signature matches the
                                            ; proper PlannedFunction emitted later. Without this,
                                            ; an early stub locks in a no-page-slot LLVM signature
                                            ; for any function whose body recursively calls itself
                                            ; (or is called before plan_function# records it).
                                            var pp_ref_a: ref[String]? null
                                            if mm.requires_page_param
                                            {
                                                var pp_h_a Vector[String](1)
                                                pp_h_a.put(0, "rp")
                                                set pp_ref_a: pp_h_a.get(0)
                                            }
                                            this.record_function(PlannedFunction(
                                                result.loc,
                                                false,
                                                false,
                                                suffix,
                                                mm.mangled_name,
                                                pp_ref_a,
                                                &items_holder,
                                                &^this mm.return_type,
                                                mm.throws_type,
                                                Lifetime.Unspecified(Unspecified()),
                                                extern_impl,
                                                null,
                                                false,
                                                mm.can_throw,
                                                null,
                                                this.file
                                            ))
                                        }
                                        set match_ref: mm_ref

                                        ; Option B: a get/get_ptr ref out of a
                                        ; frame-local-page holder — flag the
                                        ; result for the Local-pointee stamp.
                                        ; The name array is entry-truncated per
                                        ; function (NOT cleared), so a lazily-
                                        ; instantiated generic method planned
                                        ; MID-function sees the outer entries —
                                        ; require the receiver to be a genuine
                                        ; non-parameter local Vector binding of
                                        ; THIS scope (a field/param receiver
                                        ; is caller-lived, never stamped).
                                        var sfx_is_getref suffix.equals("get")
                                        if sfx_is_getref = false
                                            set sfx_is_getref: suffix.equals("get_ptr")
                                        if sfx_is_getref
                                            if local.is_parameter = false
                                                if local.binding_type.name.equals("Vector")
                                                    if this.array_contains_name_from(local_frame_holder_names, this.local_frame_holder_base, prefix)
                                                        set stamp_getref_local: true
                                    }
                                    }
                                }
                            }
                        }

                        ; Method-on-chain dispatch (s83): when the first
                        ; operand has a member_access chain whose last hop
                        ; is_method=true, the call is an instance method on
                        ; the chain's truncated receiver. Truncate the chain
                        ; (drop the method hop), use last_acc.parent_type as
                        ; the receiver type, and look up the method.
                        ; Mirrors stage-0 Planner.cpp:4534-4607. Required
                        ; for `inner.get_value()` and `input_file.get_length()`
                        ; in method bodies (after the implicit-this
                        ; multi-segment fallback in plan_type_operand# returns
                        ; a chain ending in a method hop).
                        if match_ref = null
                        {
                            if result.member_access <> null
                            {
                                let ma_outer (*result.member_access)
                                if ma_outer.length > 0
                                {
                                    let last_p ma_outer.get(ma_outer.length - 1)
                                    if last_p <> null
                                    {
                                        let last_acc (*last_p)
                                        if last_acc.is_method
                                        {
                                            let recv_type last_acc.parent_type
                                            let mm_ref this.lookup_method(recv_type, last_acc.name, arg_types)
                                            if mm_ref <> null
                                            {
                                                let mm3 (*mm_ref)
                                                ; Build truncated chain (drop last hop).
                                                var trunc_arr Array[PlannedMemberAccess]()
                                                var ti: size_t 0
                                                while ti + 1 < ma_outer.length
                                                {
                                                    let mp ma_outer.get ti
                                                    if mp <> null
                                                        trunc_arr.add((*mp))
                                                    set ti: ti + 1
                                                }
                                                if trunc_arr.length > 0
                                                {
                                                    var trunc_holder Vector[PlannedMemberAccess](trunc_arr)
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        &trunc_holder,
                                                        recv_type
                                                    )
                                                }
                                                else
                                                {
                                                    set receiver_op: PlannedOperand(
                                                        result.loc,
                                                        result.expr,
                                                        null,
                                                        recv_type
                                                    )
                                                }

                                                ; Option B stamp (s83 chain path
                                                ; — THE live path for `H.get(i)`
                                                ; on a local receiver: plan_type_
                                                ; operand resolves the hop to a
                                                ; method chain, so fn_name is the
                                                ; bare method name and the s75
                                                ; dotted branch never runs). Only
                                                ; a chain-free Variable receiver
                                                ; can be a holder binding; field
                                                ; receivers (non-empty truncated
                                                ; chain) are caller-lived and
                                                ; never stamped.
                                                var s83_is_getref last_acc.name.equals("get")
                                                if s83_is_getref = false
                                                    set s83_is_getref: last_acc.name.equals("get_ptr")
                                                if s83_is_getref
                                                    if trunc_arr.length = 0
                                                        choose result.expr
                                                            when s83v: Variable
                                                            {
                                                                ; The name array is entry-
                                                                ; truncated per function (NOT
                                                                ; cleared), so a lazily-
                                                                ; instantiated generic method
                                                                ; planned MID-function sees the
                                                                ; outer entries (VectorIterator.
                                                                ; next's `vector` FIELD collided
                                                                ; with test_vector's holder).
                                                                ; Require a genuine non-parameter
                                                                ; local Vector binding of THIS
                                                                ; scope — a field name misses
                                                                ; lookup_local_binding.
                                                                if this.array_contains_name_from(local_frame_holder_names, this.local_frame_holder_base, s83v.name)
                                                                {
                                                                    let s83lb this.lookup_local_binding(s83v.name)
                                                                    if s83lb <> null
                                                                        if s83lb.is_parameter = false
                                                                            if s83lb.binding_type.name.equals("Vector")
                                                                                set stamp_getref_local: true
                                                                }
                                                            }
                                                            else
                                                                0

                                                ; Record extern PlannedFunction so
                                                ; emit_function_decl emits an LLVM
                                                ; declare and emit_call resolves it
                                                ; via LLVMGetNamedFunction. Mirrors
                                                ; the s78 record at the s75 site
                                                ; (line ~2794). Skipped if already
                                                ; recorded.
                                                if this.has_recorded_function(mm3.mangled_name) = false
                                                {
                                                    var items_arr2 Array[PlannedItem]()
                                                    items_arr2.add(PlannedItem(
                                                        result.loc,
                                                        false,
                                                        null,
                                                        &^this recv_type,
                                                        null
                                                    ))
                                                    if mm3.parameter_types <> null
                                                    {
                                                        let pt_vec_ref2 mm3.parameter_types
                                                        let pt_vec2 (*pt_vec_ref2)
                                                        var ai2: size_t 0
                                                        while ai2 < pt_vec2.length
                                                        {
                                                            let p_ptr2 pt_vec2.get ai2
                                                            if p_ptr2 <> null
                                                            {
                                                                items_arr2.add(PlannedItem(
                                                                    result.loc,
                                                                    false,
                                                                    null,
                                                                    &^this (*p_ptr2),
                                                                    null
                                                                ))
                                                            }
                                                            set ai2: ai2 + 1
                                                        }
                                                    }
                                                    var items_holder2 Vector[PlannedItem](items_arr2)
                                                    let extern_impl2 PlannedImplementation.Extern(
                                                        PlannedExternImpl result.loc
                                                    )
                                                    ; s119: see stub-A site above.
                                                    var pp_ref_b: ref[String]? null
                                                    if mm3.requires_page_param
                                                    {
                                                        var pp_h_b Vector[String](1)
                                                        pp_h_b.put(0, "rp")
                                                        set pp_ref_b: pp_h_b.get(0)
                                                    }
                                                    this.record_function(PlannedFunction(
                                                        result.loc,
                                                        false,
                                                        false,
                                                        last_acc.name,
                                                        mm3.mangled_name,
                                                        pp_ref_b,
                                                        &items_holder2,
                                                        &^this mm3.return_type,
                                                        mm3.throws_type,
                                                        Lifetime.Unspecified(Unspecified()),
                                                        extern_impl2,
                                                        null,
                                                        false,
                                                        mm3.can_throw,
                                                        null,
                                                        this.file
                                                    ))
                                                }

                                                set match_ref: mm_ref
                                                set is_method_dispatch: true
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; Dotted call fallback: `cli.main(args)` arrives
                        ; with fn_name="cli.main"; the function is registered
                        ; in model_functions under its short name "main"
                        ; (register_concept_recursive flattens namespace
                        ; members; register_module_concepts recurses into
                        ; sub-modules with register_function). Retry with
                        ; the suffix; if the prefix resolves to a Namespace
                        ; concept, also override mangled_name to
                        ; `_ZN<prefix><name>E<args>` so the call links to
                        ; the namespaced function (otherwise
                        ; check_function_match's mangle_free_function path
                        ; produces the bare `_Z<name>` and collides with
                        ; the program's own free function of the same
                        ; name). Plain modules don't add a namespace
                        ; segment to the mangled name, so the suffix-only
                        ; resolve already returns the right MethodMatch
                        ; for `compiler.test()` etc.
                        var ns_mangled: String ""
                        var has_ns_mangled: bool false
                        ; Hoisted out of the nested ns-resolution block so the
                        ; call_requires_page computation below can honor the
                        ; prefix namespace member's own page flag (used_ns_page)
                        ; when the dotted re-mangle fired — otherwise the symbol
                        ; gets the page in its name but the call omits the rp
                        ; argument (wrong slot / missing page).
                        var ns_mangled_page: bool false
                        ; The actual namespace member's planned parameter types,
                        ; recorded when the s129 dotted re-mangle resolves to a
                        ; namespace member (used_ns_local). Used to drive the
                        ; String→const_char argument coercion correctly even when
                        ; the bare-name match picked a wrong same-named overload.
                        var ns_coerce_params Array[PlannedType]()
                        var ns_coerce_valid: bool false
                        ; The namespace member's actual return type, captured on
                        ; the s129 dotted re-mangle. The bare-name match may have
                        ; picked a wrong same-named overload whose return type
                        ; maps to the { ptr } cross-package placeholder; using it
                        ; for the call's sret slot undersizes it and the callee's
                        ; write overflows into adjacent stack. Prefer the member's
                        ; own return type.
                        var ns_return_type: PlannedType this.fresh_type_var("")
                        var ns_return_valid: bool false
                        if match_ref = null
                        {
                            let dot_idx fn_name.last_index_of(46 as u8)
                            if dot_idx > 0
                            {
                                let dot_pos dot_idx as size_t
                                let prefix fn_name.substring(0, dot_pos)
                                let suffix fn_name.substring(
                                    dot_pos + 1,
                                    fn_name.get_length() - dot_pos - 1
                                )
                                ; s-LSP: resolve the dotted call. resolve_dotted_call#
                                ; first tries the normal this-implicit overload,
                                ; then — for a namespace this-method invoked
                                ; qualified with an EXPLICIT receiver
                                ; (`NS.f(recv, ...)` for `f(this: T, ...)`, where
                                ; `recv` is in arg_types but the this-implicit
                                ; matcher skips `this` and arity-fails) — retries
                                ; with the receiver arg dropped. Mirrors stage-0's
                                ; name-only Namespace path (Planner.cpp:8663); the
                                ; namespace-mangling block below then drops `this`
                                ; from the name (`_ZN<ns><fn>Ev`) and the call
                                ; still passes every explicit arg, so `recv` fills
                                ; `this`. This stays ONE statement — one call, one
                                ; store to match_ref, exactly as the old single
                                ; resolve_function_call# — so collapse_operand_
                                ; sequence#'s s178 alloca pool keeps match_ref in a
                                ; stable slot. An earlier two-statement form (a
                                ; `if match_ref = null { set match_ref: ... }`
                                ; diamond) perturbed the pool's liveness and aliased
                                ; match_ref onto a recycled slot (two_vec), losing
                                ; the value before the final mangled-name read.
                                set match_ref: this.resolve_dotted_call(prefix, suffix, arg_types)

                                if match_ref <> null
                                {
                                    ; s177: prefer the Namespace concept for the
                                    ; prefix. lookup_concept returns the inner
                                    ; same-named Structure for `define Planner {
                                    ; define Planner(...) }`, so `Planner.x()`
                                    ; from another namespace never took the
                                    ; namespace-mangling branch and the whole
                                    ; statement dropped.
                                    let ns_ref this.lookup_namespace_concept(prefix)
                                    if ns_ref <> null
                                    {
                                        let nsc (*ns_ref)
                                        var is_ns: bool false
                                        choose nsc.definition
                                            when n: Namespace
                                                set is_ns: true
                                            else
                                                0
                                        if is_ns
                                        {
                                            ; Build PlannedType for the
                                            ; namespace as a parent and
                                            ; rebuild the mangled name.
                                            let ns_parent_ref &^this PlannedType(
                                                result.loc,
                                                String(prefix),
                                                Planner.encode_name prefix,
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                "",
                                                null
                                            )

                                            ; Build items from the matched
                                            ; function's declared parameter
                                            ; types (not arg_types). Stage-0
                                            ; mangles using the declared
                                            ; param types — e.g. Console.println's
                                            ; signature is
                                            ; `(text: pointer[const_char])`,
                                            ; so the mangled name is
                                            ; `_ZN7Console7printlnEP10const_char`.
                                            ; Using arg_types instead would
                                            ; produce `_ZN7Console7printlnEP2i8`
                                            ; (string-literal type) which
                                            ; doesn't match libscaly's symbol.
                                            ;
                                            ; s129: when the prefix is a
                                            ; Namespace concept, look up the
                                            ; function within ITS members
                                            ; first. resolve_function_call#
                                            ; uses the global model_functions
                                            ; registry (keyed by bare name),
                                            ; so for Console.println it can
                                            ; resolve to the PRELUDE's
                                            ; `println(pointer[i8])` via
                                            ; exact-match — even though we're
                                            ; trying to dispatch to
                                            ; Console.println(pointer[const_char]).
                                            ; Without this carve-out, the
                                            ; rebuild produces
                                            ; `_ZN7Console7printlnEP2i8` (using
                                            ; prelude's `pointer[i8]`) rather
                                            ; than `...P10const_char`, and
                                            ; the link fails against
                                            ; libscaly's `..P10const_char`.
                                            var items_arr Array[PlannedItem]()
                                            var used_ns_local: bool false
                                            ; When the prefix namespace declares
                                            ; the member itself (used_ns_local),
                                            ; the page requirement must come from
                                            ; THAT member, not from the global
                                            ; bare-name match — a same-named
                                            ; function in another package (e.g.
                                            ; scalyc.compiler's no-`#`
                                            ; is_primitive_type_name vs symbols'
                                            ; `#` one) can win the registry scan
                                            ; with requires_page_param=false,
                                            ; dropping `PN4scaly6memory4PageE` and
                                            ; leaving the call referencing a
                                            ; never-defined no-page symbol.
                                            var used_ns_page: bool false
                                            choose nsc.definition
                                                when ns_def: Namespace
                                                {
                                                    var mi_ns: size_t 0
                                                    while mi_ns < ns_def.members.length
                                                    {
                                                        let m_ptr ns_def.members.get mi_ns
                                                        if m_ptr <> null
                                                        {
                                                            let mem (*m_ptr)
                                                            choose mem
                                                                when nf: Function
                                                                {
                                                                    if used_ns_local = false
                                                                    {
                                                                        if nf.name.equals(suffix)
                                                                        {
                                                                            ; Skip leading 'this'.
                                                                            var pstart: size_t 0
                                                                            if nf.input.length > 0
                                                                            {
                                                                                let fi0 nf.input.get 0
                                                                                if fi0 <> null
                                                                                {
                                                                                    if fi0.name <> null
                                                                                    {
                                                                                        let fname (*fi0.name)
                                                                                        if fname.equals("this")
                                                                                            set pstart: 1
                                                                                    }
                                                                                }
                                                                            }
                                                                            let expected_arity nf.input.length - pstart
                                                                            ; Two callable forms for a namespace function
                                                                            ; with an explicit `this` receiver param:
                                                                            ;   (a) receiver-separate: arg_types holds the
                                                                            ;       non-`this` args (expected_arity match);
                                                                            ;   (b) this-inclusive: the receiver is passed
                                                                            ;       as the first arg (json.stringify(v)),
                                                                            ;       so arg_types.length == nf.input.length.
                                                                            ; For (b) build from the FULL input (build_start
                                                                            ; 0) so the recorded stub's param list MATCHES
                                                                            ; the real PlannedFunction (plan_function# keeps
                                                                            ; `this` in input; mangle_function# skips the
                                                                            ; `this`-named item). Without this, a function
                                                                            ; whose ONLY param is `this` got an empty-input
                                                                            ; extern stub recorded first, locking in a
                                                                            ; signature missing the `this` LLVM arg.
                                                                            var build_start: size_t pstart
                                                                            var arity_ok: bool false
                                                                            if expected_arity = arg_types.length
                                                                                set arity_ok: true
                                                                            if pstart > 0
                                                                            {
                                                                                if nf.input.length = arg_types.length
                                                                                {
                                                                                    set arity_ok: true
                                                                                    set build_start: 0
                                                                                }
                                                                            }
                                                                            if arity_ok
                                                                            {
                                                                                var pi_ns: size_t build_start
                                                                                while pi_ns < nf.input.length
                                                                                {
                                                                                    let p_ptr nf.input.get pi_ns
                                                                                    if p_ptr <> null
                                                                                    {
                                                                                        if p_ptr.type <> null
                                                                                        {
                                                                                            let pt (*p_ptr.type)
                                                                                            let planned_p this.plan_type(pt)
                                                                                            var ity_holder Vector[PlannedType](1)
                                                                                            ity_holder.put(0, planned_p)
                                                                                            ; Preserve the param NAME so the
                                                                                            ; `this` item is recognised and
                                                                                            ; skipped by mangle_function#.
                                                                                            items_arr.add(PlannedItem(
                                                                                                result.loc,
                                                                                                false,
                                                                                                p_ptr.name,
                                                                                                ity_holder.get 0,
                                                                                                null
                                                                                            ))
                                                                                            ; Record this member's planned param
                                                                                            ; for the String→const_char coercion.
                                                                                            ns_coerce_params.add planned_p
                                                                                            set ns_coerce_valid: true
                                                                                        }
                                                                                    }
                                                                                    set pi_ns: pi_ns + 1
                                                                                }
                                                                                set used_ns_local: true
                                                                                if nf.page_parameter <> null
                                                                                    set used_ns_page: true
                                                                                if Planner.function_needs_caller_page(this, nf)
                                                                                    set used_ns_page: true
                                                                                ; Capture the member's real return type so
                                                                                ; the call's sret slot is sized correctly
                                                                                ; (the bare-name match may have a wrong one).
                                                                                if nf.returns_ <> null
                                                                                {
                                                                                    let nf_rt this.plan_type((*nf.returns_))
                                                                                    this.ensure_type_layout nf_rt
                                                                                    set ns_return_type: nf_rt
                                                                                    set ns_return_valid: true
                                                                                }
                                                                            }
                                                                        }
                                                                    }
                                                                }
                                                                else
                                                                    0
                                                        }
                                                        set mi_ns: mi_ns + 1
                                                    }
                                                }
                                                else
                                                    0
                                            let mm_for_params (*match_ref)
                                            let param_types_ref mm_for_params.parameter_types
                                            if used_ns_local = false
                                            {
                                                if param_types_ref <> null
                                                {
                                                    let pts (*param_types_ref)
                                                    var ai: size_t 0
                                                    while ai < pts.length
                                                    {
                                                        let pt_ptr pts.get ai
                                                        if pt_ptr <> null
                                                        {
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                &^this (*pt_ptr),
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                                if param_types_ref = null
                                                {
                                                    var ai: size_t 0
                                                    while ai < arg_types.length
                                                    {
                                                        let at_ptr arg_types.get ai
                                                        if at_ptr <> null
                                                        {
                                                            items_arr.add(PlannedItem(
                                                                result.loc,
                                                                false,
                                                                null,
                                                                &^this (*at_ptr),
                                                                null
                                                            ))
                                                        }
                                                        set ai: ai + 1
                                                    }
                                                }
                                            }
                                            var items_holder Vector[PlannedItem](items_arr)
                                            ; Honor the matched function's
                                            ; page-param flag in the mangled
                                            ; name. parse_args# in cli.scaly
                                            ; has has_page=true so the symbol
                                            ; needs `PN4scaly6memory4PageE`
                                            ; after the function name; without
                                            ; this stage-1 produced
                                            ; `_ZN3cli10parse_argsEiPPc` which
                                            ; doesn't match libscalyc's real
                                            ; `_ZN3cli10parse_argsEPN4scaly6memory4PageEiPPc`.
                                            let mm_pp (*match_ref)
                                            ; Page requirement: when the prefix
                                            ; namespace itself declared the member
                                            ; (used_ns_local), trust THAT member's
                                            ; page flag; otherwise the resolved
                                            ; global match.
                                            var ns_has_page: bool mm_pp.requires_page_param
                                            if used_ns_local
                                                set ns_has_page: used_ns_page
                                            set ns_mangled: Planner.mangle_function(
                                                suffix, &items_holder, ns_parent_ref, ns_has_page
                                            )
                                            set has_ns_mangled: true
                                            set ns_mangled_page: ns_has_page

                                            ; Declare the namespaced
                                            ; function as extern in the
                                            ; instantiation cache so the
                                            ; Emitter generates an LLVM
                                            ; declaration that emit_call
                                            ; can resolve via
                                            ; LLVMGetNamedFunction. The
                                            ; function's body comes from
                                            ; the linked package binary
                                            ; (libscalyc / libscaly) at
                                            ; link time. plan_namespace#
                                            ; itself doesn't recurse
                                            ; into ns.modules — calling
                                            ; plan_module# on stdlib
                                            ; modules crashes stage-1
                                            ; on body-level features it
                                            ; doesn't yet support, but
                                            ; an extern declaration
                                            ; needs only types we've
                                            ; already resolved here.
                                            ;
                                            ; Skip the declaration when
                                            ; we're inside a loaded
                                            ; package's namespace body
                                            ; (current_namespace is set)
                                            ; UNLESS the prefix matches
                                            ; a Use-imported alias of
                                            ; the program's main module.
                                            ; Without the gate, externs
                                            ; emitted from e.g.
                                            ; scaly.test()'s body for
                                            ; memory.test/containers.test/
                                            ; io.test break AOT tests
                                            ; that don't link libscaly.
                                            ; The Use-alias carve-out
                                            ; lets explicitly imported
                                            ; namespaces (e.g.
                                            ; main.scaly's
                                            ; `use scalyc.cli` -> "cli")
                                            ; emit real call
                                            ; instructions; the linker
                                            ; resolves them against the
                                            ; package binary at link
                                            ; time. Mirrors stage-0's
                                            ; check at
                                            ; Planner.cpp:7752-7789.
                                            ; Gate now relies solely on
                                            ; the program's Use aliases.
                                            ; Previously this also opened
                                            ; on `current_namespace = null`
                                            ; to handle top-level call
                                            ; sites in the main program;
                                            ; that was load-bearing only
                                            ; while libscaly wasn't linked
                                            ; into the AOT pipeline. Now
                                            ; that cli.run links libscaly
                                            ; unconditionally, the
                                            ; current_namespace clause is
                                            ; no longer required: any
                                            ; legitimate top-level call
                                            ; into a loaded package goes
                                            ; through a Use-imported
                                            ; alias. main.scaly's
                                            ; `use scalyc.cli` puts "cli"
                                            ; in program_use_aliases, so
                                            ; `cli.main(...)` still opens
                                            ; the gate.
                                            ; Also opens the gate when the
                                            ; prefix matches the currently-
                                            ; active namespace (sibling call
                                            ; like cli.parse_args# from
                                            ; inside cli.main). Mirrors
                                            ; stage-0's flatten-current-
                                            ; namespace pre-pass at
                                            ; Planner.cpp:7313-7327.
                                            var prefix_is_current_ns: bool false
                                            if current_namespace_name <> null
                                            {
                                                let cnsn (*current_namespace_name)
                                                if cnsn.equals(prefix)
                                                    set prefix_is_current_ns: true
                                            }
                                            var gate_open: bool false
                                            if this.is_program_use_alias(prefix)
                                                set gate_open: true
                                            if prefix_is_current_ns
                                                set gate_open: true
                                            if gate_open
                                            if this.has_recorded_function(ns_mangled) = false
                                            {
                                                let mm (*match_ref)
                                                let extern_impl PlannedImplementation.Extern(
                                                    PlannedExternImpl result.loc
                                                )
                                                ; s78: propagate page_parameter when the
                                                ; matched function has has_page=true.
                                                ; Without this, function# callees recorded
                                                ; via the dotted fallback get null
                                                ; page_parameter, so emit_function_decl
                                                ; emits a 1-param signature for what
                                                ; should be 2-param (Page* + user param).
                                                ; A later call that goes through the body
                                                ; uses LLVMGetParam(func, 1) on a 1-param
                                                ; function and gets a bogus pointer.
                                                var pp_ref: ref[String]? null
                                                if ns_has_page
                                                {
                                                    var pp_h Vector[String](1)
                                                    pp_h.put(0, "rp")
                                                    set pp_ref: pp_h.get(0)
                                                }
                                                this.record_function(PlannedFunction(
                                                    result.loc,
                                                    false,
                                                    false,
                                                    suffix,
                                                    ns_mangled,
                                                    pp_ref,
                                                    &items_holder,
                                                    &^this mm.return_type,
                                                    mm.throws_type,
                                                    Lifetime.Unspecified(Unspecified()),
                                                    extern_impl,
                                                    null,
                                                    false,
                                                    mm.can_throw,
                                                    null,
                                                    this.file
                                                ))
                                            }
                                        }
                                    }
                                }

                                ; s155: Static method call `Type.method(args)`
                                ; where Type is a Structure concept and method
                                ; is a this-less function member. Mirrors stage-0
                                ; Planner.cpp:8421-8517. resolve_function_call#
                                ; (suffix) above misses these because struct
                                ; static methods aren't in the free-function
                                ; registry. Without this, `Page.get(this as
                                ; pointer[void])` inside Vector/Array.add resolves
                                ; to null and the whole `let own_page` binding
                                ; plus every downstream statement (allocate, the
                                ; item store, `set data`) silently drops — leaving
                                ; container .add() bodies that only bump `length`.
                                if match_ref = null
                                {
                                    let smc_ref this.lookup_concept(prefix)
                                    if smc_ref <> null
                                    {
                                        let smc (*smc_ref)
                                        var static_fn: ref[Function]? null
                                        choose smc.definition
                                            when sst: Structure
                                            {
                                                var smi: size_t 0
                                                while smi < sst.members.length
                                                {
                                                    let sm_ptr sst.members.get smi
                                                    if sm_ptr <> null
                                                    {
                                                        let sm (*sm_ptr)
                                                        choose sm
                                                            when sf: Function
                                                            {
                                                                if static_fn = null
                                                                {
                                                                    if sf.name.equals(suffix)
                                                                    {
                                                                        var is_static: bool true
                                                                        if sf.input.length > 0
                                                                        {
                                                                            let i0 sf.input.get 0
                                                                            if i0 <> null
                                                                            {
                                                                                if i0.name <> null
                                                                                {
                                                                                    if (*i0.name).equals("this")
                                                                                        set is_static: false
                                                                                }
                                                                            }
                                                                        }
                                                                        if is_static
                                                                            set static_fn: &^this sf
                                                                    }
                                                                }
                                                                0
                                                            }
                                                            else
                                                                0
                                                    }
                                                    set smi: smi + 1
                                                }
                                            }
                                            else
                                                0

                                        if static_fn <> null
                                        {
                                            let sfn (*static_fn)
                                            let sparent_ref &^this PlannedType(
                                                result.loc,
                                                String(prefix),
                                                Planner.encode_name prefix,
                                                null,
                                                Lifetime.Unspecified(Unspecified()),
                                                null,
                                                "",
                                                null
                                            )
                                            var sitems_arr Array[PlannedItem]()
                                            var spi: size_t 0
                                            while spi < sfn.input.length
                                            {
                                                let p_ptr sfn.input.get spi
                                                if p_ptr <> null
                                                {
                                                    if p_ptr.type <> null
                                                    {
                                                        let pt (*p_ptr.type)
                                                        sitems_arr.add(PlannedItem(
                                                            result.loc, false, null, &^this this.plan_type(pt), null
                                                        ))
                                                    }
                                                }
                                                set spi: spi + 1
                                            }
                                            var sitems_holder Vector[PlannedItem](sitems_arr)
                                            ; Page-param flag mirrors plan_function#'s
                                            ; has_page: explicit page_parameter OR an
                                            ; implicit return-page (struct-returning fns
                                            ; like statement_result_type get an rp arg in
                                            ; the mangled name even with no `#`). Without
                                            ; the implicit check, the call site mangles
                                            ; `...E16PlannedStatement` while the def is
                                            ; `...PageE16PlannedStatement` → link failure.
                                            var s_pp: bool false
                                            if sfn.page_parameter <> null
                                                set s_pp: true
                                            if Planner.function_needs_caller_page(this, sfn)
                                                set s_pp: true
                                            let smangled Planner.mangle_function(
                                                suffix, &sitems_holder, sparent_ref, s_pp
                                            )
                                            var s_rt: PlannedType Planner.make_void_type()
                                            if sfn.returns_ <> null
                                                set s_rt: this.plan_type((*sfn.returns_))
                                            var s_throws: ref[PlannedType]? null
                                            var s_can_throw: bool false
                                            if sfn.throws_ <> null
                                            {
                                                set s_can_throw: true
                                                set s_throws: &^this this.plan_type((*sfn.throws_))
                                            }
                                            var srt_holder Vector[PlannedType](1)
                                            srt_holder.put(0, s_rt)
                                            set match_ref: MethodMatch^this(
                                                null,
                                                smangled,
                                                s_rt,
                                                null,
                                                s_pp,
                                                s_can_throw,
                                                s_throws,
                                                false,
                                                false,
                                                false
                                            )
                                            if this.has_recorded_function(smangled) = false
                                            {
                                                var spp_ref: ref[String]? null
                                                if s_pp
                                                {
                                                    var spph Vector[String](1)
                                                    spph.put(0, "rp")
                                                    set spp_ref: spph.get(0)
                                                }
                                                let sextern PlannedImplementation.Extern(
                                                    PlannedExternImpl result.loc
                                                )
                                                this.record_function(PlannedFunction(
                                                    result.loc,
                                                    false,
                                                    false,
                                                    suffix,
                                                    smangled,
                                                    spp_ref,
                                                    &sitems_holder,
                                                    srt_holder.get 0,
                                                    s_throws,
                                                    Lifetime.Unspecified(Unspecified()),
                                                    sextern,
                                                    null,
                                                    false,
                                                    s_can_throw,
                                                    null,
                                                    this.file
                                                ))
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; s101: Implicit-this sibling method dispatch.
                        ; When the standard lookup didn't find `fn_name`
                        ; and `this: pointer[T]` is in scope, try resolving
                        ; as T's method. Mirrors stage-0 Planner.cpp:1257-
                        ; 1277 (lookupFunction's struct-member walk) +
                        ; 9747-9786 (mangleFunction with parent = struct).
                        ; Required for `define T { fn a() ... fn b() a() }`
                        ; where `a()` from inside `b()` is a sibling method.
                        ; Without this, sibling method calls fall through
                        ; to mangled="" and the call drops out of the IR.
                        if match_ref = null
                        {
                            if has_ns_mangled = false
                            {
                                let this_ref this.lookup_local("this")
                                if this_ref <> null
                                {
                                    let this_ty (*this_ref)
                                    if this_ty.name.equals("pointer")
                                    {
                                        if this_ty.generics <> null
                                        {
                                            let gens_t (*this_ty.generics)
                                            if gens_t.length > 0
                                            {
                                                let inner_ptr gens_t.get 0
                                                if inner_ptr <> null
                                                {
                                                    let inner_t (*inner_ptr)
                                                    let mm_ref this.lookup_method(inner_t, fn_name, arg_types)
                                                    if mm_ref <> null
                                                    {
                                                        set match_ref: mm_ref
                                                        ; Prepend the `this` receiver ONLY for instance
                                                        ; methods. A STATIC sibling method (Page::get,
                                                        ; Page::allocate_page) takes no `this` — prepending
                                                        ; it passes the wrong arg0 (s189: `get(object)` →
                                                        ; `get(this, object)` → current_page self-loop).
                                                        if (*mm_ref).takes_this
                                                        {
                                                            ; Build receiver_op as `this`.
                                                            set receiver_op: PlannedOperand(
                                                                result.loc,
                                                                PlannedExpression.Variable(PlannedVariable(
                                                                    result.loc,
                                                                    "this",
                                                                    this_ty,
                                                                    false
                                                                )),
                                                                null,
                                                                this_ty
                                                            )
                                                            set is_method_dispatch: true
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        var rt: PlannedType this.fresh_type_var("")
                        var mangled: String ""
                        if match_ref <> null
                        {
                            let m (*match_ref)
                            set rt: m.return_type
                            set mangled: m.mangled_name
                        }
                        if has_ns_mangled
                            set mangled: ns_mangled
                        ; When the dotted re-mangle resolved to a namespace
                        ; member, use ITS return type for the call's sret slot —
                        ; the bare-name match's return type can be a wrong
                        ; same-named overload's (s129), undersizing the sret.
                        if has_ns_mangled
                            if ns_return_valid
                                set rt: ns_return_type

                        ; Option B: the receiver holder's guts live on the
                        ; frame's local page — stamp the get/get_ptr result's
                        ; pointee life Local (Option-of-ref pierced by the
                        ; escape leaf predicates) so an escaping use of the
                        ; reference is rejected instead of dangling.
                        if stamp_getref_local
                            set rt: Planner.stamp_getref_local_pointee(rt)

                        ; Flatten the tuple argument into a list of
                        ; individual PlannedOperand values so the emitter
                        ; can treat each call argument separately. An
                        ; empty `()` produces an empty list. When the
                        ; call is a method dispatch on a local-variable
                        ; receiver (s75), prepend the receiver as
                        ; argument 0; the callee declared `this` as the
                        ; first param.
                        var args_arr Array[PlannedOperand]()
                        if is_method_dispatch
                            args_arr.add receiver_op
                        choose second.expr
                            when tp: PlannedTuple
                            {
                                if tp.components <> null
                                {
                                    let comps (*tp.components)
                                    var ci: size_t 0
                                    while ci < comps.length
                                    {
                                        let c_ptr comps.get ci
                                        if c_ptr <> null
                                        {
                                            let c (*c_ptr)
                                            if c.value <> null
                                            {
                                                let v (*c.value)
                                                args_arr.add(this.collapse_operand_sequence(v))
                                            }
                                        }
                                        set ci: ci + 1
                                    }
                                }
                            }
                            else
                                args_arr.add second
                        var call_args Vector[PlannedOperand](args_arr)
                        ; String → const_char argument coercion: wrap a String
                        ; argument bound to a pointer[const_char]-like parameter
                        ; in a PlannedAs so emit_as lowers it to a c_data pointer.
                        ; For a namespace-qualified call (`json.get(msg, "k")`)
                        ; the bare-name resolution may have matched a same-named
                        ; overload with a String parameter (the s129 collision),
                        ; so match_ref.parameter_types is wrong; the s129 path
                        ; recorded the actual namespace member's planned params
                        ; in ns_coerce_params — prefer those when present.
                        if has_ns_mangled
                            if ns_coerce_valid
                            {
                                var ns_cp_holder Vector[PlannedType](ns_coerce_params)
                                set call_args: this.coerce_string_args_to_cstr(call_args, ns_cp_holder)
                            }
                        if has_ns_mangled = false
                            if match_ref <> null
                            {
                                let mm_cc (*match_ref)
                                if mm_cc.parameter_types <> null
                                    set call_args: this.coerce_string_args_to_cstr(call_args, (*mm_cc.parameter_types))
                            }
                        ; Propagate the matched function's page-param
                        ; requirement to the PlannedCall so emit_call
                        ; prepends the rp arg. Required for in-namespace
                        ; sibling calls to `function#` callees (e.g.
                        ; cli.main → cli.parse_args#).
                        var call_requires_page: bool false
                        if match_ref <> null
                        {
                            let mm_for_pp (*match_ref)
                            if mm_for_pp.requires_page_param
                                set call_requires_page: true
                        }
                        ; When the dotted re-mangle overrode the symbol with the
                        ; prefix namespace member's page flag, the call must pass
                        ; rp to match (the global match this call resolved to can
                        ; be a same-named no-page function in another package).
                        if has_ns_mangled
                            set call_requires_page: ns_mangled_page
                        ; s143: propagate the matched function's can_throw
                        ; flag so plan_choose# can recognise this as a
                        ; throws-call when planning a choose over its
                        ; result. Without this, cli.run's
                        ; `choose p.parse_program() when err: Error / when
                        ; program: Success` doesn't get distinct
                        ; variant_indices and the Error arm always wins via
                        ; the s142 default-redirect.
                        var call_can_throw: bool false
                        var call_throws_ty: ref[PlannedType]? null
                        if match_ref <> null
                        {
                            let mm_for_ct (*match_ref)
                            if mm_for_ct.can_throw
                                set call_can_throw: true
                            ; s149: propagate throws error type for Result-wrapper
                            if mm_for_ct.throws_type <> null
                                set call_throws_ty: mm_for_ct.throws_type
                        }
                        var call_args_holder Vector[PlannedOperand](call_args)
                        ; Option::unwrap / unwrap_or are intrinsics: the
                        ; emitter inlines them (NPO load / payload extract)
                        ; rather than calling a library function. Marking
                        ; them is_intrinsic here routes emit_call to
                        ; emit_intrinsic_function. Without this, a `.unwrap()`
                        ; reached via the multi-hop method-on-chain path
                        ; emits `call _ZN6OptionIR<T>E6unwrapEv` for scalyc
                        ; type args (PlannedType&, PlannedOperand&, ...) that
                        ; libscaly.a (Option over scaly types only) can't
                        ; provide → stage-2 link failure.
                        var call_is_intrinsic: bool false
                        if fn_name.equals("unwrap")
                            set call_is_intrinsic: true
                        if fn_name.equals("unwrap_or")
                            set call_is_intrinsic: true
                        ; s184: only Option's OWN unwrap/unwrap_or are
                        ; intrinsic. A user-defined free function named
                        ; `unwrap` resolves via match_ref without a
                        ; receiver and must emit as a plain call —
                        ; marking it intrinsic routed it through
                        ; emit_intrinsic_function, which returned null
                        ; and silently dropped the whole statement.
                        if call_is_intrinsic
                        {
                            if match_ref <> null
                            {
                                var recv_is_option: bool false
                                if is_method_dispatch
                                {
                                    if receiver_op.result_type.name.equals("Option")
                                        set recv_is_option: true
                                }
                                if recv_is_option = false
                                    set call_is_intrinsic: false
                            }
                        }
                        ; s200: unwrap_or on a REAL-union Option receiver
                        ; (Option[int] — no ref/pointer generic) emits as a
                        ; plain call to the lazily-instantiated body.
                        ; emit_intrinsic_function's unwrap_or arm is a
                        ; placeholder that unconditionally returns the
                        ; DEFAULT. NPO receivers (Option[ref[T]]) keep the
                        ; intrinsic route as before (their bodies are never
                        ; instantiated — the fixed-point divergence trap).
                        ; unwrap stays intrinsic always: it is declared
                        ; `intrinsic` and has no body to call.
                        if call_is_intrinsic
                        {
                            if fn_name.equals("unwrap_or")
                            {
                                if is_method_dispatch
                                {
                                    if Planner.is_lazy_real_union(receiver_op.result_type.name, receiver_op.result_type.generics)
                                        set call_is_intrinsic: false
                                }
                            }
                        }
                        ; s185 (roadmap Step C): resolution exhausted —
                        ; mangled stays "". emit_call cannot look up such
                        ; a call; it would be SILENTLY dropped from the
                        ; IR. Two rescues replace the drop:
                        ; (a) bare variant construction `Some(5)`: scan
                        ;     the registered unions for a variant named
                        ;     fn_name and divert to a
                        ;     PlannedVariantConstruction. Stage-0's JIT
                        ;     path plans this shape (its AOT path dropped
                        ;     it too). First matching union wins. The
                        ;     scan is O(concepts^2) but only runs after
                        ;     resolution failure — never on a clean
                        ;     self-compile. (Out of scope for the concept_index
                        ;     Step-1 speedup: it scans variant names, not
                        ;     concept names; a future multi-index could serve
                        ;     it.)
                        ; (b) otherwise a HARD diagnostic with source
                        ;     position; cli.run prints it and fails the
                        ;     compile instead of emitting truncated IR.
                        if mangled.get_length() = 0
                        {
                            if call_is_intrinsic = false
                            {
                                if fn_name.last_index_of(46 as u8) < 0
                                {
                                    var bv_found: bool false
                                    var bv_tag: size_t 0
                                    var bv_union_name ""
                                    var bvi: size_t 0
                                    while bvi < concepts.length
                                    {
                                        if bv_found = false
                                        {
                                            let bv_kvp concepts.get bvi
                                            if bv_kvp <> null
                                            {
                                                let bv_t this.lookup_variant_tag(bv_kvp.key, fn_name)
                                                if bv_t >= 0
                                                {
                                                    set bv_found: true
                                                    set bv_tag: bv_t as size_t
                                                    set bv_union_name: bv_kvp.key
                                                }
                                            }
                                        }
                                        set bvi: bvi + 1
                                    }
                                    if bv_found
                                    {
                                        let bv_union_ty PlannedType(
                                            result.loc,
                                            bv_union_name,
                                            Planner.mangle_structure(bv_union_name, null),
                                            null,
                                            Lifetime.Unspecified(Unspecified()),
                                            null,
                                            "",
                                            null
                                        )
                                        var bv_payload: ref[PlannedOperand]? null
                                        if call_args_holder.length > 0
                                            set bv_payload: call_args_holder.get(0)
                                        let bv_vc PlannedVariantConstruction(
                                            result.loc,
                                            bv_union_ty,
                                            fn_name,
                                            bv_tag,
                                            bv_payload
                                        )
                                        ; Keep a trailing member chain on the
                                        ; construction result and early-return,
                                        ; mirroring the gate's variant-ctor
                                        ; branch (s184).
                                        set result: this.rebind_trailing_chain(PlannedOperand(
                                            result.loc,
                                            PlannedExpression.VariantConstruction bv_vc,
                                            second.member_access,
                                            bv_union_ty
                                        ))
                                        if ops.length > 2
                                        {
                                            var bv_remaining Array[PlannedOperand]()
                                            bv_remaining.add result
                                            var bv_rr: size_t 2
                                            while bv_rr < ops.length
                                            {
                                                let bv_ptr ops.get bv_rr
                                                if bv_ptr <> null
                                                    bv_remaining.add((*bv_ptr))
                                                set bv_rr: bv_rr + 1
                                            }
                                            var bv_vec Vector[PlannedOperand](bv_remaining)
                                            return this.collapse_operand_sequence(bv_vec)
                                        }
                                        return result
                                    }
                                }
                                var dsb StringBuilder()
                                dsb.append "function not found: "
                                dsb.append fn_name
                                ; Strict use visibility: if the name
                                ; exists but is hidden here, say how to
                                ; import it.
                                let vis_hint this.use_vis_hint(fn_name)
                                if vis_hint.get_length() > 0
                                    dsb.append vis_hint
                                this.add_diagnostic(result.loc, dsb.to_string())
                            }
                        }
                        ; s196: propagate a `^name`/`#`/`$` lifetime onto the
                        ; PlannedCall. emit_call reads call.life inside its
                        ; requires_page_param branch: a Reference life routes
                        ; the page argument through resolve_reference_page(name)
                        ; (e.g. own_page) rather than the function-local page.
                        ; Mirrors stage-0 Planner.cpp:7444 (CallLifeRef =
                        ; HasLifetimeThenArgs ? MethodLifetime : TypeExpr->Life).
                        ; The marker pre-pass merges the `^name` either into the
                        ; receiver TYPE (`slot_list.add^own_page` — receiver is
                        ; a multi-segment PlannedType) or into the args TUPLE
                        ; (receiver planned as Variable+chain). Read both.
                        var call_life: Lifetime Lifetime.Unspecified(Unspecified())
                        choose result.expr
                            when ty_life: PlannedType
                            {
                                choose ty_life.life
                                    when u: Unspecified
                                        0
                                    else
                                        set call_life: ty_life.life
                                0
                            }
                            else
                                0
                        choose second.expr
                            when tp_life: PlannedTuple
                            {
                                choose tp_life.life
                                    when u: Unspecified
                                        0
                                    else
                                        set call_life: tp_life.life
                                0
                            }
                            else
                                0
                        ; Design-B "default-to-local" flip (NARROWED): an
                        ; un-sigiled heap-returning call defaults to the caller's
                        ; rp, which makes its result outlive the call
                        ; automatically (the inverse of Ralf's intent that rp be
                        ; used only DELIBERATELY via #/^rp). Flip the default to
                        ; THIS function's local page so transient scratch is
                        ; reclaimed at exit; the escape checker then forces a #
                        ; wherever the result actually escapes. ONLY for calls
                        ; whose result genuinely owns guts on the passed page
                        ; (result_owns_page_guts) — borrows/handles (pointer/ref,
                        ; ref[T]?, LLVM* wrappers) point elsewhere, so stamping
                        ; them Local is a false escape (the coarse
                        ; call_requires_page gate alone over-stamps them).
                        if call_requires_page
                        {
                            choose call_life
                                when u: Unspecified
                                    ; A VOID call with requires_page_param is a
                                    ; storage/collector procedure (it builds
                                    ; values onto a caller-provided page, returning
                                    ; nothing) — it must receive the CALLER's rp,
                                    ; never this frame's local page. void has no
                                    ; page-owning RESULT value, so the
                                    ; default-to-local flip below would be a false
                                    ; positive (result_owns_page_guts(void)=true via
                                    ; its fall-through). Leaving call_life
                                    ; Unspecified routes the page arg to
                                    ; lookup_variable("rp") in emit_call. NEUTRAL on
                                    ; the sigiled source: there these are `#`-calls
                                    ; (Call life, not Unspecified), so the flip
                                    ; never fired for them anyway.
                                    if rt.name.equals("void") = false
                                        if Planner.result_owns_page_guts(rt)
                                            set call_life: Lifetime.Local(scalyc.compiler.Model.Local(Span(0, 0)))
                                else
                                    0
                        }
                        ; Design-B step 1 (mirror of stage-0 stampValueResultLifetime):
                        ; a value-returning init# method (requires_page_param)
                        ; produces a value whose internal pointers live on the
                        ; call-site page. Stamp call_life onto the result type so
                        ; the escape checker can see a $-local value escape. The
                        ; emitter reads call.life for page selection, not
                        ; result_type.life, so this is codegen-neutral.
                        if call_requires_page
                        {
                            choose call_life
                                when u: Unspecified
                                    0
                                else
                                    set rt: PlannedType(rt.loc, rt.name, rt.mangled_name, rt.generics, call_life, rt.origin, rt.array_size, rt.variable)
                        }
                        ; Page inference (put/add into an escaping receiver): an
                        ; INLINE construction passed as a put/add VALUE argument
                        ; into a receiver container that escapes (returned or
                        ; stored) must live on the receiver's caller page, not
                        ; this frame's local page — Vector.put/add copies the
                        ; value struct by value, so its heap guts must outlive
                        ; the frame. The bound-local half is the name-graph
                        ; (collect_store_value_locals# marks the receiver, then
                        ; plan_binding# restamps the bound value's init); an
                        ; INLINE ctor (`inner_path.put(0, "Option")`) has
                        ; no binding, so restamp it here at the plan site.
                        ; NEUTRAL on sigiled source: an explicit `#` value
                        ; (Call life) is kept verbatim by restamp_operand_life#.
                        ; Mirrors plan_action#'s set-store inline-ctor restamp
                        ; (499d3312) for the put/add method-call shape.
                        var put_args_ref: ref[Vector[PlannedOperand]]? &call_args_holder
                        var is_putadd false
                        if fn_name.equals("put")
                            set is_putadd: true
                        if fn_name.equals("add")
                            set is_putadd: true
                        if is_putadd
                        {
                            var recv_escapes false
                            choose result.expr
                                when rv: Variable
                                {
                                    if this.array_contains_name(escaping_return_locals, rv.name)
                                        set recv_escapes: true
                                    if this.array_contains_name(escaping_targets, rv.name)
                                        set recv_escapes: true
                                    if this.array_contains_name(promoted_binding_names, rv.name)
                                        set recv_escapes: true
                                    ; Store-escape into a this-FIELD (2026-07-03c): a
                                    ; put/add on a receiver that is a FIELD of `this`
                                    ; (implicit-property shape: Variable("this") +
                                    ; member chain [field..., method]) stores the value
                                    ; struct into storage that outlives this frame, so
                                    ; an inline-constructed value must not live on the
                                    ; local page. Promote to the CALLER page (rp) —
                                    ; exactly what the handwritten `#` asserted at every
                                    ; such site; NOT Page.get(this), which the
                                    ; 2026-07-01c probes proved can never reach the
                                    ; root driver page for a multi-page object. rp is
                                    ; an upper bound, not this's true page: it is
                                    ; sufficient when the object's field reads never
                                    ; outlive the caller chain that threads rp — for
                                    ; the Planner's own bookkeeping arrays this holds
                                    ; by the per-function TRUNCATION invariant (entries
                                    ; are length-truncated per function and re-read
                                    ; only during the same root-driven analysis, and
                                    ; rp = the root driver page outlives all of it).
                                    ; Where it does not hold, rp still strictly
                                    ; dominates the pre-rule Local (a guaranteed
                                    ; dangle). Gated on rp in scope (a page-less
                                    ; function keeps the local page) and on every hop
                                    ; before the method being a plain field access.
                                    ; NEUTRAL on sigiled source: explicit-`#` args
                                    ; carry Call life, which restamp_operand_life#
                                    ; refuses (returns null) → kept verbatim.
                                    if rv.name.equals("this")
                                        if result.member_access <> null
                                        {
                                            let tfm_r result.member_access
                                            let tfm (*tfm_r)
                                            if tfm.length > 1
                                                if this.lookup_local_binding("rp") <> null
                                                {
                                                    var tf_fields_only true
                                                    var tfi: size_t 0
                                                    while tfi < tfm.length - 1
                                                    {
                                                        let tfh tfm.get tfi
                                                        if tfh <> null
                                                            if (*tfh).is_method
                                                                set tf_fields_only: false
                                                        set tfi: tfi + 1
                                                    }
                                                    if tf_fields_only
                                                        set recv_escapes: true
                                                }
                                        }
                                }
                                else
                                    0
                            if recv_escapes
                                if call_args_holder.length > 0
                                {
                                    let putadd_life Lifetime.Call(scalyc.compiler.Model.Call(result.loc))
                                    let restamped this.restamp_putadd_constructions(call_args_holder, putadd_life)
                                    if restamped <> null
                                        set put_args_ref: restamped
                                }
                        }
                        ; Phase-5 class 1 (value-guts persist promotion): the
                        ; resolved callee stores an argument's VALUE into state
                        ; that outlives its frame (this-field putadd of a bare
                        ; param — add_error's `errors.add message`), and at
                        ; least one argument's guts live on THIS frame's local
                        ; page (the resolution site's args_have_local_life gate
                        ; sets persists_args only then). Left alone, the
                        ; persisted shallow copy would read freed memory once
                        ; this frame's page is released — move the argument to
                        ; the caller page, exactly what the handwritten `#`
                        ; asserted at every diag-text call site. Composes with
                        ; the put/add rule above: both stamp Call life, and
                        ; restamp_operand_life# refuses an already-Call operand
                        ; (returns null), so double-firing is idempotent and
                        ; sigiled `#` args stay verbatim. Without rp in scope
                        ; the escape cannot be fixed here — HARD diagnostic
                        ; instead of a silent dangle.
                        if match_ref <> null
                            if (*match_ref).persists_args
                            {
                                if this.persist_receiver_is_frame_local(is_method_dispatch, receiver_op) = false
                                {
                                    if this.lookup_local_binding("rp") <> null
                                    {
                                        if call_args_holder.length > 0
                                        {
                                            let pa_life Lifetime.Call(scalyc.compiler.Model.Call(result.loc))
                                            let pa_restamped this.restamp_putadd_constructions((*put_args_ref), pa_life)
                                            if pa_restamped <> null
                                                set put_args_ref: pa_restamped
                                        }
                                    }
                                    else
                                    {
                                        var pa_sb StringBuilder()
                                        pa_sb.append "argument on the local page is stored beyond the frame by "
                                        pa_sb.append fn_name
                                        pa_sb.append "; no caller page in scope"
                                        this.add_diagnostic(result.loc, pa_sb.to_string())
                                    }
                                }
                            }
                        let call PlannedCall(
                            result.loc,
                            fn_name,
                            mangled,
                            call_is_intrinsic,
                            false,
                            call_can_throw,
                            call_requires_page,
                            put_args_ref,
                            rt,
                            call_life,
                            call_throws_ty,
                            false
                        )
                        set result: PlannedOperand(
                            result.loc,
                            PlannedExpression.Call call,
                            null,
                            rt
                        )

                        ; Chained method calls: a.b().c().d(). The parser
                        ; attaches the NEXT method's member_access to the
                        ; current tuple operand. After the first call is
                        ; built, inspect the consumed tuple for a pending
                        ; method name, resolve against result.result_type,
                        ; and fold in another call if a following Tuple
                        ; supplies args. Repeat until the chain breaks.
                        var prev_tuple: PlannedOperand second
                        var next_idx: size_t 2
                        var keep_chaining: bool true
                        while keep_chaining
                        {
                            set keep_chaining: false
                            if prev_tuple.member_access <> null
                            {
                                let prev_ma (*prev_tuple.member_access)
                                if prev_ma.length > 0
                                {
                                    let last_ptr prev_ma.get(prev_ma.length - 1)
                                    if last_ptr <> null
                                    {
                                        let method_name (*last_ptr).name
                                        if next_idx < ops.length
                                        {
                                            let next_args_ptr ops.get next_idx
                                            if next_args_ptr <> null
                                            {
                                                let next_args (*next_args_ptr)
                                                var is_tuple: bool false
                                                choose next_args.expr
                                                    when tp: PlannedTuple
                                                        set is_tuple: true
                                                    else
                                                        0
                                                if is_tuple
                                                {
                                                    let match_ref this.lookup_method(
                                                        result.result_type, method_name,
                                                        Planner.extract_arg_types(next_args)
                                                    )
                                                    if match_ref <> null
                                                    {
                                                        let m (*match_ref)
                                                        ; s112: build the chained
                                                        ; PlannedCall's args list as
                                                        ; [receiver, ...flattened tuple
                                                        ; components]. Old code passed
                                                        ; [receiver, tuple_operand] —
                                                        ; emit_call then treated the
                                                        ; tuple as a second user arg
                                                        ; and the LLVMBuildCall2 arg
                                                        ; count didn't match the
                                                        ; method's `(this)` arity,
                                                        ; so emit_operand on an empty
                                                        ; Tuple returned null and
                                                        ; the entire outer call
                                                        ; dropped. Mirror the non-
                                                        ; chained call branch at
                                                        ; line ~3815.
                                                        var chained_args_arr Array[PlannedOperand]()
                                                        chained_args_arr.add result
                                                        choose next_args.expr
                                                            when chained_tp: PlannedTuple
                                                            {
                                                                if chained_tp.components <> null
                                                                {
                                                                    let chained_comps (*chained_tp.components)
                                                                    var chained_ci: size_t 0
                                                                    while chained_ci < chained_comps.length
                                                                    {
                                                                        let chained_c_ptr chained_comps.get chained_ci
                                                                        if chained_c_ptr <> null
                                                                        {
                                                                            let chained_c (*chained_c_ptr)
                                                                            if chained_c.value <> null
                                                                            {
                                                                                let chained_v (*chained_c.value)
                                                                                chained_args_arr.add(this.collapse_operand_sequence(chained_v))
                                                                            }
                                                                        }
                                                                        set chained_ci: chained_ci + 1
                                                                    }
                                                                }
                                                            }
                                                            else
                                                                0
                                                        var new_args Vector[PlannedOperand](chained_args_arr)
                                                        let chained this.make_planned_call(
                                                            next_args.loc,
                                                            method_name,
                                                            m.mangled_name,
                                                            m.return_type,
                                                            new_args
                                                        )
                                                        set result: PlannedOperand(
                                                            next_args.loc,
                                                            PlannedExpression.Call chained,
                                                            null,
                                                            m.return_type
                                                        )
                                                        set prev_tuple: next_args
                                                        set next_idx: next_idx + 1
                                                        set keep_chaining: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        ; s175: trailing FIELD access on a call result —
                        ; `LLVMTypeOf(ret_val).handle <> llvm_rt.handle`.
                        ; The chaining loop above only consumes a tuple's
                        ; member_access when its last hop is a method
                        ; followed by an args Tuple; a plain field hop on
                        ; the call result was silently dropped, so the
                        ; operand kept the callee's struct result_type,
                        ; the following binary operator failed to resolve,
                        ; and the whole statement vanished — stage-2's
                        ; prelude print/println implicit return (`if
                        ; LLVMTypeOf(ret_val).handle <> llvm_rt.handle ...
                        ; LLVMBuildRet`) collapsed to `unreachable`.
                        ; Re-resolve the hop names against the call's
                        ; result type and attach the chain, but ONLY when
                        ; every hop resolves as a property — method hops
                        ; (chained calls, parenless methods) keep the
                        ; existing paths unchanged.
                        if prev_tuple.member_access <> null
                        {
                            let tail_ma (*prev_tuple.member_access)
                            if tail_ma.length > 0
                            {
                                var tail_names Vector[String](tail_ma.length)
                                var tni: size_t 0
                                while tni < tail_ma.length
                                {
                                    let tn_ptr tail_ma.get tni
                                    if tn_ptr <> null
                                        tail_names.put(tni, (*tn_ptr).name)
                                    set tni: tni + 1
                                }
                                let tail_chain this.resolve_member_access(result.result_type, tail_names)
                                var all_props: bool false
                                if tail_chain.length > 0
                                    set all_props: true
                                var tci: size_t 0
                                while tci < tail_chain.length
                                {
                                    let tc_ptr tail_chain.get tci
                                    if tc_ptr = null
                                        set all_props: false
                                    if tc_ptr <> null
                                    {
                                        let tc (*tc_ptr)
                                        if tc.is_method
                                            set all_props: false
                                        if tc.result_type.name.equals("void")
                                            set all_props: false
                                    }
                                    set tci: tci + 1
                                }
                                if all_props
                                {
                                    var tail_holder Vector[PlannedMemberAccess](tail_chain)
                                    var tail_final: PlannedType result.result_type
                                    let tl_ptr tail_chain.get(tail_chain.length - 1)
                                    if tl_ptr <> null
                                        set tail_final: (*tl_ptr).result_type
                                    set result: PlannedOperand(
                                        result.loc,
                                        result.expr,
                                        &tail_holder,
                                        tail_final
                                    )
                                }
                            }
                        }

                        ; Splice the remaining ops into a fresh vector
                        ; and recurse.
                        if next_idx < ops.length
                        {
                            var remaining Array[PlannedOperand]()
                            remaining.add result
                            var r: size_t next_idx
                            while r < ops.length
                            {
                                let p_ptr ops.get r
                                if p_ptr <> null
                                    remaining.add((*p_ptr))
                                set r: r + 1
                            }
                            var remaining_vec Vector[PlannedOperand](remaining)
                            return this.collapse_operand_sequence(remaining_vec)
                        }
                        return result
                    }
                }
            }

            ; s176: parenless zero-arg method call as the lhs of a binary
            ; operator (`when_case.name.length > 0`) or before a postfix
            ; `as` (`fr.value.length as int`). The s171 lone-operand path
            ; only fires at ops.length==1 and the call detection above
            ; requires a following Tuple, so this shape reached the binary
            ; loop as a field access — the chain failed to resolve and the
            ; whole statement silently dropped (emit_choose/emit_try
            ; variant-binding guards vanished from stage-2). Synthesize
            ; the empty `()` Tuple and fold result into the zero-arg call
            ; before entering the loop. Mirrors stage-0's
            ; IsZeroArgMethodCall auto-call (Planner.cpp:5117).
            if result.member_access <> null
            {
                let lhs_ma (*result.member_access)
                if lhs_ma.length > 0
                {
                    let lhs_last_ptr lhs_ma.get(lhs_ma.length - 1)
                    if lhs_last_ptr <> null
                    {
                        if (*lhs_last_ptr).is_method
                        {
                            let void_ty_l Planner.make_void_type()
                            let empty_tuple_l PlannedTuple(
                                result.loc,
                                null,
                                void_ty_l,
                                false,
                                Lifetime.Unspecified(Unspecified()),
                                null
                            )
                            let tuple_op_l PlannedOperand(
                                result.loc,
                                PlannedExpression.Tuple empty_tuple_l,
                                null,
                                void_ty_l
                            )
                            var two_arr_l Array[PlannedOperand]()
                            two_arr_l.add result
                            two_arr_l.add tuple_op_l
                            var two_vec_l Vector[PlannedOperand](two_arr_l)
                            set result: this.collapse_operand_sequence(two_vec_l)
                        }
                    }
                }
            }

            var i: size_t 1
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr = null
                {
                    set i: i + 1
                    continue
                }
                let op (*op_ptr)

                ; Postfix `is Type` — stitch the accumulated result in as
                ; the value operand, recompute the variant tag from the
                ; value's union type, and advance by 1.
                var handled_unary: bool false
                choose op.expr
                    when pis: PlannedIs
                    {
                        var value_holder Vector[PlannedOperand](1)
                        value_holder.put(0, result)

                        var new_tag: size_t pis.variant_tag
                        if pis.is_null_check = false
                        {
                            let tag this.lookup_variant_tag(
                                result.result_type.name, pis.test_type.name
                            )
                            if tag >= 0
                                set new_tag: tag as size_t
                        }

                        let stitched PlannedIs(
                            pis.loc,
                            pis.test_type,
                            new_tag,
                            result.result_type.name,
                            value_holder.get 0,
                            pis.is_null_check
                        )
                        set result: PlannedOperand(
                            op.loc,
                            PlannedExpression.Is stitched,
                            null,
                            Planner.make_bool_type()
                        )
                        set handled_unary: true
                    }
                    when pas: PlannedAs
                    {
                        ; s152: compile-time fold `<string literal> as char`
                        ; → CharacterConstant and `as u8` → IntegerConstant
                        ; (first byte). Without this the string literal stays
                        ; a ptr (@.str) and emit_as ptrtoint's the ADDRESS to
                        ; i8 (garbage low byte), so `c = "/" as char` reduces
                        ; to a constant comparison that folds to false — every
                        ; such if in cli/lexer/parser is silently dropped.
                        ; Mirrors stage-0 Planner.cpp:4470-4517.
                        var folded: bool false
                        if pas.target_type.name.equals("char")
                        {
                            choose result.expr
                                when pc: scalyc.compiler.Plan.PlannedConstant
                                {
                                    choose pc.value
                                        when s: StringConstant
                                        {
                                            let cc Constant.Character(CharacterConstant(s.span, s.value))
                                            set result: PlannedOperand(
                                                op.loc,
                                                PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant cc),
                                                null,
                                                pas.target_type
                                            )
                                            set folded: true
                                        }
                                        else
                                            0
                                }
                                else
                                    0
                        }
                        if pas.target_type.name.equals("u8")
                        {
                            if folded = false
                            {
                                choose result.expr
                                    when pc: scalyc.compiler.Plan.PlannedConstant
                                    {
                                        choose pc.value
                                            when s: StringConstant
                                            {
                                                if s.value.get_length() > 0
                                                {
                                                    let bv s.value.get 0
                                                    let ic Constant.Integer(IntegerConstant(s.span, bv as size_t))
                                                    set result: PlannedOperand(
                                                        op.loc,
                                                        PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant ic),
                                                        null,
                                                        pas.target_type
                                                    )
                                                    set folded: true
                                                }
                                            }
                                            else
                                                0
                                    }
                                    else
                                        0
                            }
                        }
                        if folded = false
                        {
                            var value_holder Vector[PlannedOperand](1)
                            value_holder.put(0, result)
                            let stitched PlannedAs(
                                pas.loc,
                                pas.target_type,
                                value_holder.get 0
                            )
                            set result: PlannedOperand(
                                op.loc,
                                PlannedExpression.As stitched,
                                null,
                                pas.target_type
                            )
                        }
                        set handled_unary: true
                    }
                    else
                        0

                if handled_unary
                {
                    set i: i + 1
                    continue
                }

                ; Orphan value operand (missing operator / separator). `op` is a
                ; plain VALUE (not a PlannedType, so not an operator) sitting
                ; where a binary operator is expected, AND `result` so far is a
                ; bare NON-CALLABLE value — a plain local/constant with no method
                ; member-access chain and a non-delegate type. Nothing joins the
                ; two. This is the missing-separator mis-parse `if x g()`: the
                ; condition greedily grabs `x g()`, but `x` (a bare bool) is not
                ; callable, so the trailing call cannot attach and was silently
                ; dropped (the whole `if` degenerated + the next statement was
                ; stolen as the consequent). The gate is deliberately narrow so
                ; a VALID parenless call — `recv.method arg` (result carries a
                ; method chain) or `g arg` where g is delegate-typed — is not
                ; flagged; those attach `op` downstream. Reports instead of
                ; abandoning `op`.
                var op_is_operator: bool false
                choose op.expr
                    when opvty: PlannedType
                    {
                        ; An operator here is recognised the same way the binary
                        ; loop recognises one: a symbolic operator name
                        ; (is_operator_name, char-based), a user-declared
                        ; operator (is_operator, registry — name-operators like
                        ; `mod`/`div`), or a word operator with precedence
                        ; (`and`/`or`, get_operator_precedence > 0). Missing any
                        ; of these mis-flags valid infix uses as orphans.
                        if Planner.is_operator_name(opvty.name)
                            set op_is_operator: true
                        if this.is_operator(opvty.name)
                            set op_is_operator: true
                        if Planner.get_operator_precedence(opvty.name) > 0
                            set op_is_operator: true
                    }
                    else
                        0
                if op_is_operator = false
                {
                    var result_is_bare_noncallable: bool false
                    if result.member_access = null
                    {
                        choose result.expr
                            when rv: Variable
                                set result_is_bare_noncallable: true
                            when rc: scalyc.compiler.Plan.PlannedConstant
                                set result_is_bare_noncallable: true
                            else
                                0
                    }
                    if result_is_bare_noncallable
                        if this.is_delegate_type(result.result_type.name)
                            set result_is_bare_noncallable: false
                    if result_is_bare_noncallable
                    {
                        this.add_diagnostic(op.loc, "unexpected operand - missing operator, or a ':'/newline separator before this statement")
                        return result
                    }
                }

                ; Binary operator: op followed by rhs.
                ; if runs the break when the condition is TRUE (Scaly
                ; semantics, NOT Swift-inverted). Bail out when no rhs is
                ; available.
                if i + 1 >= ops.length
                    break

                let rhs_ptr ops.get(i + 1)
                var consumed_rest: bool false
                var rhs_call_consumed: bool false
                ; When the precedence look-ahead climbs, this records the
                ; operator position the right side stopped at (the precedence
                ; boundary). ops.length means it ran to the end. Read after the
                ; call is built to either break (boundary = end) or continue the
                ; outer loop from the boundary.
                var climb_to: size_t 0
                if rhs_ptr <> null
                {
                    var rhs: PlannedOperand (*rhs_ptr)

                    ; Extract operator name from the op operand.
                    let op_name choose op.expr
                        when ty: PlannedType
                            ty.name
                        else
                            ""

                    ; s189: rhs is itself a prefix operator (`x & ~y`,
                    ; `b.bitmap & ~((1 as u64) << slot)`). Grab the prefix
                    ; operator plus its single following operand and collapse
                    ; them into one operand so the binary op sees `~y`, not a
                    ; bare `~`. Without this the prefix RHS dropped and the
                    ; whole `&`/`|` expression vanished (stack_bucket_of's
                    ; `& ~BUCKET_MASK`, scaly_alloc_page's bitmap clear).
                    ; Advances i by 3 via rhs_call_consumed (op, ~, operand).
                    if i + 2 < ops.length
                    {
                        var rhs_is_prefix: bool false
                        choose rhs.expr
                            when rpty: PlannedType
                            {
                                if Planner.is_operator_name(rpty.name)
                                    set rhs_is_prefix: true
                            }
                            else
                                0
                        if rhs_is_prefix
                        {
                            let pfx_operand_ptr ops.get(i + 2)
                            if pfx_operand_ptr <> null
                            {
                                var pfx_arr Array[PlannedOperand]()
                                pfx_arr.add rhs
                                pfx_arr.add((*pfx_operand_ptr))
                                var pfx_vec Vector[PlannedOperand](pfx_arr)
                                set rhs: this.collapse_operand_sequence(pfx_vec)
                                set rhs_call_consumed: true
                            }
                        }
                    }

                    ; If rhs is a non-operator Type immediately followed by
                    ; a Tuple, treat it as an ungrouped call (`A | f()` →
                    ; rhs = Call(f), not Type(f)). Stage-0's planOperands
                    ; pre-processes this in scalyc/Planner.cpp:7359+ before
                    ; collapseOperandSequence runs; stage-1's plan_operands
                    ; is a flat per-operand pass, so we fold here. Without
                    ; this, `f1() | f2()` builds Call(|, [Call(f1),
                    ; Type(f2)]) and drops the trailing `()`, then the
                    ; entire `if cond { ... }` collapses because emit_call
                    ; on Type(f2) returns null and the binary call is
                    ; rejected upstream — observed in cli.parse_args's
                    ; chained-if branches.
                    if i + 2 < ops.length
                    {
                        var rhs_callable: bool false
                        choose rhs.expr
                            when rty: PlannedType
                            {
                                if Planner.is_operator_name(rty.name) = false
                                    set rhs_callable: true
                            }
                            else
                                0

                        ; s174: rhs with a member-access chain ending in a
                        ; method hop is callable too (`i < path.get_length()`).
                        ; Without this the Tuple after rhs is never consumed,
                        ; the chain plans as a field access (extractvalue),
                        ; and the comparison + branch drop — every
                        ; `while i < x.method()` loop became dead code in
                        ; stage-2 (extract_program_name, prelude path build).
                        if rhs_callable = false
                        {
                            if rhs.member_access <> null
                            {
                                let rma (*rhs.member_access)
                                if rma.length > 0
                                {
                                    let rlast_ptr rma.get(rma.length - 1)
                                    if rlast_ptr <> null
                                    {
                                        if (*rlast_ptr).is_method
                                            set rhs_callable: true
                                    }
                                }
                            }
                        }

                        if rhs_callable
                        {
                            let after_ptr ops.get(i + 2)
                            if after_ptr <> null
                            {
                                let after_op (*after_ptr)
                                var is_tuple_after: bool false
                                choose after_op.expr
                                    when tp_after: PlannedTuple
                                        set is_tuple_after: true
                                    else
                                        0
                                if is_tuple_after
                                {
                                    var sub_arr Array[PlannedOperand]()
                                    sub_arr.add rhs
                                    sub_arr.add after_op
                                    var sub_vec Vector[PlannedOperand](sub_arr)
                                    set rhs: this.collapse_operand_sequence(sub_vec)
                                    set rhs_call_consumed: true
                                }
                            }
                        }
                    }

                    ; rhs followed by an `as` cast: the postfix `as` binds
                    ; tighter than a binary operator, so fold [rhs, As] into
                    ; rhs first. Without this, `x = "/" as char` builds
                    ; (x = "/") and casts the whole comparison — the
                    ; string→char fold in the PlannedAs arm never sees the
                    ; string and the comparison degenerates to a constant.
                    ; Collapsing [rhs, As] lets that fold fire on the rhs.
                    if rhs_call_consumed = false
                    {
                        if i + 2 < ops.length
                        {
                            let as_ptr ops.get(i + 2)
                            if as_ptr <> null
                            {
                                let as_op (*as_ptr)
                                var is_as_after: bool false
                                choose as_op.expr
                                    when pa_after: PlannedAs
                                        set is_as_after: true
                                    else
                                        0
                                if is_as_after
                                {
                                    var as_arr Array[PlannedOperand]()
                                    as_arr.add rhs
                                    as_arr.add as_op
                                    var as_vec Vector[PlannedOperand](as_arr)
                                    set rhs: this.collapse_operand_sequence(as_vec)
                                    set rhs_call_consumed: true
                                }
                            }
                        }
                    }

                    ; s176: parenless zero-arg method call as the rhs
                    ; (`0 < x.name.length`). The Tuple-fold above only
                    ; fires when ops[i+2] is a Tuple; with no Tuple the
                    ; chain stayed a field access and the comparison
                    ; dropped. Fold rhs into the zero-arg call via the
                    ; same empty-Tuple synthesis. Consumes NO extra
                    ; operand, so rhs_call_consumed stays false (the
                    ; precedence look-ahead below keeps using i+2).
                    if rhs_call_consumed = false
                    {
                        if rhs.member_access <> null
                        {
                            let pma (*rhs.member_access)
                            if pma.length > 0
                            {
                                let plast_ptr pma.get(pma.length - 1)
                                if plast_ptr <> null
                                {
                                    if (*plast_ptr).is_method
                                    {
                                        let void_ty_r Planner.make_void_type()
                                        let empty_tuple_r PlannedTuple(
                                            rhs.loc,
                                            null,
                                            void_ty_r,
                                            false,
                                            Lifetime.Unspecified(Unspecified()),
                                            null
                                        )
                                        let tuple_op_r PlannedOperand(
                                            rhs.loc,
                                            PlannedExpression.Tuple empty_tuple_r,
                                            null,
                                            void_ty_r
                                        )
                                        var two_arr_r Array[PlannedOperand]()
                                        two_arr_r.add rhs
                                        two_arr_r.add tuple_op_r
                                        var two_vec_r Vector[PlannedOperand](two_arr_r)
                                        set rhs: this.collapse_operand_sequence(two_vec_r)
                                    }
                                }
                            }
                        }
                    }

                    ; Precedence look-ahead. If ops[i+2] is an operator with
                    ; HIGHER precedence than op_name, recursively collapse
                    ; [rhs, ops[i+2], ops[i+3], ...] first so the binary
                    ; call uses the precedence-correct right side. Without
                    ; this, the left-associative fold turns
                    ; `A <> X & B <> Y` into `((A <> X) & B) <> Y` rather
                    ; than `(A <> X) & (B <> Y)`. Mirrors
                    ; Planner.cpp:4298-4322. Sets consumed_rest so the outer
                    ; loop breaks after this iteration since the entire
                    ; right side has been folded into rhs.
                    ; s175: when the rhs call-fold (or as-fold) above
                    ; consumed ops[i+2], the next operator sits at i+3 —
                    ; checking i+2 saw the consumed Tuple, never an
                    ; operator, so `starts_with(p) & len() > 2` left-
                    ; folded to `(bool & len) > 2` = `1 > 2` = false and
                    ; stage-2's parse_args rejected every -L/-l arg as
                    ; "Unknown option".
                    var prec_next: size_t i + 2
                    if rhs_call_consumed
                        set prec_next: i + 3
                    ; A text-named (non-operator-char) declared operator binds
                    ; weakest — precedence 1, like ||. Gated on NOT
                    ; is_operator_name so opchar operators (incl. source `==`
                    ; / `[]`, deliberately left at their table/0 precedence)
                    ; are unaffected — fixpoint-safe. The source has no
                    ; text-named operators, so this never fires during
                    ; self-compile.
                    var current_prec Planner.get_operator_precedence(op_name)
                    if current_prec = 0
                        if Planner.is_operator_name(op_name) = false
                            if this.is_operator(op_name)
                                set current_prec: 1
                    if current_prec > 0
                    {
                        if prec_next < ops.length
                        {
                            let next_op_ptr ops.get prec_next
                            if next_op_ptr <> null
                            {
                                let next_op (*next_op_ptr)
                                choose next_op.expr
                                    when nty: PlannedType
                                    {
                                        var next_is_op: bool false
                                        if Planner.is_operator_name(nty.name)
                                            set next_is_op: true
                                        if Planner.is_operator_name(nty.name) = false
                                            if this.is_operator(nty.name)
                                                set next_is_op: true
                                        if next_is_op
                                        {
                                            var next_prec Planner.get_operator_precedence(nty.name)
                                            if next_prec = 0
                                                if Planner.is_operator_name(nty.name) = false
                                                    if this.is_operator(nty.name)
                                                        set next_prec: 1
                                            if next_prec > current_prec
                                            {
                                                ; Bound the right-side collapse to
                                                ; the precedence boundary — the
                                                ; first LATER operator whose
                                                ; precedence is <= current_prec.
                                                ; Collapsing to the end would
                                                ; swallow a following lower-prec
                                                ; operator: `a = 0 - 5 && b`
                                                ; (`=`6, `-`9, `&&`2) must stop the
                                                ; `=` right side at `&&`, giving
                                                ; `(a = (0-5)) && b`, not
                                                ; `a = ((0-5) && b)`. Operators sit
                                                ; every 2 positions from prec_next.
                                                var climb_b: size_t ops.length
                                                var bnd: size_t prec_next
                                                var found_b: bool false
                                                while found_b = false
                                                {
                                                    if bnd >= ops.length
                                                        set found_b: true
                                                    else
                                                    {
                                                        let bp ops.get bnd
                                                        var bnd_prec: int 0
                                                        if bp <> null
                                                            choose (*bp).expr
                                                                when bty: PlannedType
                                                                {
                                                                    set bnd_prec: Planner.get_operator_precedence(bty.name)
                                                                    if bnd_prec = 0
                                                                        if Planner.is_operator_name(bty.name) = false
                                                                            if this.is_operator(bty.name)
                                                                                set bnd_prec: 1
                                                                }
                                                                else
                                                                    0
                                                        var is_b: bool false
                                                        if bnd_prec > 0
                                                            if bnd_prec <= current_prec
                                                                set is_b: true
                                                        if is_b
                                                        {
                                                            set climb_b: bnd
                                                            set found_b: true
                                                        }
                                                        else
                                                            set bnd: bnd + 2
                                                    }
                                                }
                                                var right_arr Array[PlannedOperand]()
                                                right_arr.add rhs
                                                var rr: size_t prec_next
                                                while rr < climb_b
                                                {
                                                    let p_ptr ops.get rr
                                                    if p_ptr <> null
                                                        right_arr.add((*p_ptr))
                                                    set rr: rr + 1
                                                }
                                                var right_vec Vector[PlannedOperand](right_arr)
                                                set rhs: this.collapse_operand_sequence(right_vec)
                                                set consumed_rest: true
                                                set climb_to: climb_b
                                            }
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    let resolved this.resolve_operator_call(
                        op_name, result.result_type, rhs.result_type
                    )

                    ; Member binary operator dispatch (A3a): a user-defined
                    ; operator declared INSIDE a (possibly generic) concept —
                    ; e.g. `Pair[T]`'s `operator ==` — is not in the top-level
                    ; operator registry, so resolve_operator_call# above missed
                    ; it. Left untreated the call falls through to the intrinsic
                    ; path and the emitter silently drops it (the documented
                    ; generic-concept operator-dispatch gap). Mirror the
                    ; subscript pre-pass: find the member operator on the
                    ; receiver concept, record it as a dispatchable function,
                    ; and build a NON-intrinsic call. Gated to a non-primitive,
                    ; non-generic-param receiver so primitive arithmetic and
                    ; comparison keep their intrinsic fast path (fixpoint-safe:
                    ; the compiler source declares member operators only on the
                    ; non-generic String, whose call sites already dispatch).
                    if resolved = null
                    {
                        ; PlannedType.name is already a joined string (unlike
                        ; Model.Type.name's Vector[String]) — no join needed.
                        let lop_name result.result_type.name
                        if Planner.is_primitive_type_name(lop_name) = false
                        {
                            if Planner.is_generic_type_param_name(lop_name) = false
                            {
                                let mop_ref this.find_member_operator(result.result_type, op_name, result.loc)
                                if mop_ref <> null
                                {
                                    let m (*mop_ref)
                                    this.ensure_type_layout(result.result_type)
                                    this.ensure_type_layout(m.return_type)
                                    var mop_args Vector[PlannedOperand](2)
                                    mop_args.put(0, result)
                                    mop_args.put(1, rhs)
                                    let mop_call PlannedCall(
                                        result.loc,
                                        String(op_name),
                                        m.mangled_name,
                                        false,
                                        true,
                                        m.can_throw,
                                        m.requires_page_param,
                                        &mop_args,
                                        m.return_type,
                                        Lifetime.Unspecified(Unspecified()),
                                        m.throws_type,
                                        false
                                    )
                                    set result: PlannedOperand(
                                        result.loc,
                                        PlannedExpression.Call mop_call,
                                        null,
                                        m.return_type
                                    )
                                    if consumed_rest
                                    {
                                        if climb_to >= ops.length
                                            break
                                        set i: climb_to
                                        continue
                                    }
                                    if rhs_call_consumed
                                    {
                                        set i: i + 3
                                        continue
                                    }
                                    set i: i + 2
                                    continue
                                }
                            }
                        }
                    }

                    var combined_type: PlannedType this.fresh_type_var("")
                    if resolved <> null
                        set combined_type: (*resolved)

                    ; Pointer arithmetic fallback: pointer[T] +/- integer
                    ; resolves to pointer[T]. resolve_operator_call# only
                    ; sees registered operators, so primitive ptr-arith
                    ; falls through with a fresh type var — emit_intrinsic
                    ; _binary_op then has no element type to derive and the
                    ; GEP fallback uses i8 (byte stride). Mirrors
                    ; Planner.cpp:3135-3155 (findOperator's IsPointerType +
                    ; IsIntegerType branch) — result type = LHS pointer type.
                    if resolved = null
                    {
                        if result.result_type.name.equals("pointer")
                        {
                            if Planner.is_integer_type(rhs.result_type.name)
                            {
                                if op_name.equals("+")
                                    set combined_type: result.result_type
                                if op_name.equals("-")
                                    set combined_type: result.result_type
                            }
                        }

                        ; s90: built-in comparison operators on primitive
                        ; types return bool. Without this, the fresh type
                        ; var from above leaks into upstream arg_types,
                        ; resolve_function_call# then arity-matches but
                        ; type-mismatches against the formal `bool` parameter
                        ; (fresh-name "" vs "bool"), match_ref stays null,
                        ; mangled="", and `let X f(a, p = q)` silently drops.
                        ; Mirrors Planner.cpp's findOperator returning bool
                        ; for primitive comparison.
                        if op_name.equals("=")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("<>")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("<")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals(">")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("<=")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals(">=")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("&&")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("||")
                            set combined_type: Planner.make_bool_type()
                        ; Word-operator synonyms for &&/|| — also yield bool.
                        if op_name.equals("and")
                            set combined_type: Planner.make_bool_type()
                        if op_name.equals("or")
                            set combined_type: Planner.make_bool_type()

                        ; s101: built-in arithmetic / bitwise operators on
                        ; primitive integer types return the left operand's
                        ; type. Without this, `n - 1` (and any int op)
                        ; resolves to a fresh type var (empty name) — which
                        ; then leaks into resolve_function_call#'s arg_types,
                        ; arity matches but type comparison fails against
                        ; the formal `int` parameter, match_ref stays null,
                        ; mangled="", and the entire surrounding call
                        ; silently drops. Mirrors stage-0 Planner.cpp:
                        ; findOperator's primitive arithmetic passthrough
                        ; at lines 3073-3112.
                        if Planner.is_integer_type(result.result_type.name)
                        {
                            if Planner.is_integer_type(rhs.result_type.name)
                            {
                                if op_name.equals("+")
                                    set combined_type: result.result_type
                                if op_name.equals("-")
                                    set combined_type: result.result_type
                                if op_name.equals("*")
                                    set combined_type: result.result_type
                                if op_name.equals("/")
                                    set combined_type: result.result_type
                                if op_name.equals("%")
                                    set combined_type: result.result_type
                                if op_name.equals("div")
                                    set combined_type: result.result_type
                                if op_name.equals("mod")
                                    set combined_type: result.result_type
                                if op_name.equals("&")
                                    set combined_type: result.result_type
                                if op_name.equals("|")
                                    set combined_type: result.result_type
                                if op_name.equals("^")
                                    set combined_type: result.result_type
                                if op_name.equals("<<")
                                    set combined_type: result.result_type
                                if op_name.equals(">>")
                                    set combined_type: result.result_type
                            }
                        }
                    }

                    var two_args Vector[PlannedOperand](2)
                    two_args.put(0, result)
                    two_args.put(1, rhs)
                    var two_args_holder Vector[PlannedOperand](two_args)
                    ; Built-in binary operators on primitive types are
                    ; intrinsic (Planner.cpp:4378-4379). A user-defined
                    ; operator (resolve returned non-null AND its impl is not
                    ; Intrinsic) is NOT intrinsic — emit_call then emits a real
                    ; call to its mangled function. resolved=null keeps the
                    ; primitive-fallback intrinsic=true. Mirrors stage-0
                    ; Call.IsIntrinsic = OpMatch->IsIntrinsic (Planner.cpp:4470).
                    var bin_is_intrinsic: bool true
                    if resolved <> null
                        set bin_is_intrinsic: this.resolved_op_is_intrinsic
                    let call PlannedCall(
                        result.loc,
                        op_name,
                        this.mangle_binary_operator(op_name, result.result_type, rhs.result_type),
                        bin_is_intrinsic,
                        true,
                        false,
                        false,
                        &two_args_holder,
                        combined_type,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        false
                    )
                    set result: PlannedOperand(
                        result.loc,
                        PlannedExpression.Call call,
                        null,
                        combined_type
                    )
                }
                if consumed_rest
                {
                    ; Whole tail folded into rhs (boundary = end): done.
                    ; Otherwise the bounded climb stopped at a lower-precedence
                    ; operator — continue the outer loop from that boundary with
                    ; the just-built call as the new left side.
                    if climb_to >= ops.length
                        break
                    set i: climb_to
                    continue
                }
                if rhs_call_consumed
                {
                    set i: i + 3
                    continue
                }
                set i: i + 2
            }

            result
        }

        ; check_operator_match: test a single Operator candidate against
        ; argument types. Same shape as check_function_match.
        function check_operator_match(
            this: Planner,
            o: Operator,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns ref[PlannedType]?
        {
            var param_start: size_t 0
            if o.input.length > 0
            {
                let first_ptr o.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
                }
            }

            let expected_arity o.input.length - param_start
            if expected_arity <> arg_types.length
                return null

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr o.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return null
                if a_ptr = null
                    return null
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return null
                }
                set j: j + 1
            }

            if o.returns_ <> null
            {
                let rt (*o.returns_)
                return &^this this.plan_type(rt)
            }
            &^this Planner.make_void_type()
        }

        ; resolve_prefix_operator_call: for unary prefix operators like
        ; `-x` or `!flag`. Two-pass: exact matches first, then compatible.
        ; True iff an operator's implementation is Intrinsic (built-in
        ; primitive op, emitted inline by emit_intrinsic_*_op). A user-defined
        ; operator carries an Action body and must be emitted/called as a real
        ; function. Mirrors stage-0's holds_alternative<IntrinsicImpl>(Op->Impl).
        function operator_is_intrinsic(o: Operator) returns bool
        {
            var r: bool false
            choose o.implementation
                when oi: Intrinsic
                    set r: true
                else
                    0
            r
        }

        function resolve_prefix_operator_call(
            this: Planner,
            name: String,
            operand: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators(name)
            if candidates.length = 0
                return null

            var arg_types Vector[PlannedType](1)
            arg_types.put(0, operand)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get i
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match(o, arg_types, true)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get k
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match(o, arg_types, false)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set k: k + 1
            }
            null
        }

        ; resolve_operator_call: two-pass overload resolution for binary
        ; operators keyed on the operator symbol registry.
        function resolve_operator_call(
            this: Planner,
            name: String,
            left: PlannedType,
            right: PlannedType
        ) returns ref[PlannedType]?
        {
            let candidates this.lookup_operators(name)
            if candidates.length = 0
                return null

            var arg_types Vector[PlannedType](2)
            arg_types.put(0, left)
            arg_types.put(1, right)

            ; Pass 1: exact.
            var i: size_t 0
            while i < candidates.length
            {
                let o_ptr candidates.get i
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match(o, arg_types, true)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set i: i + 1
            }

            ; Pass 2: compatible (widened).
            var k: size_t 0
            while k < candidates.length
            {
                let o_ptr candidates.get k
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    let rt this.check_operator_match(o, arg_types, false)
                    if rt <> null
                    {
                        set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                        return rt
                    }
                }
                set k: k + 1
            }

            ; Pass 3: generic operator. Plan parameter types, infer
            ; generic bindings against arg_types, seed type_substitutions
            ; and plan the operator's declared return type under those
            ; bindings.
            var g: size_t 0
            while g < candidates.length
            {
                let o_ptr candidates.get g
                if o_ptr <> null
                {
                    let o (*o_ptr)
                    if o.parameters.length > 0
                    {
                        var param_start2: size_t 0
                        if o.input.length > 0
                        {
                            let fi0 o.input.get 0
                            if fi0 <> null
                            {
                                if fi0.name <> null
                                {
                                    let fname (*fi0.name)
                                    if fname.equals("this")
                                        set param_start2: 1
                                }
                            }
                        }

                        let expected_arity o.input.length - param_start2
                        if expected_arity = arg_types.length
                        {
                            var param_types_arr Array[PlannedType]()
                            var pi: size_t param_start2
                            while pi < o.input.length
                            {
                                let p_ptr o.input.get pi
                                if p_ptr <> null
                                {
                                    if p_ptr.type <> null
                                    {
                                        let pt (*p_ptr.type)
                                        param_types_arr.add(this.plan_type(pt))
                                    }
                                }
                                set pi: pi + 1
                            }
                            var param_types_vec Vector[PlannedType](param_types_arr)

                            let bindings this.infer_type_arguments(
                                param_types_vec, arg_types
                            )
                            if bindings.length >= o.parameters.length
                            {
                                let saved_len type_substitutions.length
                                var bi: size_t 0
                                while bi < bindings.length
                                {
                                    let kv_ptr bindings.get bi
                                    if kv_ptr <> null
                                        this.define_type_substitution(
                                            kv_ptr.key, kv_ptr.value
                                        )
                                    set bi: bi + 1
                                }

                                ; Let-bound box: plan_type must run BEFORE the
                                ; type_substitutions restore (it resolves the
                                ; return type against the active substitutions),
                                ; so the box can't be inlined into the return.
                                ; The box's call-result promotion routes plan_
                                ; type's guts to ^this; local_box_names records r
                                ; so region_of_operand# accepts `return r` past
                                ; the intervening restore.
                                if o.returns_ <> null
                                {
                                    let rt_model (*o.returns_)
                                    let r &^this this.plan_type(rt_model)
                                    set type_substitutions.length: saved_len
                                    set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                                    return r
                                }
                                set type_substitutions.length: saved_len
                                set this.resolved_op_is_intrinsic: Planner.operator_is_intrinsic(o)
                                return &^this Planner.make_void_type()
                            }
                        }
                    }
                }
                set g: g + 1
            }

            null
        }

        ; mangle_method: build `_ZN<parent>methodEparam*` without the
        ; PlannedItem ceremony that mangle_function requires. Just takes
        ; a parent PlannedType and a Vector of param PlannedTypes.
        function mangle_method(
            this: Planner,
            method_name: String,
            parent: PlannedType,
            params: Vector[PlannedType],
            has_page_param: bool
        ) returns String
        {
            var sb StringBuilder()
            sb.append "_ZN"
            sb.append(Planner.encode_type(parent))
            sb.append(Planner.encode_name method_name)
            sb.append "E"

            ; Implicit page parameter for `function foo#(...)` methods —
            ; matches mangle_function's handling of has_page_param.
            var has_explicit: bool false
            if has_page_param
            {
                sb.append "PN4scaly6memory4PageE"
                set has_explicit: true
            }

            if params.length = 0
            {
                if has_explicit = false
                    sb.append "v"
                return sb.to_string()
            }

            var i: size_t 0
            while i < params.length
            {
                let p_ptr params.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    sb.append(Planner.encode_type(p))
                }
                set i: i + 1
            }

            sb.to_string()
        }

        ; method_params_match: does method `f`'s declared parameter list
        ; (after skipping a leading `this`) match `arg_types`? Mirrors the
        ; per-arg comparison in check_function_match#, but returns only a
        ; bool so lookup_method# can pick the right overload among several
        ; same-named methods. `exact_only` selects types_equal (pass 1) vs
        ; types_compatible (pass 2).
        function method_params_match(
            this: Planner,
            f: Function,
            arg_types: Vector[PlannedType],
            exact_only: bool
        ) returns bool
        {
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
                }
            }

            let expected_arity f.input.length - param_start
            if expected_arity <> arg_types.length
                return false

            var j: size_t 0
            while j < arg_types.length
            {
                let p_ptr f.input.get(j + param_start)
                let a_ptr arg_types.get j
                if p_ptr = null
                    return false
                if a_ptr = null
                    return false
                if p_ptr.type <> null
                {
                    let p_type (*p_ptr.type)
                    let planned_p this.plan_type(p_type)
                    let arg (*a_ptr)
                    var ok: bool false
                    if exact_only
                        set ok: Planner.types_equal(planned_p, arg)
                    if exact_only = false
                        set ok: Planner.types_compatible(planned_p, arg)
                    if ok = false
                        return false
                }
                set j: j + 1
            }
            true
        }

        ; lookup_method: more-detailed method lookup that returns a
        ; MethodMatch with mangled name, return type, and parameter
        ; types pre-computed. The `method` field of MethodMatch points
        ; at a PlannedFunction — we leave it null for now; wiring it up
        ; requires caching planned methods per struct, which we don't
        ; do yet.
        function lookup_method(
            this: Planner,
            struct_type: PlannedType,
            method_name: String,
            arg_types: Vector[PlannedType]
        ) returns ref[MethodMatch]?
        {
            ; s106: auto-deref pointer[T] / ref[T] before lookup. Mirrors
            ; getInnerTypeIfPointerLike at Planner.cpp:1441. Without this,
            ; method dispatch on a pointer-typed local (e.g. init#'s
            ; implicit `page: pointer[scaly.memory.Page]`) silently fails
            ; because lookup walks the outer "pointer" name.
            var lookup_st: PlannedType struct_type
            if struct_type.name.equals("pointer")
            {
                if struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            if struct_type.name.equals("ref")
            {
                if struct_type.generics <> null
                {
                    let gens (*struct_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            ; s172: Option[ref[T]] / Option[pointer[T]] unwrap — mirrors
            ; stage-0 lookupMethod's Option fallback (Planner.cpp:1730-
            ; 1737). Method calls through nullable ref fields
            ; (`names.add(n)` where names: ref[Vector[String]]?) carry
            ; parent_type Option[ref[Vector[String]]]; without the
            ; unwrap, lookup walks "Option", finds nothing, and the s83
            ; dispatch drops the whole call. Option's own methods are
            ; exempt so NPO unwrap dispatch keeps resolving.
            var mn_is_opt: bool false
            if method_name.equals("unwrap")
                set mn_is_opt: true
            if method_name.equals("unwrap_or")
                set mn_is_opt: true
            if method_name.equals("is_some")
                set mn_is_opt: true
            if method_name.equals("is_none")
                set mn_is_opt: true
            if mn_is_opt = false
            {
                if lookup_st.name.equals("Option")
                {
                    if lookup_st.generics <> null
                    {
                        let ogens (*lookup_st.generics)
                        if ogens.length > 0
                        {
                            let og_ptr ogens.get 0
                            if og_ptr <> null
                            {
                                var inner_o (*og_ptr)
                                if inner_o.name.equals("ref")
                                {
                                    if inner_o.generics <> null
                                    {
                                        let igens (*inner_o.generics)
                                        if igens.length > 0
                                        {
                                            let iip igens.get 0
                                            if iip <> null
                                                set inner_o: (*iip)
                                        }
                                    }
                                }
                                if inner_o.name.equals("pointer")
                                {
                                    if inner_o.generics <> null
                                    {
                                        let pgens (*inner_o.generics)
                                        if pgens.length > 0
                                        {
                                            let pip pgens.get 0
                                            if pip <> null
                                                set inner_o: (*pip)
                                        }
                                    }
                                }
                                set lookup_st: inner_o
                            }
                        }
                    }
                }
            }
            let candidates this.lookup_methods(lookup_st.name, method_name)
            if candidates.length = 0
                return null

            ; s163: arg-type-aware overload selection. When a struct has
            ; several same-named methods (e.g. String.equals(String) /
            ; equals(pointer[const_char]) / equals(Vector[char])), pick the
            ; overload whose declared parameter types match the call's
            ; argument types — two passes (exact via types_equal, then
            ; compatible) mirroring resolve_function_call#. Without this,
            ; `joined.equals("pointer")` (arg pointer[const_char]) always
            ; resolved to equals(String)[0], mangled _ZN6String6equalsE6String,
            ; and a raw char* was passed where a String is expected →
            ; get_length deref'd the literal bytes → SIGSEGV in
            ; resolve_type_base#. A single candidate, or no arg-type match,
            ; falls back to the first by-name candidate (prior behaviour).
            var f_ptr: ref[Function]? candidates.get(0)
            if candidates.length > 1
            {
                let saved_subst_sel type_substitutions.length
                ; Bind the receiver concept's generic parameters to the
                ; concrete generics of lookup_st before matching, so a
                ; candidate's declared `T` param plans to the concrete
                ; type (e.g. Array[char].add: T→char). Without this,
                ; method_params_match# plans `plan_type(T)` as an
                ; unbound type var that types_equal() treats as matching
                ; anything, so `buffer.add(Vector[char](...))` resolved
                ; to add(item: T) [= add(char)] instead of
                ; add(items: Vector[T]) — the Vector pointer was passed
                ; where an i8 was expected (s190). Stage-0 sidesteps this
                ; by collecting candidates from the already-instantiated
                ; structure's monomorphised methods.
                if lookup_st.generics <> null
                {
                    let mm_conc this.lookup_concept(lookup_st.name)
                    if mm_conc <> null
                    {
                        let mm_c (*mm_conc)
                        let mm_gens (*lookup_st.generics)
                        var mm_pi: size_t 0
                        while mm_pi < mm_c.parameters.length
                        {
                            if mm_pi < mm_gens.length
                            {
                                let mm_p mm_c.parameters.get mm_pi
                                let mm_a mm_gens.get mm_pi
                                if mm_p <> null
                                {
                                    if mm_a <> null
                                        this.define_type_substitution(mm_p.name, (*mm_a))
                                }
                            }
                            set mm_pi: mm_pi + 1
                        }
                    }
                }
                var chosen: ref[Function]? null
                var ci: size_t 0
                while ci < candidates.length
                {
                    if chosen = null
                    {
                        let c_ptr candidates.get ci
                        if c_ptr <> null
                        {
                            if this.method_params_match((*c_ptr), arg_types, true)
                                set chosen: c_ptr
                        }
                    }
                    set ci: ci + 1
                }
                if chosen = null
                {
                    var ck: size_t 0
                    while ck < candidates.length
                    {
                        if chosen = null
                        {
                            let c_ptr candidates.get ck
                            if c_ptr <> null
                            {
                                if this.method_params_match((*c_ptr), arg_types, false)
                                    set chosen: c_ptr
                            }
                        }
                        set ck: ck + 1
                    }
                }
                set type_substitutions.length: saved_subst_sel
                if chosen <> null
                    set f_ptr: chosen
            }
            if f_ptr = null
                return null
            let f (*f_ptr)

            ; ── s188: lazy full instantiation of a HashSet-machinery generic
            ; concept reached via a method CALL rather than a type annotation.
            ; plan_type#'s instantiate_generic# only fires for generic types
            ; written as annotations; methods called transitively from another
            ; generic's body (BuilderList<Slot<String>>::add from
            ; HashSetBuilder::add_internal, the Vector<BuilderList<…>> bucket
            ; ops, the iterator next() chain) are reached only as calls, so
            ; their owning structure was never instantiated — declared, never
            ; defined → undefined at seed link. Instantiate the WHOLE structure
            ; here (layout + ctor + ALL methods, consistent — a per-method hook
            ; is wrong: it makes the method real while the ctor stays a stub →
            ; null-field deref) the first time any method resolves.
            ; instantiate_generic# self-dedups (has_instantiated_structure) and
            ; self-guards cycles; its bodies resolve further machinery calls →
            ; recursion to fixed point. GATED to the data-structure plumbing
            ; HashSet<String> needs: firing for every generic concept also
            ; makes HashMap/HashMapBuilder<String,Nameable> (Modeler symbol
            ; table) real, which activates a latent-broken reallocate→page
            ; path the baseline masks with a no-op stub (runtime SIGSEGV).
            ; Ambient substitutions are cleared first: instantiate_generic#
            ; binds the concept params to the explicit concrete args, and a
            ; same-named ambient binding would win under first-wins lookup.
            var s188_lazy_fire Planner.is_lazy_machinery_generic(lookup_st.name)
            if s188_lazy_fire = false
                set s188_lazy_fire: Planner.is_lazy_real_union(lookup_st.name, lookup_st.generics)
            if s188_lazy_fire
            {
                if lookup_st.generics <> null
                {
                    let li_gens (*lookup_st.generics)
                    if li_gens.length > 0
                    {
                        let li_smangled Planner.mangle_structure(lookup_st.name, lookup_st.generics)
                        var li_need: bool true
                        if this.has_instantiated_structure(li_smangled)
                            set li_need: false
                        if li_need
                            if this.has_instantiated_union(li_smangled)
                                set li_need: false
                        var li_ip: size_t 0
                        while li_ip < instantiating_methods.length
                        {
                            let li_mp instantiating_methods.get li_ip
                            if li_mp <> null
                                if li_mp.equals(li_smangled)
                                    set li_need: false
                            set li_ip: li_ip + 1
                        }
                        if li_need
                        {
                            let li_conc this.lookup_concept(lookup_st.name)
                            if li_conc <> null
                            {
                                if (*li_conc).parameters.length > 0
                                {
                                    instantiating_methods.add li_smangled
                                    var li_args_holder Vector[PlannedType](li_gens)
                                    var li_snap Array[KeyValuePair[String, PlannedType]]()
                                    var li_si: size_t 0
                                    while li_si < type_substitutions.length
                                    {
                                        let li_sp type_substitutions.get li_si
                                        if li_sp <> null
                                            li_snap.add((*li_sp))
                                        set li_si: li_si + 1
                                    }
                                    set type_substitutions.length: 0
                                    let li_pt this.instantiate_generic(lookup_st.name, li_args_holder, lookup_st.loc)
                                    set type_substitutions.length: 0
                                    var li_ri: size_t 0
                                    while li_ri < li_snap.length
                                    {
                                        let li_rp li_snap.get li_ri
                                        if li_rp <> null
                                            type_substitutions.add((*li_rp))
                                        set li_ri: li_ri + 1
                                    }
                                    if instantiating_methods.length > 0
                                        set instantiating_methods.length: instantiating_methods.length - 1
                                }
                            }
                        }
                    }
                }
            }

            ; Set up type substitutions for the struct's type parameters.
            ; Mirrors Planner.cpp:1660-1664 / 2004-2007. Without this, when
            ; resolving the param/return Types of a generic method (e.g.
            ; Array.add(this, item: T)) the bound `T` doesn't substitute to
            ; the concrete generic argument (Program), so the mangled name
            ; comes out as `_ZN5ArrayI7ProgramE3addE1T` instead of
            ; `_ZN5ArrayI7ProgramE3addE7Program` and the link fails.
            ; s132: bind substitutions against the auto-deref'd `lookup_st`,
            ; not the raw `struct_type`. For a `ref[Vector[Module]]` receiver,
            ; struct_type.name="ref" and lookup_concept("ref")=null — the
            ; substitution loop silently no-ops and `T` stays unbound, so
            ; mangle_method emits `_ZN6VectorI6ModuleE3addE1T` instead of
            ; `..3addE6Module`. Mirrors the auto-deref above this block
            ; (lookup_st = struct_type.generics[0] when struct_type is
            ; pointer/ref).
            ; s167: plan the method's return/param types with the RECEIVER's
            ; generic bindings OVERRIDING any same-named ambient binding
            ; (mirrors stage-0's TypeSubstitutions map-overwrite). For a
            ; Vector<Vector<String>> receiver inside an instantiated
            ; HashSet[String], Vector's `T` must bind to Vector<String>,
            ; shadowing the ambient HashSet `T -> String`. Appending the
            ; receiver binding doesn't help — name_substitution_lookup is
            ; first-wins and a global last-wins flip breaks -c. So rebuild
            ; the substitution list: keep ambient entries whose key is NOT a
            ; receiver param, then append the receiver bindings; restore the
            ; full ambient list afterward.
            var rb_names Array[String]()
            var rb_vals Array[PlannedType]()
            let conc_ref this.lookup_concept(lookup_st.name)
            if conc_ref <> null
            {
                let conc (*conc_ref)
                if conc.parameters.length > 0
                {
                    if lookup_st.generics <> null
                    {
                        let gens_ref (*lookup_st.generics)
                        var pi: size_t 0
                        while pi < conc.parameters.length
                        {
                            if pi < gens_ref.length
                            {
                                let cp_ptr conc.parameters.get pi
                                let gen_ptr gens_ref.get pi
                                if cp_ptr <> null
                                {
                                    if gen_ptr <> null
                                    {
                                        rb_names.add cp_ptr.name
                                        rb_vals.add((*gen_ptr))
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                    }
                }
            }
            ; Snapshot ambient substitutions for restore.
            var subst_snapshot Array[KeyValuePair[String, PlannedType]]()
            var ssi: size_t 0
            while ssi < type_substitutions.length
            {
                let sp type_substitutions.get ssi
                if sp <> null
                    subst_snapshot.add((*sp))
                set ssi: ssi + 1
            }
            ; Rebuild: ambient entries not shadowed by a receiver param,
            ; then the receiver bindings (so they resolve under first-wins).
            set type_substitutions.length: 0
            var rsi: size_t 0
            while rsi < subst_snapshot.length
            {
                let ep subst_snapshot.get rsi
                if ep <> null
                {
                    let e (*ep)
                    var shadowed: bool false
                    var ri: size_t 0
                    while ri < rb_names.length
                    {
                        let rn_ptr rb_names.get ri
                        if rn_ptr <> null
                            if rn_ptr.equals(e.key)
                                set shadowed: true
                        set ri: ri + 1
                    }
                    if shadowed = false
                        type_substitutions.add e
                }
                set rsi: rsi + 1
            }
            var rbi: size_t 0
            while rbi < rb_names.length
            {
                let rn_ptr rb_names.get rbi
                let rv_ptr rb_vals.get rbi
                if rn_ptr <> null
                {
                    if rv_ptr <> null
                        this.define_type_substitution((*rn_ptr), (*rv_ptr))
                }
                set rbi: rbi + 1
            }

            var return_type: PlannedType Planner.make_void_type()
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: this.plan_type(rt)
            }

            ; Skip leading 'this' in the parameter list.
            var param_start: size_t 0
            if f.input.length > 0
            {
                let first_ptr f.input.get 0
                if first_ptr <> null
                {
                    if first_ptr.name <> null
                    {
                        let fname (*first_ptr.name)
                        if fname.equals("this")
                            set param_start: 1
                    }
                }
            }

            ; Collect planned parameter types (excluding this).
            var params_arr Array[PlannedType]()
            var i: size_t param_start
            while i < f.input.length
            {
                let p_ptr f.input.get i
                if p_ptr <> null
                {
                    if p_ptr.type <> null
                    {
                        let pt (*p_ptr.type)
                        params_arr.add(this.plan_type(pt))
                    }
                }
                set i: i + 1
            }
            var params_holder Vector[PlannedType](params_arr)
            ; s167: restore the full ambient substitution list.
            set type_substitutions.length: 0
            var rst: size_t 0
            while rst < subst_snapshot.length
            {
                let ep2 subst_snapshot.get rst
                if ep2 <> null
                    type_substitutions.add((*ep2))
                set rst: rst + 1
            }

            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            ; Implicit return-page: a function whose return type is a
            ; user-defined struct/union gets an `_rp` page parameter
            ; injected at planFunction time (Planner.cpp:11697). Mirror
            ; that here so the mangled name matches the emitted function.
            if Planner.function_needs_caller_page(this, f)
                set has_page: true
            ; s106: mangle against the auto-derefed receiver type.
            ; struct_type may be pointer[Foo] / ref[Foo]; the Itanium
            ; method symbol uses the bare receiver Foo so it matches
            ; the body emitted under planStructure(Foo).
            let mangled this.mangle_method(method_name, lookup_st, params_holder, has_page)

            ; Throws type (optional).
            var can_throw: bool false
            var throws_ref: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                set can_throw: true
                set throws_ref: &^this this.plan_type(tt)
            }

            ; s88: propagate has_page (set when the resolved method takes
            ; an explicit `page` param OR when it returns a struct/union
            ; that triggers the implicit-return-page injection) into the
            ; MethodMatch's requires_page_param. collapse_operand_sequence#
            ; reads this field on the resolved match and threads it onto
            ; the PlannedCall so emit_call prepends `rp` as arg0. Without
            ; it, every call to a `function#` method (e.g. String.to_c_string#,
            ; File.read_to_string#) emits only the explicit args and the
            ; callee reads garbage in the rp slot — observed as the empty
            ; cli.run "Could not read input file" path before s88.
            ; takes_this distinguishes instance methods (param_start=1, a
            ; leading `this`) from STATIC methods (param_start=0, e.g.
            ; Page::get / Page::allocate_page). The sibling-dispatch site
            ; (s101) prepends the `this` receiver only when this is true —
            ; a static method called unqualified from a sibling method must
            ; NOT get `this` prepended (s189: `get(object)` was emitted as
            ; `get(this, object)`, returning this's page → current_page
            ; self-loop → infinite recursion in Page::allocate).
            var mm_takes_this: bool false
            if param_start > 0
                set mm_takes_this: true
            ; Phase-5 class 1: flag the match when a Local-life argument is
            ; passed to a body that persists a parameter's value guts
            ; (add_error / add_diagnostic resolve through this path).
            var mm_persists: bool false
            if Planner.args_have_local_life(arg_types)
            {
                if this.persists_args_for(mangled, f)
                    set mm_persists: true
            }
            MethodMatch^this(
                null,
                mangled,
                return_type,
                &params_holder,
                has_page,
                can_throw,
                throws_ref,
                false,
                mm_takes_this,
                mm_persists
            )
        }

        ; find_member_operator: resolve a member operator named `op_name`
        ; (`[]` for subscripts, `==`/`<>`/… for a concept's binary operators)
        ; to the receiver concept's declaration. Mirrors stage-0
        ; findSubscriptOperator (Planner.cpp:2896): bind the concept's generic
        ; params to the receiver's generic args (s167 rebuild so receiver
        ; bindings win under first-wins lookup), plan the operator under that
        ; substitution, and record it as a dispatchable PlannedFunction on
        ; first use so the Emitter defines the symbol (plan_structure's
        ; PlannedOperators are stored but never emitted). Returns null when
        ; the receiver's concept declares no matching operator — the caller
        ; then leaves the operand sequence untouched.
        function find_member_operator(
            this: Planner,
            container_type: PlannedType,
            op_name: String,
            loc: Span
        ) returns ref[MethodMatch]?
        {
            ; Auto-deref pointer/ref receivers (s106 pattern).
            var lookup_st: PlannedType container_type
            if container_type.name.equals("pointer")
            {
                if container_type.generics <> null
                {
                    let gens (*container_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }
            if container_type.name.equals("ref")
            {
                if container_type.generics <> null
                {
                    let gens (*container_type.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set lookup_st: (*inner_ptr)
                    }
                }
            }

            let concept_ref this.lookup_concept(lookup_st.name)
            if concept_ref = null
                return null
            let conc (*concept_ref)

            ; Find the `[]` operator member.
            var op_holder Array[Operator]()
            choose conc.definition
                when s: Structure
                {
                    var mi: size_t 0
                    while mi < s.members.length
                    {
                        let m_ptr s.members.get mi
                        if m_ptr <> null
                        {
                            choose (*m_ptr)
                                when o: Operator
                                {
                                    if o.name.equals(op_name)
                                        if op_holder.length = 0
                                            op_holder.add o
                                    0
                                }
                                else
                                    0
                        }
                        set mi: mi + 1
                    }
                    0
                }
                else
                    0
            if op_holder.length = 0
                return null
            let op_ptr op_holder.get 0
            if op_ptr = null
                return null
            let op (*op_ptr)

            ; Cycle guard: planning the operator body below re-enters
            ; collapse; a subscript inside the SAME container's own `[]`
            ; body would recurse forever (recording happens only after
            ; planning completes). Keyed distinctly from the struct
            ; mangled so the s188 lazy-instantiation entries are not
            ; disturbed.
            var guard_sb StringBuilder()
            guard_sb.append "ix:"
            guard_sb.append op_name
            guard_sb.append ":"
            guard_sb.append(Planner.mangle_structure(lookup_st.name, lookup_st.generics))
            let guard_key guard_sb.to_string()
            var gi_i: size_t 0
            while gi_i < instantiating_methods.length
            {
                let g_ptr instantiating_methods.get gi_i
                if g_ptr <> null
                    if g_ptr.equals(guard_key)
                        return null
                set gi_i: gi_i + 1
            }
            instantiating_methods.add guard_key

            ; s167 substitution rebuild: receiver generic bindings must WIN
            ; over same-named ambient bindings (first-wins lookup). Snapshot
            ; ambient, rebuild without shadowed keys, append receiver
            ; bindings; restore the full ambient list afterward.
            var rb_names Array[String]()
            var rb_vals Array[PlannedType]()
            if conc.parameters.length > 0
            {
                if lookup_st.generics <> null
                {
                    let gens_ref (*lookup_st.generics)
                    var pi: size_t 0
                    while pi < conc.parameters.length
                    {
                        if pi < gens_ref.length
                        {
                            let cp_ptr conc.parameters.get pi
                            let gen_ptr gens_ref.get pi
                            if cp_ptr <> null
                            {
                                if gen_ptr <> null
                                {
                                    rb_names.add cp_ptr.name
                                    rb_vals.add((*gen_ptr))
                                }
                            }
                        }
                        set pi: pi + 1
                    }
                }
            }
            var subst_snapshot Array[KeyValuePair[String, PlannedType]]()
            var ssi: size_t 0
            while ssi < type_substitutions.length
            {
                let sp type_substitutions.get ssi
                if sp <> null
                    subst_snapshot.add((*sp))
                set ssi: ssi + 1
            }
            set type_substitutions.length: 0
            var rsi: size_t 0
            while rsi < subst_snapshot.length
            {
                let ep subst_snapshot.get rsi
                if ep <> null
                {
                    let e (*ep)
                    var shadowed: bool false
                    var ri: size_t 0
                    while ri < rb_names.length
                    {
                        let rn_ptr rb_names.get ri
                        if rn_ptr <> null
                            if rn_ptr.equals(e.key)
                                set shadowed: true
                        set ri: ri + 1
                    }
                    if shadowed = false
                        type_substitutions.add e
                }
                set rsi: rsi + 1
            }
            var rbi: size_t 0
            while rbi < rb_names.length
            {
                let rn_ptr rb_names.get rbi
                let rv_ptr rb_vals.get rbi
                if rn_ptr <> null
                {
                    if rv_ptr <> null
                        this.define_type_substitution((*rn_ptr), (*rv_ptr))
                }
                set rbi: rbi + 1
            }

            ; Parent type for planning/mangling: the concrete receiver.
            var parent_holder Vector[PlannedType](1)
            parent_holder.put(0, lookup_st)

            let planned_op this.plan_operator(op, parent_holder.get(0))

            ; Restore ambient substitutions.
            set type_substitutions.length: 0
            var rst_i: size_t 0
            while rst_i < subst_snapshot.length
            {
                let rp_e subst_snapshot.get rst_i
                if rp_e <> null
                    type_substitutions.add((*rp_e))
                set rst_i: rst_i + 1
            }

            ; Pop the cycle guard.
            if instantiating_methods.length > 0
                set instantiating_methods.length: instantiating_methods.length - 1

            ; Record as a dispatchable function on first use (dedup by
            ; mangled name). The same implicit-return-page rule as
            ; plan_operator's mangling decides the rp slot.
            var op_has_page: bool false
            if Planner.is_extern_impl(op.implementation) = false
            {
                if op.returns_ <> null
                {
                    let ort (*op.returns_)
                    if ort.name.length > 0
                    {
                        let ojoined Planner.join_dotted_name(ort.name)
                        if Planner.is_primitive_type_name(ojoined) = false
                            if Planner.is_generic_type_param_name(ojoined) = false
                                set op_has_page: true
                    }
                }
            }

            var return_type: PlannedType Planner.make_void_type()
            if planned_op.return_type <> null
            {
                let prt planned_op.return_type
                set return_type: (*prt)
            }

            if this.has_recorded_function(planned_op.mangled_name) = false
            {
                var page_param_ref: ref[String]? null
                if op_has_page
                {
                    var pp_holder Vector[String](1)
                    pp_holder.put(0, String("rp"))
                    set page_param_ref: pp_holder.get(0)
                }
                var rt_ref: ref[PlannedType]? null
                if planned_op.return_type <> null
                    set rt_ref: planned_op.return_type
                let op_fn PlannedFunction(
                    planned_op.loc,
                    planned_op.is_private,
                    true,
                    planned_op.name,
                    planned_op.mangled_name,
                    page_param_ref,
                    planned_op.input,
                    rt_ref,
                    planned_op.throws_type,
                    Lifetime.Unspecified(Unspecified()),
                    planned_op.impl,
                    null,
                    false,
                    false,
                    null,
                    this.file
                )
                this.record_function(op_fn)
            }

            var can_throw: bool false
            if planned_op.throws_type <> null
                set can_throw: true

            MethodMatch^this(
                null,
                planned_op.mangled_name,
                return_type,
                null,
                op_has_page,
                can_throw,
                planned_op.throws_type,
                false,
                true,
                false
            )
        }

        ; generate_page_get_this: synthesize a `Page.get(this)` call,
        ; returned as a PlannedOperand whose result_type is
        ; `pointer[Page]`. Used when lowering a `^this` lifetime
        ; annotation — the emitter needs the page that currently owns
        ; `this` to allocate a sibling value.
        ;
        ; `this` must be a local in the current scope; the unreachable
        ; fallback returns a void placeholder so the type checker still
        ; threads a value through.
        function generate_page_get_this(this: Planner, loc: Span) returns PlannedOperand
        {
            let this_ty_ref this.lookup_local("this")
            if this_ty_ref = null
            {
                let void_ty Planner.make_void_type()
                return PlannedOperand(
                    loc,
                    PlannedExpression.Type void_ty,
                    null,
                    void_ty
                )
            }

            let this_ty (*this_ty_ref)

            ; Build the result type: pointer[Page].
            let page_ty PlannedType(
                loc,
                "Page",
                "",
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )
            let result_type Planner.make_pointer_type(page_ty)

            ; Plan the `this` variable operand to pass as the argument.
            let this_var PlannedVariable(loc, "this", this_ty, false)
            let this_operand PlannedOperand(
                loc,
                PlannedExpression.Variable this_var,
                null,
                this_ty
            )

            var args_vec Vector[PlannedOperand](1)
            args_vec.put(0, this_operand)

            ; Mangle as a call to Page.get(pointer[void]).
            let call this.make_planned_call(
                loc,
                "get",
                "_ZN4scaly6memory4Page3getEPv",
                result_type,
                args_vec
            )

            PlannedOperand(
                loc,
                PlannedExpression.Call call,
                null,
                result_type
            )
        }

        ; s184: a construction result can carry a trailing member chain
        ; (`Point(3, 4).x`). The construction gate attaches the chain raw
        ; and keeps result_type = the struct type, so plan_tuple's
        ; single-component lift typed the whole group as the struct and
        ; emit_tuple rebuilt the struct from the extracted field. Resolve
        ; the hops against the operand's result type and rewrite chain +
        ; result_type when every hop resolves as a property — the same
        ; rule as the s175 call-branch fix. Returns the operand
        ; unchanged when the chain is absent or not all-property.
        function rebind_trailing_chain(
            this: Planner,
            operand: PlannedOperand
        ) returns PlannedOperand
        {
            if operand.member_access = null
                return operand
            let tail_ma (*operand.member_access)
            if tail_ma.length = 0
                return operand
            var tail_names Vector[String](tail_ma.length)
            var tni: size_t 0
            while tni < tail_ma.length
            {
                let tn_ptr tail_ma.get tni
                if tn_ptr <> null
                    tail_names.put(tni, (*tn_ptr).name)
                set tni: tni + 1
            }
            let tail_chain this.resolve_member_access(operand.result_type, tail_names)
            var all_props: bool false
            if tail_chain.length > 0
                set all_props: true
            var tci: size_t 0
            while tci < tail_chain.length
            {
                let tc_ptr tail_chain.get tci
                if tc_ptr = null
                    set all_props: false
                if tc_ptr <> null
                {
                    let tc (*tc_ptr)
                    if tc.is_method
                        set all_props: false
                    if tc.result_type.name.equals("void")
                        set all_props: false
                }
                set tci: tci + 1
            }
            if all_props = false
                return operand
            var tail_holder Vector[PlannedMemberAccess](tail_chain)
            var tail_final: PlannedType operand.result_type
            let tl_ptr tail_chain.get(tail_chain.length - 1)
            if tl_ptr <> null
                set tail_final: (*tl_ptr).result_type
            PlannedOperand(
                operand.loc,
                operand.expr,
                &tail_holder,
                tail_final
            )
        }

        ; ================================================================
        ; resolve_member_access: walk a chain of member names against
        ; `base_type`, producing a PlannedMemberAccess for each hop.
        ;
        ; At each step:
        ;   - if the name is a property, record the planned PropertyType
        ;     and continue the chain from that type;
        ;   - else if the name is a method, record the planned return
        ;     type and continue from that type;
        ;   - else record a placeholder with void result (caller will
        ;     surface this as an error when emission is attempted).
        ;
        ; The produced access chain feeds `PlannedOperand.member_access`.
        ; ================================================================
        function resolve_member_access(
            this: Planner,
            base_type: PlannedType,
            members: Vector[String]
        ) returns Vector[PlannedMemberAccess]
        {
            var result Array[PlannedMemberAccess]()
            var current: PlannedType base_type

            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    let m (*m_ptr)

                    var matched: bool false

                    ; s106: auto-deref pointer[T] / ref[T] for member lookup.
                    ; Mirrors stage-0's getInnerTypeIfPointerLike at
                    ; Planner.cpp:1441. Without this, a pointer-typed local
                    ; (e.g. init#'s implicit `page: pointer[scaly.memory.Page]`)
                    ; never finds methods because lookup walks the outer
                    ; "pointer" name.
                    var lookup_type: PlannedType current
                    if current.name.equals("pointer")
                    {
                        if current.generics <> null
                        {
                            let gens (*current.generics)
                            if gens.length > 0
                            {
                                let inner_ptr gens.get 0
                                if inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }
                    if current.name.equals("ref")
                    {
                        if current.generics <> null
                        {
                            let gens (*current.generics)
                            if gens.length > 0
                            {
                                let inner_ptr gens.get 0
                                if inner_ptr <> null
                                    set lookup_type: (*inner_ptr)
                            }
                        }
                    }

                    ; s172: Option[ref[T]] / Option[pointer[T]] auto-deref —
                    ; mirrors stage-0 lookupMethod's Option-unwrap fallback
                    ; (Planner.cpp:1730-1737). A nullable ref field like
                    ; `function_cache_names: ref[Vector[String]]?` is
                    ; Option[ref[Vector[String]]]; without unwrapping,
                    ; lookup_property/lookup_methods search "Option", find
                    ; nothing, and the call (`names.add(n)`) silently
                    ; drops — stage-2's function cache stayed empty and
                    ; every body bailed at the cache miss. Option's own
                    ; methods (is_some/is_none/unwrap/unwrap_or) are
                    ; exempt so NPO unwrap dispatch keeps resolving on
                    ; the Option itself.
                    var m_is_opt_method: bool false
                    if m.equals("unwrap")
                        set m_is_opt_method: true
                    if m.equals("unwrap_or")
                        set m_is_opt_method: true
                    if m.equals("is_some")
                        set m_is_opt_method: true
                    if m.equals("is_none")
                        set m_is_opt_method: true
                    ; s184: variant names resolve on the union itself
                    ; (`Option[int].None` after the generic merge) —
                    ; unwrapping would look "None" up on the payload
                    ; type and produce a void placeholder hop.
                    if this.lookup_variant_tag(lookup_type.name, m) >= 0
                        set m_is_opt_method: true
                    if m_is_opt_method = false
                    {
                        if lookup_type.name.equals("Option")
                        {
                            if lookup_type.generics <> null
                            {
                                let ogens (*lookup_type.generics)
                                if ogens.length > 0
                                {
                                    let og_ptr ogens.get 0
                                    if og_ptr <> null
                                    {
                                        var inner_o (*og_ptr)
                                        if inner_o.name.equals("ref")
                                        {
                                            if inner_o.generics <> null
                                            {
                                                let igens (*inner_o.generics)
                                                if igens.length > 0
                                                {
                                                    let iip igens.get 0
                                                    if iip <> null
                                                        set inner_o: (*iip)
                                                }
                                            }
                                        }
                                        if inner_o.name.equals("pointer")
                                        {
                                            if inner_o.generics <> null
                                            {
                                                let pgens (*inner_o.generics)
                                                if pgens.length > 0
                                                {
                                                    let pip pgens.get 0
                                                    if pip <> null
                                                        set inner_o: (*pip)
                                                }
                                            }
                                        }
                                        set lookup_type: inner_o
                                    }
                                }
                            }
                        }
                    }

                    ; Property lookup.
                    let prop_ref this.lookup_property(lookup_type.name, m)
                    if prop_ref <> null
                    {
                        set matched: true
                        ; Ensure the parent struct's LLVM layout is planned so
                        ; the emitter GEPs the right field offset for this hop
                        ; — needed for cross-package types whose defining
                        ; package this root doesn't walk (e.g. ProgramSyntax /
                        ; FileSyntax referenced from scalyls). No-op for the
                        ; compiler's own builds (every such struct is already
                        ; registered) and for ABI-opaque stdlib structs.
                        this.ensure_member_layout(lookup_type.name)
                        let prop (*prop_ref)
                        var prop_type: PlannedType this.fresh_type_var("")
                        if prop.type <> null
                        {
                            let t (*prop.type)
                            ; s173: bind the concept's type parameters to
                            ; lookup_type's generic args before planning
                            ; the property type — mirrors stage-0
                            ; Planner.cpp:5078-5084. Without this,
                            ; KeyValuePair[String, LocalBinding].key
                            ; planned as bare "K", the next hop (.equals)
                            ; failed to resolve, and the whole guard
                            ; statement was dropped — stage-2's
                            ; lookup_local_binding compare loop vanished,
                            ; so every function param read planned as a
                            ; Type expression and bodies emitted const 0.
                            ; Receiver bindings shadow ambient same-named
                            ; entries (s167 first-wins rebuild pattern
                            ; from lookup_method#).
                            var ps_names Array[String]()
                            var ps_vals Array[PlannedType]()
                            let pconc_ref this.lookup_concept(lookup_type.name)
                            if pconc_ref <> null
                            {
                                let pconc (*pconc_ref)
                                if pconc.parameters.length > 0
                                {
                                    if lookup_type.generics <> null
                                    {
                                        let pgens (*lookup_type.generics)
                                        var ppi: size_t 0
                                        while ppi < pconc.parameters.length
                                        {
                                            if ppi < pgens.length
                                            {
                                                let pcp pconc.parameters.get ppi
                                                let pgp pgens.get ppi
                                                if pcp <> null
                                                {
                                                    if pgp <> null
                                                    {
                                                        ps_names.add pcp.name
                                                        ps_vals.add((*pgp))
                                                    }
                                                }
                                            }
                                            set ppi: ppi + 1
                                        }
                                    }
                                }
                            }
                            var did_subst: bool false
                            var ps_snapshot Array[KeyValuePair[String, PlannedType]]()
                            if ps_names.length > 0
                            {
                                var psi: size_t 0
                                while psi < type_substitutions.length
                                {
                                    let sp2 type_substitutions.get psi
                                    if sp2 <> null
                                        ps_snapshot.add((*sp2))
                                    set psi: psi + 1
                                }
                                set type_substitutions.length: 0
                                var psr: size_t 0
                                while psr < ps_snapshot.length
                                {
                                    let ep3 ps_snapshot.get psr
                                    if ep3 <> null
                                    {
                                        let e3 (*ep3)
                                        var shadowed2: bool false
                                        var pri: size_t 0
                                        while pri < ps_names.length
                                        {
                                            let prn ps_names.get pri
                                            if prn <> null
                                                if prn.equals(e3.key)
                                                    set shadowed2: true
                                            set pri: pri + 1
                                        }
                                        if shadowed2 = false
                                            type_substitutions.add e3
                                    }
                                    set psr: psr + 1
                                }
                                var prb: size_t 0
                                while prb < ps_names.length
                                {
                                    let prn2 ps_names.get prb
                                    let prv2 ps_vals.get prb
                                    if prn2 <> null
                                    {
                                        if prv2 <> null
                                            this.define_type_substitution((*prn2), (*prv2))
                                    }
                                    set prb: prb + 1
                                }
                                set did_subst: true
                            }
                            set prop_type: this.plan_type(t)
                            if did_subst
                            {
                                set type_substitutions.length: 0
                                var prr: size_t 0
                                while prr < ps_snapshot.length
                                {
                                    let ep4 ps_snapshot.get prr
                                    if ep4 <> null
                                        type_substitutions.add((*ep4))
                                    set prr: prr + 1
                                }
                            }
                        }
                        let idx this.get_property_index(lookup_type.name, m)
                        ; s173: record the UNWRAPPED lookup_type as the
                        ; hop's parent (mirrors stage-0 Planner.cpp:5104
                        ; "Use dereferenced type for auto-deref").
                        ; field_index is computed against lookup_type's
                        ; layout; recording the pre-unwrap Option[ref[T]]
                        ; made emit_member_access_chain's deref-load use
                        ; the wrong struct type and bail — `ret.result
                        ; .length > 0` in emit_return silently dropped,
                        ; every stage-2 body returned const 0/null.
                        result.add(PlannedMemberAccess(
                            m, idx as size_t, false, false, lookup_type, prop_type
                        ))
                        set current: prop_type
                    }

                    ; Method lookup as fallback.
                    if matched = false
                    {
                        let methods this.lookup_methods(lookup_type.name, m)
                        if methods.length > 0
                        {
                            set matched: true
                            let first_ptr methods.get 0
                            if first_ptr <> null
                            {
                                let f (*first_ptr)
                                var return_ty: PlannedType this.fresh_type_var("")
                                if f.returns_ <> null
                                {
                                    let rt (*f.returns_)
                                    set return_ty: this.plan_type(rt)
                                }
                                ; s173: parent = unwrapped lookup_type
                                ; (stage-0 Planner.cpp:5142).
                                result.add(PlannedMemberAccess(
                                    m, 0, true, false, lookup_type, return_ty
                                ))
                                set current: return_ty
                            }
                        }
                    }

                    ; Union-variant lookup for the remaining case
                    ; (e.g. `opt.Some` as a variant construction). The
                    ; result type of a variant access is the owning union
                    ; itself — construction stays within the same type.
                    if matched = false
                    {
                        let tag this.lookup_variant_tag(lookup_type.name, m)
                        if tag >= 0
                        {
                            set matched: true
                            ; s173: parent = unwrapped lookup_type
                            ; (stage-0 Planner.cpp:5159).
                            result.add(PlannedMemberAccess(
                                m, tag as size_t, false, true, lookup_type,
                                current
                            ))
                        }
                    }

                    ; s103: Union `.value` accessor — extracts the
                    ; payload of the union's first non-unit variant.
                    ; Mirrors stage-0 Planner.cpp:5198-5226. The result
                    ; type is the variant's payload type. is_union_value
                    ; is set so emit_member_access_chain takes the
                    ; alloca + GEP-to-data + bitcast + load path
                    ; instead of a plain extractvalue at field_index.
                    if matched = false
                    {
                        if m.equals("value")
                        {
                            let conc_ref_for_value this.lookup_concept(lookup_type.name)
                            if conc_ref_for_value <> null
                            {
                                let conc_for_value (*conc_ref_for_value)
                                choose conc_for_value.definition
                                    when uv: scalyc.compiler.Model.Union
                                    {
                                        var found_payload: bool false
                                        var payload_type: PlannedType Planner.make_void_type()
                                        var vi: size_t 0
                                        while vi < uv.variants.length
                                        {
                                            if found_payload = false
                                            {
                                                let v_ptr uv.variants.get vi
                                                if v_ptr <> null
                                                {
                                                    let var_def (*v_ptr)
                                                    if var_def.type <> null
                                                    {
                                                        let vt (*var_def.type)
                                                        set payload_type: this.plan_type(vt)
                                                        set found_payload: true
                                                    }
                                                }
                                            }
                                            set vi: vi + 1
                                        }
                                        if found_payload
                                        {
                                            set matched: true
                                            ; s173: parent = unwrapped
                                            ; lookup_type (stage-0
                                            ; Planner.cpp:5224).
                                            result.add(PlannedMemberAccess(
                                                m, 1, false, true, lookup_type,
                                                payload_type
                                            ))
                                            set current: payload_type
                                        }
                                    }
                                    else
                                        0
                            }
                        }
                    }

                    ; Unresolved — record placeholder with void result.
                    if matched = false
                    {
                        var sb StringBuilder()
                        sb.append "member '"
                        sb.append m
                        sb.append "' not found in type "
                        sb.append current.name
                        this.add_error(sb.to_string())
                        result.add(PlannedMemberAccess(
                            m, 0, false, false, current, Planner.make_void_type()
                        ))
                    }
                }
                set i: i + 1
            }

            Vector[PlannedMemberAccess](result)
        }

        ; fresh_type_var: allocate a new type variable as a PlannedType
        ; wrapper with `variable` populated. Equivalent to Planner.cpp's
        ; freshTypeVar. `debug_name` is stored on the TypeVariable for
        ; error messages ("expected T, got int").
        function fresh_type_var(this: Planner, debug_name: String) returns PlannedType
        {
            let id this.fresh_type_var_id()
            ; Allocate the TypeVariable in a one-element Vector on rp so
            ; its address outlives this function.
            let tv_ref TypeVariable^this(id, String(debug_name))
            PlannedType(
                Span(0, 0),
                String(debug_name),
                "",
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                tv_ref
            )
        }

        ; ================================================================
        ; Constraint management.
        ; ================================================================

        function add_equality_constraint(
            this: Planner,
            left: PlannedType,
            right: PlannedType,
            loc: Span
        )
        {
            constraints.add(TypeConstraint.Equality(
                EqualityConstraint(left, right, loc, String(file))
            ))
        }

        ; solve_and_apply: drain the constraint queue, unify everything,
        ; stash the result in `solution`. Returns true on success, false
        ; if any constraint failed to unify. Constraints are cleared on
        ; success so subsequent add_equality_constraint / solve cycles
        ; start fresh.
        function solve_and_apply(this: Planner) returns bool
        {
            if constraints.length = 0
                return true

            ; Run the stateless solver.
            var cs_vec Vector[TypeConstraint](constraints)
            let result Planner.solve_constraints(&cs_vec)
            if result = null
                return false

            ; Snapshot the substitution into the Planner's persistent
            ; `solution` array, overwriting any previous solution.
            set solution.length: 0
            let result_v (*result)
            var i: size_t 0
            while i < result_v.length
            {
                let kvp_ptr result_v.get i
                if kvp_ptr <> null
                    solution.add(*kvp_ptr)

                set i: i + 1
            }

            ; Constraints are consumed.
            set constraints.length: 0
            true
        }

        ; apply_current_substitution: rewrite `t` using the current
        ; `solution`. Convenience wrapper around apply_substitution so
        ; callers don't have to marshal the Array-as-Vector themselves.
        function apply_current_substitution(this: Planner, t: PlannedType) returns PlannedType
        {
            if solution.length = 0
                return t

            var sol_vec Vector[KeyValuePair[size_t, PlannedType]](solution)
            Planner.apply_substitution(t, &sol_vec)
        }

        ; ================================================================
        ; plan_type: Model.Type → PlannedType using the active generic
        ; substitutions. Pulls together resolve_type_base (Model → Plan
        ; skeleton), apply_name_substitution (T → int, etc.), and the
        ; concept registry to fill in mangled_name for registered types.
        ; ================================================================
        function plan_type(this: Planner, t: Type) returns PlannedType
        {
            let base Planner.resolve_type_base(t)

            var after_subst: PlannedType base
            var subst_fired: bool false
            if type_substitutions.length > 0
            {
                var sub_vec Vector[KeyValuePair[String, PlannedType]](type_substitutions)
                set after_subst: Planner.apply_name_substitution(base, &sub_vec)
                ; If substitution actually replaced the name (T → Concrete),
                ; the result is already a concrete type — skip the dotted-name
                ; canonicalization that would shorten qualified names like
                ; `scalyc.compiler.Plan.PlannedUnion` → `PlannedUnion`. Stage-0
                ; preserves the full name in this case (encodeType uses the
                ; pre-set MangledName shortcut at Planner.cpp:518); without
                ; this if stage-1 emits an inconsistent mangling — the
                ; container generic uses `33scalyc.compiler.Plan.PlannedUnion`
                ; (full) while the arg substitutes to `12PlannedUnion` (short),
                ; producing a method symbol that no other side defines (s100).
                if after_subst.name.equals(base.name) = false
                    set subst_fired: true
            }
            if subst_fired
                return after_subst

            ; s96: Recursively canonicalize inner generics for ref[T] /
            ; pointer[T]. resolve_type_base# only recurses via itself
            ; (no Planner state, no has_concept access), so an inner
            ; type written as `Planner.Planner` (joined dotted name)
            ; stays in that form even when stage-1's concept registry
            ; has it under the canonical short name `Planner`. Without
            ; this, `ref[Planner.Planner]` mangles its inner as
            ; `15Planner.Planner` while a same-source-but-canonicalized
            ; `Planner` argument would mangle as `7Planner` — types_equal
            ; on the inner names returns false, types_compatible
            ; (s96 part 2) bails, the call is dropped. Mirrors stage-0
            ; Planner.cpp's resolveType which calls itself recursively
            ; on generic args (via resolveType, not the static helper).
            if after_subst.mangled_name.get_length() > 0
            {
                if t.generics <> null
                {
                    let model_gens (*t.generics)
                    if model_gens.length > 0
                    {
                        var canon_gens Vector[PlannedType](model_gens.length)
                        var gi: size_t 0
                        while gi < model_gens.length
                        {
                            let g_ptr model_gens.get gi
                            if g_ptr <> null
                            {
                                let g (*g_ptr)
                                let canon_inner this.plan_type(g)
                                canon_gens.put(gi, canon_inner)
                            }
                            set gi: gi + 1
                        }
                        ; Rebuild outer mangled name with canonicalized inner.
                        var sb StringBuilder()
                        if after_subst.name.equals("pointer")
                            sb.append "P"
                        if after_subst.name.equals("ref")
                            sb.append "R"
                        let inner0_ptr canon_gens.get 0
                        if inner0_ptr <> null
                        {
                            let inner0 (*inner0_ptr)
                            sb.append inner0.mangled_name
                        }
                        return PlannedType(
                            after_subst.loc,
                            after_subst.name,
                            sb.to_string(),
                            &canon_gens,
                            after_subst.life,
                            after_subst.origin,
                            after_subst.array_size,
                            after_subst.variable
                        )
                    }
                }
                return after_subst
            }

            ; s192: fixed-size array type `T[N]` where T is a primitive.
            ; The model carries the size N as a "generic argument" of the
            ; primitive. Rewrite to pointer[T] with array_size set so
            ; emit_binding allocas `[N x T]` on the stack and decays it to
            ; a pointer. Without this the primitive-with-generic falls
            ; through to the concept path, the binding gets a bogus scalar
            ; type, and the whole enclosing body is dropped (e.g.
            ; `var buffer char[64]`). Mirrors stage-0 Planner.cpp:6193-6255.
            if Planner.is_primitive_type_name(after_subst.name)
            {
                if after_subst.generics <> null
                {
                    let arr_gens (*after_subst.generics)
                    if arr_gens.length > 0
                    {
                        let size_ptr arr_gens.get 0
                        if size_ptr <> null
                        {
                            let size_name (*size_ptr).name
                            ; Build the element pointer type pointer[T].
                            let elem_mangled Planner.encode_type(PlannedType(
                                after_subst.loc,
                                after_subst.name,
                                "",
                                null,
                                after_subst.life,
                                null,
                                "",
                                null
                            ))
                            var elem_holder Vector[PlannedType](1)
                            elem_holder.put(0, PlannedType(
                                after_subst.loc,
                                after_subst.name,
                                elem_mangled,
                                null,
                                after_subst.life,
                                null,
                                "",
                                null
                            ))
                            var ptr_sb StringBuilder()
                            ptr_sb.append "P"
                            ptr_sb.append elem_mangled
                            return PlannedType(
                                after_subst.loc,
                                "pointer",
                                ptr_sb.to_string(),
                                &elem_holder,
                                after_subst.life,
                                null,
                                String(size_name),
                                null
                            )
                        }
                    }
                }
            }

            ; Otherwise consult the concept table: a registered user type
            ; mangles as "_Z"-length-prefix-with-optional-generic-block.
            ;
            ; Dotted-name canonicalization: when the joined name (e.g.
            ; "parser.ProgramSyntax") doesn't resolve, try the last
            ; segment alone ("ProgramSyntax"). This makes a parameter
            ; type written as `parser.ProgramSyntax` (qualified by use
            ; alias) match a function declaring `syntax: ProgramSyntax`
            ; (unqualified). Mirrors stage-0 Planner.cpp:5619-5648
            ; (lookupConcept dotted) and 6263-6311 (resolveType module
            ; stack fallback).
            var canonical_name: String String(after_subst.name)

            ; Union.Variant pattern: a dotted name like `Member.Function`
            ; where the prefix is a Union concept and the suffix is one of
            ; its variants must KEEP its dotted form so that
            ; collapse_operand_sequence#'s variant-ctor path (which splits
            ; on '.' and looks the prefix up as a union) fires. The suffix-
            ; canonicalization below would otherwise rewrite it to the bare
            ; suffix when the variant name collides with a registered type
            ; (e.g. `Concept`/`Function` are both Member variants AND Model
            ; types), so `Member.Function(fn)` would be planned as a bare
            ; `Function(fn)` construction and the union wrapper dropped —
            ; every top-level function/concept member then gets an undef
            ; tag and the planner's member loop skips it. Stage-0 resolves
            ; the variant before resolveType ever sees it.
            if this.has_concept(canonical_name) = false
            {
                let vc_dot canonical_name.last_index_of("." as u8)
                if vc_dot > 0
                {
                    let vc_start (vc_dot as size_t) + 1
                    let vc_total canonical_name.get_length()
                    if vc_total > vc_start
                    {
                        let vc_prefix canonical_name.substring(0, vc_dot as size_t)
                        let vc_suffix canonical_name.substring(vc_start, vc_total - vc_start)
                        let vc_union_ref this.lookup_concept(vc_prefix)
                        if vc_union_ref <> null
                        {
                            let vc_uconc (*vc_union_ref)
                            var vc_is_union: bool false
                            choose vc_uconc.definition
                                when u: scalyc.compiler.Model.Union
                                    set vc_is_union: true
                                else
                                    0
                            if vc_is_union
                            {
                                let vc_tag this.lookup_variant_tag(vc_prefix, vc_suffix)
                                if vc_tag >= 0
                                    return after_subst
                            }
                        }
                    }
                }
            }

            if this.has_concept(canonical_name) = false
            {
                let last_dot canonical_name.last_index_of("." as u8)
                if last_dot >= 0
                {
                    let start (last_dot as size_t) + 1
                    let total canonical_name.get_length()
                    if total > start
                    {
                        let suffix canonical_name.substring(start, total - start)
                        ; s182: Namespace-function pattern. A dotted name
                        ; like `NS.Thing` where the prefix is a Namespace
                        ; concept declaring a FUNCTION named `Thing` must
                        ; KEEP its dotted form. Canonicalizing to the bare
                        ; suffix whenever the function name collides with
                        ; a registered concept (the s179 class:
                        ; `LLVMTypeKind.Array()` planned as a zero-init
                        ; `Array` construction, call + enclosing comparison
                        ; silently dropped) hands the construction gate a
                        ; false match. With the dotted form kept, the
                        ; gate's lookup_concept misses and the dotted-call
                        ; fallback resolves the namespace function.
                        ; Mirrors stage-0's ordering: the qualified-call
                        ; branch runs BEFORE the construction check
                        ; (Planner.cpp:8604 vs 8754).
                        var nf_keep_dotted: bool false
                        let nf_ns_ref this.lookup_namespace_concept(
                            canonical_name.substring(0, last_dot as size_t))
                        if nf_ns_ref <> null
                        {
                            let nf_conc (*nf_ns_ref)
                            choose nf_conc.definition
                                when nf_ns: Namespace
                                {
                                    var nf_mi: size_t 0
                                    while nf_mi < nf_ns.members.length
                                    {
                                        let nf_m_ptr nf_ns.members.get nf_mi
                                        if nf_m_ptr <> null
                                        {
                                            let nf_mem (*nf_m_ptr)
                                            choose nf_mem
                                                when nff: Function
                                                {
                                                    if nff.name.equals(suffix)
                                                        set nf_keep_dotted: true
                                                    0
                                                }
                                                else
                                                    0
                                        }
                                        set nf_mi: nf_mi + 1
                                    }
                                    0
                                }
                                else
                                    0
                        }
                        if nf_keep_dotted
                            return after_subst
                        if this.has_concept(suffix)
                            set canonical_name: suffix
                    }
                }
            }
            if this.has_concept(canonical_name) = false
                return after_subst

            ; s107: when the concept is a generic data class (Structure
            ; with no members/initializers) used with concrete type args,
            ; route through instantiate_generic# so the specialised body
            ; gets recorded in instantiated_structures. Restricted to
            ; data classes — generics with method bodies (Vector,
            ; HashMap, etc.) drag in cross-package references that
            ; stage-1 cannot fully plan, exhausting the rp page during
            ; the deep plan_function# walk and SEGVing in LLVM codegen.
            ; The restriction means user-defined `define Box[T](value: T)`
            ; types instantiate cleanly, while stdlib generics fall
            ; through to the empty-mangled fallback below as before.
            let conc_ref this.lookup_concept(canonical_name)
            if conc_ref <> null
            {
                let conc (*conc_ref)
                if conc.parameters.length > 0
                {
                    ; s109: relax to any generic Structure. stdlib generics
                    ; (Vector / HashMap / Array / etc.) historically SEGV
                    ; when their bodies are walked with substitutions
                    ; bound — keep them on the empty-mangled fallback
                    ; path. User-defined generics with methods/inits
                    ; (e.g. nested_generic's Box, generic_lifetime's
                    ; Container) get specialised here so the spec'd
                    ; bodies (`_ZN3BoxIiE3getEv`, `_ZN9ContainerIiE...`)
                    ; reach the emitter.
                    var is_struct: bool false
                    choose conc.definition
                        when s: Structure
                            set is_struct: true
                        else
                            0
                    var is_stdlib_generic: bool false
                    ; s129: Vector + Array routed through instantiate_generic#
                    ; (removed from the data-class restriction). The s107 gate
                    ; originally excluded all stdlib generics because their
                    ; bodies were "drag[ging] in cross-package references" —
                    ; with s109..s127 (generic spec'd methods, intrinsic
                    ; map_type, page_param stub, deref-load, receiver-load,
                    ; emit_choose IR guards, empty-args ctor field-init, scope
                    ; push/pop, LinkOnceODR linkage) all in place, stage-1 can
                    ; now plan + emit those bodies. Removing Vector + Array
                    ; from this list cuts Step-7 stage-2 link undef refs from
                    ; 106 → 4. The matching skip_dispatch denylist site
                    ; (~line 3240) is intentionally kept: `vec.add(x)` style
                    ; method dispatch still routes via the extern-decl shim
                    ; rather than the spec'd `_ZN6VectorI...E3addE...` lookup.
                    ; s200: HashMap + HashMapBuilder lifted (the s189 user-
                    ; program instantiation hole). The s188-era blocker — the
                    ; reallocate→page SIGSEGV when HashMapBuilder<String,
                    ; Nameable> (Modeler symbol table) goes real — was fixed
                    ; by the intervening s190 overload-resolution receiver-
                    ; generic binding and s181 ^this Page.get wrap (the same
                    ; machinery HashSetBuilder exercises since s188). With
                    ; these denylisted, a user program's
                    ; `HashMapBuilder[String,int](vector)` resolved to a
                    ; mangled name only (declare, never define) → undefined
                    ; ctor/contains at link.
                    ; if canonical_name.equals("HashMap")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("HashMapBuilder")
                    ;     set is_stdlib_generic: true
                    ; s166: HashSet/HashSetBuilder lifted so
                    ; instantiate_generic# emits their init# bodies.
                    ; if canonical_name.equals("HashSet")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("HashSetBuilder")
                    ;     set is_stdlib_generic: true
                    ; s129: Array removed alongside Vector (see comment above).
                    ; s148: List + ListIterator + Node removed analogous to
                    ; the s129 Vector/Array lift. Without this, stage-1's
                    ; planner doesn't run instantiate_generic# for
                    ; List<StatementSyntax>/etc., so `list.add(node)` calls
                    ; emitted via the skip_dispatch (still kept) extern-decl
                    ; shim have no body to link against. Specialised bodies
                    ; (`_ZN4ListIxxxE3addExxx`) are needed because Itanium
                    ; mangling makes each T-instantiation a distinct symbol
                    ; and libscaly.a only provides List<int> (used by tests
                    ; in scaly.scaly itself).
                    ; if canonical_name.equals("List")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("ListIterator")
                    ;     set is_stdlib_generic: true
                    ; s188: BuilderList + BuilderListIterator lifted (like
                    ; s129 Vector/Array, s148 List/Node, s166 HashSet).
                    ; HashSetBuilder<String> (un-denylisted) holds buckets:
                    ; Vector[BuilderList[Slot[String]]] and its real
                    ; add_internal/reallocate call BuilderList<Slot<String>>::
                    ; {add,get_iterator} + the iterator next() chain. With
                    ; these denylisted, plan_type# resolved them to a mangled
                    ; name only (declare, never define → undefined at seed
                    ; link). instantiate_generic# plans layout + ctor + ALL
                    ; methods consistently. This handles the type-annotation
                    ; path; lookup_method#'s s188 lazy hook handles the
                    ; call-reached path (BuilderList::add etc. are reached
                    ; only as calls from inside another generic's body).
                    ; if canonical_name.equals("BuilderList")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("BuilderListIterator")
                    ;     set is_stdlib_generic: true
                    ; s148: Node removed alongside List (see comment above).
                    ; List<T>::add allocates Node<T>; with Node in the
                    ; stdlib-generic skip list it falls through to the
                    ; abstract `{ptr, ptr}` placeholder (16 bytes for any
                    ; T) instead of `{T, ptr}` (sizeof(T) + 8). Lifting
                    ; lets instantiate_generic# produce a properly sized
                    ; named struct per concrete T.
                    ; if canonical_name.equals("Node")
                    ;     set is_stdlib_generic: true
                    ; s188: Slot lifted — element type of BuilderList<Slot<T>>,
                    ; a pure data class (plan_structure# just records layout).
                    ; if canonical_name.equals("Slot")
                    ;     set is_stdlib_generic: true
                    ; s200: Slice lifted with HashMap/HashMapBuilder (the
                    ; s189 user-program hole: Slice[int].get/is_empty were
                    ; declare-only → undefined at link).
                    ; if canonical_name.equals("Slice")
                    ;     set is_stdlib_generic: true
                    ; s200: Option + Result lifted (same s189 hole for user
                    ; programs annotating Option[int]/Result[T,E]). The s188
                    ; "Option diverges the fixed point" warning concerned the
                    ; lookup_method# lazy-machinery allowlist, not this
                    ; annotation path — verified by cycle.
                    ; if canonical_name.equals("Option")
                    ;     set is_stdlib_generic: true
                    ; if canonical_name.equals("Result")
                    ;     set is_stdlib_generic: true
                    ; s173: KeyValuePair lifted (like s129 Vector/Array,
                    ; s148 List). It's a pure data class — no methods, no
                    ; init bodies, nothing to drag in. With it denylisted,
                    ; KeyValuePair[String, LocalBinding] never reached
                    ; instantiate_generic#, the emitter had no struct
                    ; layout, and every member hop through a KVP element
                    ; (lookup_local_binding's `kvp_ptr.key.equals(name)`)
                    ; bailed at map_type → the whole if statement
                    ; dropped → stage-2 resolved NO local variables.
                    ; if canonical_name.equals("KeyValuePair")
                    ;     set is_stdlib_generic: true
                    if is_struct
                        if is_stdlib_generic = false
                        {
                            if after_subst.generics <> null
                            {
                                let g (*after_subst.generics)
                                if g.length = conc.parameters.length
                                {
                                    ; s110: recursively plan each generic arg
                                    ; before instantiation, so nested generics
                                    ; like Box[Box[int]] propagate inner
                                    ; mangled names. Without this, inner args
                                    ; from resolve_type_base# carry empty
                                    ; mangled names and the spec'd struct's
                                    ; property type bottoms out with empty
                                    ; mangled — map_type's struct_cache miss
                                    ; emits the outer's field as opaque ptr.
                                    ; s115: skip the recursion when the inner
                                    ; arg is already a struct (has non-empty
                                    ; mangled_name) — the s110 case only
                                    ; needs to fire for raw model types from
                                    ; resolve_type_base#. Recursing on every
                                    ; arg in instantiate_generic#'s loop
                                    ; triggered deep stack growth in
                                    ; scalyc.scaly self-compile because
                                    ; nested-generic method bodies kept
                                    ; re-entering plan_type# → instantiate_
                                    ; generic# before the outer hit the
                                    ; instantiated_structures cache.
                                    ; s133: refine the s115 short-circuit. Using `gp`
                                    ; directly when its mangled is non-empty is safe
                                    ; for inner args that are already fully specialised
                                    ; (e.g. `Box[int]` arriving via type substitution).
                                    ; But when the model side `mp` has generics yet
                                    ; `gp.generics` is null, `gp` is the ABSTRACT
                                    ; template (mangled looks like `_Z12KeyValuePair`,
                                    ; no `I...E` suffix) and reusing it propagates the
                                    ; truncated mangling through every nesting layer.
                                    ; Concretely: HashMap[String, LocalBinding] uses
                                    ; Slot[KeyValuePair[K, V]] internally; without this
                                    ; carve-out, Vector<Vector<KeyValuePair<String,
                                    ; LocalBinding>>>::ctor ends up named
                                    ; `_ZN6VectorI6VectorI12KeyValuePairEEC1...`,
                                    ; dropping the inner `I6String12LocalBindingE`.
                                    ; Re-plan via plan_type# in this case so the
                                    ; current substitutions (K → String, V →
                                    ; LocalBinding) drive the inner mangling.
                                    var canon_gens_inst Vector[PlannedType](g.length)
                                    var ggi: size_t 0
                                    while ggi < g.length
                                    {
                                        let gp_ptr g.get ggi
                                        if gp_ptr <> null
                                        {
                                            let gp (*gp_ptr)
                                            var need_replan: bool false
                                            if gp.mangled_name.get_length() = 0
                                                set need_replan: true
                                            if gp.generics = null
                                            {
                                                if t.generics <> null
                                                {
                                                    let mg_check (*t.generics)
                                                    if ggi < mg_check.length
                                                    {
                                                        let mp_check_ptr mg_check.get ggi
                                                        if mp_check_ptr <> null
                                                        {
                                                            if mp_check_ptr.generics <> null
                                                                set need_replan: true
                                                        }
                                                    }
                                                }
                                            }
                                            if need_replan = false
                                                canon_gens_inst.put(ggi, gp)
                                            if need_replan
                                            {
                                                if t.generics <> null
                                                {
                                                    let mg (*t.generics)
                                                    if ggi < mg.length
                                                    {
                                                        let mp_ptr mg.get ggi
                                                        if mp_ptr <> null
                                                        {
                                                            let mp (*mp_ptr)
                                                            let cgi this.plan_type(mp)
                                                            canon_gens_inst.put(ggi, cgi)
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        set ggi: ggi + 1
                                    }

                                    ; s109: preserve the call-site lifetime
                                    ; (^page / $ / #) on the specialised
                                    ; PlannedType. instantiate_generic#
                                    ; returns Lifetime.Unspecified by
                                    ; default; without overlaying the
                                    ; original after_subst.life,
                                    ; `Container[int]^page_ptr(...)` loses
                                    ; the page-pointer arg at the ctor
                                    ; call site (`<null operand!>`).
                                    let inst this.instantiate_generic(canonical_name, canon_gens_inst, after_subst.loc)
                                    return PlannedType(
                                        inst.loc,
                                        inst.name,
                                        inst.mangled_name,
                                        inst.generics,
                                        after_subst.life,
                                        after_subst.origin,
                                        after_subst.array_size,
                                        after_subst.variable
                                    )
                                }
                            }
                        }
                }
            }

            let mangled Planner.mangle_structure(canonical_name, after_subst.generics)
            PlannedType(
                after_subst.loc,
                canonical_name,
                mangled,
                after_subst.generics,
                after_subst.life,
                after_subst.origin,
                after_subst.array_size,
                after_subst.variable
            )
        }

        ; ================================================================
        ; plan_item: Model.Item → PlannedItem.
        ;
        ; Handles the optional name and type annotation. Attributes are
        ; dropped for now — the PlannedItem carries `null` in that slot
        ; until attribute planning is ported.
        ;
        ; Returns-by-value copies the PlannedItem to the caller; the refs
        ; inside (name, item_type) point into single-element holder Vectors
        ; allocated on this function's rp, so they survive the caller's
        ; use of the returned PlannedItem.
        ; ================================================================
        function plan_item(this: Planner, i: Item) returns PlannedItem
        {
            var planned_name: ref[String]? null
            if i.name <> null
            {
                let n (*i.name)
                var name_holder Vector[String](1)
                name_holder.put(0, String(n))
                set planned_name: name_holder.get(0)
            }

            var planned_type: ref[PlannedType]? null
            if i.type <> null
            {
                let model_type (*i.type)
                set planned_type: &^this this.plan_type(model_type)
            }

            PlannedItem(
                i.span,
                i.private_,
                planned_name,
                planned_type,
                null
            )
        }

        ; plan_items: batch version of plan_item over a Vector[Item].
        ; Pre-allocates the result Vector at the correct size so we can
        ; use `put(i, ...)` instead of Array.add + copy.
        function plan_items(this: Planner, items: Vector[Item]) returns Vector[PlannedItem]
        {
            var result Vector[PlannedItem](items.length)
            var i: size_t 0
            while i < items.length
            {
                let item_ptr items.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    let pl this.plan_item(item)
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; plan_constant_operand: wrap a Constant literal as a PlannedOperand
        ; with its inferred type populated. The result_type is whatever
        ; infer_constant_type says at pre-solver time (e.g. IntegerConstant
        ; → "int", StringConstant → pointer[i8]).
        function plan_constant_operand(
            this: Planner,
            c: Constant,
            loc: Span
        ) returns PlannedOperand
        {
            let ty Planner.infer_constant_type(c)
            PlannedOperand(
                loc,
                PlannedExpression.Constant(scalyc.compiler.Plan.PlannedConstant c),
                null,
                ty
            )
        }

        ; ================================================================
        ; Simple Expression planners.
        ; ================================================================

        ; plan_sizeof: SizeOf(type) → PlannedSizeOf with computed byte
        ; size. get_primitive_alignment doubles as size for primitives
        ; but returns the catch-all 8 for any non-primitive — wrong for
        ; struct types like Module (80 B). Look the Concept up in the
        ; registry (set up during plan_program's namespace walk, before
        ; generic instantiation runs) and compute the size from its
        ; Model.Property list. Each property's contribution is either a
        ; primitive byte size or a hardcoded stdlib-container shape:
        ; Vector = 16 (length + data), String/HashMap = 8 (single ptr).
        ; That gives Module = 1 (bool) + 7 (pad) + 2*8 + 3*16 + 8 = 80,
        ; matching the LLVM struct layout. Without this, Vector(rp,len)
        ; for Vector[Module] allocates len*8 instead of len*80, and
        ; put(i, m) overruns and SEGVs build_program.
        function plan_sizeof(this: Planner, s: SizeOf) returns PlannedSizeOf
        {
            let sized this.plan_type(s.type)
            ; Delegate to compute_payload_size, which sizes primitives,
            ; the stdlib container shapes (Vector/Array/String/HashMap/...),
            ; Structures (recursing into each field) AND Unions (tag + max
            ; variant payload). The earlier inline Structure arm here sized
            ; each field via get_primitive_alignment, which returns the
            ; default 8 for a nested struct/union-typed field — so e.g.
            ; OperandSyntax (start+end+expression:ExpressionSyntax(232B)+
            ; postfixes) came out 32 not 256, and Vector[OperandSyntax].add
            ; under-allocated 32 bytes/element, truncating every operand's
            ; embedded expression to its first 16 bytes. compute_payload_size
            ; recurses, so nested struct/union fields are sized correctly.
            let size this.compute_payload_size(sized.name)
            PlannedSizeOf(s.span, sized, size)
        }

        ; plan_is: Is(name) is a runtime variant-tag test. At this site
        ; we resolve the test type and (best-effort) the union_name; the
        ; `variant_tag` and `value` fields get stitched in at the
        ; operand-sequence collapse site, which has the value operand.
        function plan_is(this: Planner, i: Is) returns PlannedIs
        {
            ; `x is null` — single-segment "null" name. Skip type
            ; resolution; the emitter compares the pointer to zero.
            if i.name.length = 1
            {
                let first_ptr i.name.get 0
                if first_ptr <> null
                {
                    if (*first_ptr).equals("null")
                        return PlannedIs(
                            i.span,
                            Planner.make_void_type(),
                            0,
                            "",
                            null,
                            true
                        )
                }
            }

            ; Resolve the dotted path as a Type so nested variant names
            ; like Option.Some pick up the full planned type. The
            ; variant_tag itself is filled in by the call site that
            ; pairs a PlannedIs with its value operand (needs the
            ; operand's union type, which plan_is doesn't see).
            let ty_path Vector[String](i.name)
            let ty Type(i.span, ty_path, null, Lifetime.Unspecified(Unspecified()))
            let test_type this.plan_type(ty)
            let union_name Planner.join_dotted_name(i.name)

            PlannedIs(
                i.span,
                test_type,
                0,
                union_name,
                null,
                false
            )
        }

        ; plan_as: `x as TargetType` — explicit cast. Resolves the
        ; target type; the value operand is stitched in at the use site
        ; (typically during collapse, like PlannedIs).
        function plan_as(this: Planner, a: scaly.compiler.Model.As) returns PlannedAs
        {
            let target this.plan_type(a.target_type)
            PlannedAs(a.span, target, null)
        }

        ; plan_alignof: alignof(Type) → size_t. Mirrors plan_sizeof.
        ; s106: take the alignment from get_primitive_alignment instead
        ; of hardcoding 0. Without this, every `alignof T` lowers to a
        ; literal 0 — observed first as init_lifetime's
        ; `page.allocate(sizeof int, alignof int)` passing align=0.
        function plan_alignof(
            this: Planner,
            a: scaly.compiler.Model.AlignOf
        ) returns PlannedAlignOf
        {
            let planned this.plan_type(a.type)
            let align Planner.get_primitive_alignment(planned.name)
            PlannedAlignOf(a.span, planned, align)
        }

        ; plan_type_operand: a Model.Type used as an operand can mean
        ; qualified_ref_is_dangling: a VALUE-position qualified name `X.Y`
        ; (exactly two segments) whose prefix X is a known NAMESPACE but whose
        ; suffix Y is not any member of it (function/operator/nested concept),
        ; not a registered concept/type (X.Y or bare Y), not a union variant,
        ; and not a global constant. Such a reference is a dangling qualified
        ; access — a typo like `NS.bogus` — that currently plans leniently as a
        ; bare Type operand (the emitter then produces garbage: `return NS.bogus`
        ; compiles and returns 0). This lets plan_type_operand#'s value fallback
        ; hard-error instead. Deliberately CONSERVATIVE — it fires only for a
        ; two-segment name with a resolvable NAMESPACE prefix, so deep paths,
        ; package/module names, type variables, generic params, struct static
        ; calls, and every real member are left untouched (no false positive).
        ; A parenless reference to a REAL member (`NS.real`, function not called)
        ; is NOT flagged — that is a separate lenient case, out of scope here.
        function qualified_ref_is_dangling(this: Planner, t: Type) returns bool
        {
            if t.name.length <> 2
                return false
            let prefix_ptr t.name.get 0
            let suffix_ptr t.name.get 1
            if prefix_ptr = null
                return false
            if suffix_ptr = null
                return false
            let prefix (*prefix_ptr)
            let suffix (*suffix_ptr)
            ; Self-namespace static call: `Planner.foo` inside a Planner method
            ; (prefix == current namespace) is flattened to a sibling call `foo`
            ; and resolved via the namespace-sibling path (s199) — the static
            ; functions live in the namespace concept, not model_functions, so
            ; is_function misses them. Never dangling; leave to the flatten pass.
            if current_namespace_name <> null
            {
                let cnsn (*current_namespace_name)
                if cnsn.equals(prefix)
                    return false
            }
            ; The whole dotted name or the bare suffix resolving to a concept
            ; means it is a real type / constructor target.
            let joined Planner.join_dotted_name(t.name)
            if this.has_concept(joined)
                return false
            if this.has_concept(suffix)
                return false
            ; A registered FUNCTION or OPERATOR named `suffix` (including static
            ; namespace functions like Planner.encode_name — a real call target
            ; whether parenful or parenless) resolves. is_function/is_operator
            ; are name-indexed over the whole program, so this excludes every
            ; real member regardless of where it is stored (namespace member
            ; vector vs symbol table vs struct static) — the robust signal that
            ; a manual member scan missed.
            if this.is_function(suffix)
                return false
            if this.is_operator(suffix)
                return false
            ; A global (module constant / mutable) under either name resolves.
            if this.lookup_global(joined) <> null
                return false
            if this.lookup_global(suffix) <> null
                return false
            ; A union variant `Union.Variant` resolves.
            if this.lookup_variant_tag(prefix, suffix) >= 0
                return false
            ; The prefix must be a known NAMESPACE — a genuine qualified-member
            ; access attempt (not a package/module name, type variable, generic
            ; param, or struct static receiver, which stay lenient).
            let ns_ref this.lookup_namespace_concept(prefix)
            if ns_ref = null
                return false
            ; A namespace-MEMBER function/operator/concept named `suffix` (a
            ; static reached cross-namespace or from top level, e.g. `NS.real()`
            ; — is_function only indexes top-level free functions, so it misses
            ; these). Scan the namespace concept's own members.
            let conc (*ns_ref)
            choose conc.definition
                when ns: Namespace
                {
                    var mi: size_t 0
                    while mi < ns.members.length
                    {
                        let m_ptr ns.members.get mi
                        if m_ptr <> null
                            choose (*m_ptr)
                                when mc: Concept
                                    if mc.name.equals(suffix)
                                        return false
                                when mo: Operator
                                    if mo.name.equals(suffix)
                                        return false
                                when mf: Function
                                    if mf.name.equals(suffix)
                                        return false
                                else
                                    0
                        set mi: mi + 1
                    }
                }
                else
                    0
            ; Prefix is a namespace; suffix is not a function, operator,
            ; concept, global, or variant anywhere → the reference dangles.
            true
        }

        ; different things depending on whether the name resolves to:
        ;   - a local variable in scope → PlannedVariable with its type
        ;   - a top-level function name → keep as Type, result is a
        ;     function reference (return-type filled in later during
        ;     call resolution)
        ;   - an actual type name → PlannedExpression.Type with the
        ;     planned type
        function plan_type_operand(this: Planner, t: Type, loc: Span) returns PlannedOperand
        {
            ; Single-name references are candidates for local-variable
            ; resolution. Dotted names always go to plan_type.
            if t.name.length = 1
            {
                let n_ptr t.name.get 0
                if n_ptr <> null
                {
                    let name (*n_ptr)

                    ; Bare null/true/false at expression position parse as
                    ; Type names; rewrite them as Constant operands so the
                    ; emitter sees the right shape. Mirrors
                    ; Planner.cpp:10148-10160.
                    if name.equals("null")
                    {
                        let c Constant.Null(NullConstant loc)
                        return this.plan_constant_operand(c, loc)
                    }
                    if name.equals("true")
                    {
                        let c Constant.Boolean(BooleanConstant(loc, true))
                        return this.plan_constant_operand(c, loc)
                    }
                    if name.equals("false")
                    {
                        let c Constant.Boolean(BooleanConstant(loc, false))
                        return this.plan_constant_operand(c, loc)
                    }

                    ; Local variable lookup.
                    let local this.lookup_local_binding(name)
                    if local <> null
                    {
                        let lb (*local)
                        return PlannedOperand(
                            loc,
                            PlannedExpression.Variable(PlannedVariable(
                                loc, name, lb.binding_type, lb.is_mutable
                            )),
                            null,
                            lb.binding_type
                        )
                    }

                    ; s88: sibling-global constant-fold. `define X: int K`
                    ; references like F_OK / SEEK_END must resolve to
                    ; their value or every caller silently drops the
                    ; whole statement (plan_type_operand# returning
                    ; PlannedExpression.Type → emit_call ignores it →
                    ; trailing `f(.., NAME) = K` becomes a no-op so the
                    ; function body emits only the default return).
                    ; Mirrors Planner.cpp:6950-6995. Single scalar
                    ; PlannedConstant inlines directly; non-constant or
                    ; multi-operand value falls back to PlannedGlobalRef.
                    let g_ref this.lookup_global(name)
                    if g_ref <> null
                    {
                        let g (*g_ref)
                        ; Mutable module globals must LOAD the current value on
                        ; every read — never inline the initializer constant.
                        ; Emit a GlobalRef; emit_global_ref loads it (s189).
                        if g.is_mutable
                            return PlannedOperand(
                                loc,
                                PlannedExpression.GlobalRef(PlannedGlobalRef(
                                    loc,
                                    g.name,
                                    g.mangled_name,
                                    g.global_type
                                )),
                                null,
                                g.global_type
                            )
                        if g.value <> null
                        {
                            let val_vec (*g.value)
                            if val_vec.length = 1
                            {
                                let v_ptr val_vec.get 0
                                if v_ptr <> null
                                {
                                    let v (*v_ptr)
                                    choose v.expr
                                        when c: scalyc.compiler.Plan.PlannedConstant
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Constant c,
                                                null,
                                                g.global_type
                                            )
                                        else
                                        {
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.GlobalRef(PlannedGlobalRef(
                                                    loc,
                                                    g.name,
                                                    g.mangled_name,
                                                    g.global_type
                                                )),
                                                null,
                                                g.global_type
                                            )
                                        }
                                }
                            }
                        }
                        return PlannedOperand(
                            loc,
                            PlannedExpression.GlobalRef(PlannedGlobalRef(
                                loc,
                                g.name,
                                g.mangled_name,
                                g.global_type
                            )),
                            null,
                            g.global_type
                        )
                    }

                    ; Implicit property access: when `name` matches a
                    ; field on T and `this: pointer[T]` is in scope,
                    ; rewrite as Variable("this") + member_access [name].
                    ; Mirrors Planner.cpp:7055-7097. Strings used in the
                    ; returned operand must live on rp, not the local
                    ; page — otherwise their data is freed when the
                    ; function returns.
                    let this_ref this.lookup_local("this")
                    if this_ref <> null
                    {
                        let this_ty (*this_ref)
                        if this_ty.name.equals("pointer")
                        {
                            if this_ty.generics <> null
                            {
                                let gens (*this_ty.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                    {
                                        let inner (*inner_ptr)
                                        let prop_ref this.lookup_property(inner.name, name)
                                        if prop_ref <> null
                                        {
                                            let prop (*prop_ref)
                                            var prop_type: PlannedType this.fresh_type_var("")
                                            if prop.type <> null
                                            {
                                                let pt2 (*prop.type)
                                                set prop_type: this.plan_type(pt2)
                                            }
                                            let idx this.get_property_index(inner.name, name)
                                            var ma_arr Array[PlannedMemberAccess]()
                                            ma_arr.add(PlannedMemberAccess(
                                                name, idx as size_t, false, false,
                                                inner, prop_type
                                            ))
                                            var ma_holder Vector[PlannedMemberAccess](ma_arr)
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, "this", this_ty, false
                                                )),
                                                &ma_holder,
                                                prop_type
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; Multi-element name: if the first segment is a local binding,
            ; treat the rest as a member-access chain. Mirrors
            ; Planner.cpp:6805-6826. Skip when the chain contains any
            ; method hop — stage-1's call resolution doesn't yet wire
            ; instance method dispatch, and forcing this path would
            ; surface emit_call SEGVs on the receiver.
            if t.name.length > 1
            {
                let first_ptr t.name.get 0
                if first_ptr <> null
                {
                    let first_name (*first_ptr)
                    let local this.lookup_local_binding(first_name)
                    if local <> null
                    {
                        let lb (*local)
                        var rest_arr Array[String]()
                        var k: size_t 1
                        while k < t.name.length
                        {
                            let seg_ptr t.name.get k
                            if seg_ptr <> null
                                rest_arr.add((*seg_ptr))
                            set k: k + 1
                        }
                        var rest_vec Vector[String](rest_arr)
                        ; Auto-deref pointer[T] / ref[T]: use the inner
                        ; generic as the base for member resolution.
                        var base_for_chain lb.binding_type
                        if lb.binding_type.name.equals("pointer")
                        {
                            if lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                if g.length > 0
                                {
                                    let ip g.get 0
                                    if ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        if lb.binding_type.name.equals("ref")
                        {
                            if lb.binding_type.generics <> null
                            {
                                let g (*lb.binding_type.generics)
                                if g.length > 0
                                {
                                    let ip g.get 0
                                    if ip <> null
                                        set base_for_chain: (*ip)
                                }
                            }
                        }
                        let access_chain this.resolve_member_access(
                            base_for_chain, rest_vec
                        )
                        var has_method: bool false
                        var ci: size_t 0
                        while ci < access_chain.length
                        {
                            let mp access_chain.get ci
                            if mp <> null
                            {
                                if (*mp).is_method
                                    set has_method: true
                            }
                            set ci: ci + 1
                        }
                        if has_method = false
                        {
                            var access_holder Vector[PlannedMemberAccess](access_chain)
                            var final_type lb.binding_type
                            if access_chain.length > 0
                            {
                                let last_ptr access_chain.get(access_chain.length - 1)
                                if last_ptr <> null
                                    set final_type: (*last_ptr).result_type
                            }
                            ; Escape soundness (hole-1 pass-to-callee): a
                            ; reference-like FIELD read off a TAINTED local
                            ; struct binding carries that struct's captured
                            ; &<frame-local>. Flip the inner pointee to Local on
                            ; the operand TYPE so the uniform is_reference_to_
                            ; local_page# check fires at the pass-to-callee POST-
                            ; PASS (the per-fn taint set is gone by then), just as
                            ; a direct &<frame-local> does. No-op unless first_name
                            ; is tainted (none in non-test code).
                            set final_type: this.taint_field_read_by_name(first_name, final_type)
                            return PlannedOperand(
                                loc,
                                PlannedExpression.Variable(PlannedVariable(
                                    loc, first_name, lb.binding_type, lb.is_mutable
                                )),
                                &access_holder,
                                final_type
                            )
                        }

                        ; Trailing-method chain on a local (e.g.
                        ; `o.inner.val()`): the chain has one or more
                        ; field hops followed by a method hop. Return the
                        ; Variable operand carrying the FULL chain so
                        ; collapse_operand_sequence#'s method-on-chain
                        ; dispatch (s83) truncates to the receiver
                        ; (last_acc.parent_type) and resolves the method.
                        ; Restricted to chains longer than one hop — the
                        ; 1-hop `local.method()` case keeps its existing
                        ; dotted-name qualified-call path to avoid
                        ; regressing it. Without this, multi-hop method
                        ; calls fell through to plan_type# (a dotted Type
                        ; operand whose `()` looked like a free call to a
                        ; non-existent function) and the whole call was
                        ; dropped — breaking every `m.members.get(i)` /
                        ; `m.modules.get(i)` loop body in plan_module# and
                        ; register_module_concepts.
                        ; s171: relaxed from `> 1` to `> 0`. A single-hop
                        ; method chain on a local (e.g. parenless
                        ; `name.length`, `sb.get_length`) must also return
                        ; the Variable+chain operand so collapse_operand_
                        ; sequence# can build the call — with a trailing
                        ; Tuple via the s83 method-on-chain dispatch, or
                        ; without one via the s171 parenless-zero-arg path
                        ; (ops.length==1 synthesizes an empty `()` Tuple).
                        ; Previously single-hop fell through to plan_type#
                        ; as a dotted Type "s.length", which the parenless
                        ; case can't resolve, dropping encode_name's
                        ; `let len name.length` and corrupting every mangled
                        ; name. Only local-variable receivers reach here
                        ; (namespaces aren't locals → still take the
                        ; qualified-call path), so rerouting 1-hop method
                        ; calls is safe.
                        if has_method
                        {
                            if access_chain.length > 0
                            {
                                let last_ptr access_chain.get(access_chain.length - 1)
                                if last_ptr <> null
                                {
                                    if (*last_ptr).is_method
                                    {
                                        var access_holder_m Vector[PlannedMemberAccess](access_chain)
                                        let final_type_m (*last_ptr).result_type
                                        return PlannedOperand(
                                            loc,
                                            PlannedExpression.Variable(PlannedVariable(
                                                loc, first_name, lb.binding_type, lb.is_mutable
                                            )),
                                            &access_holder_m,
                                            final_type_m
                                        )
                                    }
                                }
                            }
                        }
                    }

                    ; Implicit-this multi-segment fallback: when first_name
                    ; matches a property of T (where this: pointer[T]),
                    ; build a chain starting from `this` with all segments
                    ; resolved against T. Mirrors Planner.cpp:7055-7097 +
                    ; chain-building from 6805-6826. Skip when the chain
                    ; contains any method hop — same constraint as the
                    ; local-binding branch above.
                    let this_ref2 this.lookup_local("this")
                    if this_ref2 <> null
                    {
                        let this_ty2 (*this_ref2)
                        if this_ty2.name.equals("pointer")
                        {
                            if this_ty2.generics <> null
                            {
                                let gens2 (*this_ty2.generics)
                                if gens2.length > 0
                                {
                                    let inner_ptr2 gens2.get 0
                                    if inner_ptr2 <> null
                                    {
                                        let inner2 (*inner_ptr2)
                                        let prop_ref2 this.lookup_property(inner2.name, first_name)
                                        if prop_ref2 <> null
                                        {
                                            var all_arr Array[String]()
                                            var k2: size_t 0
                                            while k2 < t.name.length
                                            {
                                                let sp t.name.get k2
                                                if sp <> null
                                                    all_arr.add((*sp))
                                                set k2: k2 + 1
                                            }
                                            var all_vec Vector[String](all_arr)
                                            let chain2 this.resolve_member_access(inner2, all_vec)
                                            ; s87: skip removed (was `var has_method2 / while /
                                            ; if has_method2 = false` wrapper preserved through
                                            ; s83-s86). With s87's emit_variable struct/ptr-alloca
                                            ; fix and s86's heap-copy in MemberAssignment, the
                                            ; method-on-chain dispatch now works at runtime.
                                            var holder2 Vector[PlannedMemberAccess](chain2)
                                            var ft2 inner2
                                            if chain2.length > 0
                                            {
                                                let lp2 chain2.get(chain2.length - 1)
                                                if lp2 <> null
                                                    set ft2: (*lp2).result_type
                                            }
                                            return PlannedOperand(
                                                loc,
                                                PlannedExpression.Variable(PlannedVariable(
                                                    loc, "this", this_ty2, false
                                                )),
                                                &holder2,
                                                ft2
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; Dangling qualified reference (e.g. `NS.bogus` where NS is a
            ; namespace with no member `bogus`): hard-error rather than plan a
            ; lenient bare Type operand the emitter would turn into garbage. A
            ; parenful `NS.bogus()` already errors via the call path; this closes
            ; the parenless value-position hole.
            if this.qualified_ref_is_dangling(t)
            {
                let dangling_name Planner.join_dotted_name(t.name)
                var dsb StringBuilder()
                dsb.append "not found: "
                dsb.append dangling_name
                this.add_diagnostic(loc, dsb.to_string())
            }

            let pt this.plan_type(t)
            PlannedOperand(
                loc,
                PlannedExpression.Type pt,
                null,
                pt
            )
        }

        ; ================================================================
        ; Control-flow planners.
        ; ================================================================

        ; statement_result_type: extract the PlannedType produced by a
        ; statement used as an expression. Covers the Action case (the
        ; common `if cond x else y` shape); non-value statements
        ; (Return/Throw/Break/Continue/Binding) return void.
        function statement_result_type(s: PlannedStatement) returns PlannedType
        {
            choose s
                when a: PlannedAction
                    a.result_type
                else
                    Planner.make_void_type()
        }

        ; plan_if: plans the condition (a Vector[Operand]), the consequent
        ; statement, and optionally the alternative. Emits a bool
        ; constraint on the condition and (when an alternative exists)
        ; unifies the two branches' result types.
        function plan_if(this: Planner, f: If) returns PlannedIf
        {
            let planned_cond_flat this.plan_operands(f.condition)
            let planned_cond_collapsed this.collapse_operand_sequence(planned_cond_flat)
            let bool_ty Planner.make_bool_type()
            this.add_equality_constraint(bool_ty, planned_cond_collapsed.result_type, f.span)

            let planned_consequent this.plan_statement(f.consequent)
            var consequent_holder Vector[PlannedStatement](1)
            consequent_holder.put(0, planned_consequent)

            var alternative_ref: ref[PlannedStatement]? null
            if f.alternative <> null
            {
                let alt (*f.alternative)
                let planned_alt this.plan_statement(alt)
                var alt_holder Vector[PlannedStatement](1)
                alt_holder.put(0, planned_alt)
                set alternative_ref: alt_holder.get(0)

                ; Unify the consequent and alternative result types so an
                ; `if` used as an expression has a single type. Skips
                ; voids (pure statements contribute no constraint).
                let cons_ty Planner.statement_result_type(planned_consequent)
                let alt_ty Planner.statement_result_type(planned_alt)
                if cons_ty.name.equals("void") = false
                    if alt_ty.name.equals("void") = false
                        this.add_equality_constraint(cons_ty, alt_ty, f.span)
            }

            var cond_holder Vector[PlannedOperand](1)
            cond_holder.put(0, planned_cond_collapsed)
            PlannedIf(
                f.span,
                &cond_holder,
                null,
                consequent_holder.get 0,
                alternative_ref
            )
        }

        ; plan_lambda: anonymous function literal. Opens a fresh scope,
        ; seeds each parameter with a fresh type variable (lambdas omit
        ; parameter type annotations), plans the body Action, and
        ; synthesizes a unique mangled name. Captures are the set of
        ; variable names referenced in the body that aren't lambda
        ; parameters — a best-effort over-approximation (inner bindings
        ; may leak in) that the emitter can intersect with the real
        ; outer scope.
        ; collect_free_names: walk a PlannedOperand's expression tree
        ; and accumulate the names of every PlannedVariable reference
        ; encountered. Recurses into Call args, Tuple components, and
        ; If/Match/Block/Choose sub-statements. Used by plan_lambda's
        ; capture-discovery pass — captures are this set minus any
        ; lambda-local names (params + inner bindings).
        function collect_free_names(
            this: Planner,
            op: PlannedOperand,
            acc: Array[String]
        )
        {
            choose op.expr
                when v: PlannedVariable
                    acc.add v.name
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                                this.collect_free_names((*a_ptr), acc)
                            set i: i + 1
                        }
                    }
                    0
                }
                when tup: PlannedTuple
                {
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                if c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get j
                                        if v_ptr <> null
                                            this.collect_free_names((*v_ptr), acc)
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0
        }

        ; Recursive lambda-body name walkers used by monomorphize_lambda#'s
        ; capture discovery. Unlike collect_free_names (which only reaches
        ; Variable/Call/Tuple, so a block-bodied lambda's captures were missed
        ; entirely), these recurse through every compound expression and
        ; statement. They are FLOW-SENSITIVE within a linear statement
        ; sequence: `bound` is maintained in evaluation order, and a name a
        ; body PlannedBinding (or a for-loop / when / try identifier)
        ; introduces is added to `bound` ONLY AFTER its initializer is walked.
        ; A PlannedVariable USE is recorded into `uses` (a capture candidate)
        ; only when its name is not yet in `bound` at that point — so a use
        ; that lexically PRECEDES a body binding of the same name (the
        ; use-before-bind case `let n n + 1` over an enclosing `n`) captures
        ; the enclosing value, while a use AFTER the binding is the local.
        ; Ordinary shadowing (`let n 3; x + n`, no preceding use) stays local.
        ; The walk is also SCOPE-ACCURATE, not just linear: every construct
        ; that pushes a planner scope (block, for/while/repeat body, choose /
        ; match / try when-arm, try-else) records the bound-set length on entry
        ; and TRUNCATES back on exit (`set bound.length:` — `bound` is passed by
        ; reference), so a name bound only inside a nested block or sibling
        ; branch does NOT suppress a capture of an enclosing same-named variable
        ; used after it. `if` branches, choose/match `else`, and the try-bound
        ; name are NOT scoped/truncated here because plan_if/plan_choose/
        ; plan_match don't push a scope for them and the try binding leaks into
        ; the enclosing scope — mirroring the planner exactly keeps "bound at
        ; this point" equal to "pass-1 resolved this use to a body-local".
        function name_in_string_array(this: Planner, arr: Array[String], name: String) returns bool
        {
            var i: size_t 0
            while i < arr.length
            {
                let p arr.get i
                if p <> null
                    if (*p).equals(name)
                        return true
                set i: i + 1
            }
            false
        }

        function collect_lambda_names_ops(this: Planner, ops_ref: ref[Vector[PlannedOperand]]?, uses: Array[String], bound: Array[String])
        {
            if ops_ref = null
                return
            let ops (*ops_ref)
            var i: size_t 0
            while i < ops.length
            {
                let p ops.get i
                if p <> null
                    this.collect_lambda_names((*p), uses, bound)
                set i: i + 1
            }
        }

        function collect_lambda_names_action(this: Planner, act: PlannedAction, uses: Array[String], bound: Array[String])
        {
            this.collect_lambda_names_ops(act.source, uses, bound)
            this.collect_lambda_names_ops(act.target, uses, bound)
        }

        function collect_lambda_names_stmt(this: Planner, stmt: PlannedStatement, uses: Array[String], bound: Array[String])
        {
            choose stmt
                when a: PlannedAction
                    this.collect_lambda_names_action(a, uses, bound)
                when b: PlannedBinding
                {
                    ; Evaluation order: the initializer runs BEFORE the new
                    ; binding is in scope, so walk it first (a use of the
                    ; binding's own name in its initializer captures the
                    ; enclosing variable), then mark the name bound.
                    this.collect_lambda_names_ops(b.operation, uses, bound)
                    if b.binding_item.name <> null
                        bound.add (*b.binding_item.name)
                }
                when r: PlannedReturn
                    this.collect_lambda_names_ops(r.result, uses, bound)
                when th: PlannedThrow
                    this.collect_lambda_names_ops(th.result, uses, bound)
                when brk: PlannedBreak
                    this.collect_lambda_names_ops(brk.result, uses, bound)
                else
                    0
        }

        function collect_lambda_names_stmts(this: Planner, stmts_ref: ref[Vector[PlannedStatement]]?, uses: Array[String], bound: Array[String])
        {
            if stmts_ref = null
                return
            let stmts (*stmts_ref)
            var i: size_t 0
            while i < stmts.length
            {
                let p stmts.get i
                if p <> null
                    this.collect_lambda_names_stmt((*p), uses, bound)
                set i: i + 1
            }
        }

        function collect_lambda_names_stmt_opt(this: Planner, stmt_ref: ref[PlannedStatement]?, uses: Array[String], bound: Array[String])
        {
            if stmt_ref = null
                return
            this.collect_lambda_names_stmt((*stmt_ref), uses, bound)
        }

        function collect_lambda_names(this: Planner, op: PlannedOperand, uses: Array[String], bound: Array[String])
        {
            choose op.expr
                when v: PlannedVariable
                {
                    if this.name_in_string_array(bound, v.name) = false
                        uses.add v.name
                    0
                }
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                                this.collect_lambda_names((*a_ptr), uses, bound)
                            set i: i + 1
                        }
                    }
                    0
                }
                when tup: PlannedTuple
                {
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                this.collect_lambda_names_ops(c.value, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                when blk: PlannedBlock
                {
                    ; A block is a nested scope (plan_block push/pops one), so
                    ; its bindings must NOT leak to code after the block or to
                    ; a sibling branch. Record the bound-set length, walk, then
                    ; truncate back — dropping names bound inside the block so a
                    ; later use of an enclosing same-named variable still
                    ; captures. `bound` is pass-by-ref; `set .length:` truncates.
                    let mark bound.length
                    this.collect_lambda_names_stmts(blk.statements, uses, bound)
                    set bound.length: mark
                    0
                }
                when iff: PlannedIf
                {
                    this.collect_lambda_names_ops(iff.condition, uses, bound)
                    this.collect_lambda_names_stmt_opt(iff.consequent, uses, bound)
                    this.collect_lambda_names_stmt_opt(iff.alternative, uses, bound)
                    0
                }
                when ch: PlannedChoose
                {
                    this.collect_lambda_names_ops(ch.condition, uses, bound)
                    if ch.cases <> null
                    {
                        let whens (*ch.cases)
                        var i: size_t 0
                        while i < whens.length
                        {
                            let w_ptr whens.get i
                            if w_ptr <> null
                            {
                                ; Each when-arm is its own scope (plan_when
                                ; push/pops): the pattern name + arm-local
                                ; bindings must not leak to sibling arms, the
                                ; else, or code after the choose. Mark/truncate.
                                let mark bound.length
                                let w (*w_ptr)
                                if w.name.get_length() > 0
                                    bound.add w.name
                                this.collect_lambda_names_stmt_opt(w.consequent, uses, bound)
                                set bound.length: mark
                            }
                            set i: i + 1
                        }
                    }
                    ; The else is planned in the current scope (no push in
                    ; plan_choose), like an if branch — no mark/truncate.
                    this.collect_lambda_names_stmt_opt(ch.alternative, uses, bound)
                    0
                }
                when mt: PlannedMatch
                {
                    this.collect_lambda_names_ops(mt.condition, uses, bound)
                    if mt.branches <> null
                    {
                        let brs (*mt.branches)
                        var i: size_t 0
                        while i < brs.length
                        {
                            let b_ptr brs.get i
                            if b_ptr <> null
                            {
                                let br (*b_ptr)
                                if br.cases <> null
                                {
                                    let cs (*br.cases)
                                    var j: size_t 0
                                    while j < cs.length
                                    {
                                        let cp cs.get j
                                        if cp <> null
                                            this.collect_lambda_names_ops((*cp).condition, uses, bound)
                                        set j: j + 1
                                    }
                                }
                                this.collect_lambda_names_stmt_opt(br.consequent, uses, bound)
                            }
                            set i: i + 1
                        }
                    }
                    this.collect_lambda_names_stmt_opt(mt.alternative, uses, bound)
                    0
                }
                when fr: PlannedFor
                {
                    ; The loop identifier + body live in the loop's pushed
                    ; scope (plan_for); the collection expr is evaluated before
                    ; the identifier is in scope. Mark, walk expr, bind the
                    ; identifier, walk body, truncate.
                    let mark bound.length
                    this.collect_lambda_names_ops(fr.expr, uses, bound)
                    if fr.identifier.get_length() > 0
                        bound.add fr.identifier
                    this.collect_lambda_names_action(fr.body, uses, bound)
                    set bound.length: mark
                    0
                }
                when wh: PlannedWhile
                {
                    ; while-let's bound name + body live in the loop scope
                    ; (plan_while); the condition operation runs before the
                    ; name is in scope. Mark, walk cond, bind name, walk body.
                    let mark bound.length
                    this.collect_lambda_names_ops(wh.cond.operation, uses, bound)
                    if wh.cond.binding_item.name <> null
                        bound.add (*wh.cond.binding_item.name)
                    this.collect_lambda_names_action(wh.body, uses, bound)
                    set bound.length: mark
                    0
                }
                when rp: PlannedRepeat
                {
                    ; repeat body is a pushed scope (plan_repeat).
                    let mark bound.length
                    this.collect_lambda_names_action(rp.body, uses, bound)
                    set bound.length: mark
                    0
                }
                when as_e: scalyc.compiler.Plan.PlannedAs
                {
                    if as_e.value <> null
                        this.collect_lambda_names((*as_e.value), uses, bound)
                    0
                }
                when is_e: scalyc.compiler.Plan.PlannedIs
                {
                    if is_e.value <> null
                        this.collect_lambda_names((*is_e.value), uses, bound)
                    0
                }
                when tr: PlannedTry
                {
                    ; The try-bound name (`try let q ...`) LEAKS into the
                    ; enclosing scope (plan_try binds it in the current scope,
                    ; no push) — the success path falls through past the try
                    ; with it in scope. So walk its initializer, then add the
                    ; name to the CURRENT scope WITHOUT truncating.
                    this.collect_lambda_names_ops(tr.cond.operation, uses, bound)
                    if tr.cond.binding_item.name <> null
                        bound.add (*tr.cond.binding_item.name)
                    if tr.catches <> null
                    {
                        let cats (*tr.catches)
                        var i: size_t 0
                        while i < cats.length
                        {
                            let w_ptr cats.get i
                            if w_ptr <> null
                            {
                                ; Each catch arm is its own scope (plan_when).
                                let mark bound.length
                                let w (*w_ptr)
                                if w.name.get_length() > 0
                                    bound.add w.name
                                this.collect_lambda_names_stmt_opt(w.consequent, uses, bound)
                                set bound.length: mark
                            }
                            set i: i + 1
                        }
                    }
                    ; The try-else gets its own pushed scope (plan_try).
                    let alt_mark bound.length
                    this.collect_lambda_names_stmt_opt(tr.alternative, uses, bound)
                    set bound.length: alt_mark
                    0
                }
                else
                    0
        }

        function plan_lambda(this: Planner, lam: Lambda) returns PlannedLambda
        {
            this.push_scope()

            var planned_items Vector[PlannedItem](lam.input.length)
            var i: size_t 0
            while i < lam.input.length
            {
                let it_ptr lam.input.get i
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    let pi this.plan_item(it)
                    planned_items.put(i, pi)

                    var param_type: PlannedType Planner.make_void_type()
                    if pi.item_type <> null
                        set param_type: (*pi.item_type)
                    if pi.item_type = null
                    {
                        ; Lambda parameters omit type annotations; give
                        ; each a fresh type variable that the solver
                        ; later unifies against the call site.
                        var pname: String ""
                        if it.name <> null
                            set pname: (*it.name)
                        set param_type: this.fresh_type_var(pname)
                    }

                    if it.name <> null
                    {
                        let n (*it.name)
                        this.define_parameter(n, param_type)
                    }
                }
                set i: i + 1
            }

            let planned_body this.plan_action(lam.body)

            ; Capture discovery: walk the body operands collecting all
            ; variable-name references, then filter out names that match
            ; one of the lambda's own parameters. The remainder is the
            ; captures set (best-effort: inner bindings declared inside
            ; the body can leak in, but it's a safe over-approximation
            ; that the emitter can intersect with the real scope).
            var free_names Array[String]()
            if planned_body.source <> null
            {
                let src (*planned_body.source)
                var si: size_t 0
                while si < src.length
                {
                    let s_ptr src.get si
                    if s_ptr <> null
                        this.collect_free_names((*s_ptr), free_names)
                    set si: si + 1
                }
            }

            var captures_arr Array[String]()
            var fi: size_t 0
            while fi < free_names.length
            {
                let nm_ptr free_names.get fi
                if nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    var is_param: bool false
                    var pj: size_t 0
                    while pj < lam.input.length
                    {
                        let p_ptr lam.input.get pj
                        if p_ptr <> null
                        {
                            if p_ptr.name <> null
                            {
                                let pn (*p_ptr.name)
                                if pn.equals(nm)
                                    set is_param: true
                            }
                        }
                        set pj: pj + 1
                    }
                    var already: bool false
                    var di: size_t 0
                    while di < captures_arr.length
                    {
                        let d_ptr captures_arr.get di
                        if d_ptr <> null
                        {
                            if (*d_ptr).equals(nm)
                                set already: true
                        }
                        set di: di + 1
                    }
                    if is_param = false && already = false
                        captures_arr.add(String(nm))
                }
                set fi: fi + 1
            }

            this.pop_scope()

            let lam_id next_lambda_id
            set next_lambda_id: lam_id + 1
            var name_sb StringBuilder()
            name_sb.append "_ZN6lambda"
            name_sb.append(Planner.size_to_string lam_id)
            name_sb.append "Ev"
            let mangled name_sb.to_string()

            var items_holder Vector[PlannedItem](planned_items)
            var captures_holder Vector[String](captures_arr)
            var captures_ref: ref[Vector[String]]? null
            if captures_holder.length > 0
                set captures_ref: &captures_holder

            PlannedLambda(
                lam.span,
                mangled,
                &items_holder,
                planned_body,
                planned_body.result_type,
                captures_ref
            )
        }

        ; Phase-1 lambda monomorphization: given a lambda model and the
        ; call-site argument types, synthesize (and record, once) a concrete
        ; top-level function whose parameters take those arg types, plan its
        ; body, and return the function's mangled name. The call site then
        ; resolves to a direct call to this function (see the lambda-call
        ; intercept in collapse_operand_sequence#). Cached per mangled name
        ; via has_recorded_function so repeated calls with identical arg
        ; types reuse the same function.
        function monomorphize_lambda(this: Planner, base_name: String, lam: Lambda, arg_types: Vector[PlannedType]) returns LambdaMonoResult
        {
            ; ---- Pass 1: discover captures. Plan the body in a scope with the
            ; lambda's own params defined; the enclosing scope is still on the
            ; stack so a captured `n` resolves there. A captured name is a free
            ; variable that, AFTER popping (params + body-locals gone), still
            ; resolves via lookup_local_binding — i.e. it lives in an enclosing
            ; scope. Captures become leading parameters; the call site passes
            ; the captured VALUES as leading args (capture by value).
            this.push_scope()
            var pnames Array[String]()
            var p1i: size_t 0
            while p1i < lam.input.length
            {
                let it_ptr lam.input.get p1i
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    var pty1: PlannedType this.fresh_type_var("")
                    if p1i < arg_types.length
                    {
                        let at_ptr arg_types.get p1i
                        if at_ptr <> null
                            set pty1: (*at_ptr)
                    }
                    if it.name <> null
                    {
                        let pn (*it.name)
                        pnames.add(String(pn))
                        this.define_parameter(pn, pty1)
                    }
                }
                set p1i: p1i + 1
            }
            let body1 this.plan_action(lam.body)
            var free Array[String]()
            var body_bound Array[String]()
            this.collect_lambda_names_ops(body1.source, free, body_bound)
            this.collect_lambda_names_ops(body1.target, free, body_bound)
            this.pop_scope()

            var cap_names Array[String]()
            var cap_types Array[PlannedType]()
            var fi: size_t 0
            while fi < free.length
            {
                let nm_ptr free.get fi
                if nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    var is_param: bool false
                    var pj: size_t 0
                    while pj < pnames.length
                    {
                        let pn_ptr pnames.get pj
                        if pn_ptr <> null
                            if (*pn_ptr).equals(nm)
                                set is_param: true
                        set pj: pj + 1
                    }
                    var already: bool false
                    var dj: size_t 0
                    while dj < cap_names.length
                    {
                        let d_ptr cap_names.get dj
                        if d_ptr <> null
                            if (*d_ptr).equals(nm)
                                set already: true
                        set dj: dj + 1
                    }
                    ; `free` already excludes uses that follow a body-local
                    ; binding of the same name (collect_lambda_names records a
                    ; use only while its name is not yet bound), so a name here
                    ; is a genuine capture even if it is ALSO rebound later
                    ; (the use-before-bind case). No post-hoc shadow filter.
                    if is_param = false
                        if already = false
                        {
                            let lb this.lookup_local_binding(nm)
                            if lb <> null
                            {
                                cap_names.add(String(nm))
                                cap_types.add((*lb).binding_type)
                            }
                        }
                }
                set fi: fi + 1
            }

            ; ---- mangled name = base + capture type mangles + arg type mangles
            var ml_sb StringBuilder()
            ml_sb.append "_ZN6lambdaN"
            ml_sb.append base_name
            ml_sb.append "E"
            var cmi: size_t 0
            while cmi < cap_types.length
            {
                let ct_ptr cap_types.get cmi
                if ct_ptr <> null
                {
                    let ct (*ct_ptr)
                    ml_sb.append "_c"
                    if ct.mangled_name.get_length() > 0
                        ml_sb.append ct.mangled_name
                    else
                        ml_sb.append ct.name
                }
                set cmi: cmi + 1
            }
            var mi: size_t 0
            while mi < arg_types.length
            {
                let mat_ptr arg_types.get mi
                if mat_ptr <> null
                {
                    let mat (*mat_ptr)
                    ml_sb.append "_"
                    if mat.mangled_name.get_length() > 0
                        ml_sb.append mat.mangled_name
                    else
                        ml_sb.append mat.name
                }
                set mi: mi + 1
            }
            ml_sb.append "Ev"
            let mangled ml_sb.to_string()

            var caps_holder Vector[String](cap_names)
            var caps_ref: ref[Vector[String]]? null
            if caps_holder.length > 0
                set caps_ref: &caps_holder

            ; Already synthesized for this (captures, arg types) — reuse.
            if this.has_recorded_function(mangled)
                return LambdaMonoResult(mangled, caps_ref)

            ; ---- Pass 2: plan with captures + params as parameters.
            this.push_scope()
            var item_arr Array[PlannedItem]()
            var ci: size_t 0
            while ci < cap_names.length
            {
                let cn_ptr cap_names.get ci
                let ct_ptr cap_types.get ci
                if cn_ptr <> null
                    if ct_ptr <> null
                    {
                        let cn (*cn_ptr)
                        let ct (*ct_ptr)
                        var cn_holder Vector[String](1)
                        cn_holder.put(0, String(cn))
                        this.define_parameter(cn, ct)
                        item_arr.add(PlannedItem(lam.span, false, cn_holder.get(0), &^this ct, null))
                    }
                set ci: ci + 1
            }
            var pi2: size_t 0
            while pi2 < lam.input.length
            {
                let it_ptr lam.input.get pi2
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    var pty: PlannedType this.fresh_type_var("")
                    if pi2 < arg_types.length
                    {
                        let at_ptr arg_types.get pi2
                        if at_ptr <> null
                            set pty: (*at_ptr)
                    }
                    var pname_ref: ref[String]? null
                    if it.name <> null
                    {
                        let pn (*it.name)
                        var name_holder Vector[String](1)
                        name_holder.put(0, String(pn))
                        set pname_ref: name_holder.get(0)
                        this.define_parameter(pn, pty)
                    }
                    item_arr.add(PlannedItem(it.span, false, pname_ref, &^this pty, null))
                }
                set pi2: pi2 + 1
            }
            let planned_body this.plan_action(lam.body)
            this.pop_scope()

            var items_holder Vector[PlannedItem](item_arr)
            var rt_holder Vector[PlannedType](1)
            rt_holder.put(0, planned_body.result_type)
            let synth_fn PlannedFunction(
                lam.span,
                false,
                false,
                mangled,
                mangled,
                null,
                &items_holder,
                rt_holder.get(0),
                null,
                Lifetime.Unspecified(Unspecified()),
                PlannedImplementation.Action(planned_body),
                null,
                false,
                false,
                null,
                this.file
            )
            this.record_function(synth_fn)
            LambdaMonoResult(mangled, caps_ref)
        }

        ; GAP B substep 2: build a closure VALUE for a lambda assigned to a
        ; delegate type. Monomorphizes the real lambda against the delegate's
        ; parameter types (captures become leading params, reused from
        ; monomorphize_lambda#), then packages a PlannedClosure carrying the
        ; real symbol, a generated thunk symbol, the closure record type name,
        ; and the captured VALUES (looked up here, where they are in scope) +
        ; their types. The emitter lowers it to a heap `{ptr thunk, caps...}`
        ; record; the thunk bridges the uniform `R(ptr self, params)` call
        ; shape to `real(caps..., params)`. `life` is the record's allocation
        ; lifetime (local region, or `#` caller page when the closure escapes).
        function make_closure(this: Planner, base_name: String, lam: Lambda, dparams: Vector[PlannedType], dret: PlannedType, del_pt: PlannedType, life: Lifetime) returns PlannedClosure
        {
            let mono this.monomorphize_lambda(base_name, lam, dparams)
            var cap_ops Array[PlannedOperand]()
            var cap_tys Array[PlannedType]()
            if mono.captures <> null
            {
                let caps (*mono.captures)
                var ci: size_t 0
                while ci < caps.length
                {
                    let cn_ptr caps.get ci
                    if cn_ptr <> null
                    {
                        let cn (*cn_ptr)
                        let lb this.lookup_local_binding(cn)
                        if lb <> null
                        {
                            let cty (*lb).binding_type
                            let cmut (*lb).is_mutable
                            let cvar PlannedVariable(lam.span, String(cn), cty, cmut)
                            let cop PlannedOperand(lam.span, PlannedExpression.Variable cvar, null, cty)
                            cap_ops.add cop
                            cap_tys.add cty
                        }
                    }
                    set ci: ci + 1
                }
            }
            var thunk_sb StringBuilder()
            thunk_sb.append mono.mangled
            thunk_sb.append "_thunk"
            let thunk_name thunk_sb.to_string()
            var clo_sb StringBuilder()
            clo_sb.append "clo_"
            clo_sb.append mono.mangled
            let clo_type_name clo_sb.to_string()
            var cap_ops_holder Vector[PlannedOperand](cap_ops)
            var cap_tys_holder Vector[PlannedType](cap_tys)
            var dparams_holder Vector[PlannedType](dparams)
            PlannedClosure(
                lam.span,
                thunk_name,
                mono.mangled,
                clo_type_name,
                &cap_ops_holder,
                &cap_tys_holder,
                &dparams_holder,
                dret,
                del_pt,
                life
            )
        }

        ; plan_repeat: do-while body runs at least once; the terminating
        ; condition lives inside the body action via `break` or an
        ; embedded if. Nothing else to constrain at this level.
        function plan_repeat(this: Planner, r: Repeat) returns PlannedRepeat
        {
            this.push_scope()
            let planned_body this.plan_action(r.action)
            this.pop_scope()
            ; A `repeat` is an infinite loop exiting only via break. Its value
            ; (for `let x repeat { ... break v ... }`) is the type of the first
            ; break-with-value targeting this repeat; void when none.
            let value_type this.find_break_type_in_operands(planned_body.source)
            PlannedRepeat(r.span, planned_body, r.loop_label, value_type)
        }

        ; Recursive break-value-type finder. Descends through if/choose/match
        ; consequents and nested blocks, but NOT into nested while/for/repeat
        ; bodies (an unlabeled break there targets the inner loop, not this
        ; repeat). Returns void when no break-with-value is found.
        function find_break_type_in_operands(this: Planner, ops: ref[Vector[PlannedOperand]]?) returns PlannedType
        {
            if ops = null
                return Planner.make_void_type()
            let v (*ops)
            var i: size_t 0
            while i < v.length
            {
                let op_ptr v.get i
                if op_ptr <> null
                {
                    let t this.find_break_type_in_expr((*op_ptr).expr)
                    if t.name.equals("void") = false
                        return t
                }
                set i: i + 1
            }
            Planner.make_void_type()
        }

        function find_break_type_in_statement(this: Planner, s: PlannedStatement) returns PlannedType
        {
            choose s
                when br: PlannedBreak
                {
                    if br.result = null
                        return Planner.make_void_type()
                    let res (*br.result)
                    if res.length = 0
                        return Planner.make_void_type()
                    let op_ptr res.get 0
                    if op_ptr = null
                        return Planner.make_void_type()
                    (*op_ptr).result_type
                }
                when a: PlannedAction
                    this.find_break_type_in_operands(a.source)
                else
                    Planner.make_void_type()
        }

        function find_break_type_in_stmt_ref(this: Planner, s: ref[PlannedStatement]?) returns PlannedType
        {
            if s = null
                return Planner.make_void_type()
            this.find_break_type_in_statement(*s)
        }

        function find_break_type_in_expr(this: Planner, e: PlannedExpression) returns PlannedType
        {
            choose e
                when blk: PlannedBlock
                {
                    if blk.statements = null
                        return Planner.make_void_type()
                    let stmts (*blk.statements)
                    var i: size_t 0
                    while i < stmts.length
                    {
                        let sp stmts.get i
                        if sp <> null
                        {
                            let t this.find_break_type_in_statement(*sp)
                            if t.name.equals("void") = false
                                return t
                        }
                        set i: i + 1
                    }
                    Planner.make_void_type()
                }
                when ife: PlannedIf
                {
                    let tc this.find_break_type_in_stmt_ref(ife.consequent)
                    if tc.name.equals("void") = false
                        return tc
                    this.find_break_type_in_stmt_ref(ife.alternative)
                }
                when ch: PlannedChoose
                {
                    if ch.cases <> null
                    {
                        let cases (*ch.cases)
                        var i: size_t 0
                        while i < cases.length
                        {
                            let cp cases.get i
                            if cp <> null
                            {
                                let t this.find_break_type_in_stmt_ref((*cp).consequent)
                                if t.name.equals("void") = false
                                    return t
                            }
                            set i: i + 1
                        }
                    }
                    this.find_break_type_in_stmt_ref(ch.alternative)
                }
                when mt: PlannedMatch
                {
                    if mt.branches <> null
                    {
                        let brs (*mt.branches)
                        var i: size_t 0
                        while i < brs.length
                        {
                            let bp brs.get i
                            if bp <> null
                            {
                                let t this.find_break_type_in_stmt_ref((*bp).consequent)
                                if t.name.equals("void") = false
                                    return t
                            }
                            set i: i + 1
                        }
                    }
                    this.find_break_type_in_stmt_ref(mt.alternative)
                }
                else
                    Planner.make_void_type()
        }

        ; plan_while: Binding condition + Action body. The binding opens
        ; a short-lived scope for the loop variable. Emits a constraint
        ; that the planned binding's type is bool (the solver promotes
        ; `while let maybe_x = ...` through Option's None sentinel, so
        ; this is a reasonable approximation today).
        function plan_while(this: Planner, w: While) returns PlannedWhile
        {
            this.push_scope()
            let planned_cond this.plan_binding(w.condition)
            let planned_body this.plan_action(w.action)
            this.pop_scope()

            ; Two shapes reach this point:
            ;   `while cond`          — binding has no name; we constrain
            ;                           its declared type to bool.
            ;   `while let x = opt`   — binding has a name; x takes the
            ;                           Option's Some payload. If the
            ;                           operation's result type is
            ;                           Option[T] we constrain x to T, so
            ;                           the solver sees the unwrapped
            ;                           type.
            let bool_ty Planner.make_bool_type()
            if planned_cond.binding_item.name = null
            {
                ; Plain `while cond` — bool constraint applies if the
                ; binding's item_type is explicit.
                if planned_cond.binding_item.item_type <> null
                {
                    let bt (*planned_cond.binding_item.item_type)
                    this.add_equality_constraint(bool_ty, bt, w.span)
                }
            }
            if planned_cond.binding_item.name <> null
            {
                if planned_cond.binding_item.item_type <> null
                {
                    if planned_cond.operation <> null
                    {
                        let ops (*planned_cond.operation)
                        if ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            if last_ptr <> null
                            {
                                let op_ty (*last_ptr).result_type
                                if op_ty.name.equals("Option")
                                {
                                    if op_ty.generics <> null
                                    {
                                        let gens (*op_ty.generics)
                                        if gens.length > 0
                                        {
                                            let payload_ptr gens.get 0
                                            if payload_ptr <> null
                                            {
                                                let bt (*planned_cond.binding_item.item_type)
                                                this.add_equality_constraint(
                                                    bt, (*payload_ptr), w.span
                                                )
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            PlannedWhile(w.span, planned_cond, planned_body, w.loop_label)
        }

        ; plan_for: loop variable bound to each element of `expression`.
        ; Two shapes are supported, matching the C++ Planner:
        ;   1. Integer range: `for i in N` — element type == N's type.
        ;   2. Iterator protocol: `for x in collection` — resolve
        ;      `get_iterator` on the collection type, then `next` on the
        ;      iterator type; the element type is what `next` returns.
        ; Option[T] and ref/pointer wrappers on the collection type are
        ; peeled before the dispatch.
        function plan_for(this: Planner, f: For) returns PlannedFor
        {
            this.push_scope()
            let planned_expr this.plan_operands(f.expression)
            let collapsed_expr this.collapse_operand_sequence(planned_expr)

            var coll_type: PlannedType collapsed_expr.result_type

            ; Auto-unwrap Option[T] → T on the collection side.
            if coll_type.name.equals("Option")
            {
                if coll_type.generics <> null
                {
                    let gens (*coll_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set coll_type: (*g_ptr)
                    }
                }
            }

            ; Peel ref[T] / pointer[T] to reach the underlying struct.
            ; Stage-1 multi-line `or` chains in a if condition do not
            ; short-circuit correctly (the LF continuation surfaces `set`
            ; as a top-level statement). Mirror the C++ Planner using
            ; per-name guards.
            var iter_type: PlannedType coll_type
            var is_pointer_like: bool false
            if iter_type.name.equals("ref")
                set is_pointer_like: true
            if iter_type.name.equals("pointer")
                set is_pointer_like: true
            if is_pointer_like
            {
                if iter_type.generics <> null
                {
                    let gens (*iter_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set iter_type: (*g_ptr)
                    }
                }
            }

            ; Stage-1 multi-line `or` chains do not short-circuit (LF
            ; continuation surfaces `set` as a top-level statement, which
            ; runs unconditionally). Use per-name guards so each one
            ; matches its own primitive name.
            var is_integer: bool false
            if iter_type.name.equals("int")
                set is_integer: true
            if iter_type.name.equals("int8")
                set is_integer: true
            if iter_type.name.equals("int16")
                set is_integer: true
            if iter_type.name.equals("int32")
                set is_integer: true
            if iter_type.name.equals("int64")
                set is_integer: true
            if iter_type.name.equals("size_t")
                set is_integer: true
            if iter_type.name.equals("uint8")
                set is_integer: true
            if iter_type.name.equals("uint16")
                set is_integer: true
            if iter_type.name.equals("uint32")
                set is_integer: true
            if iter_type.name.equals("uint64")
                set is_integer: true

            var is_iterator_loop: bool false
            var iterator_type: PlannedType Planner.make_void_type()
            var element_type: PlannedType Planner.make_void_type()
            var get_iter_name: String ""
            var next_name: String ""

            if is_integer
            {
                set element_type: iter_type
            }
            if is_integer = false
            {
                ; get_iterator / next are zero-arg (only `this`), so an
                ; empty arg_types list drives lookup_method#'s overload
                ; selection.
                var no_args_arr Array[PlannedType]()
                let no_args Vector[PlannedType](no_args_arr)
                let get_iter_match this.lookup_method(iter_type, "get_iterator", no_args)
                if get_iter_match <> null
                {
                    let gm (*get_iter_match)
                    set is_iterator_loop: true
                    set iterator_type: gm.return_type
                    set get_iter_name: gm.mangled_name

                    let next_match this.lookup_method(iterator_type, "next", no_args)
                    if next_match <> null
                    {
                        let nm (*next_match)
                        set next_name: nm.mangled_name
                        set element_type: nm.return_type
                    }
                }
                if get_iter_match = null
                {
                    ; No get_iterator: fall back to the iterable's first
                    ; generic (what Vec[T] / List[T] would yield), or
                    ; the iter_type itself if no generics.
                    var fell_back: bool false
                    if iter_type.generics <> null
                    {
                        let gens (*iter_type.generics)
                        if gens.length > 0
                        {
                            let g_ptr gens.get 0
                            if g_ptr <> null
                            {
                                set element_type: (*g_ptr)
                                set fell_back: true
                            }
                        }
                    }
                    if fell_back = false
                        set element_type: iter_type
                }
            }

            this.define_local(f.identifier, element_type, false, false)

            let planned_body this.plan_action(f.action)
            this.pop_scope()

            var expr_holder Vector[PlannedOperand](planned_expr)
            PlannedFor(
                f.span,
                f.identifier,
                &expr_holder,
                planned_body,
                is_iterator_loop,
                coll_type,
                iterator_type,
                element_type,
                get_iter_name,
                next_name,
                f.loop_label
            )
        }

        ; plan_try: try { binding } catch WhenPatterns else alt.
        function plan_try(this: Planner, t: Try) returns PlannedTry
        {
            ; The try-bound variable (e.g. `try let q ...`) leaks into the
            ; ENCLOSING scope: the success path is the only way execution
            ; falls through past the try block, where the binding is in
            ; scope. So plan the binding in the current scope — do NOT push
            ; a scope around it. plan_when# scopes each catch arm; the else
            ; arm gets its own scope below.
            let planned_bind this.plan_binding(t.binding)

            ; Detect a throwing-call condition. A throws function returns the
            ; Result wrapper { i8 status, [N x i8] data }; on error the data
            ; field holds the thrown error union INLINE. The catch arms select
            ; error variants of the function's `throws T` union (NOT the
            ; success type), so resolve them against the throws union.
            var is_throwing: bool false
            var throws_type: PlannedType Planner.make_void_type()
            var union_for_catches: PlannedType Planner.make_void_type()
            if planned_bind.operation <> null
            {
                let ops (*planned_bind.operation)
                if ops.length > 0
                {
                    let last_ptr ops.get(ops.length - 1)
                    if last_ptr <> null
                    {
                        let last_op (*last_ptr)
                        set union_for_catches: last_op.result_type
                        choose last_op.expr
                            when call: Call
                            {
                                if call.can_throw
                                {
                                    set is_throwing: true
                                    if call.throws_type <> null
                                    {
                                        set throws_type: (*call.throws_type)
                                        set union_for_catches: (*call.throws_type)
                                    }
                                }
                            }
                            else
                                0
                    }
                }
            }

            var catches_arr Array[PlannedWhen]()
            var ci: size_t 0
            while ci < t.catches.length
            {
                let w_ptr t.catches.get ci
                if w_ptr <> null
                {
                    let w (*w_ptr)
                    catches_arr.add(this.plan_when(w, union_for_catches, false, null))
                }
                set ci: ci + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if t.alternative <> null
            {
                this.push_scope()
                let alt (*t.alternative)
                set alternative_ref: &^this this.plan_statement(alt)
                this.pop_scope()
            }

            var catches_holder Vector[PlannedWhen](catches_arr)
            PlannedTry(t.span, planned_bind, &catches_holder, alternative_ref, throws_type, is_throwing)
        }

        ; plan_when: one pattern arm of choose/try. When `union_type` is
        ; non-null and names a registered union concept, the variant's
        ; payload type and tag index are resolved so the Emitter can
        ; extract the payload and compare tags correctly. When union_type
        ; is void (the fallback from plan_try with no exception type),
        ; the arm still plans but variant_type stays void and tag stays 0.
        function plan_when(
            this: Planner,
            w: When,
            union_type: PlannedType,
            is_throws_call: bool,
            throws_ty: ref[PlannedType]?
        ) returns PlannedWhen
        {
            this.push_scope()

            ; Resolve the variant's payload type and tag against the
            ; enclosing union. `w.name` is the binding identifier
            ; (e.g. `s` in `when s: Some`); the variant *type* name
            ; lives in `w.variant` (last segment for dotted paths).
            ; Fall back to a fresh type variable when the union isn't
            ; resolvable (e.g. when called from plan_try before
            ; exception types land).
            var binding_ty: PlannedType this.fresh_type_var("")
            var variant_type: PlannedType Planner.make_void_type()
            var variant_tag: size_t 0

            var variant_name: String ""
            if w.variant.length > 0
            {
                let last_ptr w.variant.get(w.variant.length - 1)
                if last_ptr <> null
                    set variant_name: (*last_ptr)
            }

            if union_type.name.equals("void") = false
            {
                ; s184: bind the union's generic parameters to the
                ; scrutinee's generic args before planning the payload
                ; type — `when v: Some` over Option[int] must type v as
                ; int, not T (which maps to ptr and drops the implicit
                ; return). Same pattern as the s81 ctor-diversion site.
                let saved_subst_when type_substitutions.length
                if union_type.generics <> null
                {
                    let wgens (*union_type.generics)
                    let wconc_ref this.lookup_concept(union_type.name)
                    if wconc_ref <> null
                    {
                        let wconc (*wconc_ref)
                        var wpi: size_t 0
                        while wpi < wconc.parameters.length
                        {
                            if wpi < wgens.length
                            {
                                let wp_ptr wconc.parameters.get wpi
                                let wg_ptr wgens.get wpi
                                if wp_ptr <> null
                                {
                                    if wg_ptr <> null
                                        this.define_type_substitution(wp_ptr.name, (*wg_ptr))
                                }
                            }
                            set wpi: wpi + 1
                        }
                    }
                }
                let payload_ref this.lookup_variant_type(
                    union_type.name, variant_name
                )
                set type_substitutions.length: saved_subst_when
                if payload_ref <> null
                {
                    set binding_ty: (*payload_ref)
                    set variant_type: (*payload_ref)
                }
                let tag this.lookup_variant_tag(union_type.name, variant_name)
                if tag >= 0
                    set variant_tag: tag as size_t
            }

            ; s143: throws-call synthetic Error/Success variant assignment.
            ; Mirrors stage-0 Planner.cpp:11363-11382. When the surrounding
            ; choose's condition is a throwing call AND the union lookup
            ; failed (variant_type still void), recognise the synthetic
            ; "Error"/"err"/"error" and "Success"/"Ok"/"ok"/"value"/"node"
            ; case names and assign variant_index 1 / 0 respectively.
            ; Without this, emit_choose's seen_tags dedup collapses both
            ; cases on variant_index=0, the second case body gets dropped,
            ; and the s142 default-redirect picks whichever arm comes first
            ; in source order — so cli.run's `choose parse_program() when
            ; err: Error / when program: Success` always takes the err arm
            ; on hello.scaly and prints "Parse error" even when parsing
            ; succeeds. Distinct variant_indices unblock the natural
            ; first-byte-of-sret-slot dispatch: parse_X#'s emit_return
            ; stores the struct (start.size_t low byte = 0 for hello.scaly
            ; → Success arm); emit_throw stores tag=1 at offset 0 → Error
            ; arm. Result union wrapping is the proper fix (1-2 day
            ; refactor) but isn't required for hello.scaly's narrow path.
            if variant_type.name.equals("void")
            {
                if is_throws_call
                {
                    let is_error variant_name.equals("Error")
                    var is_err: bool is_error
                    if is_err = false
                        set is_err: variant_name.equals("err")
                    if is_err = false
                        set is_err: variant_name.equals("error")
                    if is_err
                    {
                        set variant_tag: 1
                        if throws_ty <> null
                        {
                            let tt (*throws_ty)
                            set binding_ty: tt
                            set variant_type: tt
                        }
                    }
                    if is_err = false
                    {
                        let is_success variant_name.equals("Success")
                        var is_ok: bool is_success
                        if is_ok = false
                            set is_ok: variant_name.equals("Ok")
                        if is_ok = false
                            set is_ok: variant_name.equals("ok")
                        if is_ok = false
                            set is_ok: variant_name.equals("value")
                        if is_ok = false
                            set is_ok: variant_name.equals("node")
                        if is_ok
                        {
                            ; s172: bind the success arm to the call's
                            ; result type (stage-0 Planner.cpp:11377-11380
                            ; PW.VariantType = ValueType). Without this,
                            ; binding_ty stays a fresh no-name type var,
                            ; resolve_member_access# finds no properties
                            ; on `success.field`, every hop defaults to
                            ; field_index 0, and parse_routine's
                            ; ReturnsSyntax(success.start, success.end,
                            ; success.type, ...) rebuilds the syntax with
                            ; field 0 in every slot — stage-2 then sees
                            ; empty type names ("int" → "", mangling
                            ; _Z3addPN4scaly6memory4PageE, no bodies).
                            set variant_tag: 0
                            set binding_ty: union_type
                            set variant_type: union_type
                        }
                    }
                }
            }

            this.define_local(w.name, binding_ty, false, false)

            let cons_box &^this this.plan_statement(w.consequent)
            this.pop_scope()

            PlannedWhen(
                w.span,
                w.name,
                variant_type,
                variant_tag,
                cons_box
            )
        }

        ; plan_choose: Scaly's choose/when pattern match.
        ; Phase-5 class 2 helpers (choose-payload back-prop). True when ops
        ; is exactly one bare single-segment name equal to `name`.
        function ops_are_bare_name(ops: Vector[Operand], name: String) returns bool
        {
            if ops.length <> 1
                return false
            let p ops.get 0
            if p = null
                return false
            if (*p).member_access <> null
                return false
            choose (*p).expression
                when t: scalyc.compiler.Model.Type
                {
                    if t.generics = null
                        if t.name.length = 1
                        {
                            let np t.name.get 0
                            if np <> null
                                return (*np).equals(name)
                        }
                }
                else
                    0
            false
        }

        function binding_flows_payload_to_escaping(this: Planner, b: scalyc.compiler.Model.Binding, payload: String) returns bool
        {
            if b.item.name = null
                return false
            if Planner.ops_are_bare_name(b.operation, payload) = false
                return false
            let bn (*b.item.name)
            if this.array_contains_name(escaping_return_locals, bn)
                return true
            if this.array_contains_name(escaping_targets, bn)
                return true
            false
        }

        function action_flows_payload_to_escaping(this: Planner, a: Action, payload: String) returns bool
        {
            ; direct `set TARGET: payload` — a bare single-segment target
            ; that the completed escape sets mark escaping
            if a.target.length = 1
            {
                if Planner.ops_are_bare_name(a.source, payload)
                {
                    let tp a.target.get 0
                    if tp <> null
                    {
                        if (*tp).member_access = null
                            choose (*tp).expression
                                when tt: scalyc.compiler.Model.Type
                                {
                                    if tt.generics = null
                                        if tt.name.length = 1
                                        {
                                            let tnp tt.name.get 0
                                            if tnp <> null
                                            {
                                                if this.array_contains_name(escaping_return_locals, (*tnp))
                                                    return true
                                                if this.array_contains_name(escaping_targets, (*tnp))
                                                    return true
                                            }
                                        }
                                }
                                else
                                    0
                    }
                }
                return false
            }
            ; braced consequent: descend the block's statements
            if a.source.length = 1
            {
                let op0 a.source.get 0
                if op0 <> null
                    choose (*op0).expression
                        when bk: Block
                        {
                            var i: size_t 0
                            while i < bk.statements.length
                            {
                                let sp bk.statements.get i
                                if sp <> null
                                    if this.stmt_flows_payload_to_escaping((*sp), payload)
                                        return true
                                set i: i + 1
                            }
                        }
                        else
                            0
            }
            false
        }

        function stmt_flows_payload_to_escaping(this: Planner, s: Statement, payload: String) returns bool
        {
            choose s
                when a: scalyc.compiler.Model.Action
                    return this.action_flows_payload_to_escaping(a, payload)
                when b: scalyc.compiler.Model.Binding
                    return this.binding_flows_payload_to_escaping(b, payload)
                else
                    return false
            false
        }

        ; Phase-5 class 2: does this when-arm's consequent store the arm
        ; payload BARE into a local that the completed escape sets mark
        ; escaping (`when prog: Success set syntax: prog`, where `syntax`
        ; later feeds the returned Module)? Field-read sources (`ok.text`)
        ; are not covered in this increment — the compiler's shapes store
        ; the payload bare.
        function when_payload_flows_to_escaping(this: Planner, w: When) returns bool
        {
            this.stmt_flows_payload_to_escaping(w.consequent, w.name)
        }

        function plan_choose(this: Planner, c: Choose) returns PlannedChoose
        {
            let planned_cond this.plan_operands(c.condition)
            ; Fold the choose condition down to a single value to
            ; recover its type — that's the union each `when` pattern
            ; selects a variant of.
            var collapsed_cond this.collapse_operand_sequence(planned_cond)
            ; GAP 1 (when-arm-escape): when a when-arm BINDING name escapes
            ; (is returned / stored into an escaping aggregate — collected by
            ; the set-reassignment / flow-graph machinery into
            ; escaping_return_locals), the choose SCRUTINEE call's result flows
            ; out through that arm binding, so it must live on the caller page.
            ; The arm binding has no plan_binding# to restamp its init — its
            ; init IS this scrutinee — so promote a defaulted-Local/Unspecified
            ; scrutinee construction to rp here. NEUTRAL on sigiled source: an
            ; explicit `#`/`^` scrutinee carries Call/Reference life, which
            ; restamp_operand_life# keeps verbatim (returns null).
            var arm_escapes: bool false
            var ae_i: size_t 0
            while ae_i < c.cases.length
            {
                let ae_wp c.cases.get ae_i
                if ae_wp <> null
                {
                    let ae_w (*ae_wp)
                    if ae_w.name.get_length() > 0
                    {
                        if this.array_contains_name(escaping_return_locals, ae_w.name)
                            set arm_escapes: true
                        ; Phase-5 class 2 (choose-payload back-prop): the arm
                        ; binding itself is often NOT in the escaping sets —
                        ; the linear pre-scan visits the arm's `set X: payload`
                        ; BEFORE X's own escape is collected (X escapes via a
                        ; LATER statement, e.g. build_referenced_module's tail
                        ; `build_module(..., syntax.file, ...)`), so the
                        ; set-reassign back-prop's gate is false at visit time
                        ; and the payload name is never added. At PLAN time the
                        ; sets are complete, so walk the arm consequent for a
                        ; reassignment (or re-binding) of the payload into an
                        ; escaping local. The scrutinee's guts flow out through
                        ; that store — same promotion as the arm-name check.
                        if arm_escapes = false
                            if this.when_payload_flows_to_escaping(ae_w)
                                set arm_escapes: true
                    }
                }
                set ae_i: ae_i + 1
            }
            if arm_escapes
            {
                let ae_life Lifetime.Call(scalyc.compiler.Model.Call(c.span))
                let ae_promoted this.restamp_operand_life(collapsed_cond, ae_life)
                if ae_promoted <> null
                    set collapsed_cond: (*ae_promoted)
            }
            ; s173: peel ref[T]/pointer[T] off the condition type so
            ; plan_when# can resolve the union's variants. A for-in loop
            ; variable is typed ref[T] (the iterator's next() return),
            ; so `choose stmt` over Vector[PlannedStatement] otherwise
            ; looks up variants on "ref" — every arm keeps tag 0 plus a
            ; fresh binding type, emit_choose's seen_tags dedup drops all
            ; but the first arm, and the NPO null-check path hijacks the
            ; dispatch. Mirrors stage-0 Planner.cpp:11247-11250.
            var union_type: PlannedType collapsed_cond.result_type
            var peel_cond: bool false
            if union_type.name.equals("ref")
                set peel_cond: true
            if union_type.name.equals("pointer")
                set peel_cond: true
            if peel_cond
            {
                if union_type.generics <> null
                {
                    let gens (*union_type.generics)
                    if gens.length > 0
                    {
                        let g_ptr gens.get 0
                        if g_ptr <> null
                            set union_type: (*g_ptr)
                    }
                }
            }

            ; Ensure a cross-package union scrutinee has its layout planned so
            ; the emitter extracts the variant payload at the right offset
            ; (rather than off the s114 { ptr } placeholder). No-op for the
            ; compiler's own builds and for opaque stdlib types.
            this.ensure_union_layout(union_type.name)

            ; s143: detect a throws-call as the choose condition. plan_when#
            ; needs this so it can assign distinct variant_index to the
            ; synthetic "Error" / "Success" arms, otherwise both collide on
            ; variant_index=0 and emit_choose's seen_tags dedup drops the
            ; second arm. See plan_when# comment for the full rationale.
            var is_throws_call: bool false
            var throws_ty_ref: ref[PlannedType]? null
            choose collapsed_cond.expr
                when call: Call
                {
                    set is_throws_call: call.can_throw
                    if call.throws_type <> null
                        set throws_ty_ref: call.throws_type
                }
                else
                    0

            var cases_arr Array[PlannedWhen]()
            var i: size_t 0
            while i < c.cases.length
            {
                let w_ptr c.cases.get i
                if w_ptr <> null
                {
                    let w (*w_ptr)
                    cases_arr.add(this.plan_when(w, union_type, is_throws_call, throws_ty_ref))
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if c.alternative <> null
            {
                let alt (*c.alternative)
                set alternative_ref: &^this this.plan_statement(alt)
            }

            ; Unify each when-arm's consequent result type (plus the
            ; optional alternative) so choose-as-expression has a single
            ; type. Voids are skipped — statement-only arms contribute
            ; no constraint.
            if cases_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type()
                var have_first: bool false
                var wi: size_t 0
                while wi < cases_arr.length
                {
                    let w_ptr cases_arr.get wi
                    if w_ptr <> null
                    {
                        let pw (*w_ptr)
                        if pw.consequent <> null
                        {
                            let cons_ref (*pw.consequent)
                            let arm_ty Planner.statement_result_type(cons_ref)
                            if arm_ty.name.equals("void") = false
                            {
                                if have_first = false
                                {
                                    set first_ty: arm_ty
                                    set have_first: true
                                }
                                if have_first
                                    this.add_equality_constraint(
                                        first_ty, arm_ty, pw.loc
                                    )
                            }
                        }
                    }
                    set wi: wi + 1
                }
                if alternative_ref <> null
                {
                    if have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        if alt_ty.name.equals("void") = false
                            this.add_equality_constraint(first_ty, alt_ty, c.span)
                    }
                }
            }

            ; Store the COLLAPSED single operand, not the flat list.
            ; emit_operands only emits the first operand (assuming
            ; callers have already collapsed); storing the flat
            ; `[get_color, ()]` would emit only `get_color` and miss
            ; the call. plan_if has this same shape (~line 5096).
            var cond_holder Vector[PlannedOperand](1)
            cond_holder.put(0, collapsed_cond)
            var cases_holder Vector[PlannedWhen](cases_arr)
            PlannedChoose(c.span, &cond_holder, &cases_holder, alternative_ref)
        }

        ; plan_case / plan_branch / plan_match: the full match-expression form.
        function plan_case(this: Planner, cs: Case) returns PlannedCase
        {
            let planned_cond this.plan_operands(cs.condition)
            var cond_holder Vector[PlannedOperand](planned_cond)
            PlannedCase(cs.span, &cond_holder)
        }

        function plan_branch(this: Planner, b: Branch) returns PlannedBranch
        {
            var cases_arr Array[PlannedCase]()
            var i: size_t 0
            while i < b.cases.length
            {
                let cs_ptr b.cases.get i
                if cs_ptr <> null
                {
                    let cs (*cs_ptr)
                    cases_arr.add(this.plan_case(cs))
                }
                set i: i + 1
            }

            let cons_box &^this this.plan_statement(b.consequent)

            var cases_holder Vector[PlannedCase](cases_arr)
            PlannedBranch(b.span, &cases_holder, cons_box)
        }

        function plan_match(this: Planner, m: Match) returns PlannedMatch
        {
            let planned_cond this.plan_operands(m.condition)
            ; Fold the match condition so its result_type is
            ; comparable against each case's collapsed condition type.
            let collapsed_cond this.collapse_operand_sequence(planned_cond)
            let cond_type collapsed_cond.result_type

            var branches_arr Array[PlannedBranch]()
            var i: size_t 0
            while i < m.branches.length
            {
                let b_ptr m.branches.get i
                if b_ptr <> null
                {
                    let b (*b_ptr)
                    let planned_branch this.plan_branch(b)

                    ; Each case's condition must be the same type as the
                    ; match condition. Emit an equality constraint so
                    ; the HM solver rejects mismatches.
                    if planned_branch.cases <> null
                    {
                        let cases (*planned_branch.cases)
                        var ci: size_t 0
                        while ci < cases.length
                        {
                            let case_ptr cases.get ci
                            if case_ptr <> null
                            {
                                let case_cond (*case_ptr)
                                if case_cond.condition <> null
                                {
                                    let cond_list (*case_cond.condition)
                                    let collapsed_case this.collapse_operand_sequence(cond_list)
                                    this.add_equality_constraint(
                                        cond_type,
                                        collapsed_case.result_type,
                                        case_cond.loc
                                    )
                                }
                            }
                            set ci: ci + 1
                        }
                    }

                    branches_arr.add planned_branch
                }
                set i: i + 1
            }

            var alternative_ref: ref[PlannedStatement]? null
            if m.alternative <> null
            {
                let alt (*m.alternative)
                set alternative_ref: &^this this.plan_statement(alt)
            }

            ; Unify all branch consequent result types (and the
            ; alternative when present) so the match-as-expression has
            ; a single type. Voids are skipped — pure-statement
            ; branches contribute no constraint.
            if branches_arr.length > 0
            {
                var first_ty: PlannedType Planner.make_void_type()
                var have_first: bool false
                var bi: size_t 0
                while bi < branches_arr.length
                {
                    let br_ptr branches_arr.get bi
                    if br_ptr <> null
                    {
                        let br (*br_ptr)
                        if br.consequent <> null
                        {
                            let cons (*br.consequent)
                            let br_ty Planner.statement_result_type(cons)
                            if br_ty.name.equals("void") = false
                            {
                                if have_first = false
                                {
                                    set first_ty: br_ty
                                    set have_first: true
                                }
                                if have_first
                                    this.add_equality_constraint(
                                        first_ty, br_ty, br.loc
                                    )
                            }
                        }
                    }
                    set bi: bi + 1
                }
                if alternative_ref <> null
                {
                    if have_first
                    {
                        let alt (*alternative_ref)
                        let alt_ty Planner.statement_result_type(alt)
                        if alt_ty.name.equals("void") = false
                            this.add_equality_constraint(first_ty, alt_ty, m.span)
                    }
                }
            }

            var cond_holder Vector[PlannedOperand](planned_cond)
            var branches_holder Vector[PlannedBranch](branches_arr)
            PlannedMatch(m.span, &cond_holder, &branches_holder, alternative_ref)
        }

        ; ================================================================
        ; Tuples and matrices.
        ; ================================================================

        ; plan_component: Model.Component → PlannedComponent.
        ; Mirrors Planner.cpp:10499-10512 — each component's operand
        ; sequence is collapsed so prefix ops like `*p` and method-call
        ; arguments resolve against the collapsed result rather than the
        ; raw operand sequence. emit_tuple's grouping shortcut emits
        ; comp.value[0], so without this collapse `(*p).field` would
        ; emit only the leading `Type("*")` operand and produce null.
        function plan_component(this: Planner, c: Component) returns PlannedComponent
        {
            let planned_value this.plan_operands(c.value)
            var name_ref: ref[String]? null
            if c.name <> null
            {
                let n (*c.name)
                var holder Vector[String](1)
                holder.put(0, String(n))
                set name_ref: holder.get(0)
            }
            ; Collapse when the operand sequence either starts with a
            ; prefix operator (`*p`, `-x`, `!flag`, ...) or contains a
            ; postfix `as`/`is` operand (`x as T`, `y is V`). emit_tuple's
            ; grouping shortcut emits comp.value[0]; without collapse,
            ; `(*p).field` would emit only the leading `Type("*")`
            ; operand and `f(x as T)` would surface as two args to f
            ; (`extract_tuple_arg_types` reads each operand's
            ; result_type), failing arity match. Other shapes are left
            ; untouched — running them through collapse_operand_sequence#
            ; adds String allocations that surface a latent
            ; dangling-String bug in resolve_function_call when stage-1
            ; self-compiles.
            var should_collapse: bool false
            if planned_value.length > 1
            {
                let f0_ptr planned_value.get 0
                if f0_ptr <> null
                {
                    let f0 (*f0_ptr)
                    choose f0.expr
                        when ty: PlannedType
                        {
                            if Planner.is_operator_name(ty.name)
                                set should_collapse: true
                        }
                        else
                            0
                }
                if should_collapse = false
                {
                    var k: size_t 1
                    while k < planned_value.length
                    {
                        let op_ptr planned_value.get k
                        if op_ptr <> null
                        {
                            let op (*op_ptr)
                            choose op.expr
                                when a: PlannedAs
                                    set should_collapse: true
                                when i: PlannedIs
                                    set should_collapse: true
                                when tp: PlannedTuple
                                {
                                    ; Call/construction shape: a Tuple at
                                    ; k>=1 is an argument list following a
                                    ; callee/concept (`f(x)`, `Point(3, 4)`,
                                    ; `abs (- 5)`). Without collapse the
                                    ; grouped form `(f x)` keeps the raw
                                    ; 2-operand sequence and emit_tuple's
                                    ; grouping shortcut emits only the
                                    ; callee operand — the whole statement
                                    ; silently drops.
                                    set should_collapse: true
                                }
                                when mx: scalyc.compiler.Plan.PlannedMatrix
                                {
                                    ; Subscript shape: a Matrix at k>=1 is
                                    ; an index (`(v[0])`) or a generic arg
                                    ; list — either way the collapse pre-
                                    ; passes own the pair. Without this the
                                    ; grouping shortcut emits only the base
                                    ; operand and the subscript silently
                                    ; drops.
                                    set should_collapse: true
                                }
                                when ty: PlannedType
                                {
                                    ; s90: binary operator at k>=1 (e.g.
                                    ; `x = y`, `a + b`, `p <> null`) means
                                    ; the operand sequence must collapse to
                                    ; a single PlannedCall. Without this,
                                    ; tuple components carrying a binary
                                    ; comparison as a function arg leave
                                    ; planned_value as a 3-operand sequence,
                                    ; emit_tuple's per-component arg path
                                    ; only sees the first operand, the call
                                    ; arity-mismatches, returns null, and
                                    ; the entire `let X = f(...arg-with-cmp...)`
                                    ; binding plus its `if X = false`
                                    ; follower silently drop. Mirrors stage-
                                    ; 0's planTuple at Planner.cpp:10506-10511
                                    ; (unconditional collapse on every
                                    ; component value).
                                    if Planner.is_operator_name(ty.name)
                                        set should_collapse: true
                                    ; Named infix operators (`div`, `mod`)
                                    ; are not operator-shaped names, but a
                                    ; name WITH a precedence at k>=1 sits in
                                    ; operator position — collapse so the
                                    ; binary loop can build the call.
                                    if Planner.get_operator_precedence(ty.name) > 0
                                        set should_collapse: true
                                    ; A declared text-named operator (e.g.
                                    ; `'minus'`) is neither operator-shaped nor
                                    ; in the precedence table, but still sits in
                                    ; operator position — collapse so a
                                    ; parenthesized `(a 'op' b)` (e.g. a binding
                                    ; init or the literate-test wrapper) folds
                                    ; into the call instead of dropping to its
                                    ; RHS. Stage-0 collapses unconditionally
                                    ; (Planner.cpp:10506).
                                    if this.is_operator(ty.name)
                                        set should_collapse: true
                                }
                                else
                                    0
                        }
                        set k: k + 1
                    }
                }
            }
            if should_collapse = false
            {
                var mc: size_t 0
                while mc < planned_value.length
                {
                    let mop_ptr planned_value.get mc
                    if mop_ptr <> null
                    {
                        let mop (*mop_ptr)
                        if mop.member_access <> null
                        {
                            let mma (*mop.member_access)
                            if mma.length > 0
                            {
                                let mh_ptr mma.get(mma.length - 1)
                                if mh_ptr <> null
                                {
                                    if (*mh_ptr).is_method
                                        set should_collapse: true
                                }
                            }
                        }
                    }
                    set mc: mc + 1
                }
            }
            ; s184: generic-argument shape — a bare Type followed by a
            ; Matrix (`Option[int].None` as a lone argument). Collapse
            ; runs the s107 [Type, Matrix] merge; without it the raw
            ; pair reaches emit_tuple, which emits only the bare Type
            ; operand and the statement silently drops.
            if should_collapse = false
            {
                if planned_value.length > 1
                {
                    let g0_ptr planned_value.get 0
                    let g1_ptr planned_value.get 1
                    if g0_ptr <> null
                    {
                        if g1_ptr <> null
                        {
                            var g0_bare_type: bool false
                            choose (*g0_ptr).expr
                                when g0t: PlannedType
                                {
                                    if g0t.generics = null
                                        set g0_bare_type: true
                                }
                                else
                                    0
                            if g0_bare_type
                            {
                                choose (*g1_ptr).expr
                                    when g1m: scalyc.compiler.Plan.PlannedMatrix
                                        set should_collapse: true
                                    else
                                        0
                            }
                        }
                    }
                }
            }
            var value_holder Vector[PlannedOperand](planned_value)
            if should_collapse
            {
                let collapsed this.collapse_operand_sequence(planned_value)
                var collapsed_arr Array[PlannedOperand]()
                collapsed_arr.add collapsed
                set value_holder: Vector[PlannedOperand](collapsed_arr)
            }
            PlannedComponent(c.span, name_ref, &value_holder, null)
        }

        function plan_tuple(this: Planner, t: Tuple) returns PlannedTuple
        {
            var comps_arr Array[PlannedComponent]()
            var i: size_t 0
            while i < t.components.length
            {
                let c_ptr t.components.get i
                if c_ptr <> null
                {
                    let c (*c_ptr)
                    comps_arr.add(this.plan_component(c))
                }
                set i: i + 1
            }

            ; Single anonymous component = grouping parens. Lift the
            ; component's collapsed result_type into tuple_type so callers
            ; that consume the tuple as a value (resolve_member_access on
            ; `(*p).field`, ...) see the inner expression's type instead of
            ; `void`. Mirrors Planner.cpp:10497-10501. Multi-component
            ; tuples and named components keep tuple_type=void to avoid
            ; disturbing the struct-construction and function-argument
            ; paths.
            var tuple_ty: PlannedType Planner.make_void_type()
            if comps_arr.length = 1
            {
                let only_ptr_initial comps_arr.get 0
                if only_ptr_initial <> null
                {
                    let only_initial (*only_ptr_initial)
                    if only_initial.name = null
                    {
                        if only_initial.value <> null
                        {
                            let vals_initial (*only_initial.value)
                            if vals_initial.length > 0
                            {
                                let collapsed this.collapse_operand_sequence(vals_initial)
                                set tuple_ty: collapsed.result_type
                            }
                        }
                    }
                }
            }

            var comps_holder Vector[PlannedComponent](comps_arr)
            PlannedTuple(
                t.span,
                &comps_holder,
                tuple_ty,
                false,
                Lifetime.Unspecified(Unspecified()),
                null
            )
        }

        function plan_matrix(this: Planner, m: Matrix) returns scalyc.compiler.Plan.PlannedMatrix
        {
            var rows_arr Array[Vector[PlannedOperand]]()
            var i: size_t 0
            while i < m.operations.length
            {
                let row_ptr m.operations.get i
                if row_ptr <> null
                {
                    let row (*row_ptr)
                    let planned_row this.plan_operands(row)
                    rows_arr.add planned_row
                }
                set i: i + 1
            }

            var rows_holder Vector[Vector[PlannedOperand]](rows_arr)
            scalyc.compiler.Plan.PlannedMatrix(
                m.span,
                &rows_holder,
                Planner.make_void_type(),
                m.life
            )
        }

        ; plan_new: `new Foo(args)` — object construction. The mangled
        ; initializer and resolved struct type depend on the concept
        ; table, so we plan the type skeleton and arguments and leave
        ; the call layout for later resolution. For now we model it as
        ; a PlannedTuple carrying the argument list and the planned type.
        function plan_new(this: Planner, n: New) returns PlannedTuple
        {
            let planned_ty this.plan_type(n.type)
            let planned_args this.plan_tuple(n.arguments)

            ; Verify the target type has a matching initializer. A New
            ; with no matching init is a hard error — record it so the
            ; emitter doesn't silently produce an empty struct value.
            var arg_types_arr Array[PlannedType]()
            if planned_args.components <> null
            {
                let comps (*planned_args.components)
                var ci: size_t 0
                while ci < comps.length
                {
                    let c_ptr comps.get ci
                    if c_ptr <> null
                    {
                        let c (*c_ptr)
                        if c.value <> null
                        {
                            let vops (*c.value)
                            if vops.length > 0
                            {
                                let last_ptr vops.get(vops.length - 1)
                                if last_ptr <> null
                                    arg_types_arr.add((*last_ptr).result_type)
                            }
                        }
                    }
                    set ci: ci + 1
                }
            }
            var arg_types_vec Vector[PlannedType](arg_types_arr)
            let init_ref this.find_initializer(planned_ty.name, arg_types_vec)
            if init_ref = null
            {
                var sb StringBuilder()
                sb.append "no matching initializer for `new "
                sb.append planned_ty.name
                sb.append "`"
                this.add_error(sb.to_string())
            }

            PlannedTuple(
                n.span,
                planned_args.components,
                planned_ty,
                true,
                planned_ty.life,
                null
            )
        }

        ; ================================================================
        ; plan_operand: dispatch by Expression variant, then wrap with
        ; any member-access chain declared on the operand.
        ; ================================================================
        function plan_operand(this: Planner, op: scalyc.compiler.Model.Operand) returns PlannedOperand
        {
            let base choose op.expression
                when c: Constant
                    this.plan_constant_operand(c, op.span)
                when ty: Type
                    this.plan_type_operand(ty, op.span)
                when tp: Tuple
                {
                    let pt this.plan_tuple(tp)
                    PlannedOperand(op.span, PlannedExpression.Tuple pt, null, pt.tuple_type)
                }
                when mx: Matrix
                {
                    let pm this.plan_matrix(mx)
                    PlannedOperand(op.span, PlannedExpression.Matrix pm, null, pm.element_type)
                }
                when bk: Block
                {
                    let pb this.plan_block(bk)
                    ; Block-as-expression takes its type from the last
                    ; statement (typically an Action whose source is the
                    ; trailing expression). Empty blocks remain void.
                    var block_type: PlannedType Planner.make_void_type()
                    if pb.statements <> null
                    {
                        let stmts (*pb.statements)
                        if stmts.length > 0
                        {
                            let last_ptr stmts.get(stmts.length - 1)
                            if last_ptr <> null
                                set block_type: Planner.statement_result_type((*last_ptr))
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Block pb, null, block_type)
                }
                when ife: If
                {
                    let pi this.plan_if(ife)
                    ; Result type is the consequent's — branch unification
                    ; already equated it with the alternative via the
                    ; solver.
                    var if_type: PlannedType Planner.make_void_type()
                    if pi.consequent <> null
                    {
                        let cons (*pi.consequent)
                        set if_type: Planner.statement_result_type(cons)
                    }
                    PlannedOperand(op.span, PlannedExpression.If pi, null, if_type)
                }
                when mt: Match
                {
                    let pm this.plan_match(mt)
                    var match_type: PlannedType Planner.make_void_type()
                    if pm.branches <> null
                    {
                        let brs (*pm.branches)
                        if brs.length > 0
                        {
                            let first_br_ptr brs.get 0
                            if first_br_ptr <> null
                            {
                                let first_br (*first_br_ptr)
                                if first_br.consequent <> null
                                    set match_type: Planner.statement_result_type(
                                        (*first_br.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Match pm, null, match_type)
                }
                when ch: Choose
                {
                    let pc this.plan_choose(ch)
                    var choose_type: PlannedType Planner.make_void_type()
                    if pc.cases <> null
                    {
                        let cases (*pc.cases)
                        if cases.length > 0
                        {
                            let first_ptr cases.get 0
                            if first_ptr <> null
                            {
                                let first_case (*first_ptr)
                                if first_case.consequent <> null
                                    set choose_type: Planner.statement_result_type(
                                        (*first_case.consequent)
                                    )
                            }
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Choose pc, null, choose_type)
                }
                when fr: For
                {
                    let pf this.plan_for(fr)
                    PlannedOperand(op.span, PlannedExpression.For pf, null, Planner.make_void_type())
                }
                when wh: While
                {
                    let pw this.plan_while(wh)
                    PlannedOperand(op.span, PlannedExpression.While pw, null, Planner.make_void_type())
                }
                when tr: Try
                {
                    let pt this.plan_try(tr)
                    ; Try-as-expression takes the happy-path value's
                    ; type — that's the binding's operation result.
                    var try_type: PlannedType Planner.make_void_type()
                    if pt.cond.operation <> null
                    {
                        let ops (*pt.cond.operation)
                        if ops.length > 0
                        {
                            let last_ptr ops.get(ops.length - 1)
                            if last_ptr <> null
                                set try_type: (*last_ptr).result_type
                        }
                    }
                    PlannedOperand(op.span, PlannedExpression.Try pt, null, try_type)
                }
                when so: SizeOf
                {
                    let ps this.plan_sizeof(so)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.SizeOf ps,
                        null,
                        Planner.make_size_type()
                    )
                }
                when ao: scaly.compiler.Model.AlignOf
                {
                    let pa this.plan_alignof(ao)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.AlignOf pa,
                        null,
                        Planner.make_size_type()
                    )
                }
                when isx: Is
                {
                    let pi this.plan_is(isx)
                    PlannedOperand(op.span, PlannedExpression.Is pi, null, Planner.make_bool_type())
                }
                when asx: scaly.compiler.Model.As
                {
                    let pa this.plan_as(asx)
                    PlannedOperand(
                        op.span,
                        PlannedExpression.As pa,
                        null,
                        pa.target_type
                    )
                }
                when nw: New
                {
                    let pt this.plan_new(nw)
                    PlannedOperand(op.span, PlannedExpression.Tuple pt, null, pt.tuple_type)
                }
                when lam: Lambda
                {
                    let pl this.plan_lambda(lam)
                    PlannedOperand(op.span, PlannedExpression.Lambda pl, null, pl.return_type)
                }
                when rep: Repeat
                {
                    let pr this.plan_repeat(rep)
                    PlannedOperand(op.span, PlannedExpression.Repeat pr, null, pr.value_type)
                }

            ; s164: bind member_access to a local BEFORE the guard. A
            ; `guard`/`if`/... statement placed immediately after a
            ; `let X choose {...}` binding is absorbed into the binding's
            ; initializer operation by the parser (the choose's trailing
            ; newline is consumed, so the operand list keeps collecting),
            ; and since the Expression union has no Guard variant the
            ; absorbed if is silently dropped — stage-1 then emitted no
            ; null-check and dereferenced a null op.member_access. A
            ; non-stmt-like binding (`let ma ...`) closes the choose
            ; binding's operation, so the following if survives as its
            ; own statement. (Stage-0's parser doesn't collapse this, so it
            ; was never exercised there.)
            let ma op.member_access
            if ma = null
                return base

            let members (*ma)
            let access_chain this.resolve_member_access(base.result_type, members)
            var access_holder Vector[PlannedMemberAccess](access_chain)
            var final_type: PlannedType base.result_type
            if access_chain.length > 0
            {
                let last_ptr access_chain.get(access_chain.length - 1)
                if last_ptr <> null
                    set final_type: (*last_ptr).result_type
            }
            PlannedOperand(base.loc, base.expr, &access_holder, final_type)
        }

        ; plan_operands: batch plan_operand over a Vector.
        ; s184: unit variant referenced without an argument tuple —
        ; `Option.None` as a value. Mirrors stage-0's planOperands
        ; Case 3 (Planner.cpp:8376-8419): a two-segment name whose
        ; first segment is a registered union and whose second a
        ; payload-less variant plans as a PlannedVariantConstruction
        ; with no value. Returns null when the shape doesn't match so
        ; the caller falls back to plan_operand#. Locals win — a
        ; shadowing local binding disqualifies the union lookup.
        function try_plan_unit_variant(
            this: Planner,
            t: Type,
            loc: Span
        ) returns ref[PlannedOperand]?
        {
            if t.name.length <> 2
                return null
            let u_ptr t.name.get 0
            let v_ptr t.name.get 1
            if u_ptr = null
                return null
            if v_ptr = null
                return null
            let union_name (*u_ptr)
            let variant_name (*v_ptr)
            if this.lookup_local_binding(union_name) <> null
                return null
            let uconc_ref this.lookup_concept(union_name)
            if uconc_ref = null
                return null
            let uconc (*uconc_ref)
            var unit_variant: bool false
            choose uconc.definition
                when uvd: scalyc.compiler.Model.Union
                {
                    var uvi: size_t 0
                    while uvi < uvd.variants.length
                    {
                        let var_ptr uvd.variants.get uvi
                        if var_ptr <> null
                        {
                            let var_def (*var_ptr)
                            if var_def.name.equals(variant_name)
                            {
                                if var_def.type = null
                                    set unit_variant: true
                            }
                        }
                        set uvi: uvi + 1
                    }
                }
                else
                    0
            if unit_variant = false
                return null
            let unit_tag this.lookup_variant_tag(union_name, variant_name)
            if unit_tag < 0
                return null
            let unit_union_ty PlannedType(
                loc,
                union_name,
                Planner.mangle_structure(union_name, null),
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )
            let unit_vc PlannedVariantConstruction(
                loc,
                unit_union_ty,
                variant_name,
                unit_tag as size_t,
                null
            )
            PlannedOperand^this(
                loc,
                PlannedExpression.VariantConstruction unit_vc,
                null,
                unit_union_ty
            )
        }

        function plan_operands(
            this: Planner,
            ops: Vector[scalyc.compiler.Model.Operand]
        ) returns Vector[PlannedOperand]
        {
            var result Vector[PlannedOperand](ops.length)
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    ; s184 unit-variant lookahead: only a Type operand
                    ; NOT followed by an argument Tuple and carrying no
                    ; member chain qualifies — `Union.Unit()` (with
                    ; parens) must keep flowing through the collapse
                    ; construction gate as [Type, Tuple].
                    var unit_ref: ref[PlannedOperand]? null
                    if op.member_access = null
                    {
                        var followed_by_tuple: bool false
                        if i + 1 < ops.length
                        {
                            let next_ptr ops.get(i + 1)
                            if next_ptr <> null
                            {
                                choose (*next_ptr).expression
                                    when nt: Tuple
                                        set followed_by_tuple: true
                                    else
                                        0
                            }
                        }
                        if followed_by_tuple = false
                        {
                            choose op.expression
                                when uty: Type
                                    set unit_ref: this.try_plan_unit_variant(uty, op.span)
                                else
                                    0
                        }
                    }
                    if unit_ref <> null
                    {
                        result.put(i, (*unit_ref))
                    }
                    if unit_ref = null
                    {
                        let pl this.plan_operand(op)
                        result.put(i, pl)
                    }
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_binding: Model.Binding → Plan.PlannedBinding.
        ;
        ; Responsibilities:
        ;   1. Plan the initializer operands (by calling plan_operands).
        ;   2. Plan the binding's annotated item, which yields the
        ;      PlannedItem with an optional PlannedType.
        ;   3. Register the binding in the current scope so later uses
        ;      resolve by name.
        ;
        ; plan_binding now collapses the operation sequence. Stack-array
        ; type detection (`[T, N]` at binding site) is deferred.
        ; ================================================================

        ; Drop a LEADING `=` from a binding initializer (the assignment
        ; form `let x = value` → operands `[=, value]`). `=` is also the
        ; comparison operator, so a NON-leading `=` (`let r a = b`) must be
        ; kept — it collapses to the comparison `r = (a == b)`. Mirrors the
        ; stage-0 index-0 if in Planner.cpp::planBinding.
        function strip_leading_eq(ops: Vector[PlannedOperand]) returns Vector[PlannedOperand]
        {
            if ops.length > (0 as size_t)
            {
                let f0 ops.get 0
                if f0 <> null
                {
                    let f0v (*f0)
                    choose f0v.expr
                        when e0: PlannedType
                        {
                            if e0.name.equals("=")
                            {
                                var arr Array[PlannedOperand]()
                                var i: size_t 1
                                while i < ops.length
                                {
                                    let p ops.get i
                                    if p <> null
                                        arr.add((*p))
                                    set i: i + 1
                                }
                                return Vector[PlannedOperand](arr)
                            }
                        }
                        else
                            0
                }
            }
            ops
        }

        function plan_binding(this: Planner, b: Binding) returns PlannedBinding
        {
            ; GAP B: a delegate-typed binding initialized by a lambda literal —
            ; `let g: Callback \x: x + 1` — becomes a function-pointer VALUE (the
            ; address of the lambda monomorphized against the delegate's declared
            ; signature), so g can be passed around and called indirectly. This
            ; must run BEFORE the Phase-1 model-record intercept below, which
            ; would otherwise treat it as a call-site-monomorphized binding and
            ; emit no value.
            if b.operation.length = 1
            {
                var del_name ""
                if b.item.type <> null
                {
                    let ann (*b.item.type)
                    let nm Planner.join_dotted_name(ann.name)
                    if this.is_delegate_type(nm)
                        set del_name: nm
                }
                if del_name.get_length() > 0
                {
                    let dop_ptr b.operation.get 0
                    if dop_ptr <> null
                        choose (*dop_ptr).expression
                            when dl: Lambda
                            {
                                var dparams this.delegate_param_types(del_name)
                                var base_name "lam"
                                if b.item.name <> null
                                    set base_name: String((*b.item.name))
                                let del_pt this.plan_type((*b.item.type))
                                let dret this.delegate_return_type(del_name)
                                let clo this.make_closure(base_name, dl, dparams, dret, del_pt, Lifetime.Local(scalyc.compiler.Model.Local(b.span)))
                                let fref_op PlannedOperand(b.span, PlannedExpression.Closure clo, null, del_pt)
                                var op_arr Array[PlannedOperand]()
                                op_arr.add fref_op
                                var op_vec Vector[PlannedOperand](op_arr)
                                var name_ref: ref[String]? null
                                if b.item.name <> null
                                {
                                    var nh Vector[String](1)
                                    nh.put(0, String((*b.item.name)))
                                    set name_ref: nh.get(0)
                                }
                                var pt_h Vector[PlannedType](1)
                                pt_h.put(0, del_pt)
                                let pitem PlannedItem(b.span, false, name_ref, pt_h.get(0), null)
                                ; Register the local so later references resolve
                                ; to the delegate type (e.g. passing g to apply,
                                ; or calling g(...) indirectly).
                                if b.item.name <> null
                                {
                                    this.define_local((*b.item.name), del_pt, b.binding_type.equals("var"), false)
                                    ; Track it as a stack closure for escape
                                    ; checking (returning it would dangle).
                                    local_closure_names.add(String((*b.item.name)))
                                }
                                return PlannedBinding(b.span, b.binding_type, pitem, &op_vec)
                            }
                            else
                                0
                }
            }

            ; Phase-1 lambda binding: `let f \params: body`. Record the lambda
            ; model under the binding name and emit no runtime value — calls to
            ; `f` monomorphize the body at the call site (collapse_operand_sequence#).
            if b.operation.length = 1
            {
                let lb_op0_ptr b.operation.get 0
                if lb_op0_ptr <> null
                {
                    if b.item.name <> null
                    {
                        choose (*lb_op0_ptr).expression
                            when lb_lam: Lambda
                            {
                                this.record_lambda_model((*b.item.name), lb_lam)
                                ; skip-binding: null item name + null operation
                                ; → emit_binding is a no-op for this binding.
                                return PlannedBinding(
                                    b.span,
                                    b.binding_type,
                                    PlannedItem(b.span, false, null, null, null),
                                    null
                                )
                            }
                            else
                                0
                    }
                }
            }

            let raw_ops_flat this.plan_operands(b.operation)
            let planned_ops_flat Planner.strip_leading_eq(raw_ops_flat)
            let orig_item this.plan_item(b.item)

            ; s135: support `var NAME TYPE INIT` (no colon). When the
            ; Modeler produces a Binding with no annotation but >=2
            ; operands AND the first is a bare PlannedType (not Matrix/
            ; Tuple-followed and not an operator), treat the first as
            ; the item_type and the remaining as the initializer.
            ; Without this, collapse_operand_sequence#'s binary loop
            ; sees [Type, Const] as a would-be binary op, bails when
            ; there's no rhs, returns just the Type, and emit_binding
            ; drops the alloca entirely.
            var peeled_idx: size_t 0
            var has_peeled_type: bool false
            var peeled_holder Vector[PlannedType](1)
            if orig_item.item_type = null
            {
                if planned_ops_flat.length >= 2
                {
                    let first_ptr planned_ops_flat.get 0
                    if first_ptr <> null
                    {
                        let first_op (*first_ptr)
                        ; A type annotation never carries a member-access
                        ; chain. A first operand WITH a chain is a qualified
                        ; or method call (`ns.fn y`, `obj.m y`) — don't peel
                        ; it as a type; let collapse resolve the parenless
                        ; call.
                        if first_op.member_access = null
                        choose first_op.expr
                            when ft: PlannedType
                            {
                                if ft.name.get_length() > 0
                                {
                                    if Planner.is_operator_name(ft.name) = false
                                    {
                                        let next_ptr planned_ops_flat.get 1
                                        if next_ptr <> null
                                        {
                                            let next_op (*next_ptr)
                                            var next_is_continuation: bool false
                                            choose next_op.expr
                                                when nm: scalyc.compiler.Plan.PlannedMatrix
                                                    set next_is_continuation: true
                                                when nt: PlannedTuple
                                                    set next_is_continuation: true
                                                when nty: PlannedType
                                                {
                                                    ; Lifetime markers (^name, $, #) are
                                                    ; modeled as Expression.Type with an
                                                    ; empty name path. Such markers
                                                    ; participate in the same call/ctor
                                                    ; collapse as Matrix/Tuple — don't
                                                    ; peel.
                                                    if nty.name.get_length() = 0
                                                        set next_is_continuation: true
                                                }
                                                else
                                                    0
                                            ; Don't peel a callable head: a free
                                            ; function or unqualified sibling
                                            ; method (`let t triple 10`, `let p
                                            ; get x`) is a parenless single-arg
                                            ; call, NOT a typed binding. A dotted
                                            ; non-concept name (`let r ns.fn x`)
                                            ; is likewise a qualified call. A
                                            ; genuine type head (primitive or
                                            ; concept) still peels.
                                            var head_is_call: bool false
                                            if this.is_function(ft.name)
                                                set head_is_call: true
                                            if this.is_namespace_sibling_function(ft.name)
                                                set head_is_call: true
                                            if this.has_this_method(ft.name)
                                                set head_is_call: true
                                            ; A Phase-1 lambda binding name is callable,
                                            ; not a type — `let r inc(5)` must collapse
                                            ; to the lambda call, not peel `inc` as r's type.
                                            if this.lookup_lambda_model(ft.name) <> null
                                                set head_is_call: true
                                            if ft.name.last_index_of("." as u8) >= 0
                                            {
                                                if this.lookup_concept(ft.name) = null
                                                    set head_is_call: true
                                            }
                                            if next_is_continuation = false
                                            {
                                                if head_is_call = false
                                                {
                                                    set has_peeled_type: true
                                                    set peeled_idx: 1
                                                    peeled_holder.put(0, ft)
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                    }
                }
            }

            ; Build the actual ops vector to collapse: either all of
            ; planned_ops_flat or just the tail starting at peeled_idx.
            var rest_arr Array[PlannedOperand]()
            var ri: size_t peeled_idx
            while ri < planned_ops_flat.length
            {
                let p_ptr planned_ops_flat.get ri
                if p_ptr <> null
                    rest_arr.add((*p_ptr))
                set ri: ri + 1
            }
            let ops_to_collapse Vector[PlannedOperand](rest_arr)
            var collapsed this.collapse_operand_sequence(ops_to_collapse)

            ; Page inference, gap 1 (backward binding promotion): if this
            ; binding's name was found returned bare (`let x Foo(); ... return
            ; x`) and its initializer is a relocatable allocation, promote the
            ; allocation to the CALLER's page now (instead of the local page),
            ; and record the name so plan_return# skips the escape diagnostic at
            ; `return x`. The binding_type itself stays Local — the value still
            ; LIVES in this frame's slot, it just points at caller-page guts,
            ; exactly like the hand-written `let x Foo(); return x` idiom.
            if b.item.name <> null
            {
                let bn (*b.item.name)
                ; Escape soundness step 3 (provenance through a binding): a
                ; binding whose initializer is a REFERENCE into a local page
                ; (`let r &b`, result_type pointer[T{Local}]) is NOT a
                ; relocatable allocation — its pointee is frame-bound. Gap-1
                ; promotion would bogusly flip the outer `&`-call life to Call
                ; and mark the name promoted, so `return r` would SKIP the
                ; escape check (silent use-after-free). Suppress promotion for
                ; such bindings; the Local-inner survives on binding_type and
                ; the return/store/pass check fires at the use site.
                var do_promote false
                if this.array_contains_name(escaping_return_locals, bn)
                {
                    set do_promote: true
                    if Planner.is_local_ref_pointer(collapsed.result_type)
                        set do_promote: false
                }
                if do_promote
                {
                    let promote_life Lifetime.Call(scalyc.compiler.Model.Call(b.span))
                    let promoted_init this.restamp_operand_life(collapsed, promote_life)
                    if promoted_init <> null
                    {
                        set collapsed: (*promoted_init)
                        promoted_binding_names.add(String(bn))
                    }
                    else
                    {
                        ; Choose/if/match/block-bound init (`let base choose {
                        ; when c: plan_constant_operand(c) ... }; return base`):
                        ; restamp_operand_life# only promotes a top-level
                        ; Call/Tuple, so a control-flow init returns null. Fall
                        ; back to promote_tail_operand#, which recurses into each
                        ; branch's value position and promotes the leaf Local/
                        ; Unspecified construction/call to the caller page. NEUTRAL
                        ; on sigiled source: the branch values are explicit
                        ; `#`-calls (Call life), which restamp refuses, so nothing
                        ; is promoted and the binding is kept verbatim.
                        let promoted_ctrl this.promote_tail_operand(collapsed, promote_life)
                        if promoted_ctrl <> null
                        {
                            set collapsed: (*promoted_ctrl)
                            promoted_binding_names.add(String(bn))
                        }
                    }
                }

                ; Let-bound box escape: a binding whose initializer is a
                ; `&^this`/`&^rp` box places its value on a surviving page, so
                ; the local is safe to return/store/pass (region_of_operand#
                ; ranks it Caller). Record the name here.
                choose collapsed.expr
                    when bx: Box
                    {
                        if bx.target_page.equals("this")
                            local_box_names.add(String(bn))
                        if bx.target_page.equals("rp")
                            local_box_names.add(String(bn))
                    }
                    else
                        0
            }

            ; Page inference (address-taken rule): a frame-local Vector binding
            ; (`var V Vector[X](arr)`, no explicit lifetime) whose address is
            ; taken (`&V` found by the scan_address_taken# pre-scan) and
            ; referenced into an escaping structure (a PlannedCall arg /
            ; PlannedItem / PlannedFunction field) must live on the CALLER's page
            ; (rp), not the local page — exactly what an explicit `^rp` provided.
            ; Promote the construction's lifetime to the caller page now. This is
            ; SOUND: it is precisely the page an address-taken-into-an-escaping-
            ; structure reference requires; for the `Vector[X]^rp(arr)` sites it
            ; is emission-IDENTICAL to the sigil (Call and Reference("rp") both
            ; route emit_call's page_arg through lookup_variable("rp")). Gated:
            ;   - name in address_taken_locals (a `&NAME` was seen),
            ;   - the function HAS a caller page (rp in scope) — a primitive-
            ;     returning helper (test()) has none, so it keeps the local page,
            ;   - the init is a Vector construction, and restamp_operand_life#
            ;     returns non-null (a relocatable page-owning Call/Tuple with
            ;     Local/Unspecified life). A scalar/value-struct address-taken
            ;     local fails owns-page-guts → stays unpromoted and is REJECTED-
            ;     if-escaping, per the escape-soundness contract.
            ; NEUTRAL on sigiled source: a `^rp` Vector's construction carries
            ; Reference life, which restamp refuses → no promotion; the rule
            ; fires only once the `^rp` is dropped.
            if b.item.name <> null
            {
                let abn (*b.item.name)
                ; Ref-flow provenance (2026-07-02f): a holder whose interior
                ; reference (`H.get(i)`) reaches an argument/return position
                ; (getref_arg_locals, collected by scan_getref_args#) needs
                ; the caller page exactly like an address-taken one — the
                ; reference lands in a structure that outlives the frame
                ; (record_function's PlannedFunction, MethodMatch^this).
                var at_hit false
                if this.array_contains_name(address_taken_locals, abn)
                    set at_hit: true
                if this.array_contains_name(getref_arg_locals, abn)
                    set at_hit: true
                if at_hit
                    if collapsed.result_type.name.equals("Vector")
                    {
                        if this.lookup_local_binding("rp") <> null
                        {
                            let at_life Lifetime.Call(scalyc.compiler.Model.Call(b.span))
                            let at_promoted this.restamp_operand_life(collapsed, at_life)
                            if at_promoted <> null
                            {
                                set collapsed: (*at_promoted)
                                ; Record the promotion so a later REASSIGNMENT
                                ; of the same holder (`set value_holder:
                                ; Vector[...](arr)` in plan_component) is
                                ; promoted too — plan_action#'s reassign
                                ; promotion keys on promoted_binding_names.
                                ; Also correct for the return/tail gap-1
                                ; shortcut: the binding's allocation now
                                ; lives on the caller page.
                                if this.array_contains_name(promoted_binding_names, abn) = false
                                    promoted_binding_names.add(String(abn))
                            }
                        }
                        else
                        {
                            ; Option B (2026-07-02h): the getref scan proved
                            ; this holder's interior references reach an
                            ; argument/return position, so promotion to the
                            ; caller page is REQUIRED — but no rp is in scope
                            ; (the lambda-machinery class). The refs would
                            ; dangle silently once the local page is freed;
                            ; hard-error instead. Only fires for a construction
                            ; that actually stayed on the LOCAL page — a #/^
                            ; holder (Call/Reference life) already outlives the
                            ; frame and is skipped. Keyed on getref_arg_locals
                            ; (not the address-taken set) to keep the error
                            ; surface exactly the interior-ref class.
                            if this.array_contains_name_from(getref_arg_locals, this.getref_arg_base, abn)
                                if this.operand_is_local_page_construction(collapsed)
                                    this.add_diagnostic(b.span, "reference into a local page escapes via a container ref - no caller page is in scope to promote the holder to; allocate the holder on a surviving region ('^this') or copy the value out instead of passing the reference")
                        }
                    }
            }

            ; Hole-1 field provenance: a `let h Holder(&b)` binding where the
            ; construction received a &<frame-local> argument now holds a frame
            ; address in one of h's pointer fields. The binding lives in this
            ; frame as a VALUE struct (collapsed.result_type not pointer/ref/
            ; Option-of-ref). Taint h so a later `return h.field` is rejected;
            ; the Local rank that the field's static type cannot carry is
            ; tracked through this per-function set instead. Coarse (whole
            ; binding); a caller-ptr arg leaves the field at Caller rank
            ; (is_local_ref_pointer false) so the positive case is untouched.
            if b.item.name <> null
            {
                let tbn (*b.item.name)
                if this.result_type_is_value_struct(collapsed.result_type)
                    if this.construction_has_local_ref_arg(collapsed)
                        if this.array_contains_name(local_tainted_struct_bindings, tbn) = false
                            local_tainted_struct_bindings.add(String(tbn))
            }

            ; Option B (2026-07-02h): record a container holder whose
            ; construction REMAINED on the frame's local page after the gap-1 /
            ; address-taken / getref promotion passes above — its `.get(i)` /
            ; `.get_ptr(i)` refs point into this frame's page. The method-
            ; dispatch stamp in collapse_operand_sequence# marks such refs
            ; Local-pointee so the return/store/pass escape checks reject an
            ; escaping use (the silent-dangle class). Parameters never bind
            ; here; #/^ holders carry Call/Reference life (operand_is_local_
            ; page_construction false); promoted bindings are excluded by name.
            if b.item.name <> null
            {
                let fhn (*b.item.name)
                if collapsed.result_type.name.equals("Vector")
                    if this.operand_is_local_page_construction(collapsed)
                        if this.array_contains_name(promoted_binding_names, fhn) = false
                            if this.array_contains_name_from(local_frame_holder_names, this.local_frame_holder_base, fhn) = false
                                local_frame_holder_names.add(String(fhn))
            }

            ; s192: stack array declaration `var buffer char[64]` (no
            ; init). The single operand collapses to a PlannedType that
            ; plan_type# rewrote to pointer[T] with array_size set; treat
            ; it as the item TYPE (no initializer), not a value operand.
            ; Mirrors stage-0 Planner.cpp:10953-10978. Without this the
            ; lone-type operand is kept as an init, emit_operands returns
            ; null on it, and emit_binding drops the slot.
            var is_stack_array_decl: bool false
            var stack_array_holder Vector[PlannedType](1)
            if has_peeled_type = false
            {
                if orig_item.item_type = null
                {
                    choose collapsed.expr
                        when ct: PlannedType
                        {
                            if ct.array_size.get_length() > 0
                            {
                                if ct.name.equals("pointer")
                                {
                                    set is_stack_array_decl: true
                                    stack_array_holder.put(0, ct)
                                }
                            }
                        }
                        else
                            0
                }
            }

            ; Rebuild PlannedItem with the peeled type if any.
            var planned_item: PlannedItem orig_item
            if has_peeled_type
                set planned_item: PlannedItem(
                    orig_item.loc,
                    orig_item.is_private,
                    orig_item.name,
                    peeled_holder.get 0,
                    orig_item.attributes
                )
            if is_stack_array_decl
                set planned_item: PlannedItem(
                    orig_item.loc,
                    orig_item.is_private,
                    orig_item.name,
                    stack_array_holder.get 0,
                    orig_item.attributes
                )

            ; Use the annotated type if present; otherwise infer from the
            ; initializer's result type so emit_variable can map_type the
            ; binding without waiting for constraint resolution. Mirrors
            ; Planner.cpp:10950-10974.
            var binding_type: PlannedType collapsed.result_type
            if planned_item.item_type <> null
                set binding_type: (*planned_item.item_type)

            ; Emit an equality constraint between the declared binding
            ; type and the collapsed initializer's result type. Solvable
            ; cases either confirm the annotation or fix the fresh var.
            ; Skipped for a stack-array decl: there is no initializer —
            ; the "collapsed" operand IS the type.
            if is_stack_array_decl = false
                this.add_equality_constraint(binding_type, collapsed.result_type, b.span)

            ; Register the local in the current scope.
            if planned_item.name <> null
            {
                let n (*planned_item.name)
                this.define_local(n, binding_type, b.binding_type.equals "var", false)
            }

            ; s93: only include the collapsed operand when there's an
            ; actual initializer. For typed-no-init `var X: T`, an empty
            ; b.operation produces a void-type placeholder from
            ; collapse_operand_sequence#; passing it through made
            ; emit_binding's `length > 0` gate true and emit_operands
            ; return null on the placeholder, which then bailed out
            ; without allocating the binding's slot. Skipping the put
            ; lets emit_binding fall through to the type-only alloca
            ; path. Mirrors stage-0 Planner.cpp:10947 where empty
            ; ValueOps produce a null `Init` field on the Binding.
            var ops_holder Vector[PlannedOperand](0)
            if rest_arr.length > 0
            {
                if is_stack_array_decl = false
                {
                    set ops_holder: Vector[PlannedOperand](1)
                    ops_holder.put(0, collapsed)
                }
            }
            PlannedBinding(
                b.span,
                b.binding_type,
                planned_item,
                &ops_holder
            )
        }

        ; ================================================================
        ; plan_action / plan_return / plan_break / plan_throw.
        ;
        ; Each wraps a Vector[Operand] into the appropriate Planned*
        ; variant. plan_action collapses its source + target operand
        ; sequences via collapse_operand_sequence (which folds binary
        ; ops, method chains, is/as, and prefix ops); result_type takes
        ; the collapsed source's type.
        ; ================================================================

        function plan_action(this: Planner, a: Action) returns PlannedAction
        {
            ; Read-and-clear the tail-return flag: only THIS (outermost body)
            ; action is the function's implicit return. Nested actions planned
            ; while collapsing this one's source (choose/if arm consequents)
            ; must NOT see it set — promote_tail_operand# recurses into those
            ; arms itself.
            let do_tail_promote this.promote_tail_return
            set this.promote_tail_return: false
            let do_tail_check this.check_tail_escape
            set this.check_tail_escape: false

            let planned_source_flat this.plan_operands(a.source)
            var planned_source_collapsed this.collapse_operand_sequence(planned_source_flat)

            let planned_target_flat this.plan_operands(a.target)
            let planned_target_collapsed this.collapse_operand_sequence(planned_target_flat)

            ; For -g line info: take the location from the FIRST flat source
            ; operand, which carries the authoritative source span. The
            ; collapsed operand's loc is sometimes synthesized (start 0),
            ; which would emit a useless DILocation at line 0.
            var action_loc planned_source_collapsed.loc
            if planned_source_flat.length > 0
            {
                let first_op_ptr planned_source_flat.get 0
                if first_op_ptr <> null
                    set action_loc: (*first_op_ptr).loc
            }

            ; STORE vector: a ref/pointer into a Local ($) page stored into
            ; FRAME-EXTERNAL memory is a use-after-free. Frame-external = a
            ; parameter/receiver's field (`this.field`/`param.field` writes into
            ; the CALLER's object), a module global, or through a pointer deref.
            ; A same-frame local's field (`var`/`let`) dies WITH the ref -> safe.
            ; Mirrors Planner.cpp planAction store check.
            ; The source triggers when it is a DIRECT &<frame-local> reference
            ; (is_reference_to_local_page) OR a read of a TAINTED local struct's
            ; pointer field (hole-1 store: `let h Holder(&b); set this.p: h.p` —
            ; h.p's static type is pointer[Box{Unspecified}], so the Local pointee
            ; isn't on the field type; the per-fn taint set carries it instead).
            var store_src_escapes false
            if this.region_of_operand(planned_source_collapsed) < Planner.required_region_for_escape()
                set store_src_escapes: true
            if this.operand_reads_tainted_local_field(planned_source_collapsed)
                set store_src_escapes: true
            if a.target.length > 0
                if store_src_escapes
                {
                    var has_member false
                    if planned_target_collapsed.member_access <> null
                    {
                        let ma (*planned_target_collapsed.member_access)
                        if ma.length > (0 as size_t)
                            set has_member: true
                    }
                    var external false
                    var base_is_this false
                    choose planned_target_collapsed.expr
                        when v: Variable
                        {
                            if has_member
                            {
                                let lb this.lookup_local_binding(v.name)
                                if lb <> null
                                    if lb.is_parameter
                                    {
                                        set external: true
                                        if v.name.equals("this")
                                            set base_is_this: true
                                    }
                            }
                        }
                        when g: GlobalRef
                            set external: true
                        when c: Call
                            set external: true
                        else
                            0
                    if external
                    {
                        ; Page inference, rule 3 (store-into-`this`-field): when
                        ; the source IS a fresh allocation, place it on the
                        ; RECEIVER's page (Reference("this") -> Page.get(this) in
                        ; the emitter) so it outlives this frame, instead of
                        ; demanding `#`/`^`. Only `this.field` is inferred — a
                        ; non-`this` parameter base would need resolve_reference_
                        ; page to wrap an arbitrary param in Page.get (not yet
                        ; supported), and the split `let x ...; set f: &x` shape
                        ; needs the deferred dataflow pass; both keep the error.
                        var promoted_done false
                        if base_is_this
                        {
                            let ref_life Lifetime.Reference(scalyc.compiler.Model.Reference(action_loc, "this"))
                            let promoted this.restamp_operand_life(planned_source_collapsed, ref_life)
                            if promoted <> null
                            {
                                set planned_source_collapsed: (*promoted)
                                set promoted_done: true
                            }
                        }
                        ; Option B deferral: a container get/get_ptr ref stored
                        ; into a field of `this` follows the save/restore
                        ; discipline (plan_namespace's current_namespace_name:
                        ; every read happens before this frame exits and the
                        ; old value is restored). The stamped Local pointee
                        ; would reject the compiler's own benign idiom; keep
                        ; the pre-Option-B behavior (silent acceptance) for
                        ; exactly this shape — a DIRECT non-operator get/
                        ; get_ptr call source into a this-field. All other
                        ; sinks (non-this param fields, globals, derefs,
                        ; return, pass-to-storing-callee) keep the hard error.
                        ; `&local` sources are operator calls and stay flagged.
                        var defer_this_getref false
                        if base_is_this
                            choose planned_source_collapsed.expr
                                when sgc: Call
                                {
                                    if sgc.is_operator = false
                                    {
                                        if sgc.name.equals("get")
                                            set defer_this_getref: true
                                        if sgc.name.equals("get_ptr")
                                            set defer_this_getref: true
                                    }
                                }
                                else
                                    0
                        if promoted_done = false
                            if defer_this_getref = false
                                this.add_diagnostic(action_loc, "reference into a local page escapes via store - allocate the target with '#' (caller page) or '^name' (region) so it outlives the use")
                    }
                }

            ; STORE vector, CLOSURE variant: a closure bound to a local lives on
            ; the stack frame (its env record is entry_alloca'd). Storing it into
            ; FRAME-EXTERNAL memory (a parameter/receiver's field, a module global,
            ; or through a pointer deref) is a use-after-free once the frame exits.
            ; is_reference_to_local_page / region_of_operand can't see it — a
            ; closure is delegate-typed, not pointer/ref — so it's tracked
            ; separately via local_closure_names (live during this function's
            ; planning). No promotion path exists (unlike the this.field ref case):
            ; the only escaping-closure form is `return \x: ...` (Call life), so
            ; this is a hard error. Vector 3 (pass-to-storing-callee) is NOT
            ; extended to closures — the interprocedural post-pass runs after
            ; local_closure_names is truncated, so it can't see per-function
            ; closure-locality without recording it into the escape summary.
            if a.target.length > 0
                if this.operand_is_stack_closure(planned_source_collapsed)
                    if this.target_is_frame_external(planned_target_collapsed)
                        this.add_diagnostic(action_loc, "a closure bound to a local lives on the stack frame and escapes via store into memory that outlives this frame - return the lambda directly (return \\x: ...) instead of binding it to a local first")

            ; STORE vector (page inference, VALUE variant): a fresh page-owning
            ; VALUE stored into an escaping (returned) local must be promoted to
            ; the caller page (Call/rp) — the local is returned by value, so its
            ; heap guts must outlive this frame. Covers BOTH shapes:
            ;   - `set opts.field: String(x)` — store into a FIELD of escaping
            ;     `opts` (member access on the target Variable);
            ;   - `set uses: Vector[Use](n)` — REASSIGN an escaping plain var
            ;     (no member access). The tree-builders use `var x V(0); set x:
            ;     V(n); x.put(...); return Struct(..., x, ...)`, where the
            ;     reassignment creates the real container; without promoting it
            ;     the returned struct's field points at a freed local page.
            ; The target Variable's name drives both — member_access is
            ; irrelevant to whether the SOURCE must outlive the frame. Inline
            ; constructions have no binding to promote, so restamp at the plan
            ; site. result_owns_page_guts is false for refs (handled above, no
            ; double-fire) and pure stack values; restamp_operand_life# only
            ; promotes DEFAULTED (Local/Unspecified) lifetimes, so an explicit
            ; #/^ source and a non-escaping target are no-ops (emission-neutral
            ; on sigiled source).
            if a.target.length > 0
                if Planner.result_owns_page_guts(planned_source_collapsed.result_type)
                    choose planned_target_collapsed.expr
                        when v: Variable
                        {
                            var vesc false
                            if this.array_contains_name(escaping_return_locals, v.name)
                                set vesc: true
                            if this.array_contains_name(promoted_binding_names, v.name)
                                set vesc: true
                            if vesc
                            {
                                let cl Lifetime.Call(scalyc.compiler.Model.Call(action_loc))
                                let pr this.restamp_operand_life(planned_source_collapsed, cl)
                                if pr <> null
                                    set planned_source_collapsed: (*pr)
                                ; Nested-guts promotion (mirrors plan_return#):
                                ; restamp_operand_life# only flips a TOP-LEVEL
                                ; PlannedCall/PlannedTuple, so a variant-construction
                                ; source (`set ret_deep: Literal.Integer(IntegerLiteral(
                                ; String(..))))`) with a fresh Local String buried in
                                ; its payload is missed. promote_escaping_guts# reaches
                                ; PlannedVariantConstruction payloads. NEUTRAL on
                                ; sigiled source (already-Call leaves not re-flipped).
                                let pg this.promote_escaping_guts(planned_source_collapsed, cl)
                                if pg <> null
                                    set planned_source_collapsed: (*pg)
                            }
                        }
                        else
                            0

            ; Implicit-return (tail) promotion: this action is the body's last
            ; expression of a page-owning-return function and has no store
            ; target, so its value IS the function result. Promote a no-sigil
            ; construction/call (and recurse into choose/if/match arms + variant
            ; payloads) to the caller page so the returned guts outlive the
            ; frame. NEUTRAL on sigiled source: the tail is an explicit `#`
            ; (Call life) which restamp refuses, or a void action (no page-
            ; owning value). Only fires for needs_implicit_return_page funcs.
            if do_tail_promote
                if a.target.length = 0
                {
                    let tail_life Lifetime.Call(scalyc.compiler.Model.Call(action_loc))
                    let tp this.promote_tail_operand(planned_source_collapsed, tail_life)
                    if tp <> null
                        set planned_source_collapsed: (*tp)
                }

            ; Implicit-return (tail) ESCAPE CHECK — hole 1 (2026-07-02f).
            ; plan_return# hard-errors a returned reference into the local
            ; page, but the IMPLICIT tail return had no such check: a body
            ; ending in `&result` (unify's block tail) compiled clean and
            ; dangled once the frame's local page was freed. Walk the planned
            ; tail operand's return positions (diagnostic-only — no node is
            ; rebuilt, emission is byte-identical on escape-free source).
            ; Runs AFTER the promotion above so a promoted tail is judged by
            ; its promoted state.
            if do_tail_check
                if a.target.length = 0
                    this.check_tail_ref_escape(planned_source_collapsed, action_loc)

            let result_type planned_source_collapsed.result_type

            var source_holder Vector[PlannedOperand](1)
            source_holder.put(0, planned_source_collapsed)

            var target_holder: ref[Vector[PlannedOperand]]? null
            if a.target.length > 0
            {
                var target_vec Vector[PlannedOperand](1)
                target_vec.put(0, planned_target_collapsed)
                set target_holder: &target_vec
            }

            PlannedAction(
                action_loc,
                &source_holder,
                target_holder,
                result_type
            )
        }

        ; Escape checker (RBMM blocker C): true for two escaping shapes:
        ;  (1) a ref[T]/pointer[T] whose POINTEE lives on a Local ($) page — the
        ;      `&` operator and resolve_type keep the pointee (with its life) in
        ;      generics[0];
        ;  (2) a VALUE whose OWN life is Local (design-B item 3) — String()/etc
        ;      carry an internal `data` pointer into the local page, so returning
        ;      the value by copy still hands out a dangling internal pointer.
        ; A Local pointee/value dies at scope exit, so returning/storing it is a
        ; use-after-free. Call (#) and Reference (^name) lifetimes outlive the
        ; function and are fine. Mirrors Planner.cpp::isReferenceToLocalPage.
        ; True when the operand IS a freshly-built page-owning construction
        ; whose allocation lives on the function's LOCAL page (Local life) or
        ; would (Unspecified life on a page-owning value). is_reference_to_local_
        ; page only inspects result_type.life, but the construction blocks
        ; (init# / reshape) stamp the Local life onto the PlannedCall/PlannedTuple
        ; EXPRESSION (call.life), leaving result_type.life Unspecified — the
        ; emitter selects the page from call.life, not result_type.life. So a
        ; directly-returned no-sigil construction (`return Vector[T](0)`) is a
        ; local-page allocation that is_reference_to_local_page misses. R2 uses
        ; this as an additional gate so such returns are promoted to rp by
        ; restamp_operand_life# (which re-checks the expression life itself).
        ; result_owns_page_guts excludes borrows/handles. Read the EXPRESSION
        ; life, not result_type.life, by design.
        function operand_is_local_page_construction(this: Planner, op: PlannedOperand) returns bool
        {
            if Planner.result_owns_page_guts(op.result_type) = false
                return false
            ; Slice[T] is a BORROW value (data pointer + length into memory the
            ; callee does not own); result_owns_page_guts can't tell (it only
            ; excludes ptr/ref/LLVM/Option-of-ref by name). A Slice-returning
            ; call/construction is built on whatever page but its guts point
            ; elsewhere, so it never needs page promotion — excluding it keeps
            ; `slice_from`/`slice_to` (de-sigiled tail calls to `subslice`)
            ; byte-identical. R2's explicit-return path still covers a Local-
            ; life Slice via is_reference_to_local_page if one ever escapes.
            if op.result_type.name.equals("Slice")
                return false
            ; Read the EXPRESSION life (call.life / tuple.life). Only LOCAL —
            ; a construction the init#/reshape block placed on the function's
            ; local page (heap-backed default, or `$`). Unspecified is NOT
            ; included: a no-page-param construction (a plain value struct) has
            ; Unspecified life and is a pure STACK value that must NOT be
            ; region-promoted (result_owns_page_guts returns true for it too —
            ; it only excludes borrows/handles, not stack structs).
            choose op.expr
                when c: PlannedCall
                {
                    if c.is_operator
                        return false
                    choose c.life
                        when l: Local
                            return true
                        else
                            return false
                }
                when t: PlannedTuple
                {
                    choose t.life
                        when l: Local
                            return true
                        else
                            return false
                }
                else
                    return false
            false
        }

        ; binding_is_frame_local: true when `name` resolves to a non-parameter
        ; local binding whose stored VALUE lives in this frame (life Unspecified
        ; = plain stack value / no-sigil; or Local = $/heap-backed-default). Such
        ; a binding's STORAGE is the frame, so `&name` is a pointer into the
        ; local page (region rank Local). Parameters are excluded: a by-pointer
        ; struct param points at the caller's object (rank Caller), and a value
        ; param copied into the frame is not address-escaped in practice
        ; (pos_return_param_ptr returns the pointer VALUE, never `&param`).
        ; Bindings allocated with #/^ carry Call/Reference life on their VALUE —
        ; the programmer placed them on a caller/named page deliberately — so
        ; `&` of those is left to a later step (their slot is frame, but value
        ; uses are the common case and stay correct). Escape soundness step 1.
        function binding_is_frame_local(this: Planner, name: String) returns bool
        {
            let lb this.lookup_local_binding(name)
            if lb = null
                return false
            if lb.is_parameter
                return false
            choose lb.binding_type.life
                when u: Unspecified
                    return true
                when l: Local
                    return true
                else
                    return false
        }

        ; base_is_value_struct: true when the local binding `name` stores a
        ; VALUE struct in the frame — NOT a pointer/ref. Escape soundness
        ; step 2: a frame-local pointer var (`var old_current current`,
        ; `let p = ...`) has `.field` AUTO-DEREF to the pointed-to object,
        ; which lives on a caller/heap page — `&p.field` is then a Caller
        ; pointer, NOT a frame address. parent_type can't tell us this
        ; (s173 records the UNWRAPPED type), so the base binding's stored
        ; type is checked directly. Every compiler `return &base.field`
        ; (HashMap/List iterators) has a pointer/ref/^rp base, so this
        ; excludes them all.
        function base_is_value_struct(this: Planner, name: String) returns bool
        {
            var result true
            let lb this.lookup_local_binding(name)
            if lb = null
                set result: false
            else
            {
                if lb.binding_type.name.equals("pointer")
                    set result: false
                if lb.binding_type.name.equals("ref")
                    set result: false
                ; A `ref[T]?` / `pointer[T]?` local (e.g. `let p v.get(i)`,
                ; which returns ref[T]?) stores as an `Option` whose inner is
                ; a ref/pointer (NPO) — `.field` auto-derefs OUT of the frame,
                ; so `&p.field` is a Caller pointer, NOT Local. Exclude it.
                ; Every compiler `return &kvp_ptr.value` (HashMap scope walk)
                ; is this shape. An Option of a VALUE struct is a frame-
                ; resident tagged union, so it stays flagged (sound).
                if lb.binding_type.name.equals("Option")
                {
                    if this.option_inner_is_reference(lb.binding_type)
                        set result: false
                }
            }
            result
        }

        ; option_inner_is_reference: true when `t` is an Option whose first
        ; generic argument is a `pointer`/`ref` — the NPO auto-deref shape.
        function option_inner_is_reference(this: Planner, t: PlannedType) returns bool
        {
            var result false
            if t.generics <> null
            {
                let gens (*t.generics)
                if gens.length > 0
                {
                    let gp gens.get 0
                    if gp <> null
                    {
                        if gp.name.equals("pointer")
                            set result: true
                        if gp.name.equals("ref")
                            set result: true
                    }
                }
            }
            result
        }

        ; member_chain_all_fields: true when every member-access hop is a
        ; plain field (or union-value) access — no method call. `&x.m()`
        ; addresses a call result, not a frame field, so it is not flagged
        ; here (rare; deferred to step 3). A null chain is vacuously true.
        function member_chain_all_fields(this: Planner, op: PlannedOperand) returns bool
        {
            var result true
            if op.member_access <> null
            {
                let chain (*op.member_access)
                var i: size_t 0
                while i < chain.length
                {
                    let hp chain.get i
                    if hp <> null
                    {
                        if hp.is_method
                            set result: false
                    }
                    set i: i + 1
                }
            }
            result
        }

        ; construction_life_is_frame: true when a construction (PlannedCall
        ; ctor / Tuple / VariantConstruction) lives in THIS frame — i.e. its
        ; life is Unspecified (no sigil) or Local ($). A #/^ construction is
        ; allocated on a caller/named page, so its address is Caller, not
        ; Local. (this is ignored — kept a method to match the call style.)
        function construction_life_is_frame(this: Planner, life: Lifetime) returns bool
        {
            var result false
            choose life
                when u: Unspecified
                    set result: true
                when l: Local
                    set result: true
                else
                    0
            result
        }

        ; True when `&op` produces a pointer into THIS frame — generalizes
        ; the step-1 bare `&x` to field chains and address-of-temporary.
        ; Kept as its own single-exit helper (not inlined into the prefix-`&`
        ; collapse block): a nested choose/if there is miscompiled by the
        ; bootstrap lineage (the documented braceless-nest trap). Cases:
        ;   (1) bare `&x`            — x a frame-local of ANY type (the slot
        ;                              itself is in the frame).
        ;   (2) `&x.field-chain`     — x a frame-local VALUE struct, all hops
        ;                              plain fields (base_is_value_struct +
        ;                              member_chain_all_fields exclude every
        ;                              compiler pointer/ref-base `&p.field`).
        ;   (3) `&Box(5)` / `&(a,b)` — address of a frame TEMPORARY (no-sigil
        ;                              or $ construction; #/^ live on a page).
        ; `&<^rp-local>` (the slot is frame but the value is Caller) is NOT
        ; flagged — binding_is_frame_local's {Unspecified,Local} gate excludes
        ; Reference life; deferred to a later soundness step.
        function operand_addr_is_frame_local(this: Planner, op: PlannedOperand) returns bool
        {
            var result false
            choose op.expr
                when v: Variable
                {
                    if this.binding_is_frame_local(v.name)
                    {
                        if op.member_access = null
                            set result: true
                        else
                        {
                            if this.base_is_value_struct(v.name)
                            {
                                if this.member_chain_all_fields(op)
                                    set result: true
                            }
                        }
                    }
                }
                when c: Call
                {
                    if op.member_access = null
                    {
                        if this.construction_life_is_frame(c.life)
                            set result: true
                    }
                }
                when t: Tuple
                {
                    if op.member_access = null
                    {
                        if this.construction_life_is_frame(t.life)
                            set result: true
                    }
                }
                when vc: VariantConstruction
                {
                    if op.member_access = null
                        set result: true
                }
                else
                    0
            result
        }

        function is_reference_to_local_page(t: PlannedType) returns bool
        {
            choose t.life
                when loc: Local
                {
                    ; Option B: a stamped pointee life spreads to a DEREF'D
                    ; value (`*b` of a stamped pointer[int{Local}] derives
                    ; int{Local} via the prefix-* generic rule); a primitive
                    ; value is a plain copy and cannot dangle, so it must not
                    ; trip the value clause. Pre-existing Local-life VALUE
                    ; types are page-guts-owning structs (the default-to-local
                    ; flip's result_owns_page_guts gate), never primitives —
                    ; the guard is neutral for them.
                    if Planner.is_primitive_type_name(t.name) = false
                        return true
                }
                else
                    0
            let ptr_name "pointer"
            let ref_name "ref"
            var is_ref_like false
            if t.name.equals(ptr_name)
                set is_ref_like: true
            if is_ref_like = false
                if t.name.equals(ref_name)
                    set is_ref_like: true
            if is_ref_like
            {
                if t.generics <> null
                {
                    let gens (*t.generics)
                    if gens.length > (0 as size_t)
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            choose inner.life
                                when loc: Local
                                    return true
                                else
                                    0
                        }
                    }
                }
            }
            ; Option-of-ref piercing (Option B, 2026-07-02h): a STAMPED
            ; Option[ref[T{Local}]] (frame-local-page holder get-ref) must
            ; rank Local at region_of_operand#'s sinks. is_local_ref_pointer
            ; carries the same piercing; only stamped types ever match (the
            ; leading value-clause above is deliberately NOT applied to the
            ; Option's inner — see the is_local_ref_pointer header comment).
            if t.name.equals("Option")
            {
                if t.generics <> null
                {
                    let gens_o (*t.generics)
                    if gens_o.length > (0 as size_t)
                    {
                        let io_ptr gens_o.get 0
                        if io_ptr <> null
                            if Planner.is_local_ref_pointer((*io_ptr))
                                return true
                    }
                }
            }
            false
        }

        ; region_of_operand#: the single provenance chokepoint (Stage B). Returns
        ; the region rank of the operand's pointee — TODAY a coarse {Local,Caller}
        ; derived from the operand's result_type Local stamp (which already
        ; encodes the step-1/2/3 address-of/deref/field/join provenance walk via
        ; make_pointer_to_local#/make_ref_to_local_inner# + natural type flow).
        ; The 4 bespoke escape sites route their reference-escape gate through
        ; here so phase-5 (Stage D) refines the rank — ordered numeric ages from
        ; signatures, field/inter-proc provenance — in ONE place instead of four.
        ; NEUTRAL: region_of_operand(op) < required_region_for_escape() is
        ; exactly today's is_reference_to_local_page(op.result_type) (rank Local
        ; iff a frame pointee, else Caller; Caller < Static unused yet).
        ; operand_is_stack_closure: true when `op` is a bare read (no member-
        ; access hop) of a local bound to a stack (Lifetime.Local) closure —
        ; recorded in local_closure_names at plan_binding#. A member hop
        ; (`clo.field`) is a read THROUGH the closure, not the closure value, so
        ; it does not qualify. Used by the CLOSURE store-escape check.
        function operand_is_stack_closure(this: Planner, op: PlannedOperand) returns bool
        {
            if op.member_access <> null
            {
                let ma (*op.member_access)
                if ma.length > (0 as size_t)
                    return false
            }
            choose op.expr
                when v: Variable
                    return this.array_contains_name(local_closure_names, v.name)
                else
                    return false
            false
        }

        ; target_is_frame_external: true when a store TARGET writes into memory
        ; that outlives this frame — a parameter/receiver's field
        ; (`this.field`/`param.field`, base binding is_parameter), a module
        ; global (GlobalRef), or through a pointer deref (Call). A same-frame
        ; local's field (base var/let) dies with the frame → false. Mirrors the
        ; inline frame-external detection in the ref STORE vector above.
        function target_is_frame_external(this: Planner, target: PlannedOperand) returns bool
        {
            var has_member false
            if target.member_access <> null
            {
                let ma (*target.member_access)
                if ma.length > (0 as size_t)
                    set has_member: true
            }
            choose target.expr
                when v: Variable
                {
                    if has_member
                    {
                        let lb this.lookup_local_binding(v.name)
                        if lb <> null
                            if lb.is_parameter
                                return true
                    }
                }
                when g: GlobalRef
                    return true
                when c: Call
                    return true
                else
                    0
            false
        }

        function region_of_operand(this: Planner, op: PlannedOperand) returns size_t
        {
            ; A box (`&^obj v`) places a COPY of the value on obj's page. For the
            ; ^this / ^rp targets the page is the borrowed receiver / the caller's
            ; region — both outlive this frame — so the resulting pointer is at
            ; least Caller-region and is safe to return / store, regardless of the
            ; boxed value's own (now stale) Local life. (A named-region box falls
            ; through to the conservative pointee-life check below.)
            choose op.expr
                when b: Box
                {
                    if b.target_page.equals("this")
                        return Planner.region_rank_caller()
                    if b.target_page.equals("rp")
                        return Planner.region_rank_caller()
                    ; A box targeting a PARAMETER (`&^page v` in a `#`
                    ; function whose declared page param is `page`, or
                    ; `&^obj v` onto a receiver object's page) copies onto
                    ; caller-lived memory — the caller owns both its pages
                    ; and its objects. Rank Caller so the return checks
                    ; accept it (box_value's box_point#). A named LOCAL page
                    ; still falls through to the conservative pointee check.
                    let pb this.lookup_local_binding(b.target_page)
                    if pb <> null
                        if pb.is_parameter
                            return Planner.region_rank_caller()
                }
                when v: Variable
                {
                    ; A local bound to a `&^this`/`&^rp` box (recorded in
                    ; local_box_names at plan_binding#) points at a surviving
                    ; page even though its binding_type carries the boxed value's
                    ; stale Local inner. Rank it Caller so `let r &^this <call>;
                    ; <intervening statements>; return r` is accepted. Only a bare
                    ; Variable read (no member-access hop) qualifies.
                    if op.member_access = null
                        if this.array_contains_name(local_box_names, v.name)
                            return Planner.region_rank_caller()
                }
                when c: PlannedCall
                {
                    ; Borrow-return holder (2026-07-03): `&NAME` where NAME's
                    ; binding was promoted to the caller page by the addr-taken/
                    ; getref rule (promoted_binding_names) points at rp-lived
                    ; memory even though the stamped pointee life still reads
                    ; Local (restamp_operand_life# rewrites call.life, not
                    ; result_type.life). Rank the reference Caller so the
                    ; return/tail escape gates accept the de-sigiled restamp/
                    ; unify shape (`var out Vector[T](n) ... &out`). Only the
                    ; exact intrinsic `&` over a bare promoted Variable
                    ; qualifies; everything else falls through to the
                    ; conservative pointee-life check below.
                    if c.is_operator
                        if c.name.equals("&")
                            if c.args <> null
                            {
                                let amp_args (*c.args)
                                if amp_args.length = 1
                                {
                                    let amp_a0 amp_args.get 0
                                    if amp_a0 <> null
                                        if (*amp_a0).member_access = null
                                            choose (*amp_a0).expr
                                                when av: Variable
                                                    if this.array_contains_name(promoted_binding_names, av.name)
                                                        return Planner.region_rank_caller()
                                                else
                                                    0
                                }
                            }
                }
                else
                    0
            if Planner.is_reference_to_local_page(op.result_type)
                return Planner.region_rank_local()
            Planner.region_rank_caller()
        }

        ; required_region_for_escape#: the minimum pointee rank an escape sink
        ; (return / store into Caller-lived memory / pass to a storing callee)
        ; demands. TODAY constant Caller — anything Local-ranked escapes. Stage D
        ; refines this per destination (the returned-into caller region, the
        ; stored-into param's age, the callee's stored-dest age).
        function required_region_for_escape() returns size_t
            Planner.region_rank_caller()

        ; is_local_ref_pointer: the REFERENCE half of is_reference_to_local_
        ; page# — true ONLY when `t` is a pointer/ref whose inner pointee has
        ; Local life (a genuine `&<frame-local>` reference). It deliberately
        ; OMITS the leading `t.life==Local` clause, which also matches a Local-
        ; life VALUE type (e.g. a type-metadata PlannedType returned by copy
        ; into sret — find_break_type_in_*). Used by plan_binding#'s step-3
        ; gap-1 exclusion: a binding holding such a reference is not a
        ; relocatable allocation and must not be promoted, but a Local-life
        ; value binding stays promotable (returned by copy, no dangle).
        function is_local_ref_pointer(t: PlannedType) returns bool
        {
            var result false
            var is_ref_like false
            if t.name.equals("pointer")
                set is_ref_like: true
            if t.name.equals("ref")
                set is_ref_like: true
            if is_ref_like
            {
                if t.generics <> null
                {
                    let gens (*t.generics)
                    if gens.length > (0 as size_t)
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            choose inner.life
                                when loc: Local
                                    set result: true
                                else
                                    0
                        }
                    }
                }
            }
            ; Option-of-ref piercing (Option B, 2026-07-02h): `ref[T]?` plans
            ; as Option[ref[T]] — a STAMPED get-ref out of a frame-local-page
            ; holder carries its Local pointee on the INNER reference, which
            ; the Option wrapper otherwise hides from every escape site.
            ; Recurse into the Option's first generic; the recursion only
            ; fires when that inner is itself a pointer/ref with a Local
            ; pointee, so unstamped Option-of-ref (declared signatures,
            ; Unspecified life) stays invisible exactly as before.
            if t.name.equals("Option")
            {
                if t.generics <> null
                {
                    let gens_o (*t.generics)
                    if gens_o.length > (0 as size_t)
                    {
                        let io_ptr gens_o.get 0
                        if io_ptr <> null
                            if Planner.is_local_ref_pointer((*io_ptr))
                                set result: true
                    }
                }
            }
            result
        }

        ; result_type_is_value_struct: true when `t` is a by-VALUE struct held
        ; in the frame — not a pointer/ref, and not an Option whose inner is a
        ; reference (NPO auto-deref). The type-based twin of base_is_value_
        ; struct# (which keys off a binding name); used at construction time in
        ; plan_binding# before the local is defined.
        function result_type_is_value_struct(this: Planner, t: PlannedType) returns bool
        {
            var result true
            if t.name.equals("pointer")
                set result: false
            if t.name.equals("ref")
                set result: false
            if t.name.equals("Option")
                if this.option_inner_is_reference(t)
                    set result: false
            result
        }

        ; Hole-1 field provenance: true when `op` is a construction (a
        ; value-struct Tuple or an init# ctor Call) one of whose arguments is a
        ; `&<frame-local>` reference (result_type is pointer/ref with Local
        ; inner). Such an arg stores a frame address into one of the new
        ; struct's pointer fields. Scans Tuple component value-operands and
        ; Call args. Single-exit; only flat loops (no nested choose) to dodge
        ; the bootstrap-nest miscompile.
        function construction_has_local_ref_arg(this: Planner, op: PlannedOperand) returns bool
        {
            var result false
            choose op.expr
                when t: Tuple
                {
                    if t.components <> null
                    {
                        let comps (*t.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let cp comps.get i
                            if cp <> null
                            {
                                let comp (*cp)
                                if comp.value <> null
                                {
                                    let vals (*comp.value)
                                    var j: size_t 0
                                    while j < vals.length
                                    {
                                        let vp vals.get j
                                        if vp <> null
                                            if Planner.is_local_ref_pointer(vp.result_type)
                                                set result: true
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                }
                when c: Call
                {
                    if c.args <> null
                    {
                        let args (*c.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let ap args.get i
                            if ap <> null
                                if Planner.is_local_ref_pointer(ap.result_type)
                                    set result: true
                            set i: i + 1
                        }
                    }
                }
                else
                    0
            result
        }

        ; Hole-1 field provenance: true when `op` reads a reference-like FIELD
        ; of a tainted frame-local value-struct binding (`h.p` where h was
        ; constructed with a &<frame-local> arg). Returning / storing / passing
        ; such a field hands out the frame address. Single-exit.
        function operand_reads_tainted_local_field(this: Planner, op: PlannedOperand) returns bool
        {
            var result false
            choose op.expr
                when v: Variable
                {
                    if op.member_access <> null
                    {
                        let chain (*op.member_access)
                        if chain.length > (0 as size_t)
                            if this.array_contains_name(local_tainted_struct_bindings, v.name)
                                if Planner.is_reference_like(op.result_type)
                                    set result: true
                    }
                }
                else
                    0
            result
        }

        ; taint_field_read_by_name#: at the member-access read site, if the base
        ; local binding `name` is TAINTED (constructed with a &<frame-local> arg)
        ; and the read FIELD type `t` is reference-like, return the same outer
        ; type with the inner pointee flipped to Local — the field holds a frame
        ; address, so the operand TYPE must carry that Local signal for the
        ; pass-to-callee post-pass (which runs after the per-fn taint set is torn
        ; down) to reject it via is_reference_to_local_page#. Identity (returns
        ; `t`) unless `name` is in the taint set, so a no-op for all non-test
        ; code (no tainted bindings there). Return/store are also covered by
        ; operand_reads_tainted_local_field#; this additionally makes the
        ; uniform check fire at the interprocedural call boundary.
        function taint_field_read_by_name(this: Planner, name: String, t: PlannedType) returns PlannedType
        {
            var result: PlannedType t
            if this.array_contains_name(local_tainted_struct_bindings, name)
                if Planner.is_reference_like(t)
                    set result: Planner.make_ref_to_local_inner(t)
            result
        }

        ; ================================================================
        ; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
        ;
        ; A reference into a Local ($) page passed to a callee that STORES
        ; it into frame-external memory (its `this`/param field, a global,
        ; or a pointer deref) is a use-after-free once the local page is
        ; freed at scope exit. Implemented as a POST-PASS Plan-tree walker
        ; (call discovery in ONE place rather than the many scattered
        ; PlannedCall construction sites in collapse_operand_sequence#).
        ;
        ; Two passes over every planned function body:
        ;   Pass 0 (collect): record which parameter a function stores
        ;                     frame-external, and into which destination.
        ;   Pass 1 (check):   at each call, if a local-page-ref arg is bound
        ;                     to such a param AND the destination outlives
        ;                     the arg -> hard diagnostic.
        ; Non-transitive (a param escaping only via a deeper escaping callee
        ; is not chased) — documented limitation, mirrors Planner.cpp.
        ;
        ; The walk mirrors the Emitter's body walk EXACTLY (emit_function_body
        ; -> emit_action -> emit_operands -> emit_operand / emit_statement),
        ; the only shape proven not to corrupt under stage-0 codegen.
        ; ================================================================

        ; True when `t` is a bare reference-like type (pointer[T]/ref[T]),
        ; regardless of pointee lifetime. Used at collect time on a callee's
        ; stored parameter; the local-page determination happens at the call
        ; site via is_reference_to_local_page. Mirrors isReferenceLikeType.
        function is_reference_like(t: PlannedType) returns bool
        {
            let ptr_name "pointer"
            if t.name.equals(ptr_name)
                return true
            let ref_name "ref"
            if t.name.equals(ref_name)
                return true
            false
        }

        ; True when a call's RESULT genuinely owns heap guts allocated on the
        ; passed page — i.e. the only return shape the default-to-local flip
        ; should stamp Local. Borrows/handles are EXCLUDED: pointer[T]/ref[T]
        ; (and ref[T]?/pointer[T]? under NPO, which resolve to name "ref"/
        ; "pointer") point into memory the callee already owns elsewhere, and
        ; extern LLVM-C wrapper structs (LLVMValueRef/TypeRef/MetadataRef/...)
        ; wrap LLVM-context-owned memory, not a Scaly page. Stamping any of
        ; these Local is a false escape (the flip's coarse `call_requires_page`
        ; gate fired on every class/union/wrapper return).
        function result_owns_page_guts(t: PlannedType) returns bool
        {
            if Planner.is_reference_like(t)
                return false
            if t.name.starts_with("LLVM")
                return false
            ; ref[T]?/pointer[T]? are modeled as Option[ref[T]]/Option[pointer[T]]
            ; (Modeler.handle_type# wraps an optional in Option[..]); under NPO
            ; that is a nullable borrow — exclude when the Option's inner is
            ; reference-like. Option[value] (e.g. String?) DOES own guts -> keep.
            if t.name.equals("Option")
            {
                if t.generics <> null
                {
                    let gens (*t.generics)
                    if gens.length > (0 as size_t)
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            if Planner.is_reference_like(inner)
                                return false
                        }
                    }
                }
            }
            true
        }

        ; Index of a parameter named `name` in the CURRENT function's Input
        ; (re-fetched via escape_fn_index), or -1. Excludes the page param
        ; (which is not part of the arg<->param mapping), matching the C++
        ; CalleeParamNames (Input only).
        function escape_param_index_current(this: Planner, name: String) returns int
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return -1
            if fp.input = null
                return -1
            var i: size_t 0
            while i < fp.input.length
            {
                let it_ptr fp.input.get i
                if it_ptr <> null
                {
                    let nm_ptr it_ptr.name
                    if nm_ptr <> null
                    {
                        let nm (*nm_ptr)
                        if nm.equals(name)
                            return (i as int)
                    }
                }
                set i: i + 1
            }
            -1
        }

        ; The current function's Input length (the callee param count recorded
        ; in a summary entry; used to right-align a call's args).
        function escape_current_param_count(this: Planner) returns size_t
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return 0
            if fp.input = null
                return 0
            fp.input.length
        }

        ; True when `name` is a parameter (or page receiver) of the CURRENT
        ; function — i.e. caller-provided memory that outlives this frame.
        ; Mirrors the EscapeFnParams membership test (Input + PageParam).
        function escape_name_is_current_param(this: Planner, name: String) returns bool
        {
            let fp instantiated_functions.get escape_fn_index
            if fp = null
                return false
            if fp.page_parameter <> null
            {
                let pp (*fp.page_parameter)
                if pp.equals(name)
                    return true
            }
            if fp.input = null
                return false
            var i: size_t 0
            while i < fp.input.length
            {
                let it_ptr fp.input.get i
                if it_ptr <> null
                {
                    let nm_ptr it_ptr.name
                    if nm_ptr <> null
                    {
                        let nm (*nm_ptr)
                        if nm.equals(name)
                            return true
                    }
                }
                set i: i + 1
            }
            false
        }

        ; A destination arg outlives the (local-page) arg passed alongside it
        ; when it refers to memory living beyond the current frame: a parameter
        ; of the current function, or a #/^ allocated value, or a module
        ; global. A same-frame $/stack local dies WITH the arg -> safe.
        ; Mirrors Planner.cpp::escapeDestArgOutlives.
        function escape_dest_arg_outlives(this: Planner, op: PlannedOperand) returns bool
        {
            choose op.expr
                when v: Variable
                {
                    if this.escape_name_is_current_param(v.name)
                        return true
                    choose op.result_type.life
                        when c: Call
                            return true
                        when r: Reference
                            return true
                        else
                            0
                    choose v.variable_type.life
                        when c: Call
                            return true
                        when r: Reference
                            return true
                        else
                            0
                    return false
                }
                when g: GlobalRef
                    return true
                else
                    0
            false
        }

        ; binding_inits_stack_closure: true when a PlannedBinding's initializer
        ; is a stack (Lifetime.Local) closure — i.e. `let g: Cb \x: …` whose
        ; make_closure# stamped Local (env on the frame). Read structurally from
        ; the Plan tree so the escape post-pass needs no plan-time state.
        function binding_inits_stack_closure(this: Planner, binding: PlannedBinding) returns bool
        {
            if binding.operation = null
                return false
            let ops (*binding.operation)
            if ops.length = 0
                return false
            let op0_ptr ops.get 0
            if op0_ptr = null
                return false
            choose (*op0_ptr).expr
                when clo: Closure
                {
                    choose clo.life
                        when l: Local
                            return true
                        else
                            return false
                }
                else
                    return false
            false
        }

        ; arg_is_stack_closure: true when a call ARGUMENT is a bare read (no
        ; member hop) of a name recorded in current_fn_closure_names — a stack
        ; closure of the calling function. Passing it to a callee that stores
        ; its parameter frame-external dangles once this frame exits.
        function arg_is_stack_closure(this: Planner, arg: PlannedOperand) returns bool
        {
            if arg.member_access <> null
            {
                let ma (*arg.member_access)
                if ma.length > (0 as size_t)
                    return false
            }
            choose arg.expr
                when v: Variable
                    return this.array_contains_name(current_fn_closure_names, v.name)
                else
                    return false
            false
        }

        ; Pass 0: at a frame-external store of a current-function parameter
        ; reference, record a summary entry. Reuses the Vector-2 store shape
        ; (value = a bare reference-like param; target = param.field / global
        ; / deref). Runs only in collect mode.
        function escape_handle_store(this: Planner, act: PlannedAction)
        {
            if escape_checking
                return
            ; Store facts are gathered once in the direct-collect pass; the
            ; forwarding fixpoint must not re-record them (would never converge).
            if escape_forwarding
                return
            if act.source = null
                return
            if act.target = null
                return
            if act.source.length = 0
                return
            if act.target.length = 0
                return
            let val_ptr act.source.get 0
            if val_ptr = null
                return
            let tgt_ptr act.target.get 0
            if tgt_ptr = null
                return
            let val val_ptr.unwrap()
            let tgt tgt_ptr.unwrap()

            ; Value must be a bare reference-like PARAMETER of the current fn.
            var stored_param_index: int -1
            choose val.expr
                when v: Variable
                {
                    var val_has_member false
                    if val.member_access <> null
                    {
                        let vma (*val.member_access)
                        if vma.length > (0 as size_t)
                            set val_has_member: true
                    }
                    if val_has_member = false
                    {
                        ; A stored param is escapable if it is a pointer/ref
                        ; (Vector-2 shape) OR a delegate (closure value): a
                        ; callee storing a delegate PARAM frame-external makes
                        ; whatever closure the caller passes outlive this frame;
                        ; the call check then flags callers passing a STACK
                        ; closure (a heap `#` closure / a borrowed param is fine).
                        var val_is_escapable false
                        if Planner.is_reference_like(val.result_type)
                            set val_is_escapable: true
                        if this.is_delegate_type(val.result_type.name)
                            set val_is_escapable: true
                        if val_is_escapable
                            set stored_param_index: this.escape_param_index_current(v.name)
                    }
                }
                else
                    0
            if stored_param_index < 0
                return

            ; Destination: a param's `.field` (dest_kind 0) / global / deref
            ; (dest_kind 1). A bare reassignment or same-frame local.field is
            ; not frame-external -> skip.
            var dest_kind: int -1
            var dest_index: int 0
            choose tgt.expr
                when tv: Variable
                {
                    var tgt_has_member false
                    if tgt.member_access <> null
                    {
                        let tma (*tgt.member_access)
                        if tma.length > (0 as size_t)
                            set tgt_has_member: true
                    }
                    if tgt_has_member
                    {
                        let ti this.escape_param_index_current(tv.name)
                        if ti >= 0
                        {
                            set dest_kind: 0
                            set dest_index: ti
                        }
                    }
                }
                when g: GlobalRef
                    set dest_kind: 1
                when c: Call
                    set dest_kind: 1
                else
                    0
            if dest_kind < 0
                return

            let cpc this.escape_current_param_count()
            escape_records.add(EscapeRecord(
                escape_fn_index,
                cpc,
                (stored_param_index as size_t),
                (dest_kind as size_t),
                (dest_index as size_t)
            ))
        }

        ; Pass 1: check one call against one summary entry.
        function escape_check_call_record(this: Planner, call: PlannedCall, rec: EscapeRecord)
        {
            if escape_found
                return
            let callee instantiated_functions.get rec.callee_fn_index
            if callee = null
                return
            if callee.mangled_name.equals(call.mangled_name) = false
                return
            if call.args = null
                return
            if call.args.length < rec.callee_param_count
                return
            let off call.args.length - rec.callee_param_count
            let arg_idx off + rec.param_index
            if arg_idx >= call.args.length
                return
            let arg_ptr call.args.get arg_idx
            if arg_ptr = null
                return
            let arg arg_ptr.unwrap()
            ; The arg escapes if it is a Local-page ref (Vector-2 shape) OR a
            ; STACK closure of the calling function (Vector-3 closure variant):
            ; either way, the callee stashes it into memory that outlives this
            ; frame. A heap `#` closure / a delegate PARAM arg is not local.
            var arg_is_closure false
            if this.arg_is_stack_closure(arg)
                set arg_is_closure: true
            var arg_escapes false
            if this.region_of_operand(arg) < Planner.required_region_for_escape()
                set arg_escapes: true
            if arg_is_closure
                set arg_escapes: true
            if arg_escapes
            {
                var violates false
                if rec.dest_kind = 1
                    set violates: true
                if rec.dest_kind = 0
                {
                    let dest_idx off + rec.dest_index
                    if dest_idx < call.args.length
                    {
                        let dest_ptr call.args.get dest_idx
                        if dest_ptr <> null
                            set violates: this.escape_dest_arg_outlives(dest_ptr.unwrap())
                    }
                }
                if violates
                {
                    ; The post-pass runs after plan_module# restored this.file,
                    ; so set it to the calling function's own file (re-fetched
                    ; via escape_fn_index) before reporting — else the offset is
                    ; formatted against the stale entry file.
                    let cur_fn instantiated_functions.get escape_fn_index
                    if cur_fn <> null
                        set this.file: String^this(cur_fn.file)
                    if arg_is_closure
                        this.add_diagnostic(call.loc, "a closure bound to a local lives on the stack frame and escapes via call - the callee stores it into memory that outlives this frame; return the lambda directly (return \\x: ...) instead of binding it to a local first")
                    else
                        this.add_diagnostic(call.loc, "reference into a local page escapes via call - the callee stores it into memory that outlives this frame; allocate with '#' (caller page) or '^name' (region)")
                    set escape_found: true
                }
            }
        }

        ; Pass 1: a call may match several summary entries (e.g. two escaping
        ; params); check each.
        function escape_handle_call(this: Planner, call: PlannedCall)
        {
            if escape_found
                return
            if call.args = null
                return
            ; Forwarding fixpoint pass: grow the summary instead of checking.
            if escape_forwarding
            {
                this.escape_forward_call(call)
                return
            }
            if escape_checking = false
                return
            var ri: size_t 0
            while ri < escape_records.length
            {
                if escape_found
                    return
                let rec_ptr escape_records.get ri
                if rec_ptr <> null
                    this.escape_check_call_record(call, (*rec_ptr))
                set ri: ri + 1
            }
        }

        ; True when the summary already carries a record equal to this one
        ; (callee_fn_index + param_index + dest_kind + dest_index). callee_param_
        ; count is derived from callee_fn_index so it is not part of identity.
        ; Dedup is what makes the forwarding fixpoint terminate.
        function escape_record_exists(this: Planner, fn_index: size_t, param_index: size_t, dest_kind: size_t, dest_index: size_t) returns bool
        {
            var ri: size_t 0
            while ri < escape_records.length
            {
                let rec_ptr escape_records.get ri
                if rec_ptr <> null
                {
                    let rec (*rec_ptr)
                    if rec.callee_fn_index = fn_index
                        if rec.param_index = param_index
                            if rec.dest_kind = dest_kind
                                if rec.dest_index = dest_index
                                    return true
                }
                set ri: ri + 1
            }
            false
        }

        ; Forwarding fixpoint (pass 0.5): a call may forward several params into
        ; several persisting callee slots; test the current summary against each
        ; matching record. Snapshot the length so records added during this call
        ; are not re-processed here (the outer fixpoint loop propagates them).
        function escape_forward_call(this: Planner, call: PlannedCall)
        {
            let n escape_records.length
            var ri: size_t 0
            while ri < n
            {
                let rec_ptr escape_records.get ri
                if rec_ptr <> null
                    this.escape_forward_call_record(call, (*rec_ptr))
                set ri: ri + 1
            }
        }

        ; Forwarding fixpoint core: if this call passes a bare reference-like/
        ; delegate PARAMETER of the current function into the callee's persisting
        ; slot (rec.param_index), then the current function itself persists that
        ; parameter — into whatever the callee's destination maps to from the
        ; current frame. Records a new summary entry for the current function
        ; (dedup'd). Mirrors the arg<->param mapping of escape_check_call_record.
        function escape_forward_call_record(this: Planner, call: PlannedCall, rec: EscapeRecord)
        {
            let callee instantiated_functions.get rec.callee_fn_index
            if callee = null
                return
            if callee.mangled_name.equals(call.mangled_name) = false
                return
            if call.args = null
                return
            if call.args.length < rec.callee_param_count
                return
            let off call.args.length - rec.callee_param_count
            let arg_idx off + rec.param_index
            if arg_idx >= call.args.length
                return
            let arg_ptr call.args.get arg_idx
            if arg_ptr = null
                return
            let arg arg_ptr.unwrap()

            ; The forwarded arg must be a BARE reference-like/delegate parameter
            ; of the current function (a member hop or a non-param disqualifies).
            var arg_has_member false
            if arg.member_access <> null
            {
                let ama (*arg.member_access)
                if ama.length > (0 as size_t)
                    set arg_has_member: true
            }
            if arg_has_member
                return
            var arg_is_escapable false
            if Planner.is_reference_like(arg.result_type)
                set arg_is_escapable: true
            if this.is_delegate_type(arg.result_type.name)
                set arg_is_escapable: true
            if arg_is_escapable = false
                return
            var fwd_param_index: int -1
            choose arg.expr
                when v: Variable
                    set fwd_param_index: this.escape_param_index_current(v.name)
                else
                    0
            if fwd_param_index < 0
                return

            ; Map the callee's destination into the current frame.
            ;   callee dest_kind 1 (global/deref)      -> current frame-external.
            ;   callee dest_kind 0 (callee param D)    -> whatever the current fn
            ;     passed as that arg: a current param  -> dest_kind 0 at that
            ;     param; a global/#/^ outliving value  -> dest_kind 1; a same-
            ;     frame local                          -> no escape, skip.
            var new_dest_kind: int -1
            var new_dest_index: int 0
            if rec.dest_kind = 1
                set new_dest_kind: 1
            else
            {
                let dest_idx off + rec.dest_index
                if dest_idx < call.args.length
                {
                    let dest_ptr call.args.get dest_idx
                    if dest_ptr <> null
                    {
                        let dest_op dest_ptr.unwrap()
                        var dest_has_member false
                        if dest_op.member_access <> null
                        {
                            let dma (*dest_op.member_access)
                            if dma.length > (0 as size_t)
                                set dest_has_member: true
                        }
                        var dest_param_index: int -1
                        if dest_has_member = false
                            choose dest_op.expr
                                when dv: Variable
                                    set dest_param_index: this.escape_param_index_current(dv.name)
                                else
                                    0
                        if dest_param_index >= 0
                        {
                            set new_dest_kind: 0
                            set new_dest_index: dest_param_index
                        }
                        else
                            if this.escape_dest_arg_outlives(dest_op)
                                set new_dest_kind: 1
                    }
                }
            }
            if new_dest_kind < 0
                return

            let cpc this.escape_current_param_count()
            if this.escape_record_exists(escape_fn_index, (fwd_param_index as size_t), (new_dest_kind as size_t), (new_dest_index as size_t))
                return
            escape_records.add(EscapeRecord(
                escape_fn_index,
                cpc,
                (fwd_param_index as size_t),
                (new_dest_kind as size_t),
                (new_dest_index as size_t)
            ))
        }

        ; Walk all operands in a (nullable) operand vector. Takes the
        ; ref[Vector]? field directly + auto-derefs (a by-value Vector param
        ; corrupts .length). Element passed by value via .unwrap(), mirroring
        ; emit_operands -> emit_operand(first.unwrap()).
        function escape_walk_operands(this: Planner, ops: ref[Vector[PlannedOperand]]?)
        {
            if escape_found
                return
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                if escape_found
                    return
                let op_ptr ops.get i
                if op_ptr <> null
                    this.escape_walk_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        ; Walk one statement reached through a ref[PlannedStatement]? field.
        function escape_walk_statement_ref(this: Planner, stmt: ref[PlannedStatement]?)
        {
            if escape_found
                return
            if stmt <> null
            {
                let s stmt
                this.escape_walk_statement((*s))
            }
        }

        ; Walk one operand by value. choose op.expr mirrors emit_operand;
        ; the recursive arms mirror Planner.cpp::escapeWalkOperand.
        function escape_walk_operand(this: Planner, op: PlannedOperand)
        {
            if escape_found
                return
            choose op.expr
                when call: Call
                {
                    this.escape_handle_call(call)
                    this.escape_walk_operands(call.args)
                }
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.escape_walk_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.escape_walk_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.escape_walk_operands(iff.condition)
                    this.escape_walk_statement_ref(iff.consequent)
                    this.escape_walk_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.escape_walk_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.escape_walk_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.escape_walk_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.escape_walk_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.escape_walk_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.escape_walk_operands(fr.expr)
                    this.escape_walk_action(fr.body)
                }
                when wh: While
                {
                    this.escape_walk_operands(wh.cond.operation)
                    this.escape_walk_action(wh.body)
                }
                when tr: Try
                {
                    this.escape_walk_operands(tr.cond.operation)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.escape_walk_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.escape_walk_statement_ref(tr.alternative)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.escape_walk_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.escape_walk_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.escape_walk_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.escape_walk_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                else
                    0
        }

        ; Walk one statement by value. choose stmt mirrors emit_statement.
        function escape_walk_statement(this: Planner, stmt: PlannedStatement)
        {
            if escape_found
                return
            choose stmt
                when action: Action
                    this.escape_walk_action(action)
                when binding: Binding
                {
                    ; Record a stack (Local) closure binding's name so a later
                    ; call in this function can flag passing it to a storing
                    ; callee. Detected structurally from the Plan tree.
                    if binding.binding_item.name <> null
                        if this.binding_inits_stack_closure(binding)
                            current_fn_closure_names.add(String((*binding.binding_item.name)))
                    this.escape_walk_operands(binding.operation)
                }
                when ret: Return
                    this.escape_walk_operands(ret.result)
                when throw_stmt: Throw
                    this.escape_walk_operands(throw_stmt.result)
                when brk: Break
                    this.escape_walk_operands(brk.result)
                when cont: Continue
                    0
        }

        ; Walk one action by value (the whole PlannedAction, mirroring
        ; emit_action(action)). Handle the store first, then recurse into
        ; the source/target operand vectors.
        function escape_walk_action(this: Planner, act: PlannedAction)
        {
            if escape_found
                return
            this.escape_handle_store(act)
            this.escape_walk_operands(act.source)
            this.escape_walk_operands(act.target)
        }

        ; Walk one function body. Mirrors emit_function_body: choose func.impl
        ; and feed the whole Action by value to escape_walk_action.
        function escape_walk_function_body(this: Planner, func: PlannedFunction)
        {
            ; Reset the per-function stack-closure name set; it is repopulated
            ; in evaluation order as escape_walk_statement encounters each
            ; Local-closure binding (a binding always precedes any use of its
            ; name, so a later call passing the closure sees it).
            set current_fn_closure_names.length: 0
            choose func.impl
                when action: Action
                    this.escape_walk_action(action)
                else
                    0
        }

        ; Post-pass entry: two passes over instantiated_functions.
        function check_interprocedural_escapes(this: Planner)
        {
            ; Pass 0: build the escape summary.
            set escape_checking: false
            set escape_found: false
            var i: size_t 0
            for func in instantiated_functions
            {
                set escape_fn_index: i
                this.escape_walk_function_body(func)
                set i: i + 1
            }

            ; Clean code records nothing -> nothing to check.
            if escape_records.length = 0
                return

            ; Pass 0.5: transitive closure of the summary. A function that only
            ; FORWARDS a reference/delegate parameter to a storing callee (rather
            ; than storing it itself) inherits a persist-parameter fact. Repeat
            ; the whole-program walk until no new fact is recorded — the summary
            ; only grows and dedup bounds it, so this terminates.
            set escape_forwarding: true
            var changed true
            while changed
            {
                let before escape_records.length
                var k: size_t 0
                for func in instantiated_functions
                {
                    set escape_fn_index: k
                    this.escape_walk_function_body(func)
                    set k: k + 1
                }
                set changed: escape_records.length <> before
            }
            set escape_forwarding: false

            ; Pass 1: check every call against the summary.
            set escape_checking: true
            var j: size_t 0
            for func in instantiated_functions
            {
                if escape_found = false
                {
                    set escape_fn_index: j
                    this.escape_walk_function_body(func)
                }
                set j: j + 1
            }
        }

        ; Page inference: re-stamp the allocation lifetime of a promotable
        ; operand. Shared by rule 2 (return-escape -> caller page `Call`) and
        ; rule 3 (store-into-`this`-field -> receiver page `Reference("this")`).
        ; Promotion only applies when the operand IS the allocation expression
        ; (a construction/method Call or a Tuple) AND its RESULT genuinely owns
        ; heap guts on the page (result_owns_page_guts) — a pointer/ref result
        ; (e.g. `&b` where b is a local) points into memory that stays put no
        ; matter where the `&` "allocates", so promoting it would be a false
        ; fix that masks a real dangle. Intrinsic OPERATOR calls (`&`, `*`, …)
        ; are likewise never promoted (their result aliases existing storage).
        ; Returns null for the non-promotable shapes (bare local Variable whose
        ; allocation happened at an earlier `let`, ref into a local pointee) so
        ; the caller keeps the hard escape diagnostic — those still need an
        ; explicit annotation or a later dataflow pass. Only call.life is
        ; re-stamped (everything else copied verbatim): rebuilding the
        ; result_type, which embeds the Lifetime union, by value trips the
        ; s34/s196 union-struct-copy ABI hazard and crashes the emitter.
        function restamp_operand_life(this: Planner, op: PlannedOperand, new_life: Lifetime) returns ref[PlannedOperand]?
        {
            if Planner.result_owns_page_guts(op.result_type) = false
                return null
            choose op.expr
                when c: PlannedCall
                {
                    if c.is_operator
                        return null
                    ; ONLY promote a DEFAULTED allocation — Local (`$` and
                    ; no-sigil heap-backed via R1) or Unspecified (no-sigil
                    ; page-owning stack type, e.g. a `Vector[T](…)` whose data
                    ; buffer would otherwise land on the local page). An
                    ; allocation that already carries an EXPLICIT lifetime —
                    ; `^name` (Reference) or `#` (Call) — was placed deliberately
                    ; by the programmer; re-stamping it would override the
                    ; explicit page and dangle (e.g. lexer's `let name
                    ; String^page(…); return name` must keep `^page`). The
                    ; result_owns_page_guts gate above already excludes pure
                    ; stack values (no page buffer) and borrows (pointer/ref).
                    var c_local false
                    choose c.life
                        when l: Local
                            set c_local: true
                        when u: Unspecified
                            set c_local: true
                        else
                            0
                    if c_local = false
                        return null
                    ; Recursively promote the construction's ARGUMENTS to the
                    ; same page: an inline construction in an arg position
                    ; (`T(String(x), …)`) becomes a field of the escaping
                    ; aggregate, so its heap guts must outlive the frame too.
                    ; restamp_args# keeps non-owning/explicit args verbatim.
                    var new_args: ref[Vector[PlannedOperand]]? c.args
                    if c.args <> null
                        set new_args: this.restamp_args((*c.args), new_life)
                    let nc PlannedCall(
                        c.loc, c.name, c.mangled_name, c.is_intrinsic, c.is_operator,
                        c.can_throw, c.requires_page_param, new_args,
                        c.result_type, new_life, c.throws_type, c.is_indirect
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.Call nc, op.member_access, op.result_type)
                }
                when t: PlannedTuple
                {
                    var t_local false
                    choose t.life
                        when l: Local
                            set t_local: true
                        when u: Unspecified
                            set t_local: true
                        else
                            0
                    if t_local = false
                        return null
                    ; Recursively promote the tuple's component values (struct
                    ; field constructions) to the same page — same reasoning as
                    ; the PlannedCall arg recursion above.
                    var new_comps: ref[Vector[PlannedComponent]]? t.components
                    if t.components <> null
                        set new_comps: this.restamp_components((*t.components), new_life)
                    let nt PlannedTuple(
                        t.loc, new_comps, t.tuple_type,
                        true, new_life, t.region_arg
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.Tuple nt, op.member_access, op.result_type)
                }
                else
                    return null
            null
        }
        ; Recursively re-stamp the operands of a promoted construction's
        ; argument list / component values: each arg that is itself a defaulted
        ; page-owning construction is promoted to the SAME life (it becomes a
        ; field of the escaping aggregate). Args that don't own page guts
        ; (primitives, borrows) or already carry an explicit lifetime are kept
        ; verbatim — restamp_operand_life# returns null for them. Bound-local
        ; args (a Variable) are likewise kept (their own binding is promoted via
        ; the name-graph); only INLINE constructions are restamped here.
        function restamp_args(this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) returns ref[Vector[PlannedOperand]]?
        {
            var out Vector[PlannedOperand](args.length)
            var i: size_t 0
            while i < args.length
            {
                let ap args.get i
                if ap <> null
                {
                    let promoted this.restamp_operand_life((*ap), new_life)
                    if promoted <> null
                        out.put(i, (*promoted))
                    if promoted = null
                        out.put(i, (*ap))
                }
                set i: i + 1
            }
            &out
        }
        ; Restamp ONLY inline-CONSTRUCTION value-arguments (a Tuple = struct/
        ; variant ctor, or a PlannedCall that is a CONSTRUCTION: a capitalized
        ; name = a Type construction such as LoopSyntax, OR name "init" = a
        ; value-type init# constructor such as String/Vector/Array/HashMap —
        ; these lower to a PlannedCall to the lowercase `init` method, NOT a
        ; capitalized Type name, so the capitalized gate alone misses them and
        ; the de-sigiled `recv.put(0, "x")` left its String on the local
        ; page) of a put/add into an escaping receiver. A regular function-call
        ; RESULT (lowercase non-`init` name) owns its own page routing and must
        ; NOT be overridden — promoting it cascades a bogus caller-page need
        ; across the call graph (the over-flag class). `init` is reserved for
        ; constructors (init/init#/init^ per the spec), so it never names a plain
        ; function. The receiver Variable, the index, call results and explicit-#
        ; args are all kept verbatim (restamp_operand_life# returns null for
        ; them — explicit-# is Call life, gated out — so this stays NEUTRAL on
        ; sigiled source).
        function restamp_putadd_constructions(this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) returns ref[Vector[PlannedOperand]]?
        {
            var out Vector[PlannedOperand](args.length)
            var i: size_t 0
            while i < args.length
            {
                let ap args.get i
                if ap <> null
                {
                    var is_ctor false
                    choose (*ap).expr
                        when c: PlannedCall
                        {
                            if c.is_operator = false
                            {
                                if this.name_is_capitalized(c.name)
                                    set is_ctor: true
                                if c.name.equals("init")
                                    set is_ctor: true
                                ; CALL-# de-sigil: a has_page function-call RESULT
                                ; (lowercase, e.g. `arr.add(plan_type(pt))`)
                                ; put/added into an escaping receiver must move to
                                ; rp like the `#` form did. restamp_operand_life#
                                ; self-gates (result_owns_page_guts + Local/
                                ; Unspecified life), so an explicit-`#` call (Call
                                ; life) returns null → kept verbatim → NEUTRAL on
                                ; sigiled source; only a de-sigiled call (Design-B
                                ; Local life) is flipped Local→Call (= rp).
                                if c.requires_page_param
                                    set is_ctor: true
                            }
                        }
                        when t: PlannedTuple
                            set is_ctor: true
                        else
                            0
                    if is_ctor = false
                        out.put(i, (*ap))
                    if is_ctor
                    {
                        let promoted this.restamp_operand_life((*ap), new_life)
                        if promoted <> null
                            out.put(i, (*promoted))
                        if promoted = null
                            out.put(i, (*ap))
                    }
                }
                set i: i + 1
            }
            &out
        }
        function restamp_components(this: Planner, comps: Vector[PlannedComponent], new_life: Lifetime) returns ref[Vector[PlannedComponent]]?
        {
            var out Vector[PlannedComponent](comps.length)
            var i: size_t 0
            while i < comps.length
            {
                let cp comps.get i
                if cp <> null
                {
                    let c (*cp)
                    var new_value: ref[Vector[PlannedOperand]]? c.value
                    if c.value <> null
                        set new_value: this.restamp_args((*c.value), new_life)
                    out.put(i, PlannedComponent(c.loc, c.name, new_value, c.attributes))
                }
                set i: i + 1
            }
            &out
        }

        ; promote_escaping_guts#: promote nested page-owning Local-life LEAF
        ; constructions buried inside a RETURNED value aggregate to the caller
        ; page (rp). Unlike restamp_operand_life# — which flips the TOP
        ; construction and only fires for a Local-life top — this walks an
        ; aggregate whose own life is Unspecified (a plain value struct / a
        ; variant returned by sret) and promotes ONLY the genuine Local-life
        ; heap constructions inside its fields. Example: plan_type_operand#
        ; returns `PlannedOperand(.., PlannedExpression.Variable(PlannedVariable(
        ; .., "this", ..)), ..)` — the PlannedOperand/PlannedVariable
        ; structs are stack values copied into the sret, but the fresh
        ; `"this"` data buffer would land on the local page and dangle.
        ; The enclosing value struct stays a stack value; only the dangling heap
        ; guts move to rp. Recurses through PlannedCall args, PlannedTuple
        ; components, and PlannedVariantConstruction value (which restamp_args#
        ; cannot reach). Returns null when NOTHING was promoted (NEUTRAL — the
        ; caller keeps the operand verbatim, so sigiled source whose nested
        ; constructions carry explicit #/^ lifetimes stays byte-identical). All
        ; rebuilds copy PlannedType/String fields verbatim (s34/s196 hazard).
        function promote_escaping_guts(this: Planner, op: PlannedOperand, new_life: Lifetime) returns ref[PlannedOperand]?
        {
            choose op.expr
                when c: PlannedCall
                {
                    if c.is_operator
                        return null
                    var changed false
                    var new_args: ref[Vector[PlannedOperand]]? c.args
                    if c.args <> null
                    {
                        let pa this.promote_escaping_args((*c.args), new_life)
                        if pa <> null
                        {
                            set new_args: pa
                            set changed: true
                        }
                    }
                    var out_life c.life
                    if Planner.result_owns_page_guts(c.result_type)
                        choose c.life
                            when l: Local
                            {
                                set out_life: new_life
                                set changed: true
                            }
                            else
                                0
                    if changed = false
                        return null
                    let nc PlannedCall(
                        c.loc, c.name, c.mangled_name, c.is_intrinsic, c.is_operator,
                        c.can_throw, c.requires_page_param, new_args,
                        c.result_type, out_life, c.throws_type, c.is_indirect
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.Call nc, op.member_access, op.result_type)
                }
                when t: PlannedTuple
                {
                    var changed false
                    var new_comps: ref[Vector[PlannedComponent]]? t.components
                    if t.components <> null
                    {
                        let pc this.promote_escaping_components((*t.components), new_life)
                        if pc <> null
                        {
                            set new_comps: pc
                            set changed: true
                        }
                    }
                    var out_life t.life
                    var out_region t.is_region_alloc
                    choose t.life
                        when l: Local
                        {
                            set out_life: new_life
                            set out_region: true
                            set changed: true
                        }
                        else
                            0
                    if changed = false
                        return null
                    let nt PlannedTuple(
                        t.loc, new_comps, t.tuple_type, out_region, out_life, t.region_arg
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.Tuple nt, op.member_access, op.result_type)
                }
                when vc: PlannedVariantConstruction
                {
                    if vc.value = null
                        return null
                    let promoted this.promote_escaping_guts((*vc.value), new_life)
                    if promoted = null
                        return null
                    let nvc PlannedVariantConstruction(
                        vc.loc, vc.union_type, vc.variant_name, vc.variant_tag, promoted
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.VariantConstruction nvc, op.member_access, op.result_type)
                }
                else
                    return null
            null
        }
        function promote_escaping_args(this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) returns ref[Vector[PlannedOperand]]?
        {
            var changed false
            var out Vector[PlannedOperand](args.length)
            var i: size_t 0
            while i < args.length
            {
                let ap args.get i
                if ap <> null
                {
                    let promoted this.promote_escaping_guts((*ap), new_life)
                    if promoted <> null
                    {
                        out.put(i, (*promoted))
                        set changed: true
                    }
                    if promoted = null
                        out.put(i, (*ap))
                }
                set i: i + 1
            }
            if changed = false
                return null
            &out
        }
        function promote_escaping_components(this: Planner, comps: Vector[PlannedComponent], new_life: Lifetime) returns ref[Vector[PlannedComponent]]?
        {
            var changed false
            var out Vector[PlannedComponent](comps.length)
            var i: size_t 0
            while i < comps.length
            {
                let cp comps.get i
                if cp <> null
                {
                    let c (*cp)
                    var new_value: ref[Vector[PlannedOperand]]? c.value
                    if c.value <> null
                    {
                        let pv this.promote_escaping_args((*c.value), new_life)
                        if pv <> null
                        {
                            set new_value: pv
                            set changed: true
                        }
                    }
                    out.put(i, PlannedComponent(c.loc, c.name, new_value, c.attributes))
                }
                set i: i + 1
            }
            if changed = false
                return null
            &out
        }

        ; ================================================================
        ; Implicit-return (tail) promotion. R2 (plan_return#) promotes an
        ; EXPLICIT `return X`; this pair handles the IMPLICIT return — the
        ; body's last expression with no `return` keyword — for a function
        ; whose result owns page guts. A directly-returned no-sigil
        ; construction/call (`{ ... Vector[T](0) }`) is promoted to the
        ; caller page by restamp_operand_life#; a choose/if/match/block tail
        ; (handle_expression#'s `choose syntax when ...: Expression.X(handle_Y
        ; (...))`) recurses into each branch's value position, and a variant
        ; construction (`Expression.Tuple(handle_object(obj))`) recurses into
        ; its payload. Returns null when nothing was promotable (NEUTRAL — the
        ; operand is kept verbatim). All rebuilds copy PlannedType/String
        ; fields verbatim and only swap the promoted sub-operand, avoiding the
        ; s34/s196 result_type-rebuild hazard.
        ; ================================================================
        function promote_tail_operand(this: Planner, op: PlannedOperand, new_life: Lifetime) returns ref[PlannedOperand]?
        {
            ; Direct construction/call placed on the LOCAL page (Local life on
            ; the PlannedCall/PlannedTuple). Gated on operand_is_local_page_
            ; construction (Local only) NOT a bare restamp_operand_life# call:
            ; restamp also promotes UNSPECIFIED-life tuples, which for a tail
            ; return would region-promote a pure STACK value struct (e.g.
            ; PageList.get_iterator's by-value PageListIterator) onto the caller
            ; page — wrong and emission-changing. A real local-page allocation
            ; carries Local life; a stack value carries Unspecified and must
            ; stay stack.
            if this.operand_is_local_page_construction(op)
            {
                let direct this.restamp_operand_life(op, new_life)
                if direct <> null
                    return direct
            }
            choose op.expr
                when vc: PlannedVariantConstruction
                {
                    if vc.value = null
                        return null
                    let promoted this.promote_tail_operand((*vc.value), new_life)
                    if promoted = null
                        return null
                    let nvc PlannedVariantConstruction(vc.loc, vc.union_type, vc.variant_name, vc.variant_tag, &^this (*promoted))
                    return PlannedOperand^this(op.loc, PlannedExpression.VariantConstruction nvc, op.member_access, op.result_type)
                }
                when ch: PlannedChoose
                {
                    var changed false
                    var new_cases: ref[Vector[PlannedWhen]]? ch.cases
                    if ch.cases <> null
                    {
                        let cases_in (*ch.cases)
                        var out_cases Vector[PlannedWhen](cases_in.length)
                        var i: size_t 0
                        while i < cases_in.length
                        {
                            let cp cases_in.get i
                            if cp <> null
                            {
                                let cw (*cp)
                                var new_cons: ref[PlannedStatement]? cw.consequent
                                if cw.consequent <> null
                                {
                                    let pc this.promote_tail_statement((*cw.consequent), new_life)
                                    if pc <> null
                                    {
                                        set new_cons: pc
                                        set changed: true
                                    }
                                }
                                out_cases.put(i, PlannedWhen(cw.loc, cw.name, cw.variant_type, cw.variant_index, new_cons))
                            }
                            set i: i + 1
                        }
                        var ch_holder Vector[PlannedWhen](out_cases)
                        set new_cases: &ch_holder
                    }
                    var new_alt: ref[PlannedStatement]? ch.alternative
                    if ch.alternative <> null
                    {
                        let pa this.promote_tail_statement((*ch.alternative), new_life)
                        if pa <> null
                        {
                            set new_alt: pa
                            set changed: true
                        }
                    }
                    if changed = false
                        return null
                    let nch PlannedChoose(ch.loc, ch.condition, new_cases, new_alt)
                    return PlannedOperand^this(op.loc, PlannedExpression.Choose nch, op.member_access, op.result_type)
                }
                when iff: PlannedIf
                {
                    var changed false
                    var new_cons: ref[PlannedStatement]? iff.consequent
                    if iff.consequent <> null
                    {
                        let pc this.promote_tail_statement((*iff.consequent), new_life)
                        if pc <> null
                        {
                            set new_cons: pc
                            set changed: true
                        }
                    }
                    var new_alt: ref[PlannedStatement]? iff.alternative
                    if iff.alternative <> null
                    {
                        let pa this.promote_tail_statement((*iff.alternative), new_life)
                        if pa <> null
                        {
                            set new_alt: pa
                            set changed: true
                        }
                    }
                    if changed = false
                        return null
                    let nif PlannedIf(iff.loc, iff.condition, iff.prop, new_cons, new_alt)
                    return PlannedOperand^this(op.loc, PlannedExpression.If nif, op.member_access, op.result_type)
                }
                when mt: PlannedMatch
                {
                    var changed false
                    var new_branches: ref[Vector[PlannedBranch]]? mt.branches
                    if mt.branches <> null
                    {
                        let brs_in (*mt.branches)
                        var out_brs Vector[PlannedBranch](brs_in.length)
                        var i: size_t 0
                        while i < brs_in.length
                        {
                            let bp brs_in.get i
                            if bp <> null
                            {
                                let br (*bp)
                                var new_cons: ref[PlannedStatement]? br.consequent
                                if br.consequent <> null
                                {
                                    let pc this.promote_tail_statement((*br.consequent), new_life)
                                    if pc <> null
                                    {
                                        set new_cons: pc
                                        set changed: true
                                    }
                                }
                                out_brs.put(i, PlannedBranch(br.loc, br.cases, new_cons))
                            }
                            set i: i + 1
                        }
                        var mb_holder Vector[PlannedBranch](out_brs)
                        set new_branches: &mb_holder
                    }
                    var new_malt: ref[PlannedStatement]? mt.alternative
                    if mt.alternative <> null
                    {
                        let pa this.promote_tail_statement((*mt.alternative), new_life)
                        if pa <> null
                        {
                            set new_malt: pa
                            set changed: true
                        }
                    }
                    if changed = false
                        return null
                    let nmt PlannedMatch(mt.loc, mt.condition, new_branches, new_malt)
                    return PlannedOperand^this(op.loc, PlannedExpression.Match nmt, op.member_access, op.result_type)
                }
                when blk: PlannedBlock
                {
                    if blk.statements = null
                        return null
                    let stmts (*blk.statements)
                    if stmts.length = 0
                        return null
                    let last_ptr stmts.get(stmts.length - 1)
                    if last_ptr = null
                        return null
                    let pl this.promote_tail_statement((*last_ptr), new_life)
                    if pl = null
                        return null
                    var out_stmts Vector[PlannedStatement](stmts.length)
                    var i: size_t 0
                    while i < stmts.length
                    {
                        let sp stmts.get i
                        if sp <> null
                        {
                            if i = stmts.length - 1
                                out_stmts.put(i, (*pl))
                            else
                                out_stmts.put(i, (*sp))
                        }
                        set i: i + 1
                    }
                    var sh Vector[PlannedStatement](out_stmts)
                    let nblk PlannedBlock(blk.loc, &sh, blk.needs_local_page_cleanup)
                    return PlannedOperand^this(op.loc, PlannedExpression.Block nblk, op.member_access, op.result_type)
                }
                when c: PlannedCall
                {
                    ; A plain-struct construction (`Action(handle_operands(...),
                    ; ...)`) in tail position: the STRUCT itself is a by-value
                    ; stack aggregate (Unspecified life — operand_is_local_page_
                    ; construction above is Local-only and did NOT fire), so keep
                    ; its own life, but its INLINE page-owning args (the
                    ; handle_operands call) become the escaping struct's fields and
                    ; must move to the caller page. Recurse restamp_args# only —
                    ; never restamp the construction itself (that would region-
                    ; promote a pure stack value, the ba5045c2 rule-3 hazard).
                    ; Gated on Unspecified so explicit `#`/`^` placements stand.
                    var c_unspec false
                    choose c.life
                        when u: Unspecified
                            set c_unspec: true
                        else
                            0
                    if c_unspec = false
                        return null
                    if c.args = null
                        return null
                    let new_args this.restamp_args((*c.args), new_life)
                    let nc PlannedCall(
                        c.loc, c.name, c.mangled_name, c.is_intrinsic, c.is_operator,
                        c.can_throw, c.requires_page_param, new_args,
                        c.result_type, c.life, c.throws_type, c.is_indirect
                    )
                    return PlannedOperand^this(op.loc, PlannedExpression.Call nc, op.member_access, op.result_type)
                }
                when t: PlannedTuple
                {
                    var t_unspec false
                    choose t.life
                        when u: Unspecified
                            set t_unspec: true
                        else
                            0
                    if t_unspec = false
                        return null
                    if t.components = null
                        return null
                    let new_comps this.restamp_components((*t.components), new_life)
                    let nt PlannedTuple(t.loc, new_comps, t.tuple_type, t.is_region_alloc, t.life, t.region_arg)
                    return PlannedOperand^this(op.loc, PlannedExpression.Tuple nt, op.member_access, op.result_type)
                }
                else
                    return null
            null
        }

        ; Promote the value position of a tail STATEMENT (a choose/if/match arm
        ; consequent or a block's last statement). Only an Action with NO store
        ; target carries an implicit value; a Return is already handled by R2
        ; (plan_return#), so leave it (return null). The action's value is its
        ; single source operand.
        function promote_tail_statement(this: Planner, stmt: PlannedStatement, new_life: Lifetime) returns ref[PlannedStatement]?
        {
            choose stmt
                when a: PlannedAction
                {
                    if a.target <> null
                        return null
                    if a.source = null
                        return null
                    let src (*a.source)
                    if src.length = 0
                        return null
                    let s0_ptr src.get 0
                    if s0_ptr = null
                        return null
                    let promoted this.promote_tail_operand((*s0_ptr), new_life)
                    if promoted = null
                        return null
                    var srch Vector[PlannedOperand](1)
                    srch.put(0, (*promoted))
                    let na PlannedAction(a.loc, &srch, a.target, a.result_type)
                    var h Vector[PlannedStatement](1)
                    h.put(0, PlannedStatement.Action na)
                    return h.get(0)
                }
                else
                    return null
            null
        }

        ; Hole-1 (2026-07-02f): diagnostic-only mirror of plan_return#'s
        ; reference-escape check for IMPLICIT tail returns. Recurses over
        ; return-position subexpressions exactly like promote_tail_operand#
        ; (variant payloads, choose/if/match arm consequents + alternatives,
        ; block last statement); at each leaf flags a Local-ranked reference
        ; (region_of_operand below the escape threshold, or a tainted-field
        ; read) that gap-1 does not cover. READ-ONLY: no restamp, no rebuild.
        function check_tail_ref_escape(this: Planner, op: PlannedOperand, loc: Span)
        {
            var recursed false
            choose op.expr
                when vc: PlannedVariantConstruction
                {
                    set recursed: true
                    if vc.value <> null
                        this.check_tail_ref_escape((*vc.value), loc)
                }
                when ch: PlannedChoose
                {
                    set recursed: true
                    if ch.cases <> null
                    {
                        let cases_in (*ch.cases)
                        var i: size_t 0
                        while i < cases_in.length
                        {
                            let cp cases_in.get i
                            if cp <> null
                            {
                                let cw (*cp)
                                if cw.consequent <> null
                                    this.check_tail_ref_escape_statement((*cw.consequent), loc)
                            }
                            set i: i + 1
                        }
                    }
                    if ch.alternative <> null
                        this.check_tail_ref_escape_statement((*ch.alternative), loc)
                }
                when iff: PlannedIf
                {
                    set recursed: true
                    if iff.consequent <> null
                        this.check_tail_ref_escape_statement((*iff.consequent), loc)
                    if iff.alternative <> null
                        this.check_tail_ref_escape_statement((*iff.alternative), loc)
                }
                when mt: PlannedMatch
                {
                    set recursed: true
                    if mt.branches <> null
                    {
                        let brs_in (*mt.branches)
                        var i: size_t 0
                        while i < brs_in.length
                        {
                            let bp brs_in.get i
                            if bp <> null
                            {
                                let br (*bp)
                                if br.consequent <> null
                                    this.check_tail_ref_escape_statement((*br.consequent), loc)
                            }
                            set i: i + 1
                        }
                    }
                    if mt.alternative <> null
                        this.check_tail_ref_escape_statement((*mt.alternative), loc)
                }
                when blk: PlannedBlock
                {
                    set recursed: true
                    if blk.statements <> null
                    {
                        let stmts (*blk.statements)
                        if stmts.length > 0
                        {
                            let last_ptr stmts.get(stmts.length - 1)
                            if last_ptr <> null
                                this.check_tail_ref_escape_statement((*last_ptr), loc)
                        }
                    }
                }
                else
                    0
            if recursed
                return

            ; Leaf: judge REFERENCES only — is_local_ref_pointer (a pointer/
            ; ref whose pointee has Local life, i.e. a genuine &<frame-local>)
            ; AND region_of_operand below the threshold, or a tainted-field
            ; read. The conjunction is load-bearing on both sides:
            ;   - is_local_ref_pointer alone (not is_reference_to_local_page)
            ;     because the latter's Local-life VALUE clause false-fires on
            ;     an already-promoted tail construction (restamp_operand_life#
            ;     rewrites call.life but not result_type.life — Path.
            ;     get_file_name) and on a borrow-value call kept local by
            ;     design (Slice.slice_from); value tails are the promotion
            ;     machinery's domain (do_tail_promote/R2), not this check's.
            ;   - region_of_operand supplies the Box exemptions: a `&^this`/
            ;     `&^rp` box (check_operator_match's tail) and a box-bound
            ;     Variable point at a surviving page even though the stamped
            ;     pointee life reads Local.
            var leaf_escapes false
            if Planner.is_local_ref_pointer(op.result_type)
                if this.region_of_operand(op) < Planner.required_region_for_escape()
                    set leaf_escapes: true
            if leaf_escapes = false
                if this.operand_reads_tainted_local_field(op)
                    set leaf_escapes: true
            if leaf_escapes = false
                return
            ; Gap-1 parity with plan_return#: a bare Variable whose binding was
            ; promoted to the caller page holds a caller-page pointer — safe.
            ; A tainted-field read bypasses the shortcut (the field still
            ; points into this frame even when the container was promoted).
            var already_promoted false
            choose op.expr
                when v: Variable
                {
                    if this.array_contains_name(promoted_binding_names, v.name)
                        set already_promoted: true
                }
                else
                    0
            if this.operand_reads_tainted_local_field(op)
                set already_promoted: false
            if already_promoted
                return
            this.add_diagnostic(loc, "reference into a local page escapes via return - allocate the target with '#' (caller page) or '^name' (region) so it outlives the use")
        }

        ; Tail-statement hop for check_tail_ref_escape#: only an Action with
        ; no store target carries an implicit value; explicit Returns are
        ; already checked by plan_return#.
        function check_tail_ref_escape_statement(this: Planner, stmt: PlannedStatement, loc: Span)
        {
            choose stmt
                when a: PlannedAction
                {
                    if a.target <> null
                        return
                    if a.source = null
                        return
                    let src (*a.source)
                    if src.length = 0
                        return
                    let s0_ptr src.get 0
                    if s0_ptr <> null
                        this.check_tail_ref_escape((*s0_ptr), loc)
                }
                else
                    0
        }

        function plan_return(this: Planner, r: Return) returns PlannedReturn
        {
            ; GAP B: `return \x: …` where the function's return type is a delegate
            ; yields an ESCAPING closure — env on the caller page (`#`) so it
            ; outlives this frame. Mirrors the typed-binding closure path, but
            ; with Lifetime.Call instead of Local.
            if this.current_return_type <> null
            {
                let crt (*this.current_return_type)
                if this.is_delegate_type(crt.name)
                    if r.result.length = 1
                    {
                        let r0_ptr r.result.get 0
                        if r0_ptr <> null
                            choose (*r0_ptr).expression
                                when rl: Lambda
                                {
                                    let dparams this.delegate_param_types(crt.name)
                                    let dret this.delegate_return_type(crt.name)
                                    let rlam_id next_lambda_id
                                    set next_lambda_id: rlam_id + 1
                                    var rb_sb StringBuilder()
                                    rb_sb.append "ret"
                                    let rlam_str size_to_string(rlam_id)
                                    rb_sb.append rlam_str
                                    let rbase rb_sb.to_string()
                                    let rclo this.make_closure(rbase, rl, dparams, dret, crt, Lifetime.Call(scalyc.compiler.Model.Call(r.span)))
                                    let rclo_op PlannedOperand(r.span, PlannedExpression.Closure rclo, null, crt)
                                    var rh Vector[PlannedOperand](1)
                                    rh.put(0, rclo_op)
                                    return PlannedReturn(r.span, &rh)
                                }
                                else
                                    0
                    }
            }

            ; GAP B escape check: returning a local (stack) closure dangles —
            ; its record lives on this frame. Flag it (mirrors the design's
            ; escape-as-compile-error) and point at the working alternative:
            ; return the lambda DIRECTLY so it allocates on the caller page.
            if r.result.length = 1
            {
                let er0_ptr r.result.get 0
                if er0_ptr <> null
                    choose (*er0_ptr).expression
                        when ev: scalyc.compiler.Model.Type
                        {
                            if ev.name.length = 1
                            {
                                let evn_ptr ev.name.get 0
                                if evn_ptr <> null
                                {
                                    var is_stack_closure: bool false
                                    var lci: size_t 0
                                    while lci < local_closure_names.length
                                    {
                                        let lcn_ptr local_closure_names.get lci
                                        if lcn_ptr <> null
                                            if (*lcn_ptr).equals((*evn_ptr))
                                                set is_stack_closure: true
                                        set lci: lci + 1
                                    }
                                    if is_stack_closure
                                        this.add_diagnostic(r.span, "a closure bound to a local lives on the stack frame and cannot be returned - return the lambda directly (return \\x: ...) so it is allocated on the caller's region")
                                }
                            }
                        }
                        else
                            0
            }

            let planned_flat this.plan_operands(r.result)
            var planned_collapsed this.collapse_operand_sequence(planned_flat)

            ; A returned value/ref whose lifetime is the Local ($) page would
            ; dangle once the frame is freed. Page inference (rule 2): if the
            ; returned operand IS the allocation expression, PROMOTE it to the
            ; caller page (rp) so it outlives the use — no `#` needed. Only when
            ; promotion isn't possible (a bare local Variable, or a ref into a
            ; local pointee) do we keep the hard escape diagnostic.
            ; Promote when the returned operand is a Local-page REFERENCE/value
            ; (is_reference_to_local_page reads result_type.life) OR a directly-
            ; returned no-sigil CONSTRUCTION whose Local life rides the
            ; expression (call.life / tuple.life), which is_reference_to_local_
            ; page misses because the construction blocks leave result_type.life
            ; Unspecified. The latter closes `return Vector[T](0)` /
            ; `return SomeStruct(...)` directly-returned-construction dangling.
            var return_needs_promotion false
            if this.region_of_operand(planned_collapsed) < Planner.required_region_for_escape()
                set return_needs_promotion: true
            if return_needs_promotion = false
                if this.operand_is_local_page_construction(planned_collapsed)
                    set return_needs_promotion: true
            ; Hole-1 field provenance: `return h.field` where h is a tainted
            ; frame-local value struct (constructed with a &<frame-local> arg)
            ; and the field is reference-like — the field holds a frame address.
            ; restamp_operand_life# returns null for a member-access Variable, so
            ; return_needs_promotion -> the hard escape diagnostic below.
            if return_needs_promotion = false
                if this.operand_reads_tainted_local_field(planned_collapsed)
                    set return_needs_promotion: true
            if planned_flat.length > 0
                if return_needs_promotion
                {
                    ; Gap 1: `return x` where x's binding was already promoted to
                    ; the caller page (its allocation lives on rp) — the Variable
                    ; itself is just a frame slot holding a caller-page pointer,
                    ; so it does NOT dangle. Skip both the re-stamp and the error.
                    var already_promoted false
                    choose planned_collapsed.expr
                        when v: Variable
                        {
                            if this.array_contains_name(promoted_binding_names, v.name)
                                set already_promoted: true
                        }
                        else
                            0
                    ; Hole-1 field provenance: `return h.field` where h holds a
                    ; &<frame-local> dangles even when the CONTAINER h was gap-1
                    ; promoted to rp — the field still points into this frame.
                    ; Bypass the already-promoted shortcut; restamp_operand_life#
                    ; returns null for a member-access Variable, so the hard
                    ; diagnostic below fires. (Suppressing the gap-1 promotion
                    ; instead breaks the container's own rp guts — see cycle.)
                    if this.operand_reads_tainted_local_field(planned_collapsed)
                        set already_promoted: false
                    if already_promoted = false
                    {
                        let call_life Lifetime.Call(scalyc.compiler.Model.Call(r.span))
                        let promoted this.restamp_operand_life(planned_collapsed, call_life)
                        if promoted <> null
                            set planned_collapsed: (*promoted)
                        else
                            this.add_diagnostic(r.span, "reference into a local page escapes via return - allocate the target with '#' (caller page) or '^name' (region) so it outlives the use")
                    }
                }

            ; Nested-guts promotion: even when the returned operand itself does
            ; not need top-level promotion (it is an Unspecified value struct or
            ; a variant copied by value into the sret), a fresh Local-life heap
            ; construction buried in its fields would dangle. Promote those to
            ; rp. NEUTRAL when nothing is promotable (returns null -> keep
            ; verbatim); idempotent after the restamp above (already-Call leaves
            ; are not re-flipped). Reaches PlannedVariantConstruction payloads
            ; that restamp_args# cannot.
            if planned_flat.length > 0
            {
                let nested_call_life Lifetime.Call(scalyc.compiler.Model.Call(r.span))
                let nested_promoted this.promote_escaping_guts(planned_collapsed, nested_call_life)
                if nested_promoted <> null
                    set planned_collapsed: (*nested_promoted)
            }

            var holder Vector[PlannedOperand](1)
            if planned_flat.length > 0
                holder.put(0, planned_collapsed)
            PlannedReturn(r.span, &holder)
        }

        function plan_break(this: Planner, b: Break) returns PlannedBreak
        {
            ; Collapse the operand sequence so a break value like `break -1`
            ; or `break parse(line)` folds into a single typed operand (same
            ; reason plan_throw# collapses) — emit_break stores result[0] and
            ; the repeat's value type is read from result[0].result_type.
            let planned_flat this.plan_operands(b.result)
            if planned_flat.length = 0
            {
                var empty_holder Vector[PlannedOperand](planned_flat)
                return PlannedBreak(b.span, &empty_holder, b.loop_label)
            }
            let planned_collapsed this.collapse_operand_sequence(planned_flat)
            var holder Vector[PlannedOperand](1)
            holder.put(0, planned_collapsed)
            PlannedBreak(b.span, &holder, b.loop_label)
        }

        function plan_throw(this: Planner, t: Throw) returns PlannedThrow
        {
            ; Collapse the operand sequence the same way plan_return# does.
            ; A thrown value like `MyError.Different(DifferentSyntax())` arrives
            ; as multiple flat operands ([MyError.Different, (DifferentSyntax())])
            ; that must be folded into a single PlannedCall (variant
            ; construction). emit_operands only emits ops.get(0), so without
            ; the collapse only the bare type reference survives and emit_throw
            ; drops the error value entirely (status byte stored, data left
            ; uninitialised → caller reads a garbage variant tag).
            let planned_flat this.plan_operands(t.result)
            var planned_collapsed this.collapse_operand_sequence(planned_flat)
            ; A thrown value escapes the frame exactly like a returned one: it
            ; travels up the stack via the throws Result-wrapper sret. A fresh
            ; Local-life heap construction buried in its fields (e.g. the error
            ; message String in `throw E.Invalid(InvalidSyntax(.., String(..)))`)
            ; would dangle once this frame's local page is freed. Promote those
            ; guts to the caller page (rp), mirroring plan_return#'s nested-guts
            ; promotion. NEUTRAL on sigiled source (an already-Call `String#`
            ; leaf is not re-flipped; returns null when nothing is promotable).
            if planned_flat.length > 0
            {
                let throw_call_life Lifetime.Call(scalyc.compiler.Model.Call(t.span))
                let throw_promoted this.promote_escaping_guts(planned_collapsed, throw_call_life)
                if throw_promoted <> null
                    set planned_collapsed: (*throw_promoted)
            }
            var holder Vector[PlannedOperand](1)
            if planned_flat.length > 0
                holder.put(0, planned_collapsed)
            PlannedThrow(t.span, &holder)
        }

        ; ================================================================
        ; plan_statement: Model.Statement → Plan.PlannedStatement.
        ; Dispatches over the Statement union and delegates to the
        ; variant-specific plan_* method. `Continue` is trivial — just
        ; carries the location.
        ; ================================================================
        function plan_statement(this: Planner, s: Statement) returns PlannedStatement
        {
            choose s
                when a: Action
                    PlannedStatement.Action(this.plan_action(a))
                when b: Binding
                    PlannedStatement.Binding(this.plan_binding(b))
                when br: Break
                    PlannedStatement.Break(this.plan_break(br))
                when c: Continue
                    PlannedStatement.Continue(PlannedContinue(c.span, c.loop_label))
                when r: Return
                    PlannedStatement.Return(this.plan_return(r))
                when t: Throw
                    PlannedStatement.Throw(this.plan_throw(t))
        }

        ; Page inference (discarded page-call statement, 2026-07-03c): a
        ; page-requiring, non-operator call in NON-LAST statement position
        ; discards its result — the call matters only through its side
        ; effects, and any data the callee allocates on the passed page that
        ; PERSISTS (shallow-stored into `this`-state registries, e.g.
        ; plan_module's planned functions reaching record_function) must
        ; outlive this frame. The Design-B flip in collapse stamped the call
        ; Local because its result type owns page guts, but for a discarded
        ; result that routing is never right: persistent callee data on the
        ; local page DANGLES at first read after this frame exits, while
        ; transient callee data on rp is only a bounded leak. This extends
        ; the flip site's own void rationale (a void page-call is a storage
        ; procedure -> it must receive the caller's rp) to value-returning
        ; calls whose value is dropped — the interprocedural "callee's
        ; page-arg allocations escape the call" summary, degenerated to the
        ; one signal that needs no call-graph walk and no sigils: the result
        ; is discarded. Non-last position is PRECISE (a non-last statement's
        ; value is never a block value, arm value, or tail return). Gated on
        ; rp in scope (a page-less function keeps the local page); sigiled
        ; `#` calls carry Call life, which restamp_operand_life# refuses ->
        ; NEUTRAL on sigiled source.
        function promote_discarded_pagecall(this: Planner, stmt: PlannedStatement) returns ref[PlannedStatement]?
        {
            if this.lookup_local_binding("rp") = null
                return null
            choose stmt
                when a: PlannedAction
                {
                    if a.target <> null
                        return null
                    if a.source = null
                        return null
                    let src (*a.source)
                    if src.length = 0
                        return null
                    let s0_ptr src.get 0
                    if s0_ptr = null
                        return null
                    let s0 (*s0_ptr)
                    var is_pagecall false
                    choose s0.expr
                        when dc: PlannedCall
                            if dc.requires_page_param
                                if dc.is_operator = false
                                    set is_pagecall: true
                        else
                            0
                    if is_pagecall = false
                        return null
                    let disc_life Lifetime.Call(scalyc.compiler.Model.Call(s0.loc))
                    let promoted this.restamp_operand_life(s0, disc_life)
                    if promoted = null
                        return null
                    var srch Vector[PlannedOperand](1)
                    srch.put(0, (*promoted))
                    let na PlannedAction(a.loc, &srch, a.target, a.result_type)
                    var h Vector[PlannedStatement](1)
                    h.put(0, PlannedStatement.Action na)
                    return h.get(0)
                }
                else
                    return null
            null
        }

        ; plan_statements: batch plan_statement over a Model.Block's statements.
        function plan_statements(
            this: Planner,
            stmts: Vector[Statement]
        ) returns Vector[PlannedStatement]
        {
            var result Vector[PlannedStatement](stmts.length)
            var i: size_t 0
            while i < stmts.length
            {
                let s_ptr stmts.get i
                if s_ptr <> null
                {
                    let s (*s_ptr)
                    var pl this.plan_statement(s)
                    ; Discarded-result page-call promotion (non-last only;
                    ; see promote_discarded_pagecall above).
                    if i + 1 < stmts.length
                    {
                        let dp this.promote_discarded_pagecall(pl)
                        if dp <> null
                            set pl: (*dp)
                    }
                    result.put(i, pl)
                }
                set i: i + 1
            }
            result
        }

        ; ================================================================
        ; plan_block: push a fresh scope, plan every statement, pop.
        ; After planning, scan the planned statements for any operand
        ; carrying a Local lifetime — that's the signal that a `$`
        ; allocation happened in this block and the emitter must emit
        ; page-cleanup on exit.
        ; ================================================================
        function plan_block(this: Planner, b: Block) returns PlannedBlock
        {
            this.push_scope()
            let planned_stmts this.plan_statements(b.statements)
            this.pop_scope()

            var has_local: bool false
            var si: size_t 0
            while si < planned_stmts.length
            {
                let s_ptr planned_stmts.get si
                if s_ptr <> null
                {
                    if Planner.statement_has_local_lifetime((*s_ptr))
                        set has_local: true
                }
                set si: si + 1
            }

            var stmts_holder Vector[PlannedStatement](planned_stmts)
            PlannedBlock(b.span, &stmts_holder, has_local)
        }

        ; has_local_lifetime: true iff `t` is a $-allocation marker
        ; (Lifetime.Local). Value types with Unspecified lifetime stay
        ; stack-resident and don't need page cleanup.
        function has_local_lifetime(t: PlannedType) returns bool
        {
            choose t.life
                when l: Local
                    true
                else
                    false
        }

        ; operand_has_local_lifetime: true iff the operand's own type or
        ; any of its planned call args / tuple components carries a
        ; Local lifetime. Does not descend into nested blocks — those
        ; own their own needs_local_page_cleanup flag.
        function operand_has_local_lifetime(op: PlannedOperand) returns bool
        {
            if Planner.has_local_lifetime(op.result_type)
                return true

            choose op.expr
                when call: PlannedCall
                {
                    if call.args <> null
                    {
                        let args (*call.args)
                        var i: size_t 0
                        while i < args.length
                        {
                            let a_ptr args.get i
                            if a_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*a_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when tup: PlannedTuple
                {
                    if Planner.has_local_lifetime(tup.tuple_type)
                        return true
                    if tup.components <> null
                    {
                        let comps (*tup.components)
                        var i: size_t 0
                        while i < comps.length
                        {
                            let c_ptr comps.get i
                            if c_ptr <> null
                            {
                                let c (*c_ptr)
                                if c.value <> null
                                {
                                    let vops (*c.value)
                                    var j: size_t 0
                                    while j < vops.length
                                    {
                                        let v_ptr vops.get j
                                        if v_ptr <> null
                                        {
                                            if Planner.operand_has_local_lifetime((*v_ptr))
                                                return true
                                        }
                                        set j: j + 1
                                    }
                                }
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; statement_has_local_lifetime: scan the operands inside a
        ; PlannedStatement for any Local-lifetime marker.
        function statement_has_local_lifetime(s: PlannedStatement) returns bool
        {
            choose s
                when a: PlannedAction
                {
                    if a.source <> null
                    {
                        let src (*a.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when b: PlannedBinding
                {
                    if b.operation <> null
                    {
                        let ops (*b.operation)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                when r: PlannedReturn
                {
                    if r.result <> null
                    {
                        let ops (*r.result)
                        var i: size_t 0
                        while i < ops.length
                        {
                            let op_ptr ops.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    return true
                            }
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    false
        }

        ; ================================================================
        ; plan_property: Model.Property → Plan.PlannedProperty.
        ;
        ; `mangled_name` is left empty here — the planner enclosing the
        ; struct sets it once the struct's own mangled name is known.
        ; `offset` is 0 until compute_property_offsets runs as part of
        ; the enclosing struct's layout pass.
        ; ================================================================
        function plan_property(this: Planner, p: Property) returns PlannedProperty
        {
            var prop_type: PlannedType this.fresh_type_var("")
            if p.type <> null
            {
                let t (*p.type)
                set prop_type: this.plan_type(t)
            }

            var initializer_ref: ref[Vector[PlannedOperand]]? null
            if p.initializer <> null
            {
                let init_ops (*p.initializer)
                let planned_init this.plan_operands(init_ops)
                var init_holder Vector[PlannedOperand](planned_init)
                set initializer_ref: &init_holder
            }

            let mangled Planner.encode_name(p.name)

            PlannedProperty(
                p.span,
                p.private_,
                p.name,
                mangled,
                prop_type,
                initializer_ref,
                null,
                0
            )
        }

        ; plan_implementation: Implementation variant → PlannedImplementation.
        ; Extern/Instruction/Intrinsic are trivially tagged wrappers;
        ; Action delegates to plan_action which in turn plans its source
        ; and target operand lists.
        ; Page inference, gap 1 (backward binding promotion) — read-only Model
        ; pre-scan collecting bare `return x` targets. A function-body walk that
        ; records, into escaping_return_locals, every local NAME returned bare
        ; (`return x`, including inside if/choose/match/loop bodies). plan_binding#
        ; then promotes those bindings' allocations to the caller page. Missing a
        ; nested shape is SAFE — that binding simply stays a hard escape error,
        ; the pre-inference behavior. NOT recorded: chained/qualified returns
        ; (`return x.f`, `return f(x)`) — those are handled by rule 2's
        ; return-site promotion, not binding promotion.
        function array_contains_name(this: Planner, arr: Array[String], name: String) returns bool
        {
            var i: size_t 0
            while i < arr.length
            {
                let p arr.get i
                if p <> null
                    if (*p).equals(name)
                        return true
                set i: i + 1
            }
            false
        }

        ; Option B: like array_contains_name but scanning only entries at
        ; index >= base — the CURRENT function's slice of an entry-truncated
        ; per-function name array. Used by the stamp and no-rp gate so a
        ; lazily-instantiated generic method planned mid-function does not
        ; false-match the outer function's holder names.
        function array_contains_name_from(this: Planner, arr: Array[String], base: size_t, name: String) returns bool
        {
            var i: size_t base
            while i < arr.length
            {
                let p arr.get i
                if p <> null
                    if (*p).equals(name)
                        return true
                set i: i + 1
            }
            false
        }

        ; deep-R2 (nested-construction return-promotion). The bare-`return x`
        ; collection below promotes only the OUTERMOST returned allocation. A
        ; construction returned (directly or via a bound local) builds its value
        ; from SUB-constructions assigned to other locals (`let p Vector(...);
        ; ... T(p, ...)`); those sub-allocations default to the local page and
        ; would be freed before the returned value's fields are read (dangling).
        ; These helpers collect, into escaping_return_locals, every local whose
        ; value flows into a returned construction's argument fields — directly,
        ; and transitively through bindings (the binding closure in
        ; collect_returns_stmt#'s Binding arm + the fixpoint loop in
        ; scan_top_level_returns#). plan_binding# then promotes them all to rp.
        ; Gated on a CAPITALIZED head name (a construction, not a call) so an
        ; ordinary `return f(scratch)` does not over-promote scratch — over-
        ; collection is merely leaky, never unsafe, but the gate keeps it tight.
        ; The escaping-name stores live on `^this` (the Planner's own page), not
        ; `^rp`: the set is a Planner field, so its names belong to the Planner's
        ; region and outlive every per-function scan/promote cycle. `^rp` here
        ; was only ever an accident of the transitive page-set — dropping it was
        ; blocked until the transient `Vector[Operand]` holders in the collect_*
        ; walkers below stopped requiring rp (they are now plain locals). With
        ; those holders local, no scan-machinery function needs rp threaded from
        ; add_escaping_*, so `^this` here no longer collapses the rp web.
        function add_escaping_local(this: Planner, name: String)
        {
            if this.array_contains_name(escaping_return_locals, name) = false
                escaping_return_locals.add(String^this(name))
        }
        function name_is_capitalized(this: Planner, n: String) returns bool
        {
            if n.get_length() = 0
                return false
            let b n.get_buffer()
            let c (*b)
            (c >= (65 as u8)) && (c <= (90 as u8))
        }
        ; If `ops` is a `RECV.get(...)` call (a dotted Type name ["RECV","get"]),
        ; return RECV (deep-copied onto rp); otherwise the empty string. Used to
        ; back-propagate escape through a Vector element read: `let opp
        ; SRC.get(i)` makes opp alias SRC's element guts.
        ; Alias-yielding method names for binding_get_receiver: `get` returns
        ; an element ref, `get_iterator` returns an iterator holding a pointer
        ; into the container, `next` returns an element ref out of an
        ; iterator (phase-5 class 3: the List-drain idiom `var it C.get_
        ; iterator(); while let m it.next() { set *(buf+i): *m }` threads
        ; escape back from the drained element to the container).
        function is_alias_method_name(n: String) returns bool
        {
            if n.equals("get")
                return true
            if n.equals("next")
                return true
            if n.equals("get_iterator")
                return true
            false
        }
        function binding_get_receiver(this: Planner, ops: Vector[Operand]) returns String
        {
            if ops.length >= 1
            {
                let hp ops.get 0
                if hp <> null
                {
                    let h (*hp)
                    ; Form A — dotted name `Type(["SRC","get"])`, member_access null.
                    if h.member_access = null
                        choose h.expression
                            when t: scalyc.compiler.Model.Type
                            {
                                if t.name.length = 2
                                {
                                    let mp t.name.get 1
                                    if mp <> null
                                        if Planner.is_alias_method_name((*mp))
                                        {
                                            let rp_ptr t.name.get 0
                                            if rp_ptr <> null
                                                return String((*rp_ptr))
                                        }
                                }
                            }
                            else
                                0
                    ; Form B — member access `Type(["SRC"])` + member_access whose
                    ; last hop is `get`.
                    if h.member_access <> null
                        choose h.expression
                            when t2: scalyc.compiler.Model.Type
                            {
                                if t2.name.length = 1
                                {
                                    let ma (*h.member_access)
                                    if ma.length >= 1
                                    {
                                        let last_ptr ma.get(ma.length - 1)
                                        if last_ptr <> null
                                            if Planner.is_alias_method_name((*last_ptr))
                                            {
                                                let rp2 t2.name.get 0
                                                if rp2 <> null
                                                    return String((*rp2))
                                            }
                                    }
                                }
                            }
                            else
                                0
                }
            }
            ""
        }
        ; UNIFIED value-flow extractor (page-inference name-graph). Given a
        ; value's operand sequence `ops`, collect every bare-local NAME whose
        ; own allocation becomes part of that value — so when an escaping
        ; consumer (a return, or a store into an escaping receiver) takes the
        ; value, those locals escape too and plan_binding# must promote them
        ; to the caller page. This subsumes the former two capitalized-gated
        ; heuristics (collect_value_locals#/collect_ctor_arg_locals#) into ONE
        ; recursive walker that descends ALL value-flow shapes:
        ;   - bare local alias `a`        -> a flows in (the alias itself owns
        ;                                    nothing; promote the source)
        ;   - inline ctor `Ctor(args)`    -> recurse each arg value
        ;   - choose/if/block-valued init -> recurse each branch's value
        ; A CALL or METHOD call (lowercase head, or member-access chain) is NOT
        ; descended: its result is a fresh value (the binding-init restamp
        ; promotes the call itself) or a borrow (result_owns_page_guts gates
        ; restamp), and its arguments are inputs, not the result's guts.
        ; Over-collection is merely leaky, never unsafe; under-collection
        ; dangles. The mutually-recursive collect_flow_stmt# unwraps a branch
        ; statement (Action/Return) to its value operands.
        function collect_flow_locals(this: Planner, ops: Vector[Operand])
        {
            if ops.length = 1
            {
                let vp ops.get 0
                if vp <> null
                {
                    let v (*vp)
                    if v.member_access = null
                        choose v.expression
                            when t: scalyc.compiler.Model.Type
                            {
                                if t.generics = null
                                {
                                    if t.name.length = 1
                                    {
                                        let np t.name.get 0
                                        if np <> null
                                            if this.name_is_capitalized((*np)) = false
                                                this.add_escaping_local((*np))
                                    }
                                    ; A dotted FIELD READ of a local — `inst.name`,
                                    ; `base.generics` — folds into a Type name
                                    ; [local, field, …] with member_access=null
                                    ; (Form A). Storing the field into an escaping
                                    ; aggregate aliases the BASE local's guts (a
                                    ; field String's .data / Vector buffer lives on
                                    ; the base's page), so the base local must be
                                    ; promoted to rp too. Collect the first segment
                                    ; when it is a non-capitalized local. Over-
                                    ; collection is safe + NEUTRAL: a sigiled `#`/`^`
                                    ; binding is kept verbatim by restamp, and a
                                    ; dotted name whose head is not a local (a
                                    ; namespace/qualified ref) records a name that
                                    ; never matches a binding.
                                    if t.name.length >= 2
                                    {
                                        let bp t.name.get 0
                                        if bp <> null
                                            if this.name_is_capitalized((*bp)) = false
                                                this.add_escaping_local((*bp))
                                    }
                                }
                            }
                            when ch: Choose
                            {
                                var i: size_t 0
                                while i < ch.cases.length
                                {
                                    let wp ch.cases.get i
                                    if wp <> null
                                        this.collect_flow_stmt((*wp).consequent)
                                    set i: i + 1
                                }
                                if ch.alternative <> null
                                {
                                    let alt ch.alternative
                                    this.collect_flow_stmt((*alt))
                                }
                            }
                            when iff: scalyc.compiler.Model.If
                            {
                                this.collect_flow_stmt(iff.consequent)
                                if iff.alternative <> null
                                {
                                    let alt iff.alternative
                                    this.collect_flow_stmt((*alt))
                                }
                            }
                            when m: Match
                            {
                                var i: size_t 0
                                while i < m.branches.length
                                {
                                    let bp m.branches.get i
                                    if bp <> null
                                        this.collect_flow_stmt((*bp).consequent)
                                    set i: i + 1
                                }
                                if m.alternative <> null
                                {
                                    let alt m.alternative
                                    this.collect_flow_stmt((*alt))
                                }
                            }
                            when b: Block
                            {
                                if b.statements.length > 0
                                {
                                    let lp b.statements.get(b.statements.length - 1)
                                    if lp <> null
                                        this.collect_flow_stmt(lp.unwrap())
                                }
                            }
                            when tup: scalyc.compiler.Model.Tuple
                            {
                                ; A PARENTHESIZED expression `(X)` is modeled as a
                                ; single-operand Tuple wrapping X; it aliases X (no
                                ; allocation of its own). Recurse each component's
                                ; value so a parenthesized deref `(*p_ptr)` stored
                                ; into an escaping receiver collects `p_ptr` (and a
                                ; parenthesized local `(x)` collects `x`). Without
                                ; this the length-1 path stops at the Tuple and the
                                ; inner value's flow locals are missed —
                                ; `dst.add((*src.get(i)))` (a Vector element copy
                                ; written with explicit parens) is the case in
                                ; plan_binding#'s rest_arr fill loop.
                                var ti: size_t 0
                                while ti < tup.components.length
                                {
                                    let cp tup.components.get ti
                                    if cp <> null
                                        this.collect_flow_locals((*cp).value)
                                    set ti: ti + 1
                                }
                            }
                            else
                                0
                    ; Same field-read as above but modeled as a bare local
                    ; Type([local]) carrying a member_access chain (Form B,
                    ; `inst.name` → expression Type(["inst"]) + member_access
                    ; ["name"]). Collect the base local for the same aliasing
                    ; reason. Single non-capitalized segment only.
                    if v.member_access <> null
                        choose v.expression
                            when t: scalyc.compiler.Model.Type
                            {
                                if t.name.length = 1
                                {
                                    let bp t.name.get 0
                                    if bp <> null
                                        if this.name_is_capitalized((*bp)) = false
                                            this.add_escaping_local((*bp))
                                }
                            }
                            else
                                0
                }
            }
            if ops.length >= 2
            {
                let head_ptr ops.get 0
                ; The arguments operand is normally at index 1, but a GENERIC
                ; container ctor `Vector[T](args)` splits into [Type(Vector),
                ; Matrix([T]), Tuple(args)] (s107) — the generic args ride a
                ; Matrix at index 1 and the real arg Tuple is at index 2. A
                ; LIFETIME ctor `Foo#(args)` additionally inserts the lifetime
                ; marker — an EMPTY-name Type carrying the Call/Local/Reference
                ; lifetime (handle_expression's LifetimeSyntax arm,
                ; Modeler.scaly:576-581) — as its OWN operand before the arg
                ; Tuple, so `LoopSyntax#(a, b)` is [Type(LoopSyntax),
                ; Type(empty,#), Tuple(a, b)] and `Vector[T]#(args)` is
                ; [Type(Vector), Matrix([T]), Type(empty,#), Tuple(args)]. Skip
                ; any leading Matrix and/or empty-name lifetime-marker operands
                ; so the real arg Tuple is found — else a `#`-lifetime
                ; reconstruction ctor `set name: LoopSyntax#(success.start, …)`
                ; stops at the marker and never collects the field-read base
                ; `success`. A real Type arg always has a non-empty name, so the
                ; empty-name test never skips a genuine argument. Over-collection
                ; is safe + NEUTRAL on sigiled source (restamp keeps an explicit
                ; #/^ arg binding verbatim).
                var args_idx: size_t 1
                var skipping: bool true
                while skipping
                {
                    set skipping: false
                    let probe_ptr ops.get args_idx
                    if probe_ptr <> null
                        choose (*probe_ptr).expression
                            when mx: Matrix
                            {
                                set args_idx: args_idx + 1
                                set skipping: true
                            }
                            when lt: scalyc.compiler.Model.Type
                            {
                                if lt.name.length = 0
                                {
                                    set args_idx: args_idx + 1
                                    set skipping: true
                                }
                            }
                            else
                                0
                }
                let args_ptr ops.get args_idx
                if head_ptr <> null
                    if args_ptr <> null
                    {
                        let head (*head_ptr)
                        let args (*args_ptr)
                        var is_ctor: bool false
                        var is_deref: bool false
                        ; A method/qualified CALL bound to an escaping local can
                        ; ALIAS its arguments into the result — e.g.
                        ; collapse_operand_sequence(flat) returns an operand that
                        ; shares `flat`'s element guts. The call's result is
                        ; promoted to the caller page via the binding-init restamp,
                        ; but a bound-local ARG whose guts the call passes through
                        ; would still dangle on the local page. Collect those arg
                        ; locals so they are promoted too. Conservatively assumes a
                        ; call may alias its args; over-promotion to rp is safe and
                        ; NEUTRAL on sigiled source — an arg whose binding carries
                        ; an explicit `#`/`^` lifetime is kept verbatim by restamp.
                        ; Two call shapes: `obj.method(args)` carries a
                        ; member_access; `this.method(args)`/`recv.method(args)`
                        ; folds into a dotted Type name [recv, …, method] with a
                        ; NON-capitalized last segment (a dotted ctor `a.b.Type`
                        ; has a capitalized last segment, so it stays is_ctor).
                        var is_call: bool false
                        if head.member_access <> null
                            set is_call: true
                        if head.member_access = null
                            choose head.expression
                                when t: scalyc.compiler.Model.Type
                                {
                                    if t.name.length >= 1
                                    {
                                        let n0 t.name.get 0
                                        if n0 <> null
                                            if this.name_is_capitalized((*n0))
                                                set is_ctor: true
                                    }
                                    ; A deref `*opp` is the operand sequence
                                    ; [Type("*"), opp]; the VALUE is what follows
                                    ; the operator. Recurse past it so a `*opp`
                                    ; stored into an escaping receiver collects
                                    ; `opp` (whose binding may alias an escaping
                                    ; source). Single-segment name only.
                                    if t.name.length = 1
                                    {
                                        let d0 t.name.get 0
                                        if d0 <> null
                                            if (*d0).equals("*")
                                                set is_deref: true
                                    }
                                    if t.name.length >= 2
                                    {
                                        let last_seg t.name.get(t.name.length - 1)
                                        if last_seg <> null
                                            if this.name_is_capitalized((*last_seg)) = false
                                                set is_call: true
                                    }
                                    ; Phase-5 class 2: a SINGLE-segment
                                    ; IDENTIFIER head (leading lowercase
                                    ; letter or underscore) followed by an
                                    ; argument operand is a FREE-FUNCTION /
                                    ; bare sibling call (`build_module(...,
                                    ; syntax.file, ...)` as build_referenced_
                                    ; module's tail). Its args flow into the
                                    ; result exactly like the dotted-call
                                    ; case, so collect them too — without
                                    ; this, `syntax` never enters the escape
                                    ; sets and the choose-payload back-prop
                                    ; in plan_choose# has nothing to match.
                                    ; OPERATOR heads (`&`, `*`, `+`, ...) are
                                    ; NOT calls: collecting `&b`'s operand as
                                    ; a call arg promoted the binding, and
                                    ; gap-1's already_promoted shortcut then
                                    ; ACCEPTED `return &b` — defeating the
                                    ; escape checker's rejection (escape
                                    ; suite neg_return_local_ptr). `*` keeps
                                    ; its own deref recursion above.
                                    if t.name.length = 1
                                    {
                                        let c0 t.name.get 0
                                        if c0 <> null
                                        {
                                            let c0s (*c0)
                                            if c0s.get_length() > 0
                                            {
                                                let c0b c0s.get_buffer()
                                                let c0c (*c0b)
                                                var c0_ident false
                                                if (c0c >= (97 as u8)) && (c0c <= (122 as u8))
                                                    set c0_ident: true
                                                if c0c = (95 as u8)
                                                    set c0_ident: true
                                                if c0_ident
                                                    set is_call: true
                                            }
                                        }
                                    }
                                }
                                else
                                    0
                        ; dh/ph/sa are TRANSIENT single-element holders: box one
                        ; operand, pass it to the SYNCHRONOUS read-only recursive
                        ; collect_flow_locals, discard. They never escape, so they
                        ; are plain LOCALS (no `^rp`). This is load-bearing for the
                        ; `^this` escaping-name stores above: were these `^rp`, the
                        ; whole collect_* chain would need rp threaded from
                        ; add_escaping_* (via the transitive page-set); when
                        ; add_escaping_* moved to `^this` and left that set, the
                        ; chain lost rp, these holders dangled, and the scan
                        ; under-collected — a returned/stored local (e.g.
                        ; handle_declaration's `var fns`) was left on the local page
                        ; and freed, dangling a Modeler concept name into
                        ; register_concept. As locals they need no rp at all.
                        if is_deref
                        {
                            var dh Vector[Operand](1)
                            dh.put(0, args)
                            this.collect_flow_locals(dh)
                        }
                        if is_ctor || is_call
                            choose args.expression
                                when tup: scalyc.compiler.Model.Tuple
                                {
                                    var ci: size_t 0
                                    while ci < tup.components.length
                                    {
                                        let cp tup.components.get ci
                                        if cp <> null
                                            this.collect_flow_locals((*cp).value)
                                        set ci: ci + 1
                                    }
                                }
                                else
                                {
                                    ; Variant construction with a BARE-value
                                    ; payload (`Member.Concept concept`,
                                    ; `Nameable.Functions fns`): the payload is a
                                    ; single operand, NOT a Tuple. It becomes the
                                    ; union's stored value, so a bound-local
                                    ; payload flows into the escaping union and
                                    ; must be promoted. Recurse on a one-operand
                                    ; sequence so the ops.length=1 alias/branch
                                    ; logic collects it.
                                    var ph Vector[Operand](1)
                                    ph.put(0, args)
                                    this.collect_flow_locals(ph)
                                }
                    }
            }
        }
        ; Unwrap a value-yielding branch statement to its value operands so
        ; collect_flow_locals# can descend a choose/if/match/block branch.
        function collect_flow_stmt(this: Planner, s: Statement)
        {
            choose s
                when a: Action
                    this.collect_flow_locals(a.source)
                when r: Return
                    this.collect_flow_locals(r.result)
                else
                    0
        }

        ; deep-R2 store-escape helpers. A value stored via `recv.put(i, v)` /
        ; `recv.add(v)` into a Vector that outlives the frame (recv bound with a
        ; `^name`/`#` init, or already promoted to escape) must itself live on a
        ; non-local page. Bound-local values are collected here (the name-set
        ; then promotes their binding in plan_binding#); INLINE constructions in
        ; a put/add value position have no binding and are left `#` at the source
        ; (the de-sigil skips put/add inline args), so they stay caller-page.
        function add_escaping_target(this: Planner, name: String)
        {
            if this.array_contains_name(escaping_targets, name) = false
                escaping_targets.add(String^this(name))
        }
        ; A binding initializer escapes the frame when its construction carries
        ; an explicit `^name` (Reference) or `#` (Call) lifetime. For a
        ; NON-generic type (`String^rp(…)`) the marker lands on the leading
        ; Type operand; for a GENERIC container (`Vector[T]^rp(…)`) the parser
        ; splits `Vector[T]^rp` into [Type(Vector), Matrix([T])^rp] and the
        ; lifetime rides the MATRIX operand's `life` (s107). Scan EVERY operand
        ; (top-level only — nested ctor args in a Tuple are not the binding's
        ; own placement) for either form.
        ; True when an operation sequence's head is a `Vector[...]` construction
        ; (`var V Vector[X](arr)`). Used by the address-taken escaping-target
        ; trigger so a de-sigiled holder is treated like the `^rp` it replaced.
        function op_seq_head_is_vector(this: Planner, ops: Vector[Operand]) returns bool
        {
            if ops.length = 0
                return false
            let hp ops.get 0
            if hp = null
                return false
            let h (*hp)
            if h.member_access <> null
                return false
            choose h.expression
                when t: scalyc.compiler.Model.Type
                {
                    if t.name.length = 1
                    {
                        let np t.name.get 0
                        if np <> null
                            if (*np).equals("Vector")
                                return true
                    }
                }
                else
                    0
            false
        }
        function operand_seq_escaping_ctor(this: Planner, ops: Vector[Operand]) returns bool
        {
            var i: size_t 0
            while i < ops.length
            {
                let h ops.get i
                if h <> null
                    choose (*h).expression
                        when t: scalyc.compiler.Model.Type
                        {
                            choose t.lifetime
                                when r: Reference
                                    return true
                                when c: Call
                                    return true
                                else
                                    0
                        }
                        when mx: Matrix
                        {
                            choose mx.life
                                when r: Reference
                                    return true
                                when c: Call
                                    return true
                                else
                                    0
                        }
                        else
                            0
                set i: i + 1
            }
            false
        }
        ; Extract the receiver name from a `(*X)` deref modeled as a parenthesized
        ; Tuple with one component whose value is the operand sequence
        ; [Type("*"), Type([X])]. Returns "" when the shape doesn't match. Used to
        ; recognise a pointer-param store `(*param).add(v)` whose receiver is a
        ; ref/pointer out-parameter (seeded into escaping_targets).
        function tuple_deref_receiver_name(this: Planner, tup: scalyc.compiler.Model.Tuple) returns String
        {
            if tup.components.length <> 1
                return ""
            let cp tup.components.get 0
            if cp = null
                return ""
            let val (*cp).value
            if val.length <> 2
                return ""
            let op0 val.get 0
            let op1 val.get 1
            if op0 = null
                return ""
            if op1 = null
                return ""
            var star_ok: bool false
            choose (*op0).expression
                when t0: scalyc.compiler.Model.Type
                {
                    if t0.name.length = 1
                    {
                        let s0 t0.name.get 0
                        if s0 <> null
                            if (*s0).equals("*")
                                set star_ok: true
                    }
                }
                else
                    0
            if star_ok = false
                return ""
            choose (*op1).expression
                when t1: scalyc.compiler.Model.Type
                {
                    if t1.name.length = 1
                    {
                        let s1 t1.name.get 0
                        if s1 <> null
                            return String((*s1))
                    }
                }
                else
                    0
            ""
        }
        function collect_store_value_locals(this: Planner, source: Vector[Operand])
        {
            if source.length >= 2
            {
                let head_ptr source.get 0
                let args_ptr source.get 1
                if head_ptr <> null
                    if args_ptr <> null
                    {
                        let head (*head_ptr)
                        let args (*args_ptr)
                        var recv_escapes: bool false
                        ; Form A — explicit member access: head is `recv` (Type
                        ; name=["recv"]) with member_access=[…, "put"/"add"].
                        if head.member_access <> null
                        {
                            let ma (*head.member_access)
                            if ma.length >= 1
                            {
                                let last_ptr ma.get(ma.length - 1)
                                if last_ptr <> null
                                {
                                    let meth (*last_ptr)
                                    if meth.equals("put") || meth.equals("add")
                                        choose head.expression
                                            when t: scalyc.compiler.Model.Type
                                            {
                                                if t.name.length = 1
                                                {
                                                    let rn_ptr t.name.get 0
                                                    if rn_ptr <> null
                                                    {
                                                        let rn (*rn_ptr)
                                                        if this.array_contains_name(escaping_targets, rn)
                                                            set recv_escapes: true
                                                        if this.array_contains_name(escaping_return_locals, rn)
                                                            set recv_escapes: true
                                                    }
                                                }
                                            }
                                            else
                                                0
                                }
                            }
                        }
                        ; Form B — dotted name: `recv.put(args)` is modeled as a
                        ; Type whose name is ["recv", "put"] with member_access=null
                        ; (the parser folds the method into the name's extensions).
                        ; This is the shape the tree-builders actually emit
                        ; (`gens_holder.put(0, gen_types)` in Modeler.handle_type#),
                        ; so without it the store-escape never fired.
                        if head.member_access = null
                            choose head.expression
                                when t: scalyc.compiler.Model.Type
                                {
                                    if t.name.length = 2
                                    {
                                        let meth_ptr t.name.get 1
                                        if meth_ptr <> null
                                        {
                                            let meth (*meth_ptr)
                                            if meth.equals("put") || meth.equals("add")
                                            {
                                                let rn_ptr t.name.get 0
                                                if rn_ptr <> null
                                                {
                                                    let rn (*rn_ptr)
                                                    if this.array_contains_name(escaping_targets, rn)
                                                        set recv_escapes: true
                                                    if this.array_contains_name(escaping_return_locals, rn)
                                                        set recv_escapes: true
                                                }
                                            }
                                        }
                                    }
                                }
                                else
                                    0
                        ; Form C — pointer-param deref: `(*param).add(args)` /
                        ; `(*param).put(args)` models head.expression as a
                        ; parenthesized Tuple wrapping `(*param)`, with
                        ; member_access ending in put/add. Extract the deref'd
                        ; receiver and check escape membership (ref/pointer
                        ; out-params are seeded into escaping_targets), e.g.
                        ; handle_constituent's `(*symbols_builder).add(name,
                        ; Nameable.Functions fns)`.
                        if head.member_access <> null
                        {
                            let ma2 (*head.member_access)
                            if ma2.length >= 1
                            {
                                let last2 ma2.get(ma2.length - 1)
                                if last2 <> null
                                {
                                    let meth2 (*last2)
                                    if meth2.equals("put") || meth2.equals("add")
                                        choose head.expression
                                            when th: scalyc.compiler.Model.Tuple
                                            {
                                                let rn2 this.tuple_deref_receiver_name(th)
                                                if rn2.get_length() > 0
                                                {
                                                    if this.array_contains_name(escaping_targets, rn2)
                                                        set recv_escapes: true
                                                    if this.array_contains_name(escaping_return_locals, rn2)
                                                        set recv_escapes: true
                                                }
                                            }
                                            else
                                                0
                                }
                            }
                        }
                        if recv_escapes
                            choose args.expression
                                when tup: scalyc.compiler.Model.Tuple
                                {
                                    var ci: size_t 0
                                    while ci < tup.components.length
                                    {
                                        let cp tup.components.get ci
                                        if cp <> null
                                            this.collect_flow_locals((*cp).value)
                                        set ci: ci + 1
                                    }
                                }
                                else
                                {
                                    ; Parenless single-argument store
                                    ; (`result.add stmt`, s199): the argument is a
                                    ; bare value operand, NOT wrapped in a Tuple, so
                                    ; collect the value's flow locals directly.
                                    var sa Vector[Operand](1)
                                    sa.put(0, args)
                                    this.collect_flow_locals(sa)
                                }
                    }
            }
        }

        ; Page inference, gap 1 — RECURSIVE pre-scan collecting bare `return x`
        ; names ANYWHERE in a function body (Block, if consequent/alternative,
        ; choose/match branches + alternative, and loop bodies), so a `return x`
        ; nested in any control flow is found, not just top-level returns.
        ; The walker is `#` and deep-copies each collected name onto rp via
        ; `String^rp` — load-bearing: the name comes from a Model Type.name
        ; Vector whose String `data` points into a transient page; storing it BY
        ; VALUE (`.add((*np))`) dangles and corrupts later reads. (There is NO
        ; "Model-union-by-value" codegen bug — the recursive walk over Model
        ; unions, even passing value-field consequents like iff.consequent by
        ; value, is fine.) Mirrors the proven plan_statement#/plan_if# Model
        ; recursion: union params pass by in-place pointer, `.unwrap()` collapses
        ; to a ref under NPO. The earlier "choose/match arm corrupts" was a
        ; SYMPTOM of a promotion bug, now fixed: collecting a nested return of an
        ; EXPLICITLY-`^page`-bound local (lexer's `return name`) made restamp_
        ; operand_life# override the explicit lifetime → wrong page → dangling
        ; token Strings. restamp now only promotes DEFAULTED-Local allocations.
        ; Phase-5 class 3: the get-alias back-prop for a WHILE-LET condition
        ; binding (`while let m it.next()`). The While condition is a Binding
        ; STRUCT, not a Binding statement, so the walker's Binding arm never
        ; sees it — the drain idiom's element alias `m` had no back-prop and
        ; the escape chain (m -> it -> container) broke at the loop head.
        ; Mirrors the Binding arm's escaping-alias essentials.
        function collect_returns_while_binding(this: Planner, bind: Binding)
        {
            if bind.item.name <> null
            {
                let bnm (*bind.item.name)
                if this.array_contains_name(escaping_return_locals, bnm)
                {
                    this.collect_flow_locals(bind.operation)
                    this.add_escaping_target(bnm)
                    let src this.binding_get_receiver(bind.operation)
                    if src.get_length() > 0
                    {
                        this.add_escaping_target(src)
                        this.add_escaping_local(src)
                    }
                }
            }
        }

        function collect_returns_stmt(this: Planner, s: Statement)
        {
            choose s
                when r: Return
                    ; A returned value escapes — seed the name-graph with every
                    ; bare local flowing into it (alias, ctor args, branch
                    ; values). collect_flow_locals# subsumes the former
                    ; bare-`return x` add + the deep-R2 `return T(args)` walk.
                    this.collect_flow_locals(r.result)
                when bind: Binding
                {
                    ; deep-R2 binding closure: when this binding's name is already
                    ; known to escape, the locals feeding its construction
                    ; initializer escape too. The fixpoint loop in
                    ; scan_top_level_returns# re-runs until no new names appear.
                    if bind.item.name <> null
                    {
                        let bnm (*bind.item.name)
                        if this.array_contains_name(escaping_return_locals, bnm)
                            this.collect_flow_locals(bind.operation)
                        ; deep-R2 store-escape: a binding with an escaping init
                        ; (`^name`/`#`), or an already-promoted name, is a target
                        ; into which put/add stores must place caller-page values.
                        if this.operand_seq_escaping_ctor(bind.operation)
                        {
                            this.add_escaping_target(bnm)
                            ; The escaping (`^rp`/`#`) construction's bound-local
                            ; ARGS flow into the aggregate and must outlive the
                            ; frame too — e.g. a copy-ctor `Vector[T]^rp(local)`
                            ; shallow-copies `local`'s elements, whose heap guts
                            ; stay on the local page. Collect them so their
                            ; bindings are promoted to the construction's page.
                            ; NEUTRAL on sigiled source: the arg's binding-init
                            ; carries an explicit lifetime, which restamp keeps.
                            this.collect_flow_locals(bind.operation)
                        }
                        ; Address-taken Vector binding (page-inference). The `^rp`
                        ; this de-sigil replaced carried a Reference life, so the
                        ; escaping-ctor block above marked the holder an escaping
                        ; target and promoted its feeding locals. A plain
                        ; `var V Vector[X](arr)` whose `&V` escapes into a returned
                        ; structure needs the SAME transitive promotion: V's own
                        ; construction is promoted in plan_binding# by the address-
                        ; taken rule, but the values flowing into it (the feeding
                        ; Array + the elements .add'd into it) reach the caller page
                        ; only via this escaping-target chain. Gated on a Vector ctor
                        ; head so it fires for exactly the de-sigiled-holder shape.
                        ; NEUTRAL on sigiled source: the Reference life already
                        ; triggered the block above, so this is a no-op addition
                        ; there; it only takes over once the `^rp` is gone.
                        if this.array_contains_name(address_taken_locals, bnm)
                            if this.op_seq_head_is_vector(bind.operation)
                            {
                                this.add_escaping_target(bnm)
                                this.collect_flow_locals(bind.operation)
                            }
                        ; Ref-flow counterpart (value-guts provenance,
                        ; 2026-07-03): a holder whose `.get(i)` refs reach an
                        ; argument/return position (getref_arg_locals, recorded
                        ; by scan_getref_args# which runs BEFORE this fixpoint)
                        ; is promoted to the caller page by plan_binding#'s
                        ; getref gate — but the VALUES put/add'd into it must
                        ; move too: Vector.put copies the value struct
                        ; SHALLOWLY, so a bound value's nested heap guts stay
                        ; on its own (local) page and dangle once the frame
                        ; exits. Mark the holder an escaping target so
                        ; collect_store_value_locals# collects its stored
                        ; values into the promotion name-graph. Base-scoped
                        ; consult (the s2026-07-02i guard): a same-named
                        ; OUTER-function entry must never false-match. NEUTRAL
                        ; on sigiled source: a #/^ holder is already an
                        ; escaping target via the escaping-ctor block above.
                        if this.array_contains_name_from(getref_arg_locals, this.getref_arg_base, bnm)
                            if this.op_seq_head_is_vector(bind.operation)
                            {
                                this.add_escaping_target(bnm)
                                this.collect_flow_locals(bind.operation)
                            }
                        if this.array_contains_name(escaping_return_locals, bnm)
                            this.add_escaping_target(bnm)
                        ; get-alias back-propagation: a binding `let opp
                        ; SRC.get(i)` aliases element guts of the local Vector
                        ; SRC. If that alias `opp` is found escaping (its deref
                        ; was stored into an escaping receiver), then SRC's
                        ; elements escape too — mark SRC an escaping target so
                        ; the values put into SRC are themselves promoted. This
                        ; threads escape backward through a Vector-to-Vector
                        ; element copy (`dst.put(i, *src.get(j))`).
                        ;
                        ; ALSO add SRC to escaping_return_locals: when SRC is a
                        ; call-RESULT binding whose elements are read out and
                        ; shallow-copied into an escaping aggregate (plan_binding#'s
                        ; `let planned_ops_flat strip_leading_eq(raw); … let p_ptr
                        ; planned_ops_flat.get i; rest_arr.add(*p_ptr)`), the
                        ; escaping_targets membership alone does NOT promote SRC's
                        ; binding — plan_binding#'s init-promotion gate reads
                        ; escaping_return_locals, not escaping_targets. So the
                        ; strip_leading_eq/plan_operands call result stays on the
                        ; local page and its element guts dangle. Adding SRC to
                        ; escaping_return_locals restamps its call-init to rp.
                        ; NEUTRAL on sigiled source: a `#`/`^`-init binding is kept
                        ; verbatim by restamp; a fill-Vector SRC (the get-alias's
                        ; original target) is already `^rp`/`#`, so promotion is a
                        ; no-op there too — only a DEFAULTED-Local call result moves.
                        if this.array_contains_name(escaping_return_locals, bnm)
                        {
                            let src this.binding_get_receiver(bind.operation)
                            if src.get_length() > 0
                            {
                                this.add_escaping_target(src)
                                this.add_escaping_local(src)
                            }
                        }
                    }
                }
                when a: Action
                    this.collect_returns_action(a)
                else
                    0
        }
        function collect_returns_operand(this: Planner, op: Operand)
        {
            choose op.expression
                when b: Block
                {
                    var i: size_t 0
                    while i < b.statements.length
                    {
                        let sp b.statements.get i
                        if sp <> null
                            this.collect_returns_stmt(sp.unwrap())
                        set i: i + 1
                    }
                    ; deep-R2: the block's LAST statement, if an Action, is the
                    ; implicit return — promote its construction arg locals.
                    if b.statements.length > 0
                    {
                        let last_ptr b.statements.get(b.statements.length - 1)
                        if last_ptr <> null
                            choose last_ptr.unwrap()
                                when la: Action
                                    this.collect_flow_locals(la.source)
                                else
                                    0
                    }
                }
                when iff: scalyc.compiler.Model.If
                {
                    this.collect_returns_stmt(iff.consequent)
                    if iff.alternative <> null
                    {
                        let alt iff.alternative
                        this.collect_returns_stmt((*alt))
                    }
                }
                when ch: Choose
                {
                    var i: size_t 0
                    while i < ch.cases.length
                    {
                        let wp ch.cases.get i
                        if wp <> null
                            this.collect_returns_stmt(wp.consequent)
                        set i: i + 1
                    }
                    if ch.alternative <> null
                    {
                        let alt ch.alternative
                        this.collect_returns_stmt((*alt))
                    }
                }
                when m: Match
                {
                    var i: size_t 0
                    while i < m.branches.length
                    {
                        let bp m.branches.get i
                        if bp <> null
                            this.collect_returns_stmt(bp.consequent)
                        set i: i + 1
                    }
                    if m.alternative <> null
                    {
                        let alt m.alternative
                        this.collect_returns_stmt((*alt))
                    }
                }
                when fo: For
                    this.collect_returns_action(fo.action)
                when wh: While
                {
                    this.collect_returns_while_binding(wh.condition)
                    this.collect_returns_action(wh.action)
                }
                when rep: Repeat
                    this.collect_returns_action(rep.action)
                else
                    0
        }
        function collect_returns_action(this: Planner, a: Action)
        {
            var i: size_t 0
            while i < a.source.length
            {
                let op_ptr a.source.get i
                if op_ptr <> null
                    this.collect_returns_operand(op_ptr.unwrap())
                set i: i + 1
            }
            ; deep-R2 store-escape: a `recv.put/add(value)` where recv outlives
            ; the frame promotes the stored value's bound locals to a non-local
            ; page.
            this.collect_store_value_locals(a.source)
            ; set-reassignment escape: `set X: value` where X is an escaping
            ; accumulator local (the tree-builders' `var result …; … set result:
            ; PlannedOperand(.., Call call, ..); … result` pattern in
            ; collapse_operand_sequence#). The source flows into X and escapes,
            ; so collect the source's bound-local constructions (`call`,
            ; `chained`, `void_ty`) — plan_binding# then promotes their inits (the
            ; inline mangle_*/make_planned_call calls build the returned operand's
            ; mangled-name String / PlannedCall and must live on rp). The
            ; plan_action# PROMOTION side already restamps INLINE source
            ; constructions for the same `set X:`; this is the COLLECTION
            ; counterpart for BOUND-local sources the name-graph owns. Plain-var
            ; target only (member_access null, single segment) — a `set obj.field:`
            ; is the rule-3 store-into-field path, handled elsewhere. NEUTRAL on
            ; sigiled source: the bound local's init carries an explicit #/^,
            ; which restamp keeps verbatim.
            ; Phase-5 class 3 (deref-target store escape): `set *(P): SRC`
            ; stores SRC's VALUE through a pointer into memory whose lifetime
            ; this function cannot see (an rp.allocate'd buffer in the json
            ; List drain, a caller-owned slot via a pointer param). The
            ; shallow-copied value's guts must therefore outlive the frame —
            ; collect SRC's flow locals so the fixpoint promotes their
            ; bindings (and, through the while-let alias back-prop, the
            ; drained container's stored values). Params collected here are
            ; inert (no local binding to promote), so the stdlib drains
            ; (Vector's freeze init over a List PARAM) stay untouched.
            if a.target.length > 1
            {
                let dt_p a.target.get 0
                if dt_p <> null
                {
                    if (*dt_p).member_access = null
                        choose (*dt_p).expression
                            when dt_t: scalyc.compiler.Model.Type
                            {
                                if dt_t.name.length = 1
                                {
                                    let dt_n dt_t.name.get 0
                                    if dt_n <> null
                                        if (*dt_n).equals("*")
                                            this.collect_flow_locals(a.source)
                                }
                            }
                            else
                                0
                }
            }
            if a.target.length = 1
            {
                let tgt_p a.target.get 0
                if tgt_p <> null
                {
                    let tgt (*tgt_p)
                    if tgt.member_access = null
                        choose tgt.expression
                            when tt: scalyc.compiler.Model.Type
                            {
                                if tt.generics = null
                                    if tt.name.length = 1
                                    {
                                        let tnp tt.name.get 0
                                        if tnp <> null
                                        {
                                            let tn (*tnp)
                                            var tesc: bool false
                                            if this.array_contains_name(escaping_return_locals, tn)
                                                set tesc: true
                                            if this.array_contains_name(escaping_targets, tn)
                                                set tesc: true
                                            if tesc
                                            {
                                                this.collect_flow_locals(a.source)
                                                ; get-alias back-propagation, SET form
                                                ; (mirror of the Binding-arm back-prop):
                                                ; `set X: SRC.get(i)` where X escapes
                                                ; makes X alias SRC's element guts, so
                                                ; SRC's elements escape too — mark SRC
                                                ; an escaping target (its put/add VALUES
                                                ; are then collected and promoted) and
                                                ; an escaping local (its own construction
                                                ; is promoted by plan_binding#'s gap-1
                                                ; restamp — the same Call/rp destination
                                                ; the getref gate picks). The holder
                                                ; shape `var H Vector[T](1); H.put(0,
                                                ; bound_local); set alias: H.get(0)`
                                                ; needs this: the getref scan promotes H
                                                ; itself, but the BOUND put value's guts
                                                ; stayed on the local page (value-guts
                                                ; provenance, 2026-07-03). NEUTRAL on
                                                ; sigiled source: a #/^ holder is already
                                                ; an escaping target via its escaping-
                                                ; ctor lifetime, and restamp keeps
                                                ; explicit lifetimes verbatim.
                                                let gsrc this.binding_get_receiver(a.source)
                                                if gsrc.get_length() > 0
                                                {
                                                    this.add_escaping_target(gsrc)
                                                    this.add_escaping_local(gsrc)
                                                }
                                            }
                                        }
                                    }
                            }
                            else
                                0
                }
            }
        }

        ; ================================================================
        ; Address-taken pre-scan (page inference). A read-only Model walk
        ; that records, into address_taken_locals, every BARE local NAME
        ; that appears as the operand of a prefix `&` (`&NAME`) anywhere in
        ; the function body — including inside call-argument Tuples, Matrix
        ; rows, and nested control-flow. plan_binding# then promotes such a
        ; name's binding to the caller page (rp) when its initializer is a
        ; relocatable page-owning Vector construction: a `&V` reference into
        ; an escaping structure (a PlannedCall arg / PlannedItem field) must
        ; outlive the frame, exactly what an explicit `^rp` provided.
        ; Over-collection is harmless — the binding-site gate (Vector init +
        ; restamp owns-page-guts) only fires for the intended shape. Mirrors
        ; the recursion structure of operand_mentions_set#.
        ; ================================================================
        function add_address_taken(this: Planner, name: String)
        {
            if this.array_contains_name(address_taken_locals, name) = false
                address_taken_locals.add(String^this(name))
        }
        function scan_addr_taken_ops(this: Planner, ops: Vector[Operand])
        {
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    ; `& NAME` adjacent pair: this op is the `&` operator and
                    ; the next is a bare single-segment local name.
                    var is_amp: bool false
                    if op.member_access = null
                        choose op.expression
                            when t: scalyc.compiler.Model.Type
                            {
                                if t.generics = null
                                    if t.name.length = 1
                                    {
                                        let np t.name.get 0
                                        if np <> null
                                            if (*np).equals("&")
                                                set is_amp: true
                                    }
                            }
                            else
                                0
                    if is_amp
                        if i + 1 < ops.length
                        {
                            let nxt_ptr ops.get(i + 1)
                            if nxt_ptr <> null
                            {
                                let nxt (*nxt_ptr)
                                if nxt.member_access = null
                                    choose nxt.expression
                                        when nt: scalyc.compiler.Model.Type
                                        {
                                            if nt.generics = null
                                                if nt.name.length = 1
                                                {
                                                    let nnp nt.name.get 0
                                                    if nnp <> null
                                                        this.add_address_taken((*nnp))
                                                }
                                        }
                                        else
                                            0
                            }
                        }
                    this.scan_addr_taken_operand(op)
                }
                set i: i + 1
            }
        }
        function scan_addr_taken_action(this: Planner, a: Action)
        {
            this.scan_addr_taken_ops(a.source)
            this.scan_addr_taken_ops(a.target)
        }
        function scan_addr_taken_stmt(this: Planner, s: Statement)
        {
            choose s
                when a: Action
                    this.scan_addr_taken_action(a)
                when bd: Binding
                    this.scan_addr_taken_ops(bd.operation)
                when r: Return
                    this.scan_addr_taken_ops(r.result)
                when th: Throw
                    this.scan_addr_taken_ops(th.result)
                when br: Break
                    this.scan_addr_taken_ops(br.result)
                else
                    0
        }
        function scan_addr_taken_operand(this: Planner, op: Operand)
        {
            choose op.expression
                when tup: Tuple
                {
                    var i: size_t 0
                    while i < tup.components.length
                    {
                        let cp tup.components.get i
                        if cp <> null
                            this.scan_addr_taken_ops((*cp).value)
                        set i: i + 1
                    }
                }
                when mx: Matrix
                {
                    var i: size_t 0
                    while i < mx.operations.length
                    {
                        let rp_ptr mx.operations.get i
                        if rp_ptr <> null
                            this.scan_addr_taken_ops((*rp_ptr))
                        set i: i + 1
                    }
                }
                when b: Block
                {
                    var i: size_t 0
                    while i < b.statements.length
                    {
                        let sp b.statements.get i
                        if sp <> null
                            this.scan_addr_taken_stmt(sp.unwrap())
                        set i: i + 1
                    }
                }
                when iff: scalyc.compiler.Model.If
                {
                    this.scan_addr_taken_ops(iff.condition)
                    this.scan_addr_taken_stmt(iff.consequent)
                    if iff.alternative <> null
                        this.scan_addr_taken_stmt((*iff.alternative))
                }
                when ch: Choose
                {
                    this.scan_addr_taken_ops(ch.condition)
                    var i: size_t 0
                    while i < ch.cases.length
                    {
                        let wp ch.cases.get i
                        if wp <> null
                            this.scan_addr_taken_stmt((*wp).consequent)
                        set i: i + 1
                    }
                    if ch.alternative <> null
                        this.scan_addr_taken_stmt((*ch.alternative))
                }
                when m: Match
                {
                    this.scan_addr_taken_ops(m.condition)
                    var i: size_t 0
                    while i < m.branches.length
                    {
                        let bp m.branches.get i
                        if bp <> null
                        {
                            let br (*bp)
                            var ci: size_t 0
                            while ci < br.cases.length
                            {
                                let casep br.cases.get ci
                                if casep <> null
                                    this.scan_addr_taken_ops((*casep).condition)
                                set ci: ci + 1
                            }
                            this.scan_addr_taken_stmt(br.consequent)
                        }
                        set i: i + 1
                    }
                    if m.alternative <> null
                        this.scan_addr_taken_stmt((*m.alternative))
                }
                when fo: For
                {
                    this.scan_addr_taken_ops(fo.expression)
                    this.scan_addr_taken_action(fo.action)
                }
                when wh: While
                {
                    this.scan_addr_taken_ops(wh.condition.operation)
                    this.scan_addr_taken_action(wh.action)
                }
                when rep: Repeat
                    this.scan_addr_taken_action(rep.action)
                when tr: Try
                {
                    this.scan_addr_taken_ops(tr.binding.operation)
                    var i: size_t 0
                    while i < tr.catches.length
                    {
                        let wp tr.catches.get i
                        if wp <> null
                            this.scan_addr_taken_stmt((*wp).consequent)
                        set i: i + 1
                    }
                    if tr.alternative <> null
                        this.scan_addr_taken_stmt((*tr.alternative))
                }
                when nw: New
                {
                    var i: size_t 0
                    while i < nw.arguments.components.length
                    {
                        let cp nw.arguments.components.get i
                        if cp <> null
                            this.scan_addr_taken_ops((*cp).value)
                        set i: i + 1
                    }
                }
                when lam: Lambda
                    this.scan_addr_taken_action(lam.body)
                else
                    0
        }
        procedure scan_address_taken(this: Planner, impl: Implementation)
        {
            choose impl
                when a: Action
                    this.scan_addr_taken_action(a)
                else
                    0
        }

        ; ================================================================
        ; Get-ref argument pre-scan (ref-flow provenance, 2026-07-02f).
        ; See the getref_arg_locals field comment. Mirrors the recursion
        ; structure of scan_addr_taken_* with an `in_args` mode: Tuple
        ; components (call/construction argument lists) and return/throw/
        ; break results are escape positions; conditions and plain statement
        ; sources are not. Over-collection is harmless — the plan_binding#
        ; gate (rp in scope + Vector init + restamp owns-page-guts) only
        ; fires for the intended holder shape, and promotion to the caller
        ; page is the page an escaping interior reference requires.
        ; ================================================================
        function add_getref_arg(this: Planner, name: String)
        {
            if this.array_contains_name(getref_arg_locals, name) = false
                getref_arg_locals.add(String^this(name))
        }
        function add_getref_alias(this: Planner, alias_name: String, recv: String)
        {
            getref_alias_names.add(String^this(alias_name))
            getref_alias_receivers.add(String^this(recv))
        }
        function getref_alias_receiver(this: Planner, n: String) returns String
        {
            var i: size_t 0
            while i < getref_alias_names.length
            {
                let p getref_alias_names.get i
                if p <> null
                    if (*p).equals(n)
                    {
                        let rcv getref_alias_receivers.get i
                        if rcv <> null
                            return String((*rcv))
                    }
                set i: i + 1
            }
            ""
        }
        ; Form A/B `RECV.get`/`RECV.get_ptr` detection on a SINGLE operand
        ; (binding_get_receiver# checks ops[0] of a whole sequence; argument
        ; scanning needs the per-operand form). Returns RECV or "".
        function operand_get_receiver(this: Planner, op: Operand) returns String
        {
            if op.member_access = null
                choose op.expression
                    when t: scalyc.compiler.Model.Type
                    {
                        if t.name.length = 2
                        {
                            let mp t.name.get 1
                            if mp <> null
                            {
                                var is_get (*mp).equals("get")
                                if is_get = false
                                    set is_get: (*mp).equals("get_ptr")
                                if is_get
                                {
                                    let rp_ptr t.name.get 0
                                    if rp_ptr <> null
                                        return String((*rp_ptr))
                                }
                            }
                        }
                    }
                    else
                        0
            if op.member_access <> null
                choose op.expression
                    when t2: scalyc.compiler.Model.Type
                    {
                        if t2.name.length = 1
                        {
                            let ma (*op.member_access)
                            if ma.length >= 1
                            {
                                let last_ptr ma.get(ma.length - 1)
                                if last_ptr <> null
                                {
                                    var is_get2 (*last_ptr).equals("get")
                                    if is_get2 = false
                                        set is_get2: (*last_ptr).equals("get_ptr")
                                    if is_get2
                                    {
                                        let rp2 t2.name.get 0
                                        if rp2 <> null
                                            return String((*rp2))
                                    }
                                }
                            }
                        }
                    }
                    else
                        0
            ""
        }
        ; Bare single-segment local name (no generics, no member access) — the
        ; shape of an alias use in an argument list.
        function operand_bare_name(this: Planner, op: Operand) returns String
        {
            if op.member_access <> null
                return ""
            choose op.expression
                when t: scalyc.compiler.Model.Type
                {
                    if t.generics = null
                        if t.name.length = 1
                        {
                            let np t.name.get 0
                            if np <> null
                                return String((*np))
                        }
                }
                else
                    0
            ""
        }
        function scan_getref_ops(this: Planner, ops: Vector[Operand], in_args: bool)
        {
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    ; `*RECV.get(i)` copies the value out — benign. The `*`
                    ; rides the PREVIOUS operand in the flat sequence.
                    var deref_before false
                    if i > 0
                    {
                        let prev_ptr ops.get(i - 1)
                        if prev_ptr <> null
                        {
                            let pn this.operand_bare_name((*prev_ptr))
                            if pn.equals("*")
                                set deref_before: true
                        }
                    }
                    if in_args
                        if deref_before = false
                        {
                            let recv this.operand_get_receiver(op)
                            if recv.get_length() > 0
                                this.add_getref_arg(recv)
                            if recv.get_length() = 0
                            {
                                let bare this.operand_bare_name(op)
                                if bare.get_length() > 0
                                {
                                    let arecv this.getref_alias_receiver(bare)
                                    if arecv.get_length() > 0
                                        this.add_getref_arg(arecv)
                                }
                            }
                        }
                    ; `*(RECV.get i)` — a `*`-prefixed single-component paren
                    ; group is DEREF'D: its leading get copies the value out,
                    ; so the receiver must NOT be recorded (Option B: the
                    ; no-rp gate would otherwise false-fire on the benign
                    ; `*(vector.get 0)` test shapes). The paren group models
                    ; as a Tuple, whose component recursion below forces
                    ; in_args=true — intercept it here (where the previous
                    ; operand is visible) and scan the component with
                    ; in_args=false instead; a REAL call-arg tuple nested
                    ; deeper re-enables recording through the normal Tuple
                    ; recursion.
                    var handled_deref_tuple false
                    if deref_before
                        choose op.expression
                            when dtup: Tuple
                            {
                                if dtup.components.length = 1
                                {
                                    let dcp dtup.components.get 0
                                    if dcp <> null
                                    {
                                        this.scan_getref_ops((*dcp).value, false)
                                        set handled_deref_tuple: true
                                    }
                                }
                            }
                            else
                                0
                    if handled_deref_tuple = false
                        this.scan_getref_operand(op, in_args)
                }
                set i: i + 1
            }
        }
        function scan_getref_action(this: Planner, a: Action)
        {
            ; `set X: RECV.get(i)` — X aliases RECV's element guts.
            if a.target.length = 1
            {
                let tgt_p a.target.get 0
                if tgt_p <> null
                {
                    let tn this.operand_bare_name((*tgt_p))
                    if tn.get_length() > 0
                    {
                        let recv this.binding_get_receiver(a.source)
                        if recv.get_length() > 0
                            this.add_getref_alias(tn, recv)
                    }
                }
            }
            this.scan_getref_ops(a.source, false)
            this.scan_getref_ops(a.target, false)
        }
        function scan_getref_stmt(this: Planner, s: Statement)
        {
            choose s
                when a: Action
                    this.scan_getref_action(a)
                when bd: Binding
                {
                    ; `let r RECV.get(i)` — r aliases RECV's element guts.
                    if bd.item.name <> null
                    {
                        let recv this.binding_get_receiver(bd.operation)
                        if recv.get_length() > 0
                            this.add_getref_alias((*bd.item.name), recv)
                    }
                    this.scan_getref_ops(bd.operation, false)
                }
                when r: Return
                    this.scan_getref_ops(r.result, true)
                when th: Throw
                    this.scan_getref_ops(th.result, true)
                when br: Break
                    this.scan_getref_ops(br.result, true)
                else
                    0
        }
        function scan_getref_operand(this: Planner, op: Operand, in_args: bool)
        {
            choose op.expression
                when tup: Tuple
                {
                    var i: size_t 0
                    while i < tup.components.length
                    {
                        let cp tup.components.get i
                        if cp <> null
                            this.scan_getref_ops((*cp).value, true)
                        set i: i + 1
                    }
                }
                when mx: Matrix
                {
                    var i: size_t 0
                    while i < mx.operations.length
                    {
                        let rp_ptr mx.operations.get i
                        if rp_ptr <> null
                            this.scan_getref_ops((*rp_ptr), in_args)
                        set i: i + 1
                    }
                }
                when b: Block
                {
                    var i: size_t 0
                    while i < b.statements.length
                    {
                        let sp b.statements.get i
                        if sp <> null
                            this.scan_getref_stmt(sp.unwrap())
                        set i: i + 1
                    }
                }
                when iff: scalyc.compiler.Model.If
                {
                    this.scan_getref_ops(iff.condition, false)
                    this.scan_getref_stmt(iff.consequent)
                    if iff.alternative <> null
                        this.scan_getref_stmt((*iff.alternative))
                }
                when ch: Choose
                {
                    this.scan_getref_ops(ch.condition, false)
                    var i: size_t 0
                    while i < ch.cases.length
                    {
                        let wp ch.cases.get i
                        if wp <> null
                            this.scan_getref_stmt((*wp).consequent)
                        set i: i + 1
                    }
                    if ch.alternative <> null
                        this.scan_getref_stmt((*ch.alternative))
                }
                when m: Match
                {
                    this.scan_getref_ops(m.condition, false)
                    var i: size_t 0
                    while i < m.branches.length
                    {
                        let bp m.branches.get i
                        if bp <> null
                        {
                            let br (*bp)
                            var ci: size_t 0
                            while ci < br.cases.length
                            {
                                let casep br.cases.get ci
                                if casep <> null
                                    this.scan_getref_ops((*casep).condition, false)
                                set ci: ci + 1
                            }
                            this.scan_getref_stmt(br.consequent)
                        }
                        set i: i + 1
                    }
                    if m.alternative <> null
                        this.scan_getref_stmt((*m.alternative))
                }
                when fo: For
                {
                    this.scan_getref_ops(fo.expression, false)
                    this.scan_getref_action(fo.action)
                }
                when wh: While
                {
                    this.scan_getref_ops(wh.condition.operation, false)
                    this.scan_getref_action(wh.action)
                }
                when rep: Repeat
                    this.scan_getref_action(rep.action)
                when tr: Try
                {
                    this.scan_getref_ops(tr.binding.operation, false)
                    var i: size_t 0
                    while i < tr.catches.length
                    {
                        let wp tr.catches.get i
                        if wp <> null
                            this.scan_getref_stmt((*wp).consequent)
                        set i: i + 1
                    }
                    if tr.alternative <> null
                        this.scan_getref_stmt((*tr.alternative))
                }
                when nw: New
                {
                    var i: size_t 0
                    while i < nw.arguments.components.length
                    {
                        let cp nw.arguments.components.get i
                        if cp <> null
                            this.scan_getref_ops((*cp).value, true)
                        set i: i + 1
                    }
                }
                when lam: Lambda
                    this.scan_getref_action(lam.body)
                else
                    0
        }
        procedure scan_getref_args(this: Planner, impl: Implementation)
        {
            choose impl
                when a: Action
                    this.scan_getref_action(a)
                else
                    0
        }

        ; Entry: pre-scan a whole function body for bare `return x` targets and
        ; (deep-R2) locals flowing into returned constructions. Re-run to a
        ; FIXPOINT: each pass the Binding arm propagates escape one level deeper
        ; through `let p Ctor(q, ...)` chains; iterate until the set stops
        ; growing. Bounded by the number of bindings (monotone, dedup-add).
        procedure scan_top_level_returns(this: Planner, impl: Implementation)
        {
            choose impl
                when a: Action
                {
                    var prev_len: size_t 0
                    var passes: size_t 0
                    repeat
                    {
                        ; Track BOTH sets: a pass may grow only escaping_targets
                        ; (e.g. the get-alias marking a Vector whose elements feed
                        ; an escaping receiver) without adding any return-local.
                        ; Terminating on escaping_return_locals alone would stop
                        ; before the next pass picks up the newly-escaping target's
                        ; stored values (`SRC.put(i, modelled)` → promote modelled).
                        set prev_len: escaping_return_locals.length + escaping_targets.length
                        this.collect_returns_action(a)
                        set passes: passes + 1
                        if (escaping_return_locals.length + escaping_targets.length) = prev_len
                            break
                        if passes >= 64
                            break
                    }
                }
                else
                    0
        }

        function plan_implementation(this: Planner, impl: Implementation) returns PlannedImplementation
        {
            choose impl
                when a: Action
                    PlannedImplementation.Action(this.plan_action(a))
                when e: Extern
                    PlannedImplementation.Extern(PlannedExternImpl e.span)
                when i: Instruction
                    PlannedImplementation.Instruction(PlannedInstructionImpl i.span)
                when n: Intrinsic
                    PlannedImplementation.Intrinsic(PlannedIntrinsicImpl n.span)
        }

        ; ================================================================
        ; plan_function: Model.Function → Plan.PlannedFunction.
        ;
        ; Opens a new scope, registers each parameter as a local, plans
        ; the return/throws types, and plans the implementation.
        ; Computes:
        ;   - mangled_name (Itanium ABI via mangle_function)
        ;   - can_throw (set iff throws_type is present)
        ;   - needs_local_page (scan body for Local-lifetime ops)
        ;   - has_page (page parameter present or implicit return alloc)
        ; `origin` (instantiation source) and `scheme` (post-solver
        ; type scheme) remain null for now.
        ; ================================================================
        function plan_function(
            this: Planner,
            f: Function,
            parent: ref[PlannedType]?
        ) returns PlannedFunction
        {
            this.push_scope()

            ; For generic functions with no explicit instantiation,
            ; seed each type parameter with a fresh type variable so
            ; plan_type can resolve `T` etc. to something unifiable.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < f.parameters.length
            {
                let gp_ptr f.parameters.get gi
                if gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    if existing = null
                    {
                        let fresh this.fresh_type_var(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items(f.input)

            ; Patch `this` parameter to carry the enclosing type. The Modeler
            ; produces an Item with no explicit type for `this`, so plan_item#
            ; returns a PlannedItem with item_type=null. Without this patch,
            ; emit_function_decl skips `this` (no item_type → no LLVMTypeRef
            ; pushed) and LLVMGetParam later crashes on a null Argument type.
            ; Mirrors Planner.cpp:11765-11778.
            if parent <> null
            {
                var ti: size_t 0
                while ti < planned_input.length
                {
                    let item_ptr planned_input.get ti
                    if item_ptr <> null
                    {
                        let item (*item_ptr)
                        if item.name <> null
                        {
                            if item.item_type = null
                            {
                                let n (*item.name)
                                if n.equals("this")
                                {
                                    let p (*parent)
                                    var patched item
                                    set patched.item_type: &^this p
                                    planned_input.put(ti, patched)
                                }
                            }
                        }
                    }
                    set ti: ti + 1
                }
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            ; For 'this', the local-scope binding should be
                            ; pointer[T] (struct-by-pointer ABI), so field
                            ; access auto-derefs. Mirrors Planner.cpp:11781-11790.
                            if n.equals("this")
                            {
                                let ptr_t Planner.make_pointer_type(t)
                                this.define_parameter(n, ptr_t)
                            }
                            if n.equals("this") = false
                                this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            ; s152: register the implicit page parameter (function#'s `rp`)
            ; as a pointer[Page] local so the body can pass it as an explicit
            ; value argument — e.g. `file_path.substring(start, length)`.
            ; Without this `rp` doesn't resolve as a variable,
            ; plan_type_operand# mis-plans the operand, and emit_call drops
            ; the entire call (its arg emits a null handle, line ~3285).
            ; Symptom: extract_program_name#'s implicit-return substring was
            ; silently elided (bare `ret void`). Mirrors stage-0's page-param
            ; binding in planFunction (Planner.cpp implicit `rp`).
            ; The page param's name: explicit when `#` set page_parameter, else
            ; the implicit "rp" when the page is INFERRED (de-sigiled decl with
            ; function_needs_caller_page true — mirrors the s131 page_param_ref
            ; inference below). Registering it as a pointer[Page] local lets a
            ; de-sigiled body pass `rp` as an explicit value arg
            ; (`x.substring(...)`), not only as the `^rp` lifetime. Without
            ; this a de-sigiled fn that uses `rp` explicitly mis-plans the
            ; operand and emit_call drops the call (the s152 symptom), which only
            ; surfaces in the self-built compiler (seed_root emits the de-sigiled
            ; body wrong → stage1 mis-resolves the dropped call). NEUTRAL on
            ; sigiled source: page_parameter is set, so the implicit branch
            ; never fires; it also defines `rp` for any already-no-`#`
            ; non-primitive-returning fn (a latent consistency fix).
            var pp_name_ref: ref[String]? null
            if f.page_parameter <> null
                set pp_name_ref: f.page_parameter
            if f.page_parameter = null
                if Planner.function_needs_caller_page(this, f)
                {
                    var rp_holder Vector[String](1)
                    rp_holder.put(0, "rp")
                    set pp_name_ref: rp_holder.get(0)
                }
            if pp_name_ref <> null
            {
                let pp_name (*pp_name_ref)
                let pp_page_ty PlannedType(
                    f.span,
                    "Page",
                    "",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
                let pp_ptr_ty Planner.make_pointer_type(pp_page_ty)
                this.define_parameter(pp_name, pp_ptr_ty)
            }

            var return_type: ref[PlannedType]? null
            if f.returns_ <> null
            {
                let rt (*f.returns_)
                set return_type: &^this this.plan_type(rt)
            }

            var throws_type: ref[PlannedType]? null
            if f.throws_ <> null
            {
                let tt (*f.throws_)
                set throws_type: &^this this.plan_type(tt)
            }

            ; GAP B: expose the return type to the body so a returned lambda
            ; becomes an escaping closure (env on the caller page). Track stack
            ; closures bound in this function for the return-escape check; the
            ; set is truncated back at the boundary so nested functions are
            ; isolated.
            let saved_return_type this.current_return_type
            set this.current_return_type: return_type
            let saved_lcn local_closure_names.length
            let saved_lbn local_box_names.length
            ; Page inference, gap 1: pre-scan the body for bare `return x`
            ; targets so plan_binding# can promote their allocations to the
            ; caller page. Sets are truncated at the function boundary so
            ; nested functions stay isolated.
            let saved_erl escaping_return_locals.length
            let saved_pbn promoted_binding_names.length
            let saved_etg escaping_targets.length
            let saved_lts local_tainted_struct_bindings.length
            let saved_atl address_taken_locals.length
            let saved_gra getref_arg_locals.length
            let saved_gan getref_alias_names.length
            let saved_gar getref_alias_receivers.length
            let saved_lfh local_frame_holder_names.length
            ; Option B: scope the NEW consultations (stamp + no-rp gate) to
            ; entries recorded by THIS function — a lazily-instantiated
            ; generic method planned mid-function must not see the outer
            ; function's holder names (see the field comment).
            let saved_lfb this.local_frame_holder_base
            set this.local_frame_holder_base: local_frame_holder_names.length
            let saved_gab this.getref_arg_base
            set this.getref_arg_base: getref_arg_locals.length
            ; Page inference: a value stored through a ref/pointer out-parameter
            ; escapes to the caller, so seed those param names as escape targets.
            ; A later `param.add(v)` / `(*param).add(v)` then promotes v to the
            ; caller page (e.g. handle_constituent's `var fns Vector[Function]`
            ; stored into the `symbols_builder` pointer param). `this` excluded.
            var pp: size_t 0
            while pp < f.input.length
            {
                let pip f.input.get pp
                if pip <> null
                {
                    let pit (*pip)
                    if pit.name <> null
                        if pit.type <> null
                        {
                            let pnm (*pit.name)
                            if pnm.equals("this") = false
                                if Planner.is_ref_or_pointer_type((*pit.type))
                                    this.add_escaping_target(pnm)
                        }
                }
                set pp: pp + 1
            }
            ; Page inference (address-taken rule): record every bare `&NAME`
            ; FIRST, so the scan_top_level_returns# fixpoint below can treat an
            ; address-taken Vector binding as an escaping-target (its feeding
            ; Array + the values .add'd into it must reach the caller page too,
            ; exactly as the `^rp` holder's escaping-ctor lifetime did).
            this.scan_address_taken(f.implementation)
            ; Ref-flow provenance (2026-07-02f): record holder locals whose
            ; get-refs reach argument/return positions — see scan_getref_args#.
            this.scan_getref_args(f.implementation)
            this.scan_top_level_returns(f.implementation)
            ; Page inference: promote the IMPLICIT-RETURN (tail) expression of a
            ; page-owning-return function to the caller page. R2 only sees
            ; explicit `return`; a function whose body's last expression is a
            ; bare construction/call (`{ ... Vector[T](0) }`) or a choose/if
            ; whose arms construct the result needs the tail promoted too, or
            ; it dangles on the local page. plan_action# reads-and-clears the
            ; flag so only the outermost body action promotes.
            let saved_ptr this.promote_tail_return
            set this.promote_tail_return: Planner.needs_implicit_return_page(f)
            ; Hole-1 (2026-07-02f): the tail ref-escape CHECK runs for every
            ; function with a return type, not just page-owning-value returns
            ; (unify returns ref[Vector[...]]? — needs_implicit_return_page is
            ; false there, yet its tail `&result` is a return position).
            let saved_cte this.check_tail_escape
            var f_has_return false
            if f.returns_ <> null
                set f_has_return: true
            set this.check_tail_escape: f_has_return
            let planned_impl this.plan_implementation(f.implementation)
            set this.promote_tail_return: saved_ptr
            set this.check_tail_escape: saved_cte
            set escaping_return_locals.length: saved_erl
            set promoted_binding_names.length: saved_pbn
            set escaping_targets.length: saved_etg
            set local_tainted_struct_bindings.length: saved_lts
            set address_taken_locals.length: saved_atl
            set getref_arg_locals.length: saved_gra
            set getref_alias_names.length: saved_gan
            set getref_alias_receivers.length: saved_gar
            set local_frame_holder_names.length: saved_lfh
            set this.local_frame_holder_base: saved_lfb
            set this.getref_arg_base: saved_gab
            set local_closure_names.length: saved_lcn
            set local_box_names.length: saved_lbn
            set this.current_return_type: saved_return_type

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            var input_holder Vector[PlannedItem](planned_input)

            ; Compute the Itanium mangled name. For a free function this
            ; is `_Z<name-len><name><params>`; for methods (parent
            ; non-null) it's `_ZN<parent><name>E<params>`. function#
            ; sites prepend an implicit page parameter; functions that
            ; return a user-defined type also need the caller's page to
            ; allocate the result (needs_implicit_return_page).
            var has_page: bool false
            if f.page_parameter <> null
                set has_page: true
            if Planner.function_needs_caller_page(this, f)
                set has_page: true

            ; Extern C functions keep their unmangled name so LLVM can
            ; resolve them against libc / system libraries. Mirrors
            ; Planner.cpp:11806-11808's IsExtern ? Func.Name : mangle.
            var mangled_holder Vector[String](1)
            if Planner.is_extern_impl(f.implementation)
                mangled_holder.put(0, String(f.name))
            if Planner.is_extern_impl(f.implementation) = false
                mangled_holder.put(0, Planner.mangle_function(f.name, &input_holder, parent, has_page))
            let mangled (*mangled_holder.get(0))

            var can_throw: bool false
            if throws_type <> null
                set can_throw: true

            ; needs_local_page: true iff the Action body contains any $
            ; allocation (Lifetime.Local on some operand's type). Used
            ; by the Emitter to emit page-cleanup on function exit.
            var needs_local_page: bool false
            choose planned_impl
                when ia: PlannedAction
                {
                    if ia.source <> null
                    {
                        let src (*ia.source)
                        var i: size_t 0
                        while i < src.length
                        {
                            let op_ptr src.get i
                            if op_ptr <> null
                            {
                                if Planner.operand_has_local_lifetime((*op_ptr))
                                    set needs_local_page: true
                            }
                            set i: i + 1
                        }
                    }
                    0
                }
                else
                    0

            ; Propagate the page_parameter ref so emit_function_decl can
            ; prepend the implicit `rp: pointer[Page]` LLVM arg. Without
            ; this, `function(x: T)` mangles correctly (PN4scaly...) but
            ; the LLVM signature drops the rp slot and stage-1 callers
            ; that pass `rp` first end up loading the wrong arg.
            ;
            ; s131: also set page_param_ref when needs_implicit_return_page
            ; is true (return-by-page allocation injects an implicit page
            ; arg the same way `#` does). Without this, the mangled name
            ; includes `PN4scaly6memory4PageE` (via has_page above) but the
            ; PlannedFunction's page_parameter stays null. emit_function_decl
            ; then computes page_offset=0 and emits 3 LLVM params instead
            ; of 4 — emit_function_body's variable-binding loop then maps
            ; user params (this, i) to LLVMGetParam(1, 2), which actually
            ; correspond to the page + this slots in the 4-arg LLVM
            ; signature created by the s78/s83 extern-decl path (which
            ; sees requires_page_param=true via MethodMatch). Symptom:
            ; `Vector.get` body's `data + i` emits `add ptr %data, %2`
            ; where %2 is the this-ptr slot, not the i index.
            var page_param_ref: ref[String]? null
            if f.page_parameter <> null
            {
                var pp_holder Vector[String](1)
                pp_holder.put(0, String((*f.page_parameter)))
                set page_param_ref: pp_holder.get(0)
            }
            if f.page_parameter = null
            {
                if Planner.function_needs_caller_page(this, f)
                {
                    var pp_holder Vector[String](1)
                    pp_holder.put(0, "rp")
                    set page_param_ref: pp_holder.get(0)
                }
            }

            let result PlannedFunction(
                f.span,
                f.private_,
                f.pure,
                f.name,
                mangled,
                page_param_ref,
                &input_holder,
                return_type,
                throws_type,
                f.lifetime,
                planned_impl,
                null,
                needs_local_page,
                can_throw,
                null,
                this.file
            )
            this.record_function(result)
            result
        }

        ; plan_initializer: Model.Initializer → Plan.PlannedInitializer.
        ; An initializer is like a function without name / returns_ / throws_ /
        ; lifetime. Parameters open a new scope, implementation is planned,
        ; scope closed.
        ;
        ; s81: also synthesizes a PlannedFunction wrapper for the init
        ; body and records it in instantiated_functions so emit_function_decl
        ; / emit_function_body produce the C1 ctor body. The wrapper's
        ; LLVM signature is [this: parent, page (if init#), ...user_args]
        ; — page_parameter on the wrapper is left null to avoid the
        ; emit_function_decl page-prepend; the page slot is just a
        ; regular input item.
        function plan_initializer(
            this: Planner,
            ini: Initializer,
            parent: ref[PlannedType]?
        ) returns PlannedInitializer
        {
            this.push_scope()

            let planned_input this.plan_items(ini.input)

            ; s81: define `page` as `pointer[scaly.memory.Page]` so
            ; bare `page.allocate(...)` in the init body resolves.
            ; Mirrors Planner.cpp:12048-12061.
            if ini.page_parameter <> null
            {
                let page_struct_ty PlannedType(
                    ini.span,
                    "scaly.memory.Page",
                    "N4scaly6memory4PageE",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
                let page_ptr_ty Planner.make_pointer_type(page_struct_ty)
                this.define_parameter((*ini.page_parameter), page_ptr_ty)
            }

            var i: size_t 0
            while i < planned_input.length
            {
                let item_ptr planned_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            ; s81: define `this` as `pointer[parent]` so bare-field
            ; access in the init body (`set data: ...`) is rewritten
            ; via the implicit-property-access path at Planner.scaly
            ; line ~4347. Mirrors Planner.cpp:12082-12088.
            if parent <> null
            {
                let p (*parent)
                let this_ptr_ty Planner.make_pointer_type(p)
                this.define_parameter("this", this_ptr_ty)
            }

            let planned_impl this.plan_implementation(ini.implementation)

            this.pop_scope()

            var input_holder Vector[PlannedItem](planned_input)

            ; init#(page, ...) requires the mangled symbol to carry a
            ; leading size_t "page" parameter so LLVM signatures match
            ; what emit-site call resolution expects. When parent is
            ; non-null the initializer mangles as a method of that type
            ; (Itanium `_ZN<parent>initE<params>`).
            var has_page: bool false
            if ini.page_parameter <> null
                set has_page: true

            let mangled Planner.mangle_function(
                "init", &input_holder, parent, has_page
            )

            ; Clone the page_parameter name into rp so the resulting
            ; PlannedInitializer owns a stable reference.
            var page_ref: ref[String]? null
            if ini.page_parameter <> null
            {
                var holder Vector[String](1)
                holder.put(0, String((*ini.page_parameter)))
                set page_ref: holder.get(0)
            }

            let result_ini PlannedInitializer(
                ini.span,
                ini.private_,
                page_ref,
                mangled,
                &input_holder,
                planned_impl
            )

            ; s81: synthesize a PlannedFunction body wrapper and record
            ; it so emit_function_decl/body produce the C1 ctor body.
            ; Skip when impl is Extern/Intrinsic (no body to emit) or
            ; when parent is null (free-floating init# isn't a thing).
            choose planned_impl
                when ia: PlannedAction
                {
                    if parent <> null
                    {
                        let p (*parent)
                        var synth_items Array[PlannedItem]()

                        var this_name_holder Vector[String](1)
                        this_name_holder.put(0, "this")
                        synth_items.add(PlannedItem(
                            ini.span,
                            false,
                            this_name_holder.get 0,
                            &^this p,
                            null
                        ))

                        if ini.page_parameter <> null
                        {
                            let page_struct_ty PlannedType(
                                ini.span,
                                "scaly.memory.Page",
                                "N4scaly6memory4PageE",
                                null,
                                Lifetime.Unspecified(Unspecified()),
                                null,
                                "",
                                null
                            )
                            let page_ptr_ty Planner.make_pointer_type(page_struct_ty)
                            var page_ty_holder Vector[PlannedType](1)
                            page_ty_holder.put(0, page_ptr_ty)

                            var page_name_holder Vector[String](1)
                            page_name_holder.put(0, String((*ini.page_parameter)))

                            synth_items.add(PlannedItem(
                                ini.span,
                                false,
                                page_name_holder.get 0,
                                page_ty_holder.get 0,
                                null
                            ))
                        }

                        var ui: size_t 0
                        while ui < planned_input.length
                        {
                            let pi_ptr planned_input.get ui
                            if pi_ptr <> null
                                synth_items.add((*pi_ptr))
                            set ui: ui + 1
                        }

                        var synth_input_holder Vector[PlannedItem](synth_items)

                        let synth_fn PlannedFunction(
                            ini.span,
                            ini.private_,
                            false,
                            "init",
                            mangled,
                            null,
                            &synth_input_holder,
                            null,
                            null,
                            Lifetime.Unspecified(Unspecified()),
                            planned_impl,
                            null,
                            false,
                            false,
                            null,
                            this.file
                        )
                        this.record_function(synth_fn)
                    }
                    0
                }
                else
                    0

            result_ini
        }

        ; plan_deinitializer: Model.DeInitializer → Plan.PlannedDeInitializer.
        ; Even simpler than plan_initializer — no parameters.
        function plan_deinitializer(
            this: Planner,
            dei: DeInitializer,
            parent: ref[PlannedType]?
        ) returns PlannedDeInitializer
        {
            let planned_impl this.plan_implementation(dei.implementation)
            ; Mangle as a method of `parent` named "deinit" (Itanium
            ; `_ZN<parent>6deinitEv`); bare deinit for a free context.
            let mangled Planner.mangle_function(
                "deinit", null, parent, false
            )
            PlannedDeInitializer(
                dei.span,
                mangled,
                planned_impl
            )
        }

        ; plan_operator: Model.Operator → Plan.PlannedOperator.
        ; Structurally identical to plan_function modulo the two missing
        ; fields (no `pure`, no `lifetime`).
        function plan_operator(
            this: Planner,
            op: Operator,
            parent: ref[PlannedType]?
        ) returns PlannedOperator
        {
            this.push_scope()

            ; Seed generic type parameters with fresh type variables.
            let saved_subst_len type_substitutions.length
            var gi: size_t 0
            while gi < op.parameters.length
            {
                let gp_ptr op.parameters.get gi
                if gp_ptr <> null
                {
                    let gp (*gp_ptr)
                    let existing this.lookup_type_substitution(gp.name)
                    if existing = null
                    {
                        let fresh this.fresh_type_var(gp.name)
                        this.define_type_substitution(gp.name, fresh)
                    }
                }
                set gi: gi + 1
            }

            let planned_input this.plan_items(op.input)

            ; Member operators may declare `this` implicitly (Vector/Slice
            ; `operator [](i: size_t)`) — prepend the receiver item so the
            ; body's bare field reads (`length`, `data`) resolve through
            ; the `this` binding and the signature matches the
            ; [receiver, args...] call shape when the operator is recorded
            ; as a dispatchable function (find_subscript_operator).
            ; Explicit-this declarations (Array's `operator [](this:
            ; Array[T], i)`) come through plan_items already; mangle_operator
            ; skips the leading "this" item by name either way, so mangled
            ; names are unchanged.
            var oi_arr Array[PlannedItem]()
            var needs_this: bool false
            if parent <> null
                set needs_this: true
            if needs_this
            {
                if planned_input.length > 0
                {
                    let fi_ptr planned_input.get 0
                    if fi_ptr <> null
                    {
                        let fi (*fi_ptr)
                        if fi.name <> null
                        {
                            let fin (*fi.name)
                            if fin.equals("this")
                                set needs_this: false
                        }
                    }
                }
            }
            if needs_this
            {
                let pt (*parent)
                var tn_holder Vector[String](1)
                tn_holder.put(0, String("this"))
                oi_arr.add(PlannedItem(op.span, false, tn_holder.get(0), &^this pt, null))
            }
            var pii: size_t 0
            while pii < planned_input.length
            {
                let ip planned_input.get pii
                if ip <> null
                    oi_arr.add((*ip))
                set pii: pii + 1
            }
            var full_input Vector[PlannedItem](oi_arr)

            var i: size_t 0
            while i < full_input.length
            {
                let item_ptr full_input.get i
                if item_ptr <> null
                {
                    let item (*item_ptr)
                    if item.name <> null
                    {
                        if item.item_type <> null
                        {
                            let n (*item.name)
                            let t (*item.item_type)
                            ; For 'this', the local-scope binding must be
                            ; pointer[T] so bare-field access in the body
                            ; resolves via the implicit-property path
                            ; (same as plan_function's this handling).
                            if n.equals("this")
                            {
                                let ptr_t Planner.make_pointer_type(t)
                                this.define_parameter(n, ptr_t)
                            }
                            if n.equals("this") = false
                                this.define_parameter(n, t)
                        }
                    }
                }
                set i: i + 1
            }

            ; Same implicit-return-page rule as plan_function: a non-extern
            ; operator returning a non-primitive (Vector's `[]` returns
            ; ref[T]?) takes the caller's page, exactly like Vector.get.
            ; Register `rp` as a pointer[Page] local (s152 mirror) and
            ; carry the slot in the mangled name below.
            var op_has_page: bool false
            if Planner.is_extern_impl(op.implementation) = false
            {
                if op.returns_ <> null
                {
                    let ort (*op.returns_)
                    if ort.name.length > 0
                    {
                        let ojoined Planner.join_dotted_name(ort.name)
                        if Planner.is_primitive_type_name(ojoined) = false
                            if Planner.is_generic_type_param_name(ojoined) = false
                                set op_has_page: true
                    }
                }
            }
            if op_has_page
            {
                let pp_page_ty PlannedType(
                    op.span,
                    "Page",
                    "",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
                let pp_ptr_ty Planner.make_pointer_type(pp_page_ty)
                this.define_parameter("rp", pp_ptr_ty)
            }

            var return_type: ref[PlannedType]? null
            if op.returns_ <> null
            {
                let rt (*op.returns_)
                set return_type: &^this this.plan_type(rt)
            }

            var throws_type: ref[PlannedType]? null
            if op.throws_ <> null
            {
                let tt (*op.throws_)
                set throws_type: &^this this.plan_type(tt)
            }

            let planned_impl this.plan_implementation(op.implementation)

            this.pop_scope()
            set type_substitutions.length: saved_subst_len

            let mangled Planner.mangle_operator_paged(op.name, &full_input, parent, op_has_page)
            PlannedOperator(
                op.span,
                op.private_,
                op.name,
                mangled,
                &full_input,
                return_type,
                throws_type,
                planned_impl,
                null,
                null
            )
        }

        ; plan_variant: Model.Variant → Plan.PlannedVariant.
        ; The tag is assigned by the caller (variants need sequential tags
        ; within the union; we can't see sibling variants from here).
        ; `mangled_name` is left empty for the same reason as
        ; plan_property.
        function plan_variant(this: Planner, v: Variant, tag: int) returns PlannedVariant
        {
            var var_type: ref[PlannedType]? null
            if v.type <> null
            {
                let t (*v.type)
                set var_type: &^this this.plan_type(t)
            }

            let mangled Planner.encode_name(v.name)

            PlannedVariant(
                v.span,
                v.name,
                mangled,
                var_type,
                null,
                tag
            )
        }

        ; ================================================================
        ; plan_structure: Model.Structure → Plan.PlannedStructure.
        ;
        ; Plans every property, computes struct size/alignment (simple
        ; "size == alignment per primitive" model), then plans all
        ; members: methods (Function), operators, initializers, and the
        ; deinitializer. mangled_name is built via mangle_structure so
        ; method/operator mangling can reference the parent.
        ; ================================================================
        function plan_structure(this: Planner, s: Structure, name: String) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property(p))
                }
                set i: i + 1
            }

            ; First-pass layout on properties with offset=0 to obtain the
            ; per-property offsets.
            var props_initial Vector[PlannedProperty](planned_props)
            let offsets Planner.compute_property_offsets(&props_initial)

            ; Re-emit each PlannedProperty with the computed offset
            ; written back. (PlannedProperty is stored by value in the
            ; Vector; in-place mutation would require reaching through
            ; the heap, so a copy-with-new-offset is cleaner.)
            var props_with_offsets Array[PlannedProperty]()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get j
                let o_ptr offsets.get j
                if p_ptr <> null
                {
                    if o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty](props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)

            ; Build the struct's own PlannedType (name + resolved
            ; generics) before planning methods so method mangling
            ; can encode the parent.
            var gens_arr Array[PlannedType]()
            let c_for_gens_ref this.lookup_concept(name)
            if c_for_gens_ref <> null
            {
                let c_for_gens (*c_for_gens_ref)
                var pi: size_t 0
                while pi < c_for_gens.parameters.length
                {
                    let p_ptr c_for_gens.parameters.get pi
                    if p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        if ts_ref <> null
                            gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var gens_holder Vector[PlannedType](gens_arr)
            var gens_ref: ref[Vector[PlannedType]]? null
            if gens_holder.length > 0
                set gens_ref: &gens_holder
            let mangled Planner.mangle_structure(name, gens_ref)

            let parent_ref PlannedType^this(
                s.span,
                String^this(name),
                mangled,
                gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )

            ; Plan methods, operators, initializers, deinitializer.
            var planned_methods Array[PlannedFunction]()
            var planned_operators Array[PlannedOperator]()
            var planned_initializers Array[PlannedInitializer]()
            var deinit_ref: ref[PlannedDeInitializer]? null

            var mi: size_t 0
            while mi < s.members.length
            {
                let m_ptr s.members.get mi
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            planned_methods.add(this.plan_function(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            planned_operators.add(this.plan_operator(o, parent_ref))
                            0
                        }
                        else
                            0
                }
                set mi: mi + 1
            }

            var ii: size_t 0
            while ii < s.initializers.length
            {
                let ii_ptr s.initializers.get ii
                if ii_ptr <> null
                {
                    let ini (*ii_ptr)
                    planned_initializers.add(this.plan_initializer(ini, parent_ref))
                }
                set ii: ii + 1
            }

            if s.deinitializer <> null
            {
                let di (*s.deinitializer)
                set deinit_ref: &^this this.plan_deinitializer(di, parent_ref)
            }

            var methods_holder Vector[PlannedFunction](planned_methods)
            var ops_holder Vector[PlannedOperator](planned_operators)
            var inits_holder Vector[PlannedInitializer](planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String(name),
                mangled,
                &props_holder,
                &inits_holder,
                deinit_ref,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; plan_structure_layout#: register a Structure's layout (properties,
        ; offsets, size, alignment) into instantiated_structures WITHOUT
        ; planning its methods, operators, initializers, or deinitializer.
        ;
        ; Used by register_struct_layouts# to import cross-module struct
        ; layouts so map_type / emit_struct_type / emit_member_assignment
        ; have a real struct type available, even when the module's
        ; function bodies aren't planned in the current compilation unit.
        ; Skipping methods avoids the planner-side crashes (null this in
        ; check_function_match → String::get_buffer) that would otherwise
        ; happen when walking generic/cross-module method bodies.
        function plan_structure_layout(this: Planner, s: Structure, name: String) returns PlannedStructure
            this.plan_structure_layout_opt(s, name, true)

        ; plan_structure_layout_opt#: as plan_structure_layout# but with a
        ; `plan_inits` switch. The on-demand cross-package path
        ; (ensure_member_layout#) passes false: it needs ONLY the field
        ; layout so map_type can emit the real struct type for member-access
        ; GEPs, NOT the constructor. Planning initializers there records a
        ; PlannedInitializer, which makes the Emitter emit the struct's
        ; `C1` body into THIS root's object — but a dependency type's
        ; constructor belongs to its OWN package's object (e.g. emitting
        ; Planner::C1 into scalyls.o mis-mangles its internal
        ; `ConceptIndex.create#` call to a bare `_Z6createm` and fails to
        ; link). With plan_inits=false the struct stays declare-only here
        ; and the real body is resolved cross-unit at link time.
        function plan_structure_layout_opt(this: Planner, s: Structure, name: String, plan_inits: bool) returns PlannedStructure
        {
            var planned_props Array[PlannedProperty]()
            var i: size_t 0
            while i < s.properties.length
            {
                let p_ptr s.properties.get i
                if p_ptr <> null
                {
                    let p (*p_ptr)
                    planned_props.add(this.plan_property(p))
                }
                set i: i + 1
            }

            var props_initial Vector[PlannedProperty](planned_props)
            let offsets Planner.compute_property_offsets(&props_initial)

            var props_with_offsets Array[PlannedProperty]()
            var j: size_t 0
            while j < planned_props.length
            {
                let p_ptr planned_props.get j
                let o_ptr offsets.get j
                if p_ptr <> null
                {
                    if o_ptr <> null
                    {
                        let p (*p_ptr)
                        let offset *o_ptr
                        props_with_offsets.add(PlannedProperty(
                            p.loc,
                            p.is_private,
                            p.name,
                            p.mangled_name,
                            p.prop_type,
                            p.initializer,
                            p.attributes,
                            offset
                        ))
                    }
                }
                set j: j + 1
            }

            var props_holder Vector[PlannedProperty](props_with_offsets)
            let total_size Planner.compute_struct_size(&props_holder)
            let total_align Planner.compute_struct_alignment(&props_holder)
            let mangled Planner.mangle_structure(name, null)

            ; Build the parent type (struct's own PlannedType) so
            ; plan_initializer can encode the parent in the
            ; mangled C1/C2 names.
            var gens_holder Vector[PlannedType](0)
            let parent_ref PlannedType^this(
                s.span,
                String^this(name),
                mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )

            ; Plan only initializers (constructor bodies). Method
            ; bodies and operators are skipped — those frequently
            ; reference cross-module/generic types that the planner
            ; can't resolve outside their normal walk and would crash
            ; mid-emit. Initializers are simpler (just `set field: ...`
            ; over the struct's own fields) and safe to walk here.
            var planned_initializers Array[PlannedInitializer]()
            if plan_inits
            {
                var ii: size_t 0
                while ii < s.initializers.length
                {
                    let ii_ptr s.initializers.get ii
                    if ii_ptr <> null
                    {
                        let ini (*ii_ptr)
                        planned_initializers.add(this.plan_initializer(ini, parent_ref))
                    }
                    set ii: ii + 1
                }
            }

            var methods_holder Vector[PlannedFunction](0)
            var ops_holder Vector[PlannedOperator](0)
            var inits_holder Vector[PlannedInitializer](planned_initializers)

            let result PlannedStructure(
                s.span,
                s.private_,
                false,
                String(name),
                mangled,
                &props_holder,
                &inits_holder,
                null,
                &methods_holder,
                &ops_holder,
                total_size,
                total_align,
                null
            )
            this.record_structure(result)
            result
        }

        ; register_struct_layouts_in_module#: walk a module's tree and
        ; register layout-only PlannedStructures for every Concept whose
        ; definition is a Structure. Skips the Concept if its name is
        ; already in instantiated_structures (avoids duplicate entries
        ; when the same module is also walked by the full planner).
        function register_struct_layouts_in_module(this: Planner, m: Module)
        {
            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_struct_layouts_in_concept(c)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_struct_layouts_in_module(sub)
                }
                set mi: mi + 1
            }
        }

        ; register_struct_layouts_in_concept#: if the concept's
        ; definition is a Structure, register its layout. If it's a
        ; Namespace, recurse into namespace members and modules.
        function register_struct_layouts_in_concept(this: Planner, c: Concept)
        {
            ; Only handle parameterless concepts here — generic
            ; structures get planned per-instantiation by the existing
            ; lookup_concept path in plan_type#.
            if c.parameters.length > 0
                return

            ; Skip if already recorded.
            let m_check Planner.mangle_structure(c.name, null)
            if this.has_instantiated_structure(m_check)
                return

            choose c.definition
                when s: Structure
                {
                    let pl this.plan_structure_layout(s, c.name)
                    0
                }
                when ns: Namespace
                {
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_struct_layouts_in_concept(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get mi
                        if sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_struct_layouts_in_module(sub)
                        }
                        set mi: mi + 1
                    }
                    0
                }
                else
                    0
        }

        ; ensure_member_layout#: on-demand layout for a CROSS-PACKAGE struct
        ; reached as a member-access base while planning a root that does NOT
        ; walk the defining package. register_struct_layouts_in_module# only
        ; imports the COMPILATION-ROOT package's structs; a dependency type
        ; (e.g. scalyc's ProgramSyntax referenced from scalyls'
        ; symbols.document_symbols#) is registered as a Concept but its
        ; PlannedStructure is never planned, so map_type falls back to the
        ; s114 { ptr } placeholder and emit_member_access_chain GEPs offset 0
        ; for every field — the throws-Success arm `program.file.declarations`
        ; reads garbage and the enclosing `if … <> null` is dropped, so the
        ; LSP feature returns []. Planning the layout here lands it in
        ; instantiated_structures → map_type's on-demand walk emits the real
        ; struct → the GEP chain is correct.
        ;
        ; Pinned to owning_page (the s188/d8c7216e transient-rp lesson): the
        ; PlannedStructure is persistent, so its name/mangled/property-type
        ; Strings must not live on resolve_member_access#'s transient page.
        ; ABI-opaque stdlib structs are excluded (is_runtime_opaque_struct) so
        ; the scaly/scalyc/main fixed point stays byte-identical. Generic
        ; concepts are left to instantiate_generic# (parameterless guard).
        function ensure_member_layout(this: Planner, name: String)
        {
            if Planner.is_runtime_opaque_struct(name)
                return
            let m_check Planner.mangle_structure(name, null)
            if this.has_instantiated_structure(m_check)
                return
            ; Re-entrancy guard (same discipline as instantiate_generic#):
            ; skip if this struct's layout is already being planned higher up
            ; the stack, before record_structure has run.
            var gi: size_t 0
            while gi < instantiating_structures.length
            {
                let im_ptr instantiating_structures.get gi
                if im_ptr <> null
                    if im_ptr.equals(m_check)
                        return
                set gi: gi + 1
            }
            let concept_ref this.lookup_concept(name)
            if concept_ref = null
                return
            let c (*concept_ref)
            if c.parameters.length > 0
                return
            choose c.definition
                when s: Structure
                {
                    ; Layout-only (no initializers) — see
                    ; plan_structure_layout_opt#: the dependency type's
                    ; constructor must NOT be emitted into this root.
                    instantiating_structures.add m_check
                    let pl this.plan_structure_layout_opt^this(s, name, false)
                    if instantiating_structures.length > 0
                        set instantiating_structures.length: instantiating_structures.length - 1
                    ; Recurse into BY-VALUE field types so the emitter's struct
                    ; sizing walker maps each embedded field to its REAL layout
                    ; rather than the s114 { ptr } placeholder — e.g. Planner
                    ; embeds ConceptIndex (16B) / FunctionIndex (32B) by value;
                    ; placeholdering them to 8B shifts every later field offset
                    ; and a Planner constructed in this root mismatches the
                    ; dependency object's. Pointer/ref/primitive/generic
                    ; segments → guarded no-op; the has_instantiated guard at the
                    ; top of each helper breaks field-graph cycles.
                    var fpi: size_t 0
                    while fpi < s.properties.length
                    {
                        let pp_ptr s.properties.get fpi
                        if pp_ptr <> null
                        {
                            let pp (*pp_ptr)
                            if pp.type <> null
                            {
                                let pt (*pp.type)
                                if pt.name.length > 0
                                {
                                    let lp pt.name.get(pt.name.length - 1)
                                    if lp <> null
                                        this.ensure_layout_by_name((*lp))
                                }
                            }
                        }
                        set fpi: fpi + 1
                    }
                    0
                }
                else
                    0
        }

        ; ensure_union_layout#: on-demand layout for a CROSS-PACKAGE union
        ; that is the scrutinee of a `choose` while planning a root that does
        ; not walk the union's defining package (e.g. scalyc's
        ; DeclarationSyntax matched in scalyls' decl_symbol#). Without it,
        ; map_type returns the s114 { ptr } placeholder, the choose extracts
        ; no payload, and a `when f: FunctionSyntax { f.target … }` arm GEPs
        ; the field off a NULL base. Registering the variant tags + payload
        ; sizing (methods skipped — see plan_union_opt#) makes map_type emit
        ; the real tagged union so the payload is extracted correctly.
        ;
        ; Same fixed-point safety as ensure_member_layout#: opaque stdlib
        ; types are excluded, generic concepts are left to instantiate_generic#,
        ; and pinning is to owning_page (persistent plan storage).
        function ensure_union_layout(this: Planner, name: String)
        {
            if Planner.is_runtime_opaque_struct(name)
                return
            let m_check Planner.mangle_structure(name, null)
            if this.has_instantiated_union(m_check)
                return
            var gi: size_t 0
            while gi < instantiating_structures.length
            {
                let im_ptr instantiating_structures.get gi
                if im_ptr <> null
                    if im_ptr.equals(m_check)
                        return
                set gi: gi + 1
            }
            let concept_ref this.lookup_concept(name)
            if concept_ref = null
                return
            let c (*concept_ref)
            choose c.definition
                when u: scalyc.compiler.Model.Union
                {
                    instantiating_structures.add m_check
                    ; A GENERIC cross-package union (Option[X], Result[X,Y],
                    ; a user generic union) is laid out under its BARE name —
                    ; the parameter-free tagged layout {i8 tag, [maxpayload x
                    ; i8]} the emitter uses for every instantiation, identical
                    ; to what the module walk produces for an in-package
                    ; generic union. Ambient substitutions are cleared so a
                    ; generic param bound higher on the stack never leaks a
                    ; monomorphised suffix (_Z6OptionIiE) into the mangled
                    ; name — map_type looks the union up by its bare mangle.
                    ; Non-generic unions have no params, so the clear is inert
                    ; for them. Structs (Vector/Array/HashMap machinery) never
                    ; reach this arm — they are handled by instantiate_generic#.
                    let saved_subst_len type_substitutions.length
                    set type_substitutions.length: 0
                    let pl this.plan_union_opt^this(u, name, false)
                    set type_substitutions.length: saved_subst_len
                    if instantiating_structures.length > 0
                        set instantiating_structures.length: instantiating_structures.length - 1
                    ; Recurse into BY-VALUE variant payload types so the union
                    ; payload is sized over their REAL layouts, not the { ptr }
                    ; placeholder (e.g. JsonValue.Array → JsonArray, 16B). Same
                    ; guard/cycle reasoning as the struct recursion above.
                    var vpi: size_t 0
                    while vpi < u.variants.length
                    {
                        let vv_ptr u.variants.get vpi
                        if vv_ptr <> null
                        {
                            let vv (*vv_ptr)
                            if vv.type <> null
                            {
                                let vt (*vv.type)
                                if vt.name.length > 0
                                {
                                    let lv vt.name.get(vt.name.length - 1)
                                    if lv <> null
                                        this.ensure_layout_by_name((*lv))
                                }
                            }
                        }
                        set vpi: vpi + 1
                    }
                    0
                }
                else
                    0
        }

        ; ensure_type_layout#: on-demand layout for a CROSS-PACKAGE struct OR
        ; union that crosses a call boundary BY VALUE (an sret return type or a
        ; by-value parameter) while planning a root that does not walk the
        ; defining package. ensure_member_layout# / ensure_union_layout# fire
        ; only on member-access hops / choose scrutinees; a type that is merely
        ; PASSED to or RETURNED from an extern dependency function (e.g.
        ; scalyls' json.get / json.as_i64 with JsonValue, a scalyc union) never
        ; reaches either, so map_type falls back to the s114 { ptr } placeholder
        ; — the caller sizes the sret/arg slot at 8 bytes while the callee
        ; (in the dependency's object) writes the real (larger) struct, smashing
        ; the stack. Ensuring both kinds here makes map_type emit the real type
        ; so the by-value ABI matches across the package boundary. Dispatch is by
        ; trying both helpers; each is a guarded no-op when the named concept is
        ; not its kind / already instantiated / opaque / generic. Fixed-point-
        ; safe for the same reason as the two underlying helpers: scaly/scalyc/
        ; main pass no unplanned cross-package types by value (every in-package
        ; type is already registered → no-op).
        function ensure_type_layout(this: Planner, t: PlannedType)
            this.ensure_layout_by_name(t.name)

        ; By-name twin of ensure_type_layout#: lay out whichever kind (struct
        ; or union) the named concept is. Each underlying helper is a guarded
        ; no-op when the concept is not its kind / already instantiated / opaque
        ; / generic / unknown (primitives, pointer, ref). Both helpers RECURSE
        ; into the type's by-value constituents (see their bodies), so this also
        ; lays out the whole by-value subgraph reachable from `name`.
        function ensure_layout_by_name(this: Planner, name: String)
        {
            if name.get_length() = 0
                return
            this.ensure_member_layout(name)
            this.ensure_union_layout(name)
        }

        ; plan_global: Model.Global → Plan.PlannedGlobal.
        ; The `name` comes from the enclosing Concept — Global itself has
        ; no name field.
        function plan_global(this: Planner, g: Global, name: String) returns PlannedGlobal
        {
            let planned_type this.plan_type(g.type)
            let planned_value this.plan_operands(g.value)
            var value_holder Vector[PlannedOperand](planned_value)
            ; Module-level mutable globals (stack_head etc.) keep their bare
            ; name as the LLVM symbol, matching stage-0 (@stack_head). Const
            ; defines stay Itanium-length-prefixed via encode_name (s189).
            var mangled Planner.encode_name(name)
            if g.is_mutable
                set mangled: String(name)
            let result PlannedGlobal(
                g.span,
                String(name),
                mangled,
                planned_type,
                &value_holder,
                g.is_mutable
            )
            this.record_global(result)
            result
        }

        ; plan_namespace: Model.Namespace → Plan.PlannedNamespace.
        ; Dispatches each Member to the appropriate plan_* method and
        ; collects the results into the per-kind vectors the planned
        ; representation expects.
        ;
        ; Pushes the namespace onto the current-namespace context so
        ; nested plan_function / plan_operator calls pick up the
        ; namespace as their mangling parent (Itanium
        ; `_ZN<NSName><FnName>E…`) and so is_namespace_sibling_function
        ; can resolve unqualified intra-namespace calls. The old
        ; context is restored before returning, giving nested
        ; namespaces correct save/restore semantics.
        function plan_namespace(this: Planner, ns: Namespace, name: String) returns PlannedNamespace
        {
            ; Build the parent PlannedType that tags every Function /
            ; Operator inside this namespace for mangling. Name alone
            ; drives the Itanium segment; encode_type length-prefixes
            ; it to emit `_ZN<NSName><FnName>E…`.
            let ns_mangled Planner.encode_name(name)
            let parent_ref PlannedType^this(
                ns.span,
                String^this(name),
                ns_mangled,
                null,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )

            ; Save outer context and activate this namespace.
            let old_ns this.current_namespace
            let old_ns_name this.current_namespace_name
            set current_namespace: &ns
            var name_box Vector[String](1)
            name_box.put(0, name)
            set current_namespace_name: name_box.get(0)

            var functions Array[PlannedFunction]()
            var operators Array[PlannedOperator]()
            var concepts Array[PlannedConcept]()

            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get i
                if m_ptr <> null
                {
                    let m (*m_ptr)
                    choose m
                        when f: Function
                        {
                            functions.add(this.plan_function(f, parent_ref))
                            0
                        }
                        when o: Operator
                        {
                            operators.add(this.plan_operator(o, parent_ref))
                            0
                        }
                        when c: Concept
                        {
                            concepts.add(this.plan_concept(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            ; Walk loaded sub-modules from `define ns { module foo }`
            ; so their concepts/functions get planned (and recorded
            ; into instantiated_functions for emission). Side effect
            ; only — return value of plan_module# is intentionally
            ; discarded (mirrors session 43's plan_loaded_packages#).
            ; Mixing the struct-by-value return into plan_namespace#'s
            ; own struct construction corrupts the frame on stage-0
            ; codegen; the helper isolates the call.
            this.plan_namespace_modules(ns)

            ; Restore outer namespace context.
            set current_namespace: old_ns
            set current_namespace_name: old_ns_name

            var funcs_holder Vector[PlannedFunction](functions)
            var ops_holder Vector[PlannedOperator](operators)
            var concs_holder Vector[PlannedConcept](concepts)

            PlannedNamespace(
                ns.span,
                String(name),
                ns_mangled,
                null,
                &funcs_holder,
                &ops_holder,
                &concs_holder
            )
        }

        ; plan_namespace_module_one#: walk EVERY sub-module of the
        ; namespace being compiled (the former hand-maintained name
        ; allowlist is GONE — commit 0c4791f4). Only the COMPILATION
        ; ROOT package's namespace modules reach here (loaded dependency
        ; packages are registered but never walked), so this emits
        ; exactly the current package's bodies.
        ;
        ; A bare `plan_module(sub)` call (no `equals("X") = false`
        ; negation) avoids the stage-0 codegen SEGV that originally
        ; motivated the positive-enumeration allowlist.
        function plan_namespace_module_one(rp, this: Planner, sub: Module)
        {
            ; Walk EVERY sub-module of the namespace being compiled.
            ; Only the COMPILATION ROOT package's namespace modules reach
            ; here (loaded dependency packages are registered but never
            ; walked — plan_loaded_packages# is intentionally not called),
            ; so this emits exactly the current package's bodies: scaly's
            ; for scaly.scaly, scalyc's for scalyc.scaly, scalyls's for
            ; scalyls.scaly. Replaces the former hand-maintained name
            ; allowlist (every reachable scaly/scalyc module was already on
            ; it, so this is emission-identical for the compiler) and lets
            ; the scalyls package self-host without naming its modules in
            ; the compiler. A bare call (no `equals("X") = false` negation)
            ; avoids the stage-0 codegen SEGV that motivated the allowlist.
            ; Bare non-last statement call: the result is intentionally
            ; discarded (only the `this`-registering side effects matter),
            ; so promote_discarded_pagecall routes the page arg to rp —
            ; exactly what the former `let planned this.plan_module#(sub)`
            ; sigil provided. The registrations plan_module makes on that
            ; page persist in `this`; a local page here would dangle them.
            this.plan_module(sub)
            ; Layout-only fallback: after the walk (or when a struct was
            ; already cached), register layouts for any concrete
            ; (parameterless) Structures it defines. has_instantiated_structure
            ; in register_struct_layouts_in_concept# guards against
            ; duplicate entries. This makes cross-module struct types
            ; (e.g. EmitterConfig referenced from cli.scaly) map_type-
            ; resolvable without walking the module's method bodies.
            this.register_struct_layouts_in_module(sub)
        }

        ; Helper for plan_namespace#: walk ns.modules and route each
        ; through plan_namespace_module_one# (which walks the module's
        ; bodies). Side effect only — plan_module# returns
        ; a struct-by-value PlannedModule that's intentionally
        ; discarded inside the inner helper. Mixing that struct
        ; return into plan_namespace#'s own struct construction
        ; corrupts the frame on stage-0 codegen (session-43 pattern);
        ; the helper isolates the call.
        function plan_namespace_modules(rp, this: Planner, ns: Namespace)
        {
            var mi: size_t 0
            while mi < ns.modules.length
            {
                let sub_ptr ns.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.plan_namespace_module_one(sub)
                }
                set mi: mi + 1
            }
        }

        ; has_this_method: true when `this` is in scope and its struct/
        ; union type declares a method named `name`. Detects unqualified
        ; implicit-this sibling METHOD calls in BINDING position
        ; (`let p get x` inside a method) so s135 doesn't mis-peel the
        ; method name as a type. A FIELD named `name` is not a method, so
        ; this stays false for casts like `data as pointer[u8]`.
        function has_this_method(this: Planner, name: String) returns bool
        {
            let this_ref this.lookup_local("this")
            if this_ref = null
                return false
            let this_ty (*this_ref)
            var struct_name String(this_ty.name)
            if this_ty.generics <> null
            {
                var is_ptr_like: bool false
                if this_ty.name.equals("pointer")
                    set is_ptr_like: true
                if this_ty.name.equals("ref")
                    set is_ptr_like: true
                if is_ptr_like
                {
                    let gens (*this_ty.generics)
                    if gens.length > 0
                    {
                        let inner_ptr gens.get 0
                        if inner_ptr <> null
                            set struct_name: String((*inner_ptr).name)
                    }
                }
            }
            let methods this.lookup_methods(struct_name, name)
            methods.length > 0
        }

        ; is_namespace_sibling_function: true iff `name` refers to a
        ; Function defined directly in the currently-active
        ; namespace's members list. Used to decide whether an
        ; unqualified call inside a namespace body should route to
        ; the namespace-scoped peer or fall back to the global
        ; registry. Returns false whenever no namespace is active.
        function is_namespace_sibling_function(this: Planner, name: String) returns bool
        {
            if current_namespace = null
                return false

            let ns (*current_namespace)
            var i: size_t 0
            while i < ns.members.length
            {
                let m_ptr ns.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            if f.name.equals(name)
                                return true
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }
            false
        }

        ; register_concept_recursive: register `c` and, if its Definition
        ; is a Namespace, recurse into the namespace's members so inner
        ; Concepts / Functions / Operators are all visible by
        ; unqualified name during later planning.
        function register_concept_recursive(this: Planner, c: Concept)
        {
            this.register_concept(c)
            ; Use-visibility stage 1: members registered while descending
            ; into this concept carry a container path extended by the
            ; concept's own name ("scalyc.compiler.Modeler" + ".Modeler"
            ; for the inner namespace). Saved/restored around the choose.
            let saved_reg_path this.registering_path
            let inner_reg_path this.extend_dotted_path(saved_reg_path, c.name)
            choose c.definition
                when ns: Namespace
                {
                    set this.registering_path: String^this(inner_reg_path)
                    var i: size_t 0
                    while i < ns.members.length
                    {
                        let m_ptr ns.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                when f: Function
                                {
                                    this.register_function(f)
                                    0
                                }
                                when o: Operator
                                {
                                    this.register_operator(o)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }

                    ; Sub-modules of a namespace (`define ns { module foo }`)
                    ; flatten just like top-level `module foo` decls so
                    ; nested function names resolve under the namespace
                    ; via short-name fallback in collapse_operand_sequence#.
                    var mi: size_t 0
                    while mi < ns.modules.length
                    {
                        let sub_ptr ns.modules.get mi
                        if sub_ptr <> null
                        {
                            let sub (*sub_ptr)
                            this.register_module_concepts(sub)
                        }
                        set mi: mi + 1
                    }
                    set this.registering_path: saved_reg_path
                    0
                }
                when s: Structure
                {
                    ; Nested concepts inside a struct's members block
                    ; register under their own name. This lets
                    ; `struct Outer { struct Inner { ... } }` resolve
                    ; `Inner` by its short name.
                    set this.registering_path: String^this(inner_reg_path)
                    var i: size_t 0
                    while i < s.members.length
                    {
                        let m_ptr s.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    set this.registering_path: saved_reg_path
                    0
                }
                when u: scalyc.compiler.Model.Union
                {
                    set this.registering_path: String^this(inner_reg_path)
                    var i: size_t 0
                    while i < u.members.length
                    {
                        let m_ptr u.members.get i
                        if m_ptr <> null
                        {
                            let mem (*m_ptr)
                            choose mem
                                when inner: Concept
                                {
                                    this.register_concept_recursive(inner)
                                    0
                                }
                                else
                                    0
                        }
                        set i: i + 1
                    }
                    set this.registering_path: saved_reg_path
                    0
                }
                else
                    0
        }

        ; register_module_concepts: walk a Model.Module's members and
        ; register every Concept, Function and Operator in the relevant
        ; registry. Done as a first pass so forward references work
        ; (A referencing B below, or main() calling helper() declared
        ; later in the file). Recurses into sub-modules and into
        ; namespace-shaped concepts so deeply nested definitions are
        ; reachable by their short name.
        function register_module_concepts(this: Planner, m: Module)
        {
            ; Use-visibility stage 1: switch the registration context so
            ; register_concept records each concept's origin, then record
            ; this module's use clauses (dedup'd by file). Saved and
            ; restored at the single exit below (same shape as
            ; plan_module's saved_file dance). A walk starting with an
            ; EMPTY inherited prefix may be a mid-tree re-walk
            ; (plan_module(sub)) — restore the anchored path recorded at
            ; this file's first walk.
            let saved_reg_file this.registering_file
            let saved_reg_path this.registering_path
            if m.file.get_length() > 0
            {
                let new_reg_file String^this(m.file)
                set this.registering_file: new_reg_file
            }
            var new_reg_path this.extend_dotted_path(saved_reg_path, m.name)
            if saved_reg_path.get_length() = 0
            {
                let known this.use_vis_lookup_file_path(m.file)
                if known.get_length() > 0
                    set new_reg_path: String^this(known)
            }
            set this.registering_path: String^this(new_reg_path)
            this.record_module_uses m

            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when c: Concept
                        {
                            this.register_concept_recursive(c)
                            0
                        }
                        when f: Function
                        {
                            this.register_function(f)
                            0
                        }
                        when o: Operator
                        {
                            this.register_operator(o)
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    this.register_module_concepts(sub)
                }
                set mi: mi + 1
            }

            set this.registering_file: saved_reg_file
            set this.registering_path: saved_reg_path
        }

        ; plan_module: Model.Module → Plan.PlannedModule.
        ;
        ; Two-pass: first register every concept reachable through this
        ; module's tree, then plan sub-modules and members. This makes
        ; forward references resolve — `struct A { b: B }` works even
        ; when B is defined later in the same module.
        function plan_module(this: Planner, m: Module) returns PlannedModule
        {
            ; Track the current source file for diagnostics (mirrors stage-0
            ; planModule: `OldFile = File; if (!Mod.File.empty()) File = Mod.File`).
            ; Sub-modules live in their own files; without this every escape /
            ; hard diagnostic from a sub-module is formatted against the entry
            ; file and reports a bogus line. Restored at the single return below.
            let saved_file this.file
            if m.file.get_length() > 0
                set this.file: String^this(m.file)

            ; Propagate this module's Use clauses into program_use_aliases
            ; so the dotted-call extern-decl gate fires for prefixes
            ; imported from sub-modules (e.g. cli.scaly's `use scaly.io.Console`
            ; → "Console") in addition to the main program's own uses.
            ; Without this, calls like `Console.println(...)` inside cli.run
            ; resolve at planning time but never reach the gate, so no
            ; extern declaration is emitted and emit_call returns null
            ; → empty function bodies.
            ;
            ; ModuleStack scoping (mirrors stage-0's push/pop): record this
            ; module's aliases here, then TRUNCATE them back at the single
            ; return below. The two arrays grow in lockstep, so saving one
            ; length suffices for both. Because plan_module# plans sub-modules
            ; and then this module's members BEFORE returning, a nested module
            ; and this module's own bodies see this module's + ancestors' uses;
            ; a SIBLING module planned later does NOT (its frame was popped) —
            ; without this a sibling's `use ns.foo` bled globally and mis-mangled
            ; an unrelated bare `foo(...)` in another module as `_ZN2ns3fooE…`.
            let saved_use_aliases_len program_use_aliases.length
            var uu: size_t 0
            while uu < m.uses.length
            {
                let u_ptr m.uses.get uu
                if u_ptr <> null
                {
                    let path u_ptr.path
                    if path.length > 0
                    {
                        let last_ptr path.get(path.length - 1)
                        if last_ptr <> null
                            program_use_aliases.add((*last_ptr))
                        var ns_name ""
                        if path.length > 1
                        {
                            let ns_ptr path.get(path.length - 2)
                            if ns_ptr <> null
                                set ns_name: String^this((*ns_ptr))
                        }
                        program_use_namespaces.add ns_name
                    }
                }
                set uu: uu + 1
            }

            this.register_module_concepts(m)

            ; Build the transitive page-need set once, after the first (top-
            ; level) module's whole tree is registered (siblings were seeded
            ; before plan_module). The set names the escape-machinery
            ; dispatchers that forward rp to a void ^rp storer; consulted by
            ; function_needs_caller_page so they keep a page even after the
            ; explicit `#`/rp is removed from their declaration.
            if transitive_page_built = false
            {
                this.build_transitive_page_set()
                set transitive_page_built: true
            }

            var functions Array[PlannedFunction]()
            var operators Array[PlannedOperator]()
            var pl_concepts Array[PlannedConcept]()
            var sub_modules Array[PlannedModule]()

            var mi: size_t 0
            while mi < m.modules.length
            {
                let sub_ptr m.modules.get mi
                if sub_ptr <> null
                {
                    let sub (*sub_ptr)
                    sub_modules.add(this.plan_module(sub))
                }
                set mi: mi + 1
            }

            var i: size_t 0
            while i < m.members.length
            {
                let m_ptr m.members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            functions.add(this.plan_function(f, null))
                            0
                        }
                        when o: Operator
                        {
                            let po this.plan_operator(o, null)
                            operators.add po
                            ; A free (top-level) operator needs a real
                            ; emitted body. emit() walks instantiated_functions
                            ; only; struct operators reach it via call-site
                            ; resolution, but a free operator is planned here
                            ; and would otherwise never be recorded — the call
                            ; site (resolve_operator_call#) emits a reference to
                            ; its OPERATOR-mangled name, so the body must be
                            ; emitted under that same name. Record an
                            ; Action-bodied free operator as a PlannedFunction
                            ; carrying po.mangled_name. Extern/Intrinsic/
                            ; Instruction operators have no Scaly body to emit.
                            var op_has_body: bool false
                            choose o.implementation
                                when oa: Action
                                    set op_has_body: true
                                else
                                    0
                            if op_has_body
                            {
                                let synth_fn Function(
                                    o.span,
                                    o.private_,
                                    true,
                                    o.name,
                                    o.parameters,
                                    null,
                                    o.input,
                                    o.returns_,
                                    o.throws_,
                                    Lifetime.Unspecified(Unspecified()),
                                    o.implementation
                                )
                                var op_page_param: ref[String]? null
                                if Planner.needs_implicit_return_page(synth_fn)
                                {
                                    var pp_holder Vector[String](1)
                                    pp_holder.put(0, "rp")
                                    set op_page_param: pp_holder.get(0)
                                }
                                var op_can_throw: bool false
                                if po.throws_type <> null
                                    set op_can_throw: true
                                this.record_function(PlannedFunction(
                                    po.loc,
                                    po.is_private,
                                    true,
                                    po.name,
                                    po.mangled_name,
                                    op_page_param,
                                    po.input,
                                    po.return_type,
                                    po.throws_type,
                                    Lifetime.Unspecified(Unspecified()),
                                    po.impl,
                                    null,
                                    false,
                                    op_can_throw,
                                    null,
                                    this.file
                                ))
                            }
                            0
                        }
                        when c: Concept
                        {
                            pl_concepts.add(this.plan_concept(c))
                            0
                        }
                        else
                            0
                }
                set i: i + 1
            }

            var mods_holder Vector[PlannedModule](sub_modules)
            var concs_holder Vector[PlannedConcept](pl_concepts)
            var funcs_holder Vector[PlannedFunction](functions)
            var ops_holder Vector[PlannedOperator](operators)

            set this.file: saved_file
            ; Pop this module's Use aliases off the stack (see the save above).
            set program_use_aliases.length: saved_use_aliases_len
            set program_use_namespaces.length: saved_use_aliases_len

            PlannedModule(
                m.file,
                m.name,
                &mods_holder,
                &concs_holder,
                &funcs_holder,
                &ops_holder
            )
        }

        ; plan_concept: wrap a Model.Concept (definition + generics) into
        ; PlannedConcept. Generic parameters are not instantiated here —
        ; that's the job of the separate instantiate-generic pass (TODO).
        ; For now we just drop the parameters on the floor and plan the
        ; underlying definition as-is.
        ;
        ; Intrinsic concepts (built-in types) are represented by a Type
        ; variant carrying a void placeholder until a proper Intrinsic
        ; variant is added to PlannedDefinition.
        function plan_concept(this: Planner, c: Concept) returns PlannedConcept
        {
            ; s107: generic data-class concepts (Structure with no
            ; members/initializers) defer body planning to
            ; instantiate_generic# at use sites. Pre-planning the
            ; unspecialised template here would record a struct named
            ; the same as every later instance (Box, etc.) — and
            ; emit_struct_type's name-keyed cache short-circuits the
            ; second emission, leaving %_Z3BoxIiE undefined while a
            ; ptr-typed property over the unbound `T` reaches map_type
            ; and gets lowered to opaque pointer, breaking field
            ; alignment. Mirrors stage-0 Planner.cpp:1613,1953,2131
            ; which only call planConcept when Parameters.empty().
            ; Stdlib generics (Vector etc.) have members/initializers
            ; and fall through to plan_structure# as before — the s107
            ; plan_type# if mirrors this same data-class restriction.
            let pl_def choose c.definition
                when s: Structure
                {
                    var skip: bool false
                    if c.parameters.length > 0
                        if s.members.length = 0
                            if s.initializers.length = 0
                                set skip: true
                    if skip
                        return PlannedConcept(
                            c.span,
                            c.name,
                            Planner.encode_name c.name,
                            null,
                            PlannedDefinition.Type(Planner.make_void_type()),
                            null
                        )
                    PlannedDefinition.Structure(this.plan_structure(s, c.name))
                }
                when u: scalyc.compiler.Model.Union
                    PlannedDefinition.Union(this.plan_union(u, c.name))
                when ns: Namespace
                    PlannedDefinition.Namespace(this.plan_namespace(ns, c.name))
                when g: Global
                    PlannedDefinition.Global(this.plan_global(g, c.name))
                when t: Type
                    PlannedDefinition.Type(this.plan_type(t))
                when intr: Intrinsic
                    PlannedDefinition.Type(Planner.make_void_type())

            ; Generic concepts get a simple length-prefixed name; fully
            ; instantiated concepts get the full `_Z<name-len><name>`.
            var mangled: String ""
            if c.parameters.length > 0
                set mangled: Planner.encode_name(c.name)
            if c.parameters.length = 0
                set mangled: Planner.mangle_structure(c.name, null)

            PlannedConcept(
                c.span,
                c.name,
                mangled,
                null,
                pl_def,
                null
            )
        }

        ; s148: byte size of a type referenced by name (variant payload
        ; or struct property). Knows about primitives, stdlib container
        ; shapes (Vector/Array = 16, String/HashMap/HashSet = 8), and
        ; walks registered Concept Structures' property lists when
        ; the name is a struct. Default 8 (matches the catch-all in
        ; get_primitive_alignment for unknown names).
        function compute_payload_size(this: Planner, name: String) returns size_t
        {
            var size: size_t Planner.get_primitive_alignment(name)
            if name.equals("Vector")
                return 16
            if name.equals("Array")
                return 16
            if name.equals("String")
                return 8
            if name.equals("HashMap")
                return 8
            if name.equals("HashSet")
                return 8
            if name.equals("HashMapBuilder")
                return 8
            if name.equals("HashSetBuilder")
                return 8
            let c_ref this.lookup_concept(name)
            if c_ref <> null
            {
                let c (*c_ref)
                choose c.definition
                    when st: Structure
                    {
                        var offset: size_t 0
                        var sa: size_t 1
                        var pi: size_t 0
                        while pi < st.properties.length
                        {
                            let p_ptr st.properties.get pi
                            if p_ptr <> null
                            {
                                let p (*p_ptr)
                                if p.type <> null
                                {
                                    let pt (*p.type)
                                    if pt.name.length > 0
                                    {
                                        let last_p pt.name.get(pt.name.length - 1)
                                        if last_p <> null
                                        {
                                            let pn (*last_p)
                                            let fs this.compute_payload_size(pn)
                                            let fa Planner.get_primitive_alignment(pn)
                                            set offset: Planner.align_offset(offset, fa) + fs
                                            if fa > sa
                                                set sa: fa
                                        }
                                    }
                                }
                            }
                            set pi: pi + 1
                        }
                        let total Planner.align_offset(offset, sa)
                        if total > 0
                            set size: total
                    }
                    when un: scalyc.compiler.Model.Union
                    {
                        ; s161: size a nested UNION field. Without this arm a
                        ; union-typed property (e.g. RoutineSyntax's
                        ; `implementation: ImplementationSyntax`, 24B) fell to
                        ; the get_primitive_alignment default of 8 — so
                        ; compute_payload_size(RoutineSyntax)=72 not 88,
                        ; NamedSyntax=96 not 112, and plan_union# emitted
                        ; TargetSyntax as {i8,[103xi8]}=104 (too small to hold
                        ; its own 112B NamedSyntax variant). build_function#'s
                        ; `load NamedSyntax` from the union payload then read
                        ; past the allocation → garbage routine.parameters →
                        ; SIGSEGV. Mirrors the plan_sizeof# union arm.
                        var max_payload: size_t 0
                        var max_palign: size_t 1
                        var ui: size_t 0
                        while ui < un.variants.length
                        {
                            let uv_ptr un.variants.get ui
                            if uv_ptr <> null
                            {
                                let uv (*uv_ptr)
                                if uv.type <> null
                                {
                                    let uvt (*uv.type)
                                    if uvt.name.length > 0
                                    {
                                        let uvn_ptr uvt.name.get(uvt.name.length - 1)
                                        if uvn_ptr <> null
                                        {
                                            let uvn (*uvn_ptr)
                                            let uvsz this.compute_payload_size(uvn)
                                            let uval Planner.get_primitive_alignment(uvn)
                                            if uvsz > max_payload
                                                set max_payload: uvsz
                                            if uval > max_palign
                                                set max_palign: uval
                                        }
                                    }
                                }
                            }
                            set ui: ui + 1
                        }
                        var u_tag_sz: size_t 1
                        if un.variants.length > 256
                            set u_tag_sz: 4
                        let u_total Planner.align_offset(max_payload + u_tag_sz, max_palign)
                        if u_total > 0
                            set size: u_total
                    }
                    else
                        0
            }
            size
        }

        ; plan_union: Model.Union → Plan.PlannedUnion.
        ; Similar scope to plan_structure: plans variants and computes
        ; size/alignment; skips methods/operators for now.
        function plan_union(this: Planner, u: scalyc.compiler.Model.Union, name: String) returns scalyc.compiler.Plan.PlannedUnion
            this.plan_union_opt(u, name, true)

        ; plan_union_opt#: as plan_union# with a `plan_methods` switch. The
        ; on-demand cross-package path (ensure_union_layout#) passes false:
        ; it needs the variant tags + payload sizing so map_type emits the
        ; real tagged-union type (and choose extracts the payload at the
        ; right offset), but NOT the union's methods/operators — those
        ; belong to the union's own package's object (same reasoning as
        ; plan_structure_layout_opt#).
        function plan_union_opt(this: Planner, u: scalyc.compiler.Model.Union, name: String, plan_methods: bool) returns scalyc.compiler.Plan.PlannedUnion
        {
            var planned_vs Array[PlannedVariant]()
            var tag: int 0
            var i: size_t 0
            while i < u.variants.length
            {
                let v_ptr u.variants.get i
                if v_ptr <> null
                {
                    let v (*v_ptr)
                    planned_vs.add(this.plan_variant(v, tag))
                    set tag: tag + 1
                }
                set i: i + 1
            }

            var vs_holder Vector[PlannedVariant](planned_vs)

            var max_payload_size: size_t 0
            var max_payload_align: size_t 1
            var vi: size_t 0
            while vi < planned_vs.length
            {
                let vp_ptr planned_vs.get vi
                if vp_ptr <> null
                {
                    let vp (*vp_ptr)
                    if vp.var_type <> null
                    {
                        let vt (*vp.var_type)
                        let vsz this.compute_payload_size(vt.name)
                        let val Planner.get_primitive_alignment(vt.name)
                        if vsz > max_payload_size
                            set max_payload_size: vsz
                        if val > max_payload_align
                            set max_payload_align: val
                    }
                }
                set vi: vi + 1
            }
            var tag_sz: size_t 1
            if planned_vs.length > 256
                set tag_sz: 4
            let u_size Planner.align_offset(max_payload_size + tag_sz, max_payload_align)
            let u_align Planner.compute_union_alignment(&vs_holder)

            ; Build the union's own PlannedType + mangled_name upfront
            ; so method planning can mangle methods with this as parent.
            var u_gens_arr Array[PlannedType]()
            let u_concept_ref this.lookup_concept(name)
            if u_concept_ref <> null
            {
                let u_concept (*u_concept_ref)
                var pi: size_t 0
                while pi < u_concept.parameters.length
                {
                    let p_ptr u_concept.parameters.get pi
                    if p_ptr <> null
                    {
                        let ts_ref this.lookup_type_substitution(p_ptr.name)
                        if ts_ref <> null
                            u_gens_arr.add((*ts_ref))
                    }
                    set pi: pi + 1
                }
            }
            var u_gens_holder Vector[PlannedType](u_gens_arr)
            var u_gens_ref: ref[Vector[PlannedType]]? null
            if u_gens_holder.length > 0
                set u_gens_ref: &u_gens_holder
            let u_mangled Planner.mangle_structure(name, u_gens_ref)

            let u_parent_ref PlannedType^this(
                u.span,
                String^this(name),
                u_mangled,
                u_gens_ref,
                Lifetime.Unspecified(Unspecified()),
                null,
                "",
                null
            )

            ; Plan methods and operators declared on the union.
            var planned_methods Array[PlannedFunction]()
            var planned_operators Array[PlannedOperator]()
            if plan_methods
            {
                var mi: size_t 0
                while mi < u.members.length
                {
                    let m_ptr u.members.get mi
                    if m_ptr <> null
                    {
                        let mem (*m_ptr)
                        choose mem
                            when f: Function
                            {
                                planned_methods.add(this.plan_function(f, u_parent_ref))
                                0
                            }
                            when o: Operator
                            {
                                planned_operators.add(this.plan_operator(o, u_parent_ref))
                                0
                            }
                            else
                                0
                    }
                    set mi: mi + 1
                }
            }

            var methods_holder Vector[PlannedFunction](planned_methods)
            var ops_holder Vector[PlannedOperator](planned_operators)

            let result scalyc.compiler.Plan.PlannedUnion(
                u.span,
                u.private_,
                String(name),
                u_mangled,
                &vs_holder,
                &methods_holder,
                &ops_holder,
                u_size,
                u_align,
                null
            )
            this.record_union(result)
            result
        }

        ; plan_program: top-level entry point.
        ;
        ; Walks the Model.Program:
        ;   - plan the main Module (recursively plans sub-modules and
        ;     members)
        ;   - plan top-level statements (executed before main())
        ;
        ; Instantiation caches (structures / unions / functions / globals)
        ; are left null — the per-kind planned data lives inside the
        ; PlannedModule tree for now. The separate caches come online
        ; once the instantiate-generic pass is ported.
        function plan_program(this: Planner, prog: Program) returns ref[Plan]?
        {
            ; Stash the program's main-module Use aliases up front
            ; so the dotted-call extern-decl gate can consult them
            ; while planning loaded-package namespace bodies.
            this.record_program_uses(prog)

            ; Seed the concept/function/operator registries with
            ; every sibling program's top-level definitions first.
            ; This way plan_module's lookups see cross-file
            ; references (main.scaly -> cli.scaly etc.) before it
            ; starts planning the primary module's members.
            this.register_sibling_programs()

            ; NOTE (s176): registering struct layouts for loaded-package
            ; concrete structures here (register_struct_layouts_in_module#
            ; over loaded_packages) fixes map_type's ptr fallback for
            ; StringBuilder but flips String/Page/PageList from ptr to
            ; real struct types throughout, changing ABI decisions in
            ; everything stage-1 emits — stage-2 went to empty modules.
            ; The under-sizing harm is instead contained in
            ; emit_constructor_call's region-size fallback.

            ; plan_loaded_packages# is intentionally NOT called here.
            ; If invoked, it walks each loaded package and records every
            ; top-level Function via plan_function# -> instantiated_functions
            ; -> Emitter emits the function body. For functions whose
            ; bodies stage-1 cannot fully plan (every dotted call inside
            ; the body collapses to nothing because the gate / lookup
            ; doesn't fire), this produces ret-stub definitions that
            ; collide with the real bodies in libscaly.a / libscalyc.a
            ; at link time ("duplicate symbol _ZN5scaly4testEv").
            ; Skipping the walk lets the dotted-call extern-decl gate
            ; emit declarations only, with libscaly/libscalyc providing
            ; the bodies at link time. Functions still resolve at
            ; planning time via register_module_concepts (called by
            ; cli.run::register_packages).

            let planned_main this.plan_module(prog.module_)
            let planned_stmts this.plan_statements(prog.statements)

            ; Hard-fail on any glob import collision (two `use a.*`/`use b.*`
            ; supplying the same concept name into one file). Registration
            ; and the use tables are complete by here.
            this.check_glob_ambiguities()

            ; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
            ; Runs once instantiated_functions is fully populated; appends a
            ; hard diagnostic (failed at cli.run) on a detected escape.
            this.check_interprocedural_escapes()

            var stmts_holder Vector[PlannedStatement](planned_stmts)
            var structs_holder Vector[PlannedStructure](instantiated_structures)
            var unions_holder Vector[scalyc.compiler.Plan.PlannedUnion](instantiated_unions)
            var funcs_holder Vector[PlannedFunction](instantiated_functions)
            var globals_holder Vector[PlannedGlobal](instantiated_globals)
            var delegates_holder Vector[String](delegate_names)
            var constraints_holder Vector[TypeConstraint](constraints)

            Plan(
                planned_main,
                &stmts_holder,
                &structs_holder,
                &unions_holder,
                &funcs_holder,
                &globals_holder,
                &delegates_holder,
                next_type_var_id,
                &constraints_holder
            )
        }

        ; Collect every Function member of a concept (struct/union) into acc.
        ; Mirrors collect_methods_in# but takes no name filter.
        function gather_member_functions(this: Planner, members: Vector[Member], acc: Array[Function])
        {
            var i: size_t 0
            while i < members.length
            {
                let mp members.get i
                if mp <> null
                    choose (*mp)
                        when f: Function
                        {
                            acc.add f
                            0
                        }
                        else
                            0
                set i: i + 1
            }
        }

        ; build_transitive_page_set: compute, by a fixpoint over the call graph,
        ; the set of functions that need the caller's page ONLY because they
        ; forward rp to a sibling that needs one. SEED = void functions that
        ; directly build a ^rp value (the persistent storers add_escaping_* and
        ; the collect_*/promote_* leaves). PROPAGATE = any function whose own
        ; page-need is NOT already implied by its return type / ref-param
        ; storage / own ^rp, but whose body CALLS a function already in the set,
        ; needs one too (it threads rp down). The direct-checks gate keeps the
        ; already-page-bearing planning spine out of the set, bounding it to the
        ; void dispatcher cluster. NEUTRAL on the sigiled source: every function
        ; added is still `#` there (it forwards rp today), so has_page is
        ; unchanged; the set only matters once the explicit `#`/rp is removed.
        function build_transitive_page_set(this: Planner)
        {
            var all Array[Function]()
            var fi: size_t 0
            while fi < model_functions.length
            {
                let kvp model_functions.get fi
                if kvp <> null
                    all.add((*kvp).value)
                set fi: fi + 1
            }
            var cdi: size_t 0
            while cdi < concepts.length
            {
                let cp concepts.get cdi
                if cp <> null
                {
                    let c (*cp).value
                    choose c.definition
                        when s: Structure
                        {
                            this.gather_member_functions(s.members, all)
                            0
                        }
                        when u: scalyc.compiler.Model.Union
                        {
                            this.gather_member_functions(u.members, all)
                            0
                        }
                        else
                            0
                }
                set cdi: cdi + 1
            }

            ; Seed: void ^rp storers.
            var si: size_t 0
            while si < all.length
            {
                let fp all.get si
                if fp <> null
                {
                    let f (*fp)
                    if f.returns_ = null
                        if Planner.body_references_rp(f)
                            if this.array_contains_name(transitive_page_names, f.name) = false
                                transitive_page_names.add(String^this(f.name))
                }
                set si: si + 1
            }

            ; Fixpoint propagation up the call graph.
            var grew: bool true
            while grew
            {
                set grew: false
                var ii: size_t 0
                while ii < all.length
                {
                    let fp all.get ii
                    if fp <> null
                    {
                        let f (*fp)
                        if this.array_contains_name(transitive_page_names, f.name) = false
                        {
                            var direct: bool false
                            if Planner.needs_implicit_return_page(f)
                                set direct: true
                            if Planner.proc_needs_caller_page_for_storage(f)
                                set direct: true
                            if Planner.body_references_rp(f)
                                set direct: true
                            if direct = false
                                if Planner.impl_mentions_set(f.implementation, transitive_page_names)
                                {
                                    transitive_page_names.add(String^this(f.name))
                                    set grew: true
                                }
                        }
                    }
                    set ii: ii + 1
                }
            }
        }
    }

    ; ========================================================================
    ; Itanium ABI name encoding helpers.
    ; These are the smallest independent units of Planner.cpp; worth
    ; porting in full so Planner.test() can exercise them end-to-end.
    ; ========================================================================

    ; encode_name: "foo" -> "3foo" (length prefix + raw name)
    function encode_name(name: String) returns String
    {
        let len name.length
        let len_str size_to_string len
        let result StringBuilder()
        result.append len_str
        result.append name
        result.to_string()
    }

    ; strip_package_prefix: "scaly.containers.String" -> "String".
    ; Matches stripPackagePrefix in Planner.cpp: only strips when the full
    ; name begins with "scaly.". Anything else (e.g. "scalyc.compiler.Foo")
    ; is returned unchanged so user types keep their qualified identity.
    function strip_package_prefix(name: String) returns String
    {
        if name.starts_with("scaly.") = false
            return String(name)

        let last_dot name.last_index_of("." as u8)
        if last_dot < 0
            return String(name)

        let start (last_dot as size_t) + 1
        let len name.get_length() - start
        name.substring(start, len)
    }

    ; encode_type: Itanium ABI type code.
    ;
    ; Recurses for pointer[T], ref[T] and generic instantiations. The
    ; optimized "use pre-computed mangled_name" shortcut from the C++
    ; implementation is deliberately omitted here — every PlannedType we
    ; construct from scratch will end up with an empty mangled_name, and
    ; the shortcut only saves work in a later pass we do not implement yet.
    function encode_type(type_value: PlannedType) returns String
    {
        ; Built-in primitive types.
        if type_value.name.equals("void")
            return "v"
        if type_value.name.equals("bool")
            return "b"
        if type_value.name.equals("char")
            return "c"
        if type_value.name.equals("int")
            return "i"
        if type_value.name.equals("uint")
            return "j"
        if type_value.name.equals("long")
            return "l"
        if type_value.name.equals("ulong")
            return "m"
        if type_value.name.equals("float")
            return "f"
        if type_value.name.equals("double")
            return "d"
        if type_value.name.equals("size")
            return "m"
        if type_value.name.equals("size_t")
            return "m"

        ; pointer[T] -> "P" + encode_type(T)
        if type_value.name.equals("pointer")
        {
            if type_value.generics <> null
            {
                let gens (*type_value.generics)
                if gens.length = 1
                {
                    let arg_ptr gens.get 0
                    if arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let inner Planner.encode_type(arg)
                        var sb StringBuilder()
                        sb.append("P" as char)
                        sb.append inner
                        return sb.to_string()
                    }
                }
            }
        }

        ; ref[T] -> "R" + encode_type(T)   (non-owning reference)
        if type_value.name.equals("ref")
        {
            if type_value.generics <> null
            {
                let gens (*type_value.generics)
                if gens.length = 1
                {
                    let arg_ptr gens.get 0
                    if arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let inner Planner.encode_type(arg)
                        var sb StringBuilder()
                        sb.append("R" as char)
                        sb.append inner
                        return sb.to_string()
                    }
                }
            }
        }

        ; Generic instantiation: Name + "I" + args + "E".
        ; Strip any "Base.arg" instantiation suffix so we encode the template name.
        if type_value.generics <> null
        {
            let gens (*type_value.generics)
            if gens.length > 0
            {
                let dot_pos type_value.name.index_of("." as u8)
                var base_name: String type_value.name
                if dot_pos >= 0
                    set base_name: type_value.name.substring(0, dot_pos as size_t)

                var sb StringBuilder()
                sb.append(Planner.encode_name base_name)
                sb.append("I" as char)
                var i: size_t 0
                while i < gens.length
                {
                    let arg_ptr gens.get i
                    if arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let enc Planner.encode_type(arg)
                        sb.append enc
                    }
                    set i: i + 1
                }
                sb.append("E" as char)
                return sb.to_string()
            }
        }

        ; User-defined type: length-prefixed, with "scaly.*" stripped.
        let normalized Planner.strip_package_prefix(type_value.name)
        Planner.encode_name normalized
    }

    ; mangle_type: "_Z" + encode_type(T). The "_Z" prefix marks this as a
    ; (fake) C++-compatible Itanium symbol so external tools like c++filt
    ; can demangle our names for humans.
    function mangle_type(type_value: PlannedType) returns String
    {
        let encoded Planner.encode_type(type_value)
        var sb StringBuilder()
        sb.append "_Z"
        sb.append encoded
        sb.to_string()
    }

    ; mangle_structure: "_Z" + name-with-length-prefix + optional "I...E" generic block.
    ; Used for symbol-mangling concrete struct / union / trait definitions.
    function mangle_structure(name: String, generic_args: ref[Vector[PlannedType]]?) returns String
    {
        if generic_args <> null
        {
            let args (*generic_args)
            if args.length > 0
            {
                var sb StringBuilder()
                sb.append "_Z"
                sb.append(Planner.encode_name name)
                sb.append "I"
                var i: size_t 0
                while i < args.length
                {
                    let arg_ptr args.get i
                    if arg_ptr <> null
                    {
                        let arg (*arg_ptr)
                        let enc Planner.encode_type(arg)
                        sb.append enc
                    }
                    set i: i + 1
                }
                sb.append "E"
                return sb.to_string()
            }
        }

        var sb StringBuilder()
        sb.append "_Z"
        sb.append(Planner.encode_name name)
        sb.to_string()
    }

    ; mangle_function: Itanium symbol for a function / method.
    ;
    ;   free function   -> _Z + encode_name + params
    ;   method          -> _Z + "N" + encode_type(parent) + encode_name + "E" + params
    ;
    ; A 'this' parameter (implicit receiver) is skipped in the mangled
    ; name — Itanium treats it as implicit. If has_page_param is set the
    ; implicit page parameter (`pointer[Page]`) is encoded first; this is
    ; how "function foo#" lowers on the ABI side.
    function mangle_function(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?,
        has_page_param: bool
    ) returns String
    {
        var sb StringBuilder()
        sb.append "_Z"

        if parent <> null
        {
            let p (*parent)
            sb.append "N"
            sb.append(Planner.encode_type(p))
            ; Itanium ABI: methods named "init" on a struct are constructors;
            ; emit C1 (complete-object ctor) instead of "<len>init". Mirrors
            ; stage-0 Planner.cpp:12100-12103. Required so constructor call-
            ; sites and the def-site (plan_initializer) agree on the symbol
            ; (`_ZN<T>C1E<args>`) which libscaly.a exports from stage-0.
            if name.equals("init")
                sb.append "C1"
            if name.equals("init") = false
                sb.append(Planner.encode_name name)
            sb.append "E"
        }
        if parent = null
            sb.append(Planner.encode_name name)

        var has_explicit_params: bool false

        ; Implicit page parameter for `function foo#(…)` lowerings.
        ; Hard-coded mangling matches scaly::memory::Page in the C++ impl.
        if has_page_param
        {
            sb.append "PN4scaly6memory4PageE"
            set has_explicit_params: true
        }

        if params <> null
        {
            let ps (*params)
            var i: size_t 0
            while i < ps.length
            {
                let param_ptr ps.get i
                if param_ptr <> null
                {
                    let param (*param_ptr)
                    var is_this: bool false
                    if param.name <> null
                    {
                        let pname (*param.name)
                        set is_this: pname.equals("this")
                    }
                    if is_this = false
                    {
                        if param.item_type <> null
                        {
                            let pty (*param.item_type)
                            sb.append(Planner.encode_type(pty))
                            set has_explicit_params: true
                        }
                    }
                }
                set i: i + 1
            }
        }

        if has_explicit_params = false
            sb.append "v"

        sb.to_string()
    }

    ; mangle_free_function_from_types: build a free-function Itanium
    ; symbol directly from PlannedTypes, skipping the PlannedItem
    ; ceremony mangle_function requires. Shape matches mangle_function
    ; with parent=null.
    function mangle_free_function_from_types(
        name: String,
        params: Vector[PlannedType],
        has_page_param: bool
    ) returns String
    {
        var sb StringBuilder()
        sb.append "_Z"
        sb.append(Planner.encode_name name)

        var has_explicit: bool false
        if has_page_param
        {
            sb.append "PN4scaly6memory4PageE"
            set has_explicit: true
        }

        var i: size_t 0
        while i < params.length
        {
            let p_ptr params.get i
            if p_ptr <> null
            {
                let p (*p_ptr)
                sb.append(Planner.encode_type(p))
                set has_explicit: true
            }
            set i: i + 1
        }

        if has_explicit = false
            sb.append "v"

        sb.to_string()
    }

    ; operator_code: map a Scaly operator name to its Itanium ABI two-letter
    ; code. Unknown operators fall back to the `v0` vendor extension,
    ; followed by the length-prefixed operator identifier.
    function operator_code(name: String) returns String
    {
        if name.equals("+")
            return "pl"
        if name.equals("-")
            return "mi"
        if name.equals("*")
            return "ml"
        if name.equals("/")
            return "dv"
        if name.equals("%")
            return "rm"
        if name.equals("==")
            return "eq"
        if name.equals("!=")
            return "ne"
        if name.equals("<")
            return "lt"
        if name.equals(">")
            return "gt"
        if name.equals("<=")
            return "le"
        if name.equals(">=")
            return "ge"
        if name.equals("&&")
            return "aa"
        if name.equals("and")
            return "aa"
        if name.equals("||")
            return "oo"
        if name.equals("or")
            return "oo"
        if name.equals("!")
            return "nt"
        if name.equals("not")
            return "nt"
        if name.equals("&")
            return "an"
        if name.equals("|")
            return "or"
        if name.equals("^")
            return "eo"
        if name.equals("~")
            return "co"
        if name.equals("<<")
            return "ls"
        if name.equals(">>")
            return "rs"
        if name.equals("[]")
            return "ix"
        if name.equals("()")
            return "cl"

        ; Vendor extension for operators without a dedicated code.
        var sb StringBuilder()
        sb.append "v0"
        sb.append(Planner.encode_name name)
        sb.to_string()
    }

    ; mangle_operator: Itanium ABI symbol for an operator definition.
    ; Mirrors mangle_function but substitutes the two-letter op code for
    ; the operator name and skips an explicit 'this' parameter when the
    ; operator is declared as a member.
    function mangle_operator(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?
    ) returns String
    {
        let op_code Planner.operator_code(name)
        var sb StringBuilder()
        sb.append "_Z"

        if parent <> null
        {
            let p (*parent)
            sb.append "N"
            sb.append(Planner.encode_type(p))
            sb.append op_code
            sb.append "E"
        }
        if parent = null
            sb.append op_code

        ; Skip 'this' on member operators (param[0] with name "this").
        var start_idx: size_t 0
        if parent <> null
        {
            if params <> null
            {
                let ps (*params)
                if ps.length > 0
                {
                    let first_ptr ps.get 0
                    if first_ptr <> null
                    {
                        let first (*first_ptr)
                        if first.name <> null
                        {
                            let pname (*first.name)
                            if pname.equals("this")
                                set start_idx: 1
                        }
                    }
                }
            }
        }

        var has_params: bool false
        if params <> null
        {
            let ps (*params)
            var i: size_t start_idx
            while i < ps.length
            {
                let param_ptr ps.get i
                if param_ptr <> null
                {
                    let param (*param_ptr)
                    if param.item_type <> null
                    {
                        let pty (*param.item_type)
                        sb.append(Planner.encode_type(pty))
                        set has_params: true
                    }
                }
                set i: i + 1
            }
        }

        if has_params = false
            sb.append "v"

        sb.to_string()
    }

    ; mangle_operator_paged: mangle_operator plus the implicit caller-page
    ; parameter slot (PN4scaly6memory4PageE inserted before the explicit
    ; params, mirroring mangle_function's has_page placement). Used by
    ; plan_operator / find_subscript_operator for operators that fall under
    ; the implicit-return-page rule (e.g. `operator [] returns ref[T]?`,
    ; the same rule that gives Vector.get its page slot).
    function mangle_operator_paged(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?,
        has_page: bool
    ) returns String
    {
        let op_code Planner.operator_code(name)
        var sb StringBuilder()
        sb.append "_Z"

        if parent <> null
        {
            let p (*parent)
            sb.append "N"
            sb.append(Planner.encode_type(p))
            sb.append op_code
            sb.append "E"
        }
        if parent = null
            sb.append op_code

        var has_params: bool false
        if has_page
        {
            sb.append "PN4scaly6memory4PageE"
            set has_params: true
        }

        ; Skip 'this' on member operators (param[0] with name "this").
        var start_idx: size_t 0
        if parent <> null
        {
            if params <> null
            {
                let ps (*params)
                if ps.length > 0
                {
                    let first_ptr ps.get 0
                    if first_ptr <> null
                    {
                        let first (*first_ptr)
                        if first.name <> null
                        {
                            let pname (*first.name)
                            if pname.equals("this")
                                set start_idx: 1
                        }
                    }
                }
            }
        }

        if params <> null
        {
            let ps (*params)
            var i: size_t start_idx
            while i < ps.length
            {
                let param_ptr ps.get i
                if param_ptr <> null
                {
                    let param (*param_ptr)
                    if param.item_type <> null
                    {
                        let pty (*param.item_type)
                        sb.append(Planner.encode_type(pty))
                        set has_params: true
                    }
                }
                set i: i + 1
            }
        }

        if has_params = false
            sb.append "v"

        sb.to_string()
    }

    ; ========================================================================
    ; Type utilities.
    ; Used by the expression/statement planner for type checks and readable
    ; diagnostics. Ported from the "Type Utilities" section of Planner.cpp.
    ; ========================================================================

    ; get_readable_name: human-facing representation, e.g. "Vector[int]".
    function get_readable_name(type_value: PlannedType) returns String
    {
        if type_value.generics <> null
        {
            let gens (*type_value.generics)
            if gens.length > 0
            {
                var sb StringBuilder()
                sb.append type_value.name
                sb.append "["
                var i: size_t 0
                while i < gens.length
                {
                    if i > 0
                        sb.append ", "

                    let g_ptr gens.get i
                    if g_ptr <> null
                    {
                        let g (*g_ptr)
                        let inner Planner.get_readable_name(g)
                        sb.append inner
                    }
                    set i: i + 1
                }
                sb.append "]"
                return sb.to_string()
            }
        }
        String(type_value.name)
    }

    ; normalize_type_name: canonicalise builtin aliases.
    ; "scaly.*" packages collapse to their last component so "scaly.containers.String"
    ; compares equal to "String", matching Planner.cpp's normalizeTypeName. Integer
    ; aliases fold onto their sized form so int/size_t/char compare structurally.
    function normalize_type_name(name: String) returns String
    {
        var base: String name
        if name.starts_with("scaly.")
        {
            let last_dot name.last_index_of("." as u8)
            if last_dot >= 0
            {
                let start (last_dot as size_t) + 1
                let len name.get_length() - start
                set base: name.substring(start, len)
            }
        }

        if base.equals("int")
            return "i64"
        if base.equals("i64")
            return "i64"
        if base.equals("i32")
            return "i32"
        if base.equals("i16")
            return "i16"
        if base.equals("i8")
            return "i8"
        if base.equals("size_t")
            return "u64"
        if base.equals("size")
            return "u64"
        if base.equals("u64")
            return "u64"
        if base.equals("usize")
            return "u64"
        if base.equals("u32")
            return "u32"
        if base.equals("u16")
            return "u16"
        if base.equals("u8")
            return "u8"
        if base.equals("char")
            return "u8"
        if base.equals("double")
            return "f64"
        if base.equals("f64")
            return "f64"
        if base.equals("float")
            return "f32"
        if base.equals("f32")
            return "f32"

        String(base)
    }

    ; is_integer_type: is a normalized type name one of the integer family?
    ; Called post-normalization so both "int" and "i64" answer true.
    function is_integer_type(normalized: String) returns bool
    {
        if normalized.equals("i64")
            return true
        if normalized.equals("i32")
            return true
        if normalized.equals("i16")
            return true
        if normalized.equals("i8")
            return true
        if normalized.equals("u64")
            return true
        if normalized.equals("u32")
            return true
        if normalized.equals("u16")
            return true
        if normalized.equals("u8")
            return true
        if normalized.equals("size_t")
            return true
        if normalized.equals("int")
            return true
        if normalized.equals("uint")
            return true
        if normalized.equals("char")
            return true
        false
    }

    ; is_char_like_cross_compatible: decide whether two pointer-inner types
    ; can freely substitute for each other. Mirrors the unwieldy pointer
    ; rules in Planner.cpp's typesCompatible exactly — in particular the
    ; one-way (param=const_char, arg=char) rule; the reverse is rejected
    ; because you must not silently assign immutable data to mutable storage.
    function is_char_like_cross_compatible(param_inner: String, arg_inner: String) returns bool
    {
        if param_inner.equals("const_char")
        {
            if arg_inner.equals("i8")
                return true
            if arg_inner.equals("char")
                return true
        }
        if param_inner.equals("i8")
        {
            if arg_inner.equals("const_char")
                return true
            if arg_inner.equals("char")
                return true
        }
        if param_inner.equals("char")
        {
            if arg_inner.equals("i8")
                return true
        }

        ; u8 is ABI-identical to the 1-byte char family.
        if param_inner.equals("u8")
        {
            if arg_inner.equals("char")
                return true
            if arg_inner.equals("const_char")
                return true
            if arg_inner.equals("i8")
                return true
            if arg_inner.equals("u8")
                return true
        }
        if arg_inner.equals("u8")
        {
            if param_inner.equals("char")
                return true
            if param_inner.equals("const_char")
                return true
            if param_inner.equals("i8")
                return true
        }

        false
    }

    ; types_equal: structural equality after alias normalisation.
    ; Recurses pairwise through the generics list; mismatched arities
    ; are unequal. Null/empty generics are treated uniformly as arity 0.
    function types_equal(a: PlannedType, b: PlannedType) returns bool
    {
        let norm_a Planner.normalize_type_name(a.name)
        let norm_b Planner.normalize_type_name(b.name)
        if norm_a.equals(norm_b) = false
            return false

        var a_len: size_t 0
        var b_len: size_t 0
        if a.generics <> null
        {
            let ag (*a.generics)
            set a_len: ag.length
        }
        if b.generics <> null
        {
            let bg (*b.generics)
            set b_len: bg.length
        }

        if a_len <> b_len
            return false

        if a_len = 0
            return true

        if a.generics <> null
        {
            if b.generics <> null
            {
                let ag (*a.generics)
                let bg (*b.generics)
                var i: size_t 0
                while i < a_len
                {
                    let a_ptr ag.get i
                    let b_ptr bg.get i
                    if a_ptr <> null
                    {
                        if b_ptr <> null
                        {
                            let av (*a_ptr)
                            let bv (*b_ptr)
                            if Planner.types_equal(av, bv) = false
                                return false
                        }
                    }
                    set i: i + 1
                }
            }
        }
        true
    }

    ; types_compatible: decide whether an argument of ArgType can be passed
    ; to a parameter of ParamType without an explicit cast. Order of rules
    ; matches Planner.cpp — earlier rules short-circuit, later rules remain
    ; authoritative for their specific cases (pointer-to-void, Option-null).
    function types_compatible(param_type: PlannedType, arg_type: PlannedType) returns bool
    {
        ; Rule 1: exact equality (post-normalisation).
        if Planner.types_equal(param_type, arg_type)
            return true

        ; Rule 2: any integer type is compatible with any other. The Emitter
        ; inserts the appropriate zext/sext/trunc at the call site.
        let norm_p Planner.normalize_type_name(param_type.name)
        let norm_a Planner.normalize_type_name(arg_type.name)
        if Planner.is_integer_type(norm_p)
        {
            if Planner.is_integer_type(norm_a)
                return true
        }

        ; Rule 2b: a String value is compatible with pointer[const_char]
        ; (= pointer[i8]/char/u8): it coerces to its NUL-terminated content
        ; pointer (c_data) for C/extern interop. Lets a String literal flow
        ; into scaly_eputs / String() ctor / equals(cstr) etc. The Emitter
        ; emits a plain NUL-terminated cstr global for a String CONSTANT in
        ; such a position (byte-identical to the pre-feature cstr).
        if arg_type.name.equals("String")
        {
            if param_type.name.equals("pointer")
            {
                if param_type.generics <> null
                {
                    let pgs (*param_type.generics)
                    if pgs.length > 0
                    {
                        let pinner_ptr pgs.get 0
                        if pinner_ptr <> null
                        {
                            let pinner (*pinner_ptr)
                            if pinner.name.equals("const_char")
                                return true
                            if pinner.name.equals("i8")
                                return true
                            if pinner.name.equals("char")
                                return true
                            if pinner.name.equals("u8")
                                return true
                        }
                    }
                }
            }
        }

        ; Rule 3: arg is pointer[T], param is T — implicit deref. Handles
        ; passing `this` (a pointer) to a function expecting the value type.
        if arg_type.name.equals("pointer")
        {
            if arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                if ag.length > 0
                {
                    let inner_ptr ag.get 0
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        if Planner.types_equal(param_type, inner)
                            return true
                    }
                }
            }
        }

        ; Rule 4: ref[T] implicitly derefs to T.
        if arg_type.name.equals("ref")
        {
            if arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                if ag.length > 0
                {
                    let inner_ptr ag.get 0
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        if Planner.types_equal(param_type, inner)
                            return true
                    }
                }
            }
        }

        ; s96: pointer[T] is compatible with ref[T] (and vice versa). Both
        ; lower to `ptr` in LLVM, and `&local` produces pointer[T] while
        ; ref params expect ref[T]. Stage-0's typesCompatible doesn't have
        ; this rule (it falls through and works only via the qualified-
        ; call name-only fallback at Planner.cpp:7912 for namespace.fn
        ; sites); extending the rule here lets free-function `f(&x)` for
        ; `f(p: ref[T])` work too. Symmetric: pointer[T] passed to ref[T]
        ; param, OR ref[T] passed to pointer[T] param.
        if param_type.name.equals("ref")
        {
            if arg_type.name.equals("pointer")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if param_type.name.equals("pointer")
        {
            if arg_type.name.equals("ref")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 5 & 6 both require both sides to be pointer[T] with a generic arg.
        if param_type.name.equals("pointer")
        {
            if arg_type.name.equals("pointer")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)

                            ; Rule 6: any pointer[T] coerces to pointer[void].
                            if p0.name.equals("void")
                                return true

                            ; Rule 5: char-family pointer cross-compatibility.
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.is_char_like_cross_compatible(p0.name, a0.name)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 7 & 8: null (typed as pointer[void]) is the None for Option types.
        if arg_type.name.equals("pointer")
        {
            if arg_type.generics <> null
            {
                let ag (*arg_type.generics)
                if ag.length > 0
                {
                    let a0_ptr ag.get 0
                    if a0_ptr <> null
                    {
                        let a0 (*a0_ptr)
                        if a0.name.equals("void")
                        {
                            if param_type.name.equals("Option")
                                return true
                            if param_type.name.starts_with("Option.")
                                return true
                        }
                    }
                }
            }
        }

        ; s170: a CONCRETE pointer[T] / ref[T] arg is a valid (non-null)
        ; Some for an Option[ref[T]] / Option[pointer[T]] param. With NPO
        ; the Option is just a nullable pointer, so `&input_holder`
        ; (pointer[Vector[PlannedItem]]) is a legal value for a
        ; `params: ref[Vector[PlannedItem]]?` param. Rules 7&8 above only
        ; accept the null literal (pointer[void]); a real address-of
        ; falls through. Recurse types_compatible into the Option's inner
        ; generic so the s96 pointer↔ref rule handles the inner match
        ; (inner ref[T] vs arg pointer[T]). Stage-0 resolves the
        ; offending site (`Planner.mangle_function(f.name, &input_holder,
        ; ...)` in plan_function#) via the qualified-call name-only
        ; fallback (Planner.cpp:7912) and never type-checks args, so it
        ; has no equivalent rule; stage-1 takes the type-checked dotted
        ; path (resolve_function_call# on the suffix), so without this
        ; the put call is dropped, `add`'s mangled_name stays empty, and
        ; stage-2's emit_function_decl SIGSEGVs in LLVMAddFunction(null).
        if param_type.name.equals("Option")
        {
            var arg_is_ptr_like: bool false
            if arg_type.name.equals("pointer")
                set arg_is_ptr_like: true
            if arg_type.name.equals("ref")
                set arg_is_ptr_like: true
            if arg_is_ptr_like
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let inner_ptr pg.get 0
                        if inner_ptr <> null
                        {
                            let inner (*inner_ptr)
                            if Planner.types_compatible(inner, arg_type)
                                return true
                        }
                    }
                }
            }
        }

        false
    }

    ; ========================================================================
    ; Struct-layout arithmetic.
    ; ========================================================================

    ; is_primitive_type_name: matches the set the C++ Planner treats as not
    ; requiring an implicit return-page parameter. Used both for layout
    ; decisions and for the needs_implicit_return_page check.
    function is_primitive_type_name(name: String) returns bool
    {
        if name.equals("void")
            return true
        if name.equals("bool")
            return true
        if name.equals("int")
            return true
        if name.equals("uint")
            return true
        if name.equals("char")
            return true
        if name.equals("i8")
            return true
        if name.equals("i16")
            return true
        if name.equals("i32")
            return true
        if name.equals("i64")
            return true
        if name.equals("u8")
            return true
        if name.equals("u16")
            return true
        if name.equals("u32")
            return true
        if name.equals("u64")
            return true
        if name.equals("f32")
            return true
        if name.equals("f64")
            return true
        if name.equals("float")
            return true
        if name.equals("double")
            return true
        if name.equals("size_t")
            return true
        if name.equals("size")
            return true
        if name.equals("pointer")
            return true
        if name.equals("ref")
            return true
        false
    }

    ; get_primitive_alignment: bytes of alignment required by a primitive.
    ; Mirrors the simplified model in Planner.cpp's computeStructLayout —
    ; size is always equal to alignment here (no padding for subword
    ; fields), which is good enough for Phase-2 layout decisions. Unknown
    ; or non-primitive types default to 8-byte alignment.
    function get_primitive_alignment(type_name: String) returns size_t
    {
        if type_name.equals("bool")
            return 1
        if type_name.equals("char")
            return 1
        if type_name.equals("i8")
            return 1
        if type_name.equals("u8")
            return 1
        if type_name.equals("i16")
            return 2
        if type_name.equals("u16")
            return 2
        if type_name.equals("i32")
            return 4
        if type_name.equals("u32")
            return 4
        if type_name.equals("float")
            return 4
        if type_name.equals("f32")
            return 4
        ; s103: int/uint are 8 bytes (i64) to match stage-0
        ; (Planner.cpp:960). Stage-1 previously returned 4 here,
        ; making sizeof(int) = 4 vs stage-0's 8 — sizeof_ops AOT
        ; test compared 4 = 8 → false → printed WRONG.
        8
    }

    ; align_offset: round `offset` up to the next multiple of `align`.
    ; `align` must be a power of two (standard struct-layout precondition).
    function align_offset(offset: size_t, align: size_t) returns size_t
    {
        (offset + align - 1) & (~(align - 1))
    }

    ; compute_struct_alignment: the maximum alignment demanded by any
    ; property in `props`, with a floor of 1 (empty struct).
    function compute_struct_alignment(props: ref[Vector[PlannedProperty]]?) returns size_t
    {
        if props = null
            return 1

        let ps (*props)
        var max_align: size_t 1
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get i
            if p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                if align > max_align
                    set max_align: align
            }
            set i: i + 1
        }
        max_align
    }

    ; compute_struct_size: total byte size needed for a struct with these
    ; properties, assuming size == alignment per field (the simplified
    ; model from Planner.cpp). The final size is rounded up to the
    ; struct's own alignment.
    function compute_struct_size(props: ref[Vector[PlannedProperty]]?) returns size_t
    {
        if props = null
            return 0

        let ps (*props)
        var offset: size_t 0
        var max_align: size_t 1
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get i
            if p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                set offset: Planner.align_offset(offset, align)
                set offset: offset + align
                if align > max_align
                    set max_align: align
            }
            set i: i + 1
        }
        Planner.align_offset(offset, max_align)
    }

    ; compute_property_offsets: per-property byte offsets in struct order.
    ; Split out as a separate pass (rather than mutating PlannedProperty in
    ; place) because Scaly's Vector stores by value and we don't yet have
    ; a clean mutation pattern for nested struct fields.
    function compute_property_offsets(props: ref[Vector[PlannedProperty]]?) returns Vector[size_t]
    {
        if props = null
            return Vector[size_t](0)

        let ps (*props)
        var result Vector[size_t](ps.length)
        var offset: size_t 0
        var i: size_t 0
        while i < ps.length
        {
            let p_ptr ps.get i
            if p_ptr <> null
            {
                let p (*p_ptr)
                let align Planner.get_primitive_alignment(p.prop_type.name)
                set offset: Planner.align_offset(offset, align)
                result.put(i, offset)
                set offset: offset + align
            }
            set i: i + 1
        }
        result
    }

    ; compute_union_size: max-variant-size plus a 1-byte (or 4-byte for
    ; very large unions) tag, aligned to the widest variant's alignment.
    ; Ignores variants with no payload type; a tag-only variant contributes
    ; nothing to the size calculation beyond the tag itself.
    function compute_union_size(variants: ref[Vector[PlannedVariant]]?) returns size_t
    {
        if variants = null
            return 0

        let vs (*variants)
        var max_size: size_t 0
        var max_align: size_t 1
        var i: size_t 0
        while i < vs.length
        {
            let v_ptr vs.get i
            if v_ptr <> null
            {
                let v (*v_ptr)
                if v.var_type <> null
                {
                    let vt (*v.var_type)
                    let align Planner.get_primitive_alignment(vt.name)
                    if align > max_size
                        set max_size: align
                    if align > max_align
                        set max_align: align
                }
            }
            set i: i + 1
        }

        ; Tag: 1 byte for ≤256 variants, 4 bytes beyond.
        var tag_size: size_t 1
        if vs.length > 256
            set tag_size: 4

        Planner.align_offset(max_size + tag_size, max_align)
    }

    ; compute_union_alignment: max alignment across all variant payload
    ; types; tag-only variants contribute the 1-byte tag alignment.
    function compute_union_alignment(variants: ref[Vector[PlannedVariant]]?) returns size_t
    {
        if variants = null
            return 1

        let vs (*variants)
        var max_align: size_t 1
        var i: size_t 0
        while i < vs.length
        {
            let v_ptr vs.get i
            if v_ptr <> null
            {
                let v (*v_ptr)
                if v.var_type <> null
                {
                    let vt (*v.var_type)
                    let align Planner.get_primitive_alignment(vt.name)
                    if align > max_align
                        set max_align: align
                }
            }
            set i: i + 1
        }

        max_align
    }

    ; ========================================================================
    ; Constraint-solver helpers.
    ; The main Hindley-Milner machinery (unify, solveConstraints,
    ; freshTypeVar) touches Plan-global state, but the "occurs check"
    ; and compatible-integer predicate are pure and can be ported now.
    ; ========================================================================

    ; substitution_lookup: linear scan for a type-var id in a substitution.
    ; The `Substitution` type in Planner.cpp is a map<uint64_t, PlannedType>.
    ; In Scaly we represent it as Vector[KeyValuePair[size_t, PlannedType]]
    ; because primitive size_t lacks a `.hash()` method — HashMap requires
    ; `key.hash()` / `key.equals()` which are only defined on String today.
    ; At the scale of substitutions during a single function body (a few
    ; dozen entries at most) O(n) lookup is fine.
    function substitution_lookup(
        subst: Vector[KeyValuePair[size_t, PlannedType]],
        id: size_t
    ) returns ref[PlannedType]?
    {
        var i: size_t 0
        while i < subst.length
        {
            let kvp_ptr subst.get_ptr i
            if kvp_ptr <> null
            {
                if kvp_ptr.key = id
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; apply_substitution: replace every type variable in `t` with its binding
    ; in `subst`, recursing to handle chains (T0 -> T1 -> int). Concrete
    ; types get rebuilt with substituted generic arguments; everything
    ; else (loc / life / origin / mangled_name / array_size / variable) is
    ; preserved from the input. Returns the input unchanged when subst is
    ; null (i.e. empty substitution).
    function apply_substitution(
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    ) returns PlannedType
    {
        if t.variable <> null
        {
            if subst <> null
            {
                let s (*subst)
                let tv (*t.variable)
                let found Planner.substitution_lookup(s, tv.id)
                if found <> null
                {
                    let found_ty (*found)
                    return Planner.apply_substitution(found_ty, subst)
                }
            }
            ; Unresolved variable — return as-is.
            return t
        }

        if t.generics <> null
        {
            let gens (*t.generics)
            var new_gens Vector[PlannedType](gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get i
                if g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub_g Planner.apply_substitution(g, subst)
                    new_gens.put(i, sub_g)
                }
                set i: i + 1
            }
            return PlannedType(
                t.loc,
                t.name,
                t.mangled_name,
                &new_gens,
                t.life,
                t.origin,
                t.array_size,
                t.variable
            )
        }

        t
    }

    ; free_type_vars_with_dups: depth-first collection of every type-var
    ; id reachable through the generics tree. May contain duplicates —
    ; the public free_type_vars wrapper dedupes.
    function free_type_vars_with_dups(t: PlannedType) returns Vector[size_t]
    {
        var acc Array[size_t]()
        if t.variable <> null
        {
            let tv (*t.variable)
            acc.add tv.id
        }
        if t.generics <> null
        {
            let gens (*t.generics)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get i
                if g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub Planner.free_type_vars_with_dups(g)
                    var j: size_t 0
                    while j < sub.length
                    {
                        let id_ptr sub.get j
                        if id_ptr <> null
                            acc.add(*id_ptr)

                        set j: j + 1
                    }
                }
                set i: i + 1
            }
        }
        Vector[size_t](acc)
    }

    ; free_type_vars: distinct type-var ids in `t`, in first-seen order.
    ; Used for generalization (promoting a type to a type scheme).
    function free_type_vars(t: PlannedType) returns Vector[size_t]
    {
        let with_dups Planner.free_type_vars_with_dups(t)
        var acc Array[size_t]()
        var i: size_t 0
        while i < with_dups.length
        {
            let id_ptr with_dups.get i
            if id_ptr <> null
            {
                let id *id_ptr
                var found: bool false
                var j: size_t 0
                while j < acc.length
                {
                    let existing acc.get j
                    if existing <> null
                    {
                        if *existing = id
                            set found: true
                    }
                    set j: j + 1
                }
                if found = false
                    acc.add id
            }
            set i: i + 1
        }
        Vector[size_t](acc)
    }

    ; name_substitution_lookup: linear scan by String key. Distinct from
    ; substitution_lookup (which keys on size_t type-var ids).
    function name_substitution_lookup(
        subst: Vector[KeyValuePair[String, PlannedType]],
        name: String
    ) returns ref[PlannedType]?
    {
        var i: size_t 0
        while i < subst.length
        {
            let kvp_ptr subst.get_ptr i
            if kvp_ptr <> null
            {
                if kvp_ptr.key.equals(name)
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; planned_type_to_model_type: deep-convert PlannedType → Model.Type,
    ; preserving nested generics. Used by extract_row_to_type# to rebuild
    ; an outer Model.Type with proper inner generic structure.
    function planned_type_to_model_type(pt: PlannedType) returns Type
    {
        var name_path Vector[String](1)
        name_path.put(0, pt.name)
        var maybe_gens: ref[Vector[Type]]? null
        if pt.generics <> null
        {
            let pgens (*pt.generics)
            if pgens.length > 0
            {
                var conv Vector[Type](pgens.length)
                var i: size_t 0
                while i < pgens.length
                {
                    let inner_ptr pgens.get i
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        conv.put(i, Planner.planned_type_to_model_type(inner))
                    }
                    set i: i + 1
                }
                set maybe_gens: &conv
            }
        }
        Type(pt.loc, name_path, maybe_gens, pt.life)
    }

    ; apply_name_substitution: substitute type-parameter names (e.g. "T",
    ; "K") with concrete types. Used by generic instantiation — the C++
    ; `TypeSubstitutions` is a name-keyed map populated before resolving
    ; each method in an instantiated struct.
    ;
    ; Preserves the caller's `loc` on the substituted type so error
    ; messages point at the use-site, matching Planner.cpp.
    function apply_name_substitution(
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[String, PlannedType]]]?
    ) returns PlannedType
    {
        if subst <> null
        {
            let s (*subst)
            let hit Planner.name_substitution_lookup(s, t.name)
            if hit <> null
            {
                let replacement (*hit)
                return PlannedType(
                    t.loc,
                    replacement.name,
                    replacement.mangled_name,
                    replacement.generics,
                    replacement.life,
                    replacement.origin,
                    replacement.array_size,
                    replacement.variable
                )
            }
        }

        if t.generics <> null
        {
            let gens (*t.generics)
            var new_gens Vector[PlannedType](gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get i
                if g_ptr <> null
                {
                    let g (*g_ptr)
                    let new_g Planner.apply_name_substitution(g, subst)
                    new_gens.put(i, new_g)
                }
                set i: i + 1
            }
            return PlannedType(
                t.loc,
                t.name,
                t.mangled_name,
                &new_gens,
                t.life,
                t.origin,
                t.array_size,
                t.variable
            )
        }

        t
    }

    ; ========================================================================
    ; Primitive-type factories.
    ;
    ; The C++ Planner implicitly knows the Itanium one-letter codes for
    ; every built-in type. Until we have a Concepts table populated with
    ; pre-registered primitives, callers that need to synthesize a
    ; primitive PlannedType (e.g. for `return type of null = pointer[void]`)
    ; go through these factories so the codes stay consistent everywhere.
    ; ========================================================================

    function make_primitive_type(name: pointer[const_char], mangled: pointer[const_char]) returns PlannedType
    {
        PlannedType(
            Span(0, 0),
            String(name),
            String(mangled),
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
    }

    function make_void_type() returns PlannedType
        Planner.make_primitive_type("void", "v")

    function make_bool_type() returns PlannedType
        Planner.make_primitive_type("bool", "b")

    function make_int_type() returns PlannedType
        Planner.make_primitive_type("int", "i")

    function make_i64_type() returns PlannedType
        Planner.make_primitive_type("i64", "x")

    function make_char_type() returns PlannedType
        Planner.make_primitive_type("char", "c")

    function make_size_type() returns PlannedType
        Planner.make_primitive_type("size_t", "m")

    function make_double_type() returns PlannedType
        Planner.make_primitive_type("double", "d")

    ; make_pointer_type: wrap `inner` as pointer[inner], with Itanium "P..."
    ; mangled name. `inner.mangled_name` must be populated.
    function make_pointer_type(inner: PlannedType) returns PlannedType
    {
        var gens Vector[PlannedType](1)
        gens.put(0, inner)
        var sb StringBuilder()
        sb.append "P"
        sb.append inner.mangled_name
        PlannedType(
            Span(0, 0),
            "pointer",
            sb.to_string(),
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
    }

    ; make_pointer_to_local#: like make_pointer_type# but the INNER pointee
    ; carries Local life — `&<frame-local-binding>` produces a pointer into
    ; the function's frame, so is_reference_to_local_page# (which reads the
    ; inner generic's life) fires when that pointer is returned / stored
    ; externally / passed to a storing callee. Escape soundness step 1: the
    ; address-of signal `$` used to provide on the binding, now inferred for
    ; no-sigil frame locals. The inner is rebuilt FRESH (rehome_type# style,
    ; String^rp copies, generics carried by ref) — never a by-value copy of
    ; an existing result_type (the s34/s196 union-struct-copy ABI hazard).
    function make_pointer_to_local(inner: PlannedType) returns PlannedType
    {
        let local_inner PlannedType(
            inner.loc,
            String(inner.name),
            String(inner.mangled_name),
            inner.generics,
            Lifetime.Local(scalyc.compiler.Model.Local(inner.loc)),
            inner.origin,
            String(inner.array_size),
            inner.variable
        )
        Planner.make_pointer_type(local_inner)
    }

    ; make_ref_to_local_inner#: rebuild a reference-like type (pointer[X] or
    ; ref[X]) PRESERVING its outer (pointer vs ref) and mangled name, but with
    ; the inner pointee X carrying Local life — so is_reference_to_local_page#
    ; (inner-Local clause) and is_local_ref_pointer# both fire. Unlike
    ; make_pointer_to_local# (which takes a bare inner and always builds a
    ; pointer) this is driven by an EXISTING reference type and keeps ref-ness,
    ; used by the hole-1 pass case to mark a tainted field read on the operand
    ; type itself. Inner rebuilt FRESH (String^rp copies — s34 ABI hazard).
    function make_ref_to_local_inner(t: PlannedType) returns PlannedType
    {
        if t.generics = null
            return t
        let gens (*t.generics)
        if gens.length = 0
            return t
        let inner_ptr gens.get 0
        if inner_ptr = null
            return t
        let inner (*inner_ptr)
        let local_inner PlannedType(
            inner.loc,
            String(inner.name),
            String(inner.mangled_name),
            inner.generics,
            Lifetime.Local(scalyc.compiler.Model.Local(inner.loc)),
            inner.origin,
            String(inner.array_size),
            inner.variable
        )
        var new_gens Vector[PlannedType](1)
        new_gens.put(0, local_inner)
        PlannedType(
            t.loc,
            String(t.name),
            String(t.mangled_name),
            &new_gens,
            t.life,
            t.origin,
            String(t.array_size),
            t.variable
        )
    }

    ; stamp_getref_local_pointee# (Option B, 2026-07-02h): rebuild a container
    ; get/get_ptr RESULT type with its pointee life Local. get_ptr returns a
    ; bare pointer[T] — delegate to make_ref_to_local_inner#. get returns
    ; ref[T]? which plans as Option[ref[T]] — rebuild the Option with its
    ; inner reference stamped (the Option-of-ref shape the escape leaf
    ; predicates pierce). Any other type is returned verbatim. Applied by
    ; collapse_operand_sequence#'s method dispatch when the receiver holder's
    ; guts live on the frame's local page (local_frame_holder_names).
    function stamp_getref_local_pointee(t: PlannedType) returns PlannedType
    {
        var is_ref_like false
        if t.name.equals("pointer")
            set is_ref_like: true
        if t.name.equals("ref")
            set is_ref_like: true
        if is_ref_like
            return Planner.make_ref_to_local_inner(t)
        if t.name.equals("Option") = false
            return t
        if t.generics = null
            return t
        let gens (*t.generics)
        if gens.length = 0
            return t
        let inner_ptr gens.get 0
        if inner_ptr = null
            return t
        let inner (*inner_ptr)
        var inner_is_ref false
        if inner.name.equals("pointer")
            set inner_is_ref: true
        if inner.name.equals("ref")
            set inner_is_ref: true
        if inner_is_ref = false
            return t
        let stamped_ref Planner.make_ref_to_local_inner(inner)
        var new_gens Vector[PlannedType](1)
        new_gens.put(0, stamped_ref)
        PlannedType(
            t.loc,
            String(t.name),
            String(t.mangled_name),
            &new_gens,
            t.life,
            t.origin,
            String(t.array_size),
            t.variable
        )
    }

    ; rehome_type#: deep-copy a PlannedType onto `rp`, recursively
    ; re-homing its name / mangled_name / array_size Strings and all
    ; nested generic-argument PlannedTypes. Used by instantiate_generic#
    ; to pin a generic argument (which may have been built on a transient
    ; sub-computation page by the s188 lazy method hook) onto the
    ; Planner's persistent owning page before it is substituted into the
    ; instantiated structure's property / method types — otherwise the
    ; substituted name Strings dangle and emit's String hash SIGSEGVs.
    ; origin / variable refs are carried as-is (not read on the emit
    ; struct-type / hash path); life is a value, copied.
    function rehome_type(t: PlannedType) returns PlannedType
    {
        var gens_ref: ref[Vector[PlannedType]]? null
        if t.generics <> null
        {
            let gs (*t.generics)
            if gs.length > 0
            {
                var arr Array[PlannedType]()
                var i: size_t 0
                while i < gs.length
                {
                    let gp gs.get i
                    if gp <> null
                        arr.add(Planner.rehome_type((*gp)))
                    set i: i + 1
                }
                var gh Vector[PlannedType](arr)
                set gens_ref: &gh
            }
        }
        PlannedType(
            t.loc,
            String(t.name),
            String(t.mangled_name),
            gens_ref,
            t.life,
            t.origin,
            String(t.array_size),
            t.variable
        )
    }

    ; extract_row_to_type#: convert one row of a parsed VectorSyntax /
    ; Matrix into a Model.Type, recursively handling nested generics.
    ; Mirrors stage-0 Planner.cpp:7180-7214 (extractTypeFromRow lambda).
    ;
    ; row.length == 1: cell must be a PlannedType — wrap it as Model.Type.
    ; row.length >= 2: first cell is bare PlannedType (no generics) AND
    ;   second cell is PlannedMatrix → recurse into each nested row,
    ;   build Model.Type with generics filled in.
    ; Otherwise: return null (caller treats this as extraction failure).
    ; matrix_single_int_size: if a PlannedMatrix is exactly one row with a
    ; single integer-constant cell, return its decimal value as a String;
    ; otherwise empty. Recognises the `primitive[N]` stack-array shape in
    ; collapse_operand_sequence#'s Type+Matrix merge (s192).
    function matrix_single_int_size(nm: scalyc.compiler.Plan.PlannedMatrix) returns String
    {
        if nm.operations = null
            return ""
        let rows (*nm.operations)
        if rows.length <> 1
            return ""
        let row0_ptr rows.get 0
        if row0_ptr = null
            return ""
        let row0 (*row0_ptr)
        if row0.length <> 1
            return ""
        let cell_ptr row0.get 0
        if cell_ptr = null
            return ""
        let cell (*cell_ptr)
        var out ""
        choose cell.expr
            when c: scalyc.compiler.Plan.PlannedConstant
            {
                choose c.value
                    when ic: IntegerConstant
                        set out: Planner.size_to_string(ic.value)
                    else
                        0
            }
            else
                0
        out
    }

    function extract_row_to_type(row: Vector[PlannedOperand]) returns ref[Type]?
    {
        if row.length = 0
            return null

        ; Nested generic pattern: [Type, Matrix, ...]. Check before the
        ; single-cell branch since row.length>=2 with bare-Type first +
        ; Matrix second is the signature for `Box[int]` / `Pair[A,B]` /
        ; etc. inside an outer generic argument list.
        if row.length >= 2
        {
            let cell0_ptr row.get 0
            if cell0_ptr <> null
            {
                let cell0 (*cell0_ptr)
                choose cell0.expr
                    when name_type: PlannedType
                    {
                        if name_type.name.get_length() > 0
                        {
                            if name_type.generics = null
                            {
                                let cell1_ptr row.get 1
                                if cell1_ptr <> null
                                {
                                    let cell1 (*cell1_ptr)
                                    choose cell1.expr
                                        when nested_matrix: scalyc.compiler.Plan.PlannedMatrix
                                        {
                                            var nested_gens Array[Type]()
                                            var ok: bool true
                                            if nested_matrix.operations <> null
                                            {
                                                let nested_rows (*nested_matrix.operations)
                                                var nri: size_t 0
                                                while nri < nested_rows.length
                                                {
                                                    let nrow_ptr nested_rows.get nri
                                                    if nrow_ptr <> null
                                                    {
                                                        let nrow (*nrow_ptr)
                                                        let inner_t Planner.extract_row_to_type(nrow)
                                                        if inner_t = null
                                                            set ok: false
                                                        if inner_t <> null
                                                            nested_gens.add((*inner_t))
                                                    }
                                                    set nri: nri + 1
                                                }
                                            }
                                            if ok
                                            {
                                                if nested_gens.length > 0
                                                {
                                                    var name_path Vector[String](1)
                                                    name_path.put(0, name_type.name)
                                                    var gens_vec Vector[Type](nested_gens)
                                                    var holder Vector[Type](1)
                                                    holder.put(0, Type(
                                                        name_type.loc,
                                                        name_path,
                                                        &gens_vec,
                                                        name_type.life
                                                    ))
                                                    return holder.get 0
                                                }
                                            }
                                        }
                                        else
                                            0
                                }
                            }
                        }
                    }
                    else
                        0
            }
        }

        ; Single-cell row: PlannedType → Model.Type. Use the recursive
        ; helper so nested generics survive the round-trip. s134: the
        ; previous implementation built each inner generic as
        ; `Type(name=[pt.name], generics=null)`, stripping deeper
        ; generic information. For PT_Vector<KVP<S, LB>> this turned
        ; the inner KVP into `Type("KeyValuePair", null)` — plan_type#
        ; later fell through to `mangle_structure("KeyValuePair", null)`
        ; and produced the truncated `_Z12KeyValuePair` that broke
        ; Step-7 link with `_ZN6VectorI6VectorI12KeyValuePairEE...`
        ; calls.
        if row.length = 1
        {
            let cell_ptr row.get 0
            if cell_ptr <> null
            {
                let cell (*cell_ptr)
                choose cell.expr
                    when et: PlannedType
                    {
                        var holder Vector[Type](1)
                        holder.put(0, Planner.planned_type_to_model_type(et))
                        return holder.get 0
                    }
                    else
                        return null
            }
        }

        null
    }

    ; resolve_type_base: convert a Model.Type into a PlannedType skeleton.
    ;
    ; Handles everything the non-stateful part of Planner.cpp's
    ; `resolveType` does:
    ;   - joins the dotted name (["scaly","containers","String"] -> "scaly.containers.String")
    ;   - recursively resolves generic arguments
    ;   - sets the Itanium mangled_name for the intrinsic pointer[T] / ref[T]
    ;     forms ("P…" / "R…")
    ;
    ; Deliberately skipped:
    ;   - TypeSubstitutions lookup (requires Planner state)
    ;   - Concepts table lookup for user-defined types' mangled_name
    ;     (leaves mangled_name empty for non-intrinsic names; the caller
    ;     fills that in once the Concepts table is available)
    function resolve_type_base(t: Type) returns PlannedType
    {
        let joined Planner.join_dotted_name(t.name)

        var resolved_gens: ref[Vector[PlannedType]]? null
        if t.generics <> null
        {
            let gens (*t.generics)
            var result Vector[PlannedType](gens.length)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get i
                if g_ptr <> null
                {
                    let g (*g_ptr)
                    let sub Planner.resolve_type_base(g)
                    result.put(i, sub)
                }
                set i: i + 1
            }
            set resolved_gens: &result
        }

        var mangled ""
        if joined.equals("pointer")
        {
            if resolved_gens <> null
            {
                let rg (*resolved_gens)
                if rg.length = 1
                {
                    let inner_ptr rg.get 0
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        var sb StringBuilder()
                        sb.append "P"
                        sb.append inner.mangled_name
                        set mangled: sb.to_string()
                    }
                }
            }
        }
        if joined.equals("ref")
        {
            if resolved_gens <> null
            {
                let rg (*resolved_gens)
                if rg.length = 1
                {
                    let inner_ptr rg.get 0
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        var sb StringBuilder()
                        sb.append "R"
                        sb.append inner.mangled_name
                        set mangled: sb.to_string()
                    }
                }
            }
        }

        PlannedType(
            t.span,
            joined,
            mangled,
            resolved_gens,
            t.lifetime,
            null,
            "",
            null
        )
    }

    ; lookup_local_in_scope: linear scan of one scope's bindings by name.
    ; Returned reference points into the scope's KeyValuePair storage.
    function lookup_local_in_scope(
        scope: Vector[KeyValuePair[String, LocalBinding]],
        name: String
    ) returns ref[LocalBinding]?
    {
        var i: size_t 0
        while i < scope.length
        {
            let kvp_ptr scope.get_ptr i
            if kvp_ptr <> null
            {
                if kvp_ptr.key.equals(name)
                    return &kvp_ptr.value
            }
            set i: i + 1
        }
        null
    }

    ; lookup_local_in_stack: searches innermost (top of the stack) to
    ; outermost — matches the reverse iteration in Planner.cpp's
    ; lookupLocal. A name shadowed in a newer scope hides the older
    ; binding.
    function lookup_local_in_stack(
        scopes: Vector[Vector[KeyValuePair[String, LocalBinding]]],
        name: String
    ) returns ref[LocalBinding]?
    {
        if scopes.length = 0
            return null

        var i scopes.length
        while i > 0
        {
            set i: i - 1
            let scope_ptr scopes.get_ptr i
            if scope_ptr <> null
            {
                let found Planner.lookup_local_in_scope(*scope_ptr, name)
                if found <> null
                    return found
            }
        }
        null
    }

    ; is_on_page_lifetime: everything except `Unspecified` is a page-backed
    ; allocation in Scaly's RBMM (local / caller / named / thrown all live
    ; on a page). Matches the static helper in Planner.cpp.
    function is_on_page_lifetime(life: Lifetime) returns bool
    {
        choose life
            when u: Unspecified
                false
            else
                true
    }

    ; ================================================================
    ; Provenance region-rank lattice (escape soundness, step 1).
    ;
    ; A coarse total order over WHERE a value's storage lives:
    ;   Local (0)  < Caller (1)  < Static (2)
    ;   frame/$       rp/#/^name     global/const
    ; An ESCAPE is a reference whose pointee rank is Local placed where
    ; Caller+ is required (return / store into a Caller-lived field /
    ; pass to a storing callee). Sound + conservative: in doubt -> Local
    ; -> reject. `#` and `^name` both collapse to Caller for now; the
    ; ordered numeric-rank family (`'a: 'b` outlives) is the phase-5
    ; endgame. region_rank_min implements the choose/if-join MINIMUM
    ; (shortest-lived branch wins) used by step 3's provenance walk.
    ; ================================================================
    function region_rank_local() returns size_t
        0
    function region_rank_caller() returns size_t
        1
    function region_rank_static() returns size_t
        2
    function region_rank_of_life(life: Lifetime) returns size_t
    {
        choose life
            when u: Unspecified
                return 0
            when l: Local
                return 0
            else
                return 1
    }
    function region_rank_min(a: size_t, b: size_t) returns size_t
    {
        if a < b
            return a
        b
    }

    ; decode_utf8_to_code_point: decode exactly one UTF-8 code point from
    ; `s`. Returns -1 for empty input, malformed sequences, overlong
    ; encodings, surrogates/out-of-range, or any trailing bytes past the
    ; first character. Matches the static helper in Planner.cpp.
    function decode_utf8_to_code_point(s: String) returns int
    {
        let len s.get_length()
        if len = 0
            return -1

        let buf s.get_buffer()
        let b0 *buf

        var code_point: int -1
        var char_len: size_t 0

        ; ASCII: 0xxxxxxx
        if (b0 & (0x80 as u8)) = (0 as u8)
        {
            set code_point: b0 as int
            set char_len: 1
        }

        ; 2-byte: 110xxxxx 10xxxxxx
        if char_len = 0
        {
            if (b0 & (0xE0 as u8)) = (0xC0 as u8)
            {
                if len >= 2
                {
                    let b1 *(buf + 1)
                    if (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        let cp (((b0 & (0x1F as u8)) as int) << 6) | ((b1 & (0x3F as u8)) as int)
                        if cp >= 0x80
                        {
                            set code_point: cp
                            set char_len: 2
                        }
                    }
                }
            }
        }

        ; 3-byte: 1110xxxx 10xxxxxx 10xxxxxx
        if char_len = 0
        {
            if (b0 & (0xF0 as u8)) = (0xE0 as u8)
            {
                if len >= 3
                {
                    let b1 *(buf + 1)
                    let b2 *(buf + 2)
                    if (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        if (b2 & (0xC0 as u8)) = (0x80 as u8)
                        {
                            let cp (((b0 & (0x0F as u8)) as int) << 12) | (((b1 & (0x3F as u8)) as int) << 6) | ((b2 & (0x3F as u8)) as int)
                            if cp >= 0x800
                            {
                                set code_point: cp
                                set char_len: 3
                            }
                        }
                    }
                }
            }
        }

        ; 4-byte: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
        if char_len = 0
        {
            if (b0 & (0xF8 as u8)) = (0xF0 as u8)
            {
                if len >= 4
                {
                    let b1 *(buf + 1)
                    let b2 *(buf + 2)
                    let b3 *(buf + 3)
                    if (b1 & (0xC0 as u8)) = (0x80 as u8)
                    {
                        if (b2 & (0xC0 as u8)) = (0x80 as u8)
                        {
                            if (b3 & (0xC0 as u8)) = (0x80 as u8)
                            {
                                let cp (((b0 & (0x07 as u8)) as int) << 18) | (((b1 & (0x3F as u8)) as int) << 12) | (((b2 & (0x3F as u8)) as int) << 6) | ((b3 & (0x3F as u8)) as int)
                                if cp >= 0x10000
                                {
                                    if cp <= 0x10FFFF
                                    {
                                        set code_point: cp
                                        set char_len: 4
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        if char_len = 0
            return -1

        if char_len <> len
            return -1

        code_point
    }

    ; id_list_contains: linear scan for a size_t id in a Vector[size_t].
    function id_list_contains(ids: Vector[size_t], needle: size_t) returns bool
    {
        var i: size_t 0
        while i < ids.length
        {
            let p ids.get i
            if p <> null
            {
                if *p = needle
                    return true
            }
            set i: i + 1
        }
        false
    }

    ; instantiate: dual of generalize. Replace every universally quantified
    ; variable in a TypeScheme with a freshly generated type variable so
    ; the scheme can be used polymorphically at a single call site.
    ;
    ; The C++ Planner gets fresh ids from the owning Plan's counter. Here
    ; we take `next_id_start` as a parameter and allocate sequential ids
    ; from there; the caller is responsible for advancing its counter by
    ; `scheme.quantified.length`.
    function instantiate(
        scheme: TypeScheme,
        next_id_start: size_t
    ) returns PlannedType
    {
        if scheme.scheme_type = null
            return Planner.make_void_type()

        let ty (*scheme.scheme_type)

        if scheme.quantified = null
            return ty

        let quants (*scheme.quantified)
        if quants.length = 0
            return ty

        ; Allocate stable storage for the fresh TypeVariables so their
        ; addresses can be embedded in the substitution-target PlannedTypes.
        var fresh_vars Vector[TypeVariable](quants.length)
        var subst_arr Array[KeyValuePair[size_t, PlannedType]]()
        var i: size_t 0
        while i < quants.length
        {
            let q_ptr quants.get i
            if q_ptr <> null
            {
                let q (*q_ptr)
                fresh_vars.put(i, TypeVariable(next_id_start + i, ""))
                let fresh_ptr fresh_vars.get i
                if fresh_ptr <> null
                {
                    let new_var_ty PlannedType(
                        Span(0, 0),
                        "",
                        "",
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        "",
                        fresh_ptr
                    )
                    subst_arr.add(KeyValuePair[size_t, PlannedType](q.id, new_var_ty))
                }
            }
            set i: i + 1
        }

        var subst Vector[KeyValuePair[size_t, PlannedType]](subst_arr)
        Planner.apply_substitution(ty, &subst)
    }

    ; generalize: promote a type to a type scheme by universally
    ; quantifying every free var that is NOT already free in the
    ; surrounding type environment. This is the operation behind
    ; `let`-polymorphism (ML / Haskell).
    function generalize(
        t: PlannedType,
        free_in_env: Vector[size_t]
    ) returns TypeScheme
    {
        let all_free Planner.free_type_vars(t)
        var quantified_arr Array[TypeVariable]()
        var i: size_t 0
        while i < all_free.length
        {
            let id_ptr all_free.get i
            if id_ptr <> null
            {
                let id *id_ptr
                if Planner.id_list_contains(free_in_env, id) = false
                    quantified_arr.add(TypeVariable(id, ""))
            }
            set i: i + 1
        }

        var quantified Vector[TypeVariable](quantified_arr)
        let scheme_t PlannedType(
            t.loc,
            t.name,
            t.mangled_name,
            t.generics,
            t.life,
            t.origin,
            t.array_size,
            t.variable
        )
        TypeScheme(&quantified, scheme_t)
    }

    ; is_option_vs_void_pointer: does `left` name an Option family type
    ; while `right` is `pointer[void]`? Used by unify to treat the null
    ; literal as the None constructor of any Option type.
    function is_option_vs_void_pointer(left: PlannedType, right: PlannedType) returns bool
    {
        var is_option: bool false
        if left.name.equals("Option")
            set is_option: true
        if left.name.starts_with("Option.")
            set is_option: true

        if is_option = false
            return false

        if right.name.equals("pointer") = false
            return false

        if right.generics = null
            return false

        let rg (*right.generics)
        if rg.length = 0
            return false

        let g0 rg.get 0
        if g0 = null
            return false

        (*g0).name.equals("void")
    }

    ; unify: produce the most-general substitution that makes `left` and
    ; `right` structurally equal. Returns null on any failure (occurs
    ; check, name mismatch, arity mismatch). The error channel intentionally
    ; drops the specific reason for now — adding a proper Result/Expected
    ; type is a separate refactor.
    ;
    ; Special cases preserved from Planner.cpp:
    ;   - same variable id                       → empty subst
    ;   - variable vs T (or vice versa)          → bind (with occurs check)
    ;   - void vs anything                       → empty subst
    ;   - compatible integer families            → empty subst
    ;   - Option family vs pointer[void]         → empty subst
    ;   - concrete names equal, arities equal    → recurse on generics
    function unify(
        left: PlannedType,
        right: PlannedType
    ) returns ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    {
        let left_embed left.variable
        let right_embed right.variable

        ; Case 1: both point to the same variable id.
        if left_embed <> null
        {
            if right_embed <> null
            {
                let lv (*left_embed)
                let rv (*right_embed)
                if lv.id = rv.id
                {
                    var empty Vector[KeyValuePair[size_t, PlannedType]](0)
                    return &empty
                }
            }
        }

        ; Case 2: left is a type variable — bind it to right.
        if left_embed <> null
        {
            let lv (*left_embed)
            if Planner.occurs_in(lv.id, right)
                return null
            var s Vector[KeyValuePair[size_t, PlannedType]](1)
            s.put(0, KeyValuePair[size_t, PlannedType](lv.id, right))
            return &s
        }

        ; Case 3: right is a type variable (left is concrete) — bind it to left.
        if right_embed <> null
        {
            let rv (*right_embed)
            if Planner.occurs_in(rv.id, left)
                return null
            var s Vector[KeyValuePair[size_t, PlannedType]](1)
            s.put(0, KeyValuePair[size_t, PlannedType](rv.id, left))
            return &s
        }

        ; Case 4: both concrete.

        ; `void` unifies with anything (null literal compatibility).
        if left.name.equals("void")
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]](0)
            return &empty
        }
        if right.name.equals("void")
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]](0)
            return &empty
        }

        ; Any pair of integer families unify trivially (the Emitter
        ; inserts the cast).
        if Planner.are_compatible_integer_types(left.name, right.name)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]](0)
            return &empty
        }

        ; null literal (pointer[void]) as the None of any Option type.
        if Planner.is_option_vs_void_pointer(left, right)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]](0)
            return &empty
        }
        if Planner.is_option_vs_void_pointer(right, left)
        {
            var empty Vector[KeyValuePair[size_t, PlannedType]](0)
            return &empty
        }

        ; Names must match.
        if left.name.equals(right.name) = false
            return null

        ; Arities must match.
        var l_len: size_t 0
        var r_len: size_t 0
        if left.generics <> null
        {
            let lg (*left.generics)
            set l_len: lg.length
        }
        if right.generics <> null
        {
            let rg (*right.generics)
            set r_len: rg.length
        }
        if l_len <> r_len
            return null

        ; Unify generic args pairwise, composing substitutions.
        var result Vector[KeyValuePair[size_t, PlannedType]](0)
        if left.generics <> null
        {
            if right.generics <> null
            {
                let lg (*left.generics)
                let rg (*right.generics)
                var i: size_t 0
                while i < l_len
                {
                    let lg_ptr lg.get i
                    let rg_ptr rg.get i
                    if lg_ptr <> null
                    {
                        if rg_ptr <> null
                        {
                            let lgv (*lg_ptr)
                            let rgv (*rg_ptr)
                            let sub Planner.unify(lgv, rgv)
                            if sub = null
                                return null

                            set result: Planner.compose_substitutions(result, (*sub))
                        }
                    }
                    set i: i + 1
                }
            }
        }

        &result
    }

    ; solve_constraints: classical HM solver. Walk the constraint list
    ; in order, applying the current solution to each constraint's sides,
    ; unifying them, and composing the new substitution into the solution.
    ; Instance (trait) constraints are skipped — matches the TODO in
    ; Planner.cpp. Returns null on any unification failure.
    function solve_constraints(
        constraints: ref[Vector[TypeConstraint]]?
    ) returns ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    {
        var solution Vector[KeyValuePair[size_t, PlannedType]](0)

        if constraints = null
            return &solution

        let cs (*constraints)
        var i: size_t 0
        while i < cs.length
        {
            let c_ptr cs.get i
            if c_ptr <> null
            {
                let c (*c_ptr)
                let new_solution choose c
                    when eq: EqualityConstraint
                    {
                        let left_applied Planner.apply_substitution(eq.left, &solution)
                        let right_applied Planner.apply_substitution(eq.right, &solution)
                        let sub Planner.unify(left_applied, right_applied)
                        if sub = null
                            return null

                        Planner.compose_substitutions(solution, (*sub))
                    }
                    when inst: InstanceConstraint
                        solution
                set solution: new_solution
            }
            set i: i + 1
        }

        &solution
    }

    ; compose_substitutions: S2 ∘ S1 — apply S1 first, then S2.
    ; Equivalent to the C++ `composeSubstitutions`:
    ;   Result = S2 ⊎ { (id, apply(T, S2)) | (id, T) ∈ S1 }
    ; with S1's entries winning on duplicate ids (since the C++ map
    ; assignment overwrites). We implement the dedup by first emitting
    ; every S1 entry with its S2-applied value, then appending only the
    ; S2 entries whose id did not already appear in S1.
    function compose_substitutions(
        s1: Vector[KeyValuePair[size_t, PlannedType]],
        s2: Vector[KeyValuePair[size_t, PlannedType]]
    ) returns Vector[KeyValuePair[size_t, PlannedType]]
    {
        var temp Array[KeyValuePair[size_t, PlannedType]]()

        var i: size_t 0
        while i < s1.length
        {
            let ptr s1.get i
            if ptr <> null
            {
                let kvp (*ptr)
                let applied Planner.apply_substitution(kvp.value, &s2)
                temp.add(KeyValuePair[size_t, PlannedType](kvp.key, applied))
            }
            set i: i + 1
        }

        var j: size_t 0
        while j < s2.length
        {
            let ptr s2.get j
            if ptr <> null
            {
                let kvp (*ptr)
                let already Planner.substitution_lookup(s1, kvp.key)
                if already = null
                    temp.add kvp
            }
            set j: j + 1
        }

        Vector[KeyValuePair[size_t, PlannedType]](temp)
    }

    ; occurs_in: does a type variable with the given id appear anywhere in
    ; `t` (or its recursive generic arguments)? The occurs check prevents
    ; the unifier from constructing infinite types like T ~ List[T].
    function occurs_in(var_id: size_t, t: PlannedType) returns bool
    {
        if t.variable <> null
        {
            let tv (*t.variable)
            if tv.id = var_id
                return true
        }
        if t.generics <> null
        {
            let gens (*t.generics)
            var i: size_t 0
            while i < gens.length
            {
                let g_ptr gens.get i
                if g_ptr <> null
                {
                    let g (*g_ptr)
                    if Planner.occurs_in(var_id, g)
                        return true
                }
                set i: i + 1
            }
        }
        false
    }

    ; are_compatible_integer_types: trivial wrapper around is_integer_type.
    ; Kept as a named predicate so call sites read like their C++ counterparts.
    function are_compatible_integer_types(left: String, right: String) returns bool
    {
        if Planner.is_integer_type(left) = false
            return false
        Planner.is_integer_type right
    }

    ; ========================================================================
    ; Operator identification.
    ; ========================================================================

    ; is_operator_name: does this identifier look like an operator definition?
    ; Mirrors Planner.cpp — the one "name-shaped" exception is `abs`, which
    ; the grammar exposes as a unary prefix operator despite being spelled
    ; alphabetically. Everything else keys off the first byte.
    function is_operator_name(name: String) returns bool
    {
        if name.get_length() = 0
            return false

        if name.equals("abs")
            return true
        ; `not` is the alphabetically-spelled prefix synonym for `!`
        ; (like `abs`) — recognised here so the prefix path fires.
        if name.equals("not")
            return true

        let first name.get 0
        if first = ("+" as u8)
            return true
        if first = ("-" as u8)
            return true
        if first = ("*" as u8)
            return true
        if first = ("/" as u8)
            return true
        if first = ("%" as u8)
            return true
        if first = ("=" as u8)
            return true
        if first = ("<" as u8)
            return true
        if first = (">" as u8)
            return true
        if first = ("!" as u8)
            return true
        if first = ("&" as u8)
            return true
        if first = ("|" as u8)
            return true
        if first = ("^" as u8)
            return true
        if first = ("~" as u8)
            return true
        if first = ("[" as u8)
            return true
        if first = ("(" as u8)
            return true
        false
    }

    ; get_operator_precedence: higher = binds tighter. Mirrors
    ; Planner.cpp:1418-1431 exactly. Used by collapse_operand_sequence#
    ; to climb precedence so `A <> X & B <> Y` collapses as
    ; `(A <> X) & (B <> Y)` rather than `((A <> X) & B) <> Y`.
    function get_operator_precedence(name: String) returns int
    {
        if name.equals("||")
            return 1
        if name.equals("or")
            return 1
        if name.equals("&&")
            return 2
        if name.equals("and")
            return 2
        if name.equals("|")
            return 3
        if name.equals("^")
            return 4
        if name.equals("&")
            return 5
        if name.equals("=")
            return 6
        if name.equals("<>")
            return 6
        if name.equals("<")
            return 7
        if name.equals(">")
            return 7
        if name.equals("<=")
            return 7
        if name.equals(">=")
            return 7
        if name.equals("<<")
            return 8
        if name.equals(">>")
            return 8
        if name.equals("+")
            return 9
        if name.equals("-")
            return 9
        if name.equals("*")
            return 10
        if name.equals("/")
            return 10
        if name.equals("%")
            return 10
        if name.equals("div")
            return 10
        if name.equals("mod")
            return 10
        0
    }

    ; ========================================================================
    ; Function-signature helpers.
    ; ========================================================================

    ; join_dotted_name: "scaly" / "containers" / "String" -> "scaly.containers.String".
    ; Matches the Planner.cpp logic that collapses a Type.Name Vector into
    ; one canonical dotted identifier for primitive/generic-param checks.
    function join_dotted_name(parts: Vector[String]) returns String
    {
        var sb StringBuilder()
        ; Defensive: bail early if the Vector layout is corrupted —
        ; length>0 with data=null. Some Type.name vectors picked up
        ; via plan_type → resolve_type_base end up in this state once
        ; stage-1 walks Planner.scaly, and Vector.get computes
        ; data + i, returning a non-null but invalid 0x8 pointer for
        ; i>0 (caller's null-check passes, then the deref SEGVs).
        if parts.length > 0
        {
            if parts.data = null
                return sb.to_string()
        }
        var i: size_t 0
        while i < parts.length
        {
            if i > 0
                sb.append "."

            let p_ptr parts.get i
            if p_ptr <> null
                sb.append((*p_ptr))

            set i: i + 1
        }
        sb.to_string()
    }

    ; is_extern_impl: detect the Extern variant of Implementation without
    ; leaking a bare choose into the caller's control flow.
    function is_extern_impl(impl: Implementation) returns bool
    {
        choose impl
            when e: Extern
                true
            else
                false
    }

    ; s188: allowlist of data-structure plumbing generics that lookup_method#
    ; may lazily full-instantiate when reached via a method CALL. Restricted
    ; to the machinery HashSet<String> transitively needs — making EVERY
    ; generic concept real this way also activates latent-broken paths the
    ; baseline masks with stubs (HashMap/HashMapBuilder<String,Nameable> in
    ; the Modeler symbol table → reallocate→page SIGSEGV) and test-only
    ; instantiations (Option/Result/Slice from containers::test_*).
    function is_lazy_machinery_generic(name: String) returns bool
    {
        if name.equals("BuilderList") = false
            if name.equals("BuilderListIterator") = false
                if name.equals("ListIterator") = false
                    if name.equals("VectorIterator") = false
                        if name.equals("Vector") = false
                            if name.equals("Node") = false
                                if name.equals("Slot") = false
                                    if name.equals("KeyValuePair") = false
                                        return false
        true
    }

    ; s200: Option/Result method calls on REAL-union instantiations
    ; (Option[int], Result[int,bool]) may lazily instantiate — they are
    ; UNIONS, so the plan_type# route (Structure-gated) never emits their
    ; method bodies and a user's `o.is_some()` linked against nothing (the
    ; s189 user-program hole). GATED on every generic arg being non-ref/
    ; non-pointer: adding Option to is_lazy_machinery_generic blanketly
    ; instantiates the compiler's own NPO `ref[T]?` Options, whose generic
    ; bodies hit the escape checker (Emitter.scaly:37 "reference into a
    ; local page escapes via return", rc 4) and DIVERGE the fixed point —
    ; the s188 warning, reproduced 2026-07-06. NPO Options stay on the
    ; intrinsic unwrap path.
    function is_lazy_real_union(name: String, generics: ref[Vector[PlannedType]]?) returns bool
    {
        var is_or: bool false
        if name.equals("Option")
            set is_or: true
        if name.equals("Result")
            set is_or: true
        if is_or = false
            return false
        if generics = null
            return false
        let gens (*generics)
        if gens.length = 0
            return false
        var gi: size_t 0
        while gi < gens.length
        {
            let gp gens.get gi
            if gp <> null
            {
                if (*gp).name.equals("ref")
                    return false
                if (*gp).name.equals("pointer")
                    return false
            }
            set gi: gi + 1
        }
        true
    }

    ; is_runtime_opaque_struct: the non-generic scaly-stdlib structs whose
    ; LLVM layout map_type intentionally keeps OPAQUE (String → literal
    ; { ptr }, Page/PageList/... → plain ptr). The s176 note records that
    ; registering their real layouts flips them from ptr to full structs
    ; throughout, changing every ABI decision stage-1 makes and emptying
    ; stage-2's modules. The on-demand cross-package layout registration
    ; (ensure_member_layout#) must NEVER touch these — so String stays
    ; { ptr } whether the compilation root is scaly, scalyc, or scalyls,
    ; keeping the compiler fixed point byte-identical. Generic stdlib
    ; containers (Vector/Array/HashMap/...) need no entry here: the caller
    ; already skips parameterized concepts.
    function is_runtime_opaque_struct(name: String) returns bool
    {
        if name.equals("String")
            return true
        if name.equals("StringBuilder")
            return true
        if name.equals("StringIterator")
            return true
        if name.equals("Page")
            return true
        if name.equals("PageList")
            return true
        if name.equals("PageListIterator")
            return true
        if name.equals("PageNode")
            return true
        if name.equals("Path")
            return true
        if name.equals("File")
            return true
        if name.equals("Directory")
            return true
        if name.equals("Console")
            return true
        if name.equals("FileError")
            return true
        if name.equals("BlockWatermark")
            return true
        if name.equals("HeapBucketHeader")
            return true
        if name.equals("StackBucketHeader")
            return true
        if name.equals("TraceEntry")
            return true
        false
    }

    ; is_generic_type_param_name: single ASCII uppercase letter — how the
    ; grammar encodes a type parameter like `T`, `K`, `V`. Such names
    ; don't get an implicit return page because the instantiator picks
    ; the real type later.
    function is_generic_type_param_name(name: String) returns bool
    {
        if name.get_length() = 1
        {
            let c name.get 0
            if c >= (65 as u8)
            {
                if c <= (90 as u8)
                    return true
            }
        }
        false
    }

    ; needs_implicit_return_page: does a function whose return type is
    ; known-non-primitive need an implicit page parameter so the caller
    ; can allocate the returned struct?
    ;
    ; Matches Planner.cpp exactly except for the leading `PageParameter`
    ; check — Scaly's Model.Function does not (yet) record whether a
    ; function was declared with `#`; treat every function uniformly for
    ; now. Extern functions bail early because they don't participate in
    ; RBMM.
    function needs_implicit_return_page(func: Function) returns bool
    {
        if Planner.is_extern_impl(func.implementation)
            return false

        if func.returns_ = null
            return false

        let ret_type (*func.returns_)
        if ret_type.name.length = 0
            return false

        let joined Planner.join_dotted_name(ret_type.name)
        if Planner.is_primitive_type_name(joined)
            return false

        if Planner.is_generic_type_param_name(joined)
            return false

        true
    }

    ; ---- Interprocedural collector-procedure page inference ----
    ; A VOID procedure that stores a freshly-constructed value into a non-`this`
    ; ref/pointer parameter via `param.add(...)` / `param.put(...)` must receive
    ; the caller's page (rp), exactly like a `#`-procedure: the values it builds
    ; (e.g. build_referenced_module#'s Module) have to outlive this frame and
    ; land on the caller's page, not this frame's local page (freed on return).
    ; This is the interprocedural counterpart of needs_implicit_return_page for
    ; collector procedures — handle_module_decl / handle_package_decl in the
    ; de-sigiled Modeler, which append loaded sub-modules into a `&modules`
    ; out-parameter. Detected by a shallow Model-body scan for the
    ; put/add-on-ref-param shape (Form A / Form B of collect_store_value_locals#).
    ; Cheap-gated: false for non-void (needs_implicit_return_page covers those),
    ; externs, and functions with no non-`this` ref/pointer parameter.
    ;
    ; NEUTRAL on the sigiled source: the only two functions it flags are already
    ; `#` (page_parameter set), so the page decision is unchanged everywhere it
    ; fires. function_needs_caller_page unifies it with needs_implicit_return_page
    ; at every page-decision site (mangled `…PageE` suffix, page_param_ref="rp",
    ; requires_page_param on calls).
    function is_ref_or_pointer_type(t: scalyc.compiler.Model.Type) returns bool
    {
        if t.name.length <> 1
            return false
        let n0 t.name.get 0
        if n0 = null
            return false
        let n (*n0)
        if n.equals("ref")
            return true
        if n.equals("pointer")
            return true
        false
    }
    function is_ref_pointer_param(func: Function, name: String) returns bool
    {
        var i: size_t 0
        while i < func.input.length
        {
            let ip func.input.get i
            if ip <> null
            {
                let it (*ip)
                if it.name <> null
                    if it.type <> null
                    {
                        let nm (*it.name)
                        if nm.equals(name)
                            if nm.equals("this") = false
                                return Planner.is_ref_or_pointer_type((*it.type))
                    }
            }
            set i: i + 1
        }
        false
    }
    function has_ref_pointer_param(func: Function) returns bool
    {
        var i: size_t 0
        while i < func.input.length
        {
            let ip func.input.get i
            if ip <> null
            {
                let it (*ip)
                if it.name <> null
                    if it.type <> null
                    {
                        let nm (*it.name)
                        if nm.equals("this") = false
                            if Planner.is_ref_or_pointer_type((*it.type))
                                return true
                    }
            }
            set i: i + 1
        }
        false
    }
    ; A single operand sequence is `recv.put(...)` / `recv.add(...)` where recv is
    ; a non-`this` ref/pointer parameter of func. Form A: member_access ends in
    ; put/add with head Type name=["recv"]; Form B: dotted name ["recv","put"]
    ; with member_access=null (the shape the tree-builders actually emit).
    function op_seq_stores_into_ref_param(func: Function, ops: Vector[Operand]) returns bool
    {
        if ops.length < 2
            return false
        let head_ptr ops.get 0
        if head_ptr = null
            return false
        let head (*head_ptr)
        if head.member_access <> null
        {
            let ma (*head.member_access)
            if ma.length >= 1
            {
                let last_ptr ma.get(ma.length - 1)
                if last_ptr <> null
                {
                    let meth (*last_ptr)
                    if meth.equals("put") || meth.equals("add")
                        choose head.expression
                            when t: scalyc.compiler.Model.Type
                            {
                                if t.name.length = 1
                                {
                                    let rn_ptr t.name.get 0
                                    if rn_ptr <> null
                                        if Planner.is_ref_pointer_param(func, (*rn_ptr))
                                            return true
                                }
                            }
                            else
                                0
                }
            }
        }
        if head.member_access = null
            choose head.expression
                when t: scalyc.compiler.Model.Type
                {
                    if t.name.length = 2
                    {
                        let meth_ptr t.name.get 1
                        if meth_ptr <> null
                        {
                            let meth (*meth_ptr)
                            if meth.equals("put") || meth.equals("add")
                            {
                                let rn_ptr t.name.get 0
                                if rn_ptr <> null
                                    if Planner.is_ref_pointer_param(func, (*rn_ptr))
                                        return true
                            }
                        }
                    }
                }
                else
                    0
        false
    }
    ; Walk a body Action: either a single Block operand (the common
    ; multi-statement body) whose top-level Action statements are scanned, or a
    ; direct store operand sequence (single-statement body).
    function action_stores_into_ref_param(func: Function, a: Action) returns bool
    {
        if Planner.op_seq_stores_into_ref_param(func, a.source)
            return true
        if a.source.length = 1
        {
            let op_ptr a.source.get 0
            if op_ptr <> null
            {
                let op (*op_ptr)
                choose op.expression
                    when b: Block
                    {
                        var i: size_t 0
                        while i < b.statements.length
                        {
                            let sp b.statements.get i
                            if sp <> null
                                choose sp.unwrap()
                                    when sa: Action
                                        if Planner.op_seq_stores_into_ref_param(func, sa.source)
                                            return true
                                    else
                                        0
                            set i: i + 1
                        }
                    }
                    else
                        0
            }
        }
        false
    }
    function proc_needs_caller_page_for_storage(func: Function) returns bool
    {
        if func.returns_ <> null
            return false
        if Planner.is_extern_impl(func.implementation)
            return false
        if Planner.has_ref_pointer_param(func) = false
            return false
        choose func.implementation
            when a: Action
                return Planner.action_stores_into_ref_param(func, a)
            else
                0
        false
    }
    ; ---- body-^rp-scan: a function whose body constructs anything with a
    ; `^rp` reference lifetime (`String^rp(...)` / `Vector[T]^rp(...)`) needs the
    ; caller's page even when its return type is primitive (ref/void/bool) —
    ; needs_implicit_return_page only inspects the RETURN TYPE. The escape-
    ; analysis/promotion helpers (collect_*/promote_*/scan_top_level_returns/
    ; add_escaping_*) build promoted rp-allocated operands via `^rp`; de-sigiled
    ; without a page, those `^rp` allocations have no rp local — the promotion
    ; silently lands on the local page and fails, and the values it was meant to
    ; promote (e.g. find_break_type_in_*'s returned PlannedType) then escape.
    ; A recursive Model-body walk. It RETURNS bool and STORES NOTHING — no
    ; borrowed-String lifetime hazard, so it needs no page itself (cf. the
    ; disproven "Model-union-by-value" fear: a recursive Model walk that only
    ; reads is fine). PRECISE: only a Type carrying Lifetime.Reference("rp")
    ; counts — type ANNOTATIONS carry Unspecified, never Reference — so it never
    ; spuriously flips has_page. NEUTRAL on the sigiled source: every function it
    ; flags is still `#` there (page_parameter set → has_page already true).
    function type_has_rp_lifetime(t: scalyc.compiler.Model.Type) returns bool
    {
        choose t.lifetime
            when r: Reference
                return r.location.equals("rp")
            else
                return false
        false
    }
    ; The `^rp` on a GENERIC construction (`Vector[T]^rp(...)`) rides the Matrix
    ; operand's life, NOT the leading Type's lifetime (the s107 split). The
    ; `#`-scan (operand_has_call_life) checks Matrix.life via lifetime_is_call;
    ; the `^rp`-scan below must be symmetric, else a function whose only rp use is
    ; a `Vector[T]^rp(...)` construction is not recognised as needing rp on its
    ; own — it then depends on the transitive page-set reaching it through a
    ; `^rp`-storing callee, which silently breaks the moment that callee drops its
    ; `^rp`. The compiler source currently has NO `^rp` (all migrated to
    ; `#`/`^this`/local), so this is behaviour-neutral today; it is a correctness
    ; fix that keeps the two lifetime scans symmetric and guards reintroduction.
    function lifetime_is_rp(lt: Lifetime) returns bool
    {
        choose lt
            when r: Reference
                return r.location.equals("rp")
            else
                return false
        false
    }
    function ops_reference_rp(ops: Vector[Operand]) returns bool
    {
        var i: size_t 0
        while i < ops.length
        {
            let op_ptr ops.get i
            if op_ptr <> null
                if Planner.operand_references_rp(op_ptr.unwrap())
                    return true
            set i: i + 1
        }
        false
    }
    function binding_references_rp(b: Binding) returns bool
    {
        Planner.ops_reference_rp(b.operation)
    }
    function statement_references_rp(s: Statement) returns bool
    {
        choose s
            when a: Action
            {
                if Planner.ops_reference_rp(a.source)
                    return true
                if Planner.ops_reference_rp(a.target)
                    return true
            }
            when bd: Binding
                if Planner.binding_references_rp(bd)
                    return true
            when r: Return
                if Planner.ops_reference_rp(r.result)
                    return true
            when th: Throw
                if Planner.ops_reference_rp(th.result)
                    return true
            when br: Break
                if Planner.ops_reference_rp(br.result)
                    return true
            else
                0
        false
    }
    function action_references_rp(a: Action) returns bool
    {
        if Planner.ops_reference_rp(a.source)
            return true
        Planner.ops_reference_rp(a.target)
    }
    function operand_references_rp(op: Operand) returns bool
    {
        choose op.expression
            when t: scalyc.compiler.Model.Type
                if Planner.type_has_rp_lifetime(t)
                    return true
            when tup: Tuple
            {
                var i: size_t 0
                while i < tup.components.length
                {
                    let cp tup.components.get i
                    if cp <> null
                        if Planner.ops_reference_rp((*cp).value)
                            return true
                    set i: i + 1
                }
            }
            when mx: Matrix
            {
                if Planner.lifetime_is_rp(mx.life)
                    return true
                var i: size_t 0
                while i < mx.operations.length
                {
                    let rp_ptr mx.operations.get i
                    if rp_ptr <> null
                        if Planner.ops_reference_rp((*rp_ptr))
                            return true
                    set i: i + 1
                }
            }
            when b: Block
            {
                var i: size_t 0
                while i < b.statements.length
                {
                    let sp b.statements.get i
                    if sp <> null
                        if Planner.statement_references_rp(sp.unwrap())
                            return true
                    set i: i + 1
                }
            }
            when iff: scalyc.compiler.Model.If
            {
                if Planner.ops_reference_rp(iff.condition)
                    return true
                if Planner.statement_references_rp(iff.consequent)
                    return true
                if iff.alternative <> null
                    if Planner.statement_references_rp((*iff.alternative))
                        return true
            }
            when ch: Choose
            {
                if Planner.ops_reference_rp(ch.condition)
                    return true
                var i: size_t 0
                while i < ch.cases.length
                {
                    let wp ch.cases.get i
                    if wp <> null
                        if Planner.statement_references_rp((*wp).consequent)
                            return true
                    set i: i + 1
                }
                if ch.alternative <> null
                    if Planner.statement_references_rp((*ch.alternative))
                        return true
            }
            when m: Match
            {
                if Planner.ops_reference_rp(m.condition)
                    return true
                var i: size_t 0
                while i < m.branches.length
                {
                    let bp m.branches.get i
                    if bp <> null
                        if Planner.statement_references_rp((*bp).consequent)
                            return true
                    set i: i + 1
                }
                if m.alternative <> null
                    if Planner.statement_references_rp((*m.alternative))
                        return true
            }
            when fo: For
            {
                if Planner.ops_reference_rp(fo.expression)
                    return true
                if Planner.action_references_rp(fo.action)
                    return true
            }
            when wh: While
            {
                if Planner.binding_references_rp(wh.condition)
                    return true
                if Planner.action_references_rp(wh.action)
                    return true
            }
            when rep: Repeat
                if Planner.action_references_rp(rep.action)
                    return true
            when tr: Try
            {
                if Planner.binding_references_rp(tr.binding)
                    return true
                var i: size_t 0
                while i < tr.catches.length
                {
                    let wp tr.catches.get i
                    if wp <> null
                        if Planner.statement_references_rp((*wp).consequent)
                            return true
                    set i: i + 1
                }
                if tr.alternative <> null
                    if Planner.statement_references_rp((*tr.alternative))
                        return true
            }
            when az: As
                if Planner.type_has_rp_lifetime(az.target_type)
                    return true
            when nw: New
            {
                if Planner.type_has_rp_lifetime(nw.type)
                    return true
                var i: size_t 0
                while i < nw.arguments.components.length
                {
                    let cp nw.arguments.components.get i
                    if cp <> null
                        if Planner.ops_reference_rp((*cp).value)
                            return true
                    set i: i + 1
                }
            }
            when so: SizeOf
                if Planner.type_has_rp_lifetime(so.type)
                    return true
            when ao: AlignOf
                if Planner.type_has_rp_lifetime(ao.type)
                    return true
            when lam: Lambda
                if Planner.action_references_rp(lam.body)
                    return true
            else
                0
        false
    }
    ; A function whose body constructs anything with a `^rp` reference lifetime
    ; needs the caller's page (see the walker above).
    function body_references_rp(func: Function) returns bool
    {
        if Planner.is_extern_impl(func.implementation)
            return false
        choose func.implementation
            when a: Action
                return Planner.action_references_rp(a)
            else
                0
        false
    }
    ; ---- body-`#`-scan: does a function body construct anything with a
    ; Call (`#`) lifetime? A `#` construction (`Vector[T]#(acc)`, `String#(...)`)
    ; allocates on the CALLER's page (rp), so the function must receive rp even
    ; when its declared return type is a PRIMITIVE (ref/pointer) that
    ; needs_implicit_return_page does not cover. This is exactly the
    ; `parse_X_list` shape: `returns ref[Vector[XSyntax]]?` with an implicit
    ; return `Vector[XSyntax]#(acc)`. Mirrors the body-`^rp` walker above but
    ; tests `Lifetime.Call` on a Type AND on a Matrix.life (a GENERIC
    ; construction `Vector[T]#(...)` carries its lifetime on the Matrix operand
    ; per s107, not the bare Type). Structurally identical recursion.
    ;
    ; NEUTRAL on the sigiled source: any function with a `#` construction in its
    ; body is already a `#` decl there (the `#` needs an rp to allocate on), so
    ; page_parameter is set and has_page is true regardless — this clause only
    ; ever ADDS a page for a DE-SIGILED primitive-returning function whose body
    ; keeps a genuine caller-page `#` construction.
    function lifetime_is_call(lt: Lifetime) returns bool
    {
        choose lt
            when c: Call
                return true
            else
                return false
        false
    }
    function lifetime_is_local(lt: Lifetime) returns bool
    {
        choose lt
            when l: Local
                return true
            else
                return false
        false
    }
    ; Phase-5 class 1 helpers: the value-guts persist summary. See the
    ; persist_summary_names field comment for the contract and
    ; function_persists_param_guts below for the entry point.
    function persist_names_contain(arr: Array[String], name: String) returns bool
    {
        var i: size_t 0
        while i < arr.length
        {
            let p arr.get i
            if p <> null
                if (*p).equals(name)
                    return true
            set i: i + 1
        }
        false
    }
    ; Does the operand sequence (from index `start`) mention one of `pnames`
    ; BARE — a single-segment name operand, at top level or nested inside a
    ; construction WITHOUT an explicit lifetime? A `^this`/`^page`/`#`
    ; construction re-homes or deep-copies its content (String^this(name) in
    ; the escape collectors), so a param nested under one is NOT persisted
    ; shallowly; a bare data-class construction copies the param struct
    ; SHALLOWLY, so its page guts escape with it (PlannerDiagnostic(...,
    ; message, ...) in add_diagnostic).
    function persist_value_mentions_param(ops: Vector[Operand], start: size_t, pnames: Array[String]) returns bool
    {
        var prev_explicit_life false
        var i start
        while i < ops.length
        {
            let op_ptr ops.get i
            if op_ptr <> null
            {
                var cur_explicit_life false
                choose (*op_ptr).expression
                    when ty: scalyc.compiler.Model.Type
                    {
                        choose ty.lifetime
                            when u: Unspecified
                                0
                            else
                                set cur_explicit_life: true
                        if ty.name.length = 1
                        {
                            let s0 ty.name.get 0
                            if s0 <> null
                                if Planner.persist_names_contain(pnames, (*s0))
                                    return true
                        }
                    }
                    when tup: Tuple
                    {
                        if prev_explicit_life = false
                        {
                            var ci: size_t 0
                            while ci < tup.components.length
                            {
                                let cp tup.components.get ci
                                if cp <> null
                                    if Planner.persist_value_mentions_param((*cp).value, 0, pnames)
                                        return true
                                set ci: ci + 1
                            }
                        }
                    }
                    else
                        0
                set prev_explicit_life: cur_explicit_life
            }
            set i: i + 1
        }
        false
    }
    ; Is this operand sequence a put/add into state that outlives the frame
    ; (receiver a this-field or a name that is neither a parameter nor a
    ; body-local, i.e. a field/global reached via the implicit-property
    ; path), whose value mentions a parameter bare?
    function persist_ops_putadd_param(ops: Vector[Operand], pnames: Array[String], locals: Array[String]) returns bool
    {
        if ops.length < 2
            return false
        let op0p ops.get 0
        if op0p = null
            return false
        if (*op0p).member_access <> null
            return false
        var recv_persists false
        choose (*op0p).expression
            when ty: scalyc.compiler.Model.Type
            {
                if ty.name.length > 1
                {
                    let lastp ty.name.get(ty.name.length - 1)
                    if lastp <> null
                    {
                        var is_putadd false
                        if (*lastp).equals("add")
                            set is_putadd: true
                        if (*lastp).equals("put")
                            set is_putadd: true
                        if is_putadd
                        {
                            let s0p ty.name.get 0
                            if s0p <> null
                            {
                                let s0 (*s0p)
                                if s0.equals("this")
                                {
                                    ; this.field.add(...) — needs a field hop
                                    if ty.name.length > 2
                                        set recv_persists: true
                                }
                                else
                                {
                                    var s0_known false
                                    if Planner.persist_names_contain(pnames, s0)
                                        set s0_known: true
                                    if Planner.persist_names_contain(locals, s0)
                                        set s0_known: true
                                    if s0_known = false
                                        set recv_persists: true
                                }
                            }
                        }
                    }
                }
            }
            else
                0
        if recv_persists = false
            return false
        Planner.persist_value_mentions_param(ops, 1, pnames)
    }
    ; Walk the TOP statement level of a body block: collect Binding names
    ; as body-locals first (a local container receiver is frame state, not
    ; persistence), then test each Action's operand sequence. Nested
    ; control-flow putadds stay unclassified in this increment — their
    ; call sites keep pre-rule behavior.
    function persist_scan_statements(stmts: Vector[Statement], pnames: Array[String]) returns bool
    {
        var locals Array[String]()
        var i: size_t 0
        while i < stmts.length
        {
            let sp stmts.get i
            if sp <> null
                choose (*sp)
                    when b: scalyc.compiler.Model.Binding
                    {
                        if b.item.name <> null
                            locals.add((*b.item.name))
                    }
                    else
                        0
            set i: i + 1
        }
        set i: 0
        while i < stmts.length
        {
            let sp stmts.get i
            if sp <> null
                choose (*sp)
                    when a: scalyc.compiler.Model.Action
                        if Planner.persist_ops_putadd_param(a.source, pnames, locals)
                            return true
                    else
                        0
            set i: i + 1
        }
        false
    }
    ; Entry point: does f's body store a parameter's page-guts VALUE into
    ; state that outlives its frame? True for add_error (`errors.add
    ; message`) and add_diagnostic (`diagnostics.add(PlannerDiagnostic(...,
    ; message, ...))`); false for the deep-copying escape collectors
    ; (`escaping_return_locals.add(String^this(name))` — explicit-lifetime
    ; construction excluded) and for putadds into body-local containers.
    function function_persists_param_guts(f: Function) returns bool
    {
        var pnames Array[String]()
        var pi: size_t 0
        while pi < f.input.length
        {
            let ip f.input.get pi
            if ip <> null
                if (*ip).name <> null
                {
                    let pn (*(*ip).name)
                    if pn.equals("this") = false
                        pnames.add pn
                }
            set pi: pi + 1
        }
        if pnames.length = 0
            return false
        var found false
        choose f.implementation
            when a: scalyc.compiler.Model.Action
            {
                var scanned_block false
                if a.source.length = 1
                {
                    let op0 a.source.get 0
                    if op0 <> null
                        choose (*op0).expression
                            when bk: Block
                            {
                                set scanned_block: true
                                if Planner.persist_scan_statements(bk.statements, pnames)
                                    set found: true
                            }
                            else
                                0
                }
                if scanned_block = false
                {
                    var no_locals Array[String]()
                    if Planner.persist_ops_putadd_param(a.source, pnames, no_locals)
                        set found: true
                }
            }
            else
                0
        found
    }
    function type_has_call_lifetime(t: scalyc.compiler.Model.Type) returns bool
        Planner.lifetime_is_call(t.lifetime)
    function ops_have_call_life(ops: Vector[Operand]) returns bool
    {
        var i: size_t 0
        while i < ops.length
        {
            let op_ptr ops.get i
            if op_ptr <> null
                if Planner.operand_has_call_life(op_ptr.unwrap())
                    return true
            set i: i + 1
        }
        false
    }
    function binding_has_call_life(b: Binding) returns bool
    {
        Planner.ops_have_call_life(b.operation)
    }
    function statement_has_call_life(s: Statement) returns bool
    {
        choose s
            when a: Action
            {
                if Planner.ops_have_call_life(a.source)
                    return true
                if Planner.ops_have_call_life(a.target)
                    return true
            }
            when bd: Binding
                if Planner.binding_has_call_life(bd)
                    return true
            when r: Return
                if Planner.ops_have_call_life(r.result)
                    return true
            when th: Throw
                if Planner.ops_have_call_life(th.result)
                    return true
            when br: Break
                if Planner.ops_have_call_life(br.result)
                    return true
            else
                0
        false
    }
    function action_has_call_life(a: Action) returns bool
    {
        if Planner.ops_have_call_life(a.source)
            return true
        Planner.ops_have_call_life(a.target)
    }
    function operand_has_call_life(op: Operand) returns bool
    {
        choose op.expression
            when t: scalyc.compiler.Model.Type
                if Planner.type_has_call_lifetime(t)
                    return true
            when tup: Tuple
            {
                var i: size_t 0
                while i < tup.components.length
                {
                    let cp tup.components.get i
                    if cp <> null
                        if Planner.ops_have_call_life((*cp).value)
                            return true
                    set i: i + 1
                }
            }
            when mx: Matrix
            {
                if Planner.lifetime_is_call(mx.life)
                    return true
                var i: size_t 0
                while i < mx.operations.length
                {
                    let rp_ptr mx.operations.get i
                    if rp_ptr <> null
                        if Planner.ops_have_call_life((*rp_ptr))
                            return true
                    set i: i + 1
                }
            }
            when b: Block
            {
                var i: size_t 0
                while i < b.statements.length
                {
                    let sp b.statements.get i
                    if sp <> null
                        if Planner.statement_has_call_life(sp.unwrap())
                            return true
                    set i: i + 1
                }
            }
            when iff: scalyc.compiler.Model.If
            {
                if Planner.ops_have_call_life(iff.condition)
                    return true
                if Planner.statement_has_call_life(iff.consequent)
                    return true
                if iff.alternative <> null
                    if Planner.statement_has_call_life((*iff.alternative))
                        return true
            }
            when ch: Choose
            {
                if Planner.ops_have_call_life(ch.condition)
                    return true
                var i: size_t 0
                while i < ch.cases.length
                {
                    let wp ch.cases.get i
                    if wp <> null
                        if Planner.statement_has_call_life((*wp).consequent)
                            return true
                    set i: i + 1
                }
                if ch.alternative <> null
                    if Planner.statement_has_call_life((*ch.alternative))
                        return true
            }
            when m: Match
            {
                if Planner.ops_have_call_life(m.condition)
                    return true
                var i: size_t 0
                while i < m.branches.length
                {
                    let bp m.branches.get i
                    if bp <> null
                        if Planner.statement_has_call_life((*bp).consequent)
                            return true
                    set i: i + 1
                }
                if m.alternative <> null
                    if Planner.statement_has_call_life((*m.alternative))
                        return true
            }
            when fo: For
            {
                if Planner.ops_have_call_life(fo.expression)
                    return true
                if Planner.action_has_call_life(fo.action)
                    return true
            }
            when wh: While
            {
                if Planner.binding_has_call_life(wh.condition)
                    return true
                if Planner.action_has_call_life(wh.action)
                    return true
            }
            when rep: Repeat
                if Planner.action_has_call_life(rep.action)
                    return true
            when tr: Try
            {
                if Planner.binding_has_call_life(tr.binding)
                    return true
                var i: size_t 0
                while i < tr.catches.length
                {
                    let wp tr.catches.get i
                    if wp <> null
                        if Planner.statement_has_call_life((*wp).consequent)
                            return true
                    set i: i + 1
                }
                if tr.alternative <> null
                    if Planner.statement_has_call_life((*tr.alternative))
                        return true
            }
            when nw: New
            {
                if Planner.type_has_call_lifetime(nw.type)
                    return true
                var i: size_t 0
                while i < nw.arguments.components.length
                {
                    let cp nw.arguments.components.get i
                    if cp <> null
                        if Planner.ops_have_call_life((*cp).value)
                            return true
                    set i: i + 1
                }
            }
            when lam: Lambda
                if Planner.action_has_call_life(lam.body)
                    return true
            else
                0
        false
    }
    function body_has_call_lifetime(func: Function) returns bool
    {
        if Planner.is_extern_impl(func.implementation)
            return false
        choose func.implementation
            when a: Action
                return Planner.action_has_call_life(a)
            else
                0
        false
    }
    ; ---- transitive page-need walker: does a function body MENTION any name in
    ; a set? A sibling CALL's name rides either a member_access hop
    ; (`this.collect_flow_locals(...)`) or a dotted Type-name segment
    ; (`recv.method`), so both are checked. Structurally mirrors the ^rp walker
    ; above. Over-approximate (a coincidental type/variable reference also
    ; matches) — safe, since the set holds only cluster method names and a match
    ; only ever ADDS a page (NEUTRAL on the sigiled source). Used by
    ; build_transitive_page_set's fixpoint.
    function static_name_in_set(names: Array[String], n: String) returns bool
    {
        var i: size_t 0
        while i < names.length
        {
            let p names.get i
            if p <> null
                if (*p).equals(n)
                    return true
            set i: i + 1
        }
        false
    }
    function type_name_mentions_set(t: scalyc.compiler.Model.Type, names: Array[String]) returns bool
    {
        var i: size_t 0
        while i < t.name.length
        {
            let np t.name.get i
            if np <> null
                if Planner.static_name_in_set(names, (*np))
                    return true
            set i: i + 1
        }
        false
    }
    function ops_mention_set(ops: Vector[Operand], names: Array[String]) returns bool
    {
        var i: size_t 0
        while i < ops.length
        {
            let op_ptr ops.get i
            if op_ptr <> null
                if Planner.operand_mentions_set(op_ptr.unwrap(), names)
                    return true
            set i: i + 1
        }
        false
    }
    function binding_mentions_set(b: Binding, names: Array[String]) returns bool
    {
        Planner.ops_mention_set(b.operation, names)
    }
    function statement_mentions_set(s: Statement, names: Array[String]) returns bool
    {
        choose s
            when a: Action
            {
                if Planner.ops_mention_set(a.source, names)
                    return true
                if Planner.ops_mention_set(a.target, names)
                    return true
            }
            when bd: Binding
                if Planner.binding_mentions_set(bd, names)
                    return true
            when r: Return
                if Planner.ops_mention_set(r.result, names)
                    return true
            when th: Throw
                if Planner.ops_mention_set(th.result, names)
                    return true
            when br: Break
                if Planner.ops_mention_set(br.result, names)
                    return true
            else
                0
        false
    }
    function action_mentions_set(a: Action, names: Array[String]) returns bool
    {
        if Planner.ops_mention_set(a.source, names)
            return true
        Planner.ops_mention_set(a.target, names)
    }
    function operand_mentions_set(op: Operand, names: Array[String]) returns bool
    {
        if op.member_access <> null
        {
            let ma (*op.member_access)
            var mi: size_t 0
            while mi < ma.length
            {
                let hp ma.get mi
                if hp <> null
                    if Planner.static_name_in_set(names, (*hp))
                        return true
                set mi: mi + 1
            }
        }
        choose op.expression
            when t: scalyc.compiler.Model.Type
                if Planner.type_name_mentions_set(t, names)
                    return true
            when tup: Tuple
            {
                var i: size_t 0
                while i < tup.components.length
                {
                    let cp tup.components.get i
                    if cp <> null
                        if Planner.ops_mention_set((*cp).value, names)
                            return true
                    set i: i + 1
                }
            }
            when mx: Matrix
            {
                var i: size_t 0
                while i < mx.operations.length
                {
                    let rp_ptr mx.operations.get i
                    if rp_ptr <> null
                        if Planner.ops_mention_set((*rp_ptr), names)
                            return true
                    set i: i + 1
                }
            }
            when b: Block
            {
                var i: size_t 0
                while i < b.statements.length
                {
                    let sp b.statements.get i
                    if sp <> null
                        if Planner.statement_mentions_set(sp.unwrap(), names)
                            return true
                    set i: i + 1
                }
            }
            when iff: scalyc.compiler.Model.If
            {
                if Planner.ops_mention_set(iff.condition, names)
                    return true
                if Planner.statement_mentions_set(iff.consequent, names)
                    return true
                if iff.alternative <> null
                    if Planner.statement_mentions_set((*iff.alternative), names)
                        return true
            }
            when ch: Choose
            {
                if Planner.ops_mention_set(ch.condition, names)
                    return true
                var i: size_t 0
                while i < ch.cases.length
                {
                    let wp ch.cases.get i
                    if wp <> null
                        if Planner.statement_mentions_set((*wp).consequent, names)
                            return true
                    set i: i + 1
                }
                if ch.alternative <> null
                    if Planner.statement_mentions_set((*ch.alternative), names)
                        return true
            }
            when m: Match
            {
                if Planner.ops_mention_set(m.condition, names)
                    return true
                var i: size_t 0
                while i < m.branches.length
                {
                    let bp m.branches.get i
                    if bp <> null
                        if Planner.statement_mentions_set((*bp).consequent, names)
                            return true
                    set i: i + 1
                }
                if m.alternative <> null
                    if Planner.statement_mentions_set((*m.alternative), names)
                        return true
            }
            when fo: For
            {
                if Planner.ops_mention_set(fo.expression, names)
                    return true
                if Planner.action_mentions_set(fo.action, names)
                    return true
            }
            when wh: While
            {
                if Planner.binding_mentions_set(wh.condition, names)
                    return true
                if Planner.action_mentions_set(wh.action, names)
                    return true
            }
            when rep: Repeat
                if Planner.action_mentions_set(rep.action, names)
                    return true
            when tr: Try
            {
                if Planner.binding_mentions_set(tr.binding, names)
                    return true
                var i: size_t 0
                while i < tr.catches.length
                {
                    let wp tr.catches.get i
                    if wp <> null
                        if Planner.statement_mentions_set((*wp).consequent, names)
                            return true
                    set i: i + 1
                }
                if tr.alternative <> null
                    if Planner.statement_mentions_set((*tr.alternative), names)
                        return true
            }
            when az: As
                if Planner.type_name_mentions_set(az.target_type, names)
                    return true
            when nw: New
            {
                if Planner.type_name_mentions_set(nw.type, names)
                    return true
                var i: size_t 0
                while i < nw.arguments.components.length
                {
                    let cp nw.arguments.components.get i
                    if cp <> null
                        if Planner.ops_mention_set((*cp).value, names)
                            return true
                    set i: i + 1
                }
            }
            when so: SizeOf
                if Planner.type_name_mentions_set(so.type, names)
                    return true
            when ao: AlignOf
                if Planner.type_name_mentions_set(ao.type, names)
                    return true
            when lam: Lambda
                if Planner.action_mentions_set(lam.body, names)
                    return true
            else
                0
        false
    }
    function impl_mentions_set(impl: Implementation, names: Array[String]) returns bool
    {
        choose impl
            when a: Action
                return Planner.action_mentions_set(a, names)
            else
                0
        false
    }
    ; Unified page-decision predicate: a function needs the caller's page (rp)
    ; either to allocate a returned struct/union (needs_implicit_return_page), to
    ; store freshly-built values into a ref/pointer out-parameter
    ; (proc_needs_caller_page_for_storage), to build a `^rp`-lifetime value in
    ; its body (body_references_rp), or — transitively — to forward rp to a
    ; sibling that does (transitive_page_names, built by build_transitive_page_
    ; set). Consulted at every has_page / page_param_ref / requires_page_param
    ; site; `pl` supplies the precomputed transitive set.
    function function_needs_caller_page(pl: Planner, func: Function) returns bool
    {
        if Planner.needs_implicit_return_page(func)
            return true
        if Planner.proc_needs_caller_page_for_storage(func)
            return true
        if Planner.body_references_rp(func)
            return true
        ; body-`#`-scan, GATED on a ref/pointer return type. A `parse_X_list`
        ; returns `ref[Vector[XSyntax]]?` (a primitive ref → needs_implicit_return_page
        ; is false) and builds the returned `Vector[XSyntax]#(acc)` on the caller
        ; page; the `#` construction needs rp. The ref/pointer gate confines this
        ; to that caller-page-ref-return shape — WITHOUT it the scan also flips
        ; void / value-returning helpers that merely build a transient `#` value
        ; (e.g. scalyls's rpc/server handlers), whose non-flagged callers then do
        ; not forward rp. NEUTRAL on sigiled source: such a function is already a
        ; `#` decl (the `#` needs an rp), so page_parameter is set and has_page is
        ; true regardless.
        if func.returns_ <> null
            if Planner.is_ref_or_pointer_type((*func.returns_))
                if Planner.body_has_call_lifetime(func)
                    return true
        Planner.static_name_in_set(pl.transitive_page_names, func.name)
    }

    ; ========================================================================
    ; Argument-list helpers.
    ; ========================================================================

    ; Collect the result_type of every operand inside a tuple-shaped operand.
    ; Split out so extract_arg_types can dispatch via a simple choose without
    ; a nested side-effecting match expression.
    function extract_tuple_arg_types(tuple_val: PlannedTuple) returns Vector[PlannedType]
    {
        var temp Array[PlannedType]()
        if tuple_val.components <> null
        {
            let comps (*tuple_val.components)
            var i: size_t 0
            while i < comps.length
            {
                let c_ptr comps.get i
                if c_ptr <> null
                {
                    let c (*c_ptr)
                    if c.value <> null
                    {
                        let vals (*c.value)
                        var j: size_t 0
                        while j < vals.length
                        {
                            let v_ptr vals.get j
                            if v_ptr <> null
                            {
                                let v (*v_ptr)
                                temp.add v.result_type
                            }
                            set j: j + 1
                        }
                    }
                }
                set i: i + 1
            }
        }
        Vector[PlannedType](temp)
    }

    ; extract_arg_types: flatten a function-call argument list (modelled as a
    ; tuple of components) into a plain Vector of argument result types.
    ; A non-tuple operand falls back to its own result_type as a single arg —
    ; the parser may elide the tuple around a single-argument call like
    ; `f(x)` where `x` is already a complete operand.
    function extract_arg_types(args_op: PlannedOperand) returns Vector[PlannedType]
    {
        choose args_op.expr
            when t: PlannedTuple
                Planner.extract_tuple_arg_types(t)
            else
                Vector[PlannedType](null as pointer[PlannedType], 0 as size_t)
    }

    ; ========================================================================
    ; Constant type inference.
    ; ========================================================================

    ; Helper: build a pointer[i8]-typed PlannedType — the representation of
    ; C-style string literals. Shared by StringConstant and FragmentConstant.
    function make_cstring_type(sp: Span) returns PlannedType
    {
        var gens Vector[PlannedType](1)
        let i8_ty PlannedType(
            sp,
            "i8",
            "a",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        gens.put(0, i8_ty)
        PlannedType(
            sp,
            "pointer",
            "Pa",
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
    }

    ; Helper: pointer[void] for the null literal. The constraint solver is
    ; expected to unify this with whatever pointer-like type is required
    ; at the use-site.
    function make_null_type(sp: Span) returns PlannedType
    {
        var gens Vector[PlannedType](1)
        let void_ty PlannedType(
            sp,
            "void",
            "v",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        gens.put(0, void_ty)
        PlannedType(
            sp,
            "pointer",
            "Pv",
            &gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
    }

    ; infer_constant_type: map a Constant variant to the PlannedType assigned
    ; to that literal before the constraint solver runs. Primitive families
    ; carry the Itanium one-letter codes directly; string/fragment/null
    ; delegate to the helpers above.
    function infer_constant_type(c: Constant) returns PlannedType
    {
        choose c
            when b: BooleanConstant
                PlannedType(
                    b.span,
                    "bool",
                    "b",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when i: IntegerConstant
                PlannedType(
                    i.span,
                    "int",
                    "i",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when h: HexConstant
                PlannedType(
                    h.span,
                    "u64",
                    "u64",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when f: FloatingPointConstant
                PlannedType(
                    f.span,
                    "f64",
                    "f64",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when ch: CharacterConstant
                PlannedType(
                    ch.span,
                    "char",
                    "c",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when s: StringConstant
                PlannedType(
                    s.span,
                    "String",
                    "6String",
                    null,
                    Lifetime.Unspecified(Unspecified()),
                    null,
                    "",
                    null
                )
            when fr: FragmentConstant
                Planner.make_cstring_type(fr.span)
            when n: NullConstant
                Planner.make_null_type(n.span)
    }

    ; get_pointer_element_type: return the element type T for pointer[T],
    ; ref[T], Option[pointer[T]], or Option[ref[T]]. Everything else
    ; yields null.
    ;
    ; Planner.cpp also has a "flattened" Option.ref.X fast path to cope
    ; with how monomorphisation mangles nested generics into the name.
    ; That path is a fragile heuristic; leaving it out until we actually
    ; hit a case that needs it.
    function get_pointer_element_type(ptr_type: PlannedType) returns ref[PlannedType]?
    {
        if ptr_type.name.equals("pointer")
        {
            if ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                if gens.length > 0
                    return gens.get 0
            }
        }
        if ptr_type.name.equals("ref")
        {
            if ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                if gens.length > 0
                    return gens.get 0
            }
        }
        if ptr_type.name.equals("Option")
        {
            if ptr_type.generics <> null
            {
                let gens (*ptr_type.generics)
                if gens.length > 0
                {
                    let inner_ptr gens.get 0
                    if inner_ptr <> null
                    {
                        let inner (*inner_ptr)
                        if inner.name.equals("pointer")
                        {
                            if inner.generics <> null
                            {
                                let ig (*inner.generics)
                                if ig.length > 0
                                    return ig.get 0
                            }
                        }
                        if inner.name.equals("ref")
                        {
                            if inner.generics <> null
                            {
                                let ig (*inner.generics)
                                if ig.length > 0
                                    return ig.get 0
                            }
                        }
                    }
                }
            }
        }
        null
    }

    ; get_operator_precedence: higher wins. Returns 0 for unknown operators
    ; so the caller can distinguish "unbound" from explicit parenthesisation.
    ; Scaly uses `=` / `<>` (equal / not-equal) instead of C's `==` / `!=`.
    function get_operator_precedence(op: String) returns int
    {
        if op.equals("||")
            return 1
        if op.equals("or")
            return 1
        if op.equals("&&")
            return 2
        if op.equals("and")
            return 2
        if op.equals("|")
            return 3
        if op.equals("^")
            return 4
        if op.equals("&")
            return 5
        if op.equals("=")
            return 6
        if op.equals("<>")
            return 6
        if op.equals("<")
            return 7
        if op.equals(">")
            return 7
        if op.equals("<=")
            return 7
        if op.equals(">=")
            return 7
        if op.equals("<<")
            return 8
        if op.equals(">>")
            return 8
        if op.equals("+")
            return 9
        if op.equals("-")
            return 9
        if op.equals("*")
            return 10
        if op.equals("/")
            return 10
        if op.equals("%")
            return 10
        if op.equals("div")
            return 10
        if op.equals("mod")
            return 10
        0
    }

    ; size_to_string: decimal representation of a size_t.
    ; Classic divide-by-10 with digit buffer and reversal.
    function size_to_string(n: size_t) returns String
    {
        if n = 0
            return "0"

        let result StringBuilder()
        var value n
        var digits Array[char]()

        while value > 0
        {
            let digit ((value % 10) as char) + 48 as char
            digits.add digit
            set value: value / 10
        }

        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                result.append(*d)

        }

        result.to_string()
    }

    ; ========================================================================
    ; Test entry point, exercised by compiler.test().
    ; Returns 0 on pass, non-zero diagnostic code on failure.
    ; Only touches real helpers — never calls a stub (that would exit 111).
    ; ========================================================================

    function test() returns int
    {
        ; size_to_string - smallest self-contained helper.
        let str0 Planner.size_to_string(0)
        if str0.equals("0") = false
            return 1

        let str4 Planner.size_to_string(4)
        if str4.equals("4") = false
            return 2

        let str42 Planner.size_to_string(42)
        if str42.equals("42") = false
            return 3

        ; encode_name - depends on size_to_string.
        let encoded Planner.encode_name("test")
        if encoded.equals("4test") = false
            return 4

        let encoded2 Planner.encode_name("")
        if encoded2.equals("0") = false
            return 5

        ; strip_package_prefix - only strips when it starts with "scaly."
        let stripped Planner.strip_package_prefix("scaly.containers.String")
        if stripped.equals("String") = false
            return 6

        let unstripped Planner.strip_package_prefix("scalyc.compiler.Planner")
        if unstripped.equals("scalyc.compiler.Planner") = false
            return 7

        ; encode_type - built-in primitive codes.
        let int_ty PlannedType(
            Span(0, 0),
            "int",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let enc_int Planner.encode_type(int_ty)
        if enc_int.equals("i") = false
            return 8

        let bool_ty PlannedType(
            Span(0, 0),
            "bool",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let enc_bool Planner.encode_type(bool_ty)
        if enc_bool.equals("b") = false
            return 9

        ; encode_type - user-defined falls through to encode_name.
        let foo_ty PlannedType(
            Span(0, 0),
            "Foo",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let enc_foo Planner.encode_type(foo_ty)
        if enc_foo.equals("3Foo") = false
            return 10

        ; encode_type - "scaly.containers.String" -> "6String" (prefix stripped).
        let sstr_ty PlannedType(
            Span(0, 0),
            "scaly.containers.String",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let enc_sstr Planner.encode_type(sstr_ty)
        if enc_sstr.equals("6String") = false
            return 11

        ; mangle_type - "_Z" prefix + encoded type.
        let mangled_int Planner.mangle_type(int_ty)
        if mangled_int.equals("_Zi") = false
            return 12

        let mangled_foo Planner.mangle_type(foo_ty)
        if mangled_foo.equals("_Z3Foo") = false
            return 13

        ; mangle_structure - no generics falls back to encode_name.
        let mangled_s Planner.mangle_structure("String", null)
        if mangled_s.equals("_Z6String") = false
            return 14

        ; mangle_structure with one int generic arg: Vector[int] -> _Z6VectorIiE.
        var gens_vec Vector[PlannedType](1)
        gens_vec.put(0, int_ty)
        let mangled_vec Planner.mangle_structure("Vector", &gens_vec)
        if mangled_vec.equals("_Z6VectorIiE") = false
            return 15

        ; mangle_function - free, no params -> _Z3foov.
        let mf_free Planner.mangle_function("foo", null, null, false)
        if mf_free.equals("_Z3foov") = false
            return 16

        ; mangle_function - method on Foo, no params -> _ZN3Foo3fooEv.
        let mf_method Planner.mangle_function("foo", null, &foo_ty, false)
        if mf_method.equals("_ZN3Foo3fooEv") = false
            return 17

        ; mangle_function - 'this' is implicit; drops out of the name.
        let this_name "this"
        var this_only Vector[PlannedItem](1)
        this_only.put(0, PlannedItem(Span(0, 0), false, &this_name, &foo_ty, null))
        let mf_this Planner.mangle_function("bar", &this_only, &foo_ty, false)
        if mf_this.equals("_ZN3Foo3barEv") = false
            return 18

        ; mangle_function with implicit page param.
        let mf_page Planner.mangle_function("foo", null, null, true)
        if mf_page.equals("_Z3fooPN4scaly6memory4PageE") = false
            return 19

        ; mangle_function - free with int param -> _Z3fooi.
        let x_name "x"
        var one_int Vector[PlannedItem](1)
        one_int.put(0, PlannedItem(Span(0, 0), false, &x_name, &int_ty, null))
        let mf_i Planner.mangle_function("foo", &one_int, null, false)
        if mf_i.equals("_Z3fooi") = false
            return 20

        ; operator_code - a few known codes plus vendor extension.
        let op_plus Planner.operator_code("+")
        if op_plus.equals("pl") = false
            return 21

        let op_index Planner.operator_code("[]")
        if op_index.equals("ix") = false
            return 22

        let op_vendor Planner.operator_code("??")
        if op_vendor.equals("v02??") = false
            return 23

        ; mangle_operator - free + with int param -> _Zpli.
        let mop_plus Planner.mangle_operator("+", &one_int, null)
        if mop_plus.equals("_Zpli") = false
            return 24

        ; mangle_operator - member + on Foo with (this, int) -> _ZN3FooplEi.
        var this_int Vector[PlannedItem](2)
        this_int.put(0, PlannedItem(Span(0, 0), false, &this_name, &foo_ty, null))
        this_int.put(1, PlannedItem(Span(0, 0), false, &x_name, &int_ty, null))
        let mop_member Planner.mangle_operator("+", &this_int, &foo_ty)
        if mop_member.equals("_ZN3FooplEi") = false
            return 25

        ; mangle_operator - member with only 'this' -> _ZN3FooneEv (the 'this' skip).
        let mop_this Planner.mangle_operator("!=", &this_only, &foo_ty)
        if mop_this.equals("_ZN3FooneEv") = false
            return 26

        ; get_readable_name - plain type, no generics.
        let rn_int Planner.get_readable_name(int_ty)
        if rn_int.equals("int") = false
            return 27

        ; get_readable_name - generic: Vector[int] -> "Vector[int]".
        var vec_gens Vector[PlannedType](1)
        vec_gens.put(0, int_ty)
        let vec_ty PlannedType(
            Span(0, 0),
            "Vector",
            "",
            &vec_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let rn_vec Planner.get_readable_name(vec_ty)
        if rn_vec.equals("Vector[int]") = false
            return 28

        ; normalize_type_name - builtin aliases collapse.
        let nm_int Planner.normalize_type_name("int")
        if nm_int.equals("i64") = false
            return 29

        let nm_size Planner.normalize_type_name("size_t")
        if nm_size.equals("u64") = false
            return 30

        let nm_char Planner.normalize_type_name("char")
        if nm_char.equals("u8") = false
            return 31

        ; normalize_type_name - "scaly.containers.String" -> "String".
        let nm_sstr Planner.normalize_type_name("scaly.containers.String")
        if nm_sstr.equals("String") = false
            return 32

        ; normalize_type_name - user types pass through.
        let nm_user Planner.normalize_type_name("scalyc.compiler.Planner")
        if nm_user.equals("scalyc.compiler.Planner") = false
            return 33

        ; types_equal - identical primitives.
        if Planner.types_equal(int_ty, int_ty) = false
            return 34

        ; types_equal - int == i64 via normalization.
        let i64_ty PlannedType(
            Span(0, 0),
            "i64",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_equal(int_ty, i64_ty) = false
            return 35

        ; types_equal - different primitives.
        if Planner.types_equal(int_ty, bool_ty)
            return 36

        ; types_equal - structurally equal generics.
        var vec_gens2 Vector[PlannedType](1)
        vec_gens2.put(0, int_ty)
        let vec_ty2 PlannedType(
            Span(0, 0),
            "Vector",
            "",
            &vec_gens2,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_equal(vec_ty, vec_ty2) = false
            return 37

        ; types_equal - same outer name, different generic arg.
        var vec_gens_b Vector[PlannedType](1)
        vec_gens_b.put(0, bool_ty)
        let vec_bool_ty PlannedType(
            Span(0, 0),
            "Vector",
            "",
            &vec_gens_b,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_equal(vec_ty, vec_bool_ty)
            return 38

        ; is_integer_type - a couple of positive and negative cases.
        if Planner.is_integer_type("i64") = false
            return 39
        if Planner.is_integer_type("bool")
            return 40

        ; types_compatible - exact equality.
        if Planner.types_compatible(int_ty, int_ty) = false
            return 41

        ; types_compatible - integer coercion (int <-> i64 is already equal,
        ;                                      so pair a distinct integer family).
        let u32_ty PlannedType(
            Span(0, 0),
            "u32",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_compatible(int_ty, u32_ty) = false
            return 42

        ; types_compatible - non-integer mismatch is rejected.
        if Planner.types_compatible(int_ty, bool_ty)
            return 43

        ; types_compatible - pointer[int] arg can pass where int expected (implicit deref).
        var ptr_int_gens Vector[PlannedType](1)
        ptr_int_gens.put(0, int_ty)
        let ptr_int_ty PlannedType(
            Span(0, 0),
            "pointer",
            "",
            &ptr_int_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_compatible(int_ty, ptr_int_ty) = false
            return 44

        ; types_compatible - pointer[void] accepts any pointer.
        let void_ty PlannedType(
            Span(0, 0),
            "void",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        var ptr_void_gens Vector[PlannedType](1)
        ptr_void_gens.put(0, void_ty)
        let ptr_void_ty PlannedType(
            Span(0, 0),
            "pointer",
            "",
            &ptr_void_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_compatible(ptr_void_ty, ptr_int_ty) = false
            return 45

        ; types_compatible - pointer[const_char] <- pointer[i8] (Rule 5).
        let const_char_ty PlannedType(
            Span(0, 0),
            "const_char",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let i8_ty PlannedType(
            Span(0, 0),
            "i8",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        var ptr_cc_gens Vector[PlannedType](1)
        ptr_cc_gens.put(0, const_char_ty)
        let ptr_cc_ty PlannedType(
            Span(0, 0),
            "pointer",
            "",
            &ptr_cc_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        var ptr_i8_gens Vector[PlannedType](1)
        ptr_i8_gens.put(0, i8_ty)
        let ptr_i8_ty PlannedType(
            Span(0, 0),
            "pointer",
            "",
            &ptr_i8_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_compatible(ptr_cc_ty, ptr_i8_ty) = false
            return 46

        ; types_compatible - Option accepts null (pointer[void]).
        let option_ty PlannedType(
            Span(0, 0),
            "Option",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.types_compatible(option_ty, ptr_void_ty) = false
            return 47

        ; is_operator_name - operator chars and 'abs' are operators.
        if Planner.is_operator_name("+") = false
            return 48
        if Planner.is_operator_name("abs") = false
            return 49
        if Planner.is_operator_name("foo")
            return 50
        if Planner.is_operator_name("")
            return 51

        ; get_operator_precedence - canonical ranks plus the 'unknown' zero.
        if Planner.get_operator_precedence("||") <> 1
            return 52
        if Planner.get_operator_precedence("*") <> 10
            return 53
        if Planner.get_operator_precedence("<>") <> 6
            return 54
        if Planner.get_operator_precedence("???") <> 0
            return 55

        ; get_pointer_element_type - pointer[int] -> int.
        let pe_int Planner.get_pointer_element_type(ptr_int_ty)
        if pe_int = null
            return 56
        let pe_int_v (*pe_int)
        if pe_int_v.name.equals("int") = false
            return 57

        ; get_pointer_element_type - non-pointer returns null.
        let pe_none Planner.get_pointer_element_type(int_ty)
        if pe_none <> null
            return 58

        ; get_pointer_element_type - Option[pointer[int]] -> int.
        var opt_gens Vector[PlannedType](1)
        opt_gens.put(0, ptr_int_ty)
        let opt_ptr_int_ty PlannedType(
            Span(0, 0),
            "Option",
            "",
            &opt_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let pe_opt Planner.get_pointer_element_type(opt_ptr_int_ty)
        if pe_opt = null
            return 59
        let pe_opt_v (*pe_opt)
        if pe_opt_v.name.equals("int") = false
            return 60

        ; infer_constant_type - booleans yield "bool".
        let c_bool Constant.Boolean(BooleanConstant(Span(0, 0), true))
        let t_bool Planner.infer_constant_type(c_bool)
        if t_bool.name.equals("bool") = false
            return 61

        ; infer_constant_type - integer literal is "int" (pre-solver).
        let c_int Constant.Integer(IntegerConstant(Span(0, 0), 42))
        let t_int Planner.infer_constant_type(c_int)
        if t_int.name.equals("int") = false
            return 62
        if t_int.mangled_name.equals("i") = false
            return 63

        ; infer_constant_type - hex literal is u64.
        let c_hex Constant.Hex(HexConstant(Span(0, 0), 255))
        let t_hex Planner.infer_constant_type(c_hex)
        if t_hex.name.equals("u64") = false
            return 64

        ; infer_constant_type - string literal is pointer[i8] (Itanium "Pa").
        let c_str Constant.String(StringConstant(Span(0, 0), "hi"))
        let t_str Planner.infer_constant_type(c_str)
        if t_str.name.equals("pointer") = false
            return 65
        if t_str.mangled_name.equals("Pa") = false
            return 66
        if t_str.generics = null
            return 67

        ; infer_constant_type - null literal is pointer[void].
        let c_null Constant.Null(NullConstant(Span(0, 0)))
        let t_null Planner.infer_constant_type(c_null)
        if t_null.name.equals("pointer") = false
            return 68
        if t_null.mangled_name.equals("Pv") = false
            return 69

        ; extract_arg_types - non-tuple operand yields empty Vector.
        let plain_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type int_ty,
            null,
            int_ty
        )
        let empty_types Planner.extract_arg_types(plain_op)
        if empty_types.length <> 0
            return 70

        ; extract_arg_types - tuple of two components (int, bool) yields [int, bool].
        let int_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type int_ty,
            null,
            int_ty
        )
        let bool_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Type bool_ty,
            null,
            bool_ty
        )
        var v1 Vector[PlannedOperand](1)
        v1.put(0, int_op)
        var v2 Vector[PlannedOperand](1)
        v2.put(0, bool_op)
        var comps Vector[PlannedComponent](2)
        comps.put(0, PlannedComponent(Span(0, 0), null, &v1, null))
        comps.put(1, PlannedComponent(Span(0, 0), null, &v2, null))
        let tpl PlannedTuple(
            Span(0, 0),
            &comps,
            int_ty,
            false,
            Lifetime.Unspecified(Unspecified()),
            null
        )
        let tuple_op PlannedOperand(
            Span(0, 0),
            PlannedExpression.Tuple tpl,
            null,
            int_ty
        )
        let two_types Planner.extract_arg_types(tuple_op)
        if two_types.length <> 2
            return 71
        let t0 two_types.get 0
        if t0 = null
            return 72
        let t0v (*t0)
        if t0v.name.equals("int") = false
            return 73
        let t1 two_types.get 1
        if t1 = null
            return 74
        let t1v (*t1)
        if t1v.name.equals("bool") = false
            return 75

        ; is_primitive_type_name - representative cases.
        if Planner.is_primitive_type_name("int") = false
            return 76
        if Planner.is_primitive_type_name("pointer") = false
            return 77
        if Planner.is_primitive_type_name("Foo")
            return 78

        ; get_primitive_alignment - bool/char -> 1, int -> 8 (i64),
        ; default 8. Matches stage-0 (Planner.cpp:960) for sizeof
        ; consistency.
        if Planner.get_primitive_alignment("bool") <> 1
            return 79
        if Planner.get_primitive_alignment("int") <> 8
            return 80
        if Planner.get_primitive_alignment("String") <> 8
            return 81

        ; align_offset - round up to nearest power-of-two multiple.
        if Planner.align_offset(0, 8) <> 0
            return 82
        if Planner.align_offset(1, 8) <> 8
            return 83
        if Planner.align_offset(9, 4) <> 12
            return 84
        if Planner.align_offset(16, 8) <> 16
            return 85

        ; occurs_in - a var id not present in a concrete type.
        if Planner.occurs_in(7, int_ty)
            return 86

        ; occurs_in - direct hit on the top-level variable.
        let tv7 TypeVariable(7, "T")
        let var_ty PlannedType(
            Span(0, 0),
            "T",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            &tv7
        )
        if Planner.occurs_in(7, var_ty) = false
            return 87

        ; occurs_in - hidden inside a generic argument.
        var vec_with_var Vector[PlannedType](1)
        vec_with_var.put(0, var_ty)
        let vec_of_t_ty PlannedType(
            Span(0, 0),
            "Vector",
            "",
            &vec_with_var,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.occurs_in(7, vec_of_t_ty) = false
            return 88
        if Planner.occurs_in(99, vec_of_t_ty)
            return 89

        ; are_compatible_integer_types - both integer -> true, one not -> false.
        if Planner.are_compatible_integer_types("int", "u64") = false
            return 90
        if Planner.are_compatible_integer_types("int", "bool")
            return 91

        ; join_dotted_name - joins a Vector[String] with dots.
        var parts Vector[String](3)
        parts.put(0, "scaly")
        parts.put(1, "containers")
        parts.put(2, "String")
        let joined Planner.join_dotted_name(parts)
        if joined.equals("scaly.containers.String") = false
            return 92

        ; is_generic_type_param_name - single uppercase letter.
        if Planner.is_generic_type_param_name("T") = false
            return 93
        if Planner.is_generic_type_param_name("Foo")
            return 94
        if Planner.is_generic_type_param_name("t")
            return 95

        ; needs_implicit_return_page - extern returns false regardless.
        let extern_func Function(
            Span(0, 0),
            false,
            false,
            "foo",
            Vector[GenericParameter](0),
            null,
            Vector[Item](0),
            null,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Extern(Extern(Span(0, 0)))
        )
        if Planner.needs_implicit_return_page(extern_func)
            return 96

        ; needs_implicit_return_page - void return (null) -> false.
        let void_func Function(
            Span(0, 0),
            false,
            false,
            "bar",
            Vector[GenericParameter](0),
            null,
            Vector[Item](0),
            null,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        if Planner.needs_implicit_return_page(void_func)
            return 97

        ; needs_implicit_return_page - returns primitive "int" -> false.
        var int_return_parts Vector[String](1)
        int_return_parts.put(0, "int")
        let int_return_ty Type(
            Span(0, 0),
            int_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let int_ret_func Function(
            Span(0, 0),
            false,
            false,
            "baz",
            Vector[GenericParameter](0),
            null,
            Vector[Item](0),
            &int_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        if Planner.needs_implicit_return_page(int_ret_func)
            return 98

        ; needs_implicit_return_page - returns generic param "T" -> false.
        var t_return_parts Vector[String](1)
        t_return_parts.put(0, "T")
        let t_return_ty Type(
            Span(0, 0),
            t_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let t_ret_func Function(
            Span(0, 0),
            false,
            false,
            "qux",
            Vector[GenericParameter](0),
            null,
            Vector[Item](0),
            &t_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        if Planner.needs_implicit_return_page(t_ret_func)
            return 99

        ; needs_implicit_return_page - returns "Foo" (user type) -> true.
        var foo_return_parts Vector[String](1)
        foo_return_parts.put(0, "Foo")
        let foo_return_ty Type(
            Span(0, 0),
            foo_return_parts,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let foo_ret_func Function(
            Span(0, 0),
            false,
            false,
            "make_foo",
            Vector[GenericParameter](0),
            null,
            Vector[Item](0),
            &foo_return_ty,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        if Planner.needs_implicit_return_page(foo_ret_func) = false
            return 100

        ; apply_substitution - null substitution leaves type unchanged.
        let sub_int Planner.apply_substitution(int_ty, null)
        if sub_int.name.equals("int") = false
            return 101

        ; apply_substitution - unbound variable stays as-is.
        var empty_sub Vector[KeyValuePair[size_t, PlannedType]](0)
        let sub_var Planner.apply_substitution(var_ty, &empty_sub)
        if sub_var.variable = null
            return 102

        ; apply_substitution - bound variable gets replaced.
        var sub1 Vector[KeyValuePair[size_t, PlannedType]](1)
        sub1.put(0, KeyValuePair[size_t, PlannedType](7, int_ty))
        let sub_hit Planner.apply_substitution(var_ty, &sub1)
        if sub_hit.name.equals("int") = false
            return 103

        ; apply_substitution - substitutes inside generic arguments.
        let sub_vec Planner.apply_substitution(vec_of_t_ty, &sub1)
        if sub_vec.name.equals("Vector") = false
            return 104
        if sub_vec.generics = null
            return 105
        let sub_vec_gens (*sub_vec.generics)
        if sub_vec_gens.length <> 1
            return 106
        let sub_vec_g0 sub_vec_gens.get 0
        if sub_vec_g0 = null
            return 107
        let sub_vec_g0v (*sub_vec_g0)
        if sub_vec_g0v.name.equals("int") = false
            return 108

        ; apply_substitution - follows chains T7 -> T8 -> int.
        let tv8 TypeVariable(8, "U")
        let var_ty8 PlannedType(
            Span(0, 0),
            "U",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            &tv8
        )
        var sub_chain Vector[KeyValuePair[size_t, PlannedType]](2)
        sub_chain.put(0, KeyValuePair[size_t, PlannedType](7, var_ty8))
        sub_chain.put(1, KeyValuePair[size_t, PlannedType](8, int_ty))
        let sub_chained Planner.apply_substitution(var_ty, &sub_chain)
        if sub_chained.name.equals("int") = false
            return 109

        ; compose_substitutions - S2 ∘ S1: S1={T7 -> T8}, S2={T8 -> int}
        ; Expected: T7 -> int (applied), T8 -> int (carried over from S2).
        var s1_vec Vector[KeyValuePair[size_t, PlannedType]](1)
        s1_vec.put(0, KeyValuePair[size_t, PlannedType](7, var_ty8))
        var s2_vec Vector[KeyValuePair[size_t, PlannedType]](1)
        s2_vec.put(0, KeyValuePair[size_t, PlannedType](8, int_ty))
        let composed Planner.compose_substitutions(s1_vec, s2_vec)
        if composed.length <> 2
            return 110

        ; Look up T7 in the composed substitution - should be int.
        let comp7 Planner.substitution_lookup(composed, 7)
        if comp7 = null
            return 111
        let comp7v (*comp7)
        if comp7v.name.equals("int") = false
            return 112

        ; T8 should still be present.
        let comp8 Planner.substitution_lookup(composed, 8)
        if comp8 = null
            return 113

        ; compose with duplicate key: S1 wins.
        var s1_dup Vector[KeyValuePair[size_t, PlannedType]](1)
        s1_dup.put(0, KeyValuePair[size_t, PlannedType](7, int_ty))
        var s2_dup Vector[KeyValuePair[size_t, PlannedType]](1)
        s2_dup.put(0, KeyValuePair[size_t, PlannedType](7, bool_ty))
        let dup_comp Planner.compose_substitutions(s1_dup, s2_dup)
        if dup_comp.length <> 1
            return 114
        let dup7 Planner.substitution_lookup(dup_comp, 7)
        if dup7 = null
            return 115
        let dup7v (*dup7)
        if dup7v.name.equals("int") = false
            return 116

        ; compute_struct_size / compute_struct_alignment - empty and simple.
        if Planner.compute_struct_size(null) <> 0
            return 117
        if Planner.compute_struct_alignment(null) <> 1
            return 118

        ; Struct with two int properties: offsets 0, 8; size 16; align 8
        ; (int is 8 bytes per s103).
        var two_ints Vector[PlannedProperty](2)
        two_ints.put(0, PlannedProperty(
            Span(0, 0), false, "x", "",
            int_ty, null, null, 0
        ))
        two_ints.put(1, PlannedProperty(
            Span(0, 0), false, "y", "",
            int_ty, null, null, 0
        ))
        if Planner.compute_struct_size(&two_ints) <> 16
            return 119
        if Planner.compute_struct_alignment(&two_ints) <> 8
            return 120

        let offsets Planner.compute_property_offsets(&two_ints)
        if offsets.length <> 2
            return 121
        let o0 offsets.get 0
        if o0 = null
            return 122
        if *o0 <> 0
            return 123
        let o1 offsets.get 1
        if o1 = null
            return 124
        if *o1 <> 8
            return 125

        ; Mixed struct: bool then int — padding puts int at offset 8
        ; (8-byte alignment for int per s103).
        var bool_then_int Vector[PlannedProperty](2)
        bool_then_int.put(0, PlannedProperty(
            Span(0, 0), false, "flag", "",
            bool_ty, null, null, 0
        ))
        bool_then_int.put(1, PlannedProperty(
            Span(0, 0), false, "count", "",
            int_ty, null, null, 0
        ))
        if Planner.compute_struct_size(&bool_then_int) <> 16
            return 126
        let bi_offsets Planner.compute_property_offsets(&bool_then_int)
        let bi0 bi_offsets.get 0
        if bi0 = null
            return 127
        if *bi0 <> 0
            return 128
        let bi1 bi_offsets.get 1
        if bi1 = null
            return 129
        if *bi1 <> 8
            return 130

        ; unify - identical concrete types → empty substitution.
        let u1 Planner.unify(int_ty, int_ty)
        if u1 = null
            return 131
        if (*u1).length <> 0
            return 132

        ; unify - incompatible primitives → null.
        if Planner.unify(int_ty, bool_ty) <> null
            return 133

        ; unify - left variable, right concrete → binds.
        let u2 Planner.unify(var_ty, int_ty)
        if u2 = null
            return 134
        if (*u2).length <> 1
            return 135
        let u2_lookup Planner.substitution_lookup((*u2), 7)
        if u2_lookup = null
            return 136
        if (*u2_lookup).name.equals("int") = false
            return 137

        ; unify - right variable, left concrete → also binds.
        let u3 Planner.unify(int_ty, var_ty)
        if u3 = null
            return 138
        if (*u3).length <> 1
            return 139

        ; unify - same variable → empty.
        let u4 Planner.unify(var_ty, var_ty)
        if u4 = null
            return 140
        if (*u4).length <> 0
            return 141

        ; unify - void unifies with anything.
        if Planner.unify(void_ty, int_ty) = null
            return 142

        ; unify - integer compatibility (u64 vs int).
        let i64_try Planner.unify(int_ty, u32_ty)
        if i64_try = null
            return 143

        ; unify - Option[T] vs pointer[void] → empty.
        if Planner.unify(option_ty, ptr_void_ty) = null
            return 144

        ; unify - recurse on generics: Vector[T7] vs Vector[int] → [(7, int)].
        let u_vec Planner.unify(vec_of_t_ty, vec_ty)
        if u_vec = null
            return 145
        if (*u_vec).length <> 1
            return 146
        let u_vec_lookup Planner.substitution_lookup((*u_vec), 7)
        if u_vec_lookup = null
            return 147
        if (*u_vec_lookup).name.equals("int") = false
            return 148

        ; unify - occurs check: T7 vs Vector[T7] → null.
        if Planner.unify(var_ty, vec_of_t_ty) <> null
            return 149

        ; unify - name mismatch with matching arity → null.
        var list_gens Vector[PlannedType](1)
        list_gens.put(0, int_ty)
        let list_int_ty PlannedType(
            Span(0, 0),
            "List",
            "",
            &list_gens,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        if Planner.unify(vec_ty, list_int_ty) <> null
            return 150

        ; solve_constraints - null list → empty substitution.
        let sc_null Planner.solve_constraints(null)
        if sc_null = null
            return 151
        if (*sc_null).length <> 0
            return 152

        ; solve_constraints - single T7 = int → binds T7 to int.
        var one_eq Vector[TypeConstraint](1)
        one_eq.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, int_ty, Span(0, 0), "")
        ))
        let sc_one Planner.solve_constraints(&one_eq)
        if sc_one = null
            return 153
        let sc_one_lookup Planner.substitution_lookup((*sc_one), 7)
        if sc_one_lookup = null
            return 154
        if (*sc_one_lookup).name.equals("int") = false
            return 155

        ; solve_constraints - chain T7 = T8, T8 = int → T7 resolves to int.
        var chain Vector[TypeConstraint](2)
        chain.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, var_ty8, Span(0, 0), "")
        ))
        chain.put(1, TypeConstraint.Equality(
            EqualityConstraint(var_ty8, int_ty, Span(0, 0), "")
        ))
        let sc_chain Planner.solve_constraints(&chain)
        if sc_chain = null
            return 156
        let sc_chain_t7 Planner.apply_substitution(var_ty, sc_chain)
        if sc_chain_t7.name.equals("int") = false
            return 157

        ; solve_constraints - conflicting: T7 = int, T7 = bool → null.
        var conflict Vector[TypeConstraint](2)
        conflict.put(0, TypeConstraint.Equality(
            EqualityConstraint(var_ty, int_ty, Span(0, 0), "")
        ))
        conflict.put(1, TypeConstraint.Equality(
            EqualityConstraint(var_ty, bool_ty, Span(0, 0), "")
        ))
        if Planner.solve_constraints(&conflict) <> null
            return 158

        ; free_type_vars - concrete type yields empty list.
        let fv_int Planner.free_type_vars(int_ty)
        if fv_int.length <> 0
            return 159

        ; free_type_vars - standalone variable yields [id].
        let fv_var Planner.free_type_vars(var_ty)
        if fv_var.length <> 1
            return 160
        let fv_var_0 fv_var.get 0
        if fv_var_0 = null
            return 161
        if *fv_var_0 <> 7
            return 162

        ; free_type_vars - Vector[T7] yields [7].
        let fv_vec Planner.free_type_vars(vec_of_t_ty)
        if fv_vec.length <> 1
            return 163

        ; free_type_vars - dedupes repeated variables inside nested generics.
        var two_t Vector[PlannedType](2)
        two_t.put(0, var_ty)
        two_t.put(1, var_ty)
        let pair_of_t_ty PlannedType(
            Span(0, 0),
            "Pair",
            "",
            &two_t,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let fv_pair Planner.free_type_vars(pair_of_t_ty)
        if fv_pair.length <> 1
            return 164

        ; id_list_contains - basic sanity checks.
        var ids_37 Vector[size_t](2)
        ids_37.put(0, 3)
        ids_37.put(1, 7)
        if Planner.id_list_contains(ids_37, 3) = false
            return 165
        if Planner.id_list_contains(ids_37, 5)
            return 166

        ; generalize - concrete type has no quantified vars.
        var empty_env Vector[size_t](0)
        let sch_int Planner.generalize(int_ty, empty_env)
        if sch_int.quantified = null
            return 167
        let sch_int_q (*sch_int.quantified)
        if sch_int_q.length <> 0
            return 168

        ; generalize - standalone type variable is quantified when not in env.
        let sch_var Planner.generalize(var_ty, empty_env)
        if sch_var.quantified = null
            return 169
        let sch_var_q (*sch_var.quantified)
        if sch_var_q.length <> 1
            return 170
        let sch_var_tv sch_var_q.get 0
        if sch_var_tv = null
            return 171
        if (*sch_var_tv).id <> 7
            return 172

        ; generalize - variable present in env is NOT quantified.
        var env_with_7 Vector[size_t](1)
        env_with_7.put(0, 7)
        let sch_in_env Planner.generalize(var_ty, env_with_7)
        if sch_in_env.quantified = null
            return 173
        if (*sch_in_env.quantified).length <> 0
            return 174

        ; is_on_page_lifetime - Unspecified is the only "on-stack" lifetime.
        if Planner.is_on_page_lifetime(Lifetime.Unspecified(Unspecified()))
            return 175
        if Planner.is_on_page_lifetime(Lifetime.Local(
            scalyc.compiler.Model.Local(Span(0, 0))
        )) = false
            return 176

        ; decode_utf8_to_code_point - ASCII "A" -> 65.
        if Planner.decode_utf8_to_code_point("A") <> 65
            return 177

        ; decode_utf8_to_code_point - empty string -> -1.
        if Planner.decode_utf8_to_code_point("") <> -1
            return 178

        ; decode_utf8_to_code_point - "AB" (trailing byte) -> -1.
        if Planner.decode_utf8_to_code_point("AB") <> -1
            return 179

        ; lookup_local_in_scope - hit, miss.
        let lb_x LocalBinding(int_ty, false, false)
        let lb_y LocalBinding(bool_ty, true, true)
        var scope1 Vector[KeyValuePair[String, LocalBinding]](2)
        scope1.put(0, KeyValuePair[String, LocalBinding]("x", lb_x))
        scope1.put(1, KeyValuePair[String, LocalBinding]("y", lb_y))
        let hit_x Planner.lookup_local_in_scope(scope1, "x")
        if hit_x = null
            return 180
        if (*hit_x).is_mutable
            return 181
        if Planner.lookup_local_in_scope(scope1, "z") <> null
            return 182

        ; lookup_local_in_stack - innermost shadows outer.
        let lb_x_outer LocalBinding(int_ty, false, false)
        let lb_x_inner LocalBinding(bool_ty, true, false)
        var outer_scope Vector[KeyValuePair[String, LocalBinding]](1)
        outer_scope.put(0, KeyValuePair[String, LocalBinding]("x", lb_x_outer))
        var inner_scope Vector[KeyValuePair[String, LocalBinding]](1)
        inner_scope.put(0, KeyValuePair[String, LocalBinding]("x", lb_x_inner))
        var stack Vector[Vector[KeyValuePair[String, LocalBinding]]](2)
        stack.put(0, outer_scope)
        stack.put(1, inner_scope)
        let resolved Planner.lookup_local_in_stack(stack, "x")
        if resolved = null
            return 183
        if (*resolved).is_mutable = false
            return 184

        ; resolve_type_base - simple path.
        var int_name_vec Vector[String](1)
        int_name_vec.put(0, "int")
        let int_type Type(
            Span(0, 0),
            int_name_vec,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_int Planner.resolve_type_base(int_type)
        if rt_int.name.equals("int") = false
            return 185
        if rt_int.generics <> null
            return 186

        ; resolve_type_base - dotted name.
        var str_name_vec Vector[String](3)
        str_name_vec.put(0, "scaly")
        str_name_vec.put(1, "containers")
        str_name_vec.put(2, "String")
        let str_type Type(
            Span(0, 0),
            str_name_vec,
            null,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_str Planner.resolve_type_base(str_type)
        if rt_str.name.equals("scaly.containers.String") = false
            return 187

        ; resolve_type_base - pointer[int] gets "P" mangled prefix.
        var ptr_name_vec Vector[String](1)
        ptr_name_vec.put(0, "pointer")
        var ptr_inner_gens Vector[Type](1)
        ptr_inner_gens.put(0, int_type)
        let ptr_type Type(
            Span(0, 0),
            ptr_name_vec,
            &ptr_inner_gens,
            Lifetime.Unspecified(Unspecified())
        )
        let rt_ptr Planner.resolve_type_base(ptr_type)
        if rt_ptr.name.equals("pointer") = false
            return 188
        if rt_ptr.generics = null
            return 189
        let rt_ptr_gens (*rt_ptr.generics)
        if rt_ptr_gens.length <> 1
            return 190
        let rt_ptr_inner rt_ptr_gens.get 0
        if rt_ptr_inner = null
            return 191
        if (*rt_ptr_inner).name.equals("int") = false
            return 192
        ; Inner primitive has no mangled_name set here (set by caller after
        ; concept-table lookup), so outer just becomes "P" + "".
        if rt_ptr.mangled_name.equals("P") = false
            return 193

        ; name_substitution_lookup - hit/miss.
        var t_subst Vector[KeyValuePair[String, PlannedType]](1)
        t_subst.put(0, KeyValuePair[String, PlannedType]("T", int_ty))
        let hit_t Planner.name_substitution_lookup(t_subst, "T")
        if hit_t = null
            return 194
        if (*hit_t).name.equals("int") = false
            return 195
        if Planner.name_substitution_lookup(t_subst, "K") <> null
            return 196

        ; apply_name_substitution - standalone "T" replaced by int.
        let t_ty PlannedType(
            Span(0, 0),
            "T",
            "",
            null,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let subst_t Planner.apply_name_substitution(t_ty, &t_subst)
        if subst_t.name.equals("int") = false
            return 197

        ; apply_name_substitution - Vector[T] → Vector[int].
        var vec_t_gens_ns Vector[PlannedType](1)
        vec_t_gens_ns.put(0, t_ty)
        let vec_t_ns_ty PlannedType(
            Span(0, 0),
            "Vector",
            "",
            &vec_t_gens_ns,
            Lifetime.Unspecified(Unspecified()),
            null,
            "",
            null
        )
        let subst_vec Planner.apply_name_substitution(vec_t_ns_ty, &t_subst)
        if subst_vec.name.equals("Vector") = false
            return 198
        if subst_vec.generics = null
            return 199
        let subst_vec_g0 (*subst_vec.generics).get(0)
        if subst_vec_g0 = null
            return 200
        if (*subst_vec_g0).name.equals("int") = false
            return 201

        ; apply_name_substitution - null substitution, no change.
        let no_subst Planner.apply_name_substitution(vec_t_ns_ty, null)
        if no_subst.name.equals("Vector") = false
            return 202

        ; Primitive factories set the Itanium one-letter codes.
        let mk_int Planner.make_int_type()
        if mk_int.name.equals("int") = false
            return 203
        if mk_int.mangled_name.equals("i") = false
            return 204

        let mk_void Planner.make_void_type()
        if mk_void.mangled_name.equals("v") = false
            return 205

        ; make_pointer_type wraps "P" + inner.mangled_name.
        let mk_ptr_int Planner.make_pointer_type(mk_int)
        if mk_ptr_int.name.equals("pointer") = false
            return 206
        if mk_ptr_int.mangled_name.equals("Pi") = false
            return 207
        if mk_ptr_int.generics = null
            return 208
        let mk_ptr_int_gens (*mk_ptr_int.generics)
        if mk_ptr_int_gens.length <> 1
            return 209

        ; instantiate - no quantified vars: return scheme type unchanged.
        let inst_int Planner.instantiate(sch_int, 100)
        if inst_int.name.equals("int") = false
            return 210

        ; instantiate - scheme with quantified T7 gets fresh id 100.
        let inst_var Planner.instantiate(sch_var, 100)
        if inst_var.variable = null
            return 211
        if (*inst_var.variable).id <> 100
            return 212

        ; ====================================================================
        ; Planner-instance (scope stack) tests. Exercises the struct surgery
        ; added in this session — `Planner.Planner(...)` constructor, plus
        ; push_scope / define_local / lookup_local / pop_scope sequencing.
        ; ====================================================================

        var p Planner.Planner("test.scaly")

        ; Empty stack → no local named "x".
        if p.lookup_local("x") <> null
            return 213

        ; Push a scope, define "x" = int, lookup → hits.
        p.push_scope()
        p.define_local("x", int_ty, false, false)
        let px1 p.lookup_local("x")
        if px1 = null
            return 214
        if (*px1).name.equals("int") = false
            return 215

        ; Push inner scope, shadow "x" with bool.
        p.push_scope()
        p.define_local("x", bool_ty, true, false)
        let px2 p.lookup_local("x")
        if px2 = null
            return 216
        if (*px2).name.equals("bool") = false
            return 217

        ; Lookup binding flags on inner "x".
        let pxb2 p.lookup_local_binding("x")
        if pxb2 = null
            return 218
        if (*pxb2).is_mutable = false
            return 219

        ; Pop inner scope, outer "x" reappears.
        p.pop_scope()
        let px3 p.lookup_local("x")
        if px3 = null
            return 220
        if (*px3).name.equals("int") = false
            return 221

        ; Pop outer scope, no locals remain.
        p.pop_scope()
        if p.lookup_local("x") <> null
            return 222

        ; ====================================================================
        ; Type-substitution tests.
        ; ====================================================================

        if p.lookup_type_substitution("T") <> null
            return 223

        p.define_type_substitution("T", int_ty)
        let ps_t p.lookup_type_substitution("T")
        if ps_t = null
            return 224
        if (*ps_t).name.equals("int") = false
            return 225

        p.clear_type_substitutions()
        if p.lookup_type_substitution("T") <> null
            return 226

        ; ====================================================================
        ; Fresh type-variable id counter.
        ; ====================================================================

        if p.fresh_type_var_id() <> 0
            return 227
        if p.fresh_type_var_id() <> 1
            return 228
        if p.fresh_type_var_id() <> 2
            return 229

        ; ====================================================================
        ; fresh_type_var + constraint-solver methods on the Planner instance.
        ; ====================================================================

        let fv1 p.fresh_type_var("T")
        if fv1.variable = null
            return 230
        if (*fv1.variable).id <> 3
            return 231

        ; Add a solvable constraint: fv1 = int, solve → success.
        p.add_equality_constraint(fv1, int_ty, Span(0, 0))
        if p.solve_and_apply() = false
            return 232

        ; Applying the current substitution to fv1 should now yield int.
        let rewritten p.apply_current_substitution(fv1)
        if rewritten.name.equals("int") = false
            return 233

        ; Constraints are cleared after a successful solve — adding an
        ; unrelated constraint and solving again should still succeed.
        let fv2 p.fresh_type_var("U")
        p.add_equality_constraint(fv2, bool_ty, Span(0, 0))
        if p.solve_and_apply() = false
            return 234

        ; Add a conflicting pair: fv3 = int, fv3 = bool. Expect failure.
        let fv3 p.fresh_type_var("V")
        p.add_equality_constraint(fv3, int_ty, Span(0, 0))
        p.add_equality_constraint(fv3, bool_ty, Span(0, 0))
        if p.solve_and_apply()
            return 235

        ; ====================================================================
        ; plan_type on the Planner instance.
        ; ====================================================================

        ; A clean Planner — no active substitutions — resolves "int" plainly.
        var p2 Planner.Planner("test2.scaly")
        let pt_int p2.plan_type(int_type)
        if pt_int.name.equals("int") = false
            return 236

        ; With T → int substitution active, Vector[T] becomes Vector[int].
        p2.define_type_substitution("T", int_ty)
        var vec_t_path Vector[String](1)
        vec_t_path.put(0, "Vector")
        var vec_t_generics Vector[Type](1)
        var t_path Vector[String](1)
        t_path.put(0, "T")
        vec_t_generics.put(0, Type(
            Span(0, 0),
            t_path,
            null,
            Lifetime.Unspecified(Unspecified())
        ))
        let vec_t_model Type(
            Span(0, 0),
            vec_t_path,
            &vec_t_generics,
            Lifetime.Unspecified(Unspecified())
        )
        let pt_vec_t p2.plan_type(vec_t_model)
        if pt_vec_t.name.equals("Vector") = false
            return 237
        if pt_vec_t.generics = null
            return 238
        let pt_vec_t_g0 (*pt_vec_t.generics).get(0)
        if pt_vec_t_g0 = null
            return 239
        if (*pt_vec_t_g0).name.equals("int") = false
            return 240

        ; ====================================================================
        ; plan_item: Model.Item (name + optional type) → PlannedItem.
        ; ====================================================================

        ; Item { name: "x", type: int } → PlannedItem with planned int type.
        let model_item Item(
            Span(0, 0),
            false,
            &("x"),
            &int_type,
            Vector[Attribute](0)
        )
        let pl_item p2.plan_item(model_item)
        if pl_item.name = null
            return 241
        if (*pl_item.name).equals("x") = false
            return 242
        if pl_item.item_type = null
            return 243
        if (*pl_item.item_type).name.equals("int") = false
            return 244

        ; Item { name: null, type: null } → PlannedItem with nulls propagated.
        let bare_item Item(
            Span(0, 0),
            true,
            null,
            null,
            Vector[Attribute](0)
        )
        let pl_bare p2.plan_item(bare_item)
        if pl_bare.name <> null
            return 245
        if pl_bare.item_type <> null
            return 246
        if pl_bare.is_private = false
            return 247

        ; plan_items: batch over a two-Item Vector.
        var model_items Vector[Item](2)
        model_items.put(0, model_item)
        model_items.put(1, bare_item)
        let pl_items p2.plan_items(model_items)
        if pl_items.length <> 2
            return 248
        let pi0 pl_items.get 0
        if pi0 = null
            return 249
        if (*pi0).item_type = null
            return 250

        ; plan_constant_operand: literal 42 → PlannedOperand with result_type = int.
        let plan_c42 p2.plan_constant_operand(
            Constant.Integer(IntegerConstant(Span(0, 0), 42)),
            Span(0, 0)
        )
        if plan_c42.result_type.name.equals("int") = false
            return 251

        ; plan_operand / plan_operands over Constant-only operands.
        let op_42 Operand(
            Span(0, 0),
            Expression.Constant(Constant.Integer(IntegerConstant(Span(0, 0), 42))),
            null
        )
        let po_42 p2.plan_operand(op_42)
        if po_42.result_type.name.equals("int") = false
            return 252

        let op_true Operand(
            Span(0, 0),
            Expression.Constant(Constant.Boolean(BooleanConstant(Span(0, 0), true))),
            null
        )
        var model_ops Vector[Operand](2)
        model_ops.put(0, op_42)
        model_ops.put(1, op_true)
        let po_batch p2.plan_operands(model_ops)
        if po_batch.length <> 2
            return 253
        let po_batch_1 po_batch.get 1
        if po_batch_1 = null
            return 254
        if (*po_batch_1).result_type.name.equals("bool") = false
            return 255

        ; plan_binding - `let x: int = 42`:
        ;   - produces PlannedBinding with PlannedItem.name = "x"
        ;   - registers x in the current scope
        var p3 Planner.Planner("test3.scaly")
        p3.push_scope()
        var init_ops Vector[Operand](1)
        init_ops.put(0, op_42)
        let model_bind Binding(
            Span(0, 0),
            "let",
            Item(
                Span(0, 0),
                false,
                &("x"),
                &int_type,
                Vector[Attribute](0)
            ),
            init_ops
        )
        let pb p3.plan_binding(model_bind)
        if pb.binding_type.equals("let") = false
            return 256
        if pb.binding_item.name = null
            return 257
        if (*pb.binding_item.name).equals("x") = false
            return 258

        ; After plan_binding, x should be a local in p3's scope.
        let plocal_x p3.lookup_local("x")
        if plocal_x = null
            return 259
        if (*plocal_x).name.equals("int") = false
            return 260

        ; The equality constraint binding_type = init_type should be solvable.
        if p3.solve_and_apply() = false
            return 261

        ; ====================================================================
        ; Statement dispatch: plan_action, plan_return, plan_statement.
        ; ====================================================================

        ; An Action: source = [42], target = [] → PlannedAction with result_type int.
        let model_action Action(init_ops, Vector[Operand](0))
        let pl_act p3.plan_action(model_action)
        if pl_act.result_type.name.equals("int") = false
            return 262

        ; A Return with one operand.
        let model_return Return(Span(0, 0), init_ops)
        let pl_ret p3.plan_return(model_return)
        if pl_ret.result = null
            return 263
        if (*pl_ret.result).length <> 1
            return 264

        ; plan_statement over the Action above.
        let stmt_action Statement.Action(model_action)
        let pl_stmt p3.plan_statement(stmt_action)
        let stmt_is_action choose pl_stmt
            when a: PlannedAction
                true
            else
                false
        if stmt_is_action = false
            return 265

        ; plan_statement over a Continue.
        let stmt_continue Statement.Continue(Continue(Span(0, 0), ""))
        let pl_cont p3.plan_statement(stmt_continue)
        let stmt_is_continue choose pl_cont
            when c: PlannedContinue
                true
            else
                false
        if stmt_is_continue = false
            return 266

        ; plan_block: a block with one Action statement.
        var stmts_vec Vector[Statement](1)
        stmts_vec.put(0, stmt_action)
        let model_block Block(Span(0, 0), stmts_vec)
        let pl_block p3.plan_block(model_block)
        if pl_block.statements = null
            return 267
        if (*pl_block.statements).length <> 1
            return 268

        ; plan_property - Property { name: "x", type: int, no initializer }.
        let model_prop Property(
            Span(0, 0),
            false,
            "x",
            &int_type,
            null,
            Vector[Attribute](0)
        )
        let pl_prop p3.plan_property(model_prop)
        if pl_prop.name.equals("x") = false
            return 269
        if pl_prop.prop_type.name.equals("int") = false
            return 270
        if pl_prop.offset <> 0
            return 271

        ; plan_variant - Variant { name: "Some", type: int, tag=1 }.
        let model_variant Variant(
            Span(0, 0),
            "Some",
            &int_type,
            Vector[Attribute](0)
        )
        let pl_variant p3.plan_variant(model_variant, 1)
        if pl_variant.name.equals("Some") = false
            return 272
        if pl_variant.tag <> 1
            return 273
        if pl_variant.var_type = null
            return 274

        ; plan_function - extern "foo(x: int) returns int".
        var x_params Vector[Item](1)
        x_params.put(0, Item(
            Span(0, 0),
            false,
            &("x"),
            &int_type,
            Vector[Attribute](0)
        ))
        let model_fn Function(
            Span(0, 0),
            false,
            true,
            "foo",
            Vector[GenericParameter](0),
            null,
            x_params,
            &int_type,
            null,
            Lifetime.Unspecified(Unspecified()),
            Implementation.Extern(Extern(Span(0, 0)))
        )
        let pl_fn p3.plan_function(model_fn, null)
        if pl_fn.name.equals("foo") = false
            return 275
        if pl_fn.input = null
            return 276
        if (*pl_fn.input).length <> 1
            return 277
        if pl_fn.return_type = null
            return 278
        if (*pl_fn.return_type).name.equals("int") = false
            return 279

        ; plan_structure - empty Structure: size 0, alignment 1.
        var empty_kvps Vector[KeyValuePair[String, scalyc.compiler.Model.Nameable]](0)
        var empty_builder HashMapBuilder[String, scalyc.compiler.Model.Nameable](empty_kvps)
        var empty_symbols HashMap[String, scalyc.compiler.Model.Nameable](empty_builder)
        let empty_struct Structure(
            Span(0, 0),
            false,
            Vector[Property](0),
            Vector[scalyc.compiler.Model.Module](0),
            Vector[scalyc.compiler.Model.Use](0),
            Vector[scalyc.compiler.Model.Initializer](0),
            null,
            Vector[scalyc.compiler.Model.Member](0),
            empty_symbols
        )
        let pl_struct p3.plan_structure(empty_struct, "Foo")
        if pl_struct.name.equals("Foo") = false
            return 280
        if pl_struct.size <> 0
            return 281
        if pl_struct.alignment <> 1
            return 282

        ; plan_initializer - Initializer with one parameter.
        let model_init Initializer(
            Span(0, 0),
            false,
            null,
            x_params,
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        let pl_init p3.plan_initializer(model_init, null)
        if pl_init.input = null
            return 283
        if (*pl_init.input).length <> 1
            return 284

        ; plan_operator - operator + with (this, int) parameters.
        var plus_params Vector[Item](2)
        plus_params.put(0, Item(
            Span(0, 0),
            false,
            &("this"),
            null,
            Vector[Attribute](0)
        ))
        plus_params.put(1, Item(
            Span(0, 0),
            false,
            &("other"),
            &int_type,
            Vector[Attribute](0)
        ))
        let model_op Operator(
            Span(0, 0),
            false,
            "+",
            Vector[GenericParameter](0),
            plus_params,
            &int_type,
            null,
            Implementation.Intrinsic(Intrinsic(Span(0, 0)))
        )
        let pl_op p3.plan_operator(model_op, null)
        if pl_op.name.equals("+") = false
            return 285
        if pl_op.input = null
            return 286
        if (*pl_op.input).length <> 2
            return 287
        if pl_op.return_type = null
            return 288

        ; ====================================================================
        ; Lambda: `\: 42` — no params, body is an Action returning 42.
        ; ====================================================================
        var p4 Planner.Planner("test_lambda.scaly")
        let lam_body Action(init_ops, Vector[Operand](0))
        let model_lam Lambda(
            Span(0, 0),
            Vector[Item](0),
            lam_body
        )
        let pl_lam p4.plan_lambda(model_lam)
        if pl_lam.mangled_name.equals("_ZN6lambda0Ev") = false
            return 289
        if pl_lam.return_type.name.equals("int") = false
            return 290

        ; A second lambda bumps the counter to 1.
        let pl_lam2 p4.plan_lambda(model_lam)
        if pl_lam2.mangled_name.equals("_ZN6lambda1Ev") = false
            return 291

        ; ====================================================================
        ; Repeat: a do-while whose body is the same trivial Action.
        ; ====================================================================
        let model_rep Repeat(Span(0, 0), lam_body, "")
        let pl_rep p4.plan_repeat(model_rep)
        if pl_rep.body.result_type.name.equals("int") = false
            return 292

        0
    }
}
