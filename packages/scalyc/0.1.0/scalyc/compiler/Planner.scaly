        ; lower to `ptr` in LLVM, and `&local` produces pointer[T] while
        ; ref params expect ref[T]. Stage-0's typesCompatible doesn't have
        ; this rule (it falls through and works only via the qualified-
        ; call name-only fallback at Planner.cpp:7912 for namespace.fn
        ; sites); extending the rule here lets free-function `f(&x)` for
        ; `f(p: ref[T])` work too. Symmetric: pointer[T] passed to ref[T]
        ; param, OR ref[T] passed to pointer[T] param.
        if param_type.name.equals("ref")
        {
            if arg_type.name.equals("pointer")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if param_type.name.equals("pointer")
        {
            if arg_type.name.equals("ref")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.types_equal(p0, a0)
                                            return true
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ; Rules 5 & 6 both require both sides to be pointer[T] with a generic arg.
        if param_type.name.equals("pointer")
        {
            if arg_type.name.equals("pointer")
            {
                if param_type.generics <> null
                {
                    let pg (*param_type.generics)
                    if pg.length > 0
                    {
                        let p0_ptr pg.get 0
                        if p0_ptr <> null
                        {
                            let p0 (*p0_ptr)

                            ; Rule 6: any pointer[T] coerces to pointer[void].
                            if p0.name.equals("void")
                                return true

                            ; Rule 5: char-family pointer cross-compatibility.
                            if arg_type.generics <> null
                            {
                                let ag (*arg_type.generics)
                                if ag.length > 0
                                {
                                    let a0_ptr ag.get 0
                                    if a0_ptr <> null
                                    {
                                        let a0 (*a0_ptr)
                                        if Planner.is_char_like_cross_compatible(p0.name, a0.name)
