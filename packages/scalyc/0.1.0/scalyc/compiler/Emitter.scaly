use scaly.compiler.LLVM.LLVMInt1TypeInContext
use scaly.compiler.LLVM.LLVMInt32TypeInContext
use scaly.compiler.LLVM.LLVMInt64TypeInContext
use scaly.compiler.LLVM.LLVMInt8TypeInContext
