; Emitter.scaly - LLVM IR generation from Plan
;
; Generates LLVM IR using the LLVM-C API for both JIT execution (tests)
; and AOT compilation.
;
; Ported from C++ Emitter.cpp

; scaly.io.Console is load-bearing beyond visibility: the use alias
; feeds the dotted-call extern-decl gate (typed declaration for the
; cross-package Console.println call instead of a varargs fallback).
use scaly.io.Console
use scaly.io.File
use scalyc.compiler.Modeler
use scalyc.compiler.ConceptIndex.ConceptIndex
use scalyc.compiler.TaskPlanner.TaskPlanner
use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.LLVM.*
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*
use scalyc.compiler.Planner.*

; dlopen/dlsym: used by the JIT stub pass to tell a genuinely-unresolvable
; declared-only symbol (an uninstantiated generic never reached at runtime,
; which must be stubbed) apart from one the host process already exports
; (the whole RBMM runtime + stdlib — scalyc links libscaly.a). Stubbing the
; latter shadows the real definition with a null-returning body, so every
; JIT program that region-allocates gets a null page and either crashes
; (deref) or silently produces empty results. dlopen(null, RTLD_NOW=2)
; yields the main-program handle on both macOS and Linux (portable, no
; OS-conditional constant), and dlsym takes the un-prefixed C name — the
; same name that appears on the LLVM declaration.
function dlopen(filename: pointer[const_char], flag: i32) returns pointer[void] extern
function dlsym(handle: pointer[void], symbol: pointer[const_char]) returns pointer[void] extern

define Emitter
{
    ; ============================================================================
    ; Intrinsic Type Info
    ; ============================================================================

    ; Information about an intrinsic type
    define IntrinsicTypeInfo
    (
        llvm_type: LLVMTypeRef
        size: size_t
        alignment: size_t
        is_signed: bool
    )

    ; A 1-based source line/column, computed from a byte offset for DWARF.
    ; i32 fields: the LLVM-C DI APIs take 32-bit line/column (see LLVM.scaly).
    define DebugPos
    (
        line: i32
        col: i32
    )

    ; ============================================================================
    ; Emitter Configuration
    ; ============================================================================

    define EmitterConfig
    (
        emit_debug_info: bool       ; Generate DWARF
        optimize_for_size: bool
        opt_level: int              ; 0 = none, 1-3 = increasing
        target_triple: String       ; Empty = host
        data_layout: String         ; Empty = default for target
        skip_tests: bool            ; --no-tests: omit test/test_* functions
    )
    {
        init()
        {
            set emit_debug_info: true
            set optimize_for_size: false
            set opt_level: 0
            set target_triple: String()
            set data_layout: String()
            set skip_tests: false
        }
    }

    ; ============================================================================
    ; Loop Context - for break/continue handling
    ; ============================================================================

    define LoopContext
    (
        exit_block: LLVMBasicBlockRef       ; Target for 'break'
        continue_block: LLVMBasicBlockRef   ; Target for 'continue'
        loop_label: String                  ; Loop label ("" = unlabeled)
        result_slot: LLVMValueRef           ; break-value alloca (null = no value)
    )

    ; ============================================================================
    ; Region Info - for lifetime/region management
    ; ============================================================================

    define RegionInfo
    (
        local_page: LLVMValueRef        ; Local ($) allocations
        return_page: LLVMValueRef       ; Call (#) - passed by caller
        exception_page: LLVMValueRef    ; Thrown (!) - passed by caller
        ; Named regions (^name) would use a map, simplified for now
        named_region_names: ref[Array[String]]?
        named_region_values: ref[Array[LLVMValueRef]]?
    )
    {
        init()
        {
            set local_page: LLVMValueRef(null)
            set return_page: LLVMValueRef(null)
            set exception_page: LLVMValueRef(null)
            set named_region_names: Array[String]^this()
            set named_region_values: Array[LLVMValueRef]^this()
        }

        function lookup_named_region(this, name: String) returns LLVMValueRef
        {
            var i 0
            for n in named_region_names
            {
                if n = name
                {
                    let val named_region_values.get i
                    if val <> null
                        return val

                }
                set i: i + 1
            }
            LLVMValueRef null
        }

        procedure add_named_region(this, name: String, value: LLVMValueRef)
        {
            named_region_names.add name
            named_region_values.add value
        }
    }

    ; ============================================================================
    ; Emitter
    ; ============================================================================

    define Emitter
    (
        config: EmitterConfig
        ; LLVM handles
        context: LLVMContextRef
        ; JIT mode: when has_external_context is true, initialize() adopts
        ; external_context (the LLVMContext owned by an ORC ThreadSafeContext)
        ; instead of creating its own, so the emitted module can be wrapped into a
        ; ThreadSafeModule without crashing addIRModule. Off for the normal
        ; -S/-c/-o path (byte-identical emission preserved).
        external_context: LLVMContextRef
        has_external_context: bool
        ; Stage 7: does the emission triple use COFF? Decided once in
        ; apply_target_layout, read by set_linkonce_odr. It is a property of the
        ; OBJECT FORMAT, not of the host — a cross-emit for Windows from a Mac
        ; must set it and a native Mac build must not.
        target_is_coff: bool
        llvm_module: LLVMModuleRef
        builder: LLVMBuilderRef
        ; Debug info (DWARF) — populated only when config.emit_debug_info.
        ; source_text/source_file feed byte-offset -> (line,col) conversion;
        ; di_builder/di_file/di_cu are the compile-unit handles; current_di_scope
        ; is the DISubprogram of the function currently being emitted.
        di_builder: LLVMDIBuilderRef
        di_file: LLVMMetadataRef
        di_cu: LLVMMetadataRef
        current_di_scope: LLVMMetadataRef
        source_text: String
        source_file: String
        ; Current plan being emitted
        current_plan: ref[Plan]?
        ; Type cache: name -> LLVM type (using parallel vectors)
        type_cache_names: ref[Array[String]]?
        type_cache_types: ref[Array[LLVMTypeRef]]?
        ; Struct cache: name -> LLVM struct type
        struct_cache_names: ref[Array[String]]?
        struct_cache_types: ref[Array[LLVMTypeRef]]?
        ; -g: DIType cache: mangled name -> DWARF composite type. Keyed like
        ; struct_cache; the entry is a forward decl while members are built,
        ; then replaced with the final type (RAUW) so back-pointers resolve.
        di_type_cache_names: ref[Array[String]]?
        di_type_cache_types: ref[Array[LLVMMetadataRef]]?
        ; Function cache: mangled name -> LLVM function
        function_cache_names: ref[Array[String]]?
        function_cache_funcs: ref[Array[LLVMValueRef]]?
        ; Parallel to function_cache_funcs: the LLVM-argument index of the
        ; function's caller-page parameter, or -1 when it takes none. Written by
        ; emit_function_decl (the ONE place that decides the layout) and read only
        ; by elide_unused_pages, which must never guess the position — see the
        ; note there on why a call site's argument j is not generally the callee's
        ; parameter j.
        function_cache_page_param: ref[Array[int]]?
        ; O(1) name -> cache-array-index maps shadowing the three hot caches
        ; above. The caches' linear scans were ~87% of self-compile time (the
        ; time analog of the Planner's lookup_concept, fixed by ConceptIndex).
        ; FIRST-write-wins (insert_if_absent) + only registered for NON-NULL
        ; entries, so the mapped index always names the FIRST non-null entry —
        ; reproducing the linear scan's "first non-null match" exactly. Stores
        ; indices, not pointers (the arrays reallocate). Fixed generous caps
        ; (measured scalyc self-compile: func <=32K, type 8-32K, struct <=8K);
        ; exit(14) on overflow is a loud backstop for larger programs.
        type_index: ConceptIndex
        struct_index: ConceptIndex
        function_index: ConceptIndex
        ; -g only: same O(1) index over di_type_cache. The cache adds a NON-NULL
        ; forward decl at `idx`, then RAUW-overwrites that slot via put(idx,final);
        ; the name->idx mapping is stable across the put, so get(idx) returns the
        ; current slot value (fwd during member build, final after). Each mangled
        ; name is added exactly once (lookup_di_cache early-return + forward-decl
        ; if against recursive re-add), so insert_if_absent == first-non-null.
        di_index: ConceptIndex
        ; s180: throws Result-wrapper cache: callee mangled name -> wrapper
        ; type. Keyed per callee so emit_function_decl and emit_call always
        ; build the IDENTICAL wrapper even when their value_ty provenance
        ; differs (resolved struct vs cross-package placeholder).
        throws_result_names: ref[Array[String]]?
        throws_result_types: ref[Array[LLVMTypeRef]]?
        ; Intrinsic types
        intrinsic_type_names: ref[Array[String]]?
        intrinsic_types: ref[Array[IntrinsicTypeInfo]]?
        ; Current function state
        current_function: LLVMValueRef
        current_block: LLVMBasicBlockRef
        current_function_can_throw: bool
        ; s196: the current function's local root page for transient #/$/for
        ; allocations in a non-rp function. Mirrors stage-0's
        ; CurrentRegion.LocalPage but kept SEPARATE from current_region.local_page
        ; (which stays a never-set null read only by emit_action's rp fallback).
        ;
        ; PARENT-LINKED FRAME CHAIN (2026-08-02, after the lazy slots of
        ; 2026-08-01): what the entry block holds is a two-word {page, parent}
        ; RECORD. The page is materialised by scaly_force_frame — parents first —
        ; only where something really allocates, and released through
        ; scaly_release_frame on every exit path (a no-op when nothing forced it).
        ; A caller-page argument is the record's ADDRESS and costs no call at all,
        ; which is what lets a callee that allocates nothing leave the caller's
        ; region unopened. See get_local_frame here and the ordering proof at
        ; scaly_force_frame (root_pages.scaly).
        ;
        ; function_local_frame: the record's alloca, created on first demand.
        ; function_local_page / _block: the FORCED page cached for ONE basic
        ;   block, so several allocations in one block share a single call.
        function_local_frame: LLVMValueRef
        function_local_page: LLVMValueRef
        function_local_page_block: LLVMBasicBlockRef
        ; The `store null` that initialises the page word.
        function_local_page_init: LLVMValueRef
        ; The `store <incoming frame>` into the parent word. elide_unused_pages
        ; must not count it as a use of the caller-page parameter — see
        ; page_param_is_unused.
        function_local_frame_parent_store: LLVMValueRef
        ; The incoming caller frame this function chains its own onto, bound where
        ; the page parameter is bound. Deliberately NOT a lookup_variable("_rp")
        ; at frame-creation time: the outlined parfor task function still sees the
        ; enclosing function's variable table, and chaining a worker thread's frame
        ; onto a frame owned by another thread's StackBucket would both reference a
        ; value from another function and cross an allocator boundary. It stays
        ; null there, which roots the task's chain — exactly what a fresh thread
        ; needs (the same reason Fiber.create takes an explicit host page).
        current_frame_parent: LLVMValueRef
        ; TCO (2026-08-04): self-tail-call → loop. Set per function by
        ; emit_function_body when the body contains at least one `return f(…)`
        ; inside f whose shape the transform accepts (tail_loop_eligible), and
        ; null for every other function — those emit exactly as before.
        ;
        ; tail_loop_block is the loop header the back edges branch to. It carries
        ; one PHI per user parameter, and the parameter NAMES are bound to those
        ; PHIs instead of to LLVMGetParam, which is the whole reason this is a
        ; phi-loop and not a slot-loop: lookup_variable keeps answering a plain
        ; SSA value, so not one of its ~40 consumers changes (parameters are
        ; immutable, so an alloca would have to be loaded at every read site, and
        ; emit_variable only loads when the PLAN says is_mutable).
        ;
        ; The iteration reuses this function's ONE local frame — allocations
        ; accumulate in the same region across iterations instead of being
        ; released per recursive frame. That is the documented cost (a tail loop
        ; is a `while` loop, and a `while` loop allocates into its enclosing
        ; region today); it buys a bounded STACK, which is what the recursion
        ; needed.
        tail_loop_block: LLVMBasicBlockRef
        tail_loop_phis: ref[Array[LLVMValueRef]]?
        ; Per by-value-struct parameter (null handle for the others): a DEDICATED
        ; entry alloca the back edge copies the next iteration's value into, plus a
        ; staging slot used only when one back edge copies MORE than one parameter
        ; (then a source may be another parameter's shadow, so all reads must
        ; happen before any shadow is written). Never handed to the temp pool —
        ; that is the point: the pool must never be able to reuse this storage.
        tail_loop_shadows: ref[Array[LLVMValueRef]]?
        tail_loop_stages: ref[Array[LLVMValueRef]]?
        tail_loop_slot_types: ref[Array[LLVMTypeRef]]?
        ; The mangled name a `return`ed call must carry to be a self call, and
        ; how many user arguments it must have. Kept beside the phis so
        ; emit_return can test a candidate without reaching for the Plan.
        tail_loop_mangled: String
        ; Local variables: name -> LLVM value. Flat tables; per-scope
        ; visibility maintained by scope_marks below.
        local_var_names: ref[Array[String]]?
        local_var_values: ref[Array[LLVMValueRef]]?
        ; s128: scope stack. Each entry is a snapshot of
        ; local_var_names.length at scope entry. enter_scope pushes;
        ; exit_scope pops and truncates names+values back to the snapshot,
        ; dropping any defines that happened inside the scope. Sibling
        ; choose/if arms must each enter/exit a fresh scope, otherwise the
        ; first arm's `var X` leaks into subsequent arms' lookups (s123
        ; comment block lists this as the root cause of 106 dom errors and
        ; the buggy stdlib Vector emissions that surfaced in s126 testing).
        scope_marks: ref[Array[size_t]]?
        ; Region/lifetime management
        current_region: RegionInfo
        ; Loop context stack for break/continue
        loop_stack: ref[Array[LoopContext]]?
        ; s178: alloca-reuse pool. Entry-block temp slots (arg.tmp,
        ; sret.result, deref.tmp, tuple, choose.union, variant.ptr) are
        ; registered here and recycled across statements of the same
        ; function when provably dead at statement end. Parallel vectors:
        ; type, alloca, free flag (1 = available). temp_pool_start marks
        ; the first entry belonging to current_function so earlier
        ; functions' slots are never matched. temp_stmt_log records pool
        ; indices acquired during the currently-emitting statement;
        ; temp_stmt_log_start is the current statement's window start
        ; (saved/restored across nested emit_statement calls).
        temp_pool_types: ref[Array[LLVMTypeRef]]?
        temp_pool_slots: ref[Array[LLVMValueRef]]?
        temp_pool_free: ref[Array[size_t]]?
        temp_pool_start: size_t
        temp_stmt_log: ref[Array[size_t]]?
        temp_stmt_log_start: size_t
        ; s178: base allocas of values the emitter holds across scope
        ; exits (choose/if arm results before their merge PHI exists,
        ; the choose scrutinee + union slot while arms are emitted).
        ; The scope-exit release pass skips pinned slots; pins expire
        ; with their enclosing statement window.
        temp_pinned: ref[Array[LLVMValueRef]]?
        ; Milestone 3.3: parallel-for capture-scan scratch. parfor_locals
        ; holds the names bound inside the scanned body (scoped — callers
        ; save/restore the length around nested scopes); parfor_captures
        ; collects every free name that resolves in the enclosing scope.
        ; Scratch for ONE scan at a time: emit_parallel_for copies the
        ; result out before it emits the body (a nested promoted for
        ; would rescan into the same arrays).
        parfor_locals: ref[Array[String]]?
        parfor_captures: ref[Array[String]]?
        ; Milestone 4.2: static body-weight memo (mangled name -> saturated
        ; weight) plus the stack of names currently being weighed (recursion
        ; falls back to the flat call cost instead of diverging).
        weight_memo_names: ref[Array[String]]?
        weight_memo_vals: ref[Array[size_t]]?
        weight_stack: ref[Array[String]]?
        ; Milestone 4.4: plain `for` drives the engine. One TaskPlanner per
        ; Emitter answers "does this body verify parallelizable?" per loop
        ; site (its purity memo persists across sites). parfor_file is the
        ; source file of the function currently being emitted — the
        ; classifier's foundation-containment rule keys on it.
        parfor_checker: TaskPlanner
        parfor_file: String
        ; Stage 7.2: symbols of region swizzle walkers already generated in
        ; this module. The registry (not a body-count query) also breaks
        ; type-level recursion: a walker's shell registers BEFORE its body
        ; is built, so a self-referential type finds its own symbol.
        region_walkers: ref[Array[String]]?
        ; Name of the concept whose method body is currently being emitted (the
        ; `this` receiver's type, pointer/ref peeled). Empty for free functions.
        ; Lets resolve_reference_page lower `^field` (a `^host` sigil naming a
        ; pointer[Page] FIELD of the receiver, as in opensp's Parser) by loading
        ; this.<field>. scaly/scalyc never use `^field`, so this stays neutral.
        current_receiver_concept: String
    )
    {
        init(cfg: EmitterConfig)
        {
            set config: cfg
            set context: LLVMContextRef(null)
            set external_context: LLVMContextRef(null)
            set has_external_context: false
            set target_is_coff: false
            set llvm_module: LLVMModuleRef(null)
            set builder: LLVMBuilderRef(null)
            set di_builder: LLVMDIBuilderRef(null)
            set di_file: LLVMMetadataRef(null)
            set di_cu: LLVMMetadataRef(null)
            set current_di_scope: LLVMMetadataRef(null)
            set source_text: String()
            set source_file: String()
            set current_plan: null
            set type_cache_names: Array[String]^this()
            set type_cache_types: Array[LLVMTypeRef]^this()
            set struct_cache_names: Array[String]^this()
            set struct_cache_types: Array[LLVMTypeRef]^this()
            set di_type_cache_names: Array[String]^this()
            set di_type_cache_types: Array[LLVMMetadataRef]^this()
            set function_cache_names: Array[String]^this()
            set function_cache_funcs: Array[LLVMValueRef]^this()
            set function_cache_page_param: Array[int]^this()
            set type_index: ConceptIndex.create(131072)
            set struct_index: ConceptIndex.create(131072)
            set function_index: ConceptIndex.create(262144)
            set di_index: ConceptIndex.create(131072)
            set throws_result_names: Array[String]^this()
            set throws_result_types: Array[LLVMTypeRef]^this()
            set intrinsic_type_names: Array[String]^this()
            set intrinsic_types: Array[IntrinsicTypeInfo]^this()
            set current_function: LLVMValueRef(null)
            set current_block: LLVMBasicBlockRef(null)
            set current_function_can_throw: false
            set function_local_frame: LLVMValueRef(null)
            set function_local_page: LLVMValueRef(null)
            set function_local_page_block: LLVMBasicBlockRef(null)
            set function_local_page_init: LLVMValueRef(null)
            set function_local_frame_parent_store: LLVMValueRef(null)
            set current_frame_parent: LLVMValueRef(null)
            set tail_loop_block: LLVMBasicBlockRef(null)
            set tail_loop_phis: Array[LLVMValueRef]^this()
            set tail_loop_shadows: Array[LLVMValueRef]^this()
            set tail_loop_stages: Array[LLVMValueRef]^this()
            set tail_loop_slot_types: Array[LLVMTypeRef]^this()
            set tail_loop_mangled: String()
            set local_var_names: Array[String]^this()
            set local_var_values: Array[LLVMValueRef]^this()
            set scope_marks: Array[size_t]^this()
            set current_region: RegionInfo^this()
            set loop_stack: Array[LoopContext]^this()
            set temp_pool_types: Array[LLVMTypeRef]^this()
            set temp_pool_slots: Array[LLVMValueRef]^this()
            set temp_pool_free: Array[size_t]^this()
            set temp_pool_start: 0
            set temp_stmt_log: Array[size_t]^this()
            set temp_stmt_log_start: 0
            set temp_pinned: Array[LLVMValueRef]^this()
            set parfor_locals: Array[String]^this()
            set region_walkers: Array[String]^this()
            set parfor_captures: Array[String]^this()
            set weight_memo_names: Array[String]^this()
            set weight_memo_vals: Array[size_t]^this()
            set weight_stack: Array[String]^this()
            set parfor_checker: TaskPlanner^this()
            set parfor_file: String()
            set current_receiver_concept: String()
        }

        ; ========================================================================
        ; Initialization
        ; ========================================================================

        ; Initialize the emitter (create LLVM context, builder, etc.)
        procedure initialize(this, module_name: String)
        {
            ; Create LLVM context (or adopt the JIT ThreadSafeContext's context).
            if has_external_context
                set context: external_context
            else
                set context: LLVMContextCreate()

            ; Create module. Use to_c_string#, not c_data — the latter
            ; returns a pointer into the String's varint-prefixed buffer
            ; with NO null terminator, and LLVMModuleCreateWithNameInContext
            ; reads until NUL. Without this, the Module ID is garbage from
            ; whatever follows in the heap page (session 28).
            set llvm_module: LLVMModuleCreateWithNameInContext(module_name.to_c_string(), context)

            ; Create builder
            set builder: LLVMCreateBuilderInContext(context)

            ; Stamp the module with the target's DataLayout. Every consumer
            ; that folds a `ptrtoint (getelementptr (%T, null, 1))` allocation
            ; size must use the SAME layout the backend uses for field offsets;
            ; a module without a datalayout line makes `opt` fold with LLVM's
            ; DEFAULT layout (i64 ABI-align 4) while llc lays out with the
            ; target layout (i64 align 8) — region allocations come out
            ; undersized (Planner: 1208 vs 1216) and the heap corrupts. llc
            ; masked this at O0 by stamping the target layout itself.
            apply_target_layout()

            ; Initialize intrinsic types
            init_intrinsic_types()

            ; Set up DWARF debug info (-g). No-op unless emit_debug_info.
            init_debug_info()
        }

        ; Resolve the emission triple (host default, or --target override) to a
        ; TargetMachine and copy its DataLayout string onto the module. Best
        ; effort: on any failure the module keeps no layout — the llc path
        ; still works exactly as before.
        procedure apply_target_layout(this)
        {
            LLVMInitializeAArch64TargetInfo()
            LLVMInitializeAArch64Target()
            LLVMInitializeAArch64TargetMC()
            LLVMInitializeX86TargetInfo()
            LLVMInitializeX86Target()
            LLVMInitializeX86TargetMC()

            var triple (LLVMGetDefaultTargetTriple() as pointer[const_char])
            if config.target_triple.get_length() > 0
            {
                let override_triple config.target_triple.to_c_string()
                set triple: override_triple
            }
            else
            {
                if triple = null
                    return
            }

            ; Stage 7: the object format decides whether a linkonce_odr function
            ; needs a comdat. This is the only place the emission triple is
            ; resolved before any function is emitted, so it is where the question
            ; gets answered — once, not per function.
            set target_is_coff: triple_is_coff(triple)

            var target LLVMTargetRef(null)
            let lookup_err LLVMGetTargetFromTriple(triple, &target, null as pointer[pointer[char]])
            if lookup_err <> 0
                return

            let tm LLVMCreateTargetMachine(target, triple,
                "generic" as pointer[const_char],
                "" as pointer[const_char],
                0, 2, 0)
            if tm.handle = null
                return

            let td LLVMCreateTargetDataLayout(tm)
            if td.handle <> null
            {
                let dl_str LLVMCopyStringRepOfTargetData(td)
                if dl_str <> null
                {
                    LLVMSetDataLayout(llvm_module, dl_str as pointer[const_char])
                    LLVMDisposeMessage dl_str
                }
                LLVMDisposeTargetData td
            }
            LLVMDisposeTargetMachine tm
        }

        ; Does this triple emit COFF? The OS component is the whole answer: every
        ; Windows triple carries `windows` (x86_64-pc-windows-msvc,
        ; aarch64-pc-windows-gnu, …) and no ELF or Mach-O triple does. Asked of
        ; the TRIPLE rather than of the host, because `--target` cross-emits.
        function triple_is_coff(this, t: pointer[const_char]) returns bool
        {
            if t = null
                return false
            ; The page-hosted constructions bind POINTERS, and a method call on
            ; the pointer would hand `contains` the address where it expects the
            ; String value — the deref-receiver class. Bind the values first.
            let sp String^this(t)
            let np String^this("windows")
            let s *sp
            let needle *np
            s.contains(needle)
        }

        ; Give a body-carrying, non-private function its LinkOnceODR linkage —
        ; and, on COFF only, the comdat that linkage REQUIRES there.
        ;
        ; ★Stage 7. Mach-O and ELF lower `linkonce_odr` on their own (weak
        ; symbols), so four targets have never needed this. COFF has no weak
        ; definition in the ELF sense: the assembler answers a bare `.weak` by
        ; INVENTING a default symbol named after that object's anchor
        ; (`.weak.<sym>.default.<anchor>`), so two objects carrying the same
        ; inline body disagree about the default and `link.exe` gives up with
        ; LNK1227. With a comdat the body lands in
        ; `.section .text,"xr",discard,<sym>` — real ODR selection, and the
        ; linker discards the duplicates silently.
        ;
        ; ★It must NOT be unconditional: `llc` refuses a comdat on Mach-O
        ; outright ("MachO doesn't support COMDATs"), so an unguarded version
        ; breaks both Apple targets. Guarding on the object format keeps the
        ; emission SEMANTICS of the four existing targets exactly as they were.
        ;
        ; The comdat's name is read back off the VALUE rather than taken from
        ; `func.mangled_name`, because a non-extern name collision is
        ; auto-renamed by LLVM (`name.1` — see the s187 note in
        ; emit_function_decl) and on COFF the comdat name must be the leader
        ; SYMBOL's name. A freshly inserted comdat selects `Any`, which is what
        ; ODR wants, so nothing sets a selection kind.
        ; The resolved target's object format, answered for a caller OUTSIDE the
        ; emitter — `cli.run`'s link step, which has to know whether it is building
        ; a POSIX or a Windows command line (no `-lm` there, `-lws2_32` instead, a
        ; `.lib` archive and a temp directory that exists).
        ;
        ; ★It is a getter rather than a second `LLVMGetDefaultTargetTriple()` in
        ; cli.scaly on purpose: `apply_target_layout` is the ONE place the emission
        ; triple is resolved (`--target` override included), and a second copy of
        ; the "is this Windows" test is a second thing to keep in agreement. Same
        ; reasoning as the comdat below — the OBJECT FORMAT decides, asked once.
        ; ★For the six targets this compiler emits for, COFF and Windows are the
        ; same set, which is why one predicate can serve a linkage question and a
        ; link-command question at the same time.
        function target_is_coff_format(this) returns bool
        {
            target_is_coff
        }

        procedure set_linkonce_odr(this, fn: LLVMValueRef)
        {
            LLVMSetLinkage(fn, LLVMLinkage.LinkOnceODR())
            if target_is_coff = false
                return
            var name_len: size_t 0
            let name LLVMGetValueName2(fn, &name_len)
            if name = null
                return
            if name_len = 0
                return
            let cd LLVMGetOrInsertComdat(llvm_module, name as pointer[const_char])
            LLVMSetComdat(fn, cd)
        }

        ; Record the source file path + contents for -g. Must be called
        ; before emit() so initialize()'s init_debug_info() sees them.
        procedure set_debug_source(this, file: String, src: String)
        {
            set source_file: file
            set source_text: src
        }

        ; Create the DIBuilder, compile unit and file, and set the DWARF
        ; module flags. Gated on emit_debug_info (if runs the return when
        ; the flag is FALSE — Scaly hard rule #6).
        procedure init_debug_info(this)
        {
            if config.emit_debug_info = false
                return

            ; Module flags: Dwarf Version = 4 (lldb-friendly),
            ; Debug Info Version = 3 (DEBUG_METADATA_VERSION). Behavior 1 = Warning.
            let i32_ty LLVMInt32TypeInContext(context)
            let dwarf_ver LLVMValueAsMetadata(LLVMConstInt(i32_ty, 4, 0))
            var dwarf_key "Dwarf Version"
            LLVMAddModuleFlag(llvm_module, 1, dwarf_key.c_data(), dwarf_key.get_length(), dwarf_ver)
            let di_ver LLVMValueAsMetadata(LLVMConstInt(i32_ty, 3, 0))
            var di_key "Debug Info Version"
            LLVMAddModuleFlag(llvm_module, 1, di_key.c_data(), di_key.get_length(), di_ver)

            ; DIBuilder + file + compile unit.
            set di_builder: LLVMCreateDIBuilder(llvm_module)

            var fname source_file
            if fname.get_length() = 0
                set fname: "<unknown>"
            var dir "."
            set di_file: LLVMDIBuilderCreateFile(di_builder, fname.c_data(), fname.get_length(), dir.c_data(), dir.get_length())

            ; lang 1 = DW_LANG_C89 (closest to Scaly), emission kind 1 = Full.
            var producer "scalyc"
            var empty ""
            set di_cu: LLVMDIBuilderCreateCompileUnit(di_builder, 1, di_file, producer.c_data(), producer.get_length(), 0, empty.c_data(), 0, 0, empty.c_data(), 0, 1, 0, 1, 0, empty.c_data(), 0, empty.c_data(), 0)
        }

        ; Convert a byte offset into the source into a 1-based (line, column).
        ; Mirrors cli.print_diagnostics#'s scan; numeric LF compare (10) per s185.
        function compute_debug_pos(this, offset: size_t) returns DebugPos
        {
            var line: i32 1
            var col: i32 1
            let src_len source_text.get_length()
            var target offset
            if target > src_len
                set target: src_len
            var off: size_t 0
            while off < target
            {
                let c source_text.get off
                if c = ("\n" as char)
                {
                    set line: line + 1
                    set col: 1
                }
                else
                    set col: col + 1
                set off: off + 1
            }
            DebugPos(line, col)
        }

        ; Attach a DILocation to the builder for subsequent instructions.
        ; No-op unless emit_debug_info and a function scope is active.
        procedure set_debug_location(this, span: Span)
        {
            if config.emit_debug_info = false
                return
            if current_di_scope.handle = null
                return
            let pos compute_debug_pos span.start
            let loc LLVMDIBuilderCreateDebugLocation(context, pos.line, pos.col, current_di_scope, LLVMMetadataRef null)
            LLVMSetCurrentDebugLocation2(builder, loc)
        }

        ; Create the DISubprogram for a function being emitted, attach it to
        ; llvm_func, store it as current_di_scope, and set an initial line
        ; location so prologue instructions carry a !dbg. -g only.
        ; Uses the current_function field (NOT a passed LLVMValueRef param):
        ; a single-ptr-field struct param arrives as a stack-alloca alias under
        ; the stage-0/1 ABI (s34/s36), so LLVMSetSubprogram would get a garbage
        ; handle. The field read is unaffected.
        procedure set_function_debug_scope(this, func: PlannedFunction)
        {
            let pos compute_debug_pos func.loc.start

            ; Signature for the DISubprogram: element 0 is the RETURN type, elements
            ; 1..n the parameters, read from func.input — so a method's `this` is
            ; included and the positions line up with the arg_no values
            ; emit_function_body gives the DW_TAG_formal_parameter DIEs.
            ;
            ; What it buys, measured 2026-08-11: without a return type lldb's
            ; `finish` reports only "stop reason = step out" and NO `Return value:`
            ; line, where clang-built code prints one.
            ;
            ; ★A NULL element — the canonical "void return" spelling — SIGSEGVs
            ; inside LLVM's getOrCreateTypeArray, because the C shim casts every
            ; element to DIType. So "void" cannot be SAID through this API at all:
            ; a function whose return type does not resolve keeps the empty array it
            ; always had (breakpoints and stepping never needed one), and a single
            ; unresolvable PARAMETER degrades to the return type alone rather than
            ; risk a null in the middle. Both fallbacks are exactly today's
            ; behaviour, so this can only add information, never lose it.
            var ret_dty LLVMMetadataRef(null)
            if func.return_type <> null
            {
                let rt_ref func.return_type.unwrap()
                set ret_dty: di_type_for((*rt_ref))
            }
            var sig_input_count: size_t 0
            if func.input <> null
            {
                let sig_in_ref func.input.unwrap()
                set sig_input_count: (*sig_in_ref).length
            }
            var sig_vec Vector[LLVMMetadataRef](sig_input_count + 1)
            var sig_ptr (null as pointer[LLVMMetadataRef])
            var sig_count: size_t 0
            if ret_dty.handle <> null
            {
                sig_vec.put(0, ret_dty)
                set sig_count: 1
                var sig_complete: bool true
                if func.input <> null
                {
                    let sig_items_ref func.input.unwrap()
                    let sig_items (*sig_items_ref)
                    var si: size_t 0
                    while si < sig_items.length
                    {
                        var sig_pdty LLVMMetadataRef(null)
                        let sig_ip sig_items.get si
                        if sig_ip <> null
                        {
                            let sig_item (*sig_ip)
                            if sig_item.item_type <> null
                            {
                                let sig_itt sig_item.item_type.unwrap()
                                set sig_pdty: di_type_for((*sig_itt))
                            }
                        }
                        if sig_pdty.handle = null
                            set sig_complete: false
                        if sig_complete
                        {
                            sig_vec.put(sig_count, sig_pdty)
                            set sig_count: sig_count + 1
                        }
                        set si: si + 1
                    }
                }
                if sig_complete = false
                    set sig_count: 1
                set sig_ptr: sig_vec.data
            }
            let subroutine_ty LLVMDIBuilderCreateSubroutineType(di_builder, di_file, sig_ptr, (sig_count as i32), 0)

            var name func.name
            var mangled func.mangled_name
            ; is_local_to_unit=0, is_definition=1, flags=0, is_optimized=0 — cast
            ; to i32 so the call passes 4-byte stack args (Apple-arm64 packing;
            ; see LLVM.scaly). pos.line/scope_line are already i32.
            let sp LLVMDIBuilderCreateFunction(di_builder, di_file, name.c_data(), name.get_length(), mangled.c_data(), mangled.get_length(), di_file, pos.line, subroutine_ty, 0, 1, pos.line, 0, 0)
            LLVMSetSubprogram(current_function, sp)
            set current_di_scope: sp

            ; Initial location at the function line covers prologue calls.
            let loc LLVMDIBuilderCreateDebugLocation(context, pos.line, pos.col, sp, LLVMMetadataRef null)
            LLVMSetCurrentDebugLocation2(builder, loc)
        }

        ; ------------------------------------------------------------------------
        ; -g: DWARF type construction for aggregate (struct/union) and pointer
        ; locals. All callers if on emit_debug_info. di_type_for is the
        ; dispatcher; di_struct_type/di_union_type build composites with a
        ; forward-decl-then-RAUW cycle break.
        ; ------------------------------------------------------------------------

        function lookup_di_cache(this, name: String) returns LLVMMetadataRef
        {
            let ir di_index.lookup name
            if ir >= 0
            {
                let t di_type_cache_types.get(ir as size_t)
                if t <> null
                    return t
            }
            LLVMMetadataRef null
        }

        ; Map a primitive type name to a DWARF basic type; null if not primitive.
        ; Encodings: signed=5, unsigned=7, boolean=2, float=4, signed_char=6,
        ; unsigned_char=8.
        function di_basic_type(this, name: String) returns LLVMMetadataRef
        {
            var bits: size_t 0
            var enc: i32 (5 as i32)
            if name = "bool"
            {
                set bits: 8
                set enc: 2
            }
            if name = "char"
            {
                set bits: 8
                set enc: 8
            }
            if name = "i8"
                set bits: 8
            if name = "u8"
            {
                set bits: 8
                set enc: 7
            }
            if name = "i16"
                set bits: 16
            if name = "u16"
            {
                set bits: 16
                set enc: 7
            }
            if name = "i32"
                set bits: 32
            if name = "u32"
            {
                set bits: 32
                set enc: 7
            }
            if name = "i64"
                set bits: 64
            if name = "u64"
            {
                set bits: 64
                set enc: 7
            }
            if name = "int"
                set bits: 64
            if name = "uint"
            {
                set bits: 64
                set enc: 7
            }
            if name = "size_t"
            {
                set bits: 64
                set enc: 7
            }
            if name = "float"
            {
                set bits: 32
                set enc: 4
            }
            if name = "f32"
            {
                set bits: 32
                set enc: 4
            }
            if name = "double"
            {
                set bits: 64
                set enc: 4
            }
            if name = "f64"
            {
                set bits: 64
                set enc: 4
            }
            if bits = 0
                return LLVMMetadataRef null
            LLVMDIBuilderCreateBasicType(di_builder, name.c_data(), name.get_length(), bits, enc, 0)
        }

        ; Synthesize an opaque unsigned basic type of the given width — used
        ; for a struct member whose own DIType couldn't be resolved, so the
        ; member stays typed (valid DWARF) and the layout offset is preserved.
        function di_placeholder_type(this, bits: size_t) returns LLVMMetadataRef
        {
            var b bits
            if b = 0
                set b: 8
            var nm ""
            LLVMDIBuilderCreateBasicType(di_builder, nm.c_data(), nm.get_length(), b, 7, 0)
        }

        ; -g only: DIType for a non-generic stdlib struct that the compilation ROOT
        ; never lays out, so it is absent from BOTH current_plan.structures and
        ; current_plan.unions and di_type_for's two scans answer null. That null is
        ; not a cosmetic loss: the `if dty <> null` guards at the declare sites drop
        ; the variable from the DWARF ENTIRELY, which is why every String local and
        ; parameter used to be invisible in the debugger (measured: `var name
        ; String("x")` emitted alloca + store and no #dbg_declare at all).
        ;
        ; Deliberately NOT folded into synthesize_literal_struct#: that function
        ; steers member-access GEP/extract emission, so a new name there would
        ; change NON-`-g` emission. This table is read only under -g.
        ; The generic containers need no entry — their instantiations DO reach
        ; plan.structures (`%_Z6VectorIcE` and friends appear in the IR).
        ; -g only: the DW_AT_name for a struct or union. A generic INSTANTIATION must
        ; not reuse the bare concept name.
        ;
        ; ★lldb uniques types BY NAME across a module, so `Vector[char]` and
        ; `Vector[int]` both emitted as "Vector" collapse into ONE type and one
        ; survivor's member types win for both. Measured 2026-08-11: a `Vector[int]`
        ; whose own DIE says `data: int *` resolved in lldb to `char *`
        ; (`target.FindTypes("Vector")` returned a single type), so every element was
        ; read one byte at a time and a vector of 7, 8, 9 printed as '\a', 0, 0.
        ; Silently WRONG VALUES, not a cosmetic complaint — and it hits every generic
        ; (Vector, Array, List, Node, Slice, the iterators).
        ;
        ; The READABLE form comes from the PlannedType the caller already holds:
        ; Planner.get_readable_name renders `Vector[int]`, and plain `Point` when
        ; there are no arguments. That is both unique and what the source says.
        ;
        ; ★The fallback is the safety property, not a nicety. When the PlannedType
        ; arrives WITHOUT its generics the readable form is the bare `Vector`, which
        ; is exactly the name collapse this function exists to prevent — so in that
        ; case the mangled name wins over prettiness. Detected on the mangled side:
        ; `_Z6VectorIiE` has an `I` and ends in `E`, a plain `_Z5Point` has neither.
        ; A concept literally spelled like `TRIE` trips the test and gets its mangled
        ; name; that is cosmetic noise, never a wrong type.
        ;
        ; (`InstantiationInfo.type_args` in Plan.scaly is the field that LOOKS like
        ; the right source here and is not: nothing in the tree ever constructs an
        ; InstantiationInfo, so `origin` is null on every structure and union. Filling
        ; it would mean a new page-hosted allocation inside plan_structure, where the
        ; surrounding idiom takes `&` of stack locals — a dangling-pointer risk paid
        ; for a cosmetic gain. The PlannedType already has the answer.)
        function di_display_name(this, readable: String, mangled: String) returns String
        {
            if readable.contains("[" as u8)
                return readable
            if mangled.get_length() = 0
                return readable
            if mangled.ends_with("E") = false
                return readable
            if mangled.contains("I" as u8) = false
                return readable
            mangled
        }

        function di_stdlib_struct_type(this, name: String) returns LLVMMetadataRef
        {
            if name <> "String"
                return LLVMMetadataRef null

            let cached lookup_di_cache name
            if cached.handle <> null
                return cached

            ; `define String (data: pointer[u8](null))` — a single-pointer HANDLE
            ; (packages/scaly/0.1.0/scaly/containers/String.scaly). The bytes it
            ; points at carry a varint length prefix, so this member is only the
            ; buffer ADDRESS; decoding it into text is a debugger FORMATTER's job,
            ; not DWARF's.
            var empty ""
            var u8_name "u8"
            let u8_ty di_basic_type u8_name
            var data_name "data"
            let data_ty LLVMDIBuilderCreatePointerType(di_builder, u8_ty, 64, 64, 0, empty.c_data(), 0)
            let member LLVMDIBuilderCreateMemberType(di_builder, di_cu, data_name.c_data(), data_name.get_length(), di_file, 0, 64, 0, 0, 0, data_ty)
            var member_vec Vector[LLVMMetadataRef](1)
            member_vec.put(0, member)
            let final LLVMDIBuilderCreateStructType(di_builder, di_cu, name.c_data(), name.get_length(), di_file, 0, 64, 0, 0, LLVMMetadataRef null, member_vec.data, 1, 0, LLVMMetadataRef null, empty.c_data(), 0)

            let idx di_type_cache_names.length
            di_type_cache_names.add name
            di_type_cache_types.add final
            if final.handle <> null
                di_index.insert_if_absent(name, idx)
            final
        }

        ; Does this planned type denote an object that a POINTER-typed value points
        ; AT, rather than a pointer the debugger should show as a pointer? Decides
        ; direct-vs-shadow at the declare sites below: for a composite, a `ptr`
        ; value IS the object's address, so #dbg_declare goes straight on it; for
        ; anything else the value must be spilled to a shadow slot first. Getting
        ; this backwards is silently wrong by one indirection.
        function di_planned_type_is_composite(this, pt: PlannedType) returns bool
        {
            if pt.name = "pointer"
                return false
            if pt.name = "ref"
                return false
            let basic di_basic_type pt.name
            if basic.handle <> null
                return false
            true
        }

        ; -g only: attach a DWARF variable to STORAGE at the current insertion
        ; point. arg_no = 0 yields a local (DW_TAG_variable); arg_no > 0 yields a
        ; DW_TAG_formal_parameter at that 1-based SOURCE position.
        procedure debug_declare_at(this, name: String, storage: LLVMValueRef, dty: LLVMMetadataRef, dpos: DebugPos, arg_no: size_t, indirect: bool)
        {
            if config.emit_debug_info = false
                return
            if dty.handle = null
                return
            if storage.handle = null
                return
            if current_di_scope.handle = null
                return
            var dvar LLVMMetadataRef(null)
            if arg_no > 0
                set dvar: LLVMDIBuilderCreateParameterVariable(di_builder, current_di_scope, name.c_data(), name.get_length(), (arg_no as i32), di_file, dpos.line, dty, 0, 0)
            if arg_no = 0
                set dvar: LLVMDIBuilderCreateAutoVariable(di_builder, current_di_scope, name.c_data(), name.get_length(), di_file, dpos.line, dty, 0, 0, 0)
            if dvar.handle = null
                return
            ; `indirect` = the slot holds a POINTER to the object rather than the
            ; object, so the location is one dereference away (DW_OP_deref = 0x06).
            ; This is the same shape clang gives an indirect parameter.
            var dexpr LLVMDIBuilderCreateExpression(di_builder, null as pointer[size_t], 0)
            if indirect
            {
                var deref_ops size_t[1]
                set deref_ops[0]: 6
                set dexpr: LLVMDIBuilderCreateExpression(di_builder, deref_ops, 1)
            }
            let dloc LLVMDIBuilderCreateDebugLocation(context, dpos.line, dpos.col, current_di_scope, LLVMMetadataRef null)
            let dblk LLVMGetInsertBlock(builder)
            let ddecl LLVMDIBuilderInsertDeclareRecordAtEnd(di_builder, storage, dvar, dexpr, dloc, dblk)
        }

        ; -g only: give an SSA VALUE a DWARF variable. A `let` binding and a
        ; function parameter are plain SSA values — define_variable binds the VALUE,
        ; not a slot — so there was no storage for #dbg_declare to point at and both
        ; were absent from the DWARF entirely (measured: 0 DW_TAG_formal_parameter
        ; across 49 subprograms, and a program's whole top level invisible because
        ; every top-level statement binds with `let`).
        ;
        ; The value is ALWAYS spilled to a dedicated shadow slot, because
        ; #dbg_declare's address operand must be an alloca (or an argument) — hand
        ; it any other SSA value and the DWARF emitter drops the variable SILENTLY
        ; while the IR metadata still looks perfect. Measured: declaring
        ; `let s String("x")` straight on the region-allocate call result produced a
        ; well-formed !DILocalVariable with a well-formed !DICompositeType and NO
        ; DW_TAG_variable in the .dSYM at all.
        ;
        ; So the only question the planned type decides is the EXPRESSION: when the
        ; value is a `ptr` to a composite (the region-allocated case, and a
        ; by-pointer by-value struct parameter) the slot holds the object's ADDRESS,
        ; so the declare carries DW_OP_deref. Getting that backwards is silently
        ; wrong by one indirection.
        ;
        ; The shadow is an entry_alloca, NOT acquire_temp: a pooled slot may be
        ; handed to another binding while the debugger still believes it holds this
        ; one. Nothing ever READS the shadow, so define_variable keeps binding the
        ; SSA value and not one of lookup_variable's ~40 consumers changes.
        procedure debug_declare_value(this, name: String, value: LLVMValueRef, pt: PlannedType, dpos: DebugPos, arg_no: size_t)
        {
            if config.emit_debug_info = false
                return
            if value.handle = null
                return
            let dty di_type_for pt
            if dty.handle = null
                return
            let vty LLVMTypeOf value
            var indirect: bool false
            if LLVMGetTypeKind(vty) = LLVMTypeKind.Pointer()
                if di_planned_type_is_composite pt
                    set indirect: true
            let shadow entry_alloca(vty, name.c_data())
            let copied copy_struct_value(shadow, value, vty)
            debug_declare_at(name, shadow, dty, dpos, arg_no, indirect)
        }

        function di_type_for(this, pt: PlannedType) returns LLVMMetadataRef
        {
            ; pointer[T] / ref[T] — both lower to ptr; point at the pointee's
            ; DIType (cycle-safe: a struct pointee resolves to its cached
            ; forward decl while it is being built).
            if pt.name = "pointer" || pt.name = "ref"
            {
                var inner LLVMMetadataRef(null)
                if pt.generics <> null
                {
                    let gens (*pt.generics)
                    if gens.length > 0
                    {
                        let g0p gens.get 0
                        if g0p <> null
                            set inner: di_type_for((*g0p))
                    }
                }
                return LLVMDIBuilderCreatePointerType(di_builder, inner, 64, 64, 0, pt.name.c_data(), pt.name.get_length())
            }

            let basic di_basic_type pt.name
            if basic.handle <> null
                return basic

            ; The DWARF name for whatever composite this resolves to. Computed here
            ; because THIS is where the type arguments are still available.
            var dname Planner.get_readable_name pt

            ; struct — prefer the specialised mangled name, else the bare name.
            if current_plan.structures <> null
            {
                let structs (*current_plan.structures)
                if pt.mangled_name.get_length() > 0
                {
                    var i: size_t 0
                    while i < structs.length
                    {
                        let sp structs.get i
                        if sp <> null
                        {
                            let s (*sp)
                            if s.mangled_name = pt.mangled_name
                                return di_struct_type(s, dname)
                        }
                        set i: i + 1
                    }
                }
                var k: size_t 0
                while k < structs.length
                {
                    let sp structs.get k
                    if sp <> null
                    {
                        let s (*sp)
                        if s.name = pt.name
                            return di_struct_type(s, dname)
                    }
                    set k: k + 1
                }
            }

            ; union
            if current_plan.unions <> null
            {
                let unions (*current_plan.unions)
                if pt.mangled_name.get_length() > 0
                {
                    var j: size_t 0
                    while j < unions.length
                    {
                        let up unions.get j
                        if up <> null
                        {
                            let u (*up)
                            if u.mangled_name = pt.mangled_name
                                return di_union_type(u, dname)
                        }
                        set j: j + 1
                    }
                }
                var m: size_t 0
                while m < unions.length
                {
                    let up unions.get m
                    if up <> null
                    {
                        let u (*up)
                        if u.name = pt.name
                            return di_union_type(u, dname)
                    }
                    set m: m + 1
                }
            }

            ; Last resort before giving up: a non-generic stdlib struct this root
            ; never laid out (String). Answering null here LOSES the variable.
            di_stdlib_struct_type pt.name
        }

        ; Build a DICompositeType (DW_TAG_structure_type = 19) for a struct.
        ; Member sizes/offsets come from the planner's already-computed
        ; PlannedProperty.offset (size = next field's offset - this offset, or
        ; struct size for the last field), so no type-size re-derivation needed.
        function di_struct_type(this, s: PlannedStructure, readable: String) returns LLVMMetadataRef
        {
            let cached lookup_di_cache s.mangled_name
            if cached.handle <> null
                return cached

            let pos compute_debug_pos s.loc.start
            let size_bits (s.size * 8)
            var empty ""
            ; Unique per INSTANTIATION — see di_display_name.
            var dname di_display_name(readable, s.mangled_name)

            ; Forward decl FIRST, cached, so a back-pointer member resolves here.
            let fwd LLVMDIBuilderCreateReplaceableCompositeType(di_builder, 19, dname.c_data(), dname.get_length(), di_cu, di_file, pos.line, 0, (size_bits as size_t), 0, 0, empty.c_data(), 0)
            let idx di_type_cache_names.length
            di_type_cache_names.add s.mangled_name
            di_type_cache_types.add fwd
            if fwd.handle <> null
                di_index.insert_if_absent(s.mangled_name, idx)

            var members_ptr (null as pointer[LLVMMetadataRef])
            var added: size_t 0
            if s.properties <> null
            {
                let props (*s.properties)
                if props.length > 0
                {
                    var member_vec Vector[LLVMMetadataRef](props.length)
                    var mi: size_t 0
                    while mi < props.length
                    {
                        let pp props.get mi
                        if pp <> null
                        {
                            let prop (*pp)
                            let this_off prop.offset
                            var next_off s.size
                            if mi + 1 < props.length
                            {
                                let np props.get(mi + 1)
                                if np <> null
                                    set next_off: (*np).offset
                            }
                            var msize_bytes: size_t 0
                            if next_off > this_off
                                set msize_bytes: next_off - this_off
                            let msize_bits (msize_bytes * 8)
                            var mty di_type_for prop.prop_type
                            if mty.handle = null
                                set mty: di_placeholder_type(msize_bits)
                            let member LLVMDIBuilderCreateMemberType(di_builder, fwd, prop.name.c_data(), prop.name.get_length(), di_file, pos.line, (msize_bits as size_t), 0, (this_off * 8), 0, mty)
                            member_vec.put(added, member)
                            set added: added + 1
                        }
                        set mi: mi + 1
                    }
                    set members_ptr: member_vec.data
                }
            }

            let final LLVMDIBuilderCreateStructType(di_builder, di_cu, dname.c_data(), dname.get_length(), di_file, pos.line, (size_bits as size_t), 0, 0, LLVMMetadataRef null, members_ptr, (added as i32), 0, LLVMMetadataRef null, empty.c_data(), 0)
            LLVMMetadataReplaceAllUsesWith(fwd, final)
            di_type_cache_types.put(idx, final)
            final
        }

        ; A tagged union: outer struct { tag @ 0, payload @ tag_size }, where the
        ; payload is a DWARF union of the variant payload types (each at offset 0).
        function di_union_type(this, u: PlannedUnion, readable: String) returns LLVMMetadataRef
        {
            let cached lookup_di_cache u.mangled_name
            if cached.handle <> null
                return cached

            let pos compute_debug_pos u.loc.start
            let size_bits (u.size * 8)
            var empty ""
            ; Unique per INSTANTIATION — see di_display_name.
            var dname di_display_name(readable, u.mangled_name)

            ; Forward decl (emitted as a struct, tag 19), cached for cycle-break.
            let fwd LLVMDIBuilderCreateReplaceableCompositeType(di_builder, 19, dname.c_data(), dname.get_length(), di_cu, di_file, pos.line, 0, (size_bits as size_t), 0, 0, empty.c_data(), 0)
            let idx di_type_cache_names.length
            di_type_cache_names.add u.mangled_name
            di_type_cache_types.add fwd
            if fwd.handle <> null
                di_index.insert_if_absent(u.mangled_name, idx)

            ; Tag: 1 byte for <=256 variants, else 4 (mirrors compute_union_size).
            var tag_size: size_t 1
            if u.variants <> null
                if u.variants.length > 256
                    set tag_size: 4
            let payload_bytes (u.size - tag_size)
            let payload_bits (payload_bytes * 8)

            ; Build the payload union from variants that carry a payload.
            var payload_ty LLVMMetadataRef(null)
            if u.variants <> null
            {
                let variants (*u.variants)
                if variants.length > 0
                {
                    var var_vec Vector[LLVMMetadataRef](variants.length)
                    var vadded: size_t 0
                    var vi: size_t 0
                    while vi < variants.length
                    {
                        let vp variants.get vi
                        if vp <> null
                        {
                            let variant (*vp)
                            if variant.var_type <> null
                            {
                                let vt (*variant.var_type)
                                var vty di_type_for vt
                                if vty.handle = null
                                    set vty: di_placeholder_type(payload_bits)
                                let vmember LLVMDIBuilderCreateMemberType(di_builder, fwd, variant.name.c_data(), variant.name.get_length(), di_file, pos.line, (payload_bits as size_t), 0, 0, 0, vty)
                                var_vec.put(vadded, vmember)
                                set vadded: vadded + 1
                            }
                        }
                        set vi: vi + 1
                    }
                    if vadded > 0
                        set payload_ty: LLVMDIBuilderCreateUnionType(di_builder, di_cu, dname.c_data(), dname.get_length(), di_file, pos.line, (payload_bits as size_t), 0, 0, var_vec.data, (vadded as i32), 0, empty.c_data(), 0)
                }
            }

            ; The TAG gets an ENUMERATION type whose enumerators are the variant
            ; names at their tag values, so a debugger prints `tag = Some` on its
            ; own — no formatter, no mapping table on the reader's side.
            ;
            ; ★This is the only place the mapping can live. The payload union above
            ; holds a member ONLY for variants that carry a payload, so its member
            ; INDEX is not the tag value as soon as one variant is payload-less —
            ; which is why "index the payload union by tag" is not a thing a reader
            ; can do, and why the enumeration is built over ALL variants.
            var tag_dty LLVMMetadataRef(null)
            if u.variants <> null
            {
                let enum_variants (*u.variants)
                if enum_variants.length > 0
                {
                    var enum_vec Vector[LLVMMetadataRef](enum_variants.length)
                    var eadded: size_t 0
                    var ei: size_t 0
                    while ei < enum_variants.length
                    {
                        let evp enum_variants.get ei
                        if evp <> null
                        {
                            let evariant (*evp)
                            let enumerator LLVMDIBuilderCreateEnumerator(di_builder, evariant.name.c_data(), evariant.name.get_length(), (ei as i64), 1)
                            enum_vec.put(eadded, enumerator)
                            set eadded: eadded + 1
                        }
                        set ei: ei + 1
                    }
                    if eadded > 0
                        set tag_dty: LLVMDIBuilderCreateEnumerationType(di_builder, di_cu, dname.c_data(), dname.get_length(), di_file, pos.line, (tag_size * 8), 0, enum_vec.data, (eadded as i32), LLVMMetadataRef null)
                }
            }
            if tag_dty.handle = null
                set tag_dty: di_placeholder_type(tag_size * 8)

            ; Outer struct members: tag, then payload (if any).
            var tag_name "tag"
            var pay_name "payload"
            let tag_member LLVMDIBuilderCreateMemberType(di_builder, fwd, tag_name.c_data(), tag_name.get_length(), di_file, pos.line, (tag_size * 8), 0, 0, 0, tag_dty)
            var out_vec Vector[LLVMMetadataRef](2)
            out_vec.put(0, tag_member)
            var out_count: size_t 1
            if payload_ty.handle <> null
            {
                let pay_member LLVMDIBuilderCreateMemberType(di_builder, fwd, pay_name.c_data(), pay_name.get_length(), di_file, pos.line, (payload_bits as size_t), 0, (tag_size * 8), 0, payload_ty)
                out_vec.put(1, pay_member)
                set out_count: 2
            }

            let final LLVMDIBuilderCreateStructType(di_builder, di_cu, dname.c_data(), dname.get_length(), di_file, pos.line, (size_bits as size_t), 0, 0, LLVMMetadataRef null, out_vec.data, (out_count as i32), 0, LLVMMetadataRef null, empty.c_data(), 0)
            LLVMMetadataReplaceAllUsesWith(fwd, final)
            di_type_cache_types.put(idx, final)
            final
        }

        ; Like set_function_debug_scope but for a synthetic function that has
        ; no PlannedFunction (the top-level `main` wrapping the program's
        ; top-level statements). -g only; caller guards on emit_debug_info.
        ; Attaches to current_function (set by the caller before this).
        procedure set_synthetic_debug_scope(this, name: String, line: i32)
        {
            let subroutine_ty LLVMDIBuilderCreateSubroutineType(di_builder, di_file, null as pointer[LLVMMetadataRef], 0, 0)
            var nm name
            let sp LLVMDIBuilderCreateFunction(di_builder, di_file, nm.c_data(), nm.get_length(), nm.c_data(), nm.get_length(), di_file, line, subroutine_ty, 0, 1, line, 0, 0)
            LLVMSetSubprogram(current_function, sp)
            set current_di_scope: sp
            let loc LLVMDIBuilderCreateDebugLocation(context, line, 1, sp, LLVMMetadataRef null)
            LLVMSetCurrentDebugLocation2(builder, loc)
        }

        ; Clear the builder's current debug location and the active scope.
        ; Called at function-body exit so later stub/forwarder emission (which
        ; has no DISubprogram) does not inherit a stale scope.
        procedure clear_debug_location(this)
        {
            set current_di_scope: LLVMMetadataRef(null)
            LLVMSetCurrentDebugLocation2(builder, LLVMMetadataRef null)
        }

        ; Set the line location for a statement before emitting it. -g only.
        procedure set_statement_debug_location(this, stmt: PlannedStatement)
        {
            choose stmt
                when action: Action
                    set_debug_location action.loc
                when binding: Binding
                    set_debug_location binding.loc
                when ret: Return
                    set_debug_location ret.loc
                when throw_stmt: Throw
                    set_debug_location throw_stmt.loc
                when brk: Break
                    set_debug_location brk.loc
                when cont: Continue
                    set_debug_location cont.loc
        }

        ; Initialize intrinsic type mappings
        procedure init_intrinsic_types(this)
        {
            ; void
            register_intrinsic_type("void", LLVMVoidTypeInContext context, 0, 0, false)

            ; bool (i1)
            register_intrinsic_type("bool", LLVMInt1TypeInContext context, 1, 1, false)

            ; char (i8)
            register_intrinsic_type("char", LLVMInt8TypeInContext context, 1, 1, true)

            ; Signed integers
            register_intrinsic_type("i8", LLVMInt8TypeInContext context, 1, 1, true)
            register_intrinsic_type("i16", LLVMInt16TypeInContext context, 2, 2, true)
            register_intrinsic_type("i32", LLVMInt32TypeInContext context, 4, 4, true)
            register_intrinsic_type("i64", LLVMInt64TypeInContext context, 8, 8, true)
            ; s109: int/uint map to i64 to match stage-0 (Emitter.cpp:154-155).
            ; Itanium mangling still uses 'i'/'j' (encode_type#); the LLVM-level
            ; width difference is silently allowed at link time. Aligning here
            ; makes literals like `0` / `100` flow through to size_t/i64 params
            ; without requiring a separate width-promote pass.
            register_intrinsic_type("int", LLVMInt64TypeInContext context, 8, 8, true)

            ; Unsigned integers
            register_intrinsic_type("u8", LLVMInt8TypeInContext context, 1, 1, false)
            register_intrinsic_type("u16", LLVMInt16TypeInContext context, 2, 2, false)
            register_intrinsic_type("u32", LLVMInt32TypeInContext context, 4, 4, false)
            register_intrinsic_type("u64", LLVMInt64TypeInContext context, 8, 8, false)
            register_intrinsic_type("uint", LLVMInt64TypeInContext context, 8, 8, false)
            register_intrinsic_type("size_t", LLVMInt64TypeInContext context, 8, 8, false)

            ; Floating point
            register_intrinsic_type("float", LLVMFloatTypeInContext context, 4, 4, true)
            register_intrinsic_type("double", LLVMDoubleTypeInContext context, 8, 8, true)
        }

        procedure register_intrinsic_type(this, name: String, llvm_type: LLVMTypeRef, size: size_t, alignment: size_t, is_signed: bool)
        {
            intrinsic_type_names.add name
            intrinsic_types.add(IntrinsicTypeInfo(llvm_type, size, alignment, is_signed))
        }

        ; Dispose of LLVM resources
        procedure dispose(this)
        {
            if builder.handle <> null
                LLVMDisposeBuilder builder

            if llvm_module.handle <> null
                LLVMDisposeModule llvm_module

            if context.handle <> null
                LLVMContextDispose context

        }

        ; ========================================================================
        ; Type Cache
        ; ========================================================================

        function lookup_type_cache(this, name: String) returns LLVMTypeRef
        {
            let ir type_index.lookup name
            if ir >= 0
            {
                let t type_cache_types.get(ir as size_t)
                if t <> null
                    return t
            }
            LLVMTypeRef null
        }

        procedure cache_type(this, name: String, llvm_type: LLVMTypeRef)
        {
            let entry_idx type_cache_names.length
            type_cache_names.add name
            type_cache_types.add llvm_type
            if llvm_type.handle <> null
                type_index.insert_if_absent(name, entry_idx)
        }

        ; ========================================================================
        ; Struct Cache
        ; ========================================================================

        function lookup_struct_cache(this, name: String) returns LLVMTypeRef
        {
            let ir struct_index.lookup name
            if ir >= 0
            {
                let t struct_cache_types.get(ir as size_t)
                if t <> null
                    return t
            }
            LLVMTypeRef null
        }

        procedure cache_struct(this, name: String, llvm_type: LLVMTypeRef)
        {
            let entry_idx struct_cache_names.length
            struct_cache_names.add name
            struct_cache_types.add llvm_type
            if llvm_type.handle <> null
                struct_index.insert_if_absent(name, entry_idx)
        }

        ; s138: Hoist alloca into the current function's entry block, mirroring
        ; stage-0's `createEntryBlockAlloca` (Emitter.cpp:6640). Without
        ; hoisting, an alloca inserted from within a loop body grows the stack
        ; on every iteration (LLVM doesn't merge non-entry allocas), and the
        ; static frame for big functions like Planner.collapse_operand_sequence#
        ; ends up huge enough that a few levels of recursion blow past the 8MB
        ; main-thread stack on macOS (rc=139 when stage-1 compiles
        ; packages/scaly/0.1.0/scaly.scaly). Saves the current insertion point
        ; via LLVMGetInsertBlock, repositions to before the entry block's first
        ; instruction (or at-end if empty), emits the alloca, then restores
        ; the insertion point.
        function entry_alloca(this, ty: LLVMTypeRef, name: pointer[const_char]) returns LLVMValueRef
        {
            ; s34 root fix: plain copy of the by-ptr struct param (emitBinding
            ; now copies single-ptr-field struct params correctly).
            var t ty
            let saved_block LLVMGetInsertBlock(builder)
            ; Scaly's `if cond STMT` runs STMT when cond is TRUE. Fall
            ; back to the in-place alloca only when current_function or
            ; entry_block aren't usable; same-block check avoids a no-op
            ; reposition.
            if current_function.handle = null
                return LLVMBuildAlloca(builder, t, name)
            let entry_block LLVMGetFirstBasicBlock(current_function)
            if entry_block.handle = null
                return LLVMBuildAlloca(builder, t, name)
            if saved_block.handle = entry_block.handle
                return LLVMBuildAlloca(builder, t, name)
            let first_instr LLVMGetFirstInstruction(entry_block)
            if first_instr.handle <> null
            {
                LLVMPositionBuilderBefore(builder, first_instr)
                let a LLVMBuildAlloca(builder, t, name)
                LLVMPositionBuilderAtEnd(builder, saved_block)
                return a
            }
            LLVMPositionBuilderAtEnd(builder, entry_block)
            let a LLVMBuildAlloca(builder, t, name)
            LLVMPositionBuilderAtEnd(builder, saved_block)
            a
        }

        ; ========================================================================
        ; s196: function-local root-page lifecycle (the root-page leak fix).
        ;
        ; A non-rp function that does a #/$/for allocation has no caller page to
        ; allocate on, so the three rp-fallback sites (emit_constructor_call,
        ; emit_call, emit_for) used to call Page.allocate_root_page WITHOUT ever
        ; releasing it — one leaked StackBucket page per fallback occurrence per
        ; call. Compiling the large scalyc.scaly leaked ~177k root pages / ~49GB
        ; and OOM-killed the self-hosted compiler. Stage-0 (Emitter.cpp) caches
        ; ONE page per function (getOrCreateLocalPage) and releases it on every
        ; exit; this ports that lifecycle on a dedicated field
        ; function_local_page (NOT current_region.local_page).
        ; ========================================================================

        ; Look up or declare Page.allocate_root_page() -> ptr.
        function get_alloc_root_page_fn(this) returns LLVMValueRef
        {
            var alloc_fn lookup_function_cache("_ZN4Page18allocate_root_pageEv")
            if alloc_fn.handle = null
                set alloc_fn: LLVMGetNamedFunction(llvm_module, "_ZN4Page18allocate_root_pageEv")
            if alloc_fn.handle = null
            {
                let ret_ty LLVMPointerTypeInContext(context, 0)
                let alloc_ty LLVMFunctionType(ret_ty, null as pointer[LLVMTypeRef], 0, 0)
                set alloc_fn: LLVMAddFunction(llvm_module, "_ZN4Page18allocate_root_pageEv", alloc_ty)
                LLVMSetLinkage(alloc_fn, LLVMLinkage.External())
                cache_function("_ZN4Page18allocate_root_pageEv", alloc_fn)
            }
            alloc_fn
        }

        ; Look up or declare scaly_release_root_page(ptr) -> void.
        function get_release_root_page_fn(this) returns LLVMValueRef
        {
            var rel_fn lookup_function_cache("_Z23scaly_release_root_pageP4Page")
            if rel_fn.handle = null
                set rel_fn: LLVMGetNamedFunction(llvm_module, "_Z23scaly_release_root_pageP4Page")
            if rel_fn.handle = null
            {
                let void_ty LLVMVoidTypeInContext(context)
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                var ptys Vector[LLVMTypeRef](1)
                ptys.put(0, ptr_ty)
                let fty LLVMFunctionType(void_ty, ptys.data, 1, 0)
                set rel_fn: LLVMAddFunction(llvm_module, "_Z23scaly_release_root_pageP4Page", fty)
                LLVMSetLinkage(rel_fn, LLVMLinkage.External())
                cache_function("_Z23scaly_release_root_pageP4Page", rel_fn)
            }
            rel_fn
        }

        ; Look up or declare scaly_force_frame(ptr frame) -> ptr — materialise a
        ; frame's page, PARENTS FIRST (root_pages.scaly, where the LIFO ordering
        ; argument lives). Called wherever a REAL page is needed: the Page.allocate
        ; sites, and nowhere else. Handing a frame to a callee needs no call at all.
        function get_force_frame_fn(this) returns LLVMValueRef
        {
            var fn lookup_function_cache("_Z17scaly_force_frameP5Frame")
            if fn.handle = null
                set fn: LLVMGetNamedFunction(llvm_module, "_Z17scaly_force_frameP5Frame")
            if fn.handle = null
            {
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                var ptys Vector[LLVMTypeRef](1)
                ptys.put(0, ptr_ty)
                let fty LLVMFunctionType(ptr_ty, ptys.data, 1, 0)
                set fn: LLVMAddFunction(llvm_module, "_Z17scaly_force_frameP5Frame", fty)
                LLVMSetLinkage(fn, LLVMLinkage.External())
                cache_function("_Z17scaly_force_frameP5Frame", fn)
            }
            fn
        }

        ; Look up or declare scaly_release_frame(ptr frame) -> void — the epilogue
        ; counterpart, a no-op on a frame nothing ever forced.
        function get_release_frame_fn(this) returns LLVMValueRef
        {
            var fn lookup_function_cache("_Z19scaly_release_frameP5Frame")
            if fn.handle = null
                set fn: LLVMGetNamedFunction(llvm_module, "_Z19scaly_release_frameP5Frame")
            if fn.handle = null
            {
                let void_ty LLVMVoidTypeInContext(context)
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                var ptys Vector[LLVMTypeRef](1)
                ptys.put(0, ptr_ty)
                let fty LLVMFunctionType(void_ty, ptys.data, 1, 0)
                set fn: LLVMAddFunction(llvm_module, "_Z19scaly_release_frameP5Frame", fty)
                LLVMSetLinkage(fn, LLVMLinkage.External())
                cache_function("_Z19scaly_release_frameP5Frame", fn)
            }
            fn
        }

        ; The two-word frame record {page, parent} the caller-page argument points
        ; at. Built as a named struct so the GEPs below read as field accesses.
        function frame_struct_type(this) returns LLVMTypeRef
        {
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var ftys Vector[LLVMTypeRef](2)
            ftys.put(0, ptr_ty)
            ftys.put(1, ptr_ty)
            LLVMStructTypeInContext(context, ftys.data, 2, 0)
        }

        ; Emit `scaly_force_frame(frame)` at the current position.
        function force_frame(this, frame_val: LLVMValueRef) returns LLVMValueRef
        {
            if frame_val.handle = null
                return LLVMValueRef null
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let fn get_force_frame_fn()
            var tys Vector[LLVMTypeRef](1)
            tys.put(0, ptr_ty)
            let fty LLVMFunctionType(ptr_ty, tys.data, 1, 0)
            var args Vector[LLVMValueRef](1)
            args.put(0, frame_val)
            LLVMBuildCall2(builder, fty, fn, args.data, 1, "forced_page")
        }

        ; Wrap an ALREADY REAL page in a throw-away frame so it can travel as a
        ; caller-page argument: {page, null}. scaly_force_frame returns it without
        ; touching the StackBucket, and nobody releases it — the page is not this
        ; frame's to own. Needed wherever a genuine page reaches a call site: the
        ; `^this` / `^name` / `^field` sigils, and the region a fiber is handed.
        ;
        ; ★One alloca PER SITE, never a reusable scratch frame. A call whose
        ; argument list contains another such call would otherwise overwrite the
        ; outer frame before the outer call reads it (store outer, store inner,
        ; call inner, call outer) and the outer callee would allocate on the inner
        ; page. The alloca costs stack space only.
        function wrap_page_in_frame(this, page_val: LLVMValueRef) returns LLVMValueRef
        {
            if page_val.handle = null
                return LLVMValueRef null
            let frame_ty frame_struct_type()
            let frame entry_alloca(frame_ty, "wrapped_frame")
            if frame.handle = null
                return LLVMValueRef null
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            ; The stores stay at the CURRENT position: page_val need not dominate
            ; the entry block (it is commonly a Page.get call in this very block).
            LLVMBuildStore(builder, page_val, frame)
            let parent_ptr LLVMBuildStructGEP2(builder, frame_ty, frame, 1, "wrapped.parent")
            LLVMBuildStore(builder, LLVMConstNull(ptr_ty), parent_ptr)
            frame
        }

        ; Resolve the page for a `^name` reference lifetime: the named local
        ; variable's value, wrapped in Page.get(...) when the name is `this`
        ; (the receiver is an object pointer, not a pointer[Page]). Returns null
        ; if the named variable is not in scope. Shared by emit_constructor_call
        ; and emit_call so that `x.method^own_page(...)` allocates on own_page —
        ; NOT on the function-local page, which is released on exit (s196: an
        ; escaping allocation on the local page is a use-after-free).
        ; Peel pointer[T]/ref[T] down to the underlying concept name (else t.name).
        function peel_concept_name(this, t: PlannedType) returns String
        {
            if t.name = "pointer"
                return this.first_generic_name(t)
            if t.name = "ref"
                return this.first_generic_name(t)
            t.name
        }

        function first_generic_name(this, t: PlannedType) returns String
        {
            if t.generics <> null
            {
                let g (*t.generics)
                if g.length > 0
                {
                    let g0 g.get 0
                    if g0 <> null
                        return (*g0).name
                }
            }
            t.name
        }

        ; The first generic argument of `t`, or `t` itself when it has none --
        ; the type-level sibling of first_generic_name#. Used to peel one
        ; reference wrapper at a time: Option[ref[T]] -> ref[T] -> T. A single
        ; exit through one local keeps it clear of the multi-branch by-value
        ; return hazard (a struct returned from several branches region-
        ; allocates per site and the merging phi fails llc verification).
        function first_generic_of(this, t: PlannedType) returns PlannedType
        {
            var result t
            if t.generics <> null
            {
                let g (*t.generics)
                if g.length > 0
                {
                    let g0 g.get 0
                    if g0 <> null
                        set result: (*g0)
                }
            }
            result
        }

        ; Index of the receiver concept's property named `field_name` (-1 if none).
        ; Used to lower a `^field` page sigil (host is a member, not a local).
        function receiver_field_index(this, field_name: String) returns int
        {
            if current_receiver_concept.get_length() = 0
                return -1
            if current_plan = null
                return -1
            let plan_ref current_plan
            let plan (*plan_ref)
            if plan.structures = null
                return -1
            let structures (*plan.structures)
            var i: size_t 0
            while i < structures.length
            {
                let sp structures.get i
                if sp <> null
                {
                    let s (*sp)
                    if s.name = current_receiver_concept
                    {
                        if s.properties <> null
                        {
                            let props (*s.properties)
                            var pi: size_t 0
                            while pi < props.length
                            {
                                let pp props.get pi
                                if pp <> null
                                    if (*pp).name = field_name
                                        return pi as int
                                set pi: pi + 1
                            }
                        }
                    }
                }
                set i: i + 1
            }
            -1
        }

        function resolve_reference_page(this, ref_name: String) returns LLVMValueRef
        {
            let nv lookup_variable ref_name
            if nv.handle = null
            {
                ; ref_name is not a local/param — it may be a pointer[Page] FIELD of
                ; the receiver (opensp Parser's `^host` where host is a member). Load
                ; this.<field> and use it as the page. scaly/scalyc never write
                ; `^field`, so this fallback is emission-neutral for the self-compile.
                let this_val lookup_variable("this")
                if this_val.handle = null
                    return LLVMValueRef null
                let fidx receiver_field_index(ref_name)
                if fidx < 0
                    return LLVMValueRef null
                ; Prefer the cached named struct; fall back to a literal struct
                ; built from the receiver's plan properties (the cache may not yet
                ; hold the receiver type when a method body is emitted).
                var sty lookup_struct_cache(current_receiver_concept)
                if sty.handle = null
                    set sty: synthesize_literal_struct(current_receiver_concept)
                if sty.handle = null
                    return LLVMValueRef null
                let field_ptr LLVMBuildStructGEP2(builder, sty, this_val, fidx as u32, "page.field")
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                return LLVMBuildLoad2(builder, ptr_ty, field_ptr, "page.load")
            }
            var page_val nv
            ; A `var`-bound page name resolves to its stack SLOT, not to the page:
            ; lookup_variable returns the alloca for a mutable binding and the SSA
            ; value for a `let`. Handing the slot on unloaded made the whole
            ; construction allocate from the ADDRESS OF THE VARIABLE —
            ; scaly_force_frame returned the stack slot as the "page" and
            ; Page.allocate then wrote a page header over the frame. `let ep p`
            ; worked, `var ep p` corrupted memory or SIGSEGVed, with nothing said
            ; (2026-08-04; the workaround note in Array.scaly is what this cost).
            ; Only a slot that HOLDS a pointer is loaded, so an SSA parameter (the
            ; usual `this`) and a by-value struct alloca are untouched.
            let slot LLVMIsAAllocaInst(page_val)
            if slot.handle <> null
            {
                let slot_ty LLVMGetAllocatedType(page_val)
                if slot_ty.handle <> null
                    if LLVMGetTypeKind(slot_ty) = LLVMTypeKind.Pointer()
                    {
                        let sptr_ty LLVMPointerTypeInContext(context, 0)
                        set page_val: LLVMBuildLoad2(builder, sptr_ty, page_val, "page.var.load")
                    }
            }
            if ref_name = "this"
            {
                ; ^this: wrap the receiver in Page.get(this). Mirrors stage-0's
                ; generatePageGetThis.
                var get_fn lookup_function_cache("_Z3getPv")
                if get_fn.handle = null
                    set get_fn: LLVMGetNamedFunction(llvm_module, "_Z3getPv")
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                var get_param_tys Vector[LLVMTypeRef](1)
                get_param_tys.put(0, ptr_ty)
                let get_fn_ty LLVMFunctionType(ptr_ty, get_param_tys.data, 1, 0)
                if get_fn.handle = null
                {
                    set get_fn: LLVMAddFunction(llvm_module, "_Z3getPv", get_fn_ty)
                    LLVMSetLinkage(get_fn, LLVMLinkage.External())
                    cache_function("_Z3getPv", get_fn)
                }
                var get_args Vector[LLVMValueRef](1)
                get_args.put(0, page_val)
                set page_val: LLVMBuildCall2(builder, get_fn_ty, get_fn, get_args.data, 1, "own_page")
            }
            ; `^rp` / `^page` name the caller-page slot, which since the frame
            ; chain (2026-08-02) holds a FRAME, not a page. Everything else here
            ; — `^this`, a pointer[Page] binding, a pointer[Page] field — is a
            ; genuine page and stays one.
            if current_frame_parent.handle <> null
                if page_val.handle = current_frame_parent.handle
                    return force_frame(page_val)
            page_val
        }

        ; The same `^name` resolution, but yielding a FRAME for use as a
        ; caller-page argument: a genuine page gets wrapped, the caller-page slot
        ; travels as it is. Keeps the two currencies apart at every call site —
        ; passing a raw page where a callee expects a frame is the one mistake this
        ; ABI cannot diagnose (both are a bare `ptr`).
        function resolve_reference_frame(this, ref_name: String) returns LLVMValueRef
        {
            ; The caller-page slot is already a frame — hand it on unforced, or
            ; the `^rp` sigil alone would open the caller's region.
            let nv lookup_variable ref_name
            if nv.handle <> null
                if current_frame_parent.handle <> null
                    if nv.handle = current_frame_parent.handle
                        return nv
            let page_val resolve_reference_page(ref_name)
            if page_val.handle = null
                return LLVMValueRef null
            wrap_page_in_frame page_val
        }

        ; Return this function's own FRAME — the {page, parent} record that IS the
        ; caller-page currency. Creating it emits no call: the entry block gets a
        ; two-word alloca initialised to {null, <incoming frame>}, and handing it
        ; to a callee is just passing its address.
        ;
        ; PARENT-LINKED FRAME CHAIN (2026-08-02). Lazy slots (2026-08-01) took the
        ; region out of the prologue but could only reach materialisations a
        ; function made for ITSELF: a caller that opened its page ONLY to pass it
        ; to a callee which then allocated nothing still paid the full push/pop.
        ; Measured on the dazzle DSSSL engine (tests/dazzle/PERFORMANCE.md), that
        ; was 13.79 of the remaining 28.59 million frames per 977 KB document.
        ; Passing the RECORD instead of a materialised page lets the callee decide,
        ; and 13.57 million of those frames stop existing.
        ;
        ; ★The ordering rule that makes it sound — every materialisation forces the
        ; parent chain first — lives in scaly_force_frame (root_pages.scaly),
        ; together with the proof that strict LIFO survives it. Read that before
        ; touching either side.
        ;
        ; ★The frame is created on FIRST DEMAND, not at entry: a function that
        ; never needs a region at all should not pay two stores for one.
        function get_local_frame(this) returns LLVMValueRef
        {
            if current_function.handle = null
                return LLVMValueRef null
            let entry_block LLVMGetFirstBasicBlock(current_function)
            if entry_block.handle = null
                return LLVMValueRef null

            if function_local_frame.handle <> null
                return function_local_frame

            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let frame_ty frame_struct_type()

            ; Reserve the record at entry-block start, where it dominates every
            ; demand site and every exit.
            let saved_block LLVMGetInsertBlock(builder)
            let first_instr LLVMGetFirstInstruction(entry_block)
            if first_instr.handle <> null
                LLVMPositionBuilderBefore(builder, first_instr)
            if first_instr.handle = null
                LLVMPositionBuilderAtEnd(builder, entry_block)

            let frame LLVMBuildAlloca(builder, frame_ty, "frame")
            set function_local_frame: frame
            set function_local_page_init: LLVMBuildStore(builder, LLVMConstNull(ptr_ty), frame)

            ; parent = the frame this function was handed, or null when it has
            ; none. A null parent CUTS the chain, which is sound precisely because
            ; a function that cannot force its caller's frame also cannot hand it
            ; to anyone who could (the argument at scaly_force_frame).
            let parent_ptr LLVMBuildStructGEP2(builder, frame_ty, frame, 1, "frame.parent")
            var parent_val LLVMConstNull(ptr_ty)
            if current_frame_parent.handle <> null
                set parent_val: current_frame_parent
            set function_local_frame_parent_store: LLVMBuildStore(builder, parent_val, parent_ptr)

            if saved_block.handle <> null
                LLVMPositionBuilderAtEnd(builder, saved_block)

            patch_prior_returns frame
            frame
        }

        ; Materialise an arbitrary frame's page. Routed through the block cache
        ; when the frame is this function's own, so several allocations in one
        ; block still share a single call.
        function materialise_frame(this, frame_val: LLVMValueRef) returns LLVMValueRef
        {
            if frame_val.handle = null
                return LLVMValueRef null
            if function_local_frame.handle <> null
                if frame_val.handle = function_local_frame.handle
                    return get_or_create_local_page()
            force_frame frame_val
        }

        ; Return this function's local root PAGE at the current builder position,
        ; materialising it through scaly_force_frame. Only the sites that really
        ; allocate need this; a caller-page argument takes get_local_frame instead.
        ;
        ; ★The materialisation is a plain CALL, not an inline null-check, on
        ; purpose: this runs in the middle of expression emission (emit_call,
        ; emit_constructor_call, emit_for), where splitting the current block
        ; would invalidate every insert block those walkers captured before
        ; asking for a page. The runtime helper is small enough that opt/LTO
        ; inlines its fast path; an -O0 build keeps one call per demand.
        function get_or_create_local_page(this) returns LLVMValueRef
        {
            let frame get_local_frame()
            if frame.handle = null
                return LLVMValueRef null

            let cur_block LLVMGetInsertBlock(builder)

            ; Reuse the page already forced in THIS block. The terminator test
            ; keeps the cache honest: it holds only while the block is still being
            ; appended to, never when the builder was repositioned INTO a finished
            ; block (patch_prior_returns, entry_alloca), where the cached call
            ; would not yet dominate the insert point.
            if function_local_page.handle <> null
                if cur_block.handle = function_local_page_block.handle
                    if LLVMGetBasicBlockTerminator(cur_block).handle = null
                        return function_local_page

            set function_local_page: force_frame(frame)
            set function_local_page_block: cur_block
            function_local_page
        }

        ; Give the returns already emitted into the current function (before the
        ; frame existed) their release call.
        ;
        ; ★These paths are NOT necessarily page-free at runtime, which is why the
        ; call is the frame-releasing, null-tolerant one rather than the bare
        ; scaly_release_root_page the eager version could use here: a return
        ; inside a LOOP body is emitted before a demand site further down, yet the
        ; second iteration reaches it with the page long since materialised.
        procedure patch_prior_returns(this, slot: LLVMValueRef)
        {
            if slot.handle = null
                return
            let rel_fn get_release_frame_fn()
            let void_ty LLVMVoidTypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var ptys Vector[LLVMTypeRef](1)
            ptys.put(0, ptr_ty)
            let rel_fty LLVMFunctionType(void_ty, ptys.data, 1, 0)

            let saved_block LLVMGetInsertBlock(builder)
            var bb LLVMGetFirstBasicBlock(current_function)
            while bb.handle <> null
            {
                let term LLVMGetBasicBlockTerminator(bb)
                if term.handle <> null
                {
                    let ret_inst LLVMIsAReturnInst(term)
                    if ret_inst.handle <> null
                    {
                        LLVMPositionBuilderBefore(builder, term)
                        var args Vector[LLVMValueRef](1)
                        args.put(0, slot)
                        LLVMBuildCall2(builder, rel_fty, rel_fn, args.data, 1, "")
                    }
                }
                set bb: LLVMGetNextBasicBlock(bb)
            }
            if saved_block.handle <> null
                LLVMPositionBuilderAtEnd(builder, saved_block)
        }

        ; Look up or declare scaly_release_root_page_full(ptr) -> void — the
        ; runtime full-teardown entry point (root_pages.scaly). It gates
        ; deallocate_extensions internally on the page-used predicate, then
        ; releases the StackBucket root slot.
        function get_release_root_page_full_fn(this) returns LLVMValueRef
        {
            var rel_fn lookup_function_cache("_Z28scaly_release_root_page_fullP4Page")
            if rel_fn.handle = null
                set rel_fn: LLVMGetNamedFunction(llvm_module, "_Z28scaly_release_root_page_fullP4Page")
            if rel_fn.handle = null
            {
                let void_ty LLVMVoidTypeInContext(context)
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                var ptys Vector[LLVMTypeRef](1)
                ptys.put(0, ptr_ty)
                let fty LLVMFunctionType(void_ty, ptys.data, 1, 0)
                set rel_fn: LLVMAddFunction(llvm_module, "_Z28scaly_release_root_page_fullP4Page", fty)
                LLVMSetLinkage(rel_fn, LLVMLinkage.External())
                cache_function("_Z28scaly_release_root_page_fullP4Page", rel_fn)
            }
            rel_fn
        }

        ; Release function_local_page at the current builder position (just
        ; before the caller emits a terminating return/throw). Full teardown
        ; (the blocker-C invariant 1, "always free local regions at scope
        ; exit"): a local ($) region is ALWAYS freed — the emitted call to
        ; scaly_release_root_page_full frees the owned extension chain +
        ; exclusive pages (gated on the page-used predicate, see root_pages.scaly)
        ; then returns the StackBucket root slot. The escape checker (return /
        ; store / call vectors) guarantees no escaping reference lives on this
        ; page, so the unconditional free is not a use-after-free.
        ;
        ; The gate + teardown live in the RUNTIME helper, not inline here:
        ; building the gate IR in the emitter (GEP into the Page struct) tripped
        ; a stage-0 backend miscompile of the huge Emitter whole-struct load
        ; feeding the GEP type (the page_needs_cleanup version SIGSEGV'd in
        ; GetElementPtrInst::Create with a null PointeeType). Emitting a single
        ; call sidesteps it; stage-0's own emitter keeps its inline gate
        ; (Emitter.cpp CleanupLocalPage) — same runtime behaviour either way.
        procedure emit_release_local_page(this)
        {
            ; Nothing to release when this function never reserved a frame.
            ; (Scaly `if cond STMT` runs STMT when cond is TRUE, so this
            ; returns exactly when the frame IS null.)
            if function_local_frame.handle = null
                return
            let slot function_local_frame
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let void_ty LLVMVoidTypeInContext(context)

            ; The frame, not the page: on an exit reached without ever forcing it
            ; there is no page value at all, and the helper's null test is what
            ; makes such a frame free.
            let rel_fn get_release_frame_fn()
            var r_ptys Vector[LLVMTypeRef](1)
            r_ptys.put(0, ptr_ty)
            let r_fty LLVMFunctionType(void_ty, r_ptys.data, 1, 0)
            var r_args Vector[LLVMValueRef](1)
            r_args.put(0, slot)
            LLVMBuildCall2(builder, r_fty, rel_fn, r_args.data, 1, "")
        }

        ; ========================================================================
        ; Dead-region-frame elision
        ; ========================================================================
        ;
        ; get_or_create_local_page above hands a function a local page as soon as
        ; ANYTHING in its body might need one — and a struct-returning callee
        ; always "might", because the planner gives every such function a
        ; caller-page parameter (function_needs_caller_page → needs_implicit_
        ; return_page). A plain field getter is the extreme case:
        ;
        ;     function get_gi(this: GroveNode) returns StringC { gi }
        ;
        ; emits as @get_gi(ptr sret, ptr page, ptr this) and never touches `page`
        ; — but every caller must build a region frame to pass it. Measured on
        ; the dazzle DSSSL engine (tests/dazzle/PERFORMANCE.md): 133.7 M region
        ; frames for one 977 KB document, 118.9 M of them (89 %) opened and
        ; released without a single object ever allocated on them.
        ;
        ; This pass removes the ones that are provably pointless, as a peephole
        ; over the finished module (it CANNOT run while emitting: at the point
        ; gi_matches is emitted, get_gi may not exist yet).
        ;
        ; Two steps, the first iterated to a fixed point:
        ;
        ;   1. When a DEFINED function never uses its pointer parameter j, every
        ;      direct call to it may pass null instead. This is what makes the
        ;      analysis transitive without a call graph: a function that only
        ;      FORWARDS its own frame to such a callee loses that use, so on the
        ;      next round its own parameter is unused and its callers stop
        ;      passing a frame in turn.
        ;   2. A frame whose only remaining uses are its own initialising stores
        ;      and its release calls is dead: erase them and the record. Removing
        ;      a matched push/pop pair keeps the StackBucket's strict-LIFO
        ;      invariant (scaly_release_root_page asserts it) — nothing was
        ;      allocated on the page, so there is also nothing to tear down.
        ;
        ; ★Soundness against linkonce_odr interposition: step 1 reads the callee's
        ; parameter uses out of a DEFINITION in this module, while the linker may
        ; pick a different module's copy of the same linkonce_odr symbol. That is
        ; safe because both copies are generated from the same source by the same
        ; compiler — mangled names carry the instantiated types and the package
        ; version, so two definitions of one symbol cannot disagree about which
        ; parameters they read. Declarations are skipped outright (a cross-package
        ; callee's body is not visible here, so it stays conservative).
        ;
        ; ★Restricted to POINTER parameters. Not required for soundness (an
        ; unused parameter of any type could be nulled) — it keeps the rewrite in
        ; the region-plumbing shape this exists for, and every page parameter is
        ; a pointer.
        ;
        ; Measured on `dazzledoc -t fot`: 26.86 G → 22.84 G instructions,
        ; 1.34 s → 1.15 s CPU, output byte-identical.
        procedure elide_unused_pages(this)
        {
            ; ★No early return on the allocator symbol: since the frame chain
            ; (2026-08-02) an emitted body names scaly_force_frame, not
            ; Page.allocate_root_page, so keying the whole pass on the latter
            ; would silently switch step 1 off in every module but the runtime's.

            ; --- 1a. SNAPSHOT which functions never read their caller page ----
            ; Driven off the function cache, not LLVMGetFirstFunction: the cache
            ; is what carries the recorded page-parameter index.
            ;
            ; ★★This snapshot is the whole reason the pass is sound, and it MUST
            ; be taken before a single argument is rewritten. "Function F never
            ; reads its page parameter" is then a property of F's own emitted
            ; body — identical in every module that instantiates F, because the
            ; body comes from the same source. Any predicate that also depends on
            ; what ELSE the module contains is not: F's page use may be a call to
            ; G, so a module that can see G's body would elide F while a module
            ; holding only a declaration of G would not. Both emit F as
            ; linkonce_odr, the linker keeps one — and the callers of the copy it
            ; dropped pass null to a body that dereferences it.
            ;
            ; That is exactly what a fixed-point version of this loop did: it
            ; passed every suite, then blew the planner's stack on the first
            ; self-compile (measured: 199 of 1325 rewritten call sites named a
            ; page the callee's own body reads). One round, snapshot predicate.
            var ci: size_t 0
            while ci < function_cache_funcs.length
            {
                let f_ptr function_cache_funcs.get ci
                let idx_ptr function_cache_page_param.get ci
                if f_ptr <> null
                {
                    if idx_ptr <> null
                    {
                        let page_index (*idx_ptr)
                        if page_index >= 0
                        {
                            let f (*f_ptr)
                            let keep page_param_is_unused(f, page_index)
                            if keep = false
                            {
                                let no_page 0 - 1
                                function_cache_page_param.put(ci, no_page)
                            }
                        }
                    }
                }
                set ci: ci + 1
            }

            ; --- 1b. drop the page argument at their direct call sites --------
            var cj: size_t 0
            while cj < function_cache_funcs.length
            {
                let f_ptr function_cache_funcs.get cj
                let idx_ptr function_cache_page_param.get cj
                if f_ptr <> null
                {
                    if idx_ptr <> null
                    {
                        let page_index (*idx_ptr)
                        if page_index >= 0
                        {
                            let f (*f_ptr)
                            null_page_arguments(f, page_index)
                        }
                    }
                }
                set cj: cj + 1
            }

            ; --- 2. erase every frame nothing allocates on ---------------------
            ;
            ; With the parent-linked chain a frame is a two-word alloca; the page
            ; is materialised by scaly_force_frame and torn down by
            ; scaly_release_frame, which takes the FRAME, not the page. So a
            ; region nothing uses is a frame whose remaining uses — once step 1b
            ; has nulled the arguments that were its only consumers — are just its
            ; own initialising stores and its releases. Erasing all of that leaves
            ; the region unopened for good; a frame that still has a force call on
            ; any path keeps everything.
            let rel_fn LLVMGetNamedFunction(llvm_module, "_Z19scaly_release_frameP5Frame")
            if rel_fn.handle = null
                return

            ; Collect the candidate frames FIRST: erasing rewrites the use list
            ; that is being walked. Every frame has at least one release call, so
            ; the release users enumerate them all.
            var frames Array[LLVMValueRef]()
            let rel_handle rel_fn.handle
            var u LLVMGetFirstUse(rel_fn)
            while u.handle <> null
            {
                let user LLVMGetUser(u)
                let is_call LLVMIsACallInst(user)
                if is_call.handle <> null
                {
                    let callee LLVMGetCalledValue(user)
                    if callee.handle = rel_handle
                    {
                        let fr LLVMGetOperand(user, 0)
                        if fr.handle <> null
                        {
                            ; One entry per FRAME: a function with several exit
                            ; paths releases the same frame more than once and
                            ; would otherwise reach the erase below repeatedly.
                            var seen false
                            var k: size_t 0
                            while k < frames.length
                            {
                                let kp frames.get k
                                if kp <> null
                                    if (*kp).handle = fr.handle
                                        set seen: true
                                set k: k + 1
                            }
                            if seen = false
                                frames.add fr
                        }
                    }
                }
                set u: LLVMGetNextUse(u)
            }

            var fi: size_t 0
            while fi < frames.length
            {
                let frame_ptr frames.get fi
                if frame_ptr <> null
                {
                    let frame (*frame_ptr)
                    ; Two erase lists, because a GEP can only go once the store
                    ; through it is gone.
                    var dead_stores Array[LLVMValueRef]()
                    var dead_rest Array[LLVMValueRef]()
                    var all_dead true
                    var fu LLVMGetFirstUse(frame)
                    while fu.handle <> null
                    {
                        let usr LLVMGetUser(fu)
                        var is_dead false
                        if LLVMIsAStoreInst(usr).handle <> null
                        {
                            set is_dead: true
                            dead_stores.add usr
                        }
                        let uc LLVMIsACallInst(usr)
                        if uc.handle <> null
                            if LLVMGetCalledValue(usr).handle = rel_handle
                            {
                                set is_dead: true
                                dead_rest.add usr
                            }
                        ; The parent word is written through a GEP; it is dead
                        ; when everything reached through it is a store.
                        let ug LLVMIsAGetElementPtrInst(usr)
                        if ug.handle <> null
                        {
                            var gep_dead true
                            var gu LLVMGetFirstUse(usr)
                            while gu.handle <> null
                            {
                                let guser LLVMGetUser(gu)
                                if LLVMIsAStoreInst(guser).handle = null
                                    set gep_dead: false
                                if LLVMIsAStoreInst(guser).handle <> null
                                    dead_stores.add guser
                                set gu: LLVMGetNextUse(gu)
                            }
                            if gep_dead
                            {
                                set is_dead: true
                                dead_rest.add usr
                            }
                        }
                        if is_dead = false
                            set all_dead: false
                        set fu: LLVMGetNextUse(fu)
                    }
                    if all_dead
                    {
                        var d: size_t 0
                        while d < dead_stores.length
                        {
                            let dp dead_stores.get d
                            if dp <> null
                            {
                                let dv (*dp)
                                LLVMInstructionEraseFromParent(dv)
                            }
                            set d: d + 1
                        }
                        var d2: size_t 0
                        while d2 < dead_rest.length
                        {
                            let dp2 dead_rest.get d2
                            if dp2 <> null
                            {
                                let dv2 (*dp2)
                                LLVMInstructionEraseFromParent(dv2)
                            }
                            set d2: d2 + 1
                        }
                        LLVMInstructionEraseFromParent(frame)
                    }
                }
                set fi: fi + 1
            }
        }

        ; elide_unused_pages step 1a: does `f` have a body that never uses its
        ; caller-frame parameter (LLVM-argument index `page_index`, as recorded by
        ; emit_function_decl)? Read before any rewriting — see the ODR note there.
        ;
        ; ★"Uses" deliberately counts PASSING IT ON, not just forcing it. That is
        ; what makes nulling the argument safe for the chain: a function that
        ; cannot force its caller's frame also cannot hand it to anyone who could,
        ; so cutting the chain there leaves nobody below able to materialise an
        ; outer region out of order (the ordering argument at scaly_force_frame).
        ;
        ; ★The ONE use that does not count is the store of the incoming frame into
        ; this function's own frame record — the parent link. Without this
        ; exception the predicate would be false for every function that opens a
        ; region at all, and the pass would go inert: a cut chain is exactly what
        ; a nulled argument produces, and it is sound for the same reason.
        function page_param_is_unused(this, f: LLVMValueRef, page_index: int) returns bool
        {
            if f.handle = null
                return false
            ; A declaration's body lives in another module; assume it reads.
            let is_decl LLVMIsDeclaration(f)
            if is_decl <> 0
                return false
            let n LLVMCountParams(f)
            if page_index >= n
                return false
            let p LLVMGetParam(f, page_index)
            var p_use LLVMGetFirstUse(p)
            while p_use.handle <> null
            {
                let usr LLVMGetUser(p_use)
                if parent_link_store(usr, p) = false
                    return false
                set p_use: LLVMGetNextUse(p_use)
            }
            ; A caller-page parameter is a bare `ptr` and carries no attributes;
            ; anything else is not the slot we recorded. In particular an UNUSED
            ; sret parameter (a template stub's `ret null` body never writes it)
            ; must never be handed a null — the attribute promises the callee a
            ; dereferenceable slot.
            let p_ty LLVMTypeOf(p)
            let kind LLVMGetTypeKind(p_ty)
            if kind <> LLVMTypeKind.Pointer()
                return false
            let attrs LLVMGetAttributeCountAtIndex(f, page_index + 1)
            attrs = 0
        }

        ; Is `usr` the store that links THIS function's frame onto the incoming
        ; one — `store %page_param, ptr getelementptr(%frame, 0, 1)`? Recognised
        ; structurally rather than through a recorded handle, because the pass runs
        ; over the finished module long after the per-function emitter state was
        ; reset. The shape is unambiguous: the value stored is the caller-frame
        ; parameter itself, and the destination is the second word of an alloca.
        function parent_link_store(this, usr: LLVMValueRef, p: LLVMValueRef) returns bool
        {
            let st LLVMIsAStoreInst(usr)
            if st.handle = null
                return false
            ; Operand 0 is the stored value, operand 1 the destination.
            let stored LLVMGetOperand(usr, 0)
            if stored.handle <> p.handle
                return false
            let dest LLVMGetOperand(usr, 1)
            if dest.handle = null
                return false
            let gep LLVMIsAGetElementPtrInst(dest)
            if gep.handle = null
                return false
            let base LLVMGetOperand(dest, 0)
            if base.handle = null
                return false
            let alloca_inst LLVMIsAAllocaInst(base)
            if alloca_inst.handle = null
                return false
            true
        }

        ; elide_unused_pages step 1b: pass null for f's caller page at every
        ; DIRECT call to f.
        ;
        ; ★Only the caller-page argument is ever rewritten, never an arbitrary
        ; unused parameter. Nulling any unused parameter would be sound in plain
        ; LLVM semantics, but not here: emit_call builds its OWN func_type per
        ; call site rather than reusing the declaration's, so "argument j at the
        ; call" is not generally "parameter j of the callee". The page position is
        ; the one both sides derive from the same sret/page layout, so it is the
        ; one that can be matched up safely.
        ;
        ; ★Every intermediate is bound to a `let` before use. A parenless chained
        ; call as an argument (`LLVMGetTypeKind(LLVMTypeOf p)`) and `.handle` read
        ; straight off a call result are both silent-mis-parse shapes in this
        ; compiler — the first version of this function had them and the pass came
        ; out INERT under the seed compiler.
        procedure null_page_arguments(this, f: LLVMValueRef, page_index: int)
        {
            let f_handle f.handle
            let j page_index
            var u LLVMGetFirstUse(f)
            while u.handle <> null
            {
                ; Take the successor BEFORE rewriting: LLVMSetOperand moves the
                ; argument's use off its old value, and when a call passes f BOTH
                ; as callee and as a function-pointer argument that use sits in
                ; this very list.
                let next LLVMGetNextUse(u)
                let user LLVMGetUser(u)
                let is_call LLVMIsACallInst(user)
                if is_call.handle <> null
                {
                    let callee LLVMGetCalledValue(user)
                    if callee.handle = f_handle
                    {
                        ; A call's operands are its arguments followed by the
                        ; callee, so the argument count is one less than the
                        ; operand count. The guard also covers the arity mismatch
                        ; scalyc still does not diagnose (a call site passing
                        ; fewer arguments than the callee declares).
                        let nops LLVMGetNumOperands(user)
                        let argc nops - 1
                        if j < argc
                        {
                            let a LLVMGetOperand(user, j)
                            let already LLVMIsNull(a)
                            let a_is_f a.handle = f_handle
                            ; Never rewrite f's own address into null: it would
                            ; invalidate the `next` taken above.
                            if already = 0
                                if a_is_f = false
                                {
                                    let a_ty LLVMTypeOf(a)
                                    let nullv LLVMConstNull(a_ty)
                                    LLVMSetOperand(user, j, nullv)
                                }
                        }
                    }
                }
                set u: next
            }
        }

        ; parse_array_size: numeric String → size_t, or 0 for empty / any
        ; non-digit (the s192 fixed-array stack alloca only fires on a numeric
        ; array_size; named-constant sizes return 0 and fall back to a plain
        ; pointer slot, matching stage-0's std::stoull if at Emitter.cpp:2393).
        function parse_array_size(s: String) returns size_t
        {
            if s.get_length() = 0
                return 0
            var result: size_t 0
            var i: size_t 0
            while i < s.get_length()
            {
                let c s.get i
                if c < 48
                    return 0
                if c > 57
                    return 0
                set result: result * 10 + ((c - 48) as size_t)
                set i: i + 1
            }
            result
        }

        ; s178: start a fresh pool window when a new function begins.
        ; Slots registered by earlier functions live in dead frames'
        ; entry blocks and must never be matched again.
        procedure reset_temp_pool(this)
        {
            set temp_pool_start: temp_pool_slots.length
            set temp_stmt_log_start: temp_stmt_log.length
            set temp_stmt_log.length: temp_stmt_log_start
        }

        ; s178: acquire a temp slot of LLVM type `ty`. Reuses a free
        ; pooled slot of the identical type (LLVM uniques types, so
        ; handle equality is type equality) created earlier in the same
        ; function; otherwise creates a fresh entry-block alloca and
        ; registers it. Every handed-out slot is logged to the current
        ; statement window for release_statement_temps. Without reuse,
        ; big functions like Planner.collapse_operand_sequence# get one
        ; ~600-byte slot per spill site (~450 of them) and the static
        ; frame reaches ~460KB — deep recursion then needs ulimit -s
        ; 65520 to self-compile.
        function acquire_temp(this, ty: LLVMTypeRef, name: pointer[const_char]) returns LLVMValueRef
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var t ty
            if current_function.handle = null
                return entry_alloca(t, name)
            var in_use_flag: size_t 0
            var i: size_t temp_pool_start
            while i < temp_pool_slots.length
            {
                let f_ptr temp_pool_free.get i
                if f_ptr <> null
                {
                    let f_val (*f_ptr)
                    if f_val = 1
                    {
                        let ty_ptr temp_pool_types.get i
                        if ty_ptr <> null
                        {
                            let pool_ty (*ty_ptr)
                            if pool_ty.handle = t.handle
                            {
                                let slot_ptr temp_pool_slots.get i
                                if slot_ptr <> null
                                {
                                    temp_pool_free.put(i, in_use_flag)
                                    temp_stmt_log.add i
                                    return (*slot_ptr)
                                }
                            }
                        }
                    }
                }
                set i: i + 1
            }
            let a entry_alloca(t, name)
            temp_pool_types.add t
            temp_pool_slots.add a
            temp_pool_free.add in_use_flag
            temp_stmt_log.add(temp_pool_slots.length - 1)
            a
        }

        ; s178: classify one IR user of a pooled slot pointer. Safe users
        ; read through the pointer or borrow it: loads, stores INTO the
        ; slot, call arguments (Scaly callees borrow struct args), and
        ; null-check compares. A GEP derives a new pointer — recurse into
        ; its uses. Storing the pointer AS A VALUE escapes; anything
        ; unrecognized (phi of arm results, select, ret) escapes too.
        function temp_user_is_safe(this, user_v: LLVMValueRef, ptr_v: LLVMValueRef, depth: size_t) returns bool
        {
            ; s34 root fix: plain copies of the by-ptr struct params.
            var user user_v
            var ptr_val ptr_v
            let ld LLVMIsALoadInst(user)
            if ld.handle <> null
                return true
            let st LLVMIsAStoreInst(user)
            if st.handle <> null
            {
                ; Operand 0 of a store is the VALUE being stored; the
                ; slot pointer appearing there means the pointer itself
                ; is being saved somewhere — escaped.
                let stored_val LLVMGetOperand(user, 0)
                if stored_val.handle = ptr_val.handle
                    return false
                return true
            }
            let cl LLVMIsACallInst(user)
            if cl.handle <> null
                return true
            let ic LLVMIsAICmpInst(user)
            if ic.handle <> null
                return true
            let gep LLVMIsAGetElementPtrInst(user)
            if gep.handle <> null
            {
                if temp_value_escapes(user, depth + 1)
                    return false
                return true
            }
            false
        }

        ; s178: conservative escape check over the slot's emitted uses.
        ; Depth-capped; unknown means escaped (slot is kept, never
        ; reused). Future uses can only be created through handles the
        ; emitter retains — local bindings are checked separately in
        ; release_statement_temps, and values cannot cross statement
        ; windows because emit_statement returns only bool.
        function temp_value_escapes(this, v: LLVMValueRef, depth: size_t) returns bool
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var val v
            if depth > 3
                return true
            var u LLVMGetFirstUse(val)
            while u.handle <> null
            {
                let user LLVMGetUser(u)
                if user.handle <> null
                {
                    if temp_user_is_safe(user, val, depth) = false
                        return true
                }
                set u: LLVMGetNextUse(u)
            }
            false
        }

        ; s178: strip a GEP chain to its base and return the base when it
        ; is an alloca; null otherwise. Used to map binding values and
        ; pinned arm results back to the pool slot they live in (a when-
        ; payload binding holds a GEP into the choose.union slot, not the
        ; slot itself).
        function temp_base_alloca(this, v: LLVMValueRef) returns LLVMValueRef
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var cur v
            if cur.handle = null
                return LLVMValueRef null
            var hops: size_t 0
            while hops < 8
            {
                let gep LLVMIsAGetElementPtrInst(cur)
                if gep.handle = null
                    break
                set cur: LLVMGetOperand(cur, 0)
                set hops: hops + 1
            }
            let al LLVMIsAAllocaInst(cur)
            if al.handle = null
                return LLVMValueRef null
            cur
        }

        ; s178: pin a value the emitter holds across scope exits. The pin
        ; expires with the enclosing statement window (emit_statement
        ; restores temp_pinned.length), by which point the merge PHI
        ; exists and the escape walk sees it.
        procedure pin_temp_value(this, v: LLVMValueRef)
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var val v
            let base temp_base_alloca val
            if base.handle <> null
                temp_pinned.add base
        }

        ; s178: free pool slot `idx` unless it is pinned (a pending arm
        ; result or the in-flight choose scrutinee), still referenced by
        ; a live local binding — a let-bound sret/deref result has NO IR
        ; store, the handle only lives in local_var_values — or its IR
        ; uses show the pointer escaping. Conservative on all three:
        ; kept slots are simply never reused.
        procedure release_slot_if_dead(this, idx: size_t)
        {
            var free_flag: size_t 1
            var depth0: size_t 0
            if idx < temp_pool_slots.length
            {
                let f_ptr temp_pool_free.get idx
                if f_ptr <> null
                {
                    let f_val (*f_ptr)
                    if f_val = 0
                    {
                        let slot_ptr temp_pool_slots.get idx
                        if slot_ptr <> null
                        {
                            let slot (*slot_ptr)
                            var kept: bool false
                            var pi: size_t 0
                            while pi < temp_pinned.length
                            {
                                let p_ptr temp_pinned.get pi
                                if p_ptr <> null
                                {
                                    let pv (*p_ptr)
                                    if pv.handle = slot.handle
                                        set kept: true
                                }
                                set pi: pi + 1
                            }
                            if kept = false
                            {
                                var vi: size_t 0
                                while vi < local_var_values.length
                                {
                                    let lv_ptr local_var_values.get vi
                                    if lv_ptr <> null
                                    {
                                        let lv (*lv_ptr)
                                        let lv_base temp_base_alloca lv
                                        if lv_base.handle = slot.handle
                                            set kept: true
                                    }
                                    set vi: vi + 1
                                }
                                if kept = false
                                {
                                    if temp_value_escapes(slot, depth0) = false
                                        temp_pool_free.put(idx, free_flag)
                                }
                            }
                        }
                    }
                }
            }
        }

        ; s178: copy a struct value into `dst` without materializing the
        ; whole struct as an SSA value. Big-aggregate load+store pairs
        ; make the backend allocate a spill slot per loaded value —
        ; ~350KB of collapse_operand_sequence#'s 430KB frame was spill
        ; slots against only 84KB of real allocas (a 50-copy synthetic
        ; shows 0x22000 vs 0x7000 frames). When the value is a load,
        ; memcpy straight from the load's source pointer and erase the
        ; load if nothing else uses it; non-struct or non-load values
        ; fall back to a plain store.
        ; Returns the emitted store or memcpy instruction — both void-
        ; typed and non-null, so call sites where the original store was
        ; in value position (the `when variable:` assignment arm tail in
        ; emit_action) keep their exact observable behavior at null
        ; checks and PHI void-gates.
        function copy_struct_value(this, dst: LLVMValueRef, src_value: LLVMValueRef, ty: LLVMTypeRef) returns LLVMValueRef
        {
            ; s34 root fix: plain copies of the by-ptr struct params.
            var d dst
            var sv src_value
            var t ty
            ; Fallback stores are marked align 1: some destinations (the
            ; throws Result data field at byte offset 1, s150) are
            ; misaligned, and align 1 is always safe.
            var is_struct: bool false
            if LLVMGetTypeKind(t) = LLVMTypeKind.Struct()
                set is_struct: true
            ; Opaque structs (fresh type vars, placeholders without a
            ; body) have no size — LLVMSizeOf on them hits the
            ; DataLayout::getTypeSizeInBits assertion (rc=133/SIGTRAP,
            ; s97 class). Element count 0 covers opaque and empty.
            if is_struct
            {
                if LLVMCountStructElementTypes(t) = 0
                    set is_struct: false
            }
            if is_struct = false
            {
                let st0 LLVMBuildStore(builder, sv, d)
                LLVMSetAlignment(st0, 1)
                return st0
            }
            let ld LLVMIsALoadInst(sv)
            if ld.handle = null
            {
                let st1 LLVMBuildStore(builder, sv, d)
                LLVMSetAlignment(st1, 1)
                return st1
            }
            ; TEMPORAL SOUNDNESS GATE: memcpy reads the load's source at
            ; COPY time, not load time. Only rewrite when the load is the
            ; IMMEDIATELY PRECEDING instruction in the current block —
            ; zero gap means the source cannot have been modified (or its
            ; pooled slot reused) in between. A stale load (e.g. a let-
            ; bound tuple.val consumed in a later statement) must store
            ; its loaded SNAPSHOT: nested_struct returned WRONG when both
            ; Rectangle fields memcpy'd from the recycled Point slot.
            let cur_block LLVMGetInsertBlock(builder)
            if cur_block.handle = null
            {
                let st3 LLVMBuildStore(builder, sv, d)
                LLVMSetAlignment(st3, 1)
                return st3
            }
            let last_inst LLVMGetLastInstruction(cur_block)
            if last_inst.handle <> sv.handle
            {
                let st4 LLVMBuildStore(builder, sv, d)
                LLVMSetAlignment(st4, 1)
                return st4
            }
            let src_ptr LLVMGetOperand(sv, 0)
            if src_ptr.handle = null
            {
                let st2 LLVMBuildStore(builder, sv, d)
                LLVMSetAlignment(st2, 1)
                return st2
            }
            ; Self-copy: the pooled temp acquired for the destination can be
            ; the very slot the source was loaded from (acquire_temp reuse).
            ; memcpy's operands are declared noalias, so memcpy(x, x) is UB
            ; that -O2 exploits (deleted the receiver's field store in the
            ; subscript_binary regress). A self-copy is a no-op — skip it.
            if src_ptr.handle = d.handle
                return sv
            let size_const LLVMSizeOf(t)
            ; The bypassed load is left in place even when now unused —
            ; erasing it frees the instruction while emitter-held handles
            ; (emit_action's `value`, a collected case_value) may still
            ; reference it, and the backend prunes dead non-volatile
            ; loads for free anyway (verified: 50 dead big loads add 0
            ; bytes of frame).
            LLVMBuildMemCpy(builder, d, 1, src_ptr, 1, size_const)
        }

        ; `&^obj v` — box a COPY of value v onto obj's page, yield pointer[X].
        ; Mirrors the struct-construction region-alloc path (resolve page →
        ; Page::allocate(sizeof, alignof) → copy the value in → return ptr) but
        ; for a single pre-existing value rather than field-by-field init.
        ; Replaces the hand-rolled `var H Vector[X]^rp(1); H.put(0, v); H.get(0)`.
        function emit_box(this, bx: PlannedBox) returns LLVMValueRef
        {
            if bx.value = null
                return LLVMValueRef null
            let val_op (*bx.value)
            let val emit_operand val_op
            if val.handle = null
                return LLVMValueRef null
            let val_ty map_type(val_op.result_type)

            ; Stabilize the source into a fresh, NON-POOLED entry-block slot
            ; IMMEDIATELY — before page resolution or Page::allocate emit any
            ; instruction. Two reasons: (a) if `val` is a struct SSA load, the
            ; intervening Page::allocate call pushes the load out of last-
            ; instruction position, so the box's later copy_struct_value falls
            ; back to STORING the loaded SSA struct — a big-aggregate spill that
            ; re-bloats the frame of a deeply recursive caller
            ; (collapse_operand_sequence) → stack overflow (the s178 lesson; the
            ; v_holder `-S scalyc` bus error). (b) if `val` points at a pooled
            ; sret/deref slot, capturing it now removes any dependence on that
            ; slot surviving the allocate (the th_holder corruption). The box's
            ; final copy then reads ONLY this stable slot, never the volatile
            ; pooled/SSA original. Opaque/empty structs (element count 0) skip
            ; this — LLVMSizeOf on them SIGTRAPs (s97) — and fall through to the
            ; plain-store path below.
            var src_struct: bool false
            if LLVMGetTypeKind(val_ty) = LLVMTypeKind.Struct()
            {
                if LLVMCountStructElementTypes(val_ty) <> 0
                    set src_struct: true
            }
            var stable LLVMValueRef(null)
            if src_struct
            {
                set stable: entry_alloca(val_ty, "box.src")
                if LLVMGetTypeKind(LLVMTypeOf(val)) = LLVMTypeKind.Pointer()
                {
                    if LLVMIsNull(val) <> 0
                        LLVMBuildStore(builder, LLVMConstNull(val_ty), stable)
                    if LLVMIsNull(val) = 0
                        LLVMBuildMemCpy(builder, stable, 1, val, 1, LLVMSizeOf(val_ty))
                }
                else
                    copy_struct_value(stable, val, val_ty)
            }

            ; Resolve the destination page from the Reference location
            ; (^this → Page.get(this), ^rp / ^name → that variable). This one
            ; feeds Page::allocate, so it must be a REAL page: the caller-page
            ; slot holds a frame and gets forced here.
            var page_arg: LLVMValueRef resolve_reference_page(bx.target_page)
            if page_arg.handle = null
            {
                let rp_val lookup_variable("_rp")
                if rp_val.handle <> null
                    set page_arg: force_frame(rp_val)
                if page_arg.handle = null
                    set page_arg: get_or_create_local_page()
            }
            if page_arg.handle = null
                return LLVMValueRef null

            ; Page::allocate(page, sizeof, alignof).
            var alloc_func lookup_function_cache("_ZN4Page8allocateEmm")
            if alloc_func.handle = null
                set alloc_func: LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
            if alloc_func.handle = null
            {
                var apt Vector[LLVMTypeRef](3)
                apt.put(0, LLVMPointerTypeInContext(context, 0))
                apt.put(1, LLVMInt64TypeInContext context)
                apt.put(2, LLVMInt64TypeInContext context)
                let art LLVMPointerTypeInContext(context, 0)
                let adt LLVMFunctionType(art, apt.data, 3, 0)
                set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", adt)
                LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                cache_function("_ZN4Page8allocateEmm", alloc_func)
            }
            ; s176 opaque-ptr fallback: a layout-less struct maps to ptr →
            ; LLVMSizeOf=8 under-sizes; allocate a pessimistic 64 instead.
            var size_const LLVMSizeOf(val_ty)
            if LLVMGetTypeKind(val_ty) = LLVMTypeKind.Pointer()
            {
                let i64_ty LLVMInt64TypeInContext(context)
                set size_const: LLVMConstInt(i64_ty, 64, 0)
            }
            let align_const LLVMAlignOf(val_ty)
            var alloc_args Vector[LLVMValueRef](3)
            alloc_args.put(0, page_arg)
            alloc_args.put(1, size_const)
            alloc_args.put(2, align_const)
            var apt2 Vector[LLVMTypeRef](3)
            apt2.put(0, LLVMPointerTypeInContext(context, 0))
            apt2.put(1, LLVMInt64TypeInContext context)
            apt2.put(2, LLVMInt64TypeInContext context)
            let art2 LLVMPointerTypeInContext(context, 0)
            let act LLVMFunctionType(art2, apt2.data, 3, 0)
            let box_ptr LLVMBuildCall2(builder, act, alloc_func, alloc_args.data, 3, "box.region")

            ; Copy the stabilized source into the allocation; yield the pointer.
            ; For structs, memcpy from the stable slot captured above (never a
            ; whole-struct SSA load+store — it spills, the s178 lesson). Scalars
            ; are SSA values that no allocation can invalidate, so they copy
            ; straight from `val` (and opaque/empty structs plain-store it).
            if src_struct
                LLVMBuildMemCpy(builder, box_ptr, 1, stable, 1, LLVMSizeOf(val_ty))
            else
                copy_struct_value(box_ptr, val, val_ty)
            box_ptr
        }

        ; s178: return the current statement window's pooled temps to the
        ; free pool when provably dead (see release_slot_if_dead).
        procedure release_statement_temps(this)
        {
            var li: size_t temp_stmt_log_start
            while li < temp_stmt_log.length
            {
                let idx_ptr temp_stmt_log.get li
                if idx_ptr <> null
                {
                    let idx (*idx_ptr)
                    release_slot_if_dead idx
                }
                set li: li + 1
            }
            set temp_stmt_log.length: temp_stmt_log_start
        }

        ; ========================================================================
        ; Function Cache
        ; ========================================================================

        function lookup_function_cache(this, mangled_name: String) returns LLVMValueRef
        {
            let ir function_index.lookup mangled_name
            if ir >= 0
            {
                let f function_cache_funcs.get(ir as size_t)
                if f <> null
                    return f
            }
            LLVMValueRef null
        }

        procedure cache_function(this, mangled_name: String, llvm_func: LLVMValueRef)
        {
            let entry_idx function_cache_names.length
            function_cache_names.add mangled_name
            function_cache_funcs.add llvm_func
            ; -1 until emit_function_decl records a caller-page parameter; the
            ; runtime helpers cached from get_alloc_root_page_fn & co. never get
            ; one, and neither do declarations built at call sites.
            let no_page 0 - 1
            function_cache_page_param.add no_page
            if llvm_func.handle <> null
                function_index.insert_if_absent(mangled_name, entry_idx)
        }

        ; Record where emit_function_decl put the caller-page parameter of the
        ; function it has just cached (the most recent entry).
        procedure note_page_param_index(this, index: size_t)
        {
            let n function_cache_page_param.length
            if n = 0
                return
            function_cache_page_param.put(n - 1, index as int)
        }

        ; ========================================================================
        ; Local Variable Management
        ; ========================================================================

        function lookup_variable(this, name: String) returns LLVMValueRef
        {
            ; s174: scan BACKWARD so the innermost (most recently defined)
            ; binding shadows outer ones. The old forward scan returned the
            ; OUTERMOST match, so an inner `var i` re-initialized its own
            ; alloca but all reads/writes resolved to the outer `i` — in
            ; plan_function's needs_local_page loop the inner index started
            ; at the outer loop's final value and Vector.get walked past the
            ; end (flaky stage-2 SIGSEGV for any function with parameters).
            var i: size_t local_var_names.length
            while i > 0
            {
                set i: i - 1
                let n_ptr local_var_names.get i
                if n_ptr <> null
                {
                    if (*n_ptr) = name
                    {
                        let v local_var_values.get i
                        if v <> null
                            return (*v)
                    }
                }
            }
            LLVMValueRef null
        }

        procedure define_variable(this, name: String, value: LLVMValueRef)
        {
            local_var_names.add name
            local_var_values.add value
        }

        procedure clear_local_variables(this)
        {
            set local_var_names.length: 0
            set local_var_values.length: 0
            set scope_marks.length: 0
        }

        ; s128: push a marker recording the current local_var_names.length.
        ; Sites that introduce a fresh Scaly scope (choose case body, if
        ; branch, while/for body, try arms, statement block) call enter_scope
        ; on entry and exit_scope right before their terminator. Mirrors
        ; stage-0's Emitter::enterScope / exitScope (which use a SmallVector
        ; of similar snapshots).
        procedure enter_scope(this)
        {
            scope_marks.add local_var_names.length
        }

        ; s128: pop the most recent scope marker, truncate local_var_names
        ; and local_var_values back to that snapshot so any define_variable
        ; calls made inside the scope are forgotten. Sibling arms calling
        ; enter_scope/exit_scope around their bodies stop leaking names into
        ; each other; lookup_variable's forward-iteration first-match rule
        ; now picks the most recently defined version visible at the current
        ; point.
        procedure exit_scope(this)
        {
            if scope_marks.length = 0
                return  ; underflow: silently no-op
            let mark_ptr scope_marks.get(scope_marks.length - 1)
            if mark_ptr <> null
            {
                let mark (*mark_ptr)
                ; s178: pooled slots whose only holders are the bindings
                ; dying with this scope become reusable by sibling arms
                ; and later scopes. Collect candidate pool indices from
                ; the dying values (GEP chains stripped to their base
                ; alloca) BEFORE truncating, release AFTER, so the
                ; capture check in release_slot_if_dead sees only the
                ; bindings that remain live. Only candidates reachable
                ; from dying bindings are considered — a blanket pool
                ; scan would free in-flight working slots (the enclosing
                ; choose's union slot between arms, while-condition
                ; temps) that no local references.
                var cands Array[size_t]()
                var di: size_t mark
                while di < local_var_values.length
                {
                    let dv_ptr local_var_values.get di
                    if dv_ptr <> null
                    {
                        let dv (*dv_ptr)
                        let base temp_base_alloca dv
                        if base.handle <> null
                        {
                            var ci: size_t temp_pool_start
                            while ci < temp_pool_slots.length
                            {
                                let c_ptr temp_pool_slots.get ci
                                if c_ptr <> null
                                {
                                    let cslot (*c_ptr)
                                    if cslot.handle = base.handle
                                        cands.add ci
                                }
                                set ci: ci + 1
                            }
                        }
                    }
                    set di: di + 1
                }
                set local_var_names.length: mark
                set local_var_values.length: mark
                var ri: size_t 0
                while ri < cands.length
                {
                    let r_ptr cands.get ri
                    if r_ptr <> null
                    {
                        let r_idx (*r_ptr)
                        release_slot_if_dead r_idx
                    }
                    set ri: ri + 1
                }
            }
            set scope_marks.length: scope_marks.length - 1
        }

        ; ========================================================================
        ; Type Mapping
        ; ========================================================================

        ; Map a PlannedType to an LLVM type
        ; True when `name` is a delegate (function-pointer) concept declared in the
        ; current plan. Linear scan over current_plan.delegates, which is empty for
        ; delegate-free programs (the scaly package) — so the common path is a
        ; single null/length check (GAP B).
        function is_delegate_type_name(this, name: String) returns bool
        {
            if current_plan = null
                return false
            if current_plan.delegates = null
                return false
            let dels (*current_plan.delegates)
            var i: size_t 0
            while i < dels.length
            {
                let d_ptr dels.get i
                if d_ptr <> null
                    if (*d_ptr) = name
                        return true
                set i: i + 1
            }
            false
        }

        function map_type(this, planned_type: PlannedType) returns LLVMTypeRef
        {
            ; Check type cache first
            let cached lookup_type_cache planned_type.name
            if cached.handle <> null
                return cached

            ; Check intrinsic types via the cstring-literal lookup. The
            ; Vector-based map_intrinsic_type stores names from
            ; init_intrinsic_types' `String(...)` values whose `data`
            ; dangles after init returns, so it silently misses "int"
            ; / "size_t" etc. and falls through to the opaque-ptr
            ; fallback. That made `pointer[int]` map_type's elem_ty for
            ; GEP/load come out as ptr instead of i64 — generic-spec'd
            ; method bodies emitted `gep ptr / load ptr / ret 0` instead
            ; of `gep i64 / load i64 / ret %deref` (s110).
            let intr_type map_intrinsic_type_by_name planned_type.name
            if intr_type.handle <> null
                return intr_type

            ; Handle pointer types
            if planned_type.name = "pointer"
            {
                ; Use opaque pointer (ptr) for LLVM 15+
                let ptr_type LLVMPointerTypeInContext(context, 0)
                cache_type(planned_type.mangled_name, ptr_type)
                return ptr_type
            }

            ; Handle ref types (same as pointer at LLVM level)
            if planned_type.name = "ref"
            {
                let ptr_type LLVMPointerTypeInContext(context, 0)
                cache_type(planned_type.mangled_name, ptr_type)
                return ptr_type
            }

            ; Delegate (function-pointer) types lower to an LLVM ptr (GAP B). The
            ; planner lists every delegate concept name in current_plan.delegates;
            ; the list is empty outside programs that declare delegates, so this is
            ; a no-op for the scaly package (fixpoint-safe).
            if is_delegate_type_name planned_type.name
            {
                let ptr_type LLVMPointerTypeInContext(context, 0)
                return ptr_type
            }

            ; NPO Option: Option[ref[T]] / Option[pointer[T]] is represented
            ; as a single nullable pointer at the LLVM level. Without this,
            ; map_type falls through to lookup_struct_cache("Option") which
            ; returns the tagged-union %_Z6Option struct — incorrect for NPO.
            ; needs_sret_for_return + call_needs_sret already carve Option-NPO
            ; out of the sret path; map_type must agree so call sites get
            ; `call ptr ...` (loadable, storable) instead of `call %_Z6Option`
            ; (struct value that can't be a store target for `set *X: Y`).
            if is_npo_option(planned_type)
            {
                let ptr_type LLVMPointerTypeInContext(context, 0)
                return ptr_type
            }

            ; Look up struct type
            let struct_type lookup_struct_cache planned_type.name
            if struct_type.handle <> null
                return struct_type

            ; Try mangled name
            let struct_type2 lookup_struct_cache planned_type.mangled_name
            if struct_type2.handle <> null
                return struct_type2

            ; On-demand emission: stage-0's emit() loop runs structures
            ; before unions, so when emit_struct_type(Lexer) calls
            ; map_type(Token) (Token is a union), Token isn't in the cache
            ; yet and we fall through to the ptr placeholder — which makes
            ; the Lexer struct's token field `ptr` instead of `%_Z5Token`.
            ; Stage-2 then calls Lexer::parse_colon, extracts field 5 as
            ; ptr, and `getelementptr inbounds %_Z5Token, ptr %extracted, 0, 0`
            ; treats the extracted struct VALUE as a pointer → SEGV reading
            ; tag.ptr. Mirror stage-0 Emitter.cpp:904-938: look the type up
            ; in current_plan and emit on demand. emit_struct_type and
            ; emit_union_type cache before setting bodies, so cross-references
            ; in either direction are safe from infinite recursion.
            ; Two-pass match. Generic instantiations (Vector[Member],
            ; Vector[Module], ...) all share the bare name "Vector" in
            ; current_plan.structures, so a name-first match would return
            ; whichever Vector is first in the list (e.g. Vector[char]),
            ; typing every Vector-valued struct field identically. The
            ; mangled name (_Z6VectorI6MemberE) is the specialised key, so
            ; match it FIRST across the whole list when non-empty; only
            ; fall back to a bare-name match (non-generic types, or a
            ; generic whose instantiation isn't recorded). Mirrors stage-0
            ; Emitter.cpp:873-907 which keys Structures by specialised name.
            if current_plan.structures <> null
            {
                let structs (*current_plan.structures)
                if planned_type.mangled_name.get_length() > 0
                {
                    var i: size_t 0
                    while i < structs.length
                    {
                        let s_ptr structs.get i
                        if s_ptr <> null
                        {
                            let s (*s_ptr)
                            if s.mangled_name = planned_type.mangled_name
                                return emit_struct_type s
                        }
                        set i: i + 1
                    }
                }
                var k: size_t 0
                while k < structs.length
                {
                    let s_ptr structs.get k
                    if s_ptr <> null
                    {
                        let s (*s_ptr)
                        if s.name = planned_type.name
                            return emit_struct_type s
                    }
                    set k: k + 1
                }
            }
            if current_plan.unions <> null
            {
                let unions (*current_plan.unions)
                if planned_type.mangled_name.get_length() > 0
                {
                    var j: size_t 0
                    while j < unions.length
                    {
                        let u_ptr unions.get j
                        if u_ptr <> null
                        {
                            let u (*u_ptr)
                            if u.mangled_name = planned_type.mangled_name
                                return emit_union_type u
                        }
                        set j: j + 1
                    }
                }
                var m: size_t 0
                while m < unions.length
                {
                    let u_ptr unions.get m
                    if u_ptr <> null
                    {
                        let u (*u_ptr)
                        if u.name = planned_type.name
                            return emit_union_type u
                    }
                    set m: m + 1
                }
            }

            ; s136: known stdlib single-ptr-field structs. Without this,
            ; map_type(String) falls through to the opaque-ptr fallback,
            ; which makes `*string_ref` emit `load ptr, ptr` (8 bytes as a
            ; raw pointer) instead of `load %_Z6String, ptr` (8 bytes as a
            ; { ptr } struct). Stage-0 then passes the loaded ptr to a
            ; struct-expecting callee, which reads garbage at offset 0
            ; (the first byte of the string contents) and SEGVs. Returning
            ; a literal `{ ptr }` here matches String's actual layout and
            ; routes the deref through the struct path. Same shape works
            ; for other 1-ptr-field stdlib types (StringIterator, Path,
            ; ListIterator, etc.); add them only when needed.
            if planned_type.name = "String"
            {
                var fields Vector[LLVMTypeRef](1)
                fields.put(0, LLVMPointerTypeInContext(context, 0))
                return LLVMStructTypeInContext(context, fields.data, 1, 0)
            }

            ; Fallback: opaque pointer (LLVM 15+ everything-is-ptr) instead
            ; of an opaque named struct. The named-opaque path reaches AOT
            ; codegen as `%0 = type opaque` and IRTranslator SEGVs on any
            ; load/GEP into it. A plain ptr is always sized and well-typed
            ; under opaque-pointer semantics. Functional correctness still
            ; depends on the concept being properly planned upstream — this
            ; just keeps the IR valid so the rest of the module compiles.
            LLVMPointerTypeInContext(context, 0)
        }

        ; Is this planned type pointer-SHAPED, i.e. does map_type's `ptr` answer
        ; describe the value itself rather than fall out of the last-resort
        ; fallback at the bottom of map_type?
        ;
        ; map_type ends in an opaque `ptr` for any name it cannot resolve — most
        ; often a BY-VALUE struct from another package that this root never plans
        ; (the is_runtime_opaque_struct set: Page, PageList, StackBucketHeader,
        ; ...; ensure_member_layout# deliberately skips exactly those). The IR
        ; stays valid, but a caller that reads the type KIND back cannot tell the
        ; placeholder from a real pointer, and every such caller then does the
        ; pointer thing to a struct: emit_sizeof answers 8 for a 40-byte Page, and
        ; emit_member_address LOADS the field and stores THROUGH it — a wild store
        ; that lands wherever the struct's first 8 bytes happen to point.
        ; Deciding on the NAME instead is exact: only pointer/ref, an NPO Option
        ; (pointer-payload), a delegate (function pointer) and the intrinsics
        ; (which map_type resolves before ever reaching the fallback) are really
        ; pointers.
        function type_is_pointer_shaped(this, t: PlannedType) returns bool
        {
            if t.name = "pointer"
                return true
            if t.name = "ref"
                return true
            if is_delegate_type_name t.name
                return true
            if is_npo_option t
                return true
            let intr map_intrinsic_type_by_name t.name
            if intr.handle <> null
                return true
            false
        }

        ; The element type a GEP should step by for `pointer[T] + n`. map_type is
        ; the answer except when it hands back its unresolved-name placeholder
        ; (see type_is_pointer_shaped#) — then the stride would be 8 for a struct
        ; of any size: `p + 1` on a pointer[Page] stepped 8 bytes instead of 40,
        ; so walking an array of a cross-package struct read every element from
        ; inside the first one. The literal layouts synthesize_literal_struct#
        ; keeps for exactly the never-laid-out stdlib types give the real stride;
        ; if even that has no entry, keep map_type's answer rather than emit a
        ; GEP over a type this module has no definition for.
        function stride_type(this, elem: PlannedType) returns LLVMTypeRef
        {
            let mapped map_type elem
            if mapped.handle = null
                return mapped
            if LLVMGetTypeKind(mapped) <> LLVMTypeKind.Pointer()
                return mapped
            if type_is_pointer_shaped elem
                return mapped
            let lit synthesize_literal_struct elem.name
            if lit.handle = null
                return mapped
            if LLVMGetTypeKind(lit) <> LLVMTypeKind.Struct()
                return mapped
            lit
        }

        ; s89: Create a placeholder named struct with `{ ptr }` body for
        ; cross-package types not in plan.structures. Used by emit_function_decl
        ; and emit_call to give the sret type attribute a sized type. Single-
        ; pointer-struct layout matches `String` (the only cross-package struct
        ; return exercised by the stretch metric); other multi-field structs
        ; (e.g. Vector) would over-estimate the slot size, which is incorrect
        ; for stack layout but the failure mode is that data after the struct
        ; gets clobbered, not that the function corrupts memory beyond bounds.
        function get_or_create_struct_placeholder(this, name: String, mangled_name: String) returns LLVMTypeRef
        {
            ; Look up a named struct in the cache. If found, use it as-is.
            ; Otherwise, return a *literal* `{ ptr }` struct type — a 1-pointer
            ; slot suitable for sret on `String`-shaped returns. Critical: do
            ; NOT register the placeholder in struct_cache or via
            ; LLVMStructCreateNamed. Either pollutes downstream lookups
            ; (emit_tuple, OptionsC1) and silently changes how struct fields
            ; are stored — flattening their `data` instead of storing the heap
            ; pointer. Multi-field structs (Vector etc.) returned across packages
            ; aren't exercised by the s89 stretch test, so the size-mismatch is
            ; acceptable for now; revisit when pushing further.
            let cached lookup_struct_cache name
            if cached.handle <> null
                return cached
            let cached_m lookup_struct_cache mangled_name
            if cached_m.handle <> null
                return cached_m
            var fields Vector[LLVMTypeRef](1)
            fields.put(0, LLVMPointerTypeInContext(context, 0))
            LLVMStructTypeInContext(context, fields.data, 1, 0)
        }

        ; s99: Synthesize a literal LLVM struct type from a generic
        ; PlannedStructure's properties. Used by emit_member_assignment
        ; load-through when the inner concrete type (e.g. Vector[String])
        ; isn't materialized in struct_cache. Walks current_plan.structures
        ; for an entry matching `name`, maps each property type, and builds
        ; a literal struct via LLVMStructTypeInContext.
        ;
        ; Type variables in the generic (e.g. `pointer[T]`) map to ptr,
        ; concrete primitives map normally. Returns null if no Structure
        ; matches or it has no properties.
        function synthesize_literal_struct(this, name: String) returns LLVMTypeRef
        {
            ; First try plan.structures (works for parameterless user types).
            if current_plan <> null
            {
                let plan_ref current_plan
                let plan (*plan_ref)
                if plan.structures <> null
                {
                    let structures (*plan.structures)
                    var i: size_t 0
                    while i < structures.length
                    {
                        let struct_ptr structures.get i
                        if struct_ptr <> null
                        {
                            let struct (*struct_ptr)
                            if struct.name = name
                            {
                                if struct.properties <> null
                                {
                                    let props (*struct.properties)
                                    if props.length > 0
                                    {
                                        var element_types Vector[LLVMTypeRef](props.length)
                                        var pi: size_t 0
                                        while pi < props.length
                                        {
                                            let prop_ptr props.get pi
                                            if prop_ptr <> null
                                            {
                                                let prop (*prop_ptr)
                                                let prop_ty map_type prop.prop_type
                                                element_types.put(pi, prop_ty)
                                            }
                                            set pi: pi + 1
                                        }
                                        return LLVMStructTypeInContext(context, element_types.data, props.length as int, 0)
                                    }
                                }
                            }
                        }
                        set i: i + 1
                    }
                }
            }
            ; ★MEASURED 2026-08-11, because this table looks far more load-bearing
            ; than it is: with a probe on every arm, the names that actually reach
            ; here across all five package roots are `T`, `V`, `K`, `Option` and the
            ; empty string (unresolved type variables, which match nothing below and
            ; fall through) plus — from dazzle and opensp, i.e. across a package
            ; boundary — `Page` (5 hits) and `PageNode` (2). **No container name is
            ; ever selected.** So the twelve container entries are unexercised in
            ; this tree and only the two runtime-opaque ones do work, which is
            ; exactly the case the paragraph below describes. Correct them when they
            ; disagree with their source definition, but do not expect a regression
            ; test to be able to catch a mistake in one.
            ;
            ; Fallback: hardcoded layouts for stdlib generic containers
            ; (stage-1 doesn't fully instantiate generics, so Vector[T] etc.
            ; aren't in plan.structures). The layouts below match the
            ; canonical struct definitions in packages/scaly/0.1.0/scaly/
            ; containers/. Length, capacity, and counts are i64 (size_t);
            ; data, page, and slot pointers are ptr (opaque). All entries
            ; reflect actual stdlib field ORDER.
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            if name = "Vector"
            {
                ; Vector[T]: { length: size_t, data: pointer[T] }
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            if name = "HashMap"
            {
                ; HashMap[K,V]: { length, slots: ptr, capacity, page }
                var fields Vector[LLVMTypeRef](4)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                fields.put(2, i64_ty)
                fields.put(3, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 4, 0)
            }
            if name = "HashSet"
            {
                ; HashSet[T]: { length, slots: ptr, capacity, page }
                var fields Vector[LLVMTypeRef](4)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                fields.put(2, i64_ty)
                fields.put(3, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 4, 0)
            }
            if name = "Array"
            {
                ; Array[T] (packages/scaly/0.1.0/scaly/containers/Array.scaly):
                ; { length: size_t, vector: pointer[Vector[T]] } — 2 fields.
                ; Pre-s121 had a 4-field layout that didn't match the real
                ; stdlib definition; corrected so deref-load through an
                ; Array-typed field GEPs to the right offsets.
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            if name = "List"
            {
                ; List[T] (packages/scaly/0.1.0/scaly/containers/List.scaly):
                ; `define List[T] (head: pointer[Node[T]] (null))` — ONE field, 8
                ; bytes. It is a chain, and Node carries (element, next); there is no
                ; tail and no cached length.
                ;
                ; ★Corrected 2026-08-11. This entry used to claim { head, tail,
                ; length } = 24 bytes, exactly the class the Array comment above
                ; records for pre-s121: a hardcoded layout that does not match the
                ; real stdlib definition, so wherever a List field access falls back
                ; to this table (cross-package, no plan layout) sizeof was 24 instead
                ; of 8 and every field following a by-value List member sat at the
                ; wrong offset.
                var fields Vector[LLVMTypeRef](1)
                fields.put(0, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 1, 0)
            }
            if name = "HashMapBuilder"
            {
                ; HashMapBuilder[K,V]: { length: size_t, slots: pointer[Vector[...]] }
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            if name = "HashSetBuilder"
            {
                ; HashSetBuilder[T]: { length: size_t, slots: pointer[Vector[...]] }
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, i64_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            ; Non-generic scaly.memory structs. These are on the
            ; is_runtime_opaque_struct list (registering their REAL layouts
            ; would flip ABI decisions — the s176 lesson), so a field access
            ; from OUTSIDE their package previously found no layout at all:
            ; emit_member_access_chain bailed to null and every dependent
            ; statement dropped SILENTLY (found by the stage-7.0 spike, which
            ; walks Page chains from a user program). The literal shapes
            ; below give the fallback path correct GEP/extract offsets, the
            ; same pattern as the container entries above; layouts match
            ; packages/scaly/0.1.0/scaly/memory/.
            if name = "Page"
            {
                ; Page: { next_object: ptr, current_page: ptr, next_page: ptr,
                ;         exclusive_pages: PageList { head: ptr }, region: ptr }
                var pl_fields Vector[LLVMTypeRef](1)
                pl_fields.put(0, ptr_ty)
                let pl_ty LLVMStructTypeInContext(context, pl_fields.data, 1, 0)
                var fields Vector[LLVMTypeRef](5)
                fields.put(0, ptr_ty)
                fields.put(1, ptr_ty)
                fields.put(2, ptr_ty)
                fields.put(3, pl_ty)
                fields.put(4, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 5, 0)
            }
            if name = "PageList"
            {
                ; PageList: { head: pointer[PageNode] }
                var fields Vector[LLVMTypeRef](1)
                fields.put(0, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 1, 0)
            }
            if name = "PageNode"
            {
                ; PageNode: { page: pointer[Page], next: pointer[PageNode] }
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, ptr_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            if name = "PageListIterator"
            {
                ; PageListIterator: { current: pointer[PageNode] }
                var fields Vector[LLVMTypeRef](1)
                fields.put(0, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 1, 0)
            }
            if name = "StackBucketHeader"
            {
                ; StackBucketHeader: { prev: ptr, next: ptr }
                var fields Vector[LLVMTypeRef](2)
                fields.put(0, ptr_ty)
                fields.put(1, ptr_ty)
                return LLVMStructTypeInContext(context, fields.data, 2, 0)
            }
            if name = "HeapBucketHeader"
            {
                ; HeapBucketHeader: { prev: ptr, next: ptr, bitmap: u64,
                ;                     lock: u64, dead: u64 }
                var fields Vector[LLVMTypeRef](5)
                fields.put(0, ptr_ty)
                fields.put(1, ptr_ty)
                fields.put(2, i64_ty)
                fields.put(3, i64_ty)
                fields.put(4, i64_ty)
                return LLVMStructTypeInContext(context, fields.data, 5, 0)
            }
            if name = "TraceEntry"
            {
                ; TraceEntry: { name: pointer[const_char], push_count: i64,
                ;               pop_count: i64 }
                var fields Vector[LLVMTypeRef](3)
                fields.put(0, ptr_ty)
                fields.put(1, i64_ty)
                fields.put(2, i64_ty)
                return LLVMStructTypeInContext(context, fields.data, 3, 0)
            }
            LLVMTypeRef null
        }

        ; s89: Cached sret kind id (lazily looked up). 0 = uninitialized.
        function sret_kind_id(this) returns u32
        {
            LLVMGetEnumAttributeKindForName("sret" as pointer[const_char], 4)
        }

        function noalias_kind_id(this) returns u32
        {
            LLVMGetEnumAttributeKindForName("noalias" as pointer[const_char], 7)
        }

        ; s89: Predicate — does a Scaly function with this return type need
        ; the sret IR pattern (`define void @fn(ptr sret(%T) %retval, ...)`)?
        ;
        ; Mirrors stage-0 Emitter.cpp:1241-1245. Only Itanium-mangled (`_ZN...`)
        ; functions get sret; extern C functions (LLVMContextCreate, fopen, ...)
        ; keep the C ABI scalar return regardless of struct shape.
        ;
        ; Within the Itanium-mangled set, sret applies when the return type
        ; isn't a primitive, pointer, ref, or array. Unknown types (cross-
        ; package without plan.structures entry) are assumed to be Scaly
        ; structs and sret-ified — they otherwise mis-link against stage-0's
        ; libscaly.a (which always sret-ifies the same return).
        function needs_sret_for_return(this, mangled_name: String, return_type_ref: ref[PlannedType]?) returns bool
        {
            if mangled_name.starts_with("_ZN") = false
                return false
            if return_type_ref = null
                return false
            let rt return_type_ref.unwrap()
            ; Primitive scalar types — return in x0.
            if map_intrinsic_type_by_name(rt.name).handle <> null
                return false
            ; Pointer / ref → ptr return.
            if rt.name = "pointer"
                return false
            if rt.name = "ref"
                return false
            ; s136: NPO Option detection. Option[ref[T]] / Option[pointer[T]]
            ; is represented as a single nullable pointer at the LLVM level
            ; (null=None, non-null=Some) — same width and ABI as ref/pointer.
            ; Returning these via sret produces invalid IR: the callee writes
            ; the pointer into the sret slot but the caller reads via x0/rax,
            ; or vice versa, depending on which side is "fixed" — either way,
            ; the loaded value is stack garbage. Vector.get returns
            ; `ref[T]?` → Modeler s113 wraps it in Option[ref[T]] → without
            ; this check, stage-1 sret'd the call site of `holder.get(0)` and
            ; SEGV'd at the caller dereferencing the stale alloca pointer.
            if rt.name = "Option"
                return is_npo_option(rt) = false
            ; Otherwise — struct or unknown cross-package type. Sret it.
            true
        }

        ; True iff `t` is `Option[ref[X]]` or `Option[pointer[X]]` — the
        ; True when `name` is a genuine tagged union declared in the current
        ; plan. Used by the choose emitter to reject the NPO (null-pointer)
        ; dispatch for a real multi-variant union reached through a pointer
        ; scrutinee (`choose this` where this: pointer[CodingSystem]) — NPO is
        ; the Option[ref/pointer] collapse only. Without this, a union whose
        ; first variant is nullary (variant_index 0, so the has_some heuristic
        ; misfires) dispatches on `this == null` and always takes variant 0.
        function type_name_is_plan_union(this, name: String) returns bool
        {
            if current_plan = null
                return false
            if current_plan.unions = null
                return false
            let unions (*current_plan.unions)
            var i: size_t 0
            while i < unions.length
            {
                let up unions.get i
                if up <> null
                    if (*up).name = name
                        return true
                set i: i + 1
            }
            false
        }

        ; NPO (null-pointer optimization) Option layout that's represented
        ; as a single nullable pointer rather than a tagged union.
        function is_npo_option(this, t: PlannedType) returns bool
        {
            if t.name <> "Option"
                return false
            if t.generics = null
                return false
            let gens (*t.generics)
            if gens.length = 0
                return false
            let inner_ptr gens.get 0
            if inner_ptr = null
                return false
            let inner (*inner_ptr)
            if inner.name = "ref"
                return true
            if inner.name = "pointer"
                return true
            false
        }

        ; The LLVM type of the loop-var VALUE for a scalar iterator element.
        ; `element_type` is `pointer[T]`; return the LLVM type of T so the
        ; caller can load the scalar through next()'s element pointer.
        function scalar_element_value_type(this, element_type: PlannedType) returns LLVMTypeRef
        {
            if element_type.generics <> null
            {
                let gens (*element_type.generics)
                if gens.length > 0
                {
                    let t0 gens.get 0
                    if t0 <> null
                        return map_type (*t0)
                }
            }
            ; Unreachable for a scalar element (planner set the flag off it).
            LLVMPointerTypeInContext(context, 0)
        }

        ; s89: Equivalent predicate for a callee at a call site. Reads
        ; the planned result_type (the Plan-side return type the call
        ; site expects to receive). Same heuristic as needs_sret_for_return.
        function call_needs_sret(this, mangled_name: String, result_type: PlannedType) returns bool
        {
            if mangled_name.starts_with("_ZN") = false
                return false
            if map_intrinsic_type_by_name(result_type.name).handle <> null
                return false
            if result_type.name = "pointer"
                return false
            if result_type.name = "ref"
                return false
            ; s136: same NPO Option carve-out as needs_sret_for_return —
            ; Option[ref[T]] / Option[pointer[T]] is a single ptr at the
            ; ABI level.
            if result_type.name = "Option"
                return is_npo_option(result_type) = false
            true
        }

        ; Map intrinsic type name to LLVM type
        function map_intrinsic_type(this, name: String) returns LLVMTypeRef
        {
            var i 0
            for n in intrinsic_type_names
            {
                if n = name
                {
                    let info intrinsic_types.get i
                    if info <> null
                        return info.llvm_type

                }
                set i: i + 1
            }
            LLVMTypeRef null
        }

        ; Direct intrinsic-name → LLVM type lookup that doesn't touch the
        ; intrinsic_type_names Vector. Used at sites where the Vector-based
        ; lookup is unreliable (it stores `String(...)` values from
        ; init_intrinsic_types whose `data` dangles once init returns).
        ; Returns null when the name isn't a known intrinsic — callers
        ; should fall back to map_type for struct/pointer/ref handling.
        function map_intrinsic_type_by_name(this, name: String) returns LLVMTypeRef
        {
            if name = "void"
                return LLVMVoidTypeInContext context
            if name = "bool"
                return LLVMInt1TypeInContext context
            if name = "char"
                return LLVMInt8TypeInContext context
            if name = "const_char"
                return LLVMInt8TypeInContext context
            if name = "i8"
                return LLVMInt8TypeInContext context
            if name = "u8"
                return LLVMInt8TypeInContext context
            if name = "i16"
                return LLVMInt16TypeInContext context
            if name = "u16"
                return LLVMInt16TypeInContext context
            if name = "i32"
                return LLVMInt32TypeInContext context
            if name = "u32"
                return LLVMInt32TypeInContext context
            if name = "int"
                return LLVMInt64TypeInContext context
            if name = "uint"
                return LLVMInt64TypeInContext context
            if name = "i64"
                return LLVMInt64TypeInContext context
            if name = "u64"
                return LLVMInt64TypeInContext context
            if name = "size_t"
                return LLVMInt64TypeInContext context
            if name = "float"
                return LLVMFloatTypeInContext context
            if name = "double"
                return LLVMDoubleTypeInContext context
            ; f32/f64 — the planner's own names for float-literal results
            ; (plan_constant_type stamps a bare `3.0` as "f64"). Without these
            ; entries a float-literal-typed binding fell through to map_type's
            ; opaque-ptr fallback and every read emitted `load ptr` against the
            ; `alloca double` slot — passed as a ctor/call argument the ABI skews
            ; (the double lands in a GPR, every later arg shifts) and the callee
            ; reads garbage. The DWARF basic-type table (llvm_di_basic_type)
            ; already carried both names; this table must agree.
            if name = "f32"
                return LLVMFloatTypeInContext context
            if name = "f64"
                return LLVMDoubleTypeInContext context
            LLVMTypeRef null
        }

        ; Check if a type name is an intrinsic type
        function is_intrinsic_type(this, name: String) returns bool
        {
            for n in intrinsic_type_names
            {
                if n = name
                    return true

            }
            false
        }

        ; ========================================================================
        ; Structure Type Emission
        ; ========================================================================

        ; Emit LLVM struct type for a PlannedStructure
        function emit_struct_type(this, struct: PlannedStructure) returns LLVMTypeRef
        {
            ; Check cache first — prefer mangled_name since two instances
            ; of a generic structure (Box[int] vs Box[Box[int]]) share the
            ; same `name` but have distinct mangled names. Without this,
            ; the second specialisation's emit hits the first one's cache
            ; entry and emit_struct_type returns the wrong LLVMType.
            let cached_m lookup_struct_cache struct.mangled_name
            if cached_m.handle <> null
                return cached_m
            let cached lookup_struct_cache struct.name
            if cached.handle <> null
            {
                ; Reuse only when the cached entry's name and mangled_name
                ; coincide — i.e. a non-generic struct. For generics, the
                ; mangled name disambiguates.
                if struct.name = struct.mangled_name
                    return cached
            }

            ; Create named struct
            let llvm_struct LLVMStructCreateNamed(context, struct.mangled_name.c_data())
            if struct.name = struct.mangled_name
                cache_struct(struct.name, llvm_struct)
            cache_struct(struct.mangled_name, llvm_struct)

            ; Empty struct (null or zero properties): set an empty body
            ; so the type is sized (`type {}`) rather than left opaque.
            ; Stage-0 emitStructType calls setBody unconditionally; stage-1
            ; must do the same or downstream GEPs into Unspecified-style
            ; types fail -c IR codegen (opaque type GEP rejected by
            ; IRTranslator).
            if struct.properties = null
            {
                LLVMStructSetBody(llvm_struct, null as pointer[LLVMTypeRef], 0, 0)
                return llvm_struct
            }
            if struct.properties.length = 0
            {
                LLVMStructSetBody(llvm_struct, null as pointer[LLVMTypeRef], 0, 0)
                return llvm_struct
            }

            ; Collect element types from properties
            let element_count struct.properties.length
            var element_types Vector[LLVMTypeRef](element_count)

            var i: size_t 0
            while i < element_count
            {
                let prop_ptr struct.properties.get i
                if prop_ptr <> null
                {
                    let prop prop_ptr.unwrap()
                    var prop_llvm_type map_type prop.prop_type
                    ; A BY-VALUE field whose type this root never lays out comes
                    ; back from map_type as the last-resort `ptr` placeholder (see
                    ; type_is_pointer_shaped#), and putting that in the body makes
                    ; the field 8 bytes: this struct's own size and the offsets of
                    ; every LATER field are then wrong. `define Embedder (work:
                    ; Page  tail: size_t)` measured 16 instead of 48. A member
                    ; access anywhere triggers ensure_member_layout# and fixes it,
                    ; which is why every real root worked — the layout depended on
                    ; the ORDER in which the root happened to touch things.
                    ; Resolve it here instead, where the body is built.
                    ;
                    ; Do NOT move this upstream into plan_structure: ensuring every
                    ; by-value property type's layout eagerly re-plans the whole
                    ; containers module once per triggering type — 703
                    ; plan_structure calls on packages/dazzle and a stack overflow.
                    ; Both measured 2026-08-04.
                    if LLVMGetTypeKind(prop_llvm_type) = LLVMTypeKind.Pointer()
                        if type_is_pointer_shaped(prop.prop_type) = false
                        {
                            let lit synthesize_literal_struct prop.prop_type.name
                            if lit.handle <> null
                                if LLVMGetTypeKind(lit) = LLVMTypeKind.Struct()
                                    set prop_llvm_type: lit
                        }
                    element_types.put(i, prop_llvm_type)
                }
                set i: i + 1
            }

            ; Set the struct body (not packed)
            LLVMStructSetBody(llvm_struct, element_types.data, element_count as int, 0)

            llvm_struct
        }

        ; ========================================================================
        ; Union Type Emission
        ; ========================================================================

        ; s179: round offset up to a multiple of align (a power of two).
        ; Local to Emitter — small let-steps instead of one mixed
        ; +/-//* expression (no fixed operator precedence).
        function abi_align_to(this, offset: size_t, align: size_t) returns size_t
        {
            if align < 2
                return offset
            let a_m1 align - 1
            let sum offset + a_m1
            let q sum / align
            q * align
        }

        ; s179: true when every type reachable from ty has a knowable ABI
        ; size. Opaque structs (fresh type vars, s114 placeholders), void,
        ; vectors, and function types are unsizeable — callers must fall
        ; back to a conservative estimate rather than risk under-sizing.
        function llvm_type_sizable(this, ty: LLVMTypeRef) returns bool
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var t ty
            if t.handle = null
                return false
            let kind LLVMGetTypeKind(t)
            if kind = LLVMTypeKind.Void()
                return false
            if kind = LLVMTypeKind.FunctionKind()
                return false
            if kind = LLVMTypeKind.Label()
                return false
            if kind = LLVMTypeKind.Metadata()
                return false
            if kind = LLVMTypeKind.VectorKind()
                return false
            if kind = LLVMTypeKind.ArrayKind()
                return llvm_type_sizable(LLVMGetElementType t)
            if kind = LLVMTypeKind.Struct()
            {
                if LLVMIsOpaqueStruct(t) <> 0
                    return false
                let n LLVMCountStructElementTypes(t)
                var i: int 0
                while i < n
                {
                    let f_ok llvm_type_sizable(LLVMStructGetTypeAtIndex(t, i))
                    if f_ok = false
                        return false
                    set i: i + 1
                }
                return true
            }
            true
        }

        ; s179: ABI alignment of an LLVM type, walked structurally.
        ; Matches DataLayout::getABITypeAlign for everything stage-1
        ; emits (ints, floats, pointers, non-packed structs, arrays).
        ; Never calls into DataLayout: LLVMABISizeOfType corrupts
        ; stage-1 process state (s149) and getTypeSizeInBits SIGTRAPs
        ; on opaque structs (s97). Check llvm_type_sizable first.
        function llvm_type_abi_align(this, ty: LLVMTypeRef) returns size_t
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var t ty
            let kind LLVMGetTypeKind(t)
            if kind = LLVMTypeKind.Integer()
            {
                let w LLVMGetIntTypeWidth(t)
                if w <= 8
                    return 1
                if w <= 16
                    return 2
                if w <= 32
                    return 4
                return 8
            }
            if kind = LLVMTypeKind.Pointer()
                return 8
            if kind = LLVMTypeKind.Double()
                return 8
            if kind = LLVMTypeKind.Float()
                return 4
            if kind = LLVMTypeKind.Half()
                return 2
            if kind = LLVMTypeKind.ArrayKind()
                return llvm_type_abi_align(LLVMGetElementType t)
            if kind = LLVMTypeKind.Struct()
            {
                var max_a: size_t 1
                let n LLVMCountStructElementTypes(t)
                var i: int 0
                while i < n
                {
                    let fa llvm_type_abi_align(LLVMStructGetTypeAtIndex(t, i))
                    if fa > max_a
                        set max_a: fa
                    set i: i + 1
                }
                return max_a
            }
            1
        }

        ; s179: ABI alloc size of an LLVM type, walked structurally.
        ; Mirrors stage-0's getTypeSize (DataLayout::getTypeAllocSize,
        ; Emitter.cpp:6637) without touching DataLayout — see the s149/
        ; s97 cautions on llvm_type_abi_align. Check llvm_type_sizable
        ; first; unsizeable kinds return 0 here.
        function llvm_type_abi_size(this, ty: LLVMTypeRef) returns size_t
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var t ty
            let kind LLVMGetTypeKind(t)
            if kind = LLVMTypeKind.Integer()
            {
                let w LLVMGetIntTypeWidth(t)
                if w <= 8
                    return 1
                if w <= 16
                    return 2
                if w <= 32
                    return 4
                if w <= 64
                    return 8
                return 16
            }
            if kind = LLVMTypeKind.Pointer()
                return 8
            if kind = LLVMTypeKind.Double()
                return 8
            if kind = LLVMTypeKind.Float()
                return 4
            if kind = LLVMTypeKind.Half()
                return 2
            if kind = LLVMTypeKind.ArrayKind()
            {
                let elem LLVMGetElementType(t)
                let n LLVMGetArrayLength2(t)
                let elem_sz llvm_type_abi_size elem
                return elem_sz * (n as size_t)
            }
            if kind = LLVMTypeKind.Struct()
            {
                var offset: size_t 0
                var sa: size_t 1
                let n LLVMCountStructElementTypes(t)
                var i: int 0
                while i < n
                {
                    let ft LLVMStructGetTypeAtIndex(t, i)
                    let fs llvm_type_abi_size ft
                    let fa llvm_type_abi_align ft
                    let aligned abi_align_to(offset, fa)
                    set offset: aligned + fs
                    if fa > sa
                        set sa: fa
                    set i: i + 1
                }
                return abi_align_to(offset, sa)
            }
            0
        }

        ; Emit LLVM type for a PlannedUnion (tagged union)
        function emit_union_type(this, union_type: PlannedUnion) returns LLVMTypeRef
        {
            ; Check cache first
            let cached lookup_struct_cache union_type.name
            if cached.handle <> null
                return cached

            ; Create named struct for the union
            ; Layout: { tag: i8, data: [max_variant_size x i8] }
            let llvm_union LLVMStructCreateNamed(context, union_type.mangled_name.c_data())
            cache_struct(union_type.name, llvm_union)
            cache_struct(union_type.mangled_name, llvm_union)

            ; Build union body: { i8 tag, [data_size x i8] data }
            let i8_type LLVMInt8TypeInContext(context)

            ; s179: data size = max ABI size over the variants' LLVM
            ; types, mirroring stage-0 emitUnionType (Emitter.cpp:1045-
            ; 1063): no tag byte folded into the array, no alignment
            ; rounding of the array. The planner's name-keyed estimate
            ; (union_type.size = align(max_payload+tag, align)) over-
            ; sizes every union and compounds through nesting —
            ; PlannedExpression payload was 584B vs stage-0's 457B.
            ; Fall back to the planner estimate when any variant maps
            ; to an unsizeable type (opaque struct, void, vector):
            ; the estimate only ever over-allocates, which is safe,
            ; while walker under-sizing would corrupt page headers at
            ; region-allocation sites (s27/s176-fix-4 class).
            var data_size: size_t 0
            if union_type.size > 0
                set data_size: union_type.size - 1
            var walker_ok: bool true
            var max_size: size_t 0
            if union_type.variants <> null
            {
                let vars (*union_type.variants)
                var vi: size_t 0
                while vi < vars.length
                {
                    let v_ptr vars.get vi
                    if v_ptr <> null
                    {
                        let v (*v_ptr)
                        if v.var_type <> null
                        {
                            let vt (*v.var_type)
                            let v_llvm map_type vt
                            if v_llvm.handle = null
                                set walker_ok: false
                            if v_llvm.handle <> null
                            {
                                let v_ok llvm_type_sizable v_llvm
                                if v_ok = false
                                    set walker_ok: false
                                if v_ok
                                {
                                    let vs llvm_type_abi_size v_llvm
                                    if vs > max_size
                                        set max_size: vs
                                }
                            }
                        }
                    }
                    set vi: vi + 1
                }
            }
            if walker_ok
                set data_size: max_size

            ; Always emit both fields — stage-0 emits { i8, [0 x i8] }
            ; even for payload-less unions, and construction/choose sites
            ; GEP field 1 unconditionally, so the data field must exist.
            let data_array_type LLVMArrayType2(i8_type, data_size)

            var element_types Vector[LLVMTypeRef](2)
            element_types.put(0, i8_type)       ; tag field
            element_types.put(1, data_array_type) ; data field

            LLVMStructSetBody(llvm_union, element_types.data, 2, 0)

            llvm_union
        }

        ; ========================================================================
        ; Function Declaration
        ; ========================================================================

        ; s149: Build the Result-wrapper LLVM type for a throws function.
        ; Shape: { i8 status, [N x i8] data } where N = max(sizeof T, 8).
        ; The status byte (0 = Success, 1 = Throw) is independent from the
        ; inner variant tag of T, fixing the stage-0/stage-1 collision when T
        ; is a union and the Success variant has tag != 0.
        ; Errors are passed by pointer (allocated on the exception page by
        ; the thrower), so 8 bytes is sufficient for the error case. Mirrors
        ; stage-0 Emitter.cpp:1204-1221.
        ; s194: payload-size contribution of one type to the throws Result
        ; wrapper's data field. Returns the s179-walked ABI size, or 256 (the
        ; conservative over-allocation) when the type is null/opaque/unsizeable
        ; or the `{ptr}` cross-package placeholder (unknown true size — under-
        ; sizing would let a store overflow the caller's slot).
        function throws_wrapper_payload_size(this, ty: LLVMTypeRef) returns size_t
        {
            ; s34 root fix: plain copy of the by-ptr struct param.
            var t ty
            if t.handle = null
                return 0
            ; `{ptr}` placeholder with no struct name → unknown real size.
            if LLVMGetTypeKind(t) = LLVMTypeKind.Struct()
            {
                if LLVMIsOpaqueStruct(t) = 0
                {
                    let name_c LLVMGetStructName(t)
                    if name_c = null
                    {
                        if LLVMCountStructElementTypes(t) = 1
                        {
                            let f0 LLVMStructGetTypeAtIndex(t, 0)
                            if LLVMGetTypeKind(f0) = LLVMTypeKind.Pointer()
                                return 256
                        }
                    }
                }
            }
            if llvm_type_sizable(t) = false
                return 256
            llvm_type_abi_size t
        }

        function build_throws_result_type(this, value_ty: LLVMTypeRef, throws_ty: LLVMTypeRef, mangled_name: String) returns LLVMTypeRef
        {
            ; Result wrapper: { i8 status, [N x i8] data }.
            ;
            ; s194: N = max(sizeof T, sizeof throws_type, 8). The data field
            ; holds the RETURN value T on the success path AND the thrown error
            ; (stored BY VALUE by emit_throw) on the error path, so it must fit
            ; the LARGER of the two. The s149 note below ("8 bytes covers the
            ; error arm: errors passed by pointer") is FALSE for the self-hosted
            ; emit_throw, which stores the whole error struct inline — a ref/
            ; scalar-returning throws (T=ptr → 8 bytes) whose error is a fat
            ; union (ParserError = 25 bytes) otherwise overflowed the 8-byte
            ; data field and clobbered the CALLER's stack (the s157→s194 NPO
            ; retirement exposed this: struct returns happened to be ≥ the error
            ; size, ref/scalar returns are not).
            ;
            ; s180: computed via the s179 walkers — NEVER LLVMABISizeOfType,
            ; which corrupts stage-1 process state (s149: every call leaks state
            ; that surfaces as PC=0/LR=0 at exit time, even though the emitted
            ; .o file is byte-correct).
            ;
            ; Falls back to the old conservative s149 fixed 256 when
            ; value_ty is unsizeable (opaque struct, s97 class) or is the
            ; literal `{ptr}` cross-package placeholder from
            ; get_or_create_struct_placeholder — that stands in for a
            ; struct of UNKNOWN size, and under-sizing lets the callee
            ; write past the caller's sret slot. Over-allocation is the
            ; safe direction.
            ;
            ; Cached per callee mangled name so every site touching the
            ; wrapper for the same function (emit_function_decl sret type,
            ; emit_call sret temp) builds the IDENTICAL type even when
            ; value_ty resolves differently across sites.
            var i 0
            for n in throws_result_names
            {
                if n = mangled_name
                {
                    let t throws_result_types.get i
                    if t <> null
                        return t

                }
                set i: i + 1
            }

            ; Size from the RETURN value type. A `{ptr}` cross-package
            ; placeholder (unknown true size) or any unsizeable type falls back
            ; to 256 (over-alloc is the safe direction).
            var value_size: size_t throws_wrapper_payload_size(value_ty)
            ; Size from the THROWS error type — emit_throw stores the whole
            ; error struct inline into the data field.
            var throws_size: size_t throws_wrapper_payload_size(throws_ty)
            var data_size value_size
            if throws_size > data_size
                set data_size: throws_size
            if data_size < 8
                set data_size: 8

            let i8_ty LLVMInt8TypeInContext(context)
            let data_arr_ty LLVMArrayType2(i8_ty, data_size)
            var fields Vector[LLVMTypeRef](2)
            fields.put(0, i8_ty)
            fields.put(1, data_arr_ty)
            let result_ty LLVMStructTypeInContext(context, fields.data, 2, 0)
            throws_result_names.add mangled_name
            throws_result_types.add result_ty
            result_ty
        }

        ; Emit function declaration (signature only)
        function emit_function_decl(this, func: PlannedFunction) returns LLVMValueRef
        {
            ; Check cache first
            let cached lookup_function_cache func.mangled_name
            if cached.handle <> null
            {
                ; s134: when the cached entry came from the s78/s83 extern-
                ; decl path (External linkage) but the current call has a
                ; real Action body and is not private, upgrade the linkage
                ; to LinkOnceODR so stage-1's stdlib generic instantiations
                ; merge with the same symbols in libscaly.a at link time
                ; instead of producing duplicate-symbol errors. Without this,
                ; `Array<T>::reallocate` (declared as extern via the s78
                ; path when called from `Array<T>::add`) keeps its External
                ; linkage even though the body is emitted, colliding with
                ; libscaly.a's own definition.
                var has_body: bool false
                choose func.impl
                    when a: Action
                        set has_body: true
                    else
                        0
                if has_body
                {
                    if func.is_private = false
                        set_linkonce_odr(cached)
                }
                return cached
            }

            ; s89: Detect sret-needing returns. Itanium-mangled (`_ZN...`)
            ; functions returning a non-primitive non-pointer type get the
            ; `define void @fn(ptr sret(%T) %retval, ...)` IR pattern, matching
            ; stage-0's lowering (Emitter.cpp:1241-1245). Without this, calls
            ; into stage-0-built libscaly.a (which always sret-ifies the same
            ; signature) read x0 instead of x8 and corrupt the return path.
            var use_sret needs_sret_for_return(func.mangled_name, func.return_type)
            ; s194: EVERY throwing function returns via the Result wrapper sret,
            ; regardless of its declared return type (scalar/ref/struct alike).
            ; The wrapper {i8 status, [N x i8] data} is itself a struct, so it
            ; is always sret-returned. Mirrors stage-0, where the throws wrap at
            ; Emitter.cpp:1204 runs BEFORE the isStructTy() sret test at :1241 —
            ; making sret automatic for all throws. This retires the s157 NPO-
            ; for-ptr scheme (bare pointer, null=error) which lost the error tag
            ; and silently swallowed errors at the first ref-returning throw.
            var can_throw_sret: bool false
            if func.can_throw
            {
                if func.throws_type <> null
                {
                    set use_sret: true
                    set can_throw_sret: true
                }
            }

            ; Determine return type
            var llvm_return_type LLVMVoidTypeInContext(context)
            var sret_type LLVMTypeRef(null)
            if func.return_type <> null
            {
                let rt func.return_type.unwrap()
                let mapped map_type rt
                if use_sret
                {
                    ; s194: throws wrapper base. The wrapper data field is sized
                    ; from the mapped inner type (8 for ptr/ref, ≤8→8 for
                    ; scalars, sizeof for structs). A struct return type that
                    ; map_type lowered to a bare pointer (cross-package fallback)
                    ; must use the {ptr} placeholder so build_throws_result_type
                    ; sizes data conservatively (256) rather than 8 — the real
                    ; struct may exceed 8 bytes and under-sizing corrupts the
                    ; caller's frame. Scalar/ref/ptr returns keep `mapped`.
                    if can_throw_sret
                    {
                        var wrap_base mapped
                        if LLVMGetTypeKind(mapped) = LLVMTypeKind.Pointer()
                        {
                            var rt_is_ref: bool false
                            if rt.name = "pointer"
                                set rt_is_ref: true
                            if rt.name = "ref"
                                set rt_is_ref: true
                            if is_npo_option(rt)
                                set rt_is_ref: true
                            if rt_is_ref = false
                                set wrap_base: get_or_create_struct_placeholder(rt.name, rt.mangled_name)
                        }
                        ; The wrapper data must also fit the thrown error (stored
                        ; inline by emit_throw), so size it for max(T, throws_ty).
                        var throws_llvm LLVMTypeRef(null)
                        if func.throws_type <> null
                            set throws_llvm: map_type((*func.throws_type.unwrap()))
                        set sret_type: build_throws_result_type(wrap_base, throws_llvm, func.mangled_name)
                    }
                    ; Non-throwing sret: resolve the element type to a sized
                    ; struct. If map_type returns a struct, use it; if it returns
                    ; ptr (cross-pkg fallback), synthesize a `{ ptr }` placeholder
                    ; — correct for `String`-like single-pointer-field structs.
                    if can_throw_sret = false
                    {
                        if LLVMGetTypeKind(mapped) = LLVMTypeKind.Struct()
                            set sret_type: mapped
                        if sret_type.handle = null
                            set sret_type: get_or_create_struct_placeholder(rt.name, rt.mangled_name)
                    }
                }
                else
                {
                    ; s170: map_type returns LLVMTypeRef via sret, so `mapped`
                    ; is the sret BUFFER POINTER (a struct held by-reference),
                    ; not a by-value struct. A plain `set llvm_return_type:
                    ; mapped` stores that buffer ADDRESS into llvm_return_type's
                    ; s170: map_type returns LLVMTypeRef via sret, so `mapped`
                    ; is the sret BUFFER POINTER (a struct held by-reference),
                    ; not a by-value struct.
                    set llvm_return_type: mapped
                }
            }

            ; Page parameter (function#) prepends an implicit `ptr` arg
            ; before user-declared params. Mirrors Emitter.cpp:1247-1250.
            var has_page_param: bool false
            if func.page_parameter <> null
                set has_page_param: true

            ; Build parameter types array
            var input_count: size_t 0
            if func.input <> null
            {
                let input_ref func.input.unwrap()
                let input (*input_ref)
                set input_count: input.length
            }

            var sret_offset: size_t 0
            if use_sret
                set sret_offset: 1

            var page_offset: size_t 0
            if has_page_param
                set page_offset: 1

            let param_count input_count + page_offset + sret_offset
            var param_types_ptr: pointer[LLVMTypeRef] null as pointer[LLVMTypeRef]

            if param_count > 0
            {
                var param_types Vector[LLVMTypeRef](param_count)
                if use_sret
                    param_types.put(0, LLVMPointerTypeInContext(context, 0))
                if has_page_param
                    param_types.put(sret_offset, LLVMPointerTypeInContext(context, 0))

                if func.input <> null
                {
                    let input_ref func.input.unwrap()
                    let input (*input_ref)
                    var i: size_t 0
                    while i < input_count
                    {
                        let item_ptr input.get i
                        if item_ptr <> null
                        {
                            let item (*item_ptr)
                            if item.item_type <> null
                            {
                                let item_type item.item_type.unwrap()
                                let llvm_param_type map_type item_type
                                ; Pass struct/array types by pointer (borrowed),
                                ; primitives by value. Mirrors Emitter.cpp:1257-1268.
                                let kind LLVMGetTypeKind(llvm_param_type)
                                var pass_by_ptr: bool false
                                if kind = LLVMTypeKind.Struct()
                                    set pass_by_ptr: true
                                if kind = LLVMTypeKind.ArrayKind()
                                    set pass_by_ptr: true
                                if pass_by_ptr
                                {
                                    param_types.put(i + page_offset + sret_offset, LLVMPointerTypeInContext(context, 0))
                                }
                                if pass_by_ptr = false
                                    param_types.put(i + page_offset + sret_offset, llvm_param_type)
                            }
                        }
                        set i: i + 1
                    }
                }
                set param_types_ptr: param_types.data
            }

            let func_type LLVMFunctionType(llvm_return_type, param_types_ptr, param_count as int, 0)

            ; Use unmangled "main" for linker compatibility (C entry point) —
            ; but ONLY when this is a free function. Namespaced
            ; `define cli { function main(...) }` mangles to
            ; `_ZN3cli4mainE...` and must keep its mangled name; collapsing
            ; it to "main" silently collides with the program's real
            ; `main()` and LLVM auto-renames one of them to `main.1`,
            ; defeating bootstrap (cli.main and the entry point both
            ; resolve to the wrong symbol).
            var func_cstr func.mangled_name.c_data()
            var is_entry_main: bool false
            if func.name = "main"
            {
                ; "main" is a String constant under the string-literal-as-constant
                ; feature; func_cstr is a pointer[const_char] (from c_data()). The
                ; explicit cast routes the literal through emit_as so it lowers to
                ; the plain .str global rather than storing the String struct's
                ; { ptr } into the cstr slot (which corrupts the emitted symbol).
                if func.mangled_name.starts_with("_ZN") = false
                {
                    set func_cstr: ("main" as pointer[const_char])
                    set is_entry_main: true
                }
            }

            var is_extern: bool false
            choose func.impl
                when e: Extern
                    set is_extern: true
                else
                    0

            ; s187: for an EXTERN declaration, reuse an existing same-named
            ; function instead of letting LLVMAddFunction auto-rename it to
            ; `name.1`/`name.2`. The s159 up-front varargs decls of memcpy/memset
            ; collide with the Scaly source's own concrete-signature extern decls
            ; (Vector/String): the second add was renamed `memset.1`/`memcpy.2`,
            ; the call cache pointed at the renamed symbol, and the seed link
            ; then had undefined `memset.1`/`memcpy.2` (libc only provides
            ; `memset`/`memcpy`). The bootstrap masked it — libscaly.a was
            ; stage-0-built (stage-0 emits plain `@memcpy`/`@memset`). Restricted
            ; to extern: a non-extern same-name collision is a genuine duplicate
            ; that must keep its own symbol (the auto-rename), else a second
            ; emit_function_body would append a body into the first definition.
            var llvm_func LLVMGetNamedFunction(llvm_module, func_cstr)
            if is_extern = false
                set llvm_func: LLVMAddFunction(llvm_module, func_cstr, func_type)
            if llvm_func.handle = null
                set llvm_func: LLVMAddFunction(llvm_module, func_cstr, func_type)

            ; s89: Apply sret + noalias attributes to first param so AArch64
            ; lowering uses x8 for the indirect-result-location register.
            if use_sret
            {
                if sret_type.handle <> null
                {
                    let sk sret_kind_id()
                    let nk noalias_kind_id()
                    let sret_attr LLVMCreateTypeAttribute(context, sk, sret_type)
                    LLVMAddAttributeAtIndex(llvm_func, 1, sret_attr)
                    let noalias_attr LLVMCreateEnumAttribute(context, nk, 0)
                    LLVMAddAttributeAtIndex(llvm_func, 1, noalias_attr)
                }
            }

            ; Set linkage. s127: non-private functions WITH BODIES get
            ; LinkOnceODR so stdlib generic instantiations emitted by stage-1
            ; merge with the same symbols in libscaly.a / libscalyc.a rather
            ; than producing "duplicate symbol" at link time. C++ uses this
            ; linkage for template instantiations under the ODR rule:
            ; multiple definitions are allowed, the linker picks one. macOS
            ; Mach-O lowers LinkOnceODR to weak. Extern declarations (no
            ; body — `function puts(...) extern`) must stay External; LLVM
            ; rejects `declare linkonce_odr` because LinkOnceODR semantics
            ; require a definition.
            if func.is_private
                LLVMSetLinkage(llvm_func, LLVMLinkage.Internal())
            else
            {
                if is_extern
                    LLVMSetLinkage(llvm_func, LLVMLinkage.External())
                else
                {
                    ; The program entry stays External: linkonce_odr is
                    ; discardable, so a whole-program pipeline (llvm-link +
                    ; opt) would GlobalDCE the entire binary without this
                    ; anchor.
                    if is_entry_main
                        LLVMSetLinkage(llvm_func, LLVMLinkage.External())
                    else
                        set_linkonce_odr(llvm_func)
                }
            }

            ; Cache the function
            cache_function(func.mangled_name, llvm_func)
            ; …and where its caller-page parameter sits, for elide_unused_pages.
            ; This is the only place that decides the layout (sret first, page
            ; next, user params after), so it is the only honest source for it.
            if has_page_param
                note_page_param_index(sret_offset)

            llvm_func
        }

        ; s186: detect an uninstantiated generic template by its mangled name.
        ; A literal 1-char type parameter named T/K/V is Itanium-encoded as the
        ; byte sequence `1T` / `1K` / `1V` (length-1 name + the letter). Stage-1's
        ; planner spuriously plans these templates with unresolved field/param
        ; types, so emit_function_body would produce garbage instructions (null
        ; branch conditions, store-into-integer). They are provably dead — the
        ; C++ stage-0 omits them entirely yet links a fully working compiler.
        ; The byte BEFORE the `1` must not be a digit, else `1T` would match the
        ; tail of a multi-digit length prefix on a real type name (e.g. an
        ; 11-char name `11Txxxxxxxxx`). Concrete instantiations spell out their
        ; types (`6String`, `i`, `IiE`) and never carry a length-1 T/K/V token.
        function is_uninstantiated_template(this, mangled: String) returns bool
        {
            let n mangled.get_length()
            if n <= 2
                return false
            var i: size_t 2
            while i < n
            {
                let c mangled.get i
                var is_param: bool false
                if c = ("T" as char)
                    set is_param: true
                if c = ("K" as char)
                    set is_param: true
                if c = ("V" as char)
                    set is_param: true
                if is_param
                {
                    let prev mangled.get(i - 1)
                    if prev = ("1" as char)
                    {
                        let prev2 mangled.get(i - 2)
                        var prev2_digit: bool false
                        if prev2 >= ("0" as char)
                        {
                            if prev2 <= ("9" as char)
                                set prev2_digit: true
                        }
                        if prev2_digit = false
                            return true
                    }
                }
                set i: i + 1
            }
            false
        }

        ; ========================================================================
        ; TCO — self tail call to loop (2026-08-04)
        ; ========================================================================
        ;
        ; `return f(args)` written INSIDE f becomes `br %tail.loop` with the
        ; arguments handed to the header's PHIs. Every other shape keeps its
        ; `call`, and a function without such a return is emitted exactly as
        ; before — the transform is opt-in per function, decided by the walk
        ; below before a single instruction of the body exists.
        ;
        ; Why in the emitter, when LLVM's tailcallelim does the same under -O2:
        ; emission defaults to NO opt pipeline, and so do --jit/--run and every
        ; bootstrap stage. Measured 2026-08-04 on `sum_to(3000000, 0)`: SIGSEGV
        ; at the default, fine at -O2. A language promise about recursive style
        ; cannot be a function of -O — and tailcallelim declines exactly the
        ; cases this compiler produces most (a frame-carrying callee whose
        ; region calls it cannot prove side-effect-free).
        ;
        ; ★What the loop does NOT do: open a fresh region per iteration. The
        ; jump keeps this function's one local frame, so iteration allocations
        ; accumulate until the real return, precisely as a `while` loop's do
        ; today. It trades unbounded STACK for a longer-lived region — which is
        ; the trade the recursion needed. A tail loop whose body allocates per
        ; iteration is therefore not automatically an improvement; a bounded
        ; stack is.

        ; The `return` operand shape that qualifies: exactly one operand, no
        ; member access on it, and its expression a DIRECT call to `mangled` with
        ; `arity` user arguments. `return f(x).length`, an operator, an intrinsic
        ; and an indirect call all fail here.
        ;
        ; ★A call carrying a Local or Reference lifetime (`f^page(…)`) is
        ; rejected: the jump keeps THIS frame, so it cannot honour a request to
        ; place the next iteration's allocations on another page. Unspecified and
        ; Call are both fine — Call means "the caller's page", and after the jump
        ; the caller's page is still ours.
        function return_is_self_call(this, result: ref[Vector[PlannedOperand]]?, mangled: String, arity: size_t) returns bool
        {
            if result = null
                return false
            let ops (*result)
            if ops.length <> 1
                return false
            let op_ptr ops.get 0
            if op_ptr = null
                return false
            let op (*op_ptr)
            if op.member_access <> null
            {
                let chain (*op.member_access)
                if chain.length > 0
                    return false
            }
            var ok: bool false
            choose op.expr
                when call: Call
                {
                    if call.mangled_name = mangled
                    {
                        if call.is_intrinsic = false
                        {
                            if call.is_operator = false
                            {
                                if call.is_indirect = false
                                {
                                    var args_n: size_t 0
                                    if call.args <> null
                                        set args_n: (*call.args).length
                                    if args_n = arity
                                    {
                                        choose call.life
                                            when u: Lifetime.Unspecified
                                                set ok: true
                                            when c: Lifetime.Call
                                                set ok: true
                                            else
                                                0
                                    }
                                }
                            }
                        }
                    }
                }
                else
                    0
            ok
        }

        ; Walkers: is there any qualifying `return` anywhere in this body? A
        ; return inside an `if`, a `choose` arm or even a `while` body is a tail
        ; call all the same — the jump leaves those blocks the way a `ret` does.
        ; Lambda bodies are deliberately NOT walked: they are separate functions.
        function operands_have_self_tail_call(this, ops: ref[Vector[PlannedOperand]]?, mangled: String, arity: size_t) returns bool
        {
            if ops = null
                return false
            let v (*ops)
            var i: size_t 0
            while i < v.length
            {
                let op_ptr v.get i
                if op_ptr <> null
                {
                    let op (*op_ptr)
                    choose op.expr
                        when b: Block
                        {
                            if statements_have_self_tail_call(b.statements, mangled, arity)
                                return true
                        }
                        when f: If
                        {
                            if operands_have_self_tail_call(f.condition, mangled, arity)
                                return true
                            if f.consequent <> null
                            {
                                if statement_has_self_tail_call(*f.consequent.unwrap(), mangled, arity)
                                    return true
                            }
                            if f.alternative <> null
                            {
                                if statement_has_self_tail_call(*f.alternative.unwrap(), mangled, arity)
                                    return true
                            }
                        }
                        when m: Match
                        {
                            if operands_have_self_tail_call(m.condition, mangled, arity)
                                return true
                            if m.branches <> null
                            {
                                let branches (*m.branches)
                                var bi: size_t 0
                                while bi < branches.length
                                {
                                    let br_ptr branches.get bi
                                    if br_ptr <> null
                                    {
                                        let branch (*br_ptr)
                                        if branch.consequent <> null
                                        {
                                            if statement_has_self_tail_call(*branch.consequent.unwrap(), mangled, arity)
                                                return true
                                        }
                                    }
                                    set bi: bi + 1
                                }
                            }
                            if m.alternative <> null
                            {
                                if statement_has_self_tail_call(*m.alternative.unwrap(), mangled, arity)
                                    return true
                            }
                        }
                        when c: Choose
                        {
                            if operands_have_self_tail_call(c.condition, mangled, arity)
                                return true
                            if c.cases <> null
                            {
                                let cases (*c.cases)
                                var ci: size_t 0
                                while ci < cases.length
                                {
                                    let case_ptr cases.get ci
                                    if case_ptr <> null
                                    {
                                        let when_case (*case_ptr)
                                        if when_case.consequent <> null
                                        {
                                            if statement_has_self_tail_call(*when_case.consequent.unwrap(), mangled, arity)
                                                return true
                                        }
                                    }
                                    set ci: ci + 1
                                }
                            }
                            if c.alternative <> null
                            {
                                if statement_has_self_tail_call(*c.alternative.unwrap(), mangled, arity)
                                    return true
                            }
                        }
                        when fo: For
                        {
                            if operands_have_self_tail_call(fo.expr, mangled, arity)
                                return true
                            if action_has_self_tail_call(fo.body, mangled, arity)
                                return true
                        }
                        when w: While
                        {
                            if operands_have_self_tail_call(w.cond.operation, mangled, arity)
                                return true
                            if action_has_self_tail_call(w.body, mangled, arity)
                                return true
                        }
                        when r: Repeat
                        {
                            if action_has_self_tail_call(r.body, mangled, arity)
                                return true
                        }
                        when t: Try
                        {
                            if operands_have_self_tail_call(t.cond.operation, mangled, arity)
                                return true
                            if t.catches <> null
                            {
                                let catches (*t.catches)
                                var ki: size_t 0
                                while ki < catches.length
                                {
                                    let k_ptr catches.get ki
                                    if k_ptr <> null
                                    {
                                        let catch_case (*k_ptr)
                                        if catch_case.consequent <> null
                                        {
                                            if statement_has_self_tail_call(*catch_case.consequent.unwrap(), mangled, arity)
                                                return true
                                        }
                                    }
                                    set ki: ki + 1
                                }
                            }
                            if t.alternative <> null
                            {
                                if statement_has_self_tail_call(*t.alternative.unwrap(), mangled, arity)
                                    return true
                            }
                        }
                        when call: Call
                        {
                            ; A `{ … }` block can be an argument, so an argument
                            ; can hide a `return`.
                            if operands_have_self_tail_call(call.args, mangled, arity)
                                return true
                        }
                        else
                            0
                }
                set i: i + 1
            }
            false
        }

        function action_has_self_tail_call(this, action: PlannedAction, mangled: String, arity: size_t) returns bool
        {
            operands_have_self_tail_call(action.source, mangled, arity)
        }

        function statement_has_self_tail_call(this, st: PlannedStatement, mangled: String, arity: size_t) returns bool
        {
            var found: bool false
            choose st
                when ret: Return
                    set found: return_is_self_call(ret.result, mangled, arity)
                when act: Action
                    set found: action_has_self_tail_call(act, mangled, arity)
                when bnd: Binding
                    set found: operands_have_self_tail_call(bnd.operation, mangled, arity)
                when brk: Break
                    set found: operands_have_self_tail_call(brk.result, mangled, arity)
                else
                    0
            found
        }

        function statements_have_self_tail_call(this, sts: ref[Vector[PlannedStatement]]?, mangled: String, arity: size_t) returns bool
        {
            if sts = null
                return false
            let v (*sts)
            var i: size_t 0
            while i < v.length
            {
                let st_ptr v.get i
                if st_ptr <> null
                {
                    if statement_has_self_tail_call(*st_ptr, mangled, arity)
                        return true
                }
                set i: i + 1
            }
            false
        }

        ; Does this function qualify, and can its parameters carry the loop?
        function tail_loop_eligible(this, func: PlannedFunction, llvm_func: LLVMValueRef, user_count: size_t, arg_offset: size_t) returns bool
        {
            ; A parameter is carried in one of two ways, and every parameter must
            ; fall into one of them or the function keeps its call:
            ;
            ;   (a) a VALUE — a scalar or a language-level pointer/ref/delegate/NPO
            ;       option. The PHI carries it and there is nothing else to do.
            ;   (b) a by-value STRUCT, which travels as a pointer to storage. Those
            ;       get a dedicated shadow slot (see the field declarations and
            ;       emit_self_tail_jump): a back-edge argument that lives in THIS
            ;       frame's storage is copied there, because under recursion every
            ;       frame had its own copy while the loop would otherwise let all
            ;       iterations share one slot — the pool could hand it out again,
            ;       and `let next T(a.f - 1)` overwrites it outright. Silent, and
            ;       latent until something reuses the slot: the class CLAUDE.md's
            ;       deref-receiver and Page.get(sret) notes describe.
            ;
            ; A struct whose mapped LLVM type has NO body — map_type's placeholder
            ; for a runtime-opaque or never-laid-out cross-package type — is the
            ; third case, and it disqualifies: without a size there is no copy to
            ; make (the same reason copy_struct_value refuses element count 0).
            if func.input <> null
            {
                let in_ref func.input.unwrap()
                let items (*in_ref)
                var pi: size_t 0
                while pi < items.length
                {
                    let item_ptr items.get pi
                    if item_ptr = null
                        return false
                    let item (*item_ptr)
                    if item.item_type = null
                        return false
                    let it_ref item.item_type.unwrap()
                    let it (*it_ref)
                    if type_is_pointer_shaped(it) = false
                    {
                        let sty map_type it
                        if sty.handle = null
                            return false
                        if LLVMGetTypeKind(sty) <> LLVMTypeKind.Struct()
                            return false
                        if LLVMCountStructElementTypes(sty) = 0
                            return false
                    }
                    set pi: pi + 1
                }
            }
            ; LLVMGetParam is unchecked — an index past the argument list walks
            ; off it. Establish the range once, from LLVM's own count, before
            ; asking for a single parameter.
            let param_count LLVMCountParams(llvm_func) as size_t
            if user_count + arg_offset > param_count
                return false
            var i: size_t 0
            while i < user_count
            {
                let p LLVMGetParam(llvm_func, (i + arg_offset) as int)
                if p.handle = null
                    return false
                let p_ty LLVMTypeOf(p)
                if p_ty.handle = null
                    return false
                let k LLVMGetTypeKind(p_ty)
                var simple: bool false
                if k = LLVMTypeKind.Integer()
                    set simple: true
                if k = LLVMTypeKind.Pointer()
                    set simple: true
                if k = LLVMTypeKind.Float()
                    set simple: true
                if k = LLVMTypeKind.Double()
                    set simple: true
                if simple = false
                    return false
                set i: i + 1
            }
            var found: bool false
            choose func.impl
                when action: Action
                    set found: action_has_self_tail_call(action, func.mangled_name, user_count)
                else
                    0
            found
        }

        ; Open the header: entry branches into it and every user parameter gets a
        ; PHI seeded with the incoming argument. Must run AFTER the page
        ; parameter is bound (its force_frame belongs in entry) and BEFORE the
        ; user parameters are bound — they bind to these PHIs.
        procedure open_tail_loop(this, func: PlannedFunction, llvm_func: LLVMValueRef, entry_block: LLVMBasicBlockRef, mangled: String, user_count: size_t, arg_offset: size_t)
        {
            ; The shadow/staging slots go in FIRST, while the builder still sits at
            ; the end of the entry block and before the branch exists — they must
            ; dominate the loop, and entry_alloca is deliberately not used: these
            ; are not pool temps.
            set tail_loop_shadows.length: 0
            set tail_loop_stages.length: 0
            set tail_loop_slot_types.length: 0
            var si: size_t 0
            while si < user_count
            {
                var slot_ty LLVMTypeRef(null)
                if func.input <> null
                {
                    let in_ref func.input.unwrap()
                    let items (*in_ref)
                    if si < items.length
                    {
                        let item_ptr items.get si
                        if item_ptr <> null
                        {
                            let item (*item_ptr)
                            if item.item_type <> null
                            {
                                let it_ref item.item_type.unwrap()
                                let it (*it_ref)
                                if type_is_pointer_shaped(it) = false
                                    set slot_ty: map_type(it)
                            }
                        }
                    }
                }
                var shadow LLVMValueRef(null)
                var stage LLVMValueRef(null)
                if slot_ty.handle <> null
                {
                    set shadow: LLVMBuildAlloca(builder, slot_ty, "tail.shadow")
                    set stage: LLVMBuildAlloca(builder, slot_ty, "tail.stage")
                }
                tail_loop_shadows.add shadow
                tail_loop_stages.add stage
                tail_loop_slot_types.add slot_ty
                set si: si + 1
            }

            let name "tail.loop"
            let loop_block LLVMAppendBasicBlockInContext(context, llvm_func, name.c_data())
            LLVMBuildBr(builder, loop_block)
            LLVMPositionBuilderAtEnd(builder, loop_block)
            set tail_loop_phis.length: 0
            var i: size_t 0
            while i < user_count
            {
                let p LLVMGetParam(llvm_func, (i + arg_offset) as int)
                let p_ty LLVMTypeOf(p)
                let phi LLVMBuildPhi(builder, p_ty, "tail.arg")
                var vals Vector[LLVMValueRef](1)
                var blks Vector[LLVMBasicBlockRef](1)
                vals.put(0, p)
                blks.put(0, entry_block)
                LLVMAddIncoming(phi, vals.data, blks.data, 1)
                tail_loop_phis.add phi
                set i: i + 1
            }
            set tail_loop_block: loop_block
            set tail_loop_mangled: mangled
        }

        ; Bring one back-edge argument to its PHI's type. Under the scalar/pointer
        ; restriction above the types already agree in every shape we accept; the
        ; two shims mirror emit_call's (a struct value handed to a pointer slot
        ; goes through a temp, a pointer handed to a struct slot is loaded) so a
        ; member-access argument cannot become a type crash. Anything left is an
        ; emitter inconsistency, and it dies LOUDLY rather than emitting IR that
        ; llc would reject with a message pointing nowhere near here.
        function coerce_tail_arg(this, val: LLVMValueRef, want: LLVMTypeRef) returns LLVMValueRef
        {
            let have LLVMTypeOf(val)
            if have.handle = want.handle
                return val
            let hk LLVMGetTypeKind(have)
            let wk LLVMGetTypeKind(want)
            if wk = LLVMTypeKind.Pointer()
            {
                if hk = LLVMTypeKind.Pointer()
                    return val
                if hk = LLVMTypeKind.Struct()
                {
                    let tmp acquire_temp(have, "tail.arg.tmp")
                    copy_struct_value(tmp, val, have)
                    return tmp
                }
            }
            if wk = LLVMTypeKind.Struct()
            {
                if hk = LLVMTypeKind.Pointer()
                    return LLVMBuildLoad2(builder, want, val, "tail.arg.load")
            }
            scaly_eputs "Emitter: tail-call argument type does not match the parameter it feeds\n"
            exit 20
            val
        }

        ; Is this argument parameter `index` itself, handed on unchanged? Then
        ; nothing may be copied: the bytes already live where the PHI points, and
        ; the copy would be a slot memcpy'd onto itself.
        ;
        ; ★Only the SAME position counts, and that restriction is the fix for a
        ; bug this rule had in its first form ("is it ANY of our PHIs"). Consider
        ; `return f(y, built, …)`: parameter x inherits y's PHI while y's shadow is
        ; rewritten at the same site, so from the third iteration on x pointed at
        ; y's NEW value. Same position is safe because the only site that writes
        ; shadow[i] is one that also sets PHI[i] to it, and every read of the
        ; parameter happens before the commit phase. A cross-position exchange
        ; (`return f(y, x, …)`) therefore goes through the copy machinery, where
        ; staging orders the reads correctly — a little more work than swapping two
        ; pointers, and correct for every mix of sites.
        function value_is_phi_at(this, v: LLVMValueRef, index: size_t) returns bool
        {
            let p_ptr tail_loop_phis.get index
            if p_ptr = null
                return false
            let p (*p_ptr)
            if p.handle = v.handle
                return true
            false
        }

        ; Can this pointer be trusted to address the same bytes on the NEXT
        ; iteration? Only when it does not point into THIS frame's storage: a
        ; parameter (`this`), a loaded pointer (a region-allocated binding's slot
        ; holds the heap address) and a call result all point at a page, at the
        ; caller or at the receiver, and a GEP inherits its base's answer.
        ;
        ; ★An ALLOCA is this frame — and so is everything this cannot classify (a
        ; PHI or select mixing frame storage with a page), which is why the
        ; fallthrough is `false`: guessing "outside" would keep a pointer whose
        ; bytes the next iteration overwrites, and that failure is silent. Guessing
        ; "inside" costs a copy, and a copy is only ever OBSERVABLE for storage
        ; that lives in this frame — where a caller can neither see a mutation
        ; through the parameter (its own copy is dead after the tail call) nor
        ; derive a page from the address (Page.get of frame storage is meaningless
        ; already). That asymmetry is what makes this direction the safe one.
        function pointer_outside_frame(this, v: LLVMValueRef) returns bool
        {
            if v.handle = null
                return false
            let alloca_v LLVMIsAAllocaInst(v)
            if alloca_v.handle <> null
                return false
            let arg_v LLVMIsAArgument(v)
            if arg_v.handle <> null
                return true
            let load_v LLVMIsALoadInst(v)
            if load_v.handle <> null
                return true
            let call_v LLVMIsACallInst(v)
            if call_v.handle <> null
                return true
            let gep_v LLVMIsAGetElementPtrInst(v)
            if gep_v.handle <> null
            {
                let base LLVMGetOperand(v, 0)
                return pointer_outside_frame(base)
            }
            false
        }

        ; memcpy(dst, src, sizeof(ty)) between two pointers. The C entry point
        ; rather than a load+store: map_type-produced struct types are not always
        ; loadable (the s55 cross-package note), and every destination here is a
        ; slot of exactly this type. Callers guarantee dst and src are disjoint —
        ; the two ways they could coincide are ruled out before this is reached
        ; (value_is_own_phi for the pass-through, and a same-type sub-field being
        ; impossible for a strict part of a struct).
        procedure copy_struct_bytes(this, dst: LLVMValueRef, src: LLVMValueRef, ty: LLVMTypeRef)
        {
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var memcpy_fn LLVMGetNamedFunction(llvm_module, "memcpy")
            if memcpy_fn.handle = null
            {
                var decl_pt Vector[LLVMTypeRef](3)
                decl_pt.put(0, ptr_ty)
                decl_pt.put(1, ptr_ty)
                decl_pt.put(2, LLVMInt64TypeInContext context)
                let decl_ty LLVMFunctionType(ptr_ty, decl_pt.data, 3, 0)
                set memcpy_fn: LLVMAddFunction(llvm_module, "memcpy", decl_ty)
                LLVMSetLinkage(memcpy_fn, LLVMLinkage.External())
            }
            var args Vector[LLVMValueRef](3)
            args.put(0, dst)
            args.put(1, src)
            args.put(2, LLVMSizeOf(ty))
            var call_pt Vector[LLVMTypeRef](3)
            call_pt.put(0, ptr_ty)
            call_pt.put(1, ptr_ty)
            call_pt.put(2, LLVMInt64TypeInContext context)
            let call_ty LLVMFunctionType(ptr_ty, call_pt.data, 3, 0)
            LLVMBuildCall2(builder, call_ty, memcpy_fn, args.data, 3, "")
        }

        ; Lower `return f(args)` inside f as a jump to the header. Returns false
        ; when this return is not that shape — and then NOTHING has been emitted,
        ; so emit_return proceeds normally. Everything past the shape test is
        ; committed: the arguments are already emitted, so a giving-up path there
        ; would evaluate them twice (a call argument would run twice). Hence the
        ; loud exits rather than a late `return false`.
        function emit_self_tail_jump(this, ret: PlannedReturn) returns bool
        {
            if tail_loop_block.handle = null
                return false
            let n tail_loop_phis.length
            if return_is_self_call(ret.result, tail_loop_mangled, n) = false
                return false

            let ops (*ret.result)
            let op0_ptr ops.get 0
            if op0_ptr = null
                return false
            let op (*op0_ptr)
            var jumped: bool false
            choose op.expr
                when call: Call
                {
                    ; Evaluate EVERY argument before recording a single incoming:
                    ; a PHI's incoming values are read at the branch, so all
                    ; arguments see this iteration's parameters and the update is
                    ; simultaneous — `return f(b, a)` swaps, as it must.
                    var vals Vector[LLVMValueRef](n + 1)
                    ; 1 = this argument lives in this frame's storage and must be
                    ; copied into the parameter's shadow slot before the branch.
                    var copy_flags Vector[size_t](n + 1)
                    var copy_count: size_t 0
                    var i: size_t 0
                    while i < n
                    {
                        let a_ptr call.args.get i
                        if a_ptr = null
                        {
                            scaly_eputs "Emitter: tail-call argument missing from the plan\n"
                            exit 20
                        }
                        let v emit_operand(*a_ptr)
                        if v.handle = null
                        {
                            ; The silent-drop class: a dropped argument would
                            ; leave its parameter at the previous iteration's
                            ; value and spin forever.
                            scaly_eputs "Emitter: tail-call argument did not emit\n"
                            exit 20
                        }
                        let phi_ptr tail_loop_phis.get i
                        if phi_ptr = null
                        {
                            scaly_eputs "Emitter: tail-call loop is missing a parameter slot\n"
                            exit 20
                        }
                        let phi_ty LLVMTypeOf(*phi_ptr)
                        let coerced coerce_tail_arg(v, phi_ty)
                        vals.put(i, coerced)

                        ; Classify: a by-value struct parameter (the ones with a
                        ; shadow slot) whose argument points into THIS frame needs
                        ; the copy. Everything else travels as it is.
                        var needs_copy: size_t 0
                        let shadow_ptr tail_loop_shadows.get i
                        if shadow_ptr <> null
                        {
                            let shadow (*shadow_ptr)
                            if shadow.handle <> null
                            {
                                if value_is_phi_at(coerced, i) = false
                                {
                                    if pointer_outside_frame(coerced) = false
                                        set needs_copy: 1
                                }
                            }
                        }
                        copy_flags.put(i, needs_copy)
                        if needs_copy = 1
                            set copy_count: copy_count + 1
                        set i: i + 1
                    }

                    ; Commit phase. With ONE copy the source cannot be another
                    ; parameter's shadow, so it goes straight in. With more, a
                    ; source may well be one (`return f(b, a)` over two struct
                    ; parameters), so every source is read into its staging slot
                    ; BEFORE any shadow is written — otherwise the first copy
                    ; clobbers the second's source, the swap-at-memory-level bug
                    ; the PHIs already rule out for values.
                    if copy_count > 1
                    {
                        var s1: size_t 0
                        while s1 < n
                        {
                            let f_ptr copy_flags.get s1
                            if f_ptr <> null
                            {
                                if (*f_ptr) = 1
                                {
                                    let stage_ptr tail_loop_stages.get s1
                                    let ty_ptr tail_loop_slot_types.get s1
                                    let src_ptr vals.get s1
                                    if stage_ptr <> null
                                    {
                                        if ty_ptr <> null
                                        {
                                            if src_ptr <> null
                                                copy_struct_bytes(*stage_ptr, *src_ptr, *ty_ptr)
                                        }
                                    }
                                }
                            }
                            set s1: s1 + 1
                        }
                    }
                    var ci: size_t 0
                    while ci < n
                    {
                        let f_ptr copy_flags.get ci
                        if f_ptr <> null
                        {
                            if (*f_ptr) = 1
                            {
                                let shadow_ptr tail_loop_shadows.get ci
                                let stage_ptr tail_loop_stages.get ci
                                let ty_ptr tail_loop_slot_types.get ci
                                let src_ptr vals.get ci
                                if shadow_ptr <> null
                                {
                                    if ty_ptr <> null
                                    {
                                        var src (*shadow_ptr)
                                        var have_src: bool false
                                        if copy_count > 1
                                        {
                                            if stage_ptr <> null
                                            {
                                                set src: (*stage_ptr)
                                                set have_src: true
                                            }
                                        }
                                        if copy_count = 1
                                        {
                                            if src_ptr <> null
                                            {
                                                set src: (*src_ptr)
                                                set have_src: true
                                            }
                                        }
                                        if have_src
                                        {
                                            let shadow (*shadow_ptr)
                                            copy_struct_bytes(shadow, src, *ty_ptr)
                                            ; The parameter now names the shadow
                                            ; slot: stable storage for exactly as
                                            ; long as the next iteration needs it.
                                            vals.put(ci, shadow)
                                        }
                                    }
                                }
                            }
                        }
                        set ci: ci + 1
                    }

                    ; One block feeds all the PHIs — read it after the arguments
                    ; (an argument can have split the block) and before the br.
                    let from_block LLVMGetInsertBlock(builder)
                    var j: size_t 0
                    while j < n
                    {
                        let phi_ptr tail_loop_phis.get j
                        if phi_ptr <> null
                        {
                            var iv Vector[LLVMValueRef](1)
                            var ib Vector[LLVMBasicBlockRef](1)
                            let vp vals.get j
                            if vp <> null
                                iv.put(0, *vp)
                            ib.put(0, from_block)
                            LLVMAddIncoming(*phi_ptr, iv.data, ib.data, 1)
                        }
                        set j: j + 1
                    }

                    ; ★No emit_release_local_page here: this is not an exit. The
                    ; frame stays open across iterations (see the header note),
                    ; and releasing it would free memory the arguments just
                    ; handed to the next iteration point into.
                    LLVMBuildBr(builder, tail_loop_block)
                    set jumped: true
                }
                else
                    0
            jumped
        }

        ; Emit function body (implementation)
        function emit_function_body(this, func: PlannedFunction) returns bool
        {
            ; Get the LLVM function (should already be declared)
            let llvm_func lookup_function_cache func.mangled_name
            if llvm_func.handle = null
                return false

            ; s196: a fresh function starts with no local root page; its slot is
            ; reserved lazily by get_or_create_local_page, the page itself is
            ; materialised at the demand site and released on every exit.
            set function_local_frame: LLVMValueRef(null)
            set function_local_page: LLVMValueRef(null)
            set function_local_page_block: LLVMBasicBlockRef(null)
            set function_local_page_init: LLVMValueRef(null)
            set function_local_frame_parent_store: LLVMValueRef(null)
            set current_frame_parent: LLVMValueRef(null)
            ; TCO: no tail loop until the walk below asks for one. Cleared here so
            ; a previous function's header can never be branched to.
            set tail_loop_block: LLVMBasicBlockRef(null)
            set tail_loop_phis.length: 0
            set tail_loop_shadows.length: 0
            set tail_loop_stages.length: 0
            set tail_loop_slot_types.length: 0
            set tail_loop_mangled: String()

            ; 4.4: the promotion classifier keys its foundation-containment
            ; rule on the owning source file.
            set parfor_file: func.file

            ; Skip extern functions - they have no body
            choose func.impl
                when ext: Extern
                {
                    return true
                }
                when intr: Intrinsic
                {
                    ; Intrinsic functions are handled specially at call sites
                    return true
                }
                when inst: Instruction
                {
                    ; Instruction-level functions are handled specially
                    return true
                }
                when action: Action
                {
                    ; Skip re-emitting if this function already has a body
                    ; (from a duplicate entry in plan.functions). Without
                    ; this, a second emit_function_body call appends a
                    ; new entry block into a fully-built function and
                    ; produces "Call parameter type does not match
                    ; function signature!" verify failures because the
                    ; duplicate block references stale SSA values.
                    let existing_bb LLVMGetFirstBasicBlock(llvm_func)
                    if existing_bb.handle <> null
                        return true
                    ; s186: uninstantiated generic template — emit an empty stub
                    ; body instead of the real (unresolved, garbage-producing)
                    ; one. Keeps the textual .ll verifiably valid for the Step D
                    ; seed build; these stubs are never reached at runtime.
                    if is_uninstantiated_template(func.mangled_name)
                    {
                        set current_function: llvm_func
                        let stub_entry "entry"
                        let stub_block LLVMAppendBasicBlockInContext(context, llvm_func, stub_entry.c_data())
                        LLVMPositionBuilderAtEnd(builder, stub_block)
                        let stub_func_ty LLVMGlobalGetValueType(llvm_func)
                        let stub_ret_ty LLVMGetReturnType(stub_func_ty)
                        if LLVMGetTypeKind(stub_ret_ty) = LLVMTypeKind.Void()
                            LLVMBuildRetVoid builder
                        if LLVMGetTypeKind(stub_ret_ty) <> LLVMTypeKind.Void()
                        {
                            let stub_zero LLVMConstNull(stub_ret_ty)
                            LLVMBuildRet(builder, stub_zero)
                        }
                        return true
                    }
                    ; Emit the function body
                    set current_function: llvm_func
                    set current_receiver_concept: String()
                    reset_temp_pool()

                    ; s149: track Result-wrapper return for emit_return.
                    set current_function_can_throw: false
                    if func.can_throw
                    {
                        if func.throws_type <> null
                            set current_function_can_throw: true
                    }

                    ; Create entry block
                    let entry_name "entry"
                    let entry_block LLVMAppendBasicBlockInContext(context, llvm_func, entry_name.c_data())
                    LLVMPositionBuilderAtEnd(builder, entry_block)

                    ; -g: start with a clean debug-location state, then (if
                    ; enabled) attach this function's DISubprogram + an initial
                    ; line location. Clearing first stops a stale scope from a
                    ; prior function bleeding into stubs/this prologue.
                    clear_debug_location()
                    if config.emit_debug_info
                        set_function_debug_scope func

                    ; s89: sret-using functions consume LLVM-arg index 0 for
                    ; the indirect-result-location pointer; page/user params
                    ; shift right by one. Same heuristic as emit_function_decl.
                    ; s194: must match emit_function_decl's forced sret for
                    ; throws functions, or the param indices bound below would
                    ; be off by one (the sret pointer occupies LLVM-arg 0).
                    var use_sret needs_sret_for_return(func.mangled_name, func.return_type)
                    if func.can_throw
                    {
                        if func.throws_type <> null
                            set use_sret: true
                    }
                    var sret_offset: size_t 0
                    if use_sret
                        set sret_offset: 1

                    ; Page parameter (function#) is prepended at LLVM-arg
                    ; index sret_offset; user params start at sret_offset+1.
                    var page_offset: size_t 0
                    if func.page_parameter <> null
                    {
                        set page_offset: 1
                        let page_name (*func.page_parameter.unwrap())
                        let page_value LLVMGetParam(llvm_func, sret_offset as int)

                        ; ★A peel parameter the SOURCE named (`page`, `rp`, the
                        ; Modeler's first-parameter peel) is a pointer[Page] to
                        ; user code: it gets passed to Page.allocate, threaded into
                        ; `String^page(...)`, handed to Page.get. Those must see a
                        ; REAL page, so the frame is forced here, once, at entry.
                        ; The implicit slot (`_rp`) stays a frame — that is the
                        ; whole point of the chain, and it is where the laziness
                        ; lives: the hot conditional allocators (StringBuilder.
                        ; append, List.add, Array.add) all take the implicit one.
                        ; A function that names its page does so because it
                        ; allocates on it, so forcing at entry costs it nothing.
                        var bound_page page_value
                        if page_name <> "_rp"
                            set bound_page: force_frame(page_value)
                        define_variable(page_name, bound_page)
                        ; An explicit peel-param named `rp` IS the caller-page
                        ; slot: alias the internal `_rp` name to the FRAME (never
                        ; the forced page) so the call sites that forward a caller
                        ; page keep forwarding a frame.
                        if page_name = "rp"
                            define_variable("_rp", page_value)
                        ; This function's own frame chains onto the one it was
                        ; handed. Recorded here rather than looked up later: the
                        ; outlined parfor task function still sees this variable
                        ; table and must NOT inherit it (see current_frame_parent).
                        set current_frame_parent: page_value
                    }

                    ; TCO: a body containing `return <this same function>(…)` gets
                    ; a loop header here, between the page prologue (which must
                    ; stay in entry) and the user-parameter binding (which then
                    ; binds the header's PHIs instead of the raw arguments).
                    var user_param_count: size_t 0
                    if func.input <> null
                        set user_param_count: (*func.input.unwrap()).length
                    if tail_loop_eligible(func, llvm_func, user_param_count, page_offset + sret_offset)
                        open_tail_loop(func, llvm_func, entry_block, func.mangled_name, user_param_count, page_offset + sret_offset)

                    ; Bind user parameters as local variables, offset by
                    ; the sret + page-param slots when present.
                    if func.input <> null
                    {
                        let input_ref func.input.unwrap()
                        let input (*input_ref)
                        var i: size_t 0
                        while i < input.length
                        {
                            let item_ptr input.get i
                            if item_ptr <> null
                            {
                                let item (*item_ptr)
                                if item.name <> null
                                {
                                    let param_name (*item.name.unwrap())
                                    var param_value LLVMGetParam(llvm_func, (i + page_offset + sret_offset) as int)
                                    ; With a tail loop the name must resolve to the
                                    ; header's PHI, or the second iteration would
                                    ; read the FIRST call's arguments.
                                    if tail_loop_block.handle <> null
                                    {
                                        let phi_ptr tail_loop_phis.get i
                                        if phi_ptr <> null
                                            set param_value: (*phi_ptr)
                                    }
                                    define_variable(param_name, param_value)

                                    ; -g: declare the parameter so the debugger
                                    ; lists it as an ARGUMENT. arg_no is the 1-based
                                    ; position in func.input, i.e. the SOURCE
                                    ; signature — never the LLVM argument index,
                                    ; which the sret and caller-page slots shift by
                                    ; page_offset + sret_offset. With a tail loop
                                    ; param_value is the header PHI, so the shadow
                                    ; store lands in the header and tracks the
                                    ; CURRENT iteration, which is what a debugger
                                    ; should show.
                                    if config.emit_debug_info
                                        if item.item_type <> null
                                        {
                                            let pit_ref item.item_type.unwrap()
                                            let pdpos compute_debug_pos func.loc.start
                                            debug_declare_value(param_name, param_value, (*pit_ref), pdpos, i + 1)
                                        }

                                    ; Record the receiver concept so resolve_reference_page
                                    ; can lower `^field` page sigils (opensp Parser's `^host`).
                                    if param_name = "this"
                                        if item.item_type <> null
                                            set current_receiver_concept: this.peel_concept_name(*item.item_type.unwrap())
                                }
                            }
                            set i: i + 1
                        }
                    }

                    ; Emit the action (function body)
                    let result emit_action action

                    ; Add return if not already terminated. Choose RetVoid
                    ; vs Ret-zero by querying the LLVM function's actual
                    ; return type — `func.return_type` (Plan-side) can be
                    ; null for functions whose Plan return type is missing
                    ; even when emit_function_decl gave the LLVM signature
                    ; a non-void result, which would otherwise produce
                    ; `ret void` in a `ptr`-returning function.
                    let term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                    if term.handle = null
                    {
                        ; The appended terminating return inherits the body's last
                        ; debug location. For an implicit-return function that is
                        ; the return expression's line (correct). NOTE: do NOT
                        ; redirect this to func.loc.end — that span points at the
                        ; START OF THE NEXT DECLARATION, not the closing brace, so
                        ; tagging the ret with it makes a step over a call hop to an
                        ; unrelated line in the same file. (The synthetic main uses
                        ; an EOF location instead; a function has no equivalent
                        ; reliable closing-brace offset here.)

                        ; s196: release the function-local root page on the
                        ; implicit-return path (no-op when none was allocated).
                        emit_release_local_page()
                        let func_ty LLVMGlobalGetValueType(llvm_func)
                        let llvm_rt LLVMGetReturnType(func_ty)
                        let void_ty LLVMVoidTypeInContext(context)
                        ; s89: sret functions return void at the IR level; the
                        ; result value (if any) is stored to the sret slot. If
                        ; emit_action yielded a struct-by-value, store it.
                        ; If it yielded a pointer to a struct (e.g. a heap-
                        ; allocated `var opts Options()`), load the struct
                        ; first via the sret element type.
                        if use_sret
                        {
                            let sret_ptr LLVMGetParam(llvm_func, 0)
                            ; s150: throws-function implicit return must write
                            ; into the Result wrapper {i8 status, [N x i8] data}
                            ; — status=0 (Success) at field 0, T value at field 1.
                            ; Without this, `function parse_program#() throws ...
                            ; returns ProgramSyntax { ... ProgramSyntax(...) }`
                            ; stored the bare ProgramSyntax at sret offset 0,
                            ; clobbering the status byte. Caller's choose then
                            ; reads garbage from the data offset and propagates
                            ; corrupt bytes into the Modeler. Same idea as the
                            ; emit_return throws branch below.
                            if current_function_can_throw
                            {
                                let sret_attr_imp LLVMGetEnumAttributeAtIndex(llvm_func, 1, sret_kind_id())
                                if sret_attr_imp.handle <> null
                                {
                                    let result_sty LLVMGetTypeAttributeValue(sret_attr_imp)
                                    let i8_ty_imp LLVMInt8TypeInContext(context)
                                    let tag_ptr_imp LLVMBuildStructGEP2(builder, result_sty, sret_ptr, 0, "ret.tag.ptr")
                                    LLVMBuildStore(builder, LLVMConstInt(i8_ty_imp, 0, 0), tag_ptr_imp)
                                    if result.handle <> null
                                    {
                                        let data_ptr_imp LLVMBuildStructGEP2(builder, result_sty, sret_ptr, 1, "ret.data.ptr")
                                        let rt2 func.return_type.unwrap()
                                        ; s194: a genuinely scalar/ref/ptr return
                                        ; type stores its value as-is into the data
                                        ; field (copy_struct_value plain-stores
                                        ; non-structs, align 1). Only a STRUCT
                                        ; return whose body yielded a pointer-to-
                                        ; struct (heap `Foo(...)`) needs the load-
                                        ; first so the whole aggregate is memcpy'd,
                                        ; not just 8 bytes of the pointer.
                                        var ret_is_value: bool false
                                        if map_intrinsic_type_by_name(rt2.name).handle <> null
                                            set ret_is_value: true
                                        if rt2.name = "pointer"
                                            set ret_is_value: true
                                        if rt2.name = "ref"
                                            set ret_is_value: true
                                        if is_npo_option(rt2)
                                            set ret_is_value: true
                                        var to_store_imp result
                                        if ret_is_value = false
                                        {
                                            if LLVMGetTypeKind(LLVMTypeOf result) = LLVMTypeKind.Pointer()
                                            {
                                                var sty_imp map_type rt2
                                                if LLVMGetTypeKind(sty_imp) <> LLVMTypeKind.Struct()
                                                    set sty_imp: get_or_create_struct_placeholder(rt2.name, rt2.mangled_name)
                                                if LLVMGetTypeKind(sty_imp) = LLVMTypeKind.Struct()
                                                    set to_store_imp: LLVMBuildLoad2(builder, sty_imp, result, "sret.body")
                                            }
                                        }
                                        ; s178: memcpy when to_store_imp is a load —
                                        ; kills the spill slot; non-structs become a
                                        ; plain align-1 store of the value.
                                        let tsi_ty LLVMTypeOf(to_store_imp)
                                        copy_struct_value(data_ptr_imp, to_store_imp, tsi_ty)
                                    }
                                }
                            }
                            if current_function_can_throw = false
                            {
                                if result.handle <> null
                                {
                                    var to_store result
                                    if LLVMGetTypeKind(LLVMTypeOf result) = LLVMTypeKind.Pointer()
                                    {
                                        let rt2 func.return_type.unwrap()
                                        var sty map_type rt2
                                        if LLVMGetTypeKind(sty) <> LLVMTypeKind.Struct()
                                            set sty: get_or_create_struct_placeholder(rt2.name, rt2.mangled_name)
                                        if LLVMGetTypeKind(sty) = LLVMTypeKind.Struct()
                                            set to_store: LLVMBuildLoad2(builder, sty, result, "sret.body")
                                    }
                                    if LLVMGetTypeKind(LLVMTypeOf to_store) = LLVMTypeKind.Struct()
                                    {
                                        ; s178: memcpy when to_store is a load.
                                        let ts_ty LLVMTypeOf(to_store)
                                        copy_struct_value(sret_ptr, to_store, ts_ty)
                                    }
                                }
                            }
                            LLVMBuildRetVoid builder
                        }
                        else
                        {
                            if LLVMGetTypeKind(llvm_rt) = LLVMGetTypeKind(void_ty)
                                LLVMBuildRetVoid builder
                            else
                            {
                                if result.handle <> null
                                {
                                    ; Struct-by-value return: when the function's
                                    ; LLVM return type is a struct but `result`
                                    ; is a pointer (e.g. emit_tuple yields the
                                    ; alloca, which is downstream-correct for
                                    ; stores but not for `ret %struct`), load
                                    ; the struct first. llc otherwise rejects
                                    ; "value doesn't match function result type".
                                    var ret_val result
                                    if LLVMGetTypeKind(llvm_rt) = LLVMTypeKind.Struct()
                                    {
                                        if LLVMGetTypeKind(LLVMTypeOf result) = LLVMTypeKind.Pointer()
                                            set ret_val: LLVMBuildLoad2(builder, llvm_rt, result, "ret.load")
                                    }
                                    ; ptr-returning fn with struct value → heap-alloc
                                    ; on rp, store, ret ptr. Workaround for the planner
                                    ; force-stack-allocating `Foo(...)` data-class
                                    ; ctors regardless of `#` (Planner.scaly:3047 "heap
                                    ; $/#/^ ctor support is deferred"). Without this,
                                    ; `function plan_program#() returns ref[Plan]? {
                                    ; Plan(...) }` emits `ret ptr null` because the
                                    ; body yields a stack struct that can't be returned
                                    ; as a ref. Mirrors stage-0 emit_tuple's
                                    ; PageAllocate branch for Lifetime.Call.
                                    if LLVMGetTypeKind(llvm_rt) = LLVMTypeKind.Pointer()
                                    {
                                        if LLVMGetTypeKind(LLVMTypeOf ret_val) = LLVMTypeKind.Struct()
                                        {
                                            let result_ty LLVMTypeOf(ret_val)
                                            let rp_frame lookup_variable("_rp")
                                            var rp_val: LLVMValueRef LLVMValueRef(null)
                                            if rp_frame.handle <> null
                                                set rp_val: force_frame(rp_frame)
                                            if rp_val.handle <> null
                                            {
                                                var alloc_func lookup_function_cache("_ZN4Page8allocateEmm")
                                                if alloc_func.handle = null
                                                    set alloc_func: LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
                                                if alloc_func.handle = null
                                                {
                                                    var alloc_param_types_d Vector[LLVMTypeRef](3)
                                                    alloc_param_types_d.put(0, LLVMPointerTypeInContext(context, 0))
                                                    alloc_param_types_d.put(1, LLVMInt64TypeInContext context)
                                                    alloc_param_types_d.put(2, LLVMInt64TypeInContext context)
                                                    let alloc_ret_ty_d LLVMPointerTypeInContext(context, 0)
                                                    let alloc_decl_ty LLVMFunctionType(alloc_ret_ty_d, alloc_param_types_d.data, 3, 0)
                                                    set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", alloc_decl_ty)
                                                    LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                                                    cache_function("_ZN4Page8allocateEmm", alloc_func)
                                                }
                                                let size_const LLVMSizeOf(result_ty)
                                                let align_const LLVMAlignOf(result_ty)
                                                var alloc_args Vector[LLVMValueRef](3)
                                                alloc_args.put(0, rp_val)
                                                alloc_args.put(1, size_const)
                                                alloc_args.put(2, align_const)
                                                var alloc_param_types_c Vector[LLVMTypeRef](3)
                                                alloc_param_types_c.put(0, LLVMPointerTypeInContext(context, 0))
                                                alloc_param_types_c.put(1, LLVMInt64TypeInContext context)
                                                alloc_param_types_c.put(2, LLVMInt64TypeInContext context)
                                                let alloc_ret_ty_c LLVMPointerTypeInContext(context, 0)
                                                let alloc_call_ty LLVMFunctionType(alloc_ret_ty_c, alloc_param_types_c.data, 3, 0)
                                                let heap_ptr LLVMBuildCall2(builder, alloc_call_ty, alloc_func, alloc_args.data, 3, "ret.region")
                                                LLVMBuildStore(builder, ret_val, heap_ptr)
                                                set ret_val: heap_ptr
                                            }
                                        }
                                    }
                                    ; s201: value-side integer promotion (the "real
                                    ; fix" the old bail-to-ConstNull deferred). A
                                    ; wider integer return value (e.g. `-1` (i64)
                                    ; returned as i32 — token_char's eE sentinel)
                                    ; must be TRUNCATED to the return type, not
                                    ; replaced by 0. The old fallback turned every
                                    ; width-mismatched int return into 0, so
                                    ; token_char returned 0 at end-of-entity and the
                                    ; recognizer never emitted tokenEe. scalyc has no
                                    ; wider-than-return int return (else the old bail
                                    ; would have broken its own build), so cycle
                                    ; stays IDENTICAL.
                                    var ret_final ret_val
                                    if LLVMTypeOf(ret_val).handle <> llvm_rt.handle
                                        if LLVMGetTypeKind(LLVMTypeOf ret_val) = LLVMTypeKind.Integer()
                                            if LLVMGetTypeKind(llvm_rt) = LLVMTypeKind.Integer()
                                                if LLVMGetIntTypeWidth(LLVMTypeOf ret_val) > LLVMGetIntTypeWidth(llvm_rt)
                                                    set ret_final: LLVMBuildTrunc(builder, ret_val, llvm_rt, "ret.trunc")
                                    ; Defensive: bail on any remaining type mismatch
                                    ; (fall back to ConstNull, always type-correct).
                                    if LLVMTypeOf(ret_final).handle <> llvm_rt.handle
                                        LLVMBuildRet(builder, LLVMConstNull llvm_rt)
                                    else
                                        LLVMBuildRet(builder, ret_final)
                                }
                                else
                                    LLVMBuildRet(builder, LLVMConstNull llvm_rt)
                            }
                        }
                    }

                    ; Seal any basic block that lacks a terminator. This
                    ; happens when sub-emitters bail early on an unsupported
                    ; operand (e.g. emit_while returning null with the
                    ; builder mid-cond-block leaves while.body / while.exit
                    ; empty). LLVM IR requires every block to end in a
                    ; terminator; without sealing, llc rejects the .ll and
                    ; the IRTranslator SEGVs in -o mode.
                    var bb LLVMGetFirstBasicBlock(llvm_func)
                    while bb.handle <> null
                    {
                        let bb_term LLVMGetBasicBlockTerminator(bb)
                        if bb_term.handle = null
                        {
                            LLVMPositionBuilderAtEnd(builder, bb)
                            LLVMBuildUnreachable builder
                        }
                        set bb: LLVMGetNextBasicBlock(bb)
                    }

                    ; Clear local variables for next function
                    clear_local_variables()

                    return true
                }
                else
                {
                    return false
                }
        }

        ; ========================================================================
        ; Constant Emission
        ; ========================================================================

        ; Emit a String literal as a compile-time CONSTANT: a private global
        ; [varint(len)][content][NUL] in .rodata, returning a String { ptr }
        ; value pointing at the varint start. No page, no allocation, immortal.
        ; The trailing NUL (uncounted, the s186 over-allocation contract) keeps
        ; c_data() zero-copy for C/extern interop; the empty string is just
        ; { null } (get_length treats null as 0). Mirrors String.init#'s LEB128
        ; varint exactly so get_length/get_buffer decode it.
        function emit_string_constant(this, value: String) returns LLVMValueRef
        {
            let i8ty LLVMInt8TypeInContext(context)
            let ptrty LLVMPointerTypeInContext(context, 0)

            let content_len value.get_length()
            if content_len = 0
            {
                var nullvals Vector[LLVMValueRef](1)
                nullvals.put(0, LLVMConstNull(ptrty))
                return LLVMConstStructInContext(context, nullvals.data, 1, 0)
            }

            ; count varint bytes (LEB128)
            var rest content_len
            var vcount: size_t 1
            while rest >= 0x80
            {
                set rest: rest >> 7
                set vcount: vcount + 1
            }
            let total vcount + content_len + 1
            var bytes Vector[LLVMValueRef](total)

            ; write the varint, mirroring String.init# exactly
            var wrest content_len
            var wi: size_t 0
            while wrest >= 0x80
            {
                bytes.put(wi, LLVMConstInt(i8ty, wrest | 0x80, 0))
                set wrest: wrest >> 7
                set wi: wi + 1
            }
            bytes.put(wi, LLVMConstInt(i8ty, wrest, 0))
            set wi: wi + 1

            ; content bytes
            let buf value.get_buffer()
            var ci: size_t 0
            while ci < content_len
            {
                let b *(buf + ci)
                bytes.put(wi, LLVMConstInt(i8ty, b as size_t, 0))
                set wi: wi + 1
                set ci: ci + 1
            }
            ; trailing NUL (not counted in the varint length)
            bytes.put(wi, LLVMConstInt(i8ty, 0, 0))

            let arr_ty LLVMArrayType(i8ty, total as int)
            let arr LLVMConstArray(i8ty, bytes.data, total as int)
            let g LLVMAddGlobal(llvm_module, arr_ty, ".sconst")
            LLVMSetInitializer(g, arr)
            LLVMSetGlobalConstant(g, 1)
            LLVMSetLinkage(g, LLVMLinkage.Private())

            var dvals Vector[LLVMValueRef](1)
            dvals.put(0, g)
            LLVMConstStructInContext(context, dvals.data, 1, 0)
        }

        ; Emit a constant value
        function emit_constant(this, const: PlannedConstant, result_type: PlannedType) returns LLVMValueRef
        {
            choose const.value
                when b: Boolean
                {
                    let llvm_type LLVMInt1TypeInContext(context)
                    if b.value
                        return LLVMConstInt(llvm_type, 1, 0)
                    else
                        return LLVMConstInt(llvm_type, 0, 0)
                }
                when i: Integer
                {
                    ; s105: use result_type's width when known; default to
                    ; i32 only when no type info is available. Mirrors
                    ; stage-0 emitConstant (Emitter.cpp:4297-4300) which
                    ; defaults to i64 for unknown-typed integer literals.
                    ; The Scaly default is i32 to match the existing AOT
                    ; corpus, but typed contexts (size_t param, struct
                    ; field) need the literal in the right width or stores
                    ; truncate (i32 stored into a size_t field reads
                    ; garbage in the high bytes).
                    var llvm_type map_intrinsic_type_by_name result_type.name
                    if llvm_type.handle = null
                        set llvm_type: LLVMInt32TypeInContext(context)
                    if LLVMGetTypeKind(llvm_type) <> LLVMTypeKind.Integer()
                        set llvm_type: LLVMInt32TypeInContext(context)
                    return LLVMConstInt(llvm_type, i.value as size_t, 1)
                }
                when h: Hex
                {
                    ; Honor a typed position's integer width, like the Integer
                    ; arm (s105) — an always-i64 hex constant read from a u32
                    ; module global (`define X: u32 0xFFFFFFFF`) makes a deref
                    ; store 8 bytes wide, zeroing the 4 bytes AFTER the slot.
                    ; Default stays i64 (stage-0 emitConstant hex behavior).
                    var llvm_type map_intrinsic_type_by_name result_type.name
                    if llvm_type.handle = null
                        set llvm_type: LLVMInt64TypeInContext(context)
                    if LLVMGetTypeKind(llvm_type) <> LLVMTypeKind.Integer()
                        set llvm_type: LLVMInt64TypeInContext(context)
                    return LLVMConstInt(llvm_type, h.value, 0)
                }
                when fp: FloatingPoint
                {
                    ; Honor a planner-retyped float/f32 result_type (annotated
                    ; binding, float param, float comparison operand); default
                    ; stays double. LLVMConstReal rounds the double payload to
                    ; the target width.
                    var llvm_type LLVMDoubleTypeInContext(context)
                    if result_type.name = "float"
                        set llvm_type: LLVMFloatTypeInContext(context)
                    if result_type.name = "f32"
                        set llvm_type: LLVMFloatTypeInContext(context)
                    return LLVMConstReal(llvm_type, fp.value)
                }
                when s: String
                {
                    ; String-typed position → a real String { ptr } constant
                    ; (varint global). Otherwise (pointer[const_char]/i8 position
                    ; — extern args, String() ctor, equals(cstr), const_char
                    ; returns) emit the plain NUL-terminated cstr global as
                    ; before, byte-identical.
                    if result_type.name = "String"
                        return this.emit_string_constant(s.value)
                    return LLVMBuildGlobalStringPtr(builder, s.value.c_data(), ".str")
                }
                when c: Character
                {
                    let llvm_type LLVMInt8TypeInContext(context)
                    ; Get first character
                    if c.value.get_length() > 0
                    {
                        let ch c.value.get 0
                        return LLVMConstInt(llvm_type, ch as size_t, 0)
                    }
                    return LLVMConstInt(llvm_type, 0, 0)
                }
                when fr: Fragment
                {
                    return LLVMConstStringInContext(context, fr.value.c_data(), fr.value.length as int, 0)
                }
                when n: Null
                {
                    let ptr_type LLVMPointerTypeInContext(context, 0)
                    return LLVMConstPointerNull ptr_type
                }
        }

        ; ========================================================================
        ; Basic Block Creation
        ; ========================================================================

        ; Create a new basic block in the current function
        function create_block(this, name: String) returns LLVMBasicBlockRef
        {
            LLVMAppendBasicBlockInContext(context, current_function, name.c_data())
        }

        ; ========================================================================
        ; Main Emission Entry Point
        ; ========================================================================

        ; Emit a complete plan
        ; Reachability-free test exclusion for the .ll seed build (--no-tests).
        ; The scaly/scalyc package test orchestrators (`test`, `test_*`) are the
        ; only callers of uninstantiated generics (Option[int], Result[int,bool],
        ; Slice[int].subslice, HashMap[String,int]); cli.main never reaches them.
        ; Default off, so normal -c/-o/AOT/selfhosted emission is unchanged; the
        ; seed build passes --no-tests so these dead symbols drop and the seed
        ; links with zero undefined. NOT a compiler-wide name skip (that regresses
        ; AOT sibling_call's legit `function test()`) — gated on the flag.
        function is_test_function(this, func: PlannedFunction) returns bool
        {
            if config.skip_tests = false
                return false
            if func.name = "test"
                return true
            func.name.starts_with("test_")
        }

        function emit(this, plan: Plan, module_name: String) returns bool
        {
            initialize(module_name)
            set current_plan: plan

            ; s159: Pre-declare the extern C runtime functions memcpy/memset
            ; up front, before any function body is emitted. Container methods
            ; (Vector[T].add, Vector[T].init#) call memcpy/memset. The bodies
            ; for early generic instantiations (char / String / *Syntax types)
            ; are emitted before the lazy struct-copy helper (~line 6660)
            ; materializes @memcpy, so emit_call's LLVMGetNamedFunction lookup
            ; missed and the whole call was dropped — Vector growth silently
            ; lost its old elements. The emit-order cutoff matched the first
            ; @memcpy exactly. Declaring both here removes the ordering
            ; dependency. Declared varargs (no param-type array): the call
            ; sites build their own concrete func_type for LLVMBuildCall2, so
            ; the declaration signature is cosmetic, and a varargs decl links
            ; cleanly to libc. Unconditional is safe: the struct-copy helper
            ; checks LLVMGetNamedFunction before adding, so it reuses these.
            let rt_ptr LLVMPointerTypeInContext(context, 0)
            let mc_fty LLVMFunctionType(rt_ptr, null as pointer[LLVMTypeRef], 0, 1)
            LLVMAddFunction(llvm_module, "memcpy", mc_fty)
            let ms_fty LLVMFunctionType(rt_ptr, null as pointer[LLVMTypeRef], 0, 1)
            LLVMAddFunction(llvm_module, "memset", ms_fty)

            ; Emit all structures
            if plan.structures <> null
            {
                for struct in plan.structures
                    emit_struct_type struct
            }

            ; Emit all unions
            if plan.unions <> null
            {
                for union_type in plan.unions
                    emit_union_type union_type
            }

            ; Emit function declarations first (for forward references)
            if plan.functions <> null
            {
                for func in plan.functions
                {
                    if is_test_function(func) = false
                        emit_function_decl func
                }
            }

            ; Emit global variables BEFORE function bodies so that
            ; emit_global_ref / the GlobalRef store arm can resolve them via
            ; LLVMGetNamedGlobal while emitting bodies that read/write them
            ; (s189 — mutable runtime globals like @stack_top).
            ;
            ; Globals declared as `define NAME: int VALUE` carry a planned
            ; `int`/`u8`/`size_t` type. The general map_type path runs an
            ; intrinsic-name lookup against `intrinsic_type_names`, but the
            ; Strings in that Vector are constructed via `String(...)` in
            ; init_intrinsic_types — they dangle after init returns and
            ; mis-match here, falling through to opaque-ptr fallback. That
            ; produces invalid IR like `@"NAME" = constant ptr 9`. Use the
            ; cstring-literal direct lookup first, then map_type for
            ; struct/pointer/ref globals (e.g. extern function ptr globals).
            if plan.globals <> null
            {
                for global in plan.globals
                {
                    ; Const array globals (array_size set by plan_global)
                    ; emit as [N x T] with a ConstArray initializer — the
                    ; scalar path below would emit an initializer-less
                    ; scalar decl (undefined at link; the s188 HASH_PRIMES
                    ; class).
                    if emit_array_global(global)
                        continue

                    var global_type map_intrinsic_type_by_name global.global_type.name
                    if global_type.handle = null
                        set global_type: map_type(global.global_type)

                    let gv LLVMAddGlobal(llvm_module, global_type, global.mangled_name.c_data())

                    ; Set initializer if present
                    if global.value <> null
                    {
                        let init_value emit_operands global.value
                        if init_value.handle <> null
                            LLVMSetInitializer(gv, init_value)
                    }

                    ; s189: mutable module globals (stack_head etc.) need a
                    ; concrete initializer and must NOT be marked constant —
                    ; reads load and `set NAME:` stores. A mutable global with
                    ; no explicit initializer still needs one for a definition
                    ; (vs an external declaration), so zero-init it.
                    if global.is_mutable
                    {
                        if global.value = null
                            LLVMSetInitializer(gv, LLVMConstNull global_type)
                        LLVMSetGlobalConstant(gv, 0)
                        ; M2.2: every mutable module global is thread-local —
                        ; the allocator state (stack_top/heap_head) is a
                        ; per-thread stack discipline, and any process-shared
                        ; mutable would be a data race under threads.
                        ; Exemption: a `shared` declaration keeps the global
                        ; PROCESS-global — a deliberate cross-thread cell (the
                        ; heap-trace table root). The declarer owns the race
                        ; discipline: initialize while the process is still
                        ; single-threaded (anything before the first
                        ; Thread.spawn returns) or mutate via scaly_atomic_*.
                        if global.is_shared = false
                            LLVMSetThreadLocal(gv, 1)
                    }
                    if global.is_mutable = false
                    {
                        LLVMSetGlobalConstant(gv, 1)
                        set_module_constant_linkage gv
                    }
                }
            }

            ; Emit function bodies
            if plan.functions <> null
            {
                for func in plan.functions
                {
                    if is_test_function(func) = false
                        emit_function_body func
                }
            }

            ; Emit main wrapper for top-level statements if present.
            ; Stage-1's planner can't auto-deref `plan.statements.length`
            ; (member access on a `ref[Vector[T]]?` after null-narrow), so a
            ; direct `if plan.statements.length > 0` would silently drop
            ; both itself AND any surrounding if body when stage-1 plans
            ; Emitter.scaly. Counting via a `for in plan.statements` first pass
            ; (auto-iter path works) then `if count > 0` (local var compare)
            ; sidesteps the gap. Without an outer length gate, scalyc.scaly's
            ; emit (no top-level statements) would still create an empty `@main
            ; () { ret 0 }` that overrides main.scaly's real entry at link time
            ; — observed: stage-2 silently exiting with no output.
            if plan.statements <> null
            {
                var stmt_count: size_t 0
                for s in plan.statements
                    set stmt_count: stmt_count + 1
                if stmt_count > 0
                {
                    ; Create main function if not already present
                    let main_name "main"
                    let main_func LLVMGetNamedFunction(llvm_module, main_name.c_data())
                    if main_func.handle = null
                    {
                        let i32_type LLVMInt32TypeInContext(context)
                        let main_type LLVMFunctionType(i32_type, null as pointer[LLVMTypeRef], 0, 0)
                        let new_main LLVMAddFunction(llvm_module, main_name.c_data(), main_type)
                        set current_function: new_main
                        reset_temp_pool()
                        ; TCO: main is nobody's tail loop.
                        set tail_loop_block: LLVMBasicBlockRef(null)
                        ; s196: synthetic main starts with no local root page.
                        set function_local_frame: LLVMValueRef(null)
                        set function_local_page: LLVMValueRef(null)
                        set function_local_page_block: LLVMBasicBlockRef(null)
                        set function_local_page_init: LLVMValueRef(null)
                        set function_local_frame_parent_store: LLVMValueRef(null)
                        set current_frame_parent: LLVMValueRef(null)

                        let entry_name "entry"
                        let entry_block LLVMAppendBasicBlockInContext(context, new_main, entry_name.c_data())
                        LLVMPositionBuilderAtEnd(builder, entry_block)

                        ; -g: give the synthetic main its own DISubprogram so the
                        ; top-level statements (the program body) are debuggable.
                        clear_debug_location()
                        if config.emit_debug_info
                            set_synthetic_debug_scope(main_name, 1)

                        ; Emit top-level statements
                        set parfor_file: source_file
                        for stmt in plan.statements
                            emit_statement stmt

                        ; Return 0 if not terminated
                        let term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if term.handle = null
                        {
                            ; -g: point the synthetic return past the last source
                            ; line (EOF) rather than letting it inherit the last
                            ; statement's location. Without this the trailing `ret`
                            ; carries whatever line was set last — for an if/loop as
                            ; the final statement that is a branch/body line that may
                            ; not have run, so stepping appears to hop backward into
                            ; it. An EOF location steps forward off the end of the
                            ; program (into the C runtime), like a function's closing
                            ; brace. compute_debug_pos clamps to the source length.
                            set_debug_location(Span(source_text.get_length(), source_text.get_length()))

                            ; s196: release main's local root page (no-op when
                            ; the program body allocated none on it).
                            emit_release_local_page()
                            let zero LLVMConstInt(i32_type, 0, 0)
                            LLVMBuildRet(builder, zero)
                        }

                        ; Clear before any later stub/forwarder emission.
                        clear_debug_location()
                    }
                }
            }

            ; Step-7 link blocker: stage-1's planner emits deep-generic
            ; template stubs (linkonce_odr functions with literal "T")
            ; whose bodies call constructors with an EXTRA level of
            ; generic wrapping. E.g. Vector<Vector<T>>::get_iterator's
            ; body calls VectorIterator<Vector<Vector<T>>>::ctor (wrong)
            ; instead of VectorIterator<Vector<T>>::ctor (right). Same
            ; pattern for Array<Vector<T>>::Array referencing
            ; Vector<Vector<Vector<T>>>::Vector. ld then errors because
            ; those wrong-mangled targets have no definition anywhere.
            ; These template stubs are never called at runtime (only
            ; concrete instantiations like Vector<int> are reached), so
            ; emitting empty bodies for any leftover declarations whose
            ; mangled name contains the literal-T marker `I1TE` makes
            ; the link succeed without affecting runtime correctness.
            ; -g: drop any active debug location so the stub/forwarder bodies
            ; below (which have no DISubprogram) don't inherit a stale scope.
            clear_debug_location()

            emit_template_stubs()

            ensure_free_page_get()

            ; -g: resolve all deferred debug-info references into the module.
            if config.emit_debug_info
                LLVMDIBuilderFinalize di_builder

            ; Rule-10 build stamp (stage 7): every PROGRAM module — one that
            ; DEFINES main, via the top-level-statements wrapper above or as
            ; an explicit main function (the compiler's own main.scaly) —
            ; carries `scaly_build_stamp()`. The name goes in as a raw cstring
            ; cast (the s-main func_cstr pattern): a String constant's c_data()
            ; has no NUL terminator, and this lookup DEPENDS on matching.
            let stamp_main LLVMGetNamedFunction(llvm_module, "main" as pointer[const_char])
            if stamp_main.handle <> null
                if LLVMIsDeclaration(stamp_main) = 0
                    emit_build_stamp()

            ; Last: drop the region frames nothing allocates on. Runs over the
            ; FINISHED module — every body, stub and template instantiation has
            ; to exist before a callee's parameter uses can be read.
            elide_unused_pages()

            true
        }

        ; s187: define the free-form page-get intrinsic `_Z3getPv`. The s181
        ; `^this` region-alloc emission (and the planner's page-get sites)
        ; reference `get(void*)` mangled as the free `_Z3getPv`, but the Scaly
        ; source defines `Page.get` under the namespace mangling
        ; `_ZN4Page3getEPv`. Stage-0's generatePageGetThis plans Page.get under
        ; the free name so its body is emitted; stage-1 only ever DECLARED
        ; `_Z3getPv` (on-the-fly in emit_call), leaving it undefined in the
        ; seed (.ll round-trip with no stage-0-built libscaly.a). Tie the free
        ; form to the namespace definition: when `_ZN4Page3getEPv` has a body
        ; in this module (only true for scaly.ll, where Page is defined) and
        ; `_Z3getPv` is referenced but bodyless, emit `_Z3getPv` as a
        ; LinkOnceODR forwarder. Emitting it ONLY where Page.get is defined
        ; keeps scalyc.ll declaring-not-defining (no duplicate at link).
        procedure ensure_free_page_get(this)
        {
            let page_get LLVMGetNamedFunction(llvm_module, "_ZN4Page3getEPv")
            if page_get.handle = null
                return
            if LLVMIsDeclaration(page_get) <> 0
                return
            let free_get LLVMGetNamedFunction(llvm_module, "_Z3getPv")
            if free_get.handle = null
                return
            if LLVMIsDeclaration(free_get) = 0
                return

            let saved_block LLVMGetInsertBlock(builder)
            set_linkonce_odr(free_get)
            let block LLVMAppendBasicBlockInContext(context, free_get, "entry")
            LLVMPositionBuilderAtEnd(builder, block)
            let arg0 LLVMGetParam(free_get, 0)
            let pg_ty LLVMGlobalGetValueType(page_get)
            var call_args Vector[LLVMValueRef](1)
            call_args.put(0, arg0)
            let result LLVMBuildCall2(builder, pg_ty, page_get, call_args.data, 1, "page")
            LLVMBuildRet(builder, result)
            if saved_block.handle <> null
                LLVMPositionBuilderAtEnd(builder, saved_block)
        }

        ; Rule-10 build stamp (stage 7, milestone 7.3): every PROGRAM module
        ; (top-level statements — the same gate as the main wrapper) defines
        ; `u64 scaly_build_stamp()` returning the FNV-1a-64 of the module's
        ; PRE-STAMP IR text. The hash skips the `; ModuleID` comment, the
        ; `source_filename` line and the `target datalayout` line, so a
        ; byte-identical source build reproduces the stamp regardless of the
        ; checkout path or the --target choice (the LP64-LE wire format keeps
        ; arm64<->x86_64 interop, memo rule 8 — the stamp must not break it).
        ; External linkage like main: whole-program opt must never drop it.
        ; The stdlib Node handshake reads the stamp through an extern
        ; declaration and exchanges it as the FIRST bytes on the wire — two
        ; binaries from different builds refuse each other loudly (rule 10).
        function stamp_line_skipped(this, text: pointer[char], i: size_t) returns bool
        {
            let b0 (*(((text as size_t) + i) as pointer[char])) as u8
            ; "; M..." — the ModuleID comment (Function-Attrs comments are
            ; "; F", they stay hashed; printed IR has no other comments).
            if b0 = 59
            {
                let b1 (*(((text as size_t) + i + 1) as pointer[char])) as u8
                if b1 = 32
                {
                    let b2 (*(((text as size_t) + i + 2) as pointer[char])) as u8
                    if b2 = 77
                        return true
                }
                return false
            }
            ; "sou..." — source_filename (no block label collides: the
            ; emitter's block names are entry/then/else/...).
            if b0 = 115
            {
                let b1 (*(((text as size_t) + i + 1) as pointer[char])) as u8
                if b1 = 111
                {
                    let b2 (*(((text as size_t) + i + 2) as pointer[char])) as u8
                    if b2 = 117
                        return true
                }
                return false
            }
            ; "tar..." — the target datalayout line.
            if b0 = 116
            {
                let b1 (*(((text as size_t) + i + 1) as pointer[char])) as u8
                if b1 = 97
                {
                    let b2 (*(((text as size_t) + i + 2) as pointer[char])) as u8
                    if b2 = 114
                        return true
                }
                return false
            }
            false
        }

        procedure emit_build_stamp(this)
        {
            let existing LLVMGetNamedFunction(llvm_module, "scaly_build_stamp" as pointer[const_char])
            if existing.handle <> null
                return

            let text LLVMPrintModuleToString(llvm_module)
            if text = null
                return

            var hash: u64 0xcbf29ce484222325
            var i: size_t 0
            var line_begin true
            var skipping false
            repeat
            {
                let b (*(((text as size_t) + i) as pointer[char])) as u8
                if b = 0
                    break
                if line_begin
                    set skipping: stamp_line_skipped(text, i)
                if skipping = false
                    set hash: (hash xor (b as u64)) * 0x100000001b3
                if b = 10
                    set line_begin: true
                else
                    set line_begin: false
                set i: i + 1
            }
            LLVMDisposeMessage text

            clear_debug_location()
            let saved_block LLVMGetInsertBlock(builder)
            let i64_type LLVMInt64TypeInContext(context)
            let stamp_type LLVMFunctionType(i64_type, null as pointer[LLVMTypeRef], 0, 0)
            let stamp_fn LLVMAddFunction(llvm_module, "scaly_build_stamp" as pointer[const_char], stamp_type)
            let block LLVMAppendBasicBlockInContext(context, stamp_fn, "entry" as pointer[const_char])
            LLVMPositionBuilderAtEnd(builder, block)
            let cval LLVMConstInt(i64_type, hash as size_t, 0)
            LLVMBuildRet(builder, cval)
            if saved_block.handle <> null
                LLVMPositionBuilderAtEnd(builder, saved_block)
        }

        ; Append empty stub bodies for any function declarations whose
        ; mangled name embeds a literal-T template parameter. Walks the
        ; module's function list via LLVMGetFirstFunction / LLVMGetNextFunction.
        ; For void-return functions, emits `ret void`; for non-void, emits
        ; `ret zeroinitializer` of the return type. Skips functions that
        ; already have at least one basic block (definitions). Skips
        ; non-template extern declarations (libc / LLVM-C API) by
        ; requiring the literal-T marker in the symbol name.
        procedure emit_template_stubs(this)
        {
            var func LLVMGetFirstFunction(llvm_module)
            while func.handle <> null
            {
                if LLVMIsDeclaration(func) <> 0
                {
                    var name_len: size_t 0
                    let name_ptr LLVMGetValueName2(func, &name_len)
                    if name_ptr <> null
                    {
                        if name_len > 4
                        {
                            ; s187: detect a literal 1-char type parameter T/K/V
                            ; anywhere in the mangled name by reusing the proven
                            ; is_uninstantiated_template (a single 'T'(84)/'K'(75)/
                            ; 'V'(86) preceded by '1'(49) preceded by a non-digit).
                            ; The old inline scan matched only the 4-byte window
                            ; "I1TE", missing K/V and embedded forms like "I1K1VE"
                            ; (the K,V iterator
                            ; BuilderListIterator<Slot<KeyValuePair<K,V>>>::next
                            ; referenced by the dead uninstantiated HashMapBuilder
                            ; template), which then stayed an undefined declaration
                            ; in the seed. Inlining the K/V scan here was
                            ; miscompiled by stage-1 (crash on template-heavy
                            ; modules); calling the existing fixed-point-clean
                            ; function on a String sidesteps it.
                            ;
                            ; s17 lesson: ONLY consider Scaly-mangled (`_Z...`)
                            ; symbols. The broadened T/K/V test would otherwise
                            ; match LLVM-C / libc externs — e.g.
                            ; `LLVMInt1TypeInContext` ("...t1T...": 't' non-digit,
                            ; '1', 'T') — and stub the i1-type constructor to
                            ; `ret null`, crashing every bool/icmp emission. The
                            ; old "I1TE" 4-byte window happened to exclude them
                            ; (required 'I' before "1T"); the general test does
                            ; not, so gate on the `_Z` prefix explicitly.
                            var is_scaly_mangled: bool false
                            if (*(name_ptr + 0)) = 95
                            {
                                if (*(name_ptr + 1)) = 90
                                    set is_scaly_mangled: true
                            }
                            var has_marker: bool false
                            if is_scaly_mangled
                            {
                                let mname String(name_ptr as pointer[const_char], name_len)
                                set has_marker: is_uninstantiated_template(mname)
                            }
                            ; Second marker: scalyc-specific stdlib-generic
                            ; method instantiations whose body stage-1 can't
                            ; emit (s125b: HashMapBuilder[K,V] et al. are treated
                            ; as opaque ptr, so their methods come out as extern
                            ; declares expecting libscaly.a to define them). The
                            ; only such instantiation reached by scalyc.scaly is
                            ; HashMapBuilder[String, Nameable] — Nameable is a
                            ; scalyc type, so libscaly.a (built from scaly.scaly)
                            ; never provides it. Until real HashMapBuilder
                            ; instantiation lands (Step 4 generics), stub it to a
                            ; no-op: equivalent to the pre-fix behavior where the
                            ; symbol-registering `.add` call was dropped entirely.
                            ; Marker "Nameable" = ASCII 78 97 109 101 97 98 108 101.
                            if has_marker = false
                            {
                                if name_len > 8
                                {
                                    var j: size_t 0
                                    let scan_limit2 name_len - 8
                                    while j <= scan_limit2
                                    {
                                        if has_marker = false
                                        {
                                            let q0 *(name_ptr + j)
                                            if q0 = 78
                                            {
                                                if (*(name_ptr + (j + 1))) = 97
                                                {
                                                    if (*(name_ptr + (j + 2))) = 109
                                                    {
                                                        if (*(name_ptr + (j + 3))) = 101
                                                        {
                                                            if (*(name_ptr + (j + 4))) = 97
                                                            {
                                                                if (*(name_ptr + (j + 5))) = 98
                                                                {
                                                                    if (*(name_ptr + (j + 6))) = 108
                                                                    {
                                                                        if (*(name_ptr + (j + 7))) = 101
                                                                            set has_marker: true
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        set j: j + 1
                                    }
                                }
                            }
                            if has_marker
                            {
                                let saved_block LLVMGetInsertBlock(builder)
                                let block LLVMAppendBasicBlockInContext(context, func, "stub.entry")
                                LLVMPositionBuilderAtEnd(builder, block)
                                let func_ty LLVMGlobalGetValueType(func)
                                let ret_ty LLVMGetReturnType(func_ty)
                                if LLVMGetTypeKind(ret_ty) = LLVMTypeKind.Void()
                                    LLVMBuildRetVoid builder
                                if LLVMGetTypeKind(ret_ty) <> LLVMTypeKind.Void()
                                {
                                    let zero LLVMConstNull(ret_ty)
                                    LLVMBuildRet(builder, zero)
                                }
                                if saved_block.handle <> null
                                    LLVMPositionBuilderAtEnd(builder, saved_block)
                            }
                            ; s186: a `declare linkonce_odr` (declaration, no body)
                            ; is invalid IR — linkonce_odr requires a definition.
                            ; A genuine external callee carries External linkage; a
                            ; leftover linkonce_odr declaration is a stray, never-
                            ; defined uninstantiated generic (e.g. bare
                            ; `Option::unwrap`). Demote it to External so the .ll
                            ; verifies (Step D seed round-trip); unreferenced, the
                            ; linker drops it. External (not an empty body) avoids
                            ; shadowing a real libscaly.a definition (s17 lesson).
                            ; Stage 7: the comdat set_linkonce_odr attached on a
                            ; COFF target must come off WITH the linkage — "a
                            ; declaration may not be in a comdat" is its own
                            ; verifier error, so demoting only the linkage
                            ; exchanges one invalid `declare` for another.
                            ; Clearing it unconditionally is right: a function
                            ; that is not linkonce_odr never had one.
                            if has_marker = false
                            {
                                if LLVMGetLinkage(func) = LLVMLinkage.LinkOnceODR()
                                {
                                    LLVMSetLinkage(func, LLVMLinkage.External())
                                    LLVMSetComdat(func, LLVMComdatRef(null))
                                }
                            }
                        }
                    }
                }
                set func: LLVMGetNextFunction(func)
            }
        }

        ; ========================================================================
        ; ORC LLJIT (in-process JIT) — self-hosted `--run` mode
        ; ========================================================================

        ; JIT-only: stub every declared-only Scaly-mangled (_Z...) function with a
        ; trivial return. Functions from loaded modules reference stdlib symbols
        ; the JIT module doesn't fully define; these stubs prevent JIT link
        ; failures for functions declared but never reached at runtime. C functions
        ; (libc / LLVM-C) keep their declarations — the process symbol generator
        ; resolves them from the host. Mirrors stage-0 jitExecuteIntFunction's stub
        ; pass (Emitter.cpp). Only _Z names (s17 lesson: never stub LLVM*/libc).
        ;
        ; A blanket stub, though, ALSO null-stubs the RBMM runtime + stdlib
        ; (Page.allocate, StringBuilder.*, ...) — declared-only here but real
        ; functions the host process exports — so region allocation returned a
        ; null page and every JIT program that heap-allocates crashed or produced
        ; empty output. We now skip stubbing any symbol dlsym finds in the host,
        ; letting the process generator resolve the real one.
        ; This only works when the host binary EXPORTS those symbols. Both builds
        ; now do: the multi-object bootstrap link (/tmp/scalyc_stage2) keeps them
        ; global on its own, and the whole-program `opt -O2` build (scalyc/build/
        ; scalyc) is made to as well — build-from-seed.sh promotes the runtime
        ; bodies to weak_odr before opt (else opt DCE's the fully-inlined ones,
        ; e.g. StringBuilder's ctor) and strips unnamed_addr after opt (else macOS
        ; ld auto-hides the weak_def_can_be_hidden symbols to local). See the
        ; comment block around the whole-program opt path in that script.
        ; True when the cstring [name_ptr, name_len) equals one of the mangled
        ; names in `set` (a dependency-package's provided symbols). Linear scan —
        ; the set is small (one entry per dep-package top-level function) and this
        ; runs once per module declaration at JIT setup.
        function jit_symbol_in_set(this, sym_set: pointer[Array[String]], name_ptr: pointer[const_char], name_len: size_t) returns bool
        {
            if sym_set = null
                return false
            let arr (*sym_set)
            var i: size_t 0
            while i < arr.length
            {
                let sp arr.get i
                if sp <> null
                {
                    let s (*sp)
                    if s.get_length() = name_len
                    {
                        let sd s.c_data()
                        var j: size_t 0
                        var eq: bool true
                        while j < name_len
                        {
                            if (*(sd + j)) <> (*(name_ptr + j))
                            {
                                set eq: false
                                set j: name_len
                            }
                            set j: j + 1
                        }
                        if eq
                            return true
                    }
                }
                set i: i + 1
            }
            false
        }

        ; dep_symbols: mangled names DEFINED by dependency-package objects that
        ; jit_run adds to the JITDylib (null when there are none). A declared-only
        ; symbol in that set must NOT be stubbed — the ORC object linker resolves
        ; it to the real dependency body; a null-returning stub here would shadow
        ; it (the old jit_dep_bodies false-pass). Everything else is unchanged.
        procedure emit_jit_stubs(this, dep_symbols: pointer[Array[String]])
        {
            ; Skip symbols the host process already exports so the ORC process
            ; generator can resolve the REAL function (see the per-symbol note
            ; below); stub only the genuinely-absent ones. Handle to the running
            ; scalyc image (RTLD_NOW = 2).
            let jit_host_handle dlopen(null as pointer[const_char], 2 as i32)
            var func LLVMGetFirstFunction(llvm_module)
            while func.handle <> null
            {
                if LLVMIsDeclaration(func) <> 0
                {
                    var name_len: size_t 0
                    let name_ptr LLVMGetValueName2(func, &name_len)
                    if name_ptr <> null
                    {
                        if name_len > 2
                        {
                            var is_scaly_mangled: bool false
                            if (*(name_ptr + 0)) = 95
                            {
                                if (*(name_ptr + 1)) = 90
                                    set is_scaly_mangled: true
                            }
                            ; A dependency-package object provides the real body —
                            ; leave the declaration for the ORC object linker.
                            if is_scaly_mangled
                                if this.jit_symbol_in_set(dep_symbols, name_ptr, name_len)
                                    set is_scaly_mangled: false
                            ; Skip symbols the host process already exports —
                            ; the RBMM runtime + stdlib (Page.allocate, String/
                            ; Vector/StringBuilder bodies, ...) are all defined in
                            ; the scalyc binary (it links libscaly.a). Leaving the
                            ; declaration lets the ORC process-symbol generator
                            ; resolve the REAL function; a null-returning stub here
                            ; would shadow it and break every region allocation.
                            ; Only genuinely-absent symbols (uninstantiated
                            ; generics never reached at runtime) fall through to
                            ; the stub. dlsym gets the un-prefixed C name verbatim.
                            if is_scaly_mangled
                            {
                                if jit_host_handle <> null
                                {
                                    if dlsym(jit_host_handle, name_ptr as pointer[const_char]) <> null
                                        set is_scaly_mangled: false
                                }
                            }
                            if is_scaly_mangled
                            {
                                let saved_block LLVMGetInsertBlock(builder)
                                let block LLVMAppendBasicBlockInContext(context, func, "jitstub")
                                LLVMPositionBuilderAtEnd(builder, block)
                                let func_ty LLVMGlobalGetValueType(func)
                                let ret_ty LLVMGetReturnType(func_ty)
                                if LLVMGetTypeKind(ret_ty) = LLVMTypeKind.Void()
                                    LLVMBuildRetVoid builder
                                if LLVMGetTypeKind(ret_ty) <> LLVMTypeKind.Void()
                                {
                                    let zero LLVMConstNull(ret_ty)
                                    LLVMBuildRet(builder, zero)
                                }
                                if saved_block.handle <> null
                                    LLVMPositionBuilderAtEnd(builder, saved_block)
                            }
                        }
                    }
                }
                set func: LLVMGetNextFunction(func)
            }
        }

        ; Drop the thread-local bit from every global the JIT module DEFINES.
        ;
        ; M2.2 marks every non-`shared` mutable module global thread-local. That
        ; is right for AOT — the static linker hands the definition to dyld/ld.so,
        ; which registers a TLV descriptor. The ORC JIT materializes the module
        ; itself, so a thread-local it defines never gets one: the first access
        ; lands in _tlv_bootstrap_error and abort()s the process with SIGABRT and
        ; no message at all. That killed EVERY --run/--jit program owning a
        ; mutable global — including the compiler's own `--run test`, which dies
        ; in Modeler.test's first build_program on `modeler_error_count`.
        ;
        ; --run/--jit execute the entry point on the calling thread, so a
        ; process-global cell is observationally identical unless the JIT'd
        ; program spawns threads (then the per-thread globals — including the
        ; parfor HotSpot counters — become shared; the fiber/thread suites are
        ; AOT and unaffected). DECLARATIONS keep the bit: those resolve to the
        ; host process's real, dyld-registered TLV via the ORC process generator,
        ; and clearing the bit there would read the descriptor as the value.
        ; AOT emission is untouched — this runs inside jit_run, after emit.
        procedure jit_clear_thread_locals(this)
        {
            var gv LLVMGetFirstGlobal(llvm_module)
            while gv.handle <> null
            {
                if LLVMIsDeclaration(gv) = 0
                    if LLVMIsThreadLocal(gv) <> 0
                        LLVMSetThreadLocal(gv, 0)
                set gv: LLVMGetNextGlobal(gv)
            }
        }

        ; Print an ORC/LLVM error (a non-null LLVMErrorRef) and consume it.
        ; LLVMGetErrorMessage itself consumes the error and yields a C string the
        ; caller must dispose; do NOT also call LLVMConsumeError.
        procedure report_jit_error(this, err: LLVMErrorRef, ctx: pointer[const_char])
        {
            Console.println ctx
            let msg LLVMGetErrorMessage(err)
            if msg <> null
            {
                Console.println(msg as pointer[const_char])
                LLVMDisposeErrorMessage msg
            }
        }

        ; Build the module in the ORC ThreadSafeContext's context, then JIT-execute
        ; the named function and return its i64 result. The whole pipeline (TSC →
        ; emit → LLJIT → lookup → indirect call) lives here so cli just hands off
        ; the plan + target. Returns 127 on any JIT setup failure.
        ;
        ; tsc is created and used entirely within this one function: a
        ; ThreadSafeContext handle passed across a function boundary would hit
        ; the s34 single-ptr-struct param ABI bug (the callee binds the param to
        ; the caller's stack slot, not the handle), giving the ThreadSafeModule a
        ; garbage context whose recursive_mutex traps EINVAL in addIRModule.
        ; dep_object_files: temp object paths for non-host dependency packages,
        ; each AOT-compiled through the known-good root path (see cli.run). They
        ; are added to the JIT's main JITDylib so the program module's extern
        ; declarations of dependency functions link against the real bodies —
        ; replacing the fragile jit_dep_bodies planner path (which mis-planned
        ; large dependency bodies into corrupt plans; both the escape walker and
        ; the emitter crashed on them). dep_object_symbols: the mangled names those
        ; objects define, so emit_jit_stubs leaves them as declarations. Both null
        ; when the program has no non-scaly dependencies (behavior unchanged).
        function jit_run(this, plan: Plan, module_name: String, fn_mangled: String, dep_object_files: pointer[Array[String]], dep_object_symbols: pointer[Array[String]]) returns i64
        {
            let tsc LLVMOrcCreateNewThreadSafeContext()
            let jit_ctx LLVMOrcThreadSafeContextGetContext(tsc)
            set external_context: jit_ctx
            set has_external_context: true

            let ok emit(plan, module_name)
            if ok = false
            {
                Console.println "JIT: emission failed"
                return 127
            }

            ; The JIT needs the host target backend registered (detectHost + codegen).
            ; The -c/-o path inits these in write_object_to_file, which --run bypasses;
            ; the per-target initializers are idempotent. Same set as that path.
            LLVMInitializeAArch64TargetInfo()
            LLVMInitializeAArch64Target()
            LLVMInitializeAArch64TargetMC()
            LLVMInitializeAArch64AsmPrinter()
            LLVMInitializeX86TargetInfo()
            LLVMInitializeX86Target()
            LLVMInitializeX86TargetMC()
            LLVMInitializeX86AsmPrinter()

            ; Stub declared-only Scaly symbols so JIT linking can't fail on them —
            ; except the ones a dependency-package object will supply.
            emit_jit_stubs(dep_object_symbols)

            ; A thread-local the JIT materializes itself has no TLV descriptor.
            jit_clear_thread_locals()

            let valid verify_module()
            if valid = false
            {
                Console.println "JIT: module verification failed"
                return 127
            }

            ; Wrap the module into a ThreadSafeModule (consumes the module).
            ; Bind the field to a local first: an implicit-this field as a
            ; multi-arg call argument is unresolvable here (s185 pattern).
            let jit_module llvm_module
            let tsm LLVMOrcCreateNewThreadSafeModule(jit_module, tsc)

            ; Create the LLJIT with -O0 codegen. The default (null) builder uses
            ; -O2; for fast JIT-test turnaround we build an LLJITBuilder around a
            ; TargetMachine created at opt level None (mirrors stage-0's
            ; setCodeGenOptLevel(None)). Falls back to the default builder if the
            ; host target can't be resolved. Reloc PIC(2), CodeModel default(0),
            ; same as write_object_to_file.
            var jit LLVMOrcLLJITRef(null)
            var jit_builder LLVMOrcLLJITBuilderRef(null)
            let jit_triple LLVMGetDefaultTargetTriple()
            if jit_triple <> null
            {
                var jit_target LLVMTargetRef(null)
                let tlookup LLVMGetTargetFromTriple(jit_triple as pointer[const_char], &jit_target, null as pointer[pointer[char]])
                if tlookup = 0
                {
                    let jit_tm LLVMCreateTargetMachine(jit_target, jit_triple as pointer[const_char], "generic" as pointer[const_char], "" as pointer[const_char], 0, 2, 0)
                    if jit_tm.handle <> null
                    {
                        let jtmb LLVMOrcJITTargetMachineBuilderCreateFromTargetMachine(jit_tm)
                        set jit_builder: LLVMOrcCreateLLJITBuilder()
                        LLVMOrcLLJITBuilderSetJITTargetMachineBuilder(jit_builder, jtmb)
                    }
                }
            }
            let create_err LLVMOrcCreateLLJIT(&jit, jit_builder)
            if create_err.handle <> null
            {
                report_jit_error(create_err, "JIT: could not create LLJIT")
                return 127
            }

            ; Resolve libc symbols (malloc/free/write/exit/...) from the host.
            let jd LLVMOrcLLJITGetMainJITDylib(jit)
            let prefix LLVMOrcLLJITGetGlobalPrefix(jit)
            var gen LLVMOrcDefinitionGeneratorRef(null)
            let gen_err LLVMOrcCreateDynamicLibrarySearchGeneratorForProcess(&gen, prefix, null as pointer[void], null as pointer[void])
            if gen_err.handle <> null
            {
                report_jit_error(gen_err, "JIT: could not create process generator")
                return 127
            }
            LLVMOrcJITDylibAddGenerator(jd, gen)

            ; Add dependency-package objects (AOT-compiled via the root path) to
            ; the JITDylib BEFORE the program module, so the module's extern decls
            ; of dependency functions resolve to the real bodies. Each file is
            ; loaded into a MemoryBuffer that AddObjectFile consumes.
            if dep_object_files <> null
            {
                let objs (*dep_object_files)
                var oi: size_t 0
                while oi < objs.length
                {
                    let op objs.get oi
                    if op <> null
                    {
                        let obj_path (*op)
                        var objbuf LLVMMemoryBufferRef(null)
                        let mb_err LLVMCreateMemoryBufferWithContentsOfFile(obj_path.to_c_string(), &objbuf, null as pointer[pointer[char]])
                        if mb_err <> 0
                        {
                            Console.println "JIT: could not read dependency object"
                            return 127
                        }
                        let obj_err LLVMOrcLLJITAddObjectFile(jit, jd, objbuf)
                        if obj_err.handle <> null
                        {
                            report_jit_error(obj_err, "JIT: could not add dependency object")
                            return 127
                        }
                    }
                    set oi: oi + 1
                }
            }

            ; Add the module to the JIT.
            let add_err LLVMOrcLLJITAddLLVMIRModule(jit, jd, tsm)
            if add_err.handle <> null
            {
                report_jit_error(add_err, "JIT: could not add module")
                return 127
            }

            ; Look up the target function's address (ORC applies the global prefix).
            var addr: u64 0
            let lookup_err LLVMOrcLLJITLookup(jit, &addr, fn_mangled.to_c_string())
            if lookup_err.handle <> null
            {
                report_jit_error(lookup_err, "JIT: symbol lookup failed")
                return 127
            }

            ; Indirect-call the resolved address as i64() (the language feature
            ; added for this: a call on a pointer[void] local lowers to an
            ; indirect LLVMBuildCall2 in emit_call).
            let entry addr as pointer[void]
            let result entry()
            result
        }

        ; ========================================================================
        ; Module Output
        ; ========================================================================

        ; Print module IR to string (for debugging)
        function print_module_to_string(this) returns pointer[char]
        {
            LLVMPrintModuleToString llvm_module
        }

        ; Write module IR to file
        ; ★★★The IR is written through OUR file API, not LLVM's, and the reason is
        ; ONE BYTE PER LINE. `LLVMPrintModuleToFile` opens its output in the HOST's
        ; text mode, so on Windows every `\n` leaves as `\r\n`: the same compiler,
        ; from the same sources, wrote a 38-line `main.ll` as 734 bytes on POSIX and
        ; 772 there. **The seed is an artifact this project compares BYTE for byte,
        ; so its line endings may not be a property of the machine that emitted
        ; it.** `File.write_from_string` opens `"wb"` on every target.
        ;
        ; ★Found only because a SECOND host emitted the seed (stage 7, rung 11) —
        ; one host can never see this, and reading our own File API said the
        ; opposite, because `-S` never went through it. A claim about bytes needs a
        ; second producer, not a closer read.
        ;
        ; The extra copy (print-to-string, then write) is what it costs: ~18 MB for
        ; the compiler's own module, against a build that already works in
        ; hundreds. `-c` is untouched — an object file has no line endings.
        function write_module_to_file(this, filename: String) returns bool
        {
            let ir LLVMPrintModuleToString(llvm_module)
            if ir = null
                return false
            let text String(ir as pointer[const_char])
            let ok File.write_from_string(filename, text)
            LLVMDisposeMessage(ir)
            ok
        }

        ; Write bitcode to file
        function write_bitcode_to_file(this, filename: String) returns bool
        {
            let c_name filename.to_c_string()
            let result LLVMWriteBitcodeToFile(llvm_module, c_name)
            result = 0
        }

        ; Write native object file via host target machine.
        ; LLVMObjectFile codegen type = 1. Reloc=PIC(2), OptLevel=None(0).
        function write_object_to_file(this, filename: String) returns bool
        {
            ; Initialize both AArch64 and X86 backends so stage-1 runs on arm64
            ; macOS and x86_64 Linux. LLVMInitializeNativeTarget is a static-inline
            ; helper in llvm-c/Target.h (not a real symbol), so we call the
            ; per-target symbols directly.
            LLVMInitializeAArch64TargetInfo()
            LLVMInitializeAArch64Target()
            LLVMInitializeAArch64TargetMC()
            LLVMInitializeAArch64AsmPrinter()
            LLVMInitializeX86TargetInfo()
            LLVMInitializeX86Target()
            LLVMInitializeX86TargetMC()
            LLVMInitializeX86AsmPrinter()

            ; --target <triple>: when config.target_triple is set, cross-emit for
            ; that triple instead of the host default. The AArch64 + X86 backends
            ; above are both initialized, so any LP64 "fabulous four" target
            ; (arm64/x86_64, darwin/linux) works; the IR is target-neutral (no
            ; datalayout line, LP64 sizes baked in), so llc/TargetMachine retargets
            ; it cleanly.
            var triple (LLVMGetDefaultTargetTriple() as pointer[const_char])
            if config.target_triple.get_length() > 0
            {
                let override_triple config.target_triple.to_c_string()
                set triple: override_triple
            }
            else
            {
                if triple = null
                    return false
            }

            LLVMSetTarget(llvm_module, triple)

            var target LLVMTargetRef(null)
            let lookup_err LLVMGetTargetFromTriple(triple, &target, null as pointer[pointer[char]])
            if lookup_err <> 0
                return false

            ; -O<n> (5.1): codegen at the requested level and run the new-PM
            ; default<On> pipeline in-process before emission. The default
            ; stays None — without the flag the output is byte-identical.
            var tm_level 0
            if config.opt_level > 0
                set tm_level: config.opt_level
            if tm_level > 3
                set tm_level: 3
            let tm LLVMCreateTargetMachine(target, triple,
                "generic" as pointer[const_char],
                "" as pointer[const_char],
                tm_level, 2, 0)
            if tm.handle = null
                return false

            if config.opt_level > 0
            {
                ; The module carries the TM's datalayout (apply_target_layout)
                ; — required: DL-dependent sizeof-GEPs miscompile under opt
                ; without it.
                let pb_opts LLVMCreatePassBuilderOptions()
                var pipeline ("default<O1>" as pointer[const_char])
                if config.opt_level = 2
                    set pipeline: ("default<O2>" as pointer[const_char])
                if config.opt_level >= 3
                    set pipeline: ("default<O3>" as pointer[const_char])
                let opt_err LLVMRunPasses(llvm_module, pipeline, tm, pb_opts)
                LLVMDisposePassBuilderOptions pb_opts
                if opt_err.handle <> null
                {
                    LLVMDisposeTargetMachine tm
                    return false
                }
            }

            ; s175: to_c_string#, not c_data() — c_data() points into the
            ; varint-prefixed buffer with NO null terminator (s28 rule).
            ; Exercised for the first time when stage-2 -o reached the
            ; object-writing path.
            let c_filename filename.to_c_string()
            let emit_err LLVMTargetMachineEmitToFile(tm, llvm_module, c_filename, 1,
                null as pointer[pointer[char]])
            LLVMDisposeTargetMachine tm

            emit_err = 0
        }

        ; Verify module
        function verify_module(this) returns bool
        {
            let result LLVMVerifyModule(llvm_module, 0, null as pointer[pointer[char]])
            result = 0
        }

        ; ========================================================================
        ; Expression Emission
        ; ========================================================================

        ; Emit a sequence of operands (typically collapsed to single operand)
        function emit_operands(this, ops: ref[Vector[PlannedOperand]]?) returns LLVMValueRef
        {
            if ops = null
                return LLVMValueRef null

            if ops.length = 0
                return LLVMValueRef null

            ; After collapseOperandSequence, we typically have a single collapsed operand
            let first ops.get 0
            if first = null
                return LLVMValueRef null

            emit_operand(first.unwrap())
        }

        ; Emit a single operand
        function emit_operand(this, op: PlannedOperand) returns LLVMValueRef
        {
            var value LLVMValueRef(null)

            ; Emit the expression
            choose op.expr
                when c: Constant
                    set value: emit_constant(c, op.result_type)
                else
                    set value: emit_expression(op.expr)

            ; Apply member access chain if present
            if op.member_access <> null
            {
                let chain_ref op.member_access.unwrap()
                let chain (*chain_ref)
                if chain.length > 0
                    set value: emit_member_access_chain(value, chain, op.result_type)

            }

            value
        }

        ; Emit member access chain (e.g., person.address.city)
        function emit_member_access_chain(this, base_value: LLVMValueRef, chain: Vector[PlannedMemberAccess], result_type: PlannedType) returns LLVMValueRef
        {
            ; s34 root fix: plain copy of the by-ptr struct param (emitBinding
            ; now copies single-ptr-field struct params into a struct slot).
            var current_value base_value

            if current_value.handle = null
                return LLVMValueRef null

            ; Defensive: LLVMTypeOf can return null when current_value.handle
            ; is non-null but isn't a real LLVMValue (stale/invalid pointer).
            ; Bail out cleanly instead of dereferencing null in LLVMGetTypeKind.
            let cv_type LLVMTypeOf(current_value)
            if cv_type.handle = null
                return LLVMValueRef null

            ; If base value is a pointer, we may need to load the struct
            if LLVMGetTypeKind(cv_type) = LLVMTypeKind.Pointer()
            {
                ; Get the first member's parent type to know what to load
                let first chain.get 0
                if first <> null
                {
                    let parent_type first.parent_type
                    var struct_type map_type parent_type
                    ; s137: Defensive sized-type check. map_type may return an
                    ; opaque named struct (cached via LLVMStructCreateNamed
                    ; before setBody) or fall through to the opaque-ptr
                    ; fallback for unmaterialised stdlib generics like
                    ; Vector[T] / HashMap[K,V] when their methods are now
                    ; dispatched (Vector removed from Planner.scaly skip_dispatch).
                    ; LLVMBuildLoad2 on an unsized type triggers a brk in
                    ; libLLVM's DataLayout::getTypeSizeInBits with no stderr.
                    ; Mirror the s121 fallback below: try
                    ; synthesize_literal_struct for known shapes, else bail.
                    ;
                    ; Stage-7.0-spike fix: the load gate must demand a STRUCT,
                    ; not merely a sized type — map_type's opaque-ptr fallback
                    ; is `ptr`, which IS sized, so the old gate emitted a stray
                    ; `load ptr` here (reading FIELD 0 as if it were the struct
                    ; base) and every later hop dereferenced the wrong address.
                    ; Non-struct → try the literal-shape fallback; still no
                    ; struct → leave current_value untouched (the hop loop's
                    ; deref path reports or bails from the ORIGINAL base).
                    var top_is_struct: bool false
                    if struct_type.handle <> null
                    {
                        if LLVMGetTypeKind(struct_type) = LLVMTypeKind.Struct()
                            set top_is_struct: true
                    }
                    if top_is_struct = false
                        set struct_type: synthesize_literal_struct(parent_type.name)
                    if struct_type.handle <> null
                    {
                        if LLVMGetTypeKind(struct_type) = LLVMTypeKind.Struct()
                        {
                            if LLVMTypeIsSized(struct_type) <> 0
                                set current_value: LLVMBuildLoad2(builder, struct_type, current_value, "load.struct")
                        }
                    }
                }
            }

            ; Iterate through each member access in the chain
            var i: size_t 0
            while i < chain.length
            {
                let access_ptr chain.get i
                if access_ptr <> null
                {
                    let access access_ptr.unwrap()

                    ; A non-method, non-variant hop with a VOID result is
                    ; resolve_member_access#'s unresolved placeholder (member not
                    ; found). The lenient extractvalue-at-field-0 path below is a
                    ; RECOVERY the compiler relies on when the PLANNER couldn't
                    ; resolve the base type (empty parent name): the emitter falls
                    ; back to the actual LLVM value type + field 0, correct when
                    ; the intended member IS field 0 (e.g. `.name`). But when the
                    ; base is a CONCRETE, resolved struct (non-empty name mapping
                    ; to a sized struct) and the member still isn't found, field 0
                    ; is the WRONG field — a typo'd `x.method()` silently returns
                    ; the first field. That is a certain silent miscompile: fail
                    ; HARD+LOUD (same discipline as the unknown-operator trap).
                    ; Speculative mis-typed lookups recover in the planner and
                    ; never carry the placeholder into the emitted plan; the LSP
                    ; never runs the Emitter, so it is unaffected.
                    if access.is_method = false
                        if access.is_union_value = false
                            if access.result_type.name = "void"
                                if access.parent_type.name.get_length() > 0
                                {
                                    let mac_pty map_type access.parent_type
                                    var mac_concrete: bool false
                                    if mac_pty.handle <> null
                                        if LLVMGetTypeKind(mac_pty) = LLVMTypeKind.Struct()
                                            if LLVMTypeIsSized(mac_pty) <> 0
                                                set mac_concrete: true
                                    if mac_concrete
                                    {
                                        scaly_eputs "Emitter: member not found: "
                                        let mac_parent access.parent_type.name.to_c_string()
                                        scaly_eputs mac_parent
                                        scaly_eputs "."
                                        let mac_name access.name.to_c_string()
                                        scaly_eputs mac_name
                                        scaly_eputs "\n"
                                        exit 16
                                    }
                                }

                    ; Handle union .value extraction specially
                    if access.is_union_value
                    {
                        ; Union layout is { i8 tag, [size x i8] data }
                        ; Store to alloca, GEP to field 1, bitcast, and load
                        let union_type map_type access.parent_type
                        let result_ty map_type access.result_type

                        ; Store the union value to an alloca
                        let union_ptr entry_alloca(union_type, "union.tmp")
                        LLVMBuildStore(builder, current_value, union_ptr)

                        ; GEP to field 1 (the data field)
                        let data_ptr LLVMBuildStructGEP2(builder, union_type, union_ptr, 1, "union.data.ptr")

                        ; Load the value (assuming pointer result type for now)
                        set current_value: LLVMBuildLoad2(builder, result_ty, data_ptr, "union.value")
                    }
                    else
                    {
                        var cur_kind LLVMGetTypeKind(LLVMTypeOf current_value)

                        ; s121: deref-load when current_value is a pointer
                        ; to a struct. Happens when a previous chain step
                        ; extracted a field whose stage-1 IR layout is `ptr`
                        ; (heap-stored struct field like
                        ; `scope_bindings: Array[...]^this()` or a
                        ; `ref[T]?` value). Get the struct layout from
                        ; access.parent_type via map_type, with a
                        ; synthesize_literal_struct fallback for known
                        ; stdlib generics (Vector / Array / HashMap / List)
                        ; that map_type can't resolve. Load through, then
                        ; the existing extractvalue path runs against a
                        ; real struct value. Pre-s121 this branch bailed
                        ; to LLVMValueRef(null), which left Planner.push_scope
                        ; (and other Planner methods touching
                        ; `this.scope_bindings.length` etc.) with empty
                        ; bodies after the s120 in-place chain bail.
                        if cur_kind = LLVMTypeKind.Pointer()
                        {
                            ; s155: when the parent hop's type is itself a
                            ; pointer[T]/ref[T] (a pointer-typed intermediate
                            ; field like Array.add's `vector.data`, where the
                            ; chain extracted `vector: pointer[Inner]` and now
                            ; resolves `.data` through it), current_value is the
                            ; pointer and the struct to load is the pointee T.
                            ; map_type(pointer[Inner]) returns `ptr`, not the
                            ; Inner struct — unwrap to the inner generic first.
                            ; Otherwise (s121 heap-stored struct field) the
                            ; parent_type is already the struct, use it directly.
                            var deref_parent access.parent_type
                            if access.parent_type.name = "pointer"
                            {
                                if access.parent_type.generics <> null
                                {
                                    let dpg (*access.parent_type.generics)
                                    if dpg.length > 0
                                    {
                                        let dip dpg.get 0
                                        if dip <> null
                                            set deref_parent: (*dip)
                                    }
                                }
                            }
                            if access.parent_type.name = "ref"
                            {
                                if access.parent_type.generics <> null
                                {
                                    let dpg (*access.parent_type.generics)
                                    if dpg.length > 0
                                    {
                                        let dip dpg.get 0
                                        if dip <> null
                                            set deref_parent: (*dip)
                                    }
                                }
                            }
                            var deref_struct_ty map_type deref_parent
                            if LLVMGetTypeKind(deref_struct_ty) <> LLVMTypeKind.Struct()
                                set deref_struct_ty: synthesize_literal_struct(deref_parent.name)
                            var deref_ok: bool true
                            if deref_struct_ty.handle = null
                                set deref_ok: false
                            if deref_ok
                            {
                                if LLVMGetTypeKind(deref_struct_ty) <> LLVMTypeKind.Struct()
                                    set deref_ok: false
                            }
                            if deref_ok = false
                            {
                                ; A FIELD hop the planner resolved (named parent,
                                ; real result type) whose parent layout the
                                ; emitter cannot obtain used to bail to null here
                                ; — dropping every dependent statement SILENTLY
                                ; (the stage-7.0 spike class: pointer[Page] field
                                ; reads in user programs). Fail loud like the
                                ; member-not-found trap. Method hops and
                                ; unresolved-base recoveries (empty parent name)
                                ; keep the lenient bail.
                                if access.is_method = false
                                    if access.is_union_value = false
                                        if access.result_type.name <> "void"
                                            if deref_parent.name.get_length() > 0
                                            {
                                                scaly_eputs "Emitter: no layout for field access: "
                                                let lless_parent deref_parent.name.to_c_string()
                                                scaly_eputs lless_parent
                                                scaly_eputs "."
                                                let lless_name access.name.to_c_string()
                                                scaly_eputs lless_name
                                                scaly_eputs "\n"
                                                exit 16
                                            }
                                return LLVMValueRef null
                            }
                            set current_value: LLVMBuildLoad2(builder, deref_struct_ty, current_value, "deref")
                            set cur_kind: LLVMGetTypeKind(LLVMTypeOf current_value)
                        }

                        ; Defensive: extractvalue requires a non-null
                        ; aggregate with a real type. If the chain step
                        ; produced null (no map_type, missing parent), bail
                        ; out instead of crashing inside
                        ; LLVMBuildExtractValue → setName.
                        if current_value.handle = null
                            return LLVMValueRef null

                        ; Bail on non-aggregate (Int, Float, Function, etc.) —
                        ; LLVMBuildExtractValue requires Struct or Array.
                        ; getIndexedType returns null on a non-aggregate, EVI's
                        ; result type ends up null, then setName SEGVs reading
                        ; getContext() through the null type. Mirrors stage-0's
                        ; ValTy->isAggregateType() if at Emitter.cpp:3065.
                        ; Nested form to avoid `and` precedence ambiguity:
                        ; outer if fires when cur_kind isn't Struct, then
                        ; the inner if bails iff it isn't Array either.
                        if cur_kind <> LLVMTypeKind.Struct()
                        {
                            if cur_kind <> LLVMTypeKind.ArrayKind()
                                return LLVMValueRef null
                        }

                        ; Use extractvalue for struct field access. Name
                        ; uses to_c_string# (null-terminated heap copy)
                        ; instead of c_data() — c_data() points into the
                        ; varint-prefixed buffer and has no null terminator
                        ; (load-bearing rule: any C API expecting a
                        ; null-terminated string needs to_c_string#).
                        let name_cstr access.name.to_c_string()
                        set current_value: LLVMBuildExtractValue(builder, current_value, access.field_index as u32, name_cstr)
                    }
                }
                set i: i + 1
            }

            current_value
        }

        ; Emit an expression
        function emit_expression(this, expr: PlannedExpression) returns LLVMValueRef
        {
            choose expr
                when c: Constant
                {
                    ; Use void type as placeholder when no type info available
                    let void_type PlannedType(
                        Span(0, 0),
                        "void",
                        "v",
                        null,
                        Lifetime.Unspecified(Unspecified()),
                        null,
                        "",
                        null
                    )
                    return emit_constant(c, void_type)
                }
                when t: Type
                {
                    ; Type used as expression - error
                    return LLVMValueRef null
                }
                when v: Variable
                {
                    return emit_variable v
                }
                when g: GlobalRef
                {
                    return emit_global_ref g
                }
                when c: Call
                {
                    return emit_call c
                }
                when t: Tuple
                {
                    return emit_tuple t
                }
                when m: Matrix
                {
                    return emit_matrix m
                }
                when b: Block
                {
                    return emit_block b
                }
                when i: If
                {
                    return emit_if i
                }
                when m: Match
                {
                    return emit_match m
                }
                when c: Choose
                {
                    return emit_choose c
                }
                when f: For
                {
                    return emit_for f
                }
                when w: While
                {
                    return emit_while w
                }
                when r: Repeat
                {
                    return emit_repeat r
                }
                when t: Try
                {
                    return emit_try t
                }
                when s: SizeOf
                {
                    return emit_sizeof s
                }
                when a: AlignOf
                {
                    return emit_alignof a
                }
                when i: Is
                {
                    return emit_is i
                }
                when a: As
                {
                    return emit_as a
                }
                when vc: VariantConstruction
                {
                    return emit_variant_construction vc
                }
                when fr: FunctionRef
                {
                    return emit_function_ref fr
                }
                when clo: Closure
                {
                    return emit_closure clo
                }
                when bx: Box
                {
                    return emit_box bx
                }
        }

        ; Emit a function-reference value (GAP B): the address of the named symbol,
        ; usable as an LLVM ptr (a delegate value). The symbol is a monomorphized
        ; lambda (or an ordinary function) already emitted into the module; declare
        ; it as an external if it is not yet present.
        function emit_function_ref(this, fref: PlannedFunctionRef) returns LLVMValueRef
        {
            var func LLVMGetNamedFunction(llvm_module, fref.mangled_name.c_data())
            if func.handle = null
            {
                ; Not yet emitted in this module — declare a varargs stub; the real
                ; definition (or a cross-unit symbol) resolves at link time. Only
                ; its address is taken here, so the cosmetic signature is harmless.
                let i8ptr LLVMPointerTypeInContext(context, 0)
                let stub_ty LLVMFunctionType(i8ptr, null as pointer[LLVMTypeRef], 0, 1)
                set func: LLVMAddFunction(llvm_module, fref.mangled_name.c_data(), stub_ty)
                LLVMSetLinkage(func, LLVMLinkage.External())
            }
            func
        }

        ; GAP B substep 2: lower a closure value to a heap record
        ; `{ ptr thunk, capture0, capture1, ... }` and return the record pointer.
        ; The record's field 0 is the bridge thunk; the indirect call loads it and
        ; calls `thunk(record, args...)`. Captures are stored at fields 1.. in order.
        function emit_closure(this, clo: PlannedClosure) returns LLVMValueRef
        {
            let ptr_ty LLVMPointerTypeInContext(context, 0)

            var cap_count: size_t 0
            if clo.capture_types <> null
                set cap_count: (*clo.capture_types).length
            let n_fields cap_count + 1

            ; Closure record struct type { ptr thunk, caps... }.
            var clo_ty lookup_struct_cache clo.closure_type_name
            if clo_ty.handle = null
            {
                var field_tys Vector[LLVMTypeRef](n_fields)
                field_tys.put(0, ptr_ty)
                var fi: size_t 0
                while fi < cap_count
                {
                    let ct_ptr (*clo.capture_types).get fi
                    if ct_ptr <> null
                        field_tys.put(fi + 1, map_type((*ct_ptr)))
                    set fi: fi + 1
                }
                set clo_ty: LLVMStructCreateNamed(context, clo.closure_type_name.c_data())
                LLVMStructSetBody(clo_ty, field_tys.data, n_fields as u32, 0)
                cache_struct(clo.closure_type_name, clo_ty)
            }

            ; Generate the bridge thunk once. s34 root fix: pass the closure
            ; struct type directly (emitBinding now copies single-ptr-field struct
            ; params correctly, so the old cache re-lookup-by-name is unneeded).
            var thunk_fn LLVMGetNamedFunction(llvm_module, clo.thunk_name.c_data())
            if thunk_fn.handle = null
                set thunk_fn: emit_closure_thunk(clo, clo_ty)

            ; Allocate the closure record. A non-escaping closure (Lifetime.Local)
            ; lives on the stack frame (freed at return, no runtime dependency); an
            ; escaping closure (Lifetime.Call / `#`) is heap-allocated on the
            ; caller's page so it outlives this frame.
            var on_caller: bool false
            choose clo.life
                when c: Lifetime.Call
                    set on_caller: true
                else
                    0
            var record LLVMValueRef(null)
            if on_caller = false
                set record: entry_alloca(clo_ty, "closure")
            if on_caller
            {
                var page_arg resolve_closure_page(clo.life)
                if page_arg.handle = null
                    return LLVMValueRef null
                var alloc_func lookup_function_cache("_ZN4Page8allocateEmm")
                if alloc_func.handle = null
                    set alloc_func: LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
                if alloc_func.handle = null
                {
                    var apt Vector[LLVMTypeRef](3)
                    apt.put(0, ptr_ty)
                    apt.put(1, LLVMInt64TypeInContext context)
                    apt.put(2, LLVMInt64TypeInContext context)
                    let adt LLVMFunctionType(ptr_ty, apt.data, 3, 0)
                    set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", adt)
                    LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                    cache_function("_ZN4Page8allocateEmm", alloc_func)
                }
                let size_const LLVMSizeOf(clo_ty)
                let align_const LLVMAlignOf(clo_ty)
                var alloc_args Vector[LLVMValueRef](3)
                alloc_args.put(0, page_arg)
                alloc_args.put(1, size_const)
                alloc_args.put(2, align_const)
                var apt2 Vector[LLVMTypeRef](3)
                apt2.put(0, ptr_ty)
                apt2.put(1, LLVMInt64TypeInContext context)
                apt2.put(2, LLVMInt64TypeInContext context)
                let act LLVMFunctionType(ptr_ty, apt2.data, 3, 0)
                set record: LLVMBuildCall2(builder, act, alloc_func, alloc_args.data, 3, "closure")
            }
            if record.handle = null
                return LLVMValueRef null

            ; Store the thunk pointer at field 0.
            let f0 LLVMBuildStructGEP2(builder, clo_ty, record, 0, "clo.fn")
            LLVMBuildStore(builder, thunk_fn, f0)

            ; Store the captured values at fields 1...
            var ci: size_t 0
            while ci < cap_count
            {
                if clo.captures <> null
                {
                    let cap_ptr (*clo.captures).get ci
                    if cap_ptr <> null
                    {
                        let cap_val emit_operand((*cap_ptr))
                        let cf LLVMBuildStructGEP2(builder, clo_ty, record, (ci + 1) as u32, "clo.cap")
                        LLVMBuildStore(builder, cap_val, cf)
                    }
                }
                set ci: ci + 1
            }
            record
        }

        ; Resolve the page a closure record is allocated on from its lifetime:
        ; Local → this function's local region; Call (`#`) → caller's `rp`.
        function resolve_closure_page(this, life: scaly.compiler.Model.Lifetime) returns LLVMValueRef
        {
            var on_caller: bool false
            choose life
                when c: Lifetime.Call
                    set on_caller: true
                else
                    0
            if on_caller
            {
                let rp_val lookup_variable("_rp")
                if rp_val.handle <> null
                    return force_frame(rp_val)
            }
            get_or_create_local_page()
        }

        ; Generate the closure bridge thunk `R thunk(ptr self, params...)`: load the
        ; captures from `self` (fields 1..) and call the real monomorphized lambda
        ; `real(captures..., params...)`. Mirrors a hand-written trampoline; emitted
        ; as direct IR (no body planning) with the builder saved/restored.
        function emit_closure_thunk(this, clo: PlannedClosure, clo_ty_param: LLVMTypeRef) returns LLVMValueRef
        {
            ; s34 root fix: bind the by-ptr struct param to a local var (emitBinding
            ; copies single-ptr-field struct params into a struct slot) so later
            ; extern LLVM calls receive a real LLVMTypeRef handle. Passing the bare
            ; by-ptr param straight to an extern call is NOT covered by the fix.
            var clo_ty clo_ty_param
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let ret_ty map_type(clo.return_type)

            var pcount: size_t 0
            if clo.param_types <> null
                set pcount: (*clo.param_types).length
            var cap_count: size_t 0
            if clo.capture_types <> null
                set cap_count: (*clo.capture_types).length

            ; Thunk signature: R(ptr self, params...).
            let n_tp pcount + 1
            var tptys Vector[LLVMTypeRef](n_tp)
            tptys.put(0, ptr_ty)
            var pi: size_t 0
            while pi < pcount
            {
                let pt_ptr (*clo.param_types).get pi
                if pt_ptr <> null
                    tptys.put(pi + 1, map_type((*pt_ptr)))
                set pi: pi + 1
            }
            let thunk_ty LLVMFunctionType(ret_ty, tptys.data, n_tp as u32, 0)
            let thunk LLVMAddFunction(llvm_module, clo.thunk_name.c_data(), thunk_ty)
            set_linkonce_odr(thunk)

            let saved_block LLVMGetInsertBlock(builder)
            let entry LLVMAppendBasicBlockInContext(context, thunk, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)

            let self_param LLVMGetParam(thunk, 0)

            ; Real signature: R(captures..., params...).
            let n_real cap_count + pcount
            var real_args Vector[LLVMValueRef](n_real)
            var real_tys Vector[LLVMTypeRef](n_real)
            var k: size_t 0
            while k < cap_count
            {
                let ct_ptr (*clo.capture_types).get k
                var ct ptr_ty
                if ct_ptr <> null
                    set ct: map_type((*ct_ptr))
                let gep LLVMBuildStructGEP2(builder, clo_ty, self_param, (k + 1) as u32, "cap")
                let cv LLVMBuildLoad2(builder, ct, gep, "cap")
                real_args.put(k, cv)
                real_tys.put(k, ct)
                set k: k + 1
            }
            var j: size_t 0
            while j < pcount
            {
                let pv LLVMGetParam(thunk, (j + 1) as u32)
                var pt ptr_ty
                let pt_ptr (*clo.param_types).get j
                if pt_ptr <> null
                    set pt: map_type((*pt_ptr))
                real_args.put(cap_count + j, pv)
                real_tys.put(cap_count + j, pt)
                set j: j + 1
            }
            let real_ty LLVMFunctionType(ret_ty, real_tys.data, n_real as u32, 0)
            var real_fn LLVMGetNamedFunction(llvm_module, clo.real_name.c_data())
            if real_fn.handle = null
            {
                set real_fn: LLVMAddFunction(llvm_module, clo.real_name.c_data(), real_ty)
                LLVMSetLinkage(real_fn, LLVMLinkage.External())
            }
            let result LLVMBuildCall2(builder, real_ty, real_fn, real_args.data, n_real as u32, "")
            if clo.return_type.name = "void"
                LLVMBuildRetVoid builder
            else
                LLVMBuildRet(builder, result)

            LLVMPositionBuilderAtEnd(builder, saved_block)
            thunk
        }

        ; ========================================================================
        ; Variable and Global Reference Emission
        ; ========================================================================

        ; Emit a variable reference
        function emit_variable(this, variable: PlannedVariable) returns LLVMValueRef
        {
            let var_ptr lookup_variable variable.name
            if var_ptr.handle = null
                return LLVMValueRef null

            ; s124: when variable.is_mutable but the looked-up value isn't a
            ; pointer, treat it as immutable. Stage-1's flat variable table
            ; doesn't scope per choose/if arm; sibling arms reusing the same
            ; Scaly variable name (e.g. emit_constant's Boolean arm's
            ; `let llvm_type LLVMInt1TypeInContext(...)` vs the Integer arm's
            ; `var llvm_type ...`) cause forward lookup to return the
            ; earlier let-binding's value-type LLVMValueRef instead of the
            ; later var-binding's alloca pointer. Loading from that
            ; value-type via LLVMBuildLoad2 emits invalid
            ; `load T, T %val` which llc rejects with "load operand must be
            ; a pointer to a first class type". Stage-0 has proper scoping;
            ; we fall back to returning the value as-is here.
            let var_ptr_ty LLVMTypeOf(var_ptr)
            if var_ptr_ty.handle <> null
            {
                if LLVMGetTypeKind(var_ptr_ty) <> LLVMTypeKind.Pointer()
                    return var_ptr
            }

            if variable.is_mutable
            {
                ; Mutable binding stored as pointer — load the value.
                ; For primitive types (int/size_t/i32/u8/etc.), prefer
                ; map_intrinsic_type_by_name over map_type. The Vector-
                ; keyed map_intrinsic_type sees `String()`-allocated
                ; intrinsic_type_names entries whose `data` field
                ; dangles once init_intrinsic_types' page gets reused;
                ; once that happens `name.equals(...)` mis-fires and
                ; map_type falls through to the LLVMPointerTypeInContext
                ; fallback (line 590), so emit_variable issues
                ; `load ptr, ptr %i, align 8` against an `alloca i32`
                ; slot — observed in containers.test_array / test_list
                ; under stage-1 self-build. The by_name lookup is a
                ; stable hard-coded primitive table; for non-primitives
                ; it returns null and we fall back to map_type to keep
                ; struct / pointer / ref handling intact.
                var ty map_intrinsic_type_by_name variable.variable_type.name
                if ty.handle = null
                    set ty: map_type(variable.variable_type)
                ; s178: an UNSIZED mapped type — void (planner fresh-type-
                ; var fallback), function, or an opaque struct (cross-
                ; package placeholder) — cannot be loaded: DataLayout::
                ; getTypeSizeInBits asserts (rc=133/SIGTRAP). The alloca's
                ; allocated type is the slot's ground truth; prefer it
                ; when sized, else hand back the pointer unloaded.
                var ty_unsized: bool false
                let ty_kind LLVMGetTypeKind(ty)
                if ty_kind = LLVMTypeKind.Void()
                    set ty_unsized: true
                if ty_kind = LLVMTypeKind.FunctionKind()
                    set ty_unsized: true
                if ty_kind = LLVMTypeKind.Struct()
                {
                    if LLVMCountStructElementTypes(ty) = 0
                        set ty_unsized: true
                }
                if ty_unsized
                {
                    let opq_isa LLVMIsAAllocaInst(var_ptr)
                    if opq_isa.handle = null
                        return var_ptr
                    let opq_alloc_ty LLVMGetAllocatedType(var_ptr)
                    if opq_alloc_ty.handle = null
                        return var_ptr
                    var opq_sized: bool true
                    let opq_kind LLVMGetTypeKind(opq_alloc_ty)
                    if opq_kind = LLVMTypeKind.Void()
                        set opq_sized: false
                    if opq_kind = LLVMTypeKind.FunctionKind()
                        set opq_sized: false
                    if opq_kind = LLVMTypeKind.Struct()
                    {
                        if LLVMCountStructElementTypes(opq_alloc_ty) = 0
                            set opq_sized: false
                    }
                    if opq_sized = false
                        return var_ptr
                    return LLVMBuildLoad2(builder, opq_alloc_ty, var_ptr, variable.name.c_data())
                }
                ; s87: when the alloca's allocated type is `ptr` but the
                ; mapped variable type is a struct, the binding stored a
                ; heap pointer from a region-allocated ctor (Options(),
                ; T(), T^name(...)). Loading the struct from an 8-byte
                ; ptr slot would read past the alloca and pick up stack
                ; garbage. Mirror stage-0 (Emitter.cpp:3155-3161): load
                ; as ptr to retrieve the heap pointer. Downstream
                ; consumers (emit_return, member access chain) already
                ; handle ptr-to-struct via load/auto-deref. Scaly's
                ; `if cond STMT` runs STMT when cond is TRUE, so each
                ; if below short-circuits to the regular load when
                ; the alloca-of-ptr / mapped-struct condition isn't met.
                if LLVMGetTypeKind(ty) <> LLVMTypeKind.Struct()
                    return LLVMBuildLoad2(builder, ty, var_ptr, variable.name.c_data())
                let is_alloca LLVMIsAAllocaInst(var_ptr)
                if is_alloca.handle = null
                    return LLVMBuildLoad2(builder, ty, var_ptr, variable.name.c_data())
                let alloc_ty LLVMGetAllocatedType(var_ptr)
                if alloc_ty.handle = null
                    return LLVMBuildLoad2(builder, ty, var_ptr, variable.name.c_data())
                if LLVMGetTypeKind(alloc_ty) <> LLVMTypeKind.Pointer()
                    return LLVMBuildLoad2(builder, ty, var_ptr, variable.name.c_data())
                return LLVMBuildLoad2(builder, alloc_ty, var_ptr, variable.name.c_data())
            }
            else
            {
                ; Immutable binding stored as value directly
                return var_ptr
            }
        }

        ; Emit a const ARRAY global: `define X: T[] [a, b, ...]`.
        ; plan_global decays the global's type to pointer[T] with
        ; array_size = element count; here it becomes
        ; @X = constant [N x T] [a, b, ...] (emit_global_ref GEPs to the
        ; first element on reads). Returns false when the global is not an
        ; array (array_size empty) or any element is not an integer/hex
        ; constant — the caller falls through to the scalar path. Mirrors
        ; stage-0 Emitter.cpp:1115-1204.
        function emit_array_global(this, global: PlannedGlobal) returns bool
        {
            if global.is_mutable
                return false
            let count parse_array_size(global.global_type.array_size)
            if count = 0
                return false
            if global.global_type.generics = null
                return false
            let gens (*global.global_type.generics)
            if gens.length = 0
                return false
            let elem_ptr gens.get 0
            if elem_ptr = null
                return false
            let elem_planned (*elem_ptr)
            var elem_ty map_intrinsic_type_by_name elem_planned.name
            if elem_ty.handle = null
                set elem_ty: map_type(elem_planned)
            if elem_ty.handle = null
                return false

            ; Collect the element constants from the single PlannedMatrix
            ; value (N rows x 1 column or 1 row x N columns — same shapes
            ; global_array_count counted).
            if global.value = null
                return false
            let vals (*global.value)
            if vals.length <> 1
                return false
            let v0_ptr vals.get 0
            if v0_ptr = null
                return false
            let v0 (*v0_ptr)
            var elems Vector[LLVMValueRef](count)
            var filled: size_t 0
            choose v0.expr
                when mx: PlannedMatrix
                {
                    if mx.operations <> null
                    {
                        let rows (*mx.operations)
                        var ri: size_t 0
                        while ri < rows.length
                        {
                            let row_ptr rows.get ri
                            if row_ptr <> null
                            {
                                let row (*row_ptr)
                                var ci: size_t 0
                                while ci < row.length
                                {
                                    let cell_ptr row.get ci
                                    if cell_ptr <> null
                                    {
                                        let cell (*cell_ptr)
                                        choose cell.expr
                                            when c: PlannedConstant
                                            {
                                                choose c.value
                                                    when i: Integer
                                                    {
                                                        if filled < count
                                                        {
                                                            elems.put(filled, LLVMConstInt(elem_ty, i.value, 0))
                                                            set filled: filled + 1
                                                        }
                                                    }
                                                    when h: Hex
                                                    {
                                                        if filled < count
                                                        {
                                                            elems.put(filled, LLVMConstInt(elem_ty, h.value, 0))
                                                            set filled: filled + 1
                                                        }
                                                    }
                                                    else
                                                        0
                                            }
                                            else
                                                0
                                    }
                                    set ci: ci + 1
                                }
                            }
                            set ri: ri + 1
                        }
                    }
                }
                else
                    0
            if filled <> count
                return false

            let arr_ty LLVMArrayType2(elem_ty, count)
            let gv LLVMAddGlobal(llvm_module, arr_ty, global.mangled_name.c_data())
            let arr_init LLVMConstArray2(elem_ty, elems.data, count)
            LLVMSetInitializer(gv, arr_init)
            LLVMSetGlobalConstant(gv, 1)
            set_module_constant_linkage gv
            true
        }

        ; A module-level `define NAME: T VALUE` is not part of a package's ABI:
        ; the name is unreachable from any other compilation root — even a program
        ; that declares the package and spells out `use pkg.mod.NAME` gets a hard
        ; `unknown identifier` (measured 2026-08-04, and the same holds for the
        ; prelude's own PAGE_SIZE). Every reference is resolved by
        ; LLVMGetNamedGlobal inside the SAME llvm_module, and no seed module
        ; references another's constant. So the definition has no business being a
        ; strong global symbol — and being one made two packages that happen to
        ; spell a constant the same way unlinkable: `duplicate symbol
        ; '_10SHARED_TAG'`, which is why dazzle carries hand-renamed mirrors of
        ; opensp's constants (GADV_IDREF, GDT_SGML).
        ;
        ; Only CONSTANTS. A `mutable` global stays external — the runtime's
        ; allocator state is reached by name from emitted prologue code — and a
        ; `shared` one is a deliberate process-global cell.
        function set_module_constant_linkage(this, gv: LLVMValueRef)
        {
            LLVMSetLinkage(gv, LLVMLinkage.Internal())
        }

        ; Emit a global reference
        function emit_global_ref(this, global: PlannedGlobalRef) returns LLVMValueRef
        {
            let gv LLVMGetNamedGlobal(llvm_module, global.mangled_name.c_data())
            if gv.handle = null
                return LLVMValueRef null

            ; s189: a mutable module global (marked non-constant) reads as a
            ; LOAD of the current stored value. Member access / comparison on
            ; the result then operates on the loaded pointer/scalar, not the
            ; global's address. Constant globals keep the address-return path.
            if LLVMIsGlobalConstant(gv) = 0
            {
                let gv_ty LLVMGlobalGetValueType(gv)
                return LLVMBuildLoad2(builder, gv_ty, gv, "global.load")
            }

            ; Check if this is an array type (has array_size set)
            if global.global_type.array_size.get_length() > 0
            {
                ; For arrays, create GEP to get pointer to first element
                let element_type map_type global.global_type
                let i64_type LLVMInt64TypeInContext(context)
                let zero LLVMConstInt(i64_type, 0, 0)

                ; Build indices array [0, 0] to get pointer to first element
                var indices Vector[LLVMValueRef](2)
                indices.put(0, zero)
                indices.put(1, zero)

                ; Get global's type (array type)
                let gv_type LLVMGlobalGetValueType(gv)

                return LLVMBuildInBoundsGEP2(builder, gv_type, gv, indices.data, 2, "array.ptr")
            }

            gv
        }

        ; ========================================================================
        ; Call Emission
        ; ========================================================================

        ; s80: Emit an Itanium C1 constructor call. The PlannedCall's
        ; mangled_name carries "C1E" (set by Planner.mangle_function# when
        ; name=="init" and parent != null). Emits the stage-0 reference
        ; sequence (Emitter.cpp:3618+):
        ;   %t = call ptr @_ZN4Page8allocateEmm(<page>, sizeof, alignof)
        ;   call void @<mangled>(<t>, <page>, ...args)
        ;   ; result is %t
        ; For Lifetime.Unspecified the alloc is a stack alloca instead of a
        ; Page::allocate call. The page is read from the function's `rp`
        ; local var (function# callers); non-# callers get a lazy root-page
        ; alloc — same fallback as emit_call's existing requires_page_param
        ; path.
        function emit_constructor_call(this, call: PlannedCall) returns LLVMValueRef
        {
            let no_dest LLVMValueRef(null)
            emit_constructor_call_into(call, no_dest)
        }

        ; Like emit_constructor_call, but when `dest` is non-null the struct is
        ; constructed IN PLACE on that address (a field GEP from
        ; emit_in_place_field_ctor): no page resolution, no scratch allocation.
        ; The caller guarantees dest is big enough (its LLVM type equals the
        ; ctor's struct type) and that no ctor arg aliases the destination.
        function emit_constructor_call_into(this, call: PlannedCall, dest: LLVMValueRef) returns LLVMValueRef
        {
            ; s176: region-allocated ctor results are planned as pointer[T]
            ; (s27), so map_type(call.result_type) yields `ptr` and
            ; LLVMSizeOf(ptr)=8 under-sized every Page::allocate for T
            ; bigger than 8 bytes. The ctor then wrote sizeof(T) bytes into
            ; the 8-byte slot; when the slot sat in the last 8 bytes of a
            ; page, the overflow zeroed the NEXT page's header
            ; (next_object=0), Page::allocate later returned address 0 and
            ; PageList::add crashed (ref_string_item, sibling_heap_mutation,
            ; flaky stage-2 corruption). Peel pointer[T] to T so sizing and
            ; the zero-init field GEPs below see the real struct type —
            ; mirrors stage-0, which sizes with the struct type.
            var ctor_rt call.result_type
            if ctor_rt.name = "pointer"
            {
                if ctor_rt.generics <> null
                {
                    let gens (*ctor_rt.generics)
                    if gens.length > 0
                    {
                        let g0 gens.get 0
                        if g0 <> null
                            set ctor_rt: (*g0)
                    }
                }
            }
            let struct_ty map_type ctor_rt
            if struct_ty.handle = null
                return LLVMValueRef null

            ; Decide allocation strategy based on call.life. Lifetime.Reference
            ; (^name) reads the page from the named local variable.
            var is_region_alloc: bool false
            var is_local_alloc: bool false
            var ref_name: String ""
            var has_ref_name: bool false
            choose call.life
                when l: Lifetime.Local
                {
                    set is_region_alloc: true
                    set is_local_alloc: true
                }
                when c: Lifetime.Call
                    set is_region_alloc: true
                when r: Lifetime.Reference
                {
                    set is_region_alloc: true
                    set has_ref_name: true
                    set ref_name: r.location
                }
                else
                    0

            ; In-place destination: construct directly on the caller-provided
            ; field address — skip page resolution and scratch allocation.
            var in_place: bool false
            if dest.handle <> null
                set in_place: true

            ; Resolve the page argument. TWO currencies since the frame chain
            ; (2026-08-02): the constructor takes the FRAME as its caller-page
            ; argument, while the Page::allocate below needs the materialised
            ; page. Forcing here is right — this site really is allocating.
            var page_frame: LLVMValueRef LLVMValueRef(null)
            var page_arg: LLVMValueRef LLVMValueRef(null)
            if in_place = false
            {
                if is_region_alloc
                {
                    ; A `$` (Lifetime.Local) construction allocates on THIS function's
                    ; local page (released on exit by always-free-local), NEVER the
                    ; caller's rp. Mirrors stage-0 Emitter.cpp:3680-3682. Without this,
                    ; a `$` allocation inside a `#` function (which has `rp` in scope)
                    ; fell through to the rp branch below and leaked onto the caller's
                    ; persistent page — the stage-2 transient-leak driver (2.4x RSS vs
                    ; stage-1: $ builders/Vectors/StringBuilders in the hot # planner
                    ; functions never freed). The escape checker guarantees a `$` value
                    ; that escapes is a compile error, so routing to the local page is
                    ; safe. (Item-2's LEVER fixed the analogous CALL path at ~line 5140;
                    ; constructions were missed.)
                    if is_local_alloc
                        set page_frame: get_local_frame()
                    if is_local_alloc = false
                    {
                        if has_ref_name
                            set page_frame: resolve_reference_frame(ref_name)
                        if has_ref_name = false
                        {
                            let rp_val lookup_variable("_rp")
                            if rp_val.handle <> null
                                set page_frame: rp_val
                            ; s196: non-# caller — reuse this function's single local
                            ; root page (released on exit) instead of leaking a fresh one.
                            if page_frame.handle = null
                                set page_frame: get_local_frame()
                        }
                    }
                    if page_frame.handle = null
                        return LLVMValueRef null
                    set page_arg: materialise_frame(page_frame)
                    if page_arg.handle = null
                        return LLVMValueRef null
                }
            }

            ; Allocate the struct.
            var struct_ptr: LLVMValueRef LLVMValueRef(null)
            if in_place
                set struct_ptr: dest
            if in_place = false
            {
                if is_region_alloc
                {
                    ; Page::allocate(page, sizeof, alignof). LLVMSizeOf / LLVMAlignOf
                    ; emit i64 constants computed from the module's default DataLayout.
                    var alloc_func lookup_function_cache("_ZN4Page8allocateEmm")
                    if alloc_func.handle = null
                        set alloc_func: LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
                    if alloc_func.handle = null
                    {
                        var alloc_param_types_d Vector[LLVMTypeRef](3)
                        alloc_param_types_d.put(0, LLVMPointerTypeInContext(context, 0))
                        alloc_param_types_d.put(1, LLVMInt64TypeInContext context)
                        alloc_param_types_d.put(2, LLVMInt64TypeInContext context)
                        let alloc_ret_ty LLVMPointerTypeInContext(context, 0)
                        let alloc_decl_ty LLVMFunctionType(alloc_ret_ty, alloc_param_types_d.data, 3, 0)
                        set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", alloc_decl_ty)
                        LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                        cache_function("_ZN4Page8allocateEmm", alloc_func)
                    }
                    ; s176: when map_type fell back to opaque ptr (loaded-package
                    ; structs like StringBuilder aren't layout-registered),
                    ; LLVMSizeOf(ptr)=8 under-sizes the allocation: the 16-byte
                    ; StringBuilder ctor overflowed its 8-byte slot, and when the
                    ; slot sat in a page's last 8 bytes the overflow zeroed the
                    ; NEXT page's header (next_object=0) — Page::allocate then
                    ; returned address 0 and PageList::add crashed
                    ; (ref_string_item, sibling_heap_mutation, flaky stage-2
                    ; corruption). Registering real layouts flips String/Page
                    ; mapping everywhere (breaks stage-2 wholesale), so instead
                    ; allocate a pessimistic 64 bytes when the type is opaque —
                    ; over-allocation is waste, never corruption.
                    var size_const LLVMSizeOf(struct_ty)
                    if LLVMGetTypeKind(struct_ty) = LLVMTypeKind.Pointer()
                    {
                        let i64_ty_sz LLVMInt64TypeInContext(context)
                        set size_const: LLVMConstInt(i64_ty_sz, 64, 0)
                    }
                    let align_const LLVMAlignOf(struct_ty)
                    var alloc_args Vector[LLVMValueRef](3)
                    alloc_args.put(0, page_arg)
                    alloc_args.put(1, size_const)
                    alloc_args.put(2, align_const)
                    var alloc_param_types_c Vector[LLVMTypeRef](3)
                    alloc_param_types_c.put(0, LLVMPointerTypeInContext(context, 0))
                    alloc_param_types_c.put(1, LLVMInt64TypeInContext context)
                    alloc_param_types_c.put(2, LLVMInt64TypeInContext context)
                    let alloc_ret_ty2 LLVMPointerTypeInContext(context, 0)
                    let alloc_call_ty LLVMFunctionType(alloc_ret_ty2, alloc_param_types_c.data, 3, 0)
                    set struct_ptr: LLVMBuildCall2(builder, alloc_call_ty, alloc_func, alloc_args.data, 3, "struct.region")
                }
                if is_region_alloc = false
                    set struct_ptr: entry_alloca(struct_ty, "struct.init")
            }

            ; Compute user arg count.
            var user_arg_count: size_t 0
            if call.args <> null
            {
                let argv (*call.args)
                set user_arg_count: argv.length
            }

            ; s125: empty-parens constructor → inline field-default init.
            ; Stage-0 (Emitter.cpp tuple-style ctor) inlines field-by-field
            ; default initialization for `Type[T]$()` / `Type[T]()` with no
            ; user args, rather than calling a no-args ctor. The mangled
            ; `_ZN..EC1Ev` body often doesn't exist (Scaly types like List[T],
            ; HashMapBuilder[K,V] declare only with-args inits, and the
            ; field defaults — `head (null)`, `length: size_t (0)`, etc. —
            ; carry the zero-init semantics implicitly). Stage-1's previous
            ; behavior was to LLVMBuildCall2 the non-existent C1Ev symbol,
            ; producing ~113 undefined refs at stage-2 link time.
            ;
            ; This bypass: when user_arg_count == 0 AND the struct_ty is a
            ; concrete LLVM struct, walk fields and store `LLVMConstNull` of
            ; each field's type. Matches stage-0's tuple.region pattern
            ; (Emitter.cpp:5500 / handle_class IR for symbols_builder).
            ; Requires_page_param ctors (Vector[T]^this(len)) and any ctor
            ; with explicit user args go through the regular LLVMBuildCall2
            ; path below.
            ; A GENERIC instantiation (result_type carries type generics) may have
            ; no emitted C1 body, so the zero-init/skip bypass below avoids an
            ; undefined symbol. A NON-generic concept (e.g. a de-sigiled
            ; StringBuilder whose page param was dropped, leaving a real
            ; param-less init()) has a real, linkable C1 — for the opaque
            ; cross-package case-2 it must CALL that ctor rather than return
            ; uninitialized memory (SIGSEGV on first use).
            var ctor_is_generic: bool false
            if ctor_rt.generics <> null
                if (*ctor_rt.generics).length > 0
                    set ctor_is_generic: true
            if user_arg_count = 0
            {
                if call.requires_page_param = false
                {
                    ; Only zero-init a GENERIC instantiation's concrete struct — its
                    ; monomorphized C1 body may not be emitted, so calling it would be
                    ; an undefined symbol (the ~113 List[T]/HashMapBuilder[K,V] refs
                    ; this bypass was built for). A NON-generic concept reaching here
                    ; has a real matched nullary init# with an emitted, linkable C1
                    ; (find_initializer# only routes construction here on a match, and
                    ; a concrete/layout-registered struct is body-planned in THIS
                    ; compilation, so its C1 body exists) — it must CALL that ctor.
                    ; Without the ctor_is_generic gate an in-package `T^page()`/`T()`
                    ; (e.g. ISet^host()) returned zero-inited memory and never ran
                    ; init#; cross-package the SAME construction was already correct
                    ; via the opaque branch below, which gates identically.
                    if LLVMGetTypeKind(struct_ty) = LLVMTypeKind.Struct()
                        if ctor_is_generic
                        {
                            let n_fields LLVMCountStructElementTypes(struct_ty)
                            var fi: int 0
                            while fi < n_fields
                            {
                                let field_ty LLVMStructGetTypeAtIndex(struct_ty, fi)
                                if field_ty.handle <> null
                                {
                                    let field_ptr LLVMBuildStructGEP2(builder, struct_ty, struct_ptr, fi as u32, "tuple.field")
                                    let zero LLVMConstNull(field_ty)
                                    LLVMBuildStore(builder, zero, field_ptr)
                                }
                                set fi: fi + 1
                            }
                            return struct_ptr
                        }
                    ; s125b: stdlib generic instantiations (HashMapBuilder[K,V],
                    ; List[T], etc.) aren't in struct_cache, so map_type falls
                    ; back to opaque ptr — we can't walk fields. Still skip
                    ; the LLVMBuildCall2 to the non-existent C1Ev symbol;
                    ; Page::allocate returned memory is uninitialized but at
                    ; least the link will resolve. The downstream user code
                    ; that reads the struct may misbehave (size/layout
                    ; mismatch with the actual instantiation), but those are
                    ; separate stdlib-generic-instantiation gaps to fix
                    ; independently. Closes ~113 undefined C1Ev refs at
                    ; stage-2 link time.
                    if LLVMGetTypeKind(struct_ty) <> LLVMTypeKind.Struct()
                        if ctor_is_generic
                            return struct_ptr
                }
            }

            ; Total ctor arg count: this + (page if requires_page_param) + user_args.
            var total_ctor_args: size_t 1
            if call.requires_page_param
                set total_ctor_args: 2
            set total_ctor_args: total_ctor_args + user_arg_count

            ; Build args + param types as we emit. Start with `this`.
            var ctor_args Vector[LLVMValueRef](total_ctor_args)
            var ctor_param_types Vector[LLVMTypeRef](total_ctor_args)
            ctor_args.put(0, struct_ptr)
            ctor_param_types.put(0, LLVMPointerTypeInContext(context, 0))
            var slot: size_t 1
            if call.requires_page_param
            {
                ctor_args.put(1, page_frame)
                ctor_param_types.put(1, LLVMPointerTypeInContext(context, 0))
                set slot: 2
            }

            ; Emit each user arg, applying the same struct→ptr coercion that
            ; emit_call uses (callees declare struct params as `ptr`).
            if call.args <> null
            {
                let argv (*call.args)
                var ai: size_t 0
                while ai < argv.length
                {
                    let aptr argv.get ai
                    if aptr <> null
                    {
                        var arg_value emit_operand((*aptr))
                        if arg_value.handle = null
                            return LLVMValueRef null
                        let arg_kind LLVMGetTypeKind(LLVMTypeOf arg_value)
                        if arg_kind = LLVMTypeKind.Struct()
                        {
                            let arg_alloca acquire_temp(LLVMTypeOf arg_value, "arg.tmp")
                            let av_ty LLVMTypeOf(arg_value)
                            copy_struct_value(arg_alloca, arg_value, av_ty)
                            set arg_value: arg_alloca
                        }
                        ctor_args.put(slot, arg_value)
                        ctor_param_types.put(slot, LLVMTypeOf arg_value)
                        set slot: slot + 1
                    }
                    set ai: ai + 1
                }
            }

            ; Look up or declare the ctor function.
            var ctor_fn lookup_function_cache call.mangled_name
            if ctor_fn.handle = null
                set ctor_fn: LLVMGetNamedFunction(llvm_module, call.mangled_name.c_data())
            if ctor_fn.handle = null
            {
                let void_ty LLVMVoidTypeInContext(context)
                let decl_ty LLVMFunctionType(void_ty, ctor_param_types.data, total_ctor_args as u32, 0)
                set ctor_fn: LLVMAddFunction(llvm_module, call.mangled_name.c_data(), decl_ty)
                LLVMSetLinkage(ctor_fn, LLVMLinkage.External())
                cache_function(call.mangled_name, ctor_fn)
            }

            let void_ty2 LLVMVoidTypeInContext(context)
            let ctor_call_ty LLVMFunctionType(void_ty2, ctor_param_types.data, total_ctor_args as u32, 0)
            LLVMBuildCall2(builder, ctor_call_ty, ctor_fn, ctor_args.data, total_ctor_args as u32, "")

            struct_ptr
        }

        ; True when t is pointer[const_char] / pointer[i8] / pointer[char] /
        ; pointer[u8] — i.e. a C-string position. The planner wraps a String
        ; argument bound to such a parameter in a PlannedAs(target = t); emit_as
        ; uses this to lower the String to its c_data content pointer.
        function target_is_cstr_pointer(this, t: PlannedType) returns bool
        {
            var result: bool false
            if t.name = "pointer"
                if t.generics <> null
                {
                    let gs (*t.generics)
                    if gs.length > 0
                    {
                        let ip gs.get 0
                        if ip <> null
                        {
                            let inner (*ip)
                            if inner.name = "const_char"
                                set result: true
                            if inner.name = "i8"
                                set result: true
                            if inner.name = "char"
                                set result: true
                            if inner.name = "u8"
                                set result: true
                            ; pointer[void]: a String cast to a raw buffer
                            ; pointer (write/fwrite args) hands over its
                            ; content pointer exactly like the cstr targets.
                            ; Without this the e45166de loud-cast trap fires
                            ; on `"..." as pointer[void]` (io.scaly tests).
                            if inner.name = "void"
                                set result: true
                        }
                    }
                }
            result
        }

        ; Like target_is_cstr_pointer but WITHOUT pointer[void] — the ptr-kind
        ; String coercion in emit_as keys off this, and a String cast to
        ; pointer[void] (Page.get(this as pointer[void]) in String methods)
        ; must keep the record address, not the content buffer.
        function target_is_char_pointer(this, t: PlannedType) returns bool
        {
            var result: bool false
            if t.name = "pointer"
                if t.generics <> null
                {
                    let gs (*t.generics)
                    if gs.length > 0
                    {
                        let ip gs.get 0
                        if ip <> null
                        {
                            let inner (*ip)
                            if inner.name = "const_char"
                                set result: true
                            if inner.name = "i8"
                                set result: true
                            if inner.name = "char"
                                set result: true
                            if inner.name = "u8"
                                set result: true
                        }
                    }
                }
            result
        }

        ; A private module-level `[1 x i8] c"\00"` global, the canonical valid
        ; empty C string. An empty Scaly String is `{ null }` (the s186 design),
        ; so its get_buffer()/c_data() yields null — but a C callee that
        ; dereferences the pointer (LLVMBuildCall2 reads name[0]) needs a valid
        ; "\0". Built once and reused (keyed by name in the module).
        function get_or_build_empty_cstr(this) returns LLVMValueRef
        {
            var g LLVMGetNamedGlobal(llvm_module, ".scaly.empty.cstr")
            if g.handle <> null
                return g
            let i8ty LLVMInt8TypeInContext(context)
            let arr_ty LLVMArrayType(i8ty, 1)
            var vals Vector[LLVMValueRef](1)
            vals.put(0, LLVMConstInt(i8ty, 0, 0))
            let arr LLVMConstArray(i8ty, vals.data, 1)
            set g: LLVMAddGlobal(llvm_module, arr_ty, ".scaly.empty.cstr")
            LLVMSetInitializer(g, arr)
            LLVMSetGlobalConstant(g, 1)
            LLVMSetLinkage(g, LLVMLinkage.Private())
            g
        }

        ; Coerce a runtime String VALUE to its NUL-terminated content pointer
        ; (c_data) for a pointer[const_char] parameter, by calling get_buffer
        ; (which skips the varint prefix). Used when a String VARIABLE — not a
        ; constant — flows into a const_char position (e.g. `var name "x";
        ; LLVMBuildCall2(.., name)`). A String constant takes the cheaper cstr-
        ; global fast path in emit_as instead.
        function coerce_string_value_to_cstr(this, sval: LLVMValueRef) returns LLVMValueRef
        {
            let ptrty LLVMPointerTypeInContext(context, 0)
            ; s34: copy the single-ptr-field struct PARAM into a local var before
            ; passing it to an LLVM-C extern, else it miscompiles (garbage handle).
            var sv sval
            var this_ptr sv
            if LLVMGetTypeKind(LLVMTypeOf sv) = LLVMTypeKind.Struct()
            {
                let tmp acquire_temp(LLVMTypeOf sv, "str.coerce")
                LLVMBuildStore(builder, sv, tmp)
                set this_ptr: tmp
            }
            var gb_params Vector[LLVMTypeRef](1)
            gb_params.put(0, ptrty)
            let gb_ty LLVMFunctionType(ptrty, gb_params.data, 1, 0)
            var gb LLVMGetNamedFunction(llvm_module, "_ZN6String10get_bufferEv")
            if gb.handle = null
                set gb: LLVMAddFunction(llvm_module, "_ZN6String10get_bufferEv", gb_ty)
            var ca Vector[LLVMValueRef](1)
            ca.put(0, this_ptr)
            let buf LLVMBuildCall2(builder, gb_ty, gb, ca.data, 1, "cstr")
            ; An empty String ({ null }) yields a null buffer; substitute the
            ; valid empty-cstr global so a dereferencing C callee is safe.
            let nn LLVMBuildIsNotNull(builder, buf, "cstr.nn")
            LLVMBuildSelect(builder, nn, buf, this.get_or_build_empty_cstr(), "cstr.g")
        }

        ; Emit a function/operator call
        ; M2.3: atomic primitives. The scaly_atomic_* names are declared as
        ; plain externs in the stdlib but NO such symbols exist anywhere —
        ; the emitter lowers the calls to atomic INSTRUCTIONS instead
        ; (atomicrmw / cmpxchg / atomic load+store, all seq_cst, align 8).
        ; Atomics are neither OS-specific, variadic, nor errno-bound, so per
        ; the shim containment rule they may not live in C; the libatomic
        ; ABI symbols are not uniformly linkable across the four targets.
        ; Returns a null handle when the callee is not an atomic name.
        ;   scaly_atomic_load_u64(p) / scaly_atomic_store_u64(p, v)
        ;   scaly_atomic_or_u64 / and_u64 / add_u64 (p, v) returns OLD value
        ;   scaly_atomic_cas_u64(p, expected, desired) returns OLD value
        function emit_atomic_call(this, call: PlannedCall) returns LLVMValueRef
        {
            if call.mangled_name.starts_with("scaly_atomic_") = false
                return LLVMValueRef null
            if call.args = null
                return LLVMValueRef null
            let seq_cst: i32 7
            let arg0 call.args.get 0
            if arg0 = null
                return LLVMValueRef null
            var ptr emit_operand(arg0.unwrap())
            if call.mangled_name = "scaly_atomic_load_u64"
            {
                let i64_ty LLVMInt64TypeInContext(context)
                let ld LLVMBuildLoad2(builder, i64_ty, ptr, "atomic.load")
                LLVMSetOrdering(ld, seq_cst)
                LLVMSetAlignment(ld, 8)
                return ld
            }
            if call.args.length < 2
                return LLVMValueRef null
            let arg1 call.args.get 1
            if arg1 = null
                return LLVMValueRef null
            var val emit_operand(arg1.unwrap())
            if call.mangled_name = "scaly_atomic_store_u64"
            {
                let st LLVMBuildStore(builder, val, ptr)
                LLVMSetOrdering(st, seq_cst)
                LLVMSetAlignment(st, 8)
                return st
            }
            if call.mangled_name = "scaly_atomic_or_u64"
                return LLVMBuildAtomicRMW(builder, 5, ptr, val, seq_cst, 0)
            if call.mangled_name = "scaly_atomic_and_u64"
                return LLVMBuildAtomicRMW(builder, 3, ptr, val, seq_cst, 0)
            if call.mangled_name = "scaly_atomic_add_u64"
                return LLVMBuildAtomicRMW(builder, 1, ptr, val, seq_cst, 0)
            if call.mangled_name = "scaly_atomic_cas_u64"
            {
                if call.args.length < 3
                    return LLVMValueRef null
                let arg2 call.args.get 2
                if arg2 = null
                    return LLVMValueRef null
                var desired emit_operand(arg2.unwrap())
                let pair LLVMBuildAtomicCmpXchg(builder, ptr, val, desired, seq_cst, seq_cst, 0)
                return LLVMBuildExtractValue(builder, pair, 0, "cas.old")
            }
            LLVMValueRef null
        }

        ; M2.3b: scaly_call_ptr(fn, arg) returns pointer[void] — an indirect
        ; ptr(ptr) call through a bare function-pointer value. Same
        ; extern-name-with-no-symbol pattern as the atomics above. The
        ; delegate-record calling convention prepends the record as a hidden
        ; first argument, so a plain C-shaped fn(arg) invocation (a
        ; pthread-entry signature) needs this emitter-lowered form.
        function emit_ptr_call(this, call: PlannedCall) returns LLVMValueRef
        {
            if call.mangled_name <> "scaly_call_ptr"
                return LLVMValueRef null
            if call.args = null
                return LLVMValueRef null
            if call.args.length < 2
                return LLVMValueRef null
            let a0 call.args.get 0
            let a1 call.args.get 1
            if a0 = null
                return LLVMValueRef null
            if a1 = null
                return LLVMValueRef null
            var fnv emit_operand(a0.unwrap())
            var argv emit_operand(a1.unwrap())
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var arg_tys Vector[LLVMTypeRef](1)
            arg_tys.put(0, ptr_ty)
            var arg_vals Vector[LLVMValueRef](1)
            arg_vals.put(0, argv)
            let fn_ty LLVMFunctionType(ptr_ty, arg_tys.data, 1, 0)
            return LLVMBuildCall2(builder, fn_ty, fnv, arg_vals.data, 1, "")
        }

        ; ========================================================================
        ; Stage 7.2: compiler-generated region swizzle walkers.
        ;
        ; The planner resolves `rr.fix_graph(root)` to `_scaly_walk_<T>` and
        ; validates the message type's closure (delegates rejected there); the
        ; walker bodies are generated HERE, on first call, one linkonce_odr
        ; `void _scaly_walk_X(ptr rr, ptr obj)` per reachable type. A walker
        ; fixes every pointer slot of its type through
        ; ReceivedRegion.fix_value (VALUE semantics — union payloads sit at
        ; byte offset 1, so every slot load/store is align 1) and descends
        ; through the freshly patched pointers. Layout truth is the same LLVM
        ; struct map_type gives member accesses; the planner's simplified
        ; byte offsets are never used. Programs that never call fix_graph
        ; emit byte-identical IR (the registry stays empty).
        ; ========================================================================

        function region_walker_symbol(this, t: PlannedType) returns String
        {
            var sb StringBuilder()
            sb.append "_scaly_walk_"
            if t.mangled_name.get_length() > 0
                sb.append t.mangled_name
            else
                sb.append t.name
            sb.to_string()
        }

        ; Page headers are swizzled by Region.deserialize itself — the typed
        ; walk fixes pointers TO them but never descends INTO them.
        function region_walker_header_name(this, name: String) returns bool
        {
            if name = "Page"
                return true
            if name = "PageList"
                return true
            if name = "PageNode"
                return true
            if name = "PageListIterator"
                return true
            if name = "HeapBucketHeader"
                return true
            if name = "StackBucketHeader"
                return true
            false
        }

        ; A slot the walker fixes in place: pointer, ref, or an NPO Option
        ; (a bare nullable pointer at the LLVM level).
        function region_is_ptr_slot(this, ft: PlannedType) returns bool
        {
            if ft.name = "pointer"
                return true
            if ft.name = "ref"
                return true
            if is_npo_option(ft)
                return true
            false
        }

        ; The type a fixed slot of type ft points AT ("void" = opaque target,
        ; fix-only): pointer[X]/ref[X] → X, Option[pointer[X]]/Option[ref[X]] → X.
        function region_slot_pointee(this, ft: PlannedType) returns PlannedType
        {
            var inner ft
            if ft.name = "Option"
            {
                if ft.generics = null
                    return Planner.make_void_type()
                let ogens (*ft.generics)
                if ogens.length = 0
                    return Planner.make_void_type()
                let ogp ogens.get 0
                if ogp = null
                    return Planner.make_void_type()
                set inner: (*ogp)
            }
            if inner.generics = null
                return Planner.make_void_type()
            let gens (*inner.generics)
            if gens.length = 0
                return Planner.make_void_type()
            let gp gens.get 0
            if gp = null
                return Planner.make_void_type()
            (*gp)
        }

        function find_planned_structure(this, mangled: String, name: String) returns ref[PlannedStructure]?
        {
            if current_plan = null
                return null
            let plan_ref current_plan
            let plan (*plan_ref)
            if plan.structures = null
                return null
            let structs (*plan.structures)
            if mangled.get_length() > 0
            {
                var i: size_t 0
                while i < structs.length
                {
                    let s_ptr structs.get i
                    if s_ptr <> null
                    {
                        if s_ptr.mangled_name = mangled
                            return s_ptr
                    }
                    set i: i + 1
                }
            }
            var k: size_t 0
            while k < structs.length
            {
                let s_ptr structs.get k
                if s_ptr <> null
                {
                    if s_ptr.name = name
                        return s_ptr
                }
                set k: k + 1
            }
            null
        }

        function find_planned_union(this, mangled: String, name: String) returns ref[PlannedUnion]?
        {
            if current_plan = null
                return null
            let plan_ref current_plan
            let plan (*plan_ref)
            if plan.unions = null
                return null
            let unions (*plan.unions)
            if mangled.get_length() > 0
            {
                var i: size_t 0
                while i < unions.length
                {
                    let u_ptr unions.get i
                    if u_ptr <> null
                    {
                        if u_ptr.mangled_name = mangled
                            return u_ptr
                    }
                    set i: i + 1
                }
            }
            var k: size_t 0
            while k < unions.length
            {
                let u_ptr unions.get k
                if u_ptr <> null
                {
                    if u_ptr.name = name
                        return u_ptr
                }
                set k: k + 1
            }
            null
        }

        ; Does `t` transitively contain slots to fix? Terminates without a
        ; seen-set: recursion only follows BY-VALUE embedding (pointer-like
        ; types answer true immediately), and value-embedding cannot cycle.
        function region_type_needs_walk(this, t: PlannedType) returns bool
        {
            if region_is_ptr_slot(t)
                return true
            if t.name = "String"
                return true
            if Planner.is_primitive_type_name(t.name)
                return false
            if t.name = "const_char"
                return false
            if region_walker_header_name(t.name)
                return false
            let s_ref find_planned_structure(t.mangled_name, t.name)
            if s_ref <> null
            {
                if s_ref.properties <> null
                {
                    let props (*s_ref.properties)
                    var pi: size_t 0
                    while pi < props.length
                    {
                        let p_ptr props.get pi
                        if p_ptr <> null
                        {
                            if region_type_needs_walk(p_ptr.prop_type)
                                return true
                        }
                        set pi: pi + 1
                    }
                }
                return false
            }
            let u_ref find_planned_union(t.mangled_name, t.name)
            if u_ref <> null
            {
                if u_ref.variants <> null
                {
                    let vars (*u_ref.variants)
                    var vi: size_t 0
                    while vi < vars.length
                    {
                        let v_ptr vars.get vi
                        if v_ptr <> null
                        {
                            if v_ptr.var_type <> null
                            {
                                if region_type_needs_walk((*v_ptr.var_type))
                                    return true
                            }
                        }
                        set vi: vi + 1
                    }
                }
                return false
            }
            false
        }

        ; Should a fixed slot's target be walked? Mirrors the planner's
        ; check_message_pointee: scalars, raw buffers, and page headers are
        ; fix-only.
        function region_walker_descends(this, target: PlannedType) returns bool
        {
            if target.name = "void"
                return false
            if target.name = "const_char"
                return false
            if Planner.is_scalar_value_type_name(target.name)
                return false
            if region_walker_header_name(target.name)
                return false
            region_type_needs_walk(target)
        }

        ; Anything to do for a value of type ft lying at some address?
        function region_field_acts(this, ft: PlannedType) returns bool
        {
            if region_is_ptr_slot(ft)
                return true
            if ft.name = "String"
                return true
            region_type_needs_walk(ft)
        }

        ; The stdlib slot mapper: `_ZN14ReceivedRegion9fix_valueEm` —
        ; i64 fix_value(ptr this, i64 old). Declared on demand; the body
        ; lives in scaly.memory.Region (libscaly.a / in-process for --run).
        function region_fix_value_fn(this) returns LLVMValueRef
        {
            var sym "_ZN14ReceivedRegion9fix_valueEm"
            var fn LLVMGetNamedFunction(llvm_module, sym.c_data())
            if fn.handle <> null
                return fn
            LLVMAddFunction(llvm_module, sym.c_data(), region_fix_value_type())
        }

        function region_fix_value_type(this) returns LLVMTypeRef
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var ptys Vector[LLVMTypeRef](2)
            ptys.put(0, ptr_ty)
            ptys.put(1, i64_ty)
            LLVMFunctionType(i64_ty, ptys.data, 2, 0)
        }

        function region_walker_fn_type(this) returns LLVMTypeRef
        {
            let void_ty LLVMVoidTypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var ptys Vector[LLVMTypeRef](2)
            ptys.put(0, ptr_ty)
            ptys.put(1, ptr_ty)
            LLVMFunctionType(void_ty, ptys.data, 2, 0)
        }

        ; Fix one slot in place: load old (align 1), map through fix_value,
        ; store back (align 1). Returns the NEW value as i64.
        function emit_region_fix_slot(this, rr: LLVMValueRef, slot: LLVMValueRef) returns LLVMValueRef
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let old LLVMBuildLoad2(builder, i64_ty, slot, "walk.old")
            LLVMSetAlignment(old, 1)
            let fv region_fix_value_fn()
            var fargs Vector[LLVMValueRef](2)
            fargs.put(0, rr)
            fargs.put(1, old)
            let nv LLVMBuildCall2(builder, region_fix_value_type(), fv, fargs.data, 2, "walk.new")
            let st LLVMBuildStore(builder, nv, slot)
            LLVMSetAlignment(st, 1)
            nv
        }

        procedure emit_region_walker_call(this, rr: LLVMValueRef, objp: LLVMValueRef, t: PlannedType)
        {
            let wfn ensure_region_walker t
            var wargs Vector[LLVMValueRef](2)
            wargs.put(0, rr)
            wargs.put(1, objp)
            let cv LLVMBuildCall2(builder, region_walker_fn_type(), wfn, wargs.data, 2, "")
        }

        ; Handle one value of planned type ft lying at `addr`: fix pointer
        ; slots (and descend through them), fix a String's data slot, walk an
        ; embedded aggregate in place. Scalars are untouched.
        procedure emit_region_value_at(this, fn: LLVMValueRef, rr: LLVMValueRef, addr: LLVMValueRef, ft: PlannedType)
        {
            if region_is_ptr_slot(ft)
            {
                let nv emit_region_fix_slot(rr, addr)
                let target region_slot_pointee(ft)
                if region_walker_descends(target)
                {
                    let i64_ty LLVMInt64TypeInContext(context)
                    let zero LLVMConstInt(i64_ty, 0, 0)
                    let isnn LLVMBuildICmp(builder, LLVMIntPredicate.NE(), nv, zero, "walk.nn")
                    let desc_bb LLVMAppendBasicBlockInContext(context, fn, "walk.desc")
                    let cont_bb LLVMAppendBasicBlockInContext(context, fn, "walk.cont")
                    LLVMBuildCondBr(builder, isnn, desc_bb, cont_bb)
                    LLVMPositionBuilderAtEnd(builder, desc_bb)
                    let ptr_ty LLVMPointerTypeInContext(context, 0)
                    let tp LLVMBuildIntToPtr(builder, nv, ptr_ty, "walk.p")
                    emit_region_walker_call(rr, tp, target)
                    LLVMBuildBr(builder, cont_bb)
                    LLVMPositionBuilderAtEnd(builder, cont_bb)
                }
                return
            }
            if ft.name = "String"
            {
                let sv emit_region_fix_slot(rr, addr)
                return
            }
            if region_type_needs_walk(ft)
                emit_region_walker_call(rr, addr, ft)
        }

        ; Elements data[0..count): one value_at per element. `data_i64` is the
        ; freshly mapped data pointer as i64 (0 = empty), `count` an i64.
        procedure emit_region_elem_loop(this, fn: LLVMValueRef, rr: LLVMValueRef, data_i64: LLVMValueRef, count: LLVMValueRef, elem: PlannedType)
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let zero LLVMConstInt(i64_ty, 0, 0)
            let one LLVMConstInt(i64_ty, 1, 0)

            let isnn LLVMBuildICmp(builder, LLVMIntPredicate.NE(), data_i64, zero, "walk.dnn")
            let pre_bb LLVMAppendBasicBlockInContext(context, fn, "walk.loop.pre")
            let head_bb LLVMAppendBasicBlockInContext(context, fn, "walk.loop.head")
            let body_bb LLVMAppendBasicBlockInContext(context, fn, "walk.loop.body")
            let exit_bb LLVMAppendBasicBlockInContext(context, fn, "walk.loop.exit")
            LLVMBuildCondBr(builder, isnn, pre_bb, exit_bb)

            LLVMPositionBuilderAtEnd(builder, pre_bb)
            let datap LLVMBuildIntToPtr(builder, data_i64, ptr_ty, "walk.data")
            let iv LLVMBuildAlloca(builder, i64_ty, "walk.i")
            let st0 LLVMBuildStore(builder, zero, iv)
            LLVMBuildBr(builder, head_bb)

            LLVMPositionBuilderAtEnd(builder, head_bb)
            let ivv LLVMBuildLoad2(builder, i64_ty, iv, "walk.iv")
            let cmp LLVMBuildICmp(builder, LLVMIntPredicate.ULT(), ivv, count, "walk.cmp")
            LLVMBuildCondBr(builder, cmp, body_bb, exit_bb)

            LLVMPositionBuilderAtEnd(builder, body_bb)
            let ety map_type elem
            var eidx Vector[LLVMValueRef](1)
            eidx.put(0, ivv)
            let eaddr LLVMBuildInBoundsGEP2(builder, ety, datap, eidx.data, 1, "walk.e")
            emit_region_value_at(fn, rr, eaddr, elem)
            let ivn LLVMBuildAdd(builder, ivv, one, "walk.inc")
            let stn LLVMBuildStore(builder, ivn, iv)
            LLVMBuildBr(builder, head_bb)

            LLVMPositionBuilderAtEnd(builder, exit_bb)
        }

        ; Vector[T] = { length @0, data @1 }: fix data, then walk the elements
        ; when T carries pointers. All loads align 1 — an embedded Vector in a
        ; union payload sits at byte offset 1.
        procedure emit_region_vector_body(this, fn: LLVMValueRef, rr: LLVMValueRef, obj: LLVMValueRef, t: PlannedType)
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var vfields Vector[LLVMTypeRef](2)
            vfields.put(0, i64_ty)
            vfields.put(1, ptr_ty)
            let vty LLVMStructTypeInContext(context, vfields.data, 2, 0)

            let data_slot LLVMBuildStructGEP2(builder, vty, obj, 1, "walk.vdata")
            let dv emit_region_fix_slot(rr, data_slot)

            if t.generics = null
                return
            let gens (*t.generics)
            if gens.length = 0
                return
            let ep gens.get 0
            if ep = null
                return
            let elem (*ep)
            if region_field_acts(elem) = false
                return

            let len_ptr LLVMBuildStructGEP2(builder, vty, obj, 0, "walk.vlen.ptr")
            let len LLVMBuildLoad2(builder, i64_ty, len_ptr, "walk.vlen")
            LLVMSetAlignment(len, 1)
            emit_region_elem_loop(fn, rr, dv, len, elem)
        }

        ; Array[T] = { length @0, vector: pointer[Vector[T]] @1 }: fix the
        ; vector pointer, fix the backing vector's data slot, walk the VALID
        ; prefix (array.length — the backing capacity tail is zeroed).
        procedure emit_region_array_body(this, fn: LLVMValueRef, rr: LLVMValueRef, obj: LLVMValueRef, t: PlannedType)
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            var afields Vector[LLVMTypeRef](2)
            afields.put(0, i64_ty)
            afields.put(1, ptr_ty)
            let aty LLVMStructTypeInContext(context, afields.data, 2, 0)

            let vec_slot LLVMBuildStructGEP2(builder, aty, obj, 1, "walk.avec")
            let vv emit_region_fix_slot(rr, vec_slot)

            let zero LLVMConstInt(i64_ty, 0, 0)
            let isnn LLVMBuildICmp(builder, LLVMIntPredicate.NE(), vv, zero, "walk.ann")
            let in_bb LLVMAppendBasicBlockInContext(context, fn, "walk.avec.in")
            let out_bb LLVMAppendBasicBlockInContext(context, fn, "walk.avec.out")
            LLVMBuildCondBr(builder, isnn, in_bb, out_bb)

            LLVMPositionBuilderAtEnd(builder, in_bb)
            let vecp LLVMBuildIntToPtr(builder, vv, ptr_ty, "walk.avecp")
            let data_slot LLVMBuildStructGEP2(builder, aty, vecp, 1, "walk.adata")
            let dv emit_region_fix_slot(rr, data_slot)

            var elem_acts: bool false
            var elem: PlannedType Planner.make_void_type()
            if t.generics <> null
            {
                let gens (*t.generics)
                if gens.length > 0
                {
                    let ep gens.get 0
                    if ep <> null
                    {
                        set elem: (*ep)
                        set elem_acts: region_field_acts((*ep))
                    }
                }
            }
            if elem_acts
            {
                let len_ptr LLVMBuildStructGEP2(builder, aty, obj, 0, "walk.alen.ptr")
                let len LLVMBuildLoad2(builder, i64_ty, len_ptr, "walk.alen")
                LLVMSetAlignment(len, 1)
                emit_region_elem_loop(fn, rr, dv, len, elem)
            }
            LLVMBuildBr(builder, out_bb)
            LLVMPositionBuilderAtEnd(builder, out_bb)
        }

        ; Node[T] = { element @0, next @1 }: walk the CHAIN iteratively — a
        ; per-node recursive walker would recurse list-length deep.
        procedure emit_region_node_body(this, fn: LLVMValueRef, rr: LLVMValueRef, obj: LLVMValueRef, t: PlannedType)
        {
            let i64_ty LLVMInt64TypeInContext(context)
            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let nty map_type t
            if LLVMGetTypeKind(nty) <> LLVMTypeKind.Struct()
            {
                scaly_eputs "emit_region_node_body: no layout for Node"
                scaly_eputs "\n"
                exit 18
            }

            var elem_acts: bool false
            var elem: PlannedType Planner.make_void_type()
            if t.generics <> null
            {
                let gens (*t.generics)
                if gens.length > 0
                {
                    let ep gens.get 0
                    if ep <> null
                    {
                        set elem: (*ep)
                        set elem_acts: region_field_acts((*ep))
                    }
                }
            }

            let cur LLVMBuildAlloca(builder, ptr_ty, "walk.nd")
            let st0 LLVMBuildStore(builder, obj, cur)
            let loop_bb LLVMAppendBasicBlockInContext(context, fn, "walk.chain")
            let exit_bb LLVMAppendBasicBlockInContext(context, fn, "walk.chain.exit")
            LLVMBuildBr(builder, loop_bb)

            LLVMPositionBuilderAtEnd(builder, loop_bb)
            let curv LLVMBuildLoad2(builder, ptr_ty, cur, "walk.ndv")
            if elem_acts
            {
                let eaddr LLVMBuildStructGEP2(builder, nty, curv, 0, "walk.nelem")
                emit_region_value_at(fn, rr, eaddr, elem)
            }
            let next_slot LLVMBuildStructGEP2(builder, nty, curv, 1, "walk.nnext")
            let nv emit_region_fix_slot(rr, next_slot)
            let zero LLVMConstInt(i64_ty, 0, 0)
            let cont LLVMBuildICmp(builder, LLVMIntPredicate.NE(), nv, zero, "walk.ncont")
            let np LLVMBuildIntToPtr(builder, nv, ptr_ty, "walk.np")
            let stn LLVMBuildStore(builder, np, cur)
            LLVMBuildCondBr(builder, cont, loop_bb, exit_bb)

            LLVMPositionBuilderAtEnd(builder, exit_bb)
        }

        ; Tagged union { tag @0 (i8; i32 past 256 variants), payload @tag_size }:
        ; switch on the tag, handle the live variant's payload in place. An
        ; unknown tag falls through silently, matching choose semantics.
        procedure emit_region_union_body(this, fn: LLVMValueRef, rr: LLVMValueRef, obj: LLVMValueRef, u: PlannedUnion)
        {
            if u.variants = null
                return
            let vars (*u.variants)
            let i8_ty LLVMInt8TypeInContext(context)
            let i64_ty LLVMInt64TypeInContext(context)
            var tag_ty i8_ty
            var tag_size: size_t 1
            if vars.length > 256
            {
                set tag_ty: LLVMInt32TypeInContext(context)
                set tag_size: 4
            }
            let tag LLVMBuildLoad2(builder, tag_ty, obj, "walk.tag")
            LLVMSetAlignment(tag, 1)
            var pidx Vector[LLVMValueRef](1)
            pidx.put(0, LLVMConstInt(i64_ty, tag_size, 0))
            let payload LLVMBuildInBoundsGEP2(builder, i8_ty, obj, pidx.data, 1, "walk.pay")

            var act_count: size_t 0
            var vi: size_t 0
            while vi < vars.length
            {
                let v_ptr vars.get vi
                if v_ptr <> null
                {
                    if v_ptr.var_type <> null
                    {
                        if region_field_acts((*v_ptr.var_type))
                            set act_count: act_count + 1
                    }
                }
                set vi: vi + 1
            }

            let merge_bb LLVMAppendBasicBlockInContext(context, fn, "walk.usw.end")
            let sw LLVMBuildSwitch(builder, tag, merge_bb, act_count as int)
            set vi: 0
            while vi < vars.length
            {
                let v_ptr vars.get vi
                if v_ptr <> null
                {
                    if v_ptr.var_type <> null
                    {
                        let vt (*v_ptr.var_type)
                        if region_field_acts(vt)
                        {
                            let case_bb LLVMAppendBasicBlockInContext(context, fn, "walk.ucase")
                            LLVMAddCase(sw, LLVMConstInt(tag_ty, v_ptr.tag as size_t, 0), case_bb)
                            LLVMPositionBuilderAtEnd(builder, case_bb)
                            emit_region_value_at(fn, rr, payload, vt)
                            LLVMBuildBr(builder, merge_bb)
                        }
                    }
                }
                set vi: vi + 1
            }
            LLVMPositionBuilderAtEnd(builder, merge_bb)
        }

        procedure emit_region_walk_body(this, fn: LLVMValueRef, rr: LLVMValueRef, obj: LLVMValueRef, t: PlannedType)
        {
            ; A pointer-like ROOT (walker of a pointer type): obj IS the slot.
            if region_is_ptr_slot(t)
            {
                emit_region_value_at(fn, rr, obj, t)
                return
            }
            if t.name = "String"
            {
                let sv emit_region_fix_slot(rr, obj)
                return
            }
            if t.name = "Vector"
            {
                emit_region_vector_body(fn, rr, obj, t)
                return
            }
            if t.name = "Array"
            {
                emit_region_array_body(fn, rr, obj, t)
                return
            }
            if t.name = "Node"
            {
                emit_region_node_body(fn, rr, obj, t)
                return
            }

            let s_ref find_planned_structure(t.mangled_name, t.name)
            if s_ref <> null
            {
                let sty map_type t
                if LLVMGetTypeKind(sty) <> LLVMTypeKind.Struct()
                {
                    scaly_eputs "emit_region_walk_body: no struct layout for message type: "
                    let lless_name t.name.to_c_string()
                    scaly_eputs lless_name
                    scaly_eputs "\n"
                    exit 18
                }
                if s_ref.properties <> null
                {
                    let props (*s_ref.properties)
                    var pi: size_t 0
                    while pi < props.length
                    {
                        let p_ptr props.get pi
                        if p_ptr <> null
                        {
                            let ft p_ptr.prop_type
                            if region_field_acts(ft)
                            {
                                let faddr LLVMBuildStructGEP2(builder, sty, obj, pi as int, "walk.f")
                                emit_region_value_at(fn, rr, faddr, ft)
                            }
                        }
                        set pi: pi + 1
                    }
                }
                return
            }

            let u_ref find_planned_union(t.mangled_name, t.name)
            if u_ref <> null
            {
                emit_region_union_body(fn, rr, obj, (*u_ref))
                return
            }

            ; The planner validated the closure — reaching here is a compiler
            ; bug; fail LOUD (the silent-drop lesson).
            scaly_eputs "emit_region_walk_body: no layout for message type: "
            let lless_name2 t.name.to_c_string()
            scaly_eputs lless_name2
            scaly_eputs "\n"
            exit 18
        }

        function ensure_region_walker(this, t: PlannedType) returns LLVMValueRef
        {
            let sym region_walker_symbol t
            var wi: size_t 0
            while wi < region_walkers.length
            {
                let wp region_walkers.get wi
                if wp <> null
                {
                    if (*wp) = sym
                        return LLVMGetNamedFunction(llvm_module, sym.c_data())
                }
                set wi: wi + 1
            }
            region_walkers.add(String^this(sym))

            var fn LLVMGetNamedFunction(llvm_module, sym.c_data())
            if fn.handle = null
                set fn: LLVMAddFunction(llvm_module, sym.c_data(), region_walker_fn_type())
            set_linkonce_odr(fn)

            let saved_block LLVMGetInsertBlock(builder)
            let entry LLVMAppendBasicBlockInContext(context, fn, "entry")
            LLVMPositionBuilderAtEnd(builder, entry)
            let rr LLVMGetParam(fn, 0)
            let obj LLVMGetParam(fn, 1)
            emit_region_walk_body(fn, rr, obj, t)
            LLVMBuildRetVoid builder
            if saved_block.handle <> null
                LLVMPositionBuilderAtEnd(builder, saved_block)
            fn
        }

        ; Entry from emit_call: derive the root type from the call's last
        ; argument (pointer[T] — the planner validated the shape) and make
        ; sure the walker set exists before the call is emitted.
        procedure ensure_region_walker_for_call(this, call: PlannedCall)
        {
            if call.args = null
                return
            let cargs (*call.args)
            if cargs.length = 0
                return
            let last_ptr cargs.get(cargs.length - 1)
            if last_ptr = null
                return
            let rt (*last_ptr).result_type
            if rt.name <> "pointer"
                return
            if rt.generics = null
                return
            let gens (*rt.generics)
            if gens.length = 0
                return
            let gp gens.get 0
            if gp = null
                return
            let wfn ensure_region_walker((*gp))
        }

        function emit_call(this, call: PlannedCall) returns LLVMValueRef
        {
            ; Indirect call through a function pointer value (Phase-1 JIT). args[0]
            ; is the callee pointer; the signature is i64() (zero-arg, returns i64).
            ; Used by jit_execute_int to invoke an ORC-resolved address. Mirrors
            ; stage-0 emitCall's IsIndirect branch.
            if call.is_indirect
            {
                if call.args <> null
                {
                    let ic_args (*call.args)
                    if ic_args.length > 0
                    {
                        let callee_ptr ic_args.get 0
                        if callee_ptr <> null
                        {
                            let callee_val emit_operand(*callee_ptr)
                            ; Phase-1 JIT (`cli --run`) zero-arg i64() invoke — the
                            ; callee value is itself the function address.
                            if call.name = "__jit_indirect"
                            {
                                let i64_ty LLVMInt64TypeInContext(context)
                                let n_jargs ic_args.length - 1
                                if n_jargs = 0
                                {
                                    let jit_ty LLVMFunctionType(i64_ty, null as pointer[LLVMTypeRef], 0, 0)
                                    return LLVMBuildCall2(builder, jit_ty, callee_val, null as pointer[LLVMValueRef], 0, "jit.call")
                                }
                                ; With arguments: i64(argtypes...) built from the
                                ; planned operand types, the callee value itself is
                                ; the address. dazzle's Stage-6b trampoline calls a
                                ; JIT-compiled region this way, passing the VM.
                                var jarg_tys Vector[LLVMTypeRef](n_jargs)
                                var jarg_vals Vector[LLVMValueRef](n_jargs)
                                var jk: size_t 1
                                while jk < ic_args.length
                                {
                                    let ja_ptr ic_args.get jk
                                    if ja_ptr <> null
                                    {
                                        let jav emit_operand(*ja_ptr)
                                        jarg_vals.put(jk - 1, jav)
                                        jarg_tys.put(jk - 1, map_type((*ja_ptr).result_type))
                                    }
                                    set jk: jk + 1
                                }
                                let jfn_ty LLVMFunctionType(i64_ty, jarg_tys.data, n_jargs as u32, 0)
                                return LLVMBuildCall2(builder, jfn_ty, callee_val, jarg_vals.data, n_jargs as u32, "jit.call")
                            }
                            ; GAP B closure indirect call. `callee_val` is a closure
                            ; record pointer `{ ptr thunk, caps... }`. Load the thunk
                            ; (field 0, at offset 0 → a plain ptr load) and call it
                            ; as `thunk(record, args...)`. The thunk signature is
                            ; R(ptr self, params...); build it from the planned arg
                            ; types + the call's result type.
                            let ptr_ty LLVMPointerTypeInContext(context, 0)
                            let thunk LLVMBuildLoad2(builder, ptr_ty, callee_val, "clo.thunk")
                            let n_args ic_args.length
                            var arg_tys Vector[LLVMTypeRef](n_args)
                            var arg_vals Vector[LLVMValueRef](n_args)
                            arg_vals.put(0, callee_val)
                            arg_tys.put(0, ptr_ty)
                            var k: size_t 1
                            while k < ic_args.length
                            {
                                let a_ptr ic_args.get k
                                if a_ptr <> null
                                {
                                    let av emit_operand(*a_ptr)
                                    arg_vals.put(k, av)
                                    arg_tys.put(k, map_type((*a_ptr).result_type))
                                }
                                set k: k + 1
                            }
                            let ret_ty map_type(call.result_type)
                            let fn_ty LLVMFunctionType(ret_ty, arg_tys.data, n_args as u32, 0)
                            return LLVMBuildCall2(builder, fn_ty, thunk, arg_vals.data, n_args as u32, "")
                        }
                    }
                }
                return LLVMValueRef null
            }

            ; Check if this is an intrinsic operator
            if call.is_intrinsic
            {
                if call.is_operator
                    return emit_intrinsic_operator call
                else
                    return emit_intrinsic_function call
            }

            ; M2.3: scaly_atomic_* extern names lower to atomic instructions,
            ; never to calls (no such symbols exist at link time).
            let atomic_val emit_atomic_call call
            if atomic_val.handle <> null
                return atomic_val

            ; M2.3b: scaly_call_ptr lowers to an indirect ptr(ptr) call.
            let indirect_val emit_ptr_call call
            if indirect_val.handle <> null
                return indirect_val

            ; Stage 7.2: rr.fix_graph(root) resolved to `_scaly_walk_<T>` —
            ; define the walker bodies on first call; the call itself then
            ; goes through the normal path below.
            if call.mangled_name.starts_with("_scaly_walk_")
                ensure_region_walker_for_call call

            ; s80: Itanium C1 constructor calls — mangled name contains "C1E"
            ; between the class encoding and parameter encoding. Allocate the
            ; struct (heap or stack based on call.life), pass struct ptr as
            ; first arg, page as second (if requires_page_param), then user
            ; args. Return struct ptr (the ctor itself returns void). Mirrors
            ; stage-0 Emitter.cpp:3308+ IsInitializerCall handling.
            if call.mangled_name.contains("C1E")
                return emit_constructor_call call

            ; Look up the function
            var func lookup_function_cache call.mangled_name
            if func.handle = null
            {
                ; Try to find it in the module
                set func: LLVMGetNamedFunction(llvm_module, call.mangled_name.c_data())
                if func.handle = null
                {
                    ; s186: cross-package runtime callee with a resolved
                    ; mangled name but no in-module decl (e.g. scaly_eputs /
                    ; scaly_eputnl from root_pages.scaly — stage-0 emits full
                    ; bodies into the module, stage-1's planner does not, so the
                    ; symbol lives only in libscaly.a). The planner-side s185
                    ; diagnostic already hard-errors genuinely unresolved calls,
                    ; so a non-empty mangled name here is a real symbol resolved
                    ; at link time. Declare it as an external varargs function
                    ; (same cosmetic-signature pattern as memcpy/memset and
                    ; Page.allocate_root_page below — every call path builds its
                    ; own concrete func_type for LLVMBuildCall2). Without this
                    ; the call was silently dropped: not_implemented's stderr
                    ; prints vanished from every stage-2+ binary.
                    if call.mangled_name.get_length() = 0
                        return LLVMValueRef null
                    var decl_ret map_intrinsic_type_by_name call.result_type.name
                    if decl_ret.handle = null
                        set decl_ret: map_type(call.result_type)
                    let decl_ty LLVMFunctionType(decl_ret, null as pointer[LLVMTypeRef], 0, 1)
                    set func: LLVMAddFunction(llvm_module, call.mangled_name.c_data(), decl_ty)
                    LLVMSetLinkage(func, LLVMLinkage.External())
                    cache_function(call.mangled_name, func)
                }
            }

            ; s89: Detect sret-style call. Itanium-mangled callees with a
            ; non-primitive non-pointer/ref return type use stage-0's sret
            ; pattern: alloca a slot, pass slot ptr (with sret + noalias)
            ; as first arg, call returns void, then load from slot. Required
            ; to match libscaly.a's stage-0-emitted callees.
            var use_sret call_needs_sret(call.mangled_name, call.result_type)
            ; s194: every throws CALL receives the Result-wrapper sret slot,
            ; matching emit_function_decl's forced sret. Mirrors the decl-side
            ; wrap-base logic so build_throws_result_type (cached per mangled
            ; name) sees a consistent base type from either side.
            var call_can_throw_sret: bool false
            if call.can_throw
            {
                if call.throws_type <> null
                {
                    set use_sret: true
                    set call_can_throw_sret: true
                }
            }
            var sret_slot LLVMValueRef(null)
            var sret_element_ty LLVMTypeRef(null)
            if use_sret
            {
                let mapped map_type call.result_type
                if call_can_throw_sret
                {
                    var wrap_base mapped
                    if LLVMGetTypeKind(mapped) = LLVMTypeKind.Pointer()
                    {
                        var rt_is_ref: bool false
                        if call.result_type.name = "pointer"
                            set rt_is_ref: true
                        if call.result_type.name = "ref"
                            set rt_is_ref: true
                        if is_npo_option(call.result_type)
                            set rt_is_ref: true
                        if rt_is_ref = false
                            set wrap_base: get_or_create_struct_placeholder(call.result_type.name, call.result_type.mangled_name)
                    }
                    ; Match the decl-side wrapper size: max(T, throws_ty).
                    var throws_llvm LLVMTypeRef(null)
                    if call.throws_type <> null
                        set throws_llvm: map_type((*call.throws_type.unwrap()))
                    set sret_element_ty: build_throws_result_type(wrap_base, throws_llvm, call.mangled_name)
                }
                if call_can_throw_sret = false
                {
                    if LLVMGetTypeKind(mapped) = LLVMTypeKind.Struct()
                        set sret_element_ty: mapped
                    if sret_element_ty.handle = null
                        set sret_element_ty: get_or_create_struct_placeholder(call.result_type.name, call.result_type.mangled_name)
                }
                set sret_slot: acquire_temp(sret_element_ty, "sret.result")
            }

            ; Build arguments
            ; For now, handle simple case without arguments
            if call.args = null
            {
                if use_sret
                {
                    var sa Vector[LLVMValueRef](1)
                    var sp Vector[LLVMTypeRef](1)
                    sa.put(0, sret_slot)
                    sp.put(0, LLVMPointerTypeInContext(context, 0))
                    let void_ty LLVMVoidTypeInContext(context)
                    let f_ty LLVMFunctionType(void_ty, sp.data, 1, 0)
                    let cv LLVMBuildCall2(builder, f_ty, func, sa.data, 1, "")
                    let sk sret_kind_id()
                    let nk noalias_kind_id()
                    let sa_attr LLVMCreateTypeAttribute(context, sk, sret_element_ty)
                    LLVMAddCallSiteAttribute(cv, 1, sa_attr)
                    let na_attr LLVMCreateEnumAttribute(context, nk, 0)
                    LLVMAddCallSiteAttribute(cv, 1, na_attr)
                    return sret_slot
                }
                var result_type map_type call.result_type
                ; s124: when the declared function returns void (procedure),
                ; force result_type to void here too so the call name is
                ; empty. map_type falls back to opaque ptr for empty/unknown
                ; result names, which LLVM otherwise treats as a non-void
                ; result type. llc then rejects `%call = call void @fn()` with
                ; "instructions returning void cannot have a name".
                let fn_ty LLVMGlobalGetValueType(func)
                if fn_ty.handle <> null
                {
                    if LLVMGetTypeKind(fn_ty) = LLVMTypeKind.FunctionKind()
                    {
                        let ret_ty LLVMGetReturnType(fn_ty)
                        if LLVMGetTypeKind(ret_ty) = LLVMTypeKind.Void()
                            set result_type: ret_ty
                    }
                }
                let func_type LLVMFunctionType(result_type, null as pointer[LLVMTypeRef], 0, 0)
                var call_name "call"
                if LLVMGetTypeKind(result_type) = LLVMTypeKind.Void()
                    set call_name: ""
                return LLVMBuildCall2(builder, func_type, func, null as pointer[LLVMValueRef], 0, call_name)
            }

            ; s168: zero-user-arg shortcut. SKIP it when the call needs an
            ; implicit page (rp) arg — a `function#` callee with no explicit
            ; args (e.g. `Planner.make_void_type()`) must still receive rp in
            ; slot 0 (after sret). The old shortcut passed only the sret and
            ; dropped rp, so the callee read garbage in its page param and
            ; Page::allocate crashed with a null/garbage page. Falling through
            ; to the general path below handles page_offset + sret + zero user
            ; args correctly (the user-arg while loop is a no-op).
            if call.args.length = 0
            {
                if call.requires_page_param = false
                {
                    if use_sret
                    {
                        var sa Vector[LLVMValueRef](1)
                        var sp Vector[LLVMTypeRef](1)
                        sa.put(0, sret_slot)
                        sp.put(0, LLVMPointerTypeInContext(context, 0))
                        let void_ty LLVMVoidTypeInContext(context)
                        let f_ty LLVMFunctionType(void_ty, sp.data, 1, 0)
                        let cv LLVMBuildCall2(builder, f_ty, func, sa.data, 1, "")
                        let sk sret_kind_id()
                        let nk noalias_kind_id()
                        let sa_attr LLVMCreateTypeAttribute(context, sk, sret_element_ty)
                        LLVMAddCallSiteAttribute(cv, 1, sa_attr)
                        let na_attr LLVMCreateEnumAttribute(context, nk, 0)
                        LLVMAddCallSiteAttribute(cv, 1, na_attr)
                        return sret_slot
                    }
                    var result_type map_type call.result_type
                    ; s124: same void-return if as the call.args=null path.
                    let fn_ty LLVMGlobalGetValueType(func)
                    if fn_ty.handle <> null
                    {
                        if LLVMGetTypeKind(fn_ty) = LLVMTypeKind.FunctionKind()
                        {
                            let ret_ty LLVMGetReturnType(fn_ty)
                            if LLVMGetTypeKind(ret_ty) = LLVMTypeKind.Void()
                                set result_type: ret_ty
                        }
                    }
                    let func_type LLVMFunctionType(result_type, null as pointer[LLVMTypeRef], 0, 0)
                    var call_name "call"
                    if LLVMGetTypeKind(result_type) = LLVMTypeKind.Void()
                        set call_name: ""
                    return LLVMBuildCall2(builder, func_type, func, null as pointer[LLVMValueRef], 0, call_name)
                }
            }

            ; Emit arguments and create proper call.
            ; When call.requires_page_param is set, prepend an rp arg in
            ; slot 0. Source: caller's `rp` local var if it has a page
            ; parameter (function# caller), else lazily call
            ; `_ZN4Page18allocate_root_pageEv`. Mirrors stage-0's
            ; getOrCreateLocalPage fallback at Emitter.cpp:6657-6681.
            var page_offset: size_t 0
            var page_arg: LLVMValueRef LLVMValueRef(null)
            if call.requires_page_param
            {
                set page_offset: 1
                ; s196: honor a `^name` reference lifetime FIRST (e.g.
                ; `list.add^own_page(...)`). The named page is where the callee's
                ; allocations must land — typically a persistent page (own_page,
                ; this's page). Routing these through the caller's local page
                ; (the old behavior) put escaping nodes on a page that is released
                ; on exit, corrupting the structure once the local page is reused.
                var ref_name2: String ""
                var has_ref2: bool false
                var has_local2: bool false
                choose call.life
                    when r: Lifetime.Reference
                    {
                        set has_ref2: true
                        set ref_name2: r.location
                    }
                    when l: Lifetime.Local
                        set has_local2: true
                    else
                        0
                ; ★This is the site the frame chain exists for. The argument is a
                ; FRAME, never a materialised page: forming it costs an address,
                ; and the callee opens the region only if it really allocates.
                ; Measured on the DSSSL engine, 13.57 million regions per document
                ; are never opened again because of exactly this.
                if has_ref2
                    set page_arg: resolve_reference_frame(ref_name2)
                ; design-B item 2 (THE LEVER): a `$` on a plain call routes the result
                ; to THIS function's local page (force-created on demand), not the
                ; caller's rp. The local page is fully torn down at function exit
                ; (always-free-local), so the transient is reclaimed. Safe because the
                ; escape checker (item 3) rejects any $-call whose result escapes.
                ; Mirrors stage-0 Emitter.cpp FuncPageArg LocalLifetime arm.
                if has_local2
                    set page_arg: get_local_frame()
                ; Otherwise (or if the named var wasn't in scope): the caller's rp,
                ; else this function's single local root page (released on exit).
                if page_arg.handle = null
                {
                    let rp_val lookup_variable("_rp")
                    if rp_val.handle <> null
                        set page_arg: rp_val
                    if page_arg.handle = null
                        set page_arg: get_local_frame()
                }
            }

            var sret_offset: size_t 0
            if use_sret
                set sret_offset: 1

            let user_arg_count call.args.length
            let total_arg_count user_arg_count + page_offset + sret_offset
            ; Result type — prefer the by-name primitive lookup over
            ; map_type's Vector cache, since the Vector cache is
            ; unreliable when its entry pages get reused (s71 class).
            ; Fall back to map_type for non-primitive (struct/pointer)
            ; result types.
            var result_type map_intrinsic_type_by_name call.result_type.name
            if result_type.handle = null
                set result_type: map_type(call.result_type)
            ; s89: when sret applies, the IR call returns void.
            if use_sret
                set result_type: LLVMVoidTypeInContext(context)

            ; Build args vector - allocate with page
            var args_array Vector[LLVMValueRef](total_arg_count)
            var param_types Vector[LLVMTypeRef](total_arg_count)

            if use_sret
            {
                args_array.put(0, sret_slot)
                param_types.put(0, LLVMPointerTypeInContext(context, 0))
            }

            if page_offset = 1
            {
                args_array.put(sret_offset, page_arg)
                param_types.put(sret_offset, LLVMPointerTypeInContext(context, 0))
            }

            ; Emit each user argument
            var i: size_t 0
            while i < user_arg_count
            {
                let arg_ptr call.args.get i
                if arg_ptr <> null
                {
                    let arg_operand arg_ptr.unwrap()

                    ; s101: Procedure-receiver pass-by-alloca. When the arg
                    ; is a mutable variable whose alloca holds a struct
                    ; directly (not a heap pointer), pass the alloca pointer
                    ; instead of loading the struct and re-storing into an
                    ; arg.tmp shim. Without this, mutations through procedure
                    ; params can't propagate back to the caller's variable.
                    ; Mirrors stage-0 Emitter.cpp:3418-3438. Skipped for
                    ; extern LLVM calls (those expect handle-extracted
                    ; scalars).
                    var arg_value LLVMValueRef(null)
                    var direct_alloca: bool false
                    if arg_operand.member_access = null
                    {
                        choose arg_operand.expr
                            when v: Variable
                            {
                                if v.is_mutable
                                {
                                    if call.mangled_name.starts_with("LLVM") = false
                                    {
                                        let var_ptr lookup_variable v.name
                                        if var_ptr.handle <> null
                                        {
                                            let is_alloca LLVMIsAAllocaInst(var_ptr)
                                            if is_alloca.handle <> null
                                            {
                                                let alloc_ty LLVMGetAllocatedType(var_ptr)
                                                if alloc_ty.handle <> null
                                                {
                                                    if LLVMGetTypeKind(alloc_ty) = LLVMTypeKind.Struct()
                                                    {
                                                        set arg_value: var_ptr
                                                        set direct_alloca: true
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            else
                                0
                    }

                    ; s102: In-place field GEP for chained-access receivers.
                    ; When the arg is `var.field1.field2...` (Variable + a
                    ; field-only chain), GEP from the variable's storage to
                    ; the final field instead of load+extractvalue+arg.tmp.
                    ; Required for `this.inner.set_value()` where mutations
                    ; to inner must propagate back. Mirrors stage-0's
                    ; FirstArgFieldBasePtr in-place path (Emitter.cpp:
                    ; 3984-3994). Skipped for extern LLVM calls and chains
                    ; with method hops.
                    if direct_alloca = false
                    {
                        if arg_operand.member_access <> null
                        {
                            if call.mangled_name.starts_with("LLVM") = false
                            {
                                let chain (*arg_operand.member_access)
                                if chain.length > 0
                                {
                                    var has_method: bool false
                                    var ci0: size_t 0
                                    while ci0 < chain.length
                                    {
                                        let acc_ptr0 chain.get ci0
                                        if acc_ptr0 <> null
                                        {
                                            if (*acc_ptr0).is_method
                                                set has_method: true
                                        }
                                        set ci0: ci0 + 1
                                    }
                                    if has_method = false
                                    {
                                        choose arg_operand.expr
                                            when v: Variable
                                            {
                                                let var_ptr lookup_variable v.name
                                                if var_ptr.handle <> null
                                                {
                                                    let val_ty LLVMTypeOf(var_ptr)
                                                    if LLVMGetTypeKind(val_ty) = LLVMTypeKind.Pointer()
                                                    {
                                                        let first_ptr chain.get 0
                                                        if first_ptr <> null
                                                        {
                                                            let first_acc (*first_ptr)
                                                            var current_struct_ty map_type first_acc.parent_type
                                                            if LLVMGetTypeKind(current_struct_ty) = LLVMTypeKind.Struct()
                                                            {
                                                                var current_ptr var_ptr
                                                                ; s175: a region-allocated binding (`var opts
                                                                ; Options()`) allocas a ptr SLOT holding the
                                                                ; heap address (s27); GEPing the slot directly
                                                                ; lands the field address in stack garbage —
                                                                ; stage-2's parse_args crashed in
                                                                ; Vector[String].add called on
                                                                ; opts.extra_objects with a wild header. Load
                                                                ; the base pointer first, mirroring stage-0's
                                                                ; `load ptr` before the field GEP. Struct-typed
                                                                ; allocas (var x T()) and by-ptr params keep
                                                                ; the direct GEP.
                                                                let base_isa LLVMIsAAllocaInst(current_ptr)
                                                                if base_isa.handle <> null
                                                                {
                                                                    let base_aty LLVMGetAllocatedType(current_ptr)
                                                                    if base_aty.handle <> null
                                                                    {
                                                                        if LLVMGetTypeKind(base_aty) = LLVMTypeKind.Pointer()
                                                                            set current_ptr: LLVMBuildLoad2(builder, LLVMPointerTypeInContext(context, 0), current_ptr, "base.deref")
                                                                    }
                                                                }
                                                                var chain_ok: bool true
                                                                var last_field_is_ptr: bool false
                                                                var last_field_ty LLVMTypeRef(null)
                                                                var ci: size_t 0
                                                                while ci < chain.length
                                                                {
                                                                    let acc_ptr chain.get ci
                                                                    if acc_ptr <> null
                                                                    {
                                                                        ; s120: bail when the next step's parent
                                                                        ; struct type collapsed to opaque `ptr` —
                                                                        ; stage-1's map_type fallback for
                                                                        ; unresolved generics (e.g.
                                                                        ; Array[KeyValuePair[String, LocalBinding]])
                                                                        ; returns ptr, and LLVMBuildStructGEP2 with
                                                                        ; that source type emits
                                                                        ; `getelementptr inbounds ptr, ptr X, i32 0, i32 N`
                                                                        ; which llc rejects with "invalid
                                                                        ; getelementptr indices". Symptom: re-
                                                                        ; including Planner in safe-walk crashes
                                                                        ; -c at push_scope's
                                                                        ; `scope_boundaries.add(scope_bindings.length)`.
                                                                        if LLVMGetTypeKind(current_struct_ty) <> LLVMTypeKind.Struct()
                                                                            set chain_ok: false
                                                                        if chain_ok
                                                                        {
                                                                            let acc (*acc_ptr)
                                                                            ; s122: remember whether the field's
                                                                            ; IR slot is `ptr` (heap-stored, e.g.
                                                                            ; stage-1's `Array[T]^this()` fields)
                                                                            ; vs. an inline struct (e.g.
                                                                            ; `Parser.lexer: Lexer`). Drives the
                                                                            ; post-loop deref-load decision.
                                                                            let field_ir_ty LLVMStructGetTypeAtIndex(current_struct_ty, acc.field_index as int)
                                                                            set last_field_is_ptr: LLVMGetTypeKind(field_ir_ty) = LLVMTypeKind.Pointer()
                                                                            set last_field_ty: field_ir_ty
                                                                            set current_ptr: LLVMBuildStructGEP2(builder, current_struct_ty, current_ptr, acc.field_index as u32, "field.inplace")
                                                                            if ci + 1 < chain.length
                                                                                set current_struct_ty: map_type(acc.result_type)
                                                                        }
                                                                    }
                                                                    set ci: ci + 1
                                                                }
                                                                if chain_ok
                                                                {
                                                                    ; s122: load through if the final field's
                                                                    ; IR slot is `ptr`. Otherwise the callee
                                                                    ; receives `&slot_addr` and reads garbage
                                                                    ; when treating it as the struct start —
                                                                    ; breaks every method receiver whose field
                                                                    ; is heap-stored (`Array[T]^this()`,
                                                                    ; `Vector[T]^this()`, etc.) or genuinely
                                                                    ; `pointer[T]`/`ref[T]`. Inline-struct
                                                                    ; fields (e.g. `Parser.lexer`) keep the
                                                                    ; pre-s122 behavior (pass slot ptr = struct
                                                                    ; start). Mirrors C++ stage-0's reliance on
                                                                    ; inline struct storage at Emitter.cpp:3984.
                                                                    if last_field_is_ptr
                                                                        set current_ptr: LLVMBuildLoad2(builder, LLVMPointerTypeInContext(context, 0), current_ptr, "deref.recv")
                                                                    ; s169: inline scalar final field (e.g. an Array's
                                                                    ; i64 `length`) passed to a by-value scalar param
                                                                    ; (`size_t`) — load the value, don't pass the
                                                                    ; field address. Without this, the in-place GEP
                                                                    ; ptr (a constant `this+offset`) is reinterpreted
                                                                    ; by the callee as the i64 value, corrupting it.
                                                                    ; Symptom: `scope_boundaries.add(scope_bindings.length)`
                                                                    ; pushed `&scope_bindings.length`; pop_scope read it
                                                                    ; back into scope_bindings.length → self-referential
                                                                    ; corruption → SEGV in lookup_local_binding. Struct
                                                                    ; final fields keep the pre-s169 in-place-ptr path
                                                                    ; (real receiver, by-ptr ABI).
                                                                    if last_field_is_ptr = false
                                                                    {
                                                                        if LLVMGetTypeKind(last_field_ty) <> LLVMTypeKind.Struct()
                                                                            set current_ptr: LLVMBuildLoad2(builder, last_field_ty, current_ptr, "field.val")
                                                                    }
                                                                    set arg_value: current_ptr
                                                                    set direct_alloca: true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            else
                                                0
                                    }
                                }
                            }
                        }
                    }

                    ; s200: in-place deref arg. An arg written `(*p)` (paren-group
                    ; deref) or `*p` (bare deref) where p is a pointer to a
                    ; struct-mapped T must pass p's VALUE, not a stack copy:
                    ; emit_operand materializes the deref into a pooled deref.tmp/
                    ; arg.tmp, so the callee mutates a COPY (mutations silently
                    ; lost) and a Page.get(this)-deriving method masks the STACK
                    ; address into a garbage page header — HashMapBuilder<String,
                    ; Nameable>::reallocate SIGBUSed in PageList::add when the
                    ; Modeler's `(*symbols_builder).add(...)` went real (the s189
                    ; denylist lift). Scaly struct args are by-ref at the ABI
                    ; (s101), so the original object pointer is the correct
                    ; operand. Gated to non-extern-LLVM callees, chainless
                    ; operands, struct-mapped pointees, and a pointer-typed inner
                    ; operand; the decision uses PLANNED types only, so the inner
                    ; operand is emitted exactly once (an inner call is never
                    ; double-run).
                    if direct_alloca = false
                    {
                        if arg_operand.member_access = null
                        {
                            if call.mangled_name.starts_with("LLVM") = false
                            {
                                var deref_args: ref[Vector[PlannedOperand]]? null
                                choose arg_operand.expr
                                    when dgrp: PlannedTuple
                                    {
                                        if dgrp.components <> null
                                        {
                                            let dcomps (*dgrp.components)
                                            if dcomps.length = 1
                                            {
                                                let dcomp0 dcomps.get 0
                                                if dcomp0 <> null
                                                {
                                                    if (*dcomp0).name = null
                                                    {
                                                        if (*dcomp0).value <> null
                                                        {
                                                            let dops (*(*dcomp0).value)
                                                            if dops.length = 1
                                                            {
                                                                let dop0 dops.get 0
                                                                if dop0 <> null
                                                                {
                                                                    if (*dop0).member_access = null
                                                                    {
                                                                        choose (*dop0).expr
                                                                            when dcall: PlannedCall
                                                                            {
                                                                                if dcall.is_intrinsic
                                                                                {
                                                                                    if dcall.name = "*"
                                                                                        set deref_args: dcall.args
                                                                                }
                                                                            }
                                                                            else
                                                                                0
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    when dbare: PlannedCall
                                    {
                                        if dbare.is_intrinsic
                                        {
                                            if dbare.name = "*"
                                                set deref_args: dbare.args
                                        }
                                    }
                                    else
                                        0
                                if deref_args <> null
                                {
                                    let dargs (*deref_args)
                                    if dargs.length = 1
                                    {
                                        let dinner_ptr dargs.get 0
                                        if dinner_ptr <> null
                                        {
                                            let dinner (*dinner_ptr)
                                            let pointee_ty map_type arg_operand.result_type
                                            if pointee_ty.handle <> null
                                            {
                                                if LLVMGetTypeKind(pointee_ty) = LLVMTypeKind.Struct()
                                                {
                                                    let dinner_ty map_type dinner.result_type
                                                    if dinner_ty.handle <> null
                                                    {
                                                        if LLVMGetTypeKind(dinner_ty) = LLVMTypeKind.Pointer()
                                                        {
                                                            let pval emit_operand dinner
                                                            if pval.handle <> null
                                                            {
                                                                if LLVMGetTypeKind(LLVMTypeOf pval) = LLVMTypeKind.Pointer()
                                                                {
                                                                    set arg_value: pval
                                                                    set direct_alloca: true
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    ; (String → const_char coercion is handled planner-side: a
                    ; String argument bound to a pointer[const_char]-like param is
                    ; wrapped in a PlannedAs, and emit_as lowers it — constant to
                    ; the plain .str global, variable via get_buffer. The emitter
                    ; cannot decide this itself: a by-value String param and a
                    ; const_char param are both `ptr` at the LLVM level, and a
                    ; generic instantiated method's param is invisible to a scan of
                    ; current_plan.functions.)
                    if direct_alloca = false
                        set arg_value: emit_operand(arg_operand)

                    ; Guard against arg emission returning a null handle
                    ; (e.g. an unsupported cast or unresolved sub-expression).
                    ; Calling LLVMTypeOf on a null Value* crashes; bail out
                    ; cleanly so the s48 fallback in emit_function_body emits
                    ; a degraded `ret <zero>` rather than corrupt IR.
                    if arg_value.handle = null
                        return LLVMValueRef null

                    ; Struct args: emit_function_decl declares struct
                    ; params as `ptr` (line ~832), but emit_operand
                    ; produces the struct value. Without this, the
                    ; callee receives the struct in registers but
                    ; treats the slot as a pointer and SEGVs on the
                    ; first deref. Alloca + store + pass-pointer
                    ; mirrors stage-0's `init.arg.tmp` shim
                    ; (Emitter.cpp:3741-3744). Skipped when we already
                    ; have a pointer from the s101 alloca path.
                    ; s146: extern LLVM-C calls (callee name starts with
                    ; "LLVM") expect single-ptr-field wrapper structs
                    ; (LLVMContextRef = { ptr }) unwrapped to a bare ptr.
                    ; Mirrors stage-0 Emitter.cpp:3964-3981: extractvalue
                    ; the .handle field. Without this, the callee receives
                    ; the address of a stack slot holding the wrapper and
                    ; dereferences garbage — the LLVMModuleCreateWith-
                    ; NameInContext crash in stage-2's Emitter::initialize.
                    if direct_alloca = false
                    {
                        let arg_kind LLVMGetTypeKind(LLVMTypeOf arg_value)
                        if arg_kind = LLVMTypeKind.Struct()
                        {
                            var handled: bool false
                            if call.mangled_name.starts_with("LLVM")
                            {
                                let arg_ty LLVMTypeOf(arg_value)
                                let nelems LLVMCountStructElementTypes(arg_ty)
                                if nelems = 1
                                {
                                    let inner LLVMStructGetTypeAtIndex(arg_ty, 0)
                                    if LLVMGetTypeKind(inner) = LLVMTypeKind.Pointer()
                                    {
                                        set arg_value: LLVMBuildExtractValue(builder, arg_value, 0, "handle")
                                        set handled: true
                                    }
                                }
                            }
                            if handled = false
                            {
                                let arg_alloca acquire_temp(LLVMTypeOf arg_value, "arg.tmp")
                                let av_ty2 LLVMTypeOf(arg_value)
                                copy_struct_value(arg_alloca, arg_value, av_ty2)
                                set arg_value: arg_alloca
                            }
                        }
                        ; s172: same unwrap when the arg is an ALLOCA of a
                        ; single-ptr-field wrapper. A `let v scaly_fn()`
                        ; binding whose callee returns LLVMValueRef via sret
                        ; leaves v as the sret alloca; emit_variable hands
                        ; back the alloca POINTER (kind Pointer, not Struct),
                        ; so the s146 branch above never fires and the LLVM-C
                        ; callee receives a stack address as the handle —
                        ; stage-2's first LLVMAppendBasicBlockInContext
                        ; crashed in BasicBlock::insertInto on exactly this.
                        ; `&var` args are unaffected (direct_alloca=true).
                        ; s175: `&var` args must KEEP the address — the s172/
                        ; s173 unwraps below would load the wrapper through it
                        ; and extract a null/garbage handle. write_object_to_
                        ; file's `LLVMGetTargetFromTriple(triple, &target,
                        ; null)` crashed inside libLLVM storing through a null
                        ; out-pointer because &target (alloca of LLVMTargetRef
                        ; holding null) was unwrapped to target.handle. The
                        ; s172 note "(&var args are unaffected)" was wrong:
                        ; direct_alloca is skipped for LLVM callees, so every
                        ; &var on a single-ptr-field wrapper got unwrapped.
                        ; Stage-0 passes the alloca directly for extern-LLVM
                        ; &var args (s19, Emitter.cpp ~3341).
                        var arg_is_addr_of: bool false
                        choose arg_operand.expr
                            when ac: Call
                            {
                                if ac.name = "&"
                                    set arg_is_addr_of: true
                            }
                            else
                                0
                        if arg_kind = LLVMTypeKind.Pointer()
                        {
                            if arg_is_addr_of = false
                            {
                                if call.mangled_name.starts_with("LLVM")
                                {
                                    let arg_isa LLVMIsAAllocaInst(arg_value)
                                    if arg_isa.handle <> null
                                    {
                                        let arg_aty LLVMGetAllocatedType(arg_value)
                                        if arg_aty.handle <> null
                                        {
                                            if LLVMGetTypeKind(arg_aty) = LLVMTypeKind.Struct()
                                            {
                                                let anelems LLVMCountStructElementTypes(arg_aty)
                                                if anelems = 1
                                                {
                                                    let ainner LLVMStructGetTypeAtIndex(arg_aty, 0)
                                                    if LLVMGetTypeKind(ainner) = LLVMTypeKind.Pointer()
                                                    {
                                                        let wrapper_val LLVMBuildLoad2(builder, arg_aty, arg_value, "wrapper.load")
                                                        set arg_value: LLVMBuildExtractValue(builder, wrapper_val, 0, "handle")
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    ; s173: same unwrap when the arg is a LOAD of a
                                    ; ptr-slot var. `var t map_intrinsic_type_by_name(..)`
                                    ; allocas a ptr slot holding the ADDRESS of the
                                    ; wrapper (sret slot or set-heap copy); emit_variable
                                    ; loads it, so the arg is a LoadInst of kind Pointer
                                    ; whose value points AT the wrapper, not the handle.
                                    ; stage-2's emit_constant passed exactly this to
                                    ; LLVMConstInt and crashed in ConstantInt::get.
                                    ; Gate on the PLANNED arg type naming an LLVM
                                    ; wrapper so bare pointer[T] args (idx_vec.data
                                    ; etc.) are untouched; bare handles from extern
                                    ; LLVM call results are CallInsts, not LoadInsts.
                                    if arg_isa.handle = null
                                    {
                                        let arg_load_isa LLVMIsALoadInst(arg_value)
                                        if arg_load_isa.handle <> null
                                        {
                                            if arg_operand.result_type.name.starts_with("LLVM")
                                            {
                                                let w_ty map_type arg_operand.result_type
                                                if w_ty.handle <> null
                                                {
                                                    if LLVMGetTypeKind(w_ty) = LLVMTypeKind.Struct()
                                                    {
                                                        let wnelems LLVMCountStructElementTypes(w_ty)
                                                        if wnelems = 1
                                                        {
                                                            let winner LLVMStructGetTypeAtIndex(w_ty, 0)
                                                            if LLVMGetTypeKind(winner) = LLVMTypeKind.Pointer()
                                                            {
                                                                let wrapper_val2 LLVMBuildLoad2(builder, w_ty, arg_value, "wrapper.load")
                                                                set arg_value: LLVMBuildExtractValue(builder, wrapper_val2, 0, "handle")
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        ; Same unwrap when the arg is a wrapper-struct
                                        ; PARAM passed straight through (`function f(v:
                                        ; LLVMValueRef) { LLVMDump(v) }`). emit_function_
                                        ; decl declares struct params as ptr-to-struct,
                                        ; so the raw Argument is kind Pointer but is
                                        ; neither an alloca (s172) nor a load (s173) —
                                        ; the old fall-through passed the struct's
                                        ; ADDRESS as the handle (the long-documented
                                        ; "bind it to a local var first" landmine).
                                        ; Bare handles from extern LLVM call results
                                        ; are CallInsts, not Arguments, so the planned-
                                        ; type gate plus the Argument check keeps them
                                        ; untouched.
                                        if arg_load_isa.handle = null
                                        {
                                            let arg_arg_isa LLVMIsAArgument(arg_value)
                                            if arg_arg_isa.handle <> null
                                            {
                                                if arg_operand.result_type.name.starts_with("LLVM")
                                                {
                                                    let p_ty map_type arg_operand.result_type
                                                    if p_ty.handle <> null
                                                    {
                                                        if LLVMGetTypeKind(p_ty) = LLVMTypeKind.Struct()
                                                        {
                                                            let pnelems LLVMCountStructElementTypes(p_ty)
                                                            if pnelems = 1
                                                            {
                                                                let pinner LLVMStructGetTypeAtIndex(p_ty, 0)
                                                                if LLVMGetTypeKind(pinner) = LLVMTypeKind.Pointer()
                                                                {
                                                                    let wrapper_val3 LLVMBuildLoad2(builder, p_ty, arg_value, "wrapper.load")
                                                                    set arg_value: LLVMBuildExtractValue(builder, wrapper_val3, 0, "handle")
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    args_array.put(i + page_offset + sret_offset, arg_value)

                    ; Get parameter type from the emitted value
                    let arg_type LLVMTypeOf(arg_value)
                    param_types.put(i + page_offset + sret_offset, arg_type)
                }
                set i: i + 1
            }

            ; Create function type with parameter types
            let func_type LLVMFunctionType(result_type, param_types.data, total_arg_count as u32, 0)

            ; Build the call with arguments. LLVM rejects naming the
            ; result of a void-returning call (`%foo = call void ...`),
            ; so use the empty name for those calls.
            var call_name "call"
            if LLVMGetTypeKind(result_type) = LLVMTypeKind.Void()
                set call_name: ""
            let call_value LLVMBuildCall2(builder, func_type, func, args_array.data, total_arg_count as u32, call_name)

            ; s89: attach sret + noalias to the call's first arg. Return
            ; the slot pointer (NOT a load of the slot) so downstream
            ; emit_binding/emit_operand sees a `ptr` and treats it the same
            ; way it'd treat baseline's `call ptr @fn(...)` result. Loading
            ; here would yield the inner field of single-pointer-struct
            ; returns (e.g. String's .data) instead of a pointer-to-String,
            ; which `var src f(); src.get_length()` then dispatches with a
            ; nonsense `this`.
            if use_sret
            {
                let sk sret_kind_id()
                let nk noalias_kind_id()
                let sa_attr LLVMCreateTypeAttribute(context, sk, sret_element_ty)
                LLVMAddCallSiteAttribute(call_value, 1, sa_attr)
                let na_attr LLVMCreateEnumAttribute(context, nk, 0)
                LLVMAddCallSiteAttribute(call_value, 1, na_attr)
                return sret_slot
            }

            call_value
        }

        ; ========================================================================
        ; Intrinsic Operator Emission
        ; ========================================================================

        ; Emit an intrinsic operator call
        function emit_intrinsic_operator(this, call: PlannedCall) returns LLVMValueRef
        {
            if call.args = null
                return LLVMValueRef null

            let arg_count call.args.length

            ; Unary operators
            if arg_count = 1
            {
                let arg call.args.get 0
                if arg = null
                    return LLVMValueRef null

                let arg_op arg.unwrap()

                ; s105: `&var` on a mutable struct variable returns the
                ; alloca pointer directly (bypasses emit_variable's load).
                ; Without this, `var x T(); let p &x; (*p).f = 1` mutates
                ; a snapshot in `addr.tmp`, not x. Mirrors stage-0
                ; emitOperand's KeepOriginalPointer + &-shortcut path.
                ; s146: discriminate by alloca's allocated type. For
                ; heap-bound vars (var x Foo^p() / Foo() / Foo()), the
                ; alloca holds a ptr; loading it returns the heap address
                ; callers expect from &x — without this, Plan(&stmts, ...)
                ; stores the stack alloca address into Plan.statements and
                ; the next read after return dereferences freed memory.
                ; For stack-bound mutable structs (var x Foo()), the alloca
                ; holds the struct itself; passthrough returns the alloca
                ; address so `(*p).f = 1` still mutates x in place.
                if call.name = "&"
                {
                    ; `&*x` CANCELS (2026-08-04). A fixed-size stack array decays to
                    ; a pointer variable, so `arr[i]` is planned as `*(arr + i)` —
                    ; a GEP plus a LOAD. Address-of then reached
                    ; emit_intrinsic_unary_op("&") with the loaded VALUE, whose type
                    ; is not a struct, so the `&` fell through `return op` and was a
                    ; silent NO-OP: `&arr[0]` came back as the element's CONTENTS
                    ; (isolated with `set arr[0]: 111` / `set arr[1]: 222` →
                    ; `&arr[0]` = 111, `&arr[1]` = 222), and handing `&buf[0]` to a
                    ; C API passed those contents as a pointer (EFAULT if lucky, a
                    ; wild store if not — how the stack guard's first getrlimit
                    ; probe failed). Emitting the deref's OPERAND yields the address
                    ; the load would have read from, which is exactly `&*x` = x.
                    ; Only when nothing is selected out of the deref: with a
                    ; member_access the address must be a GEP from here into the
                    ; field, which the block below does from its own base.
                    if arg_op.member_access = null
                    {
                        var addr_deref_args: ref[Vector[PlannedOperand]]? null
                        choose arg_op.expr
                            when adc: Call
                            {
                                if adc.is_intrinsic
                                {
                                    if adc.name = "*"
                                        set addr_deref_args: adc.args
                                }
                            }
                            else
                                0
                        if addr_deref_args <> null
                        {
                            let adargs (*addr_deref_args)
                            if adargs.length = 1
                            {
                                let adinner_ptr adargs.get 0
                                if adinner_ptr <> null
                                {
                                    ; Bind the deref before use — `(*p).method()`
                                    ; hands the callee the SLOT address (CLAUDE.md).
                                    let adinner (*adinner_ptr)
                                    return emit_operand adinner
                                }
                            }
                        }
                    }
                    if arg_op.member_access = null
                    {
                        choose arg_op.expr
                            when v: Variable
                            {
                                if v.is_mutable
                                {
                                    let var_ptr lookup_variable v.name
                                    if var_ptr.handle <> null
                                    {
                                        let is_alloca LLVMIsAAllocaInst(var_ptr)
                                        if is_alloca.handle <> null
                                        {
                                            let alloc_ty LLVMGetAllocatedType(var_ptr)
                                            if alloc_ty.handle <> null
                                            {
                                                if LLVMGetTypeKind(alloc_ty) = LLVMTypeKind.Pointer()
                                                {
                                                    ; s146 loads the handle for a heap-bound var
                                                    ; (var x Foo^p(): declared type = concept,
                                                    ; alloca holds the object ptr, &x = that ptr).
                                                    ; But a GENUINE pointer variable (var p:
                                                    ; pointer[T]) also has a ptr alloca — there &p
                                                    ; must be the slot ADDRESS, not p's value, or
                                                    ; `&newpos` passes null (try_transition). Keep
                                                    ; the load only when the declared type isn't
                                                    ; itself a pointer/ref.
                                                    var is_ptr_var: bool false
                                                    if arg_op.result_type.name = "pointer"
                                                        set is_ptr_var: true
                                                    if arg_op.result_type.name = "ref"
                                                        set is_ptr_var: true
                                                    ; s113 wraps `ref[T]?` into Option[ref[T]],
                                                    ; whose NAME is "Option" — so the two tests
                                                    ; above miss a nullable CELL, the load below
                                                    ; fired, and `&p` yielded p's VALUE (null)
                                                    ; instead of its slot address. An NPO Option
                                                    ; IS a bare pointer, so it belongs here.
                                                    ; Cost of the gap: `&<optional cell>` handed
                                                    ; to a `pointer[pointer[X]]` out-param stored
                                                    ; through NULL — `str x0, [x8]` with x8 = 0,
                                                    ; silent at compile time (the free-function
                                                    ; path refuses the same call as a type
                                                    ; mismatch; only the METHOD path reached the
                                                    ; emitter), 98 sites at once, 380 -> 20 ESIS.
                                                    if is_npo_option(arg_op.result_type)
                                                        set is_ptr_var: true
                                                    if is_ptr_var = false
                                                    {
                                                        let ptr_ty LLVMPointerTypeInContext(context, 0)
                                                        return LLVMBuildLoad2(builder, ptr_ty, var_ptr, "addr.heap")
                                                    }
                                                }
                                            }
                                        }
                                        return var_ptr
                                    }
                                }
                            }
                            else
                                0
                    }
                    ; `&X.field` (address-of a member access): return a GEP
                    ; into the ORIGINAL storage, not a pointer to a stack copy.
                    ; Without this, emit_operand below materialises the field
                    ; VALUE into a temp and emit_intrinsic_unary_op spills it to
                    ; `addr.tmp` (a stack slot), so `return &old_current.element`
                    ; (ListIterator.next) returned a dangling stack address —
                    ; every iterator / HashMap reference (List/BuilderList/
                    ; HashMap/the keyword HashSet) read back garbage in
                    ; stage-emitted code. Mirrors stage-0's `&`-GEP path
                    ; (Emitter.cpp:3506-3536): walk the planned member-access
                    ; chain emitting LLVMBuildStructGEP2 from the base pointer.
                    if arg_op.member_access <> null
                    {
                        let ma_ref arg_op.member_access.unwrap()
                        let ma_chain (*ma_ref)
                        ; 2026-08-09: a POINTER-typed field is GEPed like every
                        ; other one. It used to fall through to the fallback below,
                        ; which returns the emitted operand — the field's VALUE —
                        ; so `&probe.sbase` answered the loaded null while
                        ; `&probe.sp` beside it answered the correct offset. The
                        ; carried-over stage-0 rule (Emitter.cpp:3513) reads as a
                        ; statement about indirection, but what it really did was
                        ; compensate for the for-loop: PageListIterator.next
                        ; returns `&node.page`, declared pointer[pointer[Page]],
                        ; and the loop bound its variable to that result WITHOUT
                        ; loading, so a lying `&` and a missing load cancelled.
                        ; The load is now in plan_for# (element_is_scalar covers a
                        ; pointer element), and the two halves must land together.
                        ; What the compensation cost everywhere it did NOT apply,
                        ; all silent: `for e in <Vector/Array of pointers>` yielded
                        ; slot addresses, `Vector[pointer[X]](list)` SIGSEGVed in
                        ; its `*item` copy, and `List[pointer[X]].get_head()`
                        ; returned a value that dereferenced to garbage.
                        if ma_chain.length > 0
                        {
                            let base_ptr emit_expression arg_op.expr
                            if base_ptr.handle <> null
                            {
                                if LLVMGetTypeKind(LLVMTypeOf base_ptr) = LLVMTypeKind.Pointer()
                                {
                                    var gep_ptr base_ptr
                                    var gep_advanced: bool false
                                    var gep_stop: bool false
                                    var gi: size_t 0
                                    while gi < ma_chain.length
                                    {
                                        if gep_stop = false
                                        {
                                            let gacc_ptr ma_chain.get gi
                                            if gacc_ptr <> null
                                            {
                                                let gacc (*gacc_ptr)
                                                let gsty map_type gacc.parent_type
                                                if LLVMGetTypeKind(gsty) = LLVMTypeKind.Struct()
                                                {
                                                    set gep_ptr: LLVMBuildStructGEP2(builder, gsty, gep_ptr, gacc.field_index as u32, "addr.gep")
                                                    set gep_advanced: true
                                                    ; A hop THROUGH a pointer field must follow it: the
                                                    ; next hop's struct starts where the field POINTS,
                                                    ; not where it sits. Without the load the walk kept
                                                    ; adding offsets inside the outer struct, so
                                                    ; `&o.ip.b` addressed the field b bytes past `ip` —
                                                    ; `&head.element` in List.get_head answered a
                                                    ; pointer into the List, and the value read back
                                                    ; was whatever field happened to sit at that
                                                    ; offset. Only for an INTERMEDIATE hop: the last
                                                    ; field's address is the answer, never its target.
                                                    if gi + 1 < ma_chain.length
                                                    {
                                                        var gacc_follows: bool false
                                                        if gacc.result_type.name = "pointer"
                                                            set gacc_follows: true
                                                        if gacc.result_type.name = "ref"
                                                            set gacc_follows: true
                                                        if gacc_follows
                                                        {
                                                            let gptr_ty LLVMPointerTypeInContext(context, 0)
                                                            set gep_ptr: LLVMBuildLoad2(builder, gptr_ty, gep_ptr, "addr.hop")
                                                        }
                                                    }
                                                }
                                                if LLVMGetTypeKind(gsty) <> LLVMTypeKind.Struct()
                                                    set gep_stop: true
                                            }
                                        }
                                        set gi: gi + 1
                                    }
                                    if gep_advanced
                                        return gep_ptr
                                }
                            }
                        }
                    }
                }

                let operand emit_operand arg_op
                return emit_intrinsic_unary_op(call.name, operand, call.result_type)
            }

            ; Binary operators
            if arg_count = 2
            {
                let left_arg call.args.get 0
                let right_arg call.args.get 1
                if left_arg = null
                    return LLVMValueRef null

                if right_arg = null
                    return LLVMValueRef null

                ; s155: short-circuit || and && (Scaly semantics, mirrors
                ; stage-0 emitOperand's lor/land). The RHS must NOT be
                ; evaluated when the LHS already decides the result — e.g.
                ; Array.add's `(vector = null) || (length = vector.length)`
                ; derefs `vector.length` only when vector is non-null. An
                ; eager `or i1` evaluates both and null-derefs on the first
                ; add to an empty Array. Emit: cond-branch on LHS, evaluate
                ; RHS in its own block, phi the two incomings.
                var is_logical: bool false
                if call.name = "||"
                    set is_logical: true
                if call.name = "&&"
                    set is_logical: true
                ; `or`/`and` are word-operator synonyms for `||`/`&&` and take
                ; the identical short-circuit path (Scaly semantics).
                if call.name = "or"
                    set is_logical: true
                if call.name = "and"
                    set is_logical: true
                if is_logical
                {
                    var is_or: bool false
                    if call.name = "||"
                        set is_or: true
                    if call.name = "or"
                        set is_or: true
                    var lc emit_operand(left_arg.unwrap())
                    let i1_ty LLVMInt1TypeInContext(context)
                    ; If the LHS operand can't be emitted (the same pre-existing
                    ; emit gap the RHS if below handles — e.g. a literal-param
                    ; generic stub like `Array<KeyValuePair<K,V>>::add` where the
                    ; field type is unresolved, so `vector = null` plans to null),
                    ; route to the RHS block instead of emitting `br <null>`: a
                    ; false LHS evaluates the RHS for `||`, a true LHS for `&&`.
                    ; These dead stubs never run, but the IR must stay valid so a
                    ; textual `.ll` round-trips through clang (Step D seed build).
                    if lc.handle = null
                    {
                        if is_or
                            set lc: LLVMConstInt(i1_ty, 0, 0)
                        if is_or = false
                            set lc: LLVMConstInt(i1_ty, 1, 0)
                    }
                    let entry_blk LLVMGetInsertBlock(builder)
                    let rhs_blk LLVMAppendBasicBlockInContext(context, current_function, "lor.rhs")
                    let end_blk LLVMAppendBasicBlockInContext(context, current_function, "lor.end")
                    if is_or
                        LLVMBuildCondBr(builder, lc, end_blk, rhs_blk)
                    if is_or = false
                        LLVMBuildCondBr(builder, lc, rhs_blk, end_blk)
                    ; Short-circuit value from the entry block: `||`
                    ; contributes constant true, `&&` contributes false.
                    var shortcut LLVMConstInt(i1_ty, 1, 0)
                    if is_or = false
                        set shortcut: LLVMConstInt(i1_ty, 0, 0)
                    LLVMPositionBuilderAtEnd(builder, rhs_blk)
                    var rc emit_operand(right_arg.unwrap())
                    ; If the RHS operand can't be emitted (a pre-existing
                    ; emit gap for that sub-expression), fall back to the
                    ; shortcut constant so the phi stays well-formed instead
                    ; of carrying a null operand. These cases were dropped
                    ; outright before short-circuiting existed.
                    if rc.handle = null
                        set rc: shortcut
                    let rhs_end LLVMGetInsertBlock(builder)
                    LLVMBuildBr(builder, end_blk)
                    LLVMPositionBuilderAtEnd(builder, end_blk)
                    let phi LLVMBuildPhi(builder, i1_ty, "lor.result")
                    var lvalues Vector[LLVMValueRef](2)
                    var lblocks Vector[LLVMBasicBlockRef](2)
                    lvalues.put(0, shortcut)
                    lvalues.put(1, rc)
                    lblocks.put(0, entry_blk)
                    lblocks.put(1, rhs_end)
                    LLVMAddIncoming(phi, lvalues.data, lblocks.data, 2)
                    return phi
                }

                let lhs_op left_arg.unwrap()
                let left emit_operand(lhs_op)
                let right emit_operand(right_arg.unwrap())
                return emit_intrinsic_binary_op(call.name, left, right, call.result_type, lhs_op.result_type)
            }

            LLVMValueRef null
        }

        ; Emit an intrinsic unary operator
        function emit_intrinsic_unary_op(this, op_name: String, operand: LLVMValueRef, result_type: PlannedType) returns LLVMValueRef
        {
            ; s34 root fix (emitBinding now copies a single-ptr-field struct
            ; param into a struct slot): a plain `var op operand` is a correct
            ; copy under both compilers — no .handle reconstruction needed.
            var op operand

            ; Bail out cleanly if the upstream operand emitter returned a null
            ; handle — better to emit a degraded ret void in the caller than
            ; let LLVMBuildNeg crash dereferencing operand->getType().
            if op.handle = null
                return LLVMValueRef null

            let ty map_type result_type
            let is_float is_floating_point_type result_type

            ; Negation
            if op_name = "-"
            {
                if is_float
                    return LLVMBuildFNeg(builder, op, "fneg")

                return LLVMBuildNeg(builder, op, "neg")
            }

            ; Unary plus (identity)
            if op_name = "+"
                return op

            ; Absolute value. Stage-0 calls the llvm.abs/llvm.fabs
            ; intrinsics (Emitter.cpp:4238); icmp/fcmp + select is
            ; semantically equivalent (abs with is_int_min_poison=false)
            ; and needs no intrinsic-declaration bindings.
            if op_name = "abs"
            {
                if is_float
                {
                    let fzero LLVMConstReal(ty, 0.0)
                    let fneg LLVMBuildFNeg(builder, op, "fneg")
                    let fisneg LLVMBuildFCmp(builder, LLVMRealPredicate.OLT(), op, fzero, "isneg")
                    return LLVMBuildSelect(builder, fisneg, fneg, op, "fabs")
                }
                let zero LLVMConstInt(ty, 0, 0)
                let neg LLVMBuildNeg(builder, op, "neg")
                let isneg LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), op, zero, "isneg")
                return LLVMBuildSelect(builder, isneg, neg, op, "abs")
            }

            ; Logical not (`!` and its word synonym `not`)
            if op_name = "!"
                return LLVMBuildNot(builder, op, "not")
            if op_name = "not"
                return LLVMBuildNot(builder, op, "not")

            ; Bitwise not
            if op_name = "~"
                return LLVMBuildNot(builder, op, "bitnot")

            ; Dereference. For struct result types, load + spill to a
            ; temp alloca and return the alloca pointer — mirrors stage-0's
            ; `init.arg.tmp` pattern. Callees that take struct args expect
            ; `ptr` to the struct; emitting just the loaded struct value
            ; would force every call site to do its own spill. ref_string_item's
            ; `let n (*i.name)` then `String^rp(n)` hits this — `n` is the
            ; loaded String value and the ctor needs a ptr to it.
            if op_name = "*"
            {
                ; A parenthesized pointer binding (`let s (v[1]); (*s)`)
                ; arrives as a one-field { ptr } tuple VALUE — extract the
                ; pointer before loading through it. A load whose pointer
                ; operand is a struct value is invalid IR that llc tolerates
                ; at O0 and opt miscompiles at -O2 (subscript_binary).
                var opv op
                let opv_ty LLVMTypeOf(opv)
                if LLVMGetTypeKind(opv_ty) = LLVMTypeKind.Struct()
                    if LLVMCountStructElementTypes(opv_ty) = 1
                        if LLVMGetTypeKind(LLVMStructGetTypeAtIndex(opv_ty, 0)) = LLVMTypeKind.Pointer()
                            set opv: LLVMBuildExtractValue(builder, opv, 0, "deref.unwrap")
                if LLVMGetTypeKind(ty) = LLVMTypeKind.Struct()
                {
                    ; s178: memcpy instead of load+store — a big-aggregate
                    ; load gets a backend spill slot (see copy_struct_value).
                    ; Opaque/empty structs (element count 0) keep the old
                    ; load+store path — LLVMSizeOf on them asserts (s97).
                    if LLVMCountStructElementTypes(ty) > 0
                    {
                        let tmp acquire_temp(ty, "deref.tmp")
                        let size_const LLVMSizeOf(ty)
                        LLVMBuildMemCpy(builder, tmp, 1, opv, 1, size_const)
                        return tmp
                    }
                    let loaded LLVMBuildLoad2(builder, ty, opv, "deref")
                    let tmp2 acquire_temp(ty, "deref.tmp")
                    LLVMBuildStore(builder, loaded, tmp2)
                    return tmp2
                }

                ; A `ptr` from map_type is not always a pointer: for a name this
                ; root never lays out — a BY-VALUE struct from another package, or
                ; one of the runtime-opaque types (Page, PageList, …) — it is the
                ; last-resort placeholder (see type_is_pointer_shaped#). Loading
                ; through it reads the struct's FIRST 8 BYTES and passes them on as
                ; if they were the value, which for a deref RECEIVER becomes the
                ; callee's `this`: `(*t).bucket_count()` on a cross-package
                ; `pointer[Table]` called the method with `this` = Table's first
                ; field, and `(*page).get_capacity(8)` answered nonsense because
                ; get_capacity derives the page bounds from `this` as an address.
                ; Answer the pointer itself: the deref of a pointer to a struct
                ; already denotes that struct's storage. NOT a copy — copying is
                ; what the laid-out struct arm above does, and for these types it
                ; is wrong twice over: there is no size to copy for a placeholder,
                ; and a method that treats `this` as an address (anything calling
                ; Page.get(this) or measuring from it) needs the ORIGINAL address.
                if LLVMGetTypeKind(ty) = LLVMTypeKind.Pointer()
                    if type_is_pointer_shaped(result_type) = false
                        return opv
                return LLVMBuildLoad2(builder, ty, opv, "deref")
            }

            ; Address-of: when the operand is already a pointer, return it
            ; directly. When the operand is a struct value (e.g. `&n` on a
            ; let-bound struct), spill to a temp alloca and return the
            ; alloca pointer. Mirrors stage-0's `addr.tmp` pattern
            ; (Emitter.cpp ~3735) — required for `let n T(); let p &n` then
            ; `(*p).field` to round-trip through opaque ptr correctly.
            if op_name = "&"
            {
                let op_kind LLVMGetTypeKind(LLVMTypeOf op)
                if op_kind = LLVMTypeKind.Struct()
                {
                    let tmp entry_alloca(LLVMTypeOf op, "addr.tmp")
                    LLVMBuildStore(builder, op, tmp)
                    return tmp
                }
                return op
            }

            ; Unknown unary operator — HARD, LOUD failure instead of silently
            ; returning a null handle (which DROPS the whole expression: the
            ; Bug-B class, e.g. an unknown `//` that lowered to null → a
            ; content-independent hash). exit/scaly_eputs resolve from the
            ; package the same way ConceptIndex/FunctionIndex use them; the LSP
            ; never runs the Emitter (parser->model->plan only) so this cannot
            ; crash the semantic worker. For clean source this is dead code.
            scaly_eputs "Emitter: unknown unary operator: "
            let uopc op_name.to_c_string()
            scaly_eputs uopc
            scaly_eputs "\n"
            exit 14
            LLVMValueRef null
        }

        ; Emit an intrinsic binary operator
        function emit_intrinsic_binary_op(this, op_name: String, left: LLVMValueRef, right: LLVMValueRef, result_type: PlannedType, left_operand_type: PlannedType) returns LLVMValueRef
        {
            ; s34 root fix: plain copies of the by-ptr struct params (emitBinding
            ; now copies single-ptr-field struct params correctly).
            var l left
            var r right
            if l.handle = null
                return LLVMValueRef null
            if r.handle = null
                return LLVMValueRef null

            let ty map_type result_type
            var is_float is_floating_point_type result_type
            ; Signedness derives from the LEFT OPERAND's type, NOT result_type:
            ; for comparisons result_type is bool (signed by default), which
            ; would wrongly emit signed slt/sgt for size_t/unsigned operands.
            ; Mirrors C++ Emitter.cpp emitIntrinsicOp (SignednessType =
            ; LeftOperandType ? *LeftOperandType : ResultType).
            var is_signed is_signed_type left_operand_type

            ; Pointer arithmetic: pointer + int, pointer - int → GEP. The
            ; result_type is `pointer[T]` for these; element type for the
            ; GEP is map_type of the first generic, falling back to i8 when
            ; the result type isn't recognizably a pointer (gives a byte
            ; offset, matching the C++ Emitter at emitIntrinsicOp:4063+).
            let l_kind LLVMGetTypeKind(LLVMTypeOf l)
            let r_kind LLVMGetTypeKind(LLVMTypeOf r)
            ; Floatness must ALSO derive from the actual operand (the operand-
            ; side mirror of the is_signed rule above): for comparisons
            ; result_type is bool, so a double compare would otherwise fall
            ; into LLVMBuildICmp — invalid IR on FP operands, and LLVM's
            ; constant folder loops forever folding an icmp of FP constants.
            if l_kind = LLVMTypeKind.Float()
                set is_float: true
            if l_kind = LLVMTypeKind.Double()
                set is_float: true
            ; Pointer comparisons are unsigned (mirror C++ emitIntrinsicOp).
            if l_kind = LLVMTypeKind.Pointer()
                if r_kind = LLVMTypeKind.Pointer()
                    set is_signed: false
            if l_kind = LLVMTypeKind.Pointer()
            {
                if r_kind = LLVMTypeKind.Integer()
                {
                    if op_name = "+"
                    {
                        var elem_ty LLVMInt8TypeInContext(context)
                        if result_type.name = "pointer"
                        {
                            if result_type.generics <> null
                            {
                                let gens (*result_type.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                    {
                                        ; s105: pointer[void] uses byte stride.
                                        ; map_type(void) returns LLVMVoidType
                                        ; which GEP rejects; fall back to i8.
                                        if (*inner_ptr).name <> "void"
                                            set elem_ty: stride_type(*inner_ptr)
                                    }
                                }
                            }
                        }
                        var indices Vector[LLVMValueRef](1)
                        indices.put(0, r)
                        return LLVMBuildInBoundsGEP2(builder, elem_ty, l, indices.data, 1, "ptr.add")
                    }

                    if op_name = "-"
                    {
                        var elem_ty LLVMInt8TypeInContext(context)
                        if result_type.name = "pointer"
                        {
                            if result_type.generics <> null
                            {
                                let gens (*result_type.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                        set elem_ty: stride_type(*inner_ptr)
                                }
                            }
                        }
                        let neg_offset LLVMBuildNeg(builder, r, "neg")
                        var indices Vector[LLVMValueRef](1)
                        indices.put(0, neg_offset)
                        return LLVMBuildInBoundsGEP2(builder, elem_ty, l, indices.data, 1, "ptr.sub")
                    }
                }
            }

            ; Integer width promotion. When both operands are integers but
            ; widths differ (e.g. defaulted-i32 literal `0` vs i64 strlen
            ; result), zero-extend the narrower side to match the wider.
            ; Mirrors C++ Emitter.cpp:4089-4102. Required for valid icmp/
            ; arithmetic on cross-width integer pairs.
            if l_kind = LLVMTypeKind.Integer()
            {
                if r_kind = LLVMTypeKind.Integer()
                {
                    let l_width LLVMGetIntTypeWidth(LLVMTypeOf l)
                    let r_width LLVMGetIntTypeWidth(LLVMTypeOf r)
                    if l_width <> r_width
                    {
                        if l_width > r_width
                            set r: LLVMBuildZExt(builder, r, LLVMTypeOf l, "zext")
                        ; s201: widening the narrower LEFT operand must SIGN-extend
                        ; when it is a signed type — else a negative narrow value
                        ; (e.g. i32 -1 read from a set_pos/keymap sentinel, or the
                        ; eE = -1 sentinel in code_of_xchar's `x < 0`) becomes a
                        ; large positive i64 and the signed compare flips. Unsigned
                        ; operands keep zext (byte-identical). Right-operand widening
                        ; keeps zext (right is almost always the i64 literal side).
                        if l_width < r_width
                        {
                            if is_signed
                                set l: LLVMBuildSExt(builder, l, LLVMTypeOf r, "sext")
                            if is_signed = false
                                set l: LLVMBuildZExt(builder, l, LLVMTypeOf r, "zext")
                        }
                    }
                }
            }

            ; Float width promotion: a float (f32) operand beside a double —
            ; a planner-missed f64 literal or a genuine mixed-width FP pair —
            ; must not reach fadd/fcmp as-is (mixed-operand FP instructions
            ; are invalid IR that llc swallows silently). FPExt the narrower
            ; side to the wider, mirroring the integer zext above.
            if l_kind = LLVMTypeKind.Float()
                if r_kind = LLVMTypeKind.Double()
                    set l: LLVMBuildFPExt(builder, l, LLVMTypeOf r, "fpext")
            if l_kind = LLVMTypeKind.Double()
                if r_kind = LLVMTypeKind.Float()
                    set r: LLVMBuildFPExt(builder, r, LLVMTypeOf l, "fpext")

            ; Addition
            if op_name = "+"
            {
                if is_float
                    return LLVMBuildFAdd(builder, l, r, "fadd")

                return LLVMBuildAdd(builder, l, r, "add")
            }

            ; Subtraction
            if op_name = "-"
            {
                if is_float
                    return LLVMBuildFSub(builder, l, r, "fsub")

                return LLVMBuildSub(builder, l, r, "sub")
            }

            ; Multiplication
            if op_name = "*"
            {
                if is_float
                    return LLVMBuildFMul(builder, l, r, "fmul")

                return LLVMBuildMul(builder, l, r, "mul")
            }

            ; Division
            if op_name = "/"
            {
                if is_float
                    return LLVMBuildFDiv(builder, l, r, "fdiv")

                if is_signed
                    return LLVMBuildSDiv(builder, l, r, "sdiv")

                return LLVMBuildUDiv(builder, l, r, "udiv")
            }

            ; Modulo
            if op_name = "%"
            {
                if is_float
                    return LLVMBuildFRem(builder, l, r, "frem")

                if is_signed
                    return LLVMBuildSRem(builder, l, r, "srem")

                return LLVMBuildURem(builder, l, r, "urem")
            }

            ; Named integer division/modulo operators. Stage-0 never
            ; implemented these (its emitter has no handler; the test
            ; passed by accident of operand-sequence semantics) — stage-N
            ; lowers them like `/` and `%`.
            if op_name = "div"
            {
                if is_float
                    return LLVMBuildFDiv(builder, l, r, "fdiv")

                if is_signed
                    return LLVMBuildSDiv(builder, l, r, "sdiv")

                return LLVMBuildUDiv(builder, l, r, "udiv")
            }

            if op_name = "mod"
            {
                if is_float
                    return LLVMBuildFRem(builder, l, r, "frem")

                if is_signed
                    return LLVMBuildSRem(builder, l, r, "srem")

                return LLVMBuildURem(builder, l, r, "urem")
            }

            ; Logical AND (on i1 booleans). Mirrors stage-0
            ; Emitter.cpp:4176-4178. Without this handler, `a && b`
            ; falls through to the comparison block which produces
            ; an icmp without using the result, leaving downstream
            ; if/while branches with no condition value.
            if op_name = "&&"
                return LLVMBuildAnd(builder, l, r, "land")

            ; Logical OR (on i1 booleans).
            if op_name = "||"
                return LLVMBuildOr(builder, l, r, "lor")

            ; Word-operator synonyms `and`/`or` — reached only if a logical op
            ; ever bypasses emit_operand's short-circuit path; lower like &&/||.
            if op_name = "and"
                return LLVMBuildAnd(builder, l, r, "land")
            if op_name = "or"
                return LLVMBuildOr(builder, l, r, "lor")

            ; Bitwise AND
            if op_name = "&"
                return LLVMBuildAnd(builder, l, r, "and")

            ; Bitwise OR
            if op_name = "|"
                return LLVMBuildOr(builder, l, r, "or")

            ; Bitwise XOR. `xor` is the word synonym — `^` is the reference-
            ; lifetime sigil in expression position, so source code can only
            ; write XOR as the word operator.
            if op_name = "^"
                return LLVMBuildXor(builder, l, r, "xor")
            if op_name = "xor"
                return LLVMBuildXor(builder, l, r, "xor")

            ; Left shift
            if op_name = "<<"
                return LLVMBuildShl(builder, l, r, "shl")

            ; Right shift
            if op_name = ">>"
            {
                if is_signed
                    return LLVMBuildAShr(builder, l, r, "ashr")

                return LLVMBuildLShr(builder, l, r, "lshr")
            }

            ; Comparison operators. Defensive: bail when LHS/RHS type kinds
            ; mismatch. The s72 prefix-tuple-expansion fix unblocked
            ; pointer-arith deref's GEP emission, but binary ops INSIDE a
            ; grouping component (e.g. `(byte & 0x80) = 0`) are still left
            ; as a raw operand sequence by plan_component# — emit_tuple's
            ; grouping shortcut emits only the first operand, leaving the
            ; rhs dangling as a `ptr null` constant. Until plan_component#
            ; collapses binary-op components (separate session), guarding
            ; the icmp emit-site keeps llc clean.
            if op_name = "="
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.OEQ(), l, r, "eq")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                return LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), l, r, "eq")
            }

            if op_name = "<>"
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.ONE(), l, r, "ne")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                return LLVMBuildICmp(builder, LLVMIntPredicate.NE(), l, r, "ne")
            }

            if op_name = "<"
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.OLT(), l, r, "lt")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                if is_signed
                    return LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), l, r, "lt")

                return LLVMBuildICmp(builder, LLVMIntPredicate.ULT(), l, r, "lt")
            }

            if op_name = "<="
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.OLE(), l, r, "le")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                if is_signed
                    return LLVMBuildICmp(builder, LLVMIntPredicate.SLE(), l, r, "le")

                return LLVMBuildICmp(builder, LLVMIntPredicate.ULE(), l, r, "le")
            }

            if op_name = ">"
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.OGT(), l, r, "gt")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                if is_signed
                    return LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), l, r, "gt")

                return LLVMBuildICmp(builder, LLVMIntPredicate.UGT(), l, r, "gt")
            }

            if op_name = ">="
            {
                if is_float
                    return LLVMBuildFCmp(builder, LLVMRealPredicate.OGE(), l, r, "ge")

                if LLVMGetTypeKind(LLVMTypeOf l) <> LLVMGetTypeKind(LLVMTypeOf r)
                    return LLVMValueRef null
                if is_signed
                    return LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), l, r, "ge")

                return LLVMBuildICmp(builder, LLVMIntPredicate.UGE(), l, r, "ge")
            }

            ; `[]` is a DEFINED subscript operator dispatched by the collapse
            ; pre-pass (find_member_operator) to a real call; it should never
            ; reach here. The exception stays only as belt-and-braces for a
            ; subscript the pre-pass could not resolve (e.g. an un-instantiated
            ; receiver) — returning null preserves the pre-existing silent
            ; behavior rather than hard-trapping. `==` is NO LONGER excepted:
            ; A3a's member-operator dispatch (collapse_operand_sequence#) now
            ; routes a generic concept's `operator ==` to a real non-intrinsic
            ; call, so a `==` arriving here is a genuine unresolved-operator bug
            ; and SHOULD hit the loud trap below (the Bug-B class), not vanish.
            if op_name = "[]"
                return LLVMValueRef null

            ; Unknown binary operator — HARD, LOUD failure instead of silently
            ; returning a null handle. A null here DROPS the whole assignment/
            ; expression: this is the Bug-B class — `hash // value` with an
            ; unknown `//` lowered to null, reducing the FNV loop to a
            ; content-independent (length-only) hash. exit/scaly_eputs resolve
            ; from the package as ConceptIndex/FunctionIndex use them; the LSP
            ; never runs the Emitter (parser->model->plan only) so this cannot
            ; crash the semantic worker. For clean source this is dead code.
            scaly_eputs "Emitter: unknown binary operator: "
            let bopc op_name.to_c_string()
            scaly_eputs bopc
            scaly_eputs "\n"
            exit 14
            LLVMValueRef null
        }

        ; Emit an intrinsic function call
        function emit_intrinsic_function(this, call: PlannedCall) returns LLVMValueRef
        {
            ; Get the function name
            let name call.name

            ; Handle Option::unwrap - extract payload from union
            if name = "unwrap"
            {
                if call.args <> null
                {
                    if call.args.length = 1
                    {
                        let arg call.args.get 0
                        if arg <> null
                        {
                            let option_value emit_operand(arg.unwrap())
                            let result_ty map_type call.result_type

                            if result_ty.handle = null
                                return LLVMValueRef null

                            ; Check if this is an NPO Option (pointer type)
                            ; For NPO, just load from the pointer
                            if LLVMGetTypeKind(LLVMTypeOf option_value) = LLVMTypeKind.Pointer()
                            {
                                ; s169: NPO Option (Option[ref[T]] / Option[pointer[T]])
                                ; is represented as the raw pointer itself — option_value
                                ; ALREADY is the unwrapped T*. Return it directly; do NOT
                                ; load. The old `LLVMBuildLoad2(..., "unwrap.npo")` derefed
                                ; T* as T**, reading T's first field (e.g. a PlannedType's
                                ; loc.start) as the pointer. Mirrors stage-0's
                                ; `return OptionValue` for the NPO branch (Emitter.cpp:3608).
                                if LLVMGetTypeKind(result_ty) = LLVMTypeKind.Pointer()
                                    return option_value

                                ; Regular union case - option_value is pointer to union
                                ; Union layout: { i8 tag, [N x i8] payload }
                                ; GEP to field 1 (payload) and load
                                let option_type LLVMTypeOf(option_value)

                                ; Try to get struct type from cache
                                ; For now, use direct load assuming NPO representation
                                return LLVMBuildLoad2(builder, result_ty, option_value, "unwrap.value")
                            }

                            ; If option_value is already a struct value, extract field 1
                            ; This shouldn't normally happen for well-formed code
                            return option_value
                        }
                    }
                }
            }

            ; Handle Option::unwrap_or - return value or default
            if name = "unwrap_or"
            {
                if call.args <> null
                {
                    if call.args.length = 2
                    {
                        ; First arg is the Option, second is the default
                        let opt_arg call.args.get 0
                        let def_arg call.args.get 1

                        if opt_arg <> null
                        {
                            if def_arg <> null
                            {
                                ; For now, just return the default value
                                ; Full implementation would check if option has value
                                return emit_operand(def_arg.unwrap())
                            }
                        }
                    }
                }
            }

            ; Unknown intrinsic function - return null
            LLVMValueRef null
        }

        ; ========================================================================
        ; Type Helpers
        ; ========================================================================

        ; Check if type is floating point
        function is_floating_point_type(this, t: PlannedType) returns bool
        {
            if t.name = "float"
                return true

            if t.name = "double"
                return true

            false
        }

        ; Check if type is signed
        function is_signed_type(this, t: PlannedType) returns bool
        {
            ; Unsigned types start with 'u' or are size_t
            if t.name = "u8"
                return false

            if t.name = "u16"
                return false

            if t.name = "u32"
                return false

            if t.name = "u64"
                return false

            if t.name = "uint"
                return false

            if t.name = "size_t"
                return false

            if t.name = "size"
                return false

            if t.name = "usize"
                return false

            if t.name = "bool"
                return false

            if t.name = "char"
                return false

            ; Everything else is signed by default
            true
        }

        ; ========================================================================
        ; Tuple and Matrix Emission
        ; ========================================================================

        ; Emit a tuple construction
        function emit_tuple(this, tuple: PlannedTuple) returns LLVMValueRef
        {
            ; Zero-arg struct ctor (e.g. `Options()`, `Vector[int](0)` after the
            ; planner collapses an integer literal away in some paths). Look up
            ; the struct in the cache; if found, alloca and zero-init. Without
            ; this, every empty-paren ctor returns null and the binding drops.
            ; tuple.components null vs length=0 both happen depending on the
            ; planner path that built the reshape.
            if tuple.tuple_type.name.get_length() > 0
            {
                var no_comps: bool false
                if tuple.components = null
                    set no_comps: true
                if no_comps = false
                {
                    if tuple.components.length = 0
                        set no_comps: true
                }
                if no_comps
                {
                    var struct_type lookup_struct_cache tuple.tuple_type.mangled_name
                    if struct_type.handle = null
                        set struct_type: lookup_struct_cache(tuple.tuple_type.name)
                    if struct_type.handle <> null
                    {
                        let tuple_ptr acquire_temp(struct_type, "tuple")
                        LLVMBuildStore(builder, LLVMConstNull struct_type, tuple_ptr)
                        ; Same load as the per-field-store branch below: when not
                        ; region-allocated, emit_binding needs the loaded struct
                        ; value so it alloca's a struct-typed slot for `var opts
                        ; Options()` instead of a ptr-typed slot. Without this,
                        ; subsequent `set opts.field: ...` GEPs corrupt the
                        ; pointer instead of writing struct fields. Today the
                        ; planner never sets is_region_alloc, so this fires for
                        ; both Options() and Options() — matches stage-0 which
                        ; treats both as stack-allocated for empty-arg data
                        ; classes (no init#).
                        if tuple.is_region_alloc = false
                            return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                        return tuple_ptr
                    }
                }
            }

            if tuple.components = null
                return LLVMValueRef null

            if tuple.components.length = 0
                return LLVMValueRef null

            ; Check if this is struct construction vs grouped expression.
            ; Mirrors Emitter.cpp::emitTuple's StructCache-first heuristic
            ; (line 6232+): a registered struct/union in the cache means
            ; construction, regardless of single-anonymous-component shape.
            var is_struct_construction false
            if tuple.tuple_type.name.get_length() > 0
            {
                ; First check struct cache by mangled name and by readable name.
                let cached_by_mangled lookup_struct_cache tuple.tuple_type.mangled_name
                if cached_by_mangled.handle <> null
                    set is_struct_construction: true
                if is_struct_construction = false
                {
                    let cached_by_name lookup_struct_cache tuple.tuple_type.name
                    if cached_by_name.handle <> null
                        set is_struct_construction: true
                }
                ; Fallback: if not cached but name is non-empty and not "Tuple",
                ; use the single-anonymous-component heuristic for grouping.
                if is_struct_construction = false
                {
                    set is_struct_construction: true
                    if tuple.components.length = 1
                    {
                        let first tuple.components.get 0
                        if first <> null
                        {
                            if first.name = null
                                set is_struct_construction: false
                        }
                    }
                }
            }

            ; s160: a single anonymous component wrapping a struct deref
            ; `(*ptr)` is a GROUPING, not a construction, even when tuple_type
            ; names a cached struct/union. The planner sets a grouping's
            ; tuple_type to the inner value's result_type, so `let x (*ptr)`
            ; gives tuple_type = DeclarationSyntax / Member and the cache
            ; lookup above wrongly flags construction — emit then builds a
            ; `{ ptr }` wrapper around the deref pointer. emit_intrinsic_unary
            ; _op's `*` returns a POINTER to the loaded struct (deref.tmp), so
            ; here we load the struct VALUE from it and forward that, matching
            ; stage-0's `let x (*p)` → loaded value. Forwarding the pointer
            ; instead made a following `choose x` store 8 pointer bytes into
            ; the union slot and read the tag from the low byte of the address
            ; (build_module#/plan_module# member dispatch fell to the else
            ; arm, planning no functions). Scoped narrowly to a deref inner so
            ; real single-field constructions are untouched.
            if is_struct_construction
            {
                if tuple.components.length = 1
                {
                    let im_first tuple.components.get 0
                    if im_first <> null
                    {
                        let imf (*im_first)
                        if imf.name = null
                        {
                            if imf.value <> null
                            {
                                let ivops (*imf.value)
                                if ivops.length = 1
                                {
                                    let ilast_ptr ivops.get 0
                                    if ilast_ptr <> null
                                    {
                                        let ilast (*ilast_ptr)
                                        choose ilast.expr
                                            when icall: PlannedCall
                                            {
                                                if icall.name = "*"
                                                {
                                                    let deref_val emit_operands imf.value
                                                    if deref_val.handle = null
                                                        return LLVMValueRef null
                                                    let grp_ty map_type tuple.tuple_type
                                                    if LLVMGetTypeKind(grp_ty) = LLVMTypeKind.Struct()
                                                        return LLVMBuildLoad2(builder, grp_ty, deref_val, "grp.deref.val")
                                                    return deref_val
                                                }
                                            }
                                            else
                                                0
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; If single component with no name and not struct construction, just emit the value
            if tuple.components.length = 1
            {
                if ~is_struct_construction
                {
                    let comp tuple.components.get 0
                    if comp <> null
                    {
                        if comp.name = null
                            return emit_operands comp.value

                    }
                }
            }

            ; For struct construction, emit all component values first
            let comp_count tuple.components.length

            ; Emit component values
            var comp_values Vector[LLVMValueRef](comp_count)
            var comp_types Vector[LLVMTypeRef](comp_count)

            var i: size_t 0
            var any_null: bool false
            while i < comp_count
            {
                let comp_ptr tuple.components.get i
                if comp_ptr <> null
                {
                    let comp comp_ptr.unwrap()
                    let comp_value emit_operands comp.value
                    comp_values.put(i, comp_value)

                    if comp_value.handle = null
                        set any_null: true

                    if comp_value.handle <> null
                    {
                        let comp_type LLVMTypeOf(comp_value)
                        comp_types.put(i, comp_type)
                    }
                }
                set i: i + 1
            }
            if any_null
                return LLVMValueRef null
            ; Get or create struct type
            var struct_type lookup_struct_cache tuple.tuple_type.mangled_name
            if struct_type.handle = null
            {
                ; Create anonymous struct type
                set struct_type: LLVMStructTypeInContext(context, comp_types.data, comp_count as u32, 0)
            }

            ; Allocate on stack (default) or heap on the appropriate page when
            ; the tuple carries a non-Unspecified lifetime (#/$/^). Mirrors stage-0
            ; emitTuple's PageAllocate branch (Emitter.cpp:6389-6421). Without
            ; this, every `Plan(...)` / `Vector[T]^rp(...)` data-class ctor goes
            ; to the stack and any caller storing the pointer past return-time
            ; gets dangling memory.
            var tuple_ptr: LLVMValueRef LLVMValueRef(null)
            if tuple.is_region_alloc
            {
                var page_var_name: String "_rp"
                var life_is_local: bool false
                choose tuple.life
                    when l: Local
                        set life_is_local: true
                    when r: Reference
                        set page_var_name: r.location
                    else
                        0
                var page_val_raw: LLVMValueRef LLVMValueRef(null)
                ; Local life = the FUNCTION'S OWN region: materialise this
                ; function's frame, exactly as emit_constructor_call does.
                ; ★This used to `lookup_variable "local_page"` — a name nothing
                ; has defined since the frame ABI landed (the emitter's local page
                ; lives in `function_local_frame`, not in the variable table). The
                ; lookup failed, `resolve_reference_page` found nothing either, and
                ; the construction fell through to a STACK alloca at the bottom of
                ; this function — for a type whose own bodies call
                ; `Page.get(this)`, i.e. exactly the types that must NOT be stack
                ; instances. It stayed invisible because every construction that
                ; matched no init was diverted to a SYNTHESIZED empty constructor
                ; (the padded `Structure.initializers`, Modeler.scaly), which
                ; allocates on the frame page correctly; the Local branch here was
                ; unreachable in practice (2026-08-02).
                if life_is_local
                {
                    let local_frame get_local_frame()
                    set page_val_raw: force_frame(local_frame)
                }
                if life_is_local = false
                    set page_val_raw: lookup_variable page_var_name
                ; A `^field` page sigil (host is a receiver member, not a local/param)
                ; misses the variable table — resolve it as a field of `this`. Keeps
                ; `return X^host()` (host a pointer[Page] field) on the receiver's page
                ; instead of a dangling stack alloca. scaly/scalyc never `^field`, so
                ; this is emission-neutral for the self-compile.
                if page_val_raw.handle = null
                    set page_val_raw: resolve_reference_page(page_var_name)
                if page_val_raw.handle <> null
                {
                    var page_val page_val_raw
                    if page_var_name = "this"
                    {
                        ; ^this: the receiver is an object pointer, not a
                        ; pointer[Page] — wrap it in Page.get(this). Mirrors
                        ; stage-0's planner (Planner.cpp generatePageGetThis).
                        var get_fn lookup_function_cache("_Z3getPv")
                        if get_fn.handle = null
                            set get_fn: LLVMGetNamedFunction(llvm_module, "_Z3getPv")
                        let get_ptr_ty LLVMPointerTypeInContext(context, 0)
                        var get_param_tys Vector[LLVMTypeRef](1)
                        get_param_tys.put(0, get_ptr_ty)
                        let get_fn_ty LLVMFunctionType(get_ptr_ty, get_param_tys.data, 1, 0)
                        if get_fn.handle = null
                        {
                            set get_fn: LLVMAddFunction(llvm_module, "_Z3getPv", get_fn_ty)
                            LLVMSetLinkage(get_fn, LLVMLinkage.External())
                            cache_function("_Z3getPv", get_fn)
                        }
                        var get_args Vector[LLVMValueRef](1)
                        get_args.put(0, page_val)
                        set page_val: LLVMBuildCall2(builder, get_fn_ty, get_fn, get_args.data, 1, "own_page")
                    }
                    ; `_rp` / `^rp` name the caller-page slot, which holds a FRAME
                    ; since 2026-08-02; Page::allocate below needs the page.
                    ; (resolve_reference_page has already forced its own result, so
                    ; a value coming from there never matches here.)
                    if current_frame_parent.handle <> null
                        if page_val.handle = current_frame_parent.handle
                            set page_val: force_frame(page_val)
                    var alloc_func lookup_function_cache("_ZN4Page8allocateEmm")
                    if alloc_func.handle = null
                        set alloc_func: LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
                    if alloc_func.handle = null
                    {
                        var alloc_param_types_d Vector[LLVMTypeRef](3)
                        alloc_param_types_d.put(0, LLVMPointerTypeInContext(context, 0))
                        alloc_param_types_d.put(1, LLVMInt64TypeInContext context)
                        alloc_param_types_d.put(2, LLVMInt64TypeInContext context)
                        let alloc_ret_ty_d LLVMPointerTypeInContext(context, 0)
                        let alloc_decl_ty LLVMFunctionType(alloc_ret_ty_d, alloc_param_types_d.data, 3, 0)
                        set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", alloc_decl_ty)
                        LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                        cache_function("_ZN4Page8allocateEmm", alloc_func)
                    }
                    let size_const LLVMSizeOf(struct_type)
                    let align_const LLVMAlignOf(struct_type)
                    var alloc_args Vector[LLVMValueRef](3)
                    alloc_args.put(0, page_val)
                    alloc_args.put(1, size_const)
                    alloc_args.put(2, align_const)
                    var alloc_param_types_c Vector[LLVMTypeRef](3)
                    alloc_param_types_c.put(0, LLVMPointerTypeInContext(context, 0))
                    alloc_param_types_c.put(1, LLVMInt64TypeInContext context)
                    alloc_param_types_c.put(2, LLVMInt64TypeInContext context)
                    let alloc_ret_ty_c LLVMPointerTypeInContext(context, 0)
                    let alloc_call_ty LLVMFunctionType(alloc_ret_ty_c, alloc_param_types_c.data, 3, 0)
                    set tuple_ptr: LLVMBuildCall2(builder, alloc_call_ty, alloc_func, alloc_args.data, 3, "tuple.region")
                }
            }
            if tuple_ptr.handle = null
                set tuple_ptr: acquire_temp(struct_type, "tuple")

            ; Empty struct (zero element types): skip the per-field GEP loop
            ; entirely — `LLVMBuildStructGEP2(t, p, 0)` on an empty struct
            ; emits `i32 0, i32 0` which is invalid GEP indices (no field 0)
            ; and llc/IRTranslator rejects it. The alloca alone suffices
            ; for a zero-size value. Surfaces with `Lifetime.Unspecified(
            ; Unspecified())` when stage-1's planner doesn't recognize the
            ; outer call as variant construction and treats it as a
            ; single-component tuple over the empty inner struct.
            let elem_count LLVMCountStructElementTypes(struct_type)
            if elem_count = 0
            {
                if tuple.is_region_alloc = false
                    return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                return tuple_ptr
            }

            ; Whole-struct short-circuit: when a single comp is the whole struct
            ; value (not field 0), copy the struct directly. Mirrors stage-0's
            ; Vector::C1E copy-ctor dispatch — semantically equivalent for
            ; layout-compatible source/target (both on rp). Without this,
            ; `Vector[T]^rp(planned_stmts)` where planned_stmts came via sret
            ; (single-comp, comp is ptr to a struct_type-typed alloca) stores
            ; only 8 bytes (the ptr address) into the i64 length field, leaving
            ; data uninitialized. Discriminator: cv is alloca whose allocated
            ; type equals struct_type. Narrow enough to skip:
            ; (a) `Vector[T]^rp(0)` — cv is i64, not alloca;
            ; (b) `PlannedOperand(ptr_field)` — comp_count >> 1 or alloca's
            ;     type differs.
            if comp_count = 1
            {
                if elem_count > 1
                {
                    let cv0_ref comp_values.get 0
                    if cv0_ref <> null
                    {
                        let cv0 (*cv0_ref)
                        if cv0.handle <> null
                        {
                            let cv0_ty LLVMTypeOf(cv0)

                            ; s165: is the single component an Array[T]? Used by
                            ; the pointer-to-Array → Vector branch below. The
                            ; result_type of the last collapsed operand carries
                            ; the planner's view ("Array" for `var X Array[T]$()`).
                            var comp0_is_array: bool false
                            let c0_ptr tuple.components.get 0
                            if c0_ptr <> null
                            {
                                let c0 c0_ptr.unwrap()
                                if c0.value <> null
                                {
                                    let c0_ops (*c0.value)
                                    if c0_ops.length > 0
                                    {
                                        let lop_ptr c0_ops.get(c0_ops.length - 1)
                                        if lop_ptr <> null
                                            if lop_ptr.result_type.name = "Array"
                                                set comp0_is_array: true
                                    }
                                }
                            }

                            ; s172: the single component is already a struct
                            ; VALUE of the target type (e.g. a choose-bound
                            ; `success` payload in `ParameterSetSyntax(success)`)
                            ; — store it directly. The alloca branch below only
                            ; covers by-pointer components.
                            if cv0_ty.handle = struct_type.handle
                            {
                                LLVMBuildStore(builder, cv0, tuple_ptr)
                                if tuple.is_region_alloc = false
                                    return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                                return tuple_ptr
                            }

                            let alloca_check LLVMIsAAllocaInst(cv0)
                            if alloca_check.handle <> null
                            {
                                let alloc_ty LLVMGetAllocatedType(alloca_check)
                                if alloc_ty.handle = struct_type.handle
                                {
                                    let val LLVMBuildLoad2(builder, struct_type, cv0, "wholestruct.load")
                                    LLVMBuildStore(builder, val, tuple_ptr)
                                    if tuple.is_region_alloc = false
                                        return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                                    return tuple_ptr
                                }
                            }

                            ; Array→Vector convert (manual): cv is an Array
                            ; struct value (e.g. from `extractvalue Planner,
                            ; 8` for instantiated_structures), target is a
                            ; Vector[T]. Both have {i64, ptr} layout (16B)
                            ; but Array.vector is ptr-to-inner-Vector, NOT
                            ; ptr-to-elements. Per-field memcpy would store
                            ; Array.vector into Vector.data → for-iter sees
                            ; garbage element ptrs → empty IR at stage-2.
                            ; Inline the semantic of stage-0's
                            ; Vector::C1E(rp, Array) — share the inner
                            ; Vector's data buffer (RBMM-safe, both on rp):
                            ;   v.length = arr.length
                            ;   v.data   = (*arr.vector).data
                            ; Discriminator: source struct's name matches
                            ; "_Z5Array..." (Array-encoded Itanium prefix).
                            if LLVMGetTypeKind(cv0_ty) = LLVMTypeKind.Struct()
                            {
                                if cv0_ty.handle <> struct_type.handle
                                {
                                    let source_name_c LLVMGetStructName(cv0_ty)
                                    if source_name_c <> null
                                    {
                                        let source_name String(source_name_c)
                                        if source_name.starts_with("_Z5Array")
                                        {
                                            ; Branch on Array.vector != null: empty
                                            ; Arrays have vector=null and load would
                                            ; SEGV. Store {0, null} for empty,
                                            ; {arr.length, inner.data} otherwise.
                                            let arr_len LLVMBuildExtractValue(builder, cv0, 0, "arr.length")
                                            let arr_vec_ptr LLVMBuildExtractValue(builder, cv0, 1, "arr.vector")
                                            let null_ptr LLVMConstNull(LLVMPointerTypeInContext(context, 0))
                                            let is_null LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), arr_vec_ptr, null_ptr, "arr.vec.isnull")
                                            let then_block create_block("conv.empty")
                                            let else_block create_block("conv.deref")
                                            let end_block create_block("conv.end")
                                            LLVMBuildCondBr(builder, is_null, then_block, else_block)
                                            LLVMPositionBuilderAtEnd(builder, then_block)
                                            let len_gep_e LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 0, "v.length.ptr")
                                            LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext context, 0, 0), len_gep_e)
                                            let data_gep_e LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 1, "v.data.ptr")
                                            LLVMBuildStore(builder, null_ptr, data_gep_e)
                                            LLVMBuildBr(builder, end_block)
                                            LLVMPositionBuilderAtEnd(builder, else_block)
                                            var inner_ftys Vector[LLVMTypeRef](2)
                                            inner_ftys.put(0, LLVMInt64TypeInContext context)
                                            inner_ftys.put(1, LLVMPointerTypeInContext(context, 0))
                                            let inner_vec_ty LLVMStructTypeInContext(context, inner_ftys.data, 2, 0)
                                            let inner_vec LLVMBuildLoad2(builder, inner_vec_ty, arr_vec_ptr, "arr.inner")
                                            let inner_data LLVMBuildExtractValue(builder, inner_vec, 1, "arr.inner.data")
                                            let len_gep LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 0, "v.length.ptr")
                                            LLVMBuildStore(builder, arr_len, len_gep)
                                            let data_gep LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 1, "v.data.ptr")
                                            LLVMBuildStore(builder, inner_data, data_gep)
                                            LLVMBuildBr(builder, end_block)
                                            LLVMPositionBuilderAtEnd(builder, end_block)
                                            if tuple.is_region_alloc = false
                                                return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                                            return tuple_ptr
                                        }
                                    }
                                }
                            }

                            ; s165: pointer-to-Array → Vector convert. When the
                            ; single component is a `var X Array[T]$()` heap
                            ; binding, the operand value is a POINTER to the Array
                            ; struct (the var holds the region pointer), so cv0 is
                            ; `ptr` and the Struct-kind branch above cannot fire.
                            ; lookup_operators#/lookup_functions# return
                            ; `Vector[T]^rp(matches)` exactly this way. Without
                            ; this branch, emit_tuple falls through to the
                            ; per-field store and writes the Array pointer into the
                            ; Vector's i64 length field (data left uninitialized)
                            ; → garbage Vector with nonzero length, then any
                            ; `.get(0)` deref SIGSEGVs (s164 resolve_operator_call#
                            ; crash). Load the Array struct through the pointer,
                            ; then share the inner Vector's data buffer exactly
                            ; like the value-source branch above.
                            if LLVMGetTypeKind(cv0_ty) = LLVMTypeKind.Pointer()
                            {
                                if comp0_is_array
                                {
                                    let tgt_name_c LLVMGetStructName(struct_type)
                                    if tgt_name_c <> null
                                    {
                                        let tgt_name String(tgt_name_c)
                                        if tgt_name.starts_with("_Z6Vector")
                                        {
                                            var arr_ftys Vector[LLVMTypeRef](2)
                                            arr_ftys.put(0, LLVMInt64TypeInContext context)
                                            arr_ftys.put(1, LLVMPointerTypeInContext(context, 0))
                                            let arr_struct_ty LLVMStructTypeInContext(context, arr_ftys.data, 2, 0)
                                            let arr_val LLVMBuildLoad2(builder, arr_struct_ty, cv0, "arrptr.load")
                                            let arr_len LLVMBuildExtractValue(builder, arr_val, 0, "arr.length")
                                            let arr_vec_ptr LLVMBuildExtractValue(builder, arr_val, 1, "arr.vector")
                                            let null_ptr2 LLVMConstNull(LLVMPointerTypeInContext(context, 0))
                                            let is_null2 LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), arr_vec_ptr, null_ptr2, "arr.vec.isnull")
                                            let then_block2 create_block("convp.empty")
                                            let else_block2 create_block("convp.deref")
                                            let end_block2 create_block("convp.end")
                                            LLVMBuildCondBr(builder, is_null2, then_block2, else_block2)
                                            LLVMPositionBuilderAtEnd(builder, then_block2)
                                            let len_gep_e2 LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 0, "v.length.ptr")
                                            LLVMBuildStore(builder, LLVMConstInt(LLVMInt64TypeInContext context, 0, 0), len_gep_e2)
                                            let data_gep_e2 LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 1, "v.data.ptr")
                                            LLVMBuildStore(builder, null_ptr2, data_gep_e2)
                                            LLVMBuildBr(builder, end_block2)
                                            LLVMPositionBuilderAtEnd(builder, else_block2)
                                            var inner_ftys2 Vector[LLVMTypeRef](2)
                                            inner_ftys2.put(0, LLVMInt64TypeInContext context)
                                            inner_ftys2.put(1, LLVMPointerTypeInContext(context, 0))
                                            let inner_vec_ty2 LLVMStructTypeInContext(context, inner_ftys2.data, 2, 0)
                                            let inner_vec2 LLVMBuildLoad2(builder, inner_vec_ty2, arr_vec_ptr, "arr.inner")
                                            let inner_data2 LLVMBuildExtractValue(builder, inner_vec2, 1, "arr.inner.data")
                                            let len_gep2 LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 0, "v.length.ptr")
                                            LLVMBuildStore(builder, arr_len, len_gep2)
                                            let data_gep2 LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, 1, "v.data.ptr")
                                            LLVMBuildStore(builder, inner_data2, data_gep2)
                                            LLVMBuildBr(builder, end_block2)
                                            LLVMPositionBuilderAtEnd(builder, end_block2)
                                            if tuple.is_region_alloc = false
                                                return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")
                                            return tuple_ptr
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ; Store component values into struct fields. Use (*ref) instead
            ; of .unwrap() — the intrinsic Option.unwrap on `ref[LLVMValueRef]?`
            ; segfaults in stage-1 when the inner type is a struct.
            ; s105: when the field's declared type is wider than the
            ; component value's type (e.g. literal `0` as i32 stored into a
            ; size_t field), zext/sext the component before storing.
            ; Without this, `Page(buf, 0)` writes i32 0 into a 64-bit slot,
            ; leaving the high 4 bytes of `offset` as stack garbage that
            ; subsequent `&` arithmetic dereferences into a SIGSEGV.
            set i: 0
            while i < comp_count
            {
                let cv_ref comp_values.get i
                if cv_ref <> null
                {
                    var cv (*cv_ref)
                    let field_ty LLVMStructGetTypeAtIndex(struct_type, i as int)
                    if field_ty.handle <> null
                    {
                        let cv_ty LLVMTypeOf(cv)
                        if LLVMGetTypeKind(cv_ty) = LLVMTypeKind.Integer()
                        {
                            if LLVMGetTypeKind(field_ty) = LLVMTypeKind.Integer()
                            {
                                let cv_w LLVMGetIntTypeWidth(cv_ty)
                                let f_w LLVMGetIntTypeWidth(field_ty)
                                if cv_w < f_w
                                    set cv: LLVMBuildSExt(builder, cv, field_ty, "tuple.sext")
                                if cv_w > f_w
                                    set cv: LLVMBuildTrunc(builder, cv, field_ty, "tuple.trunc")
                            }
                        }
                        ; Mirror stage-0 Emitter.cpp:6456-6469: when the value is a
                        ; ptr but the field expects a struct, load the struct from
                        ; the pointer before storing. Without this, an 8-byte ptr
                        ; gets written into a wider struct slot and high bytes are
                        ; stack garbage — observed: Vector[Module](0) stored into
                        ; Module.modules (Vector<Module>=16B) leaves modules.data
                        ; uninitialized AND puts the heap ptr into modules.length,
                        ; making build_program's prelude loop run ~37 billion times.
                        if LLVMGetTypeKind(cv_ty) = LLVMTypeKind.Pointer()
                        {
                            if LLVMGetTypeKind(field_ty) = LLVMTypeKind.Struct()
                            {
                                if LLVMIsNull(cv) <> 0
                                    set cv: LLVMConstNull(field_ty)
                                if LLVMIsNull(cv) = 0
                                    set cv: LLVMBuildLoad2(builder, field_ty, cv, "field.load")
                            }
                        }
                    }
                    let field_ptr LLVMBuildStructGEP2(builder, struct_type, tuple_ptr, i as u32, "tuple.field")
                    ; s178: memcpy when cv is a load (struct components such
                    ; as a PlannedExpression field are spill-heavy otherwise).
                    let cv_st_ty LLVMTypeOf(cv)
                    copy_struct_value(field_ptr, cv, cv_st_ty)
                }
                set i: i + 1
            }

            ; Mirror stage-0 (Emitter.cpp:6493-6499): for non-region-alloc
            ; (stack), load the struct value before returning. emit_binding
            ; calls LLVMTypeOf on this result; without the load it sees
            ; ptr and alloca's a ptr-typed slot for `var opts Opts(...)`,
            ; making subsequent `set opts.field: ...` GEPs corrupt the
            ; pointer instead of writing struct fields. Region-alloc
            ; ($/#/^) keeps returning the heap pointer.
            if tuple.is_region_alloc = false
                return LLVMBuildLoad2(builder, struct_type, tuple_ptr, "tuple.val")

            tuple_ptr
        }

        ; Emit a matrix (array literal)
        function emit_matrix(this, matrix: PlannedMatrix) returns LLVMValueRef
        {
            if matrix.operations = null
                return LLVMValueRef null

            let ops_ref matrix.operations.unwrap()
            let ops (*ops_ref)

            ; For a 1D array, operations is a vector of single-element vectors
            ; Count total elements
            var total_count: size_t 0
            var row_idx: size_t 0
            while row_idx < ops.length
            {
                let row_ptr ops.get row_idx
                if row_ptr <> null
                {
                    let row (*row_ptr)
                    set total_count: total_count + row.length
                }
                set row_idx: row_idx + 1
            }

            if total_count = 0
                return LLVMValueRef null

            ; Emit all element values
            var element_values Vector[LLVMValueRef](total_count)
            var elem_idx: size_t 0
            set row_idx: 0
            while row_idx < ops.length
            {
                let row_ptr ops.get row_idx
                if row_ptr <> null
                {
                    let row (*row_ptr)
                    var col_idx: size_t 0
                    while col_idx < row.length
                    {
                        let operand_ptr row.get col_idx
                        if operand_ptr <> null
                        {
                            let operand operand_ptr.unwrap()
                            let value emit_operand operand
                            element_values.put(elem_idx, value)
                            set elem_idx: elem_idx + 1
                        }
                        set col_idx: col_idx + 1
                    }
                }
                set row_idx: row_idx + 1
            }

            ; Create array type
            let element_llvm_type map_type matrix.element_type
            ; Guard against unsized element types. When the planner can't
            ; resolve the matrix's element type (e.g. top-level array
            ; literals in root_pages.scaly with unresolved generic walk),
            ; map_type returns void, and LLVMBuildAlloca([N x void]) hits
            ; an LLVM assertion in DataLayout::getTypeSizeInBits (rc=133).
            ; Same shape as the s97 emit_throw void-ret guard.
            if LLVMGetTypeKind(element_llvm_type) = LLVMTypeKind.Void()
                return LLVMValueRef null
            let array_type LLVMArrayType2(element_llvm_type, total_count)

            ; Allocate array on stack
            let array_ptr entry_alloca(array_type, "array")

            ; Store each element using GEP
            let i64_type LLVMInt64TypeInContext(context)
            let zero LLVMConstInt(i64_type, 0, 0)

            set elem_idx: 0
            while elem_idx < total_count
            {
                let elem_value element_values.get elem_idx
                if elem_value <> null
                {
                    ; Build GEP with indices [0, elem_idx]
                    var indices Vector[LLVMValueRef](2)
                    indices.put(0, zero)
                    indices.put(1, LLVMConstInt(i64_type, elem_idx, 0))

                    let elem_ptr LLVMBuildInBoundsGEP2(builder, array_type, array_ptr, indices.data, 2, "array.elem")
                    LLVMBuildStore(builder, elem_value.unwrap(), elem_ptr)
                }
                set elem_idx: elem_idx + 1
            }

            array_ptr
        }

        ; ========================================================================
        ; Control Flow Emission
        ; ========================================================================

        ; Emit a block
        function emit_block(this, block: PlannedBlock) returns LLVMValueRef
        {
            var last_value LLVMValueRef(null)

            if block.statements <> null
            {
                for stmt in block.statements
                {
                    choose stmt
                        when action: Action
                        {
                            let value emit_action action
                            ; Only save value if it's not an assignment
                            if action.target = null
                                set last_value: value
                            else
                            {
                                if action.target.length = 0
                                    set last_value: value
                            }
                        }
                        when ret: Return
                        {
                            emit_return ret
                            return LLVMValueRef null
                        }
                        else
                        {
                            emit_statement stmt
                        }
                }
            }

            last_value
        }

        ; Emit an if expression
        function emit_if(this, if_expr: PlannedIf) returns LLVMValueRef
        {
            ; Emit the condition
            let cond_value emit_operands if_expr.condition
            if cond_value.handle = null
                return LLVMValueRef null

            ; Ensure we have a boolean (i1) for the branch. LLVMGetTypeKind
            ; returns IntegerTypeKind for i1, i32, i64, etc.; a kind-only check
            ; would miss i32/i64 conds and emit `br i32 %x, ...`. Compare the
            ; integer bit-width instead.
            var bool_cond cond_value
            let cond_type LLVMTypeOf(cond_value)

            ; If not i1, convert to boolean via icmp ne 0
            if LLVMGetIntTypeWidth(cond_type) <> 1
            {
                let zero LLVMConstInt(cond_type, 0, 0)
                set bool_cond: LLVMBuildICmp(builder, LLVMIntPredicate.NE(), cond_value, zero, "if.tobool")
            }

            ; Create basic blocks
            let then_block create_block("if.then")
            var else_block LLVMBasicBlockRef(null)
            if if_expr.alternative <> null
                set else_block: create_block("if.else")
            let merge_block create_block("if.end")

            ; Branch based on condition
            if else_block.handle <> null
                LLVMBuildCondBr(builder, bool_cond, then_block, else_block)
            else
                LLVMBuildCondBr(builder, bool_cond, then_block, merge_block)

            ; Emit then block
            LLVMPositionBuilderAtEnd(builder, then_block)
            ; s128: fresh scope for the then-branch so any `var`/`let` in
            ; it doesn't leak into the else-branch or the code after merge.
            enter_scope()
            var then_value LLVMValueRef(null)

            ; session 25 pattern: choose ref[T]? when x: Some yields a garbage
            ; binding under NPO; use explicit null-if + deref instead.
            if if_expr.consequent <> null
            {
                let cons_ref if_expr.consequent
                ; For Action-variant consequents, emit_action returns the
                ; LLVMValueRef produced by the block's last expression so the
                ; if-as-expression can propagate it through a PHI. For
                ; terminating statements (return/throw/break/continue) the
                ; value stays null and the PHI is skipped.
                choose (*cons_ref)
                    when action: Action
                        set then_value: emit_action(action)
                    else
                        emit_statement(*cons_ref)
            }

            ; Jump to merge block if not already terminated
            let then_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if then_term.handle = null
                LLVMBuildBr(builder, merge_block)
            let then_end_block LLVMGetInsertBlock(builder)
            ; s178: the then-value feeds the merge PHI that doesn't exist
            ; yet — protect its slot from the scope-exit release.
            pin_temp_value then_value
            ; s128: balance the then-branch scope.
            exit_scope()

            ; Emit else block if present
            var else_value LLVMValueRef(null)
            var else_end_block LLVMBasicBlockRef(null)

            if else_block.handle <> null
            {
                LLVMPositionBuilderAtEnd(builder, else_block)
                ; s128: fresh scope for the else-branch.
                enter_scope()

                if if_expr.alternative <> null
                {
                    let alt_ref if_expr.alternative
                    choose (*alt_ref)
                        when action: Action
                            set else_value: emit_action(action)
                        else
                            emit_statement(*alt_ref)
                }

                let else_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                if else_term.handle = null
                    LLVMBuildBr(builder, merge_block)
                set else_end_block: LLVMGetInsertBlock(builder)
                ; s178: same PHI protection as the then-branch.
                pin_temp_value else_value
                ; s128: balance the else-branch scope.
                exit_scope()
            }

            ; Continue at merge block
            LLVMPositionBuilderAtEnd(builder, merge_block)

            ; If both branches produce values of the same type, create a PHI node
            if then_value.handle <> null
            {
                if else_value.handle <> null
                {
                    if then_end_block.handle <> null
                    {
                        if else_end_block.handle <> null
                        {
                            let then_ty LLVMTypeOf(then_value)
                            let else_ty LLVMTypeOf(else_value)

                            ; Only build a PHI when both branches yield the same
                            ; LLVM type. Stage-1's variant construction
                            ; `Union.Variant(payload)` currently collapses to the
                            ; bare payload type (a separate planner gap), so the
                            ; two arms of an `if` whose branches construct
                            ; different union variants produce mismatched struct
                            ; types (e.g. Type vs Global). Building a PHI then
                            ; fails llc with "defined with type X but expected Y".
                            ; emit_choose handles this via its phi_ref_type lock;
                            ; mirror it here. When types mismatch, skip the PHI —
                            ; both branches already br to merge, so the IR stays
                            ; valid; the if simply yields no value.
                            if then_ty.handle <> else_ty.handle
                                return LLVMValueRef null

                            ; Skip the PHI when the branch values are void.
                            ; emit_action returns the LAST value it produced;
                            ; for a branch whose final expression is a void call
                            ; (e.g. `LLVMSetLinkage(...)`) that value is a void
                            ; instruction. `then_ty = else_ty = void` passes the
                            ; type-match if above, but `phi void` is invalid
                            ; IR ("void type only allowed for function results")
                            ; and crashes object codegen. Both arms already br to
                            ; merge, so skipping the PHI yields valid value-less
                            ; IR. Mirrors emit_choose's s97 void-input skip.
                            if LLVMGetTypeKind(then_ty) = LLVMTypeKind.Void()
                                return LLVMValueRef null
                            if LLVMGetTypeKind(else_ty) = LLVMTypeKind.Void()
                                return LLVMValueRef null

                            ; Create PHI node (types match)
                            let phi LLVMBuildPhi(builder, then_ty, "if.value")

                            ; Add incoming values - need arrays for LLVMAddIncoming
                            var values Vector[LLVMValueRef](2)
                            var blocks Vector[LLVMBasicBlockRef](2)
                            values.put(0, then_value)
                            values.put(1, else_value)
                            blocks.put(0, then_end_block)
                            blocks.put(1, else_end_block)

                            LLVMAddIncoming(phi, values.data, blocks.data, 2)
                            return phi
                        }
                    }
                }
            }

            ; A no-else if yields NO value: on the false path control reaches
            ; merge without producing one, so the then-value is not defined on
            ; every predecessor. Returning it here fed enclosing merge PHIs an
            ; operand that doesn't dominate its incoming edge (an `if set-stmt
            ; else if set-stmt` chain built a dead, non-dominating if.value phi
            ; that llc's verifier rejects).
            LLVMValueRef null
        }

        ; Emit a match expression
        function emit_match(this, match_expr: PlannedMatch) returns LLVMValueRef
        {
            ; Compare-chain match (port of stage-0 emitMatch, Emitter.cpp:5145):
            ; per branch, OR-combine `scrutinee = case` compares (ICmp for ints,
            ; FCmp for floats — the old LLVMBuildSwitch was integer-only) and
            ; CondBr to the branch body. Branch-body values feed a match.value
            ; PHI mirroring emit_choose's type-locked, void-gated PHI with undef
            ; fill for valueless predecessors (s124); the old version returned
            ; null unconditionally, so match-as-expression yielded no value.
            let cond_value emit_operands match_expr.condition
            if cond_value.handle = null
                return LLVMValueRef null

            let cond_type LLVMTypeOf(cond_value)
            let cond_kind LLVMGetTypeKind(cond_type)
            var cond_is_float: bool false
            if cond_kind = LLVMTypeKind.Float()
                set cond_is_float: true
            if cond_kind = LLVMTypeKind.Double()
                set cond_is_float: true

            let merge_block create_block("match.end")

            var branch_total: size_t 0
            if match_expr.branches <> null
            {
                let btr match_expr.branches
                set branch_total: (*btr).length
            }
            var has_alternative: bool false
            if match_expr.alternative <> null
                set has_alternative: true

            ; Each branch contributes at most one PHI entry (value or undef),
            ; plus one for the chain fall-through edge and one for the else arm.
            let max_count branch_total + 2
            var phi_values Vector[LLVMValueRef](max_count)
            var phi_blocks Vector[LLVMBasicBlockRef](max_count)
            var phi_count: size_t 0
            var phi_ref_type LLVMTypeRef(null)
            var undef_blocks Vector[LLVMBasicBlockRef](max_count)
            var undef_count: size_t 0

            ; Degenerate no-branch, no-else match: terminate the entry block so
            ; the merge repositioning below never leaves it unterminated.
            if branch_total = 0
            {
                if has_alternative = false
                    LLVMBuildBr(builder, merge_block)
            }

            if match_expr.branches <> null
            {
                let branches_ref match_expr.branches
                var bi: size_t 0
                while bi < branch_total
                {
                    let branch_ptr (*branches_ref).get bi
                    if branch_ptr <> null
                    {
                        let case_block create_block("match.case")
                        var next_block merge_block
                        var next_is_merge: bool true
                        if bi + 1 < branch_total
                        {
                            set next_block: create_block("match.next")
                            set next_is_merge: false
                        }
                        else
                        {
                            if has_alternative
                            {
                                set next_block: create_block("match.next")
                                set next_is_merge: false
                            }
                        }

                        ; OR-combined compare chain in the current block.
                        var branch_cond LLVMValueRef(null)
                        if (*branch_ptr).cases <> null
                        {
                            let cases_ref (*branch_ptr).cases
                            for case_cond in (*cases_ref)
                            {
                                let case_value emit_operands case_cond.condition
                                if case_value.handle <> null
                                {
                                    var case_cmp LLVMValueRef(null)
                                    if cond_is_float
                                        set case_cmp: LLVMBuildFCmp(builder, LLVMRealPredicate.OEQ(), cond_value, case_value, "match.cmp")
                                    else
                                        set case_cmp: LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), cond_value, case_value, "match.cmp")
                                    if branch_cond.handle = null
                                        set branch_cond: case_cmp
                                    else
                                        set branch_cond: LLVMBuildOr(builder, branch_cond, case_cmp, "match.or")
                                }
                            }
                        }

                        ; The chain block's false edge: when it goes straight to
                        ; merge (last branch, no else), it is a valueless PHI
                        ; predecessor.
                        let chain_block LLVMGetInsertBlock(builder)
                        if branch_cond.handle <> null
                            LLVMBuildCondBr(builder, branch_cond, case_block, next_block)
                        else
                            LLVMBuildBr(builder, case_block)
                        if next_is_merge
                        {
                            if branch_cond.handle <> null
                            {
                                undef_blocks.put(undef_count, chain_block)
                                set undef_count: undef_count + 1
                            }
                        }

                        ; Emit the branch body. s25/s28: unwrap
                        ; ref[PlannedStatement]? via if + explicit deref; s32:
                        ; Action-variant consequents go through emit_action so
                        ; the branch yields a real value for the PHI.
                        LLVMPositionBuilderAtEnd(builder, case_block)
                        enter_scope()
                        var branch_value LLVMValueRef(null)
                        if (*branch_ptr).consequent <> null
                        {
                            let stmt_ref (*branch_ptr).consequent
                            choose (*stmt_ref)
                                when action: Action
                                    set branch_value: emit_action(action)
                                else
                                    emit_statement(*stmt_ref)
                        }
                        let case_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if case_term.handle = null
                        {
                            let case_end_block LLVMGetInsertBlock(builder)
                            var added_phi: bool false
                            if branch_value.handle <> null
                            {
                                ; s97: skip void-typed and type-mismatched PHI
                                ; inputs — lock the type from the first typed
                                ; value (LLVM types are uniqued, handle compare).
                                let bv_type LLVMTypeOf(branch_value)
                                if bv_type.handle <> null
                                {
                                    if LLVMGetTypeKind(bv_type) <> LLVMTypeKind.Void()
                                    {
                                        if phi_ref_type.handle = null
                                            set phi_ref_type: bv_type
                                        if bv_type.handle = phi_ref_type.handle
                                        {
                                            phi_values.put(phi_count, branch_value)
                                            phi_blocks.put(phi_count, case_end_block)
                                            set phi_count: phi_count + 1
                                            set added_phi: true
                                        }
                                    }
                                }
                            }
                            if added_phi = false
                            {
                                undef_blocks.put(undef_count, case_end_block)
                                set undef_count: undef_count + 1
                            }
                            LLVMBuildBr(builder, merge_block)
                        }
                        ; s178: the branch value feeds the merge PHI that doesn't
                        ; exist yet — protect its slot from scope-exit release.
                        pin_temp_value branch_value
                        exit_scope()

                        ; Continue the chain in next_block (unless it is merge).
                        if next_is_merge = false
                            LLVMPositionBuilderAtEnd(builder, next_block)
                    }
                    set bi: bi + 1
                }
            }

            ; The else arm, emitted in the trailing chain block. s25/s28 unwrap.
            if match_expr.alternative <> null
            {
                enter_scope()
                var alt_value LLVMValueRef(null)
                let alt_ref match_expr.alternative
                choose (*alt_ref)
                    when action: Action
                        set alt_value: emit_action(action)
                    else
                        emit_statement(*alt_ref)
                let alt_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                if alt_term.handle = null
                {
                    let alt_end_block LLVMGetInsertBlock(builder)
                    var added_alt: bool false
                    if alt_value.handle <> null
                    {
                        let av_type LLVMTypeOf(alt_value)
                        if av_type.handle <> null
                        {
                            if LLVMGetTypeKind(av_type) <> LLVMTypeKind.Void()
                            {
                                if phi_ref_type.handle = null
                                    set phi_ref_type: av_type
                                if av_type.handle = phi_ref_type.handle
                                {
                                    phi_values.put(phi_count, alt_value)
                                    phi_blocks.put(phi_count, alt_end_block)
                                    set phi_count: phi_count + 1
                                    set added_alt: true
                                }
                            }
                        }
                    }
                    if added_alt = false
                    {
                        undef_blocks.put(undef_count, alt_end_block)
                        set undef_count: undef_count + 1
                    }
                    LLVMBuildBr(builder, merge_block)
                }
                pin_temp_value alt_value
                exit_scope()
            }

            ; Continue at merge block
            LLVMPositionBuilderAtEnd(builder, merge_block)

            ; Build the match.value PHI when at least one branch produced a
            ; typed value; append undef entries for every valueless predecessor
            ; so the PHI covers each incoming edge (s124).
            if phi_count > 0
            {
                let first_ptr phi_values.get 0
                if first_ptr <> null
                {
                    ; Bind the deref'd value to a local first (deref-arg quirk,
                    ; see emit_choose).
                    let first_val (*first_ptr)
                    let phi_ty LLVMTypeOf(first_val)
                    let undef_val LLVMGetUndef(phi_ty)
                    var ui: size_t 0
                    while ui < undef_count
                    {
                        let ub_ptr undef_blocks.get ui
                        if ub_ptr <> null
                        {
                            phi_values.put(phi_count, undef_val)
                            phi_blocks.put(phi_count, (*ub_ptr))
                            set phi_count: phi_count + 1
                        }
                        set ui: ui + 1
                    }
                    let phi LLVMBuildPhi(builder, phi_ty, "match.value")
                    LLVMAddIncoming(phi, phi_values.data, phi_blocks.data, phi_count as int)
                    return phi
                }
            }

            LLVMValueRef null
        }

        ; Emit a choose expression (pattern match on union)
        function emit_choose(this, choose_expr: PlannedChoose) returns LLVMValueRef
        {
            ; Emit the condition (union value)
            let union_value emit_operands choose_expr.condition
            if union_value.handle = null
                return LLVMValueRef null

            ; The union struct type for GEP must come from the condition's
            ; PlannedType, NOT LLVMTypeOf(union_value) — the latter yields
            ; opaque `ptr` whenever the union arrived as a by-pointer
            ; parameter (which produces invalid IR like
            ; `getelementptr inbounds ptr, ptr %0, ...` and crashes the
            ; AOT IRTranslator on -o).
            ; A method's `this` parameter binds as pointer[T] (see
            ; plan_function# at ~line 5697), so the condition's result_type
            ; carries the pointer wrapper. Peel pointer[T] / ref[T] one
            ; level so map_type resolves the underlying union struct.
            var union_type LLVMTypeRef(null)
            var is_npo: bool false
            if choose_expr.condition <> null
            {
                let cond_vec (*choose_expr.condition)
                if cond_vec.length > 0
                {
                    let last_op_ptr cond_vec.get(cond_vec.length - 1)
                    if last_op_ptr <> null
                    {
                        let cond_op (*last_op_ptr)
                        var rt cond_op.result_type
                        if rt.name = "pointer"
                        {
                            if rt.generics <> null
                            {
                                let gens (*rt.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                        set rt: (*inner_ptr)
                                }
                            }
                        }
                        if rt.name = "ref"
                        {
                            if rt.generics <> null
                            {
                                let gens (*rt.generics)
                                if gens.length > 0
                                {
                                    let inner_ptr gens.get 0
                                    if inner_ptr <> null
                                        set rt: (*inner_ptr)
                                }
                            }
                        }
                        ; s99: NPO Option detection. Option[ref[T]] /
                        ; Option[pointer[T]] is represented as a single
                        ; nullable pointer (null=None, non-null=Some).
                        ; Stage-1's planner collapses `T?` into ref/pointer
                        ; directly without an Option wrapper, so detect via
                        ; the original (pre-unwrap) result_type name plus
                        ; case-name shape (Some/None). The tagged-union IR
                        ; path otherwise produces `getelementptr ptr, ptr,
                        ; i32 0, i32 0` which llc/IRTranslator rejects.
                        if cond_op.result_type.name = "ref"
                            set is_npo: true
                        if cond_op.result_type.name = "pointer"
                            set is_npo: true
                        ; s103: Option is NPO only when its inner type is a
                        ; pointer or ref. Option[int] / Option[Struct] use
                        ; the tagged-union layout { i8 tag, [N x i8] data };
                        ; flagging them as NPO produces `icmp eq ptr null`
                        ; against the union pointer (always 0 for non-null),
                        ; folds the choose to the else branch, and drops
                        ; the Some-arm result. Mirrors stage-0
                        ; Planner.cpp:970-976 (NPO detection only on
                        ; Option[ref|pointer]).
                        if cond_op.result_type.name = "Option"
                        {
                            if cond_op.result_type.generics <> null
                            {
                                let opt_gens (*cond_op.result_type.generics)
                                if opt_gens.length > 0
                                {
                                    let inner_g_ptr opt_gens.get 0
                                    if inner_g_ptr <> null
                                    {
                                        let inner_g (*inner_g_ptr)
                                        if inner_g.name = "ref"
                                            set is_npo: true
                                        if inner_g.name = "pointer"
                                            set is_npo: true
                                    }
                                }
                            }
                        }
                        ; Confirm via case-name: NPO Option chooses always
                        ; have Some (variant 0) and possibly None (variant 1).
                        ; Without this confirmation, choose-on-pointer-to-
                        ; union (e.g. `choose this` where this: pointer[U])
                        ; would incorrectly enter the NPO path.
                        if is_npo
                        {
                            ; s173: a resolved variant_type on any arm means
                            ; the planner matched a real union variant (e.g.
                            ; `choose stmt` over ref[PlannedStatement] from a
                            ; for-in loop variable, after plan_choose#'s ref
                            ; peel) — dispatch via the tagged path, not the
                            ; NPO null-check. Skip this demotion for throws-
                            ; call conditions: their synthetic Success arm
                            ; carries a non-void variant_type (s172) but
                            ; still needs the null-tag handling (s157).
                            var cond_is_throws: bool false
                            choose cond_op.expr
                                when tcall: Call
                                    if tcall.can_throw
                                        set cond_is_throws: true
                                else
                                    0
                            if cond_is_throws = false
                            {
                                var has_resolved_variant: bool false
                                if choose_expr.cases <> null
                                {
                                    let rcases (*choose_expr.cases)
                                    var ri: size_t 0
                                    while ri < rcases.length
                                    {
                                        let rc_ptr rcases.get ri
                                        if rc_ptr <> null
                                        {
                                            let rc (*rc_ptr)
                                            if rc.variant_type.name <> "void"
                                                set has_resolved_variant: true
                                        }
                                        set ri: ri + 1
                                    }
                                }
                                if has_resolved_variant
                                    set is_npo: false
                            }
                            var has_some: bool false
                            if choose_expr.cases <> null
                            {
                                let cases (*choose_expr.cases)
                                var ci: size_t 0
                                while ci < cases.length
                                {
                                    let c_ptr cases.get ci
                                    if c_ptr <> null
                                    {
                                        let c (*c_ptr)
                                        ; Variant index 0 with name implies Some.
                                        if c.variant_index = 0
                                        {
                                            if c.name.length > 0
                                                set has_some: true
                                        }
                                    }
                                    set ci: ci + 1
                                }
                            }
                            if has_some = false
                                set is_npo: false
                            ; A genuine tagged union declared in the plan is never
                            ; NPO — that collapse is Option[ref/pointer] only. A
                            ; `choose this` over a pointer to such a union (opensp's
                            ; CodingSystem, 3 nullary variants) otherwise mis-detects
                            ; as NPO here (pointer scrutinee + a named variant-0 arm
                            ; the has_some heuristic can't rule out) and dispatches on
                            ; `this == null`, always taking variant 0.
                            if is_npo
                                if rt.name <> "Option"
                                    if this.type_name_is_plan_union(rt.name)
                                        set is_npo: false
                        }
                        set union_type: map_type(rt)
                        ; s114: when map_type falls back to opaque ptr (the
                        ; underlying union/struct isn't in struct_cache), use
                        ; the `{ ptr }` placeholder struct instead. Stage-1
                        ; calls into cross-package functions returning unions
                        ; that aren't fully planned here (e.g. Parser.parse_file
                        ; returns FileSyntax in a union throw shape); without
                        ; this, emit_call's sret slot is allocated as `{ ptr }`
                        ; (via get_or_create_struct_placeholder) but the
                        ; subsequent `LLVMBuildStructGEP2(union_type, ...)`
                        ; here uses `ptr` and emits an invalid
                        ; `getelementptr inbounds ptr, ptr %sret.result, ...`
                        ; that llc/IRTranslator rejects on -c.
                        if LLVMGetTypeKind(union_type) = LLVMTypeKind.Pointer()
                            set union_type: get_or_create_struct_placeholder(rt.name, rt.mangled_name)
                    }
                }
            }
            if union_type.handle = null
                set union_type: LLVMTypeOf(union_value)

            ; Union layout: { i8 tag, [maxSize x i8] data }
            ; Store union if not already a pointer. LLVMTypeKind.Pointer
            ; is 12 (LLVMTypeKind.Metadata is 14 — the magic-number comment
            ; that previously read "14 in LLVM" was wrong, see LLVM.scaly).
            var union_ptr union_value
            ; Decide alloca+store via the planner's result_type, not by
            ; introspecting the LLVMValueRef. Stage-0 lowers a nested extern
            ; call `LLVMGetTypeKind(LLVMTypeOf union_value)` by storing the
            ; LLVMTypeRef value into a `{ptr}`-typed temp alloca and passing
            ; the alloca ADDRESS to LLVMGetTypeKind — so `value_kind` was
            ; reading garbage from stack memory, not the real type kind.
            ; When the garbage happens to equal 12, the alloca+store branch
            ; was skipped and `choose token` over a struct field emitted
            ; `getelementptr inbounds %_Z5Token, ptr %extracted, 0, 0` —
            ; treating the extracted struct VALUE as a pointer (parse_colon
            ; SEGV in stage-2 reading tag.ptr).
            ; The peeling block above already detected pointer[T]/ref[T] on
            ; the condition's result_type. Reuse that signal: a pointer-typed
            ; condition means union_value is already a pointer to the union;
            ; a value-typed condition (struct value) needs alloca+store.
            var cond_is_pointer: bool false
            ; s143: throws-call return type for binding the synthetic Success
            ; arm to the bare sret value. Stage-1 doesn't wrap throws returns
            ; in a Result struct, so for `choose parse_X() when success:
            ; Success ...`, the bound `success` should be the entire sret slot
            ; loaded as the call's return_type — not the variant_type the
            ; planner couldn't resolve and fell back to void.
            var is_throws_call: bool false
            var throws_call_return_type: PlannedType Planner.make_void_type()
            ; s157: a throws-call returning a pointer/ref (e.g.
            ; parse_declaration_list# -> ref[Vector[..]]?) is NOT wrapped in
            ; the sret Result struct — it returns the bare pointer and signals
            ; an error by returning null (NPO-style, see emit_throw 7166-7197).
            ; For these, union_value IS the returned pointer (null=error), so
            ; the tag must come from a null-check and the Success arm binds
            ; union_value directly — NOT a load from the (nonexistent) Result
            ; wrapper's offset-1 data field.
            var throws_is_ptr: bool false
            if choose_expr.condition <> null
            {
                let cond_vec (*choose_expr.condition)
                if cond_vec.length > 0
                {
                    let last_op_ptr cond_vec.get(cond_vec.length - 1)
                    if last_op_ptr <> null
                    {
                        let cond_op (*last_op_ptr)
                        if cond_op.result_type.name = "pointer"
                            set cond_is_pointer: true
                        if cond_op.result_type.name = "ref"
                            set cond_is_pointer: true
                        ; s143: an sret-returning call yields the sret slot
                        ; pointer as its LLVM value, even though the planner's
                        ; result_type names the bare struct. Without this, the
                        ; alloca+store path below stores the pointer VALUE into
                        ; a struct-typed alloca and the subsequent GEP reads
                        ; the low byte of the pointer as the union tag —
                        ; observed as parse_declaration falling through to its
                        ; default choose.end (calling parse_use directly) for
                        ; hello.scaly because byte 0 of the stack address
                        ; sp+0x90 was 0x90 (neither 0 nor 1). Detect throws
                        ; calls and treat union_value as already-a-pointer.
                        ; Stage-0's emitChoose has the analogous branch at
                        ; Emitter.cpp:4678 (UnionValue->getType()->isPointerTy()).
                        choose cond_op.expr
                            when call: Call
                                if call.can_throw
                                {
                                    set cond_is_pointer: true
                                    set is_throws_call: true
                                    set throws_call_return_type: cond_op.result_type
                                    ; s194: throws_is_ptr (the s157 NPO-for-ptr
                                    ; branch) is RETIRED — every throws call now
                                    ; returns the Result wrapper sret, so ptr/ref
                                    ; returns read the tag + value from the wrapper
                                    ; like struct returns (no null-sentinel path).
                                    ; CRUCIAL: clear is_npo. A throws call returning
                                    ; `ref[T]?`/`pointer[T]?` (= Option[ref/ptr])
                                    ; otherwise trips the NPO detection above, and
                                    ; the NPO path would null-check the sret WRAPPER
                                    ; pointer (never null → tag always 0 → always
                                    ; Success → parse_*_list# loops forever adding
                                    ; garbage). The wrapper's status byte is the
                                    ; authority now, not a null sentinel.
                                    set is_npo: false
                                }
                            else
                                0
                    }
                }
            }
            ; s160: a by-pointer struct/union parameter used directly as the
            ; choose subject (`choose syntax` where syntax: DeclarationSyntax,
            ; as in handle_declaration#/handle_export#) arrives as the
            ; function-argument pointer, but the planner's result_type names
            ; the value type so cond_is_pointer stays false. The alloca+store
            ; below would then copy 8 pointer bytes into a struct-typed slot
            ; and read the union tag from the low byte of the address — every
            ; Function declaration dispatched to handle_declaration#'s else
            ; arm, yielding a Package (tag 0) Member, so plan_module# never
            ; planned a function. Structs/unions are always passed by-pointer
            ; in this ABI, so if union_value IS one of the current function's
            ; parameters it already points at the union — use it directly.
            ; Deterministic handle comparison; the LLVMTypeOf(value) form is
            ; unreliable here (reads uninitialized stack, see note above).
            if cond_is_pointer = false
            {
                if current_function.handle <> null
                {
                    let nparams LLVMCountParams(current_function)
                    var pi: int 0
                    while pi < nparams
                    {
                        let p LLVMGetParam(current_function, pi)
                        if p.handle = union_value.handle
                            set cond_is_pointer: true
                        set pi: pi + 1
                    }
                }
            }
            ; s175: a let-bound struct/union local used as the choose subject
            ; (`choose planned_impl` where planned_impl came from an sret-
            ; returning call) arrives as the sret-slot POINTER — emit_variable
            ; returns the stored handle as-is for immutable bindings — but
            ; result_type names the value type, it's no throws call, and it's
            ; not a function param, so none of the detections above fire. The
            ; alloca+store below then stored the 8 pointer bytes into the
            ; union slot and the tag read got the low byte of a STACK ADDRESS:
            ; nonzero → silently fell to choose.else (plan_function's
            ; needs_local_page stayed false); zero (1 in 16 stack depths,
            ; ASLR-flaky) → choose.when loaded a garbage PlannedAction whose
            ; source deref SIGSEGV'd — THE flaky prelude-planning crash.
            ; Mirror stage-0's UnionValue->getType()->isPointerTy() check
            ; (Emitter.cpp:4678), but ONLY for allocas: a ptr-returning
            ; throws call's Error arm binds the returned pointer — which is
            ; NULL on that path (s157: no error payload exists) — so a
            ; direct GEP through a non-alloca pointer would null-deref
            ; (regressed parse_name's inner `choose err` when this check
            ; was unrestricted). An alloca is never null, so the direct-GEP
            ; rewrite is safe exactly there. Bind LLVMTypeOf's result with
            ; `let` before passing it on — the NESTED call form is what
            ; stage-0 mis-lowers (see the s143 note above); the let-bound
            ; form is the same shape emit_variable's s124/s87 checks use.
            if cond_is_pointer = false
            {
                let uv_ty LLVMTypeOf(union_value)
                if uv_ty.handle <> null
                {
                    if LLVMGetTypeKind(uv_ty) = LLVMTypeKind.Pointer()
                    {
                        let uv_alloca LLVMIsAAllocaInst(union_value)
                        if uv_alloca.handle <> null
                            set cond_is_pointer: true
                    }
                }
            }
            if is_npo = false
            {
                if cond_is_pointer = false
                {
                    set union_ptr: acquire_temp(union_type, "choose.union")
                    copy_struct_value(union_ptr, union_value, union_type)
                }
            }
            ; s178: keep the scrutinee and the union slot alive across arm
            ; scope exits — a dying when-payload binding GEPs into them
            ; (making them release candidates) while later arms still read
            ; both. Pins expire with the enclosing statement window.
            pin_temp_value union_value
            pin_temp_value union_ptr

            ; Load the tag. For tagged unions, GEP into the union for the
            ; first field (i8). For NPO Option, derive the tag from a null
            ; check: tag=1 when null (None has variant_index=1), tag=0
            ; when non-null (Some has variant_index=0).
            let i8_ty LLVMInt8TypeInContext(context)
            var tag LLVMValueRef(null)
            ; s157: derive the tag from a null-check both for NPO Options and
            ; for pointer-returning throws calls (union_value is the bare
            ; returned pointer, null=error). A struct/sret throws call still
            ; loads the tag from offset 0 of the Result wrapper.
            var use_null_tag: bool is_npo
            if throws_is_ptr
                set use_null_tag: true
            if use_null_tag = false
            {
                ; s194: for a throws call the tag is byte 0 of the Result wrapper
                ; and union_ptr IS the wrapper base — load it directly. union_type
                ; here is the inner return-type mapping (a SCALAR like i64 for
                ; `returns int throws E`), so a struct GEP would emit an invalid
                ; `getelementptr i64, ptr, 0, 0` that crashes the object backend.
                if is_throws_call
                    set tag: LLVMBuildLoad2(builder, i8_ty, union_ptr, "tag")
                if is_throws_call = false
                {
                    let tag_ptr LLVMBuildStructGEP2(builder, union_type, union_ptr, 0, "tag.ptr")
                    set tag: LLVMBuildLoad2(builder, i8_ty, tag_ptr, "tag")
                }
            }

            ; s149: pre-compute the throws-call Result-wrapper data pointer
            ; HERE (shallow nesting), to be used by the Success arm below.
            ; Hoisting out of the deep nested guards avoids a stage-0
            ; codegen bug that placed the GEP result and its auto-deref
            ; extractvalue in different basic blocks → dominance error.
            ; s157: skip for throws_is_ptr — there is no Result wrapper, so an
            ; offset-1 GEP would point past the returned pointer value.
            var throws_success_ptr LLVMValueRef(null)
            var compute_throws_ptr: bool is_throws_call
            if throws_is_ptr
                set compute_throws_ptr: false
            if compute_throws_ptr
            {
                let one_val LLVMConstInt(i8_ty, 1, 0)
                var idx_vec Vector[LLVMValueRef](1)
                idx_vec.put(0, one_val)
                set throws_success_ptr: LLVMBuildInBoundsGEP2(builder, i8_ty, union_ptr, idx_vec.data, 1, "throws.data.ptr")
            }
            if use_null_tag
            {
                ; icmp eq ptr null returns i1; zext to i8 to match tagged path.
                let ptr_ty LLVMPointerTypeInContext(context, 0)
                let null_const LLVMConstPointerNull(ptr_ty)
                let is_null LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), union_value, null_const, "is.none")
                set tag: LLVMBuildZExt(builder, is_null, i8_ty, "tag.npo")
            }

            ; Create blocks
            let merge_block create_block("choose.end")
            let default_block create_block("choose.else")

            ; Create switch instruction
            let case_count choose_expr.cases.length as int
            let switch_inst LLVMBuildSwitch(builder, tag, default_block, case_count)

            ; PHI strategy for choose-as-expression: collect every branch
            ; that produced an LLVMValueRef along with the block it ended
            ; in, then assemble a PHI at merge_block. A choose used as a
            ; statement (no Action consequents) yields an empty count and
            ; we return null so the caller emits no return.
            let max_count choose_expr.cases.length + 1
            var phi_values Vector[LLVMValueRef](max_count)
            var phi_blocks Vector[LLVMBasicBlockRef](max_count)
            var phi_count: size_t 0
            ; s124: track every block that branches to merge_block without
            ; contributing a value (void result, type mismatch, statement-
            ; only consequent). Without these, the PHI's incoming count
            ; doesn't match the actual predecessor count and llc's verifier
            ; rejects with "PHINode should have one entry for each
            ; predecessor of its parent basic block". Filled in below; drained
            ; at PHI assembly time with undef of phi_ref_type.
            var undef_blocks Vector[LLVMBasicBlockRef](max_count)
            var undef_count: size_t 0

            ; Track variant_index values already added to the switch. When
            ; the planner can't resolve the union (fresh type var with empty
            ; name), every PlannedWhen.variant_index defaults to 0 — adding
            ; them all to LLVMAddCase produces `duplicate case value` and
            ; rejects the IR at -c (passes -S verification but llc/IRTranslator
            ; aborts). Skip duplicates so the IR remains well-formed; the
            ; first-wins arm runs and the rest become unreachable.
            var seen_tags Vector[size_t](choose_expr.cases.length + 1)
            var seen_count: size_t 0

            ; Reference type for the PHI — locked in by the first non-void
            ; case_value or alt_value. Subsequent incoming values whose type
            ; doesn't match it get filtered out (rather than producing a
            ; type-mismatched PHI that llc rejects with "forward referenced
            ; with type"). Mirrors stage-0 emitChoose's per-arm
            ; `CaseValue->getType() == phiTy` gate.
            var phi_ref_type LLVMTypeRef(null)

            ; First emitted case_block — used to redirect the default block
            ; when the planner couldn't resolve variant indices (all cases
            ; collide on variant_index=0, so most case bodies get dedup'd).
            ; Without this redirect, the default block has no terminator
            ; matching the dropped cases, and `choose parse_X()` over a
            ; throws-returning function emits a switch that loops forever:
            ; my throw fix stores tag=1, switch case 0 doesn't match, default
            ; (empty) brs to merge, parse_declaration_list re-enters forever.
            var first_case_block LLVMBasicBlockRef(null)
            var has_duplicates: bool false

            ; Process each when case
            if choose_expr.cases <> null
            {
                for when_case in choose_expr.cases
                {
                    ; Linear search for a matching seen variant_index.
                    var dup: bool false
                    var si: size_t 0
                    while si < seen_count
                    {
                        let st_ptr seen_tags.get si
                        if st_ptr <> null
                        {
                            if (*st_ptr) = when_case.variant_index
                                set dup: true
                        }
                        set si: si + 1
                    }
                    if dup
                    {
                        ; Skip this whole arm — but remember that we saw a
                        ; duplicate. After all cases are processed, the default
                        ; block will branch to the first emitted case_block
                        ; so the dropped cases' tags fall through to a real
                        ; case body instead of staying in an empty default
                        ; (which would re-enter the surrounding loop).
                        set has_duplicates: true
                    }
                    if dup = false
                    {
                        let case_block create_block("choose.when")
                        let tag_const LLVMConstInt(i8_ty, when_case.variant_index, 0)
                        LLVMAddCase(switch_inst, tag_const, case_block)
                        seen_tags.put(seen_count, when_case.variant_index)
                        set seen_count: seen_count + 1
                        if first_case_block.handle = null
                            set first_case_block: case_block

                        LLVMPositionBuilderAtEnd(builder, case_block)
                        ; s128: fresh per-case scope. The variant-name binding
                        ; (define_variable just below) and any `let`/`var` in
                        ; the consequent must not leak into sibling case bodies
                        ; or the code after the choose.
                        enter_scope()

                        ; Extract variant data and bind to variable. For NPO
                        ; Option, the Some payload IS the non-null pointer; bind
                        ; the variable to union_value directly. For tagged unions,
                        ; GEP into the data field and load the variant value.
                        if when_case.name.length > 0
                        {
                            if is_npo
                                define_variable(when_case.name, union_value)
                            if is_npo = false
                            {
                                ; s194: throws-call arm — hoisted ABOVE the n_fields
                                ; gate. union_ptr is the Result-wrapper sret slot
                                ; {i8 status, [N x i8] data}; the value lives at byte
                                ; offset 1 (throws_success_ptr). The Success arm
                                ; (variant_index=0) binds the whole returned T loaded
                                ; from the data field; the Error arm (variant_index<>0)
                                ; binds the throws_type value emit_throw stored there.
                                ; Works for scalar/ref/struct T alike now that the
                                ; wrapper is ALWAYS present (NPO-for-ptr retired). This
                                ; must run independent of union_type's field count —
                                ; a ref/ptr return lowers union_type to a 1-field
                                ; `{ptr}` placeholder (n_fields=1) which the old gate
                                ; bound to null, dropping the value.
                                if is_throws_call
                                {
                                    if when_case.variant_index = 0
                                    {
                                        let rt_ty map_type throws_call_return_type
                                        if LLVMGetTypeKind(rt_ty) = LLVMTypeKind.Void()
                                        {
                                            let ptr_ty_s LLVMPointerTypeInContext(context, 0)
                                            define_variable(when_case.name, LLVMConstNull ptr_ty_s)
                                        }
                                        if LLVMGetTypeKind(rt_ty) <> LLVMTypeKind.Void()
                                        {
                                            ; align 1 — the wrapper's struct alignment is
                                            ; 1, rt_ty's natural alignment may be 8.
                                            let rt_value LLVMBuildLoad2(builder, rt_ty, throws_success_ptr, "throws.success.val")
                                            LLVMSetAlignment(rt_value, 1)
                                            define_variable(when_case.name, rt_value)
                                        }
                                    }
                                    if when_case.variant_index <> 0
                                    {
                                        let var_ty_e map_type when_case.variant_type
                                        if LLVMGetTypeKind(var_ty_e) = LLVMTypeKind.Void()
                                        {
                                            let ptr_ty_e LLVMPointerTypeInContext(context, 0)
                                            define_variable(when_case.name, LLVMConstNull ptr_ty_e)
                                        }
                                        if LLVMGetTypeKind(var_ty_e) <> LLVMTypeKind.Void()
                                        {
                                            let err_value LLVMBuildLoad2(builder, var_ty_e, throws_success_ptr, "throws.err.val")
                                            LLVMSetAlignment(err_value, 1)
                                            define_variable(when_case.name, err_value)
                                        }
                                    }
                                }
                                if is_throws_call = false
                                {
                                    ; s123: if the field-1 GEP. When union_type is
                                    ; a single-field placeholder (`{ ptr }`, from the
                                    ; s114 get_or_create_struct_placeholder fallback)
                                    ; or otherwise lacks a data field, the GEP at index
                                    ; 1 is out-of-bounds and llc rejects with
                                    ; "invalid getelementptr indices" — passes -S
                                    ; verification but blocks AOT/-c. Bind to null
                                    ; instead of GEP'ing — the IR stays valid.
                                    var n_fields: int 0
                                    if LLVMGetTypeKind(union_type) = LLVMTypeKind.Struct()
                                        set n_fields: LLVMCountStructElementTypes(union_type)
                                    if n_fields < 2
                                    {
                                        ; Same as the void-var_ty branch below: bind to a
                                        ; non-null ConstNull(ptr) instead of a null handle
                                        ; so emit_call's null-arg bail doesn't silently
                                        ; drop the case body.
                                        let ptr_ty_n LLVMPointerTypeInContext(context, 0)
                                        let null_ptr_n LLVMConstNull(ptr_ty_n)
                                        define_variable(when_case.name, null_ptr_n)
                                    }
                                    if n_fields >= 2
                                    {
                                        let data_ptr LLVMBuildStructGEP2(builder, union_type, union_ptr, 1, "variant.c_data().ptr")
                                        let var_ty map_type when_case.variant_type
                                        ; s114: bail when variant_type is unresolved (mapped
                                        ; to void). LLVMBuildLoad2 of void calls into
                                        ; DataLayout::getTypeSizeInBits which SIGTRAPs on
                                        ; the VoidTy assertion. Bind the variable to a null
                                        ; placeholder so subsequent code in the arm doesn't
                                        ; crash either.
                                        if LLVMGetTypeKind(var_ty) = LLVMTypeKind.Void()
                                        {
                                            let ptr_ty LLVMPointerTypeInContext(context, 0)
                                            let null_ptr LLVMConstNull(ptr_ty)
                                            define_variable(when_case.name, null_ptr)
                                        }
                                        if LLVMGetTypeKind(var_ty) <> LLVMTypeKind.Void()
                                        {
                                            let var_ptr LLVMBuildBitCast(builder, data_ptr, LLVMPointerTypeInContext(context, 0), "variant.c_data().cast")
                                            let var_value LLVMBuildLoad2(builder, var_ty, var_ptr, "variant.val")
                                            define_variable(when_case.name, var_value)
                                        }
                                    }
                                }
                            }
                        }

                        ; Emit consequent. If it's an Action, capture the
                        ; result value for the eventual PHI. choose ref[T]?
                        ; when x: Some yields a stale binding (session 25/28);
                        ; use if + deref.
                        var case_value LLVMValueRef(null)
                        if when_case.consequent <> null
                        {
                            let r when_case.consequent
                            choose (*r)
                                when action: Action
                                {
                                    set case_value: emit_action(action)
                                    ; s164: an arm whose body is a single sret-
                                    ; returning call yields the sret slot POINTER
                                    ; (an entry-block alloca), not the struct VALUE.
                                    ; The PHI below needs a value that dominates the
                                    ; edge into merge_block AND has the struct type
                                    ; the other arms produce. Load the struct in the
                                    ; current (case) block when the consequent's
                                    ; result_type is a struct but case_value is a
                                    ; pointer. Mirrors stage-0 emitChoose
                                    ; (Emitter.cpp:4829). Without this, plan_operand#'s
                                    ; Constant/Type arms (bare `this.plan_X_operand()`)
                                    ; contributed `undef` to choose.value, so every
                                    ; variable/constant operand planned to garbage.
                                    if case_value.handle <> null
                                    {
                                        let arm_ty map_type action.result_type
                                        if LLVMGetTypeKind(arm_ty) = LLVMTypeKind.Struct()
                                        {
                                            if LLVMGetTypeKind(LLVMTypeOf case_value) = LLVMTypeKind.Pointer()
                                            {
                                                ; The s164 load reads `case_value` (a
                                                ; pointer) in the CURRENT block. emit_action
                                                ; can return a pointer defined in a nested
                                                ; branch of a statement-y arm — e.g. a
                                                ; Success arm whose block ends in
                                                ; `if cond { set local: X^... }`, where X is
                                                ; region-allocated only in the inner
                                                ; then-branch. Loading it in the arm's merge
                                                ; block references a value that does not
                                                ; dominate ("Instruction does not dominate
                                                ; all uses" — scalyls semantic::resolve_at).
                                                ; Only load when the pointer provably
                                                ; dominates: an alloca (entry-hoisted, always
                                                ; dominates) or an instruction in the current
                                                ; block. Otherwise skip the load — the
                                                ; dominance gate below then rejects the still-
                                                ; pointer case_value, so the arm contributes
                                                ; undef (the choose value is unused in this
                                                ; statement position anyway).
                                                var s164_dom: bool true
                                                let s164_inst LLVMIsAInstruction(case_value)
                                                if s164_inst.handle <> null
                                                {
                                                    let s164_alloca LLVMIsAAllocaInst(case_value)
                                                    if s164_alloca.handle = null
                                                    {
                                                        let s164_parent LLVMGetInstructionParent(s164_inst)
                                                        let s164_cur LLVMGetInsertBlock(builder)
                                                        if s164_parent.handle <> s164_cur.handle
                                                            set s164_dom: false
                                                    }
                                                }
                                                if s164_dom
                                                    set case_value: LLVMBuildLoad2(builder, arm_ty, case_value, "choose.arm.load")
                                            }
                                        }
                                    }
                                }
                                else
                                    emit_statement(*r)
                        }

                        let case_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if case_term.handle = null
                        {
                            let case_end_block LLVMGetInsertBlock(builder)
                            var added_phi: bool false
                            if case_value.handle <> null
                            {
                                ; Skip void-typed values (e.g. results of LLVMBuildCall
                                ; on a void-returning procedure) — emitting a PHI of
                                ; void produces invalid IR (`phi void [<badref>, ...]`)
                                ; that passes -S verification but crashes the AOT
                                ; IRTranslator on -c. Mirrors stage-0 emitChoose's
                                ; `!CaseValue->getType()->isVoidTy()` guard.
                                let cv_type LLVMTypeOf(case_value)
                                if cv_type.handle <> null
                                {
                                    if LLVMGetTypeKind(cv_type) <> LLVMTypeKind.Void()
                                    {
                                        ; The case value must dominate the edge into
                                        ; merge_block. emit_action returns the last
                                        ; LLVMValueRef it produced, which for a
                                        ; statement-y arm can be an intermediate
                                        ; defined in a nested block (e.g. a value from
                                        ; an inner `if`'s then-branch). If that block
                                        ; doesn't dominate case_end_block, using it as
                                        ; a PHI incoming yields "Instruction does not
                                        ; dominate all uses". Mirrors stage-0
                                        ; emitChoose (Emitter.cpp:4810): only accept
                                        ; the value when it's a non-instruction
                                        ; (constant/arg always dominate) or its
                                        ; defining block IS case_end_block.
                                        var dominates: bool true
                                        let cv_inst LLVMIsAInstruction(case_value)
                                        if cv_inst.handle <> null
                                        {
                                            let cv_parent LLVMGetInstructionParent(cv_inst)
                                            if cv_parent.handle <> case_end_block.handle
                                                set dominates: false
                                        }
                                        if dominates = true
                                        {
                                            ; Lock the PHI type from the first incoming;
                                            ; only accept later values whose type matches
                                            ; (LLVM type pointers are uniqued, so handle
                                            ; equality is type equality).
                                            if phi_ref_type.handle = null
                                                set phi_ref_type: cv_type
                                            if cv_type.handle = phi_ref_type.handle
                                            {
                                                phi_values.put(phi_count, case_value)
                                                phi_blocks.put(phi_count, case_end_block)
                                                set phi_count: phi_count + 1
                                                set added_phi: true
                                            }
                                        }
                                    }
                                }
                            }
                            if added_phi = false
                            {
                                undef_blocks.put(undef_count, case_end_block)
                                set undef_count: undef_count + 1
                            }
                            LLVMBuildBr(builder, merge_block)
                        }
                        ; s178: the case value feeds the merge PHI that doesn't
                        ; exist yet — protect its slot from the scope-exit
                        ; release.
                        pin_temp_value case_value
                        ; s128: balance the enter_scope above. Place after the
                        ; case_term/LLVMBuildBr branch so the marker pops once
                        ; the case body is fully emitted (and the new alloca
                        ; sites it introduced via `var`/`let` are forgotten).
                        exit_scope()
                    }
                }
            }

            ; Emit alternative (else)
            LLVMPositionBuilderAtEnd(builder, default_block)
            ; s128: default-block scope.
            enter_scope()
            var alt_value LLVMValueRef(null)
            if choose_expr.alternative <> null
            {
                let r choose_expr.alternative
                choose (*r)
                    when action: Action
                    {
                        set alt_value: emit_action(action)
                        ; s164: same sret-pointer→struct load as the per-case
                        ; site above (mirrors stage-0 Emitter.cpp:4829).
                        if alt_value.handle <> null
                        {
                            let alt_ty map_type action.result_type
                            if LLVMGetTypeKind(alt_ty) = LLVMTypeKind.Struct()
                            {
                                if LLVMGetTypeKind(LLVMTypeOf alt_value) = LLVMTypeKind.Pointer()
                                    set alt_value: LLVMBuildLoad2(builder, alt_ty, alt_value, "choose.alt.load")
                            }
                        }
                    }
                    else
                        emit_statement(*r)
            }
            ; When the planner couldn't resolve all variant indices (multiple
            ; cases collided on variant_index=0 → has_duplicates set), and
            ; there's no explicit `else` clause to fill the default block,
            ; redirect default to the first emitted case_block. That way the
            ; dropped cases' tag values fall through to a real case body.
            ; For parse_declaration_list's outer choose, this makes tag=1
            ; (from my throw fix) flow into the Error case body — its nested
            ; choose then has a chance to throw and exit the surrounding
            ; while loop. Without this, the default block was empty and the
            ; loop ran forever on the empty-file or hello.scaly input.
            if has_duplicates
            {
                if choose_expr.alternative = null
                {
                    if first_case_block.handle <> null
                    {
                        let cur_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if cur_term.handle = null
                            LLVMBuildBr(builder, first_case_block)
                    }
                }
            }
            let alt_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if alt_term.handle = null
            {
                let alt_end_block LLVMGetInsertBlock(builder)
                var added_alt_phi: bool false
                if alt_value.handle <> null
                {
                    ; Skip void-typed alternative values — same reason as the
                    ; per-case if above.
                    let av_type LLVMTypeOf(alt_value)
                    if av_type.handle <> null
                    {
                        if LLVMGetTypeKind(av_type) <> LLVMTypeKind.Void()
                        {
                            ; Same dominance gate as the per-case site above.
                            var alt_dominates: bool true
                            let av_inst LLVMIsAInstruction(alt_value)
                            if av_inst.handle <> null
                            {
                                let av_parent LLVMGetInstructionParent(av_inst)
                                if av_parent.handle <> alt_end_block.handle
                                    set alt_dominates: false
                            }
                            if alt_dominates = true
                            {
                                if phi_ref_type.handle = null
                                    set phi_ref_type: av_type
                                if av_type.handle = phi_ref_type.handle
                                {
                                    phi_values.put(phi_count, alt_value)
                                    phi_blocks.put(phi_count, alt_end_block)
                                    set phi_count: phi_count + 1
                                    set added_alt_phi: true
                                }
                            }
                        }
                    }
                }
                if added_alt_phi = false
                {
                    undef_blocks.put(undef_count, alt_end_block)
                    set undef_count: undef_count + 1
                }
                LLVMBuildBr(builder, merge_block)
            }
            ; s178: same PHI protection as the per-case site.
            pin_temp_value alt_value
            ; s128: balance default-block scope.
            exit_scope()

            ; Continue at merge block
            LLVMPositionBuilderAtEnd(builder, merge_block)

            ; Build PHI when at least one branch produced a value. Type
            ; is taken from the first incoming value; mismatched-type
            ; branches would produce invalid IR, but the same constraint
            ; applies to every if-as-expression site already shipping.
            if phi_count > 0
            {
                let first_ptr phi_values.get 0
                if first_ptr <> null
                {
                    ; Bind the deref'd value to a local first — passing a bare
                    ; (*first_ptr) deref-expression straight to an extern call
                    ; (LLVMTypeOf) still miscompiles under stage-0. (This is a
                    ; separate deref-arg quirk, NOT the emit_binding single-ptr-
                    ; struct-param bug, which is fixed.)
                    let first_val (*first_ptr)
                    let phi_ty LLVMTypeOf(first_val)
                    ; s124: append undef entries for every predecessor that
                    ; branched to merge_block without contributing a typed
                    ; value. PHI's incoming count must equal merge_block's
                    ; predecessor count; without this llc rejects with
                    ; "PHINode should have one entry for each predecessor".
                    let undef_val LLVMGetUndef(phi_ty)
                    var ui: size_t 0
                    while ui < undef_count
                    {
                        let ub_ptr undef_blocks.get ui
                        if ub_ptr <> null
                        {
                            phi_values.put(phi_count, undef_val)
                            phi_blocks.put(phi_count, (*ub_ptr))
                            set phi_count: phi_count + 1
                        }
                        set ui: ui + 1
                    }
                    let phi LLVMBuildPhi(builder, phi_ty, "choose.value")
                    LLVMAddIncoming(phi, phi_values.data, phi_blocks.data, phi_count as int)
                    return phi
                }
            }

            LLVMValueRef null
        }

        ; Emit a for loop
        function emit_for(this, for_expr: PlannedFor) returns LLVMValueRef
        {
            ; Milestone 4.4: plain `for` drives the engine. A body the
            ; TaskPlanner proves parallelizable dispatches through the
            ; adaptive driver (deferred fork + per-site HotSpot promotion);
            ; everything else runs sequentially. No syntax involved.
            if promote_for(for_expr)
                return emit_parallel_for for_expr

            ; Check if iterator-based or integer range loop
            if for_expr.is_iterator_loop
                return emit_for_iterator for_expr

            emit_for_integer_range for_expr
        }

        ; Milestone 4.4: should this loop site dispatch through the engine?
        ; Delegates to the TaskPlanner classifier (conservative, transitive
        ; purity, disjoint writes, no early exit, foundation containment).
        function promote_for(this, for_expr: PlannedFor) returns bool
        {
            if current_plan = null
                return false
            let plan_ref current_plan
            let plan (*plan_ref)
            parfor_checker.loop_promotable(plan, parfor_file, for_expr)
        }

        ; Emit integer range for loop: for i in N (iterates 0 to N-1)
        function emit_for_integer_range(this, for_expr: PlannedFor) returns LLVMValueRef
        {
            ; Evaluate the range expression to get the end value
            let end_value emit_operands for_expr.expr
            if end_value.handle = null
                return LLVMValueRef null

            let index_type LLVMTypeOf(end_value)

            ; Create the loop counter (allocate on stack)
            let loop_counter entry_alloca(index_type, "counter")

            ; Initialize loop counter to 0
            let zero LLVMConstInt(index_type, 0, 0)
            LLVMBuildStore(builder, zero, loop_counter)

            ; Create basic blocks
            let cond_block create_block("for.cond")
            let body_block create_block("for.body")
            let incr_block create_block("for.incr")
            let exit_block create_block("for.exit")

            ; Push loop context for break/continue
            push_loop(exit_block, incr_block, for_expr.loop_label, LLVMValueRef(null))

            ; Jump to condition block
            LLVMBuildBr(builder, cond_block)

            ; Emit condition block: i < end
            LLVMPositionBuilderAtEnd(builder, cond_block)
            let current_index LLVMBuildLoad2(builder, index_type, loop_counter, "i")
            let cond LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), current_index, end_value, "for.cmp")
            LLVMBuildCondBr(builder, cond, body_block, exit_block)

            ; Emit body block
            LLVMPositionBuilderAtEnd(builder, body_block)
            ; s128: fresh scope for the for-body so the loop counter binding
            ; AND any `var`/`let` in the body don't leak past the loop.
            enter_scope()

            ; Load current index and bind as loop variable
            let body_index LLVMBuildLoad2(builder, index_type, loop_counter, for_expr.identifier.c_data())
            define_variable(for_expr.identifier, body_index)

            ; Emit body
            emit_action for_expr.body

            ; Jump to increment block if not terminated
            let body_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if body_term.handle = null
                LLVMBuildBr(builder, incr_block)
            ; s128: balance.
            exit_scope()

            ; Emit increment block: i++
            LLVMPositionBuilderAtEnd(builder, incr_block)
            let incr_index LLVMBuildLoad2(builder, index_type, loop_counter, "i.load")
            let one LLVMConstInt(index_type, 1, 0)
            let next_index LLVMBuildAdd(builder, incr_index, one, "i.next")
            LLVMBuildStore(builder, next_index, loop_counter)
            LLVMBuildBr(builder, cond_block)

            ; Pop loop context
            pop_loop()

            ; Continue at exit block
            LLVMPositionBuilderAtEnd(builder, exit_block)

            ; For loops don't produce a value
            LLVMValueRef null
        }

        ; Emit iterator-based for loop
        function emit_for_iterator(this, for_expr: PlannedFor) returns LLVMValueRef
        {
            ; Evaluate collection expression
            let collection emit_operands for_expr.expr
            if collection.handle = null
                return LLVMValueRef null

            ; Get collection pointer (if not already pointer).
            ; Bug fix: was comparing against raw `14` (Metadata kind), so a
            ; ptr-typed collection (kind=12=Pointer) was always wrapped in a
            ; fresh alloca slot, then the function was called with `&slot`
            ; instead of the actual collection ptr — get_iterator received a
            ; pointer to a stack slot containing the ptr, dereffed it to read
            ; Vector{length,data} but got {vec_ptr, garbage} → iterator
            ; uninitialized → next() returns garbage element pointers and
            ; emit_struct_type SEGVs in the for-body.
            var collection_ptr collection
            let coll_type LLVMTypeOf(collection)
            let type_kind LLVMGetTypeKind(coll_type)
            if type_kind <> LLVMTypeKind.Pointer()
            {
                set collection_ptr: entry_alloca(coll_type, "coll.tmp")
                LLVMBuildStore(builder, collection, collection_ptr)
            }

            ; Look up get_iterator function
            let get_iter_fn LLVMGetNamedFunction(llvm_module, for_expr.get_iterator_method.c_data())
            if get_iter_fn.handle = null
                return LLVMValueRef null

            ; Call get_iterator() on collection.
            ; Stage-0 / stage-1's planner emits get_iterator with sret-return for
            ; multi-field iterators (VectorIterator = {ptr, i64}): the function
            ; signature is `void (sret iter, ptr page, ptr coll)` with 3 args.
            ; A by-value 1-arg call site mismatches the function's ABI and at
            ; runtime the callee reads garbage for page/coll, returning an
            ; uninitialized iterator — next() then immediately yields null and
            ; the for-loop body never runs. Build the 3-arg sret call to match.
            let iter_type map_type for_expr.iterator_type
            let iter_alloca entry_alloca(iter_type, "iter.alloca")

            let page_ptr_ty LLVMPointerTypeInContext(context, 0)
            let coll_ptr_ty LLVMPointerTypeInContext(context, 0)
            let iter_sret_ty LLVMPointerTypeInContext(context, 0)

            let rp_val lookup_variable("_rp")
            var page_arg: LLVMValueRef rp_val
            ; s196: non-# caller — reuse this function's single local root page
            ; (released on exit) for the iterator instead of leaking a fresh one
            ; per for-loop. get_iterator is an ordinary Scaly call, so what
            ; travels is the FRAME.
            if page_arg.handle = null
                set page_arg: get_local_frame()
            if page_arg.handle = null
                return LLVMValueRef null

            var get_iter_args Vector[LLVMValueRef](3)
            var get_iter_param_types Vector[LLVMTypeRef](3)
            get_iter_args.put(0, iter_alloca)
            get_iter_args.put(1, page_arg)
            get_iter_args.put(2, collection_ptr)
            get_iter_param_types.put(0, iter_sret_ty)
            get_iter_param_types.put(1, page_ptr_ty)
            get_iter_param_types.put(2, coll_ptr_ty)

            let void_ret_ty LLVMVoidTypeInContext(context)
            let get_iter_func_type LLVMFunctionType(void_ret_ty, get_iter_param_types.data, 3, 0)
            LLVMBuildCall2(builder, get_iter_func_type, get_iter_fn, get_iter_args.data, 3, "")

            ; Look up next function
            let next_fn LLVMGetNamedFunction(llvm_module, for_expr.next_method.c_data())
            if next_fn.handle = null
                return LLVMValueRef null

            ; Create basic blocks
            let cond_block create_block("for.cond")
            let body_block create_block("for.body")
            let exit_block create_block("for.exit")

            ; Push loop context
            push_loop(exit_block, cond_block, for_expr.loop_label, LLVMValueRef(null))

            ; Jump to condition block
            LLVMBuildBr(builder, cond_block)

            ; Condition block: call next(), check if null
            LLVMPositionBuilderAtEnd(builder, cond_block)

            ; Load iterator and call next()
            let iter_ptr_type LLVMPointerTypeInContext(context, 0)
            let element_type map_type for_expr.element_type
            let option_element_type LLVMPointerTypeInContext(context, 0)  ; Option[T] represented as nullable pointer

            ; Build args for next call (iterator pointer)
            var next_args Vector[LLVMValueRef](1)
            var next_param_types Vector[LLVMTypeRef](1)
            next_args.put(0, iter_alloca)
            next_param_types.put(0, iter_ptr_type)

            ; Create function type and call next
            let next_func_type LLVMFunctionType(option_element_type, next_param_types.data, 1, 0)
            let next_result LLVMBuildCall2(builder, next_func_type, next_fn, next_args.data, 1, "next")

            ; Check if result is null (None)
            let null_ptr LLVMConstNull(option_element_type)
            let is_null LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), next_result, null_ptr, "is.done")
            LLVMBuildCondBr(builder, is_null, exit_block, body_block)

            ; Body block
            LLVMPositionBuilderAtEnd(builder, body_block)
            ; s128: fresh scope for the iterator-for body.
            enter_scope()

            ; Bind the loop variable to the next result (unwrapped from Option).
            ; next_result is the element pointer. A record's member access derefs
            ; it; a SCALAR element used as a value must be LOADED here (else the
            ; loop var is the pointer and value uses read garbage — exit 15 when
            ; used as an index).
            var loop_bind next_result
            if for_expr.element_is_scalar
            {
                let scalar_ty scalar_element_value_type(for_expr.element_type)
                set loop_bind: LLVMBuildLoad2(builder, scalar_ty, next_result, for_expr.identifier.c_data())
            }
            define_variable(for_expr.identifier, loop_bind)

            ; Execute loop body
            emit_action for_expr.body

            let body_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if body_term.handle = null
                LLVMBuildBr(builder, cond_block)
            ; s128: balance.
            exit_scope()

            ; Exit block
            LLVMPositionBuilderAtEnd(builder, exit_block)
            pop_loop()

            LLVMValueRef null
        }

        ; ========================================================================
        ; Milestone 3.3: parallel-for outlining emission.
        ; Milestone 4.1: chunked sub-range dispatch.
        ; Milestone 4.2: deferred adaptive driver.
        ; Milestone 4.4: plain `for` drives the engine — promote_for gates
        ; entry on the TaskPlanner classifier, never on syntax.
        ;
        ; The body (proved parallelizable by the classifier — a blocked body
        ; never reaches this function; it runs sequentially)
        ; is outlined into a private `ptr(ptr)` task function that runs a
        ; SUB-RANGE [lo,hi) of iterations. The loop site (4.2) no longer
        ; submits eagerly: iterations run INLINE with backoff-spaced clock
        ; checkpoints, and only once the measured work clears the fork gate
        ; is the REMAINING range chunked into cells {lo, hi, captures...}
        ; (iterator loops: {buf, lo, hi, captures...} over a flat element-
        ; pointer array drained at fork time) — bump-allocated on the task
        ; group's own page (the 3.2 work-item discipline: the submitter
        ; writes, workers only read, TaskGroup.dispose frees the wave
        ; wholesale) and dispatched to this thread's ncpu-sized default pool
        ; (TaskPool.default_pool); TaskGroup.wait then parks the submitter
        ; until the wave finished — which is exactly what makes the captured
        ; frame reads and the disjoint-slot result writes race-free.
        ; Disjointness is range-agnostic (proven for [0,n) ⇒ proven for
        ; every sub-range), so forking a RUNNING loop at an arbitrary
        ; boundary needs no re-proof. Short loops finish inline before the
        ; gate can clear and provably never touch pool or group.
        ;
        ; Captures are the body's free names that resolve in the enclosing
        ; scope. A name bound to an ALLOCA slot travels as the slot CONTENT
        ; and is rebuilt as a same-typed alloca inside the task function, so
        ; emit_variable's alloca/pointer distinctions behave identically on
        ; both sides; a plain SSA value travels by value. The body cannot
        ; write any of them (verification blocks loop-external writes), so
        ; copy semantics are unobservable.
        ;
        ; The task function allocates on the WORKER's thread-local allocator:
        ; get_or_create_local_page inside it opens the task's own region,
        ; released in the epilogue — one region per CHUNK (entry-hoisted by
        ; get_or_create_local_page; per-iteration recycling would rework the
        ; local-page machinery — still open, revisit if churn bodies need it).
        ; ========================================================================

        ; Record a body-bound name (scoped: scanners save/restore the
        ; length of parfor_locals around nested scopes).
        procedure parfor_add_local(this, name: String)
            parfor_locals.add name

        function parfor_is_local(this, name: String) returns bool
        {
            var i: size_t 0
            while i < parfor_locals.length
            {
                let p parfor_locals.get i
                if p <> null
                    if (*p) = name
                        return true
                set i: i + 1
            }
            false
        }

        ; A free name becomes a capture when it is not body-bound, not
        ; already recorded, and actually resolves to a local of the
        ; enclosing function (names that resolve to nothing here are
        ; globals, functions, or namespaces — not frame state).
        procedure parfor_add_capture(this, name: String)
        {
            if parfor_is_local(name)
                return
            var i: size_t 0
            while i < parfor_captures.length
            {
                let p parfor_captures.get i
                if p <> null
                    if (*p) = name
                        return
                set i: i + 1
            }
            let v lookup_variable name
            if v.handle = null
                return
            parfor_captures.add name
        }

        procedure parfor_scan_operands(this, ops: ref[Vector[PlannedOperand]]?)
        {
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    parfor_scan_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        procedure parfor_scan_statement_ref(this, stmt: ref[PlannedStatement]?)
        {
            if stmt <> null
            {
                let s stmt
                parfor_scan_statement((*s))
            }
        }

        procedure parfor_scan_action(this, act: PlannedAction)
        {
            parfor_scan_operands(act.source)
            if act.target <> null
                parfor_scan_operands(act.target)
        }

        procedure parfor_scan_statement(this, stmt: PlannedStatement)
        {
            choose stmt
                when action: Action
                    parfor_scan_action(action)
                when binding: Binding
                {
                    parfor_scan_operands(binding.operation)
                    if binding.binding_item.name <> null
                        parfor_add_local((*binding.binding_item.name))
                }
                when ret: Return
                    parfor_scan_operands(ret.result)
                when throw_stmt: Throw
                    parfor_scan_operands(throw_stmt.result)
                when brk: Break
                    parfor_scan_operands(brk.result)
                when cont: Continue
                    0
        }

        procedure parfor_scan_operand(this, op: PlannedOperand)
        {
            choose op.expr
                when v: Variable
                    parfor_add_capture(v.name)
                when call: Call
                    parfor_scan_operands(call.args)
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                parfor_scan_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    let blk_mark parfor_locals.length
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                parfor_scan_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                    set parfor_locals.length: blk_mark
                }
                when iff: If
                {
                    parfor_scan_operands(iff.condition)
                    let then_mark parfor_locals.length
                    if iff.prop <> null
                        parfor_add_local(iff.prop.name)
                    parfor_scan_statement_ref(iff.consequent)
                    set parfor_locals.length: then_mark
                    let else_mark parfor_locals.length
                    parfor_scan_statement_ref(iff.alternative)
                    set parfor_locals.length: else_mark
                }
                when mt: Match
                {
                    parfor_scan_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            parfor_scan_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                let br_mark parfor_locals.length
                                parfor_scan_statement_ref(br.consequent)
                                set parfor_locals.length: br_mark
                            }
                            set i: i + 1
                        }
                    }
                    let mt_mark parfor_locals.length
                    parfor_scan_statement_ref(mt.alternative)
                    set parfor_locals.length: mt_mark
                }
                when ch: Choose
                {
                    parfor_scan_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                let case_mark parfor_locals.length
                                parfor_add_local(w.name)
                                parfor_scan_statement_ref(w.consequent)
                                set parfor_locals.length: case_mark
                            }
                            set i: i + 1
                        }
                    }
                    let ch_mark parfor_locals.length
                    parfor_scan_statement_ref(ch.alternative)
                    set parfor_locals.length: ch_mark
                }
                when fr: For
                {
                    parfor_scan_operands(fr.expr)
                    let for_mark parfor_locals.length
                    parfor_add_local(fr.identifier)
                    parfor_scan_action(fr.body)
                    set parfor_locals.length: for_mark
                }
                when wh: While
                {
                    parfor_scan_operands(wh.cond.operation)
                    let wh_mark parfor_locals.length
                    if wh.cond.binding_item.name <> null
                        parfor_add_local((*wh.cond.binding_item.name))
                    parfor_scan_action(wh.body)
                    set parfor_locals.length: wh_mark
                }
                when rp: Repeat
                    parfor_scan_action(rp.body)
                when tr: Try
                {
                    parfor_scan_operands(tr.cond.operation)
                    let tr_mark parfor_locals.length
                    if tr.cond.binding_item.name <> null
                        parfor_add_local((*tr.cond.binding_item.name))
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                let catch_mark parfor_locals.length
                                parfor_add_local(w.name)
                                parfor_scan_statement_ref(w.consequent)
                                set parfor_locals.length: catch_mark
                            }
                            set i: i + 1
                        }
                    }
                    parfor_scan_statement_ref(tr.alternative)
                    set parfor_locals.length: tr_mark
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        parfor_scan_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        parfor_scan_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        parfor_scan_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                parfor_scan_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                when bx: Box
                {
                    if bx.value <> null
                    {
                        let r bx.value
                        parfor_scan_operand((*r))
                    }
                }
                else
                    0
        }

        ; Look up or declare a runtime symbol with the given type — the 3.3
        ; dispatch calls (TaskPool/TaskGroup/Page.get/Page.allocate), keyed
        ; by mangled name like every emitter runtime declare.
        function get_parfor_runtime_fn(this, mangled: String, fn_ty: LLVMTypeRef) returns LLVMValueRef
        {
            var f lookup_function_cache(mangled)
            if f.handle = null
                set f: LLVMGetNamedFunction(llvm_module, mangled.c_data())
            if f.handle = null
            {
                set f: LLVMAddFunction(llvm_module, mangled.c_data(), fn_ty)
                LLVMSetLinkage(f, LLVMLinkage.External())
                cache_function(mangled, f)
            }
            f
        }

        ; ------------------------------------------------------------------
        ; Milestone 4.2: static body weight. A relative, saturating estimate
        ; of one iteration's work, used ONLY to place the deferred driver's
        ; first calibration checkpoint: known-tiny bodies skip early clock
        ; reads entirely, bodies containing calls or inner loops check almost
        ; immediately. The fork decision itself runs on MEASURED time —
        ; static weight cannot see runtime trip counts or data-dependent
        ; cost. Model: leaf = 1, construction = 16, intrinsic/operator = 1,
        ; extern/unresolved/indirect/recursive call = 64, direct call with a
        ; body = the callee's memoized weight, inner loop = body x 64;
        ; branches are summed (overshoot only moves the first check earlier).
        ; ------------------------------------------------------------------

        function parfor_wadd(this, a: size_t, b: size_t) returns size_t
        {
            let cap: size_t 1048576
            if a >= cap
                return cap
            if b >= cap
                return cap
            let s a + b
            if s >= cap
                return cap
            s
        }

        function parfor_wmul(this, a: size_t, b: size_t) returns size_t
        {
            let cap: size_t 1048576
            if a = 0
                return 0 as size_t
            if a >= cap
                return cap
            let lim cap / a
            if b >= lim
                return cap
            a * b
        }

        function parfor_weight_is_construction(this, name: String) returns bool
        {
            if name = "init"
                return true
            if name.get_length() = 0
                return false
            let c name.get(0)
            if c >= ("A" as char)
                if c <= ("Z" as char)
                    return true
            false
        }

        ; Weight of a callee body by mangled name, memoized. A name being
        ; weighed further up the walk (recursion) and an unresolved or
        ; extern name all fall back to the flat call cost. Declaration
        ; duplicates: a body entry wins over an extern declare for the same
        ; mangled name (the TaskPlanner's effectively_pure discipline).
        function parfor_weight_fn(this, mangled: String) returns size_t
        {
            var i: size_t 0
            while i < weight_memo_names.length
            {
                let p weight_memo_names.get i
                if p <> null
                {
                    if (*p) = mangled
                    {
                        let v weight_memo_vals.get i
                        if v <> null
                            return (*v)
                        return 64 as size_t
                    }
                }
                set i: i + 1
            }
            var j: size_t 0
            while j < weight_stack.length
            {
                let sp weight_stack.get j
                if sp <> null
                    if (*sp) = mangled
                        return 64 as size_t
                set j: j + 1
            }
            if current_plan = null
                return 64 as size_t
            if current_plan.functions = null
                return 64 as size_t
            for func in current_plan.functions
            {
                if func.mangled_name = mangled
                {
                    choose func.impl
                        when action: Action
                        {
                            weight_stack.add mangled
                            let w parfor_weight_action(action)
                            set weight_stack.length: weight_stack.length - 1
                            weight_memo_names.add mangled
                            weight_memo_vals.add w
                            return w
                        }
                        else
                            0
                }
            }
            weight_memo_names.add mangled
            weight_memo_vals.add(64)
            64 as size_t
        }

        function parfor_weight_operands(this, ops: ref[Vector[PlannedOperand]]?) returns size_t
        {
            if ops = null
                return 0 as size_t
            var w: size_t 0
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                {
                    let ow parfor_weight_operand(op_ptr.unwrap())
                    set w: parfor_wadd(w, ow)
                }
                set i: i + 1
            }
            w
        }

        function parfor_weight_statement_ref(this, stmt: ref[PlannedStatement]?) returns size_t
        {
            if stmt <> null
            {
                let s stmt
                return parfor_weight_statement((*s))
            }
            0 as size_t
        }

        function parfor_weight_action(this, act: PlannedAction) returns size_t
        {
            var w parfor_weight_operands(act.source)
            if act.target <> null
            {
                let tw parfor_weight_operands(act.target)
                set w: parfor_wadd(w, tw)
            }
            parfor_wadd(w, 1)
        }

        function parfor_weight_statement(this, stmt: PlannedStatement) returns size_t
        {
            choose stmt
                when action: Action
                    return parfor_weight_action(action)
                when binding: Binding
                {
                    let w parfor_weight_operands(binding.operation)
                    return parfor_wadd(w, 1)
                }
                when ret: Return
                {
                    let w parfor_weight_operands(ret.result)
                    return parfor_wadd(w, 1)
                }
                when throw_stmt: Throw
                {
                    let w parfor_weight_operands(throw_stmt.result)
                    return parfor_wadd(w, 1)
                }
                when brk: Break
                {
                    let w parfor_weight_operands(brk.result)
                    return parfor_wadd(w, 1)
                }
                when cont: Continue
                    return 1 as size_t
            1 as size_t
        }

        function parfor_weight_call(this, call: PlannedCall) returns size_t
        {
            var w parfor_weight_operands(call.args)
            if call.is_intrinsic
                return parfor_wadd(w, 1)
            if call.is_operator
                return parfor_wadd(w, 1)
            if call.is_indirect
                return parfor_wadd(w, 64)
            if parfor_weight_is_construction(call.name)
                return parfor_wadd(w, 16)
            let fw parfor_weight_fn(call.mangled_name)
            parfor_wadd(w, fw)
        }

        function parfor_weight_operand(this, op: PlannedOperand) returns size_t
        {
            choose op.expr
                when call: Call
                    return parfor_weight_call(call)
                when tp: Tuple
                {
                    var w: size_t 1
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                            {
                                let cw parfor_weight_operands(c_ptr.value)
                                set w: parfor_wadd(w, cw)
                            }
                            set i: i + 1
                        }
                    }
                    return w
                }
                when blk: Block
                {
                    var w: size_t 0
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                            {
                                let sw parfor_weight_statement(s_ptr.unwrap())
                                set w: parfor_wadd(w, sw)
                            }
                            set i: i + 1
                        }
                    }
                    return w
                }
                when iff: If
                {
                    var w parfor_weight_operands(iff.condition)
                    let cw parfor_weight_statement_ref(iff.consequent)
                    set w: parfor_wadd(w, cw)
                    let aw parfor_weight_statement_ref(iff.alternative)
                    set w: parfor_wadd(w, aw)
                    return parfor_wadd(w, 1)
                }
                when mt: Match
                {
                    var w parfor_weight_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            let ccw parfor_weight_operands(cs.condition)
                                            set w: parfor_wadd(w, ccw)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                let bw parfor_weight_statement_ref(br.consequent)
                                set w: parfor_wadd(w, bw)
                            }
                            set i: i + 1
                        }
                    }
                    let mw parfor_weight_statement_ref(mt.alternative)
                    return parfor_wadd(w, mw)
                }
                when ch: Choose
                {
                    var w parfor_weight_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let cse (*w_ptr)
                                let ccw parfor_weight_statement_ref(cse.consequent)
                                set w: parfor_wadd(w, ccw)
                            }
                            set i: i + 1
                        }
                    }
                    let aw parfor_weight_statement_ref(ch.alternative)
                    return parfor_wadd(w, aw)
                }
                when fr: For
                {
                    let ew parfor_weight_operands(fr.expr)
                    let bw parfor_weight_action(fr.body)
                    let lw parfor_wmul(bw, 64)
                    return parfor_wadd(ew, lw)
                }
                when wh: While
                {
                    let cw parfor_weight_operands(wh.cond.operation)
                    let bw parfor_weight_action(wh.body)
                    let per parfor_wadd(cw, bw)
                    return parfor_wmul(per, 64)
                }
                when rp: Repeat
                {
                    let bw parfor_weight_action(rp.body)
                    return parfor_wmul(bw, 64)
                }
                when tr: Try
                {
                    var w parfor_weight_operands(tr.cond.operation)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let cse (*w_ptr)
                                let ccw parfor_weight_statement_ref(cse.consequent)
                                set w: parfor_wadd(w, ccw)
                            }
                            set i: i + 1
                        }
                    }
                    let aw parfor_weight_statement_ref(tr.alternative)
                    return parfor_wadd(w, aw)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        let iw parfor_weight_operand((*r))
                        return parfor_wadd(iw, 1)
                    }
                    return 1 as size_t
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        return parfor_weight_operand((*r))
                    }
                    return 1 as size_t
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        let vw parfor_weight_operand((*r))
                        return parfor_wadd(vw, 1)
                    }
                    return 1 as size_t
                }
                when mx: Matrix
                {
                    var w: size_t 1
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                            {
                                let rw parfor_weight_operands(row_ptr)
                                set w: parfor_wadd(w, rw)
                            }
                            set i: i + 1
                        }
                    }
                    return w
                }
                when bx: Box
                {
                    if bx.value <> null
                    {
                        let r bx.value
                        let bw parfor_weight_operand((*r))
                        return parfor_wadd(bw, 16)
                    }
                    return 16 as size_t
                }
                when lm: Lambda
                    return 64 as size_t
                when cl: Closure
                    return 64 as size_t
                else
                    return 1 as size_t
            1 as size_t
        }

        function emit_parallel_for(this, for_expr: PlannedFor) returns LLVMValueRef
        {
            ; ---- Collect the captures (plan-side scan, no IR). Copy the
            ; result out of the scratch right away: emitting the body below
            ; may meet a NESTED promoted for, which rescans.
            set parfor_locals.length: 0
            set parfor_captures.length: 0
            parfor_add_local(for_expr.identifier)
            parfor_scan_action(for_expr.body)
            var cap_names Array[String]()
            var ci: size_t 0
            while ci < parfor_captures.length
            {
                let nm_ptr parfor_captures.get ci
                if nm_ptr <> null
                {
                    let nm (*nm_ptr)
                    cap_names.add nm
                }
                set ci: ci + 1
            }
            let cap_count cap_names.length

            ; ---- Evaluate the sequence expression in the ENCLOSING
            ; function (range end value / collection), like the sequential
            ; loop does first thing.
            let seq_value emit_operands for_expr.expr
            if seq_value.handle = null
                return LLVMValueRef null

            let ptr_ty LLVMPointerTypeInContext(context, 0)
            let i64_ty LLVMInt64TypeInContext(context)
            let void_ty LLVMVoidTypeInContext(context)

            ; ---- Materialize the captured values (loop-invariant — the
            ; body cannot write them). An alloca-backed name travels as the
            ; slot content; anything else travels as the SSA value itself.
            var cap_values Vector[LLVMValueRef](cap_count + 1)
            var cap_slot_tys Vector[LLVMTypeRef](cap_count + 1)
            var cap_from_slot Vector[size_t](cap_count + 1)
            set ci: 0
            while ci < cap_count
            {
                let nm_ptr cap_names.get ci
                if nm_ptr = null
                    return LLVMValueRef null
                let nm (*nm_ptr)
                let v lookup_variable nm
                if v.handle = null
                    return LLVMValueRef null
                let v_alloca LLVMIsAAllocaInst(v)
                if v_alloca.handle <> null
                {
                    let slot_ty LLVMGetAllocatedType(v)
                    let content LLVMBuildLoad2(builder, slot_ty, v, "parfor.cap")
                    cap_values.put(ci, content)
                    cap_slot_tys.put(ci, slot_ty)
                    cap_from_slot.put(ci, 1)
                }
                if v_alloca.handle = null
                {
                    cap_values.put(ci, v)
                    let v_ty LLVMTypeOf(v)
                    cap_slot_tys.put(ci, v_ty)
                    cap_from_slot.put(ci, 0)
                }
                set ci: ci + 1
            }

            ; ---- The cell struct (4.1 chunked): a cell describes a
            ; SUB-RANGE of iterations, not one iteration. Range loop:
            ; {lo: i64, hi: i64, captures...}; iterator loop: {buf: ptr,
            ; lo: i64, hi: i64, captures...} where buf is the flat
            ; element-pointer array the driver drained onto the group
            ; page. Chunk math runs uniformly in i64; a narrower range
            ; index is rebuilt by trunc inside the task function.
            var index_ty i64_ty
            if for_expr.is_iterator_loop = false
                set index_ty: LLVMTypeOf(seq_value)
            var base_fields: size_t 2
            if for_expr.is_iterator_loop
                set base_fields: 3
            var cell_field_tys Vector[LLVMTypeRef](base_fields + cap_count)
            if for_expr.is_iterator_loop
            {
                cell_field_tys.put(0, ptr_ty)
                cell_field_tys.put(1, i64_ty)
                cell_field_tys.put(2, i64_ty)
            }
            if for_expr.is_iterator_loop = false
            {
                cell_field_tys.put(0, i64_ty)
                cell_field_tys.put(1, i64_ty)
            }
            set ci: 0
            while ci < cap_count
            {
                let st cap_slot_tys.get ci
                if st = null
                    return LLVMValueRef null
                cell_field_tys.put(base_fields + ci, (*st))
                set ci: ci + 1
            }
            let cell_ty LLVMStructTypeInContext(context, cell_field_tys.data, (base_fields + cap_count) as int, 0)

            ; ---- Outline the body into a private task function ptr(ptr).
            ; Private linkage: llvm-link renames on collision, so the
            ; auto-uniquified "parfor" names can never merge across roots.
            var pf_param_tys Vector[LLVMTypeRef](1)
            pf_param_tys.put(0, ptr_ty)
            let pf_fn_ty LLVMFunctionType(ptr_ty, pf_param_tys.data, 1, 0)
            let task_fn LLVMAddFunction(llvm_module, "parfor", pf_fn_ty)
            LLVMSetLinkage(task_fn, LLVMLinkage.Private())

            ; Save the per-function emitter state, then switch to the task
            ; function. The temp-pool window moves so the outlined body can
            ; never recycle an enclosing function's slot (cross-function
            ; alloca reuse); entries created inside are dropped again on
            ; restore. Debug locations stay off inside the task function:
            ; it has no DISubprogram, and clear_debug_location's null scope
            ; makes every set_debug_location a no-op (locations scoped to
            ; the enclosing function would be invalid here).
            let saved_block LLVMGetInsertBlock(builder)
            let saved_function current_function
            let saved_local_page function_local_page
            let saved_local_frame function_local_frame
            let saved_local_page_block function_local_page_block
            let saved_local_page_init function_local_page_init
            let saved_local_frame_parent function_local_frame_parent_store
            let saved_frame_parent current_frame_parent
            let saved_can_throw current_function_can_throw
            ; TCO: the outlined task function is a DIFFERENT function — a `return`
            ; inside the loop body must never branch to the enclosing function's
            ; tail header (a cross-function branch), so the state is parked here
            ; and restored below. The body's own returns are already rejected by
            ; the promotion classifier (early exit blocks promotion), which makes
            ; this a belt to that suspender.
            let saved_tail_block tail_loop_block
            let saved_tail_len tail_loop_phis.length
            let saved_tail_shadow_len tail_loop_shadows.length
            let saved_tail_stage_len tail_loop_stages.length
            let saved_tail_slot_len tail_loop_slot_types.length
            let saved_tail_mangled tail_loop_mangled
            let saved_di_scope current_di_scope
            let saved_pool_start temp_pool_start
            let saved_pool_len temp_pool_slots.length
            let saved_log_start temp_stmt_log_start
            let saved_log_len temp_stmt_log.length
            let saved_pinned_len temp_pinned.length

            set current_function: task_fn
            set function_local_frame: LLVMValueRef(null)
            set function_local_page: LLVMValueRef(null)
            set function_local_page_block: LLVMBasicBlockRef(null)
            set function_local_page_init: LLVMValueRef(null)
            set function_local_frame_parent_store: LLVMValueRef(null)
            set current_frame_parent: LLVMValueRef(null)
            set current_function_can_throw: false
            set tail_loop_block: LLVMBasicBlockRef(null)
            clear_debug_location()
            set temp_pool_start: temp_pool_slots.length
            set temp_stmt_log_start: temp_stmt_log.length

            let pf_entry_name "entry"
            let pf_entry LLVMAppendBasicBlockInContext(context, task_fn, pf_entry_name.c_data())
            LLVMPositionBuilderAtEnd(builder, pf_entry)
            enter_scope()

            ; Rebind the chunk descriptor and every capture from the cell.
            let cell_arg LLVMGetParam(task_fn, 0)
            var chunk_buf: LLVMValueRef LLVMValueRef(null)
            var lo_idx: size_t 0
            if for_expr.is_iterator_loop
            {
                let buf_gep LLVMBuildStructGEP2(builder, cell_ty, cell_arg, 0, "parfor.buf.ptr")
                set chunk_buf: LLVMBuildLoad2(builder, ptr_ty, buf_gep, "parfor.buf")
                set lo_idx: 1
            }
            let lo_gep LLVMBuildStructGEP2(builder, cell_ty, cell_arg, lo_idx as int, "parfor.lo.ptr")
            let chunk_lo LLVMBuildLoad2(builder, i64_ty, lo_gep, "parfor.lo")
            let hi_gep LLVMBuildStructGEP2(builder, cell_ty, cell_arg, (lo_idx + 1) as int, "parfor.hi.ptr")
            let chunk_hi LLVMBuildLoad2(builder, i64_ty, hi_gep, "parfor.hi")
            set ci: 0
            while ci < cap_count
            {
                let nm_ptr cap_names.get ci
                let nm (*nm_ptr)
                let st_ptr cap_slot_tys.get ci
                let slot_ty (*st_ptr)
                let cap_gep LLVMBuildStructGEP2(builder, cell_ty, cell_arg, (base_fields + ci) as int, "parfor.cap.ptr")
                let cap_val LLVMBuildLoad2(builder, slot_ty, cap_gep, nm.c_data())
                let fs_ptr cap_from_slot.get ci
                var rebuild_slot: size_t 0
                if fs_ptr <> null
                    set rebuild_slot: (*fs_ptr)
                if rebuild_slot = 1
                {
                    let cap_slot LLVMBuildAlloca(builder, slot_ty, nm.c_data())
                    LLVMBuildStore(builder, cap_val, cap_slot)
                    define_variable(nm, cap_slot)
                }
                if rebuild_slot = 0
                    define_variable(nm, cap_val)
                set ci: ci + 1
            }

            ; The chunk loop: i in [lo,hi) — the 4.1 rewrite. The loop
            ; variable rebinds per iteration; `continue` targets the
            ; increment block (3.3's one-cell-per-iteration made continue
            ; and return the same block); break/early exits stay
            ; verification blockers, they cannot occur.
            let iv_slot LLVMBuildAlloca(builder, i64_ty, "parfor.iv.slot")
            LLVMBuildStore(builder, chunk_lo, iv_slot)
            let ck_cond create_block("parfor.chunk.cond")
            let ck_body create_block("parfor.chunk.body")
            let ck_inc create_block("parfor.chunk.inc")
            let pf_ret_block create_block("parfor.ret")
            LLVMBuildBr(builder, ck_cond)

            LLVMPositionBuilderAtEnd(builder, ck_cond)
            let iv LLVMBuildLoad2(builder, i64_ty, iv_slot, "parfor.iv")
            let ck_more LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), iv, chunk_hi, "parfor.chunk.more")
            LLVMBuildCondBr(builder, ck_more, ck_body, pf_ret_block)

            ; Per-iteration element binding. Iterator: load the element
            ; pointer from the drained flat array (the collection outlives
            ; the parked wait, so the deref is in-region), plus the scalar
            ; load where the element is an arithmetic scalar. Range: the
            ; index value, rebuilt in its source width.
            LLVMPositionBuilderAtEnd(builder, ck_body)
            var pf_loop_bind iv
            if for_expr.is_iterator_loop
            {
                var ev_idx Vector[LLVMValueRef](1)
                ev_idx.put(0, iv)
                let elem_addr LLVMBuildGEP2(builder, ptr_ty, chunk_buf, ev_idx.data, 1, "parfor.elem.addr")
                let elem_ptr LLVMBuildLoad2(builder, ptr_ty, elem_addr, for_expr.identifier.c_data())
                set pf_loop_bind: elem_ptr
                if for_expr.element_is_scalar
                {
                    let pf_scalar_ty scalar_element_value_type(for_expr.element_type)
                    set pf_loop_bind: LLVMBuildLoad2(builder, pf_scalar_ty, elem_ptr, for_expr.identifier.c_data())
                }
            }
            if for_expr.is_iterator_loop = false
            {
                let iw LLVMGetIntTypeWidth(index_ty)
                if iw < 64
                    set pf_loop_bind: LLVMBuildTrunc(builder, iv, index_ty, for_expr.identifier.c_data())
            }
            define_variable(for_expr.identifier, pf_loop_bind)
            push_loop(pf_ret_block, ck_inc, for_expr.loop_label, LLVMValueRef(null))
            emit_action for_expr.body
            let pf_body_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if pf_body_term.handle = null
                LLVMBuildBr(builder, ck_inc)
            pop_loop()
            exit_scope()

            LLVMPositionBuilderAtEnd(builder, ck_inc)
            let iv_cur LLVMBuildLoad2(builder, i64_ty, iv_slot, "parfor.iv.cur")
            let iv_one LLVMConstInt(i64_ty, 1, 0)
            let iv_next LLVMBuildAdd(builder, iv_cur, iv_one, "parfor.iv.next")
            LLVMBuildStore(builder, iv_next, iv_slot)
            LLVMBuildBr(builder, ck_cond)

            ; Epilogue: release the task's local region (one region per
            ; CHUNK — no-op when the body never allocated), return null.
            LLVMPositionBuilderAtEnd(builder, pf_ret_block)
            emit_release_local_page()
            let pf_null LLVMConstNull(ptr_ty)
            LLVMBuildRet(builder, pf_null)

            ; Terminate any dangling blocks (mirrors emit_function_body's
            ; final sweep).
            var pf_bb LLVMGetFirstBasicBlock(task_fn)
            while pf_bb.handle <> null
            {
                let pf_term LLVMGetBasicBlockTerminator(pf_bb)
                if pf_term.handle = null
                {
                    LLVMPositionBuilderAtEnd(builder, pf_bb)
                    LLVMBuildUnreachable builder
                }
                set pf_bb: LLVMGetNextBasicBlock(pf_bb)
            }

            ; Restore the enclosing function's emitter state.
            set temp_pool_slots.length: saved_pool_len
            set temp_pool_types.length: saved_pool_len
            set temp_pool_free.length: saved_pool_len
            set temp_pool_start: saved_pool_start
            set temp_stmt_log.length: saved_log_len
            set temp_stmt_log_start: saved_log_start
            set temp_pinned.length: saved_pinned_len
            set current_function: saved_function
            set function_local_page: saved_local_page
            set function_local_frame: saved_local_frame
            set function_local_page_block: saved_local_page_block
            set function_local_page_init: saved_local_page_init
            set function_local_frame_parent_store: saved_local_frame_parent
            set current_frame_parent: saved_frame_parent
            set current_function_can_throw: saved_can_throw
            set tail_loop_block: saved_tail_block
            set tail_loop_phis.length: saved_tail_len
            set tail_loop_shadows.length: saved_tail_shadow_len
            set tail_loop_stages.length: saved_tail_stage_len
            set tail_loop_slot_types.length: saved_tail_slot_len
            set tail_loop_mangled: saved_tail_mangled
            set current_di_scope: saved_di_scope
            LLVMPositionBuilderAtEnd(builder, saved_block)
            if config.emit_debug_info
                set_debug_location(for_expr.loc)

            ; ---- The deferred adaptive driver (4.2), back at the loop
            ; site. Iterations run INLINE in the enclosing function (the
            ; body's second emission besides the outlined chunk runner)
            ; with backoff-spaced calibration checkpoints (i == next_check,
            ; doubling): the first hit only records the clock base, later
            ; hits measure elapsed time, and once past the noise floor the
            ; fork gate is evaluated — a range loop projects the REMAINING
            ; time (remaining x measured per-iteration cost), an iterator
            ; loop (remaining unknowable) forks once elapsed alone proves
            ; the loop long. Elapsed only ever over-measures (preemption
            ; inflates it), so timing noise forks EARLIER, never starves a
            ; long loop. The static body weight places the FIRST checkpoint:
            ; known-tiny bodies read no clock for their first ~256 weight
            ; units of work, bodies with calls or inner loops check almost
            ; immediately (static weight cannot see runtime trip counts, so
            ; the fork decision itself runs on measured time). Short and
            ; fast loops run to completion inline and provably never create
            ; the pool or the group; an empty range exits before the first
            ; checkpoint. The fork path chunks the remaining range by the
            ; MEASURED per-iteration cost — heavy bodies get single-
            ; iteration chunks (the 4.1 imbalance-tail fix), tiny bodies
            ; get volume-floored chunks (no per-cell flood) — and always
            ; submits at least one chunk (range: i < n at the checkpoint;
            ; iterator: the in-hand element), so TaskGroup.wait never waits
            ; on an empty group.
            let dp_ty LLVMFunctionType(ptr_ty, null as pointer[LLVMTypeRef], 0, 0)
            let dp_fn get_parfor_runtime_fn("_ZN8TaskPool12default_poolEv", dp_ty)
            let gc_ty LLVMFunctionType(ptr_ty, null as pointer[LLVMTypeRef], 0, 0)
            let gc_fn get_parfor_runtime_fn("_ZN9TaskGroup6createEv", gc_ty)
            var p1_tys Vector[LLVMTypeRef](1)
            p1_tys.put(0, ptr_ty)
            let pget_ty LLVMFunctionType(ptr_ty, p1_tys.data, 1, 0)
            let pget_fn get_parfor_runtime_fn("_Z3getPv", pget_ty)
            let gv_ty LLVMFunctionType(void_ty, p1_tys.data, 1, 0)
            let gw_fn get_parfor_runtime_fn("_ZN9TaskGroup4waitEP9TaskGroup", gv_ty)
            let gd_fn get_parfor_runtime_fn("_ZN9TaskGroup7disposeEP9TaskGroup", gv_ty)
            var alloc_tys Vector[LLVMTypeRef](3)
            alloc_tys.put(0, ptr_ty)
            alloc_tys.put(1, i64_ty)
            alloc_tys.put(2, i64_ty)
            let alloc_ty LLVMFunctionType(ptr_ty, alloc_tys.data, 3, 0)
            let alloc_fn get_parfor_runtime_fn("_ZN4Page8allocateEmm", alloc_ty)
            var sub_tys Vector[LLVMTypeRef](4)
            sub_tys.put(0, ptr_ty)
            sub_tys.put(1, ptr_ty)
            sub_tys.put(2, ptr_ty)
            sub_tys.put(3, ptr_ty)
            let sub_ty LLVMFunctionType(void_ty, sub_tys.data, 4, 0)
            let sub_fn get_parfor_runtime_fn("_ZN8TaskPool6submitEP8TaskPoolPvPvP9TaskGroup", sub_ty)
            let np_ty LLVMFunctionType(i64_ty, null as pointer[LLVMTypeRef], 0, 0)
            let np_fn get_parfor_runtime_fn("_ZN8TaskPool4ncpuEv", np_ty)
            let now_ty LLVMFunctionType(i64_ty, null as pointer[LLVMTypeRef], 0, 0)
            let now_fn get_parfor_runtime_fn("scaly_eio_now_ns", now_ty)

            let cell_size llvm_type_abi_size(cell_ty)
            let cell_size_const LLVMConstInt(i64_ty, cell_size, 0)
            let cell_align_const LLVMConstInt(i64_ty, 8, 0)

            ; Driver constants (one weight unit ~ 1ns as a guess; the 4.2
            ; design note has the derivations): first checkpoint from the
            ; static weight, calibration noise floor 4096ns, range fork
            ; gate 131072ns of projected remaining work, iterator fork gate
            ; 65536ns elapsed, per-chunk volume floor 16384ns (kept <<10
            ; like the measured per-iteration cost), 4x steal oversubmit.
            var body_weight parfor_weight_action(for_expr.body)
            if body_weight = 0
                set body_weight: 1
            var check0: size_t 256 / body_weight
            if check0 = 0
                set check0: 1
            let check0_const LLVMConstInt(i64_ty, check0, 0)
            let c0 LLVMConstInt(i64_ty, 0, 0)
            let c1 LLVMConstInt(i64_ty, 1, 0)
            let c2 LLVMConstInt(i64_ty, 2, 0)
            let c10 LLVMConstInt(i64_ty, 10, 0)
            let c_noise LLVMConstInt(i64_ty, 4096, 0)
            let c_fork LLVMConstInt(i64_ty, 131072, 0)
            let c_iterfork LLVMConstInt(i64_ty, 65536, 0)
            let c_minchunk LLVMConstInt(i64_ty, 16777216, 0)
            let c_oversub LLVMConstInt(i64_ty, 4, 0)
            ; 4.3 HotSpot per-site constants: promotion volume threshold
            ; (~1ms of weight-units accumulated per thread), the volume
            ; saturation cap (2^40 — keeps the accumulator from ever
            ; wrapping), the calibration publish floor (16384ns measured),
            ; the per-execution measurement clamp (2x the cold fork gate —
            ; an inline-completed loop cannot legitimately take much longer,
            ; so one preemption outlier cannot poison the calibration), and
            ; the promoted head-fork gate: the SAME 131072ns profitability
            ; bar as the cold gate (<<10 like the per-iteration cost it
            ; divides) — promotion moves the decision to the loop HEAD
            ; (full-range capture, no warmup, zero clock reads), it does
            ; not lower the bar (measured: forking ~100us of work wins
            ; less than 2x on 10 cores — not worth the energy).
            let c_hotvol LLVMConstInt(i64_ty, 1048576, 0)
            let volcap_v 1048576 * 1048576
            let c_volcap LLVMConstInt(i64_ty, volcap_v, 0)
            let c_calmin LLVMConstInt(i64_ty, 16384, 0)
            let c_caliters LLVMConstInt(i64_ty, 512, 0)
            let c_calelmax LLVMConstInt(i64_ty, 262144, 0)
            let c_forkp LLVMConstInt(i64_ty, 134217728, 0)
            let bw_const LLVMConstInt(i64_ty, body_weight, 0)

            ; ---- 4.3 HotSpot per-site state. Four site-private globals:
            ; a thread-local work-volume accumulator plus thread-local
            ; calibration sums (per-site, per-thread — no synchronization),
            ; and ONE process-shared cell holding the published measured
            ; per-iteration cost (<<10; 0 = cold, >0 = promoted) — written
            ; rarely (at a fork, or when the calibration floor is reached),
            ; read once per execution. Private linkage like the task fn:
            ; llvm-link renames on collision, opt strips the copies orphaned
            ; by linkonce_odr dedup.
            let sv_name "parfor.site.vol"
            let site_vol LLVMAddGlobal(llvm_module, i64_ty, sv_name.c_data())
            LLVMSetInitializer(site_vol, c0)
            LLVMSetLinkage(site_vol, LLVMLinkage.Private())
            LLVMSetThreadLocal(site_vol, 1)
            let sc_name "parfor.site.calns"
            let site_calns LLVMAddGlobal(llvm_module, i64_ty, sc_name.c_data())
            LLVMSetInitializer(site_calns, c0)
            LLVMSetLinkage(site_calns, LLVMLinkage.Private())
            LLVMSetThreadLocal(site_calns, 1)
            let si_name "parfor.site.caliters"
            let site_caliters LLVMAddGlobal(llvm_module, i64_ty, si_name.c_data())
            LLVMSetInitializer(site_caliters, c0)
            LLVMSetLinkage(site_caliters, LLVMLinkage.Private())
            LLVMSetThreadLocal(site_caliters, 1)
            let sp_name "parfor.site.p1k"
            let site_p1k LLVMAddGlobal(llvm_module, i64_ty, sp_name.c_data())
            LLVMSetInitializer(site_p1k, c0)
            LLVMSetLinkage(site_p1k, LLVMLinkage.Private())

            ; Driver state slots; the fork paths hand the shared dispatch
            ; its inputs through slots too (no phis across block seams).
            let iv_drv entry_alloca(i64_ty, "parfor.i")
            let nc_slot entry_alloca(i64_ty, "parfor.nextcheck")
            let t0_slot entry_alloca(i64_ty, "parfor.t0")
            let i0_slot entry_alloca(i64_ty, "parfor.i0")
            let st_slot entry_alloca(i64_ty, "parfor.fork.lo")
            let en_slot entry_alloca(i64_ty, "parfor.fork.n")
            let p1k_slot entry_alloca(i64_ty, "parfor.fork.p1k")
            let buf_slot entry_alloca(ptr_ty, "parfor.fork.buf")
            let grp_slot entry_alloca(ptr_ty, "parfor.fork.grp")
            let gpage_slot entry_alloca(ptr_ty, "parfor.fork.gpage")
            let entryp_slot entry_alloca(i64_ty, "parfor.entryp")
            let tentry_slot entry_alloca(i64_ty, "parfor.tentry")
            let fp1k_slot entry_alloca(i64_ty, "parfor.fp1k")
            ; The cold fork needs TWO CONSECUTIVE windows over the gate
            ; (this slot is the "first one cleared it" arm). A single
            ; window is one sample of whatever the OS scheduler was doing:
            ; the first checkpoint window is ONE iteration wide, so on a
            ; loaded machine one 22us stall inside a 250ns body reads as
            ; 22us PER ITERATION, clears the gate, forks, and — because the
            ; fork publishes its measured cost — promotes the site for the
            ; rest of the process. That is how CI hit `wave2-forked` in
            ; tests/fiber/parallel_hotspot.scaly (2026-08-04) while the
            ; same binary passed on an idle box. The exit-publish path
            ; already averages over >=512 iterations for exactly this
            ; reason; the cold path now needs a second, FRESHLY BASED
            ; window to agree before it commits. Cost: a genuinely heavy
            ; loop forks one checkpoint later (i=4 instead of i=2 — the
            ; windows double, so this is a constant, not a factor). Loss:
            ; a 3- or 4-iteration loop with a >=44us body no longer
            ; cold-forks at all (nothing is left to submit at the second
            ; checkpoint); it still promotes through the exit path after
            ; 512 accumulated iterations.
            let armed_slot entry_alloca(i64_ty, "parfor.armed")
            LLVMBuildStore(builder, c0, iv_drv)
            LLVMBuildStore(builder, check0_const, nc_slot)
            LLVMBuildStore(builder, c0, t0_slot)
            LLVMBuildStore(builder, c0, i0_slot)
            LLVMBuildStore(builder, c0, tentry_slot)
            LLVMBuildStore(builder, c0, armed_slot)
            let buf_null LLVMConstNull(ptr_ty)
            LLVMBuildStore(builder, buf_null, buf_slot)

            let dispatch_block create_block("pfor.dispatch")
            let done_block create_block("pfor.done")
            let xa_block create_block("pfor.exit.acct")
            let xa_n_block create_block("pfor.exit.n")
            let xa_acct_block create_block("pfor.exit.add")
            let xa_meas_block create_block("pfor.exit.meas")
            let xa_pub_block create_block("pfor.exit.pub")

            if for_expr.is_iterator_loop = false
            {
                ; ---- Range inline loop. The count in i64 (a narrower
                ; index sign-extends; the inline body rebuilds the source
                ; width per iteration like the task function does).
                var n64 seq_value
                let nw LLVMGetIntTypeWidth(index_ty)
                if nw < 64
                    set n64: LLVMBuildSExt(builder, seq_value, i64_ty, "parfor.n64")

                let il_cond create_block("pfor.inl.cond")
                let il_chk create_block("pfor.inl.chk")
                let il_body create_block("pfor.inl.body")
                let il_inc create_block("pfor.inl.inc")
                let rc_block create_block("pfor.check")
                let rc_first create_block("pfor.check.first")
                let rc_meas create_block("pfor.check.meas")
                let rc_later create_block("pfor.check.later")
                let rc_decide create_block("pfor.check.decide")
                let rc_notyet create_block("pfor.check.notyet")
                let rc_arm create_block("pfor.check.arm")
                let rc_fork create_block("pfor.fork")
                let rg_prom create_block("pfor.gate.prom")
                let rg_prom_fork create_block("pfor.gate.headfork")
                let rg_prom_seq create_block("pfor.gate.seq")
                let rg_cold create_block("pfor.gate.cold")
                let rg_hot create_block("pfor.gate.hot")

                ; ---- 4.3 entry gate: a promoted site (published per-
                ; iteration cost > 0) decides at the HEAD from persisted
                ; calibration — fork the WHOLE range when the projected
                ; total clears the promoted gate (n >= C, C = gate/cost;
                ; the division dodges the n*cost overflow; C floors at 1
                ; so an empty range can never hand the dispatch a zero
                ; wave), else run plain sequential with the checkpoint
                ; sentinel parked at n (never matched — zero clock reads).
                ; A cold site whose thread-local volume crossed the hot
                ; threshold measures this execution wall-to-wall (entry
                ; clock here, exit clock in the accounting block) so a
                ; short-but-hot loop calibrates without ever reaching an
                ; in-loop checkpoint.
                let eg_p LLVMBuildLoad2(builder, i64_ty, site_p1k, "parfor.sitep")
                LLVMBuildStore(builder, eg_p, entryp_slot)
                let eg_isprom LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), eg_p, c0, "parfor.gate.isprom")
                LLVMBuildCondBr(builder, eg_isprom, rg_prom, rg_cold)

                LLVMPositionBuilderAtEnd(builder, rg_prom)
                let eg_c0 LLVMBuildSDiv(builder, c_forkp, eg_p, "parfor.gate.c0")
                let eg_cpos LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), eg_c0, c0, "parfor.gate.cpos")
                let eg_c LLVMBuildSelect(builder, eg_cpos, eg_c0, c1, "parfor.gate.c")
                let eg_fits LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), n64, eg_c, "parfor.gate.fits")
                LLVMBuildCondBr(builder, eg_fits, rg_prom_fork, rg_prom_seq)

                LLVMPositionBuilderAtEnd(builder, rg_prom_fork)
                let hf_group LLVMBuildCall2(builder, gc_ty, gc_fn, null as pointer[LLVMValueRef], 0, "parfor.group")
                var hf_pget_args Vector[LLVMValueRef](1)
                hf_pget_args.put(0, hf_group)
                let hf_gpage LLVMBuildCall2(builder, pget_ty, pget_fn, hf_pget_args.data, 1, "parfor.gpage")
                LLVMBuildStore(builder, c0, st_slot)
                LLVMBuildStore(builder, n64, en_slot)
                LLVMBuildStore(builder, eg_p, p1k_slot)
                LLVMBuildStore(builder, hf_group, grp_slot)
                LLVMBuildStore(builder, hf_gpage, gpage_slot)
                LLVMBuildBr(builder, dispatch_block)

                LLVMPositionBuilderAtEnd(builder, rg_prom_seq)
                LLVMBuildStore(builder, n64, nc_slot)
                LLVMBuildBr(builder, il_cond)

                LLVMPositionBuilderAtEnd(builder, rg_cold)
                let eg_vol LLVMBuildLoad2(builder, i64_ty, site_vol, "parfor.volv")
                let eg_ishot LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), eg_vol, c_hotvol, "parfor.gate.ishot")
                LLVMBuildCondBr(builder, eg_ishot, rg_hot, il_cond)

                LLVMPositionBuilderAtEnd(builder, rg_hot)
                let eg_t LLVMBuildCall2(builder, now_ty, now_fn, null as pointer[LLVMValueRef], 0, "parfor.tentry")
                LLVMBuildStore(builder, eg_t, tentry_slot)
                LLVMBuildBr(builder, il_cond)

                LLVMPositionBuilderAtEnd(builder, il_cond)
                let il_i LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.i.cur")
                let il_more LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), il_i, n64, "parfor.inl.more")
                LLVMBuildCondBr(builder, il_more, il_chk, xa_block)

                LLVMPositionBuilderAtEnd(builder, il_chk)
                let il_nc LLVMBuildLoad2(builder, i64_ty, nc_slot, "parfor.nc")
                let il_hit LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), il_i, il_nc, "parfor.chk.hit")
                LLVMBuildCondBr(builder, il_hit, rc_block, il_body)

                ; The inline body: the index rebinds per iteration in its
                ; source width; `continue` targets the increment block.
                LLVMPositionBuilderAtEnd(builder, il_body)
                enter_scope()
                let ib_i LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.i.body")
                var il_bind ib_i
                if nw < 64
                    set il_bind: LLVMBuildTrunc(builder, ib_i, index_ty, for_expr.identifier.c_data())
                define_variable(for_expr.identifier, il_bind)
                push_loop(done_block, il_inc, for_expr.loop_label, LLVMValueRef(null))
                emit_action for_expr.body
                let il_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                if il_term.handle = null
                    LLVMBuildBr(builder, il_inc)
                pop_loop()
                exit_scope()

                LLVMPositionBuilderAtEnd(builder, il_inc)
                let il_iinc LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.i.inc")
                let il_next LLVMBuildAdd(builder, il_iinc, c1, "parfor.i.next")
                LLVMBuildStore(builder, il_next, iv_drv)
                LLVMBuildBr(builder, il_cond)

                ; Checkpoint: one clock read; the first hit only records
                ; the base and doubles ahead.
                LLVMPositionBuilderAtEnd(builder, rc_block)
                let rc_t LLVMBuildCall2(builder, now_ty, now_fn, null as pointer[LLVMValueRef], 0, "parfor.t")
                let rc_t0 LLVMBuildLoad2(builder, i64_ty, t0_slot, "parfor.t0v")
                let rc_isfirst LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), rc_t0, c0, "parfor.chk.isfirst")
                LLVMBuildCondBr(builder, rc_isfirst, rc_first, rc_meas)

                LLVMPositionBuilderAtEnd(builder, rc_first)
                LLVMBuildStore(builder, rc_t, t0_slot)
                LLVMBuildStore(builder, il_i, i0_slot)
                let rcf_nc LLVMBuildMul(builder, il_i, c2, "parfor.nc.dbl")
                LLVMBuildStore(builder, rcf_nc, nc_slot)
                LLVMBuildBr(builder, il_body)

                LLVMPositionBuilderAtEnd(builder, rc_meas)
                let rc_elapsed LLVMBuildSub(builder, rc_t, rc_t0, "parfor.elapsed")
                let rc_calib LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), rc_elapsed, c_noise, "parfor.calib")
                LLVMBuildCondBr(builder, rc_calib, rc_decide, rc_later)

                ; Below the gate (or below the noise floor): disarm — the
                ; two confirming windows must be CONSECUTIVE, otherwise one
                ; stall stays armed forever and the next one forks.
                LLVMPositionBuilderAtEnd(builder, rc_later)
                LLVMBuildStore(builder, c0, armed_slot)
                let rcl_nc LLVMBuildMul(builder, il_i, c2, "parfor.nc.dbl2")
                LLVMBuildStore(builder, rcl_nc, nc_slot)
                LLVMBuildBr(builder, il_body)

                ; Decide: fork iff the projected remaining time clears the
                ; gate. per1k = elapsed<<10 / iterations-since-base (the
                ; <<10 scale keeps sub-ns iterations away from a zero).
                LLVMPositionBuilderAtEnd(builder, rc_decide)
                let rc_i0 LLVMBuildLoad2(builder, i64_ty, i0_slot, "parfor.i0v")
                let rc_iters LLVMBuildSub(builder, il_i, rc_i0, "parfor.iters")
                let rc_e10 LLVMBuildShl(builder, rc_elapsed, c10, "parfor.e10")
                let rc_p1k LLVMBuildSDiv(builder, rc_e10, rc_iters, "parfor.p1k")
                let rc_rem LLVMBuildSub(builder, n64, il_i, "parfor.rem")
                let rc_proj0 LLVMBuildMul(builder, rc_rem, rc_p1k, "parfor.proj0")
                let rc_proj LLVMBuildAShr(builder, rc_proj0, c10, "parfor.proj")
                let rc_dofork LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), rc_proj, c_fork, "parfor.dofork")
                ; Fork only when the PREVIOUS window agreed; otherwise arm
                ; and re-base the measurement, so the confirming window is
                ; an independent sample rather than a longer one containing
                ; the same stall.
                let rc_armv LLVMBuildLoad2(builder, i64_ty, armed_slot, "parfor.armedv")
                let rc_isarmed LLVMBuildICmp(builder, LLVMIntPredicate.NE(), rc_armv, c0, "parfor.chk.isarmed")
                let rc_forknow LLVMBuildAnd(builder, rc_dofork, rc_isarmed, "parfor.forknow")
                LLVMBuildCondBr(builder, rc_forknow, rc_fork, rc_notyet)

                LLVMPositionBuilderAtEnd(builder, rc_notyet)
                LLVMBuildCondBr(builder, rc_dofork, rc_arm, rc_later)

                LLVMPositionBuilderAtEnd(builder, rc_arm)
                LLVMBuildStore(builder, c1, armed_slot)
                LLVMBuildStore(builder, rc_t, t0_slot)
                LLVMBuildStore(builder, il_i, i0_slot)
                let rca_nc LLVMBuildMul(builder, il_i, c2, "parfor.nc.dbl3")
                LLVMBuildStore(builder, rca_nc, nc_slot)
                LLVMBuildBr(builder, il_body)

                ; Fork: the remaining [i, n) leaves through the shared
                ; dispatch. i < n held at the checkpoint, so at least one
                ; iteration is submitted. The measured cost is published to
                ; the site cell first — one fork promotes the site for every
                ; later execution on any thread (4.3).
                LLVMPositionBuilderAtEnd(builder, rc_fork)
                LLVMBuildStore(builder, rc_p1k, site_p1k)
                let rf_group LLVMBuildCall2(builder, gc_ty, gc_fn, null as pointer[LLVMValueRef], 0, "parfor.group")
                var rf_pget_args Vector[LLVMValueRef](1)
                rf_pget_args.put(0, rf_group)
                let rf_gpage LLVMBuildCall2(builder, pget_ty, pget_fn, rf_pget_args.data, 1, "parfor.gpage")
                LLVMBuildStore(builder, il_i, st_slot)
                LLVMBuildStore(builder, n64, en_slot)
                LLVMBuildStore(builder, rc_p1k, p1k_slot)
                LLVMBuildStore(builder, rf_group, grp_slot)
                LLVMBuildStore(builder, rf_gpage, gpage_slot)
                LLVMBuildBr(builder, dispatch_block)
            }
            if for_expr.is_iterator_loop
            {
                ; ---- Iterator inline loop: next() runs in the cond block,
                ; so the per-element measurement includes it. Nothing pool-
                ; or group-touching happens before the fork fires; a short
                ; iterator loop never allocates the drain buffer either
                ; (4.1 always drained up front).
                var collection_ptr seq_value
                let coll_type LLVMTypeOf(seq_value)
                let coll_kind LLVMGetTypeKind(coll_type)
                if coll_kind <> LLVMTypeKind.Pointer()
                {
                    set collection_ptr: entry_alloca(coll_type, "parfor.coll.tmp")
                    LLVMBuildStore(builder, seq_value, collection_ptr)
                }
                let get_iter_fn LLVMGetNamedFunction(llvm_module, for_expr.get_iterator_method.c_data())
                if get_iter_fn.handle = null
                    return LLVMValueRef null
                let iter_type map_type for_expr.iterator_type
                let iter_alloca entry_alloca(iter_type, "parfor.iter")
                let rp_val lookup_variable("_rp")
                var page_arg: LLVMValueRef rp_val
                if page_arg.handle = null
                    set page_arg: get_local_frame()
                if page_arg.handle = null
                    return LLVMValueRef null
                var gi_args Vector[LLVMValueRef](3)
                var gi_tys Vector[LLVMTypeRef](3)
                gi_args.put(0, iter_alloca)
                gi_args.put(1, page_arg)
                gi_args.put(2, collection_ptr)
                gi_tys.put(0, ptr_ty)
                gi_tys.put(1, ptr_ty)
                gi_tys.put(2, ptr_ty)
                let gi_fn_ty LLVMFunctionType(void_ty, gi_tys.data, 3, 0)
                LLVMBuildCall2(builder, gi_fn_ty, get_iter_fn, gi_args.data, 3, "")
                let next_fn LLVMGetNamedFunction(llvm_module, for_expr.next_method.c_data())
                if next_fn.handle = null
                    return LLVMValueRef null
                var next_args Vector[LLVMValueRef](1)
                var next_tys Vector[LLVMTypeRef](1)
                next_args.put(0, iter_alloca)
                next_tys.put(0, ptr_ty)
                let next_fn_ty LLVMFunctionType(ptr_ty, next_tys.data, 1, 0)
                let next_null LLVMConstNull(ptr_ty)

                let it_cond create_block("pfor.it.cond")
                let it_chk create_block("pfor.it.chk")
                let it_body create_block("pfor.it.body")
                let it_inc create_block("pfor.it.inc")
                let ic_block create_block("pfor.check")
                let ic_first create_block("pfor.check.first")
                let ic_meas create_block("pfor.check.meas")
                let ic_later create_block("pfor.check.later")
                let ic_notyet create_block("pfor.check.notyet")
                let ic_arm create_block("pfor.check.arm")
                let ic_fork create_block("pfor.fork")
                let ic_prom create_block("pfor.check.prom")
                let ic_clock create_block("pfor.check.clock")
                let ic_forkm create_block("pfor.check.forkm")
                let ig_prom create_block("pfor.gate.prom")
                let ig_cold create_block("pfor.gate.cold")
                let ig_hot create_block("pfor.gate.hot")

                ; ---- 4.3 entry gate (iterator): a promoted site parks the
                ; checkpoint at the C-th element — reaching it forks with
                ; the persisted cost by pure counter compare, no clock read
                ; on the promoted path; an iterator that ends earlier ran a
                ; plain sequential loop. Cold/hot mirror the range gate.
                let ig_p LLVMBuildLoad2(builder, i64_ty, site_p1k, "parfor.sitep")
                LLVMBuildStore(builder, ig_p, entryp_slot)
                let ig_isprom LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), ig_p, c0, "parfor.gate.isprom")
                LLVMBuildCondBr(builder, ig_isprom, ig_prom, ig_cold)

                LLVMPositionBuilderAtEnd(builder, ig_prom)
                let ig_c LLVMBuildSDiv(builder, c_forkp, ig_p, "parfor.gate.c")
                LLVMBuildStore(builder, ig_c, nc_slot)
                LLVMBuildBr(builder, it_cond)

                LLVMPositionBuilderAtEnd(builder, ig_cold)
                let ig_vol LLVMBuildLoad2(builder, i64_ty, site_vol, "parfor.volv")
                let ig_ishot LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), ig_vol, c_hotvol, "parfor.gate.ishot")
                LLVMBuildCondBr(builder, ig_ishot, ig_hot, it_cond)

                LLVMPositionBuilderAtEnd(builder, ig_hot)
                let ig_t LLVMBuildCall2(builder, now_ty, now_fn, null as pointer[LLVMValueRef], 0, "parfor.tentry")
                LLVMBuildStore(builder, ig_t, tentry_slot)
                LLVMBuildBr(builder, it_cond)

                LLVMPositionBuilderAtEnd(builder, it_cond)
                let it_e LLVMBuildCall2(builder, next_fn_ty, next_fn, next_args.data, 1, "parfor.next")
                let it_done LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), it_e, next_null, "parfor.it.done")
                LLVMBuildCondBr(builder, it_done, xa_block, it_chk)

                LLVMPositionBuilderAtEnd(builder, it_chk)
                let it_i LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.i.cur")
                let it_nc LLVMBuildLoad2(builder, i64_ty, nc_slot, "parfor.nc")
                let it_hit LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), it_i, it_nc, "parfor.chk.hit")
                LLVMBuildCondBr(builder, it_hit, ic_block, it_body)

                ; The inline body: element pointer from next(), plus the
                ; scalar load where the element is an arithmetic scalar.
                LLVMPositionBuilderAtEnd(builder, it_body)
                enter_scope()
                var it_bind it_e
                if for_expr.element_is_scalar
                {
                    let it_sc_ty scalar_element_value_type(for_expr.element_type)
                    set it_bind: LLVMBuildLoad2(builder, it_sc_ty, it_e, for_expr.identifier.c_data())
                }
                define_variable(for_expr.identifier, it_bind)
                push_loop(done_block, it_inc, for_expr.loop_label, LLVMValueRef(null))
                emit_action for_expr.body
                let it_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                if it_term.handle = null
                    LLVMBuildBr(builder, it_inc)
                pop_loop()
                exit_scope()

                LLVMPositionBuilderAtEnd(builder, it_inc)
                let it_iinc LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.i.inc")
                let it_next2 LLVMBuildAdd(builder, it_iinc, c1, "parfor.i.next")
                LLVMBuildStore(builder, it_next2, iv_drv)
                LLVMBuildBr(builder, it_cond)

                ; Checkpoint. The iterator gate is elapsed-only (remaining
                ; is unknowable before draining); the gate constant sits
                ; above the noise floor, so clearing it implies calibrated.
                ; A promoted site (4.3) reaches the checkpoint exactly at
                ; the C-th element and forks with the persisted cost — no
                ; clock is ever read on that path.
                LLVMPositionBuilderAtEnd(builder, ic_block)
                let ic_ep LLVMBuildLoad2(builder, i64_ty, entryp_slot, "parfor.ep")
                let ic_isprom LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), ic_ep, c0, "parfor.chk.isprom")
                LLVMBuildCondBr(builder, ic_isprom, ic_prom, ic_clock)

                LLVMPositionBuilderAtEnd(builder, ic_prom)
                LLVMBuildStore(builder, ic_ep, fp1k_slot)
                LLVMBuildBr(builder, ic_fork)

                LLVMPositionBuilderAtEnd(builder, ic_clock)
                let ic_t LLVMBuildCall2(builder, now_ty, now_fn, null as pointer[LLVMValueRef], 0, "parfor.t")
                let ic_t0 LLVMBuildLoad2(builder, i64_ty, t0_slot, "parfor.t0v")
                let ic_isfirst LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), ic_t0, c0, "parfor.chk.isfirst")
                LLVMBuildCondBr(builder, ic_isfirst, ic_first, ic_meas)

                LLVMPositionBuilderAtEnd(builder, ic_first)
                LLVMBuildStore(builder, ic_t, t0_slot)
                LLVMBuildStore(builder, it_i, i0_slot)
                let icf_nc LLVMBuildMul(builder, it_i, c2, "parfor.nc.dbl")
                LLVMBuildStore(builder, icf_nc, nc_slot)
                LLVMBuildBr(builder, it_body)

                ; Same two-window confirmation as the range path (the slot
                ; comment at parfor.armed has the why): one scheduler stall
                ; inside a cheap body must not fork AND promote the site.
                LLVMPositionBuilderAtEnd(builder, ic_meas)
                let ic_elapsed LLVMBuildSub(builder, ic_t, ic_t0, "parfor.elapsed")
                let ic_dofork LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), ic_elapsed, c_iterfork, "parfor.dofork")
                let ic_armv LLVMBuildLoad2(builder, i64_ty, armed_slot, "parfor.armedv")
                let ic_isarmed LLVMBuildICmp(builder, LLVMIntPredicate.NE(), ic_armv, c0, "parfor.chk.isarmed")
                let ic_forknow LLVMBuildAnd(builder, ic_dofork, ic_isarmed, "parfor.forknow")
                LLVMBuildCondBr(builder, ic_forknow, ic_forkm, ic_notyet)

                LLVMPositionBuilderAtEnd(builder, ic_notyet)
                LLVMBuildCondBr(builder, ic_dofork, ic_arm, ic_later)

                LLVMPositionBuilderAtEnd(builder, ic_arm)
                LLVMBuildStore(builder, c1, armed_slot)
                LLVMBuildStore(builder, ic_t, t0_slot)
                LLVMBuildStore(builder, it_i, i0_slot)
                let ica_nc LLVMBuildMul(builder, it_i, c2, "parfor.nc.dbl3")
                LLVMBuildStore(builder, ica_nc, nc_slot)
                LLVMBuildBr(builder, it_body)

                LLVMPositionBuilderAtEnd(builder, ic_later)
                LLVMBuildStore(builder, c0, armed_slot)
                let icl_nc LLVMBuildMul(builder, it_i, c2, "parfor.nc.dbl2")
                LLVMBuildStore(builder, icl_nc, nc_slot)
                LLVMBuildBr(builder, it_body)

                ; Measured fork: the per-iteration cost from the elapsed
                ; window, handed to the fork through the slot (the promoted
                ; path stores the persisted cost instead).
                LLVMPositionBuilderAtEnd(builder, ic_forkm)
                let if_i0 LLVMBuildLoad2(builder, i64_ty, i0_slot, "parfor.i0v")
                let if_iters LLVMBuildSub(builder, it_i, if_i0, "parfor.iters")
                let if_e10 LLVMBuildShl(builder, ic_elapsed, c10, "parfor.e10")
                let if_p1k LLVMBuildSDiv(builder, if_e10, if_iters, "parfor.p1k")
                LLVMBuildStore(builder, if_p1k, fp1k_slot)
                LLVMBuildBr(builder, ic_fork)

                ; Fork: drain the REST of the iterator — seeded with the
                ; in-hand element, so at least one element is submitted —
                ; into a flat element-pointer array on the group page
                ; (doubling growth; retired buffers stay on the page until
                ; dispose), then leave through the shared dispatch over
                ; [0, m). The element pointers reach into the collection,
                ; which outlives the parked wait. Publishing the cost to
                ; the site cell promotes the site (a promoted re-publish
                ; stores the same value back — harmless).
                LLVMPositionBuilderAtEnd(builder, ic_fork)
                let if_fp LLVMBuildLoad2(builder, i64_ty, fp1k_slot, "parfor.fp1kv")
                LLVMBuildStore(builder, if_fp, site_p1k)
                let if_group LLVMBuildCall2(builder, gc_ty, gc_fn, null as pointer[LLVMValueRef], 0, "parfor.group")
                var if_pget_args Vector[LLVMValueRef](1)
                if_pget_args.put(0, if_group)
                let if_gpage LLVMBuildCall2(builder, pget_ty, pget_fn, if_pget_args.data, 1, "parfor.gpage")

                let dr_cap entry_alloca(i64_ty, "parfor.dr.cap")
                let dr_n entry_alloca(i64_ty, "parfor.dr.n")
                let dr_buf entry_alloca(ptr_ty, "parfor.dr.buf")
                let dr_ci entry_alloca(i64_ty, "parfor.dr.ci")
                let dr_c8 LLVMConstInt(i64_ty, 8, 0)
                let dr_c256 LLVMConstInt(i64_ty, 256, 0)
                let dr_bytes0 LLVMConstInt(i64_ty, 2048, 0)
                LLVMBuildStore(builder, dr_c256, dr_cap)
                var dr_a0 Vector[LLVMValueRef](3)
                dr_a0.put(0, if_gpage)
                dr_a0.put(1, dr_bytes0)
                dr_a0.put(2, dr_c8)
                let dr_buf0 LLVMBuildCall2(builder, alloc_ty, alloc_fn, dr_a0.data, 3, "parfor.dr.buf0")
                LLVMBuildStore(builder, dr_buf0, dr_buf)
                LLVMBuildStore(builder, it_e, dr_buf0)
                LLVMBuildStore(builder, c1, dr_n)

                let dr_cond create_block("pfor.drain.cond")
                let dr_have create_block("pfor.drain.have")
                let dr_grow create_block("pfor.drain.grow")
                let dr_copy_cond create_block("pfor.drain.copy.cond")
                let dr_copy_body create_block("pfor.drain.copy.body")
                let dr_copy_done create_block("pfor.drain.copy.done")
                let dr_put create_block("pfor.drain.put")
                let dr_done create_block("pfor.drain.done")
                LLVMBuildBr(builder, dr_cond)

                LLVMPositionBuilderAtEnd(builder, dr_cond)
                let dr_e LLVMBuildCall2(builder, next_fn_ty, next_fn, next_args.data, 1, "parfor.dr.next")
                let dr_fin LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), dr_e, next_null, "parfor.dr.fin")
                LLVMBuildCondBr(builder, dr_fin, dr_done, dr_have)

                LLVMPositionBuilderAtEnd(builder, dr_have)
                let dh_n LLVMBuildLoad2(builder, i64_ty, dr_n, "parfor.dr.nv")
                let dh_cap LLVMBuildLoad2(builder, i64_ty, dr_cap, "parfor.dr.capv")
                let dh_full LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), dh_n, dh_cap, "parfor.dr.full")
                LLVMBuildCondBr(builder, dh_full, dr_grow, dr_put)

                LLVMPositionBuilderAtEnd(builder, dr_grow)
                let dg_cap2 LLVMBuildMul(builder, dh_cap, c2, "parfor.dr.cap2")
                let dg_bytes LLVMBuildMul(builder, dg_cap2, dr_c8, "parfor.dr.gbytes")
                var dg_args Vector[LLVMValueRef](3)
                dg_args.put(0, if_gpage)
                dg_args.put(1, dg_bytes)
                dg_args.put(2, dr_c8)
                let dg_nbuf LLVMBuildCall2(builder, alloc_ty, alloc_fn, dg_args.data, 3, "parfor.dr.nbuf")
                let dg_obuf LLVMBuildLoad2(builder, ptr_ty, dr_buf, "parfor.dr.obuf")
                LLVMBuildStore(builder, c0, dr_ci)
                LLVMBuildBr(builder, dr_copy_cond)

                LLVMPositionBuilderAtEnd(builder, dr_copy_cond)
                let dc_i LLVMBuildLoad2(builder, i64_ty, dr_ci, "parfor.dr.civ")
                let dc_more LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), dc_i, dh_n, "parfor.dr.cmore")
                LLVMBuildCondBr(builder, dc_more, dr_copy_body, dr_copy_done)

                LLVMPositionBuilderAtEnd(builder, dr_copy_body)
                var dc_sidx Vector[LLVMValueRef](1)
                dc_sidx.put(0, dc_i)
                let dc_src LLVMBuildGEP2(builder, ptr_ty, dg_obuf, dc_sidx.data, 1, "parfor.dr.src")
                let dc_val LLVMBuildLoad2(builder, ptr_ty, dc_src, "parfor.dr.val")
                let dc_dst LLVMBuildGEP2(builder, ptr_ty, dg_nbuf, dc_sidx.data, 1, "parfor.dr.dst")
                LLVMBuildStore(builder, dc_val, dc_dst)
                let dc_i1 LLVMBuildAdd(builder, dc_i, c1, "parfor.dr.ci1")
                LLVMBuildStore(builder, dc_i1, dr_ci)
                LLVMBuildBr(builder, dr_copy_cond)

                LLVMPositionBuilderAtEnd(builder, dr_copy_done)
                LLVMBuildStore(builder, dg_nbuf, dr_buf)
                LLVMBuildStore(builder, dg_cap2, dr_cap)
                LLVMBuildBr(builder, dr_put)

                LLVMPositionBuilderAtEnd(builder, dr_put)
                let du_buf LLVMBuildLoad2(builder, ptr_ty, dr_buf, "parfor.dr.bufv")
                let du_n LLVMBuildLoad2(builder, i64_ty, dr_n, "parfor.dr.n2")
                var du_idx Vector[LLVMValueRef](1)
                du_idx.put(0, du_n)
                let du_slot LLVMBuildGEP2(builder, ptr_ty, du_buf, du_idx.data, 1, "parfor.dr.slot")
                LLVMBuildStore(builder, dr_e, du_slot)
                let du_n1 LLVMBuildAdd(builder, du_n, c1, "parfor.dr.n1")
                LLVMBuildStore(builder, du_n1, dr_n)
                LLVMBuildBr(builder, dr_cond)

                LLVMPositionBuilderAtEnd(builder, dr_done)
                let dd_m LLVMBuildLoad2(builder, i64_ty, dr_n, "parfor.m")
                let dd_buf LLVMBuildLoad2(builder, ptr_ty, dr_buf, "parfor.buf.final")
                LLVMBuildStore(builder, c0, st_slot)
                LLVMBuildStore(builder, dd_m, en_slot)
                LLVMBuildStore(builder, if_fp, p1k_slot)
                LLVMBuildStore(builder, dd_buf, buf_slot)
                LLVMBuildStore(builder, if_group, grp_slot)
                LLVMBuildStore(builder, if_gpage, gpage_slot)
                LLVMBuildBr(builder, dispatch_block)
            }

            ; ---- 4.3 exit accounting: runs on inline completions ONLY (a
            ; forked wave leaves through the dispatch, and its wall time
            ; would include the parked wait). Promoted executions skip it
            ; (their state is final); empty executions carry no signal.
            ; Cold: one thread-local add of iterations x static weight —
            ; no clock. Hot: the exit clock closes the wall-to-wall
            ; measurement; elapsed is clamped (one preemption outlier must
            ; not poison the calibration) and accumulated until the publish
            ; floor, then the measured per-iteration cost (<<10) goes to
            ; the shared site cell — the site is promoted for every thread
            ; from then on, and both the volume and calibration accumulators
            ; go quiet (the promoted path never touches them again).
            LLVMPositionBuilderAtEnd(builder, xa_block)
            let xa_ep LLVMBuildLoad2(builder, i64_ty, entryp_slot, "parfor.x.ep")
            let xa_isprom LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_ep, c0, "parfor.x.isprom")
            LLVMBuildCondBr(builder, xa_isprom, done_block, xa_n_block)

            LLVMPositionBuilderAtEnd(builder, xa_n_block)
            let xa_iters LLVMBuildLoad2(builder, i64_ty, iv_drv, "parfor.x.iters")
            let xa_ran LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_iters, c0, "parfor.x.ran")
            LLVMBuildCondBr(builder, xa_ran, xa_acct_block, done_block)

            LLVMPositionBuilderAtEnd(builder, xa_acct_block)
            let xa_add LLVMBuildMul(builder, xa_iters, bw_const, "parfor.x.add")
            let xa_v0 LLVMBuildLoad2(builder, i64_ty, site_vol, "parfor.x.v0")
            let xa_v1 LLVMBuildAdd(builder, xa_v0, xa_add, "parfor.x.v1")
            let xa_over LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_v1, c_volcap, "parfor.x.over")
            let xa_v2 LLVMBuildSelect(builder, xa_over, c_volcap, xa_v1, "parfor.x.v2")
            LLVMBuildStore(builder, xa_v2, site_vol)
            let xa_t0 LLVMBuildLoad2(builder, i64_ty, tentry_slot, "parfor.x.t0")
            let xa_hot LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_t0, c0, "parfor.x.hot")
            LLVMBuildCondBr(builder, xa_hot, xa_meas_block, done_block)

            LLVMPositionBuilderAtEnd(builder, xa_meas_block)
            let xa_te LLVMBuildCall2(builder, now_ty, now_fn, null as pointer[LLVMValueRef], 0, "parfor.x.te")
            let xa_el0 LLVMBuildSub(builder, xa_te, xa_t0, "parfor.x.el0")
            let xa_big LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_el0, c_calelmax, "parfor.x.big")
            let xa_el LLVMBuildSelect(builder, xa_big, c_calelmax, xa_el0, "parfor.x.el")
            let xa_cn0 LLVMBuildLoad2(builder, i64_ty, site_calns, "parfor.x.cn0")
            let xa_cn1 LLVMBuildAdd(builder, xa_cn0, xa_el, "parfor.x.cn1")
            LLVMBuildStore(builder, xa_cn1, site_calns)
            let xa_ci0 LLVMBuildLoad2(builder, i64_ty, site_caliters, "parfor.x.ci0")
            let xa_ci1 LLVMBuildAdd(builder, xa_ci0, xa_iters, "parfor.x.ci1")
            LLVMBuildStore(builder, xa_ci1, site_caliters)
            ; Publish needs BOTH floors: enough measured time (16384ns) AND
            ; enough accumulated iterations (512) — averaging over many
            ; windows keeps one clamped preemption outlier from inflating
            ; the published cost enough to head-fork a nanosecond loop.
            let xa_ready0 LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), xa_cn1, c_calmin, "parfor.x.ready0")
            let xa_enough LLVMBuildICmp(builder, LLVMIntPredicate.SGE(), xa_ci1, c_caliters, "parfor.x.enough")
            let xa_ready LLVMBuildAnd(builder, xa_ready0, xa_enough, "parfor.x.ready")
            LLVMBuildCondBr(builder, xa_ready, xa_pub_block, done_block)

            LLVMPositionBuilderAtEnd(builder, xa_pub_block)
            let xa_e10 LLVMBuildShl(builder, xa_cn1, c10, "parfor.x.e10")
            let xa_p LLVMBuildSDiv(builder, xa_e10, xa_ci1, "parfor.x.p")
            let xa_ppos LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), xa_p, c0, "parfor.x.ppos")
            let xa_pf LLVMBuildSelect(builder, xa_ppos, xa_p, c1, "parfor.x.pf")
            LLVMBuildStore(builder, xa_pf, site_p1k)
            LLVMBuildBr(builder, done_block)

            ; ---- Shared dispatch: chunk the remaining range by the
            ; MEASURED per-iteration cost and hand it to the pool. The
            ; parked wait is what makes the captured-frame reads and the
            ; disjoint-slot result writes race-free.
            LLVMPositionBuilderAtEnd(builder, dispatch_block)
            let ds_lo0 LLVMBuildLoad2(builder, i64_ty, st_slot, "parfor.d.lo0")
            let ds_n LLVMBuildLoad2(builder, i64_ty, en_slot, "parfor.d.n")
            let ds_p1k0 LLVMBuildLoad2(builder, i64_ty, p1k_slot, "parfor.d.p1k0")
            let ds_grp LLVMBuildLoad2(builder, ptr_ty, grp_slot, "parfor.d.grp")
            let ds_gpage LLVMBuildLoad2(builder, ptr_ty, gpage_slot, "parfor.d.gpage")
            let ds_buf LLVMBuildLoad2(builder, ptr_ty, buf_slot, "parfor.d.buf")
            ; chunk = max(1, MIN_CHUNK<<10 / per1k, remaining / (4*ncpu)).
            let ds_p1kpos LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), ds_p1k0, c0, "parfor.d.p1kpos")
            let ds_p1k LLVMBuildSelect(builder, ds_p1kpos, ds_p1k0, c1, "parfor.d.p1k")
            let ds_minc LLVMBuildSDiv(builder, c_minchunk, ds_p1k, "parfor.d.minc")
            let ds_rem LLVMBuildSub(builder, ds_n, ds_lo0, "parfor.d.rem")
            let ds_ncpu LLVMBuildCall2(builder, np_ty, np_fn, null as pointer[LLVMValueRef], 0, "parfor.ncpu")
            let ds_denom LLVMBuildMul(builder, ds_ncpu, c_oversub, "parfor.d.denom")
            let ds_bal LLVMBuildSDiv(builder, ds_rem, ds_denom, "parfor.d.bal")
            let ds_gt LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), ds_minc, ds_bal, "parfor.d.gt")
            let ds_chunk0 LLVMBuildSelect(builder, ds_gt, ds_minc, ds_bal, "parfor.d.chunk0")
            let ds_cpos LLVMBuildICmp(builder, LLVMIntPredicate.SGT(), ds_chunk0, c0, "parfor.d.cpos")
            let ds_chunk LLVMBuildSelect(builder, ds_cpos, ds_chunk0, c1, "parfor.d.chunk")
            let ds_pool LLVMBuildCall2(builder, dp_ty, dp_fn, null as pointer[LLVMValueRef], 0, "parfor.pool")

            let sb_slot entry_alloca(i64_ty, "parfor.c.slot")
            LLVMBuildStore(builder, ds_lo0, sb_slot)
            let sb_cond create_block("pfor.sub.cond")
            let sb_body create_block("pfor.sub.body")
            let sb_done create_block("pfor.sub.done")
            LLVMBuildBr(builder, sb_cond)

            LLVMPositionBuilderAtEnd(builder, sb_cond)
            let sb_lo LLVMBuildLoad2(builder, i64_ty, sb_slot, "parfor.c.lo")
            let sb_more LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), sb_lo, ds_n, "parfor.sub.more")
            LLVMBuildCondBr(builder, sb_more, sb_body, sb_done)

            LLVMPositionBuilderAtEnd(builder, sb_body)
            let sb_hi0 LLVMBuildAdd(builder, sb_lo, ds_chunk, "parfor.chunk.hi0")
            let sb_hilt LLVMBuildICmp(builder, LLVMIntPredicate.SLT(), sb_hi0, ds_n, "parfor.hilt")
            let sb_hi LLVMBuildSelect(builder, sb_hilt, sb_hi0, ds_n, "parfor.chunk.hi")
            var sb_alloc_args Vector[LLVMValueRef](3)
            sb_alloc_args.put(0, ds_gpage)
            sb_alloc_args.put(1, cell_size_const)
            sb_alloc_args.put(2, cell_align_const)
            let sb_cell LLVMBuildCall2(builder, alloc_ty, alloc_fn, sb_alloc_args.data, 3, "parfor.cell")
            var sb_fi: size_t 0
            if for_expr.is_iterator_loop
            {
                let sb_buf_gep LLVMBuildStructGEP2(builder, cell_ty, sb_cell, 0, "parfor.cell.buf")
                LLVMBuildStore(builder, ds_buf, sb_buf_gep)
                set sb_fi: 1
            }
            let sb_lo_gep LLVMBuildStructGEP2(builder, cell_ty, sb_cell, sb_fi as int, "parfor.cell.lo")
            LLVMBuildStore(builder, sb_lo, sb_lo_gep)
            let sb_hi_gep LLVMBuildStructGEP2(builder, cell_ty, sb_cell, (sb_fi + 1) as int, "parfor.cell.hi")
            LLVMBuildStore(builder, sb_hi, sb_hi_gep)
            set ci: 0
            while ci < cap_count
            {
                let cv_ptr cap_values.get ci
                let sb_cap_gep LLVMBuildStructGEP2(builder, cell_ty, sb_cell, (base_fields + ci) as int, "parfor.cell.cap")
                LLVMBuildStore(builder, (*cv_ptr), sb_cap_gep)
                set ci: ci + 1
            }
            var sb_sub_args Vector[LLVMValueRef](4)
            sb_sub_args.put(0, ds_pool)
            sb_sub_args.put(1, task_fn)
            sb_sub_args.put(2, sb_cell)
            sb_sub_args.put(3, ds_grp)
            LLVMBuildCall2(builder, sub_ty, sub_fn, sb_sub_args.data, 4, "")
            LLVMBuildStore(builder, sb_hi, sb_slot)
            LLVMBuildBr(builder, sb_cond)

            ; The wave barrier: park until every chunk finished, then free
            ; the cells + the drained buffers wholesale with the group.
            LLVMPositionBuilderAtEnd(builder, sb_done)
            var gw_args Vector[LLVMValueRef](1)
            gw_args.put(0, ds_grp)
            LLVMBuildCall2(builder, gv_ty, gw_fn, gw_args.data, 1, "")
            var gd_args Vector[LLVMValueRef](1)
            gd_args.put(0, ds_grp)
            LLVMBuildCall2(builder, gv_ty, gd_fn, gd_args.data, 1, "")
            LLVMBuildBr(builder, done_block)

            LLVMPositionBuilderAtEnd(builder, done_block)

            LLVMValueRef null
        }

        ; Emit a while loop
        function emit_while(this, while_expr: PlannedWhile) returns LLVMValueRef
        {
            ; Create basic blocks
            let cond_block create_block("while.cond")
            let body_block create_block("while.body")
            let exit_block create_block("while.exit")

            ; Push loop context
            push_loop(exit_block, cond_block, while_expr.loop_label, LLVMValueRef(null))

            ; Jump to condition block
            LLVMBuildBr(builder, cond_block)

            ; Emit condition block
            LLVMPositionBuilderAtEnd(builder, cond_block)

            ; Emit the condition binding's operation
            let cond_value emit_operands while_expr.cond.operation
            if cond_value.handle = null
            {
                pop_loop()
                return LLVMValueRef null
            }

            ; Handle "while let" binding. s25/s28: ref[String]? must be
            ; unwrapped via if + explicit deref. `choose ... when Some`
            ; yields a String binding whose data ptr is garbage under NPO.
            if while_expr.cond.binding_item.name <> null
            {
                let name_ref while_expr.cond.binding_item.name
                let name (*name_ref)
                if while_expr.cond.binding_type = "var"
                {
                    let ty LLVMTypeOf(cond_value)
                    let alloca entry_alloca(ty, name.c_data())
                    LLVMBuildStore(builder, cond_value, alloca)
                    define_variable(name, alloca)
                }
                else
                {
                    define_variable(name, cond_value)
                }
            }

            ; Ensure we have a boolean for the branch. Both i1 and i64 have
            ; LLVMTypeKind.Integer (kind=8), so a kind comparison never fires
            ; — emit_if was fixed in session 32 to compare bit-width; emit_while
            ; needs the same fix. Without it, while-conditions of the shape
            ; `i < length as int` (where stage-1 plans the `as int` over the
            ; whole comparison rather than just the rhs) emit `zext i1 to i64`
            ; before the branch and llc rejects with "branch condition must
            ; have 'i1' type".
            var bool_cond cond_value
            let cond_type LLVMTypeOf(cond_value)

            ; s167: `while let x = ptr_call()` (e.g. iterator.next() returning
            ; ref[T]?) yields a pointer cond. The old LLVMConstInt(LLVMTypeOf(
            ; cond_value), 0) emitted a malformed `icmp ne ptr X, i0 0` (the
            ; Scaly-side LLVMTypeOf round-trip mis-reports a pointer value's type
            ; as i0). LLVMBuildIsNotNull derives the null type from the value
            ; INTERNALLY (C++ getNullValue(Val->getType())), giving a correct
            ; `icmp ne ptr X, null` for pointers and `icmp ne iN X, 0` for
            ; integers. The width <> 1 if still skips already-boolean conds.
            if LLVMGetIntTypeWidth(cond_type) <> 1
                set bool_cond: LLVMBuildIsNotNull(builder, cond_value, "while.tobool")

            ; Branch: if true go to body, else exit
            LLVMBuildCondBr(builder, bool_cond, body_block, exit_block)

            ; Emit body block
            LLVMPositionBuilderAtEnd(builder, body_block)
            ; s128: fresh scope for the while-body so `var i 0; ...` inside
            ; doesn't leak into outer code or sibling loop iterations.
            enter_scope()
            emit_action while_expr.body

            ; Jump back to condition if not terminated
            let body_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if body_term.handle = null
                LLVMBuildBr(builder, cond_block)
            ; s128: balance.
            exit_scope()

            ; Pop loop context
            pop_loop()

            ; Continue at exit block
            LLVMPositionBuilderAtEnd(builder, exit_block)

            LLVMValueRef null
        }

        ; Emit a repeat loop — an infinite loop that exits only via `break`.
        ; When the repeat yields a value (`let x repeat { ... break v }`), a
        ; result slot is allocated; emit_break stores into it and the exit
        ; block loads it as the repeat expression's value.
        function emit_repeat(this, repeat_expr: PlannedRepeat) returns LLVMValueRef
        {
            ; Allocate the break-value slot unless the repeat is value-less (void).
            var result_slot LLVMValueRef(null)
            var value_llvm_ty LLVMTypeRef(null)
            if repeat_expr.value_type.name <> "void"
            {
                set value_llvm_ty: map_type(repeat_expr.value_type)
                var slot_name "repeat.result"
                set result_slot: entry_alloca(value_llvm_ty, slot_name.c_data())
            }

            let body_block create_block("repeat.body")
            let exit_block create_block("repeat.exit")

            ; continue re-runs the body; break exits to exit_block.
            push_loop(exit_block, body_block, repeat_expr.loop_label, result_slot)

            LLVMBuildBr(builder, body_block)
            LLVMPositionBuilderAtEnd(builder, body_block)
            enter_scope()
            emit_action repeat_expr.body

            ; Infinite loop: re-run the body unless it already terminated
            ; (every exit path is a break/return/throw).
            let body_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if body_term.handle = null
                LLVMBuildBr(builder, body_block)
            exit_scope()
            pop_loop()

            LLVMPositionBuilderAtEnd(builder, exit_block)

            if result_slot.handle <> null
            {
                var load_name "repeat.value"
                return LLVMBuildLoad2(builder, value_llvm_ty, result_slot, load_name.c_data())
            }
            LLVMValueRef null
        }

        ; Emit a try expression
        function emit_try(this, try_expr: PlannedTry) returns LLVMValueRef
        {
            ; Emit the binding's operation
            let result_value emit_operands try_expr.cond.operation
            if result_value.handle = null
                return LLVMValueRef null

            let i8_ty LLVMInt8TypeInContext(context)

            ; Non-throwing try: nothing can go wrong — bind the value and return it.
            if try_expr.is_throwing_cond = false
            {
                ; s25/s28: unwrap ref[String]? via if + explicit deref.
                if try_expr.cond.binding_item.name <> null
                {
                    let name_ref try_expr.cond.binding_item.name
                    let name (*name_ref)
                    define_variable(name, result_value)
                }
                return result_value
            }

            ; Throwing-call try. The callee returns the Result wrapper
            ; { i8 status, [N x i8] data } via sret and emit_operands hands back
            ; the sret-slot POINTER (the wrapper base). Use byte-offset (i8) GEPs:
            ; the planner types the condition as the SCALAR success type, not the
            ; wrapper struct, so a struct GEP would be invalid (emit_choose s194).
            ;   byte 0 : status (0 = success, non-zero = error)
            ;   byte 1 : the success value (on success), OR the thrown error union
            ;            stored INLINE (on error) whose own variant tag is byte 1
            ;   byte 2 : the inline error union's variant payload
            let result_ptr result_value

            ; Wrapper status tag at byte offset 0.
            let tag LLVMBuildLoad2(builder, i8_ty, result_ptr, "tag")
            LLVMSetAlignment(tag, 1)

            ; Is there any error handling (catches or an else dropper)?
            var has_err: bool false
            if try_expr.catches <> null
            {
                if try_expr.catches.length > 0
                    set has_err: true
            }
            if try_expr.alternative <> null
                set has_err: true

            let ok_block create_block("try.ok")
            let merge_block create_block("try.end")
            var err_block LLVMBasicBlockRef(null)
            if has_err
                set err_block: create_block("try.err")

            let zero LLVMConstInt(i8_ty, 0, 0)
            let is_ok LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), tag, zero, "is.ok")
            var err_target err_block
            if err_block.handle = null
                set err_target: merge_block
            LLVMBuildCondBr(builder, is_ok, ok_block, err_target)

            ; --- Ok block: bind the success value; it leaks into the enclosing
            ; scope (the planner defines it there). The success path is the only
            ; way execution falls through past the merge, so the Ok block
            ; dominates subsequent statements.
            LLVMPositionBuilderAtEnd(builder, ok_block)
            var ok_type LLVMInt64TypeInContext(context)
            if try_expr.cond.binding_item.item_type <> null
            {
                let mapped map_type(try_expr.cond.binding_item.item_type.unwrap())
                if mapped.handle <> null
                    set ok_type: mapped
            }
            let ok_one LLVMConstInt(i8_ty, 1, 0)
            var ok_idx Vector[LLVMValueRef](1)
            ok_idx.put(0, ok_one)
            let ok_data_ptr LLVMBuildInBoundsGEP2(builder, i8_ty, result_ptr, ok_idx.data, 1, "ok.data.ptr")
            let ok_value LLVMBuildLoad2(builder, ok_type, ok_data_ptr, "ok.val")
            LLVMSetAlignment(ok_value, 1)
            if try_expr.cond.binding_item.name <> null
            {
                let name_ref try_expr.cond.binding_item.name
                let name (*name_ref)
                if try_expr.cond.binding_type = "var"
                {
                    let alloca entry_alloca(ok_type, name.c_data())
                    LLVMBuildStore(builder, ok_value, alloca)
                    define_variable(name, alloca)
                }
                else
                    define_variable(name, ok_value)
            }
            let ok_term LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
            if ok_term.handle = null
                LLVMBuildBr(builder, merge_block)

            ; --- Error path. On error the wrapper data field holds the thrown
            ; error union INLINE; the catch arms select on that union's OWN
            ; variant tag (NOT the wrapper status, which is 1 for every error).
            if err_block.handle <> null
            {
                LLVMPositionBuilderAtEnd(builder, err_block)

                ; Inline error union tag at byte offset 1 (the union's own tag is
                ; the first byte of the wrapper data field).
                let et_one LLVMConstInt(i8_ty, 1, 0)
                var et_idx Vector[LLVMValueRef](1)
                et_idx.put(0, et_one)
                let errtag_ptr LLVMBuildInBoundsGEP2(builder, i8_ty, result_ptr, et_idx.data, 1, "err.tag.ptr")
                let err_tag LLVMBuildLoad2(builder, i8_ty, errtag_ptr, "err.tag")
                LLVMSetAlignment(err_tag, 1)

                ; The variant payload sits at byte offset 2 (after the wrapper
                ; status byte and the inline error union's own tag byte).
                let pl_two LLVMConstInt(i8_ty, 2, 0)
                var pl_idx Vector[LLVMValueRef](1)
                pl_idx.put(0, pl_two)
                let payload_ptr LLVMBuildInBoundsGEP2(builder, i8_ty, result_ptr, pl_idx.data, 1, "err.payload.ptr")

                var has_catches: bool false
                if try_expr.catches <> null
                {
                    if try_expr.catches.length > 0
                        set has_catches: true
                }

                ; Catches present: switch on the inner error tag. Default → else
                ; dropper if present, otherwise unreachable (errors assumed
                ; exhaustive; routing unmatched errors to merge would break the Ok
                ; value's domination of statements after the try).
                if has_catches
                {
                    var default_block create_block("try.unmatched")
                    var have_else: bool false
                    if try_expr.alternative <> null
                    {
                        set default_block: create_block("try.else")
                        set have_else: true
                    }
                    let catch_count try_expr.catches.length as int
                    let catch_switch LLVMBuildSwitch(builder, err_tag, default_block, catch_count)

                    for catch_case in try_expr.catches
                    {
                        let catch_block create_block("try.catch")
                        let catch_tag_const LLVMConstInt(i8_ty, catch_case.variant_index, 0)
                        LLVMAddCase(catch_switch, catch_tag_const, catch_block)

                        LLVMPositionBuilderAtEnd(builder, catch_block)

                        ; Bind the variant payload (byte offset 2 of the wrapper)
                        ; if the arm names it. Skip when the variant type is void
                        ; (an unresolved / generic `when e: Error` arm): loading a
                        ; void type is invalid IR.
                        if catch_case.name.length > 0
                        {
                            if catch_case.variant_type.name <> "void"
                            {
                                let err_ty map_type catch_case.variant_type
                                let err_value LLVMBuildLoad2(builder, err_ty, payload_ptr, "err.val")
                                LLVMSetAlignment(err_value, 1)
                                define_variable(catch_case.name, err_value)
                            }
                        }

                        if catch_case.consequent <> null
                        {
                            let stmt_ref catch_case.consequent
                            emit_statement(*stmt_ref)
                        }

                        let cterm LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if cterm.handle = null
                            LLVMBuildBr(builder, merge_block)
                    }

                    LLVMPositionBuilderAtEnd(builder, default_block)
                    if have_else = false
                        LLVMBuildUnreachable builder
                    if have_else
                    {
                        if try_expr.alternative <> null
                        {
                            let stmt_ref try_expr.alternative
                            emit_statement(*stmt_ref)
                        }
                        let dterm LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                        if dterm.handle = null
                            LLVMBuildBr(builder, merge_block)
                    }
                }

                ; No catches, just an else dropper.
                if has_catches = false
                {
                    if try_expr.alternative <> null
                    {
                        let stmt_ref try_expr.alternative
                        emit_statement(*stmt_ref)
                    }
                    let eterm LLVMGetBasicBlockTerminator(LLVMGetInsertBlock builder)
                    if eterm.handle = null
                        LLVMBuildBr(builder, merge_block)
                }
            }

            ; Continue at merge block.
            LLVMPositionBuilderAtEnd(builder, merge_block)
            ok_value
        }

        ; ========================================================================
        ; Type Operation Emission
        ; ========================================================================

        ; Emit sizeof
        function emit_sizeof(this, sizeof_expr: PlannedSizeOf) returns LLVMValueRef
        {
            let i64_type LLVMInt64TypeInContext(context)
            ; Emit sizeof as the LLVM ABI size of the mapped type — a constexpr
            ; (LLVMSizeOf is `ptrtoint (getelementptr (%T, null, 1))`), the same
            ; form the Vector / struct allocations use. This guarantees the
            ; value EQUALS the actual emitted LLVM layout size, so a Vector[T]'s
            ; element stride and any struct's field GEPs stay consistent.
            ; The planner's compute_payload_size estimate diverges from the real
            ; layout for structs that embed unions (e.g. OperandSyntax embeds
            ; ExpressionSyntax: planner 264 vs LLVM 256), which truncated every
            ; Vector[OperandSyntax] element. Fall back to the planner's estimate
            ; only when the type isn't materialised / sized.
            let ty map_type sizeof_expr.sized_type
            if ty.handle = null
                return LLVMConstInt(i64_type, sizeof_expr.size, 0)
            if LLVMTypeIsSized(ty) = 0
                return LLVMConstInt(i64_type, sizeof_expr.size, 0)
            ; A `ptr` for a name that is not pointer-shaped is map_type's
            ; last-resort placeholder, not a layout (see type_is_pointer_shaped#).
            ; LLVMSizeOf would answer 8 for a struct of any size — `sizeof Page`
            ; in a program root came out 8 instead of 40, and a hand-built page
            ; header then put its first object INSIDE the header. The planner's
            ; compute_payload_size# walks the registered Concept's properties and
            ; is the only estimate available for a type this root never lays out.
            if LLVMGetTypeKind(ty) = LLVMTypeKind.Pointer()
                if type_is_pointer_shaped(sizeof_expr.sized_type) = false
                    return LLVMConstInt(i64_type, sizeof_expr.size, 0)
            LLVMSizeOf ty
        }

        ; Emit alignof
        function emit_alignof(this, alignof_expr: PlannedAlignOf) returns LLVMValueRef
        {
            let alignment alignof_expr.alignment
            let i64_type LLVMInt64TypeInContext(context)
            LLVMConstInt(i64_type, alignment, 0)
        }

        ; Emit is expression (type test)
        function emit_is(this, is_expr: PlannedIs) returns LLVMValueRef
        {
            ; Emit the value to test
            if is_expr.value = null
            {
                ; No value to test - return false
                let i1_type LLVMInt1TypeInContext(context)
                return LLVMConstInt(i1_type, 0, 0)
            }

            let union_value emit_operand(is_expr.value.unwrap())

            ; Handle "is null" for optional types. NPO (compare the value
            ; against null) only applies when the Option's payload is
            ; pointer-like; a tag-encoded Option[int] needs a tag compare
            ; against None (tag 1). Mirrors stage-0 Emitter.cpp:5915-5955.
            if is_expr.is_null_check
            {
                let val_op is_expr.value.unwrap()
                var opt_ty val_op.result_type
                var value_is_ptr: bool false
                if opt_ty.name = "pointer" || opt_ty.name = "ref"
                {
                    if opt_ty.generics <> null
                    {
                        let vgens (*opt_ty.generics)
                        if vgens.length > 0
                        {
                            let vip vgens.get 0
                            if vip <> null
                            {
                                set opt_ty: (*vip)
                                set value_is_ptr: true
                            }
                        }
                    }
                }
                var uses_npo: bool true
                if opt_ty.name = "Option"
                {
                    if opt_ty.generics <> null
                    {
                        let ogens (*opt_ty.generics)
                        if ogens.length > 0
                        {
                            let oip ogens.get 0
                            if oip <> null
                            {
                                set uses_npo: false
                                if (*oip).name = "pointer"
                                    set uses_npo: true
                                if (*oip).name = "ref"
                                    set uses_npo: true
                            }
                        }
                    }
                }
                if uses_npo = false
                {
                    ; Tag-encoded Option: load the tag and compare with 1
                    ; (None is the second variant after Some).
                    let i8_type_n LLVMInt8TypeInContext(context)
                    var union_llvm_type_n lookup_struct_cache opt_ty.name
                    if union_llvm_type_n.handle = null
                        set union_llvm_type_n: lookup_struct_cache(opt_ty.mangled_name)
                    if union_llvm_type_n.handle = null
                        set union_llvm_type_n: map_type(opt_ty)
                    if union_llvm_type_n.handle <> null
                    {
                        if LLVMGetTypeKind(union_llvm_type_n) = LLVMTypeKind.Struct()
                        {
                            var union_ptr_n union_value
                            if LLVMGetTypeKind(LLVMTypeOf union_value) <> LLVMTypeKind.Pointer()
                            {
                                set union_ptr_n: entry_alloca(union_llvm_type_n, "is.union")
                                LLVMBuildStore(builder, union_value, union_ptr_n)
                            }
                            let tag_ptr_n LLVMBuildStructGEP2(builder, union_llvm_type_n, union_ptr_n, 0, "is.tag.ptr")
                            let tag_n LLVMBuildLoad2(builder, i8_type_n, tag_ptr_n, "is.tag")
                            let expected_n LLVMConstInt(i8_type_n, 1, 0)
                            return LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), tag_n, expected_n, "is.result")
                        }
                    }
                }
                ; NPO / fallback: compare the pointer value against null.
                let ptr_type LLVMPointerTypeInContext(context, 0)
                var npo_value union_value
                if uses_npo
                {
                    if value_is_ptr
                        set npo_value: LLVMBuildLoad2(builder, ptr_type, union_value, "option.val")
                }
                let null_ptr LLVMConstNull(ptr_type)
                return LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), npo_value, null_ptr, "is.null")
            }

            ; For union variant check: compare tag with expected variant_tag
            ; Union layout: { i8 tag, [maxSize x i8] data }
            let i8_type LLVMInt8TypeInContext(context)
            let i1_type LLVMInt1TypeInContext(context)

            ; Get the union type from cache
            var union_llvm_type lookup_struct_cache is_expr.union_name
            if union_llvm_type.handle = null
            {
                ; Try with mangled name
                set union_llvm_type: lookup_struct_cache(is_expr.test_type.mangled_name)
            }

            ; Store the union value to get a pointer
            var union_ptr union_value
            if LLVMGetTypeKind(LLVMTypeOf union_value) <> LLVMTypeKind.Pointer()
            {
                ; Need to store to alloca
                if union_llvm_type.handle <> null
                {
                    set union_ptr: entry_alloca(union_llvm_type, "is.union")
                    LLVMBuildStore(builder, union_value, union_ptr)
                }
                else
                {
                    ; Fallback: use the value's type
                    let val_type LLVMTypeOf(union_value)
                    set union_ptr: entry_alloca(val_type, "is.union")
                    LLVMBuildStore(builder, union_value, union_ptr)
                    set union_llvm_type: val_type
                }
            }

            ; GEP to tag field (index 0)
            let tag_ptr LLVMBuildStructGEP2(builder, union_llvm_type, union_ptr, 0, "is.tag.ptr")

            ; Load the tag
            let tag LLVMBuildLoad2(builder, i8_type, tag_ptr, "is.tag")

            ; Compare with expected variant tag
            let expected_tag LLVMConstInt(i8_type, is_expr.variant_tag, 0)
            LLVMBuildICmp(builder, LLVMIntPredicate.EQ(), tag, expected_tag, "is.result")
        }

        ; Emit as expression (type cast)
        function emit_as(this, as_expr: PlannedAs) returns LLVMValueRef
        {
            ; Emit the value being cast
            if as_expr.value = null
                return LLVMValueRef null

            let as_inner as_expr.value.unwrap()

            ; String → pointer[const_char] coercion. The planner wraps a String
            ; argument matched to a pointer[const_char]-like parameter in a
            ; PlannedAs (the LLVM-level `ptr` is ambiguous between a by-value
            ; String and a const_char, so the decision is made planner-side where
            ; the substituted param type is known). A String CONSTANT lowers to
            ; the plain NUL-terminated cstr global — byte-identical to the
            ; pre-feature const_char literal, zero runtime cost. The String
            ; VARIABLE case is handled below (struct value → get_buffer).
            if this.target_is_cstr_pointer(as_expr.target_type)
                if as_inner.member_access = null
                    choose as_inner.expr
                        when as_c: Constant
                            choose as_c.value
                                when as_s: String
                                {
                                    ; Empty String constant → the valid empty-cstr
                                    ; global (c_data() is null for the empty String).
                                    if as_s.value.get_length() = 0
                                        return this.get_or_build_empty_cstr()
                                    return LLVMBuildGlobalStringPtr(builder, as_s.value.c_data(), ".str")
                                }
                                else
                                    0
                                else
                                    0

                            let src_value emit_operand(as_inner)
                    if src_value.handle = null
                        return LLVMValueRef null

            let src_type LLVMTypeOf(src_value)
            ; Prefer the by-name primitive lookup (s71 class). map_type's
            ; Vector cache is unstable when its String entries dangle —
            ; for size_t / int / u8 etc. that produces ptr instead of the
            ; correct integer type, and emit_as then emits inttoptr where
            ; zext / trunc was expected.
            var dst_type map_intrinsic_type_by_name as_expr.target_type.name
            if dst_type.handle = null
                set dst_type: map_type(as_expr.target_type)

            if dst_type.handle = null
                return LLVMValueRef null

            ; Check type kinds
            let src_kind LLVMGetTypeKind(src_type)
            let dst_kind LLVMGetTypeKind(dst_type)

            let ptr_kind LLVMTypeKind.Pointer()
            let int_kind LLVMTypeKind.Integer()
            let float_kind LLVMTypeKind.Float()
            let double_kind LLVMTypeKind.Double()

            ; String VARIABLE → pointer[const_char]: the value is a by-value
            ; String struct; hand over its c_data content pointer (get_buffer
            ; skips the varint length prefix). The constant case took the .str
            ; fast path above.
            if src_kind = LLVMTypeKind.Struct()
                if dst_kind = ptr_kind
                    if this.target_is_cstr_pointer(as_expr.target_type)
                        return this.coerce_string_value_to_cstr(src_value)

            ; String local/binding → pointer[const_char]: a `var s String(...)`
            ; local holds a POINTER to the region-allocated String record, so it
            ; arrives here ptr-kind, not struct-kind — without this it fell
            ; through to the ptr→ptr no-op below and the record address (not the
            ; content) reached the C-string position (garbage bytes). get_buffer
            ; takes the record pointer as `this` directly. pointer[void] targets
            ; are EXCLUDED: `this as pointer[void]` inside String methods
            ; (Page.get) must keep the record address.
            if src_kind = ptr_kind
                if this.target_is_char_pointer(as_expr.target_type)
                    if as_inner.result_type.name = "String"
                        return this.coerce_string_value_to_cstr(src_value)

            ; Pointer to pointer: bitcast
            if src_kind = ptr_kind
            {
                if dst_kind = ptr_kind
                    return LLVMBuildBitCast(builder, src_value, dst_type, "as.ptr")

                ; Pointer to integer: ptrtoint
                if dst_kind = int_kind
                    return LLVMBuildPtrToInt(builder, src_value, dst_type, "as.ptrtoint")

            }

            ; Integer cases
            if src_kind = int_kind
            {
                ; Integer to pointer: inttoptr
                if dst_kind = ptr_kind
                    return LLVMBuildIntToPtr(builder, src_value, dst_type, "as.inttoptr")

                ; Integer to integer: may need trunc, zext, or sext
                if dst_kind = int_kind
                {
                    let src_bits LLVMGetIntTypeWidth(src_type)
                    let dst_bits LLVMGetIntTypeWidth(dst_type)

                    if src_bits > dst_bits
                        return LLVMBuildTrunc(builder, src_value, dst_type, "as.trunc")

                    if src_bits < dst_bits
                        return LLVMBuildZExt(builder, src_value, dst_type, "as.zext")

                    ; Same size - no-op
                    return src_value
                }

                ; Integer to float: sitofp
                if dst_kind = float_kind
                    return LLVMBuildSIToFP(builder, src_value, dst_type, "as.sitofp")

                if dst_kind = double_kind
                    return LLVMBuildSIToFP(builder, src_value, dst_type, "as.sitofp")

            }

            ; Float to integer: fptosi
            if src_kind = float_kind
            {
                if dst_kind = int_kind
                    return LLVMBuildFPToSI(builder, src_value, dst_type, "as.fptosi")
                ; Float to double: fpext
                if dst_kind = double_kind
                    return LLVMBuildFPExt(builder, src_value, dst_type, "as.fpext")
                if dst_kind = float_kind
                    return src_value
            }
            if src_kind = double_kind
            {
                if dst_kind = int_kind
                    return LLVMBuildFPToSI(builder, src_value, dst_type, "as.fptosi")
                ; Double to float: fptrunc
                if dst_kind = float_kind
                    return LLVMBuildFPTrunc(builder, src_value, dst_type, "as.fptrunc")
                if dst_kind = double_kind
                    return src_value
            }

            ; No cast rule matched. The old fallback returned the source value
            ; UNCHANGED, silently producing a wrong-typed value that dropped the
            ; surrounding statement (the Bug-B silent-drop class — e.g. casting a
            ; backtick FRAGMENT, an [N x i8] array, to int). Mirror stage-0's
            ; hard error (Emitter.cpp:6211) via the unknown-operator trap pattern.
            scaly_eputs "Emitter: cannot cast this value to "
            let as_tn as_expr.target_type.name.to_c_string()
            scaly_eputs as_tn
            scaly_eputs "\n"
            exit 14
            LLVMValueRef null
        }

        ; Emit variant construction (e.g., Result.Ok value, Option.Some value)
        function emit_variant_construction(this, vc: PlannedVariantConstruction) returns LLVMValueRef
        {
            ; Check for Option with NPO (Null Pointer Optimization)
            ; NPO applies when the union is Option and inner type is pointer/ref
            var is_option false
            if vc.union_type.name.get_length() >= 6
            {
                ; Check if name starts with "Option"
                let name_ptr vc.union_type.name.c_data()
                if (*name_ptr) = 79  ; 'O'
                {
                    if (*(name_ptr + 1)) = 112  ; 'p'
                    {
                        if (*(name_ptr + 2)) = 116  ; 't'
                        {
                            if (*(name_ptr + 3)) = 105  ; 'i'
                            {
                                if (*(name_ptr + 4)) = 111  ; 'o'
                                {
                                    if (*(name_ptr + 5)) = 110  ; 'n'
                                        set is_option: true

                                }
                            }
                        }
                    }
                }
            }

            ; s103: NPO only applies to Option[ref/pointer]. Option[int]
            ; / Option[Struct] use the tagged-union layout (general path
            ; below). Without this gate, `Option.Some(7)` allocates a
            ; bare i32 and the choose receiver's GEP into a fake `{i8,
            ; [N x i8]}` reads garbage as the tag.
            if is_option
            {
                var inner_is_ptr_like: bool false
                if vc.union_type.generics <> null
                {
                    let opt_gens (*vc.union_type.generics)
                    if opt_gens.length > 0
                    {
                        let inner_g_ptr opt_gens.get 0
                        if inner_g_ptr <> null
                        {
                            let inner_g (*inner_g_ptr)
                            if inner_g.name = "ref"
                                set inner_is_ptr_like: true
                            if inner_g.name = "pointer"
                                set inner_is_ptr_like: true
                        }
                    }
                }
                if inner_is_ptr_like = false
                    set is_option: false
            }

            ; For NPO Option types, handle specially
            if is_option
            {
                ; Check if variant is None
                if vc.variant_name = "None"
                {
                    ; None = null pointer
                    let ptr_type LLVMPointerTypeInContext(context, 0)
                    return LLVMConstNull ptr_type
                }

                ; For Some, check if we have a value and the type uses NPO
                if vc.variant_name = "Some"
                {
                    if vc.value <> null
                    {
                        let value emit_operand(vc.value.unwrap())
                        let value_type LLVMTypeOf(value)

                        ; If the inner value is already a pointer, return it directly
                        if LLVMGetTypeKind(value_type) = LLVMTypeKind.Pointer()
                            return value

                        ; Otherwise, allocate and store (still uses NPO representation).
                        ; Bail if value is null (e.g. emit_operand fell through on a
                        ; non-aggregate member-access chain) so we don't pass null
                        ; into LLVMBuildStore — that would alloca on a null type
                        ; and crash inside DataLayout::getABITypeAlign.
                        if value.handle = null
                            return LLVMValueRef null
                        let value_ptr entry_alloca(value_type, "option.some")
                        copy_struct_value(value_ptr, value, value_type)
                        return value_ptr
                    }
                }
            }

            ; General union variant construction
            ; Union layout: { i8 tag, [maxSize x i8] data }

            ; Look up the union type from cache
            var union_type lookup_struct_cache vc.union_type.mangled_name
            if union_type.handle = null
                set union_type: lookup_struct_cache(vc.union_type.name)

            if union_type.handle = null
            {
                ; Can't find union type - return null
                return LLVMValueRef null
            }

            ; Allocate space for the union
            let union_ptr acquire_temp(union_type, "variant.ptr")

            ; Store the tag (field 0)
            let i8_type LLVMInt8TypeInContext(context)
            let tag_ptr LLVMBuildStructGEP2(builder, union_type, union_ptr, 0, "variant.tag.ptr")
            let tag_value LLVMConstInt(i8_type, vc.variant_tag, 0)
            LLVMBuildStore(builder, tag_value, tag_ptr)

            ; Store the value (field 1) if present
            if vc.value <> null
            {
                let op vc.value.unwrap()
                let value emit_operand op
                ; Skip the store if the operand emitted nothing — without
                ; this guard, a null value passed into LLVMBuildStore SEGVs
                ; in CreateAlignedStore reading the value's type. Same class
                ; of bail as the NPO Some branch above.
                if value.handle <> null
                {
                    let data_ptr LLVMBuildStructGEP2(builder, union_type, union_ptr, 1, "variant.data.ptr")
                    ; If the payload type is a struct but emit_operand produced a
                    ; POINTER (the operand is a local bound to an sret-returning
                    ; call, e.g. `let fn build_function(...)` → Member.Function(fn)),
                    ; store the loaded struct VALUE, not the 8-byte pointer.
                    ; Without this the union payload got the sret-slot address and
                    ; every field of the stored struct read back as garbage.
                    ; ref/pointer/primitive payloads (expected type not a struct)
                    ; store as-is.
                    var to_store value
                    let expected_ty map_type op.result_type
                    if expected_ty.handle <> null
                    {
                        if LLVMGetTypeKind(expected_ty) = LLVMTypeKind.Struct()
                        {
                            if LLVMGetTypeKind(LLVMTypeOf value) = LLVMTypeKind.Pointer()
                                set to_store: LLVMBuildLoad2(builder, expected_ty, value, "variant.payload")
                        }
                    }
                    ; s178: memcpy when to_store is a load — also marks the
                    ; store align 1, correct for the byte-offset-1 data field.
                    let vp_ty LLVMTypeOf(to_store)
                    copy_struct_value(data_ptr, to_store, vp_ty)
                }
            }

            ; Load and return the union value
            LLVMBuildLoad2(builder, union_type, union_ptr, "variant.val")
        }

        ; ========================================================================
        ; Statement Emission
        ; ========================================================================

        ; Emit a statement
        ; s178: window wrapper around emit_statement_inner. Each statement
        ; opens its own temp-pool window; pooled slots acquired while
        ; emitting it are released at its end unless captured (see
        ; release_statement_temps). Saving/restoring the window start
        ; keeps nested statements (loop bodies, choose/if arms) from
        ; releasing the enclosing statement's temps, while statements
        ; INSIDE a loop body or arm still recycle each other's slots —
        ; that's where collapse_operand_sequence#'s ~450 spill slots live.
        ; Values cannot leak across windows: emit_statement returns only
        ; bool, so expression values always flow through emit_action /
        ; emit_operand inside one window.
        function emit_statement(this, stmt: PlannedStatement) returns bool
        {
            let saved_start temp_stmt_log_start
            let saved_pinned temp_pinned.length
            set temp_stmt_log_start: temp_stmt_log.length
            let result emit_statement_inner stmt
            release_statement_temps()
            set temp_pinned.length: saved_pinned
            set temp_stmt_log_start: saved_start
            result
        }

        function emit_statement_inner(this, stmt: PlannedStatement) returns bool
        {
            ; -g: set the line location for this statement's instructions.
            if config.emit_debug_info
                set_statement_debug_location stmt
            choose stmt
                when action: Action
                {
                    let result emit_action action
                    return result.handle <> null
                }
                when binding: Binding
                {
                    return emit_binding binding
                }
                when ret: Return
                {
                    return emit_return ret
                }
                when throw_stmt: Throw
                {
                    return emit_throw throw_stmt
                }
                when brk: Break
                {
                    return emit_break brk
                }
                when cont: Continue
                {
                    return emit_continue cont
                }
        }

        ; Emit an action (expression statement or assignment)
        ; True when the operand tree mentions `name` — as a bare variable, a
        ; member-access hop, or inside nested call/tuple/as operands. Used by the
        ; in-place field-construction aliasing guard; CONSERVATIVE: any expression
        ; shape the walker doesn't enumerate counts as a mention (keep the
        ; scratch when in doubt).
        function operand_mentions_name(this, op: PlannedOperand, name: String) returns bool
        {
            if op.member_access <> null
            {
                let chain (*op.member_access)
                var mi: size_t 0
                while mi < chain.length
                {
                    let mp chain.get mi
                    if mp <> null
                    {
                        let hop (*mp)
                        if hop.name = name
                            return true
                    }
                    set mi: mi + 1
                }
            }
            var mentions: bool false
            choose op.expr
                when v: Variable
                    set mentions: v.name = name
                when c: Call
                {
                    if c.args <> null
                    {
                        let argv (*c.args)
                        var ai: size_t 0
                        while ai < argv.length
                        {
                            let ap argv.get ai
                            if ap <> null
                            {
                                let arg_op (*ap)
                                if operand_mentions_name(arg_op, name)
                                    return true
                            }
                            set ai: ai + 1
                        }
                    }
                }
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        let comps (*tp.components)
                        var ci: size_t 0
                        while ci < comps.length
                        {
                            let cp comps.get ci
                            if cp <> null
                            {
                                let comp (*cp)
                                if comp.value <> null
                                {
                                    let vals (*comp.value)
                                    var vi: size_t 0
                                    while vi < vals.length
                                    {
                                        let vp vals.get vi
                                        if vp <> null
                                        {
                                            let v_op (*vp)
                                            if operand_mentions_name(v_op, name)
                                                return true
                                        }
                                        set vi: vi + 1
                                    }
                                }
                            }
                            set ci: ci + 1
                        }
                    }
                }
                when az: As
                {
                    if az.value <> null
                    {
                        let a_ref az.value
                        let a_op (*a_ref)
                        if operand_mentions_name(a_op, name)
                            return true
                    }
                }
                when ct: Constant
                    0
                when ty: Type
                    0
                when gr: GlobalRef
                    0
                when so: SizeOf
                    0
                when ao: AlignOf
                    0
                else
                    set mentions: true
            mentions
        }

        ; Aliasing guard for in-place field construction: true when any ctor arg
        ; references the target variable or any hop of the target member chain.
        ; `set f: String(f)` must KEEP the scratch — the ctor reads the old value
        ; while in-place construction would clobber it first.
        function ctor_args_mention_chain(this, call: PlannedCall, variable: PlannedVariable, chain: Vector[PlannedMemberAccess]) returns bool
        {
            if call.args = null
                return false
            let argv (*call.args)
            var ai: size_t 0
            while ai < argv.length
            {
                let ap argv.get ai
                if ap <> null
                {
                    let arg_op (*ap)
                    if operand_mentions_name(arg_op, variable.name)
                        return true
                    var mi: size_t 0
                    while mi < chain.length
                    {
                        let mp chain.get mi
                        if mp <> null
                        {
                            let hop (*mp)
                            if operand_mentions_name(arg_op, hop.name)
                                return true
                        }
                        set mi: mi + 1
                    }
                }
                set ai: ai + 1
            }
            false
        }

        ; In-place field construction: `set X.field...: Ctor(args)` with a single
        ; construction source constructs directly on the final field address
        ; instead of a discarded scratch. The scratch LEAKED sizeof(struct) on the
        ; owner page per field init (a region-alloc'd ctor result was loaded and
        ; stored by value into the field, orphaning the allocation) and the
        ; whole-aggregate load+store is the s178 spill class. IR-verified: the
        ; scratch page always equals the destination page (Page.get(this) inside
        ; the ctor = Page.get(&field) = owner page), so interior buffer placement
        ; is unchanged. Gates (all checked BEFORE any IR is emitted):
        ;   - target is a Variable with a member-access chain;
        ;   - source is exactly one C1E constructor Call with no trailing chain,
        ;     no page param, and life Unspecified (stack scratch) or ^this
        ;     (owner page) — Local/Call/^other scratches keep the legacy copy;
        ;   - the final field's LLVM type IS the ctor's struct type (by-value
        ;     field; pointer-storing fields keep the legacy path);
        ;   - no ctor arg mentions the target chain (aliasing guard).
        ; Returns null (nothing emitted) when not applicable — emit_action then
        ; falls through to the legacy scratch path.
        function emit_in_place_field_ctor(this, action: PlannedAction) returns LLVMValueRef
        {
            let no_val LLVMValueRef(null)
            if action.target = null
                return no_val
            if action.target.length = 0
                return no_val
            let target_op action.target.get 0
            if target_op = null
                return no_val
            if target_op.member_access = null
                return no_val
            if target_op.member_access.length = 0
                return no_val
            if action.source = null
                return no_val
            if action.source.length <> 1
                return no_val
            let src_ptr action.source.get 0
            if src_ptr = null
                return no_val
            let src_op (*src_ptr)
            if src_op.member_access <> null
                return no_val

            choose target_op.expr
                when variable: Variable
                {
                    choose src_op.expr
                        when c: Call
                        {
                            if c.mangled_name.contains("C1E") = false
                                return no_val
                            if c.requires_page_param
                                return no_val
                            var life_ok: bool false
                            choose c.life
                                when u: Unspecified
                                    set life_ok: true
                                when r: Lifetime.Reference
                                {
                                    if r.location = "this"
                                        set life_ok: true
                                }
                                else
                                    0
                            if life_ok = false
                                return no_val

                            ; Final field must be a by-value struct of exactly
                            ; the ctor's LLVM type (types are uniqued — compare
                            ; handles).
                            let chain_ref target_op.member_access
                            let chain (*chain_ref)
                            let n chain.length
                            let last_ptr chain.get(n - 1)
                            if last_ptr = null
                                return no_val
                            let last_member last_ptr.unwrap()
                            let field_ty map_type last_member.result_type
                            if field_ty.handle = null
                                return no_val
                            if LLVMGetTypeKind(field_ty) <> LLVMTypeKind.Struct()
                                return no_val
                            var ctor_rt c.result_type
                            if ctor_rt.name = "pointer"
                            {
                                if ctor_rt.generics <> null
                                {
                                    let gens (*ctor_rt.generics)
                                    if gens.length > 0
                                    {
                                        let g0 gens.get 0
                                        if g0 <> null
                                            set ctor_rt: (*g0)
                                    }
                                }
                            }
                            let ctor_ty map_type ctor_rt
                            if ctor_ty.handle = null
                                return no_val
                            if ctor_ty.handle <> field_ty.handle
                                return no_val

                            if ctor_args_mention_chain(c, variable, chain)
                                return no_val

                            ; All gates passed — emit: field address, then
                            ; construct straight onto it.
                            let var_ptr lookup_variable variable.name
                            if var_ptr.handle = null
                                return no_val
                            let dest emit_member_address(var_ptr, variable, target_op.member_access)
                            if dest.handle = null
                                return no_val
                            return emit_constructor_call_into(c, dest)
                        }
                        else
                            0
                }
                else
                    0
            no_val
        }

        function emit_action(this, action: PlannedAction) returns LLVMValueRef
        {
            ; -g line info: every action carries its own source span (plan_action#
            ; takes it from the first flat source operand). emit_block, emit_if's
            ; Action branches, and the while/for/choose bodies call emit_action
            ; DIRECTLY — bypassing emit_statement's set_statement_debug_location —
            ; so without this, statements nested inside a loop or conditional body
            ; inherit the enclosing statement's line. emit_action is the single
            ; chokepoint they all share. set_debug_location self-guards on
            ; emit_debug_info and returns before its O(n) offset scan when -g is
            ; off, so default (no-g) emission stays byte-identical.
            set_debug_location action.loc

            ; In-place field construction (see emit_in_place_field_ctor): must
            ; run BEFORE the source is emitted — the legacy path materializes the
            ; ctor result into a scratch first and copies it into the field.
            let in_place_val emit_in_place_field_ctor(action)
            if in_place_val.handle <> null
                return in_place_val

            ; Emit source operands
            var value emit_operands action.source
            if value.handle = null
                return LLVMValueRef null

            ; If there are target operands, this is an assignment
            if action.target <> null
            {
                if action.target.length > 0
                {
                    ; Get the target - should be a variable reference for simple assignment
                    let target_op action.target.get 0
                    if target_op = null
                        return value

                    choose target_op.expr
                        when variable: Variable
                        {
                            ; Look up the variable's pointer
                            let var_ptr lookup_variable variable.name
                            if var_ptr.handle = null
                                return LLVMValueRef null

                            ; Check for member access (e.g., this.x = value)
                            if target_op.member_access <> null
                            {
                                if target_op.member_access.length > 0
                                {
                                    ; s86: when storing a no-arg ctor result with
                                    ; Lifetime.Unspecified into a member of `this`
                                    ; (a heap-allocated parent), emit_constructor_call
                                    ; returned a stack alloca whose address would be
                                    ; stomped after the parent's init returns. Heap-
                                    ; copy the struct value onto the parent's page
                                    ; via Page::get(this) + Page::allocate so the
                                    ; field stores a valid heap pointer.
                                    set value: maybe_heap_copy_ctor_value(value, var_ptr, variable, action.source)
                                    if value.handle = null
                                        return LLVMValueRef null
                                    ; GEP-based field assignment for member access chains
                                    return emit_member_assignment(var_ptr, variable, target_op.member_access, value)
                                }
                            }

                            ; Simple variable assignment
                            if variable.is_mutable = false
                                return LLVMValueRef null  ; Cannot assign to immutable

                            ; s124: same flat-variable-table leak as
                            ; emit_variable. When sibling choose/if arms reuse
                            ; the same Scaly variable name (`let X` in one,
                            ; `set X: ...` in another), lookup returns the
                            ; earlier let-binding's value-typed LLVMValueRef
                            ; instead of the var alloca. Storing into a
                            ; non-pointer is invalid IR; drop the store
                            ; rather than emit `store T %a, T %b`.
                            let store_ty LLVMTypeOf(var_ptr)
                            if store_ty.handle <> null
                            {
                                if LLVMGetTypeKind(store_ty) <> LLVMTypeKind.Pointer()
                                    return value
                            }
                            ; ptr-slot + ptr-VALUE disambiguation — the missing
                            ; third case beside s172/s173 (the 2026-07-04b latent
                            ; gap). The alloca holds a POINTER to the binding's
                            ; heap struct (an addr-taken/borrow-return PROMOTED
                            ; binding), the TARGET's planned type is that struct,
                            ; and the source value is ALSO an LLVM ptr (a deref
                            ; temp `set X: (*ref)`, a ref, or an sret slot) — a
                            ; struct materialized BY POINTER, not a pointer
                            ; value. The old fall-through raw-stored the pooled
                            ; stack temp's ADDRESS into the promoted slot, which
                            ; outlives the temp (garbage after frame exit). Copy
                            ; the struct THROUGH into the existing heap struct
                            ; instead: the binding's page placement (chosen at
                            ; promotion) is preserved and pre-existing &X
                            ; references observe the new contents. A genuinely
                            ; pointer-typed target (ref/pointer var reassign)
                            ; maps to Pointer, not Struct, and keeps the raw
                            ; store.
                            let tgt_rt (*target_op).result_type
                            let tgt_ty map_type tgt_rt
                            if tgt_ty.handle <> null
                            {
                                if LLVMGetTypeKind(tgt_ty) = LLVMTypeKind.Struct()
                                {
                                    let slot_alloca LLVMIsAAllocaInst(var_ptr)
                                    if slot_alloca.handle <> null
                                    {
                                        let slot_ty LLVMGetAllocatedType(var_ptr)
                                        if slot_ty.handle <> null
                                        {
                                            if LLVMGetTypeKind(slot_ty) = LLVMTypeKind.Pointer()
                                            {
                                                let val_ty_d LLVMTypeOf(value)
                                                if val_ty_d.handle <> null
                                                {
                                                    if LLVMGetTypeKind(val_ty_d) = LLVMTypeKind.Pointer()
                                                    {
                                                        let dest_ptr LLVMBuildLoad2(builder, LLVMPointerTypeInContext(context, 0), var_ptr, "set.dest")
                                                        let thru_val LLVMBuildLoad2(builder, tgt_ty, value, "set.thru")
                                                        copy_struct_value(dest_ptr, thru_val, tgt_ty)
                                                        return value
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            ; s172: layout-mismatch store, mirrors stage-0
                            ; Emitter.cpp:2076-2100. The alloca holds a POINTER
                            ; to a heap struct (var X String^rp(...)) but the
                            ; new value is a struct VALUE. Storing it bitwise
                            ; would make the slot hold the struct's first field
                            ; instead of a pointer — a later method call on the
                            ; variable passes that field as `this` and faults
                            ; (stage-2 fn_name.last_index_of on "\x06helper").
                            ; Heap-alloc a copy on the local page (or rp) and
                            ; store the new pointer instead.
                            var store_val value
                            let is_alloca LLVMIsAAllocaInst(var_ptr)
                            if is_alloca.handle <> null
                            {
                                let alloc_ty LLVMGetAllocatedType(var_ptr)
                                if alloc_ty.handle <> null
                                {
                                    if LLVMGetTypeKind(alloc_ty) = LLVMTypeKind.Pointer()
                                    {
                                        let val_ty LLVMTypeOf(value)
                                        if val_ty.handle <> null
                                        {
                                            if LLVMGetTypeKind(val_ty) = LLVMTypeKind.Struct()
                                            {
                                                var copy_page current_region.local_page
                                                if copy_page.handle = null
                                                {
                                                    let rp_val lookup_variable("_rp")
                                                    if rp_val.handle <> null
                                                        set copy_page: force_frame(rp_val)
                                                }
                                                ; current_region.local_page is a never-set null
                                                ; (see the s196 field comment); in a non-rp
                                                ; function the _rp lookup fails too, and the
                                                ; heap-copy was silently SKIPPED — the raw
                                                ; fall-through stored a struct VALUE into the
                                                ; ptr slot (`var t SC()` + `set t: p.field`
                                                ; then read t as a pointer built from the
                                                ; struct's first field). Fall back to the
                                                ; function-local page like every other
                                                ; rp-fallback site.
                                                if copy_page.handle = null
                                                    set copy_page: get_or_create_local_page()
                                                if copy_page.handle <> null
                                                {
                                                    var alloc_func LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
                                                    if alloc_func.handle = null
                                                    {
                                                        var ap_param_types Vector[LLVMTypeRef](3)
                                                        ap_param_types.put(0, LLVMPointerTypeInContext(context, 0))
                                                        ap_param_types.put(1, LLVMInt64TypeInContext context)
                                                        ap_param_types.put(2, LLVMInt64TypeInContext context)
                                                        let ap_decl_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), ap_param_types.data, 3, 0)
                                                        set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", ap_decl_ty)
                                                        LLVMSetLinkage(alloc_func, LLVMLinkage.External())
                                                    }
                                                    let size_const LLVMSizeOf(val_ty)
                                                    let align_const LLVMAlignOf(val_ty)
                                                    var alloc_args Vector[LLVMValueRef](3)
                                                    alloc_args.put(0, copy_page)
                                                    alloc_args.put(1, size_const)
                                                    alloc_args.put(2, align_const)
                                                    var ap_call_pt Vector[LLVMTypeRef](3)
                                                    ap_call_pt.put(0, LLVMPointerTypeInContext(context, 0))
                                                    ap_call_pt.put(1, LLVMInt64TypeInContext context)
                                                    ap_call_pt.put(2, LLVMInt64TypeInContext context)
                                                    let ap_call_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), ap_call_pt.data, 3, 0)
                                                    let heap_ptr LLVMBuildCall2(builder, ap_call_ty, alloc_func, alloc_args.data, 3, "set.heap")
                                                    if heap_ptr.handle <> null
                                                    {
                                                        ; s178: memcpy when value is a load.
                                                        copy_struct_value(heap_ptr, value, val_ty)
                                                        set store_val: heap_ptr
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            ; s173: converse mismatch, mirrors stage-0
                            ; Emitter.cpp:2098-2108. The alloca holds a struct
                            ; VALUE but the new value is a POINTER to one (an
                            ; sret slot from a struct-returning call — `set
                            ; value: emit_expression(...)` in emit_operand).
                            ; Storing the pointer bitwise makes the slot's
                            ; first field hold a dangling stack address (the
                            ; LLVMValueRef "handle" emit_intrinsic_binary_op
                            ; then crashed dereferencing). Load the struct
                            ; through the pointer first.
                            if is_alloca.handle <> null
                            {
                                let alloc_ty_c LLVMGetAllocatedType(var_ptr)
                                if alloc_ty_c.handle <> null
                                {
                                    if LLVMGetTypeKind(alloc_ty_c) = LLVMTypeKind.Struct()
                                    {
                                        let val_ty_c LLVMTypeOf(store_val)
                                        if val_ty_c.handle <> null
                                        {
                                            if LLVMGetTypeKind(val_ty_c) = LLVMTypeKind.Pointer()
                                                set store_val: LLVMBuildLoad2(builder, alloc_ty_c, store_val, "set.load")
                                        }
                                    }
                                }
                            }
                            ; s201: integer-width coercion on store. `set c: c + 1`
                            ; where c is u32 types the RHS as i64 (the untyped literal
                            ; is i64) and would `store i64` into a 4-byte i32 alloca —
                            ; 8 bytes into a 4-byte slot, clobbering the adjacent stack
                            ; (and at -O2 opt exploits the type-punned slot, breaking
                            ; loop counters — Syntax/Partition hung/mis-refined).
                            ; Truncate the value to the destination alloca's integer
                            ; width. scalyc's own counters are size_t/int (i64), so it
                            ; never widens on store → cycle IDENTICAL; opensp's u32/u16/
                            ; u8 counters are the beneficiaries.
                            if is_alloca.handle <> null
                            {
                                let iw_alloc_ty LLVMGetAllocatedType(var_ptr)
                                if iw_alloc_ty.handle <> null
                                {
                                    if LLVMGetTypeKind(iw_alloc_ty) = LLVMTypeKind.Integer()
                                    {
                                        let iw_val_ty LLVMTypeOf(store_val)
                                        if iw_val_ty.handle <> null
                                        {
                                            if LLVMGetTypeKind(iw_val_ty) = LLVMTypeKind.Integer()
                                            {
                                                let dst_bits LLVMGetIntTypeWidth(iw_alloc_ty)
                                                let src_bits LLVMGetIntTypeWidth(iw_val_ty)
                                                if src_bits > dst_bits
                                                    set store_val: LLVMBuildTrunc(builder, store_val, iw_alloc_ty, "set.trunc")
                                            }
                                        }
                                    }
                                }
                            }
                            ; Store the value to the variable. s178: memcpy
                            ; when store_val is a load — kills the spill slot.
                            let sv_ty LLVMTypeOf(store_val)
                            copy_struct_value(var_ptr, store_val, sv_ty)
                        }
                        when call: Call
                        {
                            ; `set accessor(args).field: value` — the target's base is
                            ; a CALL returning a pointer[T] (e.g. ISet.range_at(i) =
                            ; `ranges.get_buffer()+i`). This first `when call:` arm used
                            ; to handle ONLY the `*` deref shape; a member-access store
                            ; through any other call fell to the `else` and was SILENTLY
                            ; DROPPED (ISet coalescing left ranges [0,0]). Emit the call
                            ; to get the base pointer, then GEP the field through it
                            ; (emit_member_address handles a pointer-typed base that is
                            ; a call-result VALUE, not an alloca — no extra load).
                            ; Guarded on name <> "*" so the deref path below is byte-
                            ; identical.
                            if call.name <> "*"
                                if target_op.member_access <> null
                                    if target_op.member_access.length > 0
                                    {
                                        let base emit_call call
                                        if base.handle = null
                                            return value
                                        let cv_pv PlannedVariable(call.loc, call.name, call.result_type, true)
                                        return emit_member_assignment(base, cv_pv, target_op.member_access, value)
                                    }
                            ; Handle dereference assignment like *ptr = value
                            if call.name = "*"
                            {
                                if call.args <> null
                                {
                                    if call.args.length = 1
                                    {
                                        ; Emit the argument to get the pointer.
                                        ; Session-25 pattern: `choose ... when Some` on a
                                        ; ref[T]? deref produces null/garbage under NPO; use
                                        ; if <> null + .unwrap() instead.
                                        let arg_opt call.args.get 0
                                        if arg_opt <> null
                                        {
                                            let ptr emit_operand(arg_opt.unwrap())
                                            if ptr.handle <> null
                                            {
                                                ; s136: when storing a struct value passed
                                                ; by reference (LLVM-level ptr), load the
                                                ; struct from the source ptr first so the
                                                ; store writes the full struct contents
                                                ; into the target slot. Without this,
                                                ; `set *(data + i): item` in Vector[T]::put
                                                ; for struct T stored the source ptr (8
                                                ; bytes) instead of the struct value —
                                                ; data[i] then held the address of the
                                                ; argument's heap copy, not the copy
                                                ; itself, and downstream `*holder.get(i)`
                                                ; loaded that address as if it were the
                                                ; first 8 bytes of a String (giving the
                                                ; raw data pointer as the "String") and
                                                ; equals/etc. read garbage.
                                                var store_val value
                                                ; The s136 struct-load is correct ONLY when the
                                                ; slot `*ptr` holds the struct itself (Vector[T].
                                                ; put: `*(data+i)`, data: pointer[T]). When the
                                                ; slot holds a POINTER (`sets: pointer[pointer[
                                                ; ISet]]`, so `*(sets+i)` is a pointer[ISet] slot),
                                                ; a region-ctor / by-ref source must store its
                                                ; POINTER value directly — struct-loading it would
                                                ; write sizeof(struct) bytes into an 8-byte pointer
                                                ; slot (the in-package `set *(sets+i): ISet^page()`
                                                ; crash: sets[i] got ranges, sets[i+1] got clobbered).
                                                ; Detect via the deref arg's PLANNED type (peel one
                                                ; pointer level) — robust to opaque map_type, which
                                                ; collapses both a struct and a pointer slot to `ptr`.
                                                var slot_is_pointer: bool false
                                                let deref_rt arg_opt.unwrap().result_type
                                                if deref_rt.name = "pointer"
                                                    if deref_rt.generics <> null
                                                        if (*deref_rt.generics).length > 0
                                                        {
                                                            let slot_tp (*deref_rt.generics).get 0
                                                            if slot_tp <> null
                                                            {
                                                                let slot_t (*slot_tp)
                                                                if slot_t.name = "pointer"
                                                                    set slot_is_pointer: true
                                                                if slot_t.name = "ref"
                                                                    set slot_is_pointer: true
                                                            }
                                                        }
                                                if slot_is_pointer = false
                                                    if action.source <> null
                                                    {
                                                        let src_vec (*action.source)
                                                        if src_vec.length > 0
                                                        {
                                                            let src_op_ptr src_vec.get 0
                                                            if src_op_ptr <> null
                                                            {
                                                                let src_op (*src_op_ptr)
                                                                let src_ty map_type src_op.result_type
                                                                if LLVMGetTypeKind(src_ty) = LLVMTypeKind.Struct()
                                                                {
                                                                    if LLVMGetTypeKind(LLVMTypeOf value) = LLVMTypeKind.Pointer()
                                                                        set store_val: LLVMBuildLoad2(builder, src_ty, value, "store.load")
                                                                }
                                                            }
                                                        }
                                                    }
                                                LLVMBuildStore(builder, store_val, ptr)
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        when global_ref: GlobalRef
                        {
                            ; s189: assignment to a module-level mutable global.
                            let gv LLVMGetNamedGlobal(llvm_module, global_ref.mangled_name.c_data())
                            if gv.handle = null
                                return value

                            ; Member-access store (`set heap_head.prev: x`):
                            ; emit_member_assignment loads a POINTER base only when
                            ; the slot is an alloca — a global variable is neither,
                            ; so it would GEP into the global itself (e.g.
                            ; `set heap_head.prev` wiping the free-list head). For a
                            ; pointer/ref global, pre-load the stored pointer here
                            ; and pass it as the base so the GEP targets the
                            ; pointed-to struct's field. A by-value struct global
                            ; passes gv directly (its address IS the struct).
                            if target_op.member_access <> null
                            {
                                if target_op.member_access.length > 0
                                {
                                    var base gv
                                    var is_ptr_global global_ref.global_type.name = "pointer"
                                    if is_ptr_global = false
                                        set is_ptr_global: global_ref.global_type.name = "ref"
                                    if is_ptr_global
                                    {
                                        let ptr_type LLVMPointerTypeInContext(context, 0)
                                        set base: LLVMBuildLoad2(builder, ptr_type, gv, "gv.load")
                                    }
                                    let gv_pv PlannedVariable(global_ref.loc, global_ref.name, global_ref.global_type, true)
                                    return emit_member_assignment(base, gv_pv, target_op.member_access, value)
                                }
                            }

                            ; Simple whole-value store: `set NAME: value`.
                            LLVMBuildStore(builder, value, gv)
                        }
                        else
                        {
                            ; Other assignment targets not yet supported
                        }
                }
            }

            value
        }

        ; s86: when emit_action is storing a stack-alloca'd ctor result into a
        ; member of `this` (a heap-allocated parent), copy the struct value onto
        ; the parent's page so the field stores a stable heap pointer rather
        ; than a stack-frame address that goes invalid after init returns.
        ;
        ; Triggers only for: variable name "this" + single-operand source whose
        ; expr is a Call with Lifetime.Unspecified and a C1 (Itanium ctor)
        ; mangled name. Other shapes pass through unchanged.
        function maybe_heap_copy_ctor_value(this, value: LLVMValueRef, var_ptr: LLVMValueRef, variable: PlannedVariable, source: ref[Vector[PlannedOperand]]?) returns LLVMValueRef
        {
            if variable.name <> "this"
                return value
            if source = null
                return value
            if source.length <> 1
                return value
            let op_ptr source.get 0
            if op_ptr = null
                return value
            let op op_ptr.unwrap()

            var struct_ty: LLVMTypeRef LLVMTypeRef(null)
            choose op.expr
                when c: Call
                {
                    choose c.life
                        when u: Unspecified
                        {
                            if c.mangled_name.contains("C1E")
                                set struct_ty: map_type(c.result_type)
                        }
                        else
                            0
                }
                else
                    0
            if struct_ty.handle = null
                return value

            ; Page::get(this) - bit-mask off low bits to find the page.
            ; Use LLVMGetNamedFunction directly (skip the function-cache to avoid
            ; dangling String keys when called from many sites in one compilation).
            var page_get_fn LLVMGetNamedFunction(llvm_module, "_ZN4Page3getEPv")
            if page_get_fn.handle = null
            {
                var pg_param_types Vector[LLVMTypeRef](1)
                pg_param_types.put(0, LLVMPointerTypeInContext(context, 0))
                let pg_decl_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), pg_param_types.data, 1, 0)
                set page_get_fn: LLVMAddFunction(llvm_module, "_ZN4Page3getEPv", pg_decl_ty)
                LLVMSetLinkage(page_get_fn, LLVMLinkage.External())
            }
            var pg_args Vector[LLVMValueRef](1)
            pg_args.put(0, var_ptr)
            var pg_call_pt Vector[LLVMTypeRef](1)
            pg_call_pt.put(0, LLVMPointerTypeInContext(context, 0))
            let pg_call_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), pg_call_pt.data, 1, 0)
            let parent_page LLVMBuildCall2(builder, pg_call_ty, page_get_fn, pg_args.data, 1, "parent.page")

            ; Page::allocate(page, sizeof, alignof)
            var alloc_func LLVMGetNamedFunction(llvm_module, "_ZN4Page8allocateEmm")
            if alloc_func.handle = null
            {
                var ap_param_types Vector[LLVMTypeRef](3)
                ap_param_types.put(0, LLVMPointerTypeInContext(context, 0))
                ap_param_types.put(1, LLVMInt64TypeInContext context)
                ap_param_types.put(2, LLVMInt64TypeInContext context)
                let ap_decl_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), ap_param_types.data, 3, 0)
                set alloc_func: LLVMAddFunction(llvm_module, "_ZN4Page8allocateEmm", ap_decl_ty)
                LLVMSetLinkage(alloc_func, LLVMLinkage.External())
            }
            let size_const LLVMSizeOf(struct_ty)
            let align_const LLVMAlignOf(struct_ty)
            var alloc_args Vector[LLVMValueRef](3)
            alloc_args.put(0, parent_page)
            alloc_args.put(1, size_const)
            alloc_args.put(2, align_const)
            var ap_call_pt Vector[LLVMTypeRef](3)
            ap_call_pt.put(0, LLVMPointerTypeInContext(context, 0))
            ap_call_pt.put(1, LLVMInt64TypeInContext context)
            ap_call_pt.put(2, LLVMInt64TypeInContext context)
            let ap_call_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), ap_call_pt.data, 3, 0)
            let heap_ptr LLVMBuildCall2(builder, ap_call_ty, alloc_func, alloc_args.data, 3, "ctor.heap")

            ; Copy the struct value via memcpy(heap_ptr, value, sizeof). LLVMBuildLoad2
            ; crashes on map_type-returned types in some cross-package paths (see s55
            ; comment near line 1403); memcpy avoids needing a usable load type.
            var memcpy_fn LLVMGetNamedFunction(llvm_module, "memcpy")
            if memcpy_fn.handle = null
            {
                var mc_param_types Vector[LLVMTypeRef](3)
                mc_param_types.put(0, LLVMPointerTypeInContext(context, 0))
                mc_param_types.put(1, LLVMPointerTypeInContext(context, 0))
                mc_param_types.put(2, LLVMInt64TypeInContext context)
                let mc_decl_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), mc_param_types.data, 3, 0)
                set memcpy_fn: LLVMAddFunction(llvm_module, "memcpy", mc_decl_ty)
                LLVMSetLinkage(memcpy_fn, LLVMLinkage.External())
            }
            var mc_args Vector[LLVMValueRef](3)
            mc_args.put(0, heap_ptr)
            mc_args.put(1, value)
            mc_args.put(2, size_const)
            var mc_call_pt Vector[LLVMTypeRef](3)
            mc_call_pt.put(0, LLVMPointerTypeInContext(context, 0))
            mc_call_pt.put(1, LLVMPointerTypeInContext(context, 0))
            mc_call_pt.put(2, LLVMInt64TypeInContext context)
            let mc_call_ty LLVMFunctionType(LLVMPointerTypeInContext(context, 0), mc_call_pt.data, 3, 0)
            LLVMBuildCall2(builder, mc_call_ty, memcpy_fn, mc_args.data, 3, "")
            heap_ptr
        }

        ; Compute the ADDRESS of a member-access chain's final field (base setup
        ; + GEP-chain walk). Factored out of emit_member_assignment so the
        ; in-place field construction path (emit_in_place_field_ctor) can compute
        ; the destination without emitting a store.
        function emit_member_address(this, var_ptr: LLVMValueRef, planned_var: PlannedVariable, members: ref[Vector[PlannedMemberAccess]]?) returns LLVMValueRef
        {
            ; s34 root fix: plain var copies of the by-ptr struct params
            ; (emitBinding now copies single-ptr-field struct params correctly).
            var current_ptr var_ptr

            ; Determine the struct type for GEP. For `this` (pointer[T]) we
            ; want T's struct type directly. For non-pointer locals we use
            ; the variable type. Stage-0 has an ABI bug passing PlannedType
            ; by-value as a struct-field arg — copy fields into locals first.
            let var_ty planned_var.variable_type
            let var_ty_name var_ty.name
            ; s137: include `ref` alongside `pointer`. `var patched item` where
            ; item is `(*item_ptr).unwrap()` binds a `ref[T]` whose LLVM
            ; representation is `ptr`. Without this, member assignment
            ; (`set patched.field: value`) treats patched as a struct and
            ; emits `getelementptr inbounds ptr, ptr %patched, i32 0, i32 N`
            ; which IRTranslator SEGVs on (GEP on `ptr` base type with struct
            ; indices). With the branch, we load the ref's heap pointer first
            ; and switch current_type to the inner struct for the GEP. Use
            ; nested set instead of `or` to avoid precedence ambiguity.
            var is_pointer var_ty_name = "pointer"
            if is_pointer = false
                set is_pointer: var_ty_name = "ref"
            ; A `ref[T]?` / `pointer[T]?` arrives as Option[ref[T]] (Modeler
            ; s113), so the two name tests above miss it and the base falls
            ; through to the by-value path: current_type becomes map_type of the
            ; Option, which for an NPO is a bare `ptr`, the struct-typed load
            ; below is gated on Struct and is skipped, and the chain walk then
            ; emits `getelementptr inbounds ptr, ptr %r, i32 0, i32 N`.
            ; LLVMBuildStructGEP2 ACCEPTS that -- its assertion is compiled out
            ; of a release libLLVM -- so nothing fails here and the BACKEND
            ; SIGSEGVs instead: `-S` prints the broken GEP with rc 0 while `-o`
            ; dies wordless with rc 139. The chain's own hops have unwrapped the
            ; hull since s99; this is the same question asked of the BASE.
            if is_pointer = false
                set is_pointer: is_npo_option(var_ty)
            let is_this planned_var.name = "this"

            var current_type LLVMTypeRef(null)
            if is_pointer = false
                set current_type: map_type(var_ty)
            if is_pointer
            {
                ; Pointer-typed local: load the pointer first ONLY when the slot
                ; is an alloca holding the pointer (`var p` / a stored param).
                ; A `let p <call>` binds p to the pointer VALUE directly — there
                ; the load would deref the pointed-to memory (s189: create_stack
                ; _bucket's `set sb.prev`, where sb = aligned_alloc result, gave
                ; `load ptr, %call` of uninitialised bucket memory → SIGSEGV).
                ; `this` is always the raw pointer arg, never loaded.
                if is_this = false
                {
                    let mp_is_alloca LLVMIsAAllocaInst(current_ptr)
                    if mp_is_alloca.handle <> null
                    {
                        let ptr_type LLVMPointerTypeInContext(context, 0)
                        set current_ptr: LLVMBuildLoad2(builder, ptr_type, current_ptr, "ptr.load")
                    }
                }
                ; Inner generic = struct type for GEP.
                if var_ty.generics <> null
                {
                    let gens (*var_ty.generics)
                    if gens.length > 0
                    {
                        let inner_opt gens.get 0
                        if inner_opt <> null
                        {
                            var inner (*inner_opt)
                            ; Option[ref[T]] / Option[pointer[T]]: generic 0 is
                            ; the ref/pointer, not the pointee, so one more hop
                            ; is needed before the layout is in hand. Mirrors the
                            ; cascade the chain hop runs below.
                            if inner.name = "ref"
                                set inner: first_generic_of(inner)
                            if inner.name = "pointer"
                                set inner: first_generic_of(inner)
                            set current_type: map_type(inner)
                            ; s138: map_type falls back to opaque-ptr for
                            ; unmaterialised stdlib generics (HashMapBuilder[K,V]
                            ; etc.), so LLVMBuildStructGEP2 below would emit an
                            ; invalid `getelementptr inbounds ptr, ptr X, i32 0,
                            ; i32 N`. Mirror the s121 fallback at
                            ; emit_member_access_chain line 1921: when current_type
                            ; isn't a Struct, try synthesize_literal_struct for
                            ; known shapes. Walks plan.structures first, then the
                            ; hardcoded stdlib-container table.
                            if LLVMGetTypeKind(current_type) <> LLVMTypeKind.Struct()
                                set current_type: synthesize_literal_struct(inner.name)
                        }
                    }
                }
            }

            ; s87: when var_ptr is an alloca-of-ptr (region-allocated ctor
            ; result like Options()), the alloca holds the heap pointer
            ; rather than the struct itself. GEPing into the alloca treats
            ; an 8-byte ptr slot as the struct base and overflows on every
            ; field offset. Load the heap pointer first, then GEP into the
            ; heap struct. Mirrors emit_variable's struct/ptr-alloca fix.
            if is_pointer = false
            {
                if current_type.handle <> null
                {
                    if LLVMGetTypeKind(current_type) = LLVMTypeKind.Struct()
                    {
                        let is_alloca LLVMIsAAllocaInst(current_ptr)
                        if is_alloca.handle <> null
                        {
                            let alloc_ty LLVMGetAllocatedType(current_ptr)
                            if alloc_ty.handle <> null
                            {
                                if LLVMGetTypeKind(alloc_ty) = LLVMTypeKind.Pointer()
                                {
                                    let ptr_type LLVMPointerTypeInContext(context, 0)
                                    set current_ptr: LLVMBuildLoad2(builder, ptr_type, current_ptr, "ptr.load")
                                }
                            }
                        }
                    }
                }
            }

            ; Navigate through member access chain. `members` is
            ; ref[Vector[...]]? — unwrap and deref to the Vector first.
            ; Skip the trailing map_type(member.result_type) on the LAST
            ; hop — current_type is only used to set up the next GEP, so
            ; the last iteration's update is wasted, and stage-0 has an
            ; ABI bug passing PlannedType-by-value as a struct-field arg.
            if members <> null
            {
                let chain_ref members
                let chain (*chain_ref)
                let n chain.length
                var i: size_t 0
                while i < n
                {
                    let member_ptr chain.get i
                    if member_ptr <> null
                    {
                        let member member_ptr.unwrap()
                        let field_ptr LLVMBuildStructGEP2(builder, current_type, current_ptr, member.field_index as int, member.name.c_data())
                        set current_ptr: field_ptr
                        let next i + 1
                        if next < n
                        {
                            let rt member.result_type
                            let mapped map_type rt
                            set current_type: mapped
                            ; s99: when the field is pointer-like (ref[T]?,
                            ; ref[T], pointer[T], Option[ref[T]], etc.), load
                            ; through the field address and switch
                            ; current_type to the inner struct type so the
                            ; next StructGEP uses the right element type.
                            ; Mirrors stage-0 Emitter.cpp:2044-2055.
                            if mapped.handle <> null
                            {
                                ; A `ptr` for a name that is not pointer-shaped is
                                ; map_type's placeholder for a struct this root
                                ; never lays out — a BY-VALUE field, not a
                                ; reference. Loading through it and storing into
                                ; the load is a wild store: `set p.exclusive_pages.head: null`
                                ; on a pointer[Page] wrote through Page's
                                ; uninitialized PageList field instead of into it.
                                ; The literal layouts synthesize_literal_struct#
                                ; keeps for exactly these types give the next GEP
                                ; the right element type; keep GEPing from the
                                ; field ADDRESS.
                                var by_value_struct: bool false
                                if LLVMGetTypeKind(mapped) = LLVMTypeKind.Pointer()
                                    if type_is_pointer_shaped(rt) = false
                                    {
                                        let lit synthesize_literal_struct rt.name
                                        if lit.handle <> null
                                            if LLVMGetTypeKind(lit) = LLVMTypeKind.Struct()
                                            {
                                                set current_type: lit
                                                set by_value_struct: true
                                            }
                                    }
                                if by_value_struct = false
                                    if LLVMGetTypeKind(mapped) = LLVMTypeKind.Pointer()
                                    {
                                        var inner_rt rt
                                        if inner_rt.name = "Option"
                                        {
                                            if inner_rt.generics <> null
                                            {
                                                let gens (*inner_rt.generics)
                                                if gens.length > 0
                                                {
                                                    let g0 gens.get 0
                                                    if g0 <> null
                                                        set inner_rt: (*g0)
                                                }
                                            }
                                        }
                                        if inner_rt.name = "ref"
                                        {
                                            if inner_rt.generics <> null
                                            {
                                                let gens (*inner_rt.generics)
                                                if gens.length > 0
                                                {
                                                    let g0 gens.get 0
                                                    if g0 <> null
                                                        set inner_rt: (*g0)
                                                }
                                            }
                                        }
                                        if inner_rt.name = "pointer"
                                        {
                                            if inner_rt.generics <> null
                                            {
                                                let gens (*inner_rt.generics)
                                                if gens.length > 0
                                                {
                                                    let g0 gens.get 0
                                                    if g0 <> null
                                                        set inner_rt: (*g0)
                                                }
                                            }
                                        }
                                        var inner_struct map_type(inner_rt)
                                        if LLVMGetTypeKind(inner_struct) <> LLVMTypeKind.Struct()
                                            set inner_struct: synthesize_literal_struct(inner_rt.name)
                                        if inner_struct.handle <> null
                                        {
                                            if LLVMGetTypeKind(inner_struct) = LLVMTypeKind.Struct()
                                            {
                                                let ptr_type LLVMPointerTypeInContext(context, 0)
                                                let loaded LLVMBuildLoad2(builder, ptr_type, current_ptr, "field.deref")
                                                set current_ptr: loaded
                                                set current_type: inner_struct
                                            }
                                        }
                                    }
                            }
                        }
                    }
                    set i: i + 1
                }
            }

            current_ptr
        }

        ; Helper for member field assignment
        function emit_member_assignment(this, var_ptr: LLVMValueRef, planned_var: PlannedVariable, members: ref[Vector[PlannedMemberAccess]]?, value: LLVMValueRef) returns LLVMValueRef
        {
            var stored_value value
            let current_ptr emit_member_address(var_ptr, planned_var, members)

            ; Mirrors stage-0 Emitter.cpp:2062-2064: when stored_value is a
            ; pointer but the final field is a struct, load the struct value
            ; from the pointer first. Without this, init# results (heap ptrs)
            ; assigned to struct fields stomp the field's first 8 bytes
            ; instead of writing the struct value.
            if members <> null
            {
                let chain_ref members
                let chain (*chain_ref)
                let n chain.length
                if n > 0
                {
                    let last_ptr chain.get(n - 1)
                    if last_ptr <> null
                    {
                        let last_member last_ptr.unwrap()
                        let last_rt last_member.result_type
                        let field_type map_type last_rt
                        if field_type.handle <> null
                        {
                            let value_kind LLVMGetTypeKind(LLVMTypeOf stored_value)
                            let field_kind LLVMGetTypeKind(field_type)
                            if value_kind = LLVMTypeKind.Pointer() & field_kind = LLVMTypeKind.Struct()
                            {
                                set stored_value: LLVMBuildLoad2(builder, field_type, stored_value, "field.load")
                            }
                        }
                    }
                }
            }

            ; Store the value to the final field
            LLVMBuildStore(builder, stored_value, current_ptr)
            stored_value
        }

        ; Emit a binding (let/var declaration)
        function emit_binding(this, binding: PlannedBinding) returns bool
        {
            var value LLVMValueRef(null)

            ; Emit initialization expression if present
            if binding.operation <> null
            {
                if binding.operation.length > 0
                {
                    set value: emit_operands(binding.operation)
                    if value.handle = null
                        return false

                }
            }

            ; A float-annotated binding whose initializer evaluated at the other
            ; FP width (`var x: float <f64 expr>`): convert the VALUE to the
            ; annotated width up front so alloca/store and every later load
            ; agree on the slot type. Literal inits are already retyped by the
            ; planner; this catches computed initializers.
            if value.handle <> null
                if binding.binding_item.item_type <> null
                {
                    let fit_ref binding.binding_item.item_type
                    let fit_mapped map_type((*fit_ref))
                    if fit_mapped.handle <> null
                    {
                        let fit_kind LLVMGetTypeKind(fit_mapped)
                        let val_kind LLVMGetTypeKind(LLVMTypeOf value)
                        if fit_kind = LLVMTypeKind.Float()
                            if val_kind = LLVMTypeKind.Double()
                                set value: LLVMBuildFPTrunc(builder, value, fit_mapped, "bind.fptrunc")
                        if fit_kind = LLVMTypeKind.Double()
                            if val_kind = LLVMTypeKind.Float()
                                set value: LLVMBuildFPExt(builder, value, fit_mapped, "bind.fpext")
                        ; s201: an integer-annotated binding whose initializer
                        ; evaluated WIDER (`var n: u16 0` — the literal `0` is
                        ; i64) must truncate the VALUE to the annotated width so
                        ; the alloca (typed from the value below), every load, and
                        ; every `set n: ...` store agree. Without it the alloca is
                        ; i64 while reads are i16 and increments store 8 bytes —
                        ; Partition.resplit's n_new/n_classes desynced. scaly/
                        ; scalyc have no narrow-int var with a wider (literal)
                        ; initializer (their narrow vars init from casts/derefs),
                        ; so this is cycle-neutral for the self-compile.
                        if fit_kind = LLVMTypeKind.Integer()
                            if val_kind = LLVMTypeKind.Integer()
                            {
                                let bind_dbits LLVMGetIntTypeWidth(fit_mapped)
                                let bind_sbits LLVMGetIntTypeWidth(LLVMTypeOf value)
                                if bind_sbits > bind_dbits
                                    set value: LLVMBuildTrunc(builder, value, fit_mapped, "bind.trunc")
                            }
                    }
                }

            ; Create alloca for the binding
            if binding.binding_item.name <> null
            {
                let name_ref binding.binding_item.name
                let name (*name_ref)
                if value.handle <> null
                {
                    ; Get the type from the value
                    let ty LLVMTypeOf(value)

                    if binding.binding_type = "var"
                    {
                        ; s174: a struct value held through a pointer (sret
                        ; call result, by-ptr param) must be COPIED into a
                        ; struct-typed alloca — alloca'ing the raw ptr makes
                        ; a ptr slot that later field GEPs (emitted against
                        ; the struct layout) read as if it were the struct
                        ; itself, yielding garbage (plan_type's after_subst
                        ; crash). Region-allocated bindings (var s String^rp)
                        ; keep the ptr slot: their planned type is pointer[T]
                        ; (s27), so map_type yields ptr, not a struct.
                        var store_ty ty
                        var store_val value
                        ; s176: unannotated `var X sret_call_result` has no
                        ; item_type, so the s174 copy never fired — the slot
                        ; stayed alloca-ptr while `set X: ...` later stored a
                        ; raw struct into it, and the deref-on-read loaded
                        ; through the struct's first word (emit_function_body
                        ; `var to_store result` → LLVMGetTypeKind on garbage).
                        ; Fall back to the collapsed initializer operand's
                        ; result_type for the same struct-copy decision.
                        var mapped LLVMTypeRef(null)
                        if binding.binding_item.item_type <> null
                        {
                            let bind_ty_ref binding.binding_item.item_type
                            set mapped: map_type((*bind_ty_ref))
                        }
                        if binding.binding_item.item_type = null
                        {
                            if binding.operation <> null
                            {
                                let ops_ref binding.operation
                                let ops (*ops_ref)
                                if ops.length > 0
                                {
                                    let op0_ptr ops.get 0
                                    if op0_ptr <> null
                                    {
                                        ; Restrict to plain variable references
                                        ; (`var X some_let`): only those alias
                                        ; existing storage. Ctor/call results —
                                        ; especially region-allocated `T()` —
                                        ; must keep their ptr slots (copying
                                        ; snapshots the container header; the
                                        ; next .add then corrupts the page
                                        ; chain — parser keyword-init crash).
                                        let op0 (*op0_ptr)
                                        choose op0.expr
                                            when pv: PlannedVariable
                                                set mapped: map_type(op0.result_type)
                                            else
                                                0
                                    }
                                }
                            }
                        }
                        if mapped.handle <> null
                        {
                            if LLVMGetTypeKind(mapped) = LLVMTypeKind.Struct()
                            {
                                ; Opaque structs (fresh type vars, un-
                                ; instantiated generics) have no body —
                                ; loading through them is UB. Element
                                ; count 0 covers both opaque and empty.
                                if LLVMCountStructElementTypes(mapped) > 0
                                {
                                    if LLVMGetTypeKind(ty) = LLVMTypeKind.Pointer()
                                    {
                                        set store_ty: mapped
                                        set store_val: LLVMBuildLoad2(builder, mapped, value, "binding.load")
                                    }
                                }
                            }
                        }
                        ; Mutable binding: allocate on stack. s178: pooled —
                        ; the slot returns to the free pool when the binding
                        ; dies at exit_scope and nothing else references it.
                        let alloca acquire_temp(store_ty, name.c_data())
                        copy_struct_value(alloca, store_val, store_ty)
                        define_variable(name, alloca)

                        ; -g: declare this mutable local for the debugger so
                        ; `frame variable` / the Variables pane shows it. Scalar
                        ; integers/bool get a basic DIType inline (the scalar path
                        ; below is byte-identical to before); structs/unions/
                        ; pointers derive their DIType from the binding's planned
                        ; type via di_type_for (s.34-safe: PlannedType is multi-
                        ; field; only the alloca stays inline as an LLVMValueRef).
                        if config.emit_debug_info
                        {
                            let dpos compute_debug_pos binding.loc.start
                            var dty LLVMMetadataRef(null)
                            if LLVMGetTypeKind(store_ty) = LLVMTypeKind.Integer()
                            {
                                let width LLVMGetIntTypeWidth(store_ty)
                                var enc: i32 5; DW_ATE_signed
                                var dbits (width as size_t)
                                var tyname "int"
                                if width = 1
                                {
                                    set enc: 2       ; DW_ATE_boolean
                                    set dbits: 8
                                    set tyname: "bool"
                                }
                                set dty: LLVMDIBuilderCreateBasicType(di_builder, tyname.c_data(), tyname.get_length(), dbits, enc, 0)
                            }
                            ; aggregates / pointers: resolve from the planned type
                            ; (annotated item_type first, else the initializer's
                            ; collapsed result_type).
                            if dty.handle = null
                            {
                                if binding.binding_item.item_type <> null
                                {
                                    let it_ref binding.binding_item.item_type
                                    set dty: di_type_for((*it_ref))
                                }
                                if binding.binding_item.item_type = null
                                    if binding.operation <> null
                                    {
                                        let ops_ref binding.operation
                                        let ops (*ops_ref)
                                        if ops.length > 0
                                        {
                                            let op0_ptr ops.get 0
                                            if op0_ptr <> null
                                                set dty: di_type_for((*op0_ptr).result_type)
                                        }
                                    }
                            }
                            ; ★A REGION-ALLOCATED `var` keeps a POINTER slot (s27:
                            ; its planned type is pointer[T], so store_ty is `ptr`)
                            ; while the DIType above is the OBJECT — so the declare
                            ; needs DW_OP_deref, exactly as debug_declare_value's
                            ; indirect case does. Without it the debugger reads the
                            ; slot holding the pointer AS the object: measured
                            ; 2026-08-11, `var items Vector[int](3)` reported
                            ; length = 1073741824 and a nonsense data pointer. Only
                            ; ever visible once a DIType resolves at all, which for
                            ; String and friends it did not until today.
                            var var_indirect: bool false
                            if LLVMGetTypeKind(store_ty) = LLVMTypeKind.Pointer()
                            {
                                if binding.binding_item.item_type <> null
                                {
                                    let vi_ref binding.binding_item.item_type
                                    set var_indirect: di_planned_type_is_composite((*vi_ref))
                                }
                                if binding.binding_item.item_type = null
                                    if binding.operation <> null
                                    {
                                        let vi_ops_ref binding.operation
                                        let vi_ops (*vi_ops_ref)
                                        if vi_ops.length > 0
                                        {
                                            let vi_op0 vi_ops.get 0
                                            if vi_op0 <> null
                                                set var_indirect: di_planned_type_is_composite((*vi_op0).result_type)
                                        }
                                    }
                            }
                            debug_declare_at(name, alloca, dty, dpos, 0, var_indirect)
                        }
                    }
                    else
                    {
                        ; Immutable binding: just use the value directly
                        define_variable(name, value)

                        ; -g: a `let` owns no slot, so debug_declare_value gives it
                        ; a shadow. Same type resolution as the `var` path above:
                        ; the annotated item_type first, else the collapsed
                        ; initializer's result_type.
                        if config.emit_debug_info
                        {
                            let ldpos compute_debug_pos binding.loc.start
                            if binding.binding_item.item_type <> null
                            {
                                let lit_ref binding.binding_item.item_type
                                debug_declare_value(name, value, (*lit_ref), ldpos, 0)
                            }
                            if binding.binding_item.item_type = null
                                if binding.operation <> null
                                {
                                    let lops_ref binding.operation
                                    let lops (*lops_ref)
                                    if lops.length > 0
                                    {
                                        let lop0_ptr lops.get 0
                                        if lop0_ptr <> null
                                            debug_declare_value(name, value, (*lop0_ptr).result_type, ldpos, 0)
                                    }
                                }
                        }
                    }
                }
                else
                {
                    ; No initialization - check for type annotation
                    if binding.binding_item.item_type <> null
                    {
                        let item_type_ref binding.binding_item.item_type
                        let item_type (*item_type_ref)

                        ; s192: fixed-size stack array — the planner rewrites
                        ; `T[N]` (T primitive) to pointer[T] with a numeric
                        ; array_size. Allocate `[N x T]`, then store a decayed
                        ; first-element pointer in a ptr slot so `*(buf + i)`
                        ; works. Mirrors stage-0 Emitter.cpp:2401-2418. The
                        ; backing array uses entry_alloca (a stable entry-block
                        ; slot), NOT the statement-scoped temp pool — the buffer
                        ; outlives the declaring statement.
                        var arr_count: size_t 0
                        if item_type.name = "pointer"
                        {
                            if item_type.array_size.get_length() > 0
                                set arr_count: Emitter.parse_array_size(item_type.array_size)
                        }
                        if arr_count > 0
                        {
                            var elem_ty LLVMTypeRef(null)
                            if item_type.generics <> null
                            {
                                let egens (*item_type.generics)
                                if egens.length > 0
                                {
                                    let e_ptr egens.get 0
                                    if e_ptr <> null
                                        set elem_ty: map_type((*e_ptr))
                                }
                            }
                            if elem_ty.handle <> null
                            {
                                let arr_ty LLVMArrayType2(elem_ty, arr_count)
                                let arr_alloca entry_alloca(arr_ty, name.c_data())
                                let i64_type LLVMInt64TypeInContext(context)
                                let zero LLVMConstInt(i64_type, 0, 0)
                                var indices Vector[LLVMValueRef](2)
                                indices.put(0, zero)
                                indices.put(1, zero)
                                let first_elem LLVMBuildInBoundsGEP2(
                                    builder, arr_ty, arr_alloca, indices.data, 2, "arr.ptr")
                                let ptr_ty LLVMPointerTypeInContext(context, 0)
                                let ptr_slot entry_alloca(ptr_ty, name.c_data())
                                LLVMBuildStore(builder, first_elem, ptr_slot)
                                define_variable(name, ptr_slot)
                                return true
                            }
                        }

                        let ty map_type item_type
                        ; s178: pooled, same as the initialized var path.
                        let alloca acquire_temp(ty, name.c_data())
                        define_variable(name, alloca)
                    }
                    if binding.binding_item.item_type = null
                        return false  ; No init and no type annotation
                }
            }

            true
        }

        ; Emit a return statement
        function emit_return(this, ret: PlannedReturn) returns bool
        {
            ; TCO: `return f(args)` inside f is a jump to the loop header, not a
            ; call. Tested before anything is evaluated — when the shape does not
            ; match, this has emitted nothing and the normal path below runs.
            if emit_self_tail_jump(ret)
                return true

            ; Evaluate return value first (before cleanup)
            var ret_val LLVMValueRef(null)
            if ret.result <> null
            {
                if ret.result.length > 0
                    set ret_val: emit_operands(ret.result)

            }

            ; s196: release the function-local root page before returning
            ; (no-op when none was allocated). Replaces the old dead cleanup
            ; that read the never-set current_region.local_page and used free()
            ; instead of scaly_release_root_page.
            emit_release_local_page()

            ; Create the return instruction. Querying the function's
            ; actual LLVM return type guards against the case where
            ; ret_val is null (sub-emit fell through) but the function's
            ; signature is non-void — e.g. `return some_unplanned_call()`
            ; in `function f() returns pointer[Page]` would otherwise
            ; emit `ret void` and produce IR rejected by llc / IRTranslator.
            let func_ty LLVMGlobalGetValueType(current_function)
            let llvm_rt LLVMGetReturnType(func_ty)
            let void_ty LLVMVoidTypeInContext(context)
            ; s89: sret functions emit `store ret_val, %sret; ret void`.
            ; Detect by querying the function's first-param sret attribute.
            ; If ret_val is a pointer to the struct, load via the sret type
            ; attribute's element type (the canonical sret slot type) before
            ; storing.
            let sret_attr LLVMGetEnumAttributeAtIndex(current_function, 1, sret_kind_id())
            if sret_attr.handle <> null
            {
                let sret_ptr LLVMGetParam(current_function, 0)
                ; s149: throws function path — sret_ty is the Result wrapper
                ; `{i8 status, [N x i8] data}`. Store 0 at field 0 (Success),
                ; raw bytes of ret_val at field 1.
                if current_function_can_throw
                {
                    let result_sty LLVMGetTypeAttributeValue(sret_attr)
                    let i8_ty_ret LLVMInt8TypeInContext(context)
                    let tag_ptr LLVMBuildStructGEP2(builder, result_sty, sret_ptr, 0, "ret.tag.ptr")
                    LLVMBuildStore(builder, LLVMConstInt(i8_ty_ret, 0, 0), tag_ptr)
                    let data_ptr LLVMBuildStructGEP2(builder, result_sty, sret_ptr, 1, "ret.data.ptr")
                    ; s150: data_ptr lives at byte offset 1 of the Result wrapper
                    ; (which has struct-alignment 1), so any natural-aligned T
                    ; load/store at this address is misaligned. Mark the store
                    ; align 1 so LLVM doesn't lower it to an aligned sequence.
                    ; Mirrors stage-0 emitReturn's CreateAlignedStore(..., Align 1).
                    if ret_val.handle <> null
                    {
                        ; s178: memcpy when ret_val is a load — the helper
                        ; marks fallback stores align 1 (s150).
                        let rv_ty LLVMTypeOf(ret_val)
                        copy_struct_value(data_ptr, ret_val, rv_ty)
                    }
                    LLVMBuildRetVoid builder
                    return true
                }
                if ret_val.handle <> null
                {
                    var to_store ret_val
                    if LLVMGetTypeKind(LLVMTypeOf ret_val) = LLVMTypeKind.Pointer()
                    {
                        let sty LLVMGetTypeAttributeValue(sret_attr)
                        if LLVMGetTypeKind(sty) = LLVMTypeKind.Struct()
                            set to_store: LLVMBuildLoad2(builder, sty, ret_val, "sret.body")
                    }
                    if LLVMGetTypeKind(LLVMTypeOf to_store) = LLVMTypeKind.Struct()
                    {
                        ; s178: memcpy when to_store is a load.
                        let ts_ty2 LLVMTypeOf(to_store)
                        copy_struct_value(sret_ptr, to_store, ts_ty2)
                    }
                }
                ; When emit_operands(ret.result) returns null (sub-emit dropped
                ; statements — happens with multi-statement when-bodies that
                ; reference union-variant member chains, e.g. parse_identifier's
                ; `return name` where `let name String^this(ident.name.get_buffer(),
                ; ident.name.length)` failed to emit), the sret slot is left
                ; uninitialized. Caller reads garbage — for String that's a
                ; non-null data pointer with huge length, so length() = 0 checks
                ; in parse_extension don't fire and the parser loops forever.
                ; Zero-initialize the sret slot so caller reads a well-defined
                ; empty value (String { data: null } = length 0) and downstream
                ; "is this empty?" checks work.
                if ret_val.handle = null
                {
                    let sty LLVMGetTypeAttributeValue(sret_attr)
                    if sty.handle <> null
                    {
                        if LLVMGetTypeKind(sty) = LLVMTypeKind.Struct()
                        {
                            let zero_struct LLVMConstNull(sty)
                            LLVMBuildStore(builder, zero_struct, sret_ptr)
                        }
                    }
                }
                LLVMBuildRetVoid builder
                return true
            }
            if LLVMGetTypeKind(llvm_rt) = LLVMGetTypeKind(void_ty)
                LLVMBuildRetVoid builder
            else
            {
                if ret_val.handle <> null
                {
                    ; Struct-by-value return: load the struct value when
                    ; ret_val is an alloca pointer but the function's LLVM
                    ; return type is a struct. See emit_function_body for
                    ; rationale.
                    var final_val ret_val
                    if LLVMGetTypeKind(llvm_rt) = LLVMTypeKind.Struct()
                    {
                        if LLVMGetTypeKind(LLVMTypeOf ret_val) = LLVMTypeKind.Pointer()
                            set final_val: LLVMBuildLoad2(builder, llvm_rt, ret_val, "ret.load")
                    }
                    ; s201: value-side integer promotion for an explicit `return`
                    ; (mirrors the emit_function_body fix). A wider integer return
                    ; value (a negative literal like `return -1` in an i32 fn) must
                    ; be TRUNCATED to the return type, not dropped — the old bail
                    ; left the block unsealed (→ Unreachable, garbage return).
                    if LLVMTypeOf(final_val).handle <> llvm_rt.handle
                        if LLVMGetTypeKind(LLVMTypeOf final_val) = LLVMTypeKind.Integer()
                            if LLVMGetTypeKind(llvm_rt) = LLVMTypeKind.Integer()
                                if LLVMGetIntTypeWidth(LLVMTypeOf final_val) > LLVMGetIntTypeWidth(llvm_rt)
                                    set final_val: LLVMBuildTrunc(builder, final_val, llvm_rt, "ret.trunc")
                    ; Defensive: bail on any remaining mismatch (block-seal-with-
                    ; Unreachable in emit_function_body covers the unsealed block).
                    if LLVMTypeOf(final_val).handle <> llvm_rt.handle
                        return true
                    LLVMBuildRet(builder, final_val)
                }
                else
                    LLVMBuildRet(builder, LLVMConstNull llvm_rt)
            }

            true
        }

        ; Emit a throw statement
        function emit_throw(this, throw_stmt: PlannedThrow) returns bool
        {
            ; Throw creates an error Result and returns it
            ; Result layout: { i8 tag, [size x i8] data }
            ; Tag 0 = Ok, Tag 1+ = error variants

            if current_function.handle = null
                return false

            ; Two return shapes:
            ; (a) sret: function's first param has the sret attribute and the
            ;     LLVM return type is void. The Result is written to the
            ;     sret slot and the function returns void. Stage-1 was
            ;     bailing on this case (`ret_ty <> Struct → return false`),
            ;     which left guard-bodies empty: `if X throw Y` emitted
            ;     `if X { br end }` instead of `if X { store result; ret void }`.
            ;     Parser.parse_extension then fell through to parse_identifier
            ;     even when no `.` punctuation was present, returning Success
            ;     forever and infinite-looping parse_extension_list.
            ; (b) Direct return: the function's LLVM return type is the
            ;     Result struct itself. Allocate locally, store, ret.
            let func_ty LLVMGlobalGetValueType(current_function)
            let ret_ty LLVMGetReturnType(func_ty)
            let sret_attr LLVMGetEnumAttributeAtIndex(current_function, 1, sret_kind_id())

            var result_ptr LLVMValueRef(null)
            var result_ty LLVMTypeRef(null)
            var is_sret: bool false
            if sret_attr.handle <> null
            {
                let sty LLVMGetTypeAttributeValue(sret_attr)
                if sty.handle <> null
                {
                    if LLVMGetTypeKind(sty) = LLVMTypeKind.Struct()
                    {
                        set is_sret: true
                        set result_ptr: LLVMGetParam(current_function, 0)
                        set result_ty: sty
                    }
                }
            }
            if is_sret = false
            {
                ; s143: function returns by value (not sret). Two sub-cases:
                ; (a) Struct-by-value return: alloca a Result-like slot, store
                ;     tag=1, load, ret value. Same as before.
                ; (b) Primitive/pointer return: there's no place to write the
                ;     tag and stage-1 doesn't model the Result wrap yet. Emit
                ;     `ret <zero>` so the function unwinds instead of falling
                ;     through to garbage. For ptr-returning throws functions
                ;     (parse_declaration_list, parse_member_list, etc.), the
                ;     caller's NPO-style choose treats null as the error case
                ;     and dispatches accordingly. Without this, emit_throw was
                ;     bailing silently — the case body was empty, the choose
                ;     fell back to %choose.end → while.cond → re-enter forever.
                if LLVMGetTypeKind(ret_ty) <> LLVMTypeKind.Struct()
                {
                    ; Evaluate the thrown value purely for its side effects
                    ; (constructor calls on the exception page etc.); we
                    ; can't store it anywhere here.
                    if throw_stmt.result <> null
                    {
                        if throw_stmt.result.length > 0
                            emit_operands throw_stmt.result
                    }
                    ; s196: release the function-local root page on the throw path.
                    emit_release_local_page()
                    let void_ty LLVMVoidTypeInContext(context)
                    if LLVMGetTypeKind(ret_ty) = LLVMGetTypeKind(void_ty)
                        LLVMBuildRetVoid builder
                    else
                        LLVMBuildRet(builder, LLVMConstNull ret_ty)
                    return true
                }
                set result_ty: ret_ty
                set result_ptr: entry_alloca(result_ty, "throw.result")
            }

            ; Set the tag to 1 (first error variant)
            let i8_ty LLVMInt8TypeInContext(context)
            let tag_ptr LLVMBuildStructGEP2(builder, result_ty, result_ptr, 0, "throw.tag.ptr")
            let tag_val LLVMConstInt(i8_ty, 1, 0)
            LLVMBuildStore(builder, tag_val, tag_ptr)

            ; Evaluate the thrown value and store in the data portion
            if throw_stmt.result <> null
            {
                if throw_stmt.result.length > 0
                {
                    let thrown_value emit_operands throw_stmt.result
                    if thrown_value.handle <> null
                    {
                        ; Get pointer to the data field (field 1).
                        ; Stage-0 stores a pointer to the error object; here
                        ; we just store whatever emit_operands produced — if
                        ; the planner gave us a struct value, store it; if a
                        ; pointer, store the pointer. Mirror the stage-0
                        ; emitThrow data-handling at Emitter.cpp:2697+.
                        var n_fields: int 0
                        if LLVMGetTypeKind(result_ty) = LLVMTypeKind.Struct()
                            set n_fields: LLVMCountStructElementTypes(result_ty)
                        if n_fields >= 2
                        {
                            let data_ptr LLVMBuildStructGEP2(builder, result_ty, result_ptr, 1, "throw.data.ptr")
                            ; s150: Result wrapper has struct-align 1; store at
                            ; byte offset 1 is misaligned for natural-aligned T.
                            let store_inst LLVMBuildStore(builder, thrown_value, data_ptr)
                            LLVMSetAlignment(store_inst, 1)
                        }
                    }
                }
            }

            ; s196: release the function-local root page before unwinding.
            emit_release_local_page()

            ; Return: sret functions return void, direct-return functions
            ; load+ret the result value.
            if is_sret
                LLVMBuildRetVoid builder
            if is_sret = false
            {
                let result LLVMBuildLoad2(builder, result_ty, result_ptr, "throw.val")
                LLVMBuildRet(builder, result)
            }

            true
        }

        ; Emit a break statement
        function emit_break(this, brk: PlannedBreak) returns bool
        {
            ; Resolve the target loop (labeled → matching loop, else innermost)
            let loop_ctx this.find_loop_context(brk.loop_label)
            if loop_ctx = null
                return false

            ; break-with-value: evaluate the value and store it into the target
            ; loop's result slot (only repeat loops allocate one). Done before
            ; cleanups, mirroring emit_return's evaluate-then-cleanup order.
            if loop_ctx.result_slot.handle <> null
                if brk.result <> null
                    if brk.result.length > 0
                    {
                        let break_value emit_operands(brk.result)
                        if break_value.handle <> null
                        {
                            ; Struct-by-value break: when the operand is a pointer to
                            ; the value (a promoted heap construction bound to a local,
                            ; e.g. `break v` where v owns a Vector on the caller page)
                            ; and the result slot holds the struct itself, LOAD the
                            ; struct value first — otherwise the raw POINTER is stored
                            ; into the value slot and the repeat.value load reads
                            ; {pointer, garbage} instead of the value. Mirrors
                            ; emit_return's struct-by-value load.
                            var to_store break_value
                            let slot_ty LLVMGetAllocatedType(loop_ctx.result_slot)
                            if LLVMGetTypeKind(slot_ty) = LLVMTypeKind.Struct()
                                if LLVMGetTypeKind(LLVMTypeOf break_value) = LLVMTypeKind.Pointer()
                                    set to_store: LLVMBuildLoad2(builder, slot_ty, break_value, "break.load")
                            LLVMBuildStore(builder, to_store, loop_ctx.result_slot)
                        }
                    }

            ; Jump to the exit block of the target loop
            LLVMBuildBr(builder, loop_ctx.exit_block)

            true
        }

        ; Emit a continue statement
        function emit_continue(this, cont: PlannedContinue) returns bool
        {
            ; Resolve the target loop (labeled → matching loop, else innermost)
            let loop_ctx this.find_loop_context(cont.loop_label)
            if loop_ctx = null
                return false

            ; Jump to the continue block of the target loop
            LLVMBuildBr(builder, loop_ctx.continue_block)

            true
        }

        ; ========================================================================
        ; Loop Stack Management
        ; ========================================================================

        ; Push a loop context onto the stack
        procedure push_loop(this, exit_block: LLVMBasicBlockRef, continue_block: LLVMBasicBlockRef, loop_label: String, result_slot: LLVMValueRef)
        {
            let ctx LoopContext(exit_block, continue_block, loop_label, result_slot)
            loop_stack.add ctx
        }

        ; Resolve the loop a break/continue targets. An empty loop_label means the
        ; innermost loop (top of stack); a non-empty loop_label scans from innermost
        ; outward for the matching loop. Returns null when no match is found.
        function find_loop_context(this, loop_label: String) returns ref[LoopContext]?
        {
            if loop_stack.length = 0
                return null
            if loop_label.get_length() = 0
                return loop_stack.get(loop_stack.length - 1)
            var i loop_stack.length
            while i > 0
            {
                let ctx_ptr loop_stack.get(i - 1)
                if ctx_ptr <> null
                {
                    if ctx_ptr.loop_label = loop_label
                        return ctx_ptr
                }
                set i: i - 1
            }
            null
        }

        ; Pop a loop context from the stack
        procedure pop_loop(this)
        {
            if loop_stack.length > 0
                set loop_stack.length: loop_stack.length - 1
        }
    }

    ; ============================================================================
    ; Test function
    ; ============================================================================

    function test() returns int
    {
        ; Test EmitterConfig initialization
        let config EmitterConfig()
        if config.emit_debug_info = false
            return 1

        if config.opt_level <> 0
            return 2

        ; Test RegionInfo
        let region RegionInfo()
        if region.local_page.handle <> null
            return 3

        ; ========================================================================
        ; End-to-End Test: Parse → Model → Plan → Emit (error codes 100+)
        ; ========================================================================

        ; Test 100: End-to-end compilation of simple integer expression
        var parser Parser("42")
        choose parser.parse_program()
            when err: Error
                return 100
            when syntax: Success
            {
                ; Model the parsed program
                let program Modeler.build_program("test.scaly", "test", syntax, true)

                ; Plan the program
                var planner Planner("test.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 101

                ; Emit the plan
                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test_module")
                if emit_result = false
                    return 102

                ; Verify module was created
                if emitter.llvm_module.handle = null
                    return 103

                ; Get module IR string to verify it's not empty
                let ir emitter.print_module_to_string()
                if ir = null
                    return 104

            }

        ; Test 110: End-to-end with function definition
        set parser: Parser("function answer() returns int\n    42")
        choose parser.parse_program()
            when err: Error
                return 110
            when syntax: Success
            {
                let program Modeler.build_program("test2.scaly", "test2", syntax, true)
                var planner Planner("test2.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 111

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test2_module")
                if emit_result = false
                    return 112

                ; Verify the function was emitted. Bind module and name to
                ; locals first: the `emitter.llvm_module` member-access arg +
                ; `String(...).c_data()` ctor-chain arg shape is unresolvable
                ; by stage-1's planner and the call silently dropped (s185).
                let test_mod emitter.llvm_module
                var answer_name "_Z6answerv"
                let answer_fn LLVMGetNamedFunction(test_mod, answer_name.c_data())
                if answer_fn.handle = null
                    return 113

            }

        ; Test 120: End-to-end with struct definition
        set parser: Parser("define Point(x: int, y: int)")
        choose parser.parse_program()
            when err: Error
                return 120
            when syntax: Success
            {
                let program Modeler.build_program("test3.scaly", "test3", syntax, true)
                var planner Planner("test3.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 121

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test3_module")
                if emit_result = false
                    return 122

            }

        ; Test 130: End-to-end with if expression
        set parser: Parser("if true\n    1\nelse\n    0")
        choose parser.parse_program()
            when err: Error
                return 130
            when syntax: Success
            {
                let program Modeler.build_program("test4.scaly", "test4", syntax, true)
                var planner Planner("test4.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 131

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test4_module")
                if emit_result = false
                    return 132

            }

        ; Test 140: End-to-end with let binding and arithmetic
        set parser: Parser("let x 10\nlet y 20\nlet sum x + y")
        choose parser.parse_program()
            when err: Error
                return 140
            when syntax: Success
            {
                let program Modeler.build_program("test5.scaly", "test5", syntax, true)
                var planner Planner("test5.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 141

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test5_module")
                if emit_result = false
                    return 142

            }

        ; Test 150: End-to-end with while loop
        set parser: Parser("var i: int 0\nwhile i < 10\n    set i: i + 1")
        choose parser.parse_program()
            when err: Error
                return 150
            when syntax: Success
            {
                let program Modeler.build_program("test6.scaly", "test6", syntax, true)
                var planner Planner("test6.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 151

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test6_module")
                if emit_result = false
                    return 152

            }

        ; Test 160: End-to-end with function call
        set parser: Parser("function double(x: int) returns int\n    x * 2\n\nlet result double(21)")
        choose parser.parse_program()
            when err: Error
                return 160
            when syntax: Success
            {
                let program Modeler.build_program("test7.scaly", "test7", syntax, true)
                var planner Planner("test7.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 161

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test7_module")
                if emit_result = false
                    return 162

                ; Verify double function was emitted
                ; Locals-first call shape — same s185 rationale as test 110.
                let test_mod2 emitter.llvm_module
                var double_name "_Z6doublei"
                let double_fn LLVMGetNamedFunction(test_mod2, double_name.c_data())
                if double_fn.handle = null
                    return 163

            }

        ; Test 170: End-to-end with union definition
        set parser: Parser("define Option union(Some: int, None)")
        choose parser.parse_program()
            when err: Error
                return 170
            when syntax: Success
            {
                let program Modeler.build_program("test8.scaly", "test8", syntax, true)
                var planner Planner("test8.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 171

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test8_module")
                if emit_result = false
                    return 172

            }

        ; Test 180: End-to-end with union variant construction
        set parser: Parser("define Option union(Some: int, None)\nlet opt Option.Some(42)")
        choose parser.parse_program()
            when err: Error
                return 180
            when syntax: Success
            {
                let program Modeler.build_program("test9.scaly", "test9", syntax, true)
                var planner Planner("test9.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 181

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test9_module")
                if emit_result = false
                    return 182

            }

        ; Test 190: End-to-end with choose/when pattern matching
        set parser: Parser("define Option union(Some: int, None)\nfunction unwrap(opt: Option) returns int\n    choose opt\n        when v: Some\n            v\n        else\n            0")
        choose parser.parse_program()
            when err: Error
                return 190
            when syntax: Success
            {
                let program Modeler.build_program("test10.scaly", "test10", syntax, true)
                var planner Planner("test10.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 191

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test10_module")
                if emit_result = false
                    return 192

                ; Verify unwrap function was emitted
                ; Locals-first call shape — same s185 rationale as test 110.
                let test_mod3 emitter.llvm_module
                var unwrap_name "_Z6unwrap6Option"
                let unwrap_fn LLVMGetNamedFunction(test_mod3, unwrap_name.c_data())
                if unwrap_fn.handle = null
                    return 193

            }

        ; Test 200: End-to-end with generic type
        set parser: Parser("define Box[T](value: T)\nlet b Box[int](42)")
        choose parser.parse_program()
            when err: Error
                return 200
            when syntax: Success
            {
                let program Modeler.build_program("test11.scaly", "test11", syntax, true)
                var planner Planner("test11.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 201

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test11_module")
                if emit_result = false
                    return 202

            }

        ; Test 210: Complex program with struct, method, and mutation
        ; This mimics lexer-like code patterns
        set parser: Parser("define Scanner(text: pointer[char], pos: int)\n{\n    function current_char(this) returns char\n        *(text + pos)\n    procedure advance#(this)\n        set pos: pos + 1\n}\nvar lex Scanner(\"test\", 0)\nlet ch lex.current_char()")
        choose parser.parse_program()
            when err: Error
                return 210
            when syntax: Success
            {
                let program Modeler.build_program("test12.scaly", "test12", syntax, true)
                var planner Planner("test12.scaly")
                let plan planner.plan_program program
                if plan = null
                    return 211

                let emitter_config EmitterConfig()
                var emitter Emitter(emitter_config)
                let emit_result emitter.emit(plan, "test12_module")
                if emit_result = false
                    return 212

            }

        0
    }
}

