                optional := OptionalSyntax(success.start, success.end)

        let lifetime_start lexer.position
        var lifetime: ref[LifetimeSyntax]? null
        choose parse_lifetime()
            when err: Error
            {
                choose err
                    when d: Different {}
                    when i: Invalid
                        throw ParserError.Invalid(i)
            }
            when success: Success
                lifetime := LifetimeSyntax(success)

        let end lexer.position

        TypeSyntax(start, end, name, generics, optional, lifetime)
    }

    procedure parse_name(mutable this: Parser) returns NameSyntax throws ParserError
    {
        let start lexer.previous_position

        let name lexer.parse_identifier(keywords)
        if name.length() = 0
            throw ParserError.Different(DifferentSyntax())

        let extensions_start lexer.position
        var extensions: ref[Vector[ExtensionSyntax]]? null
        choose parse_extension_list()
            when err: Error
            {
                choose err
                    when d: Different {}
                    when i: Invalid
                        throw ParserError.Invalid(i)
            }
            when success: Success
                extensions := success

        let end lexer.position

        NameSyntax(start, end, name, extensions)
    }

    procedure parse_extension_list(mutable this: Parser) returns ref[Vector[ExtensionSyntax]]? throws ParserError
    {
        var acc List[ExtensionSyntax]()
        var parsing: bool true
        while parsing
        {
            choose parse_extension()
                when err: Error
                {
                    ; Different = no more items; stop the list (or rethrow if the
                    ; list is still empty, so the caller sees Different). Invalid =
                    ; an item committed then hit a real syntax error; propagate it
                    ; instead of silently truncating the list (e.g. a no-else if).
                    choose err
                        when i: Invalid
                            throw ParserError.Invalid(i)
                        when d: Different
                        {
                            if acc.head = null
                                throw err
                            parsing := false
                        }
                }
                when node: Success
                    acc.add(node)
        }
        Vector[ExtensionSyntax](acc)
    }

    procedure parse_extension(mutable this: Parser) returns ExtensionSyntax throws ParserError
    {
        let start lexer.previous_position

        if ~lexer.parse_punctuation(".")
            throw ParserError.Different(DifferentSyntax())

        let name lexer.parse_identifier(keywords)
        if name.length() = 0
            throw ParserError.Invalid(InvalidSyntax(start, lexer.position, "expected identifier"))

        let end lexer.position

        ExtensionSyntax(start, end, name)
    }

    procedure parse_lifetime(mutable this: Parser) returns LifetimeSyntax throws ParserError
    {
        choose parse_call()
            when err: Error
            {
                choose err
                    when i: Invalid
                        throw ParserError.Invalid(i)
                    when d: Different {}
            }
            when node: Success
                return LifetimeSyntax.Call(node)
        choose parse_reference()
            when err: Error
            {
                choose err
                    when i: Invalid
                        throw ParserError.Invalid(i)
                    when d: Different {}
            }
            when node: Success
                return LifetimeSyntax.Reference(node)
        choose parse_thrown()
            when err: Error
            {
                choose err
                    when i: Invalid
                        throw ParserError.Invalid(i)
                    when d: Different {}
            }
            when node: Success
                return LifetimeSyntax.Thrown(node)
        throw ParserError.Different(DifferentSyntax())
    }

    procedure parse_call(mutable this: Parser) returns CallSyntax throws ParserError
    {
        let start lexer.previous_position

        if ~lexer.parse_punctuation("#")
            throw ParserError.Different(DifferentSyntax())

        let end lexer.position

        CallSyntax(start, end)
    }

    procedure parse_reference(mutable this: Parser) returns ReferenceSyntax throws ParserError
    {
        let start lexer.previous_position

        if ~lexer.parse_punctuation("^")
            throw ParserError.Different(DifferentSyntax())

        let location lexer.parse_identifier(keywords)
        if location.length() = 0
            throw ParserError.Invalid(InvalidSyntax(start, lexer.position, "expected identifier"))

        let end lexer.position

        ReferenceSyntax(start, end, location)
    }

    procedure parse_thrown(mutable this: Parser) returns ThrownSyntax throws ParserError
    {
        let start lexer.previous_position

        if ~lexer.parse_punctuation("!")
            throw ParserError.Different(DifferentSyntax())

        let end lexer.position

        ThrownSyntax(start, end)
    }

    procedure parse_empty(mutable this: Parser) returns EmptySyntax throws ParserError
    {
        let start lexer.previous_position

        if ~lexer.parse_colon()
            throw ParserError.Different(DifferentSyntax())

        let end lexer.position

        EmptySyntax(start, end)
    }

    function is_at_end(this: Parser) returns bool
        lexer.is_at_end()
}

function test() returns int
{
    ; Test 1: Parse a simple literal
    var parser Parser("42")
    choose parser.parse_literal()
        when err: Error
            return 1
        when literal: Success
        {
            if ~parser.is_at_end()
                return 2
        }

    ; Test 2: Parse an identifier expression
    parser := Parser("foo")
    choose parser.parse_name()
        when err: Error
            return 3
        when name: Success
        {
            if ~parser.is_at_end()
                return 4
        }

    ; Test 3: Parse a function definition
    parser := Parser("function hello() returns int 42")
    choose parser.parse_function()
        when err: Error
            return 5
        when func: Success
        {
            if ~parser.is_at_end()
                return 6
        }

    ; Test 4: Parse a structure definition
    parser := Parser("define a ()")
    choose parser.parse_definition()
        when err: Error
            return 7
        when def: Success
        {
            if ~parser.is_at_end()
                return 8
        }

    ; Test 5: Parse a structure with properties
    parser := Parser("define Point (x: int, y: int)")
    choose parser.parse_definition()
        when err: Error
            return 9
        when def: Success
        {
            if ~parser.is_at_end()
                return 10
        }

    ; Test 6: Parse a union definition
    parser := Parser("define Option union (Some: int, None)")
    choose parser.parse_definition()
        when err: Error
            return 11
        when def: Success
        {
            if ~parser.is_at_end()
                return 12
        }

    0
}
}

