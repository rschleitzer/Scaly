; WriteCensus.scaly - the `--write-report` pass: which planned bodies WRITE
; through memory their PARAMETERS reach, and how. The measurement behind the
; question whether `function` can be made PURE by rule (R1): no store through
; a path that starts at a parameter, no allocation on a parameter's page. A
; `function` that does either today is listed; a `procedure` is only counted.
;
; WHAT IS A WRITE (one site each, `<class> <fn> writes <params> <detail>`):
;   w-field      `set p.f: v` -- a member store whose base reaches a parameter
;                (the implicit `set f: v` in a method is `this` + `.f`)
;   w-deref      `set *p: v` / `set *(p + i): v` -- a store through a pointer
;                (and every `set r: v` on a `ref`, which the planner rewrites
;                into the deref)
;   w-global     `set g: v` / `set g.f: v` on a module-level global
;   w-call       a call whose callee writes the parameter an argument fills --
;                TRANSITIVE: the callee's summary comes from the fixpoint below
;   w-extern     a pointer or reference handed to an `extern` (memcpy, ...):
;                what C does with it is not in the plan, so it counts
;   a-construct  a construction on a NAMED page that reaches a parameter
;                (`T^this(...)`, `T^host(...)`, the positional tuple with a
;                region) -- an allocation writes the page header
;   a-box        `&^p v` onto such a page
; The implicit caller page (`_rp`, or the peeled `rp`/`page` parameter) is the
; RESULT REGION and never a write: a pure function builds its answer there.
;
; ALIASING, conservatively. A local whose type is not a scalar inherits the
; parameters its initializer reaches (a field read, a deref, a cast, a call
; result -- a call is assumed to hand back something its arguments reach), and
; so do a `for` variable and a `when` binding. A scalar local reaches nothing.
; `if`/`choose` VALUES and lambdas are not followed: a local bound to one
; reaches nothing (under-approximation, named here so a zero is read with it).
;
; THE FIXPOINT. Each body's summary is a bit mask over its `input` (bit i =
; parameter i, `this` included; bit 62 = a parameter past the 62nd; bit 63 = a
; global). Calls read the callee's current summary, so the walk repeats until
; no summary grows. Only then are the sites recorded, in one last walk.
;
; Reuses PointerCensus for what that pass already knows: the body file of a
; lazily instantiated generic (`resolve_body_file`), the callee table
; (`fn_slots`) and the extern names of this root and its packages. Report
; strings live on this pass's page (`String^this`), the `--task-plan` idiom.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).

use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*
use scalyc.compiler.Planner.*
use scalyc.compiler.PointerCensus.PointerCensus
use scalyc.compiler.ConceptIndex.ConceptIndex
use scalyc.compiler.Interface.InterfaceFact
use scaly.os.File

define WC_GLOBAL u64 0x8000000000000000
; words of the per-body global set (1024 names; the last id is "unnamed")
define WC_GW: size_t 16
; apply_callee's slot when the caller has noted the callee's globals itself
define WC_NOTED: size_t 0xFFFFFFFF
define WC_OVERFLOW u64 0x4000000000000000
; the FROZEN mode's mark: the value reaches data of a frozen type
define WC_FROZEN u64 0x2000000000000000
; every parameter position: the 61 bits and WC_OVERFLOW, neither mark
define WC_PARAMS u64 0x5FFFFFFFFFFFFFFF

define WriteCensus
{
    define WriteCensus
    (
        report_files: Array[String]
        report_offsets: Array[size_t]
        report_texts: Array[String]

        var pc: ref[PointerCensus]?
        var plan_functions: ref[Vector[PlannedFunction]]?
        ; the plan's records, for a written FIELD's declaration (R2: `var`)
        var plan_structures: ref[Vector[PlannedStructure]]?
        ; field_is_var#'s lookup of a hop's record: the FIRST structure of a
        ; mangled name / of a plain name, entered once in analyze#. It scanned
        ; every planned structure per field store, per round -- and read two
        ; environment variables each time (let_probe holds SCALYC_LET_PROBE).
        var struct_by_mangled: ConceptIndex
        var struct_by_name: ConceptIndex
        var let_probe: bool
        ; R2: stores into a `let` field of an object that is already published
        var n_let_sites: size_t
        let_offsets: Array[size_t]
        let_texts: Array[String]
        let_fns: Array[size_t]
        ; check mode (phase 2): this body's stores into a `let` field of a
        ; published object -- reported after the walk, one error per body and
        ; a note per site, the way the parameter and global rules report
        var cur_let_bad: Array[String]
        var cur_let_offsets: Array[size_t]
        ; locals of the body walked whose ADDRESS was taken so far (`&x`), in
        ; program order: from there on the object is published (note_let_store#)
        var cur_addr_taken: Array[String]
        ; the file of the body being walked, for a let-site's line (a body's
        ; file is resolved for the report only; the walk knows func.file)
        var cur_file_hint: String
        ; per plan.functions index: the parameters the body writes through
        masks: Array[u64]

        ; the body walked: its input, its caller-page name, its summary so far
        var cur_input: ref[Vector[PlannedItem]]?
        var cur_page: String
        var cur_name: String
        var cur_pure: bool
        ; the RBMM substrate (scaly/memory/): its globals are the allocator's
        ; own state and are not propagated to every function that allocates
        var cur_substrate: bool
        var body_mask: u64
        var body_direct: bool
        var reporting: bool
        var current_file: String
        var loc_names: Array[String]
        var loc_masks: Array[u64]
        ; beside loc_masks: what the local IS (the object it names), without
        ; what a fresh object it names merely HOLDS (see is_of)
        var loc_is: Array[u64]

        var n_bodies: size_t
        var n_pure: size_t
        var n_pure_writing: size_t
        var n_pure_direct: size_t
        var n_proc: size_t
        var n_proc_writing: size_t
        var n_unfiled: size_t
        var n_misaligned: size_t
        var n_rounds: size_t
        var n_sites: size_t

        ; summaries of other roots' bodies, by mangled name (open addressing)
        var summaries_path: String
        sum_names: Array[String]
        sum_masks: Array[u64]
        sum_inputs: Array[size_t]
        ; the globals each summarised body writes, `a,b,?alias`
        sum_globals: Array[String]
        sum_slots: Vector[size_t]
        var n_stub_known: size_t
        var n_stub_unknown: size_t

        ; the frozen mode
        var frozen_mode: bool
        frozen_names: Array[String]
        entry_names: Array[String]
        reach: Array[u64]
        queue: Array[size_t]
        var edge_mode: bool
        var lock_depth: int
        var n_reachable: size_t
        var n_frozen_sites: size_t
        var n_locked_sites: size_t
        ; PROVENANCE: a parameter is frozen when some reachable call passes a
        ; frozen value into it (the entries: by type); a function's result is
        ; fresh until one of its returns is frozen -- one fixpoint over both
        param_frozen: Array[u64]
        returns_fresh: Array[u64]
        var frozen_pass: bool
        var fz_changed: bool
        var cur_fn: size_t
        var n_fz_rounds: size_t
        ; the check mode (--purity-check)
        check_mode: bool
        var cur_page_mask: u64
        ; what the body walked may write besides: an annotated procedure's
        ; `mutable` parameters and the globals
        var cur_allowed: u64
        ; the check as the compiler's own gate: an `error:` per violating
        ; body and a `note:` per write it did not declare (cli.scaly)
        diagnostics: bool
        var n_violations: size_t
        ; WHICH globals a body writes, transitively: a name table per root
        ; and WC_GW words per plan.functions index (id WC_GW * 64 - 1 is the
        ; global this pass cannot name: an alias, another root's body)
        gnames: Array[String]
        gwords: Array[u64]
        cur_g: Array[u64]
        g_changed: bool
        ; the global a local aliases ("" none), beside loc_names
        var loc_globals: Array[String]
        ; the global the next hit writes through, named by its caller
        var pending_global: String
        ; the runtime's own state (scaly/memory, fiber, os, cluster): ambient
        ambient_names: Array[String]
        ; check mode: the globals the walked body declares (`mutable g, h`)
        var cur_allowed_g: ref[Vector[String]]?
        ; `shared atomic` cells: written only through scaly_atomic_*
        atomic_names: Array[String]
        var in_atomic_op: bool
        var cur_atomic_bad: Array[String]
        ; every global that can change (`mutable`, `shared`, `shared atomic`),
        ; and the ones the walked FUNCTION reads: a function reads none
        mutable_names: Array[String]
        var cur_reads: Array[String]
        ; the read pre-pass of the check: per plan.functions index the first
        ; changeable global a body reads, itself or through a body it calls
        ; ("" none), and the call edges between bodies that carry it
        var read_pass: bool
        var read_index: size_t
        body_reads: Array[String]
        ; and how it reaches I/O ("" not at all): a procedure does not declare
        ; it, the check computes it like the reads
        body_io: Array[String]
        edge_from: Array[size_t]
        edge_to: Array[size_t]
        ; what a LINKED declaration (another package's interface) says it
        ; reads and whether it says `io`: a method under `Owner.name/arity`
        ; only, a free function under `name/arity` only -- a bare-name
        ; fallback for a method would hand one package's `get` the effects
        ; of another's (Page.get, mangled without its owner, read scalyls'
        ; doc_slots that way)
        decl_read_keys: Array[String]
        decl_read_vals: Array[String]
        decl_io_keys: Array[String]
        ; per plan.functions index: the global a body RETURNS ("" none), so a
        ; getter's result is an alias of that global
        ret_globals: Array[String]
        var cur_ret_global: String
        ; per plan.functions index: the PARAMETERS a body's result may alias
        ; (bit i = parameter i, WC_OVERFLOW past 61; WC_PARAMS = every one),
        ; so a call's result aliases only the arguments at those positions
        ; instead of all of them. A body this pass cannot walk (a stub, an
        ; extern) aliases every argument; so does a returned shape the walk
        ; does not follow. A least fixpoint from "nothing" over the bodies.
        ret_params: Array[u64]
        var cur_ret_params: u64
        var rp_changed: bool
        var n_rp_rounds: size_t
        ; the first round records the call edges (caller, callee); a later
        ; round re-walks only a caller of a body whose ret_params grew
        var rp_pass: bool
        rp_from: Array[size_t]
        rp_to: Array[size_t]
        rp_grew: Array[u64]
        rp_dirty: Array[u64]
        ; the IS half of ret_params: the parameters a body's result may BE,
        ; against the ones a fresh object it returns merely holds
        ret_is: Array[u64]
        var cur_ret_is: u64
    )
    {
        init()
        {
            report_files := Array[String]^this()
            report_offsets := Array[size_t]^this()
            report_texts := Array[String]^this()
            pc := null
            plan_functions := null
            plan_structures := null
            struct_by_mangled := ConceptIndex()
            struct_by_name := ConceptIndex()
            let_probe := false
            n_let_sites := 0
            let_offsets := Array[size_t]^this()
            let_texts := Array[String]^this()
            let_fns := Array[size_t]^this()
            cur_let_bad := Array[String]^this()
            cur_let_offsets := Array[size_t]^this()
            cur_addr_taken := Array[String]^this()
            cur_file_hint := String^this("")
            masks := Array[u64]^this()
            cur_input := null
            cur_page := String^this("")
            cur_name := String^this("")
            cur_pure := false
            cur_substrate := false
            body_mask := 0
            body_direct := false
            reporting := false
            current_file := String^this("")
            loc_names := Array[String]^this()
            loc_masks := Array[u64]^this()
            loc_is := Array[u64]^this()
            n_bodies := 0
            n_pure := 0
            n_pure_writing := 0
            n_pure_direct := 0
            n_proc := 0
            n_proc_writing := 0
            n_unfiled := 0
            n_misaligned := 0
            n_rounds := 0
            n_sites := 0
            summaries_path := String^this("")
            sum_names := Array[String]^this()
            sum_masks := Array[u64]^this()
            sum_inputs := Array[size_t]^this()
            sum_globals := Array[String]^this()
            sum_slots := Vector[size_t]^this(262144)
            n_stub_known := 0
            n_stub_unknown := 0
            frozen_mode := false
            frozen_names := Array[String]^this()
            entry_names := Array[String]^this()
            reach := Array[u64]^this()
            queue := Array[size_t]^this()
            edge_mode := false
            lock_depth := 0
            n_reachable := 0
            n_frozen_sites := 0
            n_locked_sites := 0
            param_frozen := Array[u64]^this()
            returns_fresh := Array[u64]^this()
            frozen_pass := false
            fz_changed := false
            cur_fn := 0
            n_fz_rounds := 0
            check_mode := false
            cur_page_mask := 0
            cur_allowed := 0
            diagnostics := false
            n_violations := 0
            gnames := Array[String]^this()
            gwords := Array[u64]^this()
            cur_g := Array[u64]^this()
            g_changed := false
            loc_globals := Array[String]^this()
            pending_global := String^this("")
            ambient_names := Array[String]^this()
            cur_allowed_g := null
            atomic_names := Array[String]^this()
            in_atomic_op := false
            cur_atomic_bad := Array[String]^this()
            mutable_names := Array[String]^this()
            cur_reads := Array[String]^this()
            read_pass := false
            read_index := 0
            body_reads := Array[String]^this()
            body_io := Array[String]^this()
            edge_from := Array[size_t]^this()
            edge_to := Array[size_t]^this()
            decl_read_keys := Array[String]^this()
            decl_read_vals := Array[String]^this()
            decl_io_keys := Array[String]^this()
            ret_globals := Array[String]^this()
            cur_ret_global := String^this("")
            ret_params := Array[u64]^this()
            cur_ret_params := 0
            rp_changed := false
            n_rp_rounds := 0
            rp_pass := false
            rp_from := Array[size_t]^this()
            rp_to := Array[size_t]^this()
            rp_grew := Array[u64]^this()
            rp_dirty := Array[u64]^this()
            ret_is := Array[u64]^this()
            cur_ret_is := 0
        }

        ; ================================================================
        ; Entry point: the pointer census's tables, the fixpoint, the report.
        ; ================================================================
        procedure analyze(mutable this: WriteCensus, plan: Plan, model: ref[Program], mutable census: ref[PointerCensus])
        {
            pc := census
            this.load_summaries()
            this.load_frozen()
            census.walk_model_module(model.module_)
            var pi: size_t 0
            while pi < model.packages.length
            {
                let pkg model.packages.get pi
                if pkg <> null
                    census.collect_externs_module((*pkg))
                pi := pi + 1
            }
            census.plan_functions := plan.functions
            census.plan_structures := plan.structures
            census.index_functions()
            plan_functions := plan.functions
            plan_structures := plan.structures
            this.index_structures()
            if plan.functions = null
                return
            if check_mode
            {
                this.run_check(model)
                return
            }
            let fns plan.functions
            var i: size_t 0
            while i < fns.length
            {
                masks.add(0)
                var w: size_t 0
                while w < WC_GW
                {
                    gwords.add(0)
                    w := w + 1
                }
                i := i + 1
            }
            ; a call's result aliases the arguments its callee's returns reach
            this.learn_returned_params()
            ; a getter's result aliases the global it returns
            this.learn_returned_globals()
            var changed true
            while changed
            {
                changed := false
                n_rounds := n_rounds + 1
                i := 0
                while i < fns.length
                {
                    let f_ptr fns.get i
                    if f_ptr <> null
                    {
                        let before masks[i]
                        ; a body without an Action never enters: no globals
                        this.clear_globals()
                        cur_fn := i
                        let after before | (this.walk_body((*f_ptr)) & (0 - (WC_FROZEN + (1 as u64))))
                        if after <> before
                        {
                            masks.put(i, after)
                            changed := true
                        }
                        if this.merge_globals_into(i)
                            changed := true
                    }
                    i := i + 1
                }
                if n_rounds >= 100
                    changed := false
            }
            this.save_summaries()
            if frozen_mode
            {
                this.report_frozen()
                return
            }
            reporting := true
            i := 0
            while i < fns.length
            {
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    cur_fn := i
                    this.report_body((*f_ptr), masks[i])
                }
                i := i + 1
            }
            this.report_globals()
        }

        function total(this: WriteCensus) returns size_t
            report_offsets.length

        function in_substrate(path: String) returns bool
            path.contains(String("/scaly/memory/"))

        function join(a: String, b: String) returns String
        {
            var sb StringBuilder()
            sb.append a
            sb.append b
            sb.to_string()
        }

        ; The summary of one body under the callee summaries known so far.
        procedure walk_body(mutable this: WriteCensus, func: PlannedFunction) returns u64
        {
            choose func.impl
                when action: Action
                {
                    this.enter_body(func)
                    this.find_action(action)
                    if action.target = null
                        this.note_returned(action.source)
                    if frozen_pass and this.tail_frozen(action)
                        this.mark_returns_frozen()
                    return body_mask
                }
                else
                    return 0
        }

        procedure enter_body(mutable this: WriteCensus, func: PlannedFunction)
        {
            cur_input := func.input
            cur_page := String^this("_rp")
            if func.page_parameter <> null
                cur_page := String^this((*func.page_parameter))
            cur_name := String^this(func.name)
            cur_file_hint := String^this(func.file)
            cur_addr_taken.length := 0
            cur_pure := func.pure
            cur_substrate := WriteCensus.in_substrate(func.file)
            body_mask := 0
            body_direct := false
            lock_depth := 0
            this.clear_globals()
            cur_page_mask := 0
            if check_mode
                cur_page_mask := this.page_param_mask() | cur_allowed
            loc_names := Array[String]^this()
            loc_masks := Array[u64]^this()
            loc_is := Array[u64]^this()
            loc_globals := Array[String]^this()
            cur_atomic_bad := Array[String]^this()
            cur_reads := Array[String]^this()
            cur_ret_global := String^this("")
            cur_ret_params := 0
            cur_ret_is := 0
        }

        ; The last walk: sites, and one `fn` line per writing pure function.
        ; The last walk: one `fn`/`proc`/`init` line per body (`clean` or the
        ; parameters it writes), and the sites of every writing function.
        procedure report_body(mutable this: WriteCensus, func: PlannedFunction, whole_mask: u64)
        {
            var is_body false
            choose func.impl
                when action: Action
                    is_body := true
                else
                    0
            if is_body = false
                return
            let census pc as ref[PointerCensus]
            let home census.resolve_body_file(func)
            if home.get_length() = 0
            {
                n_unfiled := n_unfiled + 1
                return
            }
            current_file := String^this(home)
            n_bodies := n_bodies + 1
            ; an initializer writes its own NEW object (`this`, input 0)
            var mask whole_mask
            var kind: String "fn "
            if func.name = "init"
            {
                mask := mask & ((0 as u64) - (2 as u64))
                kind := "init "
            }
            else
            {
                if func.pure = false
                    kind := "proc "
            }
            if func.pure
            {
                if func.name <> "init"
                    n_pure := n_pure + 1
            }
            else
                n_proc := n_proc + 1
            this.enter_body(func)
            var sb StringBuilder()
            sb.append kind
            sb.append func.name
            if mask = 0
            {
                sb.append " clean"
                let clean_text sb.to_string()
                this.record(func.loc.start, String^this(clean_text))
                return
            }
            sb.append " writes "
            sb.append(this.mask_names(mask))
            if func.pure = false
            {
                n_proc_writing := n_proc_writing + 1
                let proc_text sb.to_string()
                this.record(func.loc.start, String^this(proc_text))
                ; SCALYC_WRITE_PROC_SITES=1: the sites of the procedures too,
                ; which tells a DIRECT write from one inherited through a callee
                if getenv("SCALYC_WRITE_PROC_SITES") <> null
                    this.walk_body(func)
                return
            }
            this.walk_body(func)
            if func.name <> "init"
            {
                n_pure_writing := n_pure_writing + 1
                if body_direct
                    n_pure_direct := n_pure_direct + 1
            }
            if body_direct
                sb.append " direct"
            else
                sb.append " transitive"
            let text sb.to_string()
            this.record(func.loc.start, String^this(text))
        }

        ; ================================================================
        ; The global set of the body walked (cur_g) and of every body.
        ; ================================================================

        procedure clear_globals(mutable this: WriteCensus)
        {
            if cur_g.length = 0
            {
                var w: size_t 0
                while w < WC_GW
                {
                    cur_g.add(0)
                    w := w + 1
                }
                return
            }
            var i: size_t 0
            while i < WC_GW
            {
                cur_g.put(i, 0)
                i := i + 1
            }
        }

        procedure note_global_id(mutable this: WriteCensus, id: size_t)
        {
            let w id / 64
            let bit (1 as u64) << ((id - w * 64) as u64)
            cur_g.put(w, cur_g[w] | bit)
        }

        ; a name's id in this root's table ("" is the unnamed one)
        procedure note_global_named(mutable this: WriteCensus, name: String)
        {
            if name.get_length() = 0
            {
                this.note_global_id(WC_GW * 64 - 1)
                return
            }
            if check_mode
            {
                if this.is_atomic_name(name)
                {
                    if in_atomic_op = false
                        cur_atomic_bad.add(String^this(name))
                    return
                }
                if this.is_ambient(name)
                    return
            }
            var i: size_t 0
            while i < gnames.length
            {
                if gnames[i] = name
                {
                    this.note_global_id(i)
                    return
                }
                i := i + 1
            }
            if gnames.length >= WC_GW * 64 - 2
            {
                this.note_global_id(WC_GW * 64 - 1)
                return
            }
            gnames.add(String^this(name))
            this.note_global_id(gnames.length - 1)
        }

        procedure union_callee_globals(mutable this: WriteCensus, row: size_t)
        {
            var w: size_t 0
            while w < WC_GW
            {
                cur_g.put(w, cur_g[w] | gwords[row * WC_GW + w])
                w := w + 1
            }
        }

        ; OR the body's set into its row; true when the row grew
        procedure merge_globals_into(mutable this: WriteCensus, row: size_t) returns bool
        {
            var grew false
            var w: size_t 0
            while w < WC_GW
            {
                let old gwords[row * WC_GW + w]
                let nw old | cur_g[w]
                if nw <> old
                {
                    gwords.put(row * WC_GW + w, nw)
                    grew := true
                }
                w := w + 1
            }
            grew
        }

        ; the global an argument's value is rooted in ("" when it is reached
        ; through anything but the global itself)
        ; the value a body hands back: the last operand of a return or of the
        ; tail (a block's last statement, both arms of an `if` via the walk)
        procedure note_returned(mutable this: WriteCensus, ops: ref[Vector[PlannedOperand]]?)
        {
            if ops = null
                return
            if ops.length = 0
                return
            let last_ptr ops.get(ops.length - 1)
            if last_ptr = null
                return
            let last last_ptr.unwrap()
            choose last.expr
                when blk: Block
                {
                    if blk.statements = null
                        return
                    if blk.statements.length = 0
                        return
                    let st_ptr blk.statements.get(blk.statements.length - 1)
                    if st_ptr = null
                        return
                    choose (*st_ptr)
                        when a: Action
                            if a.target = null
                                this.note_returned(a.source)
                        else
                            0
                }
                else
                {
                    let r this.global_root_m(last)
                    if r.get_length() > 0
                        cur_ret_global := String^this(r)
                    cur_ret_params := cur_ret_params | this.ret_alias_of_operands(ops, false)
                    cur_ret_is := cur_ret_is | this.ret_alias_of_operands(ops, true)
                }
        }

        ; The parameters a returned operand sequence may alias: what mask_of
        ; answers for the shapes it follows, and EVERY parameter for a shape it
        ; does not (an if, a choose, a match, a block inside an arm ...) -- the
        ; conservative side, since a missed alias would let a write through the
        ; result go unrecorded.
        function ret_alias_of_operands(this: WriteCensus, ops: ref[Vector[PlannedOperand]]?, narrow: bool) returns u64
        {
            if ops = null
                return 0
            var m: u64 0
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    m := m | this.ret_alias_of(op_ptr.unwrap(), narrow)
                i := i + 1
            }
            m
        }

        ; narrow: the IS half (ret_is) -- a construction is a new object, a
        ; variable and a call answer is_of
        function ret_alias_of(this: WriteCensus, op: PlannedOperand, narrow: bool) returns u64
        {
            if WriteCensus.is_scalar(op.result_type)
                return 0
            choose op.expr
                when k: Constant
                    return 0
                when v: Variable
                {
                    if narrow
                        return this.is_of(op) & WC_PARAMS
                    return this.mask_of(op) & WC_PARAMS
                }
                when g: GlobalRef
                    return 0
                when a: As
                {
                    if a.value = null
                        return 0
                    let r a.value
                    return this.ret_alias_of((*r), narrow)
                }
                when c: Call
                {
                    if narrow
                        return this.is_of(op) & WC_PARAMS
                    return this.mask_of(op) & WC_PARAMS
                }
                when tp: Tuple
                {
                    if narrow
                        return 0
                    var m: u64 0
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                m := m | this.ret_alias_of_operands(c_ptr.value, narrow)
                            i := i + 1
                        }
                    }
                    return m
                }
                when blk: Block
                {
                    if blk.statements = null
                        return 0
                    if blk.statements.length = 0
                        return 0
                    return this.ret_alias_of_statement(blk.statements.get(blk.statements.length - 1), narrow)
                }
                when iff: If
                    return this.ret_alias_of_statement(iff.consequent, narrow) | this.ret_alias_of_statement(iff.alternative, narrow)
                when ch: Choose
                {
                    var m this.ret_alias_of_statement(ch.alternative, narrow)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                                m := m | this.ret_alias_of_statement(w_ptr.consequent, narrow)
                            i := i + 1
                        }
                    }
                    return m
                }
                when mt: Match
                {
                    var m this.ret_alias_of_statement(mt.alternative, narrow)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let b_ptr mt.branches.get i
                            if b_ptr <> null
                                m := m | this.ret_alias_of_statement(b_ptr.consequent, narrow)
                            i := i + 1
                        }
                    }
                    return m
                }
                else
                    return WC_PARAMS
        }

        ; The value a statement leaves as an arm's or a block's tail: an action
        ; without a target. A `return` inside is recorded where the walk meets
        ; it (find_statement), a set, a binding, a break or a throw leaves none.
        function ret_alias_of_statement(this: WriteCensus, stmt: ref[PlannedStatement]?, narrow: bool) returns u64
        {
            if stmt = null
                return 0
            let st stmt as ref[PlannedStatement]
            choose st
                when a: Action
                {
                    if a.target <> null
                        return 0
                    return this.ret_alias_of_operands(a.source, narrow)
                }
                else
                    return 0
        }

        ; The arguments a call's result may alias, by the callee's ret_params:
        ; only the arguments at the positions the callee's returns reach. A
        ; callee this root cannot follow (no slot, a stub -- ret_params holds
        ; WC_PARAMS for it), an init (its result is the new object built from
        ; every argument), the deref and address operators, and a call whose
        ; arguments do not line up with the callee's input keep every argument.
        function call_alias_mask(this: WriteCensus, c: PlannedCall, narrow: bool) returns u64
        {
            if c.args = null
                return 0
            var rp: u64 WC_PARAMS
            if c.name <> "init"
                if c.name <> "*"
                    if c.name <> "&"
                    {
                        let slot this.callee_index(c.mangled_name)
                        if slot > 0
                            if (slot - 1) < ret_params.length
                            {
                                let callee_ptr plan_functions.get(slot - 1)
                                if callee_ptr <> null
                                {
                                    let callee callee_ptr.unwrap()
                                    var n_in: size_t 0
                                    if callee.input <> null
                                        n_in := callee.input.length
                                    if callee.name <> "init"
                                        if n_in = c.args.length
                                        {
                                            if narrow
                                                rp := ret_is[slot - 1]
                                            else
                                                rp := ret_params[slot - 1]
                                        }
                                }
                            }
                    }
            if rp = WC_PARAMS
                return this.mask_of_operands(c.args)
            var m: u64 0
            var i: size_t 0
            while i < c.args.length
            {
                var bit: u64 WC_OVERFLOW
                if i < 61
                    bit := (1 as u64) << (i as u64)
                if (rp & bit) <> (0 as u64)
                {
                    let a_ptr c.args.get i
                    if a_ptr <> null
                    {
                        if narrow
                            m := m | this.is_of(a_ptr.unwrap())
                        else
                            m := m | this.mask_of(a_ptr.unwrap())
                    }
                }
                i := i + 1
            }
            m
        }

        ; The least fixpoint of ret_params over every body of the root: a body
        ; starts at "aliases nothing", a stub or extern at every parameter, and
        ; each round re-walks the bodies that can still grow. mask_of reads the
        ; table as it stands, so a round sees the previous round's callees.
        procedure learn_returned_params(mutable this: WriteCensus)
        {
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                var start: u64 WC_PARAMS
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    choose f_ptr.unwrap().impl
                        when action: Action
                            start := 0
                        else
                            0
                }
                ret_params.add start
                ret_is.add start
                i := i + 1
            }
            i := 0
            while i < fns.length
            {
                rp_grew.add 0
                rp_dirty.add 1
                i := i + 1
            }
            rp_pass := true
            rp_changed := true
            while rp_changed
            {
                rp_changed := false
                n_rp_rounds := n_rp_rounds + 1
                i := 0
                while i < fns.length
                {
                    rp_grew.put(i, 0)
                    let f_ptr fns.get i
                    if f_ptr <> null
                        if rp_dirty[i] <> 0
                            if ret_params[i] <> WC_PARAMS
                            {
                                cur_fn := i
                                this.clear_globals()
                                this.walk_body(f_ptr.unwrap())
                                let grown ret_params[i] | cur_ret_params
                                if grown <> ret_params[i]
                                {
                                    ret_params.put(i, grown)
                                    rp_grew.put(i, 1)
                                    rp_changed := true
                                }
                                let grown_is ret_is[i] | cur_ret_is
                                if grown_is <> ret_is[i]
                                {
                                    ret_is.put(i, grown_is)
                                    rp_grew.put(i, 1)
                                    rp_changed := true
                                }
                            }
                    i := i + 1
                }
                rp_pass := false
                ; the next round re-walks the callers of what grew
                i := 0
                while i < fns.length
                {
                    rp_dirty.put(i, 0)
                    i := i + 1
                }
                var e: size_t 0
                while e < rp_from.length
                {
                    if rp_grew[rp_to[e]] <> 0
                        rp_dirty.put(rp_from[e], 1)
                    e := e + 1
                }
                if n_rp_rounds >= 60
                    rp_changed := false
            }
        }

        ; one walk of every body to learn which bodies return a global
        procedure learn_returned_globals(mutable this: WriteCensus)
        {
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                ret_globals.add(String^this(""))
                i := i + 1
            }
            i := 0
            while i < fns.length
            {
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    this.clear_globals()
                    cur_ret_global := String^this("")
                    this.walk_body(f_ptr.unwrap())
                    if cur_ret_global.get_length() > 0
                        ret_globals.put(i, String^this(cur_ret_global))
                }
                i := i + 1
            }
        }

        ; the global a local aliases ("" none)
        function local_global(this: WriteCensus, name: String) returns String
        {
            var li loc_names.length
            while li > 0
            {
                li := li - 1
                if loc_names[li] = name
                    return String(loc_globals[li])
            }
            String("")
        }

        function global_root_m(this: WriteCensus, op: PlannedOperand) returns String
        {
            choose op.expr
                when g: GlobalRef
                    return String(g.name)
                when v: Variable
                {
                    var li loc_names.length
                    while li > 0
                    {
                        li := li - 1
                        if loc_names[li] = v.name
                            return String(loc_globals[li])
                    }
                    return String("")
                }
                when a: As
                {
                    if a.value = null
                        return String("")
                    let r a.value
                    return this.global_root_m((*r))
                }
                when tp: Tuple
                {
                    ; a construction holds what its components reach
                    if tp.components = null
                        return String("")
                    var ti: size_t 0
                    while ti < tp.components.length
                    {
                        let c_ptr tp.components.get ti
                        if c_ptr <> null
                        {
                            let vals c_ptr.value
                            if vals <> null
                            {
                                var vi: size_t 0
                                while vi < vals.length
                                {
                                    let v_ptr vals.get vi
                                    if v_ptr <> null
                                    {
                                        let vop v_ptr.unwrap()
                                        if (this.mask_of(vop) & WC_GLOBAL) <> (0 as u64)
                                        {
                                            let r this.global_root_m(vop)
                                            if r.get_length() > 0
                                                return r
                                        }
                                    }
                                    vi := vi + 1
                                }
                            }
                        }
                        ti := ti + 1
                    }
                    return String("")
                }
                when c: Call
                {
                    ; a call into a body that RETURNS a global is that global
                    if ret_globals.length > 0
                    {
                        let slot this.callee_index(c.mangled_name)
                        if slot > 0
                        {
                            if slot <= ret_globals.length
                            {
                                let rg ret_globals[slot - 1]
                                if rg.get_length() > 0
                                    return String(rg)
                            }
                        }
                    }
                    if c.args = null
                        return String("")
                    ; `&x`/`*x`, and a call RESULT, which the census lets alias
                    ; its arguments: the first argument that reaches a global
                    var ai: size_t 0
                    while ai < c.args.length
                    {
                        let inner c.args.get ai
                        if inner <> null
                        {
                            let iop inner.unwrap()
                            if (this.mask_of(iop) & WC_GLOBAL) <> (0 as u64)
                            {
                                let r this.global_root_m(iop)
                                if r.get_length() > 0
                                    return r
                            }
                        }
                        ai := ai + 1
                    }
                    return String("")
                }
                else
                    return String("")
        }

        ; row's global set as `a,b,?alias` (the summary's fourth field)
        function globals_text(this: WriteCensus, row: size_t) returns String
        {
            var sb StringBuilder()
            var any false
            var id: size_t 0
            while id < WC_GW * 64
            {
                let w id / 64
                if (gwords[row * WC_GW + w] & ((1 as u64) << ((id - w * 64) as u64))) <> (0 as u64)
                {
                    if any
                        sb.append ","
                    any := true
                    if id = WC_GW * 64 - 1
                        sb.append "?alias"
                    else if id = WC_GW * 64 - 2
                        sb.append "?other-root"
                    else
                        sb.append(gnames[id])
                }
                id := id + 1
            }
            sb.to_string()
        }

        procedure note_callee_globals(mutable this: WriteCensus, offset: size_t, list: String, callee: String)
        {
            let n list.get_length()
            var i: size_t 0
            while i < n
            {
                var nb StringBuilder()
                while i < n
                {
                    let c list.get i
                    if c = 44
                        break
                    nb.append(c as char)
                    i := i + 1
                }
                i := i + 1
                let one nb.to_string()
                if one.get_length() > 0
                {
                    this.note_global_named(one)
                    this.note_global_site(offset, one, callee)
                }
            }
        }

        procedure note_global_list(mutable this: WriteCensus, list: String)
        {
            let n list.get_length()
            if n = 0
            {
                this.note_global_id(WC_GW * 64 - 2)
                return
            }
            var i: size_t 0
            while i < n
            {
                var nb StringBuilder()
                while i < n
                {
                    let c list.get i
                    if c = 44
                        break
                    nb.append(c as char)
                    i := i + 1
                }
                i := i + 1
                let one nb.to_string()
                if one = "?alias"
                    this.note_global_id(WC_GW * 64 - 1)
                else if one = "?other-root"
                    this.note_global_id(WC_GW * 64 - 2)
                else
                    this.note_global_named(one)
            }
        }

        ; `gw <name> a,b,c` per body that writes globals, after the body lines
        procedure report_globals(mutable this: WriteCensus)
        {
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                let f_ptr fns.get i
                i := i + 1
                if f_ptr = null
                    continue
                let func f_ptr.unwrap()
                var is_body false
                choose func.impl
                    when action: Action
                        is_body := true
                    else
                        0
                if is_body = false
                    continue
                var any false
                var sb StringBuilder()
                sb.append "gw "
                sb.append func.name
                sb.append " "
                var id: size_t 0
                while id < WC_GW * 64
                {
                    let w id / 64
                    if (gwords[(i - 1) * WC_GW + w] & ((1 as u64) << ((id - w * 64) as u64))) <> (0 as u64)
                    {
                        if any
                            sb.append ","
                        any := true
                        if id = WC_GW * 64 - 1
                            sb.append "?alias"
                        else if id = WC_GW * 64 - 2
                            sb.append "?other-root"
                        else
                            sb.append(gnames[id])
                    }
                    id := id + 1
                }
                if any
                {
                    let census pc as ref[PointerCensus]
                    let home census.resolve_body_file(func)
                    if home.get_length() > 0
                    {
                        current_file := String^this(home)
                        let text sb.to_string()
                        this.record(func.loc.start, String^this(text))
                    }
                }
            }
        }

        procedure record(mutable this: WriteCensus, offset: size_t, text: String)
        {
            report_files.add(String^this(current_file))
            report_offsets.add offset
            report_texts.add text
        }

        ; ================================================================
        ; Parameters, locals and the mask of an operand.
        ; ================================================================

        function param_name(this: WriteCensus, i: size_t) returns String
        {
            if cur_input = null
                return String("?")
            let it_ptr cur_input.get i
            if it_ptr = null
                return String("?")
            let it (*it_ptr)
            if it.name = null
                return String("this")
            String((*it.name))
        }

        function param_type_name(this: WriteCensus, i: size_t) returns String
        {
            if cur_input = null
                return String("")
            let it_ptr cur_input.get i
            if it_ptr = null
                return String("")
            let it (*it_ptr)
            if it.item_type = null
                return String("")
            Planner.get_readable_name((*it.item_type))
        }

        ; `this:Box host:ref.Page global` for the bits of a mask.
        function mask_names(this: WriteCensus, mask: u64) returns String
        {
            var sb StringBuilder()
            var first true
            var i: size_t 0
            while i < 61
            {
                if (mask & ((1 as u64) << (i as u64))) <> (0 as u64)
                {
                    if first = false
                        sb.append ","
                    first := false
                    sb.append(this.param_name(i))
                    sb.append ":"
                    sb.append(this.param_type_name(i))
                }
                i := i + 1
            }
            if (mask & WC_OVERFLOW) <> (0 as u64)
            {
                if first = false
                    sb.append ","
                first := false
                sb.append "param>61"
            }
            if (mask & WC_FROZEN) <> (0 as u64)
            {
                if first = false
                    sb.append ","
                first := false
                sb.append "frozen"
            }
            if (mask & WC_GLOBAL) <> (0 as u64)
            {
                if first = false
                    sb.append ","
                sb.append "global"
            }
            sb.to_string()
        }

        function is_scalar(t: PlannedType) returns bool
        {
            let n t.name
            match n
                case "int" case "i8" case "i16" case "i32" case "i64" case "u8": return true
                case "u16" case "u32" case "u64" case "size_t" case "bool" case "char": return true
                case "float" case "double" case "f32" case "f64" case "void": return true
            false
        }

        ; The parameter bit of a name, or a local's inherited mask.
        function name_mask(this: WriteCensus, name: String) returns u64
        {
            var li loc_names.length
            while li > 0
            {
                li := li - 1
                let n loc_names.get li
                if n <> null and (*n) = name
                    return loc_masks[li]
            }
            if name = cur_page
                return 0
            if name = "_rp"
                return 0
            if cur_input = null
                return 0
            var i: size_t 0
            while i < cur_input.length
            {
                if this.param_name(i) = name
                {
                    var fz: u64 0
                    if this.param_is_frozen(i)
                        fz := WC_FROZEN
                    if i >= 61
                        return WC_OVERFLOW | fz
                    return ((1 as u64) << (i as u64)) | fz
                }
                i := i + 1
            }
            0
        }

        function param_is_frozen(this: WriteCensus, i: size_t) returns bool
        {
            if frozen_mode = false
                return false
            if cur_fn >= param_frozen.length
                return false
            if i >= 61
                return (param_frozen[cur_fn] & WC_OVERFLOW) <> (0 as u64)
            (param_frozen[cur_fn] & ((1 as u64) << (i as u64))) <> (0 as u64)
        }

        procedure remember_local(mutable this: WriteCensus, name: String, mask: u64)
            this.remember_local_of(name, mask, mask, String(""))

        procedure remember_local_of(mutable this: WriteCensus, name: String, mask: u64, is_mask: u64, global: String)
        {
            loc_names.add(String^this(name))
            loc_masks.add mask
            loc_is.add is_mask
            loc_globals.add(String^this(global))
        }

        ; name_mask's IS half: a local answers loc_is, a parameter its bit
        function name_is(this: WriteCensus, name: String) returns u64
        {
            var li loc_names.length
            while li > 0
            {
                li := li - 1
                let n loc_names.get li
                if n <> null and (*n) = name
                    return loc_is[li]
            }
            this.name_mask(name)
        }

        ; ================================================================
        ; IS against HOLDS. mask_of answers every parameter a value may REACH:
        ; the object it is, and the objects a fresh record it names holds a
        ; reference to (`let w Wrapper(node)` reaches node). A store into such a
        ; record's OWN field writes the record, not what it holds, so the
        ; w-field site asks is_of for its base: the parameters the value may
        ; BE. A construction is a new object (0), a local answers what its
        ; initializer is, a call result what the callee's returns ARE
        ; (ret_is), a loaded member or a deref may be anything the base
        ; reaches (mask_of). Frozen and global marks stay as mask_of gives
        ; them -- conservative where the two halves are not told apart.
        ; ================================================================
        function is_of(this: WriteCensus, op: PlannedOperand) returns u64
        {
            if op.member_access <> null and op.member_access.length > 0
                return this.mask_of(op)
            this.is_of_base(op)
        }

        ; is_of ignoring the operand's own member chain (the w-field site judges
        ; the chain itself: an intermediate reference hop loads another object)
        function is_of_base(this: WriteCensus, op: PlannedOperand) returns u64
        {
            if WriteCensus.is_scalar(op.result_type)
                return 0
            let marks this.mask_of(op) & (WC_FROZEN | WC_GLOBAL)
            choose op.expr
                when v: Variable
                    return this.name_is(v.name) | marks
                when a: As
                {
                    if a.value = null
                        return marks
                    let r a.value
                    return this.is_of((*r)) | marks
                }
                when tp: Tuple
                    return marks
                when c: Call
                {
                    if c.name = "init"
                        return marks
                    if c.name = "*"
                        return this.mask_of(op)
                    if c.name = "&"
                    {
                        if c.args = null
                            return marks
                        if c.args.length <> 1
                            return this.mask_of(op)
                        let a_ptr c.args.get 0
                        if a_ptr = null
                            return marks
                        return this.is_of(a_ptr.unwrap()) | marks
                    }
                    let census pc as ref[PointerCensus]
                    if census.is_extern_name(c.mangled_name)
                        return marks
                    return (this.call_alias_mask(c, true) & (0 - (WC_FROZEN + (1 as u64)))) | marks
                }
                else
                    return this.mask_of(op)
        }

        function is_of_operands(this: WriteCensus, ops: ref[Vector[PlannedOperand]]?) returns u64
        {
            if ops = null
                return 0
            if ops.length = 1
            {
                let o_ptr ops.get 0
                if o_ptr <> null
                    return this.is_of(o_ptr.unwrap())
            }
            this.mask_of_operands(ops)
        }

        ; Does a member chain load another object before its last hop?
        function loads_before_last(op: PlannedOperand) returns bool
        {
            if op.member_access = null
                return false
            let hops (*op.member_access)
            var i: size_t 0
            while i + 1 < hops.length
            {
                let hp hops.get i
                if hp <> null and WriteCensus.is_reference_name((*hp).result_type.name)
                    return true
                i := i + 1
            }
            false
        }

        function mask_of_operands(this: WriteCensus, ops: ref[Vector[PlannedOperand]]?) returns u64
        {
            if ops = null
                return 0
            var m: u64 0
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    m := m | this.mask_of(op_ptr.unwrap())
                i := i + 1
            }
            m
        }

        ; What an operand's value may alias: the parameters it reaches.
        function mask_of(this: WriteCensus, op: PlannedOperand) returns u64
        {
            ; a scalar value aliases nothing (`i` in `data + i`)
            if WriteCensus.is_scalar(op.result_type)
                return 0
            var fz this.hops_frozen(op)
            if this.is_frozen_type(op.result_type)
            {
                var loaded false
                if op.member_access <> null and op.member_access.length > 0
                    loaded := true
                ; a reference read out of a field is whatever that field holds;
                ; anything else is frozen by its PROVENANCE (value_frozen)
                if loaded
                    fz := WC_FROZEN
                else
                    fz := fz | this.value_frozen(op)
            }
            fz | this.mask_of_base(op)
        }

        ; The provenance of a frozen-typed value ignoring its member chain: a
        ; construction is fresh, so is the result of a function all of whose
        ; returns are fresh; a load through a pointer, an unknown callee and an
        ; expression this pass does not follow are frozen. A variable answers
        ; through name_mask (its parameter or its initializer).
        function value_frozen(this: WriteCensus, op: PlannedOperand) returns u64
        {
            choose op.expr
                when v: Variable
                    return 0
                when a: As
                    return 0
                when tp: Tuple
                    return 0
                when vc: VariantConstruction
                    return 0
                when bx: Box
                    return 0
                when c: Call
                {
                    if c.name = "*"
                        return WC_FROZEN
                    ; the address of a value has the value's provenance
                    if c.name = "&"
                    {
                        if c.args = null
                            return WC_FROZEN
                        if c.args.length <> 1
                            return WC_FROZEN
                        let a_ptr c.args.get 0
                        if a_ptr = null
                            return WC_FROZEN
                        let inner a_ptr.unwrap()
                        return this.value_frozen(inner) | (this.mask_of(inner) & WC_FROZEN)
                    }
                    let slot this.callee_index(c.mangled_name)
                    if slot = 0
                        return WC_FROZEN
                    let callee_ptr plan_functions.get(slot - 1)
                    if callee_ptr = null
                        return WC_FROZEN
                    if callee_ptr.unwrap().name = "init"
                        return 0
                    if (slot - 1) >= returns_fresh.length
                        return WC_FROZEN
                    if returns_fresh[slot - 1] <> 0
                        return 0
                    return WC_FROZEN
                }
                else
                    return WC_FROZEN
        }

        function mask_of_base(this: WriteCensus, op: PlannedOperand) returns u64
        {
            choose op.expr
                when v: Variable
                    return this.name_mask(v.name)
                when g: GlobalRef
                    return WC_GLOBAL
                when a: As
                {
                    if a.value = null
                        return 0
                    let r a.value
                    return this.mask_of((*r))
                }
                when c: Call
                {
                    ; a getter's result IS the global it returns
                    var getter: u64 0
                    if ret_globals.length > 0
                    {
                        let slot this.callee_index(c.mangled_name)
                        if slot > 0
                            if slot <= ret_globals.length
                            {
                                let rg ret_globals[slot - 1]
                                if rg.get_length() > 0
                                    getter := WC_GLOBAL
                            }
                    }
                    if c.args = null
                        return getter
                    if c.name = "*"
                        return this.mask_of_operands(c.args)
                    ; what C hands back is C's, not an alias of an argument
                    let census pc as ref[PointerCensus]
                    if census.is_extern_name(c.mangled_name)
                        return 0
                    if WriteCensus.is_scalar(op.result_type) and op.member_access = null
                        return 0
                    ; a call result may alias the arguments its callee's
                    ; returns reach (call_result_mask), but whether it is frozen
                    ; is decided by its OWN type (mask_of): `node_link_of(node)`
                    ; answers the checker's row, not the node
                    return (this.call_alias_mask(c, false) & (0 - (WC_FROZEN + (1 as u64)))) | getter
                }
                when tp: Tuple
                {
                    var m: u64 0
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                m := m | this.mask_of_operands(c_ptr.value)
                            i := i + 1
                        }
                    }
                    return m
                }
                else
                    return 0
        }

        ; ================================================================
        ; Sites.
        ; ================================================================

        procedure hit(mutable this: WriteCensus, offset: size_t, cls: String, whole_mask: u64, detail: String)
        {
            ; an initializer's own `this` is the object it builds
            var mask whole_mask
            if cur_name = "init"
            {
                ; its own `this` -- and so the frozen mark that came with it
                if (mask & (1 as u64)) <> (0 as u64)
                    mask := mask & (0 - (WC_FROZEN + (1 as u64)))
                mask := mask & ((0 as u64) - (2 as u64))
            }
            if cur_substrate
                mask := mask & (WC_GLOBAL - (1 as u64))
            ; a global reached through an alias: written, but not by name (a
            ; direct store and a call name theirs at the site)
            if (mask & WC_GLOBAL) <> (0 as u64)
                if cls <> "w-global"
                    if cls <> "w-call"
                    {
                        if pending_global.get_length() > 0
                            this.note_global_named(pending_global)
                        else
                            this.note_global_id(WC_GW * 64 - 1)
                        this.note_global_site(offset, pending_global, String(""))
                    }
            pending_global := String^this("")
            if check_mode
                mask := mask & (0 - (cur_page_mask + (1 as u64)))
            if mask = 0
                return
            body_mask := body_mask | mask
            if cls <> "w-call"
                body_direct := true
            if reporting = false
                return
            if frozen_mode
            {
                if (mask & WC_FROZEN) = 0
                    return
                n_frozen_sites := n_frozen_sites + 1
                if lock_depth > 0
                    n_locked_sites := n_locked_sites + 1
            }
            var sb StringBuilder()
            if diagnostics
            {
                sb.append "note: writes "
                sb.append(this.mask_names(mask))
                if detail.get_length() > 0
                {
                    sb.append " "
                    sb.append detail
                }
            }
            else
            {
                sb.append cls
                sb.append " "
                sb.append cur_name
                sb.append " writes "
                sb.append(this.mask_names(mask))
                if detail.get_length() > 0
                {
                    sb.append " "
                    sb.append detail
                }
            }
            if frozen_mode and lock_depth > 0
                sb.append " locked"
            let text sb.to_string()
            this.record(offset, String^this(text))
            n_sites := n_sites + 1
        }

        ; The page a Reference lifetime names, as a mask.
        procedure note_life(mutable this: WriteCensus, offset: size_t, life: Lifetime, cls: String)
        {
            choose life
                when r: Reference
                {
                    pending_global := this.local_global(r.location)
                    this.hit(offset, cls, this.name_mask(r.location), WriteCensus.join("^", r.location))
                }
                else
                    0
        }

        ; The index + 1 of a callee in plan.functions (0: none), read off the
        ; pointer census's table, which prefers a body over a stub.
        function callee_index(this: WriteCensus, mangled: String) returns size_t
        {
            if plan_functions = null
                return 0
            if mangled.get_length() = 0
                return 0
            let census pc as ref[PointerCensus]
            let mask (262144 as size_t) - 1
            var h mangled.hash() & mask
            var probes: size_t 0
            while probes < mask
            {
                let slot_ptr census.fn_slots.get h
                if slot_ptr = null
                    return 0
                let slot (*slot_ptr)
                if slot = 0
                    return 0
                let cand plan_functions.get(slot - 1)
                if cand <> null and cand.unwrap().mangled_name = mangled
                    return slot
                h := (h + 1) & mask
                probes := probes + 1
            }
            0
        }

        ; A call: the callee's body in this root, else a summary another
        ; root wrote (SCALYC_WRITE_SUMMARIES), else a real C extern.
        procedure note_call(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall)
        {
            if call.name = "enter_shared"
                lock_depth := lock_depth + 1
            if call.name = "leave_shared"
                lock_depth := lock_depth - 1
            this.note_life(op.loc.start, call.life, String("a-construct"))
            let slot this.callee_index(call.mangled_name)
            if rp_pass
                if slot > 0
                {
                    rp_from.add(cur_fn)
                    rp_to.add(slot - 1)
                }
            if edge_mode
            {
                if slot > 0
                {
                    if lock_depth <= 0
                    {
                        if reach[slot - 1] = 0
                        {
                            reach.put(slot - 1, 1)
                            queue.add(slot - 1)
                        }
                    }
                }
            }
            if frozen_pass
                this.pass_frozen_args(call, slot)
            this.note_call_io(op, call, slot)
            this.note_call_reads(op, call, slot)
            if call.args = null
                return
            if check_mode
            {
                this.check_call(op, call, slot)
                return
            }
            var stub false
            if slot > 0
            {
                let stub_ptr plan_functions.get(slot - 1)
                if stub_ptr <> null
                {
                    choose stub_ptr.unwrap().impl
                        when e: Extern
                            stub := true
                        else
                            0
                }
            }
            if slot > 0
            {
                if stub = false
                {
                    let callee_ptr plan_functions.get(slot - 1)
                    if callee_ptr = null
                        return
                    let callee callee_ptr.unwrap()
                    var n_in: size_t 0
                    if callee.input <> null
                        n_in := callee.input.length
                    this.apply_callee(op, call, masks[slot - 1], callee.name, n_in, slot)
                    return
                }
            }
            if call.is_intrinsic
            {
                if WriteCensus.is_simd_store(call.name)
                    this.note_extern_call(op, call)
                return
            }
            if call.is_operator
                return
            let census pc as ref[PointerCensus]
            if census.is_extern_name(call.mangled_name)
            {
                this.note_extern_call(op, call)
                return
            }
            ; a Scaly body of ANOTHER package: its own root's verdict
            let row this.summary_index(call.mangled_name)
            if row = 0
            {
                if stub
                    n_stub_unknown := n_stub_unknown + 1
                return
            }
            n_stub_known := n_stub_known + 1
            if (sum_masks[row - 1] & WC_GLOBAL) <> (0 as u64) and cur_substrate = false
                this.note_global_list(sum_globals[row - 1])
            this.apply_callee(op, call, sum_masks[row - 1], call.name, sum_inputs[row - 1], WC_NOTED)
        }

        ; The written parameters of a callee, mapped onto this call's arguments.
        procedure apply_callee(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall, callee_mask: u64, callee_name: String, n_in: size_t, slot: size_t)
        {
            if callee_mask = 0
                return
            ; the callee's own globals, by name (another root's body: unnamed)
            if (callee_mask & WC_GLOBAL) <> (0 as u64)
                if cur_substrate = false
                {
                    if slot = 0
                        this.note_global_id(WC_GW * 64 - 2)
                    else if slot <> WC_NOTED
                        this.union_callee_globals(slot - 1)
                }
            if call.args = null
                return
            ; a construction passes no receiver while its initializer's
            ; input starts with `this` -- the NEW object, never a write
            ; to anything the caller holds
            var shift: size_t 0
            if callee_name = "init" and n_in = call.args.length + 1
                shift := 1
            if n_in <> call.args.length + shift
            {
                n_misaligned := n_misaligned + 1
                if reporting
                    this.record(op.loc.start, String^this(WriteCensus.join("misaligned -> ", callee_name)))
            }
            var m: u64 callee_mask & WC_GLOBAL
            var i: size_t 0
            while i < call.args.length
            {
                let pi i + shift
                var bit: u64 WC_OVERFLOW
                if pi < 61
                    bit := (1 as u64) << (pi as u64)
                if (callee_mask & bit) <> (0 as u64)
                {
                    let a_ptr call.args.get i
                    if a_ptr <> null
                    {
                        let am this.mask_of(a_ptr.unwrap())
                        m := m | am
                        if (am & WC_GLOBAL) <> (0 as u64) and cur_substrate = false
                            this.note_global_named(this.global_root_m(a_ptr.unwrap()))
                    }
                }
                i := i + 1
            }
            this.hit(op.loc.start, String("w-call"), m, WriteCensus.join("-> ", callee_name))
        }

        ; ================================================================
        ; The FROZEN mode (SCALYC_WRITE_FROZEN + SCALYC_WRITE_ENTRY): which
        ; writes reach data of a type that is shared once a phase is over --
        ; tscaly's AST, symbols and binders after binding -- in everything
        ; reachable from the entries, procedures included. A value reaches
        ; frozen data when its type, or the parent of any hop of its member
        ; chain, is frozen: DEEP, so a container held in a frozen record is
        ; frozen too. Calls made between `enter_shared()` and
        ; `leave_shared()` are tagged `locked` and not followed.
        ; ================================================================

        ; `a,b,*Data` -> patterns; exact, `*Suffix` or `Prefix*`.
        procedure split_list(mutable this: WriteCensus, text: String, mutable into: ref[Array[String]])
        {
            let n text.get_length()
            var start: size_t 0
            var i: size_t 0
            while i <= n
            {
                var cut false
                if i = n
                    cut := true
                else
                {
                    if text.get(i) = 44
                        cut := true
                }
                if cut
                {
                    if i > start
                        into.add(String^this(text.substring(start, i - start)))
                    start := i + 1
                }
                i := i + 1
            }
        }

        procedure load_frozen(mutable this: WriteCensus)
        {
            let fz getenv("SCALYC_WRITE_FROZEN")
            let en getenv("SCALYC_WRITE_ENTRY")
            if fz = null
                return
            if en = null
                return
            this.split_list(String(fz), &frozen_names)
            this.split_list(String(en), &entry_names)
            frozen_mode := true
        }

        ; The concept a (possibly Option/ref/pointer-wrapped) type names,
        ; last dotted segment only.
        function core_name(t: PlannedType) returns String
        {
            var cur t
            var depth 0
            while depth < 4
            {
                var peeled false
                if (cur.name = "Option") or (cur.name = "ref") or (cur.name = "pointer")
                {
                    if cur.generics <> null
                    {
                        if cur.generics.length = 1
                        {
                            let g_ptr cur.generics.get 0
                            if g_ptr <> null
                            {
                                cur := g_ptr.unwrap()
                                peeled := true
                            }
                        }
                    }
                }
                if peeled = false
                    break
                depth := depth + 1
            }
            let dot cur.name.last_index_of(46)
            if dot < 0
                return String(cur.name)
            let start (dot + 1) as size_t
            cur.name.substring(start, cur.name.get_length() - start)
        }

        ; A VALUE reaches frozen memory when it is a reference (ref/pointer,
        ; optional or not) to a frozen record -- exactly one indirection. A
        ; slot (`pointer[ref[AstNode]]`) is the holder's memory, and a record
        ; held BY VALUE is a copy.
        function is_frozen_type(this: WriteCensus, t: PlannedType) returns bool
        {
            if frozen_mode = false
                return false
            var cur t
            if cur.name = "Option"
                cur := WriteCensus.first_generic(cur)
            if (cur.name <> "ref") and (cur.name <> "pointer")
                return false
            let inner WriteCensus.first_generic(cur)
            if (inner.name = "ref") or (inner.name = "pointer") or (inner.name = "Option")
                return false
            this.is_frozen_record(inner)
        }

        function first_generic(t: PlannedType) returns PlannedType
        {
            if t.generics = null
                return t
            if t.generics.length <> 1
                return t
            let g_ptr t.generics.get 0
            if g_ptr = null
                return t
            g_ptr.unwrap()
        }

        ; The record itself is frozen (a hop's parent: the memory a member
        ; access reads or writes in place).
        function is_frozen_record(this: WriteCensus, t: PlannedType) returns bool
        {
            if frozen_mode = false
                return false
            let n WriteCensus.core_name(t)
            if n.get_length() = 0
                return false
            var i: size_t 0
            while i < frozen_names.length
            {
                let p frozen_names[i]
                let k p.get_length()
                if p = n
                    return true
                if k > 1
                {
                    if p.get(0) = 42
                    {
                        if n.ends_with(p.substring(1, k - 1))
                            return true
                    }
                    if p.get(k - 1) = 42
                    {
                        if n.starts_with(p.substring(0, k - 1))
                            return true
                    }
                }
                i := i + 1
            }
            false
        }

        ; FROZEN when any hop of the operand's member chain leaves a frozen record.
        function hops_frozen(this: WriteCensus, op: PlannedOperand) returns u64
        {
            if frozen_mode = false
                return 0
            if op.member_access = null
                return 0
            ; the first hop writes the BASE's own memory: frozen only when the base
            ; value is (a record local held BY VALUE is a copy; a fresh object or a
            ; parameter no caller hands frozen data is the caller's own)
            var i: size_t 0
            choose op.expr
                when v: Variable
                {
                    if this.is_by_value_local(v)
                        i := 1
                    else
                    {
                        if (this.name_mask(v.name) & WC_FROZEN) = 0
                            i := 1
                    }
                }
                when c: Call
                {
                    if this.value_frozen(op) = 0
                        i := 1
                }
                else
                    0
            while i < op.member_access.length
            {
                let h_ptr op.member_access.get i
                if h_ptr <> null and this.is_frozen_record(h_ptr.unwrap().parent_type)
                    return WC_FROZEN
                i := i + 1
            }
            0
        }

        function is_reference_name(n: String) returns bool
        {
            if n = "ref" or n = "pointer"
                return true
            n = "Option"
        }

        function is_by_value_local(this: WriteCensus, v: PlannedVariable) returns bool
        {
            let t v.variable_type
            if (t.name = "ref") or (t.name = "pointer") or (t.name = "Option")
                return false
            var li loc_names.length
            while li > 0
            {
                li := li - 1
                let n loc_names.get li
                if n <> null and (*n) = v.name
                    return true
            }
            false
        }

        ; `Checker.get_diagnostics` for a method, the bare name otherwise.
        function entry_key(this: WriteCensus, func: PlannedFunction) returns String
        {
            if func.input <> null
            {
                if func.input.length > 0
                {
                    let it_ptr func.input.get 0
                    if it_ptr <> null
                    {
                        let it it_ptr.unwrap()
                        var is_this true
                        if it.name <> null
                            is_this := (*it.name) = "this"
                        if is_this
                        {
                            if it.item_type <> null
                            {
                                var sb StringBuilder()
                                sb.append(WriteCensus.core_name((*it.item_type)))
                                sb.append "."
                                sb.append func.name
                                return sb.to_string()
                            }
                        }
                    }
                }
            }
            String(func.name)
        }

        function is_entry(this: WriteCensus, func: PlannedFunction) returns bool
        {
            let key this.entry_key(func)
            var i: size_t 0
            while i < entry_names.length
            {
                if entry_names[i] = key
                    return true
                i := i + 1
            }
            false
        }

        procedure mark_returns_frozen(mutable this: WriteCensus)
        {
            if cur_fn >= returns_fresh.length
                return
            if returns_fresh[cur_fn] = 0
                return
            returns_fresh.put(cur_fn, 0)
            fz_changed := true
        }

        ; Is the value a body ends with (its tail expression) frozen? Follows a
        ; block to its last statement and both arms of an `if`.
        function tail_frozen(this: WriteCensus, act: PlannedAction) returns bool
        {
            if act.target <> null
                return false
            if act.source = null
                return false
            if act.source.length = 0
                return false
            let last_ptr act.source.get(act.source.length - 1)
            if last_ptr = null
                return false
            let last last_ptr.unwrap()
            choose last.expr
                when blk: Block
                {
                    if blk.statements = null
                        return false
                    if blk.statements.length = 0
                        return false
                    let s_ptr blk.statements.get(blk.statements.length - 1)
                    if s_ptr = null
                        return false
                    return this.statement_tail_frozen(s_ptr)
                }
                when iff: If
                {
                    if this.statement_tail_frozen(iff.consequent)
                        return true
                    return this.statement_tail_frozen(iff.alternative)
                }
                else
                    return (this.mask_of(last) & WC_FROZEN) <> (0 as u64)
        }

        function statement_tail_frozen(this: WriteCensus, stmt: ref[PlannedStatement]?) returns bool
        {
            if stmt = null
                return false
            let st stmt as ref[PlannedStatement]
            choose st
                when a: Action
                    return this.tail_frozen(a)
                else
                    return false
        }

        ; A call hands frozen data to the callee's parameters it fills.
        procedure pass_frozen_args(mutable this: WriteCensus, call: PlannedCall, slot: size_t)
        {
            if slot = 0
                return
            if call.args = null
                return
            let callee_ptr plan_functions.get(slot - 1)
            if callee_ptr = null
                return
            let callee callee_ptr.unwrap()
            var n_in: size_t 0
            if callee.input <> null
                n_in := callee.input.length
            var shift: size_t 0
            if callee.name = "init" and n_in = call.args.length + 1
                shift := 1
            let idx slot - 1
            if idx >= param_frozen.length
                return
            var bits param_frozen[idx]
            var i: size_t 0
            while i < call.args.length
            {
                let a_ptr call.args.get i
                if a_ptr <> null
                {
                    if (this.mask_of(a_ptr.unwrap()) & WC_FROZEN) <> (0 as u64)
                    {
                        let pi i + shift
                        var bit: u64 WC_OVERFLOW
                        if pi < 61
                            bit := (1 as u64) << (pi as u64)
                        bits := bits | bit
                    }
                }
                i := i + 1
            }
            if bits <> param_frozen[idx]
            {
                param_frozen.put(idx, bits)
                fz_changed := true
            }
        }

        ; The entries' parameters are frozen by their TYPE.
        function entry_param_bits(this: WriteCensus, func: PlannedFunction) returns u64
        {
            if func.input = null
                return 0
            var bits: u64 0
            var i: size_t 0
            while i < func.input.length
            {
                let it_ptr func.input.get i
                if it_ptr <> null
                {
                    let it it_ptr.unwrap()
                    if it.item_type <> null
                    {
                        if this.is_frozen_type((*it.item_type))
                        {
                            if i < 61
                                bits := bits | ((1 as u64) << (i as u64))
                            else
                                bits := bits | WC_OVERFLOW
                        }
                    }
                }
                i := i + 1
            }
            bits
        }

        ; Breadth-first over the call edges from the entries (edge_mode walks),
        ; then the sites of every reachable body.
        procedure report_frozen(mutable this: WriteCensus)
        {
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                reach.add(0)
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    if this.is_entry(f_ptr.unwrap())
                    {
                        reach.put(i, 1)
                        queue.add i
                    }
                }
                i := i + 1
            }
            edge_mode := true
            var head: size_t 0
            while head < queue.length
            {
                let idx queue[head]
                head := head + 1
                cur_fn := idx
                let f_ptr fns.get idx
                if f_ptr <> null
                    this.walk_body(f_ptr.unwrap())
            }
            edge_mode := false
            ; provenance: parameters by their callers, results by their returns
            i := 0
            while i < fns.length
            {
                var bits: u64 0
                let f_ptr fns.get i
                if f_ptr <> null and this.is_entry(f_ptr.unwrap())
                    bits := this.entry_param_bits(f_ptr.unwrap())
                param_frozen.add bits
                returns_fresh.add 1
                i := i + 1
            }
            frozen_pass := true
            fz_changed := true
            while fz_changed
            {
                fz_changed := false
                n_fz_rounds := n_fz_rounds + 1
                var r: size_t 0
                while r < queue.length
                {
                    let idx queue[r]
                    r := r + 1
                    cur_fn := idx
                    let f_ptr fns.get idx
                    if f_ptr <> null
                        this.walk_body(f_ptr.unwrap())
                }
                if n_fz_rounds >= 60
                    fz_changed := false
            }
            frozen_pass := false
            reporting := true
            n_reachable := queue.length
            var q: size_t 0
            while q < queue.length
            {
                let idx queue[q]
                q := q + 1
                let f_ptr fns.get idx
                if f_ptr <> null
                {
                    let func f_ptr.unwrap()
                    let census pc as ref[PointerCensus]
                    let home census.resolve_body_file(func)
                    if home.get_length() > 0
                    {
                        current_file := String^this(home)
                        cur_fn := idx
                        this.walk_body(func)
                    }
                    else
                        n_unfiled := n_unfiled + 1
                }
            }
        }

        ; ================================================================
        ; The CHECK mode (`--purity-check`, R1 step 2): a `function` may not
        ; write what its parameters reach. Local and compositional, because
        ; after R1 step 1 the keyword is honest: a callee `function` is
        ; TRUSTED, a `procedure` may write every non-scalar argument it is
        ; handed, an extern writes what extern_writes says. Across a package
        ; the keyword comes from the MODEL (a name any `procedure` carries is
        ; a procedure), so no summary of another root is needed. Explicit page
        ; parameters are the result region and exempt, as the caller page is.
        ; ================================================================

        procedure collect_purity_module(mutable this: WriteCensus, m: Module)
            this.collect_purity_module_in(m, String(""))

        procedure collect_purity_module_in(mutable this: WriteCensus, m: Module, owner: String)
        {
            this.collect_purity_members(m.members, owner)
            var i: size_t 0
            while i < m.modules.length
            {
                let sub m.modules.get i
                if sub <> null
                    this.collect_purity_module_in((*sub), owner)
                i := i + 1
            }
        }

        procedure collect_purity_members(mutable this: WriteCensus, members: Vector[Member], owner: String)
        {
            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    let mem (*m_ptr)
                    choose mem
                        when f: Function
                        {
                            ; keyed by owner as well as bare: a stub names its
                            ; owner only through its mangled name
                            let marks WriteCensus.model_writable_mask(f.input)
                            let gl WriteCensus.join_names(f.writes)
                            this.note_purity(WriteCensus.purity_key(f.name, f.input.length), f.pure, marks, gl)
                            this.note_purity(WriteCensus.owned_key(owner, f.name, f.input.length), f.pure, marks, gl)
                            var linked_decl false
                            choose f.implementation
                                when lk: Linked
                                    linked_decl := true
                                else
                                    0
                            if linked_decl
                            {
                                var key WriteCensus.purity_key(f.name, f.input.length)
                                if owner.get_length() > 0
                                    key := WriteCensus.owned_key(owner, f.name, f.input.length)
                                if f.read_globals.length > 0
                                {
                                    let first f.read_globals[0]
                                    decl_read_keys.add(String^this(key))
                                    decl_read_vals.add(String^this(first))
                                }
                                var says_io false
                                var wi: size_t 0
                                while wi < f.writes.length
                                {
                                    if f.writes[wi] = "io"
                                        says_io := true
                                    wi := wi + 1
                                }
                                if says_io
                                    decl_io_keys.add(String^this(key))
                            }
                        }
                        when c: Concept
                        {
                            choose c.definition
                                when st: Structure
                                {
                                    this.collect_purity_members(st.members, c.name)
                                    var mi: size_t 0
                                    while mi < st.modules.length
                                    {
                                        let sub st.modules.get mi
                                        if sub <> null
                                            this.collect_purity_module_in((*sub), c.name)
                                        mi := mi + 1
                                    }
                                }
                                when un: Union
                                    this.collect_purity_members(un.members, c.name)
                                when ns: Namespace
                                {
                                    this.collect_purity_members(ns.members, c.name)
                                    var mi: size_t 0
                                    while mi < ns.modules.length
                                    {
                                        let sub ns.modules.get mi
                                        if sub <> null
                                            this.collect_purity_module_in((*sub), c.name)
                                        mi := mi + 1
                                    }
                                }
                                else
                                    0
                        }
                        else
                            0
                }
                i := i + 1
            }
        }

        ; 1: every declaration of the name is a function; 2: one is a procedure.
        ; The `mutable` positions of every declaration of the name are OR-ed.
        procedure note_purity(mutable this: WriteCensus, name: String, pure: bool, writable: u64, globals: String)
        {
            var state: u64 1
            if pure = false
                state := 2
            let row this.summary_index(name)
            if row > 0
            {
                if state > sum_masks[row - 1]
                    sum_masks.put(row - 1, state)
                sum_inputs.put(row - 1, sum_inputs[row - 1] | (writable as size_t))
                ; overloads of one key: every declared global counts
                if globals.get_length() > 0
                {
                    let had sum_globals[row - 1]
                    if had.get_length() = 0
                        sum_globals.put(row - 1, String^this(globals))
                    else
                    {
                        let both WriteCensus.join(WriteCensus.join(had, String(",")), globals)
                        sum_globals.put(row - 1, String^this(both))
                    }
                }
                return
            }
            this.add_summary(String^this(name), state, writable as size_t, String^this(globals))
        }

        function join_names(names: Vector[String]) returns String
        {
            var sb StringBuilder()
            var i: size_t 0
            while i < names.length
            {
                if i > 0
                    sb.append ","
                sb.append(names[i])
                i := i + 1
            }
            sb.to_string()
        }

        ; the runtime's globals, from the Model: declared in scaly/memory,
        ; scaly/fiber, scaly/os or scaly/cluster
        procedure collect_ambient_module(mutable this: WriteCensus, m: Module, inside: bool)
        {
            var here inside
            if m.file.contains(String("/scaly/memory/"))
                here := true
            if m.file.contains(String("/scaly/fiber"))
                here := true
            if m.file.contains(String("/scaly/os"))
                here := true
            if m.file.contains(String("/scaly/cluster"))
                here := true
            this.collect_ambient_members(m.members, here)
            var k: size_t 0
            while k < m.modules.length
            {
                let sub m.modules.get k
                if sub <> null
                    this.collect_ambient_module((*sub), here)
                k := k + 1
            }
        }

        ; globals sit in a module's members and in a namespace's or a
        ; structure's, whose sub-modules are walked the same way
        procedure collect_ambient_members(mutable this: WriteCensus, members: Vector[Member], here: bool)
        {
            var i: size_t 0
            while i < members.length
            {
                let m_ptr members.get i
                if m_ptr <> null
                {
                    choose (*m_ptr)
                        when c: Concept
                        {
                            choose c.definition
                                when g: Global
                                {
                                    if g.is_mutable
                                        mutable_names.add(String^this(c.name))
                                    else if g.is_atomic
                                        mutable_names.add(String^this(c.name))
                                    if g.is_atomic
                                        atomic_names.add(String^this(c.name))
                                    else if here
                                        if g.is_mutable
                                            ambient_names.add(String^this(c.name))
                                }
                                when ns: Namespace
                                {
                                    this.collect_ambient_members(ns.members, here)
                                    var k: size_t 0
                                    while k < ns.modules.length
                                    {
                                        let sub ns.modules.get k
                                        if sub <> null
                                            this.collect_ambient_module((*sub), here)
                                        k := k + 1
                                    }
                                }
                                when st: Structure
                                {
                                    this.collect_ambient_members(st.members, here)
                                    var k: size_t 0
                                    while k < st.modules.length
                                    {
                                        let sub st.modules.get k
                                        if sub <> null
                                            this.collect_ambient_module((*sub), here)
                                        k := k + 1
                                    }
                                }
                                else
                                    0
                        }
                        when pk: Package
                        {
                            var k: size_t 0
                            while k < pk.length
                            {
                                let sub pk.get k
                                if sub <> null
                                    this.collect_ambient_module((*sub), here)
                                k := k + 1
                            }
                        }
                        else
                            0
                }
                i := i + 1
            }
        }

        function is_atomic_name(this: WriteCensus, name: String) returns bool
        {
            var i: size_t 0
            while i < atomic_names.length
            {
                if atomic_names[i] = name
                    return true
                i := i + 1
            }
            false
        }

        function is_ambient(this: WriteCensus, name: String) returns bool
        {
            if this.is_atomic_name(name)
                return true
            var i: size_t 0
            while i < ambient_names.length
            {
                if ambient_names[i] = name
                    return true
                i := i + 1
            }
            false
        }

        function global_allowed(this: WriteCensus, name: String) returns bool
        {
            if cur_allowed_g = null
                return false
            let al cur_allowed_g as ref[Vector[String]]
            var i: size_t 0
            while i < al.length
            {
                if al[i] = name
                    return true
                i := i + 1
            }
            false
        }

        ; check mode, the note walk: a `note:` where an undeclared global is
        ; written ("" names a global reached through an alias)
        procedure note_global_site(mutable this: WriteCensus, offset: size_t, name: String, callee: String)
        {
            if check_mode = false
                return
            if diagnostics = false
                return
            if reporting = false
                return
            var atomic_write false
            if name.get_length() > 0
            {
                if this.is_atomic_name(name)
                {
                    if in_atomic_op
                        return
                    atomic_write := true
                }
                else
                {
                    if this.is_ambient(name)
                        return
                    if this.global_allowed(name)
                        return
                }
            }
            var sb StringBuilder()
            if name = "io"
                sb.append "note: performs I/O"
            else if atomic_write
            {
                sb.append "note: writes atomic global "
                sb.append name
                sb.append " without scaly_atomic_*"
            }
            else if name.get_length() > 0
            {
                sb.append "note: writes global "
                sb.append name
            }
            else
                sb.append "note: writes a global through an alias the check cannot name"
            if callee.get_length() > 0
            {
                sb.append " -> "
                sb.append callee
            }
            let text sb.to_string()
            this.record(offset, String^this(text))
        }

        ; the names in cur_g a body may not write ("?alias" for the unnamed)
        function bad_globals(this: WriteCensus) returns String
        {
            var sb StringBuilder()
            var any false
            var id: size_t 0
            while id < WC_GW * 64
            {
                let w id / 64
                if (cur_g[w] & ((1 as u64) << ((id - w * 64) as u64))) <> (0 as u64)
                {
                    var name String("")
                    var bad true
                    if id < gnames.length
                    {
                        name := gnames[id]
                        if this.is_ambient(name)
                            bad := false
                        if this.global_allowed(name)
                            bad := false
                        if name = "io"
                            bad := false
                    }
                    if bad
                    {
                        if any
                            sb.append ", "
                        any := true
                        if name.get_length() > 0
                            sb.append name
                        else
                            sb.append "(a global reached through an alias)"
                    }
                }
                id := id + 1
            }
            sb.to_string()
        }

        ; does the body reach I/O its declaration does not name?
        function bad_io(this: WriteCensus) returns bool
        {
            ; a procedure may reach I/O without saying so; a function and an
            ; initializer may not
            if cur_pure = false and cur_name <> "init"
                return false
            var id: size_t 0
            while id < gnames.length
            {
                if gnames[id] = "io"
                {
                    let w id / 64
                    if (cur_g[w] & ((1 as u64) << ((id - w * 64) as u64))) = (0 as u64)
                        return false
                    return this.global_allowed(String("io")) = false
                }
                id := id + 1
            }
            false
        }

        ; a stub's row: its OWNER's declarations of that name and arity (the
        ; owner read off the mangled name), else every owner's
        function stub_row(this: WriteCensus, call: PlannedCall) returns size_t
        {
            let n_args call.args.length
            let owner WriteCensus.mangled_owner(call.mangled_name)
            if owner.get_length() > 0
            {
                let row this.summary_index(WriteCensus.owned_key(owner, call.name, n_args))
                if row > 0
                    return row
            }
            this.summary_index(WriteCensus.purity_key(call.name, n_args))
        }

        ; After the gate passed: every stub of another package's body carries
        ; its declaration's keyword into the plan. The planner records a stub
        ; as a procedure whatever it calls, so without this the TaskPlanner
        ; could trust `function` only for bodies it can see. An overloaded
        ; key counts as a function only if every overload is one.
        procedure mark_stub_purity(this: WriteCensus, mutable plan: Plan)
        {
            if plan.functions = null
                return
            let fns plan.functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                let f_ptr fns.get i
                i := i + 1
                if f_ptr = null
                    continue
                let f f_ptr.unwrap()
                if f.pure
                    continue
                var stub false
                choose f.impl
                    when e: Extern
                        stub := true
                    else
                        0
                if stub = false
                    continue
                if f.mangled_name.starts_with(String("_Z")) = false
                    continue
                var n_in: size_t 0
                if f.input <> null
                    n_in := f.input.length
                var row: size_t 0
                let owner WriteCensus.mangled_owner(f.mangled_name)
                if owner.get_length() > 0
                    row := this.summary_index(WriteCensus.owned_key(owner, f.name, n_in))
                if row = 0
                    row := this.summary_index(WriteCensus.purity_key(f.name, n_in))
                if row = 0
                    continue
                if sum_masks[row - 1] <> (1 as u64)
                    continue
                var g f
                g.pure := true
                fns.put(i - 1, g)
            }
        }

        function owned_key(owner: String, name: String, arity: size_t) returns String
        {
            var sb StringBuilder()
            sb.append owner
            sb.append "."
            sb.append name
            sb.append "/"
            sb.append arity
            sb.to_string()
        }

        ; `_ZN13StringBuilder6appendEc` -> StringBuilder: the component before
        ; the last of an Itanium nested name ("" for a name that is not nested)
        function mangled_owner(m: String) returns String
        {
            let n m.get_length()
            if n < 4
                return String("")
            if m.get(0) <> 95
                return String("")
            if m.get(1) <> 90
                return String("")
            if m.get(2) <> 78
                return String("")
            var i: size_t 3
            var prev String("")
            var last String("")
            while i < n
            {
                let c m.get i
                if c = 69
                    break
                if (c >= 48) and (c <= 57)
                {
                    var len: size_t 0
                    while i < n
                    {
                        let d m.get i
                        if (d < 48) or (d > 57)
                            break
                        len := len * 10 + ((d - 48) as size_t)
                        i := i + 1
                    }
                    var sb StringBuilder()
                    var k: size_t 0
                    while k < len
                    {
                        if i + k < n
                            sb.append(m.get(i + k) as char)
                        k := k + 1
                    }
                    i := i + len
                    prev := last
                    last := sb.to_string()
                }
                else if c = 73
                {
                    ; template arguments: skip, length-prefixed names included
                    var depth: size_t 1
                    i := i + 1
                    while i < n
                    {
                        if depth = 0
                            break
                        let d m.get i
                        if (d >= 48) and (d <= 57)
                        {
                            var len: size_t 0
                            while i < n
                            {
                                let e m.get i
                                if (e < 48) or (e > 57)
                                    break
                                len := len * 10 + ((e - 48) as size_t)
                                i := i + 1
                            }
                            i := i + len
                        }
                        else
                        {
                            if d = 73
                                depth := depth + 1
                            if d = 69
                                depth := depth - 1
                            i := i + 1
                        }
                    }
                }
                else
                    break
            }
            prev
        }

        ; the name table's key: overloads of one name and arity share a row,
        ; their marks OR-ed (a stub carries no signature to tell them apart)
        function purity_key(name: String, arity: size_t) returns String
        {
            var sb StringBuilder()
            sb.append name
            sb.append "/"
            sb.append arity
            sb.to_string()
        }

        ; the positions of a declaration's `mutable` parameters (R1)
        function model_writable_mask(items: Vector[Item]) returns u64
        {
            var m: u64 0
            var i: size_t 0
            while i < items.length
            {
                let it_ptr items.get i
                if it_ptr <> null
                {
                    let it (*it_ptr)
                    var k: size_t 0
                    while k < it.attributes.length
                    {
                        let a_ptr it.attributes.get k
                        if a_ptr <> null and (*a_ptr).name = "mutable" and i < 61
                            m := m | ((1 as u64) << (i as u64))
                        k := k + 1
                    }
                }
                i := i + 1
            }
            m
        }

        function planned_writable_mask(items: ref[Vector[PlannedItem]]?) returns u64
        {
            if items = null
                return 0
            var m: u64 0
            var i: size_t 0
            while i < items.length
            {
                let it_ptr items.get i
                if it_ptr <> null
                {
                    let it it_ptr.unwrap()
                    if it.attributes <> null
                    {
                        let attrs it.attributes as ref[Vector[PlannedAttribute]]
                        var k: size_t 0
                        while k < attrs.length
                        {
                            let a_ptr attrs.get k
                            if a_ptr <> null and a_ptr.unwrap().name = "mutable" and i < 61
                                m := m | ((1 as u64) << (i as u64))
                            k := k + 1
                        }
                    }
                }
                i := i + 1
            }
            m
        }

        ; the parameters of the body walked whose type is a Page
        function page_param_mask(this) returns u64
        {
            if cur_input = null
                return 0
            var m: u64 0
            var i: size_t 0
            while i < cur_input.length
            {
                if i < 61
                {
                    if WriteCensus.core_name_is_page(this.param_type_name(i))
                        m := m | ((1 as u64) << (i as u64))
                }
                i := i + 1
            }
            m
        }

        function core_name_is_page(readable: String) returns bool
        {
            if readable.ends_with(String("Page]"))
                return true
            readable.equals(String("Page"))
        }

        ; A call in a function body under the check: a trusted callee writes nothing.
        procedure check_call(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall, slot: size_t)
        {
            if call.is_intrinsic
            {
                if WriteCensus.is_simd_store(call.name)
                    this.note_extern_call(op, call)
                return
            }
            if call.is_operator
                return
            ; a construction writes its NEW object
            if call.name = "init"
                return
            if call.mangled_name.contains(String("4initE"))
                return
            let census pc as ref[PointerCensus]
            var known false
            var trusted false
            var writable: u64 0
            var callee_writes: ref[Vector[String]]? null
            var stub_globals String("")
            if slot > 0
            {
                let f_ptr plan_functions.get(slot - 1)
                if f_ptr <> null
                {
                    let f f_ptr.unwrap()
                    ; a body of this root carries its declaration's keyword and
                    ; `mutable` marks; the STUB a call into another package's
                    ; body leaves carries neither (always a procedure, no
                    ; attributes), so it is judged by the Model's declarations
                    ; of that name and arity below
                    var declared false
                    choose f.impl
                        when action: Action
                            declared := true
                        else
                            declared := false
                    if declared
                    {
                        known := true
                        trusted := f.pure
                        writable := WriteCensus.planned_writable_mask(f.input)
                        callee_writes := f.writes
                    }
                }
            }
            if known = false
            {
                if census.is_extern_name(call.mangled_name)
                {
                    this.note_extern_call(op, call)
                    return
                }
                let row this.stub_row(call)
                if row > 0
                {
                    if sum_masks[row - 1] = (1 as u64)
                        trusted := true
                    writable := sum_inputs[row - 1] as u64
                    stub_globals := sum_globals[row - 1]
                }
                else
                    n_stub_unknown := n_stub_unknown + 1
            }
            if trusted
                return
            ; the globals the callee declares it writes are written here
            if callee_writes <> null
            {
                let cw callee_writes as ref[Vector[String]]
                var ci: size_t 0
                while ci < cw.length
                {
                    this.note_global_named(cw[ci])
                    this.note_global_site(op.loc.start, cw[ci], call.name)
                    ci := ci + 1
                }
            }
            if stub_globals.get_length() > 0
                this.note_callee_globals(op.loc.start, stub_globals, call.name)
            ; a procedure writes exactly its `mutable` positions; a callee this
            ; root cannot name (an indirect call) may write every argument
            var conservative false
            if known = false and this.stub_row(call) = 0
                conservative := true
            var m: u64 0
            var i: size_t 0
            ; an indirect call's args[0] is the callee pointer: calling it
            ; writes nothing through it
            if call.is_indirect
                i := 1
            while i < call.args.length
            {
                let a_ptr call.args.get i
                var counts conservative
                if conservative = false and i < 61
                    counts := (writable & ((1 as u64) << (i as u64))) <> (0 as u64)
                if a_ptr <> null
                {
                    let a a_ptr.unwrap()
                    if counts
                        if WriteCensus.is_scalar(a.result_type) = false
                            if this.is_local_value(a) = false
                            {
                                let am this.mask_of(a)
                                m := m | am
                                ; a global handed to a written position
                                if (am & WC_GLOBAL) <> (0 as u64)
                                {
                                    let gn this.global_root_m(a)
                                    this.note_global_named(gn)
                                    this.note_global_site(op.loc.start, gn, call.name)
                                }
                            }
                }
                i := i + 1
            }
            this.hit(op.loc.start, String("w-call"), m, WriteCensus.join("-> ", call.name))
        }

        ; A local held BY VALUE (not a reference) is the body's own memory: a
        ; procedure handed it, `it.next()` on an iterator, writes the copy. The
        ; ASSUMPTION, stated: such a procedure does not write through the
        ; pointers the copy carries (an iterator's cursor into its container).
        function is_local_value(this: WriteCensus, a: PlannedOperand) returns bool
        {
            if a.member_access <> null and a.member_access.length > 0
                return false
            choose a.expr
                when v: Variable
                    return this.is_by_value_local(v)
                when c: Call
                {
                    ; `&it`: the address of a by-value local
                    if c.name <> "&"
                        return false
                    if c.args = null
                        return false
                    if c.args.length <> 1
                        return false
                    let inner_ptr c.args.get 0
                    if inner_ptr = null
                        return false
                    return this.is_local_value(inner_ptr.unwrap())
                }
                else
                    return false
        }

        ; The read pre-pass: every body's first changeable global, direct or
        ; through the bodies it calls (a fixpoint over the call edges). A stub
        ; of another package is not followed -- the generated interface files
        ; will carry what it reads.
        procedure learn_reads(mutable this: WriteCensus, fns: ref[Vector[PlannedFunction]])
        {
            var i: size_t 0
            while i < fns.length
            {
                ; a stub starts from what its declaration says it reads
                var declared String("")
                var declared_io String("")
                let f_ptr0 fns.get i
                if f_ptr0 <> null
                {
                    declared := this.declared_reads(f_ptr0.unwrap())
                    if this.stub_declares_io(f_ptr0.unwrap())
                        declared_io := String("its declaration")
                }
                body_reads.add(String^this(declared))
                body_io.add(String^this(declared_io))
                i := i + 1
            }
            read_pass := true
            i := 0
            while i < fns.length
            {
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    read_index := i
                    cur_fn := i
                    this.walk_body(f_ptr.unwrap())
                }
                i := i + 1
            }
            read_pass := false
            var changed true
            while changed
            {
                changed := false
                var e: size_t 0
                while e < edge_from.length
                {
                    let a edge_from[e]
                    let b edge_to[e]
                    let ra body_reads[a]
                    let rb body_reads[b]
                    if ra.get_length() = 0
                    {
                        if rb.get_length() > 0
                        {
                            body_reads.put(a, String^this(rb))
                            changed := true
                        }
                    }
                    let ia body_io[a]
                    let ib body_io[b]
                    if ia.get_length() = 0
                    {
                        if ib.get_length() > 0
                        {
                            let callee_name fns.get b
                            if callee_name <> null
                                body_io.put(a, String^this(callee_name.unwrap().name))
                            changed := true
                        }
                    }
                    e := e + 1
                }
            }
        }

        ; --emit-interface: the first changeable global each planned body of the
        ; root reads (the check's pre-pass), and whether it reaches I/O, keyed
        ; like the planner's facts (Planner.interface_facts#)
        procedure interface_facts(this: WriteCensus, mutable facts: ref[Array[InterfaceFact]])
        {
            if plan_functions = null
                return
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                if i >= body_reads.length
                    break
                let r body_reads[i]
                let f_ptr fns.get i
                i := i + 1
                if f_ptr = null
                    continue
                if r.get_length() = 0
                    continue
                let f f_ptr.unwrap()
                if f.origin <> null
                    continue
                var body false
                choose f.impl
                    when a: Action
                        body := true
                    else
                        0
                if body = false
                    continue
                facts.add(WriteCensus.fact("R" as char, f.file, f.loc.start, r))
            }
            ; and whether it reaches I/O
            i := 0
            while i < fns.length
            {
                if i >= body_io.length
                    break
                let io_how body_io[i]
                let g_ptr fns.get i
                i := i + 1
                if g_ptr = null
                    continue
                if io_how.get_length() = 0
                    continue
                let g g_ptr.unwrap()
                if g.origin <> null
                    continue
                var gbody false
                choose g.impl
                    when a: Action
                        gbody := true
                    else
                        0
                if gbody = false
                    continue
                facts.add(WriteCensus.fact("I" as char, g.file, g.loc.start, String()))
            }
        }

        function fact(tag: char, file: String, start: size_t, text: String) returns InterfaceFact
            InterfaceFact(tag, file, start, start, " " as char, String(), false, false, false, text)

        ; does a stub's declaration (its package's interface) say `io`?
        function stub_declares_io(this: WriteCensus, f: PlannedFunction) returns bool
        {
            var stub false
            choose f.impl
                when e: Extern
                    stub := true
                else
                    0
            if stub = false
                return false
            if f.mangled_name.starts_with(String("_Z")) = false
                return false
            let key this.stub_key(f)
            var i: size_t 0
            while i < decl_io_keys.length
            {
                let k decl_io_keys[i]
                if k = key
                    return true
                i := i + 1
            }
            false
        }

        ; the key a stub's declaration is filed under: its owner as the
        ; mangled name spells it, else its bare name
        function stub_key(this: WriteCensus, f: PlannedFunction) returns String
        {
            var n_in: size_t 0
            if f.input <> null
                n_in := f.input.length
            let owner WriteCensus.mangled_owner(f.mangled_name)
            if owner.get_length() > 0
                return WriteCensus.owned_key(owner, f.name, n_in)
            WriteCensus.purity_key(f.name, n_in)
        }

        ; is `name` an element of a comma-separated list?
        function list_has(list: String, name: Slice[char]) returns bool
        {
            let n list.get_length()
            let k name.length
            var start: size_t 0
            while start <= n
            {
                var stop start
                while stop < n
                {
                    let c list.get(stop)
                    if c = 44                   ; ','
                        break
                    stop := stop + 1
                }
                if stop - start = k
                {
                    var same true
                    var j: size_t 0
                    while j < k
                    {
                        let lc list.get(start + j)
                        let nc name.get(j)
                        if nc <> null and lc <> ((*nc) as u8)
                            same := false
                        j := j + 1
                    }
                    if same
                        return true
                }
                start := stop + 1
            }
            false
        }

        ; what a stub's declaration says it reads ("" none, or not a stub)
        function declared_reads(this: WriteCensus, f: PlannedFunction) returns String
        {
            var stub false
            choose f.impl
                when e: Extern
                    stub := true
                else
                    0
            if stub = false
                return String("")
            if f.mangled_name.starts_with(String("_Z")) = false
                return String("")
            var n_in: size_t 0
            if f.input <> null
                n_in := f.input.length
            let key this.stub_key(f)
            var i: size_t 0
            while i < decl_read_keys.length
            {
                let k decl_read_keys[i]
                if k = key
                    return decl_read_vals[i]
                i := i + 1
            }
            String("")
        }

        ; one walk of every function body; a violation is a write outside the
        ; page parameters
        procedure wc_mark(this: WriteCensus, phase_name: pointer[const_char])
        {
            if getenv("SCALYC_PHASE_TIMES") = null
                return
            scaly_eputs "phase "
            scaly_eputs phase_name
            scaly_eputs " "
            scaly_eputi(scaly_eio_now_ns())
            scaly_eputnl()
        }

        procedure run_check(mutable this: WriteCensus, model: ref[Program])
        {
            this.wc_mark("E0a-run-check-start")
            this.collect_ambient_module(model.module_, false)
            var ai: size_t 0
            while ai < model.packages.length
            {
                let apkg model.packages.get ai
                if apkg <> null
                    this.collect_ambient_module((*apkg), false)
                ai := ai + 1
            }
            this.collect_purity_module(model.module_)
            var pi: size_t 0
            while pi < model.packages.length
            {
                let pkg model.packages.get pi
                if pkg <> null
                    this.collect_purity_module((*pkg))
                pi := pi + 1
            }
            this.wc_mark("E0b-collected-ambient-purity")
            this.learn_returned_params()
            this.wc_mark("E0c-learn-returned-params")
            this.learn_returned_globals()
            this.wc_mark("E0d-learn-returned-globals")
            let fns plan_functions as ref[Vector[PlannedFunction]]
            this.learn_reads(fns)
            this.wc_mark("E0e-learn-reads")
            reporting := true
            var i: size_t 0
            while i < fns.length
            {
                let f_ptr fns.get i
                i := i + 1
                if f_ptr = null
                    continue
                let func f_ptr.unwrap()
                let marked WriteCensus.planned_writable_mask(func.input)
                ; an initializer builds its object and has no other effect: no
                ; global, no I/O -- which is why a construction needs no
                ; declaration at its call sites (check_call trusts `init`)
                let is_init func.name = "init"
                var is_body false
                choose func.impl
                    when action: Action
                        is_body := true
                    else
                        0
                if is_body = false
                    continue
                let census pc as ref[PointerCensus]
                let home census.resolve_body_file(func)
                if home.get_length() = 0
                {
                    n_unfiled := n_unfiled + 1
                    continue
                }
                current_file := String^this(home)
                n_pure := n_pure + 1
                ; globals are judged by NAME (cur_g against the declaration),
                ; never by the parameter mask
                cur_allowed := WC_GLOBAL
                cur_allowed_g := null
                if func.pure = false
                {
                    cur_allowed := marked | WC_GLOBAL
                    cur_allowed_g := func.writes
                }
                if is_init
                {
                    cur_allowed := 0 - (1 as u64)
                    cur_allowed_g := null
                }
                let before n_sites
                cur_let_bad := Array[String]^this()
                cur_let_offsets := Array[size_t]^this()
                ; as a gate: judge first, then walk the violating body again to
                ; place a note at every write, after its error
                if diagnostics
                    reporting := false
                let mask this.walk_body(func)
                var violated n_sites > before
                if diagnostics
                    violated := mask <> 0
                if cur_atomic_bad.length > 0
                {
                    n_violations := n_violations + 1
                    var ab StringBuilder()
                    if diagnostics
                    {
                        ab.append "error: "
                        ab.append func.name
                        ab.append " writes atomic global "
                        ab.append(cur_atomic_bad[0])
                        ab.append " other than through scaly_atomic_*"
                    }
                    else
                    {
                        ab.append "violation atomic "
                        ab.append func.name
                        ab.append " "
                        ab.append(cur_atomic_bad[0])
                    }
                    let atext ab.to_string()
                    this.record(func.loc.start, String^this(atext))
                    if diagnostics
                    {
                        reporting := true
                        this.walk_body(func)
                        reporting := false
                    }
                    ; the walk above reset the body state; walk once more so
                    ; the verdicts below read this body's own sets
                    reporting := false
                    this.walk_body(func)
                }
                let bad this.bad_globals()
                if bad.get_length() > 0
                {
                    n_violations := n_violations + 1
                    var gb StringBuilder()
                    if diagnostics
                    {
                        if is_init
                        {
                            gb.append "error: init writes global "
                            gb.append bad
                            gb.append "; an initializer has no effect but building its object - move the write into a procedure"
                        }
                        else if func.pure
                        {
                            gb.append "error: function "
                            gb.append func.name
                            gb.append " writes global "
                            gb.append bad
                            gb.append "; a function writes nothing - make it a procedure and name it after the signature: \`mutable "
                            gb.append bad
                            gb.append "\`"
                        }
                        else
                        {
                            gb.append "error: procedure "
                            gb.append func.name
                            gb.append " writes global "
                            gb.append bad
                            gb.append ", which its signature does not name: add \`mutable "
                            gb.append bad
                            gb.append "\` after it"
                        }
                    }
                    else
                    {
                        gb.append "violation globals "
                        gb.append func.name
                        gb.append " "
                        gb.append bad
                    }
                    let gtext gb.to_string()
                    this.record(func.loc.start, String^this(gtext))
                    if violated = false
                    {
                        if diagnostics
                        {
                            reporting := true
                            this.walk_body(func)
                            reporting := false
                        }
                    }
                }
                ; R2: a `let` field of a published object was written
                if cur_let_bad.length > 0
                {
                    n_violations := n_violations + 1
                    var lb StringBuilder()
                    if diagnostics
                    {
                        lb.append "error: "
                        if is_init
                            lb.append "init"
                        else if func.pure
                            lb.append "function "
                        else
                            lb.append "procedure "
                        if is_init = false
                            lb.append func.name
                        lb.append " writes let field "
                        lb.append(cur_let_bad[0])
                        lb.append "; a let field is set in init or before its object is published - write var before the field, or build the object here"
                    }
                    else
                    {
                        lb.append "violation let "
                        lb.append func.name
                        lb.append " "
                        lb.append(cur_let_bad[0])
                    }
                    let ltext lb.to_string()
                    this.record(cur_let_offsets[0], String^this(ltext))
                    if diagnostics
                    {
                        var li: size_t 1
                        while li < cur_let_bad.length
                        {
                            let ntext "note: and `cur_let_bad[li]`"
                            this.record(cur_let_offsets[li], String^this(ntext))
                            li := li + 1
                        }
                    }
                }
                if cur_reads.length > 0
                {
                    n_violations := n_violations + 1
                    var rb StringBuilder()
                    if diagnostics
                    {
                        if is_init
                        {
                            rb.append "error: init reads global "
                            rb.append(cur_reads[0])
                            rb.append "; an initializer has no effect but building its object - read it in a procedure after the construction"
                        }
                        else
                        {
                            rb.append "error: function "
                            rb.append func.name
                            rb.append " reads global "
                            rb.append(cur_reads[0])
                            rb.append "; a function reads no global that can change - pass the value in, or make it a procedure"
                        }
                    }
                    else
                    {
                        rb.append "violation reads "
                        rb.append func.name
                        rb.append " "
                        rb.append(cur_reads[0])
                    }
                    let rtext rb.to_string()
                    this.record(func.loc.start, String^this(rtext))
                    if diagnostics
                    {
                        reporting := true
                        this.walk_body(func)
                        reporting := false
                    }
                }
                if this.bad_io()
                {
                    n_violations := n_violations + 1
                    var ib StringBuilder()
                    if diagnostics
                    {
                        if is_init
                            ib.append "error: init performs I/O; an initializer has no effect but building its object - move the I/O into a procedure"
                        else if func.pure
                        {
                            ib.append "error: function "
                            ib.append func.name
                            ib.append " performs I/O; a function performs none - make it a procedure and declare \`io\` after its signature"
                        }
                        else
                        {
                            ib.append "error: procedure "
                            ib.append func.name
                            ib.append " performs I/O, which its signature does not declare: add \`io\` after it"
                        }
                    }
                    else
                    {
                        ib.append "violation io "
                        ib.append func.name
                    }
                    let itext ib.to_string()
                    this.record(func.loc.start, String^this(itext))
                    if violated = false
                    {
                        if bad.get_length() = 0
                        {
                            if diagnostics
                            {
                                reporting := true
                                this.walk_body(func)
                                reporting := false
                            }
                        }
                    }
                }
                if violated
                {
                    n_violations := n_violations + 1
                    let names this.mask_names(mask & (0 - (cur_page_mask + (1 as u64))))
                    var sb StringBuilder()
                    if diagnostics
                    {
                        let only_global (mask & (0 - (cur_page_mask + (1 as u64)))) = WC_GLOBAL
                        if func.pure
                        {
                            sb.append "error: function "
                            sb.append func.name
                            if only_global
                                sb.append " writes a global; a function writes nothing - make it a procedure"
                            else
                            {
                                sb.append " writes what its parameters reach ("
                                sb.append names
                                sb.append "); a function writes nothing - make it a procedure and declare the parameter \`mutable\`"
                            }
                        }
                        else
                        {
                            sb.append "error: procedure "
                            sb.append func.name
                            sb.append " writes "
                            sb.append names
                            sb.append ", which its signature does not declare \`mutable\`"
                        }
                    }
                    else
                    {
                        if func.pure
                            sb.append "violation fn "
                        else
                            sb.append "violation proc "
                        sb.append func.name
                        sb.append " writes "
                        sb.append names
                    }
                    let text sb.to_string()
                    this.record(func.loc.start, String^this(text))
                    if diagnostics
                    {
                        reporting := true
                        this.walk_body(func)
                        reporting := false
                    }
                }
            }
        }

        ; ================================================================
        ; Summaries across roots: `<mangled>\t<mask>\t<inputs>` per line.
        ; A root reads what the roots before it wrote and appends its own
        ; bodies, so a dependency's verdict reaches the packages that call
        ; it (tools/write-report.sh runs the roots in dependency order).
        ; ================================================================

        function summary_index(this: WriteCensus, mangled: String) returns size_t
        {
            if mangled.get_length() = 0
                return 0
            let mask (262144 as size_t) - 1
            var h mangled.hash() & mask
            var probes: size_t 0
            while probes < mask
            {
                let slot sum_slots[h]
                if slot = 0
                    return 0
                if sum_names[slot - 1] = mangled
                    return slot
                h := (h + 1) & mask
                probes := probes + 1
            }
            0
        }

        ; `mangled` must already live on this pass's page (String^this at the
        ; call): the escape checker reads a callee that stores its argument
        ; as storing the caller's local, as in PointerCensus.record.
        procedure add_summary(mutable this: WriteCensus, mangled: String, m: u64, n_in: size_t, globals: String)
        {
            if sum_names.length * 2 >= (262144 as size_t)
                return
            if this.summary_index(mangled) > 0
                return
            sum_names.add mangled
            sum_masks.add m
            sum_inputs.add n_in
            sum_globals.add globals
            let mask (262144 as size_t) - 1
            var h mangled.hash() & mask
            while sum_slots[h] <> 0
                h := (h + 1) & mask
            sum_slots.put(h, sum_names.length)
        }

        procedure load_summaries(mutable this: WriteCensus)
        {
            let env getenv("SCALYC_WRITE_SUMMARIES")
            if env = null
                return
            summaries_path := String^this(env)
            if File.exists(summaries_path) = false
                return
            let text File.read_to_string(summaries_path)
            let n text.get_length()
            var i: size_t 0
            while i < n
            {
                var name StringBuilder()
                while i < n
                {
                    let c text.get i
                    if c = 9
                        break
                    name.append(c as char)
                    i := i + 1
                }
                i := i + 1
                var m: u64 0
                while i < n
                {
                    let c text.get i
                    if (c < 48) or (c > 57)
                        break
                    m := (m * 10) + ((c - 48) as u64)
                    i := i + 1
                }
                i := i + 1
                var k: size_t 0
                while i < n
                {
                    let c text.get i
                    if (c < 48) or (c > 57)
                        break
                    k := (k * 10) + ((c - 48) as size_t)
                    i := i + 1
                }
                ; an optional fourth field: the globals the body writes
                var gl StringBuilder()
                if i < n
                {
                    if text.get(i) = 9
                    {
                        i := i + 1
                        while i < n
                        {
                            let c text.get i
                            if c = 10
                                break
                            gl.append(c as char)
                            i := i + 1
                        }
                    }
                }
                while i < n
                {
                    let c text.get i
                    i := i + 1
                    if c = 10
                        break
                }
                let name_text name.to_string()
                let gl_text gl.to_string()
                this.add_summary(String^this(name_text), m, k, String^this(gl_text))
            }
        }

        ; Append this root's bodies and write the whole table back.
        procedure save_summaries(mutable this: WriteCensus)
        {
            if summaries_path.get_length() = 0
                return
            if plan_functions = null
                return
            let fns plan_functions as ref[Vector[PlannedFunction]]
            var i: size_t 0
            while i < fns.length
            {
                let f_ptr fns.get i
                if f_ptr <> null
                {
                    let f f_ptr.unwrap()
                    var is_body false
                    choose f.impl
                        when action: Action
                            is_body := true
                        else
                            0
                    if is_body
                    {
                        var n_in: size_t 0
                        if f.input <> null
                            n_in := f.input.length
                        let gl_text this.globals_text(i)
                        this.add_summary(String^this(f.mangled_name), masks[i], n_in, String^this(gl_text))
                    }
                }
                i := i + 1
            }
            var sb StringBuilder()
            var r: size_t 0
            while r < sum_names.length
            {
                sb.append(sum_names[r])
                sb.append("\t" as char)
                sb.append(sum_masks[r] as size_t)
                sb.append("\t" as char)
                sb.append(sum_inputs[r])
                sb.append("\t" as char)
                sb.append(sum_globals[r])
                sb.append("\n" as char)
                r := r + 1
            }
            let out_text sb.to_string()
            File.write_from_string(summaries_path, out_text)
        }

        ; ================================================================
        ; I/O: the world outside the program, as one more global named `io`
        ; (a keyword, so no real global can carry the name). A procedure
        ; that reaches it declares `io` after its signature; a function never
        ; does. Where it comes from: an extern that does more than compute
        ; (extern_is_io) and every callee that declares it -- the latter
        ; arrives through the callee's global set like any other global.
        ; ================================================================

        procedure note_call_io(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall, slot: size_t)
        {
            if call.is_intrinsic
                return
            if call.is_operator
                return
            ; an indirect call goes through a DELEGATE value, and a delegate
            ; value is only ever made from a lambda (Planner.make_closure) --
            ; which is synthesized as a procedure that declares nothing, so the
            ; check refuses any lambda that performs I/O or writes a global.
            ; Calling one is therefore free of both.
            if call.is_indirect
                return
            if slot > 0
            {
                let f_ptr plan_functions.get(slot - 1)
                if f_ptr <> null
                {
                    var body false
                    choose f_ptr.unwrap().impl
                        when action: Action
                            body := true
                        else
                            0
                    if body
                    {
                        ; a body of this root reaches I/O as the pre-pass
                        ; computed it: nothing in its signature says so
                        if check_mode
                            if read_pass = false
                                if slot - 1 < body_io.length
                                {
                                    let r body_io[slot - 1]
                                    if r.get_length() > 0
                                        this.note_io(op.loc.start, call.name)
                                }
                        return
                    }
                }
            }
            let census pc as ref[PointerCensus]
            if census.is_extern_name(call.mangled_name) and WriteCensus.extern_is_io(call.name)
                this.note_io(op.loc.start, call.name)
        }

        ; The allocator substrate is ambient here as it is for globals: its
        ; trace output and the abort path's message (scaly_panic_* live in
        ; scaly/memory) are not I/O a signature declares.
        procedure note_io(mutable this: WriteCensus, offset: size_t, how: String)
        {
            if cur_substrate
                return
            if read_pass
            {
                let had body_io[read_index]
                if had.get_length() = 0
                    body_io.put(read_index, String^this(how))
                return
            }
            this.note_global_named(String("io"))
            this.note_global_site(offset, String("io"), how)
            if check_mode = false and frozen_mode = false
                body_mask := body_mask | WC_GLOBAL
        }

        ; check mode: a FUNCTION reads no global that can change -- it is an
        ; input the signature does not name, and a `mutable` one is
        ; thread-local, so a task on another worker would read a different
        ; cell. The runtime's own state is ambient (the allocator, the
        ; scheduler); a constant `define` is not a global that can change.
        procedure note_global_read(mutable this: WriteCensus, offset: size_t, name: String)
        {
            if check_mode = false
                return
            if cur_substrate
                return
            if this.is_changeable(name) = false
                return
            if read_pass
            {
                let have body_reads[read_index]
                if have.get_length() = 0
                    body_reads.put(read_index, String^this(name))
                return
            }
            ; a function reads none, and neither does an initializer: it builds
            ; its object and has no other effect
            if cur_pure = false and cur_name <> "init"
                return
            this.note_read_site(offset, name, String(""))
        }

        ; a global that can change and is not the runtime's own state
        function is_changeable(this: WriteCensus, name: String) returns bool
        {
            var changeable false
            var i: size_t 0
            while i < mutable_names.length
            {
                if mutable_names[i] = name
                    changeable := true
                i := i + 1
            }
            if changeable = false
                return false
            var j: size_t 0
            while j < ambient_names.length
            {
                if ambient_names[j] = name
                    return false
                j := j + 1
            }
            true
        }

        ; the walked function reads `name`, itself or through `callee`
        procedure note_read_site(mutable this: WriteCensus, offset: size_t, name: String, callee: String)
        {
            var known false
            var k: size_t 0
            while k < cur_reads.length
            {
                if cur_reads[k] = name
                    known := true
                k := k + 1
            }
            if known = false
                cur_reads.add(String^this(name))
            if diagnostics
            {
                if reporting
                {
                    var sb StringBuilder()
                    sb.append "note: reads global "
                    sb.append name
                    if callee.get_length() > 0
                    {
                        sb.append " -> "
                        sb.append callee
                    }
                    let text sb.to_string()
                    this.record(offset, String^this(text))
                }
            }
        }

        ; a call to a body: the pre-pass records the edge, the check asks
        ; whether a FUNCTION reaches a read through it
        procedure note_call_reads(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall, slot: size_t)
        {
            if check_mode = false
                return
            if slot = 0
                return
            if read_pass
            {
                edge_from.add(read_index)
                edge_to.add(slot - 1)
                return
            }
            if cur_pure = false and cur_name <> "init"
                return
            if slot - 1 >= body_reads.length
                return
            let r body_reads[slot - 1]
            if r.get_length() > 0
                this.note_read_site(op.loc.start, r, call.name)
        }

        ; Does an extern reach the world outside the program? Everything does
        ; but what only computes (memory, strings, maths, atomics), the
        ; runtime's coordination (threads, fiber contexts, the poller's wake
        ; descriptor, the CPU count it sizes its pool by), the catch and abort
        ; machinery and the stack guard. LLVM-C mutates its handles inside the
        ; process -- the census counts that as writing its arguments -- and is
        ; I/O only where it touches a file or asks the host.
        function extern_is_io(name: String) returns bool
        {
            if name.starts_with(String("LLVM"))
            {
                match name
                    case "LLVMCreateMemoryBufferWithContentsOfFile": return true
                    case "LLVMGetDefaultTargetTriple" case "LLVMPrintModuleToFile": return true
                    case "LLVMGetHostCPUName" case "LLVMGetHostCPUFeatures": return true
                    case "LLVMTargetMachineEmitToFile" case "LLVMWriteBitcodeToFile": return true
                return false
            }
            if name.starts_with(String("scaly_atomic_"))
                return false
            if name.starts_with(String("scaly_catch_"))
                return false
            if name.starts_with(String("scaly_panic_"))
                return false
            if name.starts_with(String("scaly_eio_wake"))
                return false
            if name = "scaly_eio_ncpu"
                return false
            if WriteCensus.extern_computes(name)
                return false
            true
        }

        function extern_computes(name: String) returns bool
        {
            ; memory
            match name
                case "malloc" case "calloc" case "realloc" case "free" case "memcpy": return true
                case "memmove" case "memset" case "memcmp" case "mmap" case "munmap": return true
                case "mprotect" case "getpagesize" case "aligned_alloc" case "scaly_aligned_alloc": return true
                case "scaly_aligned_free" case "scaly_alloc_fail_after": return true
            ; strings and numbers
            match name
                case "strlen" case "strcmp" case "strncmp" case "strdup" case "strtod": return true
                case "atoll" case "strerror" case "basename" case "dirname": return true
                case "memchr": return true
            ; maths
            match name
                case "sin" case "cos" case "tan" case "asin" case "acos" case "atan": return true
                case "atan2" case "exp" case "expf" case "log" case "logf" case "log10": return true
                case "pow" case "powf" case "sqrt" case "sqrtf" case "tanh" case "tanhf": return true
                case "floor" case "ceil" case "trunc" case "fmod" case "fabs" case "fabsf": return true
            ; the runtime's coordination and its guards
            match name
                case "scaly_thread_spawn_sized" case "scaly_stack_limit" case "pthread_create": return true
                case "pthread_join" case "sched_yield" case "scaly_make_context": return true
                case "scaly_jump_context" case "scaly_stack_guard" case "scaly_stack_limit": return true
                case "scaly_guard_install" case "scaly_build_stamp" case "signal" case "atexit": return true
            ; the abort path
            if name = "exit" or name = "abort"
                return true
            ; the bit counts (scaly/memory/bits), lowered to LLVM intrinsics
            match name
                case "scaly_bits_trailing_zeros" case "scaly_bits_leading_zeros" case "scaly_bits_count_ones": return true
            false
        }

        ; The argument positions a C function writes, from its documented
        ; contract; every extern NOT named here writes all of them (the LLVM-C
        ; API mutates through every handle it is given). Asked only for a
        ; `function ... extern`: a `procedure ... extern` DECLARES its writes
        ; with `mutable` marks (PointerCensus.extern_contract#), and a new
        ; binding declares rather than growing this table.
        ; a SIMD vector stored into a container or through a pointer: the
        ; intrinsic writes its argument 1 (ROADMAP-simd.md phase 2)
        function is_simd_store(name: String) returns bool
        {
            match name
                case "simd.store" case "simd.store_ptr": return true
            false
        }

        function extern_writes(name: String) returns u64
        {
            if WriteCensus.is_simd_store(name)
                return 2
            if name = "memcpy"
                return 1
            if name = "memmove"
                return 1
            if name = "memset"
                return 1
            if name = "fread"
                return 9
            ; the io_uring completion path (fiber/eio.c): a send READS its
            ; buffer, and the result lands in the tag record (argument 4); a
            ; receive fills its buffer (argument 2) and the tag record
            if name = "scaly_eio_submit_send"
                return 16
            if name = "scaly_eio_submit_recv"
                return 20
            if name = "fwrite"
                return 8
            if name = "memcmp"
                return 0
            if name = "memchr"
                return 0
            if name = "strlen"
                return 0
            if name = "strcmp"
                return 0
            if name = "strncmp"
                return 0
            if name = "strdup"
                return 0
            ; strtod reads the text and stores the end of the number through
            ; its second argument
            if name = "strtod"
                return 2
            if name = "access"
                return 0
            if name = "fopen"
                return 0
            if name = "mkdir"
                return 0
            if name = "rmdir"
                return 0
            if name = "opendir"
                return 0
            if name = "getenv"
                return 0
            if name = "atoll"
                return 0
            if name = "write"
                return 0
            if name = "puts"
                return 0
            if name = "scaly_eputs"
                return 0
            0 - (1 as u64)
        }

        ; The written arguments of an extern call, non-scalar ones only.
        procedure note_extern_call(mutable this: WriteCensus, op: PlannedOperand, call: PlannedCall)
        {
            if call.args = null
                return
            in_atomic_op := call.name.starts_with(String("scaly_atomic_"))
            let census pc as ref[PointerCensus]
            var written census.extern_declared_writes(call.name)
            if written = EXTERN_UNDECLARED
                written := WriteCensus.extern_writes(call.name)
            var m: u64 0
            var i: size_t 0
            while i < call.args.length
            {
                var bit: u64 WC_OVERFLOW
                if i < 61
                    bit := (1 as u64) << (i as u64)
                let a_ptr call.args.get i
                if a_ptr <> null
                {
                    let a a_ptr.unwrap()
                    if (written & bit) <> (0 as u64)
                        if WriteCensus.is_scalar(a.result_type) = false
                        {
                            let am this.mask_of(a)
                            m := m | am
                            if (am & WC_GLOBAL) <> (0 as u64)
                                pending_global := this.global_root_m(a)
                        }
                }
                i := i + 1
            }
            this.hit(op.loc.start, String("w-extern"), m, WriteCensus.join("-> ", call.name))
            in_atomic_op := false
        }

        ; ================================================================
        ; Bodies: the TaskPlanner's closed arm list, as the pointer census.
        ; ================================================================

        procedure find_operands(mutable this: WriteCensus, ops: ref[Vector[PlannedOperand]]?)
        {
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    this.find_operand(op_ptr.unwrap())
                i := i + 1
            }
        }

        procedure find_statement_ref(mutable this: WriteCensus, stmt: ref[PlannedStatement]?)
        {
            if stmt <> null
            {
                let s stmt
                this.find_statement((*s))
            }
        }

        ; The store side of a `set`: the target head decides the class.
        ; ====================================================================
        ; R2 (2026-09-20, measured first, armed later): a PROPERTY IS `let`
        ; UNLESS IT SAYS `var`. A `let` field may be written in its record's
        ; `init` and while the object is still the constructing frame's own --
        ; not yet published to anyone else -- and nowhere else. The three
        ; things a member store can be written through, and the verdict:
        ;   * `this` inside `init`               building the object: allowed
        ;   * a local whose mask is EMPTY        a construction of this frame,
        ;                                        reaching no parameter, global
        ;                                        or frozen value: allowed
        ;   * a parameter, a global, a value     published: a `w-let` site
        ;     loaded through a reference hop
        ; The hop test is the same reference-shape test the frozen mode uses:
        ; an intermediate hop of reference shape LOADS another object, one of
        ; value shape stays inside the base object (a payload by value).
        ;
        ; ★This is the measurement half. It records `w-let` lines and a count
        ; in the head line; the gate (a hard diagnostic in check mode) comes
        ; only once the tree carries its `var` marks, derived from this report
        ; by tools/purify/mark_var.py -- the two-phase discipline every rule
        ; here has followed.
        ; ====================================================================
        ; note_address_taken#: `&x` of a bare local -- the object is published
        ; from this point of the walk on (note_let_store#).
        procedure note_address_taken(mutable this: WriteCensus, call: PlannedCall)
        {
            if call.is_operator = false or call.name <> "&" or call.args = null
                return
            let args (*call.args)
            if args.length <> 1
                return
            let a0 args.get 0
            if a0 = null or a0.member_access <> null
                return
            choose a0.expr
                when v: Variable
                {
                    if this.addr_taken(v.name) = false
                        cur_addr_taken.add(String^this(v.name))
                }
                else
                    0
        }

        function addr_taken(this: WriteCensus, name: String) returns bool
        {
            var i: size_t 0
            while i < cur_addr_taken.length
            {
                let np cur_addr_taken.get i
                if np <> null and (*np) = name
                    return true
                i := i + 1
            }
            false
        }

        procedure note_let_store(mutable this: WriteCensus, head: PlannedOperand, base_mask: u64)
        {
            ; the frozen report answers a different question (writes into
            ; data shared after a phase, from the entries): its lines are
            ; asserted by name in tests/write-report, a let-site there is noise
            if frozen_mode
                return
            if head.member_access = null
                return
            let hops (*head.member_access)
            if hops.length = 0
                return
            let last_ptr hops.get(hops.length - 1)
            if last_ptr = null
                return
            let last (*last_ptr)
            if last.is_method
                return
            if this.field_is_var(last)
                return
            ; building the object in its own init
            if cur_name = "init" and (base_mask & (1 as u64)) <> (0 as u64)
                return
            var published false
            if (base_mask & (WC_GLOBAL | WC_FROZEN | WC_OVERFLOW)) <> (0 as u64)
                published := true
            if (base_mask & (WC_GLOBAL - (1 as u64)) & (0 - (WC_FROZEN + (1 as u64))) & (0 - (WC_OVERFLOW + (1 as u64)))) <> (0 as u64)
                published := true
            ; a local whose address this body took EARLIER is published from
            ; there on: `var b Box(1)  keep(&b)  set b.fixed: 2` writes a let
            ; field of an object somebody else may hold. Program order, as the
            ; walk goes; the mask alone called it a fresh construction
            ; (flow-insensitive until 2026-09-24).
            var via_local String()
            if published = false
            {
                choose head.expr
                    when hv: Variable
                        if this.addr_taken(hv.name)
                        {
                            published := true
                            via_local := String^this(hv.name)
                        }
                    else
                        0
            }
            ; an intermediate hop of reference shape loads another object
            var i: size_t 0
            while i + 1 < hops.length
            {
                let hp hops.get i
                if hp <> null and WriteCensus.is_reference_name((*hp).result_type.name)
                    published := true
                i := i + 1
            }
            if published = false
                return
            ; check mode (phase 2, the gate): collect for this body's verdict
            if check_mode
            {
                var cb StringBuilder()
                cb.append last.parent_type.name
                cb.append "."
                cb.append last.name
                cb.append " through "
                if via_local.get_length() > 0
                {
                    cb.append via_local
                    cb.append ", whose address this body handed out before"
                }
                else
                    cb.append(this.mask_names(base_mask))
                let ctext cb.to_string()
                if this.let_bad_seen(head.loc.start) = false
                {
                    cur_let_bad.add(String^this(ctext))
                    cur_let_offsets.add(head.loc.start)
                }
                return
            }
            ; the census walks a body once per ROUND: one site, one line
            if this.let_site_seen(head.loc.start)
                return
            let_offsets.add(head.loc.start)
            n_let_sites := n_let_sites + 1
            var sb StringBuilder()
            sb.append "w-let "
            sb.append cur_name
            sb.append " writes "
            sb.append last.parent_type.name
            sb.append "."
            sb.append last.name
            sb.append " through "
            if via_local.get_length() > 0
                sb.append via_local
            else
                sb.append(this.mask_names(base_mask))
            if getenv("SCALYC_LET_PROBE") <> null
            {
                sb.append " [fn "
                sb.append(cur_fn as int)
                sb.append "]"
            }
            let text sb.to_string()
            ; recorded at once, under the body's own file: the report's file
            ; resolution runs only for the summary lines, and a walk that
            ; fires first would otherwise file the site under the wrong body
            let saved_file String^this(current_file)
            current_file := String^this(cur_file_hint)
            this.record(head.loc.start, String^this(text))
            current_file := saved_file
        }

        ; The let-sites of one body, emitted where its file is known.
        procedure flush_let_sites(mutable this: WriteCensus, fn: size_t)
        {
            var i: size_t 0
            while i < let_fns.length
            {
                if let_fns[i] = fn
                {
                    let t let_texts.get i
                    if t <> null
                        this.record(let_offsets[i], (*t))
                }
                i := i + 1
            }
        }

        ; Does the written field carry `var`? Its declaration is the property
        ; of the hop's parent record in the plan, found by mangled name and
        ; field index (by name where the index does not line up).
        ; (a procedure while it carries the SCALYC_LET_PROBE print: a function performs no I/O)
        ; Enter every planned structure under its mangled and its plain name,
        ; the first of each winning (field_is_var#'s scan stopped at the first).
        procedure index_structures(mutable this: WriteCensus)
        {
            let_probe := getenv("SCALYC_LET_PROBE") <> null
            if plan_structures = null
                return
            let structs plan_structures
            var cap: size_t 1024
            while cap < (structs.length + 1) * 2
                cap := cap * 2
            struct_by_mangled := ConceptIndex.create(cap)
            struct_by_name := ConceptIndex.create(cap)
            var i: size_t 0
            while i < structs.length
            {
                let sp structs.get i
                if sp <> null
                {
                    if sp.mangled_name.get_length() > 0
                        struct_by_mangled.insert_if_absent(sp.mangled_name, i)
                    struct_by_name.insert_if_absent(sp.name, i)
                }
                i := i + 1
            }
        }

        procedure field_is_var(this: WriteCensus, hop: PlannedMemberAccess) returns bool
        {
            if plan_structures = null
                return false
            ; ★The hop's parent type keeps its REFERENCE HULL where the base is
            ; a pointer walk (`*(tab + i)` into the trace table, the scheduler's
            ; `pointer[SchedTask]` chain): `pointer[TraceEntry]` matched no
            ; structure and five `var` fields of the substrate read as `let`
            ; (measured 2026-09-20, the first armed bootstrap). Peel it first.
            var record: PlannedType hop.parent_type
            var peeled true
            while peeled
            {
                peeled := false
                if WriteCensus.is_reference_name(record.name)
                    if record.generics <> null
                    {
                        let gens (*record.generics)
                        if gens.length > 0
                        {
                            let g0 gens.get 0
                            if g0 <> null
                            {
                                record := (*g0)
                                peeled := true
                            }
                        }
                    }
            }
            let structs plan_structures
            if let_probe
            {
                scaly_eputs "let-probe: field "
                scaly_eputs(hop.name.to_c_string())
                scaly_eputs " parent "
                scaly_eputs(hop.parent_type.name.to_c_string())
                scaly_eputs " / "
                scaly_eputs(hop.parent_type.mangled_name.to_c_string())
                scaly_eputs " peeled "
                scaly_eputs(record.name.to_c_string())
                scaly_eputs " / "
                scaly_eputs(record.mangled_name.to_c_string())
                scaly_eputs " structures "
                scaly_eputi(structs.length as i64)
                scaly_eputs "\n"
            }
            ; ★A NON-GENERIC record's type on a hop carries NO mangled name
            ; (`SchedTask /` in the probe; a generic instantiation carries
            ; `_Z5ArrayIiE`), so the mangled comparison alone found only the
            ; generics -- the name decides where the mangled name is empty.
            var at: i64 0 - 1
            if record.mangled_name.get_length() > 0
                at := struct_by_mangled.lookup(record.mangled_name)
            else
                at := struct_by_name.lookup(record.name)
            if at < 0
                return false
            let sp structs.get(at as size_t)
            if sp = null
                return false
            if sp.properties = null
                return false
            let props sp.properties
            var j: size_t 0
            while j < props.length
            {
                let pp props.get j
                if pp <> null
                    if pp.name = hop.name
                    {
                        if let_probe
                        {
                            scaly_eputs "let-probe:   matched "
                            scaly_eputs(sp.name.to_c_string())
                            scaly_eputs " props "
                            scaly_eputi(props.length as i64)
                            scaly_eputs " field "
                            scaly_eputs(pp.name.to_c_string())
                            scaly_eputs " attrs "
                            if pp.attributes = null
                                scaly_eputs "null"
                            else
                            {
                                let al pp.attributes as ref[Vector[PlannedAttribute]]
                                var q: size_t 0
                                while q < al.length
                                {
                                    let aq al.get q
                                    if aq <> null
                                    {
                                        scaly_eputs(aq.name.to_c_string())
                                        scaly_eputs ","
                                    }
                                    q := q + 1
                                }
                            }
                            scaly_eputs "\n"
                        }
                        return WriteCensus.attributes_have_var(pp.attributes)
                    }
                j := j + 1
            }
            false
        }

        function let_bad_seen(this: WriteCensus, offset: size_t) returns bool
        {
            var i: size_t 0
            while i < cur_let_offsets.length
            {
                if cur_let_offsets[i] = offset
                    return true
                i := i + 1
            }
            false
        }

        function let_site_seen(this: WriteCensus, offset: size_t) returns bool
        {
            var i: size_t 0
            while i < let_offsets.length
            {
                if let_offsets[i] = offset
                    return true
                i := i + 1
            }
            false
        }

        function attributes_have_var(attrs: ref[Vector[PlannedAttribute]]?) returns bool
        {
            if attrs = null
                return false
            let a attrs
            var i: size_t 0
            while i < a.length
            {
                let ap a.get i
                if ap <> null and ap.name = "var"
                    return true
                i := i + 1
            }
            false
        }

        procedure find_action(mutable this: WriteCensus, act: PlannedAction)
        {
            this.find_operands(act.source)
            if act.target = null
                return
            if act.target.length > 0
            {
                let head_ptr act.target.get 0
                if head_ptr <> null
                {
                    let head (*head_ptr)
                    var has_members false
                    if head.member_access <> null and head.member_access.length > 0
                        has_members := true
                    choose head.expr
                        when c: Call
                        {
                            if has_members
                            {
                                ; the call's own result is the record written;
                                ; its arguments only lend their parameters --
                                ; and only the ones the result IS, unless a
                                ; hop before the last loads a held object
                                var base_mask this.mask_of_operands(c.args) & (0 - (WC_FROZEN + (1 as u64)))
                                if WriteCensus.loads_before_last(head) = false
                                    base_mask := this.is_of_base(head) & (0 - (WC_FROZEN + (1 as u64)))
                                this.note_let_store(head, base_mask)
                                this.hit(head.loc.start, String("w-field"), base_mask | this.hops_frozen(head), String(""))
                            }
                            else
                            {
                                if c.name = "*"
                                {
                                    pending_global := this.global_root_m(head)
                                    this.hit(head.loc.start, String("w-deref"), this.mask_of_operands(c.args), String(""))
                                }
                            }
                        }
                        when v: Variable
                        {
                            if has_members
                            {
                                pending_global := this.global_root_m(head)
                                var base_mask this.name_mask(v.name)
                                if WriteCensus.loads_before_last(head) = false
                                    base_mask := this.name_is(v.name)
                                this.note_let_store(head, base_mask)
                                this.hit(head.loc.start, String("w-field"), base_mask | this.hops_frozen(head), String(""))
                            }
                        }
                        when g: GlobalRef
                        {
                            if cur_substrate = false
                                this.note_global_named(String(g.name))
                            this.note_global_site(head.loc.start, String(g.name), String(""))
                            this.hit(head.loc.start, String("w-global"), WC_GLOBAL, String(g.name))
                        }
                        else
                        {
                            if has_members
                            {
                                var base_mask this.mask_of(head)
                                if WriteCensus.loads_before_last(head) = false
                                    base_mask := this.is_of_base(head)
                                this.note_let_store(head, base_mask)
                                this.hit(head.loc.start, String("w-field"), base_mask | this.hops_frozen(head), String(""))
                            }
                        }
                }
            }
            this.find_operands(act.target)
        }

        procedure find_statement(mutable this: WriteCensus, stmt: PlannedStatement)
        {
            choose stmt
                when action: Action
                    this.find_action(action)
                when binding: Binding
                    this.note_binding(binding)
                when ret: Return
                {
                    this.find_operands(ret.result)
                    this.note_returned(ret.result)
                    if frozen_pass and (this.mask_of_operands(ret.result) & WC_FROZEN) <> (0 as u64)
                        this.mark_returns_frozen()
                }
                when throw_stmt: Throw
                    this.find_operands(throw_stmt.result)
                when brk: Break
                    this.find_operands(brk.result)
                when cont: Continue
                    0
        }

        ; A local inherits what its initializer reaches, unless it is a scalar.
        procedure note_binding(mutable this: WriteCensus, binding: PlannedBinding)
        {
            this.find_operands(binding.operation)
            if binding.binding_item.name = null
                return
            let name (*binding.binding_item.name)
            var scalar false
            if binding.binding_item.item_type <> null
                scalar := WriteCensus.is_scalar((*binding.binding_item.item_type))
            else
            {
                if binding.operation <> null
                {
                    if binding.operation.length = 1
                    {
                        let o_ptr binding.operation.get 0
                        if o_ptr <> null
                            scalar := WriteCensus.is_scalar(o_ptr.unwrap().result_type)
                    }
                }
            }
            var m: u64 0
            var mi: u64 0
            if scalar = false
            {
                m := this.mask_of_operands(binding.operation)
                mi := this.is_of_operands(binding.operation)
            }
            ; a frozen RECORD bound by value is a copy
            if binding.binding_item.item_type <> null
            {
                let bt (*binding.binding_item.item_type)
                if WriteCensus.is_reference_name(bt.name) = false
                    if this.is_frozen_record(bt)
                    {
                        m := m & (0 - (WC_FROZEN + (1 as u64)))
                        mi := mi & (0 - (WC_FROZEN + (1 as u64)))
                    }
            }
            ; a local bound to (a part of) a global writes that global
            var g String("")
            if (m & WC_GLOBAL) <> (0 as u64)
                if binding.operation <> null
                    if binding.operation.length = 1
                    {
                        let g_ptr binding.operation.get 0
                        if g_ptr <> null
                            g := this.global_root_m(g_ptr.unwrap())
                    }
            this.remember_local_of(name, m, mi, g)
        }

        procedure find_operand(mutable this: WriteCensus, op: PlannedOperand)
        {
            choose op.expr
                when call: Call
                {
                    this.note_address_taken(call)
                    this.note_call(op, call)
                    this.find_operands(call.args)
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.find_operand((*r))
                    }
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.find_operand((*r))
                    }
                }
                when tp: Tuple
                {
                    if tp.is_region_alloc
                    {
                        if tp.region_arg <> null
                        {
                            let ra tp.region_arg
                            this.hit(op.loc.start, String("a-construct"), this.mask_of((*ra)), String("region"))
                        }
                    }
                    this.note_life(op.loc.start, tp.life, String("a-construct"))
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.find_operands(c_ptr.value)
                            i := i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.find_statement(s_ptr.unwrap())
                            i := i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.find_operands(iff.condition)
                    this.find_statement_ref(iff.consequent)
                    this.find_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.find_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                this.find_statement_ref(br.consequent)
                            }
                            i := i + 1
                        }
                    }
                    this.find_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.find_operands(ch.condition)
                    let subject this.mask_of_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                var m: u64 0
                                if WriteCensus.is_scalar(w.variant_type) = false
                                    m := subject
                                if WriteCensus.is_reference_name(w.variant_type.name) = false
                                    if this.is_frozen_record(w.variant_type)
                                        m := m & (0 - (WC_FROZEN + (1 as u64)))
                                this.remember_local(w.name, m)
                                this.find_statement_ref(w.consequent)
                            }
                            i := i + 1
                        }
                    }
                    this.find_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.find_operands(fr.expr)
                    this.remember_local(fr.identifier, this.mask_of_operands(fr.expr))
                    this.find_action(fr.body)
                }
                when wh: While
                {
                    this.note_binding(wh.cond)
                    this.find_action(wh.body)
                }
                when rp: Repeat
                    this.find_action(rp.body)
                when tr: Try
                {
                    this.note_binding(tr.cond)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.find_statement_ref(w.consequent)
                            }
                            i := i + 1
                        }
                    }
                    this.find_statement_ref(tr.alternative)
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.find_operand((*r))
                    }
                }
                when g: GlobalRef
                    this.note_global_read(op.loc.start, String(g.name))
                when mx: Matrix
                {
                    this.note_life(op.loc.start, mx.life, String("a-construct"))
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.find_operands(row_ptr)
                            i := i + 1
                        }
                    }
                }
                when bx: Box
                {
                    this.hit(op.loc.start, String("a-box"), this.name_mask(bx.target_page), WriteCensus.join("^", bx.target_page))
                    if bx.value <> null
                    {
                        let r bx.value
                        this.find_operand((*r))
                    }
                }
                else
                    0
        }
    }
}
