; TaskPlanner.scaly - Stage-3/4 Plan analysis pass between Planner and Emitter.
;
; The pass walks the finished Plan and classifies every `for` loop body:
; is it provably parallelizable?
; A body qualifies when
;   - every call resolves to a pure Scaly function, an intrinsic, an
;     operator, or a frame-local construction (Local/Unspecified life);
;     purity is PROVED transitively, not just read off the function/
;     procedure keyword — see effectively_pure below. (The keyword is
;     CHECKED since 2026-09-19: a `function` writes nothing, reads and
;     writes no global that can change and performs no I/O, so it is
;     trusted without a walk -- a body and a stub of another package alike,
;     the stub's keyword carried into the plan by
;     WriteCensus.mark_stub_purity. Procedure bodies are still walked.)
;   - every write lands in a binding declared inside the body, or in a
;     disjoint Vector slot (`put` whose index reads the loop variable —
;     the canonical parallel result target),
;   - control never leaves the loop early (no return/throw, no break of
;     the loop itself), and
;   - no mutable module global is read or written (mutable globals are
;     thread-local since M2.2 — a task on another worker thread would see
;     a DIFFERENT cell).
; Everything else records the FIRST blocking construct as the reason.
;
; The analysis is deliberately conservative. Two consumers (4.4 — plain
; `for` drives the engine, no syntax involved):
;   - the Emitter asks loop_promotable per `for` site; a passing body
;     dispatches through the adaptive parallel driver, a blocked one
;     runs sequentially (never a diagnostic),
;   - the `--task-plan` CLI flag prints the per-loop verdicts (the
;     `--use-vis` measurement-report precedent) — the only surface
;     where parallelization is observable.
;
; CONTROL-FLOW NOTE: `if COND STMT` runs STMT when COND is TRUE (no else).

use scalyc.compiler.Model.*
use scalyc.compiler.Plan.*

define TaskPlanner
{
    ; ========================================================================
    ; TaskPlanner - the per-compilation-unit analysis state.
    ;
    ; Report entries are three parallel Arrays (one slot per `for` loop, in
    ; walk order): the owning function's source file, the loop's byte offset
    ; in that file, and the verdict text ("parallel" or "blocked: <reason>").
    ; The cli formats them file:line:col like print_diagnostics does.
    ; ========================================================================

    define TaskPlanner
    (
        report_files: Array[String]
        report_offsets: Array[size_t]
        report_verdicts: Array[String]
        var loops_total: size_t
        var loops_parallel: size_t

        ; The plan's flat function/global vectors, for purity and
        ; mutable-global lookups by mangled name during classification.
        var plan_functions: ref[Vector[PlannedFunction]]?
        var plan_globals: ref[Vector[PlannedGlobal]]?

        ; Source file of the function whose body is currently walked
        ; (PlannedFunction.file; the entry file for top-level statements).
        var current_file: String

        ; Per-classification scratch, reset by classify_body. cls_locals
        ; holds names bound INSIDE the loop body (flat, never popped —
        ; a conservative over-approximation is fine for a report; a
        ; shadowing inner binding can mask a same-named outer write).
        cls_locals: Array[String]
        ; Alias soundness (4.4): body-introduced names whose initializer,
        ; scrutinee, or sequence can hand them a REFERENCE into
        ; loop-external state. `let r outer` launders `r.add i` past the
        ; name-based locality checks otherwise — an aliased name is
        ; treated as loop-external (writes and mutating calls block;
        ; reads stay fine). Overrides cls_locals in is_local.
        cls_aliased: Array[String]
        var cls_blocked: bool
        var cls_reason: String
        var cls_loop_var: String
        ; Nesting depth below the classified loop: a `break` at depth 0
        ; exits the classified loop itself (blocker); deeper breaks only
        ; exit an inner loop.
        var cls_depth: size_t

        ; Transitive-purity memo: mangled name -> 1 (effect-free) / 0.
        ; pure_stack holds the names currently being walked (recursion
        ; among effect-free functions is effect-free unless a concrete
        ; violation turns up elsewhere in the cycle).
        pure_memo_names: Array[String]
        pure_memo_flags: Array[size_t]
        pure_stack: Array[String]
        ; Violation flag of the purity walk currently in flight.
        var pw_impure: bool

        ; Written-params analysis: mangled name -> bitmask over the
        ; callee's input positions (bit i set = the callee may WRITE
        ; through what parameter i reaches, transitively). Bit 63 doubles
        ; as the everything-bit via WM_ALL. This is what lets a loop
        ; body READ loop-external containers (`a.get j` — mask 0) while
        ; a mutating method (`outer.add v` — List.add writes this, bit 0)
        ; still demands a per-iteration receiver. The `function` keyword
        ; plays no part — masks are computed from bodies.
        wm_memo_names: Array[String]
        wm_memo_vals: Array[size_t]
        wm_stack: Array[String]
        ; Walk-in-flight state: wr_mask accumulates the written mask;
        ; wr_names/wr_masks is a STACKED name table (params seeded with
        ; their own bit, body names with the reach-mask of what their
        ; initializer/scrutinee can alias); wr_base marks the current
        ; callee's window — recursion into a sub-callee's walk saves and
        ; restores mask/base/length around itself.
        var wr_mask: size_t
        wr_names: Array[String]
        wr_masks: Array[size_t]
        var wr_base: size_t

        ; While census (--loop-census, report only; see classify_while).
        ; Off unless the cli asks: the Emitter and the codeLens never see
        ; a `while` verdict.
        var census_while: bool
        while_files: Array[String]
        while_offsets: Array[size_t]
        while_verdicts: Array[String]
        var whiles_total: size_t
        var whiles_counted: size_t
        var whiles_parallel: size_t
        ; While a counted loop's body is classified: count the writes of
        ; the counter and how many of them are steps (a write that is not
        ; a step blocks), whether the top-level step is the body's first
        ; statement (a `continue` cannot skip it), and whether a
        ; `continue` met could skip it -- judged only after the rest of
        ; the body, so the verdict names the blocker a `for` would keep.
        var cls_counter_mode: bool
        var cls_counter_writes: size_t
        var cls_counter_steps: size_t
        var cls_step_first: bool
        var cls_continue_skips: bool
        ; The body KEEPS a value it may have built: a non-scalar `put` into
        ; a loop-external vector. The Emitter then runs the wave's chunks on
        ; heap pages it adopts after the barrier (root_pages.scaly,
        ; scaly_region_adopt_push/_drain). cls_takes_address: a unary `&`
        ; anywhere in the body -- a kept value could then point at a slot of
        ; the chunk's own stack frame, which no adoption can keep.
        var cls_keeps: bool
        var cls_takes_address: bool
        ; REDUCTIONS of the classified body (ROADMAP 4.8, route 2): a
        ; loop-external INTEGER variable the body writes only as
        ; `set v: v OP e` (OP + - | & xor, e not reading v) or as
        ; `if e > v  set v: e` (max; < for min). Parallel lists: the name,
        ; the LLVM atomicrmw operation that combines a chunk's partial into
        ; it (Add 1, And 3, Or 5, Xor 6, Max 7, Min 8, UMax 9, UMin 10) --
        ; or, for a FLOATING-POINT variable, 20 (`+`/`-`, combined by fadd)
        ; and 21 (`*`, fmul), which the Emitter combines per ITERATION in
        ; index order instead (Emitter.emit_parallel_for#), and
        ; how many of the name's occurrences those updates account for --
        ; check_reductions# demands that they are ALL of them.
        red_names: Array[String]
        red_ops: Array[int]
        red_counts: Array[size_t]
        ; The labels a `continue loop L` may name without leaving the body:
        ; the classified loop's own and every loop nested in the body. Any
        ; other label jumps OUT of the body -- in an outlined task function
        ; to a label that does not exist there (the Emitter aborted on
        ; tests/controlflow.sgm's continue-labeled-outer once a reduction
        ; had made the inner loop promotable, 2026-09-26).
        var cls_own_label: String
        cls_inner_labels: Array[String]
    )
    {
        init()
        {
            set report_files: Array[String]^this()
            set report_offsets: Array[size_t]^this()
            set report_verdicts: Array[String]^this()
            set loops_total: 0
            set loops_parallel: 0
            set plan_functions: null
            set plan_globals: null
            set current_file: String^this("")
            set cls_locals: Array[String]^this()
            set cls_aliased: Array[String]^this()
            set cls_blocked: false
            set cls_reason: String^this("")
            set cls_loop_var: String^this("")
            set cls_depth: 0
            set pure_memo_names: Array[String]^this()
            set pure_memo_flags: Array[size_t]^this()
            set pure_stack: Array[String]^this()
            set pw_impure: false
            set wm_memo_names: Array[String]^this()
            set wm_memo_vals: Array[size_t]^this()
            set wm_stack: Array[String]^this()
            set wr_mask: 0
            set wr_names: Array[String]^this()
            set wr_masks: Array[size_t]^this()
            set wr_base: 0
            set census_while: false
            set while_files: Array[String]^this()
            set while_offsets: Array[size_t]^this()
            set while_verdicts: Array[String]^this()
            set whiles_total: 0
            set whiles_counted: 0
            set whiles_parallel: 0
            set cls_counter_mode: false
            set cls_counter_writes: 0
            set cls_counter_steps: 0
            set cls_step_first: false
            set cls_continue_skips: false
            set cls_keeps: false
            set cls_takes_address: false
            set red_names: Array[String]^this()
            set red_ops: Array[int]^this()
            set red_counts: Array[size_t]^this()
            set cls_own_label: String^this("")
            set cls_inner_labels: Array[String]^this()
        }

        ; ================================================================
        ; Entry point: walk every planned function body plus the program's
        ; top-level statements and record one verdict per `for` loop.
        ; ================================================================
        procedure analyze(mutable this: TaskPlanner, plan: Plan, entry_file: String)
        {
            set plan_functions: plan.functions
            set plan_globals: plan.globals
            if plan.functions <> null
            {
                for func in plan.functions
                {
                    set current_file: String^this(func.file)
                    choose func.impl
                        when action: Action
                            this.find_action(action)
                        else
                            0
                }
            }
            if plan.statements <> null
            {
                set current_file: String^this(entry_file)
                for stmt in plan.statements
                    this.find_statement(stmt)
            }
        }

        ; ================================================================
        ; Finder: recurse over every statement/operand; each `for` met is
        ; classified, then its body is walked further so nested loops get
        ; their own entries. Lambda bodies are skipped like the escape and
        ; move walkers skip them — monomorphized lambdas appear as their
        ; own entries in plan.functions.
        ; ================================================================

        procedure find_operands(mutable this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?)
        {
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    this.find_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        procedure find_statement_ref(mutable this: TaskPlanner, stmt: ref[PlannedStatement]?)
        {
            if stmt <> null
            {
                let s stmt
                this.find_statement((*s))
            }
        }

        procedure find_action(mutable this: TaskPlanner, act: PlannedAction)
        {
            this.find_operands(act.source)
            this.find_operands(act.target)
        }

        procedure find_statement(mutable this: TaskPlanner, stmt: PlannedStatement)
        {
            choose stmt
                when action: Action
                    this.find_action(action)
                when binding: Binding
                    this.find_operands(binding.operation)
                when ret: Return
                    this.find_operands(ret.result)
                when throw_stmt: Throw
                    this.find_operands(throw_stmt.result)
                when brk: Break
                    this.find_operands(brk.result)
                when cont: Continue
                    0
        }

        procedure find_operand(mutable this: TaskPlanner, op: PlannedOperand)
        {
            choose op.expr
                when call: Call
                    this.find_operands(call.args)
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.find_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.find_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.find_operands(iff.condition)
                    this.find_statement_ref(iff.consequent)
                    this.find_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.find_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.find_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.find_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.find_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.find_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.find_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.find_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.find_operands(fr.expr)
                    this.classify_for(fr)
                    this.find_action(fr.body)
                }
                when wh: While
                {
                    this.find_operands(wh.cond.operation)
                    if census_while
                        this.classify_while(wh)
                    this.find_action(wh.body)
                }
                when rp: Repeat
                    this.find_action(rp.body)
                when tr: Try
                {
                    this.find_operands(tr.cond.operation)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.find_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.find_statement_ref(tr.alternative)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.find_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.find_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.find_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.find_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                when bx: Box
                {
                    if bx.value <> null
                    {
                        let r bx.value
                        this.find_operand((*r))
                    }
                }
                else
                    0
        }

        ; ================================================================
        ; Classifier: walk ONE loop body; the first blocking construct
        ; records a reason and short-circuits the rest of the walk (the
        ; move checker's move_found discipline).
        ; ================================================================

        procedure classify_for(mutable this: TaskPlanner, fr: PlannedFor)
        {
            this.classify_body(fr)
            set loops_total: loops_total + 1
            ; Report strings must live on the TaskPlanner's own page —
            ; a default-local copy dangles by print time (the use-vis
            ; report's `String^this` + bound-local-add idiom).
            let file_copy String^this(current_file)
            report_files.add file_copy
            report_offsets.add(fr.loc.start)
            if cls_blocked
            {
                var sb StringBuilder()
                sb.append "blocked: "
                sb.append cls_reason
                let verdict sb.to_string()
                let verdict_copy String^this(verdict)
                report_verdicts.add verdict_copy
            }
            if cls_blocked = false
            {
                set loops_parallel: loops_parallel + 1
                let par_copy String^this("parallel")
                report_verdicts.add par_copy
            }
        }

        ; Reset the per-loop scratch and walk one body; cls_blocked /
        ; cls_reason carry the verdict. Shared by the report walk and
        ; the Emitter's per-site promotion query.
        procedure classify_body(mutable this: TaskPlanner, fr: PlannedFor)
        {
            set cls_locals.length: 0
            set cls_aliased.length: 0
            set cls_blocked: false
            set cls_reason: String^this("")
            set cls_loop_var: String^this(fr.identifier)
            set cls_own_label: String^this(fr.loop_label)
            set cls_inner_labels.length: 0
            set cls_depth: 0
            set cls_keeps: false
            set cls_takes_address: false
            this.reset_reductions()
            if file_is_foundation(current_file)
                this.block("engine foundation module")
            if cls_blocked = false
                this.cls_action(fr.body)
            this.check_kept_values()
            this.check_reductions(fr.body, null)
        }

        ; ================================================================
        ; Reductions (ROADMAP 4.8, route 2). A chunk of a promoted loop runs
        ; the update on its OWN copy started at the operation's identity and
        ; combines the partial into the submitter's variable with one
        ; atomicrmw at its end (Emitter.emit_parallel_for#); the inline
        ; iterations before the fork update the variable itself. Integer
        ; operations only: + - | & xor max min are associative and
        ; commutative on integers, so the result is the sequential one BIT
        ; FOR BIT; floating point is not (the stage-5 determinism question).
        ; ================================================================

        procedure note_inner_label(mutable this: TaskPlanner, label_name: String)
        {
            if label_name.get_length() = 0
                return
            let copy String^this(label_name)
            cls_inner_labels.add copy
        }

        ; a `continue loop <label_name>` that leaves the classified body
        function label_leaves_body(this: TaskPlanner, label_name: String) returns bool
        {
            if label_name.get_length() = 0
                return false
            if label_name = cls_own_label
                return false
            var i: size_t 0
            while i < cls_inner_labels.length
            {
                if cls_inner_labels[i] = label_name
                    return false
                set i: i + 1
            }
            true
        }

        procedure reset_reductions(mutable this: TaskPlanner)
        {
            set red_names.length: 0
            set red_ops.length: 0
            set red_counts.length: 0
        }

        ; float / double
        function red_is_float(t: PlannedType) returns bool
        {
            let nm t.name
            match nm
                case "float" case "double" case "f32" case "f64": return true
            false
        }

        ; 1 = a signed integer type, 2 = an unsigned one, 0 = anything else
        function red_int_kind(t: PlannedType) returns int
        {
            let nm t.name
            match nm
                case "int" case "i8" case "i16" case "i32" case "i64": return 1
                case "u8" case "u16" case "u32" case "u64" case "size_t": return 2
            0
        }

        ; Record one update of `name` by `op`, accounting for `uses`
        ; occurrences of the name. The same variable reduced two ways blocks.
        procedure note_reduction(mutable this: TaskPlanner, name: String, op: int, uses: size_t)
        {
            var i: size_t 0
            while i < red_names.length
            {
                if red_names[i] = name
                {
                    if red_ops[i] <> op
                    {
                        this.block_named("reduces two ways: ", name)
                        return
                    }
                    red_counts.put(i, red_counts[i] + uses)
                    return
                }
                set i: i + 1
            }
            let n_copy String^this(name)
            red_names.add n_copy
            red_ops.add op
            red_counts.add uses
        }

        ; `set v: v OP e` / `set v: e OP v` on a loop-external integer v
        procedure try_reduction_action(mutable this: TaskPlanner, act: PlannedAction) returns bool
        {
            if act.target = null
                return false
            let t (*act.target)
            if t.length <> 1
                return false
            let tp_ t.get 0
            if tp_ = null
                return false
            let top tp_.unwrap()
            let v this.bare_variable_name(top)
            if v.get_length() = 0
                return false
            if this.is_local(v)
                return false
            let is_float TaskPlanner.red_is_float(top.result_type)
            if TaskPlanner.red_int_kind(top.result_type) = 0 and is_float = false
                return false
            let src act.source
            if src = null
                return false
            if src.length <> 1
                return false
            let sp src.get 0
            if sp = null
                return false
            let so sp.unwrap()
            choose so.expr
                when call: Call
                {
                    if call.is_intrinsic = false and call.is_operator = false
                        return false
                    if call.args = null
                        return false
                    let args (*call.args)
                    if args.length <> 2
                        return false
                    var op 0
                    let nm call.name
                    if is_float
                    {
                        ; floating point: a sum (with differences) or a product;
                        ; the order is fixed per iteration by the Emitter
                        match nm
                            case "+" case "-": set op: 20
                            case "*": set op: 21
                    }
                    else
                    {
                        match nm
                            case "+" case "-": set op: 1
                            case "&": set op: 3
                            case "|": set op: 5
                            case "xor": set op: 6
                    }
                    if op = 0
                        return false
                    let a0 args.get 0
                    let a1 args.get 1
                    if a0 = null
                        return false
                    if a1 = null
                        return false
                    let n0 this.bare_variable_name(a0.unwrap())
                    let n1 this.bare_variable_name(a1.unwrap())
                    if n0 = v
                    {
                        this.cls_operand(a1.unwrap())
                        this.note_reduction(v, op, 2)
                        return true
                    }
                    if n1 = v and nm <> "-"
                    {
                        this.cls_operand(a0.unwrap())
                        this.note_reduction(v, op, 2)
                        return true
                    }
                    return false
                }
                else
                    0
            false
        }

        ; `if e > v  set v: e` (max) / `if e < v  set v: e` (min), either
        ; orientation of the comparison, v a loop-external integer
        procedure try_reduction_if(mutable this: TaskPlanner, iff: PlannedIf) returns bool
        {
            if iff.alternative <> null
                return false
            if iff.prop <> null
                return false
            let cond iff.condition
            if cond = null
                return false
            if cond.length <> 1
                return false
            let cp cond.get 0
            if cp = null
                return false
            let co cp.unwrap()
            let cs iff.consequent
            if cs = null
                return false
            var target: String ""
            var value: ref[Vector[PlannedOperand]]? null
            var t_kind 0
            choose (*cs)
                when a: Action
                {
                    if a.target <> null
                    {
                        let tt (*a.target)
                        if tt.length = 1
                        {
                            let tp_ tt.get 0
                            if tp_ <> null
                            {
                                set target: this.bare_variable_name(tp_.unwrap())
                                set t_kind: TaskPlanner.red_int_kind(tp_.unwrap().result_type)
                                set value: a.source
                            }
                        }
                    }
                }
                else
                    0
            if target.get_length() = 0 or t_kind = 0
                return false
            if this.is_local(target)
                return false
            if value = null
                return false
            if value.length <> 1
                return false
            let vp value.get 0
            if vp = null
                return false
            choose co.expr
                when call: Call
                {
                    if call.args = null
                        return false
                    let args (*call.args)
                    if args.length <> 2
                        return false
                    let x_ptr args.get 0
                    let y_ptr args.get 1
                    if x_ptr = null
                        return false
                    if y_ptr = null
                        return false
                    let x x_ptr.unwrap()
                    let y y_ptr.unwrap()
                    let nm call.name
                    var greater 0
                    match nm
                        case ">" case ">=": set greater: 1
                        case "<" case "<=": set greater: 2
                    if greater = 0
                        return false
                    ; which side is v, which is e -- and is the stored value e?
                    var is_max false
                    var e_ptr: ref[PlannedOperand]? null
                    if this.bare_variable_name(y) = target
                    {
                        set is_max: greater = 1
                        set e_ptr: x_ptr
                    }
                    else
                    {
                        if this.bare_variable_name(x) = target
                        {
                            set is_max: greater = 2
                            set e_ptr: y_ptr
                        }
                    }
                    if e_ptr = null
                        return false
                    let e e_ptr.unwrap()
                    if TaskPlanner.same_access(e, vp.unwrap()) = false
                        return false
                    var op 8
                    if is_max
                        set op: 7
                    if t_kind = 2
                        set op: op + 2
                    this.cls_operand(e)
                    this.note_reduction(target, op, 2)
                    return true
                }
                else
                    0
            false
        }

        ; the same variable, through the same member hops
        function same_access(a: PlannedOperand, b: PlannedOperand) returns bool
        {
            var an ""
            var bn ""
            choose a.expr
                when v: Variable
                    set an: v.name
                else
                    return false
            choose b.expr
                when w: Variable
                    set bn: w.name
                else
                    return false
            if an <> bn
                return false
            var al: size_t 0
            if a.member_access <> null
                set al: a.member_access.length
            var bl: size_t 0
            if b.member_access <> null
                set bl: b.member_access.length
            if al <> bl
                return false
            if al = 0
                return true
            let am (*a.member_access)
            let bm (*b.member_access)
            var i: size_t 0
            while i < al
            {
                let ah am.get i
                let bh bm.get i
                if ah = null
                    return false
                if bh = null
                    return false
                if ah.name <> bh.name
                    return false
                if ah.is_method or bh.is_method
                    return false
                set i: i + 1
            }
            true
        }

        ; Every occurrence of a reduced name must be one its updates account
        ; for: any other read would see a chunk's PARTIAL, any other write
        ; would be lost. Counted over the whole body (and a while loop's
        ; condition), every construct -- the net under the pattern matchers.
        procedure check_reductions(mutable this: TaskPlanner, body: PlannedAction, cond: ref[Vector[PlannedOperand]]?)
        {
            if cls_blocked
                return
            var i: size_t 0
            while i < red_names.length
            {
                let nm red_names[i]
                var seen this.count_in_action(body, nm)
                set seen: seen + this.count_in_ops(cond, nm)
                if seen <> red_counts[i]
                {
                    this.block_named("reduction variable used outside its update: ", nm)
                    return
                }
                set i: i + 1
            }
        }

        function count_in_action(this: TaskPlanner, act: PlannedAction, name: String) returns size_t
            this.count_in_ops(act.source, name) + this.count_in_ops(act.target, name)

        function count_in_ops(this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?, name: String) returns size_t
        {
            if ops = null
                return 0
            var n: size_t 0
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    set n: n + this.count_in_op(op_ptr.unwrap(), name)
                set i: i + 1
            }
            n
        }

        function count_in_stmt_ref(this: TaskPlanner, stmt: ref[PlannedStatement]?, name: String) returns size_t
        {
            if stmt = null
                return 0
            let st stmt
            this.count_in_stmt((*st), name)
        }

        function count_in_stmt(this: TaskPlanner, stmt: PlannedStatement, name: String) returns size_t
        {
            choose stmt
                when action: Action
                    return this.count_in_action(action, name)
                when binding: Binding
                    return this.count_in_ops(binding.operation, name)
                when ret: Return
                    return this.count_in_ops(ret.result, name)
                when throw_stmt: Throw
                    return this.count_in_ops(throw_stmt.result, name)
                when brk: Break
                    return this.count_in_ops(brk.result, name)
                when cont: Continue
                    return 0
            0
        }

        ; Unknown shapes count as a use -- conservative: the check then
        ; blocks rather than trusting a read it could not see.
        function count_in_op(this: TaskPlanner, op: PlannedOperand, name: String) returns size_t
        {
            choose op.expr
                when v: Variable
                {
                    if v.name = name
                        return 1
                    return 0
                }
                when k: Constant
                    return 0
                when ty: Type
                    return 0
                when g: GlobalRef
                    return 0
                when so: SizeOf
                    return 0
                when ao: AlignOf
                    return 0
                when fr_: FunctionRef
                    return 0
                when call: Call
                    return this.count_in_ops(call.args, name)
                when tp: Tuple
                {
                    var n: size_t 0
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                set n: n + this.count_in_ops(c_ptr.value, name)
                            set i: i + 1
                        }
                    }
                    return n
                }
                when mx: Matrix
                {
                    var n: size_t 0
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                set n: n + this.count_in_ops(row_ptr, name)
                            set i: i + 1
                        }
                    }
                    return n
                }
                when blk: Block
                {
                    var n: size_t 0
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                set n: n + this.count_in_stmt(s_ptr.unwrap(), name)
                            set i: i + 1
                        }
                    }
                    return n
                }
                when iff: If
                    return this.count_in_ops(iff.condition, name) + this.count_in_stmt_ref(iff.consequent, name) + this.count_in_stmt_ref(iff.alternative, name)
                when mt: Match
                {
                    var n this.count_in_ops(mt.condition, name)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                            set n: n + this.count_in_ops((*cs_ptr).condition, name)
                                        set ci: ci + 1
                                    }
                                }
                                set n: n + this.count_in_stmt_ref(br.consequent, name)
                            }
                            set i: i + 1
                        }
                    }
                    return n + this.count_in_stmt_ref(mt.alternative, name)
                }
                when ch: Choose
                {
                    var n this.count_in_ops(ch.condition, name)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                                set n: n + this.count_in_stmt_ref((*w_ptr).consequent, name)
                            set i: i + 1
                        }
                    }
                    return n + this.count_in_stmt_ref(ch.alternative, name)
                }
                when fr: For
                    return this.count_in_ops(fr.expr, name) + this.count_in_action(fr.body, name)
                when wh: While
                    return this.count_in_ops(wh.cond.operation, name) + this.count_in_action(wh.body, name)
                when rp: Repeat
                    return this.count_in_action(rp.body, name)
                when tr: Try
                {
                    var n this.count_in_ops(tr.cond.operation, name)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                                set n: n + this.count_in_stmt_ref((*w_ptr).consequent, name)
                            set i: i + 1
                        }
                    }
                    return n + this.count_in_stmt_ref(tr.alternative, name)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                        return this.count_in_op((*is_expr.value), name)
                    return 0
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                        return this.count_in_op((*as_expr.value), name)
                    return 0
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                        return this.count_in_op((*vc.value), name)
                    return 0
                }
                when bx: Box
                {
                    if bx.value <> null
                        return this.count_in_op((*bx.value), name)
                    return 0
                }
                else
                    0
            1
        }

        ; A kept value next to a unary `&`: the value may point into the
        ; chunk's stack frame, which dies with the chunk.
        procedure check_kept_values(mutable this: TaskPlanner)
        {
            if cls_keeps and cls_takes_address
                this.block("keeps a value in a body that takes an address")
        }

        ; ================================================================
        ; While census (--loop-census; report only, emission untouched).
        ; Is a `while` a COUNTED loop -- the condition compares a plain
        ; variable, and the body steps that variable by a constant or a
        ; name exactly once, as one of its TOP-LEVEL statements -- and
        ; would its body then pass the `for` classifier with the counter
        ; as the loop variable? Nothing consumes the verdict but the
        ; report: it measures how much of a tree written with `while`
        ; the adaptive engine could reach, before anyone teaches the
        ; Emitter to drive a `while`.
        ; ================================================================

        procedure classify_while(mutable this: TaskPlanner, wh: PlannedWhile)
        {
            set whiles_total: whiles_total + 1
            let file_copy String^this(current_file)
            while_files.add file_copy
            while_offsets.add(wh.loc.start)
            set cls_step_first: false
            if this.find_counter(wh) = false
            {
                let nc "not counted: `cls_reason`"
                let nc_copy String^this(nc)
                while_verdicts.add nc_copy
                return
            }
            set whiles_counted: whiles_counted + 1
            this.classify_counted_body(wh)
            if cls_blocked
            {
                let bl "blocked: `cls_reason`"
                let bl_copy String^this(bl)
                while_verdicts.add bl_copy
                return
            }
            set whiles_parallel: whiles_parallel + 1
            let par_copy String^this("parallel")
            while_verdicts.add par_copy
        }

        ; The `for` classifier over a counted loop's body, with the counter
        ; as the loop variable (find_counter set cls_loop_var). The
        ; condition is walked too: the bound is read every iteration.
        procedure classify_counted_body(mutable this: TaskPlanner, wh: PlannedWhile)
        {
            set cls_locals.length: 0
            set cls_aliased.length: 0
            set cls_blocked: false
            set cls_reason: String^this("")
            set cls_depth: 0
            set cls_counter_mode: true
            set cls_counter_writes: 0
            set cls_counter_steps: 0
            set cls_continue_skips: false
            set cls_own_label: String^this(wh.loop_label)
            set cls_inner_labels.length: 0
            set cls_keeps: false
            set cls_takes_address: false
            this.reset_reductions()
            if file_is_foundation(current_file)
                this.block("engine foundation module")
            this.cls_operands(wh.cond.operation)
            if cls_blocked = false
                this.cls_action(wh.body)
            this.check_kept_values()
            this.check_reductions(wh.body, wh.cond.operation)
            set cls_counter_mode: false
            if cls_counter_writes > cls_counter_steps
                this.block("counter written besides its step")
            if cls_continue_skips
            {
                ; `set i: i + 1` + `continue` is the hand-written form of a
                ; `for`'s continue; a bare `continue` past the step is not
                if cls_counter_steps > 1
                    this.block("continue after its own step (a for would take it)")
                this.block("continue skips the counter step")
            }
        }

        ; A write of the counter that is itself a step (`set i: i + 1`
        ; before a `continue`) is not a second write of the counter.
        procedure note_counter_step(mutable this: TaskPlanner, act: PlannedAction)
        {
            if act.target = null
                return
            let t (*act.target)
            if t.length <> 1
                return
            let tp_ t.get 0
            if tp_ = null
                return
            let tname this.bare_variable_name(tp_.unwrap())
            if tname <> cls_loop_var
                return
            if this.is_step_of(act.source, cls_loop_var)
                set cls_counter_steps: cls_counter_steps + 1
        }

        procedure not_counted(mutable this: TaskPlanner, reason: String) returns bool
        {
            set cls_reason: String^this(reason)
            false
        }

        ; Recognize the counted shape. On success cls_loop_var names the
        ; counter and cls_step_first says whether its step is the body's
        ; first statement; on failure cls_reason names the missing part.
        procedure find_counter(mutable this: TaskPlanner, wh: PlannedWhile) returns bool
        {
            if wh.cond.binding_item.name <> null
                return this.not_counted("condition binds a name")
            let ops wh.cond.operation
            if ops = null
                return this.not_counted("empty condition")
            if ops.length <> 1
                return this.not_counted("condition is not one comparison")
            let op_ptr ops.get 0
            if op_ptr = null
                return this.not_counted("empty condition")
            let op op_ptr.unwrap()
            if this.is_comparison(op) = false
                return this.not_counted("condition is not a comparison")
            let stmts this.body_statements(wh.body)
            if stmts = null
                return this.not_counted("body is not a block")
            let lname this.comparison_side(op, 0)
            let rname this.comparison_side(op, 1)
            if lname.get_length() = 0 and rname.get_length() = 0
                return this.not_counted("comparison names no plain variable")
            let lk this.counter_steps(stmts, lname)
            if lk = 1
            {
                set cls_loop_var: String^this(lname)
                return true
            }
            let rk this.counter_steps(stmts, rname)
            if rk = 1
            {
                set cls_loop_var: String^this(rname)
                return true
            }
            if lk = 3 or rk = 3
                return this.not_counted("counter stepped twice at the top level")
            if lk = 2 or rk = 2
                return this.not_counted("counter step is not +/- a constant or name")
            this.not_counted("no top-level step of the compared variable")
        }

        ; A comparison call with two operands (`<`, `<=`, `>`, `>=`, `<>`).
        function is_comparison(this: TaskPlanner, op: PlannedOperand) returns bool
        {
            choose op.expr
                when call: Call
                {
                    if call.args = null
                        return false
                    let args (*call.args)
                    if args.length <> 2
                        return false
                    let nm call.name
                    match nm
                        case "<" case "<=" case ">" case ">=" case "<>": return true
                    return false
                }
                else
                    0
            false
        }

        ; The bare variable at argument position `index` of a comparison
        ; call, or "".
        function comparison_side(this: TaskPlanner, op: PlannedOperand, index: size_t) returns String
        {
            choose op.expr
                when call: Call
                {
                    if call.args = null
                        return ""
                    let args (*call.args)
                    if index >= args.length
                        return ""
                    let a_ptr args.get index
                    if a_ptr = null
                        return ""
                    return this.bare_variable_name(a_ptr.unwrap())
                }
                else
                    0
            ""
        }

        ; The name of a bare variable operand (no member hop), or "".
        function bare_variable_name(this: TaskPlanner, op: PlannedOperand) returns String
        {
            if op.member_access <> null
            {
                let ma (*op.member_access)
                if ma.length > 0
                    return ""
            }
            choose op.expr
                when v: Variable
                    return v.name
                else
                    0
            ""
        }

        ; The top-level statements of a braced loop body, or null.
        function body_statements(this: TaskPlanner, body: PlannedAction) returns ref[Vector[PlannedStatement]]?
        {
            if body.target <> null
                return null
            let src body.source
            if src = null
                return null
            if src.length <> 1
                return null
            let op_ptr src.get 0
            if op_ptr = null
                return null
            let op op_ptr.unwrap()
            choose op.expr
                when blk: Block
                    return blk.statements
                else
                    0
            null
        }

        ; How the top-level statements write `name`: 1 = exactly one step
        ; (`set name: name +/- K`, K a constant or a name) and no other
        ; top-level write, 2 = one write that is not such a step, 3 = more
        ; than one top-level write, 0 = none. Sets cls_step_first.
        procedure counter_steps(mutable this: TaskPlanner, stmts: ref[Vector[PlannedStatement]]?, name: String) returns int
        {
            if stmts = null
                return 0
            if name.get_length() = 0
                return 0
            var steps 0
            var others 0
            var first false
            var i: size_t 0
            while i < stmts.length
            {
                let s_ptr stmts.get i
                if s_ptr <> null
                {
                    let k this.step_kind(s_ptr.unwrap(), name)
                    if k = 1
                    {
                        set steps: steps + 1
                        if i = 0
                            set first: true
                    }
                    if k = 2
                        set others: others + 1
                }
                set i: i + 1
            }
            if steps + others > 1
                return 3
            if steps = 1
            {
                set cls_step_first: first
                return 1
            }
            if others = 1
                return 2
            0
        }

        ; 1 = stmt is a step of name, 2 = another write of name, 0 = neither.
        function step_kind(this: TaskPlanner, stmt: PlannedStatement, name: String) returns int
        {
            choose stmt
                when action: Action
                {
                    if action.target = null
                        return 0
                    let t (*action.target)
                    if t.length <> 1
                        return 0
                    let tp_ t.get 0
                    if tp_ = null
                        return 0
                    let tname this.bare_variable_name(tp_.unwrap())
                    if tname <> name
                        return 0
                    if this.is_step_of(action.source, name)
                        return 1
                    return 2
                }
                else
                    0
            0
        }

        ; Is src `name + K` or `name - K`, K a constant or a variable?
        function is_step_of(this: TaskPlanner, src: ref[Vector[PlannedOperand]]?, name: String) returns bool
        {
            if src = null
                return false
            if src.length <> 1
                return false
            let op_ptr src.get 0
            if op_ptr = null
                return false
            let op op_ptr.unwrap()
            choose op.expr
                when call: Call
                {
                    if call.name <> "+" and call.name <> "-"
                        return false
                    if call.args = null
                        return false
                    let args (*call.args)
                    if args.length <> 2
                        return false
                    let a0 args.get 0
                    if a0 = null
                        return false
                    let a1 args.get 1
                    if a1 = null
                        return false
                    let lhs this.bare_variable_name(a0.unwrap())
                    if lhs <> name
                        return false
                    let rhs a1.unwrap()
                    choose rhs.expr
                        when k: Constant
                            return true
                        when v: Variable
                            return v.name <> name
                        else
                            0
                    return false
                }
                else
                    0
            false
        }

        ; Milestone 4.4 entry point: the Emitter asks per `for` site
        ; whether the body verifies parallelizable — plain `for` drives
        ; the engine, no syntax involved. Same classifier, same
        ; conservatism as the report; the purity memo persists across
        ; sites on one instance.
        procedure loop_promotable(mutable this: TaskPlanner, plan: Plan, file: String, fr: PlannedFor) returns bool
        {
            set plan_functions: plan.functions
            set plan_globals: plan.globals
            set current_file: String^this(file)
            this.classify_body(fr)
            if cls_blocked
                return false
            true
        }

        ; Milestone 4.4: the adaptive engine never drives loops inside
        ; its own foundation. A fork allocates TaskGroup pages and may
        ; lazily create a worker pool — promoting the allocator's own
        ; teardown loops (Page.deallocate_extensions) or the fiber/task
        ; runtime's loops would re-enter that machinery mid-operation
        ; (page-tree teardown, thread-exit reclaim after the pools are
        ; drained). Keyed on the owning source file: the stdlib's memory
        ; and fiber modules stay sequential by rule, not by verdict.
        function file_is_foundation(file: String) returns bool
        {
            if file.contains("scaly/memory/") or file.contains("scaly/fiber/")
                return true
            false
        }

        ; Record the first blocker. Later calls are no-ops.
        procedure block(mutable this: TaskPlanner, reason: String)
        {
            if cls_blocked
                return
            set cls_blocked: true
            set cls_reason: String^this(reason)
        }

        procedure block_named(mutable this: TaskPlanner, prefix: String, name: String)
        {
            if cls_blocked
                return
            let msg "`prefix``name`"
            set cls_blocked: true
            set cls_reason: String^this(msg)
        }

        ; Is name bound inside the classified loop body? The loop variable
        ; itself counts: it is per-iteration state (each iteration sees a
        ; different element/index). An ALIASED name (see cls_aliased) is
        ; loop-external no matter what — aliasing wins over a same-named
        ; local binding (conservative under the flat never-popped scratch).
        function is_local(this: TaskPlanner, name: String) returns bool
        {
            var ai: size_t 0
            while ai < cls_aliased.length
            {
                let ap cls_aliased.get ai
                if ap <> null and (*ap) = name
                    return false
                set ai: ai + 1
            }
            if name = cls_loop_var
                return true
            var i: size_t 0
            while i < cls_locals.length
            {
                let p cls_locals.get i
                if p <> null and (*p) = name
                    return true
                set i: i + 1
            }
            false
        }

        ; Record a body-introduced name (binding, if-prop, choose-when,
        ; while/try condition binding, inner-for element): a name whose
        ; initializer / scrutinee / sequence can hand it a reference into
        ; loop-external state is an ALIAS, not a local — writes and
        ; mutating calls through it must block exactly like the external
        ; itself (the laundering counterexample: `let r outer` + `r.add i`).
        procedure add_body_name(mutable this: TaskPlanner, name: String, aliases_external: bool)
        {
            let n_copy String^this(name)
            if aliases_external
            {
                cls_aliased.add n_copy
                return
            }
            cls_locals.add n_copy
        }

        ; Can the value produced by ops carry a reference into
        ; loop-external state? Per operand: a SCALAR result never can
        ; (copies of arithmetic values alias nothing, whatever the
        ; expression shape — this keeps `set acc: acc + captured` and
        ; index math untainted). A non-scalar result aliases when the
        ; expression reaches a loop-external name: a bare external read
        ; IS the alias; call results can point into their arguments
        ; (Vector.get returns a ref INTO the vector) and constructions
        ; can store passed references, so calls taint when any argument
        ; does; unknown shapes taint conservatively (never a false
        ; "parallel").
        function ops_alias_external(this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?) returns bool
        {
            if ops = null
                return false
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null and this.op_aliases_external(op_ptr.unwrap())
                    return true
                set i: i + 1
            }
            false
        }

        function op_aliases_external(this: TaskPlanner, op: PlannedOperand) returns bool
        {
            if this.value_can_alias(op.result_type) = false
                return false
            choose op.expr
                when v: Variable
                {
                    if this.is_local(v.name)
                        return false
                    true
                }
                when c: Constant
                    false
                when t: Type
                    false
                when g: GlobalRef
                    false
                when call: Call
                    this.ops_alias_external(call.args)
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null and this.ops_alias_external(c_ptr.value)
                                return true
                            set i: i + 1
                        }
                    }
                    false
                }
                else
                    true
        }

        ; A copied SCALAR value cannot carry a reference into its source;
        ; records, unions, String (shares its buffer until reallocation)
        ; and pointer/ref (which ARE references) all can. Mirrors
        ; Planner.is_scalar_value_type_name's list.
        function value_can_alias(this: TaskPlanner, t: PlannedType) returns bool
        {
            if t.name = "bool"
                return false
            if t.name = "int"
                return false
            if t.name = "uint"
                return false
            if t.name = "char"
                return false
            if t.name = "i8"
                return false
            if t.name = "i16"
                return false
            if t.name = "i32"
                return false
            if t.name = "i64"
                return false
            if t.name = "u8"
                return false
            if t.name = "u16"
                return false
            if t.name = "u32"
                return false
            if t.name = "u64"
                return false
            if t.name = "f32"
                return false
            if t.name = "f64"
                return false
            if t.name = "float"
                return false
            if t.name = "double"
                return false
            if t.name = "size_t"
                return false
            if t.name = "size"
                return false
            true
        }

        ; Does the operand tree read the given name? Used to accept a
        ; Vector.put whose index is derived from the loop variable
        ; (disjoint-slot write). Conservative: unknown shapes read nothing,
        ; so an index that hides the loop variable behind them stays a
        ; blocker (never a false "parallel").
        function operands_read_name(this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?, name: String) returns bool
        {
            if ops = null
                return false
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null and this.operand_reads_name(op_ptr.unwrap(), name)
                    return true
                set i: i + 1
            }
            false
        }

        function operand_reads_name(this: TaskPlanner, op: PlannedOperand, name: String) returns bool
        {
            choose op.expr
                when v: Variable
                {
                    if v.name = name
                        return true
                }
                when call: Call
                {
                    if call.args <> null
                    {
                        var i: size_t 0
                        while i < call.args.length
                        {
                            let ap call.args.get i
                            if ap <> null and this.operand_reads_name(ap.unwrap(), name)
                                return true
                            set i: i + 1
                        }
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        if this.operand_reads_name((*r), name)
                            return true
                    }
                }
                when tp: Tuple
                {
                    ; A parenthesized expression plans as a one-component
                    ; Tuple — `(i * n + j) as size_t` must still count as
                    ; reading the loop variable.
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null and this.operands_read_name(c_ptr.value, name)
                                return true
                            set i: i + 1
                        }
                    }
                }
                else
                    0
            false
        }

        procedure cls_operands(mutable this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?)
        {
            if cls_blocked
                return
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                if cls_blocked
                    return
                let op_ptr ops.get i
                if op_ptr <> null
                    this.cls_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        procedure cls_statement_ref(mutable this: TaskPlanner, stmt: ref[PlannedStatement]?)
        {
            if cls_blocked
                return
            if stmt <> null
            {
                let s stmt
                this.cls_statement((*s))
            }
        }

        ; Walk one action: reads first, then the write target. A bare `set
        ; name:` into a body-local binding is fine; anything whose root
        ; lives outside the loop is a cross-iteration conflict.
        procedure cls_action(mutable this: TaskPlanner, act: PlannedAction)
        {
            if cls_blocked
                return
            if this.try_reduction_action(act)
                return
            this.cls_operands(act.source)
            if cls_blocked
                return
            if act.target <> null
            {
                if cls_counter_mode
                    this.note_counter_step(act)
                this.cls_write_target((*act.target))
                if cls_blocked
                    return
                ; Alias soundness: a `set LOCAL: <expr reaching
                ; loop-external state>` (whole-variable or member) re-seats
                ; the local as an alias — later writes and mutating calls
                ; through it must block like the external itself.
                this.retaint_write_target((*act.target), act.source)
            }
        }

        procedure retaint_write_target(mutable this: TaskPlanner, t: Vector[PlannedOperand], src: ref[Vector[PlannedOperand]]?)
        {
            if t.length <> 1
                return
            let tp_ t.get 0
            if tp_ = null
                return
            let top tp_.unwrap()
            choose top.expr
                when v: Variable
                {
                    if this.is_local(v.name) = false
                        return
                    if this.ops_alias_external(src)
                    {
                        let an_copy String^this(v.name)
                        cls_aliased.add an_copy
                    }
                }
                else
                    0
        }

        procedure cls_write_target(mutable this: TaskPlanner, t: Vector[PlannedOperand])
        {
            if cls_blocked
                return
            if t.length <> 1
            {
                this.block("compound assignment target")
                return
            }
            let tp_ t.get 0
            if tp_ = null
                return
            let top tp_.unwrap()
            choose top.expr
                when v: Variable
                {
                    if cls_counter_mode and v.name = cls_loop_var
                        set cls_counter_writes: cls_counter_writes + 1
                    if this.is_local(v.name) = false
                        this.block_named("writes loop-external ", v.name)
                }
                when g: GlobalRef
                    this.block_named("writes mutable global ", g.name)
                else
                    this.block("indirect write")
        }

        procedure cls_statement(mutable this: TaskPlanner, stmt: PlannedStatement)
        {
            if cls_blocked
                return
            choose stmt
                when action: Action
                    this.cls_action(action)
                when binding: Binding
                {
                    this.cls_operands(binding.operation)
                    if binding.binding_item.name <> null
                    {
                        let bn_alias this.ops_alias_external(binding.operation)
                        this.add_body_name((*binding.binding_item.name), bn_alias)
                    }
                }
                when ret: Return
                    this.block("early exit (return)")
                when throw_stmt: Throw
                    this.block("early exit (throw)")
                when brk: Break
                {
                    if cls_depth = 0
                    {
                        this.block("early exit (break)")
                        return
                    }
                    if brk.loop_label.get_length() > 0
                    {
                        this.block("early exit (labeled break)")
                        return
                    }
                    this.cls_operands(brk.result)
                }
                when cont: Continue
                {
                    if this.label_leaves_body(cont.loop_label)
                    {
                        this.block("early exit (labeled continue)")
                        return
                    }
                    if cls_counter_mode and cls_step_first = false
                    {
                        if cls_depth = 0
                            set cls_continue_skips: true
                        if cont.loop_label.get_length() > 0
                            set cls_continue_skips: true
                    }
                }
        }

        procedure cls_operand(mutable this: TaskPlanner, op: PlannedOperand)
        {
            if cls_blocked
                return
            choose op.expr
                when call: Call
                    this.cls_call(call)
                when v: Variable
                    0
                when g: GlobalRef
                    this.check_global_read(g)
                when tp: Tuple
                {
                    this.check_life(tp.life)
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.cls_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.cls_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    if this.try_reduction_if(iff)
                        return
                    this.cls_operands(iff.condition)
                    if iff.prop <> null
                    {
                        ; The null-narrow binding aliases the tested value.
                        let ic_alias this.ops_alias_external(iff.condition)
                        this.add_body_name(iff.prop.name, ic_alias)
                    }
                    this.cls_statement_ref(iff.consequent)
                    this.cls_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.cls_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.cls_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.cls_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.cls_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.cls_operands(ch.condition)
                    ; A when-binding aliases the scrutinee's variant payload.
                    let ch_alias this.ops_alias_external(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.add_body_name(w.name, ch_alias)
                                this.cls_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.cls_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.cls_operands(fr.expr)
                    ; An inner loop's element aliases the sequence — and
                    ; unlike the CLASSIFIED loop's variable it is NOT
                    ; per-iteration-disjoint: every outer iteration walks
                    ; ALL elements, so an external sequence's elements are
                    ; shared across workers.
                    let fe_alias this.ops_alias_external(fr.expr)
                    this.add_body_name(fr.identifier, fe_alias)
                    this.note_inner_label(fr.loop_label)
                    set cls_depth: cls_depth + 1
                    this.cls_action(fr.body)
                    set cls_depth: cls_depth - 1
                }
                when wh: While
                {
                    this.cls_operands(wh.cond.operation)
                    if wh.cond.binding_item.name <> null
                    {
                        let wc_alias this.ops_alias_external(wh.cond.operation)
                        this.add_body_name((*wh.cond.binding_item.name), wc_alias)
                    }
                    this.note_inner_label(wh.loop_label)
                    set cls_depth: cls_depth + 1
                    this.cls_action(wh.body)
                    set cls_depth: cls_depth - 1
                }
                when rp: Repeat
                {
                    this.note_inner_label(rp.loop_label)
                    set cls_depth: cls_depth + 1
                    this.cls_action(rp.body)
                    set cls_depth: cls_depth - 1
                }
                when tr: Try
                {
                    this.cls_operands(tr.cond.operation)
                    if tr.cond.binding_item.name <> null
                    {
                        let tc_alias this.ops_alias_external(tr.cond.operation)
                        this.add_body_name((*tr.cond.binding_item.name), tc_alias)
                    }
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                let cn_copy String^this(w.name)
                                cls_locals.add cn_copy
                                this.cls_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.cls_statement_ref(tr.alternative)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.cls_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.cls_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.cls_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    this.check_life(mx.life)
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.cls_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                when lm: Lambda
                    this.block("lambda in body")
                when cl: Closure
                    this.block("closure value in body")
                when fref: FunctionRef
                    this.block("function reference in body")
                when bx: Box
                    this.block("boxes onto an external page")
                else
                    0
        }

        ; A frame-local allocation (Local/Unspecified life) stays inside
        ; the iteration; a Call life (caller page) or Reference life
        ; (^this / ^named page) escapes the loop frame.
        procedure check_life(mutable this: TaskPlanner, life: Lifetime)
        {
            if cls_blocked
                return
            choose life
                when l: Local
                    0
                when u: Unspecified
                    0
                when c: Call
                    ; Argument scratch — lives for the duration of the
                    ; call, strictly inside one iteration's frame (the
                    ; planner leaves this on the arg tuple of a
                    ; bare-variable argument, `spin_big(base)`).
                    0
                else
                    ; Reference (^page/^this) and Thrown escape the
                    ; iteration — blocked.
                    this.block("non-local allocation")
        }

        ; Reading a MUTABLE module global blocks: since M2.2 every mutable
        ; global (except `shared` declarations) is thread-local, so a task
        ; running on a
        ; worker thread reads a different cell than the spawner. The
        ; allocator's own state cells are sanctioned — RBMM allocation is
        ; per-task by design (one region per task).
        procedure check_global_read(mutable this: TaskPlanner, g: PlannedGlobalRef)
        {
            if cls_blocked
                return
            if plan_globals = null
                return
            for global in plan_globals
            {
                if global.mangled_name = g.mangled_name
                {
                    if global.is_mutable and this.global_is_sanctioned(global.name) = false
                        this.block_named("reads mutable global ", g.name)
                    return
                }
            }
        }

        ; ================================================================
        ; Sanctioned effects. A task allocates in its OWN region, so the
        ; RBMM machinery — allocator externs, allocator/tracer state
        ; cells, atomic primitives (the allocator's cross-thread free
        ; discipline), and abort-class trap reporting — does not break
        ; parallelizability. Everything else observable (I/O, scheduler
        ; state, process control beyond abort) does.
        ; ================================================================

        ; The stdlib's READ primitives (ROADMAP 4.5): they reach the world
        ; outside the program only to READ it, so independent iterations may
        ; run them in any order and at once — a parallel `for` body may call
        ; them, and they overlap on the pool's worker threads (which have no
        ; scheduler: File takes its plain blocking path there). Treated like
        ; the stub of a `function`: nothing written but the page the result
        ; lands on. A LIST, by the mangled name's owner and routine: the
        ; interfaces carry one `io` bit for reading and writing alike, and the
        ; externs cannot tell them apart (fopen reads or truncates by its
        ; mode). Every writer — Console, File.write_from_string, a socket —
        ; still blocks the loop: its order is the program's output.
        function is_read_primitive(mangled: String) returns bool
        {
            if mangled.starts_with("_ZN4File14read_to_stringE")
                return true
            if mangled.starts_with("_ZN4File6existsE")
                return true
            if mangled.starts_with("_ZN9Directory6existsE")
                return true
            mangled.starts_with("_ZN9Directory12is_directoryE")
        }

        function extern_is_benign(this: TaskPlanner, name: String) returns bool
        {
            if name.starts_with("scaly_atomic_")
                return true
            match name
                case "aligned_alloc" case "malloc" case "calloc" case "realloc" case "free" case "memcpy": return true
                case "memmove" case "memset" case "memcmp" case "strlen" case "strcmp" case "strncmp": return true
                case "strdup" case "exit" case "scaly_eputs" case "scaly_eputi" case "scaly_eputnl": return true
            ; libm scalar math (5.1 op kernels: softmax/GELU/layernorm).
            ; Pure value→value; errno is thread-local, so concurrent calls
            ; cannot race.
            match name
                case "expf" case "exp" case "tanhf" case "tanh" case "sqrtf" case "sqrt": return true
                case "logf" case "log" case "powf" case "pow" case "fabsf" case "fabs": return true
            false
        }

        function global_is_sanctioned(this: TaskPlanner, name: String) returns bool
        {
            match name
                case "heap_head" case "stack_head" case "stack_top" case "dead_buckets_reclaimed": return true
                case "trace_enabled" case "trace_atexit_registered" case "trace_count": return true
                case "trace_entries" case "fmt_scratch" case "heap_trace_state" case "heap_trace": return true
            false
        }

        ; ================================================================
        ; Transitive purity. `pure` on a PlannedFunction is a DECLARATION
        ; (function vs procedure keyword), not a proof. effectively_pure
        ; proves the absence of observable effects: the body — and every
        ; body reachable through its calls — contains no non-benign
        ; extern, no indirect call, no unsanctioned mutable-global touch,
        ; and no lambda/closure value (conservative). Nested callees are
        ; NOT required to be declared pure: a pure function legitimately
        ; drives mutating container procedures (Array.add, Vector.put) on
        ; its frame-local state; the declared-pure contract of the DIRECT
        ; callee (checked in callee_verdict) keeps loop-visible inputs
        ; immutable. Memoized per mangled name.
        ; ================================================================

        procedure memo_purity(mutable this: TaskPlanner, mangled: String, is_pure: bool)
        {
            let m_copy String^this(mangled)
            pure_memo_names.add m_copy
            var flag: size_t 0
            if is_pure
                set flag: 1
            pure_memo_flags.add flag
        }

        procedure effectively_pure(mutable this: TaskPlanner, mangled: String) returns bool
        {
            var i: size_t 0
            while i < pure_memo_names.length
            {
                let p pure_memo_names.get i
                if p <> null
                {
                    if (*p) = mangled
                    {
                        let f pure_memo_flags.get i
                        if f <> null
                            return (*f) = 1
                        return false
                    }
                }
                set i: i + 1
            }
            var j: size_t 0
            while j < pure_stack.length
            {
                let sp pure_stack.get j
                if sp <> null and (*sp) = mangled
                    return true
                set j: j + 1
            }
            if plan_functions = null
                return false
            ; plan.functions can hold BOTH an extern declaration entry and
            ; the Action definition for one mangled name (cross-module
            ; declaration duplicates) — a body wins over a declaration.
            var saw_extern false
            var extern_benign false
            for func in plan_functions
            {
                if func.mangled_name = mangled
                {
                    ; a `function` is pure BY RULE since 2026-09-19 (the
                    ; compiler checks it: no write, no global either way, no
                    ; I/O) -- trusted without walking its body; a read
                    ; primitive counts as one (is_read_primitive)
                    if func.pure or TaskPlanner.is_read_primitive(mangled)
                    {
                        this.memo_purity(mangled, true)
                        return true
                    }
                    choose func.impl
                        when action: Action
                        {
                            let sm_copy String^this(mangled)
                            pure_stack.add sm_copy
                            let saved pw_impure
                            set pw_impure: false
                            this.pw_action(action)
                            var is_pure true
                            if pw_impure
                                set is_pure: false
                            set pw_impure: saved
                            set pure_stack.length: pure_stack.length - 1
                            this.memo_purity(mangled, is_pure)
                            return is_pure
                        }
                        when e: Extern
                        {
                            set saw_extern: true
                            if this.extern_is_benign(func.name)
                                set extern_benign: true
                        }
                        else
                        {
                            this.memo_purity(mangled, true)
                            return true
                        }
                }
            }
            if saw_extern
            {
                this.memo_purity(mangled, extern_benign)
                return extern_benign
            }
            this.memo_purity(mangled, false)
            false
        }

        ; The purity walk: recurse over a callee body looking for effect
        ; violations. Same arm coverage as the finder; only calls and
        ; global touches carry logic.
        procedure pw_operands(mutable this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?)
        {
            if pw_impure
                return
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                if pw_impure
                    return
                let op_ptr ops.get i
                if op_ptr <> null
                    this.pw_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        procedure pw_statement_ref(mutable this: TaskPlanner, stmt: ref[PlannedStatement]?)
        {
            if pw_impure
                return
            if stmt <> null
            {
                let s stmt
                this.pw_statement((*s))
            }
        }

        ; Writes to LOCAL state are what procedures are for — only a
        ; global store is an observable effect here.
        procedure pw_action(mutable this: TaskPlanner, act: PlannedAction)
        {
            if pw_impure
                return
            this.pw_operands(act.source)
            if pw_impure
                return
            if act.target <> null
            {
                let t (*act.target)
                var i: size_t 0
                while i < t.length
                {
                    let tp_ t.get i
                    if tp_ <> null
                    {
                        let top tp_.unwrap()
                        choose top.expr
                            when g: GlobalRef
                            {
                                if this.global_is_sanctioned(g.name) = false
                                    set pw_impure: true
                            }
                            else
                                this.pw_operand(top)
                    }
                    set i: i + 1
                }
            }
        }

        procedure pw_statement(mutable this: TaskPlanner, stmt: PlannedStatement)
        {
            if pw_impure
                return
            choose stmt
                when action: Action
                    this.pw_action(action)
                when binding: Binding
                    this.pw_operands(binding.operation)
                when ret: Return
                    this.pw_operands(ret.result)
                when throw_stmt: Throw
                    this.pw_operands(throw_stmt.result)
                when brk: Break
                    this.pw_operands(brk.result)
                when cont: Continue
                    0
        }

        procedure pw_global(mutable this: TaskPlanner, g: PlannedGlobalRef)
        {
            if pw_impure
                return
            if plan_globals = null
                return
            for global in plan_globals
            {
                if global.mangled_name = g.mangled_name
                {
                    if global.is_mutable and this.global_is_sanctioned(global.name) = false
                        set pw_impure: true
                    return
                }
            }
        }

        procedure pw_call(mutable this: TaskPlanner, call: PlannedCall)
        {
            if pw_impure
                return
            this.pw_operands(call.args)
            if pw_impure
                return
            if call.is_indirect
            {
                set pw_impure: true
                return
            }
            ; a SIMD store writes through its container: not effect-free
            if call.is_intrinsic and TaskPlanner.is_simd_store(call.name)
            {
                set pw_impure: true
                return
            }
            if call.is_intrinsic
                return
            if call.is_operator
                return
            if this.is_construction_name(call.name)
                return
            ; The bounds and null traps (scaly_panic_*) never come back into
            ; the body: they jump to a catch point or exit. What they write on
            ; the way — a trap counter — is not an effect of the iteration, as
            ; the write census (the abort path) and StoreEffects already hold.
            ; Walked, they made every procedure that calls `put` on its own
            ; local Vector "transitively impure" (Vector.put checks its index
            ; through scaly_panic_oob), and a loop over such a procedure ran
            ; sequentially (2026-09-27, the fannkuch gap analysis).
            if call.name.starts_with("scaly_panic_")
                return
            if this.effectively_pure(call.mangled_name) = false
                set pw_impure: true
        }

        procedure pw_operand(mutable this: TaskPlanner, op: PlannedOperand)
        {
            if pw_impure
                return
            choose op.expr
                when call: Call
                    this.pw_call(call)
                when g: GlobalRef
                    this.pw_global(g)
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.pw_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.pw_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.pw_operands(iff.condition)
                    this.pw_statement_ref(iff.consequent)
                    this.pw_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.pw_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.pw_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.pw_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.pw_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.pw_operands(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.pw_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.pw_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.pw_operands(fr.expr)
                    this.pw_action(fr.body)
                }
                when wh: While
                {
                    this.pw_operands(wh.cond.operation)
                    this.pw_action(wh.body)
                }
                when rp: Repeat
                    this.pw_action(rp.body)
                when tr: Try
                {
                    this.pw_operands(tr.cond.operation)
                    if tr.catches <> null
                    {
                        var i: size_t 0
                        while i < tr.catches.length
                        {
                            let w_ptr tr.catches.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.pw_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.pw_statement_ref(tr.alternative)
                }
                when is_expr: Is
                {
                    if is_expr.value <> null
                    {
                        let r is_expr.value
                        this.pw_operand((*r))
                    }
                }
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        this.pw_operand((*r))
                    }
                }
                when vc: VariantConstruction
                {
                    if vc.value <> null
                    {
                        let r vc.value
                        this.pw_operand((*r))
                    }
                }
                when mx: Matrix
                {
                    if mx.operations <> null
                    {
                        var i: size_t 0
                        while i < mx.operations.length
                        {
                            let row_ptr mx.operations.get i
                            if row_ptr <> null
                                this.pw_operands(row_ptr)
                            set i: i + 1
                        }
                    }
                }
                when lm: Lambda
                    set pw_impure: true
                when cl: Closure
                    set pw_impure: true
                when fref: FunctionRef
                    set pw_impure: true
                when bx: Box
                {
                    if bx.value <> null
                    {
                        let r bx.value
                        this.pw_operand((*r))
                    }
                }
                else
                    0
        }

        procedure cls_call(mutable this: TaskPlanner, call: PlannedCall)
        {
            if cls_blocked
                return
            this.cls_operands(call.args)
            if cls_blocked
                return
            if call.is_indirect
            {
                this.block("indirect call")
                return
            }
            if call.is_operator and call.name = "&" and call.args <> null and call.args.length = 1
                set cls_takes_address: true
            ; a SIMD store's lanes are not proven disjoint across iterations
            if call.is_intrinsic and TaskPlanner.is_simd_store(call.name)
            {
                this.block("SIMD store")
                return
            }
            if call.is_intrinsic
                return
            if call.is_operator
                return
            if call.can_throw
            {
                this.block_named("throwing call ", call.name)
                return
            }
            ; Constructions (a capitalized Type name, or the reserved `init`
            ; constructor) are fine when they allocate frame-locally; the
            ; lifetime says where the value lands.
            if this.is_construction_name(call.name)
            {
                this.check_life(call.life)
                return
            }
            ; The canonical disjoint result target: `results.put(i, v)` on a
            ; Vector. A body-local receiver may be written freely; an
            ; external receiver qualifies only when the index reads the
            ; loop variable (disjoint slots per iteration).
            if call.name = "put"
            {
                if this.put_is_disjoint(call)
                    return
                this.block("put into an external vector: loop-invariant index or non-scalar value")
                return
            }
            this.callee_verdict(call)
        }

        ; A namespace-qualified call carries its qualifier in the name
        ; (`Esis.put`), so the capital that marks a construction is judged
        ; on the LAST segment: `Sink.put(acc, b)` is a procedure call that
        ; writes acc, and read as a construction it passed as a
        ; frame-local allocation -- a false "parallel" the Emitter acted on.
        function is_construction_name(this: TaskPlanner, name: String) returns bool
        {
            if name = "init"
                return true
            let n name.get_length()
            var start: size_t 0
            var i: size_t 0
            while i < n
            {
                if name.get(i) = ("." as char)
                    set start: i + 1
                set i: i + 1
            }
            if start >= n
                return false
            let c name.get(start)
            if c >= ("A" as char) and c <= ("Z" as char)
                return true
            false
        }

        ; put(receiver, index, element): receiver = args[0], index = args[1].
        procedure put_is_disjoint(mutable this: TaskPlanner, call: PlannedCall) returns bool
        {
            if call.args = null
                return false
            if call.args.length < 3
                return false
            let recv_ptr call.args.get 0
            if recv_ptr <> null
            {
                let recv recv_ptr.unwrap()
                var recv_bare true
                if recv.member_access <> null
                {
                    let ma (*recv.member_access)
                    if ma.length > 0
                        set recv_bare: false
                }
                if recv_bare
                    choose recv.expr
                        when v: Variable
                        {
                            if this.is_local(v.name)
                                return true
                        }
                        else
                            0
            }
            let idx_ptr call.args.get 1
            if idx_ptr = null
                return false
            if this.operand_reads_name(idx_ptr.unwrap(), cls_loop_var) = false
                return false
            ; The slot is disjoint; the VALUE must not carry this
            ; iteration's allocations out of it. A promoted body runs on a
            ; task region released at the end of its chunk, so a String
            ; built by `mk(i)` and kept in `out.put(i, mk(i))` dangled --
            ; 306 of 400 slots overwritten at rc 0. Only a value that
            ; cannot point anywhere is admitted into a loop-external vector.
            let val_ptr call.args.get 2
            if val_ptr = null
                return false
            let vt val_ptr.unwrap().result_type
            if this.value_can_alias(vt) = false
                return true
            ; A kept value: admitted when it is a VALUE (a String, a record),
            ; its allocations then adopted with the chunk's region -- never a
            ; reference, which could point anywhere, the chunk's stack included.
            if TaskPlanner.type_is_reference_shaped(vt)
                return false
            set cls_keeps: true
            true
        }

        ; ref / pointer / an Option over one / a delegate or function pointer
        function type_is_reference_shaped(t: PlannedType) returns bool
        {
            let nm t.name
            match nm
                case "ref" case "pointer": return true
            if t.name = "Option" and t.generics <> null and t.generics.length = 1
            {
                let g_ptr t.generics.get 0
                if g_ptr <> null
                    return TaskPlanner.type_is_reference_shaped(g_ptr.unwrap())
            }
            false
        }

        ; ================================================================
        ; Written-params analysis (wm_/wr_): which of a callee's input
        ; positions can it WRITE through, transitively? The result is a
        ; bitmask over input indices (call args align 1:1 — methods
        ; declare `this` as input[0] and it rides args[0]; page params
        ; are peeled by the Modeler and appear in neither). Mask 0 means
        ; the callee only READS its inputs — a loop body may then pass
        ; loop-external values freely (`a.get j` on a shared input
        ; vector); a set bit demands a per-iteration argument at that
        ; position (`outer.add v` — List.add writes this, bit 0 —
        ; blocks). WM_ALL (all ones) is the conservative unknown.
        ; Constructions are treated as read-only on their arguments
        ; (they write the FRESH object; matches cls_call's construction
        ; policy). Runs only on effectively_pure callees, so globals,
        ; I/O, lambdas and indirect calls are already policed.
        ; ================================================================

        function wm_all() returns size_t
        {
            0 - 1
        }

        procedure memo_written(mutable this: TaskPlanner, mangled: String, mask: size_t)
        {
            let m_copy String^this(mangled)
            wm_memo_names.add m_copy
            wm_memo_vals.add mask
        }

        procedure written_mask(mutable this: TaskPlanner, mangled: String) returns size_t
        {
            var i: size_t 0
            while i < wm_memo_names.length
            {
                let p wm_memo_names.get i
                if p <> null
                {
                    if (*p) = mangled
                    {
                        let v wm_memo_vals.get i
                        if v <> null
                            return (*v)
                        return wm_all()
                    }
                }
                set i: i + 1
            }
            ; Recursion among walked functions: optimistic 0 — a concrete
            ; write elsewhere in the cycle still surfaces in the caller's
            ; own walk (the pure_stack discipline).
            var j: size_t 0
            while j < wm_stack.length
            {
                let sp wm_stack.get j
                if sp <> null and (*sp) = mangled
                    return 0
                set j: j + 1
            }
            if plan_functions = null
                return wm_all()
            var saw_extern false
            var extern_mask: size_t 0
            for func in plan_functions
            {
                if func.mangled_name = mangled
                {
                    choose func.impl
                        when action: Action
                        {
                            ; The 62-input cap keeps every shift < 63.
                            var pcount: size_t 0
                            if func.input <> null
                            {
                                let input_ref func.input.unwrap()
                                let input input_ref
                                set pcount: input.length
                            }
                            if pcount > 62
                            {
                                this.memo_written(mangled, wm_all())
                                return wm_all()
                            }
                            let sm_copy String^this(mangled)
                            wm_stack.add sm_copy
                            let saved_mask wr_mask
                            let saved_base wr_base
                            let saved_len wr_names.length
                            set wr_mask: 0
                            set wr_base: wr_names.length
                            ; Seed the params, each with its own bit.
                            if func.input <> null
                            {
                                let input_ref func.input.unwrap()
                                let input input_ref
                                var pi: size_t 0
                                while pi < pcount
                                {
                                    let item_p input.get pi
                                    if item_p <> null
                                    {
                                        let item (*item_p)
                                        if item.name <> null
                                            this.wr_add_name((*item.name), 1 << pi)
                                    }
                                    set pi: pi + 1
                                }
                            }
                            this.wr_action(action)
                            let result wr_mask
                            set wr_mask: saved_mask
                            set wr_base: saved_base
                            set wr_names.length: saved_len
                            set wr_masks.length: saved_len
                            set wm_stack.length: wm_stack.length - 1
                            this.memo_written(mangled, result)
                            return result
                        }
                        when e: Extern
                        {
                            set saw_extern: true
                            let em this.extern_written_mask(func.name)
                            set extern_mask: (extern_mask | em)
                        }
                        else
                        {
                            ; Intrinsic/Instruction impls: primitive value
                            ; ops, no pointer writes.
                            this.memo_written(mangled, 0)
                            return 0
                        }
                }
            }
            if saw_extern
            {
                this.memo_written(mangled, extern_mask)
                return extern_mask
            }
            this.memo_written(mangled, wm_all())
            wm_all()
        }

        ; Hard-coded masks for the benign-extern whitelist (the writers
        ; write through arg 0; realloc/free consume arg 0). Anything not
        ; explicitly listed is WM_ALL — adding a new benign extern FORCES
        ; a mask decision here.
        function extern_written_mask(this: TaskPlanner, name: String) returns size_t
        {
            if name.starts_with("scaly_atomic_")
                return 0
            if name = "memcpy"
                return 1 as size_t
            if name = "memmove"
                return 1 as size_t
            if name = "memset"
                return 1 as size_t
            if name = "free"
                return 1 as size_t
            if name = "realloc"
                return 1 as size_t
            if name = "malloc"
                return 0
            if name = "calloc"
                return 0
            if name = "aligned_alloc"
                return 0
            if name = "memcmp"
                return 0
            if name = "strlen"
                return 0
            if name = "strcmp"
                return 0
            if name = "strncmp"
                return 0
            if name = "strdup"
                return 0
            if name = "exit"
                return 0
            if name = "scaly_eputs"
                return 0
            if name = "scaly_eputi"
                return 0
            if name = "scaly_eputnl"
                return 0
            ; libm scalar math: reads its value arguments, writes nothing.
            if name = "expf"
                return 0
            if name = "exp"
                return 0
            if name = "tanhf"
                return 0
            if name = "tanh"
                return 0
            if name = "sqrtf"
                return 0
            if name = "sqrt"
                return 0
            if name = "logf"
                return 0
            if name = "log"
                return 0
            if name = "powf"
                return 0
            if name = "pow"
                return 0
            if name = "fabsf"
                return 0
            if name = "fabs"
                return 0
            wm_all()
        }

        ; ---- the per-callee body walk ----

        procedure wr_add_name(mutable this: TaskPlanner, name: String, mask: size_t)
        {
            let n_copy String^this(name)
            wr_names.add n_copy
            wr_masks.add mask
        }

        ; Latest entry wins (backward scan): a re-taint appends a wider
        ; mask that shadows the original. Unknown names are conservative
        ; (a global write is policed by the purity walk; anything else
        ; is a shape this walk does not model).
        function wr_lookup(this: TaskPlanner, name: String) returns size_t
        {
            var i wr_names.length
            while i > wr_base
            {
                set i: i - 1
                let p wr_names.get i
                if p <> null
                {
                    if (*p) = name
                    {
                        let m wr_masks.get i
                        if m <> null
                            return (*m)
                        return wm_all()
                    }
                }
            }
            wm_all()
        }

        ; Reach-mask of the value an operand produces: which params can
        ; it alias? Scalars reach nothing; a call result reaches at most
        ; what its arguments reach; unknown shapes reach everything.
        function wr_mask_of_ops(this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?) returns size_t
        {
            if ops = null
                return 0
            var acc: size_t 0
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    set acc: (acc | this.wr_mask_of_op(op_ptr.unwrap()))
                set i: i + 1
            }
            acc
        }

        function wr_mask_of_op(this: TaskPlanner, op: PlannedOperand) returns size_t
        {
            if this.value_can_alias(op.result_type) = false
                return 0
            choose op.expr
                when v: Variable
                    return this.wr_lookup(v.name)
                when c: Constant
                    return 0
                when t: Type
                    return 0
                when g: GlobalRef
                    return 0
                when call: Call
                    return this.wr_mask_of_ops(call.args)
                when tp: Tuple
                {
                    var acc: size_t 0
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                set acc: (acc | this.wr_mask_of_ops(c_ptr.value))
                            set i: i + 1
                        }
                    }
                    return acc
                }
                else
                    0
            wm_all()
        }

        procedure wr_operands(mutable this: TaskPlanner, ops: ref[Vector[PlannedOperand]]?)
        {
            if ops = null
                return
            var i: size_t 0
            while i < ops.length
            {
                let op_ptr ops.get i
                if op_ptr <> null
                    this.wr_operand(op_ptr.unwrap())
                set i: i + 1
            }
        }

        procedure wr_statement_ref(mutable this: TaskPlanner, stmt: ref[PlannedStatement]?)
        {
            if stmt <> null
            {
                let s stmt
                this.wr_statement((*s))
            }
        }

        procedure wr_action(mutable this: TaskPlanner, act: PlannedAction)
        {
            this.wr_operands(act.source)
            if act.target <> null
            {
                let t (*act.target)
                if t.length <> 1
                {
                    set wr_mask: wm_all()
                    return
                }
                let tp_ t.get 0
                if tp_ = null
                    return
                let top tp_.unwrap()
                choose top.expr
                    when v: Variable
                    {
                        ; The write lands wherever the root reaches; and
                        ; storing an aliasing value INTO a name widens
                        ; what later writes through it can reach.
                        set wr_mask: (wr_mask | this.wr_lookup(v.name))
                        let smask this.wr_mask_of_ops(act.source)
                        if smask <> 0
                        {
                            let widened (this.wr_lookup(v.name) | smask)
                            this.wr_add_name(v.name, widened)
                        }
                    }
                    when g: GlobalRef
                        0
                    else
                        set wr_mask: wm_all()
            }
        }

        procedure wr_statement(mutable this: TaskPlanner, stmt: PlannedStatement)
        {
            choose stmt
                when action: Action
                    this.wr_action(action)
                when binding: Binding
                {
                    this.wr_operands(binding.operation)
                    if binding.binding_item.name <> null
                    {
                        let bmask this.wr_mask_of_ops(binding.operation)
                        this.wr_add_name((*binding.binding_item.name), bmask)
                    }
                }
                when ret: Return
                    this.wr_operands(ret.result)
                when throw_stmt: Throw
                    this.wr_operands(throw_stmt.result)
                when brk: Break
                    this.wr_operands(brk.result)
                when cont: Continue
                    0
        }

        procedure wr_operand(mutable this: TaskPlanner, op: PlannedOperand)
        {
            choose op.expr
                when call: Call
                    this.wr_call(call)
                when blk: Block
                {
                    if blk.statements <> null
                    {
                        var i: size_t 0
                        while i < blk.statements.length
                        {
                            let s_ptr blk.statements.get i
                            if s_ptr <> null
                                this.wr_statement(s_ptr.unwrap())
                            set i: i + 1
                        }
                    }
                }
                when iff: If
                {
                    this.wr_operands(iff.condition)
                    if iff.prop <> null
                    {
                        let pmask this.wr_mask_of_ops(iff.condition)
                        this.wr_add_name(iff.prop.name, pmask)
                    }
                    this.wr_statement_ref(iff.consequent)
                    this.wr_statement_ref(iff.alternative)
                }
                when mt: Match
                {
                    this.wr_operands(mt.condition)
                    if mt.branches <> null
                    {
                        var i: size_t 0
                        while i < mt.branches.length
                        {
                            let br_ptr mt.branches.get i
                            if br_ptr <> null
                            {
                                let br (*br_ptr)
                                if br.cases <> null
                                {
                                    var ci: size_t 0
                                    while ci < br.cases.length
                                    {
                                        let cs_ptr br.cases.get ci
                                        if cs_ptr <> null
                                        {
                                            let cs (*cs_ptr)
                                            this.wr_operands(cs.condition)
                                        }
                                        set ci: ci + 1
                                    }
                                }
                                this.wr_statement_ref(br.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.wr_statement_ref(mt.alternative)
                }
                when ch: Choose
                {
                    this.wr_operands(ch.condition)
                    let chmask this.wr_mask_of_ops(ch.condition)
                    if ch.cases <> null
                    {
                        var i: size_t 0
                        while i < ch.cases.length
                        {
                            let w_ptr ch.cases.get i
                            if w_ptr <> null
                            {
                                let w (*w_ptr)
                                this.wr_add_name(w.name, chmask)
                                this.wr_statement_ref(w.consequent)
                            }
                            set i: i + 1
                        }
                    }
                    this.wr_statement_ref(ch.alternative)
                }
                when fr: For
                {
                    this.wr_operands(fr.expr)
                    let fmask this.wr_mask_of_ops(fr.expr)
                    this.wr_add_name(fr.identifier, fmask)
                    this.wr_action(fr.body)
                }
                when wh: While
                {
                    this.wr_operands(wh.cond.operation)
                    if wh.cond.binding_item.name <> null
                    {
                        let wmask this.wr_mask_of_ops(wh.cond.operation)
                        this.wr_add_name((*wh.cond.binding_item.name), wmask)
                    }
                    this.wr_action(wh.body)
                }
                when rp: Repeat
                    this.wr_action(rp.body)
                when tr: Try
                {
                    this.wr_operands(tr.cond.operation)
                    if tr.cond.binding_item.name <> null
                    {
                        let tmask this.wr_mask_of_ops(tr.cond.operation)
                        this.wr_add_name((*tr.cond.binding_item.name), tmask)
                    }
                }
                when tp: Tuple
                {
                    if tp.components <> null
                    {
                        var i: size_t 0
                        while i < tp.components.length
                        {
                            let c_ptr tp.components.get i
                            if c_ptr <> null
                                this.wr_operands(c_ptr.value)
                            set i: i + 1
                        }
                    }
                }
                when lm: Lambda
                    set wr_mask: wm_all()
                when cl: Closure
                    set wr_mask: wm_all()
                when fref: FunctionRef
                    set wr_mask: wm_all()
                else
                    0
        }

        ; a SIMD vector store writes its argument 1 (ROADMAP-simd.md phase 2;
        ; WriteCensus.is_simd_store is the same list)
        function is_simd_store(name: String) returns bool
        {
            match name
                case "simd.store" case "simd.store_ptr": return true
            false
        }

        procedure wr_call(mutable this: TaskPlanner, call: PlannedCall)
        {
            this.wr_operands(call.args)
            if call.is_indirect
            {
                set wr_mask: wm_all()
                return
            }
            if call.is_intrinsic and TaskPlanner.is_simd_store(call.name) and call.args <> null and call.args.length > 1
            {
                let sp call.args.get 1
                if sp <> null
                    set wr_mask: (wr_mask | this.wr_mask_of_op(sp.unwrap()))
                return
            }
            if call.is_intrinsic
                return
            if call.is_operator
                return
            if this.is_construction_name(call.name)
                return
            let sub this.written_mask(call.mangled_name)
            if sub = 0
                return
            if call.args = null
                return
            var i: size_t 0
            while i < call.args.length
            {
                var written false
                if sub = wm_all()
                    set written: true
                if i > 62
                    set written: true
                if written = false and ((sub >> i) & 1) <> 0
                    set written: true
                if written
                {
                    let ap call.args.get i
                    if ap <> null
                        set wr_mask: (wr_mask | this.wr_mask_of_op(ap.unwrap()))
                }
                set i: i + 1
            }
        }

        ; A direct callee must be transitively effect-free
        ; (effectively_pure — the function keyword alone is a claim).
        ; Its written-params mask then says which argument positions it
        ; can write through: those must be per-iteration state; purely
        ; read positions may take loop-external values freely. That
        ; admits `a.get j` on a shared input vector and
        ; `local_sb.append external_str` while blocking `outer_list.add
        ; x` (List.add writes this — order-dependent).
        procedure callee_verdict(mutable this: TaskPlanner, call: PlannedCall)
        {
            if cls_blocked
                return
            if plan_functions = null
            {
                this.block_named("unresolved callee ", call.name)
                return
            }
            ; Declaration duplicates: a body entry wins over an extern
            ; declaration for the same mangled name (see effectively_pure).
            var saw_extern false
            var extern_benign false
            for func in plan_functions
            {
                if func.mangled_name = call.mangled_name
                {
                    ; a STUB of another package's `function` is pure by rule
                    ; like a body (WriteCensus.mark_stub_purity carries its
                    ; keyword): it writes only its page, if it takes one --
                    ; and two iterations allocating on one page still race.
                    ; A read primitive is judged the same way.
                    if func.pure or TaskPlanner.is_read_primitive(func.mangled_name)
                    {
                        var stub_fn false
                        choose func.impl
                            when e: Extern
                                set stub_fn: true
                            else
                                0
                        if stub_fn
                        {
                            let swm this.declared_mask(func)
                            if swm = 0
                                return
                            if this.masked_args_local(call, swm) = false
                                this.block_named("mutating call on loop-external state: ", call.name)
                            return
                        }
                    }
                    choose func.impl
                        when action: Action
                        {
                            if this.effectively_pure(call.mangled_name) = false
                            {
                                this.block_named("transitively impure call ", call.name)
                                return
                            }
                            ; Which argument positions the callee writes
                            ; through: only those demand per-iteration state;
                            ; read-only positions take loop-external values
                            ; freely (`a.get j`). Since R1 (2026-09-19) the
                            ; DECLARATION says it and the compiler checks it
                            ; against the body: a `function` writes none, a
                            ; procedure its `mutable` positions. A PAGE
                            ; parameter counts as written (two iterations
                            ; allocating on one page race). An initializer's
                            ; input starts with its own new object, so it
                            ; keeps the body walk.
                            var wm this.declared_mask(func)
                            if func.name = "init"
                                set wm: this.written_mask(call.mangled_name)
                            if wm = 0
                                return
                            if this.masked_args_local(call, wm) = false
                                this.block_named("mutating call on loop-external state: ", call.name)
                            return
                        }
                        when e: Extern
                        {
                            set saw_extern: true
                            if this.extern_is_benign(func.name)
                                set extern_benign: true
                        }
                        else
                            return
                }
            }
            if saw_extern
            {
                if extern_benign = false
                {
                    this.block_named("extern call ", call.name)
                    return
                }
                ; The benign whitelist includes WRITERS (memcpy/memmove/
                ; memset, free): their hard-coded masks apply the same
                ; argument discipline as body callees. Atomics mask to 0
                ; (race-free by definition — the sanctioned cross-thread
                ; mechanism stays admitted on any target).
                let em this.extern_written_mask(call.name)
                if em = 0
                    return
                if this.masked_args_local(call, em) = false
                    this.block_named("extern write on loop-external state: ", call.name)
                return
            }
            this.block_named("unresolved callee ", call.name)
        }

        ; The positions a callee's declaration may write: its `mutable`
        ; parameters (none for a function) and every page parameter.
        function declared_mask(this: TaskPlanner, func: PlannedFunction) returns size_t
        {
            if func.input = null
                return 0
            var m: size_t 0
            var i: size_t 0
            while i < func.input.length
            {
                let it_ptr func.input.get i
                if it_ptr <> null
                {
                    let it it_ptr.unwrap()
                    var written false
                    if it.attributes <> null
                    {
                        let attrs it.attributes as ref[Vector[PlannedAttribute]]
                        var k: size_t 0
                        while k < attrs.length
                        {
                            let a_ptr attrs.get k
                            if a_ptr <> null and a_ptr.unwrap().name = "mutable"
                                set written: true
                            set k: k + 1
                        }
                    }
                    if it.item_type <> null and TaskPlanner.is_page_type((*it.item_type))
                        set written: true
                    if written
                    {
                        if i > 62
                            return wm_all()
                        set m: m | ((1 as size_t) << (i as size_t))
                    }
                }
                set i: i + 1
            }
            m
        }

        function is_page_type(t: PlannedType) returns bool
        {
            if t.name = "Page"
                return true
            if t.generics = null
                return false
            if t.generics.length <> 1
                return false
            var wraps false
            if t.name = "ref"
                set wraps: true
            if t.name = "pointer"
                set wraps: true
            if wraps
            {
                let g_ptr t.generics.get 0
                if g_ptr <> null
                    return TaskPlanner.is_page_type(g_ptr.unwrap())
            }
            false
        }

        ; Every argument position the mask marks written must be
        ; per-iteration state; the rest are free (read-only positions
        ; take loop-external values). `&x` / deref operator chains
        ; recurse to the named root inside.
        function masked_args_local(this: TaskPlanner, call: PlannedCall, mask: size_t) returns bool
        {
            if call.args = null
                return true
            var i: size_t 0
            while i < call.args.length
            {
                var written false
                if mask = wm_all()
                    set written: true
                if i > 62
                    set written: true
                if written = false and ((mask >> i) & 1) <> 0
                    set written: true
                if written
                {
                    let ap call.args.get i
                    if ap <> null and this.arg_root_local(ap.unwrap()) = false
                        return false
                }
                set i: i + 1
            }
            true
        }

        function arg_root_local(this: TaskPlanner, op: PlannedOperand) returns bool
        {
            ; A by-value SCALAR cannot be written through, whatever
            ; expression produced it (keeps index math, captured counts
            ; and other read-only scalar inputs admitted).
            if this.value_can_alias(op.result_type) = false
                return true
            choose op.expr
                when v: Variable
                    return this.is_local(v.name)
                when c: Constant
                    return true
                when as_expr: As
                {
                    if as_expr.value <> null
                    {
                        let r as_expr.value
                        return this.arg_root_local((*r))
                    }
                }
                when inner: Call
                {
                    ; A call result (operator, construction or plain call)
                    ; can alias at most what its own arguments reach — it
                    ; is per-iteration state iff every argument root is.
                    if inner.args <> null
                    {
                        var i: size_t 0
                        while i < inner.args.length
                        {
                            let ap inner.args.get i
                            if ap <> null and this.arg_root_local(ap.unwrap()) = false
                                return false
                            set i: i + 1
                        }
                    }
                    return true
                }
                else
                    0
            ; Unknown shapes: conservatively loop-external (never a
            ; false "parallel").
            false
        }
    }
}
