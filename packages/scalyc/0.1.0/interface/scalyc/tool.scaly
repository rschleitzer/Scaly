; tool.scaly - the build side of the one tool
;
; `scaly build` links a program against OBJECTS of the packages it uses, each
; compiled once into a cache and found again by a key over everything that
; went into it: the compiling compiler (scaly_package_stamp, which the Emitter
; defines for this library from its own IR), the target, the flavour, and every
; file of the package. A package's C and assembly files are compiled by the
; tool as well; which of them a target takes is said by their names
; (native_name#). Nothing is written into the project, and no script is run.
;
; `scaly build --release` (stage C) takes a package as unoptimised BITCODE out
; of the same cache instead: the program's module links it in, dependents
; first, and the whole program is optimised and emitted as one module
; (Emitter.link_bitcode#, the release branch of write_object_to_file#) -- what
; tools/link-lto.sh did with llvm-link, sed, opt and llc.

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.File
use scaly.os.Console
use scaly.os.Directory
use scaly.os.Directory.DirectoryEntry
use scaly.memory.Page
use scaly.memory.root_pages.getenv
use scalyc.cli
use scalyc.cli.Options
use scalyc.compiler.lexer.*
use scalyc.compiler.parser.*
use scalyc.compiler.Syntax.*

; the compiler's own identity: the Emitter sets it to the hash of this
; package's IR when it compiles the compiler (emit_package_stamp#); a compiler
; that does not know the rule leaves it 0, which keys a cache of its own
shared scaly_package_stamp: u64 linked
function getpid() returns i32 extern
function system(command: pointer[const_char]) returns i32 extern
function rename(old_path: pointer[const_char], new_path: pointer[const_char]) returns i32 extern
function LLVMGetDefaultTargetTriple() returns pointer[char] extern
procedure LLVMDisposeMessage(message: pointer[char]) extern

; a native file's name, read: `fcontext_x86_64_windows` is `fcontext` for
; x86_64 on Windows (tool.native_name#)
define NativeName
(
    base: String
    os: String
    arch: String
)

define tool
{
    ; where compiled packages are kept: $SCALY_CACHE, else ~/.scaly/cache
    ; (%USERPROFILE% where there is no HOME)
    procedure cache_root() @page true @direct true @ret_caller true @deep true returns String io linked

    ; create a directory and every missing one above it; true when it exists
    procedure ensure_directory(mutable path: String) @ret_nonlocal true @deep true returns bool io linked

    ; every file of a package, relative to its directory: the tree without
    ; `interface/` (generated from the sources) and without a name that
    ; starts with `_` or `.` -- no module can be named so, and tscaly's
    ; `_submodules` holds another project's tree
    procedure package_files(mutable dir: String, prefix: String, mutable files: ref[Array[String]]) @page true @direct true @stores true @deep true io linked

    function fnv_string(h: u64, s: String) @ret_nonlocal true @deep true returns u64 linked

    ; the cache key of a package: the compiling compiler, the target, the
    ; flavour, and every file with its path -- summed, so the order the file
    ; system lists them in does not matter
    procedure package_key(mutable dir: String, files: ref[Array[String]], triple: String, flavour: String) @ret_nonlocal true @deep true returns u64 io reads scaly_package_stamp linked

    function hex16(k: u64) @page true @direct true @ret_caller true @deep true returns String linked

    ; a native file's stem read as base name and target tags: `_windows`,
    ; `_linux`, `_darwin` name the system, `_arm64` (`_aarch64`) and `_x86_64`
    ; the architecture, stripped from the end in any order
    function native_name(stem: String) @page true @direct true @deep true returns NativeName linked

    function triple_arch(triple: String) @page true @direct true @ret_caller true @deep true returns String linked

    function triple_os(triple: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; the C and assembly files of a package this target takes: of the files
    ; that share a base name, the most specific one whose tags all match --
    ; eio.c everywhere but on Windows, where eio_windows.c replaces it
    procedure select_native(files: ref[Array[String]], triple: String, mutable chosen: ref[Array[String]]) @page true @direct true @stores true @deep true linked

    ; the host's triple, or the one --target named
    procedure target_triple(given: String) @page true @direct true @ret_caller true @deep true returns String io linked

    ; move a finished file into place: a second build of the same key at the
    ; same time finds either no file or a whole one
    procedure publish(mutable tmp: String, mutable final: String) @ret_nonlocal true @deep true returns bool io linked

    ; Is `sym` an INSTANCE -- a symbol every package that uses a generic
    ; defines for itself, from one source? Template arguments in its name
    ; (`_ZN5ArrayIiE3addEi`), or the name of a generic free function with the
    ; encoded types behind it (`_Z17allocate_slice2u8...`).
    function is_instance_symbol(sym: String, generics: ref[Array[String]]) @ret_nonlocal true @deep true returns bool linked

    ; the name in a symbol, as it is written: `helper` of `_Z6helperi`,
    ; `Box.grown` of `_ZN3Box5grownEv`
    function plain_name(sym: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; No mangled name carries its package, so a function two packages each
    ; define is ONE function after the link -- and which of the two depends
    ; on how the program is built (measured 2026-10-05: `scaly run`, `scaly
    ; build` and `--release` gave three different answers at rc 0). `files`
    ; are the definition lists the compiler wrote beside each package's
    ; object (cli.run with defs_file), `owners` the packages; instances of
    ; generics, which every user defines from one source, are not judged.
    ; False, each collision named, when two packages define one symbol.
    procedure check_definitions(owners: ref[Array[String]], files: ref[Array[String]]) @ret_nonlocal true @deep true returns bool io linked

    ; The objects of every package a program uses, each built into the cache
    ; the first time it is needed: the package's Scaly code as one object at
    ; -O2 (library linkage, cli.run with --no-prelude --no-tests), and the C
    ; and assembly files its target takes. `names` and `roots` pair a
    ; package's name with its root file. False when one of them does not build;
    ; what went wrong is printed where it happened.
    procedure package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, given_triple: String, cpu: String, release: bool, mutable objects: ref[Array[String]], mutable bitcode: ref[Array[String]], mutable link_flags: ref[StringBuilder]) @ret_nonlocal true @deep true @deep_pageof_192 true returns bool io mutable modeler_error_count reads scaly_package_stamp linked

    ; the C and assembly files of a package this target takes, each compiled
    ; into the cache beside the package's object (`<base>-<path>.o`)
    procedure native_objects(mutable dir: String, files: ref[Array[String]], triple: String, base: String, given_triple: String, includes: String, mutable objects: ref[Array[String]]) @ret_nonlocal true @deep true @deep_pageof_64 true returns bool io linked

    ; `scaly run` / `scaly test`: the packages a program uses, other than the
    ; stdlib (the tool's own image carries it), as objects the JIT adds, with
    ; the mangled names each defines (so the JIT's stubs leave them alone). The
    ; objects are built once into the cache, flavour "jit" (thread-locals
    ; cleared, cli.compile_dep_package_to_object), the names beside them in
    ; `<base>.jit.syms`. Before 2026-09-30 every run compiled them anew into
    ; one fixed /tmp path, which two runs at once overwrote.
    procedure jit_package_objects(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable objects: ref[Array[String]], mutable symbols: ref[Array[String]]) @ret_nonlocal true @deep true @deep_pageof_24 true returns bool io mutable modeler_error_count reads scaly_package_stamp linked

    ; ---- C libraries (stage B) ----------------------------------------------
    ;
    ; A package says which C libraries it uses in its root file:
    ;     extern ssl, crypto
    ; and the tool finds them: in $SCALY_LIBRARY_PATH (directories, `:`-
    ; separated, `;` on Windows), then where Homebrew puts them (every
    ; `opt/<formula>/lib` -- the highest formula name when several have it:
    ; openssl@3 before openssl@1.1 -- then its shared `lib`), else nowhere, and the linker's own
    ; search path answers (a Linux distribution's /usr/lib/<triple>). A library
    ; found in a directory adds `-L<dir>`, and `<dir>/../include` the `-I` the
    ; package's C files are compiled with.

    procedure add_library(mutable libs: ref[Array[String]], name: String) @page true @direct true @deep true @deep_pageof_1 true linked

    ; the C libraries a source file declares, in the order it names them
    procedure declared_libraries(mutable file: String, mutable libs: ref[Array[String]]) @deep true io linked

    ; does `dir` hold the library `name` in a form the linker takes
    procedure dir_has_library(dir: String, name: String) @ret_nonlocal true @deep true returns bool io linked

    ; the directory a library is found in, "" when only the linker's own
    ; search path can answer
    procedure find_library(name: String) @page true @direct true @ret_caller true @deep true returns String io linked

    ; byte order: is `a` after `b`
    function name_after(a: String, b: String) @deep true returns bool linked

    ; the link flags (`-L<dir> -l<name>`, a directory once) and the C include
    ; flags (`-I<dir>`) of the libraries
    procedure library_flags(libs: ref[Array[String]], mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder]) @deep true io linked

    ; the C libraries of a program: its own declarations first, then its
    ; packages' from the last loaded (dependents) to the first (what they
    ; use) -- the order a linker that reads left to right needs -- with the
    ; link and include flags that find them
    procedure libraries_of(names: ref[Array[String]], roots: ref[Array[String]], program_file: String, mutable link_flags: ref[StringBuilder], mutable include_flags: ref[StringBuilder]) @page true @direct true @ret_nonlocal true @deep true returns Array[String] io linked

    ; load each library into this process (scaly_eio_load_library); one that
    ; does not load is said, and the JIT then names the symbol it misses
    procedure load_libraries(libs: ref[Array[String]]) @deep true io linked

    ; a name `scaly new` accepts: what a package and its root file can be
    ; called -- letters, digits and `_`, a letter first
    function is_project_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; the function and its test every new root file starts with
    function new_body(indent: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; `scaly new <name> [--lib]`: a directory with a root file, nothing else.
    ; A program is <name>/<name>.scaly; a package lies where the compiler and
    ; a later fetch from git look for one, <name>/packages/<name>/0.1.0/.
    procedure new_project(name: String, library: bool) @ret_nonlocal true @deep true returns int io linked
}
