; lineedit.scaly - the REPL's line editor (ROADMAP-public.md, stage R)
;
; At a terminal a line is edited in place: the cursor moves by characters
; (UTF-8, so an umlaut is one step), the arrows walk the history, which
; ~/.scaly/history keeps between sessions. The terminal is raw only while a
; line is read (scaly_eio_term_raw, eio.c); input from a pipe is read as it
; comes, which is what the test gate does.
;
;   left/right, Ctrl-B/F       a character        up/down, Ctrl-P/N   history
;   Home/End, Ctrl-A/E         start / end        Backspace, Delete   delete
;   Ctrl-K / Ctrl-U / Ctrl-W   kill to end / to start / the word before
;   Tab                        four spaces        Ctrl-L              clear screen
;   Ctrl-C                     drop the line      Ctrl-D (empty)      end of input

use scaly.containers.String
use scaly.containers.StringBuilder
use scaly.os.File
use scaly.fiber.Io
use scaly.memory.root_pages.getenv
use scalyc.tool

define HISTORY_KEPT: int 1000

define lineedit
{
    ; ~/.scaly/history ("" without a home)
    procedure history_file() @page true @direct true @ret_caller true @deep true returns String io linked

    ; the history a session starts with: the file's lines
    procedure load_history(mutable history: ref[Array[String]]) @page true @stores true @deep true io linked

    ; keep a line: in memory, and the last HISTORY_KEPT in the file
    procedure remember(mutable history: ref[Array[String]], line: String) @page true @direct true @stores true @deep true io linked

    procedure write(text: String) @ret_nonlocal true @deep true io linked

    ; the characters (not bytes) of text[0, end)
    function width(text: String, end: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; the byte before the character that ends at `at`
    function char_start(text: String, at: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; the byte after the character that starts at `at`
    function char_end(text: String, at: size_t) @ret_nonlocal true @deep true returns size_t linked

    procedure redraw(prompt: String, line: String, cursor: size_t) @ret_nonlocal true @deep true io linked

    procedure read_byte() @ret_nonlocal true @deep true returns int io linked

    ; One line with its prompt into `out`; false at the end of the input.
    ; Not at a terminal, the line is read as it comes.
    procedure read_line(prompt: String, mutable history: ref[Array[String]], mutable out: ref[StringBuilder]) @page true @stores true @ret_nonlocal true @deep true returns bool io linked

    ; up (older) or down (newer) in the history; the line being written is
    ; kept as the draft below the newest entry
    procedure history_step(history: ref[Array[String]], mutable hi: ref[size_t], mutable draft: ref[String], line: String, older: bool) @page true @direct true @stores true @ret_caller true @deep true returns String linked

    ; a line from a pipe or a file: the prompt, then the bytes up to the newline
    procedure read_plain(prompt: String, mutable out: ref[StringBuilder]) @ret_nonlocal true @deep true returns bool io linked
}
