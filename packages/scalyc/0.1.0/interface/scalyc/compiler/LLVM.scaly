; LLVM.scaly - FFI bindings to LLVM-C API
;
; This module provides Scaly bindings to LLVM's C API for code generation.
; The LLVM-C API uses opaque pointer handles for all LLVM objects.
;
; Reference: https://llvm.org/doxygen/group__LLVMC.html

; ============================================================================
; LLVM Opaque Handle Types
; ============================================================================

; These are opaque pointer types representing LLVM objects
; In the LLVM-C API, these are typedefs to pointers to opaque structs

define LLVMOpaqueContext()
define LLVMContextRef pointer[LLVMOpaqueContext]
define LLVMOpaqueModule()
define LLVMModuleRef pointer[LLVMOpaqueModule]
define LLVMOpaqueBuilder()
define LLVMBuilderRef pointer[LLVMOpaqueBuilder]
define LLVMOpaqueType()
define LLVMTypeRef pointer[LLVMOpaqueType]
define LLVMOpaqueValue()
define LLVMValueRef pointer[LLVMOpaqueValue]
define LLVMOpaqueBasicBlock()
define LLVMBasicBlockRef pointer[LLVMOpaqueBasicBlock]
define LLVMTarget()
define LLVMTargetRef pointer[LLVMTarget]
define LLVMOpaqueTargetMachine()
define LLVMTargetMachineRef pointer[LLVMOpaqueTargetMachine]
define LLVMOpaqueTargetData()
define LLVMTargetDataRef pointer[LLVMOpaqueTargetData]
define LLVMOpaquePassManager()
define LLVMPassManagerRef pointer[LLVMOpaquePassManager]
define LLVMOpaqueMemoryBuffer()
define LLVMMemoryBufferRef pointer[LLVMOpaqueMemoryBuffer]
define LLVMOpaqueDIBuilder()
define LLVMDIBuilderRef pointer[LLVMOpaqueDIBuilder]
define LLVMOpaqueMetadata()
define LLVMMetadataRef pointer[LLVMOpaqueMetadata]
define LLVMOpaqueAttributeRef()
define LLVMAttributeRef pointer[LLVMOpaqueAttributeRef]
; The debug-record handle of LLVM's "new debug format" (RemoveDIs, LLVM 19).
; It replaced the LLVMValueRef that the old dbg.declare INTRINSIC was, which is
; why the insert entry point below both changed its name and its result type.
define LLVMOpaqueDbgRecord()
define LLVMDbgRecordRef pointer[LLVMOpaqueDbgRecord]
define LLVMOpaqueUse()
define LLVMUseRef pointer[LLVMOpaqueUse]
define LLVMComdat()
define LLVMComdatRef pointer[LLVMComdat]

; ============================================================================
; LLVM Enums
; ============================================================================

; LLVMIntPredicate - Integer comparison predicates
define LLVMIntPredicate
{
    function EQ() @ret_nonlocal true @deep true returns int linked
    function NE() @ret_nonlocal true @deep true returns int linked
    function UGT() @ret_nonlocal true @deep true returns int linked
    function UGE() @ret_nonlocal true @deep true returns int linked
    function ULT() @ret_nonlocal true @deep true returns int linked
    function ULE() @ret_nonlocal true @deep true returns int linked
    function SGT() @ret_nonlocal true @deep true returns int linked
    function SGE() @ret_nonlocal true @deep true returns int linked
    function SLT() @ret_nonlocal true @deep true returns int linked
    function SLE() @ret_nonlocal true @deep true returns int linked
}

; LLVMRealPredicate - Floating point comparison predicates
define LLVMRealPredicate
{
    function OEQ() @ret_nonlocal true @deep true returns int linked
    function OGT() @ret_nonlocal true @deep true returns int linked
    function OGE() @ret_nonlocal true @deep true returns int linked
    function OLT() @ret_nonlocal true @deep true returns int linked
    function OLE() @ret_nonlocal true @deep true returns int linked
    function ONE() @ret_nonlocal true @deep true returns int linked
    function ORD() @ret_nonlocal true @deep true returns int linked
    function UNO() @ret_nonlocal true @deep true returns int linked
    function UEQ() @ret_nonlocal true @deep true returns int linked
    function UGT() @ret_nonlocal true @deep true returns int linked
    function UGE() @ret_nonlocal true @deep true returns int linked
    function ULT() @ret_nonlocal true @deep true returns int linked
    function ULE() @ret_nonlocal true @deep true returns int linked
    function UNE() @ret_nonlocal true @deep true returns int linked
}

; LLVMTypeKind - Type kind for LLVMGetTypeKind
define LLVMTypeKind
{
    function Void() @ret_nonlocal true @deep true returns int linked
    function Half() @ret_nonlocal true @deep true returns int linked
    function Float() @ret_nonlocal true @deep true returns int linked
    function Double() @ret_nonlocal true @deep true returns int linked
    function X86_FP80() @ret_nonlocal true @deep true returns int linked
    function FP128() @ret_nonlocal true @deep true returns int linked
    function PPC_FP128() @ret_nonlocal true @deep true returns int linked
    function Label() @ret_nonlocal true @deep true returns int linked
    function Integer() @ret_nonlocal true @deep true returns int linked
    ; s179: Function/Array/Vector are named *Kind because the bare
    ; names collide with the Model.Function / stdlib Array / Vector
    ; concepts: stage-1's planner resolves `LLVMTypeKind.Array()` as
    ; a zero-init construction of the colliding concept instead of
    ; this call, silently dropping the comparison that uses it.
    function FunctionKind() @ret_nonlocal true @deep true returns int linked
    function Struct() @ret_nonlocal true @deep true returns int linked
    function ArrayKind() @ret_nonlocal true @deep true returns int linked
    function Pointer() @ret_nonlocal true @deep true returns int linked
    function VectorKind() @ret_nonlocal true @deep true returns int linked
    function Metadata() @ret_nonlocal true @deep true returns int linked
}

; LLVMLinkage - Linkage types
define LLVMLinkage
{
    function External() @ret_nonlocal true @deep true returns int linked
    function AvailableExternally() @ret_nonlocal true @deep true returns int linked
    function LinkOnceAny() @ret_nonlocal true @deep true returns int linked
    function LinkOnceODR() @ret_nonlocal true @deep true returns int linked
    function WeakAny() @ret_nonlocal true @deep true returns int linked
    function WeakODR() @ret_nonlocal true @deep true returns int linked
    function Appending() @ret_nonlocal true @deep true returns int linked
    function Internal() @ret_nonlocal true @deep true returns int linked
    function Private() @ret_nonlocal true @deep true returns int linked
    function ExternalWeak() @ret_nonlocal true @deep true returns int linked
    function Common() @ret_nonlocal true @deep true returns int linked
}

; LLVMCallConv - Calling conventions
define LLVMCallConv
{
    function C() @ret_nonlocal true @deep true returns int linked
    function Fast() @ret_nonlocal true @deep true returns int linked
    function Cold() @ret_nonlocal true @deep true returns int linked
    function X86Stdcall() @ret_nonlocal true @deep true returns int linked
    function X86Fastcall() @ret_nonlocal true @deep true returns int linked
}

; ============================================================================
; Context Functions
; ============================================================================

; Create a new LLVM context
function LLVMContextCreate() returns LLVMContextRef extern

; Dispose of a context
procedure LLVMContextDispose(context: LLVMContextRef) extern

; Get the global context (not recommended for multi-threaded use)
function LLVMGetGlobalContext() returns LLVMContextRef extern

; ============================================================================
; Module Functions
; ============================================================================

; Create a new module in a context
function LLVMModuleCreateWithNameInContext(name: pointer[const_char], context: LLVMContextRef) returns LLVMModuleRef extern

; Dispose of a module
procedure LLVMDisposeModule(mod: LLVMModuleRef) extern

; Set the target triple for a module
procedure LLVMSetTarget(mod: LLVMModuleRef, triple: pointer[const_char]) extern

; Set the data layout for a module
procedure LLVMSetDataLayout(mod: LLVMModuleRef, layout: pointer[const_char]) extern

; Get string representation of module (caller must dispose with LLVMDisposeMessage)
function LLVMPrintModuleToString(mod: LLVMModuleRef) returns pointer[char] extern

; Write module to file
function LLVMPrintModuleToFile(mod: LLVMModuleRef, filename: pointer[const_char], error_message: pointer[pointer[char]]) returns i32 extern

; Write bitcode to file
function LLVMWriteBitcodeToFile(mod: LLVMModuleRef, path: pointer[const_char]) returns i32 extern

; ============================================================================
; Builder Functions
; ============================================================================

; Create a new instruction builder in a context
function LLVMCreateBuilderInContext(context: LLVMContextRef) returns LLVMBuilderRef extern

; Dispose of a builder
procedure LLVMDisposeBuilder(builder: LLVMBuilderRef) extern

; Position builder at end of a basic block
procedure LLVMPositionBuilderAtEnd(builder: LLVMBuilderRef, block: LLVMBasicBlockRef) extern

; Position builder before a specific instruction
procedure LLVMPositionBuilderBefore(builder: LLVMBuilderRef, instr: LLVMValueRef) extern

; Get the current insertion block
function LLVMGetInsertBlock(builder: LLVMBuilderRef) returns LLVMBasicBlockRef extern

; Get the first instruction in a basic block
function LLVMGetFirstInstruction(block: LLVMBasicBlockRef) returns LLVMValueRef extern
; The instruction after `inst` in its block (null at the end). Lazy frames use
; it to pin an entry-block materialisation AFTER the slot's initialising store.
function LLVMGetNextInstruction(inst: LLVMValueRef) returns LLVMValueRef extern
function LLVMGetLastInstruction(block: LLVMBasicBlockRef) returns LLVMValueRef extern

; Cast a value to an instruction (returns null if not an instruction)
function LLVMIsAInstruction(val: LLVMValueRef) returns LLVMValueRef extern

; Get the basic block that contains an instruction
function LLVMGetInstructionParent(inst: LLVMValueRef) returns LLVMBasicBlockRef extern

; ============================================================================
; Type Functions
; ============================================================================

; Void type
function LLVMVoidTypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern

; Integer types
function LLVMInt1TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMInt8TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMInt16TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMInt32TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMInt64TypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMIntTypeInContext(context: LLVMContextRef, num_bits: u32) returns LLVMTypeRef extern
function LLVMVectorType(element_type: LLVMTypeRef, element_count: u32) returns LLVMTypeRef extern
function LLVMGetVectorSize(vector_type: LLVMTypeRef) returns u32 extern
function LLVMGetIntTypeWidth(int_type: LLVMTypeRef) returns u32 extern

; Floating point types
function LLVMFloatTypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern
function LLVMDoubleTypeInContext(context: LLVMContextRef) returns LLVMTypeRef extern

; Pointer type (opaque pointer in LLVM 15+)
function LLVMPointerTypeInContext(context: LLVMContextRef, address_space: u32) returns LLVMTypeRef extern

; Legacy typed pointer (for older LLVM)
function LLVMPointerType(element_type: LLVMTypeRef, address_space: u32) returns LLVMTypeRef extern

; Array type
function LLVMArrayType(element_type: LLVMTypeRef, element_count: u32) returns LLVMTypeRef extern
function LLVMArrayType2(element_type: LLVMTypeRef, element_count: size_t) returns LLVMTypeRef extern

; Struct types
function LLVMStructTypeInContext(context: LLVMContextRef, element_types: pointer[LLVMTypeRef], element_count: u32, packed: i32) returns LLVMTypeRef extern
function LLVMStructCreateNamed(context: LLVMContextRef, name: pointer[const_char]) returns LLVMTypeRef extern
procedure LLVMStructSetBody(struct_type: LLVMTypeRef, element_types: pointer[LLVMTypeRef], element_count: u32, packed: i32) extern
function LLVMIsPackedStruct(struct_type: LLVMTypeRef) returns i32 extern

; Data layout / size queries — s149 Result wrapper sizing
function LLVMGetModuleDataLayout(mod: LLVMModuleRef) returns LLVMTargetDataRef extern
function LLVMABISizeOfType(td: LLVMTargetDataRef, ty: LLVMTypeRef) returns u64 extern

; Function type
function LLVMFunctionType(return_type: LLVMTypeRef, param_types: pointer[LLVMTypeRef], param_count: u32, is_var_arg: i32) returns LLVMTypeRef extern

; Type queries
function LLVMGetTypeKind(type: LLVMTypeRef) returns i32 extern
function LLVMTypeIsSized(type: LLVMTypeRef) returns i32 extern
function LLVMGetElementType(type: LLVMTypeRef) returns LLVMTypeRef extern
function LLVMGetReturnType(func_type: LLVMTypeRef) returns LLVMTypeRef extern
function LLVMCountParamTypes(function_type: LLVMTypeRef) returns u32 extern
procedure LLVMGetParamTypes(function_type: LLVMTypeRef, dest: pointer[LLVMTypeRef]) extern
function LLVMCountStructElementTypes(struct_type: LLVMTypeRef) returns u32 extern
function LLVMGetStructElementTypes(struct_type: LLVMTypeRef, dest: pointer[LLVMTypeRef]) extern
function LLVMStructGetTypeAtIndex(struct_type: LLVMTypeRef, index: u32) returns LLVMTypeRef extern
function LLVMIsOpaqueStruct(struct_type: LLVMTypeRef) returns i32 extern
function LLVMGetArrayLength2(array_type: LLVMTypeRef) returns u64 extern

; ============================================================================
; Function Functions
; ============================================================================

; Add a function to a module
function LLVMAddFunction(mod: LLVMModuleRef, name: pointer[const_char], function_type: LLVMTypeRef) returns LLVMValueRef extern

; Get a function from a module by name
function LLVMGetNamedFunction(mod: LLVMModuleRef, name: pointer[const_char]) returns LLVMValueRef extern

; Get function parameter
function LLVMGetParam(func: LLVMValueRef, index: u32) returns LLVMValueRef extern

; Get number of parameters
function LLVMCountParams(func: LLVMValueRef) returns u32 extern

; Set linkage
procedure LLVMSetLinkage(global: LLVMValueRef, linkage: i32) extern
; LLVMVisibility: 0 default, 1 hidden, 2 protected
procedure LLVMSetVisibility(global: LLVMValueRef, viz: i32) extern
function LLVMGetLinkage(global: LLVMValueRef) returns i32 extern

; Comdats (stage 7). A `linkonce_odr` function needs one on COFF and MUST NOT
; have one on Mach-O — see Emitter.set_linkonce_odr for the whole argument.
; A freshly inserted comdat has selection kind `Any`, which is what ODR needs,
; so no LLVMSetComdatSelectionKind call belongs here.
function LLVMGetOrInsertComdat(mod: LLVMModuleRef, name: pointer[const_char]) returns LLVMComdatRef extern
procedure LLVMSetComdat(global: LLVMValueRef, comdat: LLVMComdatRef) extern

; Set the alignment (in bytes) of a load, store, or alloca instruction.
; Used for the s149 Result-wrapper { i8, [N x i8] } whose struct alignment
; is 1 — payload T at byte offset 1 is misaligned for any natural-aligned
; type. Mirrors stage-0 emitChoose/emitReturn/emitThrow's
; CreateAlignedLoad/Store(..., Align 1, ...).
procedure LLVMSetAlignment(inst: LLVMValueRef, bytes: u32) extern

; Set calling convention
procedure LLVMSetFunctionCallConv(func: LLVMValueRef, cc: u32) extern

; Attribute API (s89). LLVMAttributeIndex: 0 = return, ~0 (LLVMAttributeFunctionIndex) = function, 1+ = nth param.
function LLVMGetEnumAttributeKindForName(name: pointer[const_char], len: size_t) returns u32 extern
function LLVMCreateTypeAttribute(context: LLVMContextRef, kind_id: u32, type_ref: LLVMTypeRef) returns LLVMAttributeRef extern
function LLVMCreateEnumAttribute(context: LLVMContextRef, kind_id: u32, val: u64) returns LLVMAttributeRef extern
procedure LLVMAddAttributeAtIndex(func: LLVMValueRef, idx: u32, attr: LLVMAttributeRef) extern
function LLVMCreateStringAttribute(context: LLVMContextRef, key: pointer[const_char], key_length: u32, value: pointer[const_char], value_length: u32) returns LLVMAttributeRef extern
function LLVMGetEnumAttributeAtIndex(func: LLVMValueRef, idx: u32, kind_id: u32) returns LLVMAttributeRef extern
function LLVMGetTypeAttributeValue(attr: LLVMAttributeRef) returns LLVMTypeRef extern
procedure LLVMAddCallSiteAttribute(call: LLVMValueRef, idx: u32, attr: LLVMAttributeRef) extern

; ============================================================================
; Basic Block Functions
; ============================================================================

; Append a basic block to a function
function LLVMAppendBasicBlockInContext(context: LLVMContextRef, func: LLVMValueRef, name: pointer[const_char]) returns LLVMBasicBlockRef extern

; Get the terminator instruction of a basic block
function LLVMGetBasicBlockTerminator(block: LLVMBasicBlockRef) returns LLVMValueRef extern

; Walk the basic blocks of a function
function LLVMGetFirstBasicBlock(func: LLVMValueRef) returns LLVMBasicBlockRef extern
procedure LLVMDeleteBasicBlock(block: LLVMBasicBlockRef) extern
function LLVMGetNextBasicBlock(block: LLVMBasicBlockRef) returns LLVMBasicBlockRef extern

; Value-cast: returns the value if it is a ReturnInst, else null. Used by
; patch_prior_returns to release the function-local page on early-return
; paths emitted before the lazy page allocation.
function LLVMIsAReturnInst(val: LLVMValueRef) returns LLVMValueRef extern

; Walk the functions of a module + check whether a function has a body.
; Used by emit_template_stubs to provide empty bodies for declared-only
; deep-generic template references (mirror of stage-0's catch-all
; emit pass — without this, the linker rejects libscaly_s1.o with
; "undefined reference" to e.g. _ZN6VectorI6VectorI6VectorI1TEEEC1...
; because Vector<Vector<T>>::get_iterator's body has a buggy double-
; substituted call target).
function LLVMGetFirstFunction(mod: LLVMModuleRef) returns LLVMValueRef extern
function LLVMGetNextFunction(func: LLVMValueRef) returns LLVMValueRef extern
function LLVMIsDeclaration(global: LLVMValueRef) returns i32 extern

; ============================================================================
; Constant Functions
; ============================================================================

; Integer constants
function LLVMConstInt(int_type: LLVMTypeRef, value: size_t, sign_extend: i32) returns LLVMValueRef extern
function LLVMConstIntOfString(int_type: LLVMTypeRef, text: pointer[const_char], radix: u8) returns LLVMValueRef extern

; Sizeof / alignof — return an i64 constant computed from the module's
; default DataLayout. Used by the s80 ctor emitter to compute Page::allocate
; size/alignment without binding the full TargetData API.
function LLVMSizeOf(type: LLVMTypeRef) returns LLVMValueRef extern
function LLVMAlignOf(type: LLVMTypeRef) returns LLVMValueRef extern

; Floating point constants
function LLVMConstReal(real_type: LLVMTypeRef, value: double) returns LLVMValueRef extern
function LLVMConstIntGetZExtValue(constant_val: LLVMValueRef) returns u64 extern
procedure LLVMConstRealGetDouble(constant_val: LLVMValueRef, mutable loses_info: pointer[i32]) returns double extern

; Null pointer constant
function LLVMConstNull(type: LLVMTypeRef) returns LLVMValueRef extern
function LLVMConstVector(scalar_constant_vals: pointer[LLVMValueRef], size: u32) returns LLVMValueRef extern
function LLVMConstPointerNull(type: LLVMTypeRef) returns LLVMValueRef extern

; String constant
function LLVMConstStringInContext(context: LLVMContextRef, str: pointer[const_char], length: u32, dont_null_terminate: i32) returns LLVMValueRef extern

; Struct constant
function LLVMConstStructInContext(context: LLVMContextRef, constant_vals: pointer[LLVMValueRef], count: u32, packed: i32) returns LLVMValueRef extern
function LLVMConstNamedStruct(struct_type: LLVMTypeRef, constant_vals: pointer[LLVMValueRef], count: u32) returns LLVMValueRef extern

; Array constant
function LLVMConstArray(element_type: LLVMTypeRef, constant_vals: pointer[LLVMValueRef], length: u32) returns LLVMValueRef extern
function LLVMConstArray2(element_type: LLVMTypeRef, constant_vals: pointer[LLVMValueRef], length: size_t) returns LLVMValueRef extern

; Undefined value
function LLVMGetUndef(type: LLVMTypeRef) returns LLVMValueRef extern
function LLVMBuildShuffleVector(builder: LLVMBuilderRef, v1: LLVMValueRef, v2: LLVMValueRef, mask: LLVMValueRef, name: pointer[const_char]) returns LLVMValueRef extern
function LLVMConstAllOnes(type: LLVMTypeRef) returns LLVMValueRef extern

; ============================================================================
; Global Variable Functions
; ============================================================================

; Add a global variable
function LLVMAddGlobal(mod: LLVMModuleRef, type: LLVMTypeRef, name: pointer[const_char]) returns LLVMValueRef extern

; Get a global variable by name
function LLVMGetNamedGlobal(mod: LLVMModuleRef, name: pointer[const_char]) returns LLVMValueRef extern

; Get the value type of a global variable
function LLVMGlobalGetValueType(gv: LLVMValueRef) returns LLVMTypeRef extern

; Set initializer for global
procedure LLVMSetInitializer(global_var: LLVMValueRef, constant_val: LLVMValueRef) extern

; Set global constant
procedure LLVMSetGlobalConstant(global_var: LLVMValueRef, is_constant: i32) extern

; Mark a global as thread-local (one instance per OS thread)
procedure LLVMSetThreadLocal(global_var: LLVMValueRef, is_thread_local: i32) extern

; Walk the global variables of a module + query the thread-local bit.
; Used by the JIT's de-TLS pass (jit_clear_thread_locals): a thread-local
; the ORC JIT materializes itself has no dyld-registered TLV descriptor, so
; the first access lands in _tlv_bootstrap_error and aborts.
function LLVMGetFirstGlobal(mod: LLVMModuleRef) returns LLVMValueRef extern
function LLVMGetNextGlobal(global_var: LLVMValueRef) returns LLVMValueRef extern
function LLVMIsThreadLocal(global_var: LLVMValueRef) returns i32 extern

; Atomic instruction builders (M2.3). The enum params are C ints:
; LLVMAtomicRMWBinOp (Add=1, And=3, Or=5), LLVMAtomicOrdering
; (SequentiallyConsistent=7).
function LLVMBuildAtomicRMW(builder: LLVMBuilderRef, op: i32, ptr: LLVMValueRef, val: LLVMValueRef, ordering: i32, single_thread: i32) returns LLVMValueRef extern
function LLVMBuildAtomicCmpXchg(builder: LLVMBuilderRef, ptr: LLVMValueRef, cmp: LLVMValueRef, new_val: LLVMValueRef, success_ordering: i32, failure_ordering: i32, single_thread: i32) returns LLVMValueRef extern

; Set the atomic ordering of a load or store instruction
procedure LLVMSetOrdering(inst: LLVMValueRef, ordering: i32) extern

; Query whether a global is marked constant (0 = mutable global)
function LLVMIsGlobalConstant(global_var: LLVMValueRef) returns i32 extern

