        procedure is_structure_name(mutable this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        procedure report_hidden_member(mutable this: Planner, owner: String, member: String, at: Span) @deep true linked

        ; fresh_type_var: allocate a new type variable as a PlannedType
        ; wrapper with `variable` populated. Equivalent to Planner.cpp's
        ; freshTypeVar. `debug_name` is stored on the TypeVariable for
