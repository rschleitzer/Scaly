        procedure plan_simd_method(mutable this: Planner, recv: PlannedOperand, m: String, arg_ops: Vector[PlannedOperand], second: PlannedOperand) @page true @direct true @deep true @deep_into_1_8 true returns PlannedOperand linked

        ; report_hidden_member#: a member hop that misses only because its
        ; owner's concept is not `use`d in this file — `c.helpers.y` where the
        ; helpers' type comes from another module. The planner recorded an
        ; advisory miss and the EMITTER aborted, rc 16 `member not found`, with
        ; no file and no line (tscaly lessons §3.5jf). Reported here, at the
        ; access, with the `use` that fixes it.
        ; operand_holds_local_ref#: is `op` a reference to something that dies
        ; with this frame -- a `&<frame-local>` (the same conjunction the return
        ; leaf judges: a Local pointee AND a region below the escape threshold,
        ; so a `&^this` box passes) or a reference field read off a tainted
        ; local struct.
        function operand_holds_local_ref(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; stamp_local_ref_holder#: a `set` whose target is a plain LOCAL (no
        ; field chain, not a parameter) and whose source is a reference to
        ; something frame-local. The escape checker judges a returned, stored
        ; or passed name by the Local pointee on its TYPE, and a declared type
        ; carries none: `var r: ref[X]? null` / `set r: &a` / `r` returned the
        ; address of a stack slot at rc 0 -- also through a `when` binding,
        ; the "set ref_var: <choose-bound value>" class CLAUDE.md carried as
        ; ACTIVE since session 25. Only `let r &a` (no annotation) inherited
        ; the stamp. The binding's type is re-stamped in place, flow-
        ; insensitively on purpose: after `if c set r: &a` the name may hold
        ; the address wherever it is read.
        procedure stamp_local_ref_holder(mutable this: Planner, target: PlannedOperand, source: PlannedOperand) @deep true linked

        ; report_unknown_target_field#: a `set` whose field chain names a field
        ; its RECORD does not declare. The member resolver records such a hop as
        ; a placeholder at field 0 with an advisory error only; a READ of it is
        ; the emitter's exit 16, but a STORE went through the placeholder: `set
        ; o.nosuch: 7` on a local wrote 7 into the record's FIRST field, rc 0.
        ; It was live in the compiler itself: after the Planner's analysis state
        ; moved into sub-records (2026-09-24), `set planner.deep_facts: true` in
        ; cli.scaly compiled, wrote `true` over the Planner's first field and
        ; left the interface facts off. A hop on a PARAMETER was already refused
        ; by the let-field gate, with a message about the wrong thing. Only a
        ; hop into a Structure is judged: methods, variants and a `.value` are
        ; resolved by other arms and never carry a field index.
        procedure report_unknown_target_field(mutable this: Planner, target: PlannedOperand) @deep true linked

