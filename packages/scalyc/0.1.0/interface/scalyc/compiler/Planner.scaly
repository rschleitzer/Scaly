        ; emit_operands -> emit_operand(first.unwrap()).
        procedure escape_walk_operands(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) io linked

















        ; Walk one statement reached through a ref[PlannedStatement]? field.
        procedure escape_walk_statement_ref(mutable this: Planner, stmt: ref[PlannedStatement]?) io linked










        ; Walk one operand by value. choose op.expr mirrors emit_operand;
