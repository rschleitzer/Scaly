        procedure add_equality_constraint(
            mutable this: Planner,
            left: PlannedType,
            right: PlannedType,
            loc: Span
        ) @persists true @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true linked

        ; solve_and_apply: drain the constraint queue, unify everything,
        ; stash the result in `solution`. Returns true on success, false
        ; if any constraint failed to unify. Constraints are cleared on
        ; success so subsequent add_equality_constraint / solve cycles
        ; start fresh.
        procedure solve_and_apply(mutable this: Planner) @ret_nonlocal true @deep true returns bool linked

        ; apply_current_substitution: rewrite `t` using the current
        ; `solution`. Convenience wrapper around apply_substitution so
        ; callers don't have to marshal the Array-as-Vector themselves.
        function apply_current_substitution(this: Planner, t: PlannedType) @page true @direct true @deep true returns PlannedType linked

        ; ================================================================
        ; plan_type: Model.Type → PlannedType using the active generic
        ; substitutions. Pulls together resolve_type_base (Model → Plan
        ; skeleton), apply_name_substitution (T → int, etc.), and the
        ; concept registry to fill in mangled_name for registered types.
        ; ================================================================
        ; is_concept_parameter_name: is `name` declared as a type PARAMETER by
        ; any registered concept? The tree's own generics all use a single
        ; uppercase letter, which is_generic_type_param_name# recognises
        ; directly and which type_mentions_generic_param# already depends on —
        ; but nothing in the language requires that, and a user writing
        ; `define Box[Elem]` must not have `Elem` reported as an unknown type
        ; while the TEMPLATE body is planned (there the parameter is unbound by
        ; definition). Asking every concept rather than the enclosing one is
        ; deliberately lax in the safe direction: it can only ever SUPPRESS a
        ; report, and the set it suppresses is the set of parameter names, which
        ; in this tree is T/K/V.
        ;
        ; ★It WAS hot: 10 % of the tscaly root's plan time as a scan over every
        ; concept's parameters (2026-09-26, `sample`) -- an index entered at
        ; register_concept# since.
        function is_concept_parameter_name(this: Planner, name: String) @ret_param_0 true @deep true returns bool linked

        ; unknown_type_name: `t` names nothing that could be a type — return that
        ; name, otherwise "". The type-annotation counterpart of
        ; unknown_identifier_name#, and the last of the silent classes: an
        ; annotation that resolves to no type was DROPPED with rc 0 and not a
        ; word, in every position that takes one —
        ;
        ;   let r: nosuchtype 5          function f(a: nosuchtype)
        ;   function f() returns nosuchtype   define R (a: nosuchtype)
        ;   mutable g: nosuchtype 3
        ;
        ; — and, worst of the set, `let r nosuchname + 1`, where the untyped
        ; binding PEELS its first operand as a type annotation, so a typo in an
        ; expression became a binding of an unknown type and the diagnostic the
        ; binary-operator check would have raised never ran.
        ;
        ; The exemptions, each for a shape that legitimately reaches the
        ; unknown-name exit of plan_type#:
        ;   * a DOTTED name — the namespace machinery owns those, and the
        ;     union-variant and namespace-function forms return before the exit;
        ;     the same carve-out unknown_identifier_name# makes.
        ;   * a primitive (a plain one returns early with a mangled name; this is
        ;     belt and braces for the array/generic rewrites).
        ;   * a generic type PARAMETER, by the single-letter convention and, for
        ;     user code that does not follow it, by is_concept_parameter_name#.
        ;   * any registered concept, asked WITHOUT use-visibility
        ;     (lookup_concept_any#): a type hidden by visibility is a different
        ;     diagnosis with its own hint, and reporting it here would make this
        ;     check a function of which `use` lines a file happens to carry.
        ; report_unknown_type: the ANNOTATION-position half of the check. Called
        ; only from the places a Model.Type arrives as a written annotation —
        ; plan_item# (binding, parameter, lambda parameter, init/operator
        ; parameter), plan_property#, plan_function#'s return and throws types,
        ; plan_global#, and plan_binding#'s peeled type.
        ;
        ; ★It is NOT called from plan_type#'s own unknown-name exit, and the
        ; measurement that ruled that out is worth keeping: `plan_type` is
        ; applied to any Type-SHAPED expression, not to annotations, so that exit
        ; reports 10535 times over this tree — 2068 of them the operator `+`,
        ; 1714 `*`, then `memcpy`, `exit`, `get_iterator`, `const_char`. That is
        ; the same reason unknown_identifier_name# carries its long exemption
        ; list. An annotation position needs no such list because a name there
        ; can only be a type.
        procedure report_unknown_type(mutable this: Planner, t: PlannedType) @ret_nonlocal true @deep true linked

        function unknown_type_name(this: Planner, t: PlannedType) @page true @direct true @ret_param_1 true @deep true returns String linked

        ; report_unknown_page_name#: a `^name` page sigil must NAME something.
        ; `Foo^nosuchname(7)` used to compile in TOTAL SILENCE and take the
        ; whole statement with it: the Emitter's resolve_reference_page# found
        ; nothing, the construction emitted no value, and the enclosing
        ; statement was dropped -- a function whose body was one such binding
        ; came out as a bare `ret i64 0`, rc 0, not a word. Same class as the
        ; unknown-identifier and unknown-assignment-target drops.
        ; ★It cost a measuring round on 2026-08-26: `let pa RecA^page(7)`
        ; inside a function with no `page` in scope answered 0 for every field,
        ; which reads exactly like a broken union payload -- the probe it was
        ; written for was diagnosing something else entirely.
        ; Accepted without a scope entry:
        ;   this      the receiver's own page (the emitter wraps Page.get(this))
        ;   rp / _rp  the implicit caller-page slot (never a declared
        ;             parameter since 2026-09-25), SYNTHESIZED by this planner
        ;             (Lifetime.Reference("rp")), so it has no binding of its own
        ; plus a PROPERTY of the receiver concept -- the `^field` form the
        ; emitter resolves through `this` (opensp's `^host` where host is a
        ; member). The receiver is read off `this`'s OWN binding, because the
        ; planner keeps no current-concept the way the emitter does.
        procedure report_unknown_page_name(mutable this: Planner, t: Type) @deep true linked

        ; ================================================================
        ; TYPE ALIAS resolution at the MODEL level
        ; ================================================================
        ; Rewrite a Model Type tree, replacing every alias name by its target,
        ; BEFORE resolve_type_base# runs. That placement is the whole point:
        ; resolve_type_base# joins the dotted name, recurses on its generic
        ; arguments THROUGH ITSELF and builds the Itanium mangling -- it is
        ; static, has no Planner state and so cannot look a concept up. An alias
        ; nested inside `Array[LLVMValueRef]` is therefore never handed to
        ; plan_type# at all and cannot be resolved there.
        ; ★MEASURED, not reasoned: an env-gated probe over a converted scalyc
        ; reported 28 427 `…Ref` types reaching plan_type#, EVERY one of them
        ; with the flag armed and no generics -- i.e. every type plan_type# sees
        ; is already resolved, and the survivors were the ones it never saw.
        ; The tell in the diagnostics is a field declared with the alias
        ; (`Option[ref[Array[LLVMValueRef]]]`) taking a value whose type has
        ; resolved (`Array[pointer[LLVMOpaqueValue]]`).
        function model_type_has_alias(this: Planner, t: Type, depth: int) @ret_nonlocal true @deep true returns bool linked

        ; The rewrite itself. Only ever called where model_type_has_alias# said
        ; yes, so the common path allocates nothing.
        function resolve_model_type_aliases(this: Planner, t: Type, depth: int) @page true @direct true @deep true returns Type linked

        procedure plan_type(mutable this: Planner, mutable t: Type) @page true @direct true @deep true @deep_this_2 true returns PlannedType io linked

        ; ================================================================
        ; plan_item: Model.Item → PlannedItem.
        ;
        ; Handles the optional name and type annotation. Attributes are
        ; dropped for now — the PlannedItem carries `null` in that slot
        ; until attribute planning is ported.
        ;
        ; Returns-by-value copies the PlannedItem to the caller; the refs
        ; inside (name, item_type) point into single-element holder Vectors
        ; allocated on this function's rp, so they survive the caller's
        ; use of the returned PlannedItem.
        ; ================================================================
        procedure plan_item(mutable this: Planner, mutable i: Item) @page true @direct true @deep true @deep_this_2 true returns PlannedItem io linked

        procedure plan_item_attributes(mutable this: Planner, attributes: Vector[Attribute]) @ret_param_0 true @deep true returns ref[Vector[PlannedAttribute]] linked

        ; plan_items: batch version of plan_item over a Vector[Item].
        ; Pre-allocates the result Vector at the correct size so we can
        ; use `put(i, ...)` instead of Array.add + copy.
        procedure plan_items(mutable this: Planner, mutable items: Vector[Item]) @page true @direct true @ret_caller true @deep true @deep_this_2 true returns Vector[PlannedItem] io linked

        ; plan_constant_operand: wrap a Constant literal as a PlannedOperand
        ; with its inferred type populated. The result_type is whatever
        ; infer_constant_type says at pre-solver time (e.g. IntegerConstant
        ; → "int", StringConstant → String).
        function plan_constant_operand(
            this: Planner,
            c: Constant,
            loc: Span
        ) @page true @direct true @deep true returns PlannedOperand linked

        ; ================================================================
        ; Simple Expression planners.
        ; ================================================================

        ; plan_sizeof: SizeOf(type) → PlannedSizeOf with computed byte
        ; size. get_primitive_alignment doubles as size for primitives
        ; but returns the catch-all 8 for any non-primitive — wrong for
        ; struct types like Module (80 B). Look the Concept up in the
        ; registry (set up during plan_program's namespace walk, before
        ; generic instantiation runs) and compute the size from its
        ; Model.Property list. Each property's contribution is either a
        ; primitive byte size or a hardcoded stdlib-container shape:
        ; Vector = 16 (length + data), String/HashMap = 8 (single ptr).
        ; That gives Module = 1 (bool) + 7 (pad) + 2*8 + 3*16 + 8 = 80,
        ; matching the LLVM struct layout. Without this, Vector(rp,len)
        ; for Vector[Module] allocates len*8 instead of len*80, and
        ; put(i, m) overruns and SEGVs build_program.
        procedure plan_sizeof(mutable this: Planner, mutable s: SizeOf) @page true @direct true @deep true @deep_this_2 true returns PlannedSizeOf io linked

        ; plan_is: Is(name) is a runtime variant-tag test. At this site
        ; we resolve the test type and (best-effort) the union_name; the
        ; `variant_tag` and `value` fields get stitched in at the
        ; operand-sequence collapse site, which has the value operand.
        procedure plan_is(mutable this: Planner, mutable i: Is) @page true @direct true @deep true @deep_this_2 true returns PlannedIs io linked

        ; plan_as: `x as TargetType` — explicit cast. Resolves the
        ; target type; the value operand is stitched in at the use site
        ; (typically during collapse, like PlannedIs).
        procedure plan_as(mutable this: Planner, mutable a: scaly.compiler.Model.As) @page true @direct true @deep true @deep_this_2 true returns PlannedAs io linked

        ; plan_alignof: alignof(Type) → size_t. Mirrors plan_sizeof.
        ; s106: take the alignment from get_primitive_alignment instead
        ; of hardcoding 0. Without this, every `alignof T` lowers to a
        ; literal 0 — observed first as init_lifetime's
        ; `page.allocate(sizeof int, alignof int)` passing align=0.
        procedure plan_alignof(
            mutable this: Planner,
            mutable a: scaly.compiler.Model.AlignOf
        ) @page true @direct true @deep true @deep_this_2 true returns PlannedAlignOf io linked

        ; plan_type_operand: a Model.Type used as an operand can mean
        ; qualified_ref_is_dangling: a VALUE-position qualified name `X.Y`
        ; (exactly two segments) whose prefix X is a known NAMESPACE but whose
        ; suffix Y is not any member of it (function/operator/nested concept),
        ; not a registered concept/type (X.Y or bare Y), not a union variant,
        ; and not a global constant. Such a reference is a dangling qualified
        ; access — a typo like `NS.bogus` — that currently plans leniently as a
        ; bare Type operand (the emitter then produces garbage: `return NS.bogus`
        ; compiles and returns 0). This lets plan_type_operand#'s value fallback
        ; hard-error instead. Deliberately CONSERVATIVE — it fires only for a
        ; two-segment name with a resolvable NAMESPACE prefix, so deep paths,
        ; package/module names, type variables, generic params, struct static
        ; calls, and every real member are left untouched (no false positive).
        ; A parenless reference to a REAL member (`NS.real`, function not called)
        ; is NOT flagged — that is a separate lenient case, out of scope here.
        procedure qualified_ref_is_dangling(mutable this: Planner, t: Type) @ret_nonlocal true @deep true returns bool linked

        ; different things depending on whether the name resolves to:
        ;   - a local variable in scope → PlannedVariable with its type
        ;   - a top-level function name → keep as Type, result is a
        ;     function reference (return-type filled in later during
        ;     call resolution)
        ;   - an actual type name → PlannedExpression.Type with the
        ;     planned type
        procedure plan_type_operand(mutable this: Planner, mutable t: Type, loc: Span) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; ================================================================
        ; Control-flow planners.
        ; ================================================================

        ; statement_result_type: extract the PlannedType produced by a
        ; statement used as an expression. Covers the Action case (the
        ; common `if cond x else y` shape); non-value statements
        ; (Return/Throw/Break/Continue/Binding) return void.
        ; block_tail_type#: the type a block's value carries -- that of the
        ; last statement's value OPERAND, whose type holds the residence stamp
        ; (a `Local` call result; the action's own result_type does not). An
        ; interpolated string is such a block: without the stamp, handed to a
        ; routine that keeps it (`add_diagnostic(loc, "...`x`...")`), it was
        ; not promoted and the kept message dangled (2026-09-25).
        function block_tail_type(s: PlannedStatement) @page true @direct true @deep true returns PlannedType linked

        ; a call or construction that carries no explicit placement
        function operand_is_unplaced_build(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function statement_result_type(s: PlannedStatement) @page true @direct true @deep true returns PlannedType linked

        ; plan_if: plans the condition (a Vector[Operand]), the consequent
        ; statement, and optionally the alternative. Emits a bool
        ; constraint on the condition and (when an alternative exists)
        ; unifies the two branches' result types.
        ; A method hop on a CALL RESULT with its argument tuple (`name_of().equals(
        ; "Symbol")`, `this.acc().m(x)`). The hop handed lookup_method an EMPTY
        ; operand vector and never coerced the arguments afterwards, so a string
        ; literal into a `Slice[char]` parameter went in as the raw String
        ; struct: `name_of().equals("Symbol")` answered false at rc 0 (tscaly
        ; lessons §3.5jy, §3.5jg). The arguments are collapsed first and
        ; travel with their types, and the matched call gets the same null /
        ; cstr / char-and-Slice coercions as the non-chained path. False (after
        ; a diagnostic) when the method does not resolve.
        procedure plan_chained_method_call(mutable this: Planner, result: PlannedOperand, mutable method_name: String, next_args: PlannedOperand, mutable found: ref[bool]) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; The hops of a member chain on a CALL RESULT that the chaining loop
        ; does not consume. `mk().inner.get(1)` handed the loop `get` alone,
        ; and `name().length` (a parenless method) is no property, so the tail
        ; path attached nothing: both dropped their hops at rc 0 -- the first
        ; ran Outer.get where Inner.get was written, the second compared the
        ; String itself (2026-09-29). Walked one hop at a time on the running
        ; result: a property extends its member chain, anything else is a
        ; zero-argument method call, which plan_chained_method_call# reports
        ; when it does not resolve.
        procedure apply_call_result_hops(mutable this: Planner, mutable result: PlannedOperand, hops: Vector[PlannedMemberAccess], count: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; A CHAINED call as the right side of a binary operator (`a or
        ; this.acc().m(x)`): the call-fold folded ONE argument tuple, and the
        ; method hop `.m` rides on that tuple — folding `[this.acc, ()]` alone
        ; left `(x)` behind and dropped `.m` with it, so the right side was
        ; `this.acc()`, whose POINTER went into the phi as the i1: false for
        ; every input (tscaly lessons §3.5jm, §3.5kw). The whole run is folded
        ; at once — each further tuple while the one before it carries a
        ; member hop — and the chain loop of collapse_operand_sequence# resolves
        ; it as it does in statement position. `extra` counts the tuples past
        ; the first.
        procedure fold_rhs_call(mutable this: Planner, rhs: PlannedOperand, ops: Vector[PlannedOperand], at: size_t, mutable extra: ref[size_t]) @page true @direct true @stores true @deep true @deep_this_6 true returns PlannedOperand io linked

        ; The operand of a PREFIX operator on the right side of a binary one is
        ; a call when a tuple follows it (`6 <= *w(b, 0)`, `5 - -f(3)`): the
        ; call binds tighter than the prefix, so it is folded first. The prefix
        ; branch took the NAME alone and left the tuple behind; the comparison
        ; and the `if` around it vanished, an arithmetic right side was
        ; garbage, rc 0 (2026-09-27, found writing the route-3 spike).
        ; `extra` counts the operands consumed past the prefix's operand.
        procedure fold_prefix_call(mutable this: Planner, operand: PlannedOperand, ops: Vector[PlannedOperand], at: size_t, mutable extra: ref[size_t]) @page true @direct true @stores true @deep true @deep_this_6 true returns PlannedOperand io linked

        function operand_is_tuple(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; an argument tuple with a member hop after it (`()` of `f().m`): the
        ; hop is UNRESOLVED here — the call's result type is not known before
        ; the fold, so `is_method` cannot be asked (the chain loop asks the
        ; hop's NAME with the following tuple, and so does this)
        function tuple_ends_in_method(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; `if c { … }` on ONE line: an Expression may be a Block, so the block
        ; is the condition's LAST OPERAND (`c {…}`), the line break ends the
        ; condition and the NEXT statement becomes the body. The body never ran
        ; and a tail value after it was swallowed — `if k = 1 { return 10 }` then
        ; `20` answered 0 for every k, rc 0 (tscaly lessons §3.5ji; 237 printer
        ; dispatch arms fell through). No condition ends in a block on purpose.
        procedure report_block_in_condition(mutable this: Planner, ops: Vector[Operand], what: Slice[char]) @deep true linked

        ; plan_condition_operands#: plan an `if` condition so that a null test
        ; proves its name for the rest of an `and` chain, as a nested `if`
        ; proves it for its body: `if e <> null and cs.excluded(e)` handed an
        ; Option to a `ref` parameter (rc 4) where `if e <> null / if
        ; cs.excluded(e)` compiled -- the one real reason the tree nested its
        ; conditions (2026-09-24). The operands are split at every top-level
        ; `and`; each segment is planned and collapsed on its own, under a
        ; scope that carries the null tests of the segments before it; the
        ; positive tests land in `facts` for the consequent. A chain with a
        ; top-level `or` is planned as before -- `a and b or c` proves nothing
        ; about c.
        procedure plan_condition_operands(mutable this: Planner, mutable ops: Vector[Operand], mutable facts: ref[Array[String]]) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns Vector[PlannedOperand] io linked

        ; operand_word#: the single-segment name an operand spells, or "".
        function operand_word(op: Operand) @page true @direct true @ret_caller true @deep true returns String linked

        procedure plan_if(mutable this: Planner, mutable f: If) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedIf io linked

        ; plan_lambda: anonymous function literal. Opens a fresh scope,
        ; seeds each parameter with a fresh type variable (lambdas omit
        ; parameter type annotations), plans the body Action, and
        ; synthesizes a unique mangled name. Captures are the set of
        ; variable names referenced in the body that aren't lambda
        ; parameters — a best-effort over-approximation (inner bindings
        ; may leak in) that the emitter can intersect with the real
        ; outer scope.
        ; collect_free_names: walk a PlannedOperand's expression tree
        ; and accumulate the names of every PlannedVariable reference
        ; encountered. Recurses into Call args, Tuple components, and
        ; If/Match/Block/Choose sub-statements. Used by plan_lambda's
        ; capture-discovery pass — captures are this set minus any
        ; lambda-local names (params + inner bindings).
        procedure collect_free_names(
            this: Planner,
            op: PlannedOperand,
            mutable acc: ref[Array[String]]
        ) @ret_nonlocal true @deep true linked

        ; Recursive lambda-body name walkers used by monomorphize_lambda#'s
        ; capture discovery. Unlike collect_free_names (which only reaches
        ; Variable/Call/Tuple, so a block-bodied lambda's captures were missed
        ; entirely), these recurse through every compound expression and
        ; statement. They are FLOW-SENSITIVE within a linear statement
        ; sequence: `bound` is maintained in evaluation order, and a name a
        ; body PlannedBinding (or a for-loop / when / try identifier)
        ; introduces is added to `bound` ONLY AFTER its initializer is walked.
        ; A PlannedVariable USE is recorded into `uses` (a capture candidate)
        ; only when its name is not yet in `bound` at that point — so a use
        ; that lexically PRECEDES a body binding of the same name (the
        ; use-before-bind case `let n n + 1` over an enclosing `n`) captures
        ; the enclosing value, while a use AFTER the binding is the local.
        ; Ordinary shadowing (`let n 3; x + n`, no preceding use) stays local.
        ; The walk is also SCOPE-ACCURATE, not just linear: every construct
        ; that pushes a planner scope (block, for/while/repeat body, choose /
        ; match / try when-arm, try-else) records the bound-set length on entry
        ; and TRUNCATES back on exit (`set bound.length:` — `bound` is passed by
        ; reference), so a name bound only inside a nested block or sibling
        ; branch does NOT suppress a capture of an enclosing same-named variable
        ; used after it. `if` branches, choose/match `else`, and the try-bound
        ; name are NOT scoped/truncated here because plan_if/plan_choose/
        ; plan_match don't push a scope for them and the try binding leaks into
        ; the enclosing scope — mirroring the planner exactly keeps "bound at
        ; this point" equal to "pass-1 resolved this use to a body-local".
        function name_in_string_array(this: Planner, arr: Array[String], name: String) @ret_nonlocal true @deep true returns bool linked

        procedure collect_lambda_names_ops(this: Planner, ops_ref: ref[Vector[PlannedOperand]]?, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @deep true linked

        procedure collect_lambda_names_action(this: Planner, act: PlannedAction, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @ret_nonlocal true @deep true linked

        procedure collect_lambda_names_stmt(this: Planner, stmt: PlannedStatement, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @ret_nonlocal true @deep true linked

        procedure collect_lambda_names_stmts(this: Planner, stmts_ref: ref[Vector[PlannedStatement]]?, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @deep true linked

        procedure collect_lambda_names_stmt_opt(this: Planner, stmt_ref: ref[PlannedStatement]?, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @deep true linked

        procedure collect_lambda_names(this: Planner, op: PlannedOperand, mutable uses: ref[Array[String]], mutable bound: ref[Array[String]]) @ret_nonlocal true @deep true linked

        procedure plan_lambda(mutable this: Planner, mutable lam: Lambda) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedLambda io linked

        ; Phase-1 lambda monomorphization: given a lambda model and the
        ; call-site argument types, synthesize (and record, once) a concrete
        ; top-level function whose parameters take those arg types, plan its
        ; body, and return the function's mangled name. The call site then
        ; resolves to a direct call to this function (see the lambda-call
        ; intercept in collapse_operand_sequence#). Cached per mangled name
        ; via has_recorded_function so repeated calls with identical arg
        ; types reuse the same function.
        procedure monomorphize_lambda(mutable this: Planner, base_name: String, mutable lam: Lambda, arg_types: Vector[PlannedType]) @page true @direct true @stores true @ret_caller true @deep true @deep_this_12 true returns LambdaMonoResult io linked

        ; GAP B substep 2: build a closure VALUE for a lambda assigned to a
        ; delegate type. Monomorphizes the real lambda against the delegate's
        ; parameter types (captures become leading params, reused from
        ; monomorphize_lambda#), then packages a PlannedClosure carrying the
        ; real symbol, a generated thunk symbol, the closure record type name,
        ; and the captured VALUES (looked up here, where they are in scope) +
        ; their types. The emitter lowers it to a heap `{ptr thunk, caps...}`
        ; record; the thunk bridges the uniform `R(ptr self, params)` call
        ; shape to `real(caps..., params)`. `life` is the record's allocation
        ; lifetime (local region, or `#` caller page when the closure escapes).
        procedure make_closure(mutable this: Planner, base_name: String, mutable lam: Lambda, dparams: Vector[PlannedType], dret: PlannedType, del_pt: PlannedType, life: Lifetime) @page true @direct true @stores true @deep true @deep_this_12 true returns PlannedClosure io linked

        ; plan_repeat: do-while body runs at least once; the terminating
        ; condition lives inside the body action via `break` or an
        ; embedded if. Nothing else to constrain at this level.
        procedure plan_repeat(mutable this: Planner, mutable r: Repeat) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedRepeat io linked

        ; Recursive break-value-type finder. Descends through if/choose/match
        ; consequents and nested blocks, but NOT into nested while/for/repeat
        ; bodies (an unlabeled break there targets the inner loop, not this
        ; repeat). Returns void when no break-with-value is found.
        function find_break_type_in_operands(this: Planner, ops: ref[Vector[PlannedOperand]]?) @page true @direct true @deep true returns PlannedType linked

        function find_break_type_in_statement(this: Planner, s: PlannedStatement) @page true @direct true @deep true returns PlannedType linked

        function find_break_type_in_stmt_ref(this: Planner, s: ref[PlannedStatement]?) @page true @direct true @deep true returns PlannedType linked

        function find_break_type_in_expr(this: Planner, e: PlannedExpression) @page true @direct true @deep true returns PlannedType linked

        ; plan_while: Binding condition + Action body. The binding opens
        ; a short-lived scope for the loop variable. Emits a constraint
        ; that the planned binding's type is bool (the solver promotes
        ; `while let maybe_x = ...` through Option's None sentinel, so
        ; this is a reasonable approximation today).
        procedure plan_while(mutable this: Planner, mutable w: While) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedWhile io linked

        ; plan_for: loop variable bound to each element of `expression`.
        ; Two shapes are supported, matching the C++ Planner:
        ;   1. Integer range: `for i in N` — element type == N's type.
        ;   2. Iterator protocol: `for x in collection` — resolve
        ;      `get_iterator` on the collection type, then `next` on the
        ;      iterator type; the element type is what `next` returns.
        ; Option[T] and ref/pointer wrappers on the collection type are
        ; peeled before the dispatch.
        procedure plan_for(mutable this: Planner, mutable f: For) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedFor io linked

        ; try_condition_can_throw#: does ANY operand of a try's condition throw?
        ;
        ; plan_try below reads only the LAST operand, because that is where the
        ; Result wrapper it has to unpack sits. For the DIAGNOSIS the question
        ; is the other one -- is there anything in this condition that could
        ; throw at all -- and it must be asked over every operand, or a
        ; condition like `f() + 1` with a throwing `f` would be reported as a
        ; lie when it is not one.
        function try_condition_can_throw(bind: PlannedBinding) @ret_nonlocal true @deep true returns bool linked

        ; try_fault_arm_count#: how many arms name a RuntimeFault variant?
        ; The COUNT and not a yes/no, so the diagnosis can tell a try that
        ; catches NOTHING from one that MIXES a fault arm with a foreign one --
        ; two different mistakes, and the second one's message was misleading
        ; while both said "the when arms are unreachable".
        procedure try_fault_arm_count(mutable this: Planner, t: Try) @ret_nonlocal true @deep true returns size_t linked

        ; try_arms_are_faults#: does EVERY arm of this try name a variant of
        ; the prelude's RuntimeFault?
        ;
        ; ★Every arm, not any: a try that mixes a fault arm with something else
        ; is a confusion, and answering "yes" would send the other arm into the
        ; panic path where its tag matches nothing. A mixed try keeps the hard
        ; diagnosis below instead.
        procedure try_arms_are_faults(mutable this: Planner, t: Try) @ret_nonlocal true @deep true returns bool linked

        ; report_try_without_throw#: a `try` whose condition cannot throw.
        ;
        ; ★★★It used to compile in TOTAL SILENCE and do nothing: the `when`
        ; arms were not emitted at all -- `try let x s[i] when e: Oob return 55`
        ; ended the process with rc 15 and the 55 never appeared in the IR, and
        ; `try let v plain(argc) when e: X` simply ran the call and dropped the
        ; arm (both measured 2026-09-07 on the production binary). So an author
        ; could write a handled case that is none, and nothing anywhere said a
        ; word.
        ;
        ; ★It is the CONDITION that is judged, never the arms: a `try` with no
        ; arms at all is left alone, and so is one whose condition throws
        ; somewhere other than in its last operand.
        procedure report_try_without_throw(mutable this: Planner, t: Try, bind: PlannedBinding) @deep true linked

        ; report_unhandled_throw#: a binding whose operation calls a `throws`
        ; function, outside any try.
        ;
        ; ★★★It used to be SILENT and wrong, which is worse than the try class
        ; closed the same day: `let x step(b)` where step throws answered
        ; 6164131296 -- the Result wrapper read as the success value -- with no
        ; diagnostic and no trap. And it did not propagate either: the same
        ; line inside a function that itself declares `throws` took the success
        ; arm, so the error vanished between two functions that both say
        ; `throws` and the caller's honest `choose ... when e: Error` saw a
        ; success with a garbage value (measured 2026-09-07, TRAPS.md 3.9).
        ;
        ; The tree's convention is EXPLICIT propagation -- CLAUDE.md's "no
        ; exceptions, explicit error propagation", and
        ; tests/regress/throws_propagate.scaly writes `choose` plus `throw e`.
        ; What was missing is that leaving it out said nothing.
        ;
        ; ★Judged at the BINDING, because that is where the wrapper is read as
        ; a value. A `choose` over the call handles it (its subject is an
        ; operation, not a binding), and a `try` plans its binding through
        ; plan_try rather than through plan_statement, so neither reaches here.
        ; ops_contain_throwing_call#: the same question as
        ; try_condition_can_throw#, but over a bare operand sequence -- a
        ; `return` and a `set` carry no PlannedBinding.
        function ops_contain_throwing_call(ops: ref[Vector[PlannedOperand]]?) @ret_nonlocal true @deep true returns bool linked

        procedure report_unhandled_throw_ops(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?, loc: Span) @deep true linked

        procedure report_unhandled_throw(mutable this: Planner, bind: PlannedBinding) @deep true linked

        ; plan_try: try { binding } catch WhenPatterns else alt.
        procedure plan_try(mutable this: Planner, mutable t: Try) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedTry io linked

        ; plan_when: one pattern arm of choose/try. When `union_type` is
        ; non-null and names a registered union concept, the variant's
        ; payload type and tag index are resolved so the Emitter can
        ; extract the payload and compare tags correctly. When union_type
        ; is void (the fallback from plan_try with no exception type),
        ; the arm still plans but variant_type stays void and tag stays 0.
        ; The union a `when` arm names a variant of comes from the choose
        ; SUBJECT's type, not from a name the module wrote, so the use-visibility
        ; gate has no say in it. With the union invisible in the module (a record
        ; holding it was `use`d, the union was not), both lookups answered
        ; nothing, the tag stayed 0 and every arm tested variant 0: tscaly's
        ; printer answered null for every class until it globbed the ast module
        ; (lessons §3.5ji 2). Asked as before first; only a miss asks again with
        ; the gate off, so a visible union — and its glob disambiguation — is
        ; answered exactly as before.
        procedure when_variant_tag(mutable this: Planner, union_name: String, variant_name: String) @ret_param_0 true @deep true returns int linked

        procedure when_variant_type(mutable this: Planner, mutable union_name: String, variant_name: String) @deep true returns ref[PlannedType]? io linked

        procedure when_union_concept(mutable this: Planner, union_name: String) @ret_param_0 true @deep true returns ref[Concept]? linked

        procedure plan_when(
            mutable this: Planner,
            mutable w: When,
            mutable union_type: PlannedType,
            is_throws_call: bool,
            throws_ty: ref[PlannedType]?
        ) @page true @direct true @stores true @deep true @deep_this_22 true @deep_whole_20 true returns PlannedWhen io linked

        ; plan_choose: Scaly's choose/when pattern match.
        ; Phase-5 class 2 helpers (choose-payload back-prop). True when ops
        ; is exactly one bare single-segment name equal to `name`.
        function ops_are_bare_name(ops: Vector[Operand], name: String) @deep true returns bool linked

        function binding_flows_payload_to_escaping(this: Planner, b: scalyc.compiler.Model.Binding, payload: String) @ret_nonlocal true @deep true returns bool linked

        function action_flows_payload_to_escaping(this: Planner, a: Action, payload: String) @ret_nonlocal true @deep true returns bool linked

        function stmt_flows_payload_to_escaping(this: Planner, s: Statement, payload: String) @ret_nonlocal true @deep true returns bool linked

        ; Phase-5 class 2: does this when-arm's consequent store the arm
        ; payload BARE into a local that the completed escape sets mark
