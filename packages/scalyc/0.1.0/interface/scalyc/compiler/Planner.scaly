        ; planned call passes through it whatever path planned it.
        procedure report_lost_store_page(mutable this: Planner, call: PlannedCall) @deep true linked

        ; the root of an argument is state that outlives this routine: `this`
        ; or one of its parameters (a Variable, whatever member chain follows)
        procedure operand_root_is_own_state(mutable this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        procedure escape_walk_function_body(mutable this: Planner, func: PlannedFunction) @page true @stores true @ret_nonlocal true @deep true io linked

        ; Post-pass entry: two passes over instantiated_functions.
        procedure check_interprocedural_escapes(mutable this: Planner) @page true @stores true @deep true io linked

        ; ===== Channel use-after-send move checker (milestone 1.4) =====
        ; Channel.send transfers OWNERSHIP of the message region to the
        ; receiver, so any later use of the sent binding in the same
        ; function is a use-after-send (the receiver may free the region at
        ; any suspension point). Intra-procedural, conservative-fatal, and
        ; independent of the escape summary: a linear evaluation-order walk
        ; over each Plan body tracks bare binding NAMES — a Channel.send
        ; call (matched by mangled name) marks its message argument's root
        ; name moved; any later read (including passing it to a callee, or
        ; a second send) flags. A fresh `let` / bare `set` of the name
        ; un-moves it (a new value); a bare reference alias (`let q m`,
        ; casts/parens peeled) maps to its root so a use of either flags.
        ; Branch arms walk linearly, so a use in the sibling else-branch of
        ; a send flags too (conservative maybe-moved merge). A loop body
        ; whose walk moved a new name is walked a second time, catching
        ; wrap-around uses (use textually before the send, hit on the next
        ; iteration). Residuals (missed, rule-3 style): a message reached
        ; through a field/global/deref is not tracked; an interior pointer
        ; DERIVED from the sent object via a call (`mp.allocate(...)`) is
        ; not tracked; re-assigning a moved alias's root un-moves the
        ; alias's uses too. Pure checker: it only reads the Plan and only
        ; appends diagnostics, so clean code emits byte-identical IR.

        ; Index of name in the alias map, -1 when unmapped.
        function move_alias_index(this: Planner, name: String) @ret_param_0 true @deep true returns int linked

        ; Tombstone every moved fact and alias mapping for name — the name
        ; just received a fresh value (a new binding or a bare re-set).
        ; Every String stored into the move arrays is pinned to the
        ; Planner's page (^this): the arrays outlive this call's frame,
        ; so a plain String(...) temporary would leave its content on
        ; the dead frame page and the stored handle would dangle (a
        ; later reader decodes a garbage varint length and the copy's
        ; allocation goes wild).
        procedure move_unmark(mutable this: Planner, name: String) @deep true linked

        ; Mark the sent operand's root name moved. Peels as-casts and
        ; single-value parens/derefs; only a bare Variable (no member hop)
        ; marks — a sent field/global/call-result has no bare name to
        ; track (documented residual).
        procedure move_mark_sent(mutable this: Planner, op: PlannedOperand) @deep true linked

        ; Record bind_name as an alias of the bare variable op reads
        ; (root-resolved, so alias chains collapse to one root).
        procedure move_note_alias(mutable this: Planner, bind_name: String, op: PlannedOperand) @deep true linked

        ; A binding gives its name a fresh value: clear stale facts, then
        ; record a bare reference alias (`let q m`, cast/paren peeled) so a
        ; send of either name flags a use of the other.
        procedure move_note_binding(mutable this: Planner, binding: PlannedBinding) @deep true linked

        ; A read of a moved (channel-sent) name — directly or through the
        ; alias map — is a hard use-after-send diagnostic.
        procedure move_check_use(mutable this: Planner, op: PlannedOperand) @deep true linked

        procedure move_walk_operands(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) @deep true linked

        procedure move_walk_statement_ref(mutable this: Planner, stmt: ref[PlannedStatement]?) @deep true linked

        ; Walk one operand in evaluation order: check the read first, then
        ; recurse (arms mirror escape_walk_operand, plus Repeat). At a
        ; Channel.send call the args are walked FIRST (a second send of a
        ; moved name is itself a use), then the message argument (the last
        ; arg) is marked moved. Loop bodies re-walk once when their first
        ; walk moved a new name (wrap-around uses).
        procedure move_walk_operand(mutable this: Planner, op: PlannedOperand) @deep true linked

        procedure move_walk_statement(mutable this: Planner, stmt: PlannedStatement) @deep true linked

        ; Walk one action: the source's reads first; a bare `set name: ...`
        ; target then un-moves the name (fresh value, e.g. re-arming a
        ; message variable in a producer loop) — any other target shape
        ; (field store, deref) READS the base and is use-checked.
        procedure move_walk_action(mutable this: Planner, act: PlannedAction) @deep true linked

        ; Post-pass entry (after the escape checks): use-after-send over
        ; every instantiated function. Programs without channel sends walk
        ; each body once against empty name sets and record nothing.
        procedure check_channel_moves(mutable this: Planner) @deep true linked

        ; Page inference: re-stamp the allocation lifetime of a promotable
        ; operand. Shared by rule 2 (return-escape -> caller page `Call`) and
        ; rule 3 (store-into-`this`-field -> receiver page `Reference("this")`).
        ; Promotion only applies when the operand IS the allocation expression
        ; (a construction/method Call or a Tuple) AND its RESULT genuinely owns
        ; heap guts on the page (result_owns_page_guts) — a pointer/ref result
        ; (e.g. `&b` where b is a local) points into memory that stays put no
        ; matter where the `&` "allocates", so promoting it would be a false
        ; fix that masks a real dangle. Intrinsic OPERATOR calls (`&`, `*`, …)
        ; are likewise never promoted (their result aliases existing storage).
        ; Returns null for the non-promotable shapes (bare local Variable whose
        ; allocation happened at an earlier `let`, ref into a local pointee) so
        ; the caller keeps the hard escape diagnostic — those still need an
        ; explicit annotation or a later dataflow pass. Only call.life is
        ; re-stamped (everything else copied verbatim): rebuilding the
        ; result_type, which embeds the Lifetime union, by value trips the
        ; s34/s196 union-struct-copy ABI hazard and crashes the emitter.
        ; residency_stays_local#: a construction of a type whose bodies derive a
        ; page from `this` (concept_needs_this_residency#) is NOT moved to the
        ; CALLER page when this routine has none. The emitter finds no `_rp`
        ; for it and falls back to a STACK alloca, and a `Page.get(this)` on a
        ; stack object answers a page header below the object, in the callee
        ; frames' region: `var b HashMapBuilder[K, V]()` as a routine's FIRST
        ; statement with a tail of `b.n as int` was promoted this way and
        ; allocated its slots through the stack -- exit 139, or 19 under
        ; SCALY_POISON, rc 0 at compile time (2026-09-24). Kept Local it lands
        ; on the routine's own frame, which is where the promotion would have
        ; ended up anyway had it asked. A plain value struct is not judged: its
        ; stack slot is correct and cheaper (a frame page per loop iteration).
        procedure residency_stays_local(mutable this: Planner, t: PlannedType, new_life: Lifetime) @ret_nonlocal true @deep true returns bool linked

        procedure restamp_operand_life(mutable this: Planner, op: PlannedOperand, new_life: Lifetime) @page true @direct true @deep true returns ref[PlannedOperand]? linked
        ; Recursively re-stamp the operands of a promoted construction's
        ; argument list / component values: each arg that is itself a defaulted
        ; page-owning construction is promoted to the SAME life (it becomes a
        ; field of the escaping aggregate). Args that don't own page guts
        ; (primitives, borrows) or already carry an explicit lifetime are kept
        ; verbatim — restamp_operand_life# returns null for them. Bound-local
        ; args (a Variable) are likewise kept (their own binding is promoted via
        ; the name-graph); only INLINE constructions are restamped here.
        procedure restamp_args(mutable this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[Vector[PlannedOperand]]? linked
        ; Restamp ONLY inline-CONSTRUCTION value-arguments (a Tuple = struct/
        ; variant ctor, or a PlannedCall that is a CONSTRUCTION: a capitalized
        ; name = a Type construction such as LoopSyntax, OR name "init" = a
        ; value-type init# constructor such as String/Vector/Array/HashMap —
        ; these lower to a PlannedCall to the lowercase `init` method, NOT a
        ; capitalized Type name, so the capitalized gate alone misses them and
        ; the de-sigiled `recv.put(0, "x")` left its String on the local
        ; page) of a put/add into an escaping receiver. A regular function-call
        ; RESULT (lowercase non-`init` name) owns its own page routing and must
        ; NOT be overridden — promoting it cascades a bogus caller-page need
        ; across the call graph (the over-flag class). `init` is reserved for
        ; constructors (init/init#/init^ per the spec), so it never names a plain
        ; function. The receiver Variable, the index, call results and explicit-#
        ; args are all kept verbatim (restamp_operand_life# returns null for
        ; them — explicit-# is Call life, gated out — so this stays NEUTRAL on
        ; sigiled source).
        procedure restamp_putadd_constructions(mutable this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[Vector[PlannedOperand]]? linked
        procedure restamp_components(mutable this: Planner, comps: Vector[PlannedComponent], new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[Vector[PlannedComponent]]? linked

        ; promote_escaping_guts#: promote nested page-owning Local-life LEAF
        ; constructions buried inside a RETURNED value aggregate to the caller
        ; page (rp). Unlike restamp_operand_life# — which flips the TOP
        ; construction and only fires for a Local-life top — this walks an
        ; aggregate whose own life is Unspecified (a plain value struct / a
        ; variant returned by sret) and promotes ONLY the genuine Local-life
        ; heap constructions inside its fields. Example: plan_type_operand#
        ; returns `PlannedOperand(.., PlannedExpression.Variable(PlannedVariable(
        ; .., "this", ..)), ..)` — the PlannedOperand/PlannedVariable
        ; structs are stack values copied into the sret, but the fresh
        ; `"this"` data buffer would land on the local page and dangle.
        ; The enclosing value struct stays a stack value; only the dangling heap
        ; guts move to rp. Recurses through PlannedCall args, PlannedTuple
        ; components, and PlannedVariantConstruction value (which restamp_args#
        ; cannot reach). Returns null when NOTHING was promoted (NEUTRAL — the
        ; caller keeps the operand verbatim, so sigiled source whose nested
        ; constructions carry explicit #/^ lifetimes stays byte-identical). All
        ; rebuilds copy PlannedType/String fields verbatim (s34/s196 hazard).
        procedure promote_escaping_guts(mutable this: Planner, op: PlannedOperand, new_life: Lifetime) @page true @direct true @deep true returns ref[PlannedOperand]? linked
        procedure promote_escaping_args(mutable this: Planner, args: Vector[PlannedOperand], new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[Vector[PlannedOperand]]? linked
        procedure promote_escaping_components(mutable this: Planner, comps: Vector[PlannedComponent], new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[Vector[PlannedComponent]]? linked

        ; ================================================================
        ; Implicit-return (tail) promotion. R2 (plan_return#) promotes an
        ; EXPLICIT `return X`; this pair handles the IMPLICIT return — the
        ; body's last expression with no `return` keyword — for a function
        ; whose result owns page guts. A directly-returned no-sigil
        ; construction/call (`{ ... Vector[T](0) }`) is promoted to the
        ; caller page by restamp_operand_life#; a choose/if/match/block tail
        ; (handle_expression#'s `choose syntax when ...: Expression.X(handle_Y
        ; (...))`) recurses into each branch's value position, and a variant
        ; construction (`Expression.Tuple(handle_object(obj))`) recurses into
        ; its payload. Returns null when nothing was promotable (NEUTRAL — the
        ; operand is kept verbatim). All rebuilds copy PlannedType/String
        ; fields verbatim and only swap the promoted sub-operand, avoiding the
        ; s34/s196 result_type-rebuild hazard.
        ; ================================================================
        procedure promote_tail_operand(mutable this: Planner, op: PlannedOperand, new_life: Lifetime) @page true @direct true @deep true returns ref[PlannedOperand]? linked

        ; Promote the value position of a tail STATEMENT (a choose/if/match arm
        ; consequent or a block's last statement). Only an Action with NO store
        ; target carries an implicit value; a Return is already handled by R2
        ; (plan_return#), so leave it (return null). The action's value is its
        ; single source operand.
        procedure promote_tail_statement(mutable this: Planner, stmt: PlannedStatement, new_life: Lifetime) @page true @direct true @ret_caller true @deep true returns ref[PlannedStatement]? linked

        ; ================================================================
        ; convert_tail_literal: the three RETURN-POSITION literal
        ; conversions, applied through a block or an arm (2026-08-09).
        ;
        ; plan_action# reads its tail flag ONCE, for the function's body
        ; ACTION. When that action is a Block — or an if/choose/match — the
        ; literal that actually reaches `ret` sits nested in the tail
        ; STATEMENT, and all three conversions were skipped alike: the
        ; pointer[const_char] wrap, the char fold and the float retype.
        ; `{ if i = 0  return "Latin"  "Greek" }` emitted `ret ptr null`,
        ; and the same body shape returned 0 from a char- and from a
        ; float-returning function. Silent in every case, which is why the
        ; old rule was written down as "a function must not RETURN a
        ; pointer[const_char] literal" — the shape it named (an explicit
        ; `return`) was in fact the one that always worked.
        ;
        ; Same traversal as promote_tail_operand#/promote_tail_statement#,
        ; minus the variant payload (not a literal position) and minus the
        ; call/tuple arms (nothing to convert inside an argument — a call
        ; argument gets its own conversion at the call site). A `Return`
        ; statement inside an arm is plan_return#'s job; recursing into it
        ; would convert twice. Returns null when nothing applies, so it is
        ; a no-op after a direct conversion has already fired.
        ; ================================================================
        ; ================================================================
        ; self_tail_to_return#: an IMPLICIT self tail call -- `f(n - 1, acc)`
        ; as the value a body ends with, directly or as the last statement of
        ; a block or an if/choose/match arm -- is rewritten into the
        ; `return f(...)` it means. The emitter turns an explicit self tail
        ; return into a jump to its tail loop (Emitter.return_is_self_call#)
        ; and never saw the implicit one: until 2026-09-24 `count(n - 1, acc
        ; + 1)` at the end of a body recursed and SIGSEGVed at ten million
        ; where the same line with `return` ran in one frame. Only a DIRECT
        ; call to this very function qualifies (no member hop, no operator,
        ; intrinsic or indirect call); the emitter still decides whether the
        ; loop applies, and where it does not the `return` is what the
        ; implicit tail was. Functions with a result only.
        ; ================================================================
        function impl_or(alt: ref[PlannedImplementation]?, base: PlannedImplementation) @page true @direct true @ret_param_1 true @deep true returns PlannedImplementation linked

        function operand_is_self_call(op: PlannedOperand, mangled: String) @ret_param_0 true @deep true returns bool linked

        procedure self_tail_to_return(mutable this: Planner, impl: PlannedImplementation, mangled: String) @page true @direct true @ret_caller true @deep true returns ref[PlannedImplementation]? linked

        procedure self_tail_statement(mutable this: Planner, stmt: PlannedStatement, mangled: String) @page true @direct true @ret_caller true @deep true returns ref[PlannedStatement]? linked

        procedure self_tail_operand(mutable this: Planner, op: PlannedOperand, mangled: String) @page true @direct true @deep true returns ref[PlannedOperand]? linked

        procedure convert_tail_literal(mutable this: Planner, op: PlannedOperand, rt: PlannedType) @page true @direct true @deep true returns ref[PlannedOperand]? linked

        ; The statement half of convert_tail_literal#. Only an Action with no
        ; store target carries an implicit value; a Return is plan_return#'s.
        procedure convert_tail_literal_statement(mutable this: Planner, stmt: PlannedStatement, rt: PlannedType) @page true @direct true @ret_caller true @deep true returns ref[PlannedStatement]? linked

        ; Hole-1 (2026-07-02f): diagnostic-only mirror of plan_return#'s
        ; reference-escape check for IMPLICIT tail returns. Recurses over
        ; return-position subexpressions exactly like promote_tail_operand#
        ; (variant payloads, choose/if/match arm consequents + alternatives,
        ; block last statement); at each leaf flags a Local-ranked reference
        ; (region_of_operand below the escape threshold, or a tainted-field
        ; read) that gap-1 does not cover. READ-ONLY: no restamp, no rebuild.
        procedure check_tail_ref_escape(mutable this: Planner, op: PlannedOperand, loc: Span) @deep true linked

        ; Tail-statement hop for check_tail_ref_escape#: only an Action with
        ; no store target carries an implicit value; explicit Returns are
        ; already checked by plan_return#.
        procedure check_tail_ref_escape_statement(mutable this: Planner, stmt: PlannedStatement, loc: Span) @deep true linked

        procedure plan_return(mutable this: Planner, mutable r: Return) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedReturn io linked

        procedure plan_break(mutable this: Planner, mutable b: Break) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedBreak io linked

        procedure plan_throw(mutable this: Planner, mutable t: Throw) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedThrow io linked

        ; ================================================================
        ; plan_statement: Model.Statement → Plan.PlannedStatement.
        ; Dispatches over the Statement union and delegates to the
        ; variant-specific plan_* method. `Continue` is trivial — just
        ; carries the location.
        ; ================================================================
        procedure plan_statement(mutable this: Planner, mutable s: Statement) @page true @direct true @stores true @deep true returns PlannedStatement io linked

        ; Page inference (discarded page-call statement, 2026-07-03c): a
        ; page-requiring, non-operator call in NON-LAST statement position
        ; discards its result — the call matters only through its side
        ; effects, and any data the callee allocates on the passed page that
        ; PERSISTS (shallow-stored into `this`-state registries, e.g.
        ; plan_module's planned functions reaching record_function) must
        ; outlive this frame. The Design-B flip in collapse stamped the call
        ; Local because its result type owns page guts, but for a discarded
        ; result that routing is never right: persistent callee data on the
        ; local page DANGLES at first read after this frame exits, while
        ; transient callee data on rp is only a bounded leak. This extends
        ; the flip site's own void rationale (a void page-call is a storage
        ; procedure -> it must receive the caller's rp) to value-returning
        ; calls whose value is dropped — the interprocedural "callee's
        ; page-arg allocations escape the call" summary, degenerated to the
        ; one signal that needs no call-graph walk and no sigils: the result
        ; is discarded. Non-last position is PRECISE (a non-last statement's
        ; value is never a block value, arm value, or tail return). Gated on
        ; rp in scope (a page-less function keeps the local page); sigiled
        ; `#` calls carry Call life, which restamp_operand_life# refuses ->
        ; NEUTRAL on sigiled source.
        procedure promote_discarded_pagecall(mutable this: Planner, stmt: PlannedStatement) @page true @direct true @ret_caller true @deep true returns ref[PlannedStatement]? linked

        ; report_effect_free_statement: a statement in NON-LAST position whose
        ; whole value is a discarded OPERATOR result does nothing at all.
        ;
        ; Scaly operators are pure by definition ("Functions are pure … Operators
        ; are always pure"), so a discarded operator result cannot have had a
        ; side effect — the statement is dead, and it was accepted with rc 0 and
        ; not a word. The shape this exists for is the one that reads like an
        ; assignment and is not:
        ;
        ;   set arr[0]: 111
        ;   arr[0] = 222      ; a COMPARISON. arr[0] is still 111.
        ;
        ; `=` is equality in Scaly and there is no assignment operator, so a
        ; `=`-statement is always this mistake; it made a broken array WRITE look
        ; like a broken array read (2026-08-04, address_of_array_element).
        ; Arithmetic (`a + 1`) and every other operator get the same treatment
        ; for the same reason.
        ;
        ; NON-LAST is what makes the check sound, and it is the same precision
        ; promote_discarded_pagecall# rests on: a non-last statement's value is
        ; never a block value, an arm value, or a tail return. A bool-returning
        ; body whose last statement is `a = 0` is the legitimate implicit return
        ; and must stay silent.
        ;
        ; Deliberately narrow to operators. A discarded CALL result is ordinary
        ; (a procedure called for its effect, a builder whose return value is not
        ; needed), and a bare variable or literal as a statement, while equally
        ; dead, is not a shape that has cost anyone anything here.
        ;
        ; The LAST statement is judged too (`last`), for the one shape that is
        ; never a value: an operator call with NO NAME, the leftover of a
        ; failed collapse. `print sb.to_string()` as a procedure's last
        ; statement emitted nothing at rc 0 while the same line one statement
        ; earlier was refused (2026-09-29, found by the json package's tests).
        ; Not in an uninstantiated generic template (planning_template): there
        ; a tail like `v.get() + v.get()` on a `T` is unresolved by nature, and
        ; the instantiation is planned and judged on its own.
        ; Is `name`, standing as an operator, a FUNCTION and nothing else? It
        ; must be declared one and NOT declared an operator: an operator may
        ; carry a text name (`operator 'minus'(...)`, tests/aot/text_operator),
        ; and that one is a real infix call.
        function name_is_only_a_function(this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; A method named without its tuple (`name.length`): the collapse used
        ; to append the empty tuple and call. A thing that is not written is
        ; not there -- `x.m` is the method, `x.m()` the call
        ; (ROADMAP-operation.md); until a method is a value of its own the
        ; bare name is refused. The call is still planned, so the rest of the
        ; routine is judged as before.
        procedure report_method_without_tuple(mutable this: Planner, loc: Span, method: String) @deep true linked

        ; The same failed collapse where its value is BOUND or RETURNED:
        ; `let r show twice(3)` read as `(show twice)(3)`, the "operator"
        ; carrying the function's name, and r held nothing at rc 0.
        procedure report_function_as_operator(mutable this: Planner, op: PlannedOperand) @deep true linked

        procedure report_effect_free_statement(mutable this: Planner, stmt: PlannedStatement, last: bool) @ret_nonlocal true @deep true linked

        ; plan_statements: batch plan_statement over a Model.Block's statements.
        ; Does this statement LEAVE the enclosing block unconditionally?
        ; Only the four that cannot fall through, plus a block whose last
        ; statement is one of them -- `if x = null { ... return }` is written
        ; both ways in this tree.
        ;
        ; ★Takes a REFERENCE, not the union by value. By value this is a self
        ; tail call whose argument is a by-value struct, which the TCO
        ; lowering stages through a shadow slot -- and that memmove crashed
        ; with a garbage address on every input larger than the stdlib
        ; (EXC_BAD_ACCESS in _platform_memmove, one frame below
        ; early_exit_narrows#). A ref also skips the whole-union copy a
        ; `choose` on a value subject makes before it reads the tag.
        ; A call to a NORETURN extern leaves the block as surely as a `return`
        ; does, and the ports write the guard that way: `if peer = null exit 3`.
        ; The list is the emitter's own (Emitter.mark_noreturn_callee) -- the
        ; two must name the same three functions, or one of them is guessing.
        function operand_is_noreturn_call(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; ================================================================
        ; The NEGATION after a `while`: when the loop can only be left by its
        ; condition going false, the false condition is a FACT afterwards.
        ; `while peer = null { ... retry ... }` proves peer for everything that
        ; follows, and it is the idiom the cluster fixtures and the demo write.
        ;
        ; ★The whole proof rests on "can only be left by its condition", so a
        ; BREAK anywhere inside voids it -- and this walk is deliberately blunt
        ; about that: a break belonging to a NESTED loop still blocks the
        ; narrowing. Over-conservative in the one direction that only ever
        ; costs a diagnostic, where the other costs a null deref.
        ; ================================================================
        function ops_contain_break(this: Planner, ops_ref: ref[Vector[PlannedOperand]]?) @ret_nonlocal true @deep true returns bool linked

        function stmts_contain_break(this: Planner, stmts_ref: ref[Vector[PlannedStatement]]?) @ret_nonlocal true @deep true returns bool linked

        function stmt_opt_contains_break(this: Planner, st_ref: ref[PlannedStatement]?) @ret_nonlocal true @deep true returns bool linked

        function components_contain_break(this: Planner, c_ref: ref[Vector[PlannedComponent]]?) @ret_nonlocal true @deep true returns bool linked

        function action_contains_break(this: Planner, a: PlannedAction) @ret_nonlocal true @deep true returns bool linked

        function whens_contain_break(this: Planner, w_ref: ref[Vector[PlannedWhen]]?) @ret_nonlocal true @deep true returns bool linked

        function branches_contain_break(this: Planner, b_ref: ref[Vector[PlannedBranch]]?) @ret_nonlocal true @deep true returns bool linked

        function statement_contains_break(this: Planner, st: ref[PlannedStatement]) @ret_nonlocal true @deep true returns bool linked

        function operand_contains_break(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function statement_exits(st: ref[PlannedStatement]) @ret_nonlocal true @deep true returns bool linked

        ; Retire the proof: `set x: ...` may store anything, null included, so
        ; from that statement on the name is an Option again. This is the half
        ; that makes narrowing a `var` sound, and it is only correct because
        ; plan_statements# walks in PROGRAM ORDER.
        ;
        ; It clears the FACT rather than popping the shadow: the shadow need
        ; not be the top of the scope, and its type and mutability are the
        ; binding's own, so a cleared shadow is indistinguishable from what it
        ; shadows. A nested `set` clears an outer narrowing too, which is the
        ; conservative direction -- lookup_local_binding# finds the same shadow
        ; from any depth.
        procedure retire_narrowing(mutable this: Planner, mutable st: ref[PlannedStatement]) @deep true linked

        ; The EARLY-EXIT shape, and the one the ports actually write:
        ;     if e = null
        ;         return String()
        ;     this.resolve(e)
        ; The test guards nothing that follows it syntactically -- it guards
        ; everything that follows in the BLOCK, because the consequent leaves.
        ; Answers the name to narrow for the remaining statements.
        ;
        ; An `else` disqualifies it: the if is then a fork, plan_if# has
        ; already narrowed each side, and nothing is proven afterwards.
        procedure early_exit_narrows(
            this: Planner,
            mutable st: ref[PlannedStatement],
            mutable out_name: ref[String]
        ) @ret_nonlocal true @deep true returns bool linked

        procedure plan_statements(
            mutable this: Planner,
            mutable stmts: Vector[Statement]
        ) @page true @direct true @stores true @ret_caller true @deep true returns Vector[PlannedStatement] io linked

        ; ================================================================
        ; plan_block: push a fresh scope, plan every statement, pop.
        ; ================================================================
        procedure plan_block(mutable this: Planner, mutable b: Block) @page true @direct true @stores true @ret_caller true @deep true returns PlannedBlock io linked

        ; has_local_lifetime: true iff `t` carries a Local-lifetime
        ; marker. Value types with Unspecified lifetime stay
        ; stack-resident and don't need page cleanup.
        function has_local_lifetime(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; operand_has_local_lifetime: true iff the operand's own type or
        ; any of its planned call args / tuple components carries a
        ; Local lifetime. Does not descend into nested blocks. Feeds the
        ; function-level needs_local_page computation.
        function operand_has_local_lifetime(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; ================================================================
        ; plan_property: Model.Property → Plan.PlannedProperty.
        ;
        ; `mangled_name` is left empty here — the planner enclosing the
        ; struct sets it once the struct's own mangled name is known.
        ; `offset` is 0 until compute_property_offsets runs as part of
        ; the enclosing struct's layout pass.
        ; ================================================================
        procedure plan_property(mutable this: Planner, mutable p: Property) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedProperty io linked

        ; plan_implementation: Implementation variant → PlannedImplementation.
        ; Extern/Instruction/Intrinsic are trivially tagged wrappers;
        ; Action delegates to plan_action which in turn plans its source
        ; and target operand lists.
        ; Page inference, gap 1 (backward binding promotion) — read-only Model
        ; pre-scan collecting bare `return x` targets. A function-body walk that
        ; records, into escaping_return_locals, every local NAME returned bare
        ; (`return x`, including inside if/choose/match/loop bodies). plan_binding#
        ; then promotes those bindings' allocations to the caller page. Missing a
        ; nested shape is SAFE — that binding simply stays a hard escape error,
        ; the pre-inference behavior. NOT recorded: chained/qualified returns
        ; (`return x.f`, `return f(x)`) — those are handled by rule 2's
        ; return-site promotion, not binding promotion.
        function array_contains_name(this: Planner, arr: Array[String], name: String) @ret_nonlocal true @deep true returns bool linked

        ; Option B: like array_contains_name but scanning only entries at
        ; index >= base — the CURRENT function's slice of an entry-truncated
        ; per-function name array. Used by the stamp and no-rp gate so a
        ; lazily-instantiated generic method planned mid-function does not
        ; false-match the outer function's holder names.
        function array_contains_name_from(this: Planner, arr: Array[String], base: size_t, name: String) @ret_nonlocal true @deep true returns bool linked

        ; deep-R2 (nested-construction return-promotion). The bare-`return x`
        ; collection below promotes only the OUTERMOST returned allocation. A
        ; construction returned (directly or via a bound local) builds its value
        ; from SUB-constructions assigned to other locals (`let p Vector(...);
        ; ... T(p, ...)`); those sub-allocations default to the local page and
        ; would be freed before the returned value's fields are read (dangling).
        ; These helpers collect, into escaping_return_locals, every local whose
        ; value flows into a returned construction's argument fields — directly,
        ; and transitively through bindings (the binding closure in
        ; collect_returns_stmt#'s Binding arm + the fixpoint loop in
        ; scan_top_level_returns#). plan_binding# then promotes them all to rp.
        ; Gated on a CAPITALIZED head name (a construction, not a call) so an
        ; ordinary `return f(scratch)` does not over-promote scratch — over-
        ; collection is merely leaky, never unsafe, but the gate keeps it tight.
        ; The escaping-name stores live on `^this` (the Planner's own page), not
        ; `^rp`: the set is a Planner field, so its names belong to the Planner's
        ; region and outlive every per-function scan/promote cycle. `^rp` here
        ; was only ever an accident of the transitive page-set — dropping it was
        ; blocked until the transient `Vector[Operand]` holders in the collect_*
        ; walkers below stopped requiring rp (they are now plain locals). With
        ; those holders local, no scan-machinery function needs rp threaded from
        ; add_escaping_*, so `^this` here no longer collapses the rp web.
        procedure add_escaping_local(mutable this: Planner, name: String) @ret_nonlocal true @deep true linked
        function last_segment_is_capitalized(n: String) @deep true returns bool linked

        function name_is_capitalized(this: Planner, n: String) @ret_param_0 true @deep true returns bool linked
        ; If `ops` is a `RECV.get(...)` call (a dotted Type name ["RECV","get"]),
        ; return RECV (deep-copied onto rp); otherwise the empty string. Used to
        ; back-propagate escape through a Vector element read: `let opp
        ; SRC.get(i)` makes opp alias SRC's element guts.
        ; Alias-yielding method names for binding_get_receiver: `get` returns
        ; an element ref, `get_iterator` returns an iterator holding a pointer
        ; into the container, `next` returns an element ref out of an
        ; iterator (phase-5 class 3: the List-drain idiom `var it C.get_
        ; iterator(); while let m it.next() { set *(buf+i): *m }` threads
        ; escape back from the drained element to the container).
        function is_alias_method_name(n: String) @ret_nonlocal true @deep true returns bool linked
        function binding_get_receiver(this: Planner, ops: Vector[Operand]) @page true @direct true @ret_caller true @deep true returns String linked
        ; UNIFIED value-flow extractor (page-inference name-graph). Given a
        ; value's operand sequence `ops`, collect every bare-local NAME whose
        ; own allocation becomes part of that value — so when an escaping
        ; consumer (a return, or a store into an escaping receiver) takes the
        ; value, those locals escape too and plan_binding# must promote them
        ; to the caller page. This subsumes the former two capitalized-gated
        ; heuristics (collect_value_locals#/collect_ctor_arg_locals#) into ONE
        ; recursive walker that descends ALL value-flow shapes:
        ;   - bare local alias `a`        -> a flows in (the alias itself owns
        ;                                    nothing; promote the source)
        ;   - inline ctor `Ctor(args)`    -> recurse each arg value
        ;   - choose/if/block-valued init -> recurse each branch's value
        ; A CALL or METHOD call (lowercase head, or member-access chain) is NOT
        ; descended: its result is a fresh value (the binding-init restamp
        ; promotes the call itself) or a borrow (result_owns_page_guts gates
        ; restamp), and its arguments are inputs, not the result's guts.
        ; Over-collection is merely leaky, never unsafe; under-collection
        ; dangles. The mutually-recursive collect_flow_stmt# unwraps a branch
        ; statement (Action/Return) to its value operands.
        ; collect_view_sources_of_tail#: the implicit result of a body -- the
        ; last statement of its block, or the action itself.
        procedure collect_view_sources_of_tail(mutable this: Planner, a: Action) @deep true linked

        ; collect_view_sources#: the operand run of a RETURNED value (a
        ; `return`, the implicit tail, or the initializer of a returned alias)
        ; in a view-returning function: `x.method(...)` names its view source
        ; `x` (collect_view_receiver#), and a `Slice[...](args)` construction
        ; takes its view from its arguments. NOT the arguments of any other
        ; construction -- `String^host(sb.to_string())` returns no view of
        ; `sb`, and walking it there moved a StringBuilder onto the caller page.
        procedure collect_view_sources(mutable this: Planner, ops: Vector[Operand]) @deep true linked

        ; collect_view_receiver#: in a function that RETURNS a view (`Slice[T]`),
        ; a returned `x.method(...)` -- two operands, the dotted name and its
        ; argument tuple -- is a view of the local `x` (as_slice, slice_from,
        ; ...), so `x` escapes like a bare `return x` and plan_binding# builds
        ; it on the caller page. Before, `let s sb.to_string()` + `s.as_slice()`
        ; returned a view of a String on the routine's own frame, rc 0, garbage
        ; after the next allocations (CLAUDE.md carried it as ACTIVE since
        ; 2026-09-13). A dotted FIELD read (one operand) was already collected;
        ; the call was not. Only a view-returning function is judged, so
        ; `return s.get_length()` elsewhere promotes nothing.
        procedure collect_view_receiver(mutable this: Planner, ops: Vector[Operand]) @deep true linked

        ; operand_life_is_defaulted_construction#: a call or construction whose
        ; page the planner chose (Local / Unspecified life) -- not `^name`/`#`,
        ; and not a mere name or field read.
        function operand_life_is_defaulted_construction(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; function_returns_view#: does `f` declare a `Slice[...]` result?
        function function_returns_view(f: Function) @deep true returns bool linked

        procedure collect_flow_locals(mutable this: Planner, ops: Vector[Operand]) @deep true linked
        ; Unwrap a value-yielding branch statement to its value operands so
        ; collect_flow_locals# can descend a choose/if/match/block branch.
        procedure collect_flow_stmt(mutable this: Planner, s: Statement) @ret_nonlocal true @deep true linked

        ; deep-R2 store-escape helpers. A value stored via `recv.put(i, v)` /
        ; `recv.add(v)` into a Vector that outlives the frame (recv bound with a
        ; `^name`/`#` init, or already promoted to escape) must itself live on a
        ; non-local page. Bound-local values are collected here (the name-set
        ; then promotes their binding in plan_binding#); INLINE constructions in
        ; a put/add value position have no binding and are left `#` at the source
        ; (the de-sigil skips put/add inline args), so they stay caller-page.
        procedure add_escaping_target(mutable this: Planner, name: String) @ret_nonlocal true @deep true linked
        ; A binding initializer escapes the frame when its construction carries
        ; an explicit `^name` (Reference) or `#` (Call) lifetime. For a
        ; NON-generic type (`String^rp(…)`) the marker lands on the leading
        ; Type operand; for a GENERIC container (`Vector[T]^rp(…)`) the parser
        ; splits `Vector[T]^rp` into [Type(Vector), Matrix([T])^rp] and the
        ; lifetime rides the MATRIX operand's `life` (s107). Scan EVERY operand
        ; (top-level only — nested ctor args in a Tuple are not the binding's
        ; own placement) for either form.
        ; True when an operation sequence's head is a `Vector[...]` construction
        ; (`var V Vector[X](arr)`). Used by the address-taken escaping-target
        ; trigger so a de-sigiled holder is treated like the `^rp` it replaced.
        function op_seq_head_is_vector(this: Planner, ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
        function operand_seq_escaping_ctor(this: Planner, ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
        ; Extract the receiver name from a `(*X)` deref modeled as a parenthesized
        ; Tuple with one component whose value is the operand sequence
        ; [Type("*"), Type([X])]. Returns "" when the shape doesn't match. Used to
        ; recognise a pointer-param store `(*param).add(v)` whose receiver is a
        ; ref/pointer out-parameter (seeded into escaping_targets).
        function tuple_deref_receiver_name(this: Planner, tup: scalyc.compiler.Model.Tuple) @page true @direct true @ret_caller true @deep true returns String linked
        procedure collect_store_value_locals(mutable this: Planner, source: Vector[Operand]) @deep true linked

        ; Page inference, gap 1 — RECURSIVE pre-scan collecting bare `return x`
        ; names ANYWHERE in a function body (Block, if consequent/alternative,
        ; choose/match branches + alternative, and loop bodies), so a `return x`
        ; nested in any control flow is found, not just top-level returns.
        ; The walker is `#` and deep-copies each collected name onto rp via
        ; `String^rp` — load-bearing: the name comes from a Model Type.name
        ; Vector whose String `data` points into a transient page; storing it BY
        ; VALUE (`.add((*np))`) dangles and corrupts later reads. (There is NO
        ; "Model-union-by-value" codegen bug — the recursive walk over Model
        ; unions, even passing value-field consequents like iff.consequent by
        ; value, is fine.) Mirrors the proven plan_statement#/plan_if# Model
        ; recursion: union params pass by in-place pointer, `.unwrap()` collapses
        ; to a ref under NPO. The earlier "choose/match arm corrupts" was a
        ; SYMPTOM of a promotion bug, now fixed: collecting a nested return of an
        ; EXPLICITLY-`^page`-bound local (lexer's `return name`) made restamp_
        ; operand_life# override the explicit lifetime → wrong page → dangling
        ; token Strings. restamp now only promotes DEFAULTED-Local allocations.
        ; Phase-5 class 3: the get-alias back-prop for a WHILE-LET condition
        ; binding (`while let m it.next()`). The While condition is a Binding
        ; STRUCT, not a Binding statement, so the walker's Binding arm never
        ; sees it — the drain idiom's element alias `m` had no back-prop and
        ; the escape chain (m -> it -> container) broke at the loop head.
        ; Mirrors the Binding arm's escaping-alias essentials.
        procedure collect_returns_while_binding(mutable this: Planner, bind: Binding) @ret_nonlocal true @deep true linked

        procedure collect_returns_stmt(mutable this: Planner, s: Statement) @ret_nonlocal true @deep true linked
        procedure collect_returns_operand(mutable this: Planner, op: Operand) @ret_nonlocal true @deep true linked
        procedure collect_returns_action(mutable this: Planner, a: Action) @ret_nonlocal true @deep true linked

        ; ================================================================
        ; Address-taken pre-scan (page inference). A read-only Model walk
        ; that records, into address_taken_locals, every BARE local NAME
        ; that appears as the operand of a prefix `&` (`&NAME`) anywhere in
        ; the function body — including inside call-argument Tuples, Matrix
        ; rows, and nested control-flow. plan_binding# then promotes such a
        ; name's binding to the caller page (rp) when its initializer is a
        ; relocatable page-owning Vector construction: a `&V` reference into
        ; an escaping structure (a PlannedCall arg / PlannedItem field) must
        ; outlive the frame, exactly what an explicit `^rp` provided.
        ; Over-collection is harmless — the binding-site gate (Vector init +
        ; restamp owns-page-guts) only fires for the intended shape. Mirrors
        ; the recursion structure of operand_mentions_set#.
        ; ================================================================
        procedure add_address_taken(mutable this: Planner, name: String) @ret_nonlocal true @deep true linked
        procedure scan_addr_taken_ops(mutable this: Planner, ops: Vector[Operand]) @deep true linked
        procedure scan_addr_taken_action(mutable this: Planner, a: Action) @ret_nonlocal true @deep true linked
        procedure scan_addr_taken_stmt(mutable this: Planner, s: Statement) @ret_nonlocal true @deep true linked
        procedure scan_addr_taken_operand(mutable this: Planner, op: Operand) @deep true linked
        procedure scan_address_taken(mutable this: Planner, impl: Implementation) @ret_nonlocal true @deep true linked

        ; ================================================================
        ; Get-ref argument pre-scan (ref-flow provenance, 2026-07-02f).
        ; See the getref_arg_locals field comment. Mirrors the recursion
        ; structure of scan_addr_taken_* with an `in_args` mode: Tuple
        ; components (call/construction argument lists) and return/throw/
        ; break results are escape positions; conditions and plain statement
        ; sources are not. Over-collection is harmless — the plan_binding#
        ; gate (rp in scope + Vector init + restamp owns-page-guts) only
        ; fires for the intended holder shape, and promotion to the caller
        ; page is the page an escaping interior reference requires.
        ; ================================================================
        procedure add_getref_arg(mutable this: Planner, name: String) @ret_nonlocal true @deep true linked
        procedure add_getref_alias(mutable this: Planner, alias_name: String, recv: String) @ret_nonlocal true @deep true linked
        function getref_alias_receiver(this: Planner, n: String) @page true @direct true @ret_caller true @deep true returns String linked
        ; Form A/B `RECV.get`/`RECV.get_ptr` detection on a SINGLE operand
        ; (binding_get_receiver# checks ops[0] of a whole sequence; argument
        ; scanning needs the per-operand form). Returns RECV or "".
        function operand_get_receiver(this: Planner, op: Operand) @page true @direct true @ret_caller true @deep true returns String linked
        ; Bare single-segment local name (no generics, no member access) — the
        ; shape of an alias use in an argument list.
        function operand_bare_name(this: Planner, op: Operand) @page true @direct true @ret_caller true @deep true returns String linked
        procedure scan_getref_ops(mutable this: Planner, ops: Vector[Operand], in_args: bool) @deep true linked
        procedure scan_getref_action(mutable this: Planner, a: Action) @ret_nonlocal true @deep true linked
        procedure scan_getref_stmt(mutable this: Planner, s: Statement) @ret_nonlocal true @deep true linked
        procedure scan_getref_operand(mutable this: Planner, op: Operand, in_args: bool) @deep true linked
        procedure scan_getref_args(mutable this: Planner, impl: Implementation) @ret_nonlocal true @deep true linked

        ; Entry: pre-scan a whole function body for bare `return x` targets and
        ; (deep-R2) locals flowing into returned constructions. Re-run to a
        ; FIXPOINT: each pass the Binding arm propagates escape one level deeper
        ; through `let p Ctor(q, ...)` chains; iterate until the set stops
        ; growing. Bounded by the number of bindings (monotone, dedup-add).
        procedure scan_top_level_returns(mutable this: Planner, impl: Implementation) @ret_nonlocal true @deep true linked

        procedure plan_implementation(mutable this: Planner, mutable impl: Implementation) @page true @direct true @stores true @deep true returns PlannedImplementation io linked

        ; ================================================================
        ; plan_function: Model.Function → Plan.PlannedFunction.
        ;
        ; Opens a new scope, registers each parameter as a local, plans
        ; the return/throws types, and plans the implementation.
        ; Computes:
        ;   - mangled_name (Itanium ABI via mangle_function)
        ;   - can_throw (set iff throws_type is present)
        ;   - needs_local_page (scan body for Local-lifetime ops)
        ;   - has_page (page parameter present or implicit return alloc)
        ; `origin` (instantiation source) and `scheme` (post-solver
        ; type scheme) remain null for now.
        ; ================================================================
        ; report_declared_caller_page#: the caller's page is IMPLICIT and
        ; never an explicit parameter (2026-09-25). A first parameter named
        ; `rp`/`page` without a type used to be peeled into it; it is an
        ; untyped parameter now, and the one thing its author can have meant
        ; is the page -- say so at the declaration. A TYPED `page:
        ; pointer[Page]` is an ordinary explicit parameter.
        ; main is the C entry point, called by the runtime with (argc, argv):
        ; a caller page -- which a `#` or a built return gives any other
        ; routine -- took argc's register, and main died at its first
        ; allocation (SIGSEGV in scaly_force_frame, rc 139, not a word; the
        ; http arena's `String#(env_path)`, 2026-09-29).
        procedure report_entry_caller_page(mutable this: Planner, f: Function) @ret_nonlocal true @deep true linked

        ; A `function` writes nothing, so a `mutable` parameter on one is a
        ; contradiction -- for an extern it would be a contract the census never
        ; reads (only a `procedure ... extern` declares its writes,
        ; PointerCensus.extern_contract#). It compiled silently until 2026-09-29.
        procedure report_mutable_in_function(mutable this: Planner, f: Function) @deep true linked

        procedure report_declared_caller_page(mutable this: Planner, input: Vector[Item]) @deep true linked

        procedure plan_function(
            mutable this: Planner,
            mutable f: Function,
            parent: ref[PlannedType]?
        ) @page true @direct true @stores true @deep true @deep_this_6 true @deep_whole_6 true returns PlannedFunction io linked

        ; ================================================================
        ; WP8 — constructor completeness.
        ;
        ; A "simple" initializer body — one that consists only of field
        ; assignments (`set this.f: ...`), local bindings (let/var),
        ; control-exit statements (return/throw/break/continue) and
        ; nested Block/If/Choose — must assign every property that has no
        ; default. Any init doing something we can't fully account for
        ; (a bare helper call, a method call on this, a loop, match/try,
        ; or a computed/derefed assignment target) is treated as NOT
        ; checkable and skipped entirely — so the check is conservatively
        ; sound and never false-positives on the compiler's / stdlib's own
        ; initializers.
        ;
        ; These predicates walk the PLANNED body (planned_impl), whose
        ; source/target/statements are ref[Vector]? pointers that read
        ; reliably — the Model body's by-value Vector fields do not (see
        ; the WP8 deferral note). Two pure families: *_checkable decides
        ; whether the body is analyzable; *_assigns(field) decides whether
        ; a given property is assigned somewhere in the body.
        ; ================================================================
        function init_action_checkable(this: Planner, pa: PlannedAction) @ret_nonlocal true @deep true returns bool linked

        function init_stmt_checkable(this: Planner, stmt: PlannedStatement) @ret_nonlocal true @deep true returns bool linked

        function init_block_checkable(this: Planner, b: PlannedBlock) @ret_nonlocal true @deep true returns bool linked

        function init_if_checkable(this: Planner, f: PlannedIf) @ret_nonlocal true @deep true returns bool linked

        function init_choose_checkable(this: Planner, ch: PlannedChoose) @ret_nonlocal true @deep true returns bool linked

        function init_action_assigns(this: Planner, pa: PlannedAction, field: String) @ret_nonlocal true @deep true returns bool linked

        function init_stmt_assigns(this: Planner, stmt: PlannedStatement, field: String) @ret_nonlocal true @deep true returns bool linked

        function init_block_assigns(this: Planner, b: PlannedBlock, field: String) @ret_nonlocal true @deep true returns bool linked

        function init_if_assigns(this: Planner, f: PlannedIf, field: String) @ret_nonlocal true @deep true returns bool linked

        function init_choose_assigns(this: Planner, ch: PlannedChoose, field: String) @ret_nonlocal true @deep true returns bool linked

        ; plan_initializer: Model.Initializer → Plan.PlannedInitializer.
        ; An initializer is like a function without name / returns_ / throws_ /
        ; lifetime. Parameters open a new scope, implementation is planned,
        ; scope closed.
        ;
        ; s81: also synthesizes a PlannedFunction wrapper for the init
        ; body and records it in instantiated_functions so emit_function_decl
        ; / emit_function_body produce the C1 ctor body. The wrapper's
        ; LLVM signature is [this: parent, page (if init#), ...user_args]
        ; — page_parameter on the wrapper is left null to avoid the
        ; emit_function_decl page-prepend; the page slot is just a
        ; regular input item.
        procedure plan_initializer(
            mutable this: Planner,
            mutable ini: Initializer,
            parent: ref[PlannedType]?
        ) @page true @direct true @stores true @deep true @deep_this_6 true @deep_whole_4 true returns PlannedInitializer io linked

        ; plan_operator: Model.Operator → Plan.PlannedOperator.
        ; Structurally identical to plan_function modulo the two missing
        ; fields (no `pure`, no `lifetime`).
        procedure plan_operator(
            mutable this: Planner,
            mutable op: Operator,
            parent: ref[PlannedType]?
        ) @page true @direct true @stores true @deep true @deep_this_6 true returns PlannedOperator io linked

        ; plan_variant: Model.Variant → Plan.PlannedVariant.
        ; The tag is assigned by the caller (variants need sequential tags
        ; within the union; we can't see sibling variants from here).
        ; `mangled_name` is left empty for the same reason as
        ; plan_property.
        procedure plan_variant(mutable this: Planner, mutable v: Variant, tag: int) @page true @direct true @deep true @deep_this_2 true returns PlannedVariant io linked

        ; ================================================================
        ; plan_structure: Model.Structure → Plan.PlannedStructure.
        ;
        ; Plans every property, computes struct size/alignment (simple
        ; "size == alignment per primitive" model), then plans all
        ; members: methods (Function), operators, initializers, and the
        ; deinitializer. mangled_name is built via mangle_structure so
        ; method/operator mangling can reference the parent.
        ; ================================================================
        procedure plan_structure(mutable this: Planner, mutable s: Structure, name: String) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedStructure io linked

        ; plan_structure_layout#: register a Structure's layout (properties,
        ; offsets, size, alignment) into instantiated_structures WITHOUT
        ; planning its methods, operators, initializers, or deinitializer.
        ;
        ; Used by register_struct_layouts# to import cross-module struct
        ; layouts so map_type / emit_struct_type / emit_member_assignment
        ; have a real struct type available, even when the module's
        ; function bodies aren't planned in the current compilation unit.
        ; Skipping methods avoids the planner-side crashes (null this in
        ; check_function_match → String::get_buffer) that would otherwise
        ; happen when walking generic/cross-module method bodies.
        procedure plan_structure_layout(mutable this: Planner, mutable s: Structure, name: String) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedStructure io linked

        ; plan_structure_layout_opt#: as plan_structure_layout# but with a
        ; `plan_inits` switch. The on-demand cross-package path
        ; (ensure_member_layout#) passes false: it needs ONLY the field
        ; layout so map_type can emit the real struct type for member-access
        ; GEPs, NOT the constructor. Planning initializers there records a
        ; PlannedInitializer, which makes the Emitter emit the struct's
        ; `C1` body into THIS root's object — but a dependency type's
        ; constructor belongs to its OWN package's object (e.g. emitting
        ; Planner::C1 into scalyls.o mis-mangles its internal
        ; `ConceptIndex.create#` call to a bare `_Z6createm` and fails to
        ; link). With plan_inits=false the struct stays declare-only here
        ; and the real body is resolved cross-unit at link time.
        procedure plan_structure_layout_opt(mutable this: Planner, mutable s: Structure, name: String, plan_inits: bool) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedStructure io linked

        ; register_struct_layouts_in_module#: walk a module's tree and
        ; register layout-only PlannedStructures for every Concept whose
        ; definition is a Structure. Skips the Concept if its name is
        ; already in instantiated_structures (avoids duplicate entries
        ; when the same module is also walked by the full planner).
        procedure register_struct_layouts_in_module(mutable this: Planner, mutable m: Module) @page true @stores true @deep true io linked

        ; register_struct_layouts_in_concept#: if the concept's
        ; definition is a Structure, register its layout. If it's a
        ; Namespace, recurse into namespace members and modules.
        procedure register_struct_layouts_in_concept(mutable this: Planner, mutable c: Concept) @page true @stores true @deep true io linked

        ; ensure_member_layout#: on-demand layout for a CROSS-PACKAGE struct
        ; reached as a member-access base while planning a root that does NOT
        ; walk the defining package. register_struct_layouts_in_module# only
        ; imports the COMPILATION-ROOT package's structs; a dependency type
        ; (e.g. scalyc's ProgramSyntax referenced from scalyls'
        ; symbols.document_symbols#) is registered as a Concept but its
        ; PlannedStructure is never planned, so map_type falls back to the
        ; s114 { ptr } placeholder and emit_member_access_chain GEPs offset 0
        ; for every field — the throws-Success arm `program.file.declarations`
        ; reads garbage and the enclosing `if … <> null` is dropped, so the
        ; LSP feature returns []. Planning the layout here lands it in
        ; instantiated_structures → map_type's on-demand walk emits the real
        ; struct → the GEP chain is correct.
        ;
        ; Pinned to owning_page (the s188/d8c7216e transient-rp lesson): the
        ; PlannedStructure is persistent, so its name/mangled/property-type
        ; Strings must not live on resolve_member_access#'s transient page.
        ; ABI-opaque stdlib structs are excluded (is_runtime_opaque_struct) so
        ; the scaly/scalyc/main fixed point stays byte-identical. Generic
        ; concepts are left to instantiate_generic# (parameterless guard).
        procedure ensure_member_layout(mutable this: Planner, mutable name: String) @deep true io linked

        ; ensure_union_layout#: on-demand layout for a CROSS-PACKAGE union
        ; that is the scrutinee of a `choose` while planning a root that does
        ; not walk the union's defining package (e.g. scalyc's
        ; DeclarationSyntax matched in scalyls' decl_symbol#). Without it,
        ; map_type returns the s114 { ptr } placeholder, the choose extracts
        ; no payload, and a `when f: FunctionSyntax { f.target … }` arm GEPs
        ; the field off a NULL base. Registering the variant tags + payload
        ; sizing (methods skipped — see plan_union_opt#) makes map_type emit
        ; the real tagged union so the payload is extracted correctly.
        ;
        ; Same fixed-point safety as ensure_member_layout#: opaque stdlib
        ; types are excluded, generic concepts are left to instantiate_generic#,
        ; and pinning is to owning_page (persistent plan storage).
        procedure ensure_union_layout(mutable this: Planner, mutable name: String) @deep true io linked

        ; ensure_type_layout#: on-demand layout for a CROSS-PACKAGE struct OR
        ; union that crosses a call boundary BY VALUE (an sret return type or a
        ; by-value parameter) while planning a root that does not walk the
        ; defining package. ensure_member_layout# / ensure_union_layout# fire
        ; only on member-access hops / choose scrutinees; a type that is merely
        ; PASSED to or RETURNED from an extern dependency function (e.g.
        ; scalyls' json.get / json.as_i64 with JsonValue, a scalyc union) never
        ; reaches either, so map_type falls back to the s114 { ptr } placeholder
        ; — the caller sizes the sret/arg slot at 8 bytes while the callee
        ; (in the dependency's object) writes the real (larger) struct, smashing
        ; the stack. Ensuring both kinds here makes map_type emit the real type
        ; so the by-value ABI matches across the package boundary. Dispatch is by
        ; trying both helpers; each is a guarded no-op when the named concept is
        ; not its kind / already instantiated / opaque / generic. Fixed-point-
        ; safe for the same reason as the two underlying helpers: scaly/scalyc/
        ; main pass no unplanned cross-package types by value (every in-package
        ; type is already registered → no-op).
        procedure ensure_type_layout(mutable this: Planner, mutable t: PlannedType) @ret_nonlocal true @deep true io linked

        ; ensure_field_layouts: lay out the type of every by-value field of an
        ; instantiated generic structure (see instantiate_generic#). A pointer,
        ; ref, primitive or generic field type is a guarded no-op in
        ; ensure_layout_by_name#.
        procedure ensure_field_layouts(mutable this: Planner, mutable pl: PlannedStructure) @deep true io linked

        ; By-name twin of ensure_type_layout#: lay out whichever kind (struct
        ; or union) the named concept is. Each underlying helper is a guarded
        ; no-op when the concept is not its kind / already instantiated / opaque
        ; / generic / unknown (primitives, pointer, ref). Both helpers RECURSE
        ; into the type's by-value constituents (see their bodies), so this also
        ; lays out the whole by-value subgraph reachable from `name`.
        procedure ensure_layout_by_name(mutable this: Planner, mutable name: String) @deep true io linked

        ; plan_untyped_global: a module `mutable`/`shared` whose annotation names
        ; no type — the Modeler hands it on with an EMPTY type instead of dropping
        ; it. `mutable bad 9` (no colon), `mutable buf u8[64]` (the local array
        ; form) and `mutable pair: (x: int) 0` all vanished at rc 0, and the first
        ; USE failed as `unknown assignment target` at the use's own line. It is
        ; reported at the declaration and recorded as an int, so the uses stay
        ; quiet.
        procedure plan_untyped_global(mutable this: Planner, g: Global, name: String) @page true @direct true @ret_caller true @deep true returns PlannedGlobal linked

        ; plan_global: Model.Global → Plan.PlannedGlobal.
        ; The `name` comes from the enclosing Concept — Global itself has
        ; no name field.
        procedure plan_global(mutable this: Planner, mutable g: Global, name: String) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedGlobal io linked

        ; plan_namespace: Model.Namespace → Plan.PlannedNamespace.
        ; Dispatches each Member to the appropriate plan_* method and
        ; collects the results into the per-kind vectors the planned
        ; representation expects.
        ;
        ; Pushes the namespace onto the current-namespace context so
        ; nested plan_function / plan_operator calls pick up the
        ; namespace as their mangling parent (Itanium
        ; `_ZN<NSName><FnName>E…`) and so is_namespace_sibling_function
        ; can resolve unqualified intra-namespace calls. The old
        ; context is restored before returning, giving nested
        ; namespaces correct save/restore semantics.
        ; record_free_operator: a free operator (top-level OR namespace-level)
        ; with an Action body is planned here rather than reached by call-site
        ; member resolution, and the call site (resolve_operator_call#) emits a
        ; reference to its OPERATOR-mangled name (planned with a null parent),
        ; so its body must be emitted under that same name. emit() walks
        ; instantiated_functions only, so record it as a PlannedFunction.
        ; Extern/Intrinsic/Instruction operators have no Scaly body to emit.
        ; Operators are registered GLOBALLY by name (register_operator ignores
        ; the namespace path) and the call site mangles without a namespace, so
        ; a namespace operator behaves as a free operator — hence plan it with a
        ; null parent and record it exactly like the top-level case.
        procedure record_free_operator(mutable this: Planner, o: Operator, po: PlannedOperator) @ret_nonlocal true @deep true @deep_this_4 true linked

        procedure plan_namespace(mutable this: Planner, mutable ns: Namespace, name: String) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true @deep_whole_2 true returns PlannedNamespace io linked

        ; plan_namespace_module_one#: walk EVERY sub-module of the
        ; namespace being compiled (the former hand-maintained name
        ; allowlist is GONE — commit 0c4791f4). Only the COMPILATION
        ; ROOT package's namespace modules reach here (loaded dependency
        ; packages are registered but never walked), so this emits
        ; exactly the current package's bodies.
        ;
        ; A bare `plan_module(sub)` call (no `equals("X") = false`
        ; negation) avoids the stage-0 codegen SEGV that originally
        ; motivated the positive-enumeration allowlist.
        procedure plan_namespace_module_one(mutable this: Planner, mutable sub: Module) @page true @stores true @ret_nonlocal true @deep true io linked

        ; Helper for plan_namespace#: walk ns.modules and route each
        ; through plan_namespace_module_one# (which walks the module's
        ; bodies). Side effect only — plan_module# returns
        ; a struct-by-value PlannedModule that's intentionally
        ; discarded inside the inner helper. Mixing that struct
        ; return into plan_namespace#'s own struct construction
        ; corrupts the frame on stage-0 codegen (session-43 pattern);
        ; the helper isolates the call.
        procedure plan_namespace_modules(mutable this: Planner, mutable ns: Namespace) @page true @stores true @deep true io linked

        ; has_this_method: true when `this` is in scope and its struct/
        ; union type declares a method named `name`. Detects unqualified
        ; implicit-this sibling METHOD calls in BINDING position
        ; (`let p get x` inside a method) so s135 doesn't mis-peel the
        ; method name as a type. A FIELD named `name` is not a method, so
        ; this stays false for casts like `data as pointer[u8]`.
        procedure has_this_method(mutable this: Planner, name: String) @ret_caller true @deep true returns bool linked

        ; is_namespace_sibling_function: true iff `name` refers to a
        ; Function defined directly in the currently-active
        ; namespace's members list. Used to decide whether an
        ; unqualified call inside a namespace body should route to
        ; the namespace-scoped peer or fall back to the global
        ; registry. Returns false whenever no namespace is active.
        function is_namespace_sibling_function(this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; register_concept_recursive: register `c` and, if its Definition
        ; is a Namespace, recurse into the namespace's members so inner
        ; Concepts / Functions / Operators are all visible by
        ; unqualified name during later planning.
        procedure register_concept_recursive(mutable this: Planner, c: Concept) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

        ; register_module_concepts: walk a Model.Module's members and
        ; register every Concept, Function and Operator in the relevant
        ; registry. Done as a first pass so forward references work
        ; (A referencing B below, or main() calling helper() declared
        ; later in the file). Recurses into sub-modules and into
        ; namespace-shaped concepts so deeply nested definitions are
        ; reachable by their short name.
        procedure register_module_concepts(mutable this: Planner, m: Module) @deep true linked

        ; plan_module: Model.Module → Plan.PlannedModule.
        ;
        ; Two-pass: first register every concept reachable through this
        ; module's tree, then plan sub-modules and members. This makes
        ; forward references resolve — `struct A { b: B }` works even
        ; when B is defined later in the same module.
        procedure plan_module(mutable this: Planner, mutable m: Module) @page true @direct true @stores true @ret_caller true @deep true returns PlannedModule io linked

        ; plan_concept: wrap a Model.Concept (definition + generics) into
        ; PlannedConcept. Generic parameters are not instantiated here —
        ; that's the job of the separate instantiate-generic pass (TODO).
        ; For now we just drop the parameters on the floor and plan the
        ; underlying definition as-is.
        ;
        ; Intrinsic concepts (built-in types) are represented by a Type
        ; variant carrying a void placeholder until a proper Intrinsic
        ; variant is added to PlannedDefinition.
        ; concept_origin_file: the source file the concept of this NAME was
        ; registered from, or null when the origin is unknown. Read the same way
        ; lookup_concept reads the concept itself -- the O(1) hashed index, whose
        ; LAST-wins semantics must match, since a name registered twice (the s95
        ; Namespace+Structure pair) has to answer with the same entry's file.
        ; `concept_origin_files` runs in LOCKSTEP with `concepts`.
        ;
        ; The nullable return is `ref[T]?`, and it is FREE HERE: an NPO return
        ; asks `body_may_allocate`, and this body allocates nothing, so the
        ; mangled name does not move. The old blanket rule ("a nullable RETURN
        ; is a `pointer`, never `ref[T]?`") held only for a body that
        ; constructs -- `enter_concept_generic_scope` is the sibling that pays
        ; the page for the same spelling.
        function concept_origin_file(this: Planner, name: String) @ret_param_0 true @deep true returns ref[String]? linked

        procedure plan_concept(mutable this: Planner, mutable c: Concept) @page true @direct true @stores true @deep true returns PlannedConcept io linked

        ; s148: byte size of a type referenced by name (variant payload
        ; or struct property). Knows about primitives, stdlib container
        ; shapes (Vector/Array = 16, String/HashMap/HashSet = 8), and
        ; walks registered Concept Structures' property lists when
        ; the name is a struct. Default 8 (matches the catch-all in
        ; get_primitive_alignment for unknown names).
        procedure compute_payload_size(mutable this: Planner, name: String) @ret_nonlocal true @deep true returns size_t linked

        ; plan_union: Model.Union → Plan.PlannedUnion.
        ; Similar scope to plan_structure: plans variants and computes
        ; size/alignment; skips methods/operators for now.
        procedure plan_union(mutable this: Planner, mutable u: scalyc.compiler.Model.Union, name: String) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns scalyc.compiler.Plan.PlannedUnion io linked

        ; plan_union_opt#: as plan_union# with a `plan_methods` switch. The
        ; on-demand cross-package path (ensure_union_layout#) passes false:
        ; it needs the variant tags + payload sizing so map_type emits the
        ; real tagged-union type (and choose extracts the payload at the
        ; right offset), but NOT the union's methods/operators — those
        ; belong to the union's own package's object (same reasoning as
        ; plan_structure_layout_opt#).
        procedure plan_union_opt(mutable this: Planner, mutable u: scalyc.compiler.Model.Union, name: String, plan_methods: bool) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns scalyc.compiler.Plan.PlannedUnion io linked

        ; plan_program: top-level entry point.
        ;
        ; Walks the Model.Program:
        ;   - plan the main Module (recursively plans sub-modules and
        ;     members)
        ;   - plan top-level statements (executed before main())
        ;
        ; Instantiation caches (structures / unions / functions / globals)
        ; are left null — the per-kind planned data lives inside the
        ; PlannedModule tree for now. The separate caches come online
        ; once the instantiate-generic pass is ported.
        ; SCALYC_PHASE_TIMES=1: one stderr line per compile phase, `phase <name>
        ; <monotonic ns>` -- plan_program#'s steps, the first plan_module#'s
        ; page fixpoints, cli.run's purity gate and emission. The differences
        ; are the phase times (2026-09-26: planning bodies is ~40 % of a
        ; compile in every package, which is what a parallel planner could
        ; win at most; ROADMAP 4.8). Off, it costs one getenv per mark.
        procedure phase_mark(this: Planner, phase_name: pointer[const_char]) @deep true io linked

        procedure plan_program(mutable this: Planner, mutable prog: Program) @page true @direct true @stores true @ret_caller true @deep true returns ref[Plan]? io linked

        ; Collect every Function member of a concept (struct/union) into acc.
        ; Mirrors collect_methods_in# but takes no name filter.
        procedure rr_own_namespace_functions(mutable this: Planner, members: Vector[Member], all: ref[Array[Function]], mutable owners: ref[Array[String]], cname: String) @deep true linked

        procedure gather_member_functions(this: Planner, members: Vector[Member], mutable acc: ref[Array[Function]]) @deep true linked

        ; ---- R8, the storage hand-over rule (2026-09-25) ---------------------
        ; A routine that puts a value it BUILDS into its receiver's state
        ; (`names.add(String(t))`, `set this.f: T(...)`) builds it on the page it
        ; is given -- the putadd / set promotions move such a value to the
        ; caller page -- so it needs one: without, the value lands on its own
        ; frame and the receiver keeps a dangling copy (rc 0, measured on the
        ; tree before this: 753 read back for 15). And a routine that hands
        ; its receiver, a field of it or a parameter to such a routine hands on
        ; the page the value will live on, so it needs one as well. Until
        ; 2026-09-25 hand-declared `rp` parameters threaded that page down;
        ; the caller page is implicit now, and this rule is what declared it.
        ; Keyed by IDENTITY (name@start, store_key#): keyed by name, one tscaly
        ; `add` put every `add`/`get`/`at` of the tree into the set, the
        ; generic containers of the stdlib included -- 5 145 signatures moved
        ; in tscaly alone. The call a rule propagates through is RESOLVED
        ; (store_callee_mask#), per POSITION: a routine stores into its receiver
        ; (bit 0) or its k-th parameter (bit k), and a caller joins only where it
        ; hands its own state to such a position. What it cannot resolve the planner's net
        ; reports (report_lost_store_page#).
        procedure build_store_page_set(mutable this: Planner, all: Array[Function], owners: Array[String]) @deep true io linked

        ; store_name_index#: every routine R8 found storing, by name
        procedure index_store_names(mutable this: Planner) @deep true linked

        ; does a call of `fn_name` (its last dotted segment) reach a routine that
        ; keeps values built on its page in its receiver's or a parameter's
        ; state (R8)? By name: a routine of that name anywhere -- a page too
        ; many rather than one too few
        procedure callee_stores(this: Planner, fn_name: String) @ret_param_0 true @deep true returns bool linked

        procedure store_mask_of(mutable this: Planner, key: String) @ret_param_0 true @deep true returns u64 linked

        procedure set_store_mask(mutable this: Planner, key: String, mask: u64) @persists true @deep true linked

        ; the positions this body stores a page value into (store_page_masks)
        procedure function_store_mask(mutable this: Planner, mutable f: Function, owner: ref[String]?) @ret_param_0 true @deep true returns u64 io linked

        procedure hand_action(mutable this: Planner, mutable f: Function, owner: ref[String]?, a: Action, fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns bool io linked

        procedure hand_statement(mutable this: Planner, mutable f: Function, owner: ref[String]?, s: Statement, fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true @deep_this_8 true @deep_whole_8 true returns bool io linked

        procedure hand_statements(mutable this: Planner, mutable f: Function, owner: ref[String]?, stmts: Vector[Statement], fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns bool io linked

        ; one operand sequence: a put/add of a built value on the receiver's
        ; state, or a call of a routine in the set on state that outlives the
        ; frame; then everything nested inside it
        procedure hand_ops(mutable this: Planner, mutable f: Function, owner: ref[String]?, ops: Vector[Operand], fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns bool io linked

        procedure hand_operand(mutable this: Planner, mutable f: Function, owner: ref[String]?, op: Operand, fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns bool io linked

        ; does this operand sequence BUILD a value that lives on the page it is
        ; built on? A construction of a concept through an `init` of that arity
        ; (String(t) copies), a positional construction with such a part, a
        ; block (an interpolated string) -- a string LITERAL is a static
        ; constant (`@.sconst`) and builds nothing. NOT a positional
        ; view like `Vector[char](n, p)` -- it allocates nothing, and
        ; StringBuilder.append hands exactly that to Array.add, which copies the
        ; elements; nor a plain read (`set current: node.next`).
        procedure ops_build_page_value(mutable this: Planner, ops: Vector[Operand], depth: size_t) @ret_nonlocal true @deep true returns bool linked

        function model_operand_is_tuple(op: Operand) @ret_nonlocal true @deep true returns bool linked

        ; stored_value_builds#: does a value a put/add or a `set` stores carry
        ; something this routine BUILT on its own page -- the page R8 must hand
        ; it from its caller? A construction (ops_build_page_value#), a call
        ; whose callee builds its result on the caller page (R7's question about
        ; a returned call, ret_page_call_head#), a local bound to or set with one
        ; of those, or a positional construction with such a part. Until
        ; 2026-09-28 only the construction counted: `names.add(sb.to_string())`
        ; or `let made Fact(...)` + `facts.add(made)` seeded nothing, a caller
        ; that merely forwards `names` got no page, and the String lived on a
        ; frame released at that caller's return -- rc 0, read back as garbage
        ; (tests/regress/store_forwarded_built_value.scaly).
        procedure stored_value_builds(mutable this: Planner, mutable f: Function, owner: ref[String]?, ops: Vector[Operand], depth: size_t) @ret_nonlocal true @deep true returns bool linked

        ; call_result_builds#: does a call's RESULT carry something built on
        ; this routine's page? Its callee returns a non-reference VALUE (R1: the
        ; value's parts are on the caller page -- `sb.to_string()`), residence
        ; says the result is the caller page's (class 1), or it hands back an
        ; argument (class 3/5) that is built here. A reference whose residence
        ; is unknown (class 0) is NOT counted: R7's page for it is a
        ; conservative guess, and counting it made every cache setter of the
        ; tscaly checker a seed. Unresolved callee: residence's name bucket.
        procedure call_result_builds(mutable this: Planner, mutable f: Function, owner: ref[String]?, head: Operand, args: Operand, argc: size_t, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        ; the members of `c` named `method` with that arity: 1 one of them
        ; builds its result here, 0 none does, -1 there is no such member
        procedure concept_result_builds(mutable this: Planner, mutable f: Function, owner: ref[String]?, c: Concept, method: String, args: Operand, argc: size_t, depth: size_t) @ret_nonlocal true @deep true returns int linked

        ; a callee's result is built here when it is a VALUE (not a pointer,
        ; a reference or a scalar -- a stored handle is not a stored part) and
        ; residence places it on the caller page (1) or hands back an argument
        ; that is built here (3, 5). An unknown class (0) is not counted.
        procedure function_result_builds(mutable this: Planner, mutable f: Function, owner: ref[String]?, cf: Function, args: Operand, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        ; does `cf` return a non-scalar VALUE -- through a type alias, as
        ; function_needs_caller_page# asks (`LLVMValueRef` names a pointer)?
        function returns_value_with_parts(this: Planner, cf: Function) @ret_nonlocal true @deep true returns bool linked

        ; one of a call's arguments built (stored_value_builds#)
        procedure args_build(mutable this: Planner, mutable f: Function, owner: ref[String]?, args: Operand, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        ; a local of the walked routine: a binding or a `set` the walk has
        ; passed gives it a built value
        procedure local_stores_build(mutable this: Planner, mutable f: Function, owner: ref[String]?, name: String, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        ; a put/add's arguments: one of them built (stored_value_builds#)
        procedure tuple_stores_build(mutable this: Planner, mutable f: Function, owner: ref[String]?, op: Operand) @ret_nonlocal true @deep true returns bool linked

        procedure seq_hands_page(mutable this: Planner, mutable f: Function, owner: ref[String]?, ops: Vector[Operand], fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns bool linked

        ; the function a call head resolves to is in the store set: a member of
        ; the receiver's concept (resolved from the owner, as R7 does), a
        ; sibling for a lone name, else a free function of that name
        procedure store_callee_mask(mutable this: Planner, mutable f: Function, owner: ref[String]?, head: Operand, argc: size_t) @ret_nonlocal true @deep true returns u64 linked

        ; is `key` (`name@start`, store_key#) a key of a routine named `name`?
        function store_key_names(key: String, name: String) @ret_caller true @deep true returns bool linked

        ; does `c` declare a routine named `method`?
        function concept_has_member(this: Planner, c: Concept, method: String) @ret_nonlocal true @deep true returns bool linked

        procedure members_store_mask(mutable this: Planner, c: Concept, method: String, argc: size_t) @ret_nonlocal true @deep true returns u64 linked

        procedure member_list_store_mask(mutable this: Planner, members: Vector[Member], method: String, argc: size_t) @ret_nonlocal true @deep true returns u64 linked

        ; build_transitive_page_set: compute, by a fixpoint over the call graph,
        ; the set of functions that need the caller's page ONLY because they
        ; forward rp to a sibling that needs one. SEED = void functions that
        ; directly build a ^rp value (the persistent storers add_escaping_* and
        ; the collect_*/promote_* leaves). PROPAGATE = any function whose own
        ; page-need is NOT already implied by its return type / ref-param
        ; storage / own ^rp, but whose body CALLS a function already in the set,
        ; needs one too (it threads rp down). The direct-checks gate keeps the
        ; already-page-bearing planning spine out of the set, bounding it to the
        ; void dispatcher cluster. NEUTRAL on the sigiled source: every function
        ; added is still `#` there (it forwards rp today), so has_page is
        ; unchanged; the set only matters once the explicit `#`/rp is removed.
        procedure build_transitive_page_set(mutable this: Planner) @ret_nonlocal true @deep true io linked
    }

    ; ========================================================================
    ; Itanium ABI name encoding helpers.
    ; These are the smallest independent units of Planner.cpp; worth
    ; porting in full so Planner.test() can exercise them end-to-end.
    ; ========================================================================

    ; encode_name: "foo" -> "3foo" (length prefix + raw name)
    function encode_name(name: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; strip_package_prefix: "scaly.containers.String" -> "String".
    ; Matches stripPackagePrefix in Planner.cpp: only strips when the full
    ; name begins with "scaly.". Anything else (e.g. "scalyc.compiler.Foo")
    ; is returned unchanged so user types keep their qualified identity.
    function strip_package_prefix(name: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; encode_type: Itanium ABI type code.
    ;
    ; Recurses for pointer[T], ref[T] and generic instantiations. The
    ; optimized "use pre-computed mangled_name" shortcut from the C++
    ; implementation is deliberately omitted here — every PlannedType we
    ; construct from scratch will end up with an empty mangled_name, and
    ; the shortcut only saves work in a later pass we do not implement yet.
    function encode_type(type_value: PlannedType) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_type: "_Z" + encode_type(T). The "_Z" prefix marks this as a
    ; (fake) C++-compatible Itanium symbol so external tools like c++filt
    ; can demangle our names for humans.
    function mangle_type(type_value: PlannedType) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_structure: "_Z" + name-with-length-prefix + optional "I...E" generic block.
    ; Used for symbol-mangling concrete struct / union / trait definitions.
    function mangle_structure(name: String, generic_args: ref[Vector[PlannedType]]?) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_function: Itanium symbol for a function / method.
    ;
    ;   free function   -> _Z + encode_name + params
    ;   method          -> _Z + "N" + encode_type(parent) + encode_name + "E" + params
    ;
    ; A 'this' parameter (implicit receiver) is skipped in the mangled
    ; name — Itanium treats it as implicit. If has_page_param is set the
    ; implicit page parameter (`pointer[Page]`) is encoded first; this is
    ; how "function foo#" lowers on the ABI side.
    function mangle_function(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?,
        has_page_param: bool
    ) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_free_function_from_types: build a free-function Itanium
    ; symbol directly from PlannedTypes, skipping the PlannedItem
    ; ceremony mangle_function requires. Shape matches mangle_function
    ; with parent=null.
    function mangle_free_function_from_types(
        name: String,
        params: Vector[PlannedType],
        has_page_param: bool
    ) @page true @direct true @ret_caller true @deep true returns String linked

    ; operator_code: map a Scaly operator name to its Itanium ABI two-letter
    ; code. Unknown operators fall back to the `v0` vendor extension,
    ; followed by the length-prefixed operator identifier.
    function operator_code(name: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_operator: Itanium ABI symbol for an operator definition.
    ; Mirrors mangle_function but substitutes the two-letter op code for
    ; the operator name and skips an explicit 'this' parameter when the
    ; operator is declared as a member.
    function mangle_operator(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?
    ) @page true @direct true @ret_caller true @deep true returns String linked

    ; mangle_operator_paged: mangle_operator plus the implicit caller-page
    ; parameter slot (PN4scaly6memory4PageE inserted before the explicit
    ; params, mirroring mangle_function's has_page placement). Used by
    ; plan_operator / find_subscript_operator for operators that fall under
    ; the implicit-return-page rule (e.g. `operator [] returns ref[T]?`,
    ; the same rule that gives Vector.get its page slot).
    function mangle_operator_paged(
        name: String,
        params: ref[Vector[PlannedItem]]?,
        parent: ref[PlannedType]?,
        has_page: bool
    ) @page true @direct true @ret_caller true @deep true returns String linked

    ; ========================================================================
    ; Type utilities.
    ; Used by the expression/statement planner for type checks and readable
    ; diagnostics. Ported from the "Type Utilities" section of Planner.cpp.
    ; ========================================================================

    ; get_readable_name: human-facing representation, e.g. "Vector[int]".
    function get_readable_name(type_value: PlannedType) @page true @direct true @ret_caller true @deep true returns String linked

    ; normalize_type_name: canonicalise builtin aliases.
    ; "scaly.*" packages collapse to their last component so "scaly.containers.String"
    ; compares equal to "String", matching Planner.cpp's normalizeTypeName. Integer
    ; aliases fold onto their sized form so int/size_t/char compare structurally.
    function normalize_type_name(name: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; is_integer_type: is a normalized type name one of the integer family?
    ; Called post-normalization so both "int" and "i64" answer true.
    ; wider_integer_operand_type: the result type of an integer ARITHMETIC or
    ; BITWISE operator is the WIDER operand's, as the emitter computes it
    ; (emit_intrinsic_binary_op# widens the narrower side). It was the LEFT
    ; operand's alone, so `set n.flags: n.flags | context_flags` with a u32 field
    ; and an int context planned as u32 while the emitter produced an i64 and
    ; stored EIGHT bytes into the four-byte field — overwriting the next one,
    ; unseen by the narrowing gate because the planner believed nothing narrowed
    ; (2026-09-17). A SHIFT keeps its left operand's type: its width comes from
    ; the value shifted, never from the count. `current` is what the caller
    ; already chose (the left type for the operators that pass through).
    function wider_integer_operand_type(op_name: String, current: PlannedType, rhs_type: PlannedType) @page true @direct true @ret_args_6 true @deep true returns PlannedType linked

    ; Unsigned among the normalized integer names (char is unsigned here, as
    ; the emitter's is_signed_type# has it).
    function integer_name_is_unsigned(normalized: String) @ret_nonlocal true @deep true returns bool linked

    ; The width of a normalized integer type name, in bits (64 for the
    ; pointer-sized and default names).
    function integer_type_bits(normalized: String) @ret_nonlocal true @deep true returns int linked

    function is_integer_type(normalized: String) @ret_nonlocal true @deep true returns bool linked

    ; is_char_like_cross_compatible: decide whether two pointer-inner types
    ; can freely substitute for each other. Mirrors the unwieldy pointer
    ; rules in Planner.cpp's typesCompatible exactly — in particular the
    ; one-way (param=const_char, arg=char) rule; the reverse is rejected
    ; because you must not silently assign immutable data to mutable storage.
    function is_char_like_cross_compatible(param_inner: String, arg_inner: String) @ret_nonlocal true @deep true returns bool linked

    ; A construction PLACED ON A PAGE (`T^page(…)`, `T#(…)`) is a pointer at
    ; runtime, but its planned type is the VALUE type T carrying the lifetime
    ; that placed it — and a local bound to such a construction inherits that
    ; type. Handing it to a parameter declared `pointer[T]` is therefore a
    ; representational match, not a mismatch.
    ;
    ; Without this rule find_initializer# missed on exactly that shape and the
    ; construction fell through to the positional-tuple path meant for data
    ; classes WITHOUT an init — silently, with two failure modes measured
    ; 2026-08-02 on dazzle's SelectGen: the init body never ran, so a field
    ; with no argument of its own kept stack garbage; and at matching arity an
    ; init whose parameters are declared in a different ORDER than the fields
    ; wrote them into the wrong fields. Regression: tests/regress/
    ; init_page_hosted_arg.scaly.
    ;
    ; Deliberately narrow: only Reference/Call lifetimes (an explicit `^`/`#`
    ; placement) qualify. Unspecified-life constructions may or may not be
    ; page-resident — that is decided later by concept_needs_this_residency —
    ; so they keep falling through rather than risk matching a stack value to
    ; a pointer parameter.
    function region_value_matches_pointer(param_type: PlannedType, arg_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

    ; types_equal: structural equality after alias normalisation.
    ; Recurses pairwise through the generics list; mismatched arities
    ; are unequal. Null/empty generics are treated uniformly as arity 0.
    function types_equal(a: PlannedType, b: PlannedType) @ret_nonlocal true @deep true returns bool linked

    ; types_compatible: decide whether an argument of ArgType can be passed
    ; to a parameter of ParamType without an explicit cast. Order of rules
    ; matches Planner.cpp — earlier rules short-circuit, later rules remain
    ; authoritative for their specific cases (pointer-to-void, Option-null).
    function types_compatible(param_type: PlannedType, arg_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

    ; ========================================================================
    ; Struct-layout arithmetic.
    ; ========================================================================

    ; is_this_wrapper_name: `this` arrives WRAPPED, and both wrappers mean
    ; the same thing here -- `pointer[T]` and `ref[T]` alike name a borrowed
    ; receiver whose pointee is T, and s96 lets either flow into the other.
    ; The three implicit-this fallbacks (sibling method dispatch, implicit
    ; property access, the multi-segment chain) unwrap it to find T's members;
    ; asking only for "pointer" made a `this: ref[T]` method read its own
    ; fields as 0 with rc 0 and no diagnostic.
    function is_this_wrapper_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; is_primitive_type_name: matches the set the C++ Planner treats as not
    ; requiring an implicit return-page parameter. Used both for layout
    ; decisions and for the needs_implicit_return_page check.
    ; True for a value scalar whose iterator `next()` returns a genuine
    ; ADDRESS into the collection (Vector.get_ptr / &field on a non-pointer
    ; field) — i.e. the loop var must LOAD the value. Deliberately EXCLUDES
    ; "pointer"/"ref": for a pointer-typed element, `&field` returns the
    ; pointer VALUE directly (s191), so a load would double-deref (crashes
    ; PageList's page-release loop). Also excludes "void".
    ; planned_type_is_npo_reference: an `Option` whose sole generic argument is a
    ; `ref` or a `pointer`, i.e. the NPO spelling `ref[T]?` / `pointer[T]?`.
    ; The sibling planned_type_is_npo_ref# asks the narrower question (ref only)
    ; because IT gates the arithmetic diagnostic, where a pointer is legal.
    ; Here both belong: the question is whether the loop element is a
    ; POINTER-SHAPED value, and both spellings are.
    function planned_type_is_npo_reference(t: PlannedType) @deep true returns bool linked

    function is_scalar_value_type_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; ---- SIMD vector types (ROADMAP-simd.md) ------------------------------
    ; Built-in VALUE types named by element and lane count, lowered to LLVM
    ; vectors. A name is all the compiler needs: no grammar, no concept.

    function simd_lanes(name: String) @ret_nonlocal true @deep true returns size_t linked

    function is_simd_type_name(name: String) @ret_nonlocal true @deep true returns bool linked

    function is_simd_mask_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; the scalar type of one lane (a mask's lane is a bool)
    function simd_element_name(name: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; bytes of one value; a mask packs its lanes into bits
    function simd_size(name: String) @ret_nonlocal true @deep true returns size_t linked

    function simd_type(name: String) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function simd_mask_type(lanes: size_t) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function simd_result_type(name: String) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function simd_element_type(name: String) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; The result type NAME of method `m` on a value of vector type `t`
    ; ("" when `t` has no such method; "elem" is the lane type, "void" none).
    function simd_method_result(t: String, m: String) @page true @direct true @deep true returns String linked

    ; the lane type written as a container's element type: `f64` and
    ; `double` are one type, as are `f32`/`float` and `i64`/`int`
    function simd_lane_name_matches(lane: String, written: String) @ret_param_1 true @deep true returns bool linked

    ; The element type NAME a `load`/`store` container holds, "" if the type is
    ; not a Slice, Vector or Array (through a `ref`, `pointer` or Option).
    function simd_container_element(t: PlannedType) @page true @direct true @ret_param_0 true @deep true returns String linked

    ; The pointee type NAME of `pointer[T]` / `ref[T]`, "" otherwise.
    function simd_pointee_name(t: PlannedType) @page true @direct true @ret_param_0 true @deep true returns String linked

    ; The result type of a static `T.m(...)` on vector type `t`, "" if none.
    function simd_static_result(t: String, m: String) @page true @direct true @deep true returns String linked

    function is_primitive_type_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; get_primitive_alignment: bytes of alignment required by a primitive.
    ; Mirrors the simplified model in Planner.cpp's computeStructLayout —
    ; size is always equal to alignment here (no padding for subword
    ; fields), which is good enough for Phase-2 layout decisions. Unknown
    ; or non-primitive types default to 8-byte alignment.
    function get_primitive_alignment(type_name: String) @ret_nonlocal true @deep true returns size_t linked

    ; align_offset: round `offset` up to the next multiple of `align`.
    ; `align` must be a power of two (standard struct-layout precondition).
    function align_offset(offset: size_t, align: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; compute_struct_alignment: the maximum alignment demanded by any
    ; property in `props`, with a floor of 1 (empty struct).
    function compute_struct_alignment(props: ref[Vector[PlannedProperty]]?) @ret_nonlocal true @deep true returns size_t linked

    ; compute_struct_size: total byte size needed for a struct with these
    ; properties, assuming size == alignment per field (the simplified
    ; model from Planner.cpp). The final size is rounded up to the
    ; struct's own alignment.
    function compute_struct_size(props: ref[Vector[PlannedProperty]]?) @ret_nonlocal true @deep true returns size_t linked

    ; compute_property_offsets: per-property byte offsets in struct order.
    ; Split out as a separate pass (rather than mutating PlannedProperty in
    ; place) because Scaly's Vector stores by value and we don't yet have
    ; a clean mutation pattern for nested struct fields.
    function compute_property_offsets(props: ref[Vector[PlannedProperty]]?) @page true @direct true @ret_caller true @deep true returns Vector[size_t] linked

    ; compute_union_size: max-variant-size plus a 1-byte (or 4-byte for
    ; very large unions) tag, aligned to the widest variant's alignment.
    ; Ignores variants with no payload type; a tag-only variant contributes
    ; nothing to the size calculation beyond the tag itself.
    function compute_union_size(variants: ref[Vector[PlannedVariant]]?) @ret_nonlocal true @deep true returns size_t linked

    ; compute_union_alignment: max alignment across all variant payload
    ; types; tag-only variants contribute the 1-byte tag alignment.
    function compute_union_alignment(variants: ref[Vector[PlannedVariant]]?) @ret_nonlocal true @deep true returns size_t linked

    ; ========================================================================
    ; Constraint-solver helpers.
    ; The main Hindley-Milner machinery (unify, solveConstraints,
    ; freshTypeVar) touches Plan-global state, but the "occurs check"
    ; and compatible-integer predicate are pure and can be ported now.
    ; ========================================================================

    ; substitution_lookup: linear scan for a type-var id in a substitution.
    ; The `Substitution` type in Planner.cpp is a map<uint64_t, PlannedType>.
    ; In Scaly we represent it as Vector[KeyValuePair[size_t, PlannedType]]
    ; because primitive size_t lacks a `.hash()` method — HashMap requires
    ; `key.hash()` / `key.equals()` which are only defined on String today.
    ; At the scale of substitutions during a single function body (a few
    ; dozen entries at most) O(n) lookup is fine.
    function substitution_lookup(
        subst: Vector[KeyValuePair[size_t, PlannedType]],
        id: size_t
    ) @ret_param_0 true @deep true returns ref[PlannedType]? linked

    ; apply_substitution: replace every type variable in `t` with its binding
    ; in `subst`, recursing to handle chains (T0 -> T1 -> int). Concrete
    ; types get rebuilt with substituted generic arguments; everything
    ; else (loc / life / origin / mangled_name / array_size / variable) is
    ; preserved from the input. Returns the input unchanged when subst is
    ; null (i.e. empty substitution).
    function apply_substitution(
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[size_t, PlannedType]]]?
    ) @page true @direct true @deep true returns PlannedType linked

    ; free_type_vars_with_dups: depth-first collection of every type-var
    ; id reachable through the generics tree. May contain duplicates —
    ; the public free_type_vars wrapper dedupes.
    function free_type_vars_with_dups(t: PlannedType) @page true @direct true @ret_caller true @deep true returns Vector[size_t] linked

    ; free_type_vars: distinct type-var ids in `t`, in first-seen order.
    ; Used for generalization (promoting a type to a type scheme).
    function free_type_vars(t: PlannedType) @page true @direct true @ret_caller true @deep true returns Vector[size_t] linked

    ; name_substitution_lookup: linear scan by String key. Distinct from
    ; substitution_lookup (which keys on size_t type-var ids).
    function name_substitution_lookup(
        subst: Vector[KeyValuePair[String, PlannedType]],
        name: String
    ) @ret_param_0 true @deep true returns ref[PlannedType]? linked

    ; planned_type_to_model_type: deep-convert PlannedType → Model.Type,
    ; preserving nested generics. Used by extract_row_to_type# to rebuild
    ; an outer Model.Type with proper inner generic structure.
    function planned_type_to_model_type(pt: PlannedType) @page true @direct true @ret_caller true @deep true returns Type linked

    ; remangle_generic: recompute a generic type's Itanium name from its own
    ; ARGUMENTS, which is the identity for any type whose name already agrees.
    ;
    ; ★★★ Two ways a type reaches the emitter with a name that lies, both silent
    ; and both memory faults:
    ;   MISSING -- a receiver unwrapped out of one generic level too many
    ;     (`Option[ref[Vector[X]]]` where `pointer[Vector[X]]` works) carries "".
    ;     `map_type` then has nothing to key on, falls back to a bare-name match
    ;     and answers the FIRST `Vector[...]` ever registered; the GEP walked
    ;     `Vector[String]`.
    ;   STALE -- `apply_name_substitution` replaces a type's generic arguments and
    ;     carries `mangled_name` through UNCHANGED, so a substituted
    ;     `KeyValuePair[K, V]` comes back named `_Z12KeyValuePairI1K8NameableE`
    ;     beside arguments reading `String, Nameable`. The emitter reads the
    ;     unresolved parameter as a POINTER and LOADS the field instead of taking
    ;     its address, so `String::equals` gets string BYTES as an address.
    ;
    ; ★★★Why this hid behind six earlier attempts: every hop is CORRECT when
    ; printed by name and argument -- a probe over `resolve_member_access` shows
    ; `.key on=KeyValuePair[String Nameable]` throughout. Only the name the emitter
    ; keys on is wrong, and nothing else in the planner reads it.
    function remangle_generic(t: PlannedType) @page true @direct true @deep true returns PlannedType linked

    ; apply_name_substitution: substitute type-parameter names (e.g. "T",
    ; "K") with concrete types. Used by generic instantiation — the C++
    ; `TypeSubstitutions` is a name-keyed map populated before resolving
    ; each method in an instantiated struct.
    ;
    ; Preserves the caller's `loc` on the substituted type so error
    ; messages point at the use-site, matching Planner.cpp.
    function apply_name_substitution(
        t: PlannedType,
        subst: ref[Vector[KeyValuePair[String, PlannedType]]]?
    ) @page true @direct true @deep true returns PlannedType linked

    ; ========================================================================
    ; Primitive-type factories.
    ;
    ; The C++ Planner implicitly knows the Itanium one-letter codes for
    ; every built-in type. Until we have a Concepts table populated with
    ; pre-registered primitives, callers that need to synthesize a
    ; primitive PlannedType (e.g. for `return type of null = pointer[void]`)
    ; go through these factories so the codes stay consistent everywhere.
    ; ========================================================================

    function make_primitive_type(name: Slice[char], mangled: Slice[char]) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_void_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; The prelude's RuntimeFault (scaly/memory/runtime.scaly) -- the union a
    ; `try` catches a runtime panic through. Built by hand rather than looked
    ; up because plan_when resolves its arms through the NAME (lookup_variant_
    ; type / lookup_variant_tag), and the mangled form is what map_type needs
    ; in the emitter: a top-level define mangles without its module, so
    ; RuntimeFault is _Z12RuntimeFault (verified in the IR, not guessed).
    function make_runtime_fault_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_bool_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_int_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_i64_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_char_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_size_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    function make_double_type() @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; make_pointer_type: wrap `inner` as pointer[inner], with Itanium "P..."
    ; mangled name. `inner.mangled_name` must be populated.
    function make_pointer_type(inner: PlannedType) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; make_pointer_to_local#: like make_pointer_type# but the INNER pointee
    ; carries Local life — `&<frame-local-binding>` produces a pointer into
    ; the function's frame, so is_reference_to_local_page# (which reads the
    ; inner generic's life) fires when that pointer is returned / stored
    ; externally / passed to a storing callee. Escape soundness step 1: the
    ; address-of signal `$` used to provide on the binding, now inferred for
    ; no-sigil frame locals. The inner is rebuilt FRESH (rehome_type# style,
    ; String^rp copies, generics carried by ref) — never a by-value copy of
    ; an existing result_type (the s34/s196 union-struct-copy ABI hazard).
    function make_pointer_to_local(inner: PlannedType) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; make_ref_type#/make_ref_to_local#: the `ref` twins of make_pointer_type#
    ; and make_pointer_to_local#. `&x` yields a ref, not a pointer: a borrowed
    ; reference is what the address-of operator MEANS, and `pointer[T]` is the
    ; implementor's escape hatch (docs/scaly/chapters/types.xml). They differ
    ; in the mangled prefix -- "R" against "P", encode_type# -- and in nothing
    ; else at the LLVM level, where both are `ptr`; types_compatible#'s s96
    ; rule carries a ref into every position a pointer went, so this is a
    ; change of what the language SAYS, not of what it emits.
    function make_ref_type(inner: PlannedType) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; The inner is rebuilt FRESH (never a by-value copy of an existing
    ; result_type -- the s34/s196 union-struct-copy ABI hazard), exactly as
    ; make_pointer_to_local# does.
    function make_ref_to_local(inner: PlannedType) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; make_ref_to_local_inner#: rebuild a reference-like type (pointer[X] or
    ; ref[X]) PRESERVING its outer (pointer vs ref) and mangled name, but with
    ; the inner pointee X carrying Local life — so is_reference_to_local_page#
    ; (inner-Local clause) and is_local_ref_pointer# both fire. Unlike
    ; make_pointer_to_local# (which takes a bare inner and always builds a
    ; pointer) this is driven by an EXISTING reference type and keeps ref-ness,
    ; used by the hole-1 pass case to mark a tainted field read on the operand
    ; type itself. Inner rebuilt FRESH (String^rp copies — s34 ABI hazard).
    function make_ref_to_local_inner(t: PlannedType) @page true @direct true @deep true returns PlannedType linked

    ; stamp_getref_local_pointee# (Option B, 2026-07-02h): rebuild a container
    ; get/get_ptr RESULT type with its pointee life Local. get_ptr returns a
    ; bare pointer[T] — delegate to make_ref_to_local_inner#. get returns
    ; ref[T]? which plans as Option[ref[T]] — rebuild the Option with its
    ; inner reference stamped (the Option-of-ref shape the escape leaf
    ; predicates pierce). Any other type is returned verbatim. Applied by
    ; collapse_operand_sequence#'s method dispatch when the receiver holder's
    ; guts live on the frame's local page (local_frame_holder_names).
    function stamp_getref_local_pointee(t: PlannedType) @page true @direct true @deep true returns PlannedType linked

    ; rehome_type#: deep-copy a PlannedType onto `rp`, recursively
    ; re-homing its name / mangled_name / array_size Strings and all
    ; nested generic-argument PlannedTypes. Used by instantiate_generic#
    ; to pin a generic argument (which may have been built on a transient
    ; sub-computation page by the s188 lazy method hook) onto the
    ; Planner's persistent owning page before it is substituted into the
    ; instantiated structure's property / method types — otherwise the
    ; substituted name Strings dangle and emit's String hash SIGSEGVs.
    ; origin / variable refs are carried as-is (not read on the emit
    ; struct-type / hash path); life is a value, copied.
    function rehome_type(t: PlannedType) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; extract_row_to_type#: convert one row of a parsed VectorSyntax /
    ; Matrix into a Model.Type, recursively handling nested generics.
    ; Mirrors stage-0 Planner.cpp:7180-7214 (extractTypeFromRow lambda).
    ;
    ; row.length == 1: cell must be a PlannedType — wrap it as Model.Type.
    ; row.length >= 2: first cell is bare PlannedType (no generics) AND
    ;   second cell is PlannedMatrix → recurse into each nested row,
    ;   build Model.Type with generics filled in.
    ; Otherwise: return null (caller treats this as extraction failure).
    ; matrix_single_int_size: if a PlannedMatrix is exactly one row with a
    ; single integer-constant cell, return its decimal value as a String;
    ; otherwise empty. Recognises the `primitive[N]` stack-array shape in
    ; collapse_operand_sequence#'s Type+Matrix merge (s192).
    function matrix_single_int_size(nm: scalyc.compiler.Plan.PlannedMatrix) @page true @direct true @ret_caller true @deep true returns String linked

    ; fold_constant_ops: the plan-time fold of an integer operand run whose
    ; operators all sit on ONE precedence level (strict left-to-right is then
    ; exact: `0 - 1`, `-1`, `3 * 4`, `1 << 4`), one leading unary minus per
    ; value. Writes the value to `out` and answers true, or answers false for
    ; any other shape. Shared by a scalar global's initializer and by every
    ; element of a const ARRAY global.
    procedure fold_constant_ops(ops: Vector[PlannedOperand], mutable out: ref[size_t]) @ret_nonlocal true @deep true returns bool linked

    ; global_array_count: element count of a const-global ARRAY value.
    ; The planned value of `define X: T[] [a, b, ...]` is exactly one
    ; PlannedMatrix of either N rows x 1 column (comma/newline-separated
    ; elements) or 1 row x N columns. Returns 0 when the value is not an
    ; array literal (scalar constants keep the inline path).
    function global_array_count(value: Vector[PlannedOperand]) @deep true returns size_t linked

    ; fold_array_elements: every element of a const ARRAY global folded to ONE
    ; integer constant, in place — a row keeps its buffer, narrowed to the one
    ; operand it now holds. Answers 0, or the 1-based index of the first element
    ; that is not an integer constant. The Emitter takes one constant per
    ; element; it used to take every constant CELL of a row and skip the rest,
    ; so `[0x10, 0 - 0x5, 0x30]` emitted `[16, 0, 5]` and `-2` emitted 2, rc 0,
    ; the tail dropped to keep the declared count.
    procedure fold_array_elements(value: Vector[PlannedOperand], elem: PlannedType) @ret_nonlocal true @deep true returns size_t linked

    ; operand_is_integer_literal: a bare Integer or Hex constant, no member access.
    function operand_is_integer_literal(p: ref[PlannedOperand]?) @ret_nonlocal true @deep true returns bool linked

    function extract_row_to_type(row: Vector[PlannedOperand]) @page true @direct true @ret_caller true @deep true returns ref[Type]? linked

    ; resolve_type_base: convert a Model.Type into a PlannedType skeleton.
    ;
    ; Handles everything the non-stateful part of Planner.cpp's
    ; `resolveType` does:
    ;   - joins the dotted name (["scaly","containers","String"] -> "scaly.containers.String")
    ;   - recursively resolves generic arguments
    ;   - sets the Itanium mangled_name for the intrinsic pointer[T] / ref[T]
    ;     forms ("P…" / "R…")
    ;
    ; Deliberately skipped:
    ;   - TypeSubstitutions lookup (requires Planner state)
    ;   - Concepts table lookup for user-defined types' mangled_name
    ;     (leaves mangled_name empty for non-intrinsic names; the caller
    ;     fills that in once the Concepts table is available)
    function resolve_type_base(t: Type) @page true @direct true @deep true returns PlannedType linked

    ; lookup_local_in_scope: linear scan of one scope's bindings by name.
    ; Returned reference points into the scope's KeyValuePair storage.
    function lookup_local_in_scope(
        scope: Vector[KeyValuePair[String, LocalBinding]],
        name: String
    ) @ret_param_0 true @deep true returns ref[LocalBinding]? linked

    ; lookup_local_in_stack: searches innermost (top of the stack) to
    ; outermost — matches the reverse iteration in Planner.cpp's
    ; lookupLocal. A name shadowed in a newer scope hides the older
    ; binding.
    function lookup_local_in_stack(
        scopes: Vector[Vector[KeyValuePair[String, LocalBinding]]],
        name: String
    ) @ret_param_0 true @deep true returns ref[LocalBinding]? linked

    ; is_on_page_lifetime: everything except `Unspecified` is a page-backed
    ; allocation in Scaly's RBMM (local / caller / named / thrown all live
    ; on a page). Matches the static helper in Planner.cpp.
    function is_on_page_lifetime(life: Lifetime) @ret_nonlocal true @deep true returns bool linked

    ; ================================================================
    ; Provenance region-rank lattice (escape soundness, step 1).
    ;
    ; A coarse total order over WHERE a value's storage lives:
    ;   Local (0)  < Caller (1)  < Static (2)
    ;   frame/$       rp/#/^name     global/const
    ; An ESCAPE is a reference whose pointee rank is Local placed where
    ; Caller+ is required (return / store into a Caller-lived field /
    ; pass to a storing callee). Sound + conservative: in doubt -> Local
    ; -> reject. `#` and `^name` both collapse to Caller for now; the
    ; ordered numeric-rank family (`'a: 'b` outlives) is the phase-5
    ; endgame. region_rank_min implements the choose/if-join MINIMUM
    ; (shortest-lived branch wins) used by step 3's provenance walk.
    ; ================================================================
    function region_rank_local() @ret_nonlocal true @deep true returns size_t linked
    function region_rank_caller() @ret_nonlocal true @deep true returns size_t linked
    function region_rank_static() @ret_nonlocal true @deep true returns size_t linked
    function region_rank_of_life(life: Lifetime) @ret_nonlocal true @deep true returns size_t linked
    function region_rank_min(a: size_t, b: size_t) @ret_nonlocal true @deep true returns size_t linked

    ; decode_utf8_to_code_point: decode exactly one UTF-8 code point from
    ; `s`. Returns -1 for empty input, malformed sequences, overlong
    ; encodings, surrogates/out-of-range, or any trailing bytes past the
    ; first character. Matches the static helper in Planner.cpp.
    function decode_utf8_to_code_point(s: String) @ret_nonlocal true @deep true returns int linked

    ; id_list_contains: linear scan for a size_t id in a Vector[size_t].
    function id_list_contains(ids: Vector[size_t], needle: size_t) @ret_nonlocal true @deep true returns bool linked

    ; instantiate: dual of generalize. Replace every universally quantified
    ; variable in a TypeScheme with a freshly generated type variable so
    ; the scheme can be used polymorphically at a single call site.
    ;
    ; The C++ Planner gets fresh ids from the owning Plan's counter. Here
    ; we take `next_id_start` as a parameter and allocate sequential ids
    ; from there; the caller is responsible for advancing its counter by
    ; `scheme.quantified.length`.
    function instantiate(
        scheme: TypeScheme,
        next_id_start: size_t
    ) @page true @direct true @deep true returns PlannedType linked

    ; generalize: promote a type to a type scheme by universally
    ; quantifying every free var that is NOT already free in the
    ; surrounding type environment. This is the operation behind
    ; `let`-polymorphism (ML / Haskell).
    function generalize(
        t: PlannedType,
        free_in_env: Vector[size_t]
    ) @page true @direct true @ret_caller true @deep true returns TypeScheme linked

    ; is_option_vs_void_pointer: does `left` name an Option family type
    ; while `right` is `pointer[void]`? Used by unify to treat the null
    ; literal as the None constructor of any Option type.
    function is_option_vs_void_pointer(left: PlannedType, right: PlannedType) @deep true returns bool linked

    ; unify: produce the most-general substitution that makes `left` and
    ; `right` structurally equal. Returns null on any failure (occurs
    ; check, name mismatch, arity mismatch). The error channel intentionally
    ; drops the specific reason for now — adding a proper Result/Expected
    ; type is a separate refactor.
    ;
    ; Special cases preserved from Planner.cpp:
    ;   - same variable id                       → empty subst
    ;   - variable vs T (or vice versa)          → bind (with occurs check)
    ;   - void vs anything                       → empty subst
    ;   - compatible integer families            → empty subst
    ;   - Option family vs pointer[void]         → empty subst
    ;   - concrete names equal, arities equal    → recurse on generics
    function unify(
        left: PlannedType,
        right: PlannedType
    ) @page true @direct true @ret_caller true @deep true returns ref[Vector[KeyValuePair[size_t, PlannedType]]]? linked

    ; solve_constraints: classical HM solver. Walk the constraint list
    ; in order, applying the current solution to each constraint's sides,
    ; unifying them, and composing the new substitution into the solution.
    ; Instance (trait) constraints are skipped — matches the TODO in
    ; Planner.cpp. Returns null on any unification failure.
    function solve_constraints(
        constraints: ref[Vector[TypeConstraint]]?
    ) @page true @direct true @deep true returns ref[Vector[KeyValuePair[size_t, PlannedType]]]? linked

    ; compose_substitutions: S2 ∘ S1 — apply S1 first, then S2.
    ; Equivalent to the C++ `composeSubstitutions`:
    ;   Result = S2 ⊎ { (id, apply(T, S2)) | (id, T) ∈ S1 }
    ; with S1's entries winning on duplicate ids (since the C++ map
    ; assignment overwrites). We implement the dedup by first emitting
    ; every S1 entry with its S2-applied value, then appending only the
    ; S2 entries whose id did not already appear in S1.
    function compose_substitutions(
        s1: Vector[KeyValuePair[size_t, PlannedType]],
        s2: Vector[KeyValuePair[size_t, PlannedType]]
    ) @page true @direct true @ret_caller true @deep true returns Vector[KeyValuePair[size_t, PlannedType]] linked

    ; occurs_in: does a type variable with the given id appear anywhere in
    ; `t` (or its recursive generic arguments)? The occurs check prevents
    ; the unifier from constructing infinite types like T ~ List[T].
    function occurs_in(var_id: size_t, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

    ; are_compatible_integer_types: trivial wrapper around is_integer_type.
    ; Kept as a named predicate so call sites read like their C++ counterparts.
    function are_compatible_integer_types(left: String, right: String) @ret_nonlocal true @deep true returns bool linked

    ; chain_tail_is_property: does this operand end in a member hop that reads
    ; a resolved PROPERTY? Such an operand is exactly as non-callable as a bare
    ; local — nothing downstream attaches a following operand to it — which is
    ; what the orphan-operand gate in collapse_operand_sequence asks. The three
    ; other hop kinds all DO consume what follows and must answer false:
    ;
    ;   * a METHOD hop is the valid parenless call `recv.method arg`, and with
    ;     an argument tuple the ordinary `recv.method(args)` (the s174 rule the
    ;     rhs side of that loop reads the same way);
    ;   * a VARIANT or `.value` hop (is_union_value) is a construction;
    ;   * a PLACEHOLDER hop — void result, recorded by resolve_member_access
    ;     for a name that resolved against nothing — belongs to a type this
    ;     pass cannot see yet (an uninstantiated generic body's `value.hash()`,
    ;     a lazily registered instantiation's `vars.get vi`) and still resolves
    ;     downstream.
    ;
    ; Static, and called in ONE statement: the locals this needs would perturb
    ; collapse_operand_sequence's s178 alloca pool if they were inlined there.
    function chain_tail_is_property(operand: PlannedOperand) @deep true returns bool linked

    ; ========================================================================
    ; Operator identification.
    ; ========================================================================

    ; is_operator_name: does this identifier look like an operator definition?
    ; Mirrors Planner.cpp — the one "name-shaped" exception is `abs`, which
    ; the grammar exposes as a unary prefix operator despite being spelled
    ; alphabetically. Everything else keys off the first byte.
    function is_operator_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; get_operator_precedence: higher = binds tighter. Mirrors
    ; Planner.cpp:1418-1431 exactly. Used by collapse_operand_sequence#
    ; to climb precedence so `A <> X & B <> Y` collapses as
    ; `(A <> X) & (B <> Y)` rather than `((A <> X) & B) <> Y`.
    function get_operator_precedence(name: String) @ret_nonlocal true @deep true returns int linked

    ; ========================================================================
    ; Function-signature helpers.
    ; ========================================================================

    ; join_dotted_name: "scaly" / "containers" / "String" -> "scaly.containers.String".
    ; Matches the Planner.cpp logic that collapses a Type.Name Vector into
    ; one canonical dotted identifier for primitive/generic-param checks.
    function join_dotted_name(parts: Vector[String]) @page true @direct true @ret_caller true @deep true returns String linked

    ; a `linked` routine (a generated interface's declaration) and one of
    ; its declared facts
    function is_linked(f: Function) @ret_nonlocal true @deep true returns bool linked

    function linked_says(f: Function, name: Slice[char]) @ret_nonlocal true @deep true returns bool linked

    ; an attribute by name among a declaration's attributes (`@resident`)
    function attributes_have(attrs: Vector[Attribute], name: Slice[char]) @ret_nonlocal true @deep true returns bool linked

    ; an attribute by name on any of a routine's parameters (`@persists`)
    function items_have_attribute(items: Vector[Item], name: Slice[char]) @ret_nonlocal true @deep true returns bool linked

    ; is_extern_impl: detect the Extern variant of Implementation without
    ; leaking a bare choose into the caller's control flow.
    function is_extern_impl(impl: Implementation) @ret_nonlocal true @deep true returns bool linked

    ; s188: allowlist of data-structure plumbing generics that lookup_method#
    ; may lazily full-instantiate when reached via a method CALL. Restricted
    ; to the machinery HashSet<String> transitively needs — making EVERY
    ; generic concept real this way also activates latent-broken paths the
    ; baseline masks with stubs (HashMap/HashMapBuilder<String,Nameable> in
    ; the Modeler symbol table → reallocate→page SIGSEGV) and test-only
    ; instantiations (Option/Result/Slice from containers::test_*).
    function is_lazy_machinery_generic(name: String) @ret_nonlocal true @deep true returns bool linked

    ; s200: Option/Result method calls on REAL-union instantiations
    ; (Option[int], Result[int,bool]) may lazily instantiate — they are
    ; UNIONS, so the plan_type# route (Structure-gated) never emits their
    ; method bodies and a user's `o.is_some()` linked against nothing (the
    ; s189 user-program hole). GATED on every generic arg being non-ref/
    ; non-pointer: adding Option to is_lazy_machinery_generic blanketly
    ; instantiates the compiler's own NPO `ref[T]?` Options, whose generic
    ; bodies hit the escape checker (Emitter.scaly:37 "reference into a
    ; local page escapes via return", rc 4) and DIVERGE the fixed point —
    ; the s188 warning, reproduced 2026-07-06. NPO Options stay on the
    ; intrinsic unwrap path.
    function is_lazy_real_union(name: String, generics: ref[Vector[PlannedType]]?) @ret_nonlocal true @deep true returns bool linked

    ; is_runtime_opaque_struct: the non-generic scaly-stdlib structs whose
    ; LLVM layout map_type intentionally keeps OPAQUE (String → literal
    ; { ptr }, Page/PageList/... → plain ptr). The s176 note records that
    ; registering their real layouts flips them from ptr to full structs
    ; throughout, changing every ABI decision stage-1 makes and emptying
    ; stage-2's modules. The on-demand cross-package layout registration
    ; (ensure_member_layout#) must NEVER touch these — so String stays
    ; { ptr } whether the compilation root is scaly, scalyc, or scalyls,
    ; keeping the compiler fixed point byte-identical. Generic stdlib
    ; containers (Vector/Array/HashMap/...) need no entry here: the caller
    ; already skips parameterized concepts.
    function is_runtime_opaque_struct(name: String) @ret_nonlocal true @deep true returns bool linked

    ; is_generic_type_param_name: single ASCII uppercase letter — how the
    ; grammar encodes a type parameter like `T`, `K`, `V`. Such names
    ; don't get an implicit return page because the instantiator picks
    ; the real type later.
    function is_generic_type_param_name(name: String) @ret_nonlocal true @deep true returns bool linked

    ; type_mentions_generic_param: does this planned type — or, recursively,
    ; any of its resolved generic arguments — still name an UNINSTANTIATED
    ; type parameter? True only while a generic TEMPLATE body is planned;
    ; a real instantiation carries concrete types all the way down.
    ; Does `t` mention the type-parameter name `name` anywhere, at its own
    ; head or inside any generic argument? The occurs-check of
    ; enter_concept_generic_scope# — see there for what it prevents.
    function type_mentions_name(t: PlannedType, name: String) @ret_nonlocal true @deep true returns bool linked

    function type_mentions_generic_param(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

    ; needs_implicit_return_page: does a function whose return type is
    ; known-non-primitive need an implicit page parameter so the caller
    ; can allocate the returned struct?
    ;
    ; Matches Planner.cpp exactly except for the leading `PageParameter`
    ; check — Scaly's Model.Function does not (yet) record whether a
    ; function was declared with `#`; treat every function uniformly for
    ; now. Extern functions bail early because they don't participate in
    ; RBMM.
    function needs_implicit_return_page(func: Function) @ret_nonlocal true @deep true returns bool linked

    ; ---- Interprocedural collector-procedure page inference ----
    ; A VOID procedure that stores a freshly-constructed value into a non-`this`
    ; ref/pointer parameter via `param.add(...)` / `param.put(...)` must receive
    ; the caller's page (rp), exactly like a `#`-procedure: the values it builds
    ; (e.g. build_referenced_module#'s Module) have to outlive this frame and
    ; land on the caller's page, not this frame's local page (freed on return).
    ; This is the interprocedural counterpart of needs_implicit_return_page for
    ; collector procedures — handle_module_decl / handle_package_decl in the
    ; de-sigiled Modeler, which append loaded sub-modules into a `&modules`
    ; out-parameter. Detected by a shallow Model-body scan for the
    ; put/add-on-ref-param shape (Form A / Form B of collect_store_value_locals#).
    ; Cheap-gated: false for non-void (needs_implicit_return_page covers those),
    ; externs, and functions with no non-`this` ref/pointer parameter.
    ;
    ; NEUTRAL on the sigiled source: the only two functions it flags are already
    ; `#` (page_parameter set), so the page decision is unchanged everywhere it
    ; fires. function_needs_caller_page unifies it with needs_implicit_return_page
    ; at every page-decision site (mangled `…PageE` suffix, page_param_ref="_rp",
    ; requires_page_param on calls).
    ; is_npo_option_type: an `Option` whose sole generic is `ref`/`pointer`,
    ; i.e. the NPO layout — a bare nullable pointer with no tag. Mirrors
    ; Emitter.is_npo_option (Emitter.scaly:3801) on a Model.Type.
    ; `Option[int]` is NOT NPO (it carries a tag).
    function is_npo_option_type(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked

    ; is_reference_shaped_return: a return type that hands back a REFERENCE
    ; rather than a value -- `ref[T]`, `pointer[T]`, and the NPO forms
    ; `ref[T]?` / `pointer[T]?`, which arrive here as `Option[ref[T]]` because
    ; s113 wraps every `T?` at Model level.
    ;
    ; The wrapper carries no tag and no storage, so every rule that asks "is
    ; this a reference return?" has to ask THROUGH it. The three page rules
    ; that gate on it -- rule 4's `#`-in-body scan plus its two prepass copies,
    ; and body_returns_page_needing_call -- were blind to the NPO forms all
    ; along, and it never showed because rule 1 claimed them unconditionally.
    ; It shows the moment that claim becomes conditional: an NPO builder would
    ; keep its `#` construction and lose the page it allocates on.
    ; is_npo_option_generic_pointee: `ref[T]?` / `pointer[T]?` whose POINTEE is
    ; a generic type PARAMETER. This is the one shape where the s113 wrap's
    ; implicit caller page is provably dead weight, so needs_implicit_return_page
    ; skips it: a function returning `ref[T]?` cannot CONSTRUCT a T — it has no
    ; concrete type to construct — so the reference it hands back must point
    ; into storage that already existed (`this`, a parameter, a global), and no
    ; caller page is needed to allocate it. That is exactly the stdlib's hot
    ; container accessors: Vector.get, Array.get, Slice.get, List.get_head,
    ; HashMap.get, HashMapBuilder.get and their `[]` operators.
    ;
    ; A CONCRETE pointee is deliberately NOT exempt, and the reason is measured
    ; rather than cautious. `ref[Vector[X]]?` is the shape that BUILDS its
    ; result (parser.parse_operand_list, Planner.unify, lookup_method,
    ; restamp_args, ...), and there the blanket page does DOUBLE DUTY: it is
    ; also what makes promote_tail_operand promote the tail construction to the
    ; caller page (`f_promote_tail` reads this predicate directly). Drop it for
    ; those and the result is built on the callee's own frame and handed back
    ; as a dangling reference — and neither the escape checker nor
    ; body_returns_value_ctor_as_pointer catches it: parse_operand_list slipped
    ; through both and failed as a RUNTIME exit 19 (Page.get on an oversized
    ; page) inside List.add, before the return was ever reached.
    ;
    ; Judged on the DECLARED type, so every instantiation of a generic agrees:
    ; the Model.Function still says T after T is bound to a concrete type.
    function is_npo_option_generic_pointee(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked

    function is_reference_shaped_return(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked

    function is_ref_or_pointer_type(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked
    function is_ref_pointer_param(func: Function, name: String) @ret_nonlocal true @deep true returns bool linked
    function has_ref_pointer_param(func: Function) @ret_nonlocal true @deep true returns bool linked
    ; A single operand sequence is `recv.put(...)` / `recv.add(...)` where recv is
    ; a non-`this` ref/pointer parameter of func. Form A: member_access ends in
    ; put/add with head Type name=["recv"]; Form B: dotted name ["recv","put"]
    ; with member_access=null (the shape the tree-builders actually emit).
    function op_seq_stores_into_ref_param(func: Function, ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    ; The SHALLOW store scan, kept for the one caller that must not change: a
    ; body's top-level statements plus one Block level, matching the shape and
    ; not what is stored. This is the answer void storers have had all along.
    function action_shallow_store(func: Function, a: Action) @ret_nonlocal true @deep true returns bool linked
    ; Walk a body for a store into a ref PARAMETER. DEEP: every statement and
    ; every operand, so a store inside a `while`, a `choose` arm or a nested
    ; block counts. It used to walk the body's top-level statements and ONE
    ; Block level only, and the miss was silent in the one direction that is a
    ; memory fault -- no page, so a value the callee builds FOR THE CALLER lands
    ; on a frame that is released on return. The arm list below is closed (every
    ; Expression arm that can contain a statement or an operand is handled), so
    ; completeness needs no conservative fallback.
    ;
    ; `require_build` carries proc_needs_caller_page_for_storage's void/non-void
    ; split into ONE traversal, so both questions are asked of exactly the same
    ; store sites: a void storer fires on the shape alone, a non-void one must
    ; also BUILD something at the store.
    function action_stores_into_ref_param(func: Function, a: Action, require_build: bool) @ret_nonlocal true @deep true returns bool linked
    function binding_stores_into_ref_param(func: Function, b: Binding, require_build: bool) @ret_nonlocal true @deep true returns bool linked
    function statement_stores_into_ref_param(func: Function, st: Statement, require_build: bool) @ret_nonlocal true @deep true returns bool linked
    function ops_store_into_ref_param(func: Function, ops: Vector[Operand], require_build: bool) @ret_nonlocal true @deep true returns bool linked
    function operand_stores_into_ref_param(func: Function, op: Operand, require_build: bool) @ret_nonlocal true @deep true returns bool linked
    function proc_needs_caller_page_for_storage(func: Function) @ret_nonlocal true @deep true returns bool linked
    function op_seq_store_builds_value(func: Function, ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    ; ---- body-^rp-scan: a function whose body constructs anything with a
    ; `^rp` reference lifetime (`String^rp(...)` / `Vector[T]^rp(...)`) needs the
    ; caller's page even when its return type is primitive (ref/void/bool) —
    ; needs_implicit_return_page only inspects the RETURN TYPE. The escape-
    ; analysis/promotion helpers (collect_*/promote_*/scan_top_level_returns/
    ; add_escaping_*) build promoted rp-allocated operands via `^rp`; de-sigiled
    ; without a page, those `^rp` allocations have no rp local — the promotion
    ; silently lands on the local page and fails, and the values it was meant to
    ; promote (e.g. find_break_type_in_*'s returned PlannedType) then escape.
    ; A recursive Model-body walk. It RETURNS bool and STORES NOTHING — no
    ; borrowed-String lifetime hazard, so it needs no page itself (cf. the
    ; disproven "Model-union-by-value" fear: a recursive Model walk that only
    ; reads is fine). PRECISE: only a Type carrying Lifetime.Reference("rp")
    ; counts — type ANNOTATIONS carry Unspecified, never Reference — so it never
    ; spuriously flips has_page. NEUTRAL on the sigiled source: every function it
    ; flags is still `#` there (page_parameter set → has_page already true).
    function type_has_rp_lifetime(t: scalyc.compiler.Model.Type) @ret_param_0 true @deep true returns bool linked
    ; The `^rp` on a GENERIC construction (`Vector[T]^rp(...)`) rides the Matrix
    ; operand's life, NOT the leading Type's lifetime (the s107 split). The
    ; `#`-scan (operand_has_call_life) checks Matrix.life via lifetime_is_call;
    ; the `^rp`-scan below must be symmetric, else a function whose only rp use is
    ; a `Vector[T]^rp(...)` construction is not recognised as needing rp on its
    ; own — it then depends on the transitive page-set reaching it through a
    ; `^rp`-storing callee, which silently breaks the moment that callee drops its
    ; `^rp`. The compiler source currently has NO `^rp` (all migrated to
    ; `#`/`^this`/local), so this is behaviour-neutral today; it is a correctness
    ; fix that keeps the two lifetime scans symmetric and guards reintroduction.
    function lifetime_is_rp(lt: Lifetime) @ret_param_0 true @deep true returns bool linked
    function ops_reference_rp(ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    function binding_references_rp(b: Binding) @ret_nonlocal true @deep true returns bool linked
    function statement_references_rp(s: Statement) @ret_nonlocal true @deep true returns bool linked
    function action_references_rp(a: Action) @ret_nonlocal true @deep true returns bool linked
    function operand_references_rp(op: Operand) @ret_nonlocal true @deep true returns bool linked
    ; A function whose body constructs anything with a `^rp` reference lifetime
    ; needs the caller's page (see the walker above).
    function body_references_rp(func: Function) @ret_nonlocal true @deep true returns bool linked
    ; ---- body-`#`-scan: does a function body construct anything with a
    ; Call (`#`) lifetime? A `#` construction (`Vector[T]#(acc)`, `String#(...)`)
    ; allocates on the CALLER's page (rp), so the function must receive rp even
    ; when its declared return type is a PRIMITIVE (ref/pointer) that
    ; needs_implicit_return_page does not cover. This is exactly the
    ; `parse_X_list` shape: `returns ref[Vector[XSyntax]]?` with an implicit
    ; return `Vector[XSyntax]#(acc)`. Mirrors the body-`^rp` walker above but
    ; tests `Lifetime.Call` on a Type AND on a Matrix.life (a GENERIC
    ; construction `Vector[T]#(...)` carries its lifetime on the Matrix operand
    ; per s107, not the bare Type). Structurally identical recursion.
    ;
    ; NEUTRAL on the sigiled source: any function with a `#` construction in its
    ; body is already a `#` decl there (the `#` needs an rp to allocate on), so
    ; page_parameter is set and has_page is true regardless — this clause only
    ; ever ADDS a page for a DE-SIGILED primitive-returning function whose body
    ; keeps a genuine caller-page `#` construction.
    function lifetime_is_call(lt: Lifetime) @ret_nonlocal true @deep true returns bool linked
    ; `T^name(...)`: the construction names a page in scope, so what it builds
    ; outlives the frame that builds it -- and the frame of that frame's caller.
    function lifetime_is_reference(lt: Lifetime) @ret_nonlocal true @deep true returns bool linked
    function lifetime_is_local(lt: Lifetime) @ret_nonlocal true @deep true returns bool linked
    ; Phase-5 class 1 helpers: the value-guts persist summary. See the
    ; persist_summary_names field comment for the contract and
    ; function_persists_param_guts below for the entry point.
    function persist_names_contain(arr: Array[String], name: String) @ret_nonlocal true @deep true returns bool linked
    ; Does the operand sequence (from index `start`) mention one of `pnames`
    ; BARE — a single-segment name operand, at top level or nested inside a
    ; construction WITHOUT an explicit lifetime? A `^this`/`^page`/`#`
    ; construction re-homes or deep-copies its content (String^this(name) in
    ; the escape collectors), so a param nested under one is NOT persisted
    ; shallowly; a bare data-class construction copies the param struct
    ; SHALLOWLY, so its page guts escape with it (PlannerDiagnostic(...,
    ; message, ...) in add_diagnostic).
    function persist_value_mentions_param(ops: Vector[Operand], start: size_t, pnames: Array[String]) @ret_nonlocal true @deep true returns bool linked
    ; Is this operand sequence a put/add into state that outlives the frame
    ; (receiver a this-field or a name that is neither a parameter nor a
    ; body-local, i.e. a field/global reached via the implicit-property
    ; path), whose value mentions a parameter bare?
    function persist_paren_receiver_persists(op0p: ref[Operand], pnames: Array[String], locals: Array[String]) @deep true returns bool linked

    function persist_ops_putadd_param(ops: Vector[Operand], pnames: Array[String], locals: Array[String]) @ret_nonlocal true @deep true returns bool linked
    ; Walk the TOP statement level of a body block: collect Binding names
    ; as body-locals first (a local container receiver is frame state, not
    ; persistence), then test each Action's operand sequence. Nested
    ; control-flow putadds stay unclassified in this increment — their
    ; call sites keep pre-rule behavior.
    function persist_scan_statements(stmts: Vector[Statement], pnames: Array[String]) @ret_nonlocal true @deep true returns bool linked
    ; Entry point: does f's body store a parameter's page-guts VALUE into
    ; state that outlives its frame? True for add_error (`errors.add
    ; message`) and add_diagnostic (`diagnostics.add(PlannerDiagnostic(...,
    ; message, ...))`); false for the deep-copying escape collectors
    ; (`escaping_return_locals.add(String^this(name))` — explicit-lifetime
    ; construction excluded) and for putadds into body-local containers.
    function function_persists_param_guts(f: Function) @ret_nonlocal true @deep true returns bool linked
    function type_has_call_lifetime(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked
    function ops_have_call_life(ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    function binding_has_call_life(b: Binding) @ret_nonlocal true @deep true returns bool linked
    function statement_has_call_life(s: Statement) @ret_nonlocal true @deep true returns bool linked
    function action_has_call_life(a: Action) @ret_nonlocal true @deep true returns bool linked

    ; WP9: does this Model Action (a lambda body) assign to `name`? Checks the
    ; action's own store target (a `set name: ...`) and descends into a block
    ; body's statements and if/choose arms so `\x: { set n: ... }` and
    ; conditional assignments are caught. Bare-name targets only (a `set n:`,
    ; not `set n.field:` — mutating a field of a captured value copy is a
    ; separate concern and still only affects the copy).
    function action_assigns_name(a: Action, name: String) @ret_nonlocal true @deep true returns bool linked
    function operand_assigns_name(op: Operand, name: String) @ret_nonlocal true @deep true returns bool linked
    function statement_assigns_name(s: Statement, name: String) @ret_nonlocal true @deep true returns bool linked
    function operand_has_call_life(op: Operand) @ret_nonlocal true @deep true returns bool linked
    function body_has_call_lifetime(func: Function) @ret_nonlocal true @deep true returns bool linked

    ; ---- allocation scan ------------------------------------------------------
    ; Does this body allocate ANYTHING? It is the question the caller-page rule
    ; for an NPO return has to ask, and asking it is what lets `ref[T]?` stop
    ; costing a page (see needs_implicit_return_page).
    ;
    ; ★★★The POLARITY is the load-bearing part and it is the opposite of what a
    ; "detect the shapes that need a page" rule would do. A MISS in that
    ; direction is a page that is not granted, i.e. a value built on a frame
    ; that dies -- a memory fault, not a diagnostic, and the escape checker does
    ; not catch them all (the generated `parse_*_list` family slips through it).
    ; So this scan proves the NEGATIVE and every gap answers YES: an expression
    ; arm it does not explicitly account for as allocation-free is treated as
    ; allocating. Adding a new Expression arm therefore keeps the page by
    ; default and cannot silently drop one.
    ;
    ; A CONSTRUCTION is recognised on the operand SEQUENCE, not on one operand:
    ; a member-access-free Type head, optionally a Matrix (the generic
    ; arguments -- the s107 split, three operands, not two), then a Tuple. That
    ; same shape is also an unqualified free-function CALL, which Model cannot
    ; tell apart from a construction, and it is deliberately NOT told apart:
    ; both may need our page, so both keep it. A METHOD call (`d.get_value()`)
    ; carries a member_access and is therefore not this shape -- that is what
    ; leaves the pure accessors, the target class, exempt.
    function body_may_allocate(func: Function) @ret_nonlocal true @deep true returns bool linked
    function action_may_allocate(a: Action) @ret_nonlocal true @deep true returns bool linked
    function binding_may_allocate(b: Binding) @ret_nonlocal true @deep true returns bool linked
    function statement_may_allocate(st: Statement) @ret_nonlocal true @deep true returns bool linked
    ; the last dotted segment of a planned type name
    function last_name_segment(n: String) @page true @direct true @ret_caller true @deep true returns String linked

    ; an Itanium complete-object constructor symbol (`_ZN6StringC1E6String`)
    function mangled_is_constructor(m: String) @ret_nonlocal true @deep true returns bool linked

    ; R8's identity key: the name and the source offset of the declaration
    function store_key(f: Function) @page true @direct true @ret_caller true @deep true returns String linked

    ; R8 helpers (build_store_page_set#). The NAME a call operand calls: the
    ; last member-access hop, else the last segment of a dotted name.
    function called_name(op: Operand) @page true @direct true @ret_caller true @deep true returns String linked

    ; segments of the dotted head plus its member-access hops
    function head_path_length(op: Operand) @ret_nonlocal true @deep true returns size_t linked

    ; the root name of the first operand's path ("" when it has none); with
    ; `called` the last segment is the method and a lone name has no root
    function ops_root_name(ops: Vector[Operand], called: bool) @page true @direct true @ret_caller true @deep true returns String linked

    ; the mask bit of a root: the receiver (`this`, a field of it) is bit 0,
    ; params[k] bit k; anything else -- a local -- none
    function root_bit(root: String, fields: Array[String], params: Array[String]) @ret_nonlocal true @deep true returns u64 linked

    function ops_may_allocate(ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    ; The head is one of the runtime's `scaly_panic_*` traps.
    function ops_head_is_panic(ops: Vector[Operand]) @deep true returns bool linked

    ; The head of a construction names Slice: a view, never an owner.
    function ops_construct_view(ops: Vector[Operand]) @ret_caller true @deep true returns bool linked

    ; The construction/call SHAPE: Type head without member access, an optional
    ; Matrix of generic arguments, then a Tuple.
    function ops_are_construction(ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked
    ; Does this Type name read as a CONCEPT rather than as a value? The question
    ; only arises for a DOTTED head, where Model cannot tell `tab.at(i)` (a
    ; method call on a field) from `ns.Type(i)` (a qualified construction) --
    ; the parser emits both as one Type whose `name` carries the segments and
    ; whose member_access is null (Form B, the shape the tree-builders emit).
    ;
    ; A SINGLE segment is always treated as a concept, because an unqualified
    ; `foo(1)` may be a free-function call that needs our page just as much as a
    ; construction would; there is nothing to gain by splitting them.
    ;
    ; For a dotted head the LAST segment decides, on the capitalisation the
    ; whole tree already follows (and that `type_mentions_generic_param#` and
    ; `is_concept_parameter_name#` already depend on): `Lifetime.Unspecified`
    ; and `scaly.containers.String` are constructions, `tab.at` and `d.get_v`
    ; are calls. This is the ONE place in the page rules where a NAMING
    ; convention is load-bearing, and it is worth stating why it is worth it:
    ; without it every accessor that calls a method WITH ARGUMENTS reads as
    ; allocating and keeps a page it does not need -- which is most of the
    ; nullable accessors the ports are full of.
    function type_name_reads_as_concept(t: scalyc.compiler.Model.Type) @ret_nonlocal true @deep true returns bool linked
    ; An OPERATOR name: an identifier made exclusively of the eleven operator
    ; characters `+ - * / = % & | ~ < >`. That class IS the language's
    ; definition of an operator -- there is no operator token class, an
    ; operator IS an identifier, and `advance` branches on letter vs operator
    ; char so the two are disjoint by construction. `^` is deliberately absent
    ; (it is the lifetime sigil, never an operator char); the list must agree
    ; with lexer.scaly's scan_operator and with scalyls' grammar.is_op_char.
    ; The rule a parenless call with a call as its argument breaks, in the
    ; words every diagnostic of that shape uses.
    function chained_argument_rule() @page true @direct true @ret_caller true @deep true returns String linked

    ; A name only a FUNCTION can have: it begins with a letter and is none of
    ; the six word operators (the list of get_operator_precedence#: `div` and `mod`
    ; beside the four). `[]` and `!` are operator names of the compiler's own
    ; that are neither -- 2 515 sites answered to the first version of this,
    ; which asked "no operator characters".
    function name_is_function_name(n: String) @ret_nonlocal true @deep true returns bool linked

    function name_is_word_or_symbol_operator(n: String) @ret_nonlocal true @deep true returns bool linked

    function name_reads_as_operator(n: String) @ret_nonlocal true @deep true returns bool linked
    function operand_may_allocate(op: Operand) @ret_nonlocal true @deep true returns bool linked

    ; WP7: does a `pointer[T]`-returning function's body TAIL construct T by
    ; value (no lifetime marker)? `function create() returns pointer[Node]
    ; { Node(data) }`. The emitter would otherwise take the address of a stack
    ; value that dies with the frame. When true, function_needs_caller_page
    ; grants the rp page parameter (and `#`-style mangling) and the plan-time
    ; tail promotion restamps the construction to Call life — behaving exactly
    ; like the explicit `Node#(data)`. body_has_call_lifetime already covers
    ; the explicit-`#` case; this is the NO-sigil complement. Conservative:
    ; fires only for a direct value construction of the exact pointee at the
    ; tail (single-expression body or the last statement of a braced block).
    ; A tail that already carries a lifetime, returns a pointer, or is a call/
    ; variable is NOT flagged.
    function body_returns_value_ctor_as_pointer(func: Function) @ret_nonlocal true @deep true returns bool linked

    ; ops_tail_is_value_ctor: does this operand sequence's TAIL construct the
    ; named type by value? Handles a single-expression body ([Type(name),
    ; Tuple]) and a braced block (a lone Block operand — descend to its last
    ; statement). Returns false for anything else.
    function ops_tail_is_value_ctor(ops: Vector[Operand], type_name: String) @ret_nonlocal true @deep true returns bool linked

    ; ---- return-position page-need inference ---------------------------------
    ; A function whose RETURN VALUE is the result of a call to a page-needing
    ; function must take the caller's page itself. Without one, the callee gets
    ; the only page this frame can offer — the frame's OWN local page — the frame
    ; is released on return, and the returned pointer dangles. Silently: it reads
    ; correct until something reuses the page (measured on the minimal shape:
    ; `7/8` immediately, `10/51548000360` after 200 String allocations made at the
    ; call site's own frame level).
    ;
    ; GATED on a ref/pointer RETURN TYPE, because that is precisely the hole:
    ; needs_implicit_return_page treats `pointer`/`ref` as primitive NAMES —
    ; rightly, since most pointer returns are BORROWED, not owned — so the return
    ; type alone cannot decide it and the body has to.
    ;
    ; ★The narrowness is the point; do NOT widen this to impl_mentions_set's
    ; mention test. Nearly every function in the tree mentions SOME page-needing
    ; name (String, Vector, …), so propagating through those would promote almost
    ; the whole compiler: mangled-name churn plus a real regression, because a
    ; promoted function's locals move off its own frame onto the caller's page and
    ; stop dying with the frame — exactly the granularity the region work bought.
    ;
    ; Return positions: the body's TAIL (descending through a tail Block and both
    ; arms of a tail If) and every explicit `return`, including inside nested
    ; blocks and if/choose/match arms. A non-tail statement call is NOT a return
    ; position (`helper()` followed by `this.field` must not promote). Value
    ; shapes: a direct call (`f(x)`, `this.m(x)`, `ns.f(x)`, `(*p).m(x)`) and a
    ; local bound to one in the same block (`let r f(x)` … `r`). A `#`-marked
    ; construction is not this rule's business — body_has_call_lifetime already
    ; covers it. A tail referencing a variable bound in an OUTER block is not
    ; followed (the scope handed down is the innermost block's).
    ;
    ; ★WHICH function a call names is decided by RECEIVER-TYPE RESOLUTION
    ; (ret_page_resolve_call → ret_page_receiver_concept), not by the callee's
    ; bare name: the receiver's type comes from the enclosing concept
    ; (`this.m()`), a parameter, a local (declared OR inferred from its
    ; initializer, ret_page_local_type), a property of the enclosing concept
    ; (implicit `this`), or a concept name (a static call); every further prefix
    ; segment is a property hop (`this.id_table.lookup(...)`); and a hop off a
    ; non-name primary is resolved the same way once its base expression has a
    ; type (`(*p).mk.make()`). The resolved concept's overload set — narrowed by
    ; argument count — is then asked directly via function_needs_caller_page.
    ; This is what closes the ambiguity hole the name-keyed sets left open: with
    ; `EntityCatalog.lookup` page-needing and `IdTable.lookup` borrowed, a name
    ; test can only either promote both or neither, so the veto below had to
    ; choose neither and left a genuinely dangling `return catalog.lookup(x)`
    ; broken.
    ;
    ; What still falls back to the name-keyed sets: a receiver whose type the
    ; inference cannot name — an operator expression (`(*(buf + i)).m()`), a
    ; deref of anything but a plain name, a generic instantiation's element type
    ; — and a CHAINED tail call (`helper(x).m()`, where the value is the last
    ; call's and this rule tests the first: over-approximate when `helper` needs a
    ; page, blind to `m`'s need when it does not). Under-approximating there is
    ; deliberate: a missed shape stays as broken as it was, while a wrong
    ; promotion moves a callee's allocations onto the caller's page for good.
    ; does this function take its page as an EXPLICIT first argument
    ; (`f(host: pointer[Page], …)`)? Then a call to it hands over that page, not
    ; the caller's frame, and returning its result is sound without a page of our
    ; own. The Modeler has already PEELED a `page`/`rp`-named first parameter into
    ; page_parameter, so what remains in `input` is exactly the explicit form.
    ;
    ; ★This is what separates a real dangler from a false positive, and it is 36
    ; of 36 in packages/opensp: `ParserState.lookup_create_id` returns
    ; `id_table.lookup_create(this.host, name)` — page-needing callee, but the
    ; page comes from a long-lived field, so the created Id never touches this
    ; frame. Without this test the rule flags every `lookup_create_*` / `copy` /
    ; `parse_simple*` in the parser and hands each an unused `_rp`.
    function takes_explicit_page_arg(func: Function) @ret_nonlocal true @deep true returns bool linked

    ; `pointer[Page]` OR `ref[Page]`, spelled at any qualification depth.
    ;
    ; ★Both spellings, because this asks a SHAPE question -- "does this parameter
    ; hand the callee a region to allocate on" -- and a borrowed page reference
    ; answers it exactly as a page pointer does. Keyed on the name `pointer`
    ; alone it silently changed a PAGE DECISION when a port converted its page
    ; parameters to `ref[Page]`: the callee stopped counting as one that receives
    ; a page explicitly, so `ret_page_func_needs` fell through to
    ; `function_needs_caller_page` and gave the CALLER a frame it does not need
    ; (measured on `VM.resolve_set` / `ProcessContext.push_style_end`, where the
    ; temporaries of a `while` loop then die one level further out). Its sibling
    ; `ret_page_type_last_name` already unwraps both. Same class as the six NPO
    ; sightings in CLAUDE.md: ask the shape, not the name.
    function ret_page_type_is_page_pointer(t: scalyc.compiler.Model.Type) @deep true returns bool linked

    ; ---- the RESOLVED-callee decision -----------------------------------------
    ; does a call to THIS function leave its result on the page WE hand it? That
    ; is function_needs_caller_page (the same predicate the call site itself
    ; consults, so the answer cannot drift from what is emitted), minus the
    ; callees that receive a page EXPLICITLY: those allocate on the page the
    ; argument names — a long-lived field in every measured case
    ; (`id_table.lookup_create(this.host, name)`) — not on our frame. Checked over
    ; the whole parameter list here, `this` aside, because a member function's
    ; explicit page sits at index 1 (takes_explicit_page_arg, which keys the
    ; name-based fallback veto, only ever saw index 0).
    procedure ret_page_func_needs(pl: Planner, mutable f: Function) @ret_nonlocal true @deep true returns bool io linked

    ; the concept name a type ultimately denotes: the last segment of its dotted
    ; name, through any number of `pointer[...]` / `ref[...]` wrappers. The result
    ; points INTO the Model's own name vector — no allocation, valid as long as
    ; the Model is.
    function ret_page_type_last_name(t: scalyc.compiler.Model.Type) @deep true returns ref[String]? linked

    function ret_page_param_type_last(func: Function, name: String) @deep true returns ref[String]? linked

    ; is `name` bound by a `let`/`var` in this block? A local SHADOWS a property
    ; of the enclosing concept, so an untyped one must end the resolution attempt
    ; rather than let it fall through to the property of the same name.
    function ret_page_local_binds(scope: Vector[Statement], name: String) @ret_nonlocal true @deep true returns bool linked

    ; the DECLARED type of a local (`let p: pointer[Foo] …`). Bindings without
    ; one go through ret_page_local_type's inference.
    function ret_page_local_type_last(scope: Vector[Statement], name: String) @deep true returns ref[String]? linked

    function ret_page_property_type_last(pl: Planner, concept_name: String, prop: String) @deep true returns ref[String]? linked

    ; ---- the local type inference -------------------------------------------
    ; `let h get_holder()` … `h.make()`: the receiver has no declared type, so its
    ; type is the CALLEE's return type — which needs the same receiver resolution
    ; one level down, hence the mutual recursion below (capped by `idepth`; a
    ; self-referential or cyclic binding must not spin). Everything here answers a
    ; CONCEPT NAME as a `ref[String]?` pointing into the Model's own name vectors:
    ; no String is ever constructed on this path, because a String return would
    ; land on the pre-pass frame once per call site per fixpoint round.
    ;
    ; Inferred shapes: a construction (`Foo(…)`, `Foo#(…)`, `Foo^p(…)`), a call
    ; (free, static, or on a resolvable receiver), a property chain
    ; (`this.a.b`), another local, a parenthesized expression, and a deref
    ; (`(*p)` — `ret_page_type_last_name` already strips `pointer`/`ref`, so the
    ; deref is the identity on the answer). Anything else answers null and leaves
    ; the call site on the name-keyed fallback.

    ; every segment of `path` from `i` on is a PROPERTY hop; answer the type of
    ; the last one (a value chain, not a call).
    function ret_page_walk_props_all(pl: Planner, cur: ref[String]?, path: Vector[String], i: size_t) @deep true returns ref[String]? linked

    ; the segments path[i .. length-2] are PROPERTY hops; answer the concept that
    ; OWNS path[length-1] (its callee). Carries the current concept as a ref so
    ; the terminal answer can be handed back up without constructing a String.
    function ret_page_walk_to_concept(pl: Planner, cur: ref[String]?, path: Vector[String], i: size_t) @deep true returns ref[String]? linked

    ; the RETURN type of the functions named `method` among these members — the
    ; same overload narrowing as ret_page_members_decision, but the answers must
    ; agree on the type NAME (they do for every real overload set; a disagreement
    ; answers null rather than guessing).
    function ret_page_members_return_type(pl: Planner, members: Vector[Member], method: String, argc: size_t) @deep true returns ref[String]? linked

    function ret_page_concept_return_type(pl: Planner, concept_name: String, method: String, argc: size_t) @deep true returns ref[String]? linked

    function ret_page_functions_return_type(pl: Planner, name: String, argc: size_t) @deep true returns ref[String]? linked

    ; the type of a NAME in this scope: a local (declared or inferred), a
    ; parameter, a property of the enclosing concept, or a concept name used as a
    ; value. Same precedence the planner uses.
    function ret_page_name_type(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], name: String, idepth: int) @deep true returns ref[String]? linked

    ; a local's type: declared if it says so, else inferred from its initializer.
    function ret_page_local_type(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], name: String, idepth: int) @deep true returns ref[String]? linked

    ; the type an EXPRESSION evaluates to (no member hops — the operand level
    ; below adds those).
    function ret_page_expr_type(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], expr: Expression, idepth: int) @deep true returns ref[String]? linked

    function ret_page_operand_type(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], op: Operand, idepth: int) @deep true returns ref[String]? linked

    ; the type an operand SEQUENCE evaluates to. A call/construction is
    ; `[head, Tuple]`; a single operand is a value.
    function ret_page_ops_type(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], ops: Vector[Operand], idepth: int) @deep true returns ref[String]? linked

    ; an overload's parameter count matches a call's argument count, with the
    ; receiver — spelled out as `this` in this language — counted on the callee
    ; side only.
    function ret_page_arity_ok(f: Function, argc: size_t) @ret_nonlocal true @deep true returns bool linked

    ; decide over the functions named `method` among these members:
    ;   1 = needs our page, 0 = does not, -1 = no such member, or the overload set
    ;       disagrees even after the arity filter (then the caller falls back).
    procedure ret_page_members_decision(pl: Planner, mutable members: Vector[Member], method: String, argc: size_t) @ret_nonlocal true @deep true returns int io linked

    procedure ret_page_concept_decision(mutable pl: Planner, mutable concept_name: String, method: String, argc: size_t) @ret_nonlocal true @deep true returns int io linked

    ; the same decision over the FREE functions of that name (a bare `f(x)`).
    ; Walks the registry's hash chain in place — building a Vector of matches here
    ; would allocate on the pre-pass frame once per call site per fixpoint round.
    procedure ret_page_functions_decision(mutable pl: Planner, name: String, argc: size_t) @ret_nonlocal true @deep true returns int io linked

    ; the concept that owns the callee of a dotted call path: resolve the FIRST
    ; segment to a type (`this`, a parameter, a local — declared or inferred —, a
    ; property of the enclosing concept, or a concept name for a static call),
    ; then take every further prefix segment as a property hop.
    function ret_page_receiver_concept(pl: Planner, owner: ref[String]?, func: Function, scope: Vector[Statement], path: Vector[String], idepth: int) @deep true returns ref[String]? linked

    ; resolve `path(argc args)` to the function it actually calls and answer its
    ; page-need: 1 yes, 0 no, -1 not resolvable here.
    procedure ret_page_resolve_call(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable scope: Vector[Statement], mutable path: Vector[String], argc: size_t) @ret_nonlocal true @deep true returns int io linked

    ; the NAME-KEYED fallback, for a receiver this pre-pass cannot type.
    function ret_page_name_in_sets(pl: Planner, n: String) @ret_nonlocal true @deep true returns bool linked

    ; the callee of a call head: the head Type's dotted name (`ns.f(...)`,
    ; `this.m(...)`, `recv.m(...)` — the Modeler folds the whole path into the
    ; name), or the LAST member_access segment when the call rides a hop off a
    ; non-name primary (`(*p).m(...)`). A head carrying a lifetime marker is a
    ; CONSTRUCTION, not a plain call, and is left to body_has_call_lifetime.
    procedure ret_page_call_head(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable scope: Vector[Statement], mutable op: Operand, argc: size_t) @ret_nonlocal true @deep true returns bool io linked

    ; find `let`/`var name <ops>` in this block and test its initializer.
    procedure ret_page_binding(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable scope: Vector[Statement], name: String, depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; ret_page_stmts_sets#: does any `set name: <ops>` in these statements --
    ; however deeply nested: an arm of choose/match/if, a block, a loop body --
    ; hand the returned local a page-needing call's result? Until 2026-09-25
    ; only the binding's initializer was asked, and `var out provided` followed
    ; by `set out: this.place_named_components(...)` in a choose arm needed a
    ; DECLARED caller page (reorder_named_components); with the caller page
    ; implicit, the rule has to see it.
    procedure ret_page_stmts_sets(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable stmts: Vector[Statement], name: String, depth: int) @ret_nonlocal true @deep true returns bool io linked

    procedure ret_page_stmt_sets(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable s: Statement, mutable scope: Vector[Statement], name: String, depth: int) @ret_nonlocal true @deep true returns bool io linked

    procedure ret_page_action_sets(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable a: Action, mutable scope: Vector[Statement], name: String, depth: int) @ret_nonlocal true @deep true returns bool io linked

    procedure ret_page_ops_sets(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable ops: Vector[Operand], name: String, depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; TAIL semantics: does this operand sequence YIELD a page-needing call's
    ; result?
    ; ops_length_without_trailing_cast: the length of a flat operand sequence
    ; with any TRAILING `as` operand ignored -- the length the shape tests of the
    ; page-inference walkers have to be judged on.
    ;
    ; ★ A cast relocates nothing, so `x as ref[T]` is the same value in the same
    ; place as `x`. But it is an extra OPERAND, and both walkers below recognise
    ; their shapes by position: a bare local needs length 1, a call needs its
    ; argument Tuple at index 1. So an appended cast made every one of those
    ; shapes unrecognisable -- SILENTLY, and in the direction that REMOVES a
    ; page: measured, `id` gave its function the caller page and `id as ref[T]`
    ; did not, which puts the returned object on a frame released at the return.
    ; The unwrap the four declared-type positions demand of an Option sits on
    ; exactly these tail expressions, which is how the blind spot was found;
    ; four tscaly `Checker` functions were already losing their page to a
    ; hand-written cast before it.
    function ops_length_without_trailing_cast(ops: Vector[Operand]) @ret_param_0 true @deep true returns size_t linked

    procedure ret_page_ops_tail(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable ops: Vector[Operand], mutable scope: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    procedure ret_page_stmt_tail(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable s: Statement, mutable scope: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; a block's return positions: every explicit `return` anywhere inside it, plus
    ; its LAST statement (the tail).
    procedure ret_page_stmts_tail(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable stmts: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; the explicit-`return` walk: every Return in the body, however deeply nested.
    ; Non-tail statements are descended into ONLY to find those returns — their own
    ; values are not return positions.
    procedure ret_page_stmts_returns(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable stmts: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    procedure ret_page_stmt_returns(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable s: Statement, mutable scope: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; `scope` is the enclosing block's statements: a `return x` in an arm
    ; resolves the local `x` through the binding that block holds (2026-09-25;
    ; the arms were handed an empty scope, so `let child this.mk(i)` ...
    ; `return child` inside a loop never reached R7)
    procedure ret_page_ops_returns(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function, mutable ops: Vector[Operand], mutable scope: Vector[Statement], depth: int) @ret_nonlocal true @deep true returns bool io linked

    ; entry point: does this function return the result of a page-needing call?
    ; `owner` names the concept it is a member of (EMPTY for a free function) —
    ; the anchor for receiver-type resolution.
    procedure body_returns_page_needing_call(mutable pl: Planner, mutable owner: ref[String]?, mutable func: Function) @ret_nonlocal true @deep true returns bool io linked

    ; ---- transitive page-need walker: does a function body MENTION any name in
    ; a set? A sibling CALL's name rides either a member_access hop
    ; (`this.collect_flow_locals(...)`) or a dotted Type-name segment
    ; (`recv.method`), so both are checked. Structurally mirrors the ^rp walker
    ; above. Over-approximate (a coincidental type/variable reference also
    ; matches) — safe, since the set holds only cluster method names and a match
    ; only ever ADDS a page (NEUTRAL on the sigiled source). Used by
    ; build_transitive_page_set's fixpoint.
    function static_name_in_set(names: Array[String], n: String) @ret_nonlocal true @deep true returns bool linked
    function type_name_mentions_set(t: scalyc.compiler.Model.Type, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function ops_mention_set(ops: Vector[Operand], names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function binding_mentions_set(b: Binding, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function statement_mentions_set(s: Statement, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function action_mentions_set(a: Action, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function operand_mentions_set(op: Operand, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    function impl_mentions_set(impl: Implementation, names: Array[String]) @ret_nonlocal true @deep true returns bool linked
    ; Unified page-decision predicate: a function needs the caller's page (rp)
    ; either to allocate a returned struct/union (needs_implicit_return_page), to
    ; store freshly-built values into a ref/pointer out-parameter
    ; (proc_needs_caller_page_for_storage), to build a `^rp`-lifetime value in
    ; its body (body_references_rp), or — transitively — to forward rp to a
    ; sibling that does (transitive_page_names, built by build_transitive_page_
    ; set). Consulted at every has_page / page_param_ref / requires_page_param
    ; site; `pl` supplies the precomputed transitive set.
    ; env-gated probe (SCALYC_PAGE_PROBE=1): one line per page-granting
    ; return of function_needs_caller_page, tagged R1..R7 -- the instrument
    ; CLAUDE.md asks to rebuild for every page question, kept this time.
    procedure page_probe(func: Function, tag: pointer[const_char]) @deep true io linked

    procedure function_needs_caller_page(pl: Planner, mutable func: Function) @ret_nonlocal true @deep true returns bool io linked

    ; membership in an identity-keyed function set: the name plus the source span,
    ; which together pin exactly one function (two same-named functions would have
    ; to start AND end at the same byte offset of two different files to collide).
    ; The three arrays are parallel.
    function static_func_in_set(names: Array[String], starts: Array[size_t], ends: Array[size_t], func: Function) @ret_nonlocal true @deep true returns bool linked

    ; ========================================================================
    ; Argument-list helpers.
    ; ========================================================================

    ; Collect the result_type of every operand inside a tuple-shaped operand.
    ; Split out so extract_arg_types can dispatch via a simple choose without
    ; a nested side-effecting match expression.
    function extract_tuple_arg_types(tuple_val: PlannedTuple) @page true @direct true @ret_caller true @deep true returns Vector[PlannedType] linked

    ; extract_arg_types: flatten a function-call argument list (modelled as a
    ; tuple of components) into a plain Vector of argument result types.
    ; A non-tuple operand falls back to its own result_type as a single arg —
    ; the parser may elide the tuple around a single-argument call like
    ; `f(x)` where `x` is already a complete operand.
    function extract_arg_types(args_op: PlannedOperand) @page true @direct true @ret_caller true @deep true returns Vector[PlannedType] linked

    ; ========================================================================
    ; Constant type inference.
    ; ========================================================================

    ; Helper: build a pointer[i8]-typed PlannedType — the representation of
    ; C-style string literals. Shared by StringConstant and FragmentConstant.
    function make_cstring_type(sp: Span) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; Helper: pointer[void] for the null literal. The constraint solver is
    ; expected to unify this with whatever pointer-like type is required
    ; at the use-site.
    function make_null_type(sp: Span) @page true @direct true @ret_caller true @deep true returns PlannedType linked

    ; infer_constant_type: map a Constant variant to the PlannedType assigned
    ; to that literal before the constraint solver runs. Primitive families
    ; carry the Itanium one-letter codes directly; string/fragment/null
    ; delegate to the helpers above.
    function infer_constant_type(c: Constant) @page true @direct true @deep true returns PlannedType linked

    ; get_pointer_element_type: return the element type T for pointer[T],
    ; ref[T], Option[pointer[T]], or Option[ref[T]]. Everything else
    ; yields null.
    ;
    ; Planner.cpp also has a "flattened" Option.ref.X fast path to cope
    ; with how monomorphisation mangles nested generics into the name.
    ; That path is a fragile heuristic; leaving it out until we actually
    ; hit a case that needs it.
    function get_pointer_element_type(ptr_type: PlannedType) @deep true returns ref[PlannedType]? linked

    ; size_to_string: decimal representation of a size_t.
    ; Classic divide-by-10 with digit buffer and reversal.
    function size_to_string(n: size_t) @page true @direct true @ret_caller true @deep true returns String linked

    ; ========================================================================
    ; Test entry point, exercised by compiler.test().
    ; Returns 0 on pass, non-zero diagnostic code on failure.
    ; Only touches real helpers — never calls a stub (that would exit 111).
    ; ========================================================================

    procedure test() @ret_nonlocal true @deep true returns int io linked
}
