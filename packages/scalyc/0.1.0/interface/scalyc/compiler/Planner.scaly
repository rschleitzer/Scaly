        ; s184: a construction result can carry a trailing member chain
        ; (`Point(3, 4).x`). The construction gate attaches the chain raw
        ; and keeps result_type = the struct type, so plan_tuple's
        ; single-component lift typed the whole group as the struct and
        ; emit_tuple rebuilt the struct from the extracted field. Resolve
        ; the hops against the operand's result type and rewrite chain +
        ; result_type when every hop resolves as a property — the same
        ; rule as the s175 call-branch fix. Returns the operand
        ; unchanged when the chain is absent or not all-property.
        ; A subscript followed by a member chain, `a[0].x` / `a[i].m(y)`: the
        ; parser hangs `.x` on the index MATRIX, so the pre-pass fused `a`
        ; and `[0]` and would lose the chain -- until 2026-09-27 it refused
        ; to fuse at all and the pair failed as "unexpected operand". The
        ; chain is resolved again against the ELEMENT (rebind_trailing_chain#)
        ; and hung on the fused operand.
        procedure fused_chain_onto(mutable this: Planner, mutable fused_op: PlannedOperand, ops: Vector[PlannedOperand], at: size_t) @page true @direct true @deep true @deep_this_6 true returns PlannedOperand io linked

        procedure rebind_trailing_chain(
            mutable this: Planner,
            mutable operand: PlannedOperand
