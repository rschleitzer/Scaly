        procedure escape_walk_operand(mutable this: Planner, op: PlannedOperand) io linked









































































































































































        ; Walk one statement by value. choose stmt mirrors emit_statement.
        procedure escape_walk_statement(mutable this: Planner, stmt: PlannedStatement) io linked






























































