            mutable this: Planner,
            prefix: String,
            mutable suffix: String,
            mutable arg_types: Vector[PlannedType],
            arg_ops: Vector[PlannedOperand]
        ) @page true @returnpage true @stores true @deep true @deep_this_8 true returns ref[MethodMatch]? io linked

        ; resolve_static_method_on: resolve an UNQUALIFIED bare call `fn_name`
        ; against the this-less (static) member functions of a named Structure
        ; concept — the enclosing-struct sibling-static case. A Structure's
        ; statics are not in the free-function registry (they aren't reachable
        ; via resolve_function_call#) and, having no `this`, cannot go through
        ; the s101 implicit-this dispatch, so `bit(m)` inside ModeInfo's static
        ; `build_table()` would otherwise report "function not found". This is
        ; the exact resolution the s155 qualified-static path (`Type.method`)
        ; performs, factored into a helper so the collapse_operand_sequence#
        ; call site stays a single `set match_ref:` statement (adding an inline
        ; branch there perturbs its s178 alloca pool — see resolve_dotted_call).
        ; Returns null when the struct is unknown or declares no matching
        ; static; the caller then falls through to its remaining fallbacks.
        ; Overload note: prefer a static whose arity matches the argument count;
        ; otherwise take the first same-named static (mirrors s155's name-only
        ; pick for the single-overload common case).
        ; Among the statics of `c` named `fn_name` whose ARITY matches the
        ; call, the one whose parameter TYPES do: exact first, then compatible,
        ; then with the char/literal fold -- the three passes lookup_method#
        ; runs for a this-method. Both static paths took the first arity match
        ; alone, so `W.name_of(s)` with a String ran `name_of(s: Slice[u8])`
        ; when that was declared first, handing it the String record as a view
        ; (rc 0; scalyls' JsonWriter.quote(name) died in Slice.operator[],
        ; 2026-09-29). With one arity match nothing is asked, so every call that
        ; resolved before resolves the same; with no type match the first arity
        ; match stays.
        procedure refine_static_overload(mutable this: Planner, c: Concept, fn_name: String, arg_types: Vector[PlannedType], arg_ops: Vector[PlannedOperand], chosen: ref[Function]) @deep true returns ref[Function] io linked

        ; A qualified static or namespace call whose argument TYPES match no
        ; static of that name and arity: both static paths select by name and
        ; arity, so `tools.note(&lines, text)` handed an Array[String] to a
        ; ref[StringBuilder] parameter at rc 0 -- emit_call builds the callee
        ; type from the arguments, and the callee appended into the Array's
        ; record (2026-10-01; found by the REPL, where a second local named
        ; `history` took the first one's place in two calls). The same call on
        ; a free function was always `function not found`. Judged as a method's
        ; arguments are (report_arg_types_from#); a generic concept is left out
        ; for the reason given there. Gate xfail_static_arg_type.
        procedure report_static_arg_types(mutable this: Planner, c: Concept, fn_name: String, arg_types: Vector[PlannedType], arg_ops: Vector[PlannedOperand], chosen: ref[Function]) @deep true io linked

        ; A function without a leading `this` parameter.
        function function_is_static(f: Function) @ret_nonlocal true @deep true returns bool linked

        procedure resolve_static_method_on(
            mutable this: Planner,
            struct_name: String,
