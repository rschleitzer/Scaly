        function when_payload_flows_to_escaping(this: Planner, w: When) @ret_nonlocal true @deep true returns bool linked

        procedure plan_choose(mutable this: Planner, mutable c: Choose) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedChoose io linked

        ; plan_case / plan_branch / plan_match: the full match-expression form.
        ; The case's operand run is COLLAPSED: the emitter evaluates the case
        ; condition as one value, and a flat run (`case 0 - 1`, and the `n =
        ; "int"` a match_by_equals# case is made of) handed it three operands
        ; -- measured 2026-09-24, `case 0 - 1` matched -1 never and 1 always.
        procedure plan_case(mutable this: Planner, mutable cs: Case) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedCase io linked

        procedure plan_branch(mutable this: Planner, mutable b: Branch) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedBranch io linked

        ; match_needs_equals#: the emitter matches by `icmp` on the scrutinee's
        ; VALUE, which is right for numbers, characters, flags and references
        ; and wrong for a record: `match n` on a String compared the two
        ; buffers' addresses and never matched, rc 0 (2026-09-24; nothing in
        ; the tree used `match` on a String -- found weighing `match` for the
        ; `or`-chain rewrite).
        procedure match_needs_equals(mutable this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; operands_are_plain_name#: the operand run is one bare name.
        function operands_are_plain_name(ops: Vector[Operand]) @ret_nonlocal true @deep true returns bool linked

        ; match_by_equals#: `match n  case A case B: S  case C: T` becomes a
        ; match on `true` whose cases are `n = A`, `n = B`, `n = C` -- the `=`
        ; that desugars to `equals`. The scrutinee is a plain name
        ; (operands_are_plain_name#), so evaluating it once per case changes
        ; nothing.
        procedure match_by_equals(mutable this: Planner, m: Match) @page true @direct true @deep true returns Match linked

        procedure plan_match(mutable this: Planner, mutable m: Match) @page true @direct true @stores true @deep true @deep_beyond_2 true @deep_this_2 true returns PlannedMatch io linked

        ; ================================================================
        ; Tuples and matrices.
        ; ================================================================

        ; plan_component: Model.Component → PlannedComponent.
        ; Mirrors Planner.cpp:10499-10512 — each component's operand
        ; sequence is collapsed so prefix ops like `*p` and method-call
        ; arguments resolve against the collapsed result rather than the
        ; raw operand sequence. emit_tuple's grouping shortcut emits
        ; comp.value[0], so without this collapse `(*p).field` would
        ; emit only the leading `Type("*")` operand and produce null.
        procedure plan_component(mutable this: Planner, mutable c: Component) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns PlannedComponent io linked

        procedure plan_tuple(mutable this: Planner, mutable t: Tuple) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedTuple io linked

        procedure plan_matrix(mutable this: Planner, mutable m: Matrix) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns scalyc.compiler.Plan.PlannedMatrix io linked

        ; plan_new: `new Foo(args)` — object construction. The mangled
        ; initializer and resolved struct type depend on the concept
        ; table, so we plan the type skeleton and arguments and leave
        ; the call layout for later resolution. For now we model it as
        ; a PlannedTuple carrying the argument list and the planned type.
        procedure plan_new(mutable this: Planner, mutable n: New) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedTuple io linked

        ; ================================================================
        ; plan_operand: dispatch by Expression variant, then wrap with
        ; any member-access chain declared on the operand.
        ; ================================================================
        procedure plan_operand(mutable this: Planner, mutable op: scalyc.compiler.Model.Operand) @page true @direct true @stores true @deep true returns PlannedOperand io linked

        ; plan_operands: batch plan_operand over a Vector.
        ; s184: unit variant referenced without an argument tuple —
        ; `Option.None` as a value. Mirrors stage-0's planOperands
        ; Case 3 (Planner.cpp:8376-8419): a two-segment name whose
        ; first segment is a registered union and whose second a
        ; payload-less variant plans as a PlannedVariantConstruction
        ; with no value. Returns null when the shape doesn't match so
        ; the caller falls back to plan_operand#. Locals win — a
        ; shadowing local binding disqualifies the union lookup.
        procedure try_plan_unit_variant(
            mutable this: Planner,
            t: Type,
            loc: Span
        ) @page true @direct true @ret_caller true @deep true returns ref[PlannedOperand]? linked

        ; report_absorbed_after_control#: a `choose`, `match`, `if` or `try`
        ; followed by more operands in ONE operand run. The parser ends such a
        ; construct at its last arm's newline and then keeps collecting for the
        ; enclosing statement, so the NEXT LINE joins it: in a braceless `if`
        ; body `choose e ... else 0` took the `77` that followed the `if` --
        ; the function answered 0 at rc 0 when the condition was false -- and a
        ; call line (`this.fallback(pv)`) aborted the emitter with an empty
        ; operator name (2026-09-24; the s164 shape of `let X choose`, one
        ; statement over). Reported at the absorbed operand. Since 2026-09-25
        ; the grammar no longer produces it (When/Case read their separator in
        ; front, scaly.sgm); this stays as the net behind that.
        procedure report_absorbed_after_control(mutable this: Planner, ops: Vector[scalyc.compiler.Model.Operand]) @deep true linked

        ; ================================================================
        ; The operation census (SCALYC_OPERATION_CENSUS=1,
        ; ROADMAP-operation.md step 1): what the operand sequences of a root
        ; ARE, counted where they are planned -- which thing follows which.
        ; It is what the new left-to-right path has to answer, and it counts
        ; the shapes the concept reads differently from today: a prefix in the
        ; middle of a sequence, a method named without a tuple.
        ; Slot 0 of operation_counts is the switch (0 not asked, 1 off, 2 on).
        ; ================================================================
        procedure operation_census_on(mutable this: Planner) @ret_param_0 true @deep true returns bool io linked

        ; 1 an operator name, 2 a function's name, 3 a type's name, 4 another
        ; single name, 5 a tuple, 6 the empty tuple, 7 a vector literal, 8 a
        ; block, 9 a constant, 10 a control expression, 11 a dotted name,
        ; 0 anything else
        function operation_kind(this: Planner, op: Operand) @ret_nonlocal true @deep true returns int linked

        procedure operation_count(mutable this: Planner, slot: size_t) @persists true @ret_nonlocal true @deep true linked

        ; a counted shape and where it stands: the script counts each place
        ; ONCE, however many roots plan the body it is in
        procedure operation_site(mutable this: Planner, slot: size_t, start: size_t) @ret_nonlocal true @deep true linked

        procedure operation_census(mutable this: Planner, ops: Vector[Operand], planned: Vector[PlannedOperand]) @deep true linked

        procedure operation_census_line(mutable this: Planner, name: pointer[const_char], slot: size_t) @ret_nonlocal true @deep true linked

        procedure operation_census_report(mutable this: Planner) @ret_nonlocal true @deep true io linked

        ; ================================================================
        ; The operation driver (SCALYC_PENDING=1; ROADMAP-operation.md step 1,
        ; part 2): the loop that reads a sequence from the left, in front of
        ; collapse_operand_sequence#. It knows WHICH step comes next -- a name
        ; and its tuple, a value and its vector literal, a prefix at the
        ; start, a postfix -- and hands each step to the machinery there is,
        ; as a short sequence of its own; operators still go by the table, the
        ; folded terms and the operator names in one hand-over. A sequence it
        ; does not understand is left to the old collapse as a whole, BEFORE
        ; any step has run (operation_read#), so nothing is planned twice.
        ; The yardstick is the emission: with and without the switch every
        ; root gives the same IR. Slots of operation_counts: 23 answered by
        ; the last call, 24 the next collapse is a step (do not ask again),
        ; 25 sequences, 26 answered, 27-32 why one was left, 34-43 the steps.
        ; ================================================================

        ; What a planned thing of a sequence is: 1 an operator name, 2 another
        ; name (a function, a type, a local -- a name stays a PlannedType
        ; until a step resolves it), 3 a lifetime sigil, 4 a tuple, 5 a vector
        ; literal, 6 a postfix (`as`, `is`) still without its value, 7 a value
        function operation_thing(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns int linked

        ; What the thing before a tuple IS, asked before the step is taken --
        ; the rule reads the current value's type, the old collapse the
        ; operand's shape: 1 a method on a chain, 2 a value (a local, a
        ; field, a call's result), 3 a function, 4 a type, 5 a qualified name
        ; (`Owner.member`), 6 a bare name that is none of these here.
        function operation_name(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns size_t linked

        ; ... and what the machinery made of it: a call, a tuple (the
        ; construction by position), a variant, something else. Counted
        ; against operation_name#'s answer (slots 47 to 70): where the two
        ; disagree, the step by type has something to learn.
        procedure operation_note(mutable this: Planner, named: size_t, made: PlannedOperand) @ret_nonlocal true @deep true io linked

        ; the prefix test of the old collapse: an operator by its characters
        ; (and `abs`, `not`)
        function operand_is_symbol_operator(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; Reads a sequence without planning anything: 0 when every step of it
        ; is one the driver knows, else the counter slot of the reason.
        function operation_read(this: Planner, ops: Vector[PlannedOperand]) @ret_nonlocal true @deep true returns size_t linked

        ; One step, handed to the machinery there is: its things are a
        ; sequence of their own, and collapse_operand_sequence# does not ask
        ; the driver about that one again.
        procedure operation_step(mutable this: Planner, mutable things: Vector[PlannedOperand], slot: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; the step of a current value and the ONE thing after it
        procedure operation_pair(mutable this: Planner, cur: PlannedOperand, next: PlannedOperand, slot: size_t) @page true @direct true @stores true @deep true @deep_this_6 true returns PlannedOperand io linked

        ; Is the tuple after cur applied by collapse_application# alone? Not
        ; where one of the pair pre-passes of the old collapse owns it: a
        ; lambda bound to a name, a delegate value, a pointer local (the
        ; indirect call of the JIT).
        procedure operation_call_is_plain(mutable this: Planner, cur: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; A step taken without the pre-passes of the old collapse: its
        ; application part, and its operator part where the things are no
        ; application. `first` is things[0].
        procedure operation_apply(mutable this: Planner, mutable things: Vector[PlannedOperand], mutable first: PlannedOperand, slot: size_t) @page true @direct true @stores true @deep true @deep_this_4 true returns PlannedOperand io linked

        ; A step with a vector literal or a sigil in it, by the pair
        ; pre-passes of the old collapse in their order -- generic arguments,
        ; sigil, subscript --, and its application part where none of them
        ; takes it.
        procedure operation_merge(mutable this: Planner, mutable things: Vector[PlannedOperand], mutable first: PlannedOperand, slot: size_t) @page true @direct true @stores true @deep true @deep_this_4 true returns PlannedOperand io linked

        ; the pair of a current value and its vector literal or sigil
        procedure operation_merge_pair(mutable this: Planner, mutable cur: PlannedOperand, next: PlannedOperand, slot: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; the prefix and its term, by the prefix part of the old collapse
        procedure operation_prefix(mutable this: Planner, mutable things: Vector[PlannedOperand], mutable sign: PlannedOperand) @page true @direct true @stores true @deep true @deep_this_4 true returns PlannedOperand io linked

        ; the call without parentheses, by its part of the old collapse
        procedure operation_parenless(mutable this: Planner, mutable cur: PlannedOperand, next: PlannedOperand) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; The step of a current value and its tuple, or of the operation so
        ; far and a postfix, in a routine of its own (operation_apply#).
        procedure operation_call(mutable this: Planner, mutable cur: PlannedOperand, next: PlannedOperand, slot: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; a tuple or a vector literal with a member hop riding on it
        ; (`a.b(1).c`, `files[k].equals`)
        function thing_carries_hop(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; A term -- the things from first up to limit, no operator and no
        ; postfix among them: the first thing is the current value, and each
        ; thing after it is applied to that. A tuple or a vector literal
        ; carrying a member hop (`a.b(1).c(2)`: the hop `.c` rides on `(1)`;
        ; `files[k].equals(x)`: `.equals` on `[k]`) goes with everything
        ; chained to it in ONE step, as fold_rhs_call# takes it: the hop is
        ; resolved by the machinery only with what follows it in hand.
        procedure operation_term(mutable this: Planner, ops: Vector[PlannedOperand], first: size_t, limit: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; operators by the table: the terms and operator names of out from
        ; base on, in one hand-over
        ; Taken without the pre-passes (operation_apply#) -- no folded term
        ; and no operator name is a pair they would act on -- unless a vector
        ; literal stands among the terms: the generic pre-pass reads an
        ; operator name and a vector literal after it as a type and its
        ; arguments, and that hand-over stays with the old collapse.
        procedure operation_table(mutable this: Planner, out: Array[PlannedOperand], base: size_t) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; a lone thing between an operator and a postfix: where the source
        ; takes `(thing as T)` (tools/operation-as.py reads these lines)
        procedure operation_postfix_site(mutable this: Planner, thing: PlannedOperand, postfix: PlannedOperand) @deep true io linked

        ; The driver. Slot 23 says whether the answer is one: 0 leaves the
        ; sequence to the old collapse.
        procedure operation(mutable this: Planner, ops: Vector[PlannedOperand]) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedOperand io linked

        ; ================================================================
        ; EXPERIMENT (2026-10-04, behind SCALYC_PENDING=1): operator
        ; precedence as a protocol of PENDING types written in Scaly
        ; (tests/pending/protocol.scaly) instead of the table in
        ; collapse_operand_sequence#. `a +` answers a value of a type marked
        ; `@pending true` that waits for what follows; such a value is never
        ; bound, stored or laid out. The planner evaluates the protocol on the
        ; MODEL -- an operator name after a value is that value's operator
        ; taking only `this`, a value after a pending value is its `apply`,
        ; the end of the sequence its `finish` -- and plans what is left, an
        ; ordinary expression of real calls. Nothing of the protocol reaches
        ; the plan.
        ;
        ; Deliberately narrow: an operand of the sequence is ONE model
        ; operand; a protocol body is a name, a construction `P(args)` or a
        ; call `f(args)` / `x.m(args)`; types are not checked, a pending type's
        ; type arguments are not read; an operand a body names twice is
        ; evaluated twice. A sequence the protocol does not answer is left to
        ; the table.
        ; ================================================================
        procedure pending_on(mutable this: Planner) @ret_param_0 true @deep true returns bool io linked

        ; Is op the bare name `=`?
        function operand_is_leading_equals(op: Operand) @ret_param_0 true @deep true returns bool linked

        ; Is op a bare name made of operator characters?
        function pending_is_operator_name(op: Operand) @ret_param_0 true @deep true returns bool linked

        function pending_env_index(names: ref[Array[String]], name: String) @ret_param_0 true @deep true returns int linked

        ; The pending concept seq constructs (`P[...](...)`), or null.
        function pending_construction(this: Planner, seq: Vector[Operand]) @ret_param_0 true @deep true returns ref[Concept]? linked

        ; The body of c's member `name` -- an operator taking only `this`, or
        ; a function -- with the names of its parameters after `this`; an
        ; empty sequence when c has none.
        procedure pending_member_body(mutable this: Planner, c: ref[Concept], is_operator: bool, name: String, mutable params: ref[Array[String]]) @page true @direct true @ret_args_3 true @deep true returns Vector[Operand] linked

        ; `recv.method(args)` for a REAL receiver: a name takes the method as
        ; one more segment, a call takes it as its member access.
        procedure pending_real_call(mutable this: Planner, recv: Vector[Operand], method: String, args: Operand, mutable ok: ref[bool]) @page true @direct true @ret_args_3 true @deep true returns Vector[Operand] linked

        ; A member of the pending value recv (a construction of c), its fields
        ; and the arguments bound by name.
        procedure pending_call(mutable this: Planner, c: ref[Concept], recv: Vector[Operand], is_operator: bool, name: String, args: ref[Array[Vector[Operand]]], mutable ok: ref[bool], depth: int) @page true @direct true @ret_args_7 true @deep true returns Vector[Operand] linked

        ; One expression of the protocol's own language. The answer is in
        ; normal form: a real expression, or the construction of a pending
        ; type whose components are in normal form.
        procedure pending_eval(mutable this: Planner, seq_in: Vector[Operand], names: ref[Array[String]], vals: ref[Array[Vector[Operand]]], mutable ok: ref[bool], depth: int) @page true @direct true @ret_args_11 true @deep true returns Vector[Operand] linked

        ; The operand sequence ops read by the protocol: the real expression
        ; it folds to, or an empty sequence when the protocol does not answer.
        procedure pending_rewrite(mutable this: Planner, ops: Vector[Operand]) @page true @direct true @stores true @ret_param_0 true @deep true @deep_this_2 true returns Vector[Operand] io linked

        procedure plan_operands(
            mutable this: Planner,
            mutable ops: Vector[scalyc.compiler.Model.Operand]
        ) @page true @direct true @stores true @ret_caller true @deep true @deep_this_2 true returns Vector[PlannedOperand] io linked

        ; ================================================================
        ; plan_binding: Model.Binding → Plan.PlannedBinding.
        ;
        ; Responsibilities:
        ;   1. Plan the initializer operands (by calling plan_operands).
        ;   2. Plan the binding's annotated item, which yields the
        ;      PlannedItem with an optional PlannedType.
        ;   3. Register the binding in the current scope so later uses
        ;      resolve by name.
        ;
        ; plan_binding now collapses the operation sequence. Stack-array
        ; type detection (`[T, N]` at binding site) is deferred.
        ; ================================================================

        ; Drop a LEADING `=` from a binding initializer (the assignment
        ; form `let x = value` → operands `[=, value]`). `=` is also the
        ; comparison operator, so a NON-leading `=` (`let r a = b`) must be
        ; kept — it collapses to the comparison `r = (a == b)`. Mirrors the
        ; stage-0 index-0 if in Planner.cpp::planBinding.
        function strip_leading_eq(ops: Vector[PlannedOperand]) @page true @direct true @deep true returns Vector[PlannedOperand] linked

        procedure plan_binding(mutable this: Planner, mutable b: Binding) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedBinding io linked

        ; ================================================================
        ; plan_action / plan_return / plan_break / plan_throw.
        ;
        ; Each wraps a Vector[Operand] into the appropriate Planned*
        ; variant. plan_action collapses its source + target operand
        ; sequences via collapse_operand_sequence (which folds binary
        ; ops, method chains, is/as, and prefix ops); result_type takes
        ; the collapsed source's type.
        ; ================================================================

        ; unknown_identifier_name: when a collapsed operand is a bare,
        ; chain-free, SINGLE-segment Type expression that names nothing
        ; reachable — not a local (that would have planned as Variable),
        ; module global, function (a bare top-level function name is a
        ; legal function-pointer value), concept, delegate, operator,
        ; primitive, or generic type parameter — return that name;
        ; otherwise "". Such an operand emits as null downstream and used
        ; to drop the enclosing statement SILENTLY. Dotted names keep the
        ; lenient path (namespace machinery owns them).
        procedure unknown_identifier_name(mutable this: Planner, op: PlannedOperand) @page true @direct true @deep true returns String linked

        ; retarget_bare_variant: a variant written by its BARE name is built on
        ; the union the declared TARGET type names (2026-09-25). The payload
        ; rescue for `Hit(5)` took the FIRST registered union declaring `Hit`,
        ; so beside a second such union the construction was of the wrong type
        ; and every position reported that (`Other where Reply is declared`,
        ; `function not found`); and `None` for a `returns Option[int]` was an
        ; unknown identifier because a generic union's unit variant has no type
        ; arguments without a target. Called at the declared-type positions --
        ; an explicit and an implicit return, a typed binding, a `set` -- ahead
        ; of their unknown-name and conformance reports. A qualified
        ; `Union.Variant` is never moved, nor is an Option of a reference (its
        ; empty case is `null`).
        procedure retarget_bare_variant(mutable this: Planner, target: PlannedType, op: PlannedOperand) @page true @direct true @deep true returns PlannedOperand linked

        ; bare_variant_arg_hint: the reason a call with a bare-variant ARGUMENT
        ; found no function -- an argument is not a declared-type position
        ; retarget_bare_variant# serves, so `tag(Hit(6))` beside two unions
        ; declaring `Hit` built the first one and matched nothing.
        procedure bare_variant_arg_hint(mutable this: Planner, args: Vector[PlannedOperand]) @page true @direct true @ret_caller true @deep true returns String linked

        ; report_ambiguous_bare_variant: an UNTYPED binding of a variant written
        ; by its bare name that more than one union declares -- nothing says
        ; which union is meant, and the payload rescue built the first one.
        procedure report_ambiguous_bare_variant(mutable this: Planner, op: PlannedOperand) @deep true linked

        ; unions_declaring: how many registered unions declare a variant of
        ; this name (bare_variant_arg_hint#).
        procedure unions_declaring(mutable this: Planner, name: String) @ret_nonlocal true @deep true returns int linked

        ; retarget_bare_arg: a variant written by its bare name as the index-th
        ; of count call ARGUMENTS takes the union of that parameter -- when
        ; every non-generic candidate of the name with that arity that declares
        ; the variant there agrees on ONE union (2026-09-26). Before, the
        ; payload rescue built the first registered union declaring it and the
        ; call found no function; `f(None)` was an unknown identifier. A
        ; disagreement leaves the argument as it was, and `function not found`
        ; names the bare variant (bare_variant_arg_hint#).
        procedure retarget_bare_arg(mutable this: Planner, fn_name: String, index: size_t, count: size_t, op: PlannedOperand) @page true @direct true @deep true returns PlannedOperand io linked

        ; arg_is_bare_variant_of: the j-th argument is a variant written by its
        ; bare name that the parameter's union declares (the method gate's
        ; exemption; the argument fold then builds it on that union).
        procedure arg_is_bare_variant_of(mutable this: Planner, arg_ops: Vector[PlannedOperand], j: size_t, param: PlannedType) @ret_param_0 true @deep true returns bool linked

        function is_bare_variant_start(this: Planner, start: size_t) @ret_nonlocal true @deep true returns bool linked

        ; unit_variant_owner: the ONE non-generic union that declares a
        ; payload-less variant of this name, or "" when none or several do
        ; (try_plan_unit_variant#). A generic union is left out: its unit
        ; variant has no type arguments to construct with.
        procedure unit_variant_owner(mutable this: Planner, name: String) @page true @direct true @ret_caller true @deep true returns String linked

        ; Enter the unit variants of every union registered since the last
        ; ask. Counted first, so a table past half load is rebuilt from the
        ; whole registry before anything is entered.
        procedure index_unit_variants(mutable this: Planner) @deep true linked

        ; how many payload-less variants concepts[ci] declares when it is a
        ; non-generic union, else 0
        function unit_variant_count(this: Planner, ci: size_t) @ret_nonlocal true @deep true returns size_t linked

        ; One more union at concepts[ci] declares `vname`: the first owner is
        ; entered, a differently NAMED second one makes the name ambiguous (a
        ; union registered twice under one name is one owner, as the scan's
        ; `owner <> kv.key` test had it).
        procedure note_unit_variant(mutable this: Planner, vname: String, ci: size_t) @deep true linked

        ; The exemption battery of unknown_identifier_name#, as its own
        ; question so the bare name and the head of a dotted one are judged by
        ; ONE rule. (A name declared two ways is exempt either way: this
        ; answers "something in scope carries this name", not "which".)
        ; (a procedure, not a function: the lookups memoize through `this`)
        procedure name_resolves_to_something(mutable this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; ====================================================================
        ; ★★★`&fn` ON A FUNCTION THAT TAKES AN IMPLICIT CALLER PAGE (2026-09-20).
        ; The address-of path mangles with the page the source DECLARES; the
        ; definition's name comes from function_needs_caller_page#, which also
        ; asks the BODY. Widen one Option deep in the call graph and the
        ; definition silently becomes `_Z9jit_applyPN4scaly6memory4PageEPvPv`
        ; while `&jit_apply` still emits `_Z9jit_applyPvPv` -- and the ONLY
        ; evidence is `ld: symbol(s) not found`, with no line and no relation to
        ; the change that caused it.
        ;
        ; ★★★Why a DIAGNOSTIC and not a corrected mangling, which is the obvious
        ; fix and is WORSE: the helpers this bites are pinned to a `(void*,
        ; void*)` C ABI by the code that calls them through the pointer, so a
        ; page-taking definition is an ABI break whatever it is called. The
        ; undefined symbol is the guard; this turns it into a sentence.
        ;
        ; ★The exit for a real case is to keep the body ALLOCATION-FREE: an NPO
        ; return falls through to body_may_allocate#, so splitting a cold
        ; reporting half into its own function is usually all it takes.
        ; ====================================================================
        ; function_ref_candidate#: the function `&name` takes the address of
        ; (2026-09-28). The reference took the FIRST function registered under
        ; the name, and the stdlib's externs are registered before a program's
        ; own code: `&read` in a program with `procedure read(req, res)` was
        ; libc's read, at rc 0 — an HTTP router called read(2) with a request
        ; and a response. A call chooses by its arguments and by
        ; lookup_functions_preferring#; an address has no arguments, so: the
        ; candidates a bare call can mean, a Scaly function over an extern of
        ; the same name, and when two Scaly functions remain, rc 4 — an
        ; address names ONE function (fn_ptr_nary: no overloads).
        procedure function_ref_candidate(mutable this: Planner, name: String, loc: Span) @page true @direct true @ret_caller true @deep true returns ref[Function]? linked

        procedure report_address_of_page_function(mutable this: Planner, mutable f: Function, loc: Span) @deep true io linked

        ; report_unknown_identifier: the same message the four inline
        ; unknown-name checks build (binary operand, `set` target, `set` source,
        ; binding initializer) — name, use-visibility hint, report. A helper
        ; rather than a fifth copy because the CALL ARGUMENT site sits inside
        ; collapse_operand_sequence# and must stay a SINGLE statement: an inline
        ; branch there perturbs the s178 alloca pool (see
        ; resolve_static_method_on# for the same reasoning). The four inline
        ; copies are deliberately left alone — rewriting them buys nothing and
        ; each one would have to be re-proved emission-neutral.
        ;
        ; The argument position was the one place a name that resolves to
        ; NOTHING travelled without a word. `Box.twice(nosuchname, 3)` and
        ; `x.twice(nosuchname)` both planned with rc 0 and passed whatever the
        ; slot held; on a free function the same typo was reported only
        ; INDIRECTLY, as "function not found: twice" — the unknown argument
        ; gets a fresh type variable, no overload matches, and the message
        ; names the callee instead of the typo. Reporting at the argument
        ; makes all three shapes say the same true thing.
        ; ── Arity of a call that PREPENDS ITS RECEIVER (2026-08-15).
        ;
        ; A dotted call on a value receiver passes the receiver as argument 0, so
        ; the receiver always occupies ONE parameter — but WHICH one depends on
        ; the member:
        ;
        ;   `s.length()`        declares `this`  -> receiver binds `this`
        ;   `old.is_equal(gid)` this-LESS        -> receiver fills its FIRST
        ;                                           declared parameter, and gid
        ;                                           fills the second
        ;                                           (dazzle/ELObj.scaly:970)
        ;
        ; ★★★ WHY THIS CANNOT LIVE IN lookup_method#, where the other arity gate
        ; is: that function serves a THIRD shape it cannot tell from the second —
        ; a this-less member called UNQUALIFIED from a sibling
        ; (`allocate_page()` inside Page.allocate_exclusive_page), where nothing
        ; is prepended and args = params exactly. Its gate therefore accepts both
        ; readings, and that disjunction is what let the defect through.
        ; Tightening it there was tried and REFUTED by the build: the stdlib's own
        ; Page.allocate_page / Page.release_page sibling calls fail it. The
        ; distinguishing fact — is there a receiver at all — exists only at the
        ; call site, which is here.
        ;
        ; What was silent before: `this.one(21)` against a this-less
        ; `one(c: int)` planned with rc 0 and emitted
        ; `call @one(ptr this, i64 21)` into a ONE-parameter function. The
        ; receiver landed in `c`, the real argument was dropped, and emit_call
        ; builds the callee type from the ARGUMENTS so llc saw nothing wrong
        ; either. Found porting the TypeScript scanner: a this-less predicate
        ; answered its own receiver's address, so an identifier scan never
        ; advanced and the loop spun until the process was killed.
        ;
        ; A SINGLE statement at the call site, and the work in here, because an
        ; inline branch inside collapse_operand_sequence# perturbs its s178
        ; alloca pool — the same discipline report_unknown_identifier# follows.
        ; Conservative on anything it cannot judge (no match, no recorded
        ; parameter types): silence beats a false diagnostic in a gate this
        ; broad.
        ; report_null_into_ref#: `ref[T]` is a BORROWED REFERENCE and the docs
        ; have always said so -- `docs/scaly/chapters/types.xml` reserves the
        ; nullable spelling `ref[T]?` for a slot that may hold nothing. Nothing
        ; enforced it, because `ref` and `pointer` are one representation and
        ; null flows into either; so the 2026-08-23 port conversion carried the
        ; ports' nullability across unchanged and 630-odd declarations began
        ; claiming a reference exists where the code stores null. This makes the
        ; claim checkable at the four positions where a TARGET TYPE is in hand.
        ;
        ; Deliberately narrow: it judges the bare `null` LITERAL against a
        ; declared `ref[T]`, not the general flow of an Option into a
        ; non-optional. The wider question -- may a `ref[T]?` be passed where a
        ; `ref[T]` is declared -- is a separate one and is still allowed, so
        ; this is a diagnostic about DECLARATIONS, not yet a non-null proof.
        ; An `Option[ref[T]]` target (the `?` spelling, Modeler s113) is exactly
        ; what the fix is, so it must never fire on one -- the name test does
        ; that, since the wrapper arrives named "Option".
        ;
        ; ONE statement at each call site: an inline branch in the hot planners
        ; perturbs the s178 alloca pool (six -g checks, measured).
        procedure report_null_into_ref(
            mutable this: Planner,
            target_type: PlannedType,
            source: PlannedOperand,
            loc: Span
        ) @deep true linked

        ; operand_is_null_through_casts#: a bare `null` LITERAL, seen through
        ; any number of `as` wrappers. `null as pointer[X]` is the same value
        ; and the same claim as `null` -- the cast relocates nothing and proves
        ; nothing -- so a gate that asks operand_is_null_constant# alone can be
        ; stepped around by spelling the cast, and the corpus PREFERRED that
        ; spelling: of the 85 argument-position findings swept on 2026-08-27,
        ; 21 were written `null as pointer[X]`. Same lesson as the trailing-`as`
        ; class in the page walkers: no question ABOUT a value may be answered
        ; by the cast sitting on top of it.
        function operand_is_null_through_casts(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; report_null_into_ref_arg#: the ARGUMENT position -- the ONE place
        ; null still reaches a non-optional `ref[T]`, and the reason it does is
        ; deliberate everywhere else. `report_null_into_ref#` judges the four
        ; positions that carry a DECLARED type, and `type_conformance_accepted#`
        ; class 2 refuses an Option at those same four; an argument is judged by
        ; neither, because `null` plans as `pointer[void]` and types_compatible#
        ; accepts THAT for every pointer and every ref parameter BY INTENT --
        ; overload resolution rests on it. So the call resolves, plans, mangles
        ; and emits in silence, and the callee holds a reference its own
        ; declaration says cannot be null.
        ;
        ; Swept before the gate existed (tools/nullref/nullarg.py): 85 sites
        ; over 40 declarations, and 37 of the 40 NEVER TEST the parameter --
        ; they forward it -- which is why every body-reading sweep of the
        ; nullref campaign had missed the whole class. A forwarder tests
        ; nothing; only its call sites know.
        ;
        ; ★Alignment is copied from coerce_string_args_to_cstr# and must stay
        ; copied: param_types EXCLUDES `this` in every resolution path, so the
        ; user arguments are TAIL-aligned and a prepended receiver or implicit
        ; page argument is absorbed by the offset. The two guards are that
        ; discipline: nothing to say when there are no parameter types, and a
        ; shorter argument list than parameter list is an arity question the
        ; arity gates own.
        ;
        ; ★Narrow on purpose, in the same two ways report_null_into_ref# is: it
        ; judges a null LITERAL and not the general flow of an Option (which
        ; types_compatible# already refuses at a parameter, so every call site
        ; spells the `x as ref[X]` unwrap), and it never fires on the `?`
        ; spelling, since the s113 wrapper arrives named "Option".
        procedure report_null_into_ref_arg(
            mutable this: Planner,
            mutable args: Vector[PlannedOperand],
            param_types: Vector[PlannedType],
            callee: String
        ) @deep true linked

        ; report_null_into_ref_field#: the CONSTRUCTION arm of the argument
        ; gate, and it needs its own because a construction handed a bare
        ; `null` never reaches the call funnels at all. The init match is what
        ; diverts it: `null` plans as `pointer[void]` and types_compatible#
        ; accepts that for NO ref parameter, so `check_initializer_match`
        ; rejects the init and the construction falls through to the
        ; POSITIONAL TUPLE path -- where the argument lands in the field
        ; directly and no declared parameter is ever consulted. That is why
        ; `Rec(null)` was silent while `obj.m(null)` was not.
        ;
        ; ★It asks the ARGUMENT TYPE, not an operand, because this path has no
        ; operands -- and it can: the bare null literal IS the type
        ; `pointer[void]` mangled "Pv" (make_null_type), which is the same test
        ; the "no matching initializer" exemption thirty lines up already makes
        ; for the same reason. ★A `null` into an OPTIONAL field stays correct
        ; and stays silent: the s113 wrapper arrives named "Option", so the
        ; `ref` name test excludes it, exactly as in the other two gates.
        procedure report_null_into_ref_field(
            mutable this: Planner,
            mutable s: Structure,
            arg_types: Vector[PlannedType],
            loc: Span
        ) @deep true @deep_this_2 true io linked

        ; The message half, split out for the reason report_null_into_ref#
        ; splits its own: the walk above stays one statement per branch.
        procedure report_null_arg(mutable this: Planner, param_type: PlannedType, loc: Span) @ret_nonlocal true @deep true linked

        ; option_arg_into_plain_ref#: the OTHER half of the argument gate, and
        ; the half its own comment assumed away. report_null_into_ref_arg#
        ; judges a null LITERAL because "the general flow of an Option is
        ; refused by types_compatible# at a parameter" -- true on the FREE
        ; function path, where check_function_match# compares every argument,
        ; and FALSE on the method path: lookup_method# takes a single by-name
        ; candidate unexamined (its selection loop is gated on candidates > 1),
        ; and the gate that exists for exactly that reason,
        ; report_method_arg_types#, compares the pair only AFTER
        ; gate_strip_indirection# has taken the Option off one side and the ref
        ; off the other -- its own comment says the stripped pair "only ever
        ; ADDS acceptance", and an accepted null is what it adds.
        ;
        ; Measured 2026-08-28 with three probes one line apart: a literal
        ; `null` through a method is rc 4, an Option through a FREE function is
        ; rc 4, and an Option through a METHOD planned at rc 0 while the binary
        ; exited 139 -- a SIGSEGV at the first member hop, precisely the
        ; failure exit 21 was written to replace. The trap cannot fire there,
        ; because no unwrap is emitted where no conformance was ever demanded.
        ;
        ; The question is NULLABILITY ALONE, so the pointees must still agree:
        ; a genuine type mismatch is report_method_arg_types#'s to report, and
        ; telling its author to write an unwrap would be wrong advice.
        ;
        ; Ask the SHAPE, not the name -- both `ref[T]?` and `pointer[T]?`
        ; arrive as an Option around something pointer-shaped, and a name test
        ; that knows only "ref" is the standing bug of this seam.
        procedure option_arg_into_plain_ref(param_type: PlannedType, mutable arg_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; The operand-level question: the type rule above, minus every name a
        ; null test has already PROVEN in this branch. Narrowing is a fact
        ; about the NAME (define_narrowed#), never a type change, so it can
        ; only be asked here -- and it is what separates a guarded forward
        ; from a lie. Measured on the untouched tree: 2459 sites report
        ; without it, 1222 of them behind a guard the author already wrote.
        procedure option_arg_reaches_plain_ref(mutable this: Planner, param_type: PlannedType, mutable arg: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; The message names the unwrap, because there IS no flow narrowing of
        ; the TYPE: a caller who has just tested the value still owes the
        ; cast, and that cast is where the exit-21 trap is emitted.
        procedure report_option_arg(mutable this: Planner, param_type: PlannedType, arg_type: PlannedType, loc: Span, callee: String, index: size_t) @ret_nonlocal true @deep true linked

        ; report_type_mismatch#: does the value actually CONFORM to the type
        ; the declaration claims? Nothing asked. `current_return_type` and the
        ; binding/`set` target types were only ever READ -- for the literal
        ; retype, the char/float fold, the cstr wrap, the tail promotion and
        ; the three `ref` gates -- and never used as an ACCEPTOR, while
        ; types_compatible# ran at ten sites, every one of them a PARAMETER.
        ; So a `return` was unchecked in both directions. Measured on the
        ; untouched tree, all rc 0 and silent:
        ;   returns ref[Alpha]?  /  return x   (x: ref[Beta])
        ;       -> `ret ptr %0` -- two unrelated concepts confused outright
        ;   returns int          /  return x   (x: ref[Alpha])
        ;       -> `ret i64 0`  -- not even the address, a zero
        ; and the same hole at a typed binding (`let q: ref[Alpha]? x`).
        ;
        ; The acceptor is types_compatible# deliberately, NOT types_equal#:
        ; the looseness it carries is the language's own (integer family,
        ; String -> pointer[const_char], null -> Option, and s96/s170 letting
        ; a concrete pointer[T] stand for ref[T]?). That last one is exactly
        ; the shape that prompted this check and it must keep passing -- what
        ; was wrong was never that `pointer[T]` answered a `ref[T]?`, it was
        ; that nobody asked.
        ;
        ; ONE statement at each call site: an inline branch in the hot
        ; planners perturbs the s178 alloca pool (six -g checks, measured) --
        ; the discipline report_null_into_ref# and report_unknown_identifier#
        ; already follow.
        ;
        ; ★★★ THE CALIBRATION IS THE WHOLE STORY, and the numbers are the
        ; argument: with types_compatible# alone this reported 4683 findings
        ; over the twenty-one package roots, and every reduction came from
        ; READING them rather than counting them. 4683 -> 205 once a region
        ; construction and an Option-into-non-optional were accepted, 205 -> 12
        ; with union variants, pointer[void] and pointee equality, 12 -> 4 with
        ; the four gaps the findings themselves named -- of which three were
        ; statements about THIS FILE, not about the ports: qualified names not
        ; normalised, pointer[void] refusing a reference-shaped source, and a
        ; nested variant construction reporting its innermost payload.
        ; ★ The residue was 3 sites, all genuine, and the precision worth
        ; recording: `return vm.fail()` appears FOURTEEN times in
        ; dazzle/Insn.scaly and exactly the TWO inside a routine returning
        ; something other than ref[Insn]? were reported.
        ; Does this type's HEAD name a concept this root laid out, a
        ; primitive, or one of the language's own wrappers? Anything else is
        ; an unresolved name wearing a type's clothes.
        procedure type_head_is_resolvable(mutable this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked
        procedure type_conformance_unjudgeable(
            mutable this: Planner,
            target_type: PlannedType,
            source: PlannedOperand
        ) @ret_nonlocal true @deep true returns bool linked
        ; Is `t` the untyped pointer `pointer[void]`?
        function type_is_void_pointer(t: PlannedType) @deep true returns bool linked

        ; Strip one `Option` wrapper and then one `pointer`/`ref` wrapper off
        ; `target_type`, and ask whether what remains IS `source_type`.
        function type_is_pointee_of(target_type: PlannedType, source_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; type_conforms_as_variant#: a UNION accepts any of its variants'
        ; payloads directly -- `return JsonNull()` from a `returns JsonValue`
        ; function is the documented construction, not a mismatch. This is the
        ; question lookup_variant_tag# already answers (it keys on the PAYLOAD
        ; TYPE's name, which is what `choose ... when TypeName:` needs), so the
        ; check borrows it rather than re-deriving the union's arm list.
        procedure type_conforms_as_variant(mutable this: Planner, target_type: PlannedType, source_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; ... and NESTED, because a nested variant construction reports the
        ; INNERMOST payload's type. `Expression.Constant(Constant.Integer(
        ; IntegerConstant(...)))` arrives as `IntegerConstant` against a
        ; declared `Expression`, and `IntegerConstant` is a payload of
        ; `Constant`, which is a payload of `Expression` -- two levels down.
        ; The depth is bounded rather than trusted: a union reachable from
        ; itself would otherwise not terminate, and three levels covers every
        ; shape in the tree with one to spare.
        procedure variant_payload_accepts(mutable this: Planner, union_name: String, source_name: String, depth: int) @ret_nonlocal true @deep true returns bool linked

        ; Do two type names agree once each is reduced to its LAST dotted
        ; segment? `Option[ref[PlannedUnion]]` and
        ; `Option[ref[scalyc.compiler.Plan.PlannedUnion]]` are ONE type spelled
        ; two ways, and types_equal# compares the names whole -- so the
        ; qualified spelling disagrees with itself. Compared byte-wise from
        ; each name's own tail rather than through substring#, which would
        ; allocate a String per comparison.
        function name_tails_equal(a: String, b: String) @ret_nonlocal true @deep true returns bool linked

        ; types_equal# modulo package qualification, at every generic level.
        ; Deliberately NOT folded into types_equal# itself: that function is
        ; what overload SELECTION ranks on, so loosening it could change which
        ; function a call picks anywhere in the tree. Here it can only ever
        ; suppress a diagnostic.
        function types_equal_unqualified(a: PlannedType, b: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; A subscript's index read as its value when it is a reference to a
        ; scalar: `block[at]` with `at: ref[size_t]` indexed by the ADDRESS
        ; (a bounds trap on a Slice or an Array, pointer arithmetic with an
        ; address on a pointer), because none of the declared-type positions
        ; deref_ref_into_pointee# serves is a subscript's (2026-09-29, the
        ; http package's HPACK decoder; ref_index_subscript).
        procedure subscript_index_value(mutable this, mutable op: PlannedOperand) @page true @direct true @deep true returns PlannedOperand linked

        ; Peel ONE `pointer`/`ref` wrapper off `t` into `out`, answering
        ; whether there was one to peel.
        procedure type_strip_one_reference(t: PlannedType, mutable out: ref[PlannedType]) @ret_nonlocal true @deep true @deep_into_1_1 true returns bool linked

        ; Is this type a borrowed/raw reference, in any of its three spellings?
        function type_is_reference_shaped(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; The one-byte char family, including `const_char`, which
        ; is_integer_type# does not list. is_char_like_cross_compatible# is the
        ; established question but its `char` arm omits `const_char` while its
        ; `const_char` and `i8` arms both name `char` -- an asymmetry left
        ; alone here on purpose, since that helper feeds types_compatible#'s
        ; pointer-inner rule and widening it would reach overload resolution.
        function type_conformance_char_family(target_type: PlannedType, source_type: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; type_conformance_accepted#: the acceptor, and it is deliberately
        ; the LOOSE one. types_compatible# alone reported 4683 findings over
        ; the package roots, and reading them rather than counting them showed
        ; two structural classes that are the LANGUAGE, not defects:
        ;
        ;   1. `T where pointer[T]` -- a REGION CONSTRUCTION. `Vector[T]^page(n)`
        ;      yields a pointer while its result_type names the object, so
        ;      `set vector: Vector[T]^own_page(capacity)` looked like a value
        ;      assigned to a pointer slot. region_value_matches_pointer# is the
        ;      question that already exists for exactly this seam (it is what
        ;      init-argument resolution asks), so it is asked here too.
        ;      Biggest single class in the raw run.
        ;   2. `Option[ref[X]] where pointer[X]` -- an Option flowing into a
        ;      NULLABLE target. A `pointer[T]` may hold null by construction
        ;      (that is the whole difference between the two spellings), so
        ;      unwrapping the NPO wrapper onto one loses no claim: both sides
        ;      say the same thing about null. Into a `ref[T]` -- or into any
        ;      value type -- it is REFUSED, because `ref` means non-null:
        ;      report_null_into_ref# already says so about a literal null, and
        ;      an Option is that same null one hop further on. There is no flow
        ;      narrowing here, so a caller that has PROVEN the value non-null
        ;      says so with the explicit `x as ref[X]` unwrap, which is exactly
        ;      what the ARGUMENT position has always demanded --
        ;      types_compatible# has no rule accepting an Option into a plain
        ;      `ref` parameter. Permitting it at the four declared-type
        ;      positions made one language have two answers for one question.
        ;
        ; Both are asked AFTER types_compatible#, so the common answer stays
        ; one call.
        procedure type_conformance_accepted(target_type: PlannedType, mutable source_type: PlannedType) @ret_nonlocal true @deep true returns bool linked
        ; make_deref_operand#: build the operand the prefix `*` collapse
        ; builds, for a value that is already planned.  Same intrinsic
        ; operator call, same mangled name, same result type -- so a
        ; transparent read emits byte-identically to the `*r` it replaces.
        procedure make_deref_operand(
            mutable this: Planner,
            op: PlannedOperand,
            elem: PlannedType
        ) @page true @direct true @ret_caller true @deep true returns PlannedOperand linked

        ; deref_ref_into_pointee#: a `ref[T]` reaching a context that wants a
        ; `T` IS that value.  Transparent reading is what a borrowed reference
        ; MEANS, and `*r` is the pointer idiom it replaces.
        ;
        ; Nothing loaded here until 2026-08-27 and EVERY read position was
        ; silently wrong, at rc 0: `return r` and `let v: int r` emitted
        ; `ret i64 0`, a call argument passed the ADDRESS as an int (measured
        ; 6090403468), a cast truncated it, and only `*r` answered correctly.
        ; type_conformance_accepted#'s class 8 already ACCEPTS the shape --
        ; indirection is deliberately not its subject -- so the acceptance was
        ; there and only the load was missing.
        ;
        ; The NULLABLE spelling `ref[T]?` is deliberately NOT loaded: that is
        ; the null claim the three ref gates rest on, and such a site has to
        ; spell the `x as ref[T]` unwrap it is relying on.
        ; Does `op` need that load against `target_type`?  The predicate is
        ; separate so a call site that must know WHETHER it converted can ask
        ; -- the same split `operand_retypes_to_integer` /
        ; `retype_integer_operand` uses.
        procedure operand_derefs_to_pointee(mutable target_type: PlannedType, mutable op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; address_of_is_identity#: does `&x` hand back the operand ITSELF?
        ;
        ; MEASURED against the emitter, shape by shape. `&` yields the address of
        ; a SLOT where there is one and the operand's own value where there is
        ; not:
        ;   a ref/pointer PARAMETER, a `let`-bound reference   `ret %0`   identity
        ;   `var r: ref[X] b` / `ref[X]? null` / `pointer[X] null`  `ret %r`  the cell
        ;   a stack-struct var, a heap-bound var               the object    wrap
        ;   a member access `&r.field`                         a GEP        wrap
        ; The identity case is therefore exactly a BARE reference-shaped variable
        ; that is not mutable -- one with no slot of its own to address.
        ;
        ; ★★★ Before this the planner wrapped unconditionally, so `&b` on a
        ; `ref[Box]` was typed `ref[ref[Box]]` while the emitter handed back `b`.
        ; type_conformance_accepted#'s class 8 exists ONLY to accept that lie,
        ; and every rule that counts indirection had to stay lenient by exactly
        ; the level it was counting in order to survive it -- which is how
        ; operand_derefs_to_pointee# came to skip a load it owed
        ; (ref_cell_nonoptional.scaly). **A rule that has to be inexact to
        ; tolerate a wrong type is the wrong type's cost, paid somewhere else.**
        function address_of_is_identity(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; set_target_stores_through#: `set r: v` on a `ref[T]` target.
        ;
        ; A borrowed reference cannot be rebound through a name it does not
        ; own, so the useful reading is the C++ one -- the assignment writes
        ; the POINTEE.  Until 2026-08-27 it wrote nothing at all: the target is
        ; not `is_mutable` (a parameter never is), the Variable arm returned
        ; early, and the statement vanished at rc 0 with no diagnostic.
        ;
        ; The RHS decides, which is the only rule that can serve both: a value
        ; of the pointee type stores THROUGH, a reference of the target's own
        ; type REBINDS (a nullable local's ordinary move).  Judged with the
        ; conformance relation, so every shape it already accepts -- a
        ; construction standing for a reference, an erased instantiation --
        ; behaves the same here.
        ; The pointee of a `ref[T]`/`pointer[T]`, or the type itself when
        ; there is nothing to peel.
        procedure strip_one_reference_or_self(mutable t: PlannedType) @page true @direct true @ret_param_0 true @deep true returns PlannedType linked

        ; Is this operand a bare MUTABLE variable, i.e. a `var` local?  A
        ; parameter and a `let` are not, and that is what decides an ambiguous
        ; `set` -- see set_target_stores_through#.
        ; operand_is_rebindable_target#: may a `set` on this target put a REFERENCE
        ; into it rather than store through it? A mutable variable can be rebound,
        ; and so can the SLOT a pointer dereference names: `set *(p + i): r` with
        ; `p: pointer[ref[X]]` writes the reference into the buffer. Answering
        ; false there made set_target_stores_through# read the element store of
        ; every generic container instantiated on a non-optional reference --
        ; `Array[ref[X]].add`, `Vector[ref[X]].put` -- as a copy THROUGH the
        ; still uninitialized slot: `load ptr` + `store %X`, SIGSEGV on the first
        ; `add` (2026-09-14, tscaly's semver range; regress
        ; array_of_ref_elements).
        ; ★ A dereference of a POINTER only. `*r` on a non-optional `ref[T]` is
        ; refused by report_deref_of_ref#, and `*opt` on a `ref[T]?` names the
        ; referent, which is not a slot the statement may re-point.
        function operand_is_rebindable_target(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function operand_is_mutable_variable(op: PlannedOperand) @ret_param_0 true @deep true returns bool linked

        ; ref_pointee_may_be_null#: is the POINTEE of this `ref[T]` itself a
        ; slot that may hold nothing?
        ;
        ; The question BOTH null gates have to ask before they judge a
        ; reference, and the one neither asked.  A `ref[ref[X]?]` -- the
        ; pointer-pointee out-cell -- is a reference that always refers to
        ; something, and what it refers to is an Option: `set r: null` writes
        ; the pointee and `r = null` reads it, so neither statement is the lie
        ; the gates were built to catch.  Judging the reference refused both
        ; spellings, while `*r` is refused by report_deref_of_ref#, and the
        ; tree was left with no way to say either thing.
        ;
        ; ★★★ IT SERVES THE WRITE SIDE ONLY, and that was measured rather than
        ; reasoned.  `set r: null` reaches the pointee because
        ; set_target_stores_through# rewrites the target into the deref; a
        ; comparison `r = null` does NOT -- it takes the NPO presence-test path
        ; and never loads -- so report_null_test_on_ref# keeps its verdict and
        ; says so in as many words.  The first draft exempted both and turned a
        ; true diagnostic into a constant comparison.
        ;
        ; ★ `pointer` counts as well as `Option`: a pointer pointee is nullable
        ; by construction, which is the same reason report_null_into_ref#
        ; leaves a `pointer[T]` TARGET alone.
        procedure ref_pointee_may_be_null(mutable t: PlannedType) @ret_param_0 true @deep true returns bool linked

        ; null_set_target#: which type report_null_into_ref# must judge for a
        ; `set` whose source is the bare null literal.
        ;
        ; `set r: null` on a `ref[T]` has exactly ONE reading -- a borrowed
        ; reference cannot be rebound to nothing, so the assignment writes the
        ; POINTEE, which is set_target_stores_through#'s rule for every other
        ; source.  When that pointee is itself nullable the statement is
        ; correct and the gate must judge the POINTEE, not the reference
        ; around it.
        ;
        ; ★★★ It was found by CONVERTING, not by reading: the pointer-pointee
        ; out-cell `out: ref[ref[X]?]` -- the route CLAUDE.md records as proven
        ; and never executed -- opens with `set out: null` at nearly every one
        ; of its sites, and the tree had NO spelling left for it.  Judging the
        ; reference refused the honest form, while `set *out: null` is refused
        ; by report_deref_of_ref#, so the two gates closed on each other and
        ; the only way through was a scratch local (`var nothing: ref[X]? null`
        ; then `set out: nothing`) -- a workaround for a statement the language
        ; should simply accept.
        ;
        ; A pointee that is NOT nullable keeps the reference's own verdict:
        ; storing null through into a non-optional pointee is the same lie one
        ; level in, and `ref[int]` must still refuse it.
        ;
        ; ★ A BARE target only, for set_target_stores_through#'s reason -- a
        ; member-access chain names the REFERENCE, not the pointee -- and the
        ; two must agree, or the gate would fall silent on a statement the
        ; rewrite does not take.
        procedure null_set_target(mutable target: PlannedOperand) @page true @direct true @ret_param_0 true @deep true returns PlannedType linked

        procedure set_target_stores_through(mutable this: Planner, mutable target_type: PlannedType, mutable source_type: PlannedType, target_is_mutable: bool) @ret_nonlocal true @deep true returns bool linked

        ; report_unassignable_ref_target#: a `set` whose target is a
        ; NON-MUTABLE reference and whose source stores through nothing.
        ;
        ; The emitter's Variable arm returns without storing when the target is
        ; not `is_mutable`, so such a statement is a SILENT no-op -- which is
        ; how three `store %Entity` vanished out of opensp's
        ; parse_external_entity when a variant payload was not recognised as
        ; conforming to its union (the corpus went 380/380 to 287/380, every
        ; failure an entity or a subdoc). The store-through rewrite is what
        ; normally saves such a statement; when it does not fire, saying so is
        ; the only thing between the author and a dropped assignment.
        procedure report_unassignable_ref_target(
            mutable this: Planner,
            target: PlannedOperand,
            loc: Span
        ) @deep true linked

        procedure deref_ref_into_pointee(
            mutable this: Planner,
            mutable target_type: PlannedType,
            mutable op: PlannedOperand
        ) @page true @direct true @deep true returns PlannedOperand linked

        ; report_integer_narrowing#: a WRITE into a narrower integer is spelled
        ; with its cast. types_compatible#'s Rule 2 accepts every integer for
        ; every other, which is right for READING (the emitter widens, and since
        ; 2026-09-17 a typed binding and a right operand widen by their own
        ; signedness) and silent for WRITING: `set n.pos: offset` into an i32
        ; field kept the low half of an int at rc 0. Decided 2026-09-17 with the
        ; author: reads widen implicitly, a narrowing store says `as i32`.
        ;
        ; Judged at the typed binding and the `set`, the two positions a write
        ; takes; a bare literal that FITS is exempt because it is retyped to the
        ; target (operand_retypes_to_integer#), an explicit `as` is exempt
        ; because its result already has the target's width.
        procedure report_integer_narrowing(
            mutable this: Planner,
            target_type: PlannedType,
            source: PlannedOperand,
            loc: Span,
            position: String
        ) @deep true linked

        procedure report_type_mismatch(
            mutable this: Planner,
            target_type: PlannedType,
            mutable source: PlannedOperand,
            loc: Span,
            position: String
        ) @deep true linked

        ; report_ref_arithmetic#: `&x` yields ref[T], and arithmetic on a
        ; BORROWED REFERENCE is not a reference operation -- it is pointer
        ; arithmetic, which is what `pointer[T]` is for. Without this the
        ; operand falls past the pointer-arith fallback with a fresh type var,
        ; and emit_intrinsic_binary_op's GEP then uses BYTE stride: measured,
        ; `&b + 1` on a two-field struct stepped 1 byte instead of 16, with no
        ; diagnostic anywhere. That silent miscompile is the whole reason this
        ; check has to land in the SAME commit as `&`-yields-ref. The exit is a
        ; deliberate cast -- `(&b as pointer[Box]) + 1` -- which restores the
        ; element stride, so the twelve hand-rolled buffers in opensp/dazzle
        ; need one line each and the language needs no exception rule.
        ; ONE statement at the call site: an inline branch in
        ; collapse_operand_sequence# perturbs its s178 alloca pool (six -g
        ; checks, measured).
        ; Is this planned type an `Option` whose sole generic argument is a
        ; `ref`, i.e. the NPO spelling `ref[T]?`? The Emitter asks the same
        ; question as `is_npo_option`; this is the Planner-side twin over a
        ; PlannedType. A `pointer[T]?` is deliberately NOT included: a pointer
        ; carries its element stride and arithmetic on it is legal.
        ; subscript_receiver_type#: peel the borrow layers off a subscript
        ; receiver so `a[i]` finds the CONTAINER's `operator []`.
        ; find_member_operator# auto-derefs `pointer` and `ref` -- BY NAME, and
        ; the s113 NPO wrapper is named `Option`, so on the ordinary port field
        ; shape `ref[Array[T]]?` the lookup asked the Option concept, found no
        ; `[]`, and the pre-pass left the pair unfused: the operand stood alone
        ; and `[i]` became an orphan ("unexpected operand - missing operator").
        ; The same receiver answers `*(a.get_buffer() + i)` fine, which is what
        ; made it look like a subscript problem rather than a NAME test.
        ; ★Deliberately NOT fixed inside find_member_operator#: that helper also
        ; serves the binary member operators, where unwrapping an Option would
        ; let `x <> null` on a `ref[X]?` dispatch to X's own `==` instead of the
        ; language's NPO presence test. Narrow to the `[]` site, which is the
        ; one that asked.
        ; ★Peels at most four layers, and only NPO Options -- a REAL Option (a
        ; tagged union over a non-pointer payload) is a value, not a borrow.
        function subscript_receiver_type(t: PlannedType) @page true @direct true @deep true returns PlannedType linked

        ; Is this the NPO spelling of a BORROW -- `ref[T]?` or `pointer[T]?`,
        ; i.e. an Option whose sole generic argument is itself pointer-shaped?
        ; planned_type_is_npo_ref# above answers only for `ref`, because the
        ; arithmetic gate it serves must let a pointer through.
        ; report_subscript_assignment#: `set a[i]: v` on a CONTAINER is not a
        ; store. `operator []` answers the element BY VALUE (2026-08-27), so
        ; there is no slot behind `a[i]`, and the emitter's Call target arm has
        ; no arm for a `[]` call: the whole statement was DROPPED, rc 0, with
        ; nothing said at the line that caused it. The write is `put`.
        ; ★★★It cost FOUR live miscompiles that stood for a day.
        ; `tools/subscript.py` rewrote four `set` TARGETS from
        ; `set *(x.get_buffer() + i): v` into `set x[i]: v` (commit 25614a02,
        ; "74 buffer walks become subscripts"): dazzle's `#!optional`/`#!key`
        ; DEFAULTS were then never stored, so every default read back as `#f`,
        ; and the root-rule specificity sort never swapped a pair. Five backend
        ; suites plus `tests/dazzle/engine` went red, and the engine red was
        ; written down in CLAUDE.md as "not ours".
        ; ★A POINTER subscript is untouched and must stay so: the pre-pass
        ; FUSES `p[i]` into the `*` deref call, which is a real store and is
        ; what every hand-rolled buffer in the tree writes through. Only a `[]`
        ; CALL -- a container's own operator -- ever reaches here.
        ; ★The judgement is the RESULT SHAPE, not the receiver. A subscript
        ; that answers `pointer[T]`/`ref[T]` NAMES a slot, and a store through
        ; one is the accessor-store the emitter's ISet arm already serves; only
        ; a by-value answer has nowhere to put the value.
        procedure report_subscript_assignment(mutable this: Planner, target: PlannedOperand) @ret_nonlocal true @deep true linked

        ; planned_type_is_slot#: does this planned type NAME a location a store
        ; can land in? The three borrow spellings do -- `pointer[T]`, `ref[T]`
        ; and the s113 NPO `Option` over either -- and nothing else does.
        ; ★Ask the SHAPE, not the name: the NPO wrapper is named `Option`, and
        ; a test that only compares against "pointer"/"ref" is this compiler's
        ; standing bug pattern.
        function planned_type_is_slot(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        function planned_type_is_npo_borrow(t: PlannedType) @deep true returns bool linked

        function planned_type_is_npo_ref(t: PlannedType) @deep true returns bool linked
        procedure report_ref_arithmetic(
            mutable this: Planner,
            lhs_type: PlannedType,
            rhs_type: PlannedType,
            op_name: String,
            loc: Span
        ) @deep true linked

        ; report_container_arithmetic#: `s + i` on a container VALUE — a Slice,
        ; Vector, Array or String. No operator resolves, the Emitter adds the
        ; integer to the STRUCT (`add %Slice`) and `*(s + i)` reads garbage at
        ; rc 0; the same through a field, `*(h.s + 1)`. A view is walked with
        ; `s[i]`, narrowed with `slice_from`/`subslice`, and handed to C as
        ; `s.data`.
        procedure report_container_arithmetic(
            mutable this: Planner,
            lhs_type: PlannedType,
            rhs_type: PlannedType,
            op_name: String,
            loc: Span
        ) @deep true linked

        ; report_view_cast#: `s as pointer[T]` on a Slice or Vector VALUE. The
        ; Emitter coerces any record cast to a C string as if it were a String,
        ; so the LENGTH word became the first byte, rc 0; to any other pointer
        ; the record's own address came out. The data pointer is `s.data`.
        procedure report_view_cast(mutable this: Planner, from: PlannedType, target: PlannedType, loc: Span) @deep true linked

        ; report_deref_of_non_pointer#: `*x` on a SCALAR. Until 2026-08-27 it
        ; emitted `load i64, i64 %0` -- INVALID IR, whose pointer operand is an
        ; integer -- at rc 0 with no word, and the program then died with
        ; SIGSEGV wherever that integer happened to point. It stayed invisible
        ; because nothing ever asked: get_pointer_element_type answers null for
        ; a non-pointer and the prefix arm simply kept the operand's own type.
        ; The check earns its place with the container-subscript change of the
        ; same day: `operator []` answers the ELEMENT BY VALUE now, so every
        ; stale `*a[i]` is exactly this shape -- without a diagnostic that
        ; migration would be a silent crash instead of a compile error, which
        ; is the opposite of what a breaking change owes its callers.
        ; NARROW ON PURPOSE: only a PRIMITIVE SCALAR is judged. A struct deref
        ; is just as wrong, but a cross-package placeholder arrives as an
        ; opaque struct that IS a pointer, and an unresolved type variable must
        ; not be guessed at. Report what is proven, not what is suspected.
        function type_is_underefable_scalar(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        procedure report_deref_of_non_pointer(
            mutable this: Planner,
            operand_type: PlannedType,
            loc: Span
        ) @deep true linked

        ; report_deref_of_ref#: THE FIFTH GATE on a non-optional `ref[T]`, and
        ; the one the other four were building towards. A `ref[T]` reads and
        ; writes as its pointee (deref_ref_into_pointee#), so `*r` is the
        ; POINTER idiom on a value that is not a pointer -- the same line
        ; report_ref_arithmetic# draws for `+`.
        ;
        ; ★It could only land AFTER the transparent readings existed and after
        ; the tree was swept, because until then `*r` was the ONLY spelling
        ; that worked: 666 stores, 26 reads and 101 deref receivers had to move
        ; first, each verified by BYTE-IDENTICAL emission of every root (the
        ; deref sweep) or by the gates (the receivers, where a whole-union
        ; memcpy goes away).
        ;
        ; ★★★The NULLABLE spelling `ref[T]?` is NOT judged, and that is a
        ; statement about the language rather than a gap: `ref[T]?` is
        ; `Option[ref[T]]`, no transparent reading exists for an Option -- the
        ; three null gates rest on an Option having to spell its unwrap -- and
        ; `*opt` remains the spelling at several hundred sites. The gate asks
        ; the NAME here on purpose, which is the one place in this family where
        ; that is right: `Option` is exactly what must NOT be caught.
        procedure report_deref_of_ref(
            mutable this: Planner,
            operand_type: PlannedType,
            loc: Span
        ) @deep true linked

        ; report_null_test_on_ref#: the third gate on a NON-OPTIONAL `ref[T]`,
        ; and the one that makes the other two enforceable in the ports.
        ; `report_ref_arithmetic#` forbids `r + 1`; `report_null_into_ref#`
        ; forbids null flowing IN at the four positions where a target type is
        ; in hand. Neither can see the position where the lie is actually
        ; VISIBLE: a body that tests its own non-optional reference against
        ; null. Under the declaration that comparison is constant -- dead code
        ; that reads as a live guard -- so it is never anything but a wrong
        ; declaration.
        ;
        ; ★★★Why a checker and not another sweep. The 2026-08-23 conversion
        ; (a72ed732, "Declare concept refs as ref in the ports") added 4081
        ; `: ref[...]` declarations across opensp and dazzle and NOT ONE
        ; `ref[...]?` -- it was a flat `pointer[X]` -> `ref[X]` rewrite with no
        ; nullability analysis, and `tools/refconv.py`, which has that rule,
        ; did not exist yet. By the time it did, those sites no longer carried
        ; the string `pointer[` that is its only trigger, so the tool can never
        ; revisit them: it is ONE-WAY. Measured 2026-08-26 -- 241 provable
        ; sites (202 parameters, 20 locals, 19 fields), all of them in exactly
        ; the two packages that commit touched, and ZERO in the five that
        ; refconv itself converted. A lexical sweep would leave the class
        ; reachable again by the next blind rewrite; a planner gate cannot be
        ; regressed by any tool.
        ;
        ; It reports the PROVABLE class only. A parameter that merely FORWARDS
        ; its value to a nullable parameter of another routine is nullable too
        ; and tests nothing, so nothing here or in any tool can see it; those
        ; stay unaudited on purpose rather than being guessed at.
        ;
        ; The name test is the right one and for the same reason it is right in
        ; report_null_into_ref#: the nullable spelling arrives wrapped as
        ; `Option` (Modeler s113), so asking for "ref" skips exactly the form
        ; that IS the fix. `pointer[T]` is skipped for a different reason -- a
        ; pointer may always be null, by design, and `pointer[T]?` likewise.
        ; ONE statement at the call site: an inline branch in
        ; collapse_operand_sequence# perturbs its s178 alloca pool (six -g
        ; checks, measured).
        ; report_null_test_on_view#: `s <> null` / `s = null` on a Slice or
        ; Vector VALUE. It is a (length, data) record and never null: the
        ; comparison went to Slice's own `operator <>`, which dereferenced the
        ; null argument (SIGSEGV), and `=` answered a constant. It runs before
        ; any operator resolves, because the member operator path never comes
        ; back to report_null_test_on_ref#.
        procedure report_null_test_on_view(
            mutable this: Planner,
            lhs: PlannedOperand,
            rhs: PlannedOperand,
            op_name: String,
            loc: Span
        ) @deep true @deep_into_1_4 true linked

        procedure report_null_test_on_ref(
            mutable this: Planner,
            lhs: PlannedOperand,
            rhs: PlannedOperand,
            op_name: String,
            loc: Span
        ) @deep true @deep_into_1_4 true linked

        procedure report_receiver_arity(
            mutable this: Planner,
            is_dispatch: bool,
            match_ref: ref[MethodMatch]?,
            arg_types: Vector[PlannedType],
            fn_name: String,
            loc: Span
        ) @deep true linked

        ; gate_char_like: the one-byte family as a CALL BOUNDARY sees it.
        ; type_is_char_like# omits const_char deliberately — it decides whether
        ; a bare char LITERAL may fold — so report_method_arg_types# asks its
        ; own question rather than widening that one.
        function gate_char_like(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; gate_strip_indirection: peel Option / ref / pointer wrappers off a
        ; type until a plain one is reached (bounded, so a cyclic or absurdly
        ; nested type cannot spin). ONLY for report_method_arg_types# — it is
        ; deliberately NOT types_compatible#, which overload SELECTION depends
        ; on: tightening or loosening that function moves which candidate is
        ; chosen, i.e. emission, everywhere.
        ;
        ; The gate needs the looser question because types_compatible answers
        ; NO for two shapes this language passes freely, both measured on the
        ; compiler's own sources: an NPO Option wrapper on either side
        ; (`plan_function(name, t)` where the parameter is declared
        ; `ref[PlannedType]?`, which s113 wraps to Option[ref[PlannedType]] —
        ; the seam CLAUDE.md records hiding a pointer-shaped thing under a name
        ; no name-test knows), and an Option flowing INTO a plain parameter
        ; (`Emitter.emit`, argument Option[ref[Plan]] against `Plan`), which the
        ; nullability rule explicitly allows. Rules 3/4 cover ONE direction of
        ; the pointer/ref deref only, so a value handed to a `ref[T]` parameter
        ; is rejected too.
        ;
        ; Consequence, stated rather than hidden: an INDIRECTION mistake is not
        ; reported by this gate — pointer[A] and A agree here. What survives is
        ; the class it was built for, a genuinely different type.
        ;
        ; Single exit: a by-value struct returned from several branches
        ; region-allocates per site and the merging phi fails llc verification.
        function gate_strip_indirection(t: PlannedType) @page true @direct true @deep true returns PlannedType linked

        ; report_method_arg_types: the TYPE half of lookup_method#'s call gate
        ; (2026-08-23). Its sibling arity gate has counted a method call's
        ; arguments since 2026-08-01; their TYPES were compared only when a
        ; concept declared SEVERAL same-named methods, because the s163
        ; selection loop — which owns method_params_match#, the one place a
        ; declared parameter type ever meets an argument type — is gated on
        ; `candidates.length > 1`. A SINGLE by-name candidate was therefore
        ; taken unexamined: handing it an argument of the wrong type planned
        ; clean with rc 0, and emit_call builds the callee's type from the
        ; ARGUMENT VALUES rather than from the declaration, so llc had nothing
        ; to object to either — the callee read whatever the caller happened to
        ; leave in the register. Same class as the receiver-arity and
        ; static-arity gates, and visible from the same side: a FREE function
        ; with the identical mistake is a hard `function not found`, because
        ; check_function_match# always compares.
        ;
        ; ★★★THREE restrictions, each measured against the stdlib rather than
        ; guessed — without them the gate reports 26 findings there, all its
        ; own imprecision:
        ;
        ; (a) Only a method that declares `this`. lookup_method# also serves a
        ;     this-LESS member reached through a value receiver, whose receiver
        ;     fills the first DECLARED parameter (`old.is_equal(gid)`,
        ;     dazzle/ELObj.scaly), so its arg_types sit one slot off against
        ;     f.input and every comparison would be against the wrong
        ;     parameter. Exactly the restriction the arity gate's exact arm
        ;     carries, for the same reason.
        ; (b) Only a NON-GENERIC receiver. Binding the receiver's parameters
        ;     the way the selection loop does is not sound here: 
        ;     define_type_substitution appends and lookup is FIRST-WINS, so an
        ;     AMBIENT binding of the same letter wins over the one just made.
        ;     Measured: `slot_list.add(own_page, Slot[T](…))` on a
        ;     List[Slot[T]] inside HashSetBuilder[T] planned its
        ;     `element: T` as the ambient T (String) instead of the receiver's
        ;     Slot[String], and the gate reported a correct call. The same
        ;     trap sits in the selection loop, where it can only mis-RANK
        ;     overloads; here it would reject working code, so the whole class
        ;     stays out until substitution scoping is fixed.
        ; (c) Per argument, anything neither side has resolved is skipped: an
        ;     argument type that is a fresh variable or has no name at all
        ;     (measured 20× on Vector.get_ptr), and a parameter that still
        ;     mentions a generic parameter — a generic METHOD of a plain
        ;     concept — since an unbound var compares as matching anything and
        ;     the check would be vacuous rather than wrong.
        ;
        ; What is left is the shape the bug was found in: a plain concept, a
        ; concrete signature, one candidate. The comparison is the PERMISSIVE
        ; pass — types_compatible plus the char and float folds — i.e. exactly
        ; what the selection's last pass accepts, so nothing reported here
        ; could have been selected by it either.
        ;
        ; Record and CONTINUE, like the arity gate: add_diagnostic is fatal at
        ; the cli.scaly gate, so resolution proceeds exactly as it did before.
        ; A String VALUE handed to a `Slice[...]` parameter of a generic
        ; instance's method (`view.equals(String("abc"))`): the String record
        ; went through as the view -- a pointer read as a length -- and the
        ; comparison answered nonsense at rc 0 (2026-09-29, the json package's
        ; tests). It needs no T: the parameter's type is a Slice whatever T is,
        ; and a String converts to one only as a string LITERAL, which
        ; materializes and is left alone.
        procedure report_string_into_slice(mutable this: Planner, f: Function, method_name: String, arg_ops: Vector[PlannedOperand]) @deep true linked

        procedure report_method_arg_types(
            mutable this: Planner,
            mutable f: Function,
            lookup_st: PlannedType,
            method_name: String,
            arg_types: Vector[PlannedType],
            arg_ops: Vector[PlannedOperand],
            loc: Span
        ) @deep true io linked

        ; The judge of report_method_arg_types#, for a parameter list that
        ; starts at `param_start`: 1 for a method (its `this` is the receiver),
        ; 0 for a QUALIFIED static or namespace call, whose arguments line up
        ; with the declaration one to one (report_static_arg_types#).
        procedure report_arg_types_from(
            mutable this: Planner,
            mutable f: Function,
            owner_name: String,
            method_name: String,
            arg_types: Vector[PlannedType],
            arg_ops: Vector[PlannedOperand],
            loc: Span,
            param_start: size_t
        ) @deep true io linked

        ; report_variant_arg_arity: a union ARM carries at most ONE payload, so
        ; a variant construction takes at most one argument — and until
        ; 2026-08-18 both planner paths that build one took component 0 and
        ; dropped the rest WORDLESS, rc 0 (`U.First(1, 2)` answered 1). The two
        ; call sites are the resolved gate (is_variant_ctor) and the s185 rescue
        ; for a bare `Some(5)`; both call this in ONE statement, because an
        ; inline branch in collapse_operand_sequence# perturbs its s178 alloca
        ; pool — the same discipline report_unknown_identifier# follows.
        ;
        ; A payload record with several fields is constructed on its own
        ; (`U.First(Rec(11, 22, 33))`); spelling its fields into the variant
        ; construction is what this names.
        procedure report_variant_arg_arity(
            mutable this: Planner,
            union_name: String,
            variant_name: String,
            provided_count: size_t,
            loc: Span
        ) @deep true linked

        ; report_variant_payload_shape#: the payload of a variant construction must
        ; have the REFERENCE SHAPE its arm declares. Neither planner path compared
        ; the argument's type with the arm's, and the emitter stores whatever it is
        ; handed, so both directions compiled at rc 0 (measured 2026-09-17): a VALUE
        ; into a `ref[T]` arm (`U.B(Big(1, 2, 3, 4))`, `U.B(big)`, and a `Big^page(…)`
        ; without the `&`) SIGSEGVs on the first read through the binding, and a
        ; REFERENCE into a by-value arm reads its address back as the record's
        ; fields. tscaly met the first shape boxing NodeData's large arms and
        ; checked 254 construction sites by a scan because the compiler would not.
        ;
        ; Only the SHAPE is judged, never the pointee: the tuple path's type check
        ; (report_component_type_mismatch#) carries the measured exemptions for
        ; the rest. A GENERIC union is not judged either — its arm types name
        ; parameters this site does not bind (Option[T].Some is the NPO case).
        ; One statement per call site, as report_variant_arg_arity# above.
        procedure report_variant_payload_shape(
            mutable this: Planner,
            mutable union_name: String,
            variant_name: String,
            payload: ref[PlannedOperand]?,
            loc: Span
        ) @deep true io linked

        ; ★★★ A METHOD CALL WHOSE MEMBER DOES NOT EXIST WAS NOT A CALL AT ALL,
        ; AND THAT IS WHY IT VANISHED. Call detection above accepts exactly two
        ; shapes -- a member_access chain whose LAST HOP is_method, or a
        ; PlannedType head -- and an unresolved hop is neither: resolve_member_
        ; access# records a placeholder with is_method=false and a VOID result
        ; type, so `is_call` stays false, the operand pair collapses, and the
        ; statement leaves no trace. rc 0, no diagnostic, not even a dropped-
        ; call message, because the s185 not-found gate lives INSIDE `if
        ; is_call` and was never reached.
        ;
        ; ★★★The receiver's type decided whether ANYTHING was said, and only by
        ; accident: for a CONCEPT the emitter later tripped over the dangling
        ; member READ (`Emitter: member not found`, exit 16, no file and no
        ; line), while for a PRIMITIVE pointee -- `q.put(0, c)` on a
        ; `q: pointer[char]`, which derefs to `char` -- map_type answers `i8`,
        ; the emitter's struct-shaped trap does not fire, and the whole body
        ; came out `ret void`. Measured 2026-09-03: tscaly's
        ; get_property_name_for_known_symbol_name wrote its fallback name with
        ; three `buf.put(w, ...)` into a `buf: pointer[char]` and had emitted
        ; NOTHING since the first port.
        ;
        ; ★The gate asks for the placeholder EXACTLY: last hop not a method,
        ; void result, and a NON-EMPTY parent name. The empty name is the one
        ; legitimate recovery the placeholder arm documents (a base that itself
        ; did not resolve, already reported at its own line); a resolved
        ; property hop carries its own type, so a delegate-typed field called
        ; through `obj.f(args)` is untouched.
        procedure report_unresolved_method_call(
            mutable this: Planner,
            is_call: bool,
            recv: PlannedOperand,
            second: PlannedOperand
        ) @deep true linked

        procedure report_unknown_identifier(mutable this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true linked

        ; collapse_grouping_target#: a PARENTHESIZED `set` target is a
        ; GROUPING, not a value. `set (p).v: 55` means what `set p.v: 55`
        ; means and `set (*p).v: 77` means the store the author wrote -- but
        ; the emitter's target dispatch has arms for Variable / Call /
        ; GlobalRef only, so a Tuple target fell into its silent `else` and
        ; the WHOLE statement was dropped: rc 0, no diagnostic, no store in
        ; the emitted body at all (measured -- the `set` is simply absent
        ; from `main`).
        ;
        ; In VALUE position the same grouping is CORRECT and that asymmetry
        ; is the whole defect: emit_tuple's s160 arm loads the struct out of
        ; `(*p)`, so `let x (*p).v` READS the right field while
        ; `set (*p).v: 77` writes into that loaded COPY. Reading works,
        ; writing evaporates.
        ;
        ; Unwrap a single ANONYMOUS component holding a single operand and
        ; hand the inner expression on with the two member-access chains
        ; CONCATENATED, so the store travels the same path `set p.v:` and
        ; `set accessor(i).f:` already travel. A NAMED component is a real
        ; construction, never a grouping, and is left alone.
        ;
        ; This also puts the target in front of the checks below that choose
        ; on its expr -- the unknown-assignment-target gate, the integer /
        ; float / cstr retypes, and the frame-external STORE analysis, all of
        ; which a Tuple slipped past.
        function collapse_grouping_target(this: Planner, operand: PlannedOperand) @page true @direct true @deep true returns PlannedOperand linked

        procedure plan_action(mutable this: Planner, mutable a: Action) @page true @direct true @stores true @deep true @deep_this_2 true returns PlannedAction io linked

        ; Escape checker (RBMM blocker C): true for two escaping shapes:
        ;  (1) a ref[T]/pointer[T] whose POINTEE lives on a Local ($) page — the
        ;      `&` operator and resolve_type keep the pointee (with its life) in
        ;      generics[0];
        ;  (2) a VALUE whose OWN life is Local (design-B item 3) — String()/etc
        ;      carry an internal `data` pointer into the local page, so returning
        ;      the value by copy still hands out a dangling internal pointer.
        ; A Local pointee/value dies at scope exit, so returning/storing it is a
        ; use-after-free. Call (#) and Reference (^name) lifetimes outlive the
        ; function and are fine. Mirrors Planner.cpp::isReferenceToLocalPage.
        ; True when the operand IS a freshly-built page-owning construction
        ; whose allocation lives on the function's LOCAL page (Local life) or
        ; would (Unspecified life on a page-owning value). is_reference_to_local_
        ; page only inspects result_type.life, but the construction blocks
        ; (init# / reshape) stamp the Local life onto the PlannedCall/PlannedTuple
        ; EXPRESSION (call.life), leaving result_type.life Unspecified — the
        ; emitter selects the page from call.life, not result_type.life. So a
        ; directly-returned no-sigil construction (`return Vector[T](0)`) is a
        ; local-page allocation that is_reference_to_local_page misses. R2 uses
        ; this as an additional gate so such returns are promoted to rp by
        ; restamp_operand_life# (which re-checks the expression life itself).
        ; result_owns_page_guts excludes borrows/handles. Read the EXPRESSION
        ; life, not result_type.life, by design.
        ; WP7: true when `op` is an Unspecified-life value construction
        ; (PlannedCall/PlannedTuple) whose result_type is NOT itself a
        ; pointer/ref — the shape returned as pointer[T] that must be promoted
        ; to the caller page. A call already returning a pointer (`return
        ; create_node(x)`) has a pointer result_type and is excluded, so it is
        ; forwarded unchanged (no false-positive promotion/diagnostic).
        function tail_is_unspecified_value_ctor(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function operand_is_local_page_construction(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; binding_is_frame_local: true when `name` resolves to a non-parameter
        ; local binding whose stored VALUE lives in this frame (life Unspecified
        ; = plain stack value / no-sigil; or Local = $/heap-backed-default). Such
        ; a binding's STORAGE is the frame, so `&name` is a pointer into the
        ; local page (region rank Local). Parameters are excluded: a by-pointer
        ; struct param points at the caller's object (rank Caller), and a value
        ; param copied into the frame is not address-escaped in practice
        ; (pos_return_param_ptr returns the pointer VALUE, never `&param`).
        ; Bindings allocated with #/^ carry Call/Reference life on their VALUE —
        ; the programmer placed them on a caller/named page deliberately — so
        ; `&` of those is left to a later step (their slot is frame, but value
        ; uses are the common case and stay correct). Escape soundness step 1.
        function binding_is_frame_local(this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; base_is_value_struct: true when the local binding `name` stores a
        ; VALUE struct in the frame — NOT a pointer/ref. Escape soundness
        ; step 2: a frame-local pointer var (`var old_current current`,
        ; `let p = ...`) has `.field` AUTO-DEREF to the pointed-to object,
        ; which lives on a caller/heap page — `&p.field` is then a Caller
        ; pointer, NOT a frame address. parent_type can't tell us this
        ; (s173 records the UNWRAPPED type), so the base binding's stored
        ; type is checked directly. Every compiler `return &base.field`
        ; (HashMap/List iterators) has a pointer/ref/^rp base, so this
        ; excludes them all.
        function base_is_value_struct(this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; option_inner_is_reference: true when `t` is an Option whose first
        ; generic argument is a `pointer`/`ref` — the NPO auto-deref shape.
        function option_inner_is_reference(this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; member_chain_all_fields: true when every member-access hop is a
        ; plain field (or union-value) access — no method call. `&x.m()`
        ; addresses a call result, not a frame field, so it is not flagged
        ; here (rare; deferred to step 3). A null chain is vacuously true.
        function member_chain_all_fields(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; construction_life_is_frame: true when a construction (PlannedCall
        ; ctor / Tuple / VariantConstruction) lives in THIS frame — i.e. its
        ; life is Unspecified (no sigil) or Local ($). A #/^ construction is
        ; allocated on a caller/named page, so its address is Caller, not
        ; Local. (this is ignored — kept a method to match the call style.)
        function construction_life_is_frame(this: Planner, life: Lifetime) @ret_nonlocal true @deep true returns bool linked

        ; True when `&op` produces a pointer into THIS frame — generalizes
        ; the step-1 bare `&x` to field chains and address-of-temporary.
        ; Kept as its own single-exit helper (not inlined into the prefix-`&`
        ; collapse block): a nested choose/if there is miscompiled by the
        ; bootstrap lineage (the documented braceless-nest trap). Cases:
        ;   (1) bare `&x`            — x a frame-local of ANY type (the slot
        ;                              itself is in the frame).
        ;   (2) `&x.field-chain`     — x a frame-local VALUE struct, all hops
        ;                              plain fields (base_is_value_struct +
        ;                              member_chain_all_fields exclude every
        ;                              compiler pointer/ref-base `&p.field`).
        ;   (3) `&Box(5)` / `&(a,b)` — address of a frame TEMPORARY (no-sigil
        ;                              or $ construction; #/^ live on a page).
        ; `&<^rp-local>` (the slot is frame but the value is Caller) is NOT
        ; flagged — binding_is_frame_local's {Unspecified,Local} gate excludes
        ; Reference life; deferred to a later soundness step.
        function operand_addr_is_frame_local(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function is_reference_to_local_page(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; region_of_operand#: the single provenance chokepoint (Stage B). Returns
        ; the region rank of the operand's pointee — TODAY a coarse {Local,Caller}
        ; derived from the operand's result_type Local stamp (which already
        ; encodes the step-1/2/3 address-of/deref/field/join provenance walk via
        ; make_pointer_to_local#/make_ref_to_local_inner# + natural type flow).
        ; The 4 bespoke escape sites route their reference-escape gate through
        ; here so phase-5 (Stage D) refines the rank — ordered numeric ages from
        ; signatures, field/inter-proc provenance — in ONE place instead of four.
        ; NEUTRAL: region_of_operand(op) < required_region_for_escape() is
        ; exactly today's is_reference_to_local_page(op.result_type) (rank Local
        ; iff a frame pointee, else Caller; Caller < Static unused yet).
        ; operand_is_stack_closure: true when `op` is a bare read (no member-
        ; access hop) of a local bound to a stack (Lifetime.Local) closure —
        ; recorded in local_closure_names at plan_binding#. A member hop
        ; (`clo.field`) is a read THROUGH the closure, not the closure value, so
        ; it does not qualify. Used by the CLOSURE store-escape check.
        function operand_is_stack_closure(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; target_is_frame_external: true when a store TARGET writes into memory
        ; that outlives this frame — a parameter/receiver's field
        ; (`this.field`/`param.field`, base binding is_parameter), a module
        ; global (GlobalRef), or through a pointer deref (Call). A same-frame
        ; local's field (base var/let) dies with the frame → false. Mirrors the
        ; inline frame-external detection in the ref STORE vector above.
        ; is_value_scalar_name#: a number, `bool` or `char` -- NOT `pointer`/
        ; `ref`, which is_primitive_type_name# counts as primitive and which a
        ; record may legitimately be compared with (an identity test).
        function is_value_scalar_name(name: String) @ret_nonlocal true @deep true returns bool linked

        function lifetime_is_thrown(life: Lifetime) @ret_nonlocal true @deep true returns bool linked

        ; marker_has_no_receiver#: the operand before position `mi` is missing
        ; or an operator -- nothing a lifetime sigil could belong to.
        function marker_has_no_receiver(this: Planner, ops: Vector[PlannedOperand], mi: size_t) @ret_nonlocal true @deep true returns bool linked

        ; is_operator_char#: one of the eleven characters an operator identifier
        ; consists of (CLAUDE.md, Lexical; the scanner's own class).
        function is_operator_char(c: char) @ret_nonlocal true @deep true returns bool linked

        ; operand_is_operator_name#: an operand that is an operator identifier
        ; (only the eleven operator characters) or a word operator.
        function operand_is_operator_name(op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; report_dropped_thrown_marker#: `!` is the THROWN lifetime sigil
        ; (`Foo!(...)`, `x.m!(...)`), not negation. In `if !a` it stands alone,
        ; joins nothing, and the marker pass dropped it: `if !a` ran as `if a`,
        ; `!a and b` as `a and b`, `!(x = 3)` as `x = 3` -- all at rc 0, while
        ; CLAUDE.md listed `!` as a synonym of `not` (2026-09-24; nothing in the
        ; tree spelled it, found while probing `and`-chains). Negation is `not`.
        procedure report_dropped_thrown_marker(mutable this: Planner, life: Lifetime, at: Span) @ret_nonlocal true @deep true linked

        ; report_record_scalar_compare#: a comparison between a RECORD by
        ; value and a scalar, with no operator and no `equals` that takes it.
        ; It reached the emitter, which aborted at exit 14 with no file and no
        ; line (`'=' between operands of different LLVM kinds ... ptr vs i64`).
        ; The usual source is a subscript on a `pointer[Array[T]]`: pointer
        ; arithmetic at Array stride that yields the Array itself (2026-09-24).
        procedure report_record_scalar_compare(mutable this: Planner, lhs: PlannedType, rhs: PlannedType, op_name: String, at: Span) @deep true linked

        ; operand_is_pageless_caller_construction#: a construction or call
        ; whose life says CALLER (`T#(...)`, `x.m#()`) in a routine the page
        ; rules gave no caller page. The emitter puts it on the routine's own
        ; frame (s196), and region_of_operand#, which reads the life, took it
        ; for a surviving value -- so `set out: Holder(String#(s))` through an
        ; out-parameter, the spelling meant to fix xfail_store_local_part,
        ; compiled at rc 0 and handed out a released String (2026-09-24). A
        ; `#` whose value stays in the routine is harmless and not judged.
        function operand_is_pageless_caller_construction(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; resident_store_promotion#: the promoted source for the RESIDENT store
        ; variant in plan_action#, or null to leave it as it is. The target
        ; must be a field of `this` or of a parameter (Variable + member hop).
        procedure resident_store_promotion(mutable this: Planner, target: PlannedOperand, source: PlannedOperand, loc: Span) @page true @direct true @deep true returns ref[PlannedOperand]? linked

        ; operand_is_local_resident_construction#: a construction, with no
        ; lifetime sigil, of a type that derives its page from its own address
        ; (PlannedStructure.resident / concept_needs_this_residency) -- built as
        ; a temporary of this frame, so its guts are on this frame's page.
        procedure operand_is_local_resident_construction(mutable this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; the last dotted segment of a planned type name, asked for residency
        procedure planned_type_name_is_resident(mutable this: Planner, tname: String) @ret_nonlocal true @deep true returns bool linked

        ; operand_carries_local_guts#: a VALUE construction (`Holder(s)`,
        ; `T(String(..), n)`) whose own life is not local -- it is copied
        ; wherever it is stored -- but one of whose components is (recursively)
        ; a reference or a page-owning value on THIS routine's page. The store
        ; vector judged only the top of the source, so `set out: Holder(sb.
        ; to_string())` through an out-parameter handed the caller a String on
        ; a released page at rc 0 (the "out-param store" class CLAUDE.md
        ; carried since the page-inference era; 2026-09-24). A parameter's
        ; field and `this.field` with a DIRECT local source were already judged.
        function operand_carries_local_guts(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function target_is_frame_external(this: Planner, target: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function region_of_operand(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns size_t linked

        ; required_region_for_escape#: the minimum pointee rank an escape sink
        ; (return / store into Caller-lived memory / pass to a storing callee)
        ; demands. TODAY constant Caller — anything Local-ranked escapes. Stage D
        ; refines this per destination (the returned-into caller region, the
        ; stored-into param's age, the callee's stored-dest age).
        function required_region_for_escape() @ret_nonlocal true @deep true returns size_t linked

        ; is_local_ref_pointer: the REFERENCE half of is_reference_to_local_
        ; page# — true ONLY when `t` is a pointer/ref whose inner pointee has
        ; Local life (a genuine `&<frame-local>` reference). It deliberately
        ; OMITS the leading `t.life==Local` clause, which also matches a Local-
        ; life VALUE type (e.g. a type-metadata PlannedType returned by copy
        ; into sret — find_break_type_in_*). Used by plan_binding#'s step-3
        ; gap-1 exclusion: a binding holding such a reference is not a
        ; relocatable allocation and must not be promoted, but a Local-life
        ; value binding stays promotable (returned by copy, no dangle).
        function is_local_ref_pointer(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; result_type_is_value_struct: true when `t` is a by-VALUE struct held
        ; in the frame — not a pointer/ref, and not an Option whose inner is a
        ; reference (NPO auto-deref). The type-based twin of base_is_value_
        ; struct# (which keys off a binding name); used at construction time in
        ; plan_binding# before the local is defined.
        function result_type_is_value_struct(this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; Hole-1 field provenance: true when `op` is a construction (a
        ; value-struct Tuple or an init# ctor Call) one of whose arguments is a
        ; `&<frame-local>` reference (result_type is pointer/ref with Local
        ; inner). Such an arg stores a frame address into one of the new
        ; struct's pointer fields. Scans Tuple component value-operands and
        ; Call args. Single-exit; only flat loops (no nested choose) to dodge
        ; the bootstrap-nest miscompile.
        function construction_has_local_ref_arg(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; Hole-1 field provenance: true when `op` reads a reference-like FIELD
        ; of a tainted frame-local value-struct binding (`h.p` where h was
        ; constructed with a &<frame-local> arg). Returning / storing / passing
        ; such a field hands out the frame address. Single-exit.
        function operand_reads_tainted_local_field(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; taint_field_read_by_name#: at the member-access read site, if the base
        ; local binding `name` is TAINTED (constructed with a &<frame-local> arg)
        ; and the read FIELD type `t` is reference-like, return the same outer
        ; type with the inner pointee flipped to Local — the field holds a frame
        ; address, so the operand TYPE must carry that Local signal for the
        ; pass-to-callee post-pass (which runs after the per-fn taint set is torn
        ; down) to reject it via is_reference_to_local_page#. Identity (returns
        ; `t`) unless `name` is in the taint set, so a no-op for all non-test
        ; code (no tainted bindings there). Return/store are also covered by
        ; operand_reads_tainted_local_field#; this additionally makes the
        ; uniform check fire at the interprocedural call boundary.
        function taint_field_read_by_name(this: Planner, name: String, t: PlannedType) @page true @direct true @deep true returns PlannedType linked

        ; ================================================================
        ; Escape checker (RBMM blocker C), Vector 3: pass-to-storing-callee.
        ;
        ; A reference into a Local ($) page passed to a callee that STORES
        ; it into frame-external memory (its `this`/param field, a global,
        ; or a pointer deref) is a use-after-free once the local page is
        ; freed at scope exit. Implemented as a POST-PASS Plan-tree walker
        ; (call discovery in ONE place rather than the many scattered
        ; PlannedCall construction sites in collapse_operand_sequence#).
        ;
        ; Two passes over every planned function body:
        ;   Pass 0 (collect): record which parameter a function stores
        ;                     frame-external, and into which destination.
        ;   Pass 1 (check):   at each call, if a local-page-ref arg is bound
        ;                     to such a param AND the destination outlives
        ;                     the arg -> hard diagnostic.
        ; Non-transitive (a param escaping only via a deeper escaping callee
        ; is not chased) — documented limitation, mirrors Planner.cpp.
        ;
        ; The walk mirrors the Emitter's body walk EXACTLY (emit_function_body
        ; -> emit_action -> emit_operands -> emit_operand / emit_statement),
        ; the only shape proven not to corrupt under stage-0 codegen.
        ; ================================================================

        ; True when `t` is a bare reference-like type (pointer[T]/ref[T]),
        ; regardless of pointee lifetime. Used at collect time on a callee's
        ; stored parameter; the local-page determination happens at the call
        ; site via is_reference_to_local_page. Mirrors isReferenceLikeType.
        function is_reference_like(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; True when a call's RESULT genuinely owns heap guts allocated on the
        ; passed page — i.e. the only return shape the default-to-local flip
        ; should stamp Local. Borrows/handles are EXCLUDED: pointer[T]/ref[T]
        ; (and ref[T]?/pointer[T]? under NPO, which resolve to name "ref"/
        ; "pointer") point into memory the callee already owns elsewhere, and
        ; extern LLVM-C wrapper structs (LLVMValueRef/TypeRef/MetadataRef/...)
        ; wrap LLVM-context-owned memory, not a Scaly page. Stamping any of
        ; these Local is a false escape (the flip's coarse `call_requires_page`
        ; gate fired on every class/union/wrapper return).
        function result_owns_page_guts(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; Index of a parameter named `name` in the CURRENT function's Input
        ; (re-fetched via escape_fn_index), or -1. Excludes the page param
        ; (which is not part of the arg<->param mapping), matching the C++
        ; CalleeParamNames (Input only).
        function escape_param_index_current(this: Planner, name: String) @ret_param_0 true @deep true returns int linked

        ; The current function's Input length (the callee param count recorded
        ; in a summary entry; used to right-align a call's args).
        function escape_current_param_count(this: Planner) @ret_param_0 true @deep true returns size_t linked

        ; True when `name` is a parameter (or page receiver) of the CURRENT
        ; function — i.e. caller-provided memory that outlives this frame.
        ; Mirrors the EscapeFnParams membership test (Input + PageParam).
        function escape_name_is_current_param(this: Planner, name: String) @ret_nonlocal true @deep true returns bool linked

        ; reference_names_frame_local#: does a `^name` life name a page that
        ; dies with this frame -- a local the judge itself recorded as built
        ; here (a visible construction, or a bound call it judged local)? The
        ; receiver, a parameter and any name it cannot place stay outliving:
        ; a local may name a PARAMETER's page (`let host Page.get(this)`).
        ; (2026-09-24: cli.run's `plan`, built on the frame-local `planner`,
        ; read as outliving and made `jit_run(plan, program_name, ...)` an
        ; escape.)
        function reference_names_frame_local(this: Planner, name: String) @ret_param_0 true @deep true returns bool linked

        ; bound_ref_points_into_frame#: was `name` bound from a call whose
        ; reference result the residence classes place on this frame?
        function bound_ref_points_into_frame(this: Planner, name: String) @ret_param_0 true @deep true returns bool linked

        ; A destination arg outlives the (local-page) arg passed alongside it
        ; when it refers to memory living beyond the current frame: a parameter
        ; of the current function, or a #/^ allocated value, or a module
        ; global. A same-frame $/stack local dies WITH the arg -> safe.
        ; Mirrors Planner.cpp::escapeDestArgOutlives.
        function escape_dest_arg_outlives(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; binding_inits_stack_closure: true when a PlannedBinding's initializer
        ; is a stack (Lifetime.Local) closure — i.e. `let g: Cb \x: …` whose
        ; make_closure# stamped Local (env on the frame). Read structurally from
        ; the Plan tree so the escape post-pass needs no plan-time state.
        function binding_inits_stack_closure(this: Planner, binding: PlannedBinding) @ret_nonlocal true @deep true returns bool linked

        ; arg_is_stack_closure: true when a call ARGUMENT is a bare read (no
        ; member hop) of a name recorded in current_fn_closure_names — a stack
        ; closure of the calling function. Passing it to a callee that stores
        ; its parameter frame-external dangles once this frame exits.
        function arg_is_stack_closure(this: Planner, arg: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; escape_alias_param_index: the parameter index a local name aliases (via
        ; the current_fn_alias_names/params reshape map), or -1.
        function escape_alias_param_index(this: Planner, name: String) @ret_param_0 true @deep true returns int linked

        ; EMITTER CONSTRAINT for every EscapeAccess-returning helper below:
        ; accumulate working state in SCALARS and construct the returned struct
        ; EXACTLY ONCE (a single tail construction). A by-value struct returned
        ; from multiple branches — or a struct local reassigned across branches —
        ; is region-allocated per site, and a phi merging those buffers fails
        ; LLVM verification ("Instruction does not dominate all uses"). Field
        ; paths are k=2, appended with truncation (a truncated path denotes "this
        ; field subtree" — region_of_arg_path# resolves it SAFE unless provably
        ; local, so truncation never causes a false flag).

        ; peel_operand: the inner operand of a deref (`*pr`) or a parenthesized
        ; single value (`(*pr)` = a one-component one-operand Tuple), as a ref
        ; into the existing Plan tree (no by-value union copy). null otherwise.
        ; Lets escape_resolve_access# keep a SINGLE recursion site outside its
        ; classifying choose — two sret-returning recursive calls in separate
        ; choose arms make the emitter merge their result buffers into a phi
        ; that fails LLVM verification ("does not dominate all uses").
        function peel_operand(this: Planner, op: PlannedOperand) @deep true returns ref[PlannedOperand]? linked

        function escape_resolve_access(this: Planner, op: PlannedOperand) @page true @direct true @deep true returns EscapeAccess linked

        ; escape_value_param_access: the (parameter, field-path) an escapable
        ; stored/forwarded operand denotes, or param_index -1. A path-0 result is
        ; tracked ONLY when the operand is a bare parameter/alias Variable — the
        ; exact pre-reshape behavior of escape_value_param_root, so path-0 summary
        ; records are byte-identical. A bare deref/paren with no field (`(*pr)`)
        ; is not tracked. A field reshape (`(*pr).a`, `pr.a`, `s.current`) yields
        ; path_len > 0 and IS tracked (this is what escape_value_param_root
        ; deliberately dropped to protect the self-host; the field check now
        ; resolves it via per-field provenance instead of coarsely flagging).
        function escape_value_param_access(this: Planner, op: PlannedOperand) @page true @direct true @ret_param_0 true @deep true returns EscapeAccess linked

        ; escape_record_field_points_to (Design-B 3e): seed the caller-side
        ; field-points-to map from a binding whose initializer is a VISIBLE
        ; struct construction (a Tuple). For each POSITIONAL component that is a
        ; reference and whose operand is LOCAL-region (region_of_operand below
        ; the escape threshold), record (bind_name, component_index -> field
        ; index, Local). Named components are skipped (positional index may not
        ; equal field index -> leave unrecorded -> Caller/safe). Only local
        ; fields are recorded; every other field resolves to Caller (safe) at
        ; region_of_arg_path#. Call-result / opaque initializers are not Tuples,
        ; so they are never seeded (sound: see the current_fn_fpt_* field
        ; comment). Runs in every pass; consulted only by the phase-4 check.
        procedure escape_record_field_points_to(mutable this: Planner, binding: PlannedBinding) @deep true linked

        ; escape_value_param_root: the reference-like/delegate PARAMETER index
        ; this operand's value IS — a bare parameter, or a bare local ALIAS of a
        ; parameter (`let q p`). -1 otherwise. Deliberately BARE only (no member
        ; hop). Kept UNCHANGED (not routed through escape_value_param_access) so
        ; the alias-recording site's bare-only semantics are exactly preserved.
        function escape_value_param_root(this: Planner, op: PlannedOperand) @ret_param_0 true @deep true returns int linked

        ; Pass 0: at a frame-external store of a current-function parameter
        ; reference, record a summary entry. Reuses the Vector-2 store shape
        ; (value = a bare reference-like param; target = param.field / global
        ; / deref). Runs only in collect mode.
        procedure escape_handle_store(mutable this: Planner, act: PlannedAction) @deep true linked

        ; fpt_region_of: the recorded region rank of local `base_name`'s field
        ; `field` in the current function's field-points-to map, or Caller
        ; (safe) when not recorded. Only LOCAL-region fields are ever recorded
        ; (escape_record_field_points_to#), so an unrecorded field is treated as
        ; Caller — the UNKNOWN -> SAFE default that keeps the self-host green.
        ; a record handed BY VALUE is copied into the callee's keep. Bound
        ; from a VISIBLE positional construction, its fields are what may
        ; point into this frame's local page; otherwise (a String from a
        ; call, an init) its Local stamp IS its guts — region_of_operand
        ; answers for references only. The addr-taken rule's promotion
        ; moved the binding onto the caller page.
        ; the result of a CALL, by value: built on the page this frame
        ; passed (class 1 — the frame's local page when the frame has no
        ; caller page, else the promotion's business), or wherever its
        ; class-3 argument lives; every other class (explicit page, nowhere,
        ; unknown) is not this frame's
        function by_value_call_local(this: Planner, c: PlannedCall, result_life: Lifetime) @ret_nonlocal true @deep true returns bool linked

        ; the argument a class-3/5 result is handed back from: a VIEW or
        ; reference is local where it points into this frame (`wrap(a.as_slice())`
        ; over a frame-local Array — judged by value, the view's receiver read
        ; as the Array and was never local), a record by its own guts
        function dep_arg_local(this: Planner, a: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; variant_payload_local#: is a variant construction's payload local to
        ; this frame -- a reference into it, or a by-value payload whose buffer
        ; lives here (deep_by_value_local#)?
        function variant_payload_local(this: Planner, vc: PlannedVariantConstruction) @ret_nonlocal true @deep true returns bool linked

        function payload_promoted_without_page(this: Planner, pv: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; escape_fn_has_page#: does the function the escape post-pass is walking
        ; take a caller page (explicit `rp`/`page`, or the inferred one)?
        function escape_fn_has_page(this: Planner) @ret_param_0 true @deep true returns bool linked

        ; a record handed BY VALUE is copied into the callee's keep — its
        ; BUFFER is not. Where that buffer lives: a parameter's or a field's
        ; with the caller (never local); a local bound from a visible
        ; construction — where its fields point (the map); a local bound
        ; from a call, or a call itself — by_value_call_local#; an inline
        ; construction on this frame — where its components point; a
        ; promoted binding — the caller page.
        function deep_by_value_local(this: Planner, arg: PlannedOperand) @ret_param_0 true @deep true returns bool linked

        function type_init_allocates_buffer(t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        function bind_index_of(this: Planner, name: String) @ret_nonlocal true @deep true returns int linked

        function call_components_local(this: Planner, c: PlannedCall) @ret_nonlocal true @deep true returns bool linked

        ; does a by-value record own a heap buffer — a `pointer[…]` field
        ; anywhere inside it (String, StringC, Array, Vector, List, Text)?
        ; A record of `ref[T]` borrows owns nothing (tscaly's IterationTypes).
        ; value_is_plain#: a value type with NOTHING pointer-like inside --
        ; no pointer, ref, Option, generic instantiation (a container) or
        ; unknown type, through every field of a record and every variant of
        ; a union. Such a value is copied whole and cannot dangle. Stricter
        ; than type_owns_buffer#, which lets a borrowed REFERENCE pass.
        function value_is_plain(this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        function model_value_is_plain(this: Planner, t: scalyc.compiler.Model.Type, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        function name_is_plain(this: Planner, n: String, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        function type_owns_buffer(this: Planner, t: PlannedType, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        function model_type_owns_buffer(this: Planner, t: scalyc.compiler.Model.Type, depth: size_t) @ret_nonlocal true @deep true returns bool linked

        function lifetime_kind_name(lt: Lifetime) @page true @direct true @ret_caller true @deep true returns String linked

        ; exactly the shapes restamp_putadd_constructions# moves onto the
        ; caller page: a construction, an init, a page-taking call, a tuple
        function operand_is_restampable(this: Planner, arg: PlannedOperand) @ret_param_1 true @deep true returns bool linked

        ; does the field-points-to map hold a LOCAL field for the record the
        ; operand denotes (a bare `X` or `&X`)?
        function fpt_any_local(this: Planner, arg: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function fpt_region_of(this: Planner, base_name: String, field: size_t) @ret_param_0 true @deep true returns size_t linked

        ; region_of_arg_path: the region rank of the field the callee reaches
        ; into — arg.<src_field0> — for a FIELD-reshape record. The base local
        ; the arg denotes is a bare `X` or `&X`; its field region comes from the
        ; caller-side field-points-to map (fpt_region_of#). UNKNOWN -> Caller
        ; (SAFE): only a VISIBLY-locally-constructed struct's field resolves to
        ; Local, so a call-result / opaque / parameter arg is never flagged
        ; (this is what accepts save/restore-state and keeps the self-host
        ; green). Only depth-1 paths resolve precisely; a depth-2 (k-truncated)
        ; path -> Caller (safe), since the depth-1 map cannot prove the deeper
        ; field local without risking a false positive.
        function region_of_arg_path(this: Planner, arg: PlannedOperand, rec: EscapeRecord) @ret_param_0 true @deep true returns size_t linked

        ; Pass 1: check one call against one summary entry.
        procedure escape_check_call_record(mutable this: Planner, call: PlannedCall, rec: EscapeRecord) @deep true linked

        ; Pass 1 (indirect calls): an indirect call goes THROUGH a delegate
        ; VALUE whose body is unknown at compile time, so we cannot prove it
        ; does not stash its arguments. Conservatively (SOUND) reject passing
        ; any escaping argument to it — a reference into a local page, or a
        ; stack closure of this frame. args[0] is the callee (the delegate
        ; value itself); the real arguments are args[1..]. A borrowed parameter
        ; or a '#'/'^' allocation is Caller-ranked and stays fine. This closes
        ; the non-transitivity hole for a chain whose escaping hop is an
        ; unresolved (function-pointer) call — the direct-call summary path
        ; keys on mangled_name, which an indirect call does not have.
        procedure escape_check_indirect_call(mutable this: Planner, call: PlannedCall) @deep true linked

        ; Pass 1: a call may match several summary entries (e.g. two escaping
        ; params); check each.
        ; ====================================================================
        ; ★★★A REFERENCE PARAMETER PUT INTO A PAGE-HOSTED CONSTRUCTION ESCAPES
        ; WITH THAT OBJECT (2026-09-20). The checker refuses a frame-local
        ; reference that is RETURNED or stored by a plain `set` -- both
        ; measured loud -- and said NOTHING when the reference travelled into a
        ; callee that puts it inside a NEW HEAP OBJECT. In packages/tscaly 174
        ; frame-local lists reached `box_node_data[T](host, T(... list ...))`
        ; and compiled clean; the program died of an UNBOUNDED RECURSION (a
        ; dangling list feeds a memo, the memo answers nonsense, the cycle
        ; guard never matches) that the whole gate chain missed -- only a run
        ; over a 4 000-file corpus reached it.
        ;
        ; ★★★It is RECORDED in the summary, not diagnosed here, and that is the
        ; design: with the callee marked, the call-site machinery that already
        ; refuses "a frame-local reference passed to a storing callee" fires by
        ; itself, with its own message and its own line -- and it fires ONLY
        ; where the argument really is frame-local, which is why marking every
        ; factory that boxes a reference costs nothing.
        ;
        ; ★A PAGE-HOSTED construction is the condition (`is_region_alloc`:
        ; `T^name(...)`, `T#(...)`), because such an object outlives the
        ; callee's frame by construction. A plain value construction is not:
        ; `Slice[T](n, p)` borrows for the caller's own frame, and flagging it
        ; would refuse every `s.subslice(a, b)` over a local buffer.
        ;
        ; ★It records during the SUMMARY passes only (`escape_checking` false),
        ; like every other recorder here, and shares their dedup.
        procedure escape_record_construction_param(mutable this: Planner, tp: PlannedTuple) @deep true io linked

        ; The record itself: destination kind 1 is "frame-external" (what a
        ; global or a deref store uses), which is exactly what a page-hosted
        ; object is from the callee's point of view.
        procedure escape_record_param_into_region(mutable this: Planner, v: PlannedOperand, dest_kind: size_t) @deep true io linked

        procedure escape_handle_call(mutable this: Planner, call: PlannedCall) @deep true io linked

        ; True when the summary already carries a record equal to this one
        ; (callee_fn_index + param_index + dest_kind + dest_index). callee_param_
        ; count is derived from callee_fn_index so it is not part of identity.
        ; Dedup is what makes the forwarding fixpoint terminate.
        ; The deep gate's post-pass half (armed; SCALYC_DEEP_GATE_OFF): a callee whose
        ; deep mask names this argument position keeps the argument beyond
        ; its frame; a local-page argument there is an escape. The inline
        ; half sees only arguments with a Local-life TYPE; this one asks
        ; region_of_operand, which knows a `&local` box and an alias.
        procedure escape_check_deep(mutable this: Planner, call: PlannedCall) @deep true io linked

        function escape_record_exists(this: Planner, fn_index: size_t, param_index: size_t, dest_kind: size_t, dest_index: size_t, path_len: size_t, field0: size_t, field1: size_t) @ret_nonlocal true @deep true returns bool linked

        ; the whole-table form, for a record whose callee index resolves to
        ; nothing (its records sit on the "" chain)
        function escape_record_exists_scan(this: Planner, fn_index: size_t, param_index: size_t, dest_kind: size_t, dest_index: size_t, path_len: size_t, field0: size_t, field1: size_t) @ret_nonlocal true @deep true returns bool linked

        ; Enter a record into the summary and onto its callee's chain.
        procedure add_escape_record(mutable this: Planner, rec: EscapeRecord) @persists true @deep true linked

        ; the first record position (+1) on the chain of `name`, 0 for none
        function esc_chain_head(this: Planner, name: String) @ret_param_0 true @deep true returns size_t linked

        ; Forwarding fixpoint (pass 0.5): a call may forward several params into
        ; several persisting callee slots; test the current summary against each
        ; matching record. Snapshot the length so records added during this call
        ; are not re-processed here (the outer fixpoint loop propagates them).
        procedure escape_forward_call(mutable this: Planner, call: PlannedCall) @ret_nonlocal true @deep true linked

        ; Forwarding fixpoint (pass 0.5), indirect calls: for each bare
        ; reference-like/delegate PARAMETER of the current function forwarded
        ; (no member hop) into an indirect call, record that the current
        ; function persists that parameter frame-external (dest_kind 1). args[0]
        ; is the callee; scan args[1..]. Dedup'd so the fixpoint terminates.
        procedure escape_forward_indirect_call(mutable this: Planner, call: PlannedCall) @deep true linked

        ; Forwarding fixpoint core: if this call passes a bare reference-like/
        ; delegate PARAMETER of the current function into the callee's persisting
        ; slot (rec.param_index), then the current function itself persists that
        ; parameter — into whatever the callee's destination maps to from the
        ; current frame. Records a new summary entry for the current function
        ; (dedup'd). Mirrors the arg<->param mapping of escape_check_call_record.
        procedure escape_forward_call_record(mutable this: Planner, call: PlannedCall, rec: EscapeRecord) @deep true linked

        ; Walk all operands in a (nullable) operand vector. Takes the
        ; ref[Vector]? field directly + auto-derefs (a by-value Vector param
        ; corrupts .length). Element passed by value via .unwrap(), mirroring
        ; emit_operands -> emit_operand(first.unwrap()).
        procedure escape_walk_operands(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) @page true @stores true @deep true io linked

        ; Walk one statement reached through a ref[PlannedStatement]? field.
        procedure escape_walk_statement_ref(mutable this: Planner, stmt: ref[PlannedStatement]?) @page true @stores true @deep true io linked

        ; Walk one operand by value. choose op.expr mirrors emit_operand;
        ; the recursive arms mirror Planner.cpp::escapeWalkOperand.
        procedure escape_walk_operand(mutable this: Planner, op: PlannedOperand) @page true @stores true @deep true io linked

        ; Walk one statement by value. choose stmt mirrors emit_statement.
        procedure escape_walk_statement(mutable this: Planner, stmt: PlannedStatement) @page true @stores true @deep true io linked

        ; Walk one action by value (the whole PlannedAction, mirroring
        ; emit_action(action)). Handle the store first, then recurse into
        ; the source/target operand vectors.
        procedure escape_walk_action(mutable this: Planner, act: PlannedAction) @page true @stores true @deep true io linked

        ; Walk one function body. Mirrors emit_function_body: choose func.impl
        ; and feed the whole Action by value to escape_walk_action.
        ; ====================================================================
        ; --host-report: a census of the named-page constructions
        ; (`T^host(...)`, `T^this(...)`, any `^name`) whose value never leaves
        ; the routine that builds them. Such a value could be built on the
        ; routine's own local page and die with the frame; on the named page
        ; it lives until that region dies, which is what the sigil buys and
        ; what it costs. The verdict per candidate is the escape checker's
        ; own, asked as if the candidate were a local-page value:
        ;   (1) census_walk_* applies the inline rules: a return, throw or
        ;       break carrying the value, a `set` whose target is not a bare
        ;       local, a construction over the value, a closure capturing it.
        ;       A `let` whose initializer is the value, a non-primitive field
        ;       of it, a reference-like call RESULT on it or a construction
        ;       over it becomes an ALIAS (census_names); so does a `for`
        ;       variable over it and a bare local the value is `set` into.
        ;   (2) escape_walk_function_body applies the call-site rules with
        ;       the recorded summaries: region_of_operand answers LOCAL for
        ;       the candidate and its aliases (escape_census), the diagnostics
        ;       stay silent, escape_found is the verdict.
        ; Conservative where it is unsure (a verdict `local` is the claim; an
        ; `escapes` may be an over-approximation). Runs after
        ; check_interprocedural_escapes, so the summaries are in hand.
        procedure host_census(mutable this: Planner) @page true @stores true @deep true io linked

        procedure census_judge(mutable this: Planner, bound: ref[String]?, start: size_t, page: String, tname: String) @page true @persists true @stores true @deep true io linked

        ; Collect: every Box in the body is a candidate; a Box that is the
        ; whole initializer of a binding is judged under the binding's name.
        procedure census_collect_action(mutable this: Planner, act: PlannedAction) @page true @stores true @ret_nonlocal true @deep true io linked

        procedure census_collect_operands(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) @page true @stores true @deep true io linked

        procedure census_collect_statement_ref(mutable this: Planner, stmt: ref[PlannedStatement]?) @page true @stores true @ret_nonlocal true @deep true io linked

        procedure census_collect_statement(mutable this: Planner, stmt: PlannedStatement) @page true @stores true @deep true io linked

        procedure census_collect_operand(mutable this: Planner, op: PlannedOperand, bound: ref[String]?) @page true @stores true @deep true io linked

        ; Does this operand CARRY the candidate: the candidate box itself, an
        ; alias name (bare, or through fields to a non-primitive), a
        ; reference-like call result on an alias, `&x` / `x as T` of one.
        function census_carry(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; Is this operand the candidate construction itself?
        function census_is_candidate(this: Planner, op: PlannedOperand) @ret_args_3 true @deep true returns bool linked

        ; A call on a carrying receiver whose result is a reference or a
        ; view (`get`, `get_ptr`, `at`, `slice_from`, ...) hands out a
        ; pointer into the candidate.
        function census_call_yields_alias(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; A reference, a pointer, the NPO option of one, or a view.
        function census_type_is_ref_like(this: Planner, t: PlannedType) @ret_nonlocal true @deep true returns bool linked

        ; The inline `persists_args` rule (plan_call), and the put/add rule
        ; beside it: a callee that keeps its arguments' guts, or a container's
        ; `put`/`add`, stores a local-page argument beyond the frame unless
        ; the RECEIVER is frame-local itself. The verdict is the DEEP one
        ; (persists_deep_for#, every resolved callee under --host-report);
        ; a callee not in it is unknown and passes.
        procedure census_persisting_call_carries(mutable this: Planner, call: PlannedCall) @ret_nonlocal true @deep true returns bool io linked

        ; Does a persisted argument (beyond the receiver) hand over the candidate's
        ; ADDRESS — `&cand`/`&alias`, or a reference-typed alias name?
        function census_args_persist_address(this: Planner, call: PlannedCall) @ret_nonlocal true @deep true returns bool linked

        ; `&cand`/`&alias` (under any `as`), or a reference-typed alias name
        function census_operand_is_candidate_address(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function census_operands_carry(this: Planner, ops: ref[Vector[PlannedOperand]]?) @ret_nonlocal true @deep true returns bool linked

        ; A construction (tuple, variant, another box) with a carrying
        ; component holds a pointer into the candidate.
        function census_construction_carries(this: Planner, op: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function census_operands_carry_deep(this: Planner, ops: ref[Vector[PlannedOperand]]?) @ret_nonlocal true @deep true returns bool linked

        ; A `set` target that is a bare local becomes an alias; anything else
        ; (a field, a deref, a global) is a store the candidate escapes through.
        procedure census_target_aliases(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) @ret_nonlocal true @deep true returns bool linked

        procedure census_add_alias(mutable this: Planner, name: ref[String]?) @deep true linked

        ; Walk (1): the inline rules over one body for the current candidate.
        procedure census_walk_action(mutable this: Planner, act: PlannedAction) @deep true io linked

        procedure census_walk_operands(mutable this: Planner, ops: ref[Vector[PlannedOperand]]?) @deep true io linked

        procedure census_walk_statement_ref(mutable this: Planner, stmt: ref[PlannedStatement]?) @deep true io linked

        procedure census_walk_statement(mutable this: Planner, stmt: PlannedStatement) @deep true io linked

        procedure census_walk_operand(mutable this: Planner, op: PlannedOperand) @deep true io linked

        ; ====================================================================
        ; The CENSUS's persist question (host_census#), deeper than the gate's
        ; function_persists_param_guts: that one counts only a `put`/`add` on a
        ; non-local receiver, and making it count stores as well turned
        ; ~600 `arr.add(<call result>)` sites of the ports into hard errors
        ; (a call result carries a Local-life stamp even when its callee
        ; built it on an explicit page). Advisory here, so it may over-
        ; approximate. Does a body keep a parameter's guts beyond the call?
        ; True for a `put`/`add` on a receiver that is not a local, and for a STORE whose
        ; source carries a parameter and whose target head is not a local
        ; (`this`, another parameter, a global, a deref). A parameter travels:
        ; a local bound from it or storing it (`var d i; set d.f: p`), a local
        ; container it is `add`ed to, are TAINTED, so the later
        ; `set t.data: X(d)` into a parameter counts — the union
        ; copy/mutate/write-back idiom laundered the parameter through a
        ; local and the checker did not see it (2026-09-21: tscaly's
        ; `fill_interface_data`, a list freed under a live type). Nested
        ; blocks are walked; flow-insensitive within one body. The interface
        ; fact `@persists` is derived here too (facts_function#).
        procedure deep_trace_result(beyond: u64, this_mask: u64, pageof: u64, into: ref[Array[u64]]) @ret_nonlocal true @deep true linked

        ; a frame-local receiver (`pair.add(x)`) given a frame-local value at a
        ; position its callee keeps in the receiver: remember the receiver
        procedure deep_note_local_fill(mutable this: Planner, call: PlannedCall, off: size_t, plen: size_t, tmask: u64) @deep true linked

        ; where a REFERENCE or view a plain call answers lives, from the callee's
        ; residence class: 4 nowhere local, 2 on the page argument (judged), 3
        ; wherever that argument lives (judged); 1 and unknown answer -1 — the
        ; gate uses it only to LIFT a Local stamp, never to add one
        function ref_call_verdict(this: Planner, c: PlannedCall) @ret_nonlocal true @deep true returns int linked

        function ref_arg_lifted(this: Planner, arg: PlannedOperand) @ret_param_0 true @deep true returns bool linked

        procedure arg_is_resident_var_address(mutable this: Planner, a: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        function binding_init_has_call_life(this: Planner, b: PlannedBinding) @ret_nonlocal true @deep true returns bool linked

        function arg_is_local_filled(this: Planner, arg: PlannedOperand) @ret_nonlocal true @deep true returns bool linked

        ; a finding stops the walk — except while measuring (SCALYC_GATE_ALL),
