        procedure plan_simd_binary(mutable this: Planner, op: String, lt: PlannedType, rt: PlannedType, loc: Span) @page true @direct true @deep true returns PlannedType linked

        ; an intrinsic call operand the Emitter lowers by name (emit_simd#)
