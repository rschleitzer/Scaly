package scaly 0.1.0

; The token literal payload IS Syntax's Literal union — a single shared
; definition, not a mirror copy. Historically lexer declared its own
; byte-identical Literal family and the parser type-punned the two under
; last-write-wins glob resolution; unifying on Syntax.Literal removes that
; duplication (and the only cross-module glob-name collision) while keeping
; the invariant "the token literal and the AST literal are the same shape"
; true by construction. Syntax is declared before lexer and does not depend
; on it, so this import introduces no cycle.
use scalyc.compiler.Syntax.Literal
use scalyc.compiler.Syntax.StringLiteral
use scalyc.compiler.Syntax.CharacterLiteral
use scalyc.compiler.Syntax.FragmentLiteral
use scalyc.compiler.Syntax.IntegerLiteral
use scalyc.compiler.Syntax.BooleanLiteral
use scalyc.compiler.Syntax.FloatingPointLiteral
use scalyc.compiler.Syntax.HexLiteral

define lexer
{
    ; Token types
    define EmptyToken()
    define InvalidToken()
    define ColonToken()
    define IdentifierToken(name: String)
    define AttributeToken(name: String)
    define PunctuationToken(sign: u8)
    define LiteralToken(value: Literal)

    define Token union (
        Empty: EmptyToken,
        Invalid: InvalidToken,
        Colon: ColonToken,
        Identifier: IdentifierToken,
        Attribute: AttributeToken,
        Punctuation: PunctuationToken,
        Literal: LiteralToken
    )

    ; Snapshot of the lexer's mutable scan state, for backtracking.
    define LexerState
    (
        current: pointer[char]
        position: size_t
        previous_position: size_t
        token: Token
    )

    ; ========================================================================
    ; Lexer - Tokenizes Scaly source code
    ; ========================================================================

    define Lexer
    @resident true (
        source: String
        var current: pointer[char]
        end: pointer[char]
        var position: size_t
        var previous_position: size_t
        var token: Token
    )
    {
        init (src: String) linked




















        procedure read_character(mutable this) linked











        procedure empty(mutable this) linked




        function is_at_end(this) @ret_param_0 true returns bool linked


        procedure advance(mutable this) linked




















































































































        procedure scan_line_feed(mutable this) @page true @direct true returns Token linked




































        procedure scan_identifier(mutable this) @page true @direct true returns Token linked

























        procedure scan_attribute(mutable this) @page true @direct true returns Token linked

























        procedure scan_operator(mutable this) @page true @direct true returns Token linked






























        procedure scan_string_literal(mutable this) @page true @direct true returns Token linked

























































        ; Single-quoted strings are freeform identifiers (like SQL's 'column name')
        procedure scan_string_identifier(mutable this) @page true @direct true returns Token linked
























































        procedure scan_fragment_literal(mutable this) @page true @direct true returns Token linked





































        procedure scan_numeric_literal(mutable this) @page true @direct true returns Token linked






























        procedure scan_integer_literal(mutable this, start: pointer[char], initial_length: size_t) @page true @direct true returns Token linked


























        procedure scan_fraction(mutable this, start: pointer[char], initial_length: size_t) @page true @direct true returns Token linked























        procedure scan_exponent(mutable this, start: pointer[char], initial_length: size_t) @page true @direct true returns Token linked




















        procedure scan_hex_literal(mutable this, start: pointer[char], initial_length: size_t) @page true @direct true returns Token linked




















        procedure scan_boolean_literal(mutable this) @page true @direct true @ret_caller true returns Token linked















        procedure skip_whitespace(mutable this, skip_line_feed: bool) linked













































































        procedure handle_single_line_comment(mutable this) linked















        procedure handle_multi_line_comment(mutable this) linked








































        ; Parser helper: parse keyword
        procedure parse_keyword(mutable this, keyword: String) @ret_nonlocal true returns bool linked




















        ; Parser helper: parse identifier, returns empty string if not found
        ; or if the identifier is a keyword (matches C++ parseName behaviour).
        procedure parse_identifier(mutable this, keywords: HashSet[String]) @page true @direct true @ret_caller true returns String linked





















        ; Parser helper: peek identifier without consuming
        procedure peek_identifier(mutable this) @page true @direct true @ret_caller true returns String linked














        ; Parser helper: parse attribute
        procedure parse_attribute(mutable this) @page true @direct true @ret_caller true returns String linked


















        ; Parser helper: parse punctuation
        procedure parse_punctuation(mutable this, c: u8) @ret_nonlocal true returns bool linked




















        ; Parser helper: parse colon
        procedure parse_colon(mutable this) @ret_nonlocal true returns bool linked

















        ; Backtracking: snapshot/restore the scan position + pending token.
        ; Used by the parser's speculative else-lookahead so a separator colon
        ; can be un-consumed when no else follows (no-else if).
        procedure save_state(this) @page true @direct true @ret_param_0 true returns LexerState linked


        procedure restore_state(mutable this, s: LexerState) linked






    }

    ; ========================================================================
    ; Test function
    ; ========================================================================

    function test() @ret_nonlocal true returns int linked















































































































































































































































}
