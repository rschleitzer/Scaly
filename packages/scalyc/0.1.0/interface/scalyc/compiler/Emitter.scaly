        ; Push a loop context onto the stack
        procedure push_loop(mutable this, exit_block: LLVMBasicBlockRef, continue_block: LLVMBasicBlockRef, loop_label: String, result_slot: LLVMValueRef) @deep true @deep_this_30 true @deep_whole_30 true linked





        ; Resolve the loop a break/continue targets. An empty loop_label means the
        ; innermost loop (top of stack); a non-empty loop_label scans from innermost
        ; outward for the matching loop. Returns null when no match is found.
        function find_loop_context(this, loop_label: String) @ret_param_0 true @deep true returns ref[LoopContext]? linked



















        ; Pop a loop context from the stack
        procedure pop_loop(mutable this) @deep true linked




    }

