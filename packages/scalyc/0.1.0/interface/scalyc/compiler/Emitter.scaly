        function lookup_variable(this, name: String) @direct true @ret_param_0 true @deep true returns LLVMValueRef linked


























        procedure define_variable(mutable this, name: String, value: LLVMValueRef) @persists true @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true linked





        procedure clear_local_variables(mutable this) @deep true linked






        ; s128: push a marker recording the current local_var_names.length.
        ; Sites that introduce a fresh Scaly scope (choose case body, if
        ; branch, while/for body, try arms, statement block) call enter_scope
        ; on entry and exit_scope right before their terminator. Mirrors
        ; stage-0's Emitter::enterScope / exitScope (which use a SmallVector
        ; of similar snapshots).
        procedure enter_scope(mutable this) @ret_nonlocal true @deep true linked




        ; s128: pop the most recent scope marker, truncate local_var_names
        ; and local_var_values back to that snapshot so any define_variable
        ; calls made inside the scope are forgotten. Sibling arms calling
        ; enter_scope/exit_scope around their bodies stop leaking names into
        ; each other; lookup_variable's forward-iteration first-match rule
        ; now picks the most recently defined version visible at the current
        ; point.
        procedure exit_scope(mutable this) @deep true linked






























































        ; ========================================================================
        ; Type Mapping
        ; ========================================================================

        ; Map a PlannedType to an LLVM type
        ; True when `name` is a delegate (function-pointer) concept declared in the
        ; current plan. Linear scan over current_plan.delegates, which is empty for
        ; delegate-free programs (the scaly package) — so the common path is a
        ; single null/length check (GAP B).
        function is_delegate_type_name(this, name: String) @ret_nonlocal true @deep true returns bool linked

















        procedure map_type(mutable this, planned_type: PlannedType) @direct true @deep true returns LLVMTypeRef linked































































































































































































        ; Is this planned type pointer-SHAPED, i.e. does map_type's `ptr` answer
        ; describe the value itself rather than fall out of the last-resort
        ; fallback at the bottom of map_type?
        ;
        ; map_type ends in an opaque `ptr` for any name it cannot resolve — most
        ; often a BY-VALUE struct from another package that this root never plans
        ; (the is_runtime_opaque_struct set: Page, PageList, StackBucketHeader,
        ; ...; ensure_member_layout# deliberately skips exactly those). The IR
        ; stays valid, but a caller that reads the type KIND back cannot tell the
        ; placeholder from a real pointer, and every such caller then does the
        ; pointer thing to a struct: emit_sizeof answers 8 for a 40-byte Page, and
        ; emit_member_address LOADS the field and stores THROUGH it — a wild store
        ; that lands wherever the struct's first 8 bytes happen to point.
        ; Deciding on the NAME instead is exact: only pointer/ref, an NPO Option
        ; (pointer-payload), a delegate (function pointer) and the intrinsics
        ; (which map_type resolves before ever reaching the fallback) are really
        ; pointers.
        procedure type_is_pointer_shaped(mutable this, t: PlannedType) @ret_nonlocal true @deep true returns bool linked















        ; deref_slot_holds_a_reference#: does `*p` name a slot that holds a
        ; REFERENCE rather than the struct itself? The s136 struct-load in the
        ; deref-store arm is correct only for a slot holding the struct; when
        ; the slot holds a reference, loading sizeof(struct) bytes and storing
        ; them into the 8-byte slot writes the VALUE where the caller expects
        ; an ADDRESS.
        ;
        ; ★ Both halves of the old inline test asked the NAME and both were too
        ; narrow -- the ninth sighting of the ask-the-SHAPE-not-the-NAME seam:
        ;   * the OUTER name accepted only `pointer`, so an out-cell in its
        ;     converted spelling (`ref[ref[X]?]`, 2026-08-28) was never seen;
        ;   * the INNER name accepted only `pointer`/`ref`, so `ref[X]?` -- which
        ;     IS `Option[ref[X]]` -- failed a test meant to accept everything
        ;     reference-shaped, and `pointer[ref[X]?]` was wrong too.
        ; Measured before the fix: `set c: it` on a `ref[ref[Item]?]` emitted
        ; `load %Item` + `store %Item` into the 8-byte cell, at rc 0. The one
        ; opensp site wrote `&prosyn` and carried the workaround in a comment.
        ;
        ; ★ NOT type_is_pointer_shaped#: that helper answers a different
        ; question (is map_type's opaque `ptr` a real pointer) and says true for
        ; the INTRINSICS, so it would call a `pointer[int]` slot a reference.
        function deref_slot_holds_a_reference(this, deref_rt: PlannedType) @deep true returns bool linked

















        ; The element type a GEP should step by for `pointer[T] + n`. map_type is
        ; the answer except when it hands back its unresolved-name placeholder
        ; (see type_is_pointer_shaped#) — then the stride would be 8 for a struct
        ; of any size: `p + 1` on a pointer[Page] stepped 8 bytes instead of 40,
        ; so walking an array of a cross-package struct read every element from
        ; inside the first one. The literal layouts synthesize_literal_struct#
        ; keeps for exactly the never-laid-out stdlib types give the real stride;
        ; if even that has no entry, keep map_type's answer rather than emit a
        ; GEP over a type this module has no definition for.
        procedure stride_type(mutable this, mutable elem: PlannedType) @direct true @deep true returns LLVMTypeRef linked
















        ; s89: Create a placeholder named struct with `{ ptr }` body for
        ; cross-package types not in plan.structures. Used by emit_function_decl
        ; and emit_call to give the sret type attribute a sized type. Single-
        ; pointer-struct layout matches `String` (the only cross-package struct
        ; return exercised by the stretch metric); other multi-field structs
        ; (e.g. Vector) would over-estimate the slot size, which is incorrect
        ; for stack layout but the failure mode is that data after the struct
        ; gets clobbered, not that the function corrupts memory beyond bounds.
        procedure get_or_create_struct_placeholder(mutable this, name: String, mangled_name: String) @direct true @deep true returns LLVMTypeRef linked






















        ; s99: Synthesize a literal LLVM struct type from a generic
        ; PlannedStructure's properties. Used by emit_member_assignment
        ; load-through when the inner concrete type (e.g. Vector[String])
        ; isn't materialized in struct_cache. Walks current_plan.structures
        ; for an entry matching `name`, maps each property type, and builds
        ; a literal struct via LLVMStructTypeInContext.
        ;
        ; Type variables in the generic (e.g. `pointer[T]`) map to ptr,
        ; concrete primitives map normally. Returns null if no Structure
        ; matches or it has no properties.
        procedure synthesize_literal_struct(mutable this, name: String) @direct true @deep true returns LLVMTypeRef linked





























































































































































































































        ; s89: Cached sret kind id (lazily looked up). 0 = uninitialized.
        function sret_kind_id(this) @ret_caller true @deep true returns u32 linked




        function noalias_kind_id(this) @ret_caller true @deep true returns u32 linked




        ; A callee that never returns must SAY so, or the block after the call
        ; stays live: LLVM then assumes the call may fall through and may
        ; clobber memory, so nothing may be hoisted out of a loop whose body
        ; contains a trap. That is what a bounds check costs without this.
        ; Measured 2026-08-27 over 200M container reads, built the way the
        ; ports are built (whole-program `opt -O2` + `llc -O2`): the guarded
        ; read cost three extra loads per element and 0.11 s against 0.07 s
        ; for the same loop over a raw pointer; with the attribute LLVM proves
        ; the guard redundant against the loop condition, deletes the cold
        ; block INCLUDING its message, and the loop comes out instruction-
        ; identical to the pointer walk (`ldr x13, [x11], #8` + subs + add +
        ; b.ne). The attribute carries on a VARARGS declaration too, which is
        ; the shape the s186 on-the-fly path emits — measured, not assumed.
        ;
        ; The name list is closed and holds only entry points that cannot
        ; return by their own C contract. `exit` is the one this tree traps
        ; with (exit 14/15/17/19/20); `abort` and `_exit` are here because a
        ; port may reach for them and a missing attribute is silent.
        procedure mark_noreturn_callee(mutable this, mutable fn: LLVMValueRef, name: String) @deep true linked























































































        procedure add_function_attribute(mutable this, mutable fn: LLVMValueRef, mutable name: String) @deep true linked








        ; setjmp is the one callee in this compiler that RETURNS TWICE, and
        ; the attribute is not cosmetic: without it LLVM may promote a local
        ; of the catching function into a register across the call, and after
        ; the jump that register holds whatever it held before — the classic
        ; setjmp trap, which C answers with `volatile`. With the attribute the
        ; backend keeps what it must in memory, so a `try` can use its own
        ; locals in the else arm (measured against clang's own output for the
        ; same shape, TRAPS.md 5.6).
        procedure mark_returns_twice_callee(mutable this, mutable fn: LLVMValueRef) @deep true linked












        ; libc setjmp. The buffer comes from scaly_catch_push (the shim owns
        ; the jmp_buf layout, which is OS- and arch-specific and must not reach
        ; the ONE committed seed), so this declaration only needs the pointer.
        ;
        ; ★★★COFF IS DIFFERENT, AND IT IS NOT A SPELLING QUESTION (2026-09-20,
        ; TRAPS.md 3.22). On Win64 the CRT's catch point is `_setjmp` and it
        ; takes the FRAME as a SECOND argument, in RDX. The C header declares
        ; one parameter because the COMPILER supplies the second — which is why
        ; the two-argument form cannot be written in C and can be written here,
        ; and why the measurement that said "this spelling does not exist on
        ; this target" was about the header, not about the ABI.
        ;
        ; Called with one argument the frame slot keeps whatever RDX happened
        ; to hold (measured: 0x2002), and `Frame` is the FIRST field of the
        ; jmp_buf — the field `longjmp` reads to choose between restoring
        ; registers and unwinding through SEH. A garbage value there sends
        ; RtlUnwindEx to a phantom frame and the process dies with no message
        ; and no stderr; the raw NTSTATUS varies with the Windows build and is
        ; NOT a fingerprint (0xC00000FF, 0xC0000005 and 0xC0000028 were all one
        ; bug). Every catching program on Windows died this way.
        procedure get_setjmp_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked



















        ; The COFF half of get_setjmp_fn: `i32 @_setjmp(ptr buf, ptr frame)`.
        ; Exactly what clang emits for a C `setjmp` on this target, read off
        ; its own output rather than guessed.
        procedure get_setjmp_fn_coff(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked

















        ; `declare ptr @llvm.frameaddress.p0(i32 immarg)` — the frame `_setjmp`
        ; wants. Declared by NAME and TYPE: LLVM recognises an intrinsic by its
        ; mangled name, and `p0` is the address space of the pointer it
        ; answers. It is the only `llvm.*` this emitter declares.
        procedure get_frameaddress_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked














        ; Build the catch point's `setjmp` call — two arguments on COFF, one
        ; everywhere else. It is its own procedure so the `try` emission stays
        ; one statement at the call site.
        procedure emit_catch_setjmp(mutable this, mutable sj_fn: LLVMValueRef, mutable buf: LLVMValueRef) @direct true @ret_caller true @deep true returns LLVMValueRef linked





















        ; The catch-point shim (scaly/memory/panic.c). push takes the two
        ; function POINTERS that reach the region watermark and the unwind, so
        ; that neither this file nor the C shim writes the other's mangled
        ; names; it answers a pointer to the frame's jmp_buf.
        procedure get_catch_fn(mutable this, mutable name: String, nargs: int, returns_ptr: bool) @direct true @ret_caller true @deep true returns LLVMValueRef linked



















        ; The kind of the panic that was caught, as the variant tag of the
        ; prelude's RuntimeFault, and the filler that writes a variant's
        ; payload record in place. The FILLER exists so the record's field
        ; layout stays in the shim instead of being rebuilt with GEPs here.
        procedure get_panic_kind_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked












        ; ★ONE filler for every kind, dispatching in the shim on the kind it
        ; just recorded -- not one function per variant. That is what keeps
        ; this emitter kind-agnostic: the switch below sends every arm to the
        ; same callee, and the arm that runs is by construction the one whose
        ; tag equals that kind. A third trap kind appends a variant in the
        ; prelude and a case in the shim, and touches nothing here.
        procedure get_panic_fill_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked















        ; ★★★The two Scaly routines the shim calls back into, referenced BY
        ; THEIR ITANIUM NAMES -- which freezes their parameter types, the cost
        ; CLAUDE.md names for the eight symbols that already pay it. Grep for
        ; these strings before re-signing scaly_panic_mark or
        ; scaly_panic_unwind_to; the RETURN is free (Itanium does not encode
        ; one). They are looked up rather than declared where possible, so a
        ; rename shows up as an undefined symbol at link time and not as a
        ; silently wrong call.
        procedure get_panic_mark_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked












        procedure get_panic_unwind_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked















        ; The two runtime prints the emitted traps use. Both live in
        ; libscaly.a, which EVERY `-o` link pulls in (SCALY_HOME's lib or the
        ; cwd fallback), so a generated call resolves in exactly the programs
        ; the s186 on-the-fly path already emits runtime calls into.
        procedure get_eputs_fn(mutable this) @direct true @deep true returns LLVMValueRef linked


















        procedure get_eputnl_fn(mutable this) @direct true @deep true returns LLVMValueRef linked















        ; The stdlib's null-unwrap panic (scaly/memory/root_pages.scaly). Same
        ; shape as get_eputs_fn: the body lives in libscaly.a, so a program's
        ; module carries a `declare` and the noreturn attribute has to be put
        ; on by hand -- mark_noreturn_callee knows this mangled name.
        ;
        ; ★★★The literal FREEZES scaly_panic_null's parameter types, the ninth
        ; such case in this tree (CLAUDE.md's rule): grep for the string before
        ; re-signing it. The RETURN is free -- Itanium does not encode one.
        procedure get_panic_null_fn(mutable this) @direct true @deep true returns LLVMValueRef linked



















        ; libc `exit`. Declared with the C prototype (i32, not Scaly's 64-bit
        ; `int`) and marked noreturn through the same helper every other trap
        ; callee goes through — without the attribute the block after the call
        ; stays live and nothing may be hoisted out of a loop containing a trap.
        procedure get_exit_fn(mutable this) @direct true @ret_caller true @deep true returns LLVMValueRef linked
















        ; `x as ref[T]` is this language's `!`: the author asserts that a
        ; nullable value is present. Until now NOTHING checked the assertion --
        ; the three `ref` gates make a null unrepresentable in a DECLARATION
        ; (null into a ref, testing a ref, an Option into a ref are each a hard
        ; rc 4), so the unwrap is the one door left, and a lie walked through it
        ; silently: the first member access on the result was a SIGSEGV, rc 139,
        ; with no message -- and stdout is buffered, so the signal took the
        ; program's last words with it too. 750 such unwraps stand in the tree.
        ;
        ; The check belongs HERE and not in the accessors: this is the single
        ; site where the claim is made. In an accessor it would test what the
        ; declaration already guarantees, and it would still leave the ten
        ; thousand ordinary `.field` hops unguarded.
        ;
        ; Cost is a compare and a branch into a cold block that ends in
        ; `unreachable`; with the noreturn attribute above LLVM hoists across it
        ; and, where the value is provably non-null, deletes the whole thing.
        ; Nullable in the sense the unwrap asserts away: the NPO Option
        ; wrapper (`ref[T]?` / `pointer[T]?`) or a bare pointer.
        function type_may_be_null(this, t: PlannedType) @ret_nonlocal true @deep true returns bool linked








        ; The enclosing symbol's name, for the trap message. There is no source
        ; location at run time; a mangled name is what a reader can grep for.
        procedure current_function_label(mutable this) @ret_caller true @deep true returns pointer[char] linked







        procedure emit_null_unwrap_trap(mutable this, mutable value: LLVMValueRef, mutable site: pointer[char]) @deep true linked





































        ; s89: Predicate — does a Scaly function with this return type need
