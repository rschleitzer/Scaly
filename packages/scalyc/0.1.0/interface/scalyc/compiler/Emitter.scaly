        procedure parfor_weight_statement(mutable this, stmt: PlannedStatement) @ret_nonlocal true @deep true returns size_t linked





























        procedure parfor_weight_call(mutable this, call: PlannedCall) @ret_nonlocal true @deep true returns size_t linked














        procedure parfor_weight_operand(mutable this, op: PlannedOperand) @ret_nonlocal true @deep true returns size_t linked























































































































































































































        procedure emit_parallel_for(mutable this, mutable for_expr: PlannedFor) @direct true @ret_nonlocal true @deep true @deep_beyond_2 true returns LLVMValueRef linked



































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































































        ; Emit a while loop
        procedure emit_while(mutable this, mutable while_expr: PlannedWhile) @direct true @ret_nonlocal true @deep true @deep_beyond_2 true returns LLVMValueRef linked



























































































        ; Emit a repeat loop — an infinite loop that exits only via `break`.
        ; When the repeat yields a value (`let x repeat { ... break v }`), a
        ; result slot is allocated; emit_break stores into it and the exit
        ; block loads it as the repeat expression's value.
        procedure emit_repeat(mutable this, mutable repeat_expr: PlannedRepeat) @direct true @deep true @deep_beyond_2 true returns LLVMValueRef linked








































        ; Emit a try expression
        ; emit_try_panic_catch: a `try ... else` whose condition throws
        ; NOTHING, which since 2026-09-07 catches a runtime PANIC instead of
        ; being the silent no-op it was (TRAPS.md 5.1). The shape:
        ;
        ;     %buf = call ptr @scaly_catch_push(@mark, @unwind)
        ;     %sj  = call i32 @setjmp(ptr %buf)     ; returns_twice
        ;     br i1 (%sj == 0), %try.body, %try.catch
        ;   try.body:   <condition> ; @scaly_catch_pop()   ; br %try.end
        ;   try.catch:  @scaly_catch_caught()  ; <else>    ; br %try.end
        ;
        ; ★★★The push and the setjmp must come BEFORE the condition is
        ; emitted, which is why this is a separate function hooked in at the
        ; TOP of emit_try: that one emits its operands first, and a catch point
        ; installed after the work it guards would catch nothing.
        ;
        ; ★Both forms land here: the `else` arm and the `when` arms, the
        ; latter switching on the panic's KIND below. No union VALUE is ever
        ; materialised -- see the note at the switch.
        ;
        ; ★No value is bound on the catch path: the binding leaks into the
        ; enclosing scope (see plan_try) and the else arm of every shape in the
        ; tree ends in a return or a throw, so nothing downstream reads it.
        procedure emit_try_panic_catch(mutable this, mutable try_expr: PlannedTry) @direct true @deep true @deep_beyond_2 true returns LLVMValueRef linked









































































































































        procedure emit_try(mutable this, mutable try_expr: PlannedTry) @direct true @deep true @deep_beyond_2 true returns LLVMValueRef linked




























































































































































































































        ; ========================================================================
        ; Type Operation Emission
        ; ========================================================================

        ; Emit sizeof
        procedure emit_sizeof(mutable this, mutable sizeof_expr: PlannedSizeOf) @direct true @deep true returns LLVMValueRef linked





























        ; Emit alignof
        procedure emit_alignof(mutable this, alignof_expr: PlannedAlignOf) @direct true @ret_caller true @deep true returns LLVMValueRef linked






        ; Emit is expression (type test)
        procedure emit_is(mutable this, mutable is_expr: PlannedIs) @direct true @deep true returns LLVMValueRef linked











































































































































        ; Emit as expression (type cast)
        procedure emit_as(mutable this, mutable as_expr: PlannedAs) @direct true @deep true returns LLVMValueRef linked
















































































































































































































        ; Emit variant construction (e.g., Result.Ok value, Option.Some value)
        procedure emit_variant_construction(mutable this, mutable vc: PlannedVariantConstruction) @direct true @deep true returns LLVMValueRef linked






















































































































































































        ; ========================================================================
        ; Statement Emission
        ; ========================================================================

        ; Emit a statement
        ; s178: window wrapper around emit_statement_inner. Each statement
        ; opens its own temp-pool window; pooled slots acquired while
        ; emitting it are released at its end unless captured (see
        ; release_statement_temps). Saving/restoring the window start
        ; keeps nested statements (loop bodies, choose/if arms) from
        ; releasing the enclosing statement's temps, while statements
        ; INSIDE a loop body or arm still recycle each other's slots —
        ; that's where collapse_operand_sequence#'s ~450 spill slots live.
        ; Values cannot leak across windows: emit_statement returns only
        ; bool, so expression values always flow through emit_action /
        ; emit_operand inside one window.
        procedure emit_statement(mutable this, mutable stmt: PlannedStatement) @ret_nonlocal true @deep true returns bool linked











        procedure emit_statement_inner(mutable this, mutable stmt: PlannedStatement) @deep true returns bool linked
































        ; Emit an action (expression statement or assignment)
        ; True when the operand tree mentions `name` — as a bare variable, a
        ; member-access hop, or inside nested call/tuple/as operands. Used by the
        ; in-place field-construction aliasing guard; CONSERVATIVE: any expression
        ; shape the walker doesn't enumerate counts as a mention (keep the
        ; scratch when in doubt).
        function operand_mentions_name(this, op: PlannedOperand, name: String) @ret_param_1 true @deep true returns bool linked


































































































        ; Aliasing guard for in-place field construction: true when any ctor arg
        ; references the target variable or any hop of the target member chain.
        ; `set f: String(f)` must KEEP the scratch — the ctor reads the old value
        ; while in-place construction would clobber it first.
        function ctor_args_mention_chain(this, call: PlannedCall, variable: PlannedVariable, chain: Vector[PlannedMemberAccess]) @ret_nonlocal true @deep true returns bool linked































        ; In-place construction THROUGH A POINTER: `set *p: Ctor(args)` (and
        ; `set r: Ctor(args)` on a reference, which the planner rewrites into
        ; the same deref) constructs straight into `*p`. Only for a LOCAL-life
        ; constructor without a page parameter -- the residency default the
        ; planner gives a type whose bodies derive a page from `this`
        ; (concept_needs_this_residency#). Built as a temporary on this frame's
        ; page and copied, such an object carried guts that died with the
        ; frame: `allocate(sizeof StringBuilder)` + `set *p: StringBuilder()`
        ; ended in a bus error at the first append, rc 0 (2026-09-24). Built
        ; in place, its `Page.get(this)` answers the page `p` points into.
        ; Plain value types (Unspecified life) keep the copy path.
        ; Gates: the pointer is a plain Variable, no ctor argument mentions it.
        procedure emit_in_place_deref_ctor(mutable this, mutable action: PlannedAction) @direct true @deep true returns LLVMValueRef linked




















































































        ; In-place field construction: `set X.field...: Ctor(args)` with a single
        ; construction source constructs directly on the final field address
        ; instead of a discarded scratch. The scratch LEAKED sizeof(struct) on the
        ; owner page per field init (a region-alloc'd ctor result was loaded and
        ; stored by value into the field, orphaning the allocation) and the
        ; whole-aggregate load+store is the s178 spill class. IR-verified: the
        ; scratch page always equals the destination page (Page.get(this) inside
        ; the ctor = Page.get(&field) = owner page), so interior buffer placement
        ; is unchanged. Gates (all checked BEFORE any IR is emitted):
        ;   - target is a Variable with a member-access chain;
        ;   - source is exactly one C1E constructor Call with no trailing chain,
        ;     no page param, and life Unspecified (stack scratch) or ^this
        ;     (owner page) — Local/Call/^other scratches keep the legacy copy;
        ;   - the final field's LLVM type IS the ctor's struct type (by-value
        ;     field; pointer-storing fields keep the legacy path);
        ;   - no ctor arg mentions the target chain (aliasing guard).
        ; Returns null (nothing emitted) when not applicable — emit_action then
        ; falls through to the legacy scratch path.
        procedure emit_in_place_field_ctor(mutable this, mutable action: PlannedAction) @direct true @deep true returns LLVMValueRef linked








































































































        procedure emit_action(mutable this, mutable action: PlannedAction) @direct true @deep true returns LLVMValueRef linked





























































































































































































































































































































































































































































































        ; s86: when emit_action is storing a stack-alloca'd ctor result into a
        ; member of `this` (a heap-allocated parent), copy the struct value onto
        ; the parent's page so the field stores a stable heap pointer rather
        ; than a stack-frame address that goes invalid after init returns.
        ;
        ; Triggers only for: variable name "this" + single-operand source whose
        ; expr is a Call with Lifetime.Unspecified and a C1 (Itanium ctor)
        ; mangled name. Other shapes pass through unchanged.
        procedure maybe_heap_copy_ctor_value(mutable this, value: LLVMValueRef, var_ptr: LLVMValueRef, variable: PlannedVariable, source: ref[Vector[PlannedOperand]]?) @direct true @deep true returns LLVMValueRef linked





































































































        ; Compute the ADDRESS of a member-access chain's final field (base setup
        ; + GEP-chain walk). Factored out of emit_member_assignment so the
        ; in-place field construction path (emit_in_place_field_ctor) can compute
        ; the destination without emitting a store.
        ; reference_pointee_struct#: the LLVM struct a `ref[T]`/`pointer[T]`
        ; points at, or null when `t` is no such reference or T is no laid-out
        ; record.
        procedure reference_pointee_struct(mutable this, t: PlannedType) @direct true @deep true returns LLVMTypeRef linked


























        procedure emit_member_address(mutable this, mutable var_ptr: LLVMValueRef, planned_var: PlannedVariable, mutable members: ref[Vector[PlannedMemberAccess]]?) @direct true @deep true returns LLVMValueRef linked









































































































































































































































































        ; Helper for member field assignment
        procedure emit_member_assignment(mutable this, mutable var_ptr: LLVMValueRef, mutable planned_var: PlannedVariable, mutable members: ref[Vector[PlannedMemberAccess]]?, mutable value: LLVMValueRef) @direct true @deep true returns LLVMValueRef linked








































        ; Emit a binding (let/var declaration)
        ; The signedness of a binding's initializer, read off its planned type
        ; (the first collapsed operand); signed when nothing says otherwise, as
        ; is_signed_type# decides.
        function binding_initializer_is_signed(this, binding: PlannedBinding) @deep true returns bool linked













        procedure emit_binding(mutable this, mutable binding: PlannedBinding) @ret_nonlocal true @deep true returns bool linked

















































































































































































































































































































































        ; Emit a return statement
        procedure emit_return(mutable this, mutable ret: PlannedReturn) @ret_nonlocal true @deep true returns bool linked


















































































































































        ; Emit a throw statement
        procedure emit_throw(mutable this, mutable throw_stmt: PlannedThrow) @ret_nonlocal true @deep true returns bool linked
































































































































        ; Emit a break statement
        procedure emit_break(mutable this, mutable brk: PlannedBreak) @ret_nonlocal true @deep true returns bool linked







































        ; Emit a continue statement
        procedure emit_continue(mutable this, mutable cont: PlannedContinue) @ret_nonlocal true @deep true returns bool linked












        ; ========================================================================
        ; Loop Stack Management
