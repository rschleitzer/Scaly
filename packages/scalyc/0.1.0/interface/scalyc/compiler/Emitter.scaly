        procedure build_throws_result_type(mutable this, mutable value_ty: LLVMTypeRef, mutable throws_ty: LLVMTypeRef, mangled_name: String) @persists true @direct true @deep true @deep_this_8 true @deep_whole_8 true returns LLVMTypeRef linked





































































