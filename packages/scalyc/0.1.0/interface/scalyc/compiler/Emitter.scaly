        ; ========================================================================
        ; Tuple and Matrix Emission
        ; ========================================================================

        ; The page allocation behind a region-allocated tuple, lifted out of
        ; emit_tuple so BOTH of its construction paths can reach it.
        ;
        ; ★ It was inline in the per-field path only, and the zero-component
        ; path above it allocated an `alloca` and returned THAT pointer even
        ; when `is_region_alloc` was set -- so `T^page()` on a concept with no
        ; matching `init` (the positional-tuple path, whose zero-argument
        ; data-class case is a deliberate exemption in fill_default_components)
        ; answered an address in the DEAD FRAME, rc 0 and nothing said.
        ; Measured on opensp's `EventAux` as rc 139 in `Lpd.get_name`, with the
        ; SGML corpus at 380/380 -- two further sites (`HuState`) were live on
        ; the parser path and the corpus never touched them.
        ;
        ; Answers a null handle when the tuple is not region-allocated or the
        ; page name resolves to nothing; the caller then falls back to
        ; acquire_temp, exactly as the inline version did.
        ; The page resolution behind a region construction, taken by LIFETIME
        ; rather than by tuple, so the VARIANT path can reach it too: a
        ; `Thing.Alpha^host(...)` carries its sigil on `union_type.life` and
        ; used to land on a stack `alloca` with the sigil dropped in silence —
        ; the same class as the 2026-08-29 tuple-path fix, one bahn over.
        procedure region_alloc_tuple(mutable this, tuple: PlannedTuple, mutable struct_type: LLVMTypeRef) @direct true @deep true returns LLVMValueRef linked


        procedure region_alloc_life(mutable this, is_region: bool, life: Lifetime, mutable struct_type: LLVMTypeRef) @direct true @deep true returns LLVMValueRef linked










































































































        ; Emit a tuple construction
