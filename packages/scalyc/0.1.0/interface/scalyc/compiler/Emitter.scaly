        procedure ensure_region_walker_for_call(mutable this, mutable call: PlannedCall) @deep true linked























        ; check_receiver_fits_page#: a record that derives its page from its OWN
        ; address — `^this`, `Page.get(this)` — must lie inside one page, and an
        ; object larger than a page minus its header is allocated OVERSIZED, so
        ; the page found there answers exit 19 at run time, frames away from the
        ; cause (the compiler's own Planner record met it at 4 056 of 4 056
        ; bytes). Checked at emission, where the true size is known: the
        ; receiver's ABI size plus the page header against the stdlib's
        ; PAGE_SIZE (config.page_size, from Planner.page_size_constant#).
        procedure check_receiver_fits_page(mutable this) @deep true linked







































        ; `Page.get(this)` inside a method: the receiver's own page
        function call_is_page_of_this(this, call: PlannedCall) @deep true returns bool linked



























