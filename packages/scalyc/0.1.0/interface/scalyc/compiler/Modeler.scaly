    ; ============================================================================
    ; Parameter handling
    ; ============================================================================

    ; Model a `define NAME delegate(params) returns T throws E` concept (GAP B).
    ; The delegate names a function (closure) type; the parameter Items and the
    ; return type drive both lambda monomorphization against this signature and the
    ; LLVM function type used at indirect call sites.
    function handle_delegate(name: String, syntax: DelegateSyntax) @page true @direct true @ret_caller true @deep true returns Delegate linked























    function handle_parameter_set(syntax: ParameterSetSyntax) @page true @direct true @ret_caller true @deep true returns Vector[Item] linked








































