    ; ============================================================================

    procedure handle_operand(mutable syntax: OperandSyntax) @page true @direct true @deep true returns Operand io mutable modeler_error_count reads modeler_error_count linked



















































    procedure handle_operands(mutable syntax: ref[Vector[OperandSyntax]]?) @page true @direct true @ret_caller true @deep true returns Vector[Operand] io mutable modeler_error_count reads modeler_error_count linked





















