    procedure handle_union(name: String, mutable path: String, mutable syntax: UnionSyntax, is_private: bool) @page true @direct true @ret_caller true @deep true returns Union io mutable modeler_error_count reads modeler_error_count linked






























































    ; ============================================================================
    ; Definition handling
    ; ============================================================================

    procedure handle_definition(mutable path: String, mutable syntax: DefinitionSyntax, is_private: bool) @page true @direct true @deep true returns Concept io mutable modeler_error_count reads modeler_error_count linked






























































































    ; ============================================================================
    ; Module building
    ; ============================================================================

    ; Append a child module loaded from <path>/<name>.scaly to `modules`. The
    ; helper exists in procedure form so the choose-arm in build_module# is a
    ; single call (works around a stage-0 codegen issue where an in-place
    ; collection .add inside a choose-arm corrupts the caller's frame).
    procedure handle_module_decl(path: String, mod_syntax: ModuleSyntax, is_private: bool, mutable modules: ref[Array[Module]]) @page true @direct true @ret_caller true @deep true @deep_into_3_2 true io mutable modeler_error_count reads modeler_error_count linked





    ; Format a VersionSyntax payload as "<majorMinor>.<patch>". The lexer
    ; already formatted majorMinor as "0.1" (FloatingPoint) or "0" (Integer).
    function format_version(version_ref: ref[VersionSyntax]) @page true @direct true @ret_caller true @deep true returns String linked



















    ; Resolve the base directory that the `packages/` tree lives under. When the
    ; SCALY_HOME environment variable is set and non-empty, returns "<home>/" so
    ; the prelude and package modules are found relative to an installed location
    ; (the `scalyc` wrapper sets SCALY_HOME); otherwise returns "" so resolution
    ; stays relative to the current directory exactly as before. Keeping the empty
    ; case byte-identical is what makes the seed self-compile reproduce unchanged.
    procedure scaly_home_base() @page true @direct true @ret_caller true @deep true returns String io linked










    ; Try `<base>/<name>/<version>/<name>.scaly`. Returns true and writes the
    ; loaded module to `out` on success; false otherwise. Out parameter avoids
    ; constructing an "empty" Module that the caller would have to filter.
    ; A package with a generated interface (`<dir>/interface/<name>.scaly`,
    ; tools/interfaces.sh) is loaded through it: every declaration a caller
    ; needs, generic bodies included, while the other bodies are in the
    ; package's archive -- what AOT compilation used from the sources anyway.
    procedure interface_or_source(pkg_path: String, pkg_name: String) @page true @direct true @deep true returns String io linked








    procedure handle_package_decl(pkg_syntax: PackageSyntax, mutable packages: ref[Array[Module]]) @page true @direct true @ret_caller true @deep true @deep_into_1_1 true io mutable modeler_error_count reads modeler_error_count linked
































    ; True when any sub-module failed to load. cli.run gates on this after
    ; build_program and fails the compile before the planner emits misleading
    ; downstream diagnostics.
    procedure had_errors() @ret_nonlocal true @deep true returns bool reads modeler_error_count linked


    ; Reset at the start of each program build (harmless in a fresh process; keeps
    ; the counter honest if build_program is ever called more than once).
    procedure reset_errors() @deep true mutable modeler_error_count reads modeler_error_count linked


    ; size_t -> decimal String (self-contained; the Planner has its own copy but
    ; the Modeler must not depend on the Planner).
    function num_to_string(n: size_t) @page true @direct true @ret_caller true @deep true returns String linked























    ; Report a sub-module load failure at its real file:line:col and bump the
    ; error counter. `offset` is a byte offset into `source` (the sub-module's own
    ; contents); the line/col walk mirrors cli.print_parse_error's numeric-LF scan.
    procedure report_module_error(file_path: String, source: String, offset: size_t, message: String) @deep true io mutable modeler_error_count reads modeler_error_count linked



























    ; A required module file (the prelude, or a declared package's root) could not
    ; be loaded. Print the message and fail the compile via had_errors() — the
    ; silent path compiled WITHOUT the standard library and every later use
    ; surfaced as a misleading "function not found: print" / "unknown identifier".
    ; Resolution has exactly one base (SCALY_HOME when set, else the current
    ; directory), so nothing downstream could still find the file.
    procedure report_load_error(message: String) @deep true io mutable modeler_error_count reads modeler_error_count linked





    ; Load and model a sibling module file at <path>/<name>.scaly. On a genuine
    ; PARSE error the real syntax error is reported (file:line:col) and an empty
    ; stub is returned so modeling can continue; cli.run then fails the compile via
    ; had_errors(). A missing/empty file still returns an empty stub silently (an
    ; absent optional module is not itself an error at this layer).
    procedure build_referenced_module(path: String, name: String, is_private: bool) @page true @direct true @ret_caller true @deep true returns Module io mutable modeler_error_count reads modeler_error_count linked






























































    procedure build_module(mutable path: String, file_name: String, name: String, mutable syntax: FileSyntax, is_private: bool) @page true @direct true @ret_caller true @deep true returns Module io mutable modeler_error_count reads modeler_error_count linked




























































    ; ============================================================================
    ; Program building
    ; ============================================================================

    procedure build_program(mutable file_name: String, program_name: String, mutable syntax: ProgramSyntax, enable_prelude: bool) @page true @direct true @ret_caller true @deep true returns Program io mutable modeler_error_count reads modeler_error_count linked

























































































































    ; ============================================================================
    ; Test function
    ; ============================================================================

    procedure test() @ret_nonlocal true @deep true returns int io mutable modeler_error_count reads modeler_error_count linked




























































































































































































































































































































































































































