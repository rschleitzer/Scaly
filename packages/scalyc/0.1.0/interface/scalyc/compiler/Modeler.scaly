    procedure handle_branch(mutable syntax: BranchSyntax) @page true @direct true @deep true returns Branch io mutable modeler_error_count reads modeler_error_count linked



























    procedure handle_case(mutable syntax: CaseSyntax) @page true @direct true @ret_caller true @deep true returns Case io mutable modeler_error_count reads modeler_error_count linked





    procedure handle_choose(mutable syntax: ChooseSyntax) @page true @direct true @deep true returns Choose io mutable modeler_error_count reads modeler_error_count linked









































    procedure handle_when(mutable syntax: WhenSyntax) @page true @direct true @deep true returns When io mutable modeler_error_count reads modeler_error_count linked





































    procedure handle_action(mutable syntax: ActionSyntax) @page true @direct true @ret_caller true @deep true returns Action io mutable modeler_error_count reads modeler_error_count linked










    procedure handle_for(mutable syntax: ForSyntax) @page true @direct true @ret_caller true @deep true returns For io mutable modeler_error_count reads modeler_error_count linked
















    procedure handle_while(mutable syntax: WhileSyntax) @page true @direct true @ret_caller true @deep true returns While io mutable modeler_error_count reads modeler_error_count linked















    procedure handle_condition(mutable syntax: ConditionSyntax) @page true @direct true @ret_caller true @deep true returns Binding io mutable modeler_error_count reads modeler_error_count linked



























