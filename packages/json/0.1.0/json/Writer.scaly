; The writer: appends a document to a growable byte buffer, an Array[u8]
; on the writer's own page. A writer is page-resident, so a local one lives
; on its routine's frame page and dies with it -- a request handler's writer
; leaves nothing behind on a connection that stays open. The separators are
; its business -- the caller says begin_object, key, a value, end_object,
; and the commas and colons follow. Strings are escaped by RFC 8259: the
; quote, the backslash and every control character; the named escapes where
; the RFC has one, \u00XX for the rest. A number given as text goes out
; VERBATIM (number_text of a parsed value, a FHIR decimal).
;
; Commas need no stack: `first` is true exactly between an opening bracket
; and the container's first element, and a closed container is itself the
; element that its parent's next one follows.

use json.Value.JsonValue
use json.Value.JsonMember
use json.Value.JsonArray
use json.Value.JsonObject
use json.Value.JsonNumber
use json.Value.JsonString

define JsonWriter
(
    var buffer: Array[u8]
    var first: bool
    var after_key: bool
)
{
    init()
    {
        set buffer: Array[u8]^this()
        set first: true
        set after_key: false
    }

    ; The document so far.
    function bytes(this) returns Slice[u8]
        buffer.as_slice()

    function to_string(this) returns String
        String(buffer.get_buffer() as pointer[const_char], buffer.length)

    ; Start a new document in the same buffer.
    procedure clear(mutable this)
    {
        buffer.clear()
        set first: true
        set after_key: false
    }

    procedure begin_object(mutable this)
    {
        this.separate()
        this.byte(0x7B)                                     ; '{'
        set first: true
    }

    procedure end_object(mutable this)
    {
        this.byte(0x7D)                                     ; '}'
        set first: false
    }

    procedure begin_array(mutable this)
    {
        this.separate()
        this.byte(0x5B)                                     ; '['
        set first: true
    }

    procedure end_array(mutable this)
    {
        this.byte(0x5D)                                     ; ']'
        set first: false
    }

    ; A member name; the member's value is the next thing written.
    procedure key(mutable this, name: Slice[u8])
    {
        this.separate()
        this.quoted(name)
        this.byte(0x3A)                                     ; ':'
        set after_key: true
    }

    procedure text(mutable this, s: Slice[u8])
    {
        this.separate()
        this.quoted(s)
    }

    procedure integer(mutable this, n: i64)
    {
        this.separate()
        var digits u8[20]
        var v: u64 n as u64
        if n < 0
        {
            this.byte(0x2D)                                 ; '-'
            set v: (0 as u64) - v
        }
        var at: size_t 20
        repeat
        {
            set at: at - 1
            set digits[at]: ((v % 10) as u8) + 0x30
            set v: v / 10
            if v = 0
                break
        }
        while at < 20
        {
            buffer.add(digits[at])
            set at: at + 1
        }
    }

    ; A number given as its text, written as it stands (the caller vouches
    ; for its grammar).
    procedure number(mutable this, text: Slice[u8])
    {
        this.separate()
        this.append(text)
    }

    procedure boolean(mutable this, b: bool)
    {
        this.separate()
        if b
            this.append("true")
        else
            this.append("false")
    }

    procedure null_value(mutable this)
    {
        this.separate()
        this.append("null")
    }

    ; A whole tree.
    procedure value(mutable this, v: JsonValue)
    {
        choose v
            when n: Null
                this.null_value()
            when b: Bool
                this.boolean(b)
            when num: Number
                this.number(num.text)
            when t: Text
                this.text(t.bytes)
            when a: Array
            {
                this.begin_array()
                var i: size_t 0
                while i < a.items.length
                {
                    this.value(a.items[i])
                    set i: i + 1
                }
                this.end_array()
            }
            when o: Object
            {
                this.begin_object()
                var i: size_t 0
                while i < o.members.length
                {
                    let m o.members[i]
                    this.key(m.key)
                    this.value(m.value)
                    set i: i + 1
                }
                this.end_object()
            }
    }

    ; Bytes that already are JSON, as a value (the caller vouches for them).
    procedure raw(mutable this, json: Slice[u8])
    {
        this.separate()
        this.append(json)
    }

    ; ------------------------------------------------------------------

    ; The comma before an element that is not its container's first.
    procedure separate(mutable this)
    {
        if after_key
        {
            set after_key: false
            return
        }
        if first
            set first: false
        else
            this.byte(0x2C)                                 ; ','
    }

    ; The string and its quotes written in place in one pass: the buffer is
    ; extended by the whole literal first, and sixteen bytes a step are
    ; stored and checked together. At the first byte that needs an escape
    ; the buffer is cut back to it, and the rest goes byte by byte.
    procedure quoted(mutable this, s: Slice[u8])
    {
        let n s.length
        let start buffer.length
        let out buffer.extend(n + 2)
        out.put(0, 0x22)
        let quote u8x16.splat(0x22)
        let back u8x16.splat(0x5C)
        let space u8x16.splat(0x20)
        var i: size_t 0
        while i + 16 <= n
        {
            let v u8x16.load(s, i)
            v.store(out, i + 1)
            let special ((v = quote) or (v = back) or (v < space)).bits()
            if special <> 0
            {
                set i: i + (trailing_zeros(special) as size_t)
                break
            }
            set i: i + 16
        }
        while i < n and JsonWriter.plain(s[i])
        {
            out.put(i + 1, s[i])
            set i: i + 1
        }
        if i = n
        {
            out.put(n + 1, 0x22)
            return
        }
        ; an escape at i: what stands before it stays
        set buffer.length: start + 1 + i
        this.quoted_rest(s, i)
    }

    ; The rest of a string from its first byte that needs an escape, and the
    ; closing quote: runs of plain bytes in one copy.
    procedure quoted_rest(mutable this, s: Slice[u8], from: size_t)
    {
        let n s.length
        var i from
        while i < n
        {
            var j i
            while j < n and JsonWriter.plain(s[j])
                set j: j + 1
            if j > i
                this.append(s.subslice(i, j))
            if j >= n
                break
            this.escape(s[j])
            set i: j + 1
        }
        this.byte(0x22)
    }

    function plain(c: u8) returns bool
        c >= 0x20 and c <> 0x22 and c <> 0x5C

    procedure escape(mutable this, c: u8)
    {
        this.byte(0x5C)
        let letter JsonWriter.escape_letter(c)
        if letter <> 0
            this.byte(letter)
        else
        {
            this.append("u00")
            this.byte(JsonWriter.hex_digit(c >> 4))
            this.byte(JsonWriter.hex_digit(c & 0x0F))
        }
    }

    ; The letter of c's named escape, 0 where only \u00XX will do.
    function escape_letter(c: u8) returns u8
    {
        match c
            case 0x22: return 0x22
            case 0x5C: return 0x5C
            case 0x08: return 0x62                          ; \b
            case 0x0C: return 0x66                          ; \f
            case 0x0A: return 0x6E                          ; \n
            case 0x0D: return 0x72                          ; \r
            case 0x09: return 0x74                          ; \t
            else: return 0
    }

    ; s as a JSON string literal, for a document assembled by hand in a
    ; StringBuilder (the language server's replies): the escapes of text().
    function quote(s: Slice[u8]) returns String
    {
        var sb StringBuilder()
        JsonWriter.append_quoted(sb, s)
        sb.to_string()
    }

    function quote(s: String) returns String
        JsonWriter.quote(s.as_slice())

    procedure append_quoted(mutable sb: ref[StringBuilder], s: Slice[u8])
    {
        sb.append(0x22 as char)
        var i: size_t 0
        while i < s.length
        {
            let c s[i]
            if JsonWriter.plain(c)
                sb.append(c as char)
            else
            {
                sb.append(0x5C as char)
                let letter JsonWriter.escape_letter(c)
                if letter <> 0
                    sb.append(letter as char)
                else
                {
                    sb.append("u00")
                    sb.append(JsonWriter.hex_digit(c >> 4) as char)
                    sb.append(JsonWriter.hex_digit(c & 0x0F) as char)
                }
            }
            set i: i + 1
        }
        sb.append(0x22 as char)
    }

    ; v as JSON text in a String -- what value() writes into the buffer.
    function stringify(v: JsonValue) returns String
    {
        var sb StringBuilder()
        JsonWriter.append_value(sb, v)
        sb.to_string()
    }

    procedure append_value(mutable sb: ref[StringBuilder], v: JsonValue)
    {
        choose v
            when n: Null
                sb.append("null")
            when b: Bool
            {
                if b
                    sb.append("true")
                else
                    sb.append("false")
            }
            when num: Number
                sb.append(num.text.data as pointer[char], num.text.length)
            when t: Text
                JsonWriter.append_quoted(sb, t.bytes)
            when a: Array
            {
                sb.append(0x5B as char)
                var i: size_t 0
                while i < a.items.length
                {
                    if i > 0
                        sb.append(0x2C as char)
                    JsonWriter.append_value(sb, a.items[i])
                    set i: i + 1
                }
                sb.append(0x5D as char)
            }
            when o: Object
            {
                sb.append(0x7B as char)
                var i: size_t 0
                while i < o.members.length
                {
                    if i > 0
                        sb.append(0x2C as char)
                    let m o.members[i]
                    JsonWriter.append_quoted(sb, m.key)
                    sb.append(0x3A as char)
                    JsonWriter.append_value(sb, m.value)
                    set i: i + 1
                }
                sb.append(0x7D as char)
            }
    }

    function hex_digit(v: u8) returns u8
    {
        if v < 10
            return v + 0x30
        v + 0x57                                            ; 'a' - 10
    }

    procedure byte(mutable this, b: u8)
        buffer.add(b)

    procedure append(mutable this, s: Slice[u8])
    {
        if s.length = 0
            return
        buffer.add(s)
    }
}
