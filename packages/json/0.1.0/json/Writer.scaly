; The writer: appends a document to a growable byte buffer, an Array[u8]
; on the writer's own page. A writer is page-resident, so a local one lives
; on its routine's frame page and dies with it -- a request handler's writer
; leaves nothing behind on a connection that stays open. The separators are
; its business -- the caller says begin_object, key, a value, end_object,
; and the commas and colons follow. Strings are escaped by RFC 8259: the
; quote, the backslash and every control character; the named escapes where
; the RFC has one, \u00XX for the rest. A number given as text goes out
; VERBATIM (number_text of a parsed value, a FHIR decimal).
;
; Commas need no stack: `first` is true exactly between an opening bracket
; and the container's first element, and a closed container is itself the
; element that its parent's next one follows.

use json.Value.JsonValue
use json.Value.JsonMember
use json.Value.JsonArray
use json.Value.JsonObject
use json.Value.JsonNumber
use json.Value.JsonString

; A container the tree writer has open: its items (an array) or members (an
; object, the other one empty), and the element it wrote last.
; How much a tree write reserves at a time.
define JSON_BLOCK: size_t 4096

define JsonWriteFrame (items: Slice[JsonValue], members: Slice[JsonMember], at: size_t)

define JsonWriter
(
    var buffer: Array[u8]
    var first: bool
    var after_key: bool
)
{
    init()
    {
        set buffer: Array[u8]^this()
        set first: true
        set after_key: false
    }

    ; The document so far.
    function bytes(this) returns Slice[u8]
        buffer.as_slice()

    function to_string(this) returns String
        String(buffer.get_buffer() as pointer[const_char], buffer.length)

    ; Start a new document in the same buffer.
    procedure clear(mutable this)
    {
        buffer.clear()
        set first: true
        set after_key: false
    }

    procedure begin_object(mutable this)
    {
        this.separate()
        this.byte(0x7B)                                     ; '{'
        set first: true
    }

    procedure end_object(mutable this)
    {
        this.byte(0x7D)                                     ; '}'
        set first: false
    }

    procedure begin_array(mutable this)
    {
        this.separate()
        this.byte(0x5B)                                     ; '['
        set first: true
    }

    procedure end_array(mutable this)
    {
        this.byte(0x5D)                                     ; ']'
        set first: false
    }

    ; A member name; the member's value is the next thing written.
    procedure key(mutable this, name: Slice[u8])
    {
        this.separate()
        this.quoted(name)
        this.byte(0x3A)                                     ; ':'
        set after_key: true
    }

    procedure text(mutable this, s: Slice[u8])
    {
        this.separate()
        this.quoted(s)
    }

    procedure integer(mutable this, n: i64)
    {
        this.separate()
        var digits u8[20]
        var v: u64 n as u64
        if n < 0
        {
            this.byte(0x2D)                                 ; '-'
            set v: (0 as u64) - v
        }
        var at: size_t 20
        repeat
        {
            set at: at - 1
            set digits[at]: ((v % 10) as u8) + 0x30
            set v: v / 10
            if v = 0
                break
        }
        while at < 20
        {
            buffer.add(digits[at])
            set at: at + 1
        }
    }

    ; A number given as its text, written as it stands (the caller vouches
    ; for its grammar).
    procedure number(mutable this, text: Slice[u8])
    {
        this.separate()
        this.append(text)
    }

    procedure boolean(mutable this, b: bool)
    {
        this.separate()
        if b
            this.append("true")
        else
            this.append("false")
    }

    procedure null_value(mutable this)
    {
        this.separate()
        this.append("null")
    }

    ; A whole tree, as one element of whatever is open. One loop over the
    ; tree with the open containers on a stack (the tree writes its own
    ; commas): a call per value and the separator state per value were half
    ; of a write (the 2026-09-29 profile). The loop writes through a local
    ; cursor into a block it reserved (Array.extend) -- one register compare
    ; per byte, the length and capacity in memory touched once per block;
    ; verbatim strings and numbers are copied inline, sixteen bytes a step.
    procedure value(mutable this, v: JsonValue)
    {
        this.separate()
        var open Array[JsonWriteFrame]()
        ; the empty half of a frame (a plain `let`: a Slice constructed as an
        ; argument would force a frame per container)
        let no_items Slice[JsonValue](0, null)
        let no_members Slice[JsonMember](0, null)
        ; the block: buffer[base, base + block.length), written up to p
        var base buffer.length
        var block buffer.extend(JSON_BLOCK)
        var p: size_t 0
        var cur v
        ; cur is a member's value whose name is still to be written
        var named false
        let no_key Slice[u8](0, null)
        var name JsonMember(no_key, JsonValue.Null, false)
        repeat
        {
            if named
            {
                let n name.key.length
                if p + n + 19 > block.length
                {
                    set buffer.length: base + p
                    set base: buffer.length
                    set block: buffer.extend(n + 19 + JSON_BLOCK)
                    set p: 0
                }
                if name.verbatim_key
                {
                    block.put(p, 0x22)
                    let padded Slice[u8](n + 16, name.key.data)
                    var i: size_t 0
                    while i < n
                    {
                        u8x16.load(padded, i).store(block, p + 1 + i)
                        set i: i + 16
                    }
                    block.put(p + 1 + n, 0x22)
                    block.put(p + 2 + n, 0x3A)              ; ':'
                    set p: p + n + 3
                }
                else
                {
                    set buffer.length: base + p
                    this.quoted(name.key)
                    this.byte(0x3A)
                    set base: buffer.length
                    set block: buffer.extend(JSON_BLOCK)
                    set p: 0
                }
                set named: false
            }
            ; room for the longest fixed piece: a closer, a comma and a
            ; literal, or a name's colon
            if p + 16 > block.length
            {
                set buffer.length: base + p
                set base: buffer.length
                set block: buffer.extend(JSON_BLOCK)
                set p: 0
            }
            ; write cur; a container that is not empty opens and cur becomes
            ; its first element
            var opened false
            choose cur
                when n: Null
                {
                    block.put(p, 0x6E)
                    block.put(p + 1, 0x75)
                    block.put(p + 2, 0x6C)
                    block.put(p + 3, 0x6C)
                    set p: p + 4
                }
                when b: Bool
                {
                    if b
                    {
                        block.put(p, 0x74)
                        block.put(p + 1, 0x72)
                        block.put(p + 2, 0x75)
                        block.put(p + 3, 0x65)
                        set p: p + 4
                    }
                    else
                    {
                        block.put(p, 0x66)
                        block.put(p + 1, 0x61)
                        block.put(p + 2, 0x6C)
                        block.put(p + 3, 0x73)
                        block.put(p + 4, 0x65)
                        set p: p + 5
                    }
                }
                when num: Number
                {
                    let n num.text.length
                    if p + n + 18 > block.length
                    {
                        set buffer.length: base + p
                        set base: buffer.length
                        set block: buffer.extend(n + 18 + JSON_BLOCK)
                        set p: 0
                    }
                    if num.verbatim
                    {
                        let padded Slice[u8](n + 16, num.text.data)
                        var i: size_t 0
                        while i < n
                        {
                            u8x16.load(padded, i).store(block, p + i)
                            set i: i + 16
                        }
                    }
                    else
                    {
                        var i: size_t 0
                        while i < n
                        {
                            block.put(p + i, num.text[i])
                            set i: i + 1
                        }
                    }
                    set p: p + n
                }
                when t: Text
                {
                    let n t.bytes.length
                    if t.verbatim
                    {
                        if p + n + 18 > block.length
                        {
                            set buffer.length: base + p
                            set base: buffer.length
                            set block: buffer.extend(n + 18 + JSON_BLOCK)
                            set p: 0
                        }
                        block.put(p, 0x22)
                        let padded Slice[u8](n + 16, t.bytes.data)
                        var i: size_t 0
                        while i < n
                        {
                            u8x16.load(padded, i).store(block, p + 1 + i)
                            set i: i + 16
                        }
                        block.put(p + 1 + n, 0x22)
                        set p: p + n + 2
                    }
                    else
                    {
                        ; the escaping writer goes through the buffer itself
                        set buffer.length: base + p
                        this.quoted(t.bytes)
                        set base: buffer.length
                        set block: buffer.extend(JSON_BLOCK)
                        set p: 0
                    }
                }
                when a: Array
                {
                    if a.items.length = 0
                    {
                        block.put(p, 0x5B)
                        block.put(p + 1, 0x5D)
                        set p: p + 2
                    }
                    else
                    {
                        block.put(p, 0x5B)                  ; '['
                        set p: p + 1
                        open.add(JsonWriteFrame(a.items, no_members, 0))
                        set cur: a.items[0]
                        set opened: true
                    }
                }
                when o: Object
                {
                    if o.members.length = 0
                    {
                        block.put(p, 0x7B)
                        block.put(p + 1, 0x7D)
                        set p: p + 2
                    }
                    else
                    {
                        block.put(p, 0x7B)                  ; '{'
                        set p: p + 1
                        open.add(JsonWriteFrame(no_items, o.members, 0))
                        set name: o.members[0]
                        set named: true
                        set cur: o.members[0].value
                        set opened: true
                    }
                }
            if opened
                continue
            ; cur is written: the next element of the innermost open
            ; container, or its closer (and so on outwards)
            var next false
            while next = false and open.length > 0
            {
                if p + 2 > block.length
                {
                    set buffer.length: base + p
                    set base: buffer.length
                    set block: buffer.extend(JSON_BLOCK)
                    set p: 0
                }
                let top open.length - 1
                let f open[top]
                let at f.at + 1
                if f.members.length > 0
                {
                    if at < f.members.length
                    {
                        block.put(p, 0x2C)                  ; ','
                        set p: p + 1
                        set name: f.members[at]
                        set named: true
                        set cur: f.members[at].value
                        open.put(top, JsonWriteFrame(f.items, f.members, at))
                        set next: true
                    }
                    else
                    {
                        block.put(p, 0x7D)                  ; '}'
                        set p: p + 1
                        set open.length: top
                    }
                }
                else
                {
                    if at < f.items.length
                    {
                        block.put(p, 0x2C)                  ; ','
                        set p: p + 1
                        set cur: f.items[at]
                        open.put(top, JsonWriteFrame(f.items, f.members, at))
                        set next: true
                    }
                    else
                    {
                        block.put(p, 0x5D)                  ; ']'
                        set p: p + 1
                        set open.length: top
                    }
                }
            }
            if next = false
                break
        }
        set buffer.length: base + p
        set first: false
    }

    ; Bytes that already are JSON, as a value (the caller vouches for them).
    procedure raw(mutable this, json: Slice[u8])
    {
        this.separate()
        this.append(json)
    }

    ; ------------------------------------------------------------------

    ; The comma before an element that is not its container's first.
    procedure separate(mutable this)
    {
        if after_key
        {
            set after_key: false
            return
        }
        if first
            set first: false
        else
            this.byte(0x2C)                                 ; ','
    }

    ; The string and its quotes written in place in one pass: the buffer is
    ; extended by the whole literal first, and sixteen bytes a step are
    ; stored and checked together. At the first byte that needs an escape
    ; the buffer is cut back to it, and the rest goes byte by byte.
    procedure quoted(mutable this, s: Slice[u8])
    {
        let n s.length
        let start buffer.length
        let out buffer.extend(n + 2)
        out.put(0, 0x22)
        let quote u8x16.splat(0x22)
        let back u8x16.splat(0x5C)
        let space u8x16.splat(0x20)
        var i: size_t 0
        while i + 16 <= n
        {
            let v u8x16.load(s, i)
            v.store(out, i + 1)
            let special ((v = quote) or (v = back) or (v < space)).bits()
            if special <> 0
            {
                set i: i + (trailing_zeros(special) as size_t)
                break
            }
            set i: i + 16
        }
        ; the rest (a short string is all rest: keys, names): its plain
        ; bytes counted, then copied in one go -- a put each, bounds
        ; checked, made quoted a sixth of the server's samples under
        ; async-db, thirteen strings a row (2026-09-30)
        let bytes: Slice[u8] s
        var j i
        ; eight bytes a step while eight remain (SWAR on a little-endian
        ; word): a byte below 0x20, a quote or a backslash sets the high bit
        ; of some lane of `hits` -- exact about whether one is there, and
        ; the byte loop below finds which. A byte at a time, nine
        ; instructions each, was most of quoted's samples: keys and names
        ; are short (2026-09-30).
        while j + 8 <= n
        {
            let p bytes.data + j
            let w (*p as u64) | ((*(p + 1) as u64) << 8) | ((*(p + 2) as u64) << 16) | ((*(p + 3) as u64) << 24) | ((*(p + 4) as u64) << 32) | ((*(p + 5) as u64) << 40) | ((*(p + 6) as u64) << 48) | ((*(p + 7) as u64) << 56)
            let quote w xor 0x2222222222222222
            let back w xor 0x5C5C5C5C5C5C5C5C
            let below (w - 0x2020202020202020) & (w xor 0xFFFFFFFFFFFFFFFF)
            let q (quote - 0x0101010101010101) & (quote xor 0xFFFFFFFFFFFFFFFF)
            let b (back - 0x0101010101010101) & (back xor 0xFFFFFFFFFFFFFFFF)
            if ((below | q | b) & 0x8080808080808080) <> 0
                break
            set j: j + 8
        }
        while j < n and JsonWriter.plain(bytes[j])
            set j: j + 1
        if j > i
            memcpy(out.slice_from(i + 1).data as pointer[void], bytes.slice_from(i).data as pointer[void], j - i)
        set i: j
        if i = n
        {
            out.put(n + 1, 0x22)
            return
        }
        ; an escape at i: what stands before it stays
        set buffer.length: start + 1 + i
        this.quoted_rest(s, i)
    }

    ; The rest of a string from its first byte that needs an escape, and the
    ; closing quote: runs of plain bytes in one copy.
    procedure quoted_rest(mutable this, s: Slice[u8], from: size_t)
    {
        let n s.length
        var i from
        while i < n
        {
            var j i
            while j < n and JsonWriter.plain(s[j])
                set j: j + 1
            if j > i
                this.append(s.subslice(i, j))
            if j >= n
                break
            this.escape(s[j])
            set i: j + 1
        }
        this.byte(0x22)
    }

    function plain(c: u8) returns bool
        c >= 0x20 and c <> 0x22 and c <> 0x5C

    procedure escape(mutable this, c: u8)
    {
        this.byte(0x5C)
        let letter JsonWriter.escape_letter(c)
        if letter <> 0
            this.byte(letter)
        else
        {
            this.append("u00")
            this.byte(JsonWriter.hex_digit(c >> 4))
            this.byte(JsonWriter.hex_digit(c & 0x0F))
        }
    }

    ; The letter of c's named escape, 0 where only \u00XX will do.
    function escape_letter(c: u8) returns u8
    {
        match c
            case 0x22: return 0x22
            case 0x5C: return 0x5C
            case 0x08: return 0x62                          ; \b
            case 0x0C: return 0x66                          ; \f
            case 0x0A: return 0x6E                          ; \n
            case 0x0D: return 0x72                          ; \r
            case 0x09: return 0x74                          ; \t
            else: return 0
    }

    ; s as a JSON string literal, for a document assembled by hand in a
    ; StringBuilder (the language server's replies): the escapes of text().
    function quote(s: Slice[u8]) returns String
    {
        var sb StringBuilder()
        JsonWriter.append_quoted(sb, s)
        sb.to_string()
    }

    function quote(s: String) returns String
        JsonWriter.quote(s.as_slice())

    procedure append_quoted(mutable sb: ref[StringBuilder], s: Slice[u8])
    {
        sb.append(0x22 as char)
        var i: size_t 0
        while i < s.length
        {
            let c s[i]
            if JsonWriter.plain(c)
                sb.append(c as char)
            else
            {
                sb.append(0x5C as char)
                let letter JsonWriter.escape_letter(c)
                if letter <> 0
                    sb.append(letter as char)
                else
                {
                    sb.append("u00")
                    sb.append(JsonWriter.hex_digit(c >> 4) as char)
                    sb.append(JsonWriter.hex_digit(c & 0x0F) as char)
                }
            }
            set i: i + 1
        }
        sb.append(0x22 as char)
    }

    ; v as JSON text in a String -- what value() writes into the buffer.
    function stringify(v: JsonValue) returns String
    {
        var sb StringBuilder()
        JsonWriter.append_value(sb, v)
        sb.to_string()
    }

    procedure append_value(mutable sb: ref[StringBuilder], v: JsonValue)
    {
        choose v
            when n: Null
                sb.append("null")
            when b: Bool
            {
                if b
                    sb.append("true")
                else
                    sb.append("false")
            }
            when num: Number
                sb.append(num.text.data as pointer[char], num.text.length)
            when t: Text
                JsonWriter.append_quoted(sb, t.bytes)
            when a: Array
            {
                sb.append(0x5B as char)
                var i: size_t 0
                while i < a.items.length
                {
                    if i > 0
                        sb.append(0x2C as char)
                    JsonWriter.append_value(sb, a.items[i])
                    set i: i + 1
                }
                sb.append(0x5D as char)
            }
            when o: Object
            {
                sb.append(0x7B as char)
                var i: size_t 0
                while i < o.members.length
                {
                    if i > 0
                        sb.append(0x2C as char)
                    let m o.members[i]
                    JsonWriter.append_quoted(sb, m.key)
                    sb.append(0x3A as char)
                    JsonWriter.append_value(sb, m.value)
                    set i: i + 1
                }
                sb.append(0x7D as char)
            }
    }

    function hex_digit(v: u8) returns u8
    {
        if v < 10
            return v + 0x30
        v + 0x57                                            ; 'a' - 10
    }

    procedure byte(mutable this, b: u8)
        buffer.add(b)

    procedure append(mutable this, s: Slice[u8])
    {
        if s.length = 0
            return
        buffer.add(s)
    }
}
