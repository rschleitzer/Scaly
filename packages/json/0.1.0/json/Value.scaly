; The value tree, built from the reader's tokens. parse() copies the document
; ONCE onto its caller's page, and every string, member name and number of
; the tree is a view into that copy -- escapes decoded in place -- so the tree
; owns what it shows and allocates nothing per string. A number keeps its
; source text: as_i64 answers only where the text is an integer in range,
; as_f64 goes through strtod, number_text is the text itself (a FHIR decimal
; keeps its trailing zeros). An array's items and an object's members are
; exact-size buffers on the same page; the members keep document order, and
; get() takes the first of a duplicated name.
;
; Every accessor answers the empty value of its kind for a value of another
; kind (false, 0, the empty String, Null), so a chain like
; msg.get("params").get("textDocument").get("uri").as_string() needs no test
; between the steps.

use json.Reader.JsonReader
use json.Reader.JsonToken

; strtod(3) — fixed prototype, errno not consulted.
function strtod(s: pointer[const_char], endp: pointer[pointer[u8]]) returns f64 extern
; memcpy(3): the document's copy
procedure memcpy(mutable dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

define JsonMember (key: Slice[u8], value: JsonValue)

; The views as records: a union's payload is a type NAME, not a generic
; instance (the grammar has no `Slice[...]` in that position).
define JsonArray (items: Slice[JsonValue])
define JsonObject (members: Slice[JsonMember])
; a number's text and a string's decoded bytes, views into the document copy
define JsonNumber (text: Slice[u8])
define JsonString (bytes: Slice[u8])

define JsonValue union
(
    Null
    Bool: bool
    Number: JsonNumber
    Text: JsonString
    Array: JsonArray
    Object: JsonObject
)
{
    function is_null(this) returns bool
    {
        choose this
            when n: Null
                return true
            else
                return false
    }

    function is_bool(this) returns bool
    {
        choose this
            when b: Bool
                return true
            else
                return false
    }

    function is_number(this) returns bool
    {
        choose this
            when n: Number
                return true
            else
                return false
    }

    function is_text(this) returns bool
    {
        choose this
            when t: Text
                return true
            else
                return false
    }

    function is_array(this) returns bool
    {
        choose this
            when a: Array
                return true
            else
                return false
    }

    function is_object(this) returns bool
    {
        choose this
            when o: Object
                return true
            else
                return false
    }

    function as_bool(this) returns bool
    {
        choose this
            when b: Bool
                return b
            else
                return false
    }

    ; A string's text as a String of its own (a copy); text() is the view.
    function as_string(this) returns String
    {
        choose this
            when t: Text
                return String(t.bytes.data as pointer[const_char], t.bytes.length)
            else
                return String()
    }

    ; A string's decoded text as a view into the tree, empty for anything else.
    function text(this) returns Slice[u8]
    {
        choose this
            when t: Text
                return t.bytes
            else
                return Slice[u8]()
    }

    ; A number's source text as a view into the tree, empty for anything else.
    function number_text(this) returns Slice[u8]
    {
        choose this
            when n: Number
                return n.text
            else
                return Slice[u8]()
    }

    ; A number without fraction or exponent whose value fits an i64.
    function is_integer(this) returns bool
    {
        choose this
            when n: Number
                return JsonValue.integer_fits(n.text)
            else
                return false
    }

    ; The value of an integer number (is_integer), 0 for anything else.
    function as_i64(this) returns i64
    {
        choose this
            when n: Number
            {
                if JsonValue.integer_fits(n.text)
                    return JsonValue.integer_value(n.text)
                return 0
            }
            else
                return 0
    }

    ; The nearest double to a number, 0 for anything else. strtod wants a
    ; terminated text, and the view is not: a local copy.
    function as_f64(this) returns f64
    {
        choose this
            when n: Number
            {
                let text n.text
                var buf Vector[u8](text.length + 1)
                var i: size_t 0
                while i < text.length
                {
                    buf.put(i, text[i])
                    set i: i + 1
                }
                buf.put(text.length, 0)
                return strtod(buf.data as pointer[const_char], null as pointer[pointer[u8]])
            }
            else
                return 0.0
    }

    ; An array's item or an object's member count, 0 for anything else.
    function length(this) returns size_t
    {
        choose this
            when a: Array
                return a.items.length
            when o: Object
                return o.members.length
            else
                return 0
    }

    ; An array's i-th item, Null past its end or for anything else.
    function item(this, i: size_t) returns JsonValue
    {
        choose this
            when a: Array
            {
                if i < a.items.length
                    return a.items[i]
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    ; An object's member of that name, Null if it has none.
    function get(this, key: Slice[u8]) returns JsonValue
    {
        choose this
            when o: Object
            {
                var i: size_t 0
                while i < o.members.length
                {
                    let m o.members[i]
                    if m.key.equals(key)
                        return m.value
                    set i: i + 1
                }
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    function has(this, key: Slice[u8]) returns bool
    {
        choose this
            when o: Object
            {
                var i: size_t 0
                while i < o.members.length
                {
                    if o.members[i].key.equals(key)
                        return true
                    set i: i + 1
                }
                return false
            }
            else
                return false
    }

    ; An object's i-th member name (a view) / value, in document order.
    function key_at(this, i: size_t) returns Slice[u8]
    {
        choose this
            when o: Object
            {
                if i < o.members.length
                    return o.members[i].key
                return Slice[u8]()
            }
            else
                return Slice[u8]()
    }

    function value_at(this, i: size_t) returns JsonValue
    {
        choose this
            when o: Object
            {
                if i < o.members.length
                    return o.members[i].value
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    ; ------------------------------------------------------------------
    ; parsing

    ; Parse a whole document. On a refused one the result carries the
    ; reader's code and offset and a Null value. The tree is independent of
    ; source: it lives on the caller's page with its own copy of the text.
    procedure parse(source: Slice[u8]) returns JsonParsed
    {
        var copy Vector[u8]#(source.length)
        var doc copy.as_slice()
        if source.length > 0
            memcpy(doc.data as pointer[void], source.data as pointer[void], source.length)
        ; one stack each for the items and members of the containers still
        ; open; a closing container moves its run into an exact-size buffer
        var values Array[JsonValue]()
        var members Array[JsonMember]()
        var r JsonReader.create(doc)
        let first r.next()
        let v JsonValue.build(r, doc, values, members, first)
        if r.failed() = false
            r.next()
        if r.failed()
            return JsonParsed(JsonValue.Null, r.error, r.error_at)
        JsonParsed(v, JSON_OK, 0)
    }

    ; The value that begins with token; the rest of it is read from r.
    procedure build(mutable r: ref[JsonReader], mutable doc: Slice[u8], mutable values: ref[Array[JsonValue]], mutable members: ref[Array[JsonMember]], token: JsonToken) returns JsonValue
    {
        choose token
            when bo: ObjectStart
                return JsonValue.build_object(r, doc, values, members)
            when ba: ArrayStart
                return JsonValue.build_array(r, doc, values, members)
            when t: StringValue
                return JsonValue.Text(JsonString(JsonValue.string_view(r, doc)))
            when n: NumberValue
                return JsonValue.Number(JsonNumber(r.text()))
            when yes: TrueValue
                return JsonValue.Bool(true)
            when no: FalseValue
                return JsonValue.Bool(false)
            else
                return JsonValue.Null
    }

    ; The last Key or Text token as a view into doc: as it stands, or with
    ; its escapes decoded in place.
    procedure string_view(r: ref[JsonReader], mutable doc: Slice[u8]) returns Slice[u8]
    {
        if r.escaped = false
            return doc.subslice(r.start, r.end)
        let n JsonReader.decode_in_place(doc, r.start, r.end)
        doc.subslice(r.start, r.start + n)
    }

    procedure build_object(mutable r: ref[JsonReader], mutable doc: Slice[u8], mutable values: ref[Array[JsonValue]], mutable members: ref[Array[JsonMember]]) returns JsonValue
    {
        let base members.length
        repeat
        {
            let t r.next()
            choose t
                when k: MemberName
                {
                    let key JsonValue.string_view(r, doc)
                    let first r.next()
                    let value JsonValue.build(r, doc, values, members, first)
                    members.add(JsonMember(key, value))
                }
                else
                    break
        }
        let count members.length - base
        if count = 0
            return JsonValue.Object(JsonObject(null))
        ; built on the caller's page, which the returned value carries on
        var store Vector[JsonMember]#(count)
        var i: size_t 0
        while i < count
        {
            store.put(i, members[base + i])
            set i: i + 1
        }
        set members.length: base
        JsonValue.Object(JsonObject(store.as_slice()))
    }

    procedure build_array(mutable r: ref[JsonReader], mutable doc: Slice[u8], mutable values: ref[Array[JsonValue]], mutable members: ref[Array[JsonMember]]) returns JsonValue
    {
        let base values.length
        repeat
        {
            let t r.next()
            choose t
                when e: ArrayEnd
                    break
                when i: Invalid
                    break
                when d: End
                    break
                else
                {
                    let item JsonValue.build(r, doc, values, members, t)
                    values.add(item)
                }
        }
        let count values.length - base
        if count = 0
            return JsonValue.Array(JsonArray(null))
        var store Vector[JsonValue]#(count)
        var i: size_t 0
        while i < count
        {
            store.put(i, values[base + i])
            set i: i + 1
        }
        set values.length: base
        JsonValue.Array(JsonArray(store.as_slice()))
    }

    ; ------------------------------------------------------------------
    ; integers

    ; text is an integer (no fraction, no exponent) within i64.
    function integer_fits(text: Slice[u8]) returns bool
    {
        if text.length = 0
            return false
        var i: size_t 0
        var limit: u64 0x7FFFFFFFFFFFFFFF
        if text[0] = 0x2D
        {
            set i: 1
            set limit: 0x8000000000000000
        }
        if i >= text.length
            return false
        var v: u64 0
        while i < text.length
        {
            let c text[i]
            if c < 0x30 or c > 0x39
                return false
            let d (c - 0x30) as u64
            if v > (limit - d) / 10
                return false
            set v: (v * 10) + d
            set i: i + 1
        }
        true
    }

    ; The value of text, which integer_fits.
    function integer_value(text: Slice[u8]) returns i64
    {
        var i: size_t 0
        var negative false
        if text[0] = 0x2D
        {
            set i: 1
            set negative: true
        }
        var v: u64 0
        while i < text.length
        {
            set v: (v * 10) + ((text[i] - 0x30) as u64)
            set i: i + 1
        }
        if negative
            return ((0 as u64) - v) as i64
        v as i64
    }
}

; What JsonValue.parse answers: the value, or why and where the document
; was refused.
define JsonParsed
(
    value: JsonValue
    error: int
    offset: size_t
)
{
    function ok(this) returns bool
        error = JSON_OK

    function message(this) returns Slice[char]
        JsonReader.message(error)
}
