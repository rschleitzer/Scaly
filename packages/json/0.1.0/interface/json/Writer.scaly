; The writer: appends a document to a growable byte buffer, an Array[u8]
; on the writer's own page. A writer is page-resident, so a local one lives
; on its routine's frame page and dies with it -- a request handler's writer
; leaves nothing behind on a connection that stays open. The separators are
; its business -- the caller says begin_object, key, a value, end_object,
; and the commas and colons follow. Strings are escaped by RFC 8259: the
; quote, the backslash and every control character; the named escapes where
; the RFC has one, \u00XX for the rest. A number given as text goes out
; VERBATIM (number_text of a parsed value, a FHIR decimal).
;
; Commas need no stack: `first` is true exactly between an opening bracket
; and the container's first element, and a closed container is itself the
; element that its parent's next one follows.

use json.Value.JsonValue
use json.Value.JsonMember
use json.Value.JsonArray
use json.Value.JsonObject
use json.Value.JsonNumber
use json.Value.JsonString

define JsonWriter
@resident true @inplace true (
    var buffer: Array[u8]
    var first: bool
    var after_key: bool
)
{
    init() linked

    ; The document so far.
    function bytes(this) @ret_param_0 true @deep true returns Slice[u8] linked

    function to_string(this) @page true @direct true @ret_caller true @deep true returns String linked

    ; Start a new document in the same buffer.
    procedure clear(mutable this) @deep true linked

    procedure begin_object(mutable this) @deep true linked

    procedure end_object(mutable this) @deep true linked

    procedure begin_array(mutable this) @deep true linked

    procedure end_array(mutable this) @deep true linked

    ; A member name; the member's value is the next thing written.
    procedure key(mutable this, name: Slice[u8]) @deep true linked

    procedure text(mutable this, s: Slice[u8]) @ret_nonlocal true @deep true linked

    procedure integer(mutable this, n: i64) @deep true linked

    ; A number given as its text, written as it stands (the caller vouches
    ; for its grammar).
    procedure number(mutable this, text: Slice[u8]) @ret_nonlocal true @deep true linked

    procedure boolean(mutable this, b: bool) @ret_nonlocal true @deep true linked

    procedure null_value(mutable this) @ret_nonlocal true @deep true linked

    ; A whole tree.
    procedure value(mutable this, v: JsonValue) @ret_nonlocal true @deep true linked

    ; Bytes that already are JSON, as a value (the caller vouches for them).
    procedure raw(mutable this, json: Slice[u8]) @ret_nonlocal true @deep true linked

    ; ------------------------------------------------------------------

    ; The comma before an element that is not its container's first.
    procedure separate(mutable this) @deep true linked

    ; A string parse marked verbatim, with its quotes: sixteen bytes a step
    ; and no look at them. The last step reads up to fifteen bytes past the
    ; string, which the document copy's padding holds, and writes as far
    ; past the quotes, which the buffer is extended by and cut back from.
    procedure verbatim(mutable this, s: Slice[u8]) @deep true linked

    ; The string and its quotes written in place in one pass: the buffer is
    ; extended by the whole literal first, and sixteen bytes a step are
    ; stored and checked together. At the first byte that needs an escape
    ; the buffer is cut back to it, and the rest goes byte by byte.
    procedure quoted(mutable this, s: Slice[u8]) @deep true linked

    ; The rest of a string from its first byte that needs an escape, and the
    ; closing quote: runs of plain bytes in one copy.
    procedure quoted_rest(mutable this, s: Slice[u8], from: size_t) @ret_nonlocal true @deep true linked

    function plain(c: u8) @ret_nonlocal true @deep true returns bool linked

    procedure escape(mutable this, c: u8) @ret_nonlocal true @deep true linked

    ; The letter of c's named escape, 0 where only \u00XX will do.
    function escape_letter(c: u8) @ret_nonlocal true @deep true returns u8 linked

    ; s as a JSON string literal, for a document assembled by hand in a
    ; StringBuilder (the language server's replies): the escapes of text().
    function quote(s: Slice[u8]) @page true @direct true @ret_caller true @deep true returns String linked

    function quote(s: String) @page true @direct true @ret_nonlocal true @deep true returns String linked

    procedure append_quoted(mutable sb: ref[StringBuilder], s: Slice[u8]) @ret_nonlocal true @deep true linked

    ; v as JSON text in a String -- what value() writes into the buffer.
    function stringify(v: JsonValue) @page true @direct true @ret_caller true @deep true returns String linked

    procedure append_value(mutable sb: ref[StringBuilder], v: JsonValue) @ret_nonlocal true @deep true linked

    function hex_digit(v: u8) @ret_nonlocal true @deep true returns u8 linked

    procedure byte(mutable this, b: u8) @persists true @ret_nonlocal true @deep true linked

    procedure append(mutable this, s: Slice[u8]) @persists true @deep true linked
}
