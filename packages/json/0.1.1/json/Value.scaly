; The value tree, built from the reader's tokens. parse() copies the document
; ONCE onto its caller's page, and every string, member name and number of
; the tree is a view into that copy -- escapes decoded in place -- so the tree
; owns what it shows and allocates nothing per string. A number keeps its
; source text: as_i64 answers only where the text is an integer in range,
; as_f64 goes through strtod, number_text is the text itself (a FHIR decimal
; keeps its trailing zeros). An array's items and an object's members are
; exact-size buffers on the same page; the members keep document order, and
; get() takes the first of a duplicated name.
;
; Every accessor answers the empty value of its kind for a value of another
; kind (false, 0, the empty String, Null), so a chain like
; msg.get("params").get("textDocument").get("uri").as_string() needs no test
; between the steps.

use json.Reader.JsonReader
use json.Reader.JsonScan
use json.Reader.JsonStream

; What stage 2 expects at its token.
define STAGE_VALUE: int 0
define STAGE_KEY: int 1
define STAGE_COMPLETE: int 2

; strtod(3) — fixed prototype, errno not consulted.
function strtod(s: pointer[const_char], endp: pointer[pointer[u8]]) returns f64 extern
; memcpy(3): the document's copy
procedure memcpy(mutable dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

; How many bytes a parse's document copy carries past its end: a VERBATIM
; string (below) may be read that far past any of its bytes, so the writer
; copies it sixteen bytes a step with no loop for its tail.
define JSON_PADDING: size_t 16

; A member; verbatim_key as JsonString.verbatim, for the name.
define JsonMember (key: Slice[u8], value: JsonValue, verbatim_key: bool)

; Where a parse puts its copy of the document and the buffers of its closed
; containers: the page this record lives on, which is the parse's caller
; page. One allocation each, the exact size, filled by one copy -- where
; `Vector#(n)` spent a second allocation on its own record and cleared the
; buffer first (for the document copy, a memset of the whole document).
; A container's buffer is cut from a chunk of JSON_CHUNK elements the arena
; holds, filled element by element: a call to Page.allocate and one to
; memmove per container were a fifth of a parse of many small containers
; (citm_catalog, 2026-09-29). A container larger than a chunk gets its own.
define JSON_CHUNK: size_t 128

define JsonArena
(
    var value_room: Slice[JsonValue]
    var value_used: size_t
    var member_room: Slice[JsonMember]
    var member_used: size_t
)
{
    init()
    {
        let own_page Page.get(this)
        value_room.data := null
        value_room.length := 0
        value_used := 0
        member_room.data := null
        member_room.length := 0
        member_used := 0
    }

    ; The document's copy, with JSON_PADDING zero bytes past its end (the
    ; answer's length is the document's).
    procedure keep_document(mutable this, items: Slice[u8]) returns Slice[u8]
    {
        let padded allocate_slice[u8](Page.get(this), items.length + JSON_PADDING)
        if items.length > 0
            memcpy(padded.data as pointer[void], items.data as pointer[void], items.length)
        var i items.length
        while i < padded.length
        {
            padded.put(i, 0)
            i := i + 1
        }
        padded.subslice(0, items.length)
    }

    procedure keep_values(mutable this, items: Slice[JsonValue]) returns Slice[JsonValue]
    {
        let n items.length
        if n > JSON_CHUNK
        {
            let own allocate_slice[JsonValue](Page.get(this), n)
            memcpy(own.data as pointer[void], items.data as pointer[void], n * sizeof JsonValue)
            return own
        }
        if value_used + n > value_room.length
        {
            value_room := allocate_slice[JsonValue](Page.get(this), JSON_CHUNK)
            value_used := 0
        }
        let kept value_room.subslice(value_used, value_used + n)
        value_used := value_used + n
        var i: size_t 0
        while i < n
        {
            kept.put(i, items[i])
            i := i + 1
        }
        kept
    }

    procedure keep_members(mutable this, items: Slice[JsonMember]) returns Slice[JsonMember]
    {
        let n items.length
        if n > JSON_CHUNK
        {
            let own allocate_slice[JsonMember](Page.get(this), n)
            memcpy(own.data as pointer[void], items.data as pointer[void], n * sizeof JsonMember)
            return own
        }
        if member_used + n > member_room.length
        {
            member_room := allocate_slice[JsonMember](Page.get(this), JSON_CHUNK)
            member_used := 0
        }
        let kept member_room.subslice(member_used, member_used + n)
        member_used := member_used + n
        var i: size_t 0
        while i < n
        {
            kept.put(i, items[i])
            i := i + 1
        }
        kept
    }
}

; The views as records: a union's payload is a type NAME, not a generic
; instance (the grammar has no `Slice[...]` in that position).
define JsonArray (items: Slice[JsonValue])
define JsonObject (members: Slice[JsonMember])
; a number's text and a string's decoded bytes, views into the document copy;
; a number parse read is verbatim (as JsonString's below) without a test
define JsonNumber (text: Slice[u8], verbatim: bool)
; verbatim: set by parse alone, for a string that had no escape -- its bytes
; need none on the way out (a raw quote, backslash or control character
; cannot be in them), and they lie in a document copy padded by JSON_PADDING.
; The writer copies such a string without looking at it (yyjson's trick).
define JsonString (bytes: Slice[u8], verbatim: bool)

define JsonValue union
(
    Null
    Bool: bool
    Number: JsonNumber
    Text: JsonString
    Array: JsonArray
    Object: JsonObject
)
{
    function is_null(this) returns bool
    {
        choose this
            when n: Null
                return true
            else
                return false
    }

    function is_bool(this) returns bool
    {
        choose this
            when b: Bool
                return true
            else
                return false
    }

    function is_number(this) returns bool
    {
        choose this
            when n: Number
                return true
            else
                return false
    }

    function is_text(this) returns bool
    {
        choose this
            when t: Text
                return true
            else
                return false
    }

    function is_array(this) returns bool
    {
        choose this
            when a: Array
                return true
            else
                return false
    }

    function is_object(this) returns bool
    {
        choose this
            when o: Object
                return true
            else
                return false
    }

    function as_bool(this) returns bool
    {
        choose this
            when b: Bool
                return b
            else
                return false
    }

    ; A string's text as a String of its own (a copy); text() is the view.
    function as_string(this) returns String
    {
        choose this
            when t: Text
                return String(t.bytes.data as pointer[const_char], t.bytes.length)
            else
                return String()
    }

    ; A string's decoded text as a view into the tree, empty for anything else.
    function text(this) returns Slice[u8]
    {
        choose this
            when t: Text
                return t.bytes
            else
                return Slice[u8]()
    }

    ; A number's source text as a view into the tree, empty for anything else.
    function number_text(this) returns Slice[u8]
    {
        choose this
            when n: Number
                return n.text
            else
                return Slice[u8]()
    }

    ; A number without fraction or exponent whose value fits an i64.
    function is_integer(this) returns bool
    {
        choose this
            when n: Number
                return JsonValue.integer_fits(n.text)
            else
                return false
    }

    ; The value of an integer number (is_integer), 0 for anything else.
    function as_i64(this) returns i64
    {
        choose this
            when n: Number
            {
                if JsonValue.integer_fits(n.text)
                    return JsonValue.integer_value(n.text)
                return 0
            }
            else
                return 0
    }

    ; The nearest double to a number, 0 for anything else. strtod wants a
    ; terminated text, and the view is not: a local copy.
    function as_f64(this) returns f64
    {
        choose this
            when n: Number
            {
                let text n.text
                var buf Vector[u8](text.length + 1)
                var i: size_t 0
                while i < text.length
                {
                    buf.put(i, text[i])
                    i := i + 1
                }
                buf.put(text.length, 0)
                return strtod(buf.data as pointer[const_char], null as pointer[pointer[u8]])
            }
            else
                return 0.0
    }

    ; An array's item or an object's member count, 0 for anything else.
    function length(this) returns size_t
    {
        choose this
            when a: Array
                return a.items.length
            when o: Object
                return o.members.length
            else
                return 0
    }

    ; An array's i-th item, Null past its end or for anything else.
    function item(this, i: size_t) returns JsonValue
    {
        choose this
            when a: Array
            {
                if i < a.items.length
                    return a.items[i]
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    ; An object's member of that name, Null if it has none.
    function get(this, key: Slice[u8]) returns JsonValue
    {
        choose this
            when o: Object
            {
                var i: size_t 0
                while i < o.members.length
                {
                    let m o.members[i]
                    if m.key.equals(key)
                        return m.value
                    i := i + 1
                }
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    function has(this, key: Slice[u8]) returns bool
    {
        choose this
            when o: Object
            {
                var i: size_t 0
                while i < o.members.length
                {
                    if o.members[i].key.equals(key)
                        return true
                    i := i + 1
                }
                return false
            }
            else
                return false
    }

    ; An object's i-th member name (a view) / value, in document order.
    function key_at(this, i: size_t) returns Slice[u8]
    {
        choose this
            when o: Object
            {
                if i < o.members.length
                    return o.members[i].key
                return Slice[u8]()
            }
            else
                return Slice[u8]()
    }

    function value_at(this, i: size_t) returns JsonValue
    {
        choose this
            when o: Object
            {
                if i < o.members.length
                    return o.members[i].value
                return JsonValue.Null
            }
            else
                return JsonValue.Null
    }

    ; ------------------------------------------------------------------
    ; parsing

    ; Parse a whole document. On a refused one the result carries the code
    ; and offset JsonReader would report and a Null value. The tree is
    ; independent of source: it lives on the caller's page with its own copy
    ; of the text.
    ;
    ; Stage 2 (after simdjson): one loop over stage 1's structural positions
    ; (JsonStream), its state in locals -- what is expected next, the token
    ; position t, the value just completed. The items and members of the
    ; containers still open wait on two scratch stacks; a closing container
    ; moves its run into an exact-size buffer. A member is pushed with its
    ; name as soon as the colon is seen and gets its value when that is
    ; complete, so an open object's pending member is always the last.
    procedure parse(source: Slice[u8]) returns JsonParsed
    {
        var arena JsonArena#()
        var doc arena.keep_document(source)
        let n source.length
        var values Array[JsonValue]()
        var members Array[JsonMember]()
        ; per open container: its run's start on its stack, times two, plus
        ; one for an object
        var open Array[size_t]()
        var s JsonStream(0, 0, 0, 0, 0, 0)
        var state STAGE_VALUE
        var t s.take(doc)
        var v JsonValue.Null
        var error JSON_OK
        var error_at: size_t 0
        repeat
        {
            if state = STAGE_KEY
            {
                ; a member name at t, then its colon
                if t >= n
                {
                    error := JSON_END
                    error_at := n
                    break
                }
                if doc[t] <> 0x22
                {
                    error := JSON_KEY
                    error_at := t
                    break
                }
                var u s.take(doc)
                let close JsonValue.closing_quote(doc, t, u)
                if close.code <> JSON_OK
                {
                    error := close.code
                    error_at := close.at
                    break
                }
                while u < close.at
                    u := s.take(doc)
                let key JsonValue.string_text(doc, t, close)
                t := s.take(doc)
                if t >= n or doc[t] <> 0x3A                 ; ':'
                {
                    error := JSON_COLON
                    error_at := t
                    break
                }
                members.add(JsonMember(key, JsonValue.Null, close.flag = false))
                t := s.take(doc)
                state := STAGE_VALUE
            }
            ; a KEY falls through into its VALUE, a scalar VALUE into
            ; COMPLETE: the common path runs straight, and only a container
            ; or a separator goes back round the loop
            if state = STAGE_VALUE
            {
                ; a value begins at t
                if t >= n
                {
                    error := JSON_END
                    error_at := n
                    break
                }
                let c doc[t]
                if c = 0x7B or c = 0x5B                     ; '{' '['
                {
                    if open.length >= MAX_DEPTH
                    {
                        error := JSON_DEPTH
                        error_at := t
                        break
                    }
                    let is_object c = 0x7B
                    t := s.take(doc)
                    if is_object
                    {
                        if t < n and doc[t] = 0x7D          ; '}'
                        {
                            v := JsonValue.Object(JsonObject(null))
                            t := s.take(doc)
                            state := STAGE_COMPLETE
                            continue
                        }
                        open.add((members.length << 1) + 1)
                        state := STAGE_KEY
                        continue
                    }
                    if t < n and doc[t] = 0x5D              ; ']'
                    {
                        v := JsonValue.Array(JsonArray(null))
                        t := s.take(doc)
                        state := STAGE_COMPLETE
                        continue
                    }
                    open.add(values.length << 1)
                    continue
                }
                if c = 0x22                                 ; '"'
                {
                    ; its closing quote: the next structural position when
                    ; the string has neither escape nor control character,
                    ; else the byte scanner's (string_text says why the
                    ; stream is taken up to it first)
                    var u s.take(doc)
                    let close JsonValue.closing_quote(doc, t, u)
                    if close.code <> JSON_OK
                    {
                        error := close.code
                        error_at := close.at
                        break
                    }
                    while u < close.at
                        u := s.take(doc)
                    v := JsonValue.Text(JsonString(JsonValue.string_text(doc, t, close), close.flag = false))
                    t := s.take(doc)
                    state := STAGE_COMPLETE
                }
                else
                {
                    var end: size_t 0
                    if c = 0x2D or (c >= 0x30 and c <= 0x39)    ; '-' or a digit
                    {
                        let num JsonReader.number_end(doc, t)
                        if num.code <> JSON_OK
                        {
                            error := num.code
                            error_at := num.at
                            break
                        }
                        v := JsonValue.Number(JsonNumber(doc.subslice(t, num.at), true))
                        end := num.at
                    }
                    else
                    {
                        if JsonValue.literal_at(doc, t, "true")
                        {
                            v := JsonValue.Bool(true)
                            end := t + 4
                        }
                        else
                        {
                            if JsonValue.literal_at(doc, t, "false")
                            {
                                v := JsonValue.Bool(false)
                                end := t + 5
                            }
                            else
                            {
                                if JsonValue.literal_at(doc, t, "null")
                                {
                                    v := JsonValue.Null
                                    end := t + 4
                                }
                                else
                                {
                                    error := JSON_VALUE
                                    error_at := t
                                    break
                                }
                            }
                        }
                    }
                    ; a scalar that runs on into scalar bytes (`12x`, `truex`)
                    ; ends where the pull reader sees the byte after it: that
                    ; byte is no structural position, and the separator test
                    ; refuses it
                    t := s.take(doc)
                    if end < n and t <> end and JsonReader.is_ws(doc[end]) = false
                        t := end
                    state := STAGE_COMPLETE
                }
            }
            ; STAGE_COMPLETE: v is complete, t is the token after it
            if open.length = 0
            {
                if t < n
                {
                    error := JSON_TRAILING
                    error_at := t
                }
                break
            }
            let top open[open.length - 1]
            let in_object (top & 1) = 1
            if in_object
            {
                let last members.length - 1
                let pending members[last]
                members.put(last, JsonMember(pending.key, v, pending.verbatim_key))
            }
            else
                values.add(v)
            if t >= n
            {
                error := JSON_END
                error_at := n
                break
            }
            let c doc[t]
            if c = 0x2C                                     ; ','
            {
                t := s.take(doc)
                if in_object
                    state := STAGE_KEY
                else
                    state := STAGE_VALUE
                continue
            }
            let run top >> 1
            if in_object and c = 0x7D                       ; '}'
            {
                let kept arena.keep_members(members.as_slice().subslice(run, members.length))
                members.length := run
                v := JsonValue.Object(JsonObject(kept))
            }
            else
            {
                if in_object = false and c = 0x5D           ; ']'
                {
                    let kept arena.keep_values(values.as_slice().subslice(run, values.length))
                    values.length := run
                    v := JsonValue.Array(JsonArray(kept))
                }
                else
                {
                    error := JSON_SEPARATOR
                    error_at := t
                    break
                }
            }
            open.length := open.length - 1
            t := s.take(doc)
        }
        if error <> JSON_OK
            return JsonParsed(JsonValue.Null, error, error_at)
        JsonParsed(v, JSON_OK, 0)
    }

    ; The closing quote of the string that opens at doc[t], given stage 1's
    ; next structural position u: that one, when it is a quote (the string
    ; has neither escape nor control character), else the byte scanner's.
    ; Bound with `let`: a `var` of a record `set` to a call's result was
    ; copied to the frame page at every set -- an allocation per string.
    function closing_quote(doc: Slice[u8], t: size_t, u: size_t) returns JsonScan
    {
        if u < doc.length and doc[u] = 0x22
            return JsonScan(JSON_OK, u, false)
        JsonReader.string_close(doc, t)
    }

    ; The text of the string that opens at doc[open] and closes at close.at,
    ; its escapes decoded in place. Its closing quote was TAKEN from the
    ; stream before, which classified every block the string touches: stage
    ; 1 must never see decoded bytes -- an escaped quote would become a real
    ; one.
    procedure string_text(mutable doc: Slice[u8], open: size_t, close: JsonScan) returns Slice[u8]
    {
        if close.flag = false
            return doc.subslice(open + 1, close.at)
        let n JsonReader.decode_in_place(doc, open + 1, close.at)
        doc.subslice(open + 1, open + 1 + n)
    }

    ; word stands at doc[at] (byte by byte: a call to memcmp cost more than
    ; the four compares).
    function literal_at(doc: Slice[u8], at: size_t, word: Slice[u8]) returns bool
    {
        if at + word.length > doc.length
            return false
        var i: size_t 0
        while i < word.length
        {
            if doc[at + i] <> word[i]
                return false
            i := i + 1
        }
        true
    }

    ; ------------------------------------------------------------------
    ; integers

    ; text is an integer (no fraction, no exponent) within i64.
    function integer_fits(text: Slice[u8]) returns bool
    {
        if text.length = 0
            return false
        var i: size_t 0
        var limit: u64 0x7FFFFFFFFFFFFFFF
        if text[0] = 0x2D
        {
            i := 1
            limit := 0x8000000000000000
        }
        if i >= text.length
            return false
        var v: u64 0
        while i < text.length
        {
            let c text[i]
            if c < 0x30 or c > 0x39
                return false
            let d (c - 0x30) as u64
            if v > (limit - d) / 10
                return false
            v := (v * 10) + d
            i := i + 1
        }
        true
    }

    ; The value of text, which integer_fits.
    function integer_value(text: Slice[u8]) returns i64
    {
        var i: size_t 0
        var negative false
        if text[0] = 0x2D
        {
            i := 1
            negative := true
        }
        var v: u64 0
        while i < text.length
        {
            v := (v * 10) + ((text[i] - 0x30) as u64)
            i := i + 1
        }
        if negative
            return ((0 as u64) - v) as i64
        v as i64
    }
}

; What JsonValue.parse answers: the value, or why and where the document
; was refused.
define JsonParsed
(
    value: JsonValue
    error: int
    offset: size_t
)
{
    function ok(this) returns bool
        error = JSON_OK

    function message(this) returns Slice[char]
        JsonReader.message(error)
}
