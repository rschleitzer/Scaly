; The server: a router of handlers and the connection loop over
; scaly.os.Tcp's serve (one scheduler per core, every connection a task).
;
; A handler is a procedure (req: ref[Request], mutable res: ref[Response]),
; registered by address:
;
;   procedure hello(req: ref[Request], mutable res: ref[Response])
;       res.send_text("Hello, World!")
;
;   var app Router.create(Page.allocate_page())
;   app.get("/hello", &hello)
;   app.get("/delay/{ms}", &delay)            ; req.param("ms") — see Router
;   serve(app, 8080)                          ; false: cannot listen
;
; A connection reads into a buffer on a page of its own, answers every
; complete request in it (pipelined requests are answered in order and their
; responses leave in one write), keeps the unconsumed tail, and reads again.
; Each request is dispatched in a routine of its own, so what a handler
; allocates dies when the handler returns, not when the connection ends.

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response
use http.Router.Router

; A connection's input buffer starts here and doubles up to MAX_HEAD plus
; MAX_BODY; its output buffer starts at OUT_SIZE.
define IN_SIZE: size_t 16384
define OUT_SIZE: size_t 16384

; The router the serving threads dispatch through, as an address: stored
; before serve starts its threads (an ordinary global would be thread-
; local), and only through scaly_atomic_* — so it is ambient, and neither
; serve nor its callers have to name it as a global they write.
shared atomic http_router: u64 0

; How long a connection may say nothing while it waits for a request
; (keep-alive between two, HTTP/2 between frames), and how long a request's
; head may take from its first bytes: past either its reading ends
; (Io.idle), and it closes as after its client's end. A handler's own time
; does not count, nor does a WebSocket's silence. Without them a client
; that sent nothing, or a byte a minute (slowloris), held a fiber, a page
; and a descriptor as long as it liked, and a few thousand such filled the
; descriptor table. Seconds, 0 for none; atomics like http_router, read on
; every serving thread.
shared atomic http_idle_seconds: u64 60
shared atomic http_head_seconds: u64 30

; Set the two bounds for every server of the process (a test, or a service
; that wants others); 0 turns one off.
procedure set_idle_limits(idle: u64, head: u64)
{
    scaly_atomic_store_u64(&http_idle_seconds, idle)
    scaly_atomic_store_u64(&http_head_seconds, head)
}

; The bound before connection fd reads again, `held` the bytes it holds:
; a request's head begun and not complete keeps the bound its first bytes
; set (a byte a minute does not move it), else the idle bound from now.
; head_open says whether the head's bound stands.
procedure bound_idle(fd: i32, held: Slice[u8], mutable head_open: ref[bool])
{
    if held.length > 0 and head_end(held) = 0
    {
        if head_open = false
        {
            head_open := true
            Io.idle(fd, scaly_atomic_load_u64(&http_head_seconds) as i64)
        }
        return
    }
    head_open := false
    Io.idle(fd, scaly_atomic_load_u64(&http_idle_seconds) as i64)
}

; Answer one request: route it and run its handler. A routine of its own so
; that what the handler allocates dies here. The request and the response
; are the connection's, on its page, reused for every request: a handler
; is called through an address, and the escape checker does not let a
; frame-local reference go where it cannot see.
procedure dispatch(router: ref[Router], mutable req: ref[Request], mutable res: ref[Response])
{
    res.reset(req.keep_alive = false)
    router.handle(req, res)
}

; The answer to a request that could not be parsed; the connection ends
; after it.
procedure refuse(mutable res: ref[Response], code: int)
{
    res.reset(true)
    res.set_status(code)
    res.send_empty()
}

; Every connection: read, answer what is complete, write, keep the rest.
procedure http_connection()
{
    var c TcpStream.of_task()
    c.set_nodelay(true)
    let router (scaly_atomic_load_u64(&http_router) as size_t) as ref[Router]
    serve_connection[TcpStream](&c, router)
}

; Every connection of a dedicated h2c listener (start_h2c): HTTP/2 by prior
; knowledge, and an HTTP/1.1 request refused rather than served.
procedure h2c_connection()
{
    var c TcpStream.of_task()
    c.set_nodelay(true)
    let router (scaly_atomic_load_u64(&http_router) as size_t) as ref[Router]
    serve_stream[TcpStream](&c, router, true)
}

; The loop of one connection over any stream that reads into a Slice (the
; count, 0 at the end, -1 on an error), writes a Slice whole and closes: a
; TcpStream here, a TlsStream in the https package -- which is why it takes
; the router rather than reading this module's global.
procedure serve_connection[S](mutable c: ref[S], router: ref[Router])
    serve_stream[S](c, router, false)

; ... and with h2_only, a connection that does not open with the HTTP/2
; client preface is answered 505 (HTTP Version Not Supported) and closed.
;
; A fault while serving it -- a bounds violation, a null unwrapped, in the
; protocol code or in a handler -- ends this connection alone, unanswered,
; with one line on stderr. A fault in a fiber is caught only on that fiber's
; own stack, so without this catch point one malformed request would end
; the process and every connection in it. One catch point per connection,
; not per request: it costs a setjmp and an allocation.
procedure serve_stream[S](mutable c: ref[S], router: ref[Router], h2_only: bool)
{
    let host Page.allocate_page()
    try let served serve_loop[S](c, router, h2_only, host)
        else
            report_fault("http")
    c.close()
    host.deallocate_extensions()
    Page.release_page(host)
}

; The line on stderr for a fault caught where a connection is served (h3
; writes it too): what the panic said, as the runtime keeps it -- scalars and
; a static string, since the regions between the trap and the catch point
; are gone.
procedure report_fault(protocol: pointer[const_char])
{
    scaly_eputs(protocol)
    scaly_eputs ": a fault ended a connection: "
    scaly_eputs(Region.panic_what())
    scaly_eputs " (index "
    scaly_eputi(Region.panic_index())
    scaly_eputs ", length "
    scaly_eputi(Region.panic_length())
    scaly_eputs ")"
    scaly_eputnl()
}

; The loop of serve_stream, its buffers on host; true when it ended.
procedure serve_loop[S](mutable c: ref[S], router: ref[Router], h2_only: bool, host: ref[Page]) returns bool
{
    var inb ByteBuf.create(host, IN_SIZE)
    let outb &ByteBuf^host(host, allocate_slice[u8]^host(host, OUT_SIZE), 0, false)
    let req &Request^host(null, null, null, null, null, null, 1, true, null, null)
    let res Response.create(host, outb)
    let fd: i32 c.descriptor()
    var head_open false
    var open true
    var first true
    ; what the exchange after the last answer read, -2 when it did not run
    var ahead: int 0 - 2
    while open
    {
        var n ahead
        ahead := 0 - 2
        if n = 0 - 2
        {
            bound_idle(fd, inb.bytes(), &head_open)
            n := c.read(inb.spare())
        }
        if n <= 0
            break
        inb.advance(n as size_t)
        res.tick()
        ; HTTP/2: the client preface instead of a request line (h2c by prior
        ; knowledge, and h2 after ALPN -- the preface is all either sends).
        ; Fewer bytes than the preface that still match it decide nothing:
        ; "P" begins "PRI * HTTP/2.0" and "POST" alike, so read on.
        if first and starts_h2(inb.bytes())
        {
            if inb.length < h2_preface().length
                continue
            serve_h2[S](c, router, host, &inb, req, res, outb, fd)
            break
        }
        if h2_only
        {
            refuse(res, 505)
            if outb.length > 0
                c.write(outb.bytes())
            break
        }
        first := false
        if TcpServer.current().stopping()
            open := false
        ; answer every complete request in the buffer
        var done: size_t 0
        repeat
        {
            var view inb.bytes().slice_from(done)
            if view.length = 0
                break
            let r parse_request(view, req)
            if r = PARSE_INCOMPLETE
                break
            if r < 0
            {
                refuse(res, refusal_status(r))
                open := false
                break
            }
            ; the handler's time is not silence (nor is a WebSocket's)
            Io.idle(fd, 0)
            head_open := false
            dispatch(router, req, res)
            done := done + (r as size_t)
            if res.websocket <> null
                break
            if req.keep_alive = false
            {
                open := false
                break
            }
        }
        inb.consume(done)
        ; an accepted WebSocket upgrade: the 101 goes out, the rest of the
        ; connection is frames
        if open and res.websocket <> null
        {
            if c.write(outb.bytes()) = false
                break
            outb.clear()
            serve_websocket[S](c, res.websocket, host, &inb, outb)
            break
        }
        if inb.length = inb.capacity()
        {
            if inb.capacity() >= MAX_HEAD + MAX_BODY
                open := false
            else
                inb.reserve(inb.capacity())
        }
        if outb.length > 0
        {
            if open
            {
                ; the answers and the next read in one exchange: on a ring
                ; the receive is queued behind the send, one wait for both
                bound_idle(fd, inb.bytes(), &head_open)
                ahead := c.exchange(outb.bytes(), inb.spare())
                if ahead <= 0
                    open := false
            }
            else
                c.write(outb.bytes())
            outb.clear()
        }
    }
    true
}

; Serve router on every interface, both families, over all cores. Runs for
; as long as the process (or until a handler shuts the server down) and
; then answers true; false at once when the port cannot be listened on.
procedure serve(router: ref[Router], port: int) returns bool
{
    scaly_atomic_store_u64(&http_router, router as u64)
    var l TcpListener.listen_any(port)
    if l.is_open() = false
        return false
    l.serve(&http_connection)
    true
}

; Serve like serve, but on a listener the caller made, and return at once
; with the TcpServer (shutdown, wait).
procedure start(router: ref[Router], l: TcpListener) returns TcpServer
{
    scaly_atomic_store_u64(&http_router, router as u64)
    l.start(&http_connection)
}

; Serve HTTP/2 by prior knowledge alone on a listener the caller made: a
; dedicated h2c port, which refuses HTTP/1.1 (start serves both).
procedure start_h2c(router: ref[Router], l: TcpListener) returns TcpServer
{
    scaly_atomic_store_u64(&http_router, router as u64)
    l.start(&h2c_connection)
}
