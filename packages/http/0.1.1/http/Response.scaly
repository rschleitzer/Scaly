; A response, written straight into the connection's output buffer: the
; status line and the fixed fields when the first field or the body comes,
; each field as it is added, then Content-Length and the body. Nothing is
; allocated per response; pipelined responses queue up in the buffer and
; leave in one write.
;
;   res.set_status(201)                           ; before anything else
;   res.header("x-cache", "HIT")                   ; any number of fields
;   res.send("application/json", body)             ; ends the response
;
; Over HTTP/2 (hpack set by the connection) the same calls write the header
; block HPACK-coded instead -- :status, date, the fields, content-type and
; -length -- and the body behind it (block_at .. body_at, then the body):
; the connection frames them as they stand, where it used to parse the
; HTTP/1.1 text back and encode it (2026-09-30: a fifth of the server's
; samples in baseline-h2). Over HTTP/3 (qpack) likewise, as a QPACK field
; section.

use http.Buffer.ByteBuf
use http.Request.Request

; "HTTP/1.1 200 OK\r\nDate: " (23), the date (DATE_LENGTH), "\r\n".
define HEAD_OK_LENGTH: size_t 54
define HEAD_OK_DATE_AT: size_t 23

; The HPACK twin of head_ok: :status 200 (static entry 8, 0x88), then the
; date as a literal with the indexed name date (entry 33: 0x0f 0x12) and a
; length of 29 (0x1d), the date itself filled in once per second.
define HPACK_OK_LENGTH: size_t 33
define HPACK_OK_DATE_AT: size_t 4

procedure init_hpack_ok(mutable h: Slice[u8])
{
    h.put(0, 136)
    h.put(1, 15)
    h.put(2, 18)
    h.put(3, 29)
}

; The QPACK twin (HTTP/3): an empty field section prefix (0x00 0x00),
; :status 200 (static entry 25, 0xd9), the date as a literal with the name
; reference date (entry 6: 0x56) and a length of 29 (0x1d).
define QPACK_OK_LENGTH: size_t 34
define QPACK_OK_DATE_AT: size_t 5

procedure init_qpack_ok(mutable h: Slice[u8])
{
    h.put(0, 0)
    h.put(1, 0)
    h.put(2, 217)
    h.put(3, 86)
    h.put(4, 29)
}

; Fill a connection's head_ok block with its fixed parts; the date in the
; middle is Response.date, a view formatted in place once per second.
procedure init_head_ok(mutable h: Slice[u8])
{
    let prefix: Slice[u8] "HTTP/1.1 200 OK\r\nDate: "
    var i: size_t 0
    while i < prefix.length
    {
        h.put(i, prefix[i])
        i := i + 1
    }
    h.put(HEAD_OK_LENGTH - 2, 13)
    h.put(HEAD_OK_LENGTH - 1, 10)
}

define Response
(
    out: ref[ByteBuf]
    var status: int
    var started: bool            ; the status line is written
    var sent: bool               ; the body is written: the response is done
    var close: bool              ; Connection: close, and the connection ends
    date: Slice[u8]              ; the connection's date, a view into head_ok
    var date_second: i64         ; the second date was formatted for
    head_ok: Slice[u8]           ; "HTTP/1.1 200 OK\r\nDate: <date>\r\n", HEAD_OK_LENGTH
    var head_only: bool          ; a HEAD request: everything but the body
    trailers: ref[ByteBuf]       ; "name: value\r\n" lines sent after the body (HTTP/2 only)
    var websocket: pointer[void] ; the message handler of an accepted WebSocket upgrade
    var hpack: bool              ; HTTP/2: the head is an HPACK block
    var block_at: size_t         ; where the HPACK block starts in out
    var body_at: size_t          ; where the body starts in out (HPACK)
    hpack_ok: Slice[u8]          ; the HPACK :status 200 and date (init_hpack_ok)
    var ticked: bool             ; the connection reads the clock (tick), start need not
    var qpack: bool              ; HTTP/3: the head is a QPACK field section
    qpack_ok: Slice[u8]          ; the QPACK :status 200 and date (init_qpack_ok)
)
{
    ; A connection's response on its page, writing into out: the 200 head
    ; block and the date view inside it made once (see init_head_ok).
    procedure create(host: ref[Page], out: ref[ByteBuf]) returns ref[Response]
    {
        var head allocate_slice[u8]^host(host, HEAD_OK_LENGTH)
        init_head_ok(head)
        let trailers &ByteBuf^host(host, allocate_slice[u8]^host(host, 64), 0, false)
        var hpack_head allocate_slice[u8]^host(host, HPACK_OK_LENGTH)
        init_hpack_ok(hpack_head)
        var qpack_head allocate_slice[u8]^host(host, QPACK_OK_LENGTH)
        init_qpack_ok(qpack_head)
        &Response^host(out, 200, false, false, false, head.subslice(HEAD_OK_DATE_AT, HEAD_OK_DATE_AT + DATE_LENGTH), 0 - 1, head, false, trailers, null, false, 0, 0, hpack_head, false, false, qpack_head)
    }

    ; Ready for the next response on the same connection.
    procedure reset(mutable this, close_after: bool)
    {
        status := 200
        started := false
        sent := false
        close := close_after
        head_only := false
        websocket := null
        block_at := out.length
        body_at := out.length
        trailers.clear()
    }

    ; Accept a WebSocket upgrade (RFC 6455 4.2): 101 with the accept key, and
    ; the connection hands every message to `handler` (http.WebSocket) once
    ; this response is out. A request that is no upgrade -- no `Upgrade:
    ; websocket`, no `Connection: Upgrade`, no key, a version other than 13
    ; -- answers 400 instead, and false.
    procedure accept_websocket(mutable this, req: ref[Request], mutable handler: pointer[void]) returns bool
    {
        ; an HTTP/2 or HTTP/3 stream is no connection to take over
        if hpack or qpack
        {
            this.set_status(400)
            this.send_empty()
            return false
        }
        let key trim(req.header("sec-websocket-key"))
        if key.length = 0 or has_token(req.header("upgrade"), "websocket") = false or has_token(req.header("connection"), "upgrade") = false or trim(req.header("sec-websocket-version")).equals("13") = false
        {
            this.set_status(400)
            this.send_empty()
            return false
        }
        var accept u8[28]
        let a Slice[u8](28, &accept[0])
        websocket_accept(key, a)
        this.set_status(101)
        this.header("Upgrade", "websocket")
        this.header("Connection", "Upgrade")
        this.header("Sec-WebSocket-Accept", a)
        out.append("\r\n")
        sent := true
        websocket := handler
        true
    }

    ; A trailer field (lowercase name), sent after the body when the response
    ; goes out over HTTP/2 -- gRPC's grpc-status. HTTP/1.1 leaves it out.
    procedure trailer(mutable this, name: Slice[u8], value: Slice[u8])
    {
        trailers.append(name)
        trailers.append(": ")
        trailers.append(value)
        trailers.append("\r\n")
    }

    ; The status code; ignored once the status line is out.
    procedure set_status(mutable this, code: int)
    {
        if started = false
            status := code
    }

    ; Answer without the body (a HEAD request); Content-Length still names it.
    procedure set_head_only(mutable this)
        head_only := true

    ; End the connection after this response.
    procedure set_close(mutable this)
    {
        if started = false
            close := true
    }

    procedure start(mutable this)
    {
        if started
            return
        started := true
        if ticked = false
            this.clock(scaly_time_now())
        if hpack
        {
            ; the common case in one copy, as head_ok is for HTTP/1.1 (the
            ; status and date encoded per response were 2 % of the server's
            ; samples in baseline-h2, 2026-09-30)
            block_at := out.length
            if status = 200
            {
                out.append(hpack_ok)
                return
            }
            encode_status(out, status as i64)
            out.append(hpack_ok.slice_from(1))
            return
        }
        if qpack
        {
            block_at := out.length
            if status = 200
            {
                out.append(qpack_ok)
                return
            }
            out.append(qpack_ok.slice_to(2))
            qpack_status(out, status as i64)
            out.append(qpack_ok.slice_from(3))
            return
        }
        ; the common case in one copy: 200, the connection stays
        if status = 200 and close = false
        {
            out.append(head_ok)
            return
        }
        out.append("HTTP/1.1 ")
        out.append_uint(status as u64)
        out.append_byte(32)
        out.append(reason_phrase(status))
        out.append("\r\nDate: ")
        out.append(date)
        if close
            out.append("\r\nConnection: close")
        out.append("\r\n")
    }

    ; The clock, once for a batch of responses: a connection loop calls it
    ; after each read, and start then reads no clock of its own (one read
    ; per response was 1.5 % of the server's CPU in pipelined on Linux,
    ; 2026-09-30). A response nobody ticks reads it in start, as before.
    procedure tick(mutable this)
    {
        this.clock(scaly_time_now())
        ticked := true
    }

    ; The date for second `now`, formatted when the second changed.
    procedure clock(mutable this, now: i64)
    {
        if now = date_second
            return
        format_date(date, now)
        date_second := now
        var d: size_t 0
        while d < DATE_LENGTH
        {
            hpack_ok.put(HPACK_OK_DATE_AT + d, date[d])
            qpack_ok.put(QPACK_OK_DATE_AT + d, date[d])
            d := d + 1
        }
    }

    ; One header field. After send it is ignored.
    procedure header(mutable this, name: Slice[u8], value: Slice[u8])
    {
        if sent
            return
        this.start()
        if hpack
        {
            encode_header_field(out, name, value)
            return
        }
        if qpack
        {
            qpack_header_field(out, name, value)
            return
        }
        out.append(name)
        out.append(": ")
        out.append(value)
        out.append("\r\n")
    }

    ; The body with its content type; ends the response. A second send is
    ; ignored.
    procedure send(mutable this, content_type: Slice[u8], body: Slice[u8])
        this.send_encoded(content_type, "", body)

    ; A body already in a content coding (`gzip`: the client's
    ; accepts_encoding said so, the caller compressed it); an empty encoding
    ; is send. Ends the response.
    procedure send_encoded(mutable this, content_type: Slice[u8], encoding: Slice[u8], body: Slice[u8])
    {
        if sent
            return
        this.start()
        if hpack
        {
            if content_type.length > 0
                encode_indexed_field(out, 31, content_type)
            if encoding.length > 0
                encode_indexed_field(out, 26, encoding)
            if status <> 204 and status <> 304
            {
                var digits u8[24]
                let n decimal_into(Slice[u8](24, &digits[0]), body.length as u64)
                encode_indexed_field(out, 28, Slice[u8](n, &digits[0]))
            }
            body_at := out.length
            if head_only = false
                out.append(body)
            sent := true
            return
        }
        if qpack
        {
            if content_type.length > 0
                qpack_indexed_field(out, 44, content_type)
            if encoding.length > 0
                qpack_indexed_field(out, 42, encoding)
            if status <> 204 and status <> 304
            {
                var digits u8[24]
                let n decimal_into(Slice[u8](24, &digits[0]), body.length as u64)
                qpack_indexed_field(out, 4, Slice[u8](n, &digits[0]))
            }
            body_at := out.length
            if head_only = false
                out.append(body)
            sent := true
            return
        }
        ; the plain case in the appends it always took (baseline's hot path)
        if content_type.length > 0
        {
            out.append("Content-Type: ")
            out.append(content_type)
            if encoding.length > 0
            {
                out.append("\r\nContent-Encoding: ")
                out.append(encoding)
            }
            out.append("\r\nContent-Length: ")
        }
        else
        {
            ; a 204 carries no body and may not name one (RFC 9110 8.6)
            if status = 204
            {
                out.append("\r\n")
                sent := true
                return
            }
            if encoding.length > 0
            {
                out.append("Content-Encoding: ")
                out.append(encoding)
                out.append("\r\n")
            }
            out.append("Content-Length: ")
        }
        out.append_uint(body.length as u64)
        out.append("\r\n\r\n")
        if head_only = false
            out.append(body)
        sent := true
    }

    procedure send_text(mutable this, body: Slice[u8])
        this.send("text/plain", body)

    ; A body without a type (a 204, a 404's empty answer).
    procedure send_empty(mutable this)
        this.send("", "")

    ; A decimal number as a text/plain body, without building a string.
    procedure send_int(mutable this, v: i64)
    {
        var digits u8[24]
        var n: size_t 0
        var x v
        var neg false
        if x < 0
        {
            neg := true
            x := 0 - x
        }
        repeat
        {
            digits[n] := ((x % 10) as u8) + 48
            n := n + 1
            x := x / 10
            if x = 0
                break
        }
        var text u8[24]
        var k: size_t 0
        if neg
        {
            text[0] := 45
            k := 1
        }
        while n > 0
        {
            n := n - 1
            text[k] := digits[n]
            k := k + 1
        }
        this.send_text(Slice[u8](k, &text[0]))
    }
}

function reason_phrase(code: int) returns Slice[u8]
{
    match code
        case 101: return "Switching Protocols"
        case 200: return "OK"
        case 201: return "Created"
        case 204: return "No Content"
        case 301: return "Moved Permanently"
        case 302: return "Found"
        case 304: return "Not Modified"
        case 400: return "Bad Request"
        case 401: return "Unauthorized"
        case 403: return "Forbidden"
        case 404: return "Not Found"
        case 405: return "Method Not Allowed"
        case 413: return "Content Too Large"
        case 426: return "Upgrade Required"
        case 431: return "Request Header Fields Too Large"
        case 500: return "Internal Server Error"
        case 501: return "Not Implemented"
        case 503: return "Service Unavailable"
    "Unknown"
}
