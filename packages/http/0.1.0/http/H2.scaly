; HTTP/2 (RFC 9113) on a connection whose first bytes are the client
; preface: h2 over TLS after ALPN, h2c by prior knowledge, and on the
; HTTP/1.1 port the same way — serve_connection looks at the first bytes and
; hands the connection here.
;
; A request is translated, not re-implemented: its header block (HPACK) and
; body become HTTP/1.1 request text, parse_request fills the connection's
; Request from it (a request without a body skips the text:
; request_from_fields fills the Request the parse would) and the router
; runs the handler as for HTTP/1.1. The Response, in its HPACK mode, writes
; the header block (literals without indexing) and the body behind it, and
; they go out as HEADERS and DATA frames as they stand. Every route,
; middleware and handler therefore serves both protocols unchanged.
;
; Flow control: a response is sent as far as the connection's and its
; stream's send windows allow and the rest waits, copied onto a page of its
; own, for the client's WINDOW_UPDATE. Received DATA is credited back at
; once, and the server's initial window for request bodies is 1 MiB.
; Streams are answered in the order their requests complete, one at a time:
; a handler that parks holds the connection's other streams.

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response
use http.Router.Router
use http.Hpack.HeaderList
use http.Hpack.HpackDecoder

define H2_FRAME_HEAD: size_t 9
; SETTINGS_MAX_FRAME_SIZE's upper bound; a larger frame is refused
define H2_MAX_FRAME: size_t 16777215
define H2_DEFAULT_WINDOW: i64 65535
define H2_OWN_WINDOW: i64 1048576
define H2_CONN_WINDOW_BOOST: i64 16711680
; What the connection's output buffer holds before it is written: past it
; no more frames are taken from the input until the output went out, so
; the buffer holds this plus one response. Without it the answers to a
; whole read's worth of requests (h2load's 32 streams of static files, up to
; 200 KB each) stood in it at once: 0.9-1.2 GiB for static-h2 at 512
; connections (2026-09-29). Measured on that profile: 64 KiB 430-510 MiB at
; 5-10 % less throughput (more, smaller writes), 256 KiB 520-710 MiB at the
; unbudgeted throughput. Holding back DATA as pending responses instead --
; each body copied onto a page of its own and freed when sent -- measured
; 6 GiB and a quarter less: the copies churned the allocator.
define H2_FLUSH_AT: size_t 262144

; The client connection preface (RFC 9113 3.4).
function h2_preface() returns Slice[u8]
    "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"

; Do the first bytes of a connection begin (or, with fewer than 24, may
; still begin) the client preface?
function starts_h2(bytes: Slice[u8]) returns bool
{
    let p h2_preface()
    var n bytes.length
    if n > p.length
        set n: p.length
    n > 0 and bytes.slice_to(n).equals(p.slice_to(n))
}

function be24(s: Slice[u8], at: size_t) returns size_t
    ((s[at] as size_t) << 16) | ((s[at + 1] as size_t) << 8) | (s[at + 2] as size_t)

function be31(s: Slice[u8], at: size_t) returns u64
    (((s[at] as u64) & 127) << 24) | ((s[at + 1] as u64) << 16) | ((s[at + 2] as u64) << 8) | (s[at + 3] as u64)

; A frame's head: length, type, flags, stream.
procedure frame_head(mutable out: ref[ByteBuf], length: size_t, kind: u8, flags: u8, stream: u64)
{
    ; room once, then the nine bytes through a copy of the view: an
    ; append_byte each checked the room and stored the length nine times
    out.reserve(H2_FRAME_HEAD)
    var d: Slice[u8] out.data
    let at: size_t out.length
    d.put(at, ((length >> 16) & 255) as u8)
    d.put(at + 1, ((length >> 8) & 255) as u8)
    d.put(at + 2, (length & 255) as u8)
    d.put(at + 3, kind)
    d.put(at + 4, flags)
    d.put(at + 5, ((stream >> 24) & 127) as u8)
    d.put(at + 6, ((stream >> 16) & 255) as u8)
    d.put(at + 7, ((stream >> 8) & 255) as u8)
    d.put(at + 8, (stream & 255) as u8)
    set out.length: at + H2_FRAME_HEAD
}

procedure append_u32(mutable out: ref[ByteBuf], v: u64)
{
    out.append_byte(((v >> 24) & 255) as u8)
    out.append_byte(((v >> 16) & 255) as u8)
    out.append_byte(((v >> 8) & 255) as u8)
    out.append_byte((v & 255) as u8)
}

; A stream whose request body is still arriving: its request text so far.
define H2Stream
(
    id: u64
    page: ref[Page]
    var text: ByteBuf
    ; where the body starts in text, to count its length
    body_at: size_t
)

; A response that waits for window: the rest of its body, on its own page.
define H2Pending
(
    id: u64
    page: ref[Page]
    body: Slice[u8]
    var sent: size_t
    var window: i64
    ; the last DATA frame ends the stream (no trailers follow)
    end_stream: bool
    ; trailer lines sent once the body is out
    trailers: Slice[u8]
)

; Decoded request fields (HTTP/2 or HTTP/3) as HTTP/1.1 request text in
; `text`: the request line from :method and :path, host from :authority,
; the other fields but those HTTP/1.1 frames itself (a body's length is the
; caller's); the blank line unless a body follows. False without :method
; or :path.
procedure fields_request_text(fields: ref[HeaderList], mutable text: ref[ByteBuf], has_body: bool) returns bool
{
    let method fields.get(":method")
    let path fields.get(":path")
    if method.length = 0 or path.length = 0
        return false
    text.clear()
    text.append(method)
    text.append_byte(32)
    text.append(path)
    text.append(" HTTP/1.1\r\n")
    let authority fields.get(":authority")
    if authority.length > 0
    {
        text.append("host: ")
        text.append(authority)
        text.append("\r\n")
    }
    var i: size_t 0
    while i < fields.count()
    {
        let name fields.name(i)
        if name.length > 0 and name[0] <> 58 and name.equals("host") = false and name.equals("content-length") = false and name.equals("transfer-encoding") = false and name.equals("connection") = false
        {
            text.append(name)
            text.append(": ")
            text.append(fields.value(i))
            text.append("\r\n")
        }
        set i: i + 1
    }
    if has_body = false
        text.append("\r\n")
    true
}

; A request without a body straight from its decoded fields: method,
; target, path and query as views into them, and the fields themselves as
; req.list, which Request.header reads -- what parse_request makes of the
; text fields_request_text writes, without the text and the parse (they
; were a tenth of the server's samples in baseline-h2; writing the fields
; out as text for handlers that mostly read none, another 3 %;
; 2026-09-30). False where fields_request_text is: no :method or :path (a
; byte the text cannot carry the decoder refused already,
; HeaderList.literal); and for a method or target with a space, or a head
; larger than parse_request takes.
procedure request_from_fields(fields: ref[HeaderList], mutable req: ref[Request]) returns bool
{
    var method: Slice[u8] ""
    var target: Slice[u8] ""
    var head: size_t 0
    var i: size_t 0
    while i < fields.count()
    {
        let name fields.name(i)
        let value fields.value(i)
        if name.length = 0
            return false
        let kind pseudo_field(name)
        if kind = 1
            set method: value
        else if kind = 2
            set target: value
        set head: head + name.length + value.length + 4
        set i: i + 1
    }
    if method.length = 0 or target.length = 0 or head > MAX_HEAD
        return false
    var k: size_t 0
    while k < method.length
    {
        if method[k] = 32
            return false
        set k: k + 1
    }
    ; one pass over the target: no space, and where the query begins
    var q target.length
    set k: 0
    while k < target.length
    {
        let c target[k]
        if c = 32
            return false
        if c = 63 and q = target.length
            set q: k
        set k: k + 1
    }
    set req.method: method
    set req.target: target
    set req.path: target.slice_to(q)
    if q < target.length
        set req.query: target.slice_from(q + 1)
    else
        set req.query: target.slice_from(q)
    set req.fields: target.slice_to(0)
    set req.list: fields
    set req.body: target.slice_to(0)
    set req.minor: 1
    set req.keep_alive: true
    true
}

; The status of HTTP/1.1 response text ("HTTP/1.1 200 ..."), 0 when there
; is none.
function response_status(response: Slice[u8]) returns i64
{
    if response.length <= 12
        return 0
    ((response[9] - 48) as i64) * 100 + ((response[10] - 48) as i64) * 10 + ((response[11] - 48) as i64)
}

; Where the field lines of HTTP/1.1 response text begin (after the status
; line).
function response_fields_at(response: Slice[u8]) returns size_t
{
    var at: size_t 0
    while at + 1 < response.length and (response[at] <> 13 or response[at + 1] <> 10)
        set at: at + 1
    at + 2
}

; The next field line of HTTP/1.1 text at `at`: its name lowercased onto
; `name` and its value's span; the position after the line, or 0 at the
; blank line (or the end) that ends the fields.
procedure next_field(lines: Slice[u8], at: size_t, mutable name: ref[ByteBuf], mutable value_start: ref[size_t], mutable value_end: ref[size_t]) returns size_t
{
    if at + 1 >= lines.length or (lines[at] = 13 and lines[at + 1] = 10)
        return 0
    var colon at
    while colon < lines.length and lines[colon] <> 58
        set colon: colon + 1
    var eol colon
    while eol + 1 < lines.length and (lines[eol] <> 13 or lines[eol + 1] <> 10)
        set eol: eol + 1
    if colon >= eol
        return 0
    name.clear()
    var k at
    while k < colon
    {
        var ch lines[k]
        if ch >= 65 and ch <= 90
            set ch: ch + 32
        name.append_byte(ch)
        set k: k + 1
    }
    var vstart colon + 1
    while vstart < eol and lines[vstart] = 32
        set vstart: vstart + 1
    set value_start: vstart
    set value_end: eol
    eol + 2
}

; Is a field one HTTP/2 and HTTP/3 must not carry?
function connection_specific(name: Slice[u8]) returns bool
    name.equals("connection") or name.equals("keep-alive") or name.equals("transfer-encoding")

; A request waiting to be answered: its HTTP/1.1 text on a page of its own,
; and -- when it runs in a task of its own -- its own request, response and
; output buffer there.
define H2Job
(
    id: u64
    page: ref[Page]
    var text: ByteBuf
    router: ref[Router]
    var req: ref[Request]?
    var res: ref[Response]?
    var outb: ref[ByteBuf]?
    var parsed: bool
    ; the request waits (Router.waits) and runs in a task of its own
    var waiting: bool
    ; the waiting jobs still running, the connection's count
    var outstanding: ref[size_t]?
)

; A waiting job's task: parse its request and run its handler; the
; connection turns the response into frames once no job runs any more.
procedure h2_job()
{
    let job Scheduler.task_arg() as ref[H2Job]
    let req job.req as ref[Request]
    let r parse_request(job.text.bytes(), req)
    if r > 0
    {
        set job.parsed: true
        dispatch(job.router, req, job.res as ref[Response])
    }
    let left job.outstanding as ref[size_t]
    set left: left - 1
}

; The method and the path (without its query) of HTTP/1.1 request text.
function request_method(text: Slice[u8]) returns Slice[u8]
{
    var i: size_t 0
    while i < text.length and text[i] <> 32
        set i: i + 1
    text.slice_to(i)
}

function request_path(text: Slice[u8]) returns Slice[u8]
{
    var i: size_t 0
    while i < text.length and text[i] <> 32
        set i: i + 1
    let start i + 1
    var end start
    while end < text.length and text[end] <> 32 and text[end] <> 63
        set end: end + 1
    if start > text.length
        return text.slice_to(0)
    text.subslice(start, end)
}

define H2Conn
(
    host: ref[Page]
    var decoder: HpackDecoder
    var fields: HeaderList
    ; the frames to send, and the HTTP/1.1 request being built
    var frames: ByteBuf
    var text: ByteBuf
    ; a header block that goes on in CONTINUATION frames
    var block: ByteBuf
    var block_stream: u64
    var block_end_stream: bool
    var peer_window: i64
    var peer_max_frame: size_t
    var send_window: i64
    var last_stream: u64
    var streams: Array[ref[H2Stream]]
    var pending: Array[ref[H2Pending]]
    ; the requests complete in the frames of the last read
    var jobs: Array[ref[H2Job]]
    ; how many of them still run in tasks of their own
    var outstanding: size_t
    var closing: bool
)
{
    procedure create(host: ref[Page]) returns ref[H2Conn]
    {
        &H2Conn^host(
            host,
            HpackDecoder.create(host),
            HeaderList.create(host),
            ByteBuf.create(host, 16384),
            ByteBuf.create(host, 1024),
            ByteBuf.create(host, 1024),
            0, false,
            H2_DEFAULT_WINDOW, 16384, H2_DEFAULT_WINDOW, 0,
            Array[ref[H2Stream]]^host(),
            Array[ref[H2Pending]]^host(),
            Array[ref[H2Job]]^host(),
            0,
            false)
    }

    ; Our SETTINGS, and room for the client's bodies on the connection.
    procedure greet(mutable this)
    {
        frame_head(&frames, 18, 4, 0, 0)
        frames.append_byte(0)
        frames.append_byte(3)
        append_u32(&frames, 256)
        frames.append_byte(0)
        frames.append_byte(4)
        append_u32(&frames, H2_OWN_WINDOW as u64)
        frames.append_byte(0)
        frames.append_byte(2)
        append_u32(&frames, 0)
        frame_head(&frames, 4, 8, 0, 0)
        append_u32(&frames, H2_CONN_WINDOW_BOOST as u64)
    }

    ; End the connection with GOAWAY carrying `code`.
    procedure goaway(mutable this, code: u64)
    {
        frame_head(&frames, 8, 7, 0, 0)
        append_u32(&frames, last_stream)
        append_u32(&frames, code)
        set closing: true
    }

    procedure reset_stream(mutable this, stream: u64, code: u64)
    {
        frame_head(&frames, 4, 3, 0, stream)
        append_u32(&frames, code)
    }

    ; Credit n received bytes back to the connection and the stream.
    procedure credit(mutable this, stream: u64, n: size_t)
    {
        if n = 0
            return
        frame_head(&frames, 4, 8, 0, 0)
        append_u32(&frames, n as u64)
        frame_head(&frames, 4, 8, 0, stream)
        append_u32(&frames, n as u64)
    }

    ; The stream whose body is arriving, null when there is none.
    procedure stream_of(this, id: u64) returns ref[H2Stream]?
    {
        var i: size_t 0
        while i < streams.length
        {
            let s streams.at(i)
            if s.id = id
                return s
            set i: i + 1
        }
        null
    }

    procedure drop_stream(mutable this, id: u64)
    {
        var i: size_t 0
        while i < streams.length
        {
            let s streams.at(i)
            if s.id = id
            {
                s.page.deallocate_extensions()
                Page.release_page(s.page)
                streams.put(i, streams.at(streams.length - 1))
                set streams.length: streams.length - 1
                return
            }
            set i: i + 1
        }
    }

    ; The decoded header fields as HTTP/1.1 request text in `text`; false
    ; for a request without :method or :path.
    procedure request_text(mutable this, has_body: bool) returns bool
        fields_request_text(&fields, &text, has_body)

    ; Send as much of pending response p as the windows allow; true when
    ; it is all out.
    procedure push_data(mutable this, mutable p: ref[H2Pending]) returns bool
        this.push_body(p.id, p.body, &p.sent, &p.window, p.end_stream)

    ; Send body on stream from `sent` on, as far as the connection's window
    ; and the stream's (`window`) allow; both move. True when it is all out.
    procedure push_body(mutable this, id: u64, body: Slice[u8], mutable sent: ref[size_t], mutable window: ref[i64], end_stream: bool) returns bool
    {
        while sent < body.length
        {
            var n body.length - sent
            if n > peer_max_frame
                set n: peer_max_frame
            if (n as i64) > send_window
                set n: send_window as size_t
            ; typed: `window as size_t` would cast the reference, an address
            let stream_window: i64 window
            if (n as i64) > stream_window
                set n: stream_window as size_t
            if n = 0
                return false
            var flags: u8 0
            if sent + n = body.length and end_stream
                set flags: 1
            frame_head(&frames, n, 0, flags, id)
            frames.append(body.subslice(sent, sent + n))
            set sent: sent + n
            set send_window: send_window - (n as i64)
            set window: window - (n as i64)
        }
        true
    }

    ; Has the output reached its budget (frames_in then stops taking input)?
    ; A method, so that the generic serve_h2 need not name the constant.
    function over_budget(this) returns bool
        frames.length >= H2_FLUSH_AT

    ; Send what waits for window, in arrival order, as far as it goes.
    procedure push_pending(mutable this)
    {
        var i: size_t 0
        while i < pending.length
        {
            var p pending.at(i)
            if this.push_data(p)
            {
                if p.trailers.length > 0
                    this.headers_frame(p.id, 0, p.trailers, 0, true)
                p.page.deallocate_extensions()
                Page.release_page(p.page)
                var j i
                while j + 1 < pending.length
                {
                    pending.put(j, pending.at(j + 1))
                    set j: j + 1
                }
                set pending.length: pending.length - 1
            }
            else
                set i: i + 1
        }
    }

    ; Header lines "Name: value\r\n" of `lines` from `at` HPACK-encoded onto
    ; frames (names lowercased, connection-specific fields left out), up to
    ; a blank line or the end; answers where the lines end (past the blank
    ; line).
    procedure encode_lines(mutable this, lines: Slice[u8], from: size_t) returns size_t
    {
        var at from
        while at + 1 < lines.length
        {
            if lines[at] = 13 and lines[at + 1] = 10
                return at + 2
            var colon at
            while colon < lines.length and lines[colon] <> 58
                set colon: colon + 1
            var eol colon
            while eol + 1 < lines.length and (lines[eol] <> 13 or lines[eol + 1] <> 10)
                set eol: eol + 1
            if colon >= eol
                return lines.length
            let name_raw lines.subslice(at, colon)
            var vstart colon + 1
            while vstart < eol and lines[vstart] = 32
                set vstart: vstart + 1
            let value lines.subslice(vstart, eol)
            text.clear()
            var k: size_t 0
            while k < name_raw.length
            {
                var ch name_raw[k]
                if ch >= 65 and ch <= 90
                    set ch: ch + 32
                text.append_byte(ch)
                set k: k + 1
            }
            let name text.bytes()
            if name.equals("connection") = false and name.equals("keep-alive") = false and name.equals("transfer-encoding") = false
                encode_field(&frames, name, value)
            set at: eol + 2
        }
        lines.length
    }

    ; A HEADERS frame on `stream` whose block encode_lines writes from
    ; `lines`, after a :status when status is not 0.
    procedure headers_frame(mutable this, stream: u64, status: i64, lines: Slice[u8], from: size_t, end_stream: bool) returns size_t
    {
        let head_at frames.length
        frames.reserve(H2_FRAME_HEAD)
        set frames.length: frames.length + H2_FRAME_HEAD
        if status <> 0
            encode_status(&frames, status)
        let after this.encode_lines(lines, from)
        let block_length frames.length - head_at - H2_FRAME_HEAD
        if block_length <= peer_max_frame
        {
            var flags: u8 4
            if end_stream
                set flags: 5
            let save frames.length
            set frames.length: head_at
            frame_head(&frames, block_length, 1, flags, stream)
            set frames.length: save
            return after
        }
        ; larger than a frame: HEADERS, then CONTINUATION frames, the last
        ; with END_HEADERS (the block goes through `block`, free by now --
        ; an incoming block is decoded before its request is answered)
        block.clear()
        block.append(frames.bytes().subslice(head_at + H2_FRAME_HEAD, head_at + H2_FRAME_HEAD + block_length))
        set frames.length: head_at
        var off: size_t 0
        while off < block_length
        {
            var n block_length - off
            if n > peer_max_frame
                set n: peer_max_frame
            var kind: u8 9
            var flags: u8 0
            if off = 0
            {
                set kind: 1
                if end_stream
                    set flags: 1
            }
            if off + n = block_length
                set flags: flags | 4
            frame_head(&frames, n, kind, flags, stream)
            frames.append(block.bytes().subslice(off, off + n))
            set off: off + n
        }
        after
    }

    ; An HPACK-coded header block as a HEADERS frame on `stream`, and
    ; CONTINUATION frames when it is larger than the peer's frame limit.
    procedure block_frames(mutable this, stream: u64, block: Slice[u8], end_stream: bool)
    {
        var off: size_t 0
        repeat
        {
            var n block.length - off
            if n > peer_max_frame
                set n: peer_max_frame
            var kind: u8 9
            var flags: u8 0
            if off = 0
            {
                set kind: 1
                if end_stream
                    set flags: 1
            }
            if off + n = block.length
                set flags: flags | 4
            frame_head(&frames, n, kind, flags, stream)
            frames.append(block.subslice(off, off + n))
            set off: off + n
            if off >= block.length
                break
        }
    }

    ; The response res wrote into `out` (in HPACK mode: its header block,
    ; then its body) as frames on `stream`, then its trailer lines when there
    ; are any.
    procedure respond(mutable this, stream: u64, mutable res: ref[Response], mutable out: Slice[u8])
    {
        var block_at res.block_at
        var body_at res.body_at
        if body_at > out.length
            set body_at: out.length
        if block_at > body_at
            set block_at: body_at
        let trailers res.trailers.bytes()
        let has_trailers trailers.length > 0
        let body out.slice_from(body_at)
        let bodiless body.length = 0 and has_trailers = false
        this.block_frames(stream, out.subslice(block_at, body_at), bodiless)
        if bodiless
            return
        ; most responses fit the windows and go from where they stand; a page
        ; only for one whose rest waits (a page taken and given back for
        ; every response was 1 % of the server's samples in baseline-h2,
        ; 2026-09-30)
        var sent: size_t 0
        var window: i64 peer_window
        if this.push_body(stream, body, &sent, &window, has_trailers = false)
        {
            if has_trailers
                this.headers_frame(stream, 0, trailers, 0, true)
            return
        }
        ; the rest waits: its own copy of the body and the trailers, since
        ; the output buffer and the trailers are reused
        let page Page.allocate_page()
        let rest allocate_slice[u8]^page(page, body.length)
        memcpy(rest.data as pointer[void], body.data as pointer[void], body.length)
        let kept allocate_slice[u8]^page(page, trailers.length)
        if trailers.length > 0
            memcpy(kept.data as pointer[void], trailers.data as pointer[void], trailers.length)
        var q &H2Pending^page(stream, page, rest, sent, window, has_trailers = false, kept)
        pending.add(q)
    }

    ; Answer the request in `text` on `stream` -- at once, unless its route
    ; waits (Router.waits): that one is queued for run_jobs.
    procedure answer(mutable this, stream: u64, router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf])
    {
        let request text.bytes()
        if router.route_waits(request_method(request), request_path(request)) = false
        {
            let r parse_request(request, req)
            if r <= 0
            {
                this.reset_stream(stream, 1)
                return
            }
            outb.clear()
            dispatch(router, req, res)
            this.respond(stream, res, outb.bytes())
            outb.clear()
            return
        }
        let page Page.allocate_page()
        var t ByteBuf.create(page, text.length + 64)
        t.append(text.bytes())
        let job &H2Job^page(stream, page, t, router, null, null, null, false, false, null)
        jobs.add(job)
    }

    ; Answer the request without a body in `fields` on `stream`: at once,
    ; from the fields (request_from_fields), unless its route waits -- that
    ; one takes answer's way, as text for a task of its own.
    procedure answer_fields(mutable this, stream: u64, router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf])
    {
        if request_from_fields(&fields, req) = false
        {
            this.reset_stream(stream, 1)
            return
        }
        if router.route_waits(req.method, req.path)
        {
            if this.request_text(false) = false
            {
                this.reset_stream(stream, 1)
                return
            }
            this.answer(stream, router, req, res, outb)
            return
        }
        outb.clear()
        dispatch(router, req, res)
        this.respond(stream, res, outb.bytes())
        outb.clear()
    }

    ; Answer the queued requests -- those whose route waits: each starts in
    ; a task of its own, the connection waits for them -- a millisecond at a
    ; time, so that the poller runs -- and answers them in the order they
    ; were queued.
    procedure run_jobs(mutable this, router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf])
    {
        if jobs.length = 0
            return
        var i: size_t 0
        while i < jobs.length
        {
            ; typed: the job itself -- `as pointer[void]` on the element
            ; reference would hand over the array slot's address
            var job: ref[H2Job] jobs.at(i)
            let page job.page
            let own_out &ByteBuf^page(page, allocate_slice[u8]^page(page, 4096), 0, false)
            set job.outb: own_out
            set job.req: &Request^page(null, null, null, null, null, null, 1, true, null, null)
            let jres Response.create(page, own_out)
            set jres.hpack: true
            set job.res: jres
            set job.waiting: true
            set job.outstanding: &outstanding
            set outstanding: outstanding + 1
            Scheduler.spawn_detached(&h2_job, job as pointer[void])
            set i: i + 1
        }
        while outstanding > 0
            Scheduler.sleep(1)
        set i: 0
        while i < jobs.length
        {
            let job jobs.at(i)
            if job.waiting
            {
                if job.parsed
                {
                    let jres job.res as ref[Response]
                    let jout job.outb as ref[ByteBuf]
                    this.respond(job.id, jres, jout.bytes())
                }
                else
                    this.reset_stream(job.id, 1)
            }
            set i: i + 1
        }
        var k: size_t 0
        while k < jobs.length
        {
            let job jobs.at(k)
            job.page.deallocate_extensions()
            Page.release_page(job.page)
            set k: k + 1
        }
        jobs.clear()
    }

    ; A complete header block for `stream`: a request to answer now (no
    ; body) or a stream whose body follows. False on a compression error.
    procedure headers_done(mutable this, stream: u64, block_bytes: Slice[u8], end_stream: bool, router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf]) returns bool
    {
        fields.clear()
        if decoder.decode(block_bytes, &fields) = false
            return false
        if stream > last_stream
            set last_stream: stream
        if end_stream
        {
            this.answer_fields(stream, router, req, res, outb)
            return true
        }
        if this.request_text(true) = false
        {
            this.reset_stream(stream, 1)
            return true
        }
        ; the body follows in DATA frames: keep the head on a page of its own
        let page Page.allocate_page()
        var t ByteBuf.create(page, text.length + 1024)
        t.append(text.bytes())
        let s &H2Stream^page(stream, page, t, t.length)
        streams.add(s)
        true
    }

    ; A stream's body is complete: its request text gets its length and body.
    procedure body_done(mutable this, mutable s: ref[H2Stream], router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf])
    {
        let all s.text.bytes()
        let body all.slice_from(s.body_at)
        text.clear()
        text.append(all.slice_to(s.body_at))
        text.append("content-length: ")
        text.append_uint(body.length as u64)
        text.append("\r\n\r\n")
        text.append(body)
        let id s.id
        this.drop_stream(id)
        this.answer(id, router, req, res, outb)
    }

    ; Handle every complete frame at the front of inb; answers how many
    ; bytes it took. Sets closing on a connection error or GOAWAY.
    procedure frames_in(mutable this, input: Slice[u8], router: ref[Router], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf]) returns size_t
    {
        var at: size_t 0
        while closing = false and frames.length < H2_FLUSH_AT and at + H2_FRAME_HEAD <= input.length
        {
            let length be24(input, at)
            if length > H2_MAX_FRAME
            {
                this.goaway(6)
                return at
            }
            if at + H2_FRAME_HEAD + length > input.length
                return at
            let kind input[at + 3]
            let flags input[at + 4]
            let stream be31(input, at + 5)
            var payload input.subslice(at + H2_FRAME_HEAD, at + H2_FRAME_HEAD + length)
            set at: at + H2_FRAME_HEAD + length
            if block_stream <> 0 and (kind <> 9 or stream <> block_stream)
            {
                this.goaway(1)
                return at
            }
            ; PADDED: the pad length first, the padding last
            if (kind = 0 or kind = 1) and (flags & 8) <> 0
            {
                if payload.length = 0 or (payload[0] as size_t) >= payload.length
                {
                    this.goaway(1)
                    return at
                }
                set payload: payload.subslice(1, payload.length - (payload[0] as size_t))
            }
            match kind
                case 0:
                {
                    let s this.stream_of(stream)
                    this.credit(stream, length)
                    if s <> null
                    {
                        var st s as ref[H2Stream]
                        st.text.append(payload)
                        if (flags & 1) <> 0
                            this.body_done(st, router, req, res, outb)
                    }
                }
                case 1:
                {
                    if stream = 0 or (stream & 1) = 0
                    {
                        this.goaway(1)
                        return at
                    }
                    var block payload
                    if (flags & 32) <> 0
                    {
                        if block.length < 5
                        {
                            this.goaway(1)
                            return at
                        }
                        set block: block.slice_from(5)
                    }
                    if (flags & 4) <> 0
                    {
                        if this.headers_done(stream, block, (flags & 1) <> 0, router, req, res, outb) = false
                        {
                            this.goaway(9)
                            return at
                        }
                    }
                    else
                    {
                        self_block_start(&this.block, block)
                        set block_stream: stream
                        set block_end_stream: (flags & 1) <> 0
                    }
                }
                case 9:
                {
                    this.block.append(payload)
                    if (flags & 4) <> 0
                    {
                        let id block_stream
                        set block_stream: 0
                        if this.headers_done(id, this.block.bytes(), block_end_stream, router, req, res, outb) = false
                        {
                            this.goaway(9)
                            return at
                        }
                    }
                }
                case 3:
                    this.drop_stream(stream)
                case 4:
                {
                    if (flags & 1) = 0
                    {
                        if stream <> 0 or length % 6 <> 0
                        {
                            this.goaway(1)
                            return at
                        }
                        var k: size_t 0
                        while k < length
                        {
                            let id ((payload[k] as u64) << 8) | (payload[k + 1] as u64)
                            let value be31(payload, k + 2) | (((payload[k + 2] as u64) & 128) << 24)
                            if id = 4
                            {
                                if value > 2147483647
                                {
                                    this.goaway(3)
                                    return at
                                }
                                let delta (value as i64) - peer_window
                                set peer_window: value as i64
                                var i: size_t 0
                                while i < pending.length
                                {
                                    var p pending.at(i)
                                    set p.window: p.window + delta
                                    set i: i + 1
                                }
                            }
                            if id = 5
                            {
                                if value < 16384 or value > 16777215
                                {
                                    this.goaway(1)
                                    return at
                                }
                                set peer_max_frame: value as size_t
                            }
                            set k: k + 6
                        }
                        frame_head(&frames, 0, 4, 1, 0)
                        this.push_pending()
                    }
                }
                case 6:
                {
                    if (flags & 1) = 0
                    {
                        frame_head(&frames, 8, 6, 1, 0)
                        frames.append(payload)
                    }
                }
                case 7:
                    set closing: true
                case 8:
                {
                    if length <> 4
                    {
                        this.goaway(6)
                        return at
                    }
                    let increment be31(payload, 0) as i64
                    if stream = 0
                        set send_window: send_window + increment
                    else
                    {
                        var i: size_t 0
                        while i < pending.length
                        {
                            var p pending.at(i)
                            if p.id = stream
                                set p.window: p.window + increment
                            set i: i + 1
                        }
                    }
                    this.push_pending()
                }
        }
        at
    }
}

; Start a header block that continues: its first fragment.
procedure self_block_start(mutable block: ref[ByteBuf], fragment: Slice[u8])
{
    block.clear()
    block.append(fragment)
}

; Serve one HTTP/2 connection whose input so far is in inb (it begins with
; the preface, or with as much of it as arrived), with the connection's
; request, response and output buffer.
procedure serve_h2[S](mutable c: ref[S], router: ref[Router], host: ref[Page], mutable inb: ref[ByteBuf], mutable req: ref[Request], mutable res: ref[Response], mutable outb: ref[ByteBuf])
{
    var h H2Conn.create(host)
    set res.hpack: true
    h.greet()
    var preface_done false
    repeat
    {
        if preface_done = false and inb.length >= 24
        {
            if inb.bytes().slice_to(24).equals(h2_preface()) = false
                break
            inb.consume(24)
            set preface_done: true
        }
        ; the frames that arrived, a round at a time while frames_in stops at
        ; the output budget: each round's output is written before the next
        ; round is made, without reading in between
        var failed false
        repeat
        {
            if preface_done
            {
                let used h.frames_in(inb.bytes(), router, req, res, outb)
                inb.consume(used)
                h.run_jobs(router, req, res, outb)
            }
            if preface_done = false or h.over_budget() = false or h.closing
                break
            if c.write(h.frames.bytes()) = false
            {
                set failed: true
                break
            }
            h.frames.clear()
        }
        if failed
            break
        if h.frames.length > 0
        {
            if c.write(h.frames.bytes()) = false
                break
            h.frames.clear()
        }
        if h.closing
            break
        if inb.length = inb.capacity()
            inb.reserve(inb.capacity())
        let n c.read(inb.spare())
        if n <= 0
            break
        inb.advance(n as size_t)
        res.tick()
        if TcpServer.current().stopping()
        {
            h.goaway(0)
            if c.write(h.frames.bytes())
                h.frames.clear()
            break
        }
    }
    var i: size_t 0
    while i < h.streams.length
    {
        let s h.streams.at(i)
        s.page.deallocate_extensions()
        Page.release_page(s.page)
        set i: i + 1
    }
    set i: 0
    while i < h.pending.length
    {
        let p h.pending.at(i)
        p.page.deallocate_extensions()
        Page.release_page(p.page)
        set i: i + 1
    }
}
