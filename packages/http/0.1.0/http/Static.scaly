; Static files (ROADMAP-http.md, stage D): the file a route names under a
; directory, with its media type from the extension and, when the client
; accepts a content coding, the pre-compressed twin that sits beside it on
; disk (`app.js.br`, `app.js.gz`) — chosen by the q-values of
; Accept-Encoding, brotli first on a tie. Nothing is compressed here.
;
;   procedure asset(req: ref[Request], mutable res: ref[Response])
;       serve_file(req, res, "/data/static", req.param("path"))
;   app.get("/static/{path...}", &asset)
;
; Contents are cached per scheduler thread (a request's task never leaves
; its thread, so the cache needs no lock) and FOLLOW THE DISK: every request
; asks what the file is now (a stat: size, mtime, inode) and an entry that
; no longer matches is read again before it is served, on a page of its own
; that replaces the old one -- a file replaced on disk is served with its new
; bytes on the very next request, and a file removed answers 404. Until
; 2026-09-30 an entry was read again once it was a second old: HttpArena's
; rule is "replace a file and the next response must carry the new bytes",
; and its validation's 2 s window is a tolerance, not a budget. A path that
; climbs out of the directory ("..") or starts with '/' answers 404 as well.

use http.Request.Request
use http.Response.Response

; What a file is on disk (scaly/fiber/eio.c): out[0] size, out[1] mtime in
; nanoseconds, out[2] inode, out[3] block size; -1 when there is no file.
procedure scaly_eio_stat(path: pointer[const_char], fd: i32, mutable out: pointer[i64]) returns i32 extern
; The wall clock a file's mtime is taken from, in nanoseconds (eio.c).
procedure scaly_eio_wall_ns() returns i64 extern
; A file written this recently may be written AGAIN with the same stamp: a
; file system stamps a write with a clock that ticks (15.6 ms on Windows, a
; few on Linux), and a second write of the same size inside one tick changes
; neither size nor mtime. git calls such an entry racy and does not trust it;
; neither does load_entry#. Found 2026-10-02 on Windows, where a file replaced
; right after its first read was served stale now and then.
define STATIC_RACY_NS: i64 100000000

define StaticEntry
(
    ; the file on disk, on the cache's page
    path: String
    ; the contents, on `page`, which a reload replaces
    var page: ref[Page]
    var content: String
    var present: bool
    ; monotonic time of the last read, 0 before the first
    var loaded_at: i64
    ; what the file was when it was read (size, mtime, inode; -1 absent)
    var size: i64
    var mtime: i64
    var inode: i64
    var loading: bool
    ; whether `page` is the entry's own (false while it is the cache's)
    var owns_page: bool
)

define StaticCache
(
    host: ref[Page]
    var entries: Array[ref[StaticEntry]]
)

; This thread's cache, made at its first request.
mutable static_cache: ref[StaticCache]? null

; The media type for a file name's extension; application/octet-stream
; for one this table does not know.
function media_type(name: Slice[u8]) returns Slice[u8]
{
    var dot name.length
    while dot > 0 and name[dot - 1] <> 46 and name[dot - 1] <> 47
        dot := dot - 1
    if dot = 0 or name[dot - 1] <> 46
        return "application/octet-stream"
    let ext name.slice_from(dot)
    if ext.equals("html") or ext.equals("htm")
        return "text/html"
    if ext.equals("css")
        return "text/css"
    if ext.equals("js") or ext.equals("mjs")
        return "application/javascript"
    if ext.equals("json")
        return "application/json"
    if ext.equals("svg")
        return "image/svg+xml"
    if ext.equals("webp")
        return "image/webp"
    if ext.equals("png")
        return "image/png"
    if ext.equals("jpg") or ext.equals("jpeg")
        return "image/jpeg"
    if ext.equals("gif")
        return "image/gif"
    if ext.equals("ico")
        return "image/x-icon"
    if ext.equals("woff2")
        return "font/woff2"
    if ext.equals("woff")
        return "font/woff"
    if ext.equals("txt")
        return "text/plain"
    if ext.equals("xml")
        return "application/xml"
    if ext.equals("wasm")
        return "application/wasm"
    if ext.equals("pdf")
        return "application/pdf"
    "application/octet-stream"
}

; Is rel a path this handler may open: not empty, not absolute, no ".."
; segment?
function safe_relative(rel: Slice[u8]) returns bool
{
    if rel.length = 0 or rel[0] = 47
        return false
    var start: size_t 0
    var i: size_t 0
    while i <= rel.length
    {
        if i = rel.length or rel[i] = 47
        {
            let seg rel.subslice(start, i)
            if seg.equals("..")
                return false
            start := i + 1
        }
        i := i + 1
    }
    true
}

; The q-value (in thousandths) Accept-Encoding gives coding `name`: an
; explicit entry, else a `*` entry, else 0.
function coding_quality(accept: Slice[u8], name: Slice[u8]) returns i64
{
    var star: i64 0 - 1
    var at: size_t 0
    while at < accept.length
    {
        var end at
        while end < accept.length and accept[end] <> 44
            end := end + 1
        let item trim(accept.subslice(at, end))
        var semi: size_t 0
        while semi < item.length and item[semi] <> 59
            semi := semi + 1
        let coding trim(item.slice_to(semi))
        var q: i64 1000
        var p semi
        while p < item.length
        {
            if item[p] = 113 and p + 1 < item.length and item[p + 1] = 61
            {
                q := quality_value(item.slice_from(p + 2))
                break
            }
            p := p + 1
        }
        if coding.equals(name)
            return q
        if coding.equals("*")
            star := q
        at := end + 1
    }
    if star < 0
        return 0
    star
}

; "1", "0.8", "0.125" as thousandths.
function quality_value(s: Slice[u8]) returns i64
{
    if s.length = 0
        return 1000
    if s[0] = 49
        return 1000
    if s[0] <> 48
        return 0
    var v: i64 0
    var scale: i64 100
    var i: size_t 2
    while i < s.length and scale > 0 and s[i] >= 48 and s[i] <= 57
    {
        v := v + ((s[i] - 48) as i64) * scale
        scale := scale / 10
        i := i + 1
    }
    v
}

; This thread's cache.
procedure static_cache_here() returns ref[StaticCache] mutable static_cache
{
    let existing static_cache
    if existing <> null
        return existing as ref[StaticCache]
    let host Page.allocate_page()
    let made &StaticCache^host(host, Array[ref[StaticEntry]]^host())
    static_cache := made
    made
}

; The cache entry of the file at path, read (again) when it is new or the
; file on disk is no longer what was read; while one task reads it the
; others serve what is there, or wait for a first read.
procedure static_entry(path: Slice[u8]) returns ref[StaticEntry] mutable static_cache
{
    let cache static_cache_here()
    var found: ref[StaticEntry]? null
    var i: size_t 0
    while i < cache.entries.length
    {
        let e cache.entries.at(i)
        if e.path.as_slice().equals(path)
        {
            found := e
            break
        }
        i := i + 1
    }
    if found = null
    {
        let host cache.host
        let made &StaticEntry^host(String^host(path.data as pointer[const_char], path.length), host, String^host(), false, 0, 0 - 1, 0, 0, false, false)
        cache.entries.add(made)
        found := made
    }
    var e found as ref[StaticEntry]
    ; the path's String was written by a content init, which ends it with a
    ; NUL (what to_c_string relies on too): no copy per request
    var st i64[4]
    var size: i64 0 - 1
    var mtime: i64 0
    var inode: i64 0
    if scaly_eio_stat(e.path.c_data(), 0 - 1, &st[0]) = 0
    {
        size := st[0]
        mtime := st[1]
        inode := st[2]
    }
    if e.loading = false and (e.loaded_at = 0 or size <> e.size or mtime <> e.mtime or inode <> e.inode)
        load_entry(e, size, mtime, inode)
    while e.loaded_at = 0
        Scheduler.yield()
    e
}

; Read the entry's file onto a fresh page and put it in place of the old
; one, with what the file was just before (a change after the stat shows on
; the next request); a file that is not there reads as absent.
procedure load_entry(mutable e: ref[StaticEntry], size: i64, mtime: i64, inode: i64)
{
    e.loading := true
    let fresh Page.allocate_page()
    var p String^fresh(e.path)
    let present File.exists(p)
    var content String^fresh()
    if present
        content := File.read_to_string^fresh(p)
    let old e.page
    let had_own e.owns_page
    e.page := fresh
    e.owns_page := true
    e.content := content
    e.present := present
    e.size := size
    ; a racy file (STATIC_RACY_NS) keeps a stamp no file has, so the next
    ; request reads it again -- until it has been quiet for that long
    var kept mtime
    if size >= 0 and scaly_eio_wall_ns() - mtime < STATIC_RACY_NS
        kept := 0 - 1
    e.mtime := kept
    e.inode := inode
    e.loaded_at := scaly_eio_now_ns()
    e.loading := false
    ; with what grew from it: the content read onto it is an oversized block
    ; of its own, which release_page alone kept (2026-09-30)
    if had_own
    {
        old.deallocate_extensions()
        Page.release_page(old)
    }
}

; Serve the file rel under root (see the module header): 200 with the file
; or a pre-compressed twin, 404 when there is none.
procedure serve_file(req: ref[Request], mutable res: ref[Response], root: Slice[u8], rel: Slice[u8]) mutable static_cache
{
    if safe_relative(rel) = false
    {
        res.set_status(404)
        res.send_empty()
        return
    }
    var path Array[u8]()
    path.add(root)
    if root.length > 0 and root[root.length - 1] <> 47
        path.add(47 as u8)
    path.add(rel)
    let base path.length
    let accept req.header("accept-encoding")
    let q_br coding_quality(accept, "br")
    let q_gzip coding_quality(accept, "gzip")
    ; the codings worth trying, best first, then the file itself
    var first: Slice[u8] ""
    var second: Slice[u8] ""
    if q_br > 0 and q_br >= q_gzip
    {
        first := "br"
        if q_gzip > 0
            second := "gzip"
    }
    else if q_gzip > 0
    {
        first := "gzip"
        if q_br > 0
            second := "br"
    }
    let media media_type(rel)
    if first.length > 0 and try_variant(res, &path, base, first, media)
        return
    if second.length > 0 and try_variant(res, &path, base, second, media)
        return
    path.length := base
    let e static_entry(path.as_slice())
    if e.present = false
    {
        res.set_status(404)
        res.send_empty()
        return
    }
    ; the status line goes out with the first header, so the 404 above
    ; must come before this one
    res.header("Vary", "Accept-Encoding")
    res.send(media, e.content.as_slice())
}

; Send the twin of the file at path[0, base) in `coding` if it exists.
procedure try_variant(mutable res: ref[Response], mutable path: ref[Array[u8]], base: size_t, coding: Slice[u8], media: Slice[u8]) returns bool mutable static_cache
{
    path.length := base
    var suffix: Slice[u8] ".gz"
    if coding.equals("br")
        suffix := ".br"
    path.add(suffix)
    let e static_entry(path.as_slice())
    if e.present = false
        return false
    res.header("Vary", "Accept-Encoding")
    res.send_encoded(media, coding, e.content.as_slice())
    true
}
