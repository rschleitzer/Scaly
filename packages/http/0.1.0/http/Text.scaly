; Byte-level helpers over Slice[u8] for the HTTP grammar: lines, tokens,
; ASCII case folding, numbers. Every name given as a literal is lower case.

; The end of the line starting at i: the offset of its LF, or of the CR
; before it, or buf.length when the line has no terminator.
function line_end(buf: Slice[u8], i: size_t) returns size_t
{
    var j i
    while j < buf.length and buf[j] <> 10
        set j: j + 1
    if j > i and j <= buf.length and buf[j - 1] = 13
    {
        if j < buf.length
            return j - 1
    }
    j
}

; line_end, or -1 when the line's LF has not arrived yet.
function line_end_or_none(buf: Slice[u8], i: size_t) returns i64
{
    var j i
    while j < buf.length and buf[j] <> 10
        set j: j + 1
    if j >= buf.length
        return 0 - 1
    if j > i and buf[j - 1] = 13
        return (j - 1) as i64
    j as i64
}

; The start of the next line, given a line_end.
function next_line(buf: Slice[u8], e: size_t) returns size_t
{
    if e < buf.length and buf[e] = 13
        return e + 2
    e + 1
}

; memchr(3): the byte scan every line of a request goes through (libc's is
; vectorised; a Scaly loop over s[i] checks bounds at every byte).
function memchr(s: pointer[void], c: i32, n: size_t) returns pointer[void] extern

; The offset of the first byte b in s at or after from, -1 when there is none.
function find_byte(s: Slice[u8], from: size_t, b: u8) returns i64
{
    if from >= s.length
        return 0 - 1
    let hit memchr(s.slice_from(from).data as pointer[void], b as i32, s.length - from)
    if hit = null
        return 0 - 1
    ((hit as size_t) - (s.data as size_t)) as i64
}

; The first offset of byte b, -1 when there is none.
function index_of(s: Slice[u8], b: u8) returns i64
    find_byte(s, 0, b)

function lower(b: u8) returns u8
{
    if b >= 65 and b <= 90
        return b + 32
    b
}

function is_space(b: u8) returns bool
    b = 32 or b = 9

function has_space(s: Slice[u8]) returns bool
{
    var i: size_t 0
    while i < s.length
    {
        if is_space(s[i])
            return true
        set i: i + 1
    }
    false
}

; s without leading and trailing spaces and tabs.
function trim(s: Slice[u8]) returns Slice[u8]
{
    var a: size_t 0
    var b s.length
    while a < b and is_space(s[a])
        set a: a + 1
    while b > a and is_space(s[b - 1])
        set b: b - 1
    s.subslice(a, b)
}

; s equals the lower-case lit, ignoring ASCII case in s.
function equals_lower(s: Slice[u8], lit: Slice[u8]) returns bool
{
    if s.length <> lit.length
        return false
    var i: size_t 0
    while i < s.length
    {
        if lower(s[i]) <> lit[i]
            return false
        set i: i + 1
    }
    true
}

; s ends with the lower-case lit as its last comma-separated token.
function ends_with_lower(s: Slice[u8], lit: Slice[u8]) returns bool
{
    let t trim(s)
    if t.length < lit.length
        return false
    let tail t.slice_from(t.length - lit.length)
    if equals_lower(tail, lit) = false
        return false
    if t.length = lit.length
        return true
    let before t[t.length - lit.length - 1]
    before = 44 or is_space(before)
}

; One of the comma-separated tokens of s is the lower-case lit.
function contains_token_lower(s: Slice[u8], lit: Slice[u8]) returns bool
{
    var i: size_t 0
    while i <= s.length
    {
        var e i
        while e < s.length and s[e] <> 44
            set e: e + 1
        if equals_lower(trim(s.subslice(i, e)), lit)
            return true
        set i: e + 1
    }
    false
}

; The weight an Accept-Encoding value gives the lower-case coding, in
; thousandths (`gzip;q=0.5` -> 500, a bare `gzip` -> 1000), or -1 when the
; value does not name it. The q-value grammar of RFC 9110 12.4.2: a 0 or 1,
; up to three decimals.
function coding_quality(value: Slice[u8], coding: Slice[u8]) returns int
{
    var i: size_t 0
    while i <= value.length
    {
        var e i
        while e < value.length and value[e] <> 44          ; ','
            set e: e + 1
        let element value.subslice(i, e)
        var semi: size_t 0
        while semi < element.length and element[semi] <> 59  ; ';'
            set semi: semi + 1
        if equals_lower(trim(element.slice_to(semi)), coding)
            return quality_of(element.slice_from(semi))
        set i: e + 1
    }
    0 - 1
}

; The q parameter among `;name=value` parameters, in thousandths; 1000 when
; there is none.
function quality_of(params: Slice[u8]) returns int
{
    var i: size_t 0
    while i < params.length
    {
        ; one parameter: from after a ';' to the next
        var e i + 1
        while e < params.length and params[e] <> 59
            set e: e + 1
        let p trim(params.subslice(i + 1, e))
        if p.length >= 2 and lower(p[0]) = 113 and p[1] = 61      ; 'q='
        {
            let v trim(p.slice_from(2))
            if v.length = 0
                return 1000
            if v[0] = 49                                        ; '1'
                return 1000
            var q 0
            var scale 100
            var k: size_t 2
            while k < v.length and scale > 0 and v[k] >= 48 and v[k] <= 57
            {
                set q: q + ((v[k] - 48) as int) * scale
                set scale: scale / 10
                set k: k + 1
            }
            return q
        }
        set i: e
    }
    1000
}

function hex_value(c: u8) returns int
{
    if c >= 48 and c <= 57
        return (c - 48) as int
    if c >= 97 and c <= 102
        return (c - 87) as int
    if c >= 65 and c <= 70
        return (c - 55) as int
    0 - 1
}

; s with its %XX escapes decoded, and '+' as a space when plus_is_space (a
; query value, application/x-www-form-urlencoded); a malformed escape stays
; as it is.
function percent_decode(s: Slice[u8], plus_is_space: bool) returns String
{
    var n: size_t 0
    var i: size_t 0
    while i < s.length
    {
        if s[i] = 37 and i + 2 < s.length and hex_value(s[i + 1]) >= 0 and hex_value(s[i + 2]) >= 0
            set i: i + 3
        else
            set i: i + 1
        set n: n + 1
    }
    var out String(n)
    let d out.get_buffer()
    set i: 0
    var k: size_t 0
    while i < s.length
    {
        var c s[i]
        if c = 37 and i + 2 < s.length and hex_value(s[i + 1]) >= 0 and hex_value(s[i + 2]) >= 0
        {
            set c: ((hex_value(s[i + 1]) * 16 + hex_value(s[i + 2])) as u8)
            set i: i + 3
        }
        else
        {
            if c = 43 and plus_is_space
                set c: 32
            set i: i + 1
        }
        set *(d + k): c
        set k: k + 1
    }
    out
}

; A non-negative decimal number filling all of s; -1 when s is empty, has
; any other byte, or overflows.
function parse_decimal(s: Slice[u8]) returns i64
{
    if s.length = 0 or s.length > 18
        return 0 - 1
    var v: i64 0
    var i: size_t 0
    while i < s.length
    {
        let c s[i]
        if c < 48 or c > 57
            return 0 - 1
        set v: v * 10 + ((c - 48) as i64)
        set i: i + 1
    }
    v
}

; A decimal number with an optional sign at the start of s, reading up to
; the first non-digit; 0 when there are no digits.
function parse_int_prefix(s: Slice[u8]) returns i64
{
    var i: size_t 0
    var neg false
    if s.length > 0 and s[0] = 45
    {
        set neg: true
        set i: 1
    }
    var v: i64 0
    while i < s.length and s[i] >= 48 and s[i] <= 57
    {
        set v: v * 10 + ((s[i] - 48) as i64)
        set i: i + 1
    }
    if neg
        return 0 - v
    v
}

; The chunk size at the start of a chunk-size line (hex digits, then
; optional extensions after ';' or whitespace); -1 when there are no hex
; digits, the size overflows, or something else follows the digits.
function parse_hex_prefix(s: Slice[u8]) returns i64
{
    var v: i64 0
    var i: size_t 0
    while i < s.length
    {
        let c s[i]
        var d: i64 0 - 1
        if c >= 48 and c <= 57
            set d: (c - 48) as i64
        if c >= 97 and c <= 102
            set d: (c - 87) as i64
        if c >= 65 and c <= 70
            set d: (c - 55) as i64
        if d < 0
            break
        if i >= 15
            return 0 - 1
        set v: v * 16 + d
        set i: i + 1
    }
    if i = 0
        return 0 - 1
    if i < s.length
    {
        let c s[i]
        if c <> 59 and is_space(c) = false
            return 0 - 1
    }
    v
}
