; HPACK (RFC 7541), the header compression of HTTP/2: a decoder with the
; dynamic table and Huffman-coded strings, and an encoder for responses that
; sends literals without indexing and without Huffman (every decoder must
; take them, and a response's fields change too often to be worth a table).
;
; The dynamic table is a ring of at most DYN_ENTRIES entries whose bytes
; live in one buffer of DYN_BYTES that is compacted in place: a connection
; that sees a new :path on every request keeps a table of fixed size, not a
; page that grows with the requests.

use http.Buffer.ByteBuf

; The table size this decoder allows (SETTINGS_HEADER_TABLE_SIZE, which the
; server leaves at its default), the entries that can fit in it (an entry
; costs its name, its value and 32), and the room for their bytes.
define HPACK_TABLE_SIZE: size_t 4096
define DYN_ENTRIES: size_t 128
define DYN_BYTES: size_t 8192

; A decoded header block: every field's name and value as VIEWS -- into
; `bytes`, where the decoded literals stand, into the static table, or into
; the HPACK decoder's dynamic table (valid until its next insert, before
; which the list owns them: own_table). An indexed field costs no copy;
; copying every one was 8 % of the server's samples in baseline-h2
; (2026-09-30).
define HeaderList
(
    var bytes: ByteBuf
    ; two per field: its name, then its value
    var views: Array[Slice[u8]]
)
{
    procedure create(host: ref[Page]) returns HeaderList
        HeaderList(ByteBuf.create(host, 1024), Array[Slice[u8]]^host())

    procedure clear(mutable this)
    {
        bytes.clear()
        views.clear()
    }

    function count(this) returns size_t
        views.length / 2

    function name(this, i: size_t) returns Slice[u8]
        views[2 * i]

    function value(this, i: size_t) returns Slice[u8]
        views[2 * i + 1]

    ; The value of the first field named `name`, empty without one.
    function get(this, name: Slice[u8]) returns Slice[u8]
    {
        var i: size_t 0
        while i < this.count()
        {
            if this.name(i).equals(name)
                return this.value(i)
            set i: i + 1
        }
        bytes.bytes().slice_to(0)
    }

    ; The value of the first field named lname (lowercase) as the HTTP/1.1
    ; text of a translated request would carry it (Request.header without
    ; that text): host is :authority, the other pseudo-fields and the fields
    ; HTTP/1.1 frames itself are none.
    function header(this, lname: Slice[u8]) returns Slice[u8]
    {
        if lname.equals("host")
            return trim(this.get(":authority"))
        if framing_field(lname) or (lname.length > 0 and lname[0] = 58)
            return lname.slice_to(0)
        var i: size_t 0
        while i < this.count()
        {
            let n this.name(i)
            if n.length > 0 and n[0] <> 58 and equals_lower(n, lname)
                return trim(this.value(i))
            set i: i + 1
        }
        lname.slice_to(0)
    }

    procedure add(mutable this, name: Slice[u8], value: Slice[u8])
    {
        views.add(name)
        views.add(value)
    }

    ; Room for n more bytes in `bytes`; when they move, the views into
    ; them follow.
    procedure room(mutable this, n: size_t)
    {
        let old_at bytes.data.data as size_t
        let old_end old_at + bytes.length
        bytes.reserve(n)
        let new_at bytes.data.data as size_t
        if new_at = old_at
            return
        var i: size_t 0
        while i < views.length
        {
            let v views[i]
            let a v.data as size_t
            if v.length > 0 and a >= old_at and a < old_end
                views.put(i, bytes.data.subslice(a - old_at, a - old_at + v.length))
            set i: i + 1
        }
    }

    ; Room for the literals of a header block of n bytes (a Huffman code
    ; has at least 5 bits), made before it is decoded: `literal` never
    ; grows `bytes`, so no view it handed out moves.
    procedure room_for_block(mutable this, n: size_t)
        this.room((n * 8) / 5 + 8)

    ; A string literal's bytes (Huffman-coded or not) decoded behind the
    ; others: their view, through s. False when they are malformed, when
    ; room_for_block made too little room, and when they hold a CR, LF or
    ; NUL: RFC 9113 8.2.1 and RFC 9114 4.2 make such a field malformed
    ; (HTTP/2 ends the connection for it, 5.4.1) -- and in the HTTP/1.1 text
    ; a request becomes, an LF would begin a field of the client's choosing.
    ; Every literal passes here, and every dynamic table entry was one.
    procedure literal(mutable this, raw: Slice[u8], huffman: bool, mutable s: ref[Slice[u8]]) returns bool
    {
        let start bytes.length
        if huffman
        {
            if start + (raw.length * 8) / 5 + 1 > bytes.capacity()
                return false
            var w start
            if huffman_decode_into(raw, bytes.data, &w, true) = false
                return false
            set bytes.length: w
        }
        else
        {
            if start + raw.length > bytes.capacity() or field_bytes_ok(raw) = false
                return false
            bytes.append(raw)
        }
        set s: bytes.bytes().slice_from(start)
        true
    }

    ; Every view into `table` (the dynamic table's bytes) copied into
    ; `bytes`: before an insert, which may move or overwrite them.
    procedure own_table(mutable this, table: Slice[u8])
    {
        let lo table.data as size_t
        let hi lo + table.length
        var need: size_t 0
        var i: size_t 0
        while i < views.length
        {
            let v views[i]
            let a v.data as size_t
            if v.length > 0 and a >= lo and a < hi
                set need: need + v.length
            set i: i + 1
        }
        if need = 0
            return
        this.room(need)
        set i: 0
        while i < views.length
        {
            let v views[i]
            let a v.data as size_t
            if v.length > 0 and a >= lo and a < hi
            {
                let at bytes.length
                bytes.append(v)
                views.put(i, bytes.bytes().subslice(at, at + v.length))
            }
            set i: i + 1
        }
    }
}

; Which pseudo-field a name is: 1 :method, 2 :path, 3 :authority, 0 any
; other -- told apart by length and second byte, so that a comparison runs
; only to confirm (each was a memcmp call, 2026-09-30).
function pseudo_field(name: Slice[u8]) returns int
{
    if name.length < 5 or name[0] <> 58
        return 0
    if name.length = 7 and name[1] = 109 and name.equals(":method")
        return 1
    if name.length = 5 and name.equals(":path")
        return 2
    if name.length = 10 and name.equals(":authority")
        return 3
    0
}

; Is a (lowercase) field one HTTP/1.1 frames itself, which the text of a
; translated request leaves out?
function framing_field(name: Slice[u8]) returns bool
{
    match name.length
        case 4: return name.equals("host")
        case 10: return name[0] = 99 and name.equals("connection")
        case 14: return name.equals("content-length")
        case 17: return name.equals("transfer-encoding")
    false
}

; An integer with an n-bit prefix (RFC 7541 5.1) at block[at]; at moves
; past it. -1 when the block ends inside it or it overflows.
procedure decode_integer(block: Slice[u8], mutable at: ref[size_t], prefix_bits: u64) returns i64
{
    if at >= block.length
        return 0 - 1
    let mask ((1 as u64) << prefix_bits) - 1
    var v (block[at] as u64) & mask
    set at: at + 1
    if v < mask
        return v as i64
    var shift: u64 0
    repeat
    {
        if at >= block.length or shift > 28
            return 0 - 1
        let b block[at] as u64
        set at: at + 1
        set v: v + ((b & 127) << shift)
        set shift: shift + 7
        if (b & 128) = 0
            break
    }
    v as i64
}

; Huffman-coded bytes decoded onto out (RFC 7541 5.2, Appendix B); false on
; an EOS inside the string or padding that is not a short run of ones.
procedure huffman_decode(src: Slice[u8], mutable out: ref[ByteBuf]) returns bool
{
    ; no code is shorter than 5 bits
    out.reserve((src.length * 8) / 5 + 1)
    var w out.length
    let ok huffman_decode_into(src, out.data, &w, false)
    set out.length: w
    ok
}

; The same into room from w on (w moves past the bytes); room must hold
; (src.length * 8) / 5 + 1 more bytes -- a single symbol from HUFF_PAIR is
; written with a spare byte behind it. A field (field_only) also fails on a
; CR, LF or NUL (HeaderList.literal): their codes have 13 and 30 bits, so
; only the slow path can meet them and the fast one checks nothing.
procedure huffman_decode_into(src: Slice[u8], mutable room: Slice[u8], mutable w: ref[size_t], field_only: bool) returns bool
{
    ; copies, kept in registers: a byte stored through room may alias
    ; whatever a parameter points at, and the loop reloaded w and both
    ; slices after every one (2026-09-30). Typed, since an untyped binding
    ; of w would alias it.
    var input: Slice[u8] src
    var out: Slice[u8] room
    var at: size_t w
    ; bits: how many low bits of acc are still to decode. The codes at the
    ; front of the next 11 bits -- two of them for most letters and digits --
    ; come out of HUFF_PAIR in one look; at the end of the string the bits
    ; are padded with ones (as the padding is) and only codes that lie
    ; within the real ones are taken. A longer code is found length by
    ; length, as the code is canonical. Bit by bit, this was a tenth of the
    ; server's samples in baseline-h2; a symbol per look (8 bits), still
    ; 9 % (2026-09-30).
    var acc: u64 0
    var bits: u64 0
    var i: size_t 0
    repeat
    {
        while bits <= 56 and i < input.length
        {
            set acc: (acc << 8) | (input[i] as u64)
            set bits: bits + 8
            set i: i + 1
        }
        if bits >= 11
        {
            let e HUFF_PAIR[((acc >> (bits - 11)) & 2047) as size_t] as u64
            if e <> 0
            {
                out.put(at, (e & 255) as u8)
                out.put(at + 1, ((e >> 8) & 255) as u8)
                set at: at + ((e >> 24) & 3)
                set bits: bits - ((e >> 20) & 15)
                continue
            }
        }
        else if bits >= 5
        {
            let pad 11 - bits
            let e HUFF_PAIR[(((acc << pad) | (((1 as u64) << pad) - 1)) & 2047) as size_t] as u64
            if e <> 0
            {
                let total (e >> 20) & 15
                let first (e >> 16) & 15
                if total <= bits
                {
                    out.put(at, (e & 255) as u8)
                    out.put(at + 1, ((e >> 8) & 255) as u8)
                    set at: at + ((e >> 24) & 3)
                    set bits: bits - total
                    continue
                }
                if first <= bits
                {
                    out.put(at, (e & 255) as u8)
                    set at: at + 1
                    set bits: bits - first
                    continue
                }
            }
        }
        var length: u64 5
        var found false
        while length <= 30 and length <= bits
        {
            let code (acc >> (bits - length)) & (((1 as u64) << length) - 1)
            let n HUFF_COUNT[length as size_t] as u64
            let first HUFF_FIRST[length as size_t] as u64
            if n > 0 and code >= first and code - first < n
            {
                let symbol HUFF_SYMBOLS[(HUFF_OFFSET[length as size_t] as size_t) + ((code - first) as size_t)]
                if symbol = 256 or (field_only and (symbol = 0 or symbol = 10 or symbol = 13))
                {
                    set w: at
                    return false
                }
                out.put(at, symbol as u8)
                set at: at + 1
                set bits: bits - length
                set found: true
                break
            }
            set length: length + 1
        }
        if found
            continue
        ; no whole code left: the end, padded with fewer than 8 one bits
        set w: at
        if i < input.length
            return false
        return bits < 8 and (acc & (((1 as u64) << bits) - 1)) = ((1 as u64) << bits) - 1
    }
}

; Can a field's name or value stand in HTTP/1.1 text? Not with a CR, an LF
; or a NUL (RFC 9113 8.2.1, RFC 9114 4.2): in the text an LF would begin a
; field of the client's choosing.
function field_bytes_ok(s: Slice[u8]) returns bool
{
    var i: size_t 0
    while i < s.length
    {
        let c s[i]
        if c = 13 or c = 10 or c = 0
            return false
        set i: i + 1
    }
    true
}

define HpackDecoder
(
    ; the entries' bytes, name then value, oldest first
    var data: Slice[u8]
    var used: size_t
    ; the ring of entries: where each starts and its two lengths
    var ring_start: Slice[u32]
    var ring_name: Slice[u32]
    var ring_value: Slice[u32]
    ; the slot the next entry takes, and how many are live
    var head: size_t
    var count: size_t
    ; the table's size by RFC 7541 4.1, and its current limit
    var size: size_t
    var limit: size_t
)
{
    procedure create(host: ref[Page]) returns HpackDecoder
    {
        HpackDecoder(
            allocate_slice[u8]^host(host, DYN_BYTES), 0,
            allocate_slice[u32]^host(host, DYN_ENTRIES),
            allocate_slice[u32]^host(host, DYN_ENTRIES),
            allocate_slice[u32]^host(host, DYN_ENTRIES),
            0, 0, 0, HPACK_TABLE_SIZE)
    }

    ; The slot of dynamic entry d (0 is the newest).
    function slot(this, d: size_t) returns size_t
        (head + DYN_ENTRIES - 1 - d) % DYN_ENTRIES

    procedure evict_oldest(mutable this)
    {
        let s (head + DYN_ENTRIES - count) % DYN_ENTRIES
        set size: size - (ring_name[s] as size_t) - (ring_value[s] as size_t) - 32
        set count: count - 1
        if count = 0
            set used: 0
    }

    ; Evict until the table fits `limit` less `room`.
    procedure evict_to(mutable this, room: size_t)
    {
        while count > 0 and size + room > limit
            this.evict_oldest()
    }

    ; Slide the live entries' bytes to the front of data.
    procedure compact(mutable this)
    {
        var to: size_t 0
        var d count
        while d > 0
        {
            set d: d - 1
            let s this.slot(d)
            let from ring_start[s] as size_t
            let n (ring_name[s] as size_t) + (ring_value[s] as size_t)
            if n > 0 and from <> to
                memmove(data.slice_from(to).data as pointer[void], data.slice_from(from).data as pointer[void], n)
            ring_start.put(s, to as u32)
            set to: to + n
        }
        set used: to
    }

    procedure insert(mutable this, name: Slice[u8], value: Slice[u8])
    {
        let cost name.length + value.length + 32
        if cost > limit
        {
            while count > 0
                this.evict_oldest()
            return
        }
        this.evict_to(cost)
        if count = DYN_ENTRIES
            this.evict_oldest()
        if used + name.length + value.length > data.length
            this.compact()
        let at used
        memcpy(data.slice_from(at).data as pointer[void], name.data as pointer[void], name.length)
        memcpy(data.slice_from(at + name.length).data as pointer[void], value.data as pointer[void], value.length)
        ring_start.put(head, at as u32)
        ring_name.put(head, name.length as u32)
        ring_value.put(head, value.length as u32)
        set head: (head + 1) % DYN_ENTRIES
        set count: count + 1
        set size: size + cost
        set used: at + name.length + value.length
    }

    ; Entry `index` of the combined table (1..61 static, then dynamic): views
    ; of its name and value -- a dynamic one's valid until the next insert.
    ; False for an index that names nothing.
    procedure entry(this, index: u64, mutable name: ref[Slice[u8]], mutable value: ref[Slice[u8]]) returns bool
    {
        if index = 0
            return false
        if index <= 61
        {
            set name: static_name(index)
            set value: static_value(index)
            return true
        }
        let d (index - 62) as size_t
        if d >= count
            return false
        let s this.slot(d)
        let at ring_start[s] as size_t
        let nl ring_name[s] as size_t
        set name: data.subslice(at, at + nl)
        set value: data.subslice(at + nl, at + nl + (ring_value[s] as size_t))
        true
    }

    ; Decode one complete header block onto list; false on a malformed
    ; block (a COMPRESSION_ERROR: the connection must end).
    procedure decode(mutable this, block: Slice[u8], mutable list: ref[HeaderList]) returns bool
    {
        list.room_for_block(block.length)
        var at: size_t 0
        while at < block.length
        {
            let b block[at]
            var name: Slice[u8] ""
            var value: Slice[u8] ""
            if (b & 128) <> 0
            {
                let index decode_integer(block, &at, 7)
                if index <= 0 or this.entry(index as u64, &name, &value) = false
                    return false
                list.add(name, value)
            }
            else if (b & 224) = 32
            {
                let new_limit decode_integer(block, &at, 5)
                if new_limit < 0 or (new_limit as size_t) > HPACK_TABLE_SIZE
                    return false
                set limit: new_limit as size_t
                this.evict_to(0)
            }
            else
            {
                ; 01: incremental indexing (6-bit index); 0000 / 0001: not
                ; indexed / never indexed (4-bit index)
                let indexing (b & 192) = 64
                var prefix: u64 4
                if indexing
                    set prefix: 6
                let index decode_integer(block, &at, prefix)
                if index < 0
                    return false
                if index = 0
                {
                    if hpack_string(block, &at, list, &name) = false
                        return false
                }
                else if this.entry(index as u64, &name, &value) = false
                    return false
                if hpack_string(block, &at, list, &value) = false
                    return false
                list.add(name, value)
                if indexing
                {
                    ; the insert may move or overwrite the table's bytes
                    list.own_table(data)
                    let k list.count() - 1
                    this.insert(list.name(k), list.value(k))
                }
            }
        }
        true
    }
}

; One string literal (RFC 7541 5.2) at block[at] decoded onto list
; (HeaderList.literal): its view, through s.
procedure hpack_string(block: Slice[u8], mutable at: ref[size_t], mutable list: ref[HeaderList], mutable s: ref[Slice[u8]]) returns bool
{
    if at >= block.length
        return false
    let huffman (block[at] & 128) <> 0
    let n decode_integer(block, at, 7)
    if n < 0 or at + (n as size_t) > block.length
        return false
    let raw block.subslice(at, at + (n as size_t))
    set at: at + (n as size_t)
    list.literal(raw, huffman, s)
}

; An integer with an n-bit prefix whose other bits are `flags`.
procedure encode_integer(mutable out: ref[ByteBuf], flags: u8, prefix_bits: u64, value: u64)
{
    let mask ((1 as u64) << prefix_bits) - 1
    if value < mask
    {
        out.append_byte(flags | (value as u8))
        return
    }
    out.append_byte(flags | (mask as u8))
    var v value - mask
    while v >= 128
    {
        out.append_byte(((v & 127) | 128) as u8)
        set v: v >> 7
    }
    out.append_byte(v as u8)
}

; A string literal, not Huffman-coded.
procedure encode_string(mutable out: ref[ByteBuf], s: Slice[u8])
{
    encode_integer(out, 0, 7, s.length as u64)
    out.append(s)
}

; The :status field: indexed for the seven the static table holds, else a
; literal with the indexed name :status.
procedure encode_status(mutable out: ref[ByteBuf], status: i64)
{
    let index static_status_index(status)
    if index > 0
    {
        encode_integer(out, 128, 7, index)
        return
    }
    encode_integer(out, 0, 4, 8)
    encode_integer(out, 0, 7, 3)
    out.append_byte(((status / 100) % 10 + 48) as u8)
    out.append_byte(((status / 10) % 10 + 48) as u8)
    out.append_byte((status % 10 + 48) as u8)
}

; The static table entry of a :status, 0 for one it does not hold.
function static_status_index(status: i64) returns u64
{
    match status
        case 200: return 8
        case 204: return 9
        case 206: return 10
        case 304: return 11
        case 400: return 12
        case 404: return 13
        case 500: return 14
    0
}

; The static table index of a lowercase field name worth one, else 0.
function static_name_index(name: Slice[u8]) returns u64
{
    if name.equals("content-type")
        return 31
    if name.equals("content-length")
        return 28
    if name.equals("date")
        return 33
    if name.equals("content-encoding")
        return 26
    if name.equals("vary")
        return 59
    if name.equals("server")
        return 54
    if name.equals("cache-control")
        return 24
    if name.equals("location")
        return 46
    if name.equals("allow")
        return 22
    if name.equals("set-cookie")
        return 55
    if name.equals("etag")
        return 34
    if name.equals("last-modified")
        return 44
    0
}

; A field whose name is static table entry index, as a literal without
; indexing.
procedure encode_indexed_field(mutable out: ref[ByteBuf], index: u64, value: Slice[u8])
{
    encode_integer(out, 0, 4, index)
    encode_string(out, value)
}

; A field as a handler names it ("X-Cache"): the name lowercased, as HTTP/2
; wants it; the fields that belong to one HTTP/1.1 connection are left out.
procedure encode_header_field(mutable out: ref[ByteBuf], name: Slice[u8], value: Slice[u8])
{
    var low u8[256]
    if name.length > 256
    {
        encode_field(out, name, value)
        return
    }
    let lower Slice[u8](name.length, &low[0])
    var i: size_t 0
    while i < name.length
    {
        var c name[i]
        if c >= 65 and c <= 90
            set c: c + 32
        lower.put(i, c)
        set i: i + 1
    }
    if lower.equals("connection") or lower.equals("keep-alive") or lower.equals("transfer-encoding")
        return
    encode_field(out, lower, value)
}

; v in decimal at the front of out: the number of digits.
procedure decimal_into(mutable out: Slice[u8], v: u64) returns size_t
{
    var rev u8[24]
    var n: size_t 0
    var x v
    repeat
    {
        set rev[n]: ((x % 10) as u8) + 48
        set n: n + 1
        set x: x / 10
        if x = 0
            break
    }
    var k: size_t 0
    while k < n
    {
        out.put(k, rev[n - 1 - k])
        set k: k + 1
    }
    n
}

; A field as a literal without indexing (RFC 7541 6.2.2); name lowercase.
procedure encode_field(mutable out: ref[ByteBuf], name: Slice[u8], value: Slice[u8])
{
    let index static_name_index(name)
    encode_integer(out, 0, 4, index)
    if index = 0
        encode_string(out, name)
    encode_string(out, value)
}
