; A growable byte buffer on a page the owner names: a connection's input
; and output. The PAGE owns the bytes (hence a Slice, never a Vector). A
; small growth takes a larger block on the same page and leaves the old one
; to it; past 1 KiB the buffer gets a page of its own (as Array's does) and
; the one it replaces goes back at once -- before 2026-09-29 every
; doubling stayed until the connection ended, and an HTTP/2 connection that
; had framed a few static files held all its old blocks. `owned` says the
; current block is such a page of its own.

; memmove(3) — the input buffer slides its unconsumed tail to the front.
function memmove(dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

define ByteBuf
(
    host: ref[Page]
    var data: Slice[u8]
    var length: size_t
    var owned: bool
)
{
    procedure create(host: ref[Page], capacity: size_t) returns ByteBuf
    {
        let d allocate_slice[u8]^host(host, capacity)
        ByteBuf(host, d, 0, false)
    }

    function capacity(this) returns size_t
        data.length

    ; The filled part.
    function bytes(this) returns Slice[u8]
        data.slice_to(length)

    ; The unfilled part — where a read goes.
    function spare(this) returns Slice[u8]
        data.slice_from(length)

    procedure clear(mutable this)
        set length: 0

    ; n more bytes are filled (a read wrote them into spare()).
    procedure advance(mutable this, n: size_t)
        set length: length + n

    ; Make room for n more bytes: at least double on growth. The test stays
    ; small enough to inline into every append; the growth is out of line.
    procedure reserve(mutable this, n: size_t)
    {
        if length + n > data.length
            this.grow(n)
    }

    procedure grow(mutable this, n: size_t)
    {
        var cap data.length * 2
        if cap < length + n
            set cap: length + n
        let old data
        let old_owned owned
        if cap <= 0x400
        {
            set data: allocate_slice[u8]^host(host, cap)
            set owned: false
        }
        else
        {
            let fresh host.allocate_exclusive_buffer(cap, 1) as pointer[u8]
            set data: Slice[u8](cap, fresh)
            set owned: true
        }
        if length > 0
            memcpy(data.data as pointer[void], old.data as pointer[void], length)
        if old_owned
            host.deallocate_exclusive_page(Page.get(old.data))
    }

    ; Drop the first n bytes, sliding the rest to the front.
    procedure consume(mutable this, n: size_t)
    {
        if n = 0
            return
        if n >= length
        {
            set length: 0
            return
        }
        let rest length - n
        memmove(data.data as pointer[void], data.slice_from(n).data as pointer[void], rest)
        set length: rest
    }

    procedure append(mutable this, s: Slice[u8])
    {
        if s.length = 0
            return
        this.reserve(s.length)
        memcpy(data.slice_from(length).data as pointer[void], s.data as pointer[void], s.length)
        set length: length + s.length
    }

    procedure append_byte(mutable this, b: u8)
    {
        this.reserve(1)
        data.put(length, b)
        set length: length + 1
    }

    ; An unsigned number in decimal, written backwards into its place.
    procedure append_uint(mutable this, v: u64)
    {
        var n: size_t 1
        var t v / 10
        while t > 0
        {
            set n: n + 1
            set t: t / 10
        }
        this.reserve(n)
        var at length + n
        var x v
        repeat
        {
            set at: at - 1
            data.put(at, ((x % 10) as u8) + 48)
            set x: x / 10
            if x = 0
                break
        }
        set length: length + n
    }

    ; A signed number in decimal.
    procedure append_int(mutable this, v: i64)
    {
        if v < 0
        {
            this.append_byte(45)
            this.append_uint(((0 as i64) - v) as u64)
            return
        }
        this.append_uint(v as u64)
    }
}
