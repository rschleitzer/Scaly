; Unary gRPC over the http package's HTTP/2: the
; length-prefixed message of a request body, the reply in the same framing
; with its grpc-status trailer, and the Protocol Buffers varint fields that
; small messages are made of.
;
;   procedure get_sum(req: ref[Request], mutable res: ref[Response])
;   {
;       let msg grpc_message(req.body)
;       ... proto_varint(msg, 1) ... proto_varint(msg, 2) ...
;       grpc_reply(res, reply bytes)
;   }
;   app.post("/benchmark.BenchmarkService/GetSum", &get_sum)

use http.Buffer.ByteBuf
use http.Request.Request
use http.Response.Response

; The message of a gRPC request body: its first length-prefixed message
; (a compression flag 0 and a big-endian length); empty when the body is
; not one, or compressed.
function grpc_message(body: Slice[u8]) returns Slice[u8]
{
    if body.length < 5 or body[0] <> 0
        return body.slice_to(0)
    let n ((body[1] as size_t) << 24) | ((body[2] as size_t) << 16) | ((body[3] as size_t) << 8) | (body[4] as size_t)
    if 5 + n > body.length
        return body.slice_to(0)
    body.subslice(5, 5 + n)
}

; Answer a unary call: the message framed, content-type application/grpc,
; and the trailer grpc-status 0.
procedure grpc_reply(mutable res: ref[Response], message: Slice[u8])
{
    var framed Vector[u8](5 + message.length)
    framed.put(0, 0)
    framed.put(1, ((message.length >> 24) & 255) as u8)
    framed.put(2, ((message.length >> 16) & 255) as u8)
    framed.put(3, ((message.length >> 8) & 255) as u8)
    framed.put(4, (message.length & 255) as u8)
    var i: size_t 0
    while i < message.length
    {
        framed.put(5 + i, message[i])
        i := i + 1
    }
    res.trailer("grpc-status", "0")
    res.send("application/grpc", framed.as_slice())
}

; A varint at msg[at]; at moves past it. -1 in `ok` terms: at is set past
; the end when it is truncated.
procedure proto_read_varint(msg: Slice[u8], mutable at: ref[size_t]) returns u64
{
    var v: u64 0
    var shift: u64 0
    var pos: size_t at
    while pos < msg.length and shift < 64
    {
        let b msg[pos] as u64
        pos := pos + 1
        v := v | ((b & 127) << shift)
        if (b & 128) = 0
        {
            at := pos
            return v
        }
        shift := shift + 7
    }
    at := msg.length + 1
    0
}

; The value of varint field `field` in a Protocol Buffers message (the
; last occurrence, as proto3 reads it), 0 when absent. An int32 or int64
; comes back sign-extended from its 64-bit two's complement.
function proto_varint(msg: Slice[u8], field: u64) returns i64
{
    var found: u64 0
    var at: size_t 0
    while at < msg.length
    {
        let key proto_read_varint(msg, &at)
        if at > msg.length
            return 0
        let wire key & 7
        let number key >> 3
        if wire = 0
        {
            let v proto_read_varint(msg, &at)
            if at > msg.length
                return 0
            if number = field
                found := v
        }
        else if wire = 1
            at := at + 8
        else if wire = 5
            at := at + 4
        else if wire = 2
        {
            let n proto_read_varint(msg, &at)
            if at > msg.length
                return 0
            at := at + (n as size_t)
        }
        else
            return 0
    }
    found as i64
}

; A varint field written into out at `at` (a negative value as its ten-byte
; two's complement): the position after it. At most 20 bytes.
procedure proto_put_varint(mutable out: Slice[u8], at: size_t, field: u64, value: i64) returns size_t
{
    var pos at
    var v: u64 field << 3
    while v >= 128
    {
        out.put(pos, ((v & 127) | 128) as u8)
        pos := pos + 1
        v := v >> 7
    }
    out.put(pos, v as u8)
    pos := pos + 1
    v := value as u64
    while v >= 128
    {
        out.put(pos, ((v & 127) | 128) as u8)
        pos := pos + 1
        v := v >> 7
    }
    out.put(pos, v as u8)
    pos + 1
}
