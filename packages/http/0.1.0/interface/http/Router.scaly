; The router: routes with path parameters and a chain of middleware
; (ROADMAP-http.md, stage A — the first thing the FHIR server's REST API
; needs, and HttpArena's `completeness` flags).
;
; A route is a method and a PATTERN. A segment in braces is a parameter
; that takes one path segment; a last one ending in "..." takes the rest of
; the path:
;
;   app.get("/metadata", &capabilities)
;   app.get("/{type}/{id}", &read)                   ; req.param("id")
;   app.get("/{type}/{id}/_history/{vid}", &vread)
;   app.get("/static/{path...}", &file)             ; the rest, slashes and all
;
; When several patterns match a path, the one with the most literal
; segments wins (`/metadata` before `/{type}`, `/{type}/_search` before
; `/{type}/{id}`), then the first registered. A path that matches with the
; wrong method answers 405 with an Allow field; nothing at all, 404. HEAD is
; served by the GET route without the body.
;
; Middleware has a handler's signature and runs, in the order it was added,
; before the route's handler for every path under its prefix ("" = every
; path); one that answers (sends a response: a 401, a preflight) ends the
; request there. After-hooks run once the response is out — logging,
; metrics — and can read res.status.
;
;   app.before("/api/", &authenticate)
;   app.after("", &log)

use http.Request.Request
use http.Response.Response

define Route
(
    method: Slice[u8]            ; empty: every method
    pattern: Slice[u8]
    handler: pointer[void]
    literals: int                ; literal segments: the more, the more specific
    var waits: bool              ; its handler waits (Router.waits)
    ; the pattern's literal front: its bytes before the first parameter,
    ; and whether that is all of it (a pattern without parameters)
    prefix: size_t
    exact: bool
    ; the byte after the leading '/', -1 when a parameter (or nothing) stands
    ; there: a byte compare that rules out most routes before any call
    lead: i64
)

define Hook
(
    prefix: Slice[u8]            ; empty: every path
    handler: pointer[void]
    after: bool                  ; an after-hook, not middleware
)

define Router
@resident true @inplace true (
    host: ref[Page]
    var routes: Array[Route]
    var hooks: Array[Hook]
    ; the routes by the byte after a path's leading '/': the indices of the
    ; candidates for byte b stand in lead_routes from lead_start[b] to
    ; lead_start[b + 1], in the order they were added -- a route with a
    ; parameter (or nothing) there in every list. find and route_waits walk
    ; those alone: walking every route was a quarter of the connection
    ; loop's own samples in pipelined, on Linux (2026-09-30).
    var lead_start: Array[size_t]
    var lead_routes: Array[size_t]
)
{
    procedure create(host: ref[Page]) @ret_explicit_0 true @deep true returns ref[Router] linked

    ; lead_start and lead_routes anew, after a route was added.
    procedure index_leads(mutable this) @ret_nonlocal true @deep true linked

    ; The list of candidates for path: lead_start's index.
    function lead_of(this, path: Slice[u8]) @ret_param_1 true @deep true returns size_t linked

    ; A route for method ("" for every method) on pattern.
    procedure add(mutable this, method: Slice[u8], pattern: Slice[u8], mutable handler: pointer[void]) @persists true @ret_nonlocal true @deep true @deep_this_6 true @deep_whole_6 true linked

    procedure get(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure post(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure put(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure patch(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    procedure delete(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; Every method on pattern.
    procedure any(mutable this, pattern: Slice[u8], mutable handler: pointer[void]) @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; The routes on pattern have handlers that WAIT -- a database query, a
    ; call to another service, a sleep. Over HTTP/2 each such request runs
    ; in a task of its own, so it holds only its own stream; every other
    ; request is answered in the connection's own task, which costs
    ; nothing. (Over HTTP/1.1 a connection answers in order anyway.)
    procedure waits(mutable this, pattern: Slice[u8]) @deep true linked

    ; Does a request for method and path reach a route that waits?
    function route_waits(this, method: Slice[u8], path: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

    ; Middleware for every path under prefix ("" = every path).
    procedure before(mutable this, prefix: Slice[u8], mutable handler: pointer[void]) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; An after-hook for every path under prefix.
    procedure after(mutable this, prefix: Slice[u8], mutable handler: pointer[void]) @persists true @ret_nonlocal true @deep true @deep_this_2 true @deep_whole_2 true linked

    ; The route for req: the most specific whose pattern matches the path and
    ; whose method fits (HEAD takes a GET route) — null when none does, with
    ; path_matched telling a 405 from a 404.
    procedure find(this, req: ref[Request], mutable path_matched: ref[bool]) @page true @direct true @ret_param_0 true @deep true returns ref[Route]? linked

    ; The methods of every route whose pattern matches path, for an Allow
    ; field: "GET, HEAD, POST".
    procedure allowed(this, path: Slice[u8]) @page true @direct true @ret_caller true @deep true returns String linked

    ; Answer req: middleware, the route's handler, after-hooks. The response
    ; is the connection's (Response.reset has run).
    procedure handle(this, mutable req: ref[Request], mutable res: ref[Response]) @deep true io linked

    procedure run_after(this, mutable req: ref[Request], mutable res: ref[Response]) @deep true linked
}

; The length of a pattern's literal front: its bytes before the first
; parameter (all of them when it has none).
function literal_prefix(pattern: Slice[u8]) @ret_param_0 true @deep true returns size_t linked

; Does path match route r? The byte after the leading '/' rules out most
; routes; a pattern without parameters is the path or not -- one
; comparison, a length first; one with parameters must have its literal
; front at the path's front before match_pattern walks it. Matching every
; route byte by byte was 6 % of the server's samples in baseline-h2
; (2026-09-30).
function route_matches(r: ref[Route], path: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

; Does path match pattern? Literal bytes must be equal; a parameter "{x}"
; takes one non-empty segment (up to the next '/'), a last one "{x...}"
; the rest of the path.
function match_pattern(pattern: Slice[u8], path: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

; The literal segments of a pattern (segments not in braces).
function literal_segments(pattern: Slice[u8]) @ret_nonlocal true @deep true returns int linked

; The value of parameter name in path, matched against pattern; empty when
; the pattern has no such parameter.
function pattern_param(pattern: Slice[u8], path: Slice[u8], name: Slice[u8]) @page true @direct true @ret_param_1 true @deep true returns Slice[u8] linked
