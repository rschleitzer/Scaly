; Static files: the file a route names under a
; directory, with its media type from the extension and, when the client
; accepts a content coding, the pre-compressed twin that sits beside it on
; disk (`app.js.br`, `app.js.gz`) — chosen by the q-values of
; Accept-Encoding, brotli first on a tie. Nothing is compressed here.
;
;   procedure asset(req: ref[Request], mutable res: ref[Response])
;       serve_file(req, res, "/data/static", req.param("path"))
;   app.get("/static/{path...}", &asset)
;
; Contents are cached per scheduler thread (a request's task never leaves
; its thread, so the cache needs no lock) and FOLLOW THE DISK: every request
; asks what the file is now (a stat: size, mtime, inode) and an entry that
; no longer matches is read again before it is served, on a page of its own
; that replaces the old one -- a file replaced on disk is served with its new
; bytes on the very next request, and a file removed answers 404. Until
; 2026-09-30 an entry was read again once it was a second old: HttpArena's
; rule is "replace a file and the next response must carry the new bytes",
; and its validation's 2 s window is a tolerance, not a budget. A path that
; climbs out of the directory ("..") or starts with '/' answers 404 as well.

use http.Request.Request
use http.Response.Response

; What a file is on disk (scaly/fiber/eio.c): out[0] size, out[1] mtime in
; nanoseconds, out[2] inode, out[3] block size; -1 when there is no file.
procedure scaly_eio_stat(path: pointer[const_char], fd: i32, mutable out: pointer[i64]) returns i32 extern
; The wall clock a file's mtime is taken from, in nanoseconds (eio.c).
procedure scaly_eio_wall_ns() returns i64 extern
; A file written this recently may be written AGAIN with the same stamp: a
; file system stamps a write with a clock that ticks (15.6 ms on Windows, a
; few on Linux), and a second write of the same size inside one tick changes
; neither size nor mtime. git calls such an entry racy and does not trust it;
; neither does load_entry#. Found 2026-10-02 on Windows, where a file replaced
; right after its first read was served stale now and then.
define STATIC_RACY_NS: i64 100000000

define StaticEntry
(
    ; the file on disk, on the cache's page
    path: String
    ; the contents, on `page`, which a reload replaces
    var page: ref[Page]
    var content: String
    var present: bool
    ; monotonic time of the last read, 0 before the first
    var loaded_at: i64
    ; what the file was when it was read (size, mtime, inode; -1 absent)
    var size: i64
    var mtime: i64
    var inode: i64
    var loading: bool
    ; whether `page` is the entry's own (false while it is the cache's)
    var owns_page: bool
)

define StaticCache
@resident true @inplace true (
    host: ref[Page]
    var entries: Array[ref[StaticEntry]]
)

; This thread's cache, made at its first request.
mutable static_cache: ref[StaticCache]? linked

; The media type for a file name's extension; application/octet-stream
; for one this table does not know.
function media_type(name: Slice[u8]) @ret_nonlocal true @deep true returns Slice[u8] linked

; Is rel a path this handler may open: not empty, not absolute, no ".."
; segment?
function safe_relative(rel: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

; The q-value (in thousandths) Accept-Encoding gives coding `name`: an
; explicit entry, else a `*` entry, else 0.
function coding_quality(accept: Slice[u8], name: Slice[u8]) @ret_nonlocal true @deep true returns i64 linked

; "1", "0.8", "0.125" as thousandths.
function quality_value(s: Slice[u8]) @ret_nonlocal true @deep true returns i64 linked

; This thread's cache.
procedure static_cache_here() @deep true returns ref[StaticCache] mutable static_cache reads static_cache linked

; The cache entry of the file at path, read (again) when it is new or the
; file on disk is no longer what was read; while one task reads it the
; others serve what is there, or wait for a first read.
procedure static_entry(path: Slice[u8]) @deep true returns ref[StaticEntry] io mutable static_cache reads static_cache linked

; Read the entry's file onto a fresh page and put it in place of the old
; one, with what the file was just before (a change after the stat shows on
; the next request); a file that is not there reads as absent.
procedure load_entry(mutable e: ref[StaticEntry], size: i64, mtime: i64, inode: i64) @ret_nonlocal true @deep true @deep_beyond_1 true io linked

; Serve the file rel under root (see the module header): 200 with the file
; or a pre-compressed twin, 404 when there is none.
procedure serve_file(req: ref[Request], mutable res: ref[Response], root: Slice[u8], rel: Slice[u8]) @deep true io mutable static_cache reads static_cache linked

; Send the twin of the file at path[0, base) in `coding` if it exists.
procedure try_variant(mutable res: ref[Response], mutable path: ref[Array[u8]], base: size_t, coding: Slice[u8], media: Slice[u8]) @ret_nonlocal true @deep true returns bool io mutable static_cache reads static_cache linked
