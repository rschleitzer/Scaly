; A growable byte buffer on a page the owner names: a connection's input
; and output. The PAGE owns the bytes (hence a Slice, never a Vector): a
; growth takes a larger block on the same page and leaves the old one to
; the page, so a connection that once carried a large body keeps the peak
; until it ends, and the page dies with the connection.

; memmove(3) — the input buffer slides its unconsumed tail to the front.
function memmove(dest: pointer[void], src: pointer[void], count: size_t) returns pointer[void] extern

define ByteBuf
(
    host: ref[Page]
    var data: Slice[u8]
    var length: size_t
)
{
    procedure create(host: ref[Page], capacity: size_t) @page true @direct true @ret_explicit_0 true @deep true returns ByteBuf linked

    function capacity(this) @ret_param_0 true @deep true returns size_t linked

    ; The filled part.
    function bytes(this) @ret_param_0 true @deep true returns Slice[u8] linked

    ; The unfilled part — where a read goes.
    function spare(this) @ret_param_0 true @deep true returns Slice[u8] linked

    procedure clear(mutable this) @deep true linked

    ; n more bytes are filled (a read wrote them into spare()).
    procedure advance(mutable this, n: size_t) @deep true linked

    ; Make room for n more bytes: at least double on growth.
    procedure reserve(mutable this, n: size_t) @deep true linked

    ; Drop the first n bytes, sliding the rest to the front.
    procedure consume(mutable this, n: size_t) @deep true linked

    procedure append(mutable this, s: Slice[u8]) @deep true linked

    procedure append_byte(mutable this, b: u8) @persists true @deep true linked

    ; An unsigned number in decimal, written backwards into its place.
    procedure append_uint(mutable this, v: u64) @deep true linked

    ; A signed number in decimal.
    procedure append_int(mutable this, v: i64) @deep true linked
}
