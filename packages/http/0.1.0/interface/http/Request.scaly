; An HTTP/1.1 request and its parser (RFC 9112).
;
; The parser is RESUMABLE BY REPARSING: it reads a request from the start of
; the buffered bytes and answers 0 while the request is incomplete; the
; connection reads more and asks again. Nothing is written into the buffer
; before the whole request is there, so a request split at any byte — a
; header name, a chunk size, a CRLF — parses exactly as the unsplit one
; (HttpArena's validate-frag.py tries every offset). A chunked body is
; decoded IN PLACE once it is complete: the decoded bytes are never longer
; than the encoded ones.
;
; A Request is a set of VIEWS into the connection's input buffer, valid until
; the connection reads or consumes again — while its handler runs.

use http.Hpack.HeaderList

; parse_request's answers besides a byte count.
define PARSE_INCOMPLETE: i64 0
define PARSE_BAD: i64 -1              ; 400
define PARSE_HEAD_TOO_LARGE: i64 -2   ; 431
define PARSE_BODY_TOO_LARGE: i64 -3   ; 413
define PARSE_NOT_IMPLEMENTED: i64 -4  ; 501: a transfer coding other than chunked

; The status code of the response refusing a request parse_request answered
; negatively with (0 for any other answer). Also how another package tells
; the answers apart: a module does not see another package's constants.
function refusal_status(answer: i64) @ret_nonlocal true @deep true returns int linked

; The request line and the header fields together.
define MAX_HEAD: size_t 16384
; A body, decoded or not.
define MAX_BODY: size_t 16777216

define Request
(
    var method: Slice[u8]
    var target: Slice[u8]        ; path and query as sent
    var path: Slice[u8]
    var query: Slice[u8]         ; after '?', without it
    var fields: Slice[u8]        ; the header field lines, CRLF-separated
    var body: Slice[u8]
    var minor: int               ; HTTP/1.minor
    var keep_alive: bool
    var pattern: Slice[u8]       ; the matched route's pattern (Router.handle)
    ; HTTP/2 without text: the decoded fields, which header() reads when set
    ; (fields is empty then; request_from_fields)
    var list: ref[HeaderList]?
)
{
    procedure empty() @page true @direct true @ret_nonlocal true @deep true returns Request linked

    ; The value of path parameter name of the matched route ("/{type}/{id}":
    ; req.param("id")), raw — see percent_decode; empty when there is none.
    function param(this, name: Slice[u8]) @page true @direct true @ret_param_0 true @deep true returns Slice[u8] linked

    function is_method(this, m: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

    ; The value of the first header field of that name (ASCII case-
    ; insensitive, the name given in lower case); empty when absent.
    function header(this, lname: Slice[u8]) @page true @direct true @deep true returns Slice[u8] linked

    ; Does the client accept the lower-case content coding (Accept-Encoding,
    ; RFC 9110 12.5.3): named with a weight above 0, or covered by `*` and
    ; not refused by name. No field at all accepts nothing but identity.
    function accepts_encoding(this, coding: Slice[u8]) @ret_nonlocal true @deep true returns bool linked

    ; How often query parameter name occurs (`code=a&code=b`: 2).
    function query_count(this, name: Slice[u8]) @ret_nonlocal true @deep true returns int linked

    ; The raw value of the nth occurrence (from 0) of query parameter name;
    ; empty when there are fewer.
    function query_param_nth(this, name: Slice[u8], nth: int) @page true @direct true @ret_param_0 true @deep true returns Slice[u8] linked

    ; The raw value of query parameter `name` (no percent-decoding); empty
    ; when absent or empty. One pass that compares the name in place: each
    ; pair cut out with index_of and compared with equals -- memchr and
    ; memcmp calls on a few bytes -- was 4 % of the server's samples in
    ; baseline-h2 (2026-09-30).
    function query_param(this, name: Slice[u8]) @ret_param_0 true @deep true returns Slice[u8] linked
}

; The offset of the first byte past the head (the blank line included),
; 0 when the head is not complete yet. Both CRLF CRLF and a bare LF LF end
; it (RFC 9112 2.2: a recipient MAY accept a bare LF as a line terminator).
function head_end(buf: Slice[u8]) @ret_nonlocal true @deep true returns size_t linked

; What an unfinished head answers: incomplete, or too large once more than
; MAX_HEAD bytes have come without its end.
function head_incomplete(have: size_t) @deep true returns i64 linked

; Parse one request from the start of buf into req. A positive answer is the
; number of bytes the request took (head and encoded body); PARSE_INCOMPLETE
; asks for more bytes; the negative answers name the error response.
;
; ONE pass over the head (2026-09-28, the hot path of ROADMAP-http.md stage
; A: the parser was 17 % of a pipelined server's CPU): memchr finds each
; line's LF, the line is judged at once, and the head ends at the first
; empty line — where the parser used to find the head's end first and then
; walk every line again byte by byte. A line is only judged once its LF is
; in, so every proper prefix of a valid request still answers incomplete.
procedure parse_request(mutable buf: Slice[u8], mutable req: ref[Request]) @deep true returns i64 linked

; A chunked body starting at buf[at]: first measured without touching the
; buffer (PARSE_INCOMPLETE until the last chunk and the trailer section are
; in), then decoded in place to buf[at ..). Answers the offset past the
; message (as a byte count from the buffer start) and stores the decoded
; length into body_len.
procedure decode_chunked(mutable buf: Slice[u8], at: size_t, mutable body_len: ref[size_t]) @deep true returns i64 linked
