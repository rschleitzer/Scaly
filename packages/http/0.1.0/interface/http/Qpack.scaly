; QPACK (RFC 9204), the header compression of HTTP/3. The decoder keeps a
; dynamic table (QpackTable) when the server offers one (h3 does on
; request, h3_offer_qpack_table): the client's
; encoder inserts on its encoder stream (encoder_instructions) and its field
; sections name the entries (qpack_decode_table), the server answering on
; its decoder stream (Insert Count Increment, Section Acknowledgment). It
; allows no blocked streams (SETTINGS_QPACK_BLOCKED_STREAMS stays 0), so a
; client names only entries the server acknowledged, and a field section
; never waits for an insert. Strings are Huffman-coded as in HPACK
; (http.Hpack's decoder); responses are sent with the static table only, as
; literals without Huffman.

use http.Buffer.ByteBuf
use http.Hpack.HeaderList
use http.Hpack.HpackDecoder

; The largest dynamic table capacity a server may offer
; (SETTINGS_QPACK_MAX_TABLE_CAPACITY): HpackDecoder's ring holds the
; entries (at most 4096 / 32 of them).
define QPACK_TABLE_CAPACITY: size_t 4096

; The decoder's dynamic table of one connection.
define QpackTable
(
    ; the entries: dynamic entry d (0 the newest) is table entry 62 + d
    var table: HpackDecoder
    ; the entries inserted so far (the Insert Count), and how many of them
    ; the encoder knows arrived (the Known Received Count)
    var inserts: u64
    var known: u64
    ; an entry's name and value while it is inserted: a name or a
    ; duplicate taken from the table may move or go with the insert
    var scratch: ByteBuf
    ; the capacity offered (at most QPACK_TABLE_CAPACITY)
    offered: size_t
)
{
    ; A table on host for the capacity offered, its capacity 0 until the
    ; encoder sets one.
    procedure create(host: ref[Page], offered: size_t) @deep true returns ref[QpackTable] linked

    ; Dynamic entry with absolute index `index`: views of its name and
    ; value (valid until the next insert); false for one not (or no longer)
    ; in the table.
    procedure entry(this, index: u64, mutable name: ref[Slice[u8]], mutable value: ref[Slice[u8]]) @ret_nonlocal true @deep true returns bool linked

    ; The encoder stream's complete instructions at the front of input
    ; carried out (RFC 9204 4.3): the bytes they took -- the rest waits for
    ; more -- or -1 when one is malformed (QPACK_ENCODER_STREAM_ERROR).
    procedure encoder_instructions(mutable this, input: Slice[u8]) @ret_nonlocal true @deep true returns i64 linked

    ; One instruction at input[at]: where it ends, 0 when input ends inside
    ; it, -1 when it is malformed.
    procedure encoder_instruction(mutable this, input: Slice[u8], at: size_t) @ret_nonlocal true @deep true returns i64 linked

    ; The inserts the encoder does not know arrived, now known: the
    ; increment of an Insert Count Increment, 0 for none to send.
    procedure increment(mutable this) @ret_param_0 true @deep true returns u64 linked

    ; A field section with Required Insert Count ric was acknowledged.
    procedure acknowledged(mutable this, ric: u64) @deep true linked
}

; An integer with an n-bit prefix at input[at] as decode_integer reads it,
; but -2 when input ends inside it (more may come) and -1 only when it is
; malformed: one that runs on past five continuation bytes.
procedure qpack_integer(input: Slice[u8], mutable at: ref[size_t], prefix_bits: u64) @ret_nonlocal true @deep true returns i64 linked

; A string of an encoder instruction with an n-bit length prefix whose H
; flag is the bit just above it, decoded onto out: 1, 0 when input ends
; inside it, -1 when it is malformed -- a bad Huffman code, or a CR, LF or
; NUL, which no field may hold (HeaderList.literal) and a table entry
; becomes one.
procedure qpack_entry_string(input: Slice[u8], mutable at: ref[size_t], prefix_bits: u64, mutable out: ref[ByteBuf]) @ret_nonlocal true @deep true returns i64 linked

; A field section decoded onto list with the static table only; false when
; it is malformed or names the dynamic table.
procedure qpack_decode(block: Slice[u8], mutable list: ref[HeaderList]) @ret_nonlocal true @deep true returns bool linked

; A field section decoded onto list, naming the entries of table (none
; without one): its Required Insert Count through required, for the
; Section Acknowledgment it asks for when above 0. False when it is
; malformed, or names an entry it may not (QPACK_DECOMPRESSION_FAILED).
procedure qpack_decode_table(block: Slice[u8], table: ref[QpackTable]?, mutable list: ref[HeaderList], mutable required: ref[u64]) @ret_nonlocal true @deep true returns bool linked

; Dynamic entry `index` (absolute) for a field section whose Required
; Insert Count is ric: it must lie below ric and still be in the table.
procedure qpack_dynamic(table: ref[QpackTable]?, ric: u64, index: u64, mutable name: ref[Slice[u8]], mutable value: ref[Slice[u8]]) @ret_nonlocal true @deep true returns bool linked

; A string literal with an n-bit length prefix whose H flag is the bit just
; above it, decoded onto list (HeaderList.literal): its view, through s.
procedure qpack_string(block: Slice[u8], mutable at: ref[size_t], prefix_bits: u64, mutable list: ref[HeaderList], mutable s: ref[Slice[u8]]) @ret_nonlocal true @deep true returns bool linked

; The start of a response's field section: Required Insert Count 0, Delta
; Base 0.
procedure qpack_begin(mutable out: ref[ByteBuf]) @ret_nonlocal true @deep true linked

; The static entry of a :status, 0 for one the table does not hold.
function qpack_status_index(status: i64) @ret_nonlocal true @deep true returns u64 linked

procedure qpack_status(mutable out: ref[ByteBuf], status: i64) @deep true linked

; The static entry whose name a lowercase response field has, 0 for none
; worth one (every index here is above 0).
function qpack_name_index(name: Slice[u8]) @ret_nonlocal true @deep true returns u64 linked

; A field line as a literal (not Huffman): with the static name when the
; table has it, else with a literal name.
procedure qpack_field(mutable out: ref[ByteBuf], name: Slice[u8], value: Slice[u8]) @ret_nonlocal true @deep true linked

; A field whose name is static table entry index, as a literal with that
; name reference (RFC 9204 4.5.4, no Huffman).
procedure qpack_indexed_field(mutable out: ref[ByteBuf], index: u64, value: Slice[u8]) @ret_nonlocal true @deep true linked

; A field as a handler names it ("X-Cache"): the name lowercased, as HTTP/3
; wants it; the fields that belong to one HTTP/1.1 connection are left out.
procedure qpack_header_field(mutable out: ref[ByteBuf], name: Slice[u8], value: Slice[u8]) @deep true linked
