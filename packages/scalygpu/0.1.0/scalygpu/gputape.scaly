; gputape - the GpuTape concept: device residency for a scaly.tensor
; Tape, surfaced as a type (stage-6 milestone 6.2; the proven 6.1
; demo driver, lifted out of demo/mann_bpe_gpu.scaly and
; tests/tensor/bench/gpu_ops.scaly).
;
; GpuTape.attach(tape, params, loss_id, msl) redirects every node's
; value/grad/aux/tok buffer into its own storage-mode-shared MTLBuffer
; (region = device buffer: unified memory, the CPU keeps reading and
; writing through the same pointers - set_token, value_at and sample
; cost zero copies; the Vector[T](ptr, len) borrow init re-aims the
; 16-byte handle). It allocates the scratch slots (layernorm stats,
; crossentropy row losses) and one Adam moment slot per parameter -
; moments belong to the GpuTape, never to the node's aux (the CPU
; adam_step would lazily allocate there mid-training). Slot registry
; layout (the shim's C-side void** - Scaly has no pointer-array
; container): node_id*4 + {0 value, 1 grad, 2 aux, 3 tok}, scratch
; and moment slots appended after.
;
; ATTACH ONLY AFTER THE GRAPH IS COMPLETE: tape.nodes.add reallocates
; the node array; a node added after attach would invalidate nothing
; visibly but never reach the GPU. Op-node values and ALL grads start
; zeroed (a no-op kernel cannot fake a pass); leaf values and token
; ids are copied across. Attaching a SECOND GpuTape via attach resets
; the slot registry and releases the first one's buffers - one live
; PRIMARY GpuTape per process. attach_gen adds a forward-only SECOND
; graph beside the primary (its slots come from a reserved block, the
; registry is never reset): the shared leaves - the weights, same
; order in both id vectors - ALIAS the primary's value MTLBuffers, so
; the second graph always reads the LIVE weights with zero copies
; (the single-window generation graph). It allocates no grad or Adam
; moment slots; step/backward on it is a loud fatal error.
;
; There is NO silent CPU fallback: attach without a Metal device is a
; loud, fatal error. Programs that want a portable SKIP check
; GpuTape.available() first, like the runner scripts do.
;
; step(lr, b1, b2, eps, n) encodes forward + grad zeroing + loss seed
; + backward + Adam as ONE command buffer with a single commit+wait.
; fwd() encodes the forward walk only (autoregressive generation).
; begin()/encode_fwd(id)/encode_bwd(id)/commit_wait() expose the
; per-node encoders for the per-op-sync honesty measurement.
; save/load checkpoint the parameter values (config-header-validated,
; weights only - Adam moments are not saved, a resumed training
; re-warms them).
;
; The kind codes tested here mirror the tape's TAPE_* constants - the
; values are the tape ABI.

function exit(code: i32) extern
function powf(x: float, y: float) returns float extern
function fopen(filename: pointer[const_char], mode: pointer[const_char]) returns pointer[OpaqueFile] extern
function fclose(stream: pointer[OpaqueFile]) returns i32 extern
function fread(ptr: pointer[void], size: size_t, count: size_t, stream: pointer[OpaqueFile]) returns size_t extern
function fwrite(ptr: pointer[void], size: size_t, count: size_t, stream: pointer[OpaqueFile]) returns size_t extern

function scaly_mgpu_available() returns i32 extern
function scaly_mgpu_init() returns i32 extern
function scaly_mgpu_ops_init() returns i32 extern
function scaly_mgpu_slots_init(n: i32) returns i32 extern
function scaly_mgpu_slot_alloc(slot: i32, bytes: size_t) returns i32 extern
function scaly_mgpu_slot_contents(slot: i32) returns pointer[void] extern
procedure scaly_mgpu_slot_write(slot: i32, src: pointer[void], bytes: size_t) extern
function scaly_mgpu_slots_reserve(n: i32) returns i32 extern
procedure scaly_mgpu_slot_alias(dst: i32, src: i32) extern
function scaly_mgpu_begin() returns i32 extern
function scaly_mgpu_commit_wait() returns i32 extern
procedure scaly_mgpu_ms_reset() extern
function scaly_mgpu_ms_sum() returns double extern
procedure scaly_mgpu_enc_gemm(a: i32, b: i32, c: i32, arows: i32, acols: i32, brows: i32, bcols: i32, ta: i32, tb: i32, alpha: float, beta: float) extern
procedure scaly_mgpu_enc_mm_nn(a: i32, b: i32, c: i32, m: i32, k: i32, n: i32) extern
procedure scaly_mgpu_enc_mm_nt_acc(dc: i32, b: i32, da: i32, m: i32, k: i32, n: i32) extern
procedure scaly_mgpu_enc_mm_tn_acc(a: i32, dc: i32, db: i32, m: i32, k: i32, n: i32) extern
procedure scaly_mgpu_enc_fill(buf: i32, count: i32, v: float) extern
procedure scaly_mgpu_enc_acc(dst: i32, src: i32, count: i32) extern
procedure scaly_mgpu_enc_add(x: i32, y: i32, out: i32, count: i32) extern
procedure scaly_mgpu_enc_gelu_fwd(x: i32, out: i32, count: i32) extern
procedure scaly_mgpu_enc_gelu_bwd(x: i32, dout: i32, dx: i32, count: i32) extern
procedure scaly_mgpu_enc_add_bcast_fwd(x: i32, y: i32, out: i32, r: i32, n: i32, yr: i32) extern
procedure scaly_mgpu_enc_add_bcast_bwd_dy(dout: i32, dy: i32, r: i32, n: i32, yr: i32) extern
procedure scaly_mgpu_enc_ln_fwd(x: i32, gamma: i32, beta: i32, out: i32, stats: i32, r: i32, n: i32, eps: float) extern
procedure scaly_mgpu_enc_ln_bwd_dx(x: i32, gamma: i32, dout: i32, dx: i32, stats: i32, r: i32, n: i32) extern
procedure scaly_mgpu_enc_ln_bwd_dgb(x: i32, dout: i32, dgamma: i32, dbeta: i32, stats: i32, r: i32, n: i32) extern
procedure scaly_mgpu_enc_embed_fwd(tbl: i32, tok: i32, out: i32, tokens: i32, dim: i32) extern
procedure scaly_mgpu_enc_embed_bwd(dout: i32, tok: i32, dtable: i32, tokens: i32, dim: i32) extern
procedure scaly_mgpu_enc_ce_fwd(x: i32, tok: i32, rowloss: i32, out: i32, r: i32, n: i32) extern
procedure scaly_mgpu_enc_ce_bwd(x: i32, tok: i32, dout: i32, dx: i32, r: i32, n: i32) extern
procedure scaly_mgpu_enc_attn_fwd(q: i32, k: i32, v: i32, out: i32, aux: i32, t: i32, d: i32, hs: i32, win: i32) extern
procedure scaly_mgpu_enc_attn_bwd(q: i32, k: i32, v: i32, dout: i32, aux: i32, dq: i32, dk: i32, dv: i32, t: i32, d: i32, hs: i32, win: i32) extern
procedure scaly_mgpu_enc_adam(p: i32, g: i32, mv: i32, total: i32, lr: float, b1: float, b2: float, eps: float, bc1: float, bc2: float) extern

define GpuTape
(
    tape: Tape
    loss: int
    use_msl: int
    nnodes: int
    nparam: int
    base: int
    fwd_only: int
    xslot: Vector[int]
    mvslot: Vector[int]
    pids: Vector[int]
)
{
    ; The whole attach: loud device gate, slot registry, per-node
    ; buffer redirect, scratch slots, Adam moment slots. The record
    ; and its slot-map vectors live on their own heap page
    ; (Channel.create precedent - a by-value concept return from a
    ; static lands in recyclable temp storage and dies under the
    ; caller; a page-hosted record behind a pointer does not). The
    ; page lives as long as the process, like the MTLBuffers it maps.
    procedure attach(mutable t: Tape, params: Vector[int], loss_id: int, msl: int) returns ref[GpuTape]
    {
        if scaly_mgpu_available() = 0
        {
            Console.println("error: GpuTape: no Metal device - there is no silent CPU fallback; check GpuTape.available() for a portable SKIP")
            exit(1)
        }
        if scaly_mgpu_init() <> 0
        {
            Console.println("error: GpuTape: Metal device init failed")
            exit(1)
        }
        if scaly_mgpu_ops_init() <> 0
        {
            Console.println("error: GpuTape: kernel library init failed")
            exit(1)
        }
        let nn t.nodes.get_length() as int
        let np params.length as int
        let hp Page.allocate_page()
        let g hp.allocate(sizeof GpuTape, alignof GpuTape) as pointer[GpuTape]
        var xs_v Vector[int]^hp(nn as size_t)
        var mv_v Vector[int]^hp(np as size_t)
        var ps_v Vector[int]^hp(np as size_t)
        scaly_mgpu_slots_init((nn * 4 + nn + np) as i32)
        let xs xs_v.data
        var nextslot nn * 4
        var ri 0
        while ri < nn
        {
            let node t.nodes.at(ri)
            let count node.rows * node.cols
            let is_leaf node.op = 0
            if count > 0
            {
                let bytes (count * 4) as size_t
                scaly_mgpu_slot_alloc((ri * 4) as i32, bytes)
                if is_leaf
                    scaly_mgpu_slot_write((ri * 4) as i32, node.value.data as pointer[void], bytes)
                let p scaly_mgpu_slot_contents((ri * 4) as i32) as pointer[float]
                set node.value: Vector[float](count as size_t, p)
                scaly_mgpu_slot_alloc((ri * 4 + 1) as i32, bytes)
                let g scaly_mgpu_slot_contents((ri * 4 + 1) as i32) as pointer[float]
                set node.grad: Vector[float](count as size_t, g)
            }
            let auxlen node.aux.length as int
            if auxlen > 0
            {
                let abytes (auxlen * 4) as size_t
                scaly_mgpu_slot_alloc((ri * 4 + 2) as i32, abytes)
                let ap scaly_mgpu_slot_contents((ri * 4 + 2) as i32) as pointer[float]
                set node.aux: Vector[float](auxlen as size_t, ap)
            }
            let toklen node.tok.length as int
            if toklen > 0
            {
                let tbytes (toklen * 8) as size_t
                scaly_mgpu_slot_alloc((ri * 4 + 3) as i32, tbytes)
                scaly_mgpu_slot_write((ri * 4 + 3) as i32, node.tok.data as pointer[void], tbytes)
                let tkp scaly_mgpu_slot_contents((ri * 4 + 3) as i32) as pointer[i64]
                set node.tok: Vector[i64](toklen as size_t, tkp)
            }
            var xtra 0 - 1
            if node.op = 4
            {
                scaly_mgpu_slot_alloc(nextslot as i32, (node.rows * 2 * 4) as size_t)
                set xtra: nextslot
                set nextslot: nextslot + 1
            }
            if node.op = 7
            {
                let na t.nodes.at(node.a)
                scaly_mgpu_slot_alloc(nextslot as i32, (na.rows * 4) as size_t)
                set xtra: nextslot
                set nextslot: nextslot + 1
            }
            set xs[ri]: xtra
            set ri: ri + 1
        }
        let mvp mv_v.data
        let psp ps_v.data
        let pp params.data
        var ai 0
        while ai < np
        {
            let node t.nodes.at(pp[ai])
            let total node.rows * node.cols
            scaly_mgpu_slot_alloc(nextslot as i32, (total * 2 * 4) as size_t)
            set mvp[ai]: nextslot
            set psp[ai]: pp[ai]
            set nextslot: nextslot + 1
            set ai: ai + 1
        }
        set g.tape: t
        set g.loss: loss_id
        set g.use_msl: msl
        set g.nnodes: nn
        set g.nparam: np
        set g.base: 0
        set g.fwd_only: 0
        set g.xslot: xs_v
        set g.mvslot: mv_v
        set g.pids: ps_v
        g
    }

    ; Forward-only alias attach: a SECOND graph beside the primary
    ; GpuTape (the single-window generation graph). Slots come from a
    ; reserved block appended to the registry - the primary is never
    ; reset. leaves[i] (a node id in t) aliases primary_leaves[i] (a
    ; node id in the primary's tape): same MTLBuffer, zero copies, the
    ; second graph reads the LIVE weights. Non-shared leaves allocate
    ; and copy like attach; no grad or Adam moment slots exist - step,
    ; step_adam and encode_bwd on the result are loud fatal errors.
    procedure attach_gen(mutable t: Tape, leaves: Vector[int], primary: ref[GpuTape], primary_leaves: Vector[int], msl: int) returns ref[GpuTape]
    {
        if scaly_mgpu_available() = 0
        {
            Console.println("error: GpuTape: no Metal device - there is no silent CPU fallback; check GpuTape.available() for a portable SKIP")
            exit(1)
        }
        if scaly_mgpu_init() <> 0
        {
            Console.println("error: GpuTape: Metal device init failed")
            exit(1)
        }
        if scaly_mgpu_ops_init() <> 0
        {
            Console.println("error: GpuTape: kernel library init failed")
            exit(1)
        }
        let nn t.nodes.get_length() as int
        let np leaves.length as int
        let hp Page.allocate_page()
        let g hp.allocate(sizeof GpuTape, alignof GpuTape) as pointer[GpuTape]
        var xs_v Vector[int]^hp(nn as size_t)
        var mv_v Vector[int]()
        var ps_v Vector[int]()
        let bs scaly_mgpu_slots_reserve((nn * 4 + nn) as i32) as int
        if bs < 0
        {
            Console.println("error: GpuTape: slot registry allocation failed")
            exit(1)
        }
        let lp leaves.data
        let plp primary_leaves.data
        let pbase primary.base
        let xs xs_v.data
        var nextslot bs + nn * 4
        var ri 0
        while ri < nn
        {
            let node t.nodes.at(ri)
            let count node.rows * node.cols
            let is_leaf node.op = 0
            var shared_of 0 - 1
            var si 0
            while si < np
            {
                if lp[si] = ri
                {
                    set shared_of: plp[si]
                    break
                }
                set si: si + 1
            }
            if count > 0
            {
                let bytes (count * 4) as size_t
                if shared_of >= 0
                    scaly_mgpu_slot_alias((bs + ri * 4) as i32, (pbase + shared_of * 4) as i32)
                else
                {
                    scaly_mgpu_slot_alloc((bs + ri * 4) as i32, bytes)
                    if is_leaf
                        scaly_mgpu_slot_write((bs + ri * 4) as i32, node.value.data as pointer[void], bytes)
                }
                let p scaly_mgpu_slot_contents((bs + ri * 4) as i32) as pointer[float]
                set node.value: Vector[float](count as size_t, p)
            }
            let auxlen node.aux.length as int
            if auxlen > 0
            {
                let abytes (auxlen * 4) as size_t
                scaly_mgpu_slot_alloc((bs + ri * 4 + 2) as i32, abytes)
                let ap scaly_mgpu_slot_contents((bs + ri * 4 + 2) as i32) as pointer[float]
                set node.aux: Vector[float](auxlen as size_t, ap)
            }
            let toklen node.tok.length as int
            if toklen > 0
            {
                let tbytes (toklen * 8) as size_t
                scaly_mgpu_slot_alloc((bs + ri * 4 + 3) as i32, tbytes)
                scaly_mgpu_slot_write((bs + ri * 4 + 3) as i32, node.tok.data as pointer[void], tbytes)
                let tkp scaly_mgpu_slot_contents((bs + ri * 4 + 3) as i32) as pointer[i64]
                set node.tok: Vector[i64](toklen as size_t, tkp)
            }
            var xtra 0 - 1
            if node.op = 4
            {
                scaly_mgpu_slot_alloc(nextslot as i32, (node.rows * 2 * 4) as size_t)
                set xtra: nextslot
                set nextslot: nextslot + 1
            }
            if node.op = 7
            {
                let na t.nodes.at(node.a)
                scaly_mgpu_slot_alloc(nextslot as i32, (na.rows * 4) as size_t)
                set xtra: nextslot
                set nextslot: nextslot + 1
            }
            set xs[ri]: xtra
            set ri: ri + 1
        }
        set g.tape: t
        set g.loss: 0 - 1
        set g.use_msl: msl
        set g.nnodes: nn
        set g.nparam: 0
        set g.base: bs
        set g.fwd_only: 1
        set g.xslot: xs_v
        set g.mvslot: mv_v
        set g.pids: ps_v
        g
    }

    ; 1 when a Metal device exists - the portable SKIP check.
    procedure available() returns i32
        scaly_mgpu_available()

    ; GPU-busy accounting (sums command-buffer GPU time).
    procedure ms_reset()
        scaly_mgpu_ms_reset()

    procedure ms_sum() returns double
        scaly_mgpu_ms_sum()

    ; Switch the matmul lowering: 0 = MPS GEMM (the hybrid default),
    ; 1 = the package's own MSL 4x4 kernels (single-encoder variant).
    procedure set_msl(mutable this: GpuTape, v: int)
    {
        set use_msl: v
    }

    ; Open a command buffer for manual encoding (per-op-sync mode).
    procedure begin(this: GpuTape)
    {
        scaly_mgpu_begin()
    }

    ; Commit + wait; 0 on completion.
    procedure commit_wait(this: GpuTape) returns int
        scaly_mgpu_commit_wait()

    ; Encode one node's forward op (kind codes are the tape ABI).
    ; Slot ids are base-relative: the primary's base is 0, an
    ; attach_gen graph lives in its reserved block.
    procedure encode_fwd(this: GpuTape, id: int)
    {
        let node tape.nodes.at(id)
        let kind node.op
        if kind = 0
            return
        let bb base
        let ia node.a
        let ib node.b
        let ic node.c
        let r node.rows
        let n node.cols
        let sv bb + id * 4
        let xs xslot.data
        if kind = 1
        {
            let na tape.nodes.at(ia)
            let nb tape.nodes.at(ib)
            let m na.rows
            let kk na.cols
            let nn nb.cols
            if use_msl = 1
                scaly_mgpu_enc_mm_nn((bb + ia * 4) as i32, (bb + ib * 4) as i32, sv as i32, m as i32, kk as i32, nn as i32)
            else
                scaly_mgpu_enc_gemm((bb + ia * 4) as i32, (bb + ib * 4) as i32, sv as i32, m as i32, kk as i32, kk as i32, nn as i32, 0 as i32, 0 as i32, 1.0, 0.0)
        }
        if kind = 2
            scaly_mgpu_enc_gelu_fwd((bb + ia * 4) as i32, sv as i32, (r * n) as i32)
        if kind = 4
            scaly_mgpu_enc_ln_fwd((bb + ia * 4) as i32, (bb + ib * 4) as i32, (bb + ic * 4) as i32, sv as i32, xs[id] as i32, r as i32, n as i32, node.eps)
        if kind = 5
            scaly_mgpu_enc_embed_fwd((bb + ia * 4) as i32, (bb + id * 4 + 3) as i32, sv as i32, r as i32, n as i32)
        if kind = 7
        {
            let na tape.nodes.at(ia)
            let rr na.rows
            let nn na.cols
            scaly_mgpu_enc_ce_fwd((bb + ia * 4) as i32, (bb + id * 4 + 3) as i32, xs[id] as i32, sv as i32, rr as i32, nn as i32)
        }
        if kind = 8
            scaly_mgpu_enc_attn_fwd((bb + ia * 4) as i32, (bb + ib * 4) as i32, (bb + ic * 4) as i32, sv as i32, (bb + id * 4 + 2) as i32, r as i32, n as i32, node.heads as i32, node.win as i32)
        if kind = 9
            scaly_mgpu_enc_add((bb + ia * 4) as i32, (bb + ib * 4) as i32, sv as i32, (r * n) as i32)
        if kind = 10
        {
            let nb tape.nodes.at(ib)
            let yr nb.rows
            scaly_mgpu_enc_add_bcast_fwd((bb + ia * 4) as i32, (bb + ib * 4) as i32, sv as i32, r as i32, n as i32, yr as i32)
        }
    }

    ; Encode one node's backward op. The CPU-blocked backwards each
    ; have an explicit race-free GPU form (column-disjoint embedding
    ; scatter and layernorm dgamma/dbeta, ordered attention passes) -
    ; never silent racing.
    procedure encode_bwd(this: GpuTape, id: int)
    {
        if fwd_only = 1
        {
            Console.println("error: GpuTape: backward on a forward-only (attach_gen) tape")
            exit(1)
        }
        let node tape.nodes.at(id)
        let kind node.op
        if kind = 0
            return
        let bb base
        let ia node.a
        let ib node.b
        let ic node.c
        let r node.rows
        let n node.cols
        let sg bb + id * 4 + 1
        let xs xslot.data
        if kind = 1
        {
            let na tape.nodes.at(ia)
            let nb tape.nodes.at(ib)
            let m na.rows
            let kk na.cols
            let nn nb.cols
            if use_msl = 1
            {
                scaly_mgpu_enc_mm_nt_acc(sg as i32, (bb + ib * 4) as i32, (bb + ia * 4 + 1) as i32, m as i32, kk as i32, nn as i32)
                scaly_mgpu_enc_mm_tn_acc((bb + ia * 4) as i32, sg as i32, (bb + ib * 4 + 1) as i32, m as i32, kk as i32, nn as i32)
            }
            else
            {
                scaly_mgpu_enc_gemm(sg as i32, (bb + ib * 4) as i32, (bb + ia * 4 + 1) as i32, m as i32, nn as i32, kk as i32, nn as i32, 0 as i32, 1 as i32, 1.0, 1.0)
                scaly_mgpu_enc_gemm((bb + ia * 4) as i32, sg as i32, (bb + ib * 4 + 1) as i32, m as i32, kk as i32, m as i32, nn as i32, 1 as i32, 0 as i32, 1.0, 1.0)
            }
        }
        if kind = 2
            scaly_mgpu_enc_gelu_bwd((bb + ia * 4) as i32, sg as i32, (bb + ia * 4 + 1) as i32, (r * n) as i32)
        if kind = 4
        {
            scaly_mgpu_enc_ln_bwd_dx((bb + ia * 4) as i32, (bb + ib * 4) as i32, sg as i32, (bb + ia * 4 + 1) as i32, xs[id] as i32, r as i32, n as i32)
            scaly_mgpu_enc_ln_bwd_dgb((bb + ia * 4) as i32, sg as i32, (bb + ib * 4 + 1) as i32, (bb + ic * 4 + 1) as i32, xs[id] as i32, r as i32, n as i32)
        }
        if kind = 5
            scaly_mgpu_enc_embed_bwd(sg as i32, (bb + id * 4 + 3) as i32, (bb + ia * 4 + 1) as i32, r as i32, n as i32)
        if kind = 7
        {
            let na tape.nodes.at(ia)
            let rr na.rows
            let nn na.cols
            scaly_mgpu_enc_ce_bwd((bb + ia * 4) as i32, (bb + id * 4 + 3) as i32, sg as i32, (bb + ia * 4 + 1) as i32, rr as i32, nn as i32)
        }
        if kind = 8
            scaly_mgpu_enc_attn_bwd((bb + ia * 4) as i32, (bb + ib * 4) as i32, (bb + ic * 4) as i32, sg as i32, (bb + id * 4 + 2) as i32, (bb + ia * 4 + 1) as i32, (bb + ib * 4 + 1) as i32, (bb + ic * 4 + 1) as i32, r as i32, n as i32, node.heads as i32, node.win as i32)
        if kind = 9
        {
            scaly_mgpu_enc_acc((bb + ia * 4 + 1) as i32, sg as i32, (r * n) as i32)
            scaly_mgpu_enc_acc((bb + ib * 4 + 1) as i32, sg as i32, (r * n) as i32)
        }
        if kind = 10
        {
            let nb tape.nodes.at(ib)
            let yr nb.rows
            scaly_mgpu_enc_acc((bb + ia * 4 + 1) as i32, sg as i32, (r * n) as i32)
            scaly_mgpu_enc_add_bcast_bwd_dy(sg as i32, (bb + ib * 4 + 1) as i32, r as i32, n as i32, yr as i32)
        }
    }

    ; Encode forward + grad-zero + loss seed + backward over the whole
    ; tape (no begin/commit - the parity test brackets it itself).
    procedure encode_step(this: GpuTape)
    {
        if fwd_only = 1
        {
            Console.println("error: GpuTape: step on a forward-only (attach_gen) tape")
            exit(1)
        }
        let bb base
        var i 0
        while i < nnodes
        {
            this.encode_fwd(i)
            set i: i + 1
        }
        var z 0
        while z < nnodes
        {
            let node tape.nodes.at(z)
            let count node.rows * node.cols
            if count > 0
                scaly_mgpu_enc_fill((bb + z * 4 + 1) as i32, count as i32, 0.0)
            set z: z + 1
        }
        let lnode tape.nodes.at(loss)
        let lcount lnode.rows * lnode.cols
        scaly_mgpu_enc_fill((bb + loss * 4 + 1) as i32, lcount as i32, 1.0)
        var j loss
        while j >= 0
        {
            this.encode_bwd(j)
            set j: j - 1
        }
    }

    ; Encode the forward walk only (autoregressive generation).
    procedure encode_fwd_all(this: GpuTape)
    {
        var i 0
        while i < nnodes
        {
            this.encode_fwd(i)
            set i: i + 1
        }
    }

    ; Encode one Adam update per parameter (bias corrections are
    ; CPU-precomputed floats - powf per step, not per element).
    procedure encode_adam(this: GpuTape, lr: float, b1: float, b2: float, eps: float, bc1: float, bc2: float)
    {
        let bb base
        let pp pids.data
        let mvp mvslot.data
        var i 0
        while i < nparam
        {
            let node tape.nodes.at(pp[i])
            let total node.rows * node.cols
            scaly_mgpu_enc_adam((bb + pp[i] * 4) as i32, (bb + pp[i] * 4 + 1) as i32, mvp[i] as i32, total as i32, lr, b1, b2, eps, bc1, bc2)
            set i: i + 1
        }
    }

    ; ONE training step = ONE command buffer: forward, grad zeroing,
    ; loss seed, backward, Adam - one commit, one wait. A failed
    ; command buffer is fatal (no silent partial step).
    procedure step(this: GpuTape, lr: float, b1: float, b2: float, eps: float, stepn: int)
    {
        scaly_mgpu_begin()
        this.encode_step()
        let bc1 1.0 - powf(b1, stepn as float)
        let bc2 1.0 - powf(b2, stepn as float)
        this.encode_adam(lr, b1, b2, eps, bc1, bc2)
        let rc scaly_mgpu_commit_wait()
        if rc <> 0
        {
            Console.println("error: GpuTape: command buffer failed")
            exit(1)
        }
    }

    ; Adam only, as its own command buffer (parity testing against the
    ; CPU tape op; grads must already be in the redirected buffers).
    procedure step_adam(this: GpuTape, lr: float, b1: float, b2: float, eps: float, stepn: int)
    {
        if fwd_only = 1
        {
            Console.println("error: GpuTape: step_adam on a forward-only (attach_gen) tape")
            exit(1)
        }
        scaly_mgpu_begin()
        let bc1 1.0 - powf(b1, stepn as float)
        let bc2 1.0 - powf(b2, stepn as float)
        this.encode_adam(lr, b1, b2, eps, bc1, bc2)
        let rc scaly_mgpu_commit_wait()
        if rc <> 0
        {
            Console.println("error: GpuTape: command buffer failed")
            exit(1)
        }
    }

    ; Forward pass as one command buffer (generation; sampling stays
    ; on the CPU through unified memory).
    procedure fwd(this: GpuTape)
    {
        scaly_mgpu_begin()
        this.encode_fwd_all()
        let rc scaly_mgpu_commit_wait()
        if rc <> 0
        {
            Console.println("error: GpuTape: command buffer failed")
            exit(1)
        }
    }

    ; Save the parameter values (cfg ints as the header, then raw f32
    ; per parameter in params order). 1 when written, 0 when the file
    ; could not be opened.
    procedure save(this: GpuTape, path: pointer[const_char], cfg: Vector[i32]) returns int
    {
        let f fopen(path, "wb")
        if f = null
            return 0
        fwrite(cfg.data as pointer[void], 4, cfg.length, f)
        let pp pids.data
        var i 0
        while i < nparam
        {
            let node tape.nodes.at(pp[i])
            let total node.rows * node.cols
            fwrite(node.value.data as pointer[void], 4, total as size_t, f)
            set i: i + 1
        }
        fclose(f)
        1
    }

    ; Load a checkpoint written by save. 0 when the file does not
    ; exist (train instead); a config-header mismatch is FATAL - a
    ; silently misloaded model would be the hidden magic this package
    ; exists to rule out. Writes go through the redirected pointers
    ; straight into the MTLBuffers.
    procedure load(mutable this: GpuTape, path: pointer[const_char], cfg: Vector[i32]) returns int
    {
        let f fopen(path, "rb")
        if f = null
            return 0
        let clen cfg.length as int
        var hdr Vector[i32](cfg.length)
        let got fread(hdr.data as pointer[void], 4, cfg.length, f)
        var ok 1
        if (got as int) <> clen
            set ok: 0
        let hp hdr.data
        let cp cfg.data
        var i 0
        while i < clen
        {
            if hp[i] as int <> cp[i] as int
                set ok: 0
            set i: i + 1
        }
        if ok = 0
        {
            Console.println("error: GpuTape: checkpoint config mismatch - delete it or match the model config")
            exit(1)
        }
        let pp pids.data
        var li 0
        while li < nparam
        {
            let node tape.nodes.at(pp[li])
            let total node.rows * node.cols
            fread(node.value.data as pointer[void], 4, total as size_t, f)
            set li: li + 1
        }
        fclose(f)
        1
    }
}
