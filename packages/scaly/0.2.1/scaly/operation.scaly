    operator xor(this)
        OpXorWaits(OpOrOrWaits(outer, left), right)
    operator |(this)
        OpBitOrWaits(OpOrOrWaits(outer, left), right)
    operator and(this)
        OpAndWaits(OpOrOrWaits(outer, left), right)
    operator &&(this)
        OpAndAndWaits(OpOrOrWaits(outer, left), right)
    operator or(this)
        outer.apply(left.||(right)) or
    operator ||(this)
        outer.apply(left.||(right)) ||
    operator 'other'(this)
        outer.apply(left.||(right)) 'other'
    function finish(this)
        outer.apply(left.||(right)).finish()
}

; `left other`, waiting for its right operand
define OpOtherWaits[O, L] pending @operator "other" @level "declared" @others true (outer: O, left: L)
{
    function apply(this, right)
        OpOther(outer, left, right)
}

; `left other right`, waiting to see what follows
define OpOther[O, L, R] pending @operator "other" @level "declared" @others true (outer: O, left: L, right: R)
{
    operator *(this)
        OpTimesWaits(OpOtherWaits(outer, left), right)
    operator /(this)
        OpDivideWaits(OpOtherWaits(outer, left), right)
    operator %(this)
        OpRemainderWaits(OpOtherWaits(outer, left), right)
    operator div(this)
        OpDivWaits(OpOtherWaits(outer, left), right)
    operator mod(this)
        OpModWaits(OpOtherWaits(outer, left), right)
    operator +(this)
        OpPlusWaits(OpOtherWaits(outer, left), right)
    operator -(this)
        OpMinusWaits(OpOtherWaits(outer, left), right)
    operator <<(this)
        OpShiftLeftWaits(OpOtherWaits(outer, left), right)
    operator >>(this)
        OpShiftRightWaits(OpOtherWaits(outer, left), right)
    operator <(this)
        OpLessWaits(OpOtherWaits(outer, left), right)
    operator >(this)
        OpGreaterWaits(OpOtherWaits(outer, left), right)
    operator <=(this)
        OpLessOrEqualWaits(OpOtherWaits(outer, left), right)
    operator >=(this)
        OpGreaterOrEqualWaits(OpOtherWaits(outer, left), right)
    operator =(this)
        OpEqualWaits(OpOtherWaits(outer, left), right)
    operator <>(this)
        OpUnequalWaits(OpOtherWaits(outer, left), right)
    operator &(this)
        OpBitAndWaits(OpOtherWaits(outer, left), right)
    operator xor(this)
        OpXorWaits(OpOtherWaits(outer, left), right)
    operator |(this)
        OpBitOrWaits(OpOtherWaits(outer, left), right)
    operator and(this)
        OpAndWaits(OpOtherWaits(outer, left), right)
    operator &&(this)
        OpAndAndWaits(OpOtherWaits(outer, left), right)
    operator or(this)
        OpOrWaits(OpOtherWaits(outer, left), right)
    operator ||(this)
        OpOrOrWaits(OpOtherWaits(outer, left), right)
    operator 'other'(this)
        outer.apply(left.'other'(right)) 'other'
    function finish(this)
        outer.apply(left.'other'(right)).finish()
}
