; crypto.scaly - SHA-256 (FIPS 180-4) and HMAC-SHA256 (RFC 2104)
;
; What the cluster's key needs (cluster.scaly, the handshake): a digest of
; a short message and the keyed one over it. Written here, from the two
; standards, because the runtime cannot depend on a package (tls has
; OpenSSL). Not for bulk data: a message is copied once into its padded
; form.
;
;   var out Vector[u8](32)
;   Sha256.digest(text.as_slice(), out.as_slice())
;   Hmac.sha256(key, message, out.as_slice())
;
; The 32 bytes go into `out`, which must hold at least 32.

; the round constants: the first 32 bits of the fractional parts of the cube
; roots of the first 64 primes (one line: a line break in [] begins a row)
define SHA256_K: u32[] [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967, 0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]

define Sha256
{
    function rotate(x: u32, n: u32) returns u32
        (x >> n) | (x << (32 - n))

    ; The digest of `data` into out[0..32).
    procedure digest(data: Slice[u8], mutable out: Slice[u8])
    {
        ; the message, a one bit, zeros, and its length in bits (64 of them,
        ; big-endian), to a whole number of 64-byte blocks
        let n data.length
        var padded_len (n + 9 + 63) / 64 * 64
        var m Vector[u8](padded_len)
        var i: size_t 0
        while i < n
        {
            m.put(i, data[i])
            i := i + 1
        }
        m.put(n, 0x80 as u8)
        let bits n * 8
        var b: size_t 0
        while b < 8
        {
            m.put(padded_len - 1 - b, ((bits >> (b * 8)) & 0xff) as u8)
            b := b + 1
        }

        var h0: u32 0x6a09e667
        var h1: u32 0xbb67ae85
        var h2: u32 0x3c6ef372
        var h3: u32 0xa54ff53a
        var h4: u32 0x510e527f
        var h5: u32 0x9b05688c
        var h6: u32 0x1f83d9ab
        var h7: u32 0x5be0cd19
        var w Vector[u32](64)
        var block: size_t 0
        while block < padded_len
        {
            var t: size_t 0
            while t < 16
            {
                let at block + t * 4
                let word ((m[at] as u32) << 24) | ((m[at + 1] as u32) << 16) | ((m[at + 2] as u32) << 8) | (m[at + 3] as u32)
                w.put(t, word)
                t := t + 1
            }
            while t < 64
            {
                let x w[t - 15]
                let y w[t - 2]
                let s0 Sha256.rotate(x, 7) xor Sha256.rotate(x, 18) xor (x >> 3)
                let s1 Sha256.rotate(y, 17) xor Sha256.rotate(y, 19) xor (y >> 10)
                w.put(t, w[t - 16] + s0 + w[t - 7] + s1)
                t := t + 1
            }
            var a h0
            var bb h1
            var c h2
            var d h3
            var e h4
            var f h5
            var g h6
            var h h7
            t := 0
            while t < 64
            {
                let s1 Sha256.rotate(e, 6) xor Sha256.rotate(e, 11) xor Sha256.rotate(e, 25)
                let ch (e & f) xor ((~e) & g)
                let t1 h + s1 + ch + SHA256_K[t] + w[t]
                let s0 Sha256.rotate(a, 2) xor Sha256.rotate(a, 13) xor Sha256.rotate(a, 22)
                let maj (a & bb) xor (a & c) xor (bb & c)
                let t2 s0 + maj
                h := g
                g := f
                f := e
                e := d + t1
                d := c
                c := bb
                bb := a
                a := t1 + t2
                t := t + 1
            }
            h0 := h0 + a
            h1 := h1 + bb
            h2 := h2 + c
            h3 := h3 + d
            h4 := h4 + e
            h5 := h5 + f
            h6 := h6 + g
            h7 := h7 + h
            block := block + 64
        }
        Sha256.put_word(out, 0, h0)
        Sha256.put_word(out, 4, h1)
        Sha256.put_word(out, 8, h2)
        Sha256.put_word(out, 12, h3)
        Sha256.put_word(out, 16, h4)
        Sha256.put_word(out, 20, h5)
        Sha256.put_word(out, 24, h6)
        Sha256.put_word(out, 28, h7)
    }

    procedure put_word(mutable out: Slice[u8], at: size_t, word: u32)
    {
        out.put(at, ((word >> 24) & 0xff) as u8)
        out.put(at + 1, ((word >> 16) & 0xff) as u8)
        out.put(at + 2, ((word >> 8) & 0xff) as u8)
        out.put(at + 3, (word & 0xff) as u8)
    }
}

define Hmac
{
    ; HMAC-SHA256 of `message` under `key` into out[0..32): a key longer
    ; than a block is its digest first, a shorter one padded with zeros.
    procedure sha256(key: Slice[u8], message: Slice[u8], mutable out: Slice[u8])
    {
        var k Vector[u8](64)
        if key.length > 64
        {
            var kd Vector[u8](32)
            Sha256.digest(key, kd.as_slice())
            var i: size_t 0
            while i < 32
            {
                k.put(i, kd[i])
                i := i + 1
            }
        }
        else
        {
            var i: size_t 0
            while i < key.length
            {
                k.put(i, key[i])
                i := i + 1
            }
        }
        ; inner: (k xor ipad) ++ message
        var inner Vector[u8](64 + message.length)
        var i: size_t 0
        while i < 64
        {
            inner.put(i, k[i] xor (0x36 as u8))
            i := i + 1
        }
        i := 0
        while i < message.length
        {
            inner.put(64 + i, message[i])
            i := i + 1
        }
        var inner_digest Vector[u8](32)
        Sha256.digest(inner.as_slice(), inner_digest.as_slice())
        ; outer: (k xor opad) ++ inner digest
        var outer Vector[u8](96)
        i := 0
        while i < 64
        {
            outer.put(i, k[i] xor (0x5c as u8))
            i := i + 1
        }
        i := 0
        while i < 32
        {
            outer.put(64 + i, inner_digest[i])
            i := i + 1
        }
        Sha256.digest(outer.as_slice(), out)
    }

    ; Do two digests agree, in time that does not depend on where they
    ; differ (a comparison that stops early tells an attacker how much of
    ; a forged digest was right)?
    function same(a: Slice[u8], b: Slice[u8]) returns bool
    {
        if a.length <> b.length
            return false
        var diff: u8 0
        var i: size_t 0
        while i < a.length
        {
            diff := diff | (a[i] xor b[i])
            i := i + 1
        }
        diff = 0
    }
}
