; Node runtime (self-scaling stage 7, milestone 7.3) — remote channels
; over TCP with the failure-semantics memo implemented
; (rules 1-6, 8, 10):
;
;   let lfd Cluster.listen(port)              ; INADDR_ANY; 0 = ephemeral
;   let peer Cluster.accept(lfd)              ; handshake; null = refused
;   let peer Cluster.connect("host", port)    ; getaddrinfo; null = refused
;   let ch Cluster.channel(peer, id)          ; local Channel fed by the peer
;   Cluster.send(peer, id, msg)               ; region OWNERSHIP MOVES, always
;   let rr Channel.receive(ch)             ; pointer[ReceivedRegion]; null =
;                                          ;   peer closed OR died (rule 2)
;   rr.fix_graph(root)                     ; the 7.2 compiler walkers
;   Cluster.dispose_message(rr)               ; region + host page die
;   let mon Cluster.monitor(peer)             ; down-notice channel (rule 5)
;   Cluster.close(peer)                       ; BYE + local close
;   Cluster.dispose_peer(peer)                ; join reader, free the record
;
; Death = channel CLOSE (rule 2): when the peer is suspected dead — TCP
; EOF/reset, a framing violation, or heartbeat silence past
; NODE_SUSPECT_MS (rule 1: suspicion, never a fact) — every channel from
; it closes (parked receivers wake with null, exactly the 2.4 semantics)
; and every monitor receives one NodeDown message, then closes. Sends
; are fire-and-forget, at-most-once, FIFO per channel (rule 3); the
; message region is serialized and freed at the send, unconditionally
; (rule 4) — a send to a suspected-dead peer is silently dropped, never
; an error. Timeouts stay explicit (rule 6): Channel.receive_timeout;
; the heartbeat pair NODE_HEARTBEAT_MS/NODE_SUSPECT_MS is the one named
; hidden deadline. The trust boundary is the cluster edge (rule 8):
; framing and page-table sanity are validated, object graphs are not --
; so who may join is decided before the first frame: a cluster without a
; key (SCALY_CLUSTER_KEY, ~/.scaly/cluster.key) stays on this machine
; (a peer must be a loopback address, Cluster.listen binds 127.0.0.1), and
; one with a key admits only a peer that proves it holds the same key
; (Cluster.prove#: HMAC-SHA256 over a challenge each way). Integrity of
; the frames after it, and their confidentiality, come with TLS (still
; to be built): the key keeps strangers out, not eavesdroppers.
;
; Helpers and rounds. A program started with --scaly-helper is a helper
; (scaly_helper_main: it announces itself to the helpers' multicast group
; and serves coordinators); Helpers.find# is how a coordinator finds those
; of its own build. Built with `scalyc --cluster`, a parallel `for` whose
; captures can travel has a descriptor (scaly_cluster_register), and its
; head asks scaly_cluster_offer# first: with SCALY_CLUSTER=on and helpers
; there, its rounds go to them in stretches and what they put comes back;
; otherwise -- no helper, or none left -- the loop runs here as always.

; The handshake preamble [magic, protocol version, build stamp] (all
; u64, 24 bytes, sent immediately in BOTH directions) is the one wire
; structure whose layout is FROZEN FOREVER — it must stay parseable
; across arbitrarily different builds so mismatched binaries cleanly
; refuse instead of misparsing each other (rule 10). The stamp is the
; program's scaly_build_stamp() (the Emitter's FNV-1a-64 of the
; pre-stamp module IR); a mismatch refuses the connection loudly with
; both stamps in the error.
;
; One reader THREAD per connection owns the fd: it reads frames
; [kind, id, length] + body, delivers each DATA body — deserialized
; into real pages via Region.deserialize — as a pointer[ReceivedRegion]
; through the id's local Channel, sends heartbeats when the line is
; idle (skipped under write contention on purpose: flowing data is its
; own liveness signal), declares suspicion, and closes the fd LAST,
; after a write-lock barrier, so a racing Cluster.send can never touch a
; reused fd number.
;
; Exit code: 113 = node channel/monitor table full (NODE_MAX_CHANNELS —
; a v1 capacity, raise it when something real needs more).

use scaly.memory.Page
use scaly.memory.Region
use scaly.memory.Region.ReceivedRegion
use scaly.fiber.Channel
use scaly.fiber.Thread
use scaly.crypto.Hmac
use scaly.os.File
use scaly.fiber.Io
use scaly.fiber.Scheduler

; The program's build stamp — defined by the Emitter in every program
; module (rule 10); a library archive only declares it.
function scaly_build_stamp() returns u64 extern

; "SCALYNOD", little-endian.
define NODE_WIRE_MAGIC u64 0x444f4e594c414353
; 2 (2026-11-13): after the preamble, the key's handshake (Cluster.prove#)
define NODE_PROTO_VERSION u64 2

define NODE_FRAME_DATA u64 1
define NODE_FRAME_HEARTBEAT u64 2
define NODE_FRAME_BYE u64 3

; The heartbeat cadence and the silence deadline after which a peer is
; SUSPECTED dead (memo rule 1) — the one hidden deadline in the system
; (rule 6), named here.
define NODE_HEARTBEAT_MS i64 500
define NODE_SUSPECT_MS i64 2500

define NODE_MAX_CHANNELS size_t 64
define NODE_MAX_FRAME size_t 0x40000000

; NodeDown.reason values.
define NODE_DOWN_CLOSED i64 1
define NODE_DOWN_SUSPECT i64 2

; The monitor's down notice (memo rule 5): one NodeDown message on the
; monitor channel, then the channel closes. A plain local message — the
; receiver frees it like any channel message (Page.get + release).
define NodeDown
(
    reason: i64
)

; One connected peer. The record and its channel/monitor tables live on
; their own heap page (shared cross-thread, like a Channel record).
; lock guards the tables + alive/down_reason; wlock serializes frame
; writes (Cluster.send from app threads vs the reader's heartbeats);
; last_rx is written only by the reader.
; the helpers (ROADMAP-cluster.md, C1; their code at the end of this file)
define HELPER_GROUP_PORT i32 47790
define HELPER_ANNOUNCE u64 0x4552504c45484c53
define HELPER_ASK u64 0x4b5341594c414353
define HELPER_DATAGRAM size_t 96
define HELPER_CHANNEL u64 900

; Rounds on other machines (ROADMAP-cluster.md, C2). A parallel `for` the
; compiler (--cluster) found fit has a DESCRIPTOR: its task function -- the
; outlined body the cores run -- and the layout of its cell, words of i64:
;   [hash, cell bytes, offset of lo, of hi, of the cancel word, captures,
;    then per capture: offset, kind, bytes]
; kind 1 a plain value of `bytes` bytes (17: the cell holds its address);
; 2 a buffer the rounds read and 4
; one they put into at their counter, both (length, data) -- a Vector or a
; Slice --, 3 and 5 the same as an Array (length, capacity, buffer), `bytes`
; an element's; +16 where the cell holds the buffer record's address, not
; the record. The hash names the loop the same in every build of the program.
define CLUSTER_RESULT u64 901
define CLUSTER_TABLE_MOST size_t 4096

; A stretch of rounds for a helper: the loop, the rounds, the cell as the
; coordinator filled it, and every buffer the rounds read, whole. Like
; every message it is the FIRST object on its page (Cluster.send sends the
; region from the page the message lies on), so its parts are given to it
; after it is made.
define ClusterJob
(
    hash: u64
    lo: i64
    hi: i64
    var cell: Vector[u8]
    var inputs: Vector[Vector[u8]]
)

; What a helper's rounds put: one stretch per buffer they write, lo to hi.
define ClusterResult
(
    lo: i64
    hi: i64
    ok: bool
    var outputs: Vector[Vector[u8]]
)

; The loops of this program a helper can run (scaly_cluster_register), and
; the helpers a coordinator holds connections to (Cluster.helpers#).
shared cluster_table: pointer[pointer[void]] null
shared cluster_table_count: size_t 0
shared cluster_peers: pointer[pointer[NodePeer]] null
shared cluster_peer_count: size_t 0
shared cluster_peers_asked: bool false
; One offer at a time, and none in a helper: a loop inside a loop's rounds
; -- on a worker of this machine or in a helper -- runs where its rounds
; run (1 while an offer is under way, 2 for good in a helper).
shared atomic cluster_offering: u64 0

; A helper a coordinator found: where it listens, how many cores it has.
define HelperFound
(
    host: String
    port: i32
    cores: i64
    id: u64
)

; What a helper's announcer thread knows.
define HelperState
(
    mfd: i32
    id: u64
    port: i32
    cores: i64
    key: String
    local_only: i32
)

define NodePeer
(
    lock: u64
    fd: i32
    var alive: bool
    peer_stamp: u64
    chan_ids: pointer[u64]
    chans: pointer[pointer[Channel]]
    var chan_count: size_t
    monitors: pointer[pointer[Channel]]
    var monitor_count: size_t
    wlock: u64
    var last_rx: i64
    reader: size_t
    var down_reason: i64
)

; The reader thread's entry (free procedure: taken with &).
procedure node_reader_entry(mutable arg: pointer[void]) returns pointer[void]
{
    let p arg as ref[NodePeer]
    Cluster.reader_loop(p)
    null
}

define Cluster
{
    ; --- spinlocks (the Channel.acquire CAS pattern) ---

    procedure acquire(p: pointer[NodePeer])
    {
        let lp &p.lock
        repeat
        {
            if scaly_atomic_cas_u64(lp, 0 as u64, 1 as u64) = 0
                break
        }
    }

    procedure release(p: pointer[NodePeer])
    {
        let lp &p.lock
        scaly_atomic_store_u64(lp, 0 as u64)
    }

    procedure wacquire(p: pointer[NodePeer])
    {
        let lp &p.wlock
        repeat
        {
            if scaly_atomic_cas_u64(lp, 0 as u64, 1 as u64) = 0
                break
        }
    }

    function try_wacquire(p: pointer[NodePeer]) returns bool
    {
        let lp &p.wlock
        scaly_atomic_cas_u64(lp, 0 as u64, 1 as u64) = 0
    }

    procedure wrelease(p: pointer[NodePeer])
    {
        let lp &p.wlock
        scaly_atomic_store_u64(lp, 0 as u64)
    }

    ; --- connection surface ---

    ; Listen on ALL interfaces (a cluster node accepts real remote
    ; peers) -- where the cluster has a key; without one on this machine
    ; only (127.0.0.1): a cluster beyond it needs the key (Cluster.key#).
    ; 0 asks for an ephemeral port; Cluster.local_port reads it.
    procedure listen(port: i32) returns i32
    {
        if Cluster.key().get_length() = 0
            return Io.listen(port)
        Io.listen_any(port)
    }

    ; The cluster's key (ROADMAP-cluster.md): SCALY_CLUSTER_KEY, else the
    ; file ~/.scaly/cluster.key, a line break at its end left out; "" where
    ; there is none -- and then every peer must be on this machine.
    procedure key() returns String
    {
        let v getenv("SCALY_CLUSTER_KEY")
        if v <> null and strlen(v) > 0
            return String(v)
        let home getenv("HOME")
        if home = null
            return String()
        let path "`String(home)`/.scaly/cluster.key"
        if File.exists(path) = false
            return String()
        let text File.read_to_string(path)
        var n text.get_length()
        while n > 0 and (text.get(n - 1) = ("\n" as char) or text.get(n - 1) = ("\r" as char))
            n := n - 1
        text.substring(0, n)
    }

    procedure local_port(fd: i32) returns i32
        Io.local_port(fd)

    ; Accept one peer: TCP accept, then the frozen-preamble handshake.
    ; Returns null when the connect was refused (mismatch — already
    ; reported loudly) or the transport failed.
    procedure accept(lfd: i32) returns ref[NodePeer]?
    {
        let fd Io.accept(lfd)
        if fd < 0
            return null
        Cluster.setup(fd, true)
    }

    ; Connect to host:port (getaddrinfo — real hosts), then the frozen-
    ; preamble handshake. host must be NUL-terminated (a string
    ; literal, or String.to_c_string). Returns null when refused.
    procedure connect(mutable host: pointer[const_char], port: i32) returns ref[NodePeer]?
    {
        let fd Io.connect_host(host, port)
        if fd < 0
            return null
        Cluster.setup(fd, false)
    }

    ; connect, trying again while the other node is not listening yet,
    ; for up to ms milliseconds (memo rule 6: the wait is written where
    ; it is waited). A refused handshake does not retry.
    procedure connect(mutable host: pointer[const_char], port: i32, ms: int) returns ref[NodePeer]?
    {
        let deadline scaly_eio_now_ns() + ms * 1000000
        repeat
        {
            let fd Io.connect_host(host, port)
            if fd >= 0
                return Cluster.setup(fd, false)
            if scaly_eio_now_ns() >= deadline
                return null
            poll(null as pointer[pollfd], 0, 20)
        }
    }

    ; Say goodbye and free the peer: close, wait for the reader, release
    ; the record and the channels that came from it. After it nothing
    ; receives from this peer any more.
    procedure disconnect(mutable p: ref[NodePeer])
    {
        Cluster.close(p)
        Thread.join(p.reader)
        let chs p.chans
        var i: size_t 0
        while i < p.chan_count
        {
            Channel.dispose(chs[i] as ref[Channel])
            i := i + 1
        }
        let pp Page.get(p)
        pp.deallocate_extensions()
        Page.release_page(pp)
    }

    ; Both directions run the same handshake: send our preamble
    ; immediately, read theirs, compare BEFORE any other byte is
    ; parsed. Mismatch = loud refuse with both stamps (rule 10).
    procedure setup(fd: i32, accepting: bool) returns ref[NodePeer]?
    {
        var pre u8[24]
        let pw pre as pointer[u64]
        pw[0] := NODE_WIRE_MAGIC
        pw[1] := NODE_PROTO_VERSION
        pw[2] := scaly_build_stamp()
        if Io.tcp_write_all(fd, pre as pointer[void], 24) = false
        {
            close(fd)
            return null
        }
        var inb u8[24]
        var got: size_t 0
        while got < 24
        {
            let r Io.read(fd, ((inb as size_t) + got) as pointer[void], 24 - got)
            if r <= 0
            {
                close(fd)
                return null
            }
            got := got + (r as size_t)
        }
        let iw inb as pointer[u64]
        let magic iw[0]
        if magic <> NODE_WIRE_MAGIC
        {
            scaly_eputs "node: connect refused - peer is not a scaly node (bad preamble magic)"
            scaly_eputnl()
            close(fd)
            return null
        }
        let proto iw[1]
        if proto <> NODE_PROTO_VERSION
        {
            scaly_eputs "node: connect refused - protocol version mismatch: local "
            scaly_eputi(NODE_PROTO_VERSION as i64)
            scaly_eputs " peer "
            scaly_eputi(proto as i64)
            scaly_eputnl()
            close(fd)
            return null
        }
        let mine scaly_build_stamp()
        let theirs iw[2]
        if theirs <> mine
        {
            scaly_eputs "node: connect refused - build stamp mismatch (one cluster, one build): local "
            scaly_eputp((mine as size_t) as pointer[void])
            scaly_eputs " peer "
            scaly_eputp((theirs as size_t) as pointer[void])
            scaly_eputnl()
            close(fd)
            return null
        }
        if Cluster.prove(fd, accepting, mine) = false
        {
            close(fd)
            return null
        }

        let p Page.allocate_page()
        let np &NodePeer^p(0, fd, true, theirs, p.allocate(NODE_MAX_CHANNELS * 8, 8) as pointer[u64], p.allocate(NODE_MAX_CHANNELS * 8, 8) as pointer[pointer[Channel]], 0, p.allocate(NODE_MAX_CHANNELS * 8, 8) as pointer[pointer[Channel]], 0, 0, scaly_eio_now_ns(), 0, 0)
        Io.set_nonblocking(fd)
        let handle Thread.spawn(&node_reader_entry, np as pointer[void])
        np.reader := handle
        np
    }

    ; --- the key ---

    ; After the preamble, on a blocking socket: each side says whether it
    ; has a key. Without one on either side the peer must be on this
    ; machine. With one on both, each proves it holds the same key: it
    ; sends 32 random bytes, then HMAC-SHA256(key, role ++ the other's
    ; bytes ++ its own ++ stamp) -- the role ("A" accepting, "C"
    ; connecting) keeps a side from reflecting the other's proof back to
    ; it, the bytes from replaying an old one. The proof is compared in
    ; time that does not depend on where it differs. A mismatch is a loud
    ; refusal, as a stamp's is.
    procedure prove(fd: i32, accepting: bool, stamp: u64) returns bool
    {
        let key Cluster.key()
        var mode u8[8]
        let mw mode as pointer[u64]
        mw[0] := if key.get_length() > 0: (1 as u64) else 0
        if Io.tcp_write_all(fd, mode as pointer[void], 8) = false
            return false
        var theirs u8[8]
        if Cluster.read_exactly(fd, theirs as pointer[void], 8) = false
            return false
        let tw theirs as pointer[u64]
        if tw[0] <> mw[0]
        {
            scaly_eputs "node: connect refused - one node has a cluster key (SCALY_CLUSTER_KEY), the other has none"
            scaly_eputnl()
            return false
        }
        if mw[0] = 0
        {
            if scaly_eio_peer_is_local(fd) <> 1
            {
                scaly_eputs "node: connect refused - a cluster beyond this machine needs a key (SCALY_CLUSTER_KEY or ~/.scaly/cluster.key)"
                scaly_eputnl()
                return false
            }
            return true
        }
        var mine_nonce u8[32]
        if scaly_eio_random(mine_nonce as pointer[void], 32) <> 0
            return false
        if Io.tcp_write_all(fd, mine_nonce as pointer[void], 32) = false
            return false
        var their_nonce u8[32]
        if Cluster.read_exactly(fd, their_nonce as pointer[void], 32) = false
            return false
        let mine_view Slice[u8](32, mine_nonce as pointer[u8])
        let their_view Slice[u8](32, their_nonce as pointer[u8])
        if Hmac.same(mine_view, their_view)
        {
            scaly_eputs "node: connect refused - the peer answered our own challenge"
            scaly_eputnl()
            return false
        }
        let my_role if accepting: ("A" as char) else ("C" as char)
        let their_role if accepting: ("C" as char) else ("A" as char)
        var proof Vector[u8](32)
        Cluster.proof(key, my_role, their_view, mine_view, stamp, proof.as_slice())
        if Io.tcp_write_all(fd, proof.data as pointer[void], 32) = false
            return false
        var got u8[32]
        if Cluster.read_exactly(fd, got as pointer[void], 32) = false
            return false
        var expected Vector[u8](32)
        Cluster.proof(key, their_role, mine_view, their_view, stamp, expected.as_slice())
        if Hmac.same(expected.as_slice(), Slice[u8](32, got as pointer[u8])) = false
        {
            scaly_eputs "node: connect refused - the peer does not hold this cluster's key"
            scaly_eputnl()
            return false
        }
        true
    }

    ; --- the helpers' datagrams ---

    ; A helper's announcement of itself (its id, port and cores) to the group.
    procedure announce(st: ref[HelperState])
    {
        var d Vector[u8](HELPER_DATAGRAM)
        Cluster.fill_datagram(d.as_slice(), HELPER_ANNOUNCE, st.id, st.port, st.cores, st.key)
        scaly_eio_mcast_send(d.data as pointer[void], HELPER_DATAGRAM, HELPER_GROUP_PORT, st.local_only)
    }

    ; A datagram: [kind, protocol, stamp, id, port, cores, 0, 0], then the
    ; HMAC over those 64 bytes under the key (32 zeros without one).
    procedure fill_datagram(mutable out: Slice[u8], kind: u64, id: u64, port: i32, cores: i64, key: String)
    {
        Cluster.put_word(out, 0, kind)
        Cluster.put_word(out, 1, NODE_PROTO_VERSION)
        Cluster.put_word(out, 2, scaly_build_stamp())
        Cluster.put_word(out, 3, id)
        Cluster.put_word(out, 4, port as u64)
        Cluster.put_word(out, 5, cores as u64)
        Cluster.put_word(out, 6, 0)
        Cluster.put_word(out, 7, 0)
        var mac Vector[u8](32)
        if key.get_length() > 0
            Hmac.sha256(key.as_slice(), Slice[u8](64, out.data), mac.as_slice())
        var i: size_t 0
        while i < 32
        {
            out.put(64 + i, mac[i])
            i := i + 1
        }
    }

    ; Is it a datagram of this kind, this protocol and this build, and does
    ; its HMAC hold under the key?
    procedure datagram_ok(d: Slice[u8], kind: u64, key: String) returns bool
    {
        if d.length <> HELPER_DATAGRAM
            return false
        if Cluster.word_at(d, 0) <> kind or Cluster.word_at(d, 1) <> NODE_PROTO_VERSION or Cluster.word_at(d, 2) <> scaly_build_stamp()
            return false
        var mac Vector[u8](32)
        if key.get_length() > 0
            Hmac.sha256(key.as_slice(), Slice[u8](64, d.data), mac.as_slice())
        Hmac.same(mac.as_slice(), Slice[u8](32, ((d.data as size_t) + 64) as pointer[u8]))
    }

    ; Word k of a datagram, little-endian.
    function word_at(d: Slice[u8], k: size_t) returns u64
    {
        var v: u64 0
        var b: size_t 0
        while b < 8
        {
            v := v | ((d[k * 8 + b] as u64) << (b * 8))
            b := b + 1
        }
        v
    }

    procedure put_word(mutable d: Slice[u8], k: size_t, v: u64)
    {
        var b: size_t 0
        while b < 8
        {
            d.put(k * 8 + b, ((v >> (b * 8)) & 0xff) as u8)
            b := b + 1
        }
    }

    ; HMAC-SHA256(key, role ++ challenge ++ answer ++ stamp) into out.
    procedure proof(key: String, role: char, challenge: Slice[u8], answer: Slice[u8], stamp: u64, mutable out: Slice[u8])
    {
        var message Vector[u8](1 + 32 + 32 + 8)
        message.put(0, role as u8)
        var i: size_t 0
        while i < 32
        {
            message.put(1 + i, challenge[i])
            message.put(33 + i, answer[i])
            i := i + 1
        }
        var b: size_t 0
        while b < 8
        {
            message.put(65 + b, ((stamp >> (b * 8)) & 0xff) as u8)
            b := b + 1
        }
        Hmac.sha256(key.as_slice(), message.as_slice(), out)
    }

    ; `count` bytes from a blocking socket into buf; false where it ends
    ; before them.
    procedure read_exactly(fd: i32, mutable buf: pointer[void], count: size_t) returns bool
    {
        var got: size_t 0
        while got < count
        {
            let r Io.read(fd, ((buf as size_t) + got) as pointer[void], count - got)
            if r <= 0
                return false
            got := got + (r as size_t)
        }
        true
    }

    ; --- channels & monitors ---

    ; The local Channel carrying messages the peer sends to `id` —
    ; create-on-first-touch under the lock, from EITHER side (the app
    ; registering interest, or the reader delivering before the app
    ; got there), so registration and first delivery cannot race. The
    ; runtime holds the channel's one send handle; peer death retires
    ; it (receivers wake with null). On a peer already down a fresh id
    ; yields a channel born closed.
    procedure channel(mutable p: pointer[NodePeer], id: u64) returns ref[Channel]
    {
        Cluster.acquire(p)
        var i: size_t 0
        let ids p.chan_ids
        let chs p.chans
        while i < p.chan_count
        {
            if ids[i] = id
            {
                let c0 chs[i]
                Cluster.release(p)
                return c0
            }
            i := i + 1
        }
        if p.chan_count >= NODE_MAX_CHANNELS
        {
            Cluster.release(p)
            scaly_panic_resource("node: channel table full", NODE_MAX_CHANNELS, 113 as i32)
        }
        if p.alive = false
        {
            Cluster.release(p)
            let c1 Channel.create()
            Channel.close_sender(c1)
            return c1
        }
        let c Channel.create()
        ids[p.chan_count] := id
        chs[p.chan_count] := c
        p.chan_count := p.chan_count + 1
        Cluster.release(p)
        c
    }

    ; A down-notice channel (memo rule 5): receives ONE NodeDown when
    ; the peer is suspected dead or said goodbye, then closes. On a
    ; peer already down the notice is delivered immediately.
    procedure monitor(mutable p: pointer[NodePeer]) returns ref[Channel]
    {
        let c Channel.create()
        Cluster.acquire(p)
        if p.alive = false
        {
            let reason p.down_reason
            Cluster.release(p)
            Cluster.deliver_down(c, reason)
            return c
        }
        if p.monitor_count >= NODE_MAX_CHANNELS
        {
            Cluster.release(p)
            scaly_panic_resource("node: monitor table full", NODE_MAX_CHANNELS, 113 as i32)
        }
        let ms p.monitors
        ms[p.monitor_count] := c
        p.monitor_count := p.monitor_count + 1
        Cluster.release(p)
        c
    }

    procedure deliver_down(mutable c: pointer[Channel], reason: i64)
    {
        let dp Page.allocate_page()
        let nd &NodeDown^dp(reason)
        Channel.send(c, nd as pointer[void])
        Channel.close_sender(c)
    }

    ; --- send (memo rules 3 + 4) ---

    ; Send a message region to the peer's channel `id`. OWNERSHIP OF
    ; THE MESSAGE REGION MOVES INTO THE TRANSPORT, UNCONDITIONALLY: the
    ; region is serialized and freed HERE, whether or not the bytes
    ; ever arrive — at-most-once, fire-and-forget, FIFO per channel.
    ; msg must be non-null and rooted on its own heap page
    ; (Page.allocate_page), its graph an object-TREE closed over the
    ; region (the 7.2 walker rules; the receiver runs fix_graph). A
    ; send to a suspected-dead peer is silently dropped — death
    ; surfaces as channel close + monitor notice, never a send error.
    procedure send(p: pointer[NodePeer], id: u64, mutable msg: pointer[void])
    {
        let region Page.get(msg)
        let host Page.allocate_page()
        let frame Region.serialize(region, msg, host)
        let flen Region.frame_length(frame)
        region.deallocate_extensions()
        Page.release_page(region)
        var hdr u8[24]
        let hw hdr as pointer[u64]
        hw[0] := NODE_FRAME_DATA
        hw[1] := id
        hw[2] := flen as u64
        Cluster.wacquire(p)
        if p.alive
        {
            if Io.tcp_write_all(p.fd, hdr as pointer[void], 24)
                Io.tcp_write_all(p.fd, frame as pointer[void], flen)
        }
        Cluster.wrelease(p)
        host.deallocate_extensions()
        Page.release_page(host)
    }

    ; Heartbeat/BYE writer. try_only skips the frame when a data write
    ; holds the lock — flowing data is its own liveness signal.
    procedure send_control(p: pointer[NodePeer], kind: u64, try_only: bool)
    {
        if try_only
        {
            if Cluster.try_wacquire(p) = false
                return
        }
        else
            Cluster.wacquire(p)
        var hdr u8[24]
        let hw hdr as pointer[u64]
        hw[0] := kind
        hw[1] := 0
        hw[2] := 0
        if p.alive
            Io.tcp_write_all(p.fd, hdr as pointer[void], 24)
        Cluster.wrelease(p)
    }

    ; --- death & disposal (memo rules 1, 2, 5) ---

    ; Close every channel from this peer (receivers wake with null) and
    ; fire every monitor. Idempotent; counts are final once alive
    ; drops. Runs on the reader (suspicion, EOF, BYE) or on the app
    ; thread (Cluster.close).
    procedure teardown(mutable p: pointer[NodePeer], reason: i64)
    {
        Cluster.acquire(p)
        if p.alive = false
        {
            Cluster.release(p)
            return
        }
        p.alive := false
        p.down_reason := reason
        let nc p.chan_count
        let nm p.monitor_count
        Cluster.release(p)
        var i: size_t 0
        let chs p.chans
        while i < nc
        {
            Channel.close_sender(chs[i])
            i := i + 1
        }
        var j: size_t 0
        let ms p.monitors
        while j < nm
        {
            Cluster.deliver_down(ms[j], reason)
            j := j + 1
        }
    }

    ; Graceful goodbye: BYE frame, then the local teardown (our receive
    ; channels close, monitors fire NODE_DOWN_CLOSED). The reader
    ; notices alive=false within a heartbeat slice and closes the fd.
    procedure close(mutable p: pointer[NodePeer])
    {
        Cluster.send_control(p, NODE_FRAME_BYE, false)
        Cluster.teardown(p, NODE_DOWN_CLOSED)
    }

    ; Free the peer record after the connection ended: joins the reader
    ; (it owns the fd close), then releases the record page. Channels
    ; and monitors from this peer are disposed by their receivers
    ; (Channel.dispose after the null), independently.
    procedure dispose_peer(mutable p: ref[NodePeer])
    {
        Thread.join(p.reader)
        let pp Page.get(p)
        pp.deallocate_extensions()
        Page.release_page(pp)
    }

    ; Free a received message: the region's pages and the host page
    ; carrying the ReceivedRegion record + map (the channel node rode
    ; on it too).
    procedure dispose_message(mutable rr: ref[ReceivedRegion])
    {
        rr.release()
        let hp Page.get(rr)
        hp.deallocate_extensions()
        Page.release_page(hp)
    }

    ; --- the reader thread ---

    procedure poll_in(fd: i32, ms: i32)
    {
        var pfd u8[8]
        *(pfd as pointer[i32]) := fd
        ; POLLIN=1 on both OSes (inlined like Io.wait_ready).
        *(((pfd as size_t) + 4) as pointer[u16]) := 1
        poll(pfd as pointer[pollfd], 1, ms)
    }

    ; Read exactly count bytes; bounded polls keep the suspicion clock
    ; live during a mid-frame stall. False = transport over (EOF,
    ; error, silence past the deadline, or a local close).
    procedure read_exact(mutable p: ref[NodePeer], buf: pointer[void], count: size_t) returns bool
    {
        let fd p.fd
        var done: size_t 0
        while done < count
        {
            if p.alive = false
                return false
            let r scaly_eio_read(fd, ((buf as size_t) + done) as pointer[void], count - done)
            if r = ((0 - 2) as i64)
            {
                let t scaly_eio_now_ns()
                if t - p.last_rx > (NODE_SUSPECT_MS * 1000000)
                    return false
                Cluster.poll_in(fd, NODE_HEARTBEAT_MS as i32)
            }
            else
            {
                if r <= 0
                    return false
                done := done + (r as size_t)
                p.last_rx := scaly_eio_now_ns()
            }
        }
        true
    }

    ; One frame past the header: false stops the reader.
    procedure dispatch(mutable p: ref[NodePeer], h: pointer[u64]) returns bool
    {
        let kind h[0]
        if kind = NODE_FRAME_HEARTBEAT
            return true
        if kind = NODE_FRAME_BYE
        {
            Cluster.teardown(p, NODE_DOWN_CLOSED)
            return false
        }
        let id h[1]
        let len h[2] as size_t
        var bad false
        if kind <> NODE_FRAME_DATA
            bad := true
        if len < 32
            bad := true
        if len > NODE_MAX_FRAME
            bad := true
        if bad
        {
            ; Framing violation — the rule-8 trust boundary: treat as
            ; suspicion, never parse further.
            Cluster.teardown(p, NODE_DOWN_SUSPECT)
            return false
        }
        ; Land the frame on a scratch page, materialize into real pages
        ; (+ the map on the message's host page), free the scratch.
        let fp Page.allocate_page()
        let frame fp.allocate(len, 8) as pointer[u8]
        if Cluster.read_exact(p, frame as pointer[void], len) = false
        {
            fp.deallocate_extensions()
            Page.release_page(fp)
            Cluster.teardown(p, NODE_DOWN_SUSPECT)
            return false
        }
        let hp Page.allocate_page()
        let rr Region.deserialize(frame, hp)
        fp.deallocate_extensions()
        Page.release_page(fp)
        if rr = null
        {
            hp.deallocate_extensions()
            Page.release_page(hp)
            Cluster.teardown(p, NODE_DOWN_SUSPECT)
            return false
        }
        ; ★A frame can arrive AFTER this side closed the peer: Cluster.close
        ; runs on the application's thread while this one has the next frame
        ; in hand, and the other side cannot know we stopped listening before
        ; our goodbye reaches it. Such a frame has no receiver and is DROPPED,
        ; as a send to a peer that is gone is (rule 4). Until 2026-10-05 it
        ; was handed to Channel.send, which traps on a closed channel as a
        ; handle-discipline bug (exit 110) -- but the handle is the runtime's
        ; own and nothing was misused: the distributed trainer died of it in
        ; one run of thirty, a worker's next gradient racing the reducer's
        ; close (gate tests/cluster/lateframe.scaly, 6 of 6 before the fix).
        ; The delivery happens UNDER the peer's lock, which teardown# takes
        ; to drop `alive` before it closes the channels: either the message
        ; is queued before the close (a receiver finds it, then null) or it
        ; is dropped here -- never a send on a closed channel. A node channel
        ; is unbounded, so the send cannot block while the lock is held.
        Cluster.acquire(p)
        let live p.alive
        Cluster.release(p)
        if live = false
        {
            Cluster.dispose_message(rr)
            return false
        }
        let ch Cluster.channel(p, id)
        Cluster.acquire(p)
        if p.alive = false
        {
            Cluster.release(p)
            Cluster.dispose_message(rr)
            return false
        }
        Channel.send(ch, rr as pointer[void])
        Cluster.release(p)
        true
    }

    procedure reader_loop(mutable p: pointer[NodePeer])
    {
        let fd p.fd
        var hdr u8[24]
        var got: size_t 0
        var last_hb scaly_eio_now_ns()
        repeat
        {
            if p.alive = false
                break
            let t scaly_eio_now_ns()
            if t - last_hb >= (NODE_HEARTBEAT_MS * 1000000)
            {
                Cluster.send_control(p, NODE_FRAME_HEARTBEAT, true)
                last_hb := t
            }
            if t - p.last_rx > (NODE_SUSPECT_MS * 1000000)
            {
                Cluster.teardown(p, NODE_DOWN_SUSPECT)
                break
            }
            let r scaly_eio_read(fd, ((hdr as size_t) + got) as pointer[void], 24 - got)
            if r = ((0 - 2) as i64)
                Cluster.poll_in(fd, NODE_HEARTBEAT_MS as i32)
            else
            {
                if r <= 0
                {
                    Cluster.teardown(p, NODE_DOWN_SUSPECT)
                    break
                }
                got := got + (r as size_t)
                p.last_rx := scaly_eio_now_ns()
                if got = 24
                {
                    got := 0
                    if Cluster.dispatch(p, hdr as pointer[u64]) = false
                        break
                }
            }
        }
        ; The reader owns the fd's end of life. The wlock barrier lets
        ; any in-flight Cluster.send finish its write first; every later
        ; send sees alive=false and skips — the fd number can never be
        ; reused under a writer.
        Cluster.wacquire(p)
        close(p.fd)
        Cluster.wrelease(p)
    }

    ; SCALY_CLUSTER_TRACE=1: a line per loop offered and per stretch run.
    procedure tracing() returns bool
    {
        getenv("SCALY_CLUSTER_TRACE") <> null
    }

    ; Are the rounds of a fit loop to go to helpers (SCALY_CLUSTER=on)?
    procedure forced() returns bool
    {
        let v getenv("SCALY_CLUSTER")
        if v = null
            return false
        v[0] = ("o" as char) and v[1] = ("n" as char) and v[2] = (0 as char)
    }

    ; The helpers of this program this coordinator is connected to: found
    ; and connected the first time a loop asks, kept for the program's life.
    procedure helpers() returns size_t
    {
        if cluster_peers_asked
            return cluster_peer_count
        cluster_peers_asked := true
        let found Helpers.find(1000)
        let p Page.allocate_page()
        cluster_peers := p.allocate((found.length + 1) * 8, 8) as pointer[pointer[NodePeer]]
        for h in found
        {
            let peer Cluster.connect(h.host.to_c_string(), h.port)
            if peer <> null
            {
                cluster_peers[cluster_peer_count] := peer as pointer[NodePeer]
                cluster_peer_count := cluster_peer_count + 1
            }
        }
        cluster_peer_count
    }

    ; The descriptor of the loop of that hash; null where this build has none.
    procedure find_loop(hash: u64) returns pointer[void]
    {
        var i: size_t 0
        while i < cluster_table_count
        {
            let d cluster_table[i]
            if (Cluster.desc_word(d, 0) as u64) = hash
                return d
            i := i + 1
        }
        null
    }

    ; Word k of a descriptor (after its task function's address).
    function desc_word(desc: pointer[void], k: size_t) returns i64
    {
        let w ((desc as size_t) + 8) as pointer[i64]
        w[k]
    }

    ; Where the record of capture c lies: in the cell, or where the cell
    ; points.
    function capture_record(desc: pointer[void], cell: pointer[void], c: size_t) returns pointer[u8]
    {
        let off Cluster.desc_word(desc, 6 + c * 3) as size_t
        let kind Cluster.desc_word(desc, 7 + c * 3)
        let at ((cell as size_t) + off) as pointer[u8]
        if (kind & 16) <> 0
            return (at as pointer[pointer[u8]])[0]
        at
    }

    ; Does a capture of this kind travel to the helper beside the cell? A
    ; buffer the rounds read (whole), one they put into (the stretch, as it
    ; is here: a round may put or not, and where none puts the value stays),
    ; a record the cell holds by its address; a plain value is in the cell.
    function travels_out(kind: i64) returns bool
    {
        kind <> 1
    }

    ; The length and the data of a buffer's record (an Array's buffer is its
    ; third word).
    function buffer_of(rec: pointer[u8], kind: i64) returns (length: size_t, data: pointer[u8])
    {
        let words rec as pointer[size_t]
        let base kind & 15
        if base = 3 or base = 5
            return (length: words[0], data: (words[2] as pointer[u8]))
        (length: words[0], data: (words[1] as pointer[u8]))
    }

    ; A stretch for a helper: the cell, every buffer the rounds read, and
    ; the stretch of every one they put into.
    procedure send_job(mutable peer: pointer[NodePeer], desc: pointer[void], cell: pointer[void], lo: i64, hi: i64)
    {
        let size Cluster.desc_word(desc, 1) as size_t
        let ncap Cluster.desc_word(desc, 5) as size_t
        var nin: size_t 0
        var c: size_t 0
        while c < ncap
        {
            if Cluster.travels_out(Cluster.desc_word(desc, 7 + c * 3))
                nin := nin + 1
            c := c + 1
        }
        let mp Page.allocate_page()
        let job &ClusterJob^mp(Cluster.desc_word(desc, 0) as u64, lo, hi, Vector[u8]^mp(0), Vector[Vector[u8]]^mp(0))
        var cv Vector[u8]^mp(size)
        memcpy(cv.data as pointer[void], cell, size as c_size)
        var ins Vector[Vector[u8]]^mp(nin)
        var j: size_t 0
        c := 0
        while c < ncap
        {
            let kind Cluster.desc_word(desc, 7 + c * 3)
            if Cluster.travels_out(kind)
            {
                let elem Cluster.desc_word(desc, 8 + c * 3) as size_t
                let rec Cluster.capture_record(desc, cell, c)
                var from rec
                var bytes elem
                if kind <> 17
                {
                    let b Cluster.buffer_of(rec, kind)
                    let base kind & 15
                    from := b.data
                    bytes := b.length * elem
                    if base = 4 or base = 5
                    {
                        from := ((b.data as size_t) + (lo as size_t) * elem) as pointer[u8]
                        bytes := ((hi - lo) as size_t) * elem
                    }
                }
                var bv Vector[u8]^mp(bytes)
                memcpy(bv.data as pointer[void], from as pointer[void], bytes as c_size)
                ins.put(j, bv)
                j := j + 1
            }
            c := c + 1
        }
        job.cell := cv
        job.inputs := ins
        Cluster.send(peer, HELPER_CHANNEL, job as pointer[void])
    }

    ; What a helper's stretch put, into this program's buffers.
    procedure take_result(desc: pointer[void], cell: pointer[void], res: ref[ClusterResult])
    {
        let ncap Cluster.desc_word(desc, 5) as size_t
        var j: size_t 0
        var c: size_t 0
        while c < ncap
        {
            let kind Cluster.desc_word(desc, 7 + c * 3)
            let base kind & 15
            if base = 4 or base = 5
            {
                let elem Cluster.desc_word(desc, 8 + c * 3) as size_t
                let b Cluster.buffer_of(Cluster.capture_record(desc, cell, c), kind)
                let part res.outputs[j]
                let at ((b.data as size_t) + (res.lo as size_t) * elem) as pointer[void]
                memcpy(at, part.data as pointer[void], part.length as c_size)
                j := j + 1
            }
            c := c + 1
        }
    }

    ; The pointers of a received job, swizzled by hand: the runtime does not
    ; call fix_graph, whose walkers the compiler writes into the programs
    ; that call it, and not into the C++ the trust chain builds the
    ; compiler from. A job has two levels of buffers, a result one.
    procedure fix_job(rr: ref[ReceivedRegion], mutable job: ref[ClusterJob])
    {
        rr.fix(&job.cell.data as pointer[void])
        Cluster.fix_parts(rr, &job.inputs.data as pointer[void], job.inputs.length)
    }

    procedure fix_result(rr: ref[ReceivedRegion], mutable res: ref[ClusterResult])
    {
        Cluster.fix_parts(rr, &res.outputs.data as pointer[void], res.outputs.length)
    }

    ; The slot of a Vector[Vector[u8]]'s data, then each part's own.
    procedure fix_parts(rr: ref[ReceivedRegion], mutable slot: pointer[void], count: size_t)
    {
        rr.fix(slot)
        let parts (slot as pointer[pointer[Vector[u8]]])[0]
        var i: size_t 0
        while i < count
        {
            let part parts + i
            rr.fix(&part.data as pointer[void])
            i := i + 1
        }
    }

    ; A helper's side: every stretch a coordinator sends is run and answered,
    ; until the coordinator lets go.
    procedure serve(mutable peer: pointer[NodePeer])
    {
        let ch Cluster.channel(peer, HELPER_CHANNEL)
        repeat
        {
            let raw Channel.receive(ch)
            if raw = null
                break
            let rr raw as ref[ReceivedRegion]
            let job rr.root as pointer[ClusterJob]
            Cluster.fix_job(rr, job as ref[ClusterJob])
            let rp Page.allocate_page()
            let res Cluster.run_job(rp, job as ref[ClusterJob])
            Cluster.send(peer, CLUSTER_RESULT, res as pointer[void])
            rp.deallocate_extensions()
            Page.release_page(rp)
            Cluster.dispose_message(rr)
        }
    }

    ; One stretch, here: the cell built again -- its plain values as the
    ; coordinator had them, a read buffer pointing at the bytes that came
    ; with the stretch, a written one at a buffer of the stretch's own, set
    ; so that the round's counter indexes it as it indexes the
    ; coordinator's --, then the loop's own task function, and what it put.
    procedure run_job(rp: ref[Page], job: ref[ClusterJob]) returns ref[ClusterResult]
    {
        ; the answer on a page of its own, first on it; rp holds the
        ; stretch's scratch and is given back after the answer went
        let ap Page.allocate_page()
        let desc Cluster.find_loop(job.hash)
        if desc = null
            return &ClusterResult^ap(job.lo, job.hi, false, Vector[Vector[u8]]^ap(0))
        let res &ClusterResult^ap(job.lo, job.hi, true, Vector[Vector[u8]]^ap(0))
        let task (desc as pointer[pointer[void]])[0]
        let size Cluster.desc_word(desc, 1) as size_t
        let ncap Cluster.desc_word(desc, 5) as size_t
        let cell rp.allocate(size, 16)
        memcpy(cell, job.cell.data as pointer[void], size as c_size)
        let lo job.lo
        let hi job.hi
        (((cell as size_t) + (Cluster.desc_word(desc, 2) as size_t)) as pointer[i64])[0] := lo
        (((cell as size_t) + (Cluster.desc_word(desc, 3) as size_t)) as pointer[i64])[0] := hi
        (((cell as size_t) + (Cluster.desc_word(desc, 4) as size_t)) as pointer[pointer[void]])[0] := null
        var nout: size_t 0
        var c: size_t 0
        while c < ncap
        {
            let base Cluster.desc_word(desc, 7 + c * 3) & 15
            if base = 4 or base = 5
                nout := nout + 1
            c := c + 1
        }
        let bufs rp.allocate((nout + 1) * 8, 8) as pointer[pointer[u8]]
        let lens rp.allocate((nout + 1) * 8, 8) as pointer[size_t]
        var j: size_t 0
        var o: size_t 0
        c := 0
        while c < ncap
        {
            let off Cluster.desc_word(desc, 6 + c * 3) as size_t
            let kind Cluster.desc_word(desc, 7 + c * 3)
            let base kind & 15
            let elem Cluster.desc_word(desc, 8 + c * 3) as size_t
            if kind = 17
            {
                ; the record came beside the cell: the cell points at it
                let part job.inputs[j]
                (((cell as size_t) + off) as pointer[pointer[u8]])[0] := part.data
                j := j + 1
            }
            else if base >= 2
            {
                ; the record: in the cell, or one of this stretch's own
                var rec ((cell as size_t) + off) as pointer[size_t]
                if (kind & 16) <> 0
                {
                    rec := rp.allocate(24, 8) as pointer[size_t]
                    (((cell as size_t) + off) as pointer[pointer[size_t]])[0] := rec
                }
                var length: size_t 0
                var data: size_t 0
                if base = 2 or base = 3
                {
                    let part job.inputs[j]
                    length := part.length / elem
                    data := part.data as size_t
                    j := j + 1
                }
                else
                {
                    ; the stretch as the coordinator has it: what no round
                    ; puts goes back unchanged
                    let bytes ((hi - lo) as size_t) * elem
                    let buf rp.allocate(bytes + 1, 16) as pointer[u8]
                    let part job.inputs[j]
                    memcpy(buf as pointer[void], part.data as pointer[void], bytes as c_size)
                    j := j + 1
                    bufs[o] := buf
                    lens[o] := bytes
                    o := o + 1
                    length := hi as size_t
                    if (kind & 16) = 0
                        length := rec[0]
                    data := (buf as size_t) - (lo as size_t) * elem
                }
                rec[0] := length
                if base = 3 or base = 5
                {
                    rec[1] := length
                    rec[2] := data
                }
                else
                    rec[1] := data
            }
            c := c + 1
        }
        ; the stretch on this machine's cores, as any loop of the program
        ; would run: a part per core twice over, each with its own cell
        if Cluster.tracing()
        {
            scaly_eputs "helper: rounds "
            scaly_eputi(lo)
            scaly_eputs " to "
            scaly_eputi(hi)
            scaly_eputnl()
        }
        var parts TaskPool.ncpu() * 2
        if parts > hi - lo
            parts := hi - lo
        if parts <= 1
            scaly_call_ptr(task, cell)
        else
        {
            let pool TaskPool.default_pool()
            let g TaskGroup.create()
            let step (hi - lo + parts - 1) / parts
            var a lo
            while a < hi
            {
                var b a + step
                if b > hi
                    b := hi
                let sub rp.allocate(size, 16)
                memcpy(sub, cell, size as c_size)
                (((sub as size_t) + (Cluster.desc_word(desc, 2) as size_t)) as pointer[i64])[0] := a
                (((sub as size_t) + (Cluster.desc_word(desc, 3) as size_t)) as pointer[i64])[0] := b
                TaskPool.submit(pool, task, sub, g)
                a := b
            }
            TaskGroup.wait(g)
            TaskGroup.dispose(g)
        }
        var outs Vector[Vector[u8]]^ap(nout)
        o := 0
        while o < nout
        {
            var b Vector[u8]^ap(lens[o])
            memcpy(b.data as pointer[void], bufs[o] as pointer[void], lens[o] as c_size)
            outs.put(o, b)
            o := o + 1
        }
        res.outputs := outs
        res
    }
}

; A channel to and from a peer that carries messages of ONE type, by
; number -- the surface over Cluster.send / Channel.receive / fix_graph:
;
;   let peer Cluster.connect("localhost", 7700, 5000)
;   let counts Remote[Count](peer, 2)
;   counts.send(Count(n, "..."))       ; built on a page that leaves
;   let c counts.receive()             ; ref[Count]?, null = the peer is gone
;   Cluster.disconnect(peer)
;
; A message is a region: send builds it on a page of its own and ships
; that page, which it serializes and releases (rule 4). A received
; message joins the region of the routine that received it -- its pages
; become exclusive pages of the caller's page --, so it lives as long as
; a value that routine built, and goes with it.
define Remote[T]
(
    peer: ref[NodePeer]
    id: u64
)
{
    ; The construction (or the call that makes the message) written as the
    ; argument is put in here and built on a page of its own, which the
    ; send serializes and releases (rule 4); a name is refused, its parts
    ; would stay where they were built (Planner.put_in_lazy_call#).
    procedure send(this, message: lazy T)
    {
        let out Page.allocate_page()
        let m &^out message
        Cluster.send(peer, id, m as pointer[void])
    }

    procedure receive(mutable this) returns ref[T]?
    {
        if current_scheduler = null
            Scheduler.create(Page.allocate_page())
        var p peer
        let ch Cluster.channel(p, id)
        let raw Channel.receive(ch)
        if raw = null
            return null
        let rr raw as ref[ReceivedRegion]
        let root rr.root as pointer[T]
        rr.fix_graph(root)
        let mark &# 0
        let host Page.get(mark)
        host.exclusive_pages.add(rr.region)
        let hp Page.get(rr)
        hp.deallocate_extensions()
        Page.release_page(hp)
        root as ref[T]
    }
}

; --- helpers (ROADMAP-cluster.md, stage C1) ---------------------------------
;
; A program started with `--scaly-helper` does not run its main: it is a
; HELPER, which announces itself and serves the coordinators that connect
; (scaly_set_arguments, eio.c, calls scaly_helper_main before anything
; else). A coordinator finds the helpers of its own program with
; Cluster.find_helpers: they answer in one multicast group, one datagram
; each -- [kind, protocol, stamp, id, port, cores, 0, 0] as eight words and
; an HMAC-SHA256 over them under the cluster's key (zeros without one).
; Only a helper of the same build (stamp) and the same key is found; without
; a key the group is the loopback's alone and every helper is on this
; machine. What a helper is asked to do comes with stage C2; here it holds a
; coordinator's connection until the coordinator lets it go.

; The announcer of a helper (a thread of its own): itself every two seconds,
; and at once where a coordinator of its program asks.
procedure helper_announcer_entry(mutable arg: pointer[void]) returns pointer[void]
{
    let st arg as ref[HelperState]
    var buf Vector[u8](128)
    var from u8[64]
    var last: i64 0
    repeat
    {
        let now scaly_eio_now_ns()
        if now - last > 2000000000
        {
            Cluster.announce(st)
            last := now
        }
        let n scaly_eio_mcast_recv(st.mfd, buf.data as pointer[void], 128, 500, from as pointer[char], 64)
        if n = (HELPER_DATAGRAM as i64)
            if Cluster.datagram_ok(Slice[u8](HELPER_DATAGRAM, buf.data), HELPER_ASK, st.key)
                Cluster.announce(st)
    }
    null
}

; A program started as a helper: it listens (on this machine only, where
; there is no key), announces itself, and serves one coordinator after the
; other until it is ended from outside.
procedure scaly_helper_main()
{
    scaly_atomic_store_u64(&cluster_offering, 2 as u64)
    let page Page.allocate_page()
    if current_scheduler = null
        Scheduler.create(page)
    let key Cluster.key()
    let local_only: i32 if key.get_length() = 0: 1 else 0
    let lfd Cluster.listen(0)
    if lfd < (0 as i32)
    {
        scaly_eputs "helper: cannot listen"
        scaly_eputnl()
        exit(3)
    }
    let port Cluster.local_port(lfd)
    let mfd scaly_eio_mcast_listen(HELPER_GROUP_PORT, local_only)
    if mfd < (0 as i32)
    {
        scaly_eputs "helper: cannot join the helpers' group"
        scaly_eputnl()
        exit(3)
    }
    var idb u8[8]
    scaly_eio_random(idb as pointer[void], 8)
    let id Cluster.word_at(Slice[u8](8, idb as pointer[u8]), 0)
    let sp Page.allocate_page()
    let st &HelperState^sp(mfd, id, port, scaly_eio_ncpu() as i64, String^sp(key), local_only)
    Thread.spawn(&helper_announcer_entry, st as pointer[void])
    scaly_eputs "helper: ready, port "
    scaly_eputi(port as i64)
    scaly_eputnl()
    repeat
    {
        let peer Cluster.accept(lfd)
        if peer <> null
        {
            Cluster.serve(peer)
            Cluster.disconnect(peer)
        }
    }
}

define Helpers
{
    ; The helpers of this program that answer within `ms` milliseconds,
    ; each once.
    procedure find(ms: int) returns Vector[HelperFound]
    {
        let key Cluster.key()
        let local_only: i32 if key.get_length() = 0: 1 else 0
        let mfd scaly_eio_mcast_listen(HELPER_GROUP_PORT, local_only)
        if mfd < (0 as i32)
            return Vector[HelperFound](0)
        var ask Vector[u8](HELPER_DATAGRAM)
        Cluster.fill_datagram(ask.as_slice(), HELPER_ASK, 0, 0, 0, key)
        scaly_eio_mcast_send(ask.data as pointer[void], HELPER_DATAGRAM, HELPER_GROUP_PORT, local_only)
        var found List[HelperFound]()
        var ids List[u64]()
        var buf Vector[u8](128)
        var from u8[64]
        let deadline scaly_eio_now_ns() + ms * 1000000
        repeat
        {
            let left (deadline - scaly_eio_now_ns()) / 1000000
            if left <= 0
                break
            let n scaly_eio_mcast_recv(mfd, buf.data as pointer[void], 128, left as i32, from as pointer[char], 64)
            if n < 0
                break
            if n = (HELPER_DATAGRAM as i64)
            {
                let d Slice[u8](HELPER_DATAGRAM, buf.data)
                if Cluster.datagram_ok(d, HELPER_ANNOUNCE, key)
                {
                    let id Cluster.word_at(d, 3)
                    var seen false
                    for known in ids
                        if known = id
                            seen := true
                    if seen = false
                    {
                        ids.add(id)
                        found.add(HelperFound(String(from as pointer[const_char]), Cluster.word_at(d, 4) as i32, Cluster.word_at(d, 5) as i64, id))
                    }
                }
            }
        }
        close(mfd)
        Vector[HelperFound](found)
    }
}

; --- rounds on other machines (stage C2) -------------------------------------

; A loop of this program, made known before main runs: the compiler's
; constructor calls this once for every descriptor of the module.
procedure scaly_cluster_register(desc: pointer[void])
{
    if cluster_table = null
    {
        let p Page.allocate_page()
        cluster_table := p.allocate(CLUSTER_TABLE_MOST * 8, 8) as pointer[pointer[void]]
    }
    if cluster_table_count < CLUSTER_TABLE_MOST
    {
        cluster_table[cluster_table_count] := desc
        cluster_table_count := cluster_table_count + 1
    }
}

; The coordinator's offer, asked at the head of such a loop: where it is
; forced (SCALY_CLUSTER=on) and helpers are there, the rounds 0 to count go
; to them in stretches, a helper taking the next as it sends one back, and
; what they put lands in this program's buffers. 1 where every round ran so;
; 0 where they did not -- no helper, or none left --: the processor's loop
; then runs as always and computes the same, the rounds being pure.
procedure scaly_cluster_offer(desc: pointer[void], cell: pointer[void], count: int) returns i32
{
    if count <= 0 or Cluster.forced() = false
        return 0
    if scaly_atomic_cas_u64(&cluster_offering, 0 as u64, 1 as u64) <> 0
        return 0
    let answer cluster_offer_rounds(desc, cell, count)
    scaly_atomic_store_u64(&cluster_offering, 0 as u64)
    answer
}

; The offer itself, while it is the only one.
procedure cluster_offer_rounds(desc: pointer[void], cell: pointer[void], count: int) returns i32
{
    let n Cluster.helpers()
    if n = 0
        return 0
    if current_scheduler = null
        Scheduler.create(Page.allocate_page())
    var chunk (count + (n as i64) * 4 - 1) / ((n as i64) * 4)
    if chunk < 1
        chunk := 1
    let stretches (count + chunk - 1) / chunk
    let qp Page.allocate_page()
    let queue qp.allocate((stretches as size_t) * 8, 8) as pointer[i64]
    let busy qp.allocate(n * 8, 8) as pointer[i64]
    let live qp.allocate(n, 1) as pointer[u8]
    var q: i64 0
    while q < stretches
    {
        queue[q as size_t] := (stretches - 1 - q) * chunk
        q := q + 1
    }
    var queued stretches
    var k: size_t 0
    while k < n
    {
        busy[k] := 0 - 1
        let peer cluster_peers[k]
        live[k] := if peer.alive: (1 as u8) else 0
        k := k + 1
    }
    var done: i64 0
    var ok true
    repeat
    {
        ; every live helper without a stretch gets the next
        k := 0
        while k < n
        {
            if live[k] = 1 and busy[k] < 0 and queued > 0
            {
                queued := queued - 1
                let lo queue[queued as size_t]
                var hi lo + chunk
                if hi > count
                    hi := count
                Cluster.send_job(cluster_peers[k], desc, cell, lo, hi)
                busy[k] := lo
            }
            k := k + 1
        }
        if done = stretches
            break
        var any false
        k := 0
        while k < n
        {
            if live[k] = 1
                any := true
            k := k + 1
        }
        if any = false
        {
            ok := false
            break
        }
        ; what came back
        var got false
        k := 0
        while k < n
        {
            if live[k] = 1 and busy[k] >= 0
            {
                var timed false
                let raw Channel.receive_timeout(Cluster.channel(cluster_peers[k], CLUSTER_RESULT), 0 as i32, &timed)
                if raw <> null
                {
                    let rr raw as ref[ReceivedRegion]
                    let res rr.root as pointer[ClusterResult]
                    Cluster.fix_result(rr, res as ref[ClusterResult])
                    if res.ok
                    {
                        Cluster.take_result(desc, cell, res as ref[ClusterResult])
                        done := done + 1
                        busy[k] := 0 - 1
                    }
                    else
                    {
                        ; a helper that does not know the loop: its stretch goes back
                        queue[queued as size_t] := busy[k]
                        queued := queued + 1
                        busy[k] := 0 - 1
                        live[k] := 0
                    }
                    Cluster.dispose_message(rr)
                    got := true
                }
                else if timed = false
                {
                    ; the helper is gone: its stretch goes back
                    queue[queued as size_t] := busy[k]
                    queued := queued + 1
                    busy[k] := 0 - 1
                    live[k] := 0
                    got := true
                }
            }
            k := k + 1
        }
        if got = false
            poll(null as pointer[pollfd], 0, 1)
    }
    Page.release_page(qp)
    if Cluster.tracing()
    {
        scaly_eputs "cluster: "
        scaly_eputi(count)
        scaly_eputs " rounds in "
        scaly_eputi(stretches)
        scaly_eputs " stretches on "
        scaly_eputi(n as i64)
        if ok
            scaly_eputs " helpers, all there"
        else
            scaly_eputs " helpers, none left: this machine runs them"
        scaly_eputnl()
    }
    if ok: 1 else 0
}

