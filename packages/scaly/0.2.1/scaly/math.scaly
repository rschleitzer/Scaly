; math.scaly - exp, log, ... written in Scaly
;
; The C library's functions differ from system to system in the last bit:
; each approximates in its own way. These are the same code on every
; target, made of the operations IEEE 754 rounds exactly (+ - * /, sqrt,
; floor, round_even, ...), so a program computes the same bits wherever it
; runs -- the condition for a cluster whose nodes are different machines.
;
; One operation decides between two builds: mul_add, a * b + c with ONE
; rounding where the build's processor has FMA (arm64, x86_64 from Haswell
; on: -mcpu=x86-64-v3, native on such a machine) and two where it has not
; (an older or generic x86_64 build, WebAssembly). Builds with FMA compute
; the same bits; the others are `relaxed`: as fast, as accurate to within
; a unit in the last place, not the same bits.
;
; Every function is generic (exp[T] for T f64 or f32): it is made in the
; module of the program that calls it, for that program's processor, where
; it can be put in line and a loop over it vectorized -- a call into the C
; library cannot.
;
; The constants come from tools/math/tables.py (decimal arithmetic to 50
; digits, rounded to the nearest double); a literal is the shortest decimal
; that reads back to the same double, a constant the lexer cannot write
; (it has no exponents) its bits.

; 2^(i/128), i < 128, as hi and lo (the double nearest, and the double
; nearest the rest), the bits of each
define EXP_TABLE: u64[] [0x3ff0000000000000, 0x0000000000000000, 0x3ff0163da9fb3335, 0x3c9b61299ab8cdb7, 0x3ff02c9a3e778061, 0xbc719083535b085d, 0x3ff04315e86e7f85, 0xbc90a31c1977c96e, 0x3ff059b0d3158574, 0x3c8d73e2a475b465, 0x3ff0706b29ddf6de, 0xbc8c91dfe2b13c27, 0x3ff0874518759bc8, 0x3c6186be4bb284ff, 0x3ff09e3ecac6f383, 0x3c91487818316136, 0x3ff0b5586cf9890f, 0x3c98a62e4adc610b, 0x3ff0cc922b7247f7, 0x3c901edc16e24f71, 0x3ff0e3ec32d3d1a2, 0x3c403a1727c57b53, 0x3ff0fb66affed31b, 0xbc6b9bedc44ebd7b, 0x3ff11301d0125b51, 0xbc96c51039449b3a, 0x3ff12abdc06c31cc, 0xbc51b514b36ca5c7, 0x3ff1429aaea92de0, 0xbc932fbf9af1369e, 0x3ff15a98c8a58e51, 0x3c82406ab9eeab0a, 0x3ff172b83c7d517b, 0xbc819041b9d78a76, 0x3ff18af9388c8dea, 0xbc911023d1970f6c, 0x3ff1a35beb6fcb75, 0x3c8e5b4c7b4968e4, 0x3ff1bbe084045cd4, 0xbc995386352ef607, 0x3ff1d4873168b9aa, 0x3c9e016e00a2643c, 0x3ff1ed5022fcd91d, 0xbc91df98027bb78c, 0x3ff2063b88628cd6, 0x3c8dc775814a8495, 0x3ff21f49917ddc96, 0x3c82a97e9494a5ee, 0x3ff2387a6e756238, 0x3c99b07eb6c70573, 0x3ff251ce4fb2a63f, 0x3c8ac155bef4f4a4, 0x3ff26b4565e27cdd, 0x3c82bd339940e9d9, 0x3ff284dfe1f56381, 0xbc9a4c3a8c3f0d7e, 0x3ff29e9df51fdee1, 0x3c8612e8afad1255, 0x3ff2b87fd0dad990, 0xbc410adcd6381aa4, 0x3ff2d285a6e4030b, 0x3c90024754db41d5, 0x3ff2ecafa93e2f56, 0x3c71ca0f45d52383, 0x3ff306fe0a31b715, 0x3c86f46ad23182e4, 0x3ff32170fc4cd831, 0x3c8a9ce78e18047c, 0x3ff33c08b26416ff, 0x3c932721843659a6, 0x3ff356c55f929ff1, 0xbc8b5cee5c4e4628, 0x3ff371a7373aa9cb, 0xbc963aeabf42eae2, 0x3ff38cae6d05d866, 0xbc9e958d3c9904bd, 0x3ff3a7db34e59ff7, 0xbc75e436d661f5e3, 0x3ff3c32dc313a8e5, 0xbc9efff8375d29c3, 0x3ff3dea64c123422, 0x3c8ada0911f09ebc, 0x3ff3fa4504ac801c, 0xbc97d023f956f9f3, 0x3ff4160a21f72e2a, 0xbc5ef3691c309278, 0x3ff431f5d950a897, 0xbc81c7dde35f7999, 0x3ff44e086061892d, 0x3c489b7a04ef80d0, 0x3ff46a41ed1d0057, 0x3c9c944bd1648a76, 0x3ff486a2b5c13cd0, 0x3c73c1a3b69062f0, 0x3ff4a32af0d7d3de, 0x3c99cb62f3d1be56, 0x3ff4bfdad5362a27, 0x3c7d4397afec42e2, 0x3ff4dcb299fdd