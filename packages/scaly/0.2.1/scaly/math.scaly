; log x, the natural logarithm. x = 2^e m with m in [0.70703125, 1.4140625):
; log x = e ln2 + log(1/invc) + log1p(m invc - 1), invc near 1 / the middle
; of m's interval (one of 256; r = m invc - 1 is exact, |r| < 0.0029), log1p as r - r^2/2 + ... + r^7/7; the parts are added
; with their rounding errors kept. Near
; 1 (|x - 1| < 1/32), where the result is small and a fixed error would be
; a large one, x - 1 is exact and log1p goes to r^13/13 instead.
function log[T](x: T) returns T
{
    let v: f64 x as f64
    let zero: f64 0.0
    let one: f64 1.0
    var bits v.to_bits()
    var ex: i64 0
    ; one test for all that is not a positive normal number: below the
    ; smallest normal or from infinity up (negative ones too, NaN)
    if bits - 0x0010000000000000 >= 0x7fe0000000000000
    {
        ; NaN, and infinity: themselves (a NaN by its bits -- `<>` is the
        ; ordered comparison, false for a NaN)
        if (bits & 0x7fffffffffffffff) > 0x7ff0000000000000 or bits = 0x7ff0000000000000
            return x
        if v < zero
        {
            let nan: u64 0x7ff8000000000000
            return nan.float_from_bits() as T
        }
        if v = zero
        {
            let minus_infinity: u64 0xfff0000000000000
            return minus_infinity.float_from_bits() as T
        }
        ; subnormal: scaled by 2^52 into the normal range
        let scaled v * 4503599627370496.0
        bits := scaled.to_bits()
        ex := 0 - 52
    }
    let r0 v - one
    if r0.abs() < 0.03125
    {
        ; log1p(r) = r - r^2/2 + r^3 q: r^2 as hi + lo (lo exact by FMA,
        ; nothing without), -r^2/2 exact, r - r^2/2 with its error kept
        var q r0.mul_add(0.07692307692307693, zero - 0.08333333333333333)
        q := r0.mul_add(q, 0.09090909090909091)
        q := r0.mul_add(q, zero - 0.1)
        q := r0.mul_add(q, 0.1111111111111111)
        q := r0.mul_add(q, zero - 0.125)
        q := r0.mul_add(q, 0.14285714285714285)
        q := r0.mul_add(q, zero - 0.16666666666666666)
        q := r0.mul_add(q, 0.2)
        q := r0.mul_add(q, zero - 0.25)
        q := r0.mul_add(q, 0.3333333333333333)
        let sh r0 * r0
        let sl r0.mul_add(r0, zero - sh)
        let half zero - 0.5 * sh
        let hi0 r0 + half
        let err0 (r0 - hi0) + half
        let lo0 (sh * r0).mul_add(q, err0 - 0.5 * sl)
        return (hi0 + lo0) as T
    }
    ; x's bits less OFF's: e above bit 52 (negative below OFF), the
    ; interval i of m in the 8 bits below; m is x with e taken out
    let ix (bits - 0x3fe6a00000000000) as i64
    let k ix >> 52
    ex := ex + k
    let i ((ix >> 44) & 255) as size_t
    let mbits bits - ((k as u64) << 52)
    let m mbits.float_from_bits()
    let invc_bits LOG_TABLE[3 * i]
    let chi_bits LOG_TABLE[3 * i + 1]
    let clo_bits LOG_TABLE[3 * i + 2]
    let invc invc_bits.float_from_bits()
    let chi chi_bits.float_from_bits()
    ; r = m invc - 1, exact without FMA: m as a high part of 43 bits and
    ; the rest, each times invc (10 bits at most) exact, the high product
    ; less 1 exact (it is near 1), and the sum exact (r fits a double)
    let mhi_bits mbits & 0xfffffffffffffc00
    let mhi mhi_bits.float_from_bits()
    let r ((mhi * invc) - one) + ((m - mhi) * invc)
    ; e ln2 + logc + r, the rounding errors kept: ln2's high part has 42
    ; bits, so e times it is exact, and so is the sum with logc's high
    ; part (a multiple of 2^-42 too)
    let kd ex as f64
    let t2 kd.mul_add(0.6931471805598903, chi)
    let hi t2 + r
    let err2 (t2 - hi) + r
    ; log1p(r) - r
    var p r.mul_add(0.14285714285714285, zero - 0.16666666666666666)
    p := r.mul_add(p, 0.2)
    p := r.mul_add(p, zero - 0.25)
    p := r.mul_add(p, 0.3333333333333333)
    p := r.mul_add(p, zero - 0.5)
    let r2 r * r
    let ln2_lo: u64 0x3d2ef35793c76730
    var lo kd.mul_add(ln2_lo.float_from_bits(), clo_bits.float_from_bits())
    lo := lo + err2
    lo := r2.mul_add(p, lo)
    (hi + lo) as T
}
