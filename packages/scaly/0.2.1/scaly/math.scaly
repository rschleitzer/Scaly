; e^x. x = k ln2/128 + r with |r| <= ln2/256: e^x = 2^(k/128) e^r, the power
; of two from the table times 2^(k div 128), e^r - 1 as r + r^2/2 + r^3/6 +
; r^4/24 + r^5/120 (the next term is below a 400th of the last place).
; ln2/128 is split so that k times its high part is exact (k < 2^18), and r
; comes out exact with or without FMA.
function exp[T](x: T) returns T
{
    let v: f64 x as f64
    let zero: f64 0.0
    ; NaN by its bits: `<>` is the ordered comparison, false for a NaN
    if (v.to_bits() & 0x7fffffffffffffff) > 0x7ff0000000000000
        return x
    if v > 709.782712893384
    {
        let infinity: u64 0x7ff0000000000000
        return infinity.float_from_bits() as T
    }
    if v < 0.0 - 745.1332191019412
        return zero as T
    ; k = round(x 128 / ln 2), i = k mod 128, e = k div 128
    ; z rounded to the nearest whole number, ties to even, by the addition
    ; of 1.5 2^52 (the sum has no bits below the units) and its subtraction:
    ; no library call on any target
    let z v * 184.6649652337873
    let kd (z + 6755399441055744.0) - 6755399441055744.0
    let k kd as i64
    let i (k & 127) as size_t
    let e (k - (i as i64)) / 128
    let nk zero - kd
    let lo_bits: u64 0xbd5718432a1b0e26
    var r nk.mul_add(0.005415212348452769, v)
    r := nk.mul_add(lo_bits.float_from_bits(), r)
    ; e^r - 1
    let r2 r * r
    var p r.mul_add(0.008333333333333333, 0.041666666666666664)
    p := r.mul_add(p, 0.16666666666666666)
    p := r.mul_add(p, 0.5)
    let q r2.mul_add(p, r)
    ; 2^(i/128) e^r = th + (tl + th q)
    let th_bits EXP_TABLE[2 * i]
    let tl_bits EXP_TABLE[2 * i + 1]
    let th th_bits.float_from_bits()
    let t th.mul_add(q, tl_bits.float_from_bits())
    ; A subnormal result has fewer bits than th + t: rounding the sum, then
    ; the subnormal, would round twice. So the two parts, scaled by
    ; 2^(e + 1022) (below 1), are added to 1.0 -- whose last place is the
    ; subnormal's -- the error of that sum kept, and the sum rounded once;
    ; the 1.0 goes again, and 2^-1022 is exact.
    if e < 0 - 1022
    {
        let sb: u64 ((e + 1022 + 1023) as u64) << 52
        let sc sb.float_from_bits()
        let y th * sc
        let low t * sc
        let one: f64 1.0
        let hi one + y
        let rest ((one - hi) + y) + low
        let scaled (hi + rest) - one
        let tiny: u64 0x0010000000000000
        return (scaled * tiny.float_from_bits()) as T
    }
    let m th + t
    ; times 2^e: in one step where 2^e is a normal number, in two near the top
    if e > 1000
    {
        let s1: u64 ((e - 100 + 1023) as u64) << 52
        let s2: u64 ((100 + 1023) as u64) << 52
        return (m * s1.float_from_bits() * s2.float_from_bits()) as T
    }
    let s: u64 ((e + 1023) as u64) << 52
    (m * s.float_from_bits()) as T
}

