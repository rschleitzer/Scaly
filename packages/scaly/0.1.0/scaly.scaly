define scaly
{
    ; fiber before io: the io module routes Console/File through the
    ; fiber module's Io layer (milestone 2.5), and a module must be
    ; declared before the modules that depend on it.
    module memory
    module containers
    module fiber
    module io
    module tensor

    ; Test entry point that calls all module tests
    function test() returns int
    {
        var result memory.test()
        if result <> 0
            return result - 100

        set result: containers.test()
        if result <> 0
            return result - 200

        set result: io.test()
        if result <> 0
            return result - 300

        0
    }
}
