use scaly.memory.runtime

define ArrayIterator[T]
(
    array: pointer[Array[T]]
    position: size_t
)
{
    init (a: pointer[Array[T]])
    {
        set array: a
        set position: 0
    }

    function next(this: ArrayIterator[T]) returns pointer[T]
    {
        if array = null
            return null

        if position = array.length
            return null

        set position: position + 1
        return array.get_buffer() + (position - 1)
    }
}

define Array[T]
(
    length: size_t
    vector: pointer[Vector[T]]
)
{
    init ()
    {
        set length: 0
        set vector: null
    }

    init (size: size_t)
    {
        set length: 0
        set vector: null
        ; Two-step form (same as reallocate): stage-1's planner drops the
        ; chained `(*Page.get(this)).allocate_exclusive_page()` shape.
        let own_page Page.get(this as pointer[void])
        let exclusive_page own_page.allocate_exclusive_page()
        set vector: Vector[T]^exclusive_page(size)
    }

    ; Page-aware initializers for use when Array is allocated on a specific page
    init# (page)
    {
        set length: 0
        set vector: null
    }

    init# (page, size: size_t)
    {
        set length: 0
        set vector: null
        let exclusive_page page.allocate_exclusive_page()
        set vector: Vector[T]^exclusive_page(size)
    }

    function get_buffer(this: Array[T]) returns pointer[T]
    {
        if vector = null
            return null

        return vector.data
    }

    function get_length(this: Array[T]) returns size_t
        length

    function get_capacity(this: Array[T]) returns size_t
    {
        if vector = null
            return 0

        return vector.length
    }

    function add(this: Array[T], item: T)
    {
        if (vector = null) || (length = vector.length)
            this.reallocate()

        let location vector.data + length
        set *location: item

        set length: length + 1
    }

    function add(this: Array[T], items: Vector[T])
    {
        var new_length length + items.length
        ; Unsigned-wraparound check: items.length > 0 should grow the
        ; total. If new_length wraps below the existing length we'd
        ; under-size the allocation below and OOB-write the memcpy.
        if new_length < length
            exit 14

        let size sizeof T
        if (vector = null) || (new_length > vector.length)
            this.reallocate()

        if new_length > vector.length
        {
            ; Manual grow when one reallocate() doubling wasn't enough.
            ; Allocate for new_length items, copy the live `length`
            ; items (NOT capacity), and record new_length as the new
            ; capacity.
            var own_page Page.get(this as pointer[void])
            let data own_page.allocate(new_length * size, alignof T) as pointer[T]
            let bytes_to_copy length * size
            if length > 0
                memcpy(data, vector.data, bytes_to_copy)

            let old_exclusive_page Page.get(vector.data as pointer[void])
            own_page.deallocate_exclusive_page old_exclusive_page
            set vector.data: data
            set vector.length: new_length
        }

        if items.length > 0
            memcpy(vector.data + length * size, items.data, items.length * size)

        set length: length + items.length
    }

    function get(this: Array[T], i: size_t) returns ref[T]?
    {
        if i >= length
            return null

        vector.data + i
    }

    ; Bounds-checked element assign within the collected length (not
    ; the capacity). Growth goes through add only — an index at or past
    ; length is a caller bug, so it traps.
    function put(this: Array[T], i: size_t, item: T)
    {
        if i >= length
        {
            scaly_eputs "Array.put: index out of bounds"
            scaly_eputnl()
            exit 15
        }

        set *(vector.data + i): item
    }

    function get_iterator(this: Array[T]) returns ArrayIterator[T]
        ArrayIterator[T](this)

    operator [](this: Array[T], i: size_t) returns ref[T]?
    {
        ; `i >= length` avoids the `i + 1` overflow at SIZE_MAX.
        if i >= length
            return null

        vector.data + i
    }

    function reallocate(this: Array[T])
    {
        let own_page Page.get(this as pointer[void])
        let size sizeof T
        var length: size_t 0
        if vector = null
        {
            let exclusive_page own_page.allocate_exclusive_page()
            let capacity exclusive_page.get_capacity(alignof T) - sizeof Vector[T]
            set length: capacity / size
            set vector: Vector[T]^exclusive_page(length)
        }
        else
        {
            set length: vector.length * 2
            let new_exclusive_page own_page.allocate_exclusive_page()
            let new_vector Vector[T]^new_exclusive_page(length)
            let bytes_to_copy vector.length * size
            memcpy(new_vector.data, vector.data, bytes_to_copy)
            let old_exclusive_page Page.get(vector as pointer[void])
            own_page.deallocate_exclusive_page old_exclusive_page
            set vector: new_vector
        }
    }
}    
