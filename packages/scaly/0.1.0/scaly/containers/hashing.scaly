define hashing
{

; https://planetmath.org/goodhashtableprimes — curated hash-table
; capacities (~2x growth, primes far from powers of two). Removed in
; s188 when module-level array globals were unported (the table emitted
; as a bodyless external decl); restored 2026-07-07 with the array-global
; port (plan_global pointer[T]+array_size decay, emit_array_global
; [N x T] constant).
define HASH_PRIMES: size_t[] [
    3, 5, 11, 23, 53, 97, 193, 389, 769, 1543, 3079, 6151, 12289, 24593, 49157, 98317, 196613,
    393241, 786433, 1572869, 3145739, 6291469, 12582917, 25165843, 50331653, 100663319, 201326611,
    402653189, 805306457, 1610612741,
]

; s188: is_prime tests divisor*divisor <= candidate instead of
; precomputing sqrt(candidate). The original `sqrt(candidate as double)`
; was a libm call that stage-0 silently DROPPED (emitted sitofp+fptosi,
; no call — the identity, so limit became candidate) and that the s185
; planner diagnostic now hard-errors as "function not found: sqrt". The
; integer test is exact (no fp), libm-free, and lets the self-hosted
; planner walk the hashing namespace so get_prime/hash get real bodies
; for the .ll seed (HashSetBuilder::reallocate calls get_prime;
; String::hash calls hash) instead of declare-only → undefined at link.
function is_prime(candidate: size_t) returns bool
{
    if (candidate & 1) <> 0
    {
        var divisor: size_t 3
        while divisor * divisor <= candidate
        {
            if (candidate % divisor) = 0
                return false

            set divisor: divisor + 2
        }
        return true
    }

    return candidate = 2
}

; Table-first lookup (restored 2026-07-07): return the smallest curated
; prime >= size; sizes beyond the table fall back to the s188 direct
; search for the next odd prime. Capacities are runtime values, so the
; table's return is fixed-point-safe (both stages run the same code).
function get_prime(size: size_t) returns size_t
{
    var ti: int 0
    while ti < 30
    {
        if *(HASH_PRIMES + ti) >= size
            return *(HASH_PRIMES + ti)

        set ti: ti + 1
    }

    var i size | 1
    while i < SIZE_MAX
    {
        if is_prime(i)
            return i

        set i: i + 2
    }
    return size
}

; FNV-1a hash
function hash(data: pointer[char], length: size_t) returns size_t
{
    var hash: size_t 0xcbf29ce484222325
    var prime: size_t 0x100000001b3
    var i: size_t 0
    while i < length
    {
        let value (*(data + i)) as size_t
        ; FNV-1a XOR step. `xor` is the word operator for bitwise XOR —
        ; the `^` token is Scaly's reference-lifetime sigil and cannot be
        ; written as a bitwise operator in expression position. (History:
        ; the legacy `hash // value` used an UNKNOWN operator the emitter
        ; dropped — length-only hash; then the (a|b)-(a&b) identity, which
        ; llc never folded back to xor — 3 ALU ops per byte.)
        set hash: (hash xor value) * prime

        set i: i + (1 as size_t)
    }
    return hash
}

}