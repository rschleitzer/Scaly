; Slice[T] - Non-owning view into contiguous memory
; Zero allocation, zero copy - just pointer + length
; Lifetime bounded by source data

define Slice[T](data: pointer[T], length: size_t)
{

    ; Empty slice
    init ()
    {
        set data: null
        set length: 0
    }

    ; Get element at index (returns None if out of bounds)
    function get(this, index: size_t) returns ref[T]?
    {
        if index >= length
            return null

        data + index
    }


    ; Indexed access. See Array's operator[]: traps on a caller bug, while
    ; get(index) above is the lookup that may legitimately miss.
    operator [](index: size_t) returns T
    {
        if index >= length
        {
            scaly_eputs "Slice[]: index out of bounds"
            scaly_eputnl()
            exit 15
        }

        *(data + index)
    }

    ; Check if empty
    function is_empty(this) returns bool
        length = 0

    ; Create sub-slice (no allocation)
    function subslice(this, start: size_t, end: size_t) returns Slice[T]
    {
        var from start
        var to end
        if from > length
            set from: length

        if to > length
            set to: length

        if from > to
            set from: to

        Slice[T](data + from, to - from)
    }

    ; Slice from start
    function slice_from(this, from: size_t) returns Slice[T]
        subslice(from, length)

    ; Slice to end
    function slice_to(this, to: size_t) returns Slice[T]
        subslice(0, to)

    ; Equality (element-wise)
    function equals(this, other: Slice[T]) returns bool
    {
        if length <> other.length
            return false

        if length = 0
            return true

        memcmp(data as pointer[void], other.data as pointer[void], length * sizeof T) = 0
    }

    ; Bodies inlined from equals() as call-free byte loops: stage-1's
    ; planner resolves NO function call (sibling method or extern
    ; memcmp) from a generic concept's operator body, and since s185
    ; such an unresolvable call is a hard error instead of a silent
    ; drop. Only intrinsic ops (deref, +, <>) appear here. Use the
    ; no-else `if` (statement form) for the early-out — an `if`/`else`
    ; expression in a generic operator body breaks instantiation.
    operator ==(other: Slice[T]) returns bool
    {
        if length <> other.length
            return false
        let a_bytes data as pointer[u8]
        let b_bytes other.data as pointer[u8]
        let n length * sizeof T
        var i: size_t 0
        while i < n
        {
            if *(a_bytes + i) <> *(b_bytes + i)
                return false
            set i: i + 1
        }
        true
    }

    operator <>(other: Slice[T]) returns bool
    {
        if length <> other.length
            return true
        let a_bytes data as pointer[u8]
        let b_bytes other.data as pointer[u8]
        let n length * sizeof T
        var i: size_t 0
        while i < n
        {
            if *(a_bytes + i) <> *(b_bytes + i)
                return true
            set i: i + 1
        }
        false
    }

    ; Check if starts with prefix
    function starts_with(this, prefix: Slice[T]) returns bool
    {
        if prefix.length > length
            return false

        subslice(0, prefix.length) = prefix
    }

    ; Check if ends with suffix
    function ends_with(this, suffix: Slice[T]) returns bool
    {
        if suffix.length > length
            return false

        subslice(length - suffix.length, length) = suffix
    }

    ; Iterator support
    function get_iterator(this) returns SliceIterator[T]
        SliceIterator[T](this)
}

define SliceIterator[T](slice: Slice[T], position: size_t(0))
{
    init (s: Slice[T])
    {
        set slice: s
        set position: 0
    }

    function next(this) returns pointer[T]
    {
        if position >= slice.length
            return null

        let result slice.data + position
        set position: position + 1
        result
    }
}
