define List[T]
(
    head: pointer[Node[T]] (null)
)
{
    function get_head(this: List[T]) returns ref[T]?
    {
        if head = null
            return null

        &head.element
    }

    function count(this: List[T]) returns size_t
    {
        var list_iterator get_iterator()
        var i: size_t 0
        while list_iterator.next() <> null
            set i: i + 1
        i
    }

    ; ★`remove(element: T)` is GONE (2026-09-06), like BuilderList's: it compared
    ; `node.element = element` on a GENERIC T, which has no equality for a struct
    ; T, and a method is emitted for EVERY instantiation (List[Slot[String]],
    ; List[WhenSyntax], ...). The emitter used to drop the whole `if` silently;
    ; the loud kind-mismatch gate in emit_intrinsic_binary_op found it. Nothing
    ; in the tree called it (PageList and ISet carry their own `remove`).

    function get_iterator(this: List[T]) returns ListIterator[T]
        ListIterator[T](head)

    function add(this: List[T], element: T)
    {
        let new_node Node[T]^this(element, head)
        set head: new_node
    }
}
