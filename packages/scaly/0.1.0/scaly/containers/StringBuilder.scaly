use scaly.memory.Page
use scaly.memory.runtime

define StringBuilder
(
    buffer: Array[char]
)
{
    ; StringBuilder allocates its buffer on the object's own page via `^this`,
    ; so it must be page-resident — the residency inference (its `^this`-guts
    ; init + the heap-backed allowlist) makes a no-sigil StringBuilder()
    ; Page::allocate on the caller's local page. No explicit page param needed.

    init ()
    {
        set buffer: Array[char]^this()
    }

    init (size: size_t)
    {
        set buffer: Array[char]^this(size)
    }

    init (character: char)
    {
        set buffer: Array[char]^this()
        append character
    }

    init (string: String)
    {
        set buffer: Array[char]^this()
        append string
    }

    init (c_string: pointer[const_char])
    {
        set buffer: Array[char]^this()
        append c_string
    }

    function append(this: StringBuilder, character: char)
        buffer.add character

    function append(this: StringBuilder, string: String)
        buffer.add(Vector[char](string.get_length(), string.get_buffer()))

    function append(this: StringBuilder, c_string: pointer[const_char])
    {
        let length strlen c_string
        if length = 0
            return

        buffer.add(Vector[char](length, c_string as pointer[char]))
    }

    function append(this: StringBuilder, start: pointer[char], length: size_t)
    {
        buffer.add(Vector[char](length, start))
    }

    ; Decimal formatting overloads — string interpolation desugars an
    ; embedded expression to a plain `append`, so the numeric conversions
    ; live here. Classic divide-by-10 with digit buffer and reversal
    ; (mirrors the compiler's size_to_string).
    function append(this: StringBuilder, value: size_t)
    {
        if value = 0
        {
            append("0" as char)
            return
        }

        var v value
        var digits Array[char]()
        while v > 0
        {
            let digit ((v % 10) as char) + "0" as char
            digits.add digit
            set v: v / 10
        }

        var i digits.length
        while i > 0
        {
            set i: i - 1
            let d digits.get i
            if d <> null
                append(*d)
        }
    }

    function append(this: StringBuilder, value: int)
    {
        if value < 0
        {
            append("-" as char)
            append((0 - value) as size_t)
        }
        else
            append(value as size_t)
    }

    function append(this: StringBuilder, value: bool)
    {
        if value
            append("true")
        else
            append("false")
    }

    function get_length(this: StringBuilder) returns size_t
        buffer.get_length()

    ; ★DIE LETZTE (Zeiger, Laenge)-PAARSTELLE DES BAUMES, und sie bleibt
    ; absichtlich stehen.  Die anderen 131 sind kollabiert (`tools/pairslice.py`):
    ; opensp/dazzle ueber `StringC.as_slice()`, und die sechs im generierten
    ; `parser.scaly` ueber `String(x)` -- ein Copy-`init`, das es die ganze Zeit
    ; gab.  Hier ginge das nicht: `buffer` ist ein `Array[char]`, und `String`
    ; hat kein `init(Slice[char])`.
    ;
    ; ★★★EINES ZU BAUEN WAERE API-FLAECHE FUER GENAU EINE AUFRUFSTELLE.  Es
    ; gehoert dorthin, wo eine POPULATION es braucht -- `String.get_buffer()`
    ; hat 340 Aufrufstellen, aber die sind Walks und nicht Paare, und fuer die
    ; ist `as_slice()` (gibt es) plus `tools/sliceview.py` die Form.  Solange
    ; niemand ausser dieser Zeile danach fragt, ist das Paar hier billiger als
    ; ein sechstes 1-Argument-`init` auf `String`.
    function to_string(this: StringBuilder) returns String
        String(buffer.get_buffer(), buffer.get_length())
}
