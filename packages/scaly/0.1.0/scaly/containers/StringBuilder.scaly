use scaly.memory.Page
use scaly.memory.runtime

define StringBuilder
(
    buffer: Array[char]
)
{
    ; StringBuilder allocates its buffer on the object's own page via `^this`,
    ; so it must be page-resident — the residency inference (its `^this`-guts
    ; init + the heap-backed allowlist) makes a no-sigil StringBuilder()
    ; Page::allocate on the caller's local page. No explicit page param needed.

    init ()
    {
        buffer := Array[char]^this()
    }

    init (size: size_t)
    {
        buffer := Array[char]^this(size)
    }

    init (character: char)
    {
        buffer := Array[char]^this()
        append character
    }

    init (string: String)
    {
        buffer := Array[char]^this()
        append string
    }

    init (c_string: pointer[const_char])
    {
        buffer := Array[char]^this()
        append c_string
    }

    procedure append(mutable this: StringBuilder, character: char)
        buffer.add character

    procedure append(mutable this: StringBuilder, string: String)
        buffer.add_run(string.get_length(), string.get_buffer() as pointer[char])

    procedure append(mutable this: StringBuilder, c_string: pointer[const_char])
    {
        let length strlen c_string
        if length = 0
            return

        buffer.add_run(length, c_string as pointer[char])
    }

    procedure append(mutable this: StringBuilder, start: pointer[char], length: size_t)
        buffer.add_run(length, start)

    ; Decimal formatting overloads — string interpolation desugars an
    ; embedded expression to a plain `append`, so the numeric conversions
    ; live here. Classic divide-by-10 with digit buffer and reversal
    ; (mirrors the compiler's size_to_string).
    procedure append(mutable this: StringBuilder, value: size_t)
    {
        if value = 0
        {
            append("0" as char)
            return
        }

        var v value
        var digits Array[char]()
        while v > 0
        {
            let digit ((v % 10) as char) + ("0" as char)
            digits.add digit
            v := v / 10
        }

        var i digits.length
        while i > 0
        {
            i := i - 1
            let d digits.get i
            if d <> null
                append(*d)
        }
    }

    procedure append(mutable this: StringBuilder, value: int)
    {
        if value < 0
        {
            append("-" as char)
            append((0 - value) as size_t)
        }
        else
            append(value as size_t)
    }

    procedure append(mutable this: StringBuilder, value: bool)
    {
        if value
            append("true")
        else
            append("false")
    }

    function get_length(this: StringBuilder) returns size_t
        buffer.get_length()

    ; ★THE TREE'S LAST (pointer, length) PAIR SITE, and it stays standing
    ; on purpose.  The other 131 have been collapsed (`tools/pairslice.py`):
    ; opensp/dazzle through `StringC.as_slice()`, and the six in the generated
    ; `parser.scaly` through `String(x)` -- a copy `init` that had been there
    ; the whole time.  That would not work in this place: `buffer` is an
    ; `Array[char]`, and `String` has no `init(Slice[char])`.
    ;
    ; ★★★BUILDING ONE WOULD BE API SURFACE FOR EXACTLY ONE CALL SITE.  It
    ; belongs where a POPULATION needs it -- `String.get_buffer()`
    ; has 340 call sites, but those are walks and not pairs, and for those
    ; `as_slice()` (which does exist) plus `tools/sliceview.py` is the form.  As
    ; long as nobody apart from this line asks for it, the pair is cheaper here
    ; than a sixth 1-argument `init` on `String`.
    function to_string(this: StringBuilder) returns String
        String(buffer.get_buffer(), buffer.get_length())
}
