define StringIterator
(
    var current: pointer[char]
    last: pointer[char]
)
{

init(string: String)
{
    let buffer string.get_buffer()
    set current: buffer
    set last: buffer + string.get_length()
}

procedure next(mutable this: StringIterator) returns pointer[char]
{
    if current = last
        return null
    else
    {
        let ret current
        set current: current + 1
        return ret
    }
}

}
