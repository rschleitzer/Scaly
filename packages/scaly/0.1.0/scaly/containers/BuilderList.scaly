use scaly.memory.Page

define BuilderList[T] (head: pointer[Node[T]])
{

    init ()
    {
        set head: null
    }

    ; The node page is an EXPLICIT parameter (mirrors the retired C++
    ; `add(Page* private_page, T element)`). `Node[T]^this` would derive
    ; the page via Page.get(this) — but a BuilderList embedded in a big
    ; (>PAGE_SIZE, oversized) slots-vector buffer has NO page header at
    ; its masked address: Page.get returns the oversized page header
    ; (next_object = null) or an interior garbage "header", and the node
    ; allocation returns ~null / corrupts. Callers pass the page that
    ; OWNS the slots vector (Page.get(slots) / the fresh exclusive page).
    function add(this: BuilderList[T], page: ref[Page], element: T)
    {
        let new_node Node[T]^page(element, head)
        set head: new_node
    }

    function remove(this: BuilderList[T], element: T) returns bool
    {
        var node head
        var previous_node: pointer[Node[T]] null
        while node <> null
        {
            if node.element = element
            {
                if previous_node <> null
                    set previous_node.next: node.next

                if node = head
                    set head: node.next

                return true
            }

            set previous_node: node
            set node: node.next
        }
        return false
    }

    function get_head(this: BuilderList[T]) returns ref[T]?
    {
        if head = null
            return null

        &head.element
    }

    function count(this: BuilderList[T]) returns size_t
    {
        var list_iterator get_iterator()
        var i: size_t 0
        while list_iterator.next() <> null
            set i: i + 1
        return i
    }

    function get_iterator(this: BuilderList[T]) returns BuilderListIterator[T]
        BuilderListIterator[T](head)
}
