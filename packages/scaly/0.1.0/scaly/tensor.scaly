; Tensor tape (self-scaling stage 5.2/5.3/5.4): reverse-mode autodiff
; over the 5.1 op set — matmul, GELU, softmax, layernorm, embedding
; lookup — plus a weighted-sum reduction, (5.3) a fused
; softmax-crossentropy objective, in-place token mutation (set_token:
; one tape serves a whole training run, a step allocates nothing),
; SGD/Adam leaf updates (Adam moments live in the node's aux buffer on
; the tape's page), and (5.4) fused causal multi-head self-attention
; (softmax(QK^T/sqrt(dh)) masked to j <= i, per head), elementwise add
; (residual connections, positional embeddings) and a sampling helper
; for inference (temperature softmax + CDF walk over one row).
;
; One region per tape: a Tape is page-hosted, and every node record,
; value buffer, gradient buffer and saved auxiliary lives on the tape's
; page (the allocating tape methods derive it via Page.get(this) and
; construct with ^own_page). Dropping the tape's page frees a whole
; training step's activations and gradients wholesale — no per-buffer
; bookkeeping.
;
; Usage:
;   var tape Tape()
;   let x tape.leaf(2, 3)            ; fill via tape.set_value(x, i, v)
;   let w tape.leaf(3, 2)
;   let y tape.matmul(x, w)          ; forward runs at creation
;   let s tape.wsum(y, weights)      ; scalar objective
;   tape.backward s                  ; adjoints accumulate into node grads
;   let g tape.grad_at(x, 0)
;
; Node ids are ints in creation order; inputs always precede consumers,
; so backward is a reverse id walk. Gradient buffers are allocated
; zeroed at node creation and ACCUMULATE (+=) — call zero_grads before
; reusing a tape for another backward pass. recompute() re-runs every
; op in id order against the current leaf values (numeric gradcheck
; perturbs a leaf and recomputes).

use scaly.memory.Page
use scaly.containers.Vector
use scaly.containers.Array

function expf(x: float) returns float extern
function tanhf(x: float) returns float extern
function sqrtf(x: float) returns float extern
function logf(x: float) returns float extern
function powf(x: float, y: float) returns float extern

; --- register-tiled 4x4 f32 matmul kernels (the 5.1 kernel shape:
; call-free inner loop over pointer subscripts, disjoint c.put writes,
; parallel over 4-row tiles). Each requires its tiled dimensions % 4 =
; 0; the tape methods call them only when the shapes qualify and fall
; back to the naive triple loop otherwise. Backward variants ACCUMULATE
; (read-add through put) — a node's grad receives contributions from
; every consumer, and disjoint tiles keep each slot single-writer per
; call. ---

; C = A * B (A m x kk, B kk x n, C m x n). m % 4 = 0, n % 4 = 0.
procedure mm_tiled(a: Vector[float], b: Vector[float], c: ref[Vector[float]], m: int, kk: int, n: int)
{
    let ap a.data
    let bp b.data
    let mt m / 4
    for it in mt
    {
        var j 0
        while j < n
        {
            var a00: float 0.0
            var a01: float 0.0
            var a02: float 0.0
            var a03: float 0.0
            var a10: float 0.0
            var a11: float 0.0
            var a12: float 0.0
            var a13: float 0.0
            var a20: float 0.0
            var a21: float 0.0
            var a22: float 0.0
            var a23: float 0.0
            var a30: float 0.0
            var a31: float 0.0
            var a32: float 0.0
            var a33: float 0.0
            var x 0
            while x < kk
            {
                let r0 ap[(it * 4 + 0) * kk + x]
                let r1 ap[(it * 4 + 1) * kk + x]
                let r2 ap[(it * 4 + 2) * kk + x]
                let r3 ap[(it * 4 + 3) * kk + x]
                let c0 bp[x * n + j]
                let c1 bp[x * n + j + 1]
                let c2 bp[x * n + j + 2]
                let c3 bp[x * n + j + 3]
                set a00: a00 + r0 * c0
                set a01: a01 + r0 * c1
                set a02: a02 + r0 * c2
                set a03: a03 + r0 * c3
                set a10: a10 + r1 * c0
                set a11: a11 + r1 * c1
                set a12: a12 + r1 * c2
                set a13: a13 + r1 * c3
                set a20: a20 + r2 * c0
                set a21: a21 + r2 * c1
                set a22: a22 + r2 * c2
                set a23: a23 + r2 * c3
                set a30: a30 + r3 * c0
                set a31: a31 + r3 * c1
                set a32: a32 + r3 * c2
                set a33: a33 + r3 * c3
                set x: x + 1
            }
            c.put(((it * 4 + 0) * n + j) as size_t, a00)
            c.put(((it * 4 + 0) * n + j + 1) as size_t, a01)
            c.put(((it * 4 + 0) * n + j + 2) as size_t, a02)
            c.put(((it * 4 + 0) * n + j + 3) as size_t, a03)
            c.put(((it * 4 + 1) * n + j) as size_t, a10)
            c.put(((it * 4 + 1) * n + j + 1) as size_t, a11)
            c.put(((it * 4 + 1) * n + j + 2) as size_t, a12)
            c.put(((it * 4 + 1) * n + j + 3) as size_t, a13)
            c.put(((it * 4 + 2) * n + j) as size_t, a20)
            c.put(((it * 4 + 2) * n + j + 1) as size_t, a21)
            c.put(((it * 4 + 2) * n + j + 2) as size_t, a22)
            c.put(((it * 4 + 2) * n + j + 3) as size_t, a23)
            c.put(((it * 4 + 3) * n + j) as size_t, a30)
            c.put(((it * 4 + 3) * n + j + 1) as size_t, a31)
            c.put(((it * 4 + 3) * n + j + 2) as size_t, a32)
            c.put(((it * 4 + 3) * n + j + 3) as size_t, a33)
            set j: j + 4
        }
    }
}

; dA += dC * B^T : dA[i,x] += sum_j dC[i,j] * B[x,j]. dC m x n,
; B kk x n, dA m x kk. m % 4 = 0, kk % 4 = 0.
procedure mm_tiled_dA(gc: Vector[float], b: Vector[float], ga: ref[Vector[float]], m: int, kk: int, n: int)
{
    let gcp gc.data
    let bp b.data
    let gap ga.data
    let mt m / 4
    for it in mt
    {
        var xt 0
        while xt < kk
        {
            var a00: float 0.0
            var a01: float 0.0
            var a02: float 0.0
            var a03: float 0.0
            var a10: float 0.0
            var a11: float 0.0
            var a12: float 0.0
            var a13: float 0.0
            var a20: float 0.0
            var a21: float 0.0
            var a22: float 0.0
            var a23: float 0.0
            var a30: float 0.0
            var a31: float 0.0
            var a32: float 0.0
            var a33: float 0.0
            var j 0
            while j < n
            {
                let d0 gcp[(it * 4 + 0) * n + j]
                let d1 gcp[(it * 4 + 1) * n + j]
                let d2 gcp[(it * 4 + 2) * n + j]
                let d3 gcp[(it * 4 + 3) * n + j]
                let k0 bp[(xt + 0) * n + j]
                let k1 bp[(xt + 1) * n + j]
                let k2 bp[(xt + 2) * n + j]
                let k3 bp[(xt + 3) * n + j]
                set a00: a00 + d0 * k0
                set a01: a01 + d0 * k1
                set a02: a02 + d0 * k2
                set a03: a03 + d0 * k3
                set a10: a10 + d1 * k0
                set a11: a11 + d1 * k1
                set a12: a12 + d1 * k2
                set a13: a13 + d1 * k3
                set a20: a20 + d2 * k0
                set a21: a21 + d2 * k1
                set a22: a22 + d2 * k2
                set a23: a23 + d2 * k3
                set a30: a30 + d3 * k0
                set a31: a31 + d3 * k1
                set a32: a32 + d3 * k2
                set a33: a33 + d3 * k3
                set j: j + 1
            }
            ga.put(((it * 4 + 0) * kk + xt + 0) as size_t, gap[(it * 4 + 0) * kk + xt + 0] + a00)
            ga.put(((it * 4 + 0) * kk + xt + 1) as size_t, gap[(it * 4 + 0) * kk + xt + 1] + a01)
            ga.put(((it * 4 + 0) * kk + xt + 2) as size_t, gap[(it * 4 + 0) * kk + xt + 2] + a02)
            ga.put(((it * 4 + 0) * kk + xt + 3) as size_t, gap[(it * 4 + 0) * kk + xt + 3] + a03)
            ga.put(((it * 4 + 1) * kk + xt + 0) as size_t, gap[(it * 4 + 1) * kk + xt + 0] + a10)
            ga.put(((it * 4 + 1) * kk + xt + 1) as size_t, gap[(it * 4 + 1) * kk + xt + 1] + a11)
            ga.put(((it * 4 + 1) * kk + xt + 2) as size_t, gap[(it * 4 + 1) * kk + xt + 2] + a12)
            ga.put(((it * 4 + 1) * kk + xt + 3) as size_t, gap[(it * 4 + 1) * kk + xt + 3] + a13)
            ga.put(((it * 4 + 2) * kk + xt + 0) as size_t, gap[(it * 4 + 2) * kk + xt + 0] + a20)
            ga.put(((it * 4 + 2) * kk + xt + 1) as size_t, gap[(it * 4 + 2) * kk + xt + 1] + a21)
            ga.put(((it * 4 + 2) * kk + xt + 2) as size_t, gap[(it * 4 + 2) * kk + xt + 2] + a22)
            ga.put(((it * 4 + 2) * kk + xt + 3) as size_t, gap[(it * 4 + 2) * kk + xt + 3] + a23)
            ga.put(((it * 4 + 3) * kk + xt + 0) as size_t, gap[(it * 4 + 3) * kk + xt + 0] + a30)
            ga.put(((it * 4 + 3) * kk + xt + 1) as size_t, gap[(it * 4 + 3) * kk + xt + 1] + a31)
            ga.put(((it * 4 + 3) * kk + xt + 2) as size_t, gap[(it * 4 + 3) * kk + xt + 2] + a32)
            ga.put(((it * 4 + 3) * kk + xt + 3) as size_t, gap[(it * 4 + 3) * kk + xt + 3] + a33)
            set xt: xt + 4
        }
    }
}

; dB += A^T * dC : dB[x,j] += sum_i A[i,x] * dC[i,j]. A m x kk,
; dC m x n, dB kk x n. kk % 4 = 0, n % 4 = 0.
procedure mm_tiled_dB(a: Vector[float], gc: Vector[float], gb: ref[Vector[float]], m: int, kk: int, n: int)
{
    let ap a.data
    let gcp gc.data
    let gbp gb.data
    let kt kk / 4
    for xt in kt
    {
        var j 0
        while j < n
        {
            var a00: float 0.0
            var a01: float 0.0
            var a02: float 0.0
            var a03: float 0.0
            var a10: float 0.0
            var a11: float 0.0
            var a12: float 0.0
            var a13: float 0.0
            var a20: float 0.0
            var a21: float 0.0
            var a22: float 0.0
            var a23: float 0.0
            var a30: float 0.0
            var a31: float 0.0
            var a32: float 0.0
            var a33: float 0.0
            var i 0
            while i < m
            {
                let r0 ap[i * kk + xt * 4 + 0]
                let r1 ap[i * kk + xt * 4 + 1]
                let r2 ap[i * kk + xt * 4 + 2]
                let r3 ap[i * kk + xt * 4 + 3]
                let d0 gcp[i * n + j]
                let d1 gcp[i * n + j + 1]
                let d2 gcp[i * n + j + 2]
                let d3 gcp[i * n + j + 3]
                set a00: a00 + r0 * d0
                set a01: a01 + r0 * d1
                set a02: a02 + r0 * d2
                set a03: a03 + r0 * d3
                set a10: a10 + r1 * d0
                set a11: a11 + r1 * d1
                set a12: a12 + r1 * d2
                set a13: a13 + r1 * d3
                set a20: a20 + r2 * d0
                set a21: a21 + r2 * d1
                set a22: a22 + r2 * d2
                set a23: a23 + r2 * d3
                set a30: a30 + r3 * d0
                set a31: a31 + r3 * d1
                set a32: a32 + r3 * d2
                set a33: a33 + r3 * d3
                set i: i + 1
            }
            gb.put(((xt * 4 + 0) * n + j) as size_t, gbp[(xt * 4 + 0) * n + j] + a00)
            gb.put(((xt * 4 + 0) * n + j + 1) as size_t, gbp[(xt * 4 + 0) * n + j + 1] + a01)
            gb.put(((xt * 4 + 0) * n + j + 2) as size_t, gbp[(xt * 4 + 0) * n + j + 2] + a02)
            gb.put(((xt * 4 + 0) * n + j + 3) as size_t, gbp[(xt * 4 + 0) * n + j + 3] + a03)
            gb.put(((xt * 4 + 1) * n + j) as size_t, gbp[(xt * 4 + 1) * n + j] + a10)
            gb.put(((xt * 4 + 1) * n + j + 1) as size_t, gbp[(xt * 4 + 1) * n + j + 1] + a11)
            gb.put(((xt * 4 + 1) * n + j + 2) as size_t, gbp[(xt * 4 + 1) * n + j + 2] + a12)
            gb.put(((xt * 4 + 1) * n + j + 3) as size_t, gbp[(xt * 4 + 1) * n + j + 3] + a13)
            gb.put(((xt * 4 + 2) * n + j) as size_t, gbp[(xt * 4 + 2) * n + j] + a20)
            gb.put(((xt * 4 + 2) * n + j + 1) as size_t, gbp[(xt * 4 + 2) * n + j + 1] + a21)
            gb.put(((xt * 4 + 2) * n + j + 2) as size_t, gbp[(xt * 4 + 2) * n + j + 2] + a22)
            gb.put(((xt * 4 + 2) * n + j + 3) as size_t, gbp[(xt * 4 + 2) * n + j + 3] + a23)
            gb.put(((xt * 4 + 3) * n + j) as size_t, gbp[(xt * 4 + 3) * n + j] + a30)
            gb.put(((xt * 4 + 3) * n + j + 1) as size_t, gbp[(xt * 4 + 3) * n + j + 1] + a31)
            gb.put(((xt * 4 + 3) * n + j + 2) as size_t, gbp[(xt * 4 + 3) * n + j + 2] + a32)
            gb.put(((xt * 4 + 3) * n + j + 3) as size_t, gbp[(xt * 4 + 3) * n + j + 3] + a33)
            set j: j + 4
        }
    }
}

define TAPE_LEAF int 0
define TAPE_MATMUL int 1
define TAPE_GELU int 2
define TAPE_SOFTMAX int 3
define TAPE_LAYERNORM int 4
define TAPE_EMBEDDING int 5
define TAPE_WSUM int 6
define TAPE_CROSSENT int 7
define TAPE_ATTENTION int 8
define TAPE_ADD int 9
define TAPE_ADD_BCAST int 10

define TapeNode
(
    op: int
    a: int
    b: int
    c: int
    rows: int
    cols: int
    heads: int
    win: int
    eps: float
    value: Vector[float]
    grad: Vector[float]
    aux: Vector[float]
    tok: Vector[i64]
)
{
    init (kind: int, in_a: int, in_b: int, in_c: int, r: int, n: int)
    {
        set op: kind
        set a: in_a
        set b: in_b
        set c: in_c
        set rows: r
        set cols: n
        set heads: 1
        set win: r
        set eps: 0.0
        set value: Vector[float]()
        set grad: Vector[float]()
        set aux: Vector[float]()
        set tok: Vector[i64]()
    }
}

define Tape
(
    nodes: Array[TapeNode]
)
{
    init ()
    {
        set nodes: Array[TapeNode]()
    }

    procedure add_node(this: Tape, kind: int, in_a: int, in_b: int, in_c: int, r: int, n: int) returns int
    {
        let own_page Page.get(this as pointer[void])
        var node TapeNode(kind, in_a, in_b, in_c, r, n)
        let v Vector[float]^own_page((r * n) as size_t)
        let g Vector[float]^own_page((r * n) as size_t)
        set node.value: v
        set node.grad: g
        let id nodes.get_length() as int
        nodes.add node
        id
    }

    procedure leaf(this: Tape, r: int, n: int) returns int
        this.add_node(TAPE_LEAF, 0 - 1, 0 - 1, 0 - 1, r, n)

    procedure set_value(this: Tape, id: int, i: int, v: float)
    {
        let node nodes.get_buffer() + id
        let vv node.value
        vv.put(i as size_t, v)
    }

    ; Overwrite a saved token id in place (embedding ids or crossent
    ; targets) — a training loop mutates the batch data of an existing
    ; tape instead of building a new one, so a step allocates nothing.
    procedure set_token(this: Tape, id: int, i: int, v: i64)
    {
        let node nodes.get_buffer() + id
        let tk node.tok
        tk.put(i as size_t, v)
    }

    function value_at(this: Tape, id: int, i: int) returns float
    {
        let node nodes.get_buffer() + id
        let p node.value.data
        p[i]
    }

    ; Overwrite a gradient slot in place. The distributed trainer (7.4)
    ; injects an all-reduced (averaged) gradient here before adam_step,
    ; so every rank applies an identical update and stays in lockstep.
    procedure set_grad(this: Tape, id: int, i: int, v: float)
    {
        let node nodes.get_buffer() + id
        let g node.grad
        g.put(i as size_t, v)
    }

    function grad_at(this: Tape, id: int, i: int) returns float
    {
        let node nodes.get_buffer() + id
        let p node.grad.data
        p[i]
    }

    function node_rows(this: Tape, id: int) returns int
    {
        let node nodes.get_buffer() + id
        node.rows
    }

    function node_cols(this: Tape, id: int) returns int
    {
        let node nodes.get_buffer() + id
        node.cols
    }

    procedure matmul(this: Tape, x: int, y: int) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let ny buf + y
        let m nx.rows
        let n ny.cols
        let id this.add_node(TAPE_MATMUL, x, y, 0 - 1, m, n)
        this.run_node id
        id
    }

    procedure gelu(this: Tape, x: int) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let r nx.rows
        let n nx.cols
        let id this.add_node(TAPE_GELU, x, 0 - 1, 0 - 1, r, n)
        this.run_node id
        id
    }

    procedure softmax(this: Tape, x: int) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let r nx.rows
        let n nx.cols
        let id this.add_node(TAPE_SOFTMAX, x, 0 - 1, 0 - 1, r, n)
        this.run_node id
        id
    }

    procedure layernorm(this: Tape, x: int, gamma: int, beta: int, e: float) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let r nx.rows
        let n nx.cols
        let id this.add_node(TAPE_LAYERNORM, x, gamma, beta, r, n)
        let node nodes.get_buffer() + id
        set node.eps: e
        this.run_node id
        id
    }

    procedure embedding(this: Tape, table: int, ids: Vector[i64], tokens: int) returns int
    {
        let buf nodes.get_buffer()
        let nt buf + table
        let dim nt.cols
        let id this.add_node(TAPE_EMBEDDING, table, 0 - 1, 0 - 1, tokens, dim)
        let own_page Page.get(this as pointer[void])
        let tk Vector[i64]^own_page(ids)
        let node nodes.get_buffer() + id
        set node.tok: tk
        this.run_node id
        id
    }

    procedure wsum(this: Tape, x: int, w: Vector[float]) returns int
    {
        let id this.add_node(TAPE_WSUM, x, 0 - 1, 0 - 1, 1, 1)
        let own_page Page.get(this as pointer[void])
        let ws Vector[float]^own_page(w)
        let node nodes.get_buffer() + id
        set node.aux: ws
        this.run_node id
        id
    }

    ; Fused softmax + negative log-likelihood, averaged over rows:
    ; value = mean_i(logsumexp(x_i) - x_i[target_i]). targets holds one
    ; token id per row of the logits node.
    procedure crossentropy(this: Tape, logits: int, targets: Vector[i64]) returns int
    {
        let id this.add_node(TAPE_CROSSENT, logits, 0 - 1, 0 - 1, 1, 1)
        let own_page Page.get(this as pointer[void])
        let tk Vector[i64]^own_page(targets)
        let node nodes.get_buffer() + id
        set node.tok: tk
        this.run_node id
        id
    }

    ; Elementwise sum of two same-shape nodes — residual connections
    ; and positional embeddings. x and y may be the same node.
    procedure add(this: Tape, x: int, y: int) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let r nx.rows
        let n nx.cols
        let id this.add_node(TAPE_ADD, x, y, 0 - 1, r, n)
        this.run_node id
        id
    }

    ; Broadcast sum: x is (B*yr) x n, y is yr x n; out row i adds
    ; y row (i mod yr). Adds one shared positional-embedding block to
    ; every window of a batched activation. Backward accumulates dy
    ; across the B repeats (shared slots — bwd stays sequential).
    procedure add_bcast(this: Tape, x: int, y: int) returns int
    {
        let buf nodes.get_buffer()
        let nx buf + x
        let r nx.rows
        let n nx.cols
        let id this.add_node(TAPE_ADD_BCAST, x, y, 0 - 1, r, n)
        this.run_node id
        id
    }

    ; Fused causal multi-head self-attention: q/k/v are T x D nodes
    ; (D = hs * dh, D divisible by hs); per head, out row i is
    ; softmax(q_i . k_j / sqrt(dh) for j <= i)-weighted sum of v rows.
    ; The node's aux buffer holds the per-head probabilities in
    ; [0, hs*T*win) (forward writes them, backward reads them) and a ds
    ; scratch half in [hs*T*win, 2*hs*T*win) written by backward pass 1.
    procedure attention(this: Tape, q: int, k: int, v: int, hs: int) returns int
    {
        let buf nodes.get_buffer()
        let nq buf + q
        let t nq.rows
        this.attention_windowed(q, k, v, hs, t)
    }

    ; Batched causal attention: the T rows are nwin = T/win consecutive
    ; windows of `win` rows each; a query attends only to keys in its
    ; OWN window (j in [window_start, i]). win = T is the single-window
    ; case `attention` uses (probabilities index identically, so that
    ; path stays numerically exact). Column extent per query is win, so
    ; the aux buffer is hs*T*win doubled for the ds scratch.
    procedure attention_windowed(this: Tape, q: int, k: int, v: int, hs: int, win: int) returns int
    {
        let buf nodes.get_buffer()
        let nq buf + q
        let t nq.rows
        let d nq.cols
        let id this.add_node(TAPE_ATTENTION, q, k, v, t, d)
        let own_page Page.get(this as pointer[void])
        let scratch Vector[float]^own_page((2 * hs * t * win) as size_t)
        let node nodes.get_buffer() + id
        set node.aux: scratch
        set node.heads: hs
        set node.win: win
        this.run_node id
        id
    }

    ; Sample a token from one row of a node's values (logits): softmax
    ; at temperature temp (must be > 0), then walk the CDF with the
    ; caller-supplied uniform draw u in [0, 1). The caller owns the RNG.
    function sample(this: Tape, id: int, row: int, temp: float, u: float) returns int
    {
        let node nodes.get_buffer() + id
        let xp node.value.data
        let n node.cols
        let off row * n
        let itemp 1.0 / temp
        var mx xp[off]
        var j 1
        while j < n
        {
            let v xp[off + j]
            if v > mx
                set mx: v
            set j: j + 1
        }
        var sum: float 0.0
        var j2 0
        while j2 < n
        {
            set sum: sum + expf((xp[off + j2] - mx) * itemp)
            set j2: j2 + 1
        }
        let target u * sum
        var acc: float 0.0
        var j3 0
        while j3 < n
        {
            set acc: acc + expf((xp[off + j3] - mx) * itemp)
            if acc > target
                return j3
            set j3: j3 + 1
        }
        n - 1
    }

    ; SGD update on a leaf: value -= lr * grad.
    procedure sgd_step(this: Tape, id: int, lr: float)
    {
        let node nodes.get_buffer() + id
        let vp node.value.data
        let gp node.grad.data
        let total node.rows * node.cols
        var i 0
        while i < total
        {
            set vp[i]: vp[i] - lr * gp[i]
            set i: i + 1
        }
    }

    ; Adam update on a leaf. Moment state lives in the node's aux
    ; buffer (m at [0,total), v at [total,2*total)), lazily allocated
    ; zeroed on the tape's page at the first step. t is the 1-based
    ; step count for bias correction.
    procedure adam_step(this: Tape, id: int, lr: float, b1: float, b2: float, e: float, t: int)
    {
        let own_page Page.get(this as pointer[void])
        let node nodes.get_buffer() + id
        let total node.rows * node.cols
        let auxlen node.aux.length as int
        if auxlen < total * 2
        {
            let mv Vector[float]^own_page((total * 2) as size_t)
            set node.aux: mv
        }
        let vp node.value.data
        let gp node.grad.data
        let mp node.aux.data
        let bc1 1.0 - powf(b1, t as float)
        let bc2 1.0 - powf(b2, t as float)
        var i 0
        while i < total
        {
            let g gp[i]
            let m b1 * mp[i] + (1.0 - b1) * g
            let v b2 * mp[total + i] + (1.0 - b2) * g * g
            set mp[i]: m
            set mp[total + i]: v
            let mhat m / bc1
            let vhat v / bc2
            set vp[i]: vp[i] - lr * mhat / (sqrtf(vhat) + e)
            set i: i + 1
        }
    }

    ; Re-run every op in id order against the current leaf values.
    procedure recompute(this: Tape)
    {
        let count nodes.get_length() as int
        var i 0
        while i < count
        {
            this.run_node i
            set i: i + 1
        }
    }

    procedure zero_grads(this: Tape)
    {
        let count nodes.get_length() as int
        var i 0
        while i < count
        {
            let node nodes.get_buffer() + i
            let g node.grad
            let total node.rows * node.cols
            var j 0
            while j < total
            {
                g.put(j as size_t, 0.0)
                set j: j + 1
            }
            set i: i + 1
        }
    }

    ; Seed d(out)/d(out) = 1 and accumulate adjoints into every
    ; ancestor's grad buffer (reverse id walk — inputs precede
    ; consumers by construction).
    procedure backward(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let out buf + id
        let g out.grad
        let total out.rows * out.cols
        var s 0
        while s < total
        {
            g.put(s as size_t, 1.0)
            set s: s + 1
        }
        var i id
        while i >= 0
        {
            this.bwd_node i
            set i: i - 1
        }
    }

    procedure run_node(this: Tape, id: int)
    {
        let node nodes.get_buffer() + id
        let kind node.op
        if kind = TAPE_MATMUL
            this.fwd_matmul id
        if kind = TAPE_GELU
            this.fwd_gelu id
        if kind = TAPE_SOFTMAX
            this.fwd_softmax id
        if kind = TAPE_LAYERNORM
            this.fwd_layernorm id
        if kind = TAPE_EMBEDDING
            this.fwd_embedding id
        if kind = TAPE_WSUM
            this.fwd_wsum id
        if kind = TAPE_CROSSENT
            this.fwd_crossent id
        if kind = TAPE_ATTENTION
            this.fwd_attention id
        if kind = TAPE_ADD
            this.fwd_add id
        if kind = TAPE_ADD_BCAST
            this.fwd_add_bcast id
    }

    procedure bwd_node(this: Tape, id: int)
    {
        let node nodes.get_buffer() + id
        let kind node.op
        if kind = TAPE_MATMUL
            this.bwd_matmul id
        if kind = TAPE_GELU
            this.bwd_gelu id
        if kind = TAPE_SOFTMAX
            this.bwd_softmax id
        if kind = TAPE_LAYERNORM
            this.bwd_layernorm id
        if kind = TAPE_EMBEDDING
            this.bwd_embedding id
        if kind = TAPE_WSUM
            this.bwd_wsum id
        if kind = TAPE_CROSSENT
            this.bwd_crossent id
        if kind = TAPE_ATTENTION
            this.bwd_attention id
        if kind = TAPE_ADD
            this.bwd_add id
        if kind = TAPE_ADD_BCAST
            this.bwd_add_bcast id
    }

    procedure fwd_matmul(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let m na.rows
        let kk na.cols
        let n nb.cols
        let ap na.value.data
        let bp nb.value.data
        let out node.value
        ; tiled fast path when the tiled dims (m rows, n cols) are 4-
        ; multiples; the naive triple loop covers every other shape
        ; (char-demo head V=81, gradcheck 3x3, ...).
        if (m / 4) * 4 = m
        {
            if (n / 4) * 4 = n
            {
                mm_tiled(na.value, nb.value, &node.value, m, kk, n)
                return
            }
        }
        for i in m
        {
            var j 0
            while j < n
            {
                var acc: float 0.0
                var x 0
                while x < kk
                {
                    set acc: acc + ap[i * kk + x] * bp[x * n + j]
                    set x: x + 1
                }
                out.put((i * n + j) as size_t, acc)
                set j: j + 1
            }
        }
    }

    procedure bwd_matmul(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let m na.rows
        let kk na.cols
        let n nb.cols
        let ap na.value.data
        let bp nb.value.data
        let gp node.grad.data
        let gap na.grad.data
        let gbp nb.grad.data
        let ga na.grad
        let gb nb.grad
        let m4 (m / 4) * 4 = m
        let kk4 (kk / 4) * 4 = kk
        let n4 (n / 4) * 4 = n
        ; dA[i,x] += sum_j dC[i,j] * B[x,j] — tiled over (row, col=x)
        ; when m,kk are 4-multiples; naive row-disjoint loop otherwise
        ; (both accumulate via put so the row loop classifies parallel).
        var did_dA false
        if m4
        {
            if kk4
            {
                mm_tiled_dA(node.grad, nb.value, &na.grad, m, kk, n)
                set did_dA: true
            }
        }
        if did_dA = false
        {
            for i in m
            {
                var x 0
                while x < kk
                {
                    var acc: float 0.0
                    var j 0
                    while j < n
                    {
                        set acc: acc + gp[i * n + j] * bp[x * n + j]
                        set j: j + 1
                    }
                    ga.put((i * kk + x) as size_t, gap[i * kk + x] + acc)
                    set x: x + 1
                }
            }
        }
        ; dB[x,j] += sum_i A[i,x] * dC[i,j] — tiled over (x, col) when
        ; kk,n are 4-multiples; naive otherwise.
        var did_dB false
        if kk4
        {
            if n4
            {
                mm_tiled_dB(na.value, node.grad, &nb.grad, m, kk, n)
                set did_dB: true
            }
        }
        if did_dB = false
        {
            for x2 in kk
            {
                var j 0
                while j < n
                {
                    var acc: float 0.0
                    var i2 0
                    while i2 < m
                    {
                        set acc: acc + ap[i2 * kk + x2] * gp[i2 * n + j]
                        set i2: i2 + 1
                    }
                    gb.put((x2 * n + j) as size_t, gbp[x2 * n + j] + acc)
                    set j: j + 1
                }
            }
        }
    }

    procedure fwd_gelu(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let out node.value
        let r node.rows
        let n node.cols
        for i in r
        {
            var j 0
            while j < n
            {
                let v xp[i * n + j]
                let inner 0.7978845608 * (v + 0.044715 * v * v * v)
                let t tanhf(inner)
                let g 0.5 * v * (1.0 + t)
                out.put((i * n + j) as size_t, g)
                set j: j + 1
            }
        }
    }

    procedure bwd_gelu(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let gp node.grad.data
        let gxp na.grad.data
        let ga na.grad
        let r node.rows
        let n node.cols
        for i in r
        {
            var j 0
            while j < n
            {
                let v xp[i * n + j]
                let inner 0.7978845608 * (v + 0.044715 * v * v * v)
                let t tanhf(inner)
                ; d inner/dv, then product rule on 0.5*v*(1+t)
                let dinner 0.7978845608 * (1.0 + 0.134145 * v * v)
                let dg 0.5 * (1.0 + t) + 0.5 * v * (1.0 - t * t) * dinner
                ga.put((i * n + j) as size_t, gxp[i * n + j] + gp[i * n + j] * dg)
                set j: j + 1
            }
        }
    }

    procedure fwd_softmax(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let out node.value
        let op node.value.data
        let r node.rows
        let n node.cols
        for i in r
        {
            var mx xp[i * n]
            var j 1
            while j < n
            {
                let v xp[i * n + j]
                if v > mx
                    set mx: v
                set j: j + 1
            }
            var sum: float 0.0
            var j2 0
            while j2 < n
            {
                let e expf(xp[i * n + j2] - mx)
                out.put((i * n + j2) as size_t, e)
                set sum: sum + e
                set j2: j2 + 1
            }
            let inv 1.0 / sum
            var j3 0
            while j3 < n
            {
                let scaled op[i * n + j3] * inv
                out.put((i * n + j3) as size_t, scaled)
                set j3: j3 + 1
            }
        }
    }

    procedure bwd_softmax(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let yp node.value.data
        let gp node.grad.data
        let gxp na.grad.data
        let ga na.grad
        let r node.rows
        let n node.cols
        ; dx_j = y_j * (dy_j - sum_k dy_k * y_k), per row
        for i in r
        {
            var dot: float 0.0
            var j 0
            while j < n
            {
                set dot: dot + gp[i * n + j] * yp[i * n + j]
                set j: j + 1
            }
            var j2 0
            while j2 < n
            {
                let d yp[i * n + j2] * (gp[i * n + j2] - dot)
                ga.put((i * n + j2) as size_t, gxp[i * n + j2] + d)
                set j2: j2 + 1
            }
        }
    }

    procedure fwd_layernorm(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let ng buf + node.b
        let nbeta buf + node.c
        let xp na.value.data
        let gp ng.value.data
        let bp nbeta.value.data
        let out node.value
        let r node.rows
        let n node.cols
        let e node.eps
        for i in r
        {
            var sum: float 0.0
            var j 0
            while j < n
            {
                set sum: sum + xp[i * n + j]
                set j: j + 1
            }
            let mean sum / (n as float)
            var vsum: float 0.0
            var j2 0
            while j2 < n
            {
                let d xp[i * n + j2] - mean
                set vsum: vsum + d * d
                set j2: j2 + 1
            }
            let denom sqrtf(vsum / (n as float) + e)
            let inv 1.0 / denom
            var j3 0
            while j3 < n
            {
                let z (xp[i * n + j3] - mean) * inv
                let scaled z * gp[j3] + bp[j3]
                out.put((i * n + j3) as size_t, scaled)
                set j3: j3 + 1
            }
        }
    }

    procedure bwd_layernorm(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let ng buf + node.b
        let nbeta buf + node.c
        let xp na.value.data
        let gammap ng.value.data
        let gp node.grad.data
        let gxp na.grad.data
        let ggammap ng.grad.data
        let gbetap nbeta.grad.data
        let r node.rows
        let n node.cols
        let e node.eps
        ; Recompute mean/inv per row (cheaper than saving them; forward
        ; uses biased variance with eps inside the sqrt — match it).
        for i in r
        {
            var sum: float 0.0
            var j 0
            while j < n
            {
                set sum: sum + xp[i * n + j]
                set j: j + 1
            }
            let mean sum / (n as float)
            var vsum: float 0.0
            var j2 0
            while j2 < n
            {
                let d xp[i * n + j2] - mean
                set vsum: vsum + d * d
                set j2: j2 + 1
            }
            let denom sqrtf(vsum / (n as float) + e)
            let inv 1.0 / denom
            ; dyhat_j = dy_j * gamma_j; m1 = mean(dyhat);
            ; m2 = mean(dyhat * xhat); dx_j = inv * (dyhat_j - m1 - xhat_j * m2)
            var m1: float 0.0
            var m2: float 0.0
            var j3 0
            while j3 < n
            {
                let xhat (xp[i * n + j3] - mean) * inv
                let dyhat gp[i * n + j3] * gammap[j3]
                set m1: m1 + dyhat
                set m2: m2 + dyhat * xhat
                set j3: j3 + 1
            }
            set m1: m1 / (n as float)
            set m2: m2 / (n as float)
            var j4 0
            while j4 < n
            {
                let xhat (xp[i * n + j4] - mean) * inv
                let dyhat gp[i * n + j4] * gammap[j4]
                let dx inv * (dyhat - m1 - xhat * m2)
                set gxp[i * n + j4]: gxp[i * n + j4] + dx
                ; dgamma_j += dy_j * xhat_j; dbeta_j += dy_j — shared
                ; across rows, so this loop stays sequential.
                set ggammap[j4]: ggammap[j4] + gp[i * n + j4] * xhat
                set gbetap[j4]: gbetap[j4] + gp[i * n + j4]
                set j4: j4 + 1
            }
        }
    }

    procedure fwd_embedding(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let tp na.value.data
        let ip node.tok.data
        let out node.value
        let tokens node.rows
        let dim node.cols
        for t in tokens
        {
            let tokid ip[t]
            var j 0
            while j < dim
            {
                let v tp[(tokid as int) * dim + j]
                out.put((t * dim + j) as size_t, v)
                set j: j + 1
            }
        }
    }

    procedure bwd_embedding(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let ip node.tok.data
        let gp node.grad.data
        let gtp na.grad.data
        let tokens node.rows
        let dim node.cols
        ; Scatter-add: duplicate token ids collide on the same table
        ; row, so this walk stays sequential.
        var t 0
        while t < tokens
        {
            let tokid ip[t]
            var j 0
            while j < dim
            {
                let row (tokid as int) * dim + j
                set gtp[row]: gtp[row] + gp[t * dim + j]
                set j: j + 1
            }
            set t: t + 1
        }
    }

    procedure fwd_wsum(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let wp node.aux.data
        let out node.value
        let total na.rows * na.cols
        var sum: float 0.0
        var i 0
        while i < total
        {
            set sum: sum + wp[i] * xp[i]
            set i: i + 1
        }
        out.put(0, sum)
    }

    procedure bwd_wsum(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let wp node.aux.data
        let gp node.grad.data
        let gxp na.grad.data
        let total na.rows * na.cols
        let g0 gp[0]
        var i 0
        while i < total
        {
            set gxp[i]: gxp[i] + wp[i] * g0
            set i: i + 1
        }
    }

    procedure fwd_crossent(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let tp node.tok.data
        let out node.value
        let r na.rows
        let n na.cols
        ; Scalar reduction across rows — sequential by construction.
        var loss: float 0.0
        var i 0
        while i < r
        {
            var mx xp[i * n]
            var j 1
            while j < n
            {
                let v xp[i * n + j]
                if v > mx
                    set mx: v
                set j: j + 1
            }
            var sum: float 0.0
            var j2 0
            while j2 < n
            {
                set sum: sum + expf(xp[i * n + j2] - mx)
                set j2: j2 + 1
            }
            let lse mx + logf(sum)
            let t tp[i] as int
            set loss: loss + lse - xp[i * n + t]
            set i: i + 1
        }
        out.put(0, loss / (r as float))
    }

    procedure bwd_crossent(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let xp na.value.data
        let tp node.tok.data
        let gp node.grad.data
        let gxp na.grad.data
        let ga na.grad
        let r na.rows
        let n na.cols
        let scale gp[0] / (r as float)
        ; dx[i,j] += scale * (softmax(x_i)_j - onehot(target_i)_j);
        ; recompute the row softmax like bwd_layernorm recomputes stats.
        for i in r
        {
            var mx xp[i * n]
            var j 1
            while j < n
            {
                let v xp[i * n + j]
                if v > mx
                    set mx: v
                set j: j + 1
            }
            var sum: float 0.0
            var j2 0
            while j2 < n
            {
                set sum: sum + expf(xp[i * n + j2] - mx)
                set j2: j2 + 1
            }
            let inv 1.0 / sum
            let t tp[i] as int
            var j3 0
            while j3 < n
            {
                var p expf(xp[i * n + j3] - mx) * inv
                if j3 = t
                    set p: p - 1.0
                ga.put((i * n + j3) as size_t, gxp[i * n + j3] + scale * p)
                set j3: j3 + 1
            }
        }
    }

    procedure fwd_add(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let xp na.value.data
        let yp nb.value.data
        let out node.value
        let r node.rows
        let n node.cols
        for i in r
        {
            var j 0
            while j < n
            {
                out.put((i * n + j) as size_t, xp[i * n + j] + yp[i * n + j])
                set j: j + 1
            }
        }
    }

    procedure bwd_add(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let gp node.grad.data
        let gxp na.grad.data
        let gyp nb.grad.data
        let total node.rows * node.cols
        var i 0
        while i < total
        {
            set gxp[i]: gxp[i] + gp[i]
            set gyp[i]: gyp[i] + gp[i]
            set i: i + 1
        }
    }

    procedure fwd_add_bcast(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let xp na.value.data
        let yp nb.value.data
        let out node.value
        let r node.rows
        let n node.cols
        let yr nb.rows
        for i in r
        {
            let yb (i - (i / yr) * yr) * n
            var j 0
            while j < n
            {
                out.put((i * n + j) as size_t, xp[i * n + j] + yp[yb + j])
                set j: j + 1
            }
        }
    }

    procedure bwd_add_bcast(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let na buf + node.a
        let nb buf + node.b
        let gp node.grad.data
        let gxp na.grad.data
        let gyp nb.grad.data
        let r node.rows
        let n node.cols
        let yr nb.rows
        var i 0
        while i < r
        {
            let yb (i - (i / yr) * yr) * n
            var j 0
            while j < n
            {
                set gxp[i * n + j]: gxp[i * n + j] + gp[i * n + j]
                set gyp[yb + j]: gyp[yb + j] + gp[i * n + j]
                set j: j + 1
            }
            set i: i + 1
        }
    }

    procedure fwd_attention(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let nq buf + node.a
        let nk buf + node.b
        let nv buf + node.c
        let qp nq.value.data
        let kp nk.value.data
        let vp nv.value.data
        let px node.aux
        let pp node.aux.data
        let out node.value
        let t node.rows
        let d node.cols
        let hs node.heads
        let w node.win
        let dh d / hs
        let scale 1.0 / sqrtf(dh as float)
        ; Rows are independent: iteration i touches only p row i and
        ; out row i of every head. A query attends only within its own
        ; window [ws, i]; the probability column is the LOCAL key offset
        ; jw = j - ws in [0, w), so the aux stride is w (= t single-win).
        for i in t
        {
            let ws (i / w) * w
            var h 0
            while h < hs
            {
                ; scaled scores for the causal window ws <= j <= i
                var mx: float 0.0
                var j ws
                while j <= i
                {
                    var acc: float 0.0
                    var c 0
                    while c < dh
                    {
                        set acc: acc + qp[i * d + h * dh + c] * kp[j * d + h * dh + c]
                        set c: c + 1
                    }
                    let sc acc * scale
                    px.put((h * t * w + i * w + (j - ws)) as size_t, sc)
                    if j = ws
                        set mx: sc
                    if sc > mx
                        set mx: sc
                    set j: j + 1
                }
                ; softmax over the window, in place
                var sum: float 0.0
                var j2 ws
                while j2 <= i
                {
                    let e expf(pp[h * t * w + i * w + (j2 - ws)] - mx)
                    px.put((h * t * w + i * w + (j2 - ws)) as size_t, e)
                    set sum: sum + e
                    set j2: j2 + 1
                }
                let inv 1.0 / sum
                var j3 ws
                while j3 <= i
                {
                    let scaled pp[h * t * w + i * w + (j3 - ws)] * inv
                    px.put((h * t * w + i * w + (j3 - ws)) as size_t, scaled)
                    set j3: j3 + 1
                }
                ; out_i = sum_j p_ij * v_j over the head slice
                var c2 0
                while c2 < dh
                {
                    var acc2: float 0.0
                    var j4 ws
                    while j4 <= i
                    {
                        set acc2: acc2 + pp[h * t * w + i * w + (j4 - ws)] * vp[j4 * d + h * dh + c2]
                        set j4: j4 + 1
                    }
                    out.put((i * d + h * dh + c2) as size_t, acc2)
                    set c2: c2 + 1
                }
                set h: h + 1
            }
        }
    }

    procedure bwd_attention(this: Tape, id: int)
    {
        let buf nodes.get_buffer()
        let node buf + id
        let nq buf + node.a
        let nk buf + node.b
        let nv buf + node.c
        let qp nq.value.data
        let kp nk.value.data
        let vp nv.value.data
        let pp node.aux.data
        let gp node.grad.data
        let gqp nq.grad.data
        let gkp nk.grad.data
        let gvp nv.grad.data
        let t node.rows
        let d node.cols
        let hs node.heads
        let w node.win
        let dh d / hs
        let scale 1.0 / sqrtf(dh as float)
        let dsoff hs * t * w
        ; pass 1: per row i, dp_ij = dOut_i . v_j, then the row softmax
        ; backward ds_ij = p_ij * (dp_ij - sum_k dp_ik p_ik), saved in
        ; the aux scratch half (rows disjoint). Window [ws, i], local
        ; key column jw = j - ws (aux stride w).
        for i in t
        {
            let ws (i / w) * w
            var h 0
            while h < hs
            {
                var ci: float 0.0
                var j ws
                while j <= i
                {
                    var dp: float 0.0
                    var c 0
                    while c < dh
                    {
                        set dp: dp + gp[i * d + h * dh + c] * vp[j * d + h * dh + c]
                        set c: c + 1
                    }
                    set pp[dsoff + h * t * w + i * w + (j - ws)]: dp
                    set ci: ci + dp * pp[h * t * w + i * w + (j - ws)]
                    set j: j + 1
                }
                var j2 ws
                while j2 <= i
                {
                    let ds pp[h * t * w + i * w + (j2 - ws)] * (pp[dsoff + h * t * w + i * w + (j2 - ws)] - ci)
                    set pp[dsoff + h * t * w + i * w + (j2 - ws)]: ds
                    set j2: j2 + 1
                }
                set h: h + 1
            }
        }
        ; pass 2: dQ_i += scale * sum_{j<=i} ds_ij k_j (rows disjoint)
        for i2 in t
        {
            let ws2 (i2 / w) * w
            var h 0
            while h < hs
            {
                var c 0
                while c < dh
                {
                    var acc: float 0.0
                    var j ws2
                    while j <= i2
                    {
                        set acc: acc + pp[dsoff + h * t * w + i2 * w + (j - ws2)] * kp[j * d + h * dh + c]
                        set j: j + 1
                    }
                    set gqp[i2 * d + h * dh + c]: gqp[i2 * d + h * dh + c] + scale * acc
                    set c: c + 1
                }
                set h: h + 1
            }
        }
        ; pass 3: dK_j += scale * sum_{i>=j} ds_ij q_i and
        ;         dV_j += sum_{i>=j} p_ij dOut_i (key rows disjoint).
        ; Only queries in j5's own window [wsj, wej) attend to it.
        for j5 in t
        {
            let wsj (j5 / w) * w
            let wej wsj + w
            let jw j5 - wsj
            var h 0
            while h < hs
            {
                var c 0
                while c < dh
                {
                    var acck: float 0.0
                    var accv: float 0.0
                    var i j5
                    while i < wej
                    {
                        set acck: acck + pp[dsoff + h * t * w + i * w + jw] * qp[i * d + h * dh + c]
                        set accv: accv + pp[h * t * w + i * w + jw] * gp[i * d + h * dh + c]
                        set i: i + 1
                    }
                    set gkp[j5 * d + h * dh + c]: gkp[j5 * d + h * dh + c] + scale * acck
                    set gvp[j5 * d + h * dh + c]: gvp[j5 * d + h * dh + c] + accv
                    set c: c + 1
                }
                set h: h + 1
            }
        }
    }
}
