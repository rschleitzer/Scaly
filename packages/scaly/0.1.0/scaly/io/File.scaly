use scaly.containers.String
use scaly.memory.runtime
use scaly.memory.Page
use scaly.fiber.Io

; C stdio constants
define SEEK_SET: int 0
define SEEK_CUR: int 1
define SEEK_END: int 2

; C unistd constants
define F_OK: int 0

; The blocking open+measure shipped to a worker thread (milestone 2.5,
; zero-copy read). arg is the {path, size, buffer} request cell in the
; requester's care (alive while it parks): opens the file, measures it,
; writes FILE* and size back INTO the cell. Null when the file cannot
; be opened; a non-null sentinel otherwise — no result page.
procedure file_open_worker(arg: pointer[void]) returns pointer[void]
{
    let cell arg as pointer[size_t]
    var file fopen((*cell) as pointer[const_char], "rb")
    if file = null
        return null
    fseek(file, 0, SEEK_END)
    let size ftell file
    rewind file
    set *cell: file as size_t
    set *(((cell as size_t) + 8) as pointer[size_t]): size as size_t
    (1 as size_t) as pointer[void]
}

; The blocking read+close (the second leg): freads the whole file
; straight into the requester's String buffer named in the cell — the
; requester is parked, its region quiescent, so the cross-thread write
; is race-free and no copy is paid. A short read is ignored exactly
; like the blocking path's single unchecked fread. Always closes.
procedure file_read_close_worker(arg: pointer[void]) returns pointer[void]
{
    let cell arg as pointer[size_t]
    let file (*cell) as pointer[void]
    let size *(((cell as size_t) + (8 as size_t)) as pointer[size_t])
    let buf (*(((cell as size_t) + (16 as size_t)) as pointer[size_t])) as pointer[void]
    if size > 0
        fread(buf, 1, size, file)
    fclose file
    (1 as size_t) as pointer[void]
}

; The blocking existence probe (milestone 2.5 residual): access(2) on a
; worker; sentinel result, no pages.
procedure file_access_worker(arg: pointer[void]) returns pointer[void]
{
    if access(arg as pointer[const_char], F_OK) = 0
        return (1 as size_t) as pointer[void]
    null
}

; The blocking write shipped to a worker thread (milestone 2.5). arg is
; a {path, buffer, length} request cell in the requester's care; the
; result is null on failure, a non-null sentinel on success (nothing to
; free — no result page).
procedure file_write_worker(arg: pointer[void]) returns pointer[void]
{
    let cell arg as pointer[size_t]
    let path (*cell) as pointer[const_char]
    let data (*(((cell as size_t) + (8 as size_t)) as pointer[size_t])) as pointer[void]
    let len *(((cell as size_t) + (16 as size_t)) as pointer[size_t])
    var file fopen(path, "wb")
    if file = null
        return null
    fwrite(data, 1, len, file)
    fclose file
    (1 as size_t) as pointer[void]
}

define File
{
    ; Colorless like the rest (milestone 2.5 residual): the access(2)
    ; probe blocks on disk metadata just like a read does.
    function exists(path: String) returns bool
    {
        if Io.in_task()
        {
            let pc path.to_c_string()
            let r Io.offload(&file_access_worker, pc as pointer[void])
            return r <> null
        }
        let path_c_string path.to_c_string()
        access(path_c_string, F_OK) = 0
    }

    ; Colorless (milestone 2.5): inside a task the blocking read runs
    ; on a worker thread while the task parks; on the main context (or
    ; without a scheduler) it blocks right here — same call, same
    ; result.
    function read_to_string(path: String) returns String
    {
        if Io.in_task()
            return File.read_to_string_offloaded(path)
        var file fopen(path.to_c_string(), "rb")
        if file = null
            return String()

        fseek(file, 0, SEEK_END)
        let size ftell file
        rewind file
        var ret String(size as size_t)
        let buffer ret.get_buffer()
        fread(buffer, 1, size as size_t, file)
        fclose file
        ret
    }

    ; The task path of read_to_string: two offloads — open+measure,
    ; then fread straight into the String's own buffer (allocated here
    ; between the two, on the caller's page by the normal inference) +
    ; close. Zero copies and no result pages; the request cell is the
    ; in/out block.
    function read_to_string_offloaded(path: String) returns String
    {
        let pc path.to_c_string()
        let p Page.allocate_page_traced("File.read_cell")
        let cell p.allocate(24, 8) as pointer[size_t]
        set *cell: pc as size_t
        let opened Io.offload(&file_open_worker, cell as pointer[void])
        if opened = null
        {
            p.deallocate_extensions()
            Page.release_page_traced(p, "File.read_cell")
            return String()
        }
        let size *(((cell as size_t) + (8 as size_t)) as pointer[size_t])
        var ret String(size)
        let buffer ret.get_buffer()
        set *(((cell as size_t) + 16) as pointer[size_t]): buffer as size_t
        Io.offload(&file_read_close_worker, cell as pointer[void])
        p.deallocate_extensions()
        Page.release_page_traced(p, "File.read_cell")
        ret
    }

    ; Colorless like read_to_string: offloads inside a task, blocks
    ; otherwise.
    function write_from_string(path: String, contents: String) returns bool
    {
        if Io.in_task()
            return File.write_from_string_offloaded(path, contents)
        var file fopen(path.to_c_string(), "wb")
        if file = null
            return false

        fwrite(contents.get_buffer(), 1, contents.get_length(), file)
        fclose file
        true
    }

    ; The task path of write_from_string: pack a {path, buffer, length}
    ; request cell on its own heap page (path and buffer point into the
    ; requester's region — alive while parked), offload, free the cell.
    function write_from_string_offloaded(path: String, contents: String) returns bool
    {
        let pc path.to_c_string()
        let buf contents.get_buffer()
        let len contents.get_length()
        let p Page.allocate_page_traced("File.write_cell")
        let cell p.allocate(24, 8) as pointer[size_t]
        set *cell: pc as size_t
        set *(((cell as size_t) + 8) as pointer[size_t]): buf as size_t
        set *(((cell as size_t) + 16) as pointer[size_t]): len
        let res Io.offload(&file_write_worker, cell as pointer[void])
        p.deallocate_extensions()
        Page.release_page_traced(p, "File.write_cell")
        res <> null
    }
}
