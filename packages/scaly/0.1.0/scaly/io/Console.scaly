use scaly.memory.runtime
use scaly.fiber.Io

; stdout is fd 1. Writes go through the Io layer (milestone 2.5), so
; the same call blocks normally, suspends inside a task once the fd is
; nonblocking, and needs no scheduler at all — colorless I/O.
define Console
{
    procedure print(message: pointer[const_char])
    {
        var len strlen message
        Io.write_all(1, message as pointer[void], len)
    }

    procedure println(message: pointer[const_char])
    {
        Console.print message
        ; Numeric LF byte: the lexer stores the "\n" string literal raw as
        ; [0x5c,0x6e] (no escape decode — s185 escape class), so under
        ; stage-emitted code write(…,"\n",1) emitted a backslash, not a
        ; newline. Writing a 10 (LF) byte directly works in every stage,
        ; mirroring cli.print_diagnostics#'s numeric `10 as char` compare.
        var nl: u8 10
        let nl_ptr &nl
        Io.write_all(1, nl_ptr as pointer[void], 1)
    }
}
