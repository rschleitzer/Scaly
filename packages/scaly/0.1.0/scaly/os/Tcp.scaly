use scaly.containers.String
use scaly.memory.runtime
use scaly.memory.Page
use scaly.fiber.Io
use scaly.fiber.Scheduler
use scaly.fiber.Thread
use scaly.fiber.TaskPool
use scaly.fiber.Channel

; TCP sockets, colorless like File and Console (milestone 2.5): the same
; call blocks without a scheduler, drives the dispatcher from the main
; context, and parks the running fiber inside a task — suspension is a
; runtime property, not a type color and not a flag the caller manages.
; Every socket this layer hands out is NONBLOCKING from the start (Io.read,
; Io.accept and Io.tcp_write retry on would-block and park or poll), so the
; raw layer's one manual step, Io.set_nonblocking, never reaches a caller.
;
; connect is the one operation that blocks in the kernel whatever the fd's
; mode: name resolution (getaddrinfo) and the handshake. Inside a task it
; therefore goes to the Io worker pool, exactly as File's reads do, and the
; task parks; elsewhere it runs in place.
;
; Nagle stays on (the operating system's default): small writes may wait
; to be coalesced. set_nodelay(true) turns it off for a stream whose writes
; must leave at once (request/response protocols with small messages, as Go
; does by default).
;
; Both families: connect resolves a name to IPv6 and IPv4 addresses and
; takes the first that answers ("localhost" is ::1 and 127.0.0.1);
; listen_on binds a numeric address of either family, and "::" — as
; listen_any — is dual-stack, taking IPv4 connections as mapped addresses.
;
; Limits, named: at most one task
; parked per socket at a time (the poller keeps one entry per fd), so a
; stream is read and written by ONE task, not a reader and a writer in
; parallel; the value records are handles — a copy names the same socket,
; and close on one copy closes it for all.
;
;   let l TcpListener.listen(0)                ; 127.0.0.1, ephemeral port
;   let s TcpStream.connect("localhost", l.port())
;   let c l.accept()
;   c.write("hello")                           ; a literal is a Slice[u8]
;   var buf u8[64]
;   let n c.read(Slice[u8](64, &buf[0]))       ; bytes; 0 = EOF, -1 = error
;
; A server over all cores (self-scaling I/O): serve runs one scheduler per
; core (TaskPool.ncpu(), which SCALY_WORKERS caps), the calling thread one
; of them. ONE of them accepts and hands the connections round-robin to all
; of them, itself included, each through a Channel its dispatcher task
; receives on; every connection becomes a task of the scheduler it was
; handed to. (Every scheduler accepting on the shared listener was the first
; version: its herd of empty accepts and the contention on the listen queue
; doubled the server CPU per connection from one scheduler to five —
; measured 2026-09-27, tools/bench/README.md.) The handler
; is a zero-argument task procedure; it takes its connection with
; TcpStream.of_task() and closes it (serve cannot: once closed, the number
; may already name the next connection). serve runs until a handler shuts
; the server down (TcpServer.current().shutdown(), below) — else, as Go's
; ListenAndServe, until the process ends.
;
; A server that must stop is started instead: start returns a TcpServer at
; once (its threads serve; the calling thread does not), shutdown stops the
; accepting, wait returns when every connection has ended. Closing the
; listener could not do it — kqueue and epoll drop a closed descriptor
; silently and the accept loop parked on it would never wake — so shutdown
; sets a stop flag and makes one local connection to wake the acceptor,
; which checks the flag after every accept, drops that connection, closes
; the channels and ends; every dispatcher then wakes with the close and
; ends, and every scheduler runs out when its last connection is done.
; shutdown waits for nothing (a handler may call it); the connections in
; flight run to their end, and a handler that keeps a connection alive asks
; TcpServer.current().stopping() between two requests.
;
;   let server l.start(&handle)
;   ...
;   server.shutdown()
;   server.wait()               ; every connection ended; the handle is spent
;   l.close()
;
;   procedure handle()
;   {
;       var c TcpStream.of_task()
;       ...
;       c.close()
;   }
;   TcpListener.listen_any(8080).serve(&handle)

; The blocking connect shipped to an Io worker (the task path of
; TcpStream.connect). arg is a {host, port, fd} cell of three i64 in the
; requester's care (alive while it parks); the worker writes the fd back.
procedure tcp_connect_worker(mutable arg: pointer[void]) returns pointer[void]
{
    let cell arg as pointer[i64]
    let host (*cell) as pointer[const_char]
    let port *(((cell as size_t) + 8) as pointer[i64])
    let fd Io.connect_host(host, port as i32)
    set *(((cell as size_t) + 16) as pointer[i64]): fd as i64
    1 as pointer[void]
}

; close(2) on a socket — a free procedure so that the methods named close
; below never meet the extern by name (on Windows, posixcompat's close tells
; a SOCKET from a CRT descriptor).
procedure tcp_close_fd(fd: i32)
{
    close(fd as int)
}

; The serve cell of the thread running this code (TcpServer.current):
; thread-local like every mutable global, set by tcp_serve_thread.
mutable tcp_current_serve: pointer[i64] null

; The serve cell, i64 words on a page of its own: [0] listener fd,
; [1] handler, [2] stop flag, [3] n, the number of serving schedulers,
; [4] the next scheduler index to hand out, [5 .. 5+n) each scheduler's
; Channel, [5+n .. 5+2n) the threads' handles (TcpListener.start only).
function tcp_word(cell: pointer[i64], k: i64) returns pointer[i64]
    ((cell as size_t) + (k * 8) as size_t) as pointer[i64]

procedure tcp_make_cell(fd: i32, mutable handler: pointer[void], n: i64) returns pointer[i64]
{
    let p Page.allocate_page()
    let cell p.allocate(((5 + 2 * n) * 8) as size_t, 8) as pointer[i64]
    set *cell: fd as i64
    set *tcp_word(cell, 1): handler as i64
    set *tcp_word(cell, 2): 0
    set *tcp_word(cell, 3): n
    set *tcp_word(cell, 4): 0
    var k: i64 0
    while k < n
    {
        let ch Channel.create()
        set *tcp_word(cell, 5 + k): (ch as pointer[void]) as i64
        set k: k + 1
    }
    cell
}

; Accept on lfd, each connection a task of the
; running scheduler that runs handler with the connection's fd as its task
; argument, until *stop is set (checked after every accept: the connection
; that woke the loop is dropped). An accept error on a listener that still
; has its port is transient (a connection reset before it was taken, a
; descriptor limit hit for a moment): the loop yields and goes on. The
; accepting of serve inside a task, where there is one scheduler.
procedure tcp_accept_into_tasks(lfd: i32, mutable handler: pointer[void], mutable stop: pointer[u64])
{
    repeat
    {
        let c Io.accept(lfd)
        if scaly_atomic_load_u64(stop) <> 0
        {
            if c >= 0
                tcp_close_fd(c)
            return
        }
        if c >= 0
        {
            Io.set_nonblocking(c)
            Scheduler.spawn_arg(handler, (c as size_t) as pointer[void])
        }
        else
        {
            if Io.local_port(lfd) < 0
                return
            Scheduler.yield()
        }
    }
}

; The acceptor, a task of scheduler 0: accept, and hand each connection to
; the next scheduler round-robin — its fd in a message on a page of its own,
; which is what a Channel carries. On the stop flag (or a listener gone) it
; closes every channel; the dispatchers wake with null once their queues
; have drained.
procedure tcp_acceptor()
{
    let cell Scheduler.task_arg() as pointer[i64]
    let lfd (*cell) as i32
    let stop tcp_word(cell, 2) as pointer[u64]
    let n *tcp_word(cell, 3)
    var next: i64 0
    repeat
    {
        let c Io.accept(lfd)
        if scaly_atomic_load_u64(stop) <> 0
        {
            if c >= 0
                tcp_close_fd(c)
            break
        }
        if c >= 0
        {
            Io.set_nonblocking(c)
            let mp Page.allocate_page()
            let msg mp.allocate(8, 8) as pointer[i64]
            set *msg: c as i64
            Channel.send((*tcp_word(cell, 5 + next)) as pointer[Channel], msg as pointer[void])
            set next: next + 1
            if next = n
                set next: 0
        }
        else
        {
            if Io.local_port(lfd) < 0
                break
            Scheduler.yield()
        }
    }
    var k: i64 0
    while k < n
    {
        Channel.close_sender((*tcp_word(cell, 5 + k)) as pointer[Channel])
        set k: k + 1
    }
}

; Every scheduler's dispatcher: receive a connection, free its message page,
; start the handler on it as a task of this scheduler; end at the close.
procedure tcp_dispatch()
{
    let chp Scheduler.task_arg() as pointer[Channel]
    let handler (*tcp_word(tcp_current_serve, 1)) as pointer[void]
    repeat
    {
        let msg Channel.receive(chp as ref[Channel])
        if msg = null
            break
        let fd (*(msg as pointer[i64])) as i32
        Page.release_page(Page.get(msg))
        Scheduler.spawn_arg(handler, (fd as size_t) as pointer[void])
    }
    Channel.dispose(chp as ref[Channel])
}

; One serving thread: a scheduler of its own with its dispatcher, and the
; acceptor too on the thread that draws index 0. Returns when the accepting
; has stopped and the last connection of this scheduler has ended.
procedure tcp_serve_thread(mutable arg: pointer[void]) returns pointer[void] mutable tcp_current_serve
{
    let cell arg as pointer[i64]
    set tcp_current_serve: cell
    let idx scaly_atomic_add_u64(tcp_word(cell, 4) as pointer[u64], 1 as u64) as i64
    let page Page.allocate_page()
    let sched Scheduler.create(page)
    Scheduler.spawn_arg(&tcp_dispatch, (*tcp_word(cell, 5 + idx)) as pointer[void])
    if idx = 0
        Scheduler.spawn_arg(&tcp_acceptor, arg)
    Scheduler.run()
    Page.release_page(page)
    null
}

; A connected TCP stream. fd < 0 is a stream that is not (or no longer)
; open: every operation on it fails instead of touching a descriptor.
define TcpStream(var fd: i32)
{
    ; Connect to host:port (a name or a dotted address). Returns a stream
    ; that is_open() or not; inside a task the blocking resolution and
    ; handshake run on an Io worker while the task parks.
    procedure connect(mutable host: String, port: int) returns TcpStream
    {
        let hc host.to_c_string()
        var fd: i32 0 - 1
        if Io.in_task()
        {
            let p Page.allocate_page_traced("TcpStream.connect_cell")
            let cell p.allocate(24, 8) as pointer[i64]
            set *cell: hc as i64
            set *(((cell as size_t) + 8) as pointer[i64]): port as i64
            set *(((cell as size_t) + 16) as pointer[i64]): 0 - 1
            Io.offload(&tcp_connect_worker, cell as pointer[void])
            set fd: (*(((cell as size_t) + 16) as pointer[i64])) as i32
            p.deallocate_extensions()
            Page.release_page_traced(p, "TcpStream.connect_cell")
        }
        else
            set fd: Io.connect_host(hc, port as i32)
        if fd >= 0
            Io.set_nonblocking(fd)
        TcpStream(fd)
    }

    ; The connection a task started by TcpListener.serve serves (its task
    ; argument); not is_open() outside such a task.
    procedure of_task() returns TcpStream
    {
        let a Scheduler.task_arg()
        if a = null
            return TcpStream(0 - 1)
        TcpStream((a as size_t) as i32)
    }

    function is_open(this) returns bool
        fd >= 0

    ; Read up to buf.length bytes into buf: the count, 0 at end of stream,
    ; -1 on an error (or a closed stream). Waits for data colorlessly.
    procedure read(this, mutable buf: Slice[u8]) returns int
    {
        if fd < 0 or buf.length = 0
            return 0 - 1
        Io.read(fd, buf.data as pointer[void], buf.length) as int
    }

    ; Write ALL of data, looping over partial writes; false on an error
    ; (a peer that went away is an error return, never a SIGPIPE).
    procedure write(this, data: Slice[u8]) returns bool
    {
        if fd < 0
            return false
        Io.tcp_write_all(fd, data.data as pointer[void], data.length)
    }

    ; TCP_NODELAY: true sends every write at once, false (the default) lets
    ; Nagle coalesce small writes. False on an error or a closed stream.
    procedure set_nodelay(this, on: bool) returns bool
    {
        if fd < 0
            return false
        Io.set_nodelay(fd, on)
    }

    procedure write_string(this, s: String) returns bool
    {
        if fd < 0
            return false
        Io.tcp_write_all(fd, s.get_buffer(), s.get_length())
    }

    procedure close(mutable this)
    {
        if fd >= 0
        {
            tcp_close_fd(fd)
            set fd: 0 - 1
        }
    }
}

; A listening TCP socket.
define TcpListener(var fd: i32)
{
    ; Listen on 127.0.0.1:port (0 = an ephemeral port, read it with port()).
    procedure listen(port: int) returns TcpListener
        TcpListener(Io.listen(port as i32))

    ; Listen on all interfaces, IPv6 and IPv4 (the dual-stack "::"; IPv4
    ; alone on a host without IPv6).
    procedure listen_any(port: int) returns TcpListener
        TcpListener(Io.listen_any(port as i32))

    ; Listen on a numeric address of either family: "::1" (IPv6 loopback),
    ; "::" (every interface, dual-stack), "127.0.0.1", "0.0.0.0".
    procedure listen_on(mutable host: String, port: int) returns TcpListener
        TcpListener(Io.listen_host(host.to_c_string(), port as i32))

    function is_open(this) returns bool
        fd >= 0

    ; The port the listener is bound to, -1 when it is not open.
    procedure port(this) returns int
    {
        if fd < 0
            return 0 - 1
        Io.local_port(fd) as int
    }

    ; Serve every connection with handler, over all cores: one scheduler
    ; per core, this thread one of them, all accepting here (see the module
    ; header). Runs until a handler calls TcpServer.current().shutdown()
    ; and the last connection has ended — else for as long as the process.
    ; Inside a task there is a scheduler already: the connections become
    ; tasks of that one.
    procedure serve(this, mutable handler: pointer[void])
    {
        if fd < 0
            return
        if Io.in_task()
        {
            let cell0 tcp_make_cell(fd, handler, 0)
            tcp_accept_into_tasks(fd, handler, tcp_word(cell0, 2) as pointer[u64])
            Page.release_page(Page.get(cell0))
            return
        }
        let n TaskPool.ncpu()
        let cell tcp_make_cell(fd, handler, n)
        var threads Array[size_t]()
        var i: i64 1
        while i < n
        {
            threads.add(Thread.spawn(&tcp_serve_thread, cell as pointer[void]))
            set i: i + 1
        }
        tcp_serve_thread(cell as pointer[void])
        for t in threads
            Thread.join(t)
        Page.release_page(Page.get(cell))
    }

    ; Serve like serve, but return at once with a TcpServer that can stop:
    ; one thread per core serves (the calling thread does not), shutdown
    ; stops the accepting, wait returns when every connection has ended (see
    ; the module header). Not running when the listener is not open.
    procedure start(this, mutable handler: pointer[void]) returns TcpServer
    {
        if fd < 0
            return TcpServer(null as pointer[i64])
        let n TaskPool.ncpu()
        let cell tcp_make_cell(fd, handler, n)
        var i: i64 0
        while i < n
        {
            let h Thread.spawn(&tcp_serve_thread, cell as pointer[void])
            set *tcp_word(cell, 5 + n + i): h as i64
            set i: i + 1
        }
        TcpServer(cell)
    }

    ; Wait for a connection colorlessly and return it as a nonblocking
    ; stream (not is_open() on an error).
    procedure accept(this) returns TcpStream
    {
        if fd < 0
            return TcpStream(0 - 1)
        let c Io.accept(fd)
        if c >= 0
            Io.set_nonblocking(c)
        TcpStream(c)
    }

    procedure close(mutable this)
    {
        if fd >= 0
        {
            tcp_close_fd(fd)
            set fd: 0 - 1
        }
    }
}

; A running server (TcpListener.start): a handle on the serve cell. A copy
; names the same server; after wait the handle is spent.
define TcpServer(cell: pointer[i64])
{
    ; The server whose thread runs the calling task (not running elsewhere):
    ; how a handler reaches its server without a global of its own.
    procedure current() returns TcpServer
        TcpServer(tcp_current_serve)

    function is_running(this) returns bool
        cell <> null

    ; Has shutdown been called? A handler that keeps a connection alive asks
    ; between two requests and ends the connection when it answers true.
    procedure stopping(this) returns bool
    {
        if cell = null
            return false
        scaly_atomic_load_u64(tcp_word(cell, 2) as pointer[u64]) <> 0
    }

    ; Stop accepting: set the stop flag, then one local connection to wake
    ; the acceptor (the module header has why). Waits for nothing; from any
    ; thread or task, more than once is harmless. The connections in flight
    ; go on.
    procedure shutdown(this)
    {
        if cell = null
            return
        let stop tcp_word(cell, 2) as pointer[u64]
        if scaly_atomic_load_u64(stop) <> 0
            return
        scaly_atomic_store_u64(stop, 1 as u64)
        let s Io.connect(Io.local_port((*cell) as i32))
        if s >= 0
            tcp_close_fd(s)
    }

    ; Return when every serving thread has ended: shutdown was called and the
    ; last connection is done. Call it outside the server's own threads (a
    ; handler waiting for its own thread never returns). The handle is spent
    ; afterwards; the listener stays open until its owner closes it.
    procedure wait(this)
    {
        if cell = null
            return
        let n *tcp_word(cell, 3)
        var i: i64 0
        while i < n
        {
            Thread.join((*tcp_word(cell, 5 + n + i)) as size_t)
            set i: i + 1
        }
        Page.release_page(Page.get(cell))
    }
}
