; Deliberately NOT List[pointer[Page]]: this is the allocator's own intrusive
; list, embedded by value in the Page header — a layer BELOW containers
; (List's Node[T]^this itself calls Page.allocate). Replacing it would invert
; the memory/containers layering, pull generic instantiation into the
; allocator core, and shift the Page layout (seed refresh). Keep it concrete
; and auditable.
define PageList
(
    head: pointer[PageNode] (null)
)
{
    procedure add(this: PageList, element: ref[Page])
    {
        let own_page Page.get(this as pointer[void])
        let new_node PageNode^own_page(element, head)
        set head: new_node
    }

    procedure remove(this: PageList, element: ref[Page]) returns bool
    {
        var node head
        var previous_node: pointer[PageNode] null
        while node <> null
        {
            if node.page = element
            {
                if previous_node <> null
                    set previous_node.next: node.next

                if node = head
                    set head: node.next

                return true
            }
            set previous_node: node
            set node: node.next
        }

        return false
    }

    function get_iterator(this: PageList) returns PageListIterator
        PageListIterator head
}
