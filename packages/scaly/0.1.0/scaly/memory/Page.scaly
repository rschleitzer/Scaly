define PAGE_SIZE size_t 0x1000

; Head of the HeapBucket free list (buckets with at least one free page).
; Full buckets are unlinked by allocate_page below and re-added on free
; (release_page below). Lives HERE, not in root_pages: lookup_global is
; populated in member-planning order and module Page is planned before
; module root_pages, so allocate_page could not otherwise resolve it.
mutable heap_head: pointer[HeapBucketHeader] null

; StackBucket state for allocate_root_page below — same planning-order
; reasoning as heap_head. The release side (scaly_release_root_page,
; root_pages.scaly) is planned later and resolves stack_top fine.
; stack_head: head of the StackBucket chain (doubly-linked, for unwinding).
; stack_top: current top-of-stack root page.
mutable stack_head: pointer[StackBucketHeader] null
mutable stack_top:  pointer[Page] null
; Dead heap buckets this thread drained and freed (milestone 2.3b) —
; teardown-proof counter, read via Page.reclaimed_dead_buckets().
mutable dead_buckets_reclaimed: i64 0

; The oversized blocks this thread released last, kept for reuse instead of
; going back to free (2026-09-29). glibc serves a block of this size with
; mmap and unmaps it on free, so every region that needed one faulted all
; its pages in again -- a third of a json parse on the x86 runner, 42 810
; minor faults for 100 parses of a 1.7 MB document; macOS keeps such blocks
; itself, which is why no Mac measurement saw it. Chained through
; next_page, the size in current_page (as allocate_oversized records it);
; at most OVERSIZED_KEPT blocks and OVERSIZED_KEPT_BYTES together, freed at
; thread exit (scaly_thread_release_buckets). Not under SCALY_POISON: there
; a released block goes back at once, as it always did.
define OVERSIZED_KEPT: size_t 4
define OVERSIZED_KEPT_BYTES: size_t 0x1000000
mutable oversized_kept: pointer[Page] null
mutable oversized_kept_count: size_t 0
mutable oversized_kept_bytes: size_t 0
; tsc's `--diagnostics` memory rows (its `Memory used` and `Memory allocs`, read
; from Go's runtime.MemStats there): the bytes the regions hold in pages, every
; allocation made from a page, and the bytes of LIVE objects — Go's `Alloc`: every
; bump's advance (alignment included) is added, and a page's used part is taken out
; when the page goes back, on both routes (a heap page through release_page, a frame
; page LIFO through scaly_release_root_page). A dead frame's objects therefore leave
; the count and main's own frame stays in it, as Go's live heap does after its GC.
; ★A page rewound IN PLACE is not seen (dazzle's frame mark does that); nothing on
; tsc's path does.
; ★★★OFF UNTIL ASKED FOR (2026-09-19). Counted unconditionally, the two bumps on
; the allocation FAST PATH cost 4 % of the user time on the whole of VS Code with
; one checker and with four (11.5 -> 11.0 s, 18.4 -> 17.6 s, output identical), and
; as plain process globals they lost increments on several threads. So the counts
; live in ONE record that Page.enable_statistics() allocates, and are added
; ATOMICALLY there: exact on every thread when on, one load and a branch when off.
; They count from the moment they are enabled — a page allocated before and
; released after takes its whole used part out — which is why a driver enables
; them before its compile starts (tscaly: `--diagnostics`, `--extendedDiagnostics`).
; Read via Page.bytes_held(), Page.allocation_count() and Page.live_bytes().
define PageStatistics (bytes_held: u64  allocations: u64  live: u64  buckets: u64)
shared page_statistics: pointer[PageStatistics] null

; Poison mode (Page.enable_poison(), SCALY_POISON in the drivers): every page
; going back to its bucket, and every oversized block going to free, is
; overwritten with 0xDD first. A read through a dangling reference then
; faults at its FIRST use with the reader in the backtrace, instead of
; surviving until the page happens to be reused — the deterministic witness
; a release-after-use needs. Off by default: one global load per release.
shared page_poison: bool false

; A region is a HEAD page plus the extension chain hanging off its
; next_page. Every page carries a pointer to its head — its own address on
; a head page, the head's on an extension page — and the END of the chain
; is recorded in exactly one place: the head's current_page. So an
; allocation that derives its page from an OBJECT rather than from the
; frame (Page.get(this) in the String/Vector/Array inits, ^this placement,
; container growth) reaches the tail in one indirection, from any page of
; the region and regardless of how long the chain is.
;
; `region` is appended LAST on purpose: the first four slots keep the
; offsets that Region.deserialize's header swizzle and the emitter's
; literal Page layout (synthesize_literal_struct) name by number.
define Page
(
    var next_object: pointer[void]
    var current_page: pointer[Page]
    var next_page: pointer[Page]
    exclusive_pages: PageList
    var region: pointer[Page]
)
{
    ; Answers a borrowed reference, never null: a bucket is created when none
    ; is free, and the page address is computed from it. Return types are not
    ; part of the Itanium name, so no caller's symbol moves.
    function allocate_page() returns ref[Page]
    {
        ; Extension and exclusive pages come from the HeapBucket.
        if heap_head = null
            set heap_head: create_heap_bucket()

        let b heap_head
        ; The bucket lock (milestone 2.3) serializes the bitmap against
        ; cross-thread frees. Invariant: b.bitmap != 0 (we unlink full
        ; buckets below, and remote frees only SET bits — the lowest set
        ; bit stays set until WE clear it).
        bucket_lock b
        let slot ctz_u64 b.bitmap
        set b.bitmap: b.bitmap & ~(1 << slot)

        if b.bitmap = 0
        {
            ; Bucket is now full — unlink from the free list. Still under
            ; the lock: a remote free into this bucket must observe either
            ; in-chain-and-not-full or unlinked-and-full, never the middle.
            set heap_head: b.next
            if heap_head <> null
                set heap_head.prev: null

            set b.next: null
            set b.prev: null
        }
        bucket_unlock b

        let page_addr (b as size_t) + ((slot + 1) as size_t) * PAGE_SIZE
        let page page_addr as pointer[Page]
        reset_page page
        let st page_statistics
        if st <> null
            scaly_atomic_add_u64(&st.bytes_held, PAGE_SIZE as u64)

        page
    }

    function release_page(p: ref[Page])
    {
        ; Oversized pages (allocated directly via aligned_alloc in
        ; allocate_oversized) carry next_object == null. They go back via free.
        let st page_statistics
        if p.next_object = null
        {
            if st <> null
            {
                scaly_atomic_add_u64(&st.bytes_held, (0 as u64) - (Page.oversized_size(p) as u64))
                scaly_atomic_add_u64(&st.live, (0 as u64) - ((Page.oversized_size(p) - sizeof Page) as u64))
            }
            if page_poison
            {
                let osz Page.oversized_size(p)
                memset(p as pointer[void], 0xDD, osz)
                scaly_aligned_free(p as pointer[void])
                return
            }
            ; kept for the next oversized allocation of this thread
            let keep_size Page.oversized_size(p)
            if oversized_kept_count < OVERSIZED_KEPT and oversized_kept_bytes + keep_size <= OVERSIZED_KEPT_BYTES
            {
                set p.next_page: oversized_kept
                set oversized_kept: p
                set oversized_kept_count: oversized_kept_count + 1
                set oversized_kept_bytes: oversized_kept_bytes + keep_size
                return
            }
            scaly_aligned_free(p as pointer[void])
            return
        }
        if st <> null
        {
            scaly_atomic_add_u64(&st.bytes_held, (0 as u64) - (PAGE_SIZE as u64))
            scaly_atomic_add_u64(&st.live, (0 as u64) - (((p.next_object as size_t) - ((p as size_t) + sizeof Page)) as u64))
        }

        let b heap_bucket_of p
        let slot (((p as size_t) - (b as size_t)) / PAGE_SIZE) - 1
        if page_poison
            memset(p as pointer[void], 0xDD, PAGE_SIZE)

        bucket_lock b
        let was_full b.bitmap = 0
        set b.bitmap: b.bitmap | (1 << slot)

        if was_full
        {
            ; Bucket had been full ⇒ it was unlinked ⇒ it belongs to NO
            ; thread's chain. ADOPT it into the freeing thread's chain:
            ; with thread_local heap_head (milestone 2.2) we may not be
            ; the thread that allocated from it, and the bucket lock
            ; makes exactly one freer observe the full→free transition.
            ; heap_head is ours (TLS), and its bucket's next/prev are
            ; only ever written by us — chain buckets are never full, so
            ; no remote freer takes this branch on them.
            set b.next: heap_head
            set b.prev: null
            if heap_head <> null
                set heap_head.prev: b

            set heap_head: b
            set b.owner: heap_owner_token()
        }
        if was_full = false
        {
            ; Milestone 2.3b: the last drain of a DEAD bucket (owner
            ; thread exited with this bucket still holding live pages)
            ; frees the bucket itself — from whichever thread runs this.
            ; A dead bucket can never be full (it sits in no chain, so
            ; nothing allocates from it; bits only get set), so the two
            ; branches never collide. The check lives in root_pages
            ; (drain_dead_bucket) — BITMAP_ALL_FREE is not resolvable
            ; from this earlier-planned module (hard diagnostic).
            if drain_dead_bucket(b)
                return
            if release_idle_bucket(b)
                return
        }
        bucket_unlock b
    }

    ; Attributed variants of allocate_page/release_page for the
    ; standalone, hand-matched alloc/release pairs in fiber.scaly and
    ; File.scaly (worker-pool records, channel records, offload cells)
    ; — pages NOT owned by the region-lifecycle machinery
    ; (deallocate_extensions always frees those together), so a missed
    ; release on an odd error path is a real, silent HeapBucket leak.
    ; `site` is a hand-authored label, not an automatic call-site name
    ; — Scaly has no caller-name introspection without Emitter
    ; cooperation (see SCALY_TRACE_HEAP in root_pages.scaly). Use the
    ; SAME site string at the matching alloc and release call; a
    ; mismatched label shows up as a permanent false imbalance.
    procedure allocate_page_traced(mutable site: pointer[const_char]) returns ref[Page]
    {
        let page Page.allocate_page()
        scaly_heap_trace_alloc site
        page
    }

    procedure release_page_traced(p: ref[Page], mutable site: pointer[const_char])
    {
        Page.release_page(p)
        scaly_heap_trace_release site
    }

    ; How many dead buckets THIS thread has drained and freed
    ; (teardown proof for tests; the counter is thread-local).
    function reclaimed_dead_buckets() returns i64
        dead_buckets_reclaimed

    ; tsc's `Memory used` and `Memory allocs` (see PageStatistics above): 0 until
    ; enable_statistics()
    function bytes_held() returns i64
    {
        let st page_statistics
        if st = null
            return 0
        scaly_atomic_load_u64(&st.bytes_held) as i64
    }

    function allocation_count() returns i64
    {
        let st page_statistics
        if st = null
            return 0
        scaly_atomic_load_u64(&st.allocations) as i64
    }

    function live_bytes() returns i64
    {
        let st page_statistics
        if st = null
            return 0
        scaly_atomic_load_u64(&st.live) as i64
    }

    ; Heap buckets created minus heap buckets freed since enable_statistics(),
    ; over all threads (a bucket freed that existed before counts -1).
    function heap_bucket_count() returns i64
    {
        let st page_statistics
        if st = null
            return 0
        scaly_atomic_load_u64(&st.buckets) as i64
    }

    ; Turns the three counts on (once; later calls do nothing). Call it while the
    ; process is single-threaded, before the work to be measured.
    ; Poison mode (see page_poison). Call it while the process is
    ; single-threaded.
    procedure enable_poison()
    {
        set page_poison: true
    }

    procedure enable_statistics()
    {
        if page_statistics <> null
            return
        let pg Page.allocate_page()
        let st pg.allocate(sizeof PageStatistics, alignof PageStatistics) as pointer[PageStatistics]
        set st.bytes_held: 0
        set st.allocations: 0
        set st.live: 0
        set st.buckets: 0
        set page_statistics: st
    }

    function allocate_root_page() returns pointer[Page]
    {
        ; Function-local and try-scope pages come from the StackBucket.
        ; The Emitter calls this directly (_ZN4Page18allocate_root_pageEv,
        ; get_alloc_root_page_fn) at every local-page prologue — this
        ; function must stay allocation-free (no $/#/for-in), or its own
        ; emission would recurse into it and deadlock at runtime.
        if stack_top = null
        {
            ; First-ever push: lazily create the first bucket if needed, then
            ; return its first usable slot.
            if stack_head = null
                set stack_head: create_stack_bucket(null as pointer[StackBucketHeader])

            let p first_usable_page stack_head
            set stack_top: p
            reset_page p
            return p
        }

        ; Regular push: bump to the next page in the current bucket.
        let bucket stack_bucket_of stack_top
        let next_addr (stack_top as size_t + PAGE_SIZE) as pointer[Page]

        if next_addr > last_usable_page(bucket)
        {
            ; Current bucket exhausted — walk to an existing next bucket or
            ; create one.
            if bucket.next = null
                set bucket.next: create_stack_bucket(bucket)

            let fresh first_usable_page bucket.next
            set stack_top: fresh
            reset_page fresh
            return fresh
        }

        set stack_top: next_addr
        reset_page next_addr
        next_addr
    }

    procedure reset(this: Page)
    {
        set current_page: null
        set next_page: null
        set next_object: this + 1
        ; Zero the field directly — no PageList() construction. The allocator
        ; must never region-allocate: residency inference would promote the
        ; construction to a local page, and a local page here recurses into
        ; allocate_root_page (allocator allocating from itself).
        set exclusive_pages.head: null
        ; A fresh page is its own region until someone links it into one
        ; (allocate below, on the fresh tail it appends).
        set region: (this as size_t) as pointer[Page]
    }

    procedure allocate(this: Page, size: size_t, align: size_t) returns pointer[void]
    {
        let st page_statistics
        if st <> null
            scaly_atomic_add_u64(&st.allocations, 1 as u64)
        let location next_object as size_t

        ; next_object == null tags an OVERSIZED page (see
        ; allocate_oversized) — one that holds a single object and has no
        ; bump pointer. Allocating from it is always a caller bug, and it
        ; used to be a SILENT one: location 0 makes aligned_location 0, the
        ; capacity below then measures from offset 0 and comes out larger
        ; than any request, so the fast path returned ADDRESS 0 and wrote
        ; the bump pointer over the page header. The usual way in is
        ; `Page.get(a)` on an address inside an oversized allocation, which
        ; answers a page nothing can be allocated from. Finding that once
        ; cost hours; this check names it in a second.
        if location = 0
        {
            scaly_eputs "Page.allocate: this page is OVERSIZED (next_object == null)"
            scaly_eputnl()
            scaly_eputs "  An oversized page holds one object and has no bump pointer."
            scaly_eputnl()
            scaly_eputs "  Most likely Page.get() was called on an address inside an"
            scaly_eputnl()
            scaly_eputs "  oversized allocation: the page it answers cannot serve one."
            scaly_eputnl()
            scaly_eputs "  Thread the owning page explicitly instead of deriving it."
            scaly_eputnl()
            exit 19
        }
        let aligned_location (location + align - 1) & (~(align - 1))
        let location_after_page this as size_t + PAGE_SIZE
        let capacity location_after_page - aligned_location

        if capacity < size
        {
            ; We need to reserve the space for the page object
            let gross_size size + sizeof Page
            if gross_size > PAGE_SIZE
                return allocate_oversized gross_size

            ; Serve from the END of the region's extension chain, reached in
            ; ONE indirection: `region` names the head page, and the head's
            ; current_page names the tail. No walk, so no dependence on how
            ; long the chain is or on which of its pages we were called on.
            ;
            ; This replaced a walk down the per-page current_page chain, which
            ; collapsed the pages it visited onto the serving page and so was
            ; almost always one step — but only for pages it actually reached.
            ; A page that filled up long ago and has not been an allocation
            ; START since kept pointing at its immediate successor, and so did
            ; that one's, all the way to the tail. Such a page becomes a start
            ; whenever an allocation derives its page from an OBJECT instead of
            ; from the frame (Page.get(this) in the String/Vector/Array inits,
            ; ^this placement, container growth), so a handle created early in
            ; a long-lived region paid the whole chain on its first later
            ; allocation. Measured 2026-08-02 over a multi-GB region: of
            ; hundreds of millions of allocations exactly FOUR walks exceeded
            ; 500 links — and one of those ran 1 912 559. (Earlier still the
            ; walk RECURSED, one frame per link: SIGSEGV at 104 485 frames on
            ; the default 8 MB stack, which made the largest region a program
            ; could hold a function of its stack size.)
            ;
            ; The head is authoritative, so an intermediate page that kept some
            ; free space after a larger request skipped past it is never
            ; revisited. That space was already unreachable in practice: the
            ; collapse pointed every walk start at the tail as well.
            let head region
            var tail head.current_page
            if tail = null
            {
                let first allocate_page()
                set first.region: head
                set head.next_page: first
                set head.current_page: first
                set tail: first
            }

            var serve_location tail.next_object as size_t
            var serve_aligned (serve_location + align - 1) & (~(align - 1))
            if (tail as size_t + PAGE_SIZE) - serve_aligned < size
            {
                ; Tail is full — append a fresh page and make IT the tail.
                let fresh allocate_page()
                set fresh.region: head
                set tail.next_page: fresh
                set head.current_page: fresh
                set tail: fresh
                set serve_location: fresh.next_object as size_t
                set serve_aligned: (serve_location + align - 1) & (~(align - 1))
            }

            if st <> null
                scaly_atomic_add_u64(&st.live, ((serve_aligned + size) - serve_location) as u64)
            set tail.next_object: (serve_aligned + size) as pointer[void]
            return serve_aligned as pointer[void]
        }

        ; Allocate from ourselves
        let next_location aligned_location + size
        if st <> null
            scaly_atomic_add_u64(&st.live, (next_location - location) as u64)
        set next_object: next_location as pointer[void]
        return aligned_location as pointer[void]
    }

    procedure allocate_oversized(this: Page, size: size_t) returns pointer[void]
    {
        ; We allocate oversized objects directly.
        var rounded (size + PAGE_SIZE - 1) & (~(PAGE_SIZE - 1))
        ; a kept block that fits and wastes at most as much again, else a
        ; fresh one
        var address: pointer[void] null
        var before: pointer[Page] null
        var kept oversized_kept
        while kept <> null
        {
            let kept_size kept.current_page as size_t
            if kept_size >= rounded and kept_size <= rounded * 2
            {
                if before = null
                    set oversized_kept: kept.next_page
                else
                    set before.next_page: kept.next_page
                set oversized_kept_count: oversized_kept_count - 1
                set oversized_kept_bytes: oversized_kept_bytes - kept_size
                set rounded: kept_size
                set address: kept as pointer[void]
                break
            }
            set before: kept
            set kept: kept.next_page
        }
        if address = null
            set address: scaly_aligned_alloc(PAGE_SIZE, rounded)
        if address = null
            scaly_panic_oom("Page.allocate_oversized", rounded)
        let st page_statistics
        if st <> null
        {
            scaly_atomic_add_u64(&st.bytes_held, rounded as u64)
            scaly_atomic_add_u64(&st.live, (rounded - sizeof Page) as u64)
        }

        var page address as pointer[Page]

        ; Oversized pages have no next_object — the null tags them for
        ; release_page. The other header fields are dead for the
        ; allocator; current_page records the aligned_alloc block length
        ; (region serialization needs it, stage 7 — current_page is the
        ; safe slot: next_page chains and exclusive_pages lists are
        ; walked, current_page is only read when allocating FROM a page,
        ; which never happens on an oversized one), the rest is nulled
        ; so the header is deterministic.
        ;
        ; `region` stays NULL rather than self: an oversized page belongs
        ; to no chain, and region serialization copies this header
        ; verbatim without swizzling it (see Region.deserialize), so a
        ; self-pointer here would travel as a stale sender address. Null
        ; also makes the one way to reach this slot — allocating FROM an
        ; oversized page, which the capacity check above already gets
        ; wrong (next_object null ⇒ capacity measured from offset 0) —
        ; fail loudly instead of following garbage.
        set page.next_object: null
        set page.current_page: rounded as pointer[Page]
        set page.next_page: null
        set page.exclusive_pages.head: null
        set page.region: null as pointer[Page]

        ; An oversized page is always exclusive
        exclusive_pages.add page

        ; The page offset by the null pointer for next_object
        return (page + 1) as pointer[void]
    }

    ; The aligned_alloc block length recorded by allocate_oversized (gross
    ; size rounded up to a PAGE_SIZE multiple). Meaningful only for
    ; oversized pages (next_object == null).
    function oversized_size(p: ref[Page]) returns size_t
    {
        let s p.current_page
        s as size_t
    }

    ; Answers a borrowed reference: the page header is always there for a
    ; page-hosted address (a null would mean address 0), and the RETURN is
    ; not part of the Itanium name, so `_Z3getPv` — which the Emitter looks
    ; up by that literal — stays put. Measured 2026-09-05: `let host
    ; Page.get(...)` was the origin of 551 pointer-into-ref sites in the ports.
    function get(address: pointer[void]) returns ref[Page]
    {
        let mask ~((PAGE_SIZE - 1) as size_t)
        let page (address as size_t & mask) as pointer[Page]
        page
    }

    function get_capacity(this: Page, align: size_t) returns size_t
    {
        var location next_object as size_t
        let aligned_location (location + align - 1) & (~(align - 1))
        var location_after_page this as size_t + PAGE_SIZE
        var capacity location_after_page - aligned_location
        capacity
    }

    procedure allocate_exclusive_page(this: Page) returns ref[Page]
    {
        let page allocate_page()
        exclusive_pages.add page
        page
    }

    ; A BUFFER with a page of its own, registered in this page's exclusive list
    ; either way — which is what makes `Page.get(buffer)` the whole release path
    ; (slice 346, the embedded Array). Under a page's worth it is an ordinary
    ; exclusive page with the buffer as its first object; over it the oversized
    ; route, which registers ITSELF here and returns the object right behind the
    ; header. The decision belongs here rather than in the caller because the
    ; caller cannot see PAGE_SIZE: a module-level define does not resolve inside
    ; a generic body monomorphized into another package.
    procedure allocate_exclusive_buffer(this: Page, size: size_t, align: size_t) returns pointer[void]
    {
        let gross size + sizeof Page
        if gross > PAGE_SIZE
            return allocate_oversized gross
        let pg this.allocate_exclusive_page()
        pg.allocate(size, align)
    }

    procedure deallocate_extensions(this: Page)
    {
        ; Oversized pages cannot have extensions
        if next_object = null
            return

        for exclusive_page in exclusive_pages
        {
            exclusive_page.deallocate_extensions()
            release_page(exclusive_page)
        }

        var page next_page
        while page <> null
        {
            let next_page page.next_page
            ; Each extension page can own its OWN exclusive pages (an
            ; Array.reallocate calls allocate_exclusive_page on whatever page
            ; is current — a chain page during a large allocation). Free them
            ; before releasing the chain page, or they orphan their buckets.
            for excl in page.exclusive_pages
            {
                excl.deallocate_extensions()
                release_page(excl)
            }
            release_page(page)
            set page: next_page
        }
    }

    procedure deallocate_exclusive_page(this: Page, page: ref[Page])
    {
        page.deallocate_extensions()
        release_page(page)
        if exclusive_pages.remove(page) = false
            exit 2

    }

    ; Give back everything allocated in this REGION since a MARK was taken on
    ; it. `this` is the region's HEAD; the mark is what the region's end looked
    ; like at that moment — its tail page `mark_page` and that page's bump
    ; pointer `mark` — plus the exclusive-page lists of the mark page and of the
    ; head as they stood then (`exclusive`, `head_exclusive`).
    ;
    ; Answers false and changes NOTHING when the mark cannot be honoured:
    ;   * the mark page is oversized (no bump pointer) or the mark lies outside
    ;     the part of it that was handed out;
    ;   * an exclusive list moved: an oversized allocation since the mark put
    ;     its PageNode inside the span, so the surviving list head would
    ;     dangle. Checked on the mark page AND on the head, a different list as
    ;     soon as the mark sits on an extension page — `allocate` forwards an
    ;     oversized request to the page it was CALLED on;
    ;   * a page appended after the mark owns exclusive pages.
    ; Otherwise the appended pages go back, the chain is cut and the mark page
    ; is the region's end again, bumped back to `mark`. The whole chain is
    ; validated BEFORE anything is released, so a refusal never leaves the
    ; region in pieces.
    ;
    ; ★What this cannot know is whether anything above the mark is still
    ; reachable: proving that is the caller's job (dazzle's FrameMark and its
    ; six conditions). A wrong rewind is a dangling pointer, not a diagnostic.
    procedure rewind(this: Page, mark_page: pointer[Page], mutable mark: pointer[void], exclusive: pointer[PageNode], head_exclusive: pointer[PageNode]) returns bool
    {
        let now mark_page.next_object
        if now = null
            return false
        if (mark as size_t) < (mark_page as size_t)
            return false
        if (mark as size_t) > (now as size_t)
            return false
        if mark_page.exclusive_pages.head <> exclusive
            return false
        if exclusive_pages.head <> head_exclusive
            return false
        var p mark_page.next_page
        var pages 0
        while p <> null
        {
            if p.exclusive_pages.head <> null
                return false
            set pages: pages + 1
            set p: p.next_page
        }
        if (now as size_t) = (mark as size_t)
        {
            if pages = 0
                return true
        }
        var q mark_page.next_page
        while q <> null
        {
            let following q.next_page
            release_page(q)
            set q: following
        }
        ; the head records the end, and null means "the head IS the end" —
        ; the state `allocate` expects, it appends on demand
        set mark_page.next_page: null
        if (mark_page as size_t) = (this as size_t)
            set current_page: null
        else
            set current_page: mark_page
        ; Poison mode: the rewound stretch of the mark page itself is not
        ; released, so overwrite it here — a dangling read into it survived
        ; SCALY_POISON otherwise (asked 2026-09-23, the dazzle frame mark)
        if page_poison and (now as size_t) > (mark as size_t)
            memset(mark, 0xDD, (now as size_t) - (mark as size_t))
        set mark_page.next_object: mark
        true
    }

}
