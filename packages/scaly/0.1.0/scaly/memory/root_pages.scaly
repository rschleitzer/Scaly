; Bucket machinery for the StackBucket (strict LIFO) and HeapBucket
; (bitmap-managed) page allocators, plus the StackBucket release paths and
; the SCALY_TRACE_ROOT diagnostics. The allocate/release entry points live
; in Page.scaly (Page.allocate_root_page / Page.allocate_page /
; Page.release_page), together with the mutable allocator state.
;
; StackBucket: root pages — function-local and try-scope pages the Emitter
;   allocates at entry and releases on exit. Push is a pointer bump; pop is
;   a pointer decrement. Strict LIFO — a release that doesn't match the top
;   of stack is a bug (e.g. a missed cleanup path) and is fatal.
;
; HeapBucket: extension pages (when a root page overflows) and exclusive
;   pages (HashMap rehash etc.). Each bucket has a 64-bit bitmap tracking
;   which of its 63 usable pages are free.
;
; Each bucket is a BUCKET_SIZE-aligned region of BUCKET_PAGES pages. Page 0
; holds the bucket header; pages 1..BUCKET_PAGES-1 are usable.
;
; The trace counters are Scaly-owned mutable module globals. Diagnostics go
; to stderr via write(2, ...) below.
;
; Guard semantics: `if X ACTION` runs ACTION when X is true, then falls
; through. It's an early-exit when the condition holds.
;
; These functions must never trigger the Emitter's getOrCreateLocalPage
; (i.e. they must not have `$` allocations, `for-in` loops, or calls that
; take a caller-page parameter) — otherwise we'd recurse back into
; Page.allocate_root_page during its own emission and deadlock at runtime.

define BUCKET_PAGES  size_t 64
define BUCKET_SIZE   size_t 0x40000        ; PAGE_SIZE * BUCKET_PAGES
define BUCKET_MASK   size_t 0x3FFFF         ; BUCKET_SIZE - 1
define BITMAP_ALL_FREE u64 0x7FFFFFFFFFFFFFFF  ; bits 0..62 set (page 0 is header)

; Bucket headers sit at offset 0 of each bucket.
define StackBucketHeader
(
    prev: pointer[StackBucketHeader]
    next: pointer[StackBucketHeader]
)

define HeapBucketHeader
(
    prev: pointer[HeapBucketHeader]
    next: pointer[HeapBucketHeader]
    bitmap: u64
    lock: u64
)

; The per-thread allocator state (stack_head, stack_top, heap_head —
; thread_local like every mutable global since milestone 2.2)
; lives in Page.scaly: its consumers Page.allocate_root_page,
; Page.allocate_page and Page.release_page are planned before this module,
; and lookup_global is populated in planning order. The root-page release
; below is planned later and resolves stack_top fine.

; Trace-diagnostic state — off by default, armed by SCALY_TRACE_ROOT on
; the first root-page push or pop. All state is Scaly-owned; the shim
; only provides stderr primitives and two push/pop trampolines that
; forward to the Scaly-mangled implementations below.
mutable trace_enabled:           i64 0
mutable trace_atexit_registered: i64 0
mutable trace_count:             i64 0
mutable trace_entries:           pointer[TraceEntry] null

define TRACE_MAX size_t 8192

define TraceEntry
(
    name: pointer[const_char]
    push_count: i64
    pop_count: i64
)

function getenv(name: pointer[const_char]) returns pointer[const_char] extern
procedure atexit(cb: pointer[void]) returns int extern
function strdup(s: pointer[const_char]) returns pointer[char] extern

; Scratch buffer for integer/pointer formatting. 32 bytes is enough for
; any i64 decimal (max 20 chars) or pointer hex (18 chars). Lazily
; allocated on the first formatted write; reused from then on. Safe
; because the diagnostic dump runs single-threaded at atexit.
mutable fmt_scratch: pointer[char] null

function scaly_fmt_scratch_ptr() returns pointer[char]
{
    ; alignment must be a valid power-of-two >= sizeof(void*): aligned_alloc(1,
    ; ...) returns NULL on macOS/Apple libc (and is UB per C11), which made a
    ; deref of this scratch buffer SIGSEGV. 16 is safe; 32 is a multiple of it.
    if fmt_scratch = null
        set fmt_scratch: aligned_alloc(16, 32) as pointer[char]
    fmt_scratch
}

; Byte-level stderr output via libc write(2, ...). No format strings:
; Scaly composes every diagnostic message by writing bytes.

procedure scaly_eputs(s: pointer[const_char])
{
    write(2 as int, s as pointer[void], strlen s)
}

procedure scaly_eputnl()
{
    ; A Scaly "\n" literal is a String struct (varint-prefixed buffer); casting
    ; it to pointer[void] and writing 1 byte emitted the struct's first byte
    ; (garbage), not the newline. Write the LF byte from the scratch buffer.
    let buf scaly_fmt_scratch_ptr()
    set *buf: (10 as char)
    write(2 as int, buf as pointer[void], 1 as size_t)
}

procedure scaly_eputi(n: i64)
{
    let buf scaly_fmt_scratch_ptr()
    var pos 31 as i64
    var val n
    var negative false
    if val < 0
    {
        set negative: true
        set val: 0 - val
    }
    ; A zero value produces no digits in the loop below, so emit the single
    ; '0' here. The guard was inverted (val <> 0), which appended a spurious
    ; trailing '0' to every nonzero value and printed nothing for 0.
    if val = 0
    {
        set pos: pos - 1
        set *(buf + pos): 48 as char
    }
    while val > 0
    {
        set pos: pos - 1
        let digit val - (val / 10) * 10
        set *(buf + pos): (digit + 48) as char
        set val: val / 10
    }
    if negative
    {
        set pos: pos - 1
        set *(buf + pos): 45 as char
    }
    let len 31 - pos
    write(2 as int, (buf + pos) as pointer[void], len as size_t)
}

; Hex digit for a nibble (0..15), computed arithmetically. A fixed-array
; `char[]` lookup table would be a module-level array constant, which
; stage-1's planner emits as an external declaration (no body) — the
; unported Planner.cpp:6193 array-global gap. Computing the digit keeps
; the runtime self-hostable (s189, same avoidance as s188's hashing).
function hex_digit(nibble: i64) returns char
{
    if nibble < 10 as i64
        return (nibble + 48) as char       ; '0'..'9'
    (nibble - 10 + 97) as char             ; 'a'..'f'
}

procedure scaly_eputp(p: pointer[void])
{
    let buf scaly_fmt_scratch_ptr()
    set *(buf + 0): 48 as char
    set *(buf + 1): 120 as char
    var val p as u64
    var i 17 as i64
    while i >= 2 as i64
    {
        let nibble (val & (15 as u64)) as i64
        set *(buf + i): hex_digit(nibble)
        set val: val >> (4 as u64)
        set i: i - 1
    }
    write(2 as int, buf as pointer[void], 18 as size_t)
}

; --------------------------------------------------------------------------
; Address helpers
; --------------------------------------------------------------------------

function stack_bucket_of(p: pointer[Page]) returns pointer[StackBucketHeader]
    (p as size_t & ~BUCKET_MASK) as pointer[StackBucketHeader]

function heap_bucket_of(p: pointer[Page]) returns pointer[HeapBucketHeader]
    (p as size_t & ~BUCKET_MASK) as pointer[HeapBucketHeader]

; Atomic primitives (milestone 2.3). These extern names never exist as
; symbols — the Emitter lowers the calls to atomicrmw/cmpxchg/atomic
; load+store instructions (emit_atomic_call, all seq_cst). They may not
; live in the C shim: atomics are neither OS-specific, variadic, nor
; errno-bound (containment rule), and the libatomic ABI symbols are not
; uniformly linkable across the four targets.
function scaly_atomic_cas_u64(p: pointer[u64], expected: u64, desired: u64) returns u64 extern
procedure scaly_atomic_store_u64(p: pointer[u64], v: u64) extern

; Per-bucket spinlock (milestone 2.3, freelist safety). With thread_local
; allocator state (milestone 2.2) each thread owns a heap-bucket CHAIN,
; but a page may be FREED by a different thread than the one whose chain
; its bucket sits in — release_page reaches the bucket by address mask.
; The lock serializes everything that touches one bucket's shared state:
; the bitmap, and the chain-membership transitions (unlink-on-full in
; allocate_page, adopt-on-free in release_page). Chain next/prev fields
; are only ever written by the chain's OWNER thread (a bucket in a chain
; is never full, so no remote freer takes the adoption branch on it) —
; one bucket lock at a time, no ordering, no deadlock. Critical sections
; are a handful of instructions and contention needs a cross-thread free
; hitting the same bucket, so a bare spin (no backoff) is fine.
procedure bucket_lock(b: pointer[HeapBucketHeader])
{
    let lp &b.lock
    repeat
    {
        if scaly_atomic_cas_u64(lp, 0 as u64, 1 as u64) = (0 as u64)
            break
    }
}

procedure bucket_unlock(b: pointer[HeapBucketHeader])
{
    let lp &b.lock
    scaly_atomic_store_u64(lp, 0 as u64)
}

function first_usable_page(bucket: pointer[void]) returns pointer[Page]
    (bucket as size_t + PAGE_SIZE) as pointer[Page]

function last_usable_page(bucket: pointer[void]) returns pointer[Page]
    (bucket as size_t + (BUCKET_PAGES - (1 as size_t)) * PAGE_SIZE) as pointer[Page]

; --------------------------------------------------------------------------
; reset_page — fresh-page initialization: bump pointer sits just past the
; Page header, all chain/list pointers are null.
; --------------------------------------------------------------------------

procedure reset_page(p: pointer[Page])
{
    set p.next_object: (p as size_t + sizeof Page) as pointer[void]
    set p.current_page: null
    set p.next_page: null
    ; Zero the field directly — no PageList() construction. The allocator
    ; must never region-allocate: residency inference would promote the
    ; construction to a local page, and a local page here recurses into
    ; Page.allocate_root_page (allocator allocating from itself).
    set p.exclusive_pages.head: null
}

; --------------------------------------------------------------------------
; Bucket creation
; --------------------------------------------------------------------------

function create_stack_bucket(prev: pointer[StackBucketHeader]) returns pointer[StackBucketHeader]
{
    let mem aligned_alloc(BUCKET_SIZE as i64, BUCKET_SIZE as i64)
    if mem = null
        exit 101

    let sb mem as pointer[StackBucketHeader]
    set sb.prev: prev
    set sb.next: null
    if prev <> null
        set prev.next: sb

    sb
}

function create_heap_bucket() returns pointer[HeapBucketHeader]
{
    let mem aligned_alloc(BUCKET_SIZE as i64, BUCKET_SIZE as i64)
    if mem = null
        exit 102

    let hb mem as pointer[HeapBucketHeader]
    set hb.prev: null
    set hb.next: null
    set hb.bitmap: BITMAP_ALL_FREE
    set hb.lock: 0 as u64
    hb
}

; --------------------------------------------------------------------------
; Count trailing zeros in a u64 (for the HeapBucket bitmap scan). Caller
; must ensure x != 0. A branchless BINARY SEARCH for the lowest set bit:
; 6 halving steps instead of up to 63 shift iterations. Table-free (no
; De Bruijn i32[] module-global array, which stage-1's planner emits as a
; bodiless external declaration — the unported Planner.cpp:6193 array-global
; gap — so the seed would fail to link). Behaviour-identical to the old
; shift-loop: returns the index of the lowest set bit.
;
; This matters: Page.allocate_page clears the lowest free bit each allocation,
; so a sequentially-filling bucket drove the old shift-loop toward ~31
; iterations average (O(n^2) per bucket fill). The binary search is a fixed
; 6 steps regardless of slot — the hot path under default-to-local transient
; page churn.
; --------------------------------------------------------------------------

function ctz_u64(x: u64) returns i32
{
    ; `n` is i64 throughout: `set n: n + K` widens int arithmetic to i64,
    ; and an i32 slot would get an 8-byte store clobbering the adjacent `v`
    ; slot (observed corrupting heap-bucket slot selection under stage-1's
    ; allocation pattern, s189). Cast to i32 only at return.
    var n 0 as i64
    var v x
    if (v & (0xFFFFFFFF as u64)) = (0 as u64)
    {
        set n: n + 32
        set v: v >> (32 as u64)
    }
    if (v & (0xFFFF as u64)) = (0 as u64)
    {
        set n: n + 16
        set v: v >> (16 as u64)
    }
    if (v & (0xFF as u64)) = (0 as u64)
    {
        set n: n + 8
        set v: v >> (8 as u64)
    }
    if (v & (0xF as u64)) = (0 as u64)
    {
        set n: n + 4
        set v: v >> (4 as u64)
    }
    if (v & (0x3 as u64)) = (0 as u64)
    {
        set n: n + 2
        set v: v >> (2 as u64)
    }
    if (v & (0x1 as u64)) = (0 as u64)
        set n: n + 1
    n as i32
}

; --------------------------------------------------------------------------
; StackBucket: root pages
; --------------------------------------------------------------------------

procedure scaly_release_root_page(p: pointer[Page])
{
    ; Strict LIFO: the release must pop the current top. A mismatch means
    ; some exit path skipped its release — a real bug.
    if p <> stack_top
    {
        scaly_eputs "scaly_release_root_page: LIFO violation — release="
        scaly_eputp p
        scaly_eputs " top="
        scaly_eputp stack_top
        scaly_eputnl()
        abort()
    }

    let bucket stack_bucket_of p
    let first first_usable_page bucket

    if p <> first
    {
        set stack_top: (p as size_t - PAGE_SIZE) as pointer[Page]
        return
    }

    ; Popped the bucket's first page — unwind to the previous bucket's last
    ; usable slot, or clear the stack entirely if this was the first bucket.
    if bucket.prev = null
    {
        set stack_top: null
        return
    }

    set stack_top: last_usable_page(bucket.prev)
}

; Full teardown of a function-local root page at scope exit (the blocker-C
; "always free local regions" invariant). Frees the page's owned extension
; chain + exclusive pages when it was actually used, then returns the
; StackBucket root slot via scaly_release_root_page.
;
; The gate is load-bearing for TERMINATION, not just efficiency: the emitter
; calls this from EVERY non-# function's epilogue, including
; deallocate_extensions' own (its for-loop acquires a fresh local page). A
; fresh page — bump pointer still at the header, no chain, no exclusive pages
; — skips deallocate_extensions, so the cycle deallocate_extensions ->
; epilogue -> release_full -> deallocate_extensions bottoms out immediately.
; This function is allocation-free (no $/#/for-in) so it never acquires its
; own local page (see the header note on allocator-path functions).
;
; The escape checker (return/store/call vectors) guarantees no escaping
; reference lives on a local page, so the unconditional release is not a
; use-after-free. Mirrors stage-0's emitReturn CleanupLocalPage
; (emitPageNeedsCleanup gate + deallocate_extensions + release).
procedure scaly_release_root_page_full(p: pointer[Page])
{
    if p = null
        return
    let fresh_next (p as size_t + sizeof Page) as pointer[void]
    var used false
    if p.next_object <> fresh_next
        set used: true
    if p.next_page <> null
        set used: true
    if p.exclusive_pages.head <> null
        set used: true
    if used
        p.deallocate_extensions()
    scaly_release_root_page p
}

; --------------------------------------------------------------------------
; SCALY_TRACE_ROOT diagnostic: per-function push/pop counters. Off by
; default; armed on the first push/pop if $SCALY_TRACE_ROOT is set at
; that moment. The atexit dump reports any function whose push/pop
; counts don't balance (indicating a missed release path).
; --------------------------------------------------------------------------

procedure scaly_trace_dump()
{
    var i 0 as i64
    var any false
    while i < trace_count
    {
        let e trace_entries + i
        if (*e).push_count = (*e).pop_count
        {
            let pushes (*e).push_count
            let pops (*e).pop_count
            scaly_eputs "scaly_trace_root: UNBALANCED "
            scaly_eputs((*e).name)
            scaly_eputs " push="
            scaly_eputi pushes
            scaly_eputs " pop="
            scaly_eputi pops
            scaly_eputs " leak="
            scaly_eputi(pushes - pops)
            scaly_eputnl()
            set any: true
        }
        set i: i + 1
    }
    if any
        return
    scaly_eputs "scaly_trace_root: all root-page push/pop balanced"
    scaly_eputnl()
}

procedure scaly_rt_register_trace()
{
    ; Already armed — nothing to do.
    if trace_atexit_registered <> 0
        return
    set trace_atexit_registered: 1
    ; Env var not set — leave trace disabled.
    if getenv("SCALY_TRACE_ROOT") = null
        return
    set trace_enabled: 1
    ; Lazy-allocate the trace table. Scaly can't express a fixed-size
    ; array at module-global scope, so we heap-allocate on first arm.
    let bytes TRACE_MAX * (sizeof TraceEntry)
    set trace_entries: aligned_alloc(8, bytes as i64) as pointer[TraceEntry]
    atexit(&scaly_trace_dump)
}

function scaly_trace_find_or_add(name: pointer[const_char]) returns pointer[TraceEntry]
{
    var i 0 as i64
    while i < trace_count
    {
        let e trace_entries + i
        if strcmp((*e).name, name) = 0
            return e
        set i: i + 1
    }
    ; Table full — give up rather than corrupting.
    if trace_count >= TRACE_MAX as i64
        return null as pointer[TraceEntry]
    let new_entry trace_entries + trace_count
    ; strdup is required because JIT modules (which own the source of
    ; each `name` via CreateGlobalStringPtr) are disposed between test
    ; runs; without interning, later strcmps would walk freed memory.
    set (*new_entry).name: strdup(name) as pointer[const_char]
    set (*new_entry).push_count: 0
    set (*new_entry).pop_count: 0
    set trace_count: trace_count + 1
    new_entry
}

procedure scaly_trace_push(name: pointer[const_char])
{
    scaly_rt_register_trace()
    if trace_enabled = 0
        return
    let e scaly_trace_find_or_add name
    if e <> null
        set (*e).push_count: (*e).push_count + 1
}

procedure scaly_trace_pop(name: pointer[const_char])
{
    scaly_rt_register_trace()
    if trace_enabled = 0
        return
    let e scaly_trace_find_or_add name
    if e <> null
        set (*e).pop_count: (*e).pop_count + 1
}
