; Deliberately NOT List[pointer[Page]]: this is the allocator's own intrusive
; list, embedded by value in the Page header — a layer BELOW containers
; (List's Node[T]^this itself calls Page.allocate). Replacing it would invert
; the memory/containers layering, pull generic instantiation into the
; allocator core, and shift the Page layout (seed refresh). Keep it concrete
; and auditable.
define PageList
@resident true (
    var head: pointer[PageNode] (null)
)
{
    procedure add(mutable this: PageList, element: ref[Page]) linked






    procedure remove(mutable this: PageList, element: ref[Page]) returns bool linked






















    function get_iterator(this: PageList) @page true @direct true returns PageListIterator linked

}
