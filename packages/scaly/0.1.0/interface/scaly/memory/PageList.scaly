; Deliberately NOT List[pointer[Page]]: this is the allocator's own intrusive
; list, embedded by value in the Page header — a layer BELOW containers
; (List's Node[T]^this itself calls Page.allocate). Replacing it would invert
; the memory/containers layering, pull generic instantiation into the
; allocator core, and shift the Page layout (seed refresh). Keep it concrete
; and auditable.
define PageList
@resident true @inplace true (
    var head: pointer[PageNode] (null)
)
{
    procedure add(mutable this: PageList, element: ref[Page]) @deep true @deep_this_2 true @deep_whole_2 true @deep_pageof_1 true linked

    procedure remove(mutable this: PageList, element: ref[Page]) @ret_nonlocal true @deep true returns bool linked

    function get_iterator(this: PageList) @page true @direct true @deep true returns PageListIterator linked
}
