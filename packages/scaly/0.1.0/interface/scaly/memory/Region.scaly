; Region serialization (stage 7, milestone 7.1). A message region's pages
; travel VERBATIM as a length-prefixed frame (native LP64-LE memory image —
; the stage-7 wire format, no translation layer); the receiver materializes
; them into REAL pages — bucket pages via Page.allocate_page, oversized
; blocks via aligned_alloc, exactly the two shapes release_page frees — so
; a received region dies like any other. Pointer fixup is split: page
; HEADERS are swizzled here (structure known to the allocator), the typed
; object graph is the per-message-type walker's job (hand-written in 7.1,
; compiler-generated in 7.2) via the ReceivedRegion map/fix interface.
;
; Frame layout (all slots u64):
;   [0] magic  [1] total frame bytes  [2] page count  [3] root object (old)
;   then page table: count x (old base, byte length)  — entry 0 is the
;   region's ROOT page —  then the pages' bytes, verbatim, in table order.
;
; The region must be CLOSED: every pointer reachable from the root object
; stays inside the region (enforcement is 7.2/7.3 checker work; until then
; fix() fails loud through scaly_panic_region -- exit 18 when nobody catches
; it, and CATCHABLE as `when e: InvalidRegion` since 2026-09-08, because a
; received region is somebody else's data and a node must be able to lose the
; message instead of itself). Sender-side teardown stays the caller's:
; serialize only reads. The region's root must be a heap page
; (Page.allocate_page), not a stack root page.

define REGION_WIRE_MAGIC u64 0x3153434c59

define ReceivedRegion
(
    var region: pointer[Page]
    var root: pointer[void]
    var page_count: size_t
    var old_bases: pointer[size_t]
    var new_bases: pointer[size_t]
    var lengths: pointer[size_t]
)
{
    ; Map an address from the sender's region into the received copies;
    ; 0 = outside the region. RANGE-based on purpose: an interior pointer
    ; into an oversized buffer sits arbitrarily far past its page base,
    ; so 4K masking cannot find the owner.
    function map(this: ReceivedRegion, address: size_t) returns size_t linked





















    ; Swizzle one pointer slot in place. Null stays null; a nonnull value
    ; outside the region means the region was NOT closed — fail loud.
    procedure fix(this: ReceivedRegion, mutable slot: pointer[void]) linked












    ; Map one pointer VALUE instead of a slot — the 7.2 compiler-generated
    ; walkers load and store their slots themselves (a union payload sits at
    ; byte offset 1, so the slot may be unaligned; fix()'s size_t deref
    ; assumes natural alignment). Null stays null; a nonnull value outside
    ; the region means the region was NOT closed — fail loud.
    function fix_value(this: ReceivedRegion, old: size_t) returns size_t linked










    ; Swizzle a slot DURING deserialize, where this record still owns every
    ; page it has allocated and nobody else can free them yet.
    ;
    ; ★★★It exists because `fix` above cannot clean up: it is also called from
    ; the compiler-generated walkers during `fix_graph`, long after
    ; deserialize returned, where the owner is the CALLER and the right answer
    ; is `rr.release()` in its catch arm. Inside deserialize there is no such
    ; owner yet -- a caught fault would leak the whole half-built region --
    ; so this half frees first and then raises.
    procedure fix_owned(this: ReceivedRegion, mutable slot: pointer[void]) linked















    ; Give back every page this record allocated, through the TABLE.
    ;
    ; ★★★Through the table and NOT through the page links: while the header
    ; swizzle is running, `next_page` and `exclusive_pages` still hold SENDER
    ; addresses on the pages not reached yet, so the link walk in
    ; `deallocate_extensions` would follow them into nowhere. `new_bases`
    ; holds all of them, and `release_page` tells the two shapes apart by
    ; `next_object` (null = an oversized aligned_alloc block), which the
    ; copied bytes preserve.
    procedure release_pages(this: ReceivedRegion) linked












    ; Free the received region through the normal lifecycle.
    procedure release(mutable this: ReceivedRegion) linked





}

define Region
{
    ; --- enumeration: the deallocate_extensions walk, read-only ---

    function count_exclusives(p: ref[Page]) returns size_t linked
















    function count_pages(region: ref[Page]) returns size_t linked











    ; Fill the interleaved (base, length) table; index counts SLOTS
    ; (two per page); returns the index after the last slot written.
    procedure fill_exclusives(p: ref[Page], mutable table: pointer[size_t], index: size_t) returns size_t linked






















    procedure fill_pages(region: ref[Page], mutable table: pointer[size_t], index: size_t) returns size_t linked




















    ; --- sender: build the frame on the host page ---

    function serialize(region: ref[Page], root: pointer[void], host: ref[Page]) returns pointer[u8] linked





































    ; Total frame length in bytes, read back from a frame (or from just
    ; its 32-byte header) — for socket readers that need the rest count.
    function frame_length(frame: pointer[u8]) returns size_t linked






    ; --- receiver: materialize + header swizzle + map ---

    ; Returns null on framing violations (bad magic, empty table, a length
    ; that is not a nonzero PAGE_SIZE multiple) — the v1 trust boundary.
    ; Structural pointer violations inside accepted pages fail loud in
    ; fix() instead: by then the frame claims to be a closed region.
    function deserialize(frame: pointer[u8], host: ref[Page]) @page true @direct true returns ref[ReceivedRegion]? linked





































































































































    ; --- catching a panic (TRAPS.md 0) --------------------------------------
    ;
    ; The requirement is that a programmer can handle an out-of-bounds index
    ; instead of watching the process die. `try` is not built yet; this is the
    ; same mechanism one call earlier: run `body(arg)` with a catch point on
    ; the stack, and if a bounds trap fires anywhere inside -- at any depth,
    ; including in library code the caller did not write -- the guarded CALL
    ; ends instead of the program.
    ;
    ; ★It lives on `Region` and not as a free function because a user program
    ; cannot resolve a cross-package free function with a concept-pointer
    ; parameter (CLAUDE.md, Package system); concept STATICS resolve fine.
    ;
    ; ★`caught` is a `pointer[i32]` and not a `ref[bool]`: the shim writes a C
    ; `int`, and a bool would be the wrong WIDTH -- the silent half of the
    ; extern-ABI class the abi gate exists for.
    ;
    ; ★The two function pointers are how the shim reaches the region-stack
    ; watermark and the unwind without writing their Itanium mangled names
    ; into C, which would freeze their signatures (CLAUDE.md, eight symbols
    ; already pay that price).
    procedure run_guarded(mutable body: pointer[void], mutable arg: pointer[void], mutable caught: pointer[i32]) returns i64 linked


    ; What the panic said, once run_guarded reported one. Allocation-free by
    ; construction: the regions between the trap and the catch point are gone
    ; by the time this can be asked, so the detail travels as scalars and a
    ; static string.
    function panic_what() returns pointer[const_char] linked


    function panic_index() returns i64 linked


    function panic_length() returns i64 linked


    ; How many traps this thread has raised, caught and fatal alike, one
    ; reader per KIND. Each counter sits at its kind's ONE panic site
    ; (root_pages.scaly), which is what makes it a single load instead of one
    ; per access site; TRAPS.md 4 is the question they answer.
    ;
    ; ★A caller that wants the count for a WINDOW takes a delta -- there is
    ; deliberately no reset, because two callers resetting one thread-local
    ; counter would each destroy the other's measurement.
    ;
    ; ★They are named by KIND and not `panic_count`, which is what the bounds
    ; counter was called for one day: the moment a second trap kind is counted,
    ; an unqualified name is a claim about the family that neither reader can
    ; keep.
    function panic_oob_count() returns i64 linked


    function panic_null_count() returns i64 linked


    function panic_region_count() returns i64 linked


    function panic_size_count() returns i64 linked


    function panic_string_count() returns i64 linked


    function panic_oom_count() returns i64 linked


    function panic_resource_count() returns i64 linked


    function panic_deadlock_count() returns i64 linked


    ; Is a catch point installed on this thread's stack? The panic helper asks
    ; the shim the same question implicitly; this is for a caller that wants to
    ; know whether a trap would end the process.
    function catch_active() returns bool linked


}
