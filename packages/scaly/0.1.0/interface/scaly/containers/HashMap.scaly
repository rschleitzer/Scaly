define HashMapIterator[K, V]
(
    slot_iterator: VectorIterator[Vector[KeyValuePair[K, V]]]
    var element_iterator: VectorIterator[KeyValuePair[K, V]]
)
{
    init (hash_map: HashMap[K, V])
    {
        set slot_iterator: VectorIterator[Vector[KeyValuePair[K, V]]](hash_map.slots)
        let first_slot slot_iterator.next()
        if first_slot <> null
            set element_iterator: VectorIterator[KeyValuePair[K, V]](first_slot)

    }

    procedure next(mutable this: HashMapIterator[K, V]) returns ref[V]?
    {
        while true
        {
            let ret element_iterator.next()
            if ret <> null
                return &ret.value

            let next_slot slot_iterator.next()
            if next_slot = null
                return null

            set element_iterator: VectorIterator[KeyValuePair[K, V]](next_slot)
        }
    }
}

define HashMap[K, V]
(
    slots: ref[Vector[Vector[KeyValuePair[K, V]]]]? (null)
)
{
    init (hash_map_builder: HashMapBuilder[K, V])
    {
        if hash_map_builder.length = 0
        {
            set slots: null
            return
        }

        set slots: Vector[Vector[KeyValuePair[K, V]]]^this(hash_map_builder.slots.length)
        let length hash_map_builder.slots.length
        var i: size_t 0
        while i < length
        {
            let slot_list hash_map_builder.slots.at i
            var array Array[KeyValuePair[K, V]]()
            var list_iterator ListIterator[Slot[KeyValuePair[K, V]]](slot_list.head)
            while let item list_iterator.next()
                array.add item.value

            if array.length > 0
                slots.put(i, Vector[KeyValuePair[K, V]]^this(*array))

            set i: i + 1
        }
    }

    function contains(this: HashMap[K, V], key: K) returns bool
    {
        if slots = null
            return false

        let hash key.hash()
        let slot_number hash % slots.length
        let slot slots.at slot_number
        let length slot.length
        var i: size_t 0
        while i < length
        {
            let item slot.at i
            if key = item.key
                return true

            set i: i + 1
        }

        return false
    }

    ; Body inlined from get (not `return get key`): subscript dispatch
    ; plans this operator on demand (find_subscript_operator), and a
    ; sibling-method call from an on-demand-planned operator body resolves
    ; to a declaration that is never instantiated (HashMap is not in the
    ; s188 lazy-machinery allowlist) — an undefined symbol at link. The
    ; machinery generics used below (Vector/List iterators) ARE
    ; allowlisted, so the inline body instantiates cleanly.
    operator [](key: K) returns ref[V]?
    {
        if slots = null
            return null

        let hash key.hash()
        let slot_number hash % slots.length
        let slot slots.at slot_number
        let length slot.length
        var i: size_t 0
        while i < length
        {
            let item slot.at i
            if key = item.key
                return &item.value

            set i: i + 1
        }

        return null
    }

    function get(this: HashMap[K, V], key: K) returns ref[V]?
    {
        if slots = null
            return null

        let hash key.hash()
        let slot_number hash % slots.length
        let slot slots.at slot_number
        let length slot.length
        var i: size_t 0
        while i < length
        {
            let item slot.at i
            if key = item.key
                return &item.value

            set i: i + 1
        }

        return null
    }
}
