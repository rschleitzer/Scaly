use scaly.memory.Page
use scaly.memory.runtime

define StringBuilder
@resident true @inplace true (
    buffer: Array[char]
)
{
    ; StringBuilder allocates its buffer on the object's own page via `^this`,
    ; so it must be page-resident — the residency inference (its `^this`-guts
    ; init + the heap-backed allowlist) makes a no-sigil StringBuilder()
    ; Page::allocate on the caller's local page. No explicit page param needed.

    init () linked

    init (size: size_t) linked

    init (character: char) linked

    init (string: String) linked

    init (c_string: pointer[const_char]) linked

    procedure append(mutable this: StringBuilder, character: char) @persists true @ret_nonlocal true @deep true linked

    procedure append(mutable this: StringBuilder, string: String) @ret_nonlocal true @deep true linked

    procedure append(mutable this: StringBuilder, c_string: pointer[const_char]) @deep true linked

    procedure append(mutable this: StringBuilder, start: pointer[char], length: size_t) @ret_nonlocal true @deep true linked

    ; Decimal formatting overloads — string interpolation desugars an
    ; embedded expression to a plain `append`, so the numeric conversions
    ; live here. Classic divide-by-10 with digit buffer and reversal
    ; (mirrors the compiler's size_to_string).
    procedure append(mutable this: StringBuilder, value: size_t) @deep true linked

    procedure append(mutable this: StringBuilder, value: int) @ret_nonlocal true @deep true linked

    procedure append(mutable this: StringBuilder, value: bool) @ret_nonlocal true @deep true linked

    function get_length(this: StringBuilder) @ret_param_0 true @deep true returns size_t linked

    ; ★THE TREE'S LAST (pointer, length) PAIR SITE, and it stays standing
    ; on purpose.  The other 131 have been collapsed (`tools/pairslice.py`):
    ; opensp/dazzle through `StringC.as_slice()`, and the six in the generated
    ; `parser.scaly` through `String(x)` -- a copy `init` that had been there
    ; the whole time.  That would not work in this place: `buffer` is an
    ; `Array[char]`, and `String` has no `init(Slice[char])`.
    ;
    ; ★★★BUILDING ONE WOULD BE API SURFACE FOR EXACTLY ONE CALL SITE.  It
    ; belongs where a POPULATION needs it -- `String.get_buffer()`
    ; has 340 call sites, but those are walks and not pairs, and for those
    ; `as_slice()` (which does exist) plus `tools/sliceview.py` is the form.  As
    ; long as nobody apart from this line asks for it, the pair is cheaper here
    ; than a sixth 1-argument `init` on `String`.
    function to_string(this: StringBuilder) @page true @direct true @ret_caller true @deep true returns String linked
}
