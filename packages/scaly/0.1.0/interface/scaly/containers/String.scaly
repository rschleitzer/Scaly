use scaly.memory.Page
use scaly.memory.runtime

define PACKED_SIZE: int 9

; String is a pointer-sized HANDLE: the struct is a single pointer, the
; varint-length-prefixed byte buffer lives on a page. The allocating inits
; below derive that page from the String's own address (Page.get(this)),
; so every construction that allocates must be page-resident — residency
; inference guarantees this (concept_needs_this_residency sees the
; Page.get(this) in these bodies and region-allocates the construction on
; the destination page chosen at the call site: local page, # = caller's
; page, ^this = the owner's page).
define String @resident true (data: pointer[u8](null))
{
    ; Empty string - no allocation
    init() linked




    init(length: size_t) linked
































    init(other: pointer[const_char], length: size_t) linked































    init(other: Vector[char]) linked




























    init(c_string: pointer[const_char]) linked
































    init(other: String) linked






























    init(character: u8) linked








    function get_buffer(this: String) @ret_param_0 true @deep true returns pointer[u8] linked
























    ; Returns raw buffer pointer for C interop (cast of get_buffer)
    function c_data(this: String) @ret_param_0 true @deep true returns pointer[const_char] linked


    function to_c_string(page, this: String) @ret_caller true @deep true returns pointer[const_char] linked

































    function get_length(this: String) @ret_nonlocal true @deep true returns size_t linked























    function get(this: String, index: size_t) @deep true returns u8 linked











    function length(this: String) @ret_nonlocal true @deep true returns size_t linked


    function substring(this: String, start: size_t, len: size_t) @page true @direct true @ret_caller true @deep true returns String linked


    function equals(this: String, other: String) @ret_nonlocal true @deep true returns bool linked






























    function equals(this: String, other: pointer[const_char]) @ret_nonlocal true @deep true returns bool linked






























    function equals (this: String, other: Vector[char]) @ret_nonlocal true @deep true returns bool linked
























    function hash(this: String) @ret_nonlocal true @deep true returns size_t linked



























    function get_iterator(this: String) @page true @direct true @deep true returns StringIterator linked


    ; Get a non-owning slice view of the string data
    function as_slice(this: String) @page true @direct true @ret_param_0 true @deep true returns Slice[u8] linked

























    ; Check if string contains a character
    function contains(this: String, c: u8) @ret_nonlocal true @deep true returns bool linked

















    ; Check if string contains a substring
    function contains(this: String, other: String) @ret_nonlocal true @deep true returns bool linked






















    ; Check if string starts with prefix
    function starts_with(this: String, prefix: String) @ret_nonlocal true @deep true returns bool linked














    ; Check if string starts with C string prefix
    function starts_with(this: String, prefix: pointer[const_char]) @ret_nonlocal true @deep true returns bool linked













    ; Check if string ends with suffix
    function ends_with(this: String, suffix: String) @ret_nonlocal true @deep true returns bool linked














    ; Check if string ends with C string suffix
    function ends_with(this: String, suffix: pointer[const_char]) @ret_nonlocal true @deep true returns bool linked













    ; Find first occurrence of character, returns -1 if not found
    function index_of(this: String, c: u8) @ret_param_0 true @deep true returns int linked

















    ; Find first occurrence of character starting at offset, returns -1 if not found
    function index_of(this: String, c: u8, start: size_t) @ret_param_0 true @deep true returns int linked




















    ; Find last occurrence of character, returns -1 if not found
    function last_index_of(this: String, c: u8) @ret_param_0 true @deep true returns int linked






















}
