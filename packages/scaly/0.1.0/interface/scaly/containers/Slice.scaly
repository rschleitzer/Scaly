; Slice[T] - Non-owning view into contiguous memory
; Zero allocation, zero copy - just pointer + length
; Lifetime bounded by source data
;
; NON-OWNING is the whole contract, and it is NOT the same as read-only:
; `put` below writes THROUGH the view into memory someone else owns, exactly
; as `set *(p + i): v` does at the sites this type replaces. What the type
; promises is that the buffer is not its own -- and three mechanisms in the
; compiler act on that promise BY NAME: the Planner excludes a Slice-returning
; construction from local-page promotion (operand_is_local_page_construction,
; because result_owns_page_guts cannot tell a borrow struct from an owning
; one) and carries Slice in its skip_dispatch list, and the Emitter
; deliberately gives Slice NO region-serialization walker where Vector, Array,
; Node and String have one -- emit_region_vector_body RELOCATES the data field
; on the assumption that it points into the region.
;
; That is also why `Vector[T](len, data)` is NOT the same thing even though the
; two records are now laid out identically: it is a Vector the compiler
; believes OWNS its buffer. Use Slice for a borrowed view, in both directions.
;
; The field order is {length, data}, the same as Vector's, since 2026-08-30.
; It diverged by accident and stayed that way because nothing checked a
; POSITIONAL construction: `Slice[T]` declares only `init ()`, so no init of
; arity 2 could ever match `Slice[T](n, p)` and flipping the list would have
; silently reversed all 309 of the tree's construction sites. The tuple path
; type-checks its components since the same day, so the flip was 2839
; diagnostics -- every site, both directions -- and not one silent reversal.

define Slice[T](length: size_t, data: pointer[T])
{

    ; Empty slice
    init ()
    {
        set data: null
        set length: 0
    }

    ; Get element at index (returns None if out of bounds)
    function get(this, index: size_t) returns ref[T]?
    {
        if index >= length
            return null

        data + index
    }


    ; Indexed access. See Array's operator[]: traps on a caller bug, while
    ; get(index) above is the lookup that may legitimately miss.
    operator [](index: size_t) returns T
    {
        if index >= length
            scaly_panic_oob("Slice[]", index, length)

        *(data + index)
    }

    ; The REFERENCE twin of operator[] — see `Array.at`, which carries the
    ; account. Here for symmetry rather than for a population: the borrow sites
    ; the ports have are on `Array`, and a view that cannot hand out a borrowed
    ; element while the array it was taken from can would be a hole in the one
    ; type whose whole contract is borrowing.
    ;
    ; A METHOD for the same load-bearing reason `put` is one: a generic
    ; concept's OPERATOR loses its result expression when its receiver is
    ; constructed in the calling routine (tools/opzero/scan.py), while an
    ; ordinary method is emitted for every instantiation and is correct there.
    function at(this, index: size_t) returns ref[T]
    {
        if index >= length
            scaly_panic_oob("Slice.at", index, length)

        data + index
    }

    ; Bounds-checked store THROUGH the view, into memory the Slice does not
    ; own. The write twin of operator[]: an index at or past length is a
    ; caller bug, so it traps rather than returning an ignorable failure.
    ;
    ; A METHOD, not an operator, and that is load-bearing: `set s[i]: v` is a
    ; hard rc-4 on a container (operator[] answers T BY VALUE, so there is no
    ; slot behind it), and a generic concept's OPERATOR additionally loses its
    ; result expression when its receiver is constructed in the calling
    ; routine -- an ordinary method is emitted for every instantiation and is
    ; correct in that very build (tools/opzero/scan.py).
    procedure put(mutable this, index: size_t, value: T)
    {
        if index >= length
            scaly_panic_oob("Slice.put", index, length)

        set *(data + index): value
    }

    ; Check if empty
    function is_empty(this) returns bool
        length = 0

    ; Create sub-slice (no allocation)
    function subslice(this, start: size_t, end: size_t) returns Slice[T]
    {
        var from start
        var to end
        if from > length
            set from: length

        if to > length
            set to: length

        if from > to
            set from: to

        Slice[T](to - from, data + from)
    }

    ; Slice from start
    function slice_from(this, from: size_t) returns Slice[T]
        subslice(from, length)

    ; Slice to end
    function slice_to(this, to: size_t) returns Slice[T]
        subslice(0, to)

    ; Equality (element-wise)
    function equals(this, other: Slice[T]) returns bool
    {
        if length <> other.length
            return false

        if length = 0
            return true

        memcmp(data as pointer[void], other.data as pointer[void], length * sizeof T) = 0
    }

    ; Bodies inlined from equals() as call-free byte loops: stage-1's
    ; planner resolves NO function call (sibling method or extern
    ; memcmp) from a generic concept's operator body, and since s185
    ; such an unresolvable call is a hard error instead of a silent
    ; drop. Only intrinsic ops (deref, +, <>) appear here. Use the
    ; no-else `if` (statement form) for the early-out — an `if`/`else`
    ; expression in a generic operator body breaks instantiation.
    operator ==(other: Slice[T]) returns bool
    {
        if length <> other.length
            return false
        let a_bytes data as pointer[u8]
        let b_bytes other.data as pointer[u8]
        let n length * sizeof T
        var i: size_t 0
        while i < n
        {
            if *(a_bytes + i) <> *(b_bytes + i)
                return false
            set i: i + 1
        }
        true
    }

    operator <>(other: Slice[T]) returns bool
    {
        if length <> other.length
            return true
        let a_bytes data as pointer[u8]
        let b_bytes other.data as pointer[u8]
        let n length * sizeof T
        var i: size_t 0
        while i < n
        {
            if *(a_bytes + i) <> *(b_bytes + i)
                return true
            set i: i + 1
        }
        false
    }

    ; Check if starts with prefix
    function starts_with(this, prefix: Slice[T]) returns bool
    {
        if prefix.length > length
            return false

        subslice(0, prefix.length) = prefix
    }

    ; Check if ends with suffix
    function ends_with(this, suffix: Slice[T]) returns bool
    {
        if suffix.length > length
            return false

        subslice(length - suffix.length, length) = suffix
    }

    ; Iterator support
    function get_iterator(this) returns SliceIterator[T]
        SliceIterator[T](this)
}

define SliceIterator[T](slice: Slice[T], position: size_t(0))
{
    init (s: Slice[T])
    {
        set slice: s
        set position: 0
    }

    procedure next(mutable this) returns pointer[T]
    {
        if position >= slice.length
            return null

        let result slice.data + position
        set position: position + 1
        result
    }
}

; allocate_slice[T]: n elements of T on `host`, as a borrowed view of them.
;
; The typed counterpart of the tree's own
; `Slice[T](n, host.allocate(n * sizeof T, alignof T) as pointer[T])`, and it is
; the shape that makes the `as pointer[T]` cast unavoidable: `Page.allocate`
; answers raw memory, so SOMETHING has to give it a type, and doing that at the
; call site is what puts a pointer there.  In here the cast stands ONCE.
;
; ★The hand-written spelling is COLLECTED -- `tools/allocslice_inline.py` reads
; zero over `packages/` since 2026-09-04, after 28 further sites (opensp 22,
; dazzle 4, and the tool's own two files).  The tool proves `B == L * sizeof T`
; and `A == alignof T` TEXTUALLY and leaves lying what it cannot prove; the
; arithmetic was then re-checked ON THE IR, pair by pair, where every converted
; allocation kept its exact `sizeof` constexpr and its alignment.
;
; ★★★THE ARGUMENT WAS NEVER A COUNT BUT AN ASYMMETRY: `Escape.scaly` and
; `Jit.scaly` call this function in the `init` and wrote the same allocation by
; hand in the REHASH of the same file.  CLAUDE.md calls that shape the proof
; and not the hint.
;
; ★★★AND THE REHASH IS WHERE THE ESCAPE CHECKER SPEAKS UP: `set m.keys:
; allocate_slice[u64](h, new_cap)` on a `m: ref[EsMap]` is refused -- *reference
; into a local page escapes via store* -- where the INLINE form was accepted,
; because `region_of_operand` reads the region straight off `h.allocate(...)`
; and a CALL hides it.  The annotation that restores exactly what the inline
; form said is `^h`, and the sigil is ANNOTATION ONLY here: this function's
; caller-page parameter is DEAD (rule 1 grants it for the construction below,
; whose value is materialised in a stack temp and returned by value), so every
; call site in the tree passes `ptr null` for it and `^h` and `#` emit the SAME
; call.  ★Prefer `^h` over `#` anyway: they are equal only while that parameter
; stays dead, and `h` is the page the buffer actually comes from, while the
; caller's page need not outlive the map at all.
;
; ★It answers a Slice and not a Vector deliberately: the PAGE owns the buffer,
; the view does not, which is exactly Slice's contract. A Vector here would be
; a container the compiler believes owns its storage -- see the header above.
;
; ★It is a generic FREE function, a shape that answered GARBAGE until
; 2026-09-04: T appears only in the RETURN type, so there is nothing to infer
; and `f[u64](...)`'s explicit list had to reach the resolver first
; (resolve_function_call_generic#). `tests/regress/generic_free_function.scaly`
; is the gate, and it checks two element widths because a folded `sizeof T`
; is right for a 64-bit one by accident.
function allocate_slice[T](host: ref[Page], n: size_t) returns Slice[T]
    Slice[T](n, host.allocate(n * sizeof T, alignof T) as pointer[T])
