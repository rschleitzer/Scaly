use scaly.containers.String
use scaly.memory.runtime
use scaly.fiber.Io

; C unistd constants
define F_OK: int 0

; The blocking metadata probes shipped to a worker thread (milestone
; 2.5 residual — stat-class calls block on disk like reads do). Each
; takes the NUL-terminated path (in the requester's region, alive while
; it parks) and returns a non-null sentinel for true/success — no
; result pages.
procedure dir_access_worker(arg: pointer[void]) @ret_nonlocal true @deep true returns pointer[void] io linked






procedure dir_isdir_worker(arg: pointer[void]) @ret_nonlocal true @deep true returns pointer[void] io linked








procedure dir_create_worker(arg: pointer[void]) @ret_nonlocal true @deep true returns pointer[void] io linked






procedure dir_remove_worker(arg: pointer[void]) @ret_nonlocal true @deep true returns pointer[void] io linked






define Directory
{
    ; Check if a path exists (file or directory). Colorless (milestone
    ; 2.5): offloads inside a task, blocks otherwise.
    procedure exists(mutable path: String) @deep true returns bool io linked







    ; Check if a path is a directory (not a file)
    procedure is_directory(mutable path: String) @deep true returns bool io linked












    procedure create(mutable path: String) @deep true returns bool io linked







    procedure remove(mutable path: String) @deep true returns bool io linked






}
