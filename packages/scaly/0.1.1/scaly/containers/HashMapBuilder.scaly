use scaly.memory.Page

define HashMapBuilder[K, V]
(
    var length: size_t (0)
    var slots: ref[Vector[List[Slot[KeyValuePair[K, V]]]]]? (null)
)
{
    init (vec: Vector[KeyValuePair[K, V]])
    {
        length := 0
        slots := null
        if vec.length > 0
        {
            reallocate vec.length
            var vector_iterator VectorIterator[KeyValuePair[K, V]](&vec)
            while let element vector_iterator.next()
                add_internal(element.key, element.value)
        }
    }

    procedure reallocate(mutable this: HashMapBuilder[K, V], size: size_t)
    {
        let hash_size hashing.get_prime size
        let own_page Page.get(this)
        let slots_page own_page.allocate_exclusive_page()
        let new_slots Vector[List[Slot[KeyValuePair[K, V]]]]^slots_page(hash_size)

        if slots <> null
        {
            var vector_iterator VectorIterator[List[Slot[KeyValuePair[K, V]]]](slots)
            while let element vector_iterator.next()
            {
                var list_iterator ListIterator[Slot[KeyValuePair[K, V]]](element.head)
                while let item list_iterator.next()
                {
                    let hash_code item.hash_code
                    let slot_number hash_code % new_slots.length
                    let slot_list new_slots.at slot_number
                    slot_list.add_on(slots_page, *item)
                }
            }
            own_page.deallocate_exclusive_page(Page.get(slots))
        }
        slots := new_slots
    }

    procedure add(mutable this: HashMapBuilder[K, V], key: K, value: V) returns bool
    {
        let hash_size hashing.get_prime(length + 1)
        if slots = null || hash_size > slots.length
            reallocate(length + 1)

        return add_internal(key, value)
    }

    procedure add_internal(mutable this: HashMapBuilder[K, V], key: K, value: V) returns bool
    {
        let hash_code key.hash()
        let slot_number hash_code % slots.length
        let slot_list slots.at slot_number
        var iterator slot_list.get_iterator()
        while let item iterator.next()
        {
            if key = item.value.key
                return false

        }

        let own_page Page.get(slots)
        slot_list.add_on(own_page, Slot[KeyValuePair[K, V]](KeyValuePair[K, V](key, value), hash_code))

        length := length + 1
        return true
    }

    procedure contains(mutable this: HashMapBuilder[K, V], key: K) returns bool
    {
        if slots = null
            return false

        let hash key.hash()
        let slot_number hash % slots.length
        let slot slots.at slot_number
        var iterator slot.get_iterator()
        while let item iterator.next()
        {
            if key = item.value.key
                return true

        }

        return false
    }

    procedure get(mutable this: HashMapBuilder[K, V], key: K) returns ref[V]?
    {
        if slots = null
            return null

        let slot slots.at(key.hash() % slots.length)
        var iterator slot.get_iterator()
        while let item iterator.next()
        {
            if key = item.value.key
                return &item.value.value

        }

        return null
    }

    ; Body inlined from get — same reason as HashMap's `[]`: an on-demand-
    ; planned operator body must not depend on sibling methods that are
    ; never instantiated (undefined at link).
    operator [](key: K) returns ref[V]?
    {
        if slots = null
            return null

        let slot slots.at(key.hash() % slots.length)
        var iterator slot.get_iterator()
        while let item iterator.next()
        {
            if key = item.value.key
                return &item.value.value

        }

        return null
    }
}
