define HashSet[T]
(
    slots: ref[Vector[Vector[T]]]? (null)
)
{
    init (hash_set_builder: HashSetBuilder[T])
    {
        if hash_set_builder.length = 0
        {
            slots := null
            return
        }

        slots := Vector[Vector[T]]^this(hash_set_builder.slots.length)
        var length hash_set_builder.slots.length
        var i: size_t 0
        while i < length
        {
            let slot_list hash_set_builder.slots.at i
            var array Array[T]()
            var list_iterator ListIterator[Slot[T]](slot_list.head)
            while let item list_iterator.next()
                array.add item.value

            if array.length > 0
                slots.put(i, Vector[T]^this(*array))

            i := i + 1
        }
    }

    function contains(this: HashSet[T], value: T) returns bool
    {
        if slots = null
            return false

        let hash value.hash()
        let slot_number hash % slots.length
        let slot slots.at slot_number
        let length slot.length
        var i: size_t 0
        while i < length
        {
            if value = slot[i]
                return true

            i := i + 1
        }

        return false
    }
}
