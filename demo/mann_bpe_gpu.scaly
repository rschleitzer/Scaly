; Stage-6 milestone 6.1: the BPE Thomas-Mann trainer on the GPU. Same
; model and data as demo/mann_bpe.scaly (identical lcg init stream, so
; the loss curves are directly comparable), but the tape's buffers are
; redirected into storage-mode-shared MTLBuffers (region = device
; buffer: unified memory, the CPU keeps reading/writing through the
; same pointers — set_token, value_at and sample cost zero copies) and
; each training step — forward, gradient zeroing, seed, backward, Adam
; — is encoded as ONE command buffer with a single commit + wait.
; The tape IS the graph: the encoder walk goes over the nodes in id
; order (reverse for backward).
;
; Env switches:
;   MGPU_SYNC=1     per-op-sync mode: only the matmuls run on the GPU,
;                   one command buffer + wait EACH, everything else CPU
;                   — the step-1 honesty measurement for launch-cost.
;   MGPU_MSL=1      whole-step, but matmuls through our own MSL 4x4
;                   kernels instead of MPS (single-encoder variant).
;   MGPU_BIG=1      the bigger model (D=512, T=256, F=2048, 4 layers).
;   MGPU_STEPS=n    step cap (smoke tests).
;   MGPU_BUDGET=s   training budget in seconds (default 180).
;   MGPU_CKPT=path  weights checkpoint: load + skip training when the
;                   file exists (config-validated header), save after
;                   training otherwise. Weights only, no Adam moments.
;   MGPU_PROMPT=txt generate from this prompt (greedy longest-match
;                   BPE tokenization against the vocab).
;   MGPU_GEN=n      tokens to generate (default 120).
;   MGPU_TEMP=pct   sampling temperature in percent (default 80).
; Run via demo/run_bpe_gpu.sh (pins the cwd; SKIPs off macOS) or
; demo/showcase_gpu.sh (train once, then prompt-driven generation).

function scaly_eio_now_ns() returns i64 extern
function exit(code: int) extern
function powf(x: float, y: float) returns float extern
function getenv(name: pointer[const_char]) returns pointer[const_char] extern
function fopen(filename: pointer[const_char], mode: pointer[const_char]) returns pointer[void] extern
function fclose(stream: pointer[void]) returns int extern
function fread(ptr: pointer[void], size: size_t, count: size_t, stream: pointer[void]) returns size_t extern
function fwrite(ptr: pointer[void], size: size_t, count: size_t, stream: pointer[void]) returns size_t extern

function scaly_mgpu_available() returns i32 extern
function scaly_mgpu_init() returns i32 extern
function scaly_mgpu_ops_init() returns i32 extern
function scaly_mgpu_slots_init(n: i32) returns i32 extern
function scaly_mgpu_slot_alloc(slot: i32, bytes: size_t) returns i32 extern
function scaly_mgpu_slot_contents(slot: i32) returns pointer[void] extern
procedure scaly_mgpu_slot_write(slot: i32, src: pointer[void], bytes: size_t) extern
function scaly_mgpu_begin() returns i32 extern
function scaly_mgpu_commit_wait() returns i32 extern
procedure scaly_mgpu_ms_reset() extern
function scaly_mgpu_ms_sum() returns double extern
procedure scaly_mgpu_enc_gemm(a: i32, b: i32, c: i32, arows: i32, acols: i32, brows: i32, bcols: i32, ta: i32, tb: i32, alpha: float, beta: float) extern
procedure scaly_mgpu_enc_mm_nn(a: i32, b: i32, c: i32, m: i32, k: i32, n: i32) extern
procedure scaly_mgpu_enc_mm_nt_acc(dc: i32, b: i32, da: i32, m: i32, k: i32, n: i32) extern
procedure scaly_mgpu_enc_mm_tn_acc(a: i32, dc: i32, db: i32, m: i32, k: i32, n: i32) extern
