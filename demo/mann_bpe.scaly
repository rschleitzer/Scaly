; Stage-6 bridge demo: a bigger char/subword transformer on the FULL
; public-domain Thomas Mann corpus, tokenized with BPE (demo/bpe.scaly
; wrote demo/build/bpe_vocab.txt + bpe_tokens.txt). Same pure-Scaly
; tape as the char demo, just resized — this measures how far the
; CPU path carries a real-token model in a few-minutes budget, and is
; the baseline stage 6's GPU lowering must beat.
; Run via demo/run_bpe.sh (pins the cwd; builds the -O2 archive).

function scaly_eio_now_ns() returns i64 extern
function exit(code: int) extern

function pmod(v: int, m: int) returns int
{
    let q v / m
    v - q * m
}

function lcg(s: int) returns int
    pmod(s * 1103515245 + 12345, 2147483648)

function num_to_string(n: i64) returns String
{
    if n = 0
        return "0"
    var value n
    var digits Array[char]()
    while value > 0
    {
        let digit ((value % 10) as char) + (48 as char)
        digits.add digit
        value := value / 10
    }
    var sb StringBuilder()
    var i digits.length
    while i > 0
    {
        i := i - 1
        let d digits.get i
        if d <> null
            sb.append(*d)
    }
    sb.to_string()
}

function fixed3(f: float) returns String
{
    var ok false
    if f >= 0.0
        if f < 100000.0
            ok := true
    if ok = false
        return "nan"
    let m ((f * 1000.0) + 0.5) as int
    let ip m / 1000
    let fr m - ip * 1000
    var sb StringBuilder()
    let istr num_to_string(ip as i64)
    sb.append istr
    sb.append "."
    if fr < 100
        sb.append "0"
    if fr < 10
        sb.append "0"
    let fstr num_to_string(fr as i64)
    sb.append fstr
    sb.to_string()
}

function secs_to_string(ns: i64) returns String
{
    let cs ns / 10000000
    let ip cs / 100
    let fr cs - ip * 100
    var sb StringBuilder()
    let istr num_to_string(ip)
    sb.append istr
    sb.append "."
    if fr < 10
        sb.append "0"
    let fstr num_to_string(fr)
    sb.append fstr
    sb.to_string()
}

function hexval(b: int) returns int
{
    if b >= 48
        if b <= 57
            return b - 48
    if b >= 97
        if b <= 102
            return b - 87
    0
}

procedure fill(mutable tape: Tape, id: int, count: int, s0: int) returns int
{
    var s s0
    var i 0
    while i < count
    {
        s := lcg(s)
        let r pmod(s, 2001) - 1000
        let rv (r as float) * 0.0001
        tape.set_value(id, i, rv)
        i := i + 1
    }
    s
}

procedure fill_const(mutable tape: Tape, id: int, count: int, v: float)
{
    var i 0
    while i < count
    {
        tape.set_value(id, i, v)
        i := i + 1
    }
}

; --- load the vocab: one token per line, hex of its UTF-8 bytes.
; vb[id] = byte-offset into vbuf, vl[id] = byte length ---
let vpath String("demo/build/bpe_vocab.txt")
let vtext File.read_to_string(vpath)
let vlen vtext.get_length() as int
if vlen < 100
{
    print("error: demo/build/bpe_vocab.txt missing - run demo/run_bpe.sh\n")
    exit(1)
}
let vtb vtext.get_buffer() as pointer[u8]
var vbufoff Vector[int](4096)
var vbuflen Vector[int](4096)
var vbuf Vector[int](65536)
let vb vbufoff.data
let vl vbuflen.data
let vf vbuf.data
var V 0
var vused 0
var vp 0
while vp < vlen
{
    vb[V] := vused
    var n 0
    while vp < vlen
    {
        if vtb[vp] as int = 10
            break
        let hi hexval(vtb[vp] as int)
        let lo hexval(vtb[vp + 1] as int)
        vf[vused] := hi * 16 + lo
        vused := vused + 1
        n := n + 1
        vp := vp + 2
    }
    vl[V] := n
    V := V + 1
    vp := vp + 1        ; skip the newline
}

; --- load the token stream: decimal ids, space-separated ---
let tpath String("demo/build/bpe_tokens.txt")
let ttext File.read_to_string(tpath)
let ttlen ttext.get_length() as int
let ttb ttext.get_buffer() as pointer[u8]
var toks Vector[i64](2000000)
let tp toks.data
var ntok 0
var ti2 0
while ti2 < ttlen
{
    let b ttb[ti2] as int
    if b >= 48
    {
        if b <= 57
        {
            var v 0
            while ti2 < ttlen
            {
                let b2 ttb[ti2] as int
                if b2 < 48
                    break
                if b2 > 57
                    break
                v := v * 10 + (b2 - 48)
                ti2 := ti2 + 1
            }
            tp[ntok] := v as i64
            ntok := ntok + 1
        }
        else
            ti2 := ti2 + 1
    }
    else
        ti2 := ti2 + 1
}
if ntok < 1000
{
    print("error: token stream too small\n")
    exit(1)
}

; --- model (bigger than the char demo) ---
let D 256
let T 128
let F 512
let HEADS 8
let B 8                          ; windows per step (batching)
let TT B * T                     ; total rows fed per step
let STEPS 200000
let PROG 20
let BUDGET_NS 180000000000       ; ~3 min training cap
var tape Tape()
let table tape.leaf(V, D)
let posemb tape.leaf(T, D)
; layer 1
let g1a tape.leaf(1, D)
let b1a tape.leaf(1, D)
let wq1 tape.leaf(D, D)
let wk1 tape.leaf(D, D)
let wv1 tape.leaf(D, D)
let wo1 tape.leaf(D, D)
let g1b tape.leaf(1, D)
let b1b tape.leaf(1, D)
let wf1 tape.leaf(D, F)
let wp1 tape.leaf(F, D)
; layer 2
let g2a tape.leaf(1, D)
let b2a tape.leaf(1, D)
let wq2 tape.leaf(D, D)
let wk2 tape.leaf(D, D)
let wv2 tape.leaf(D, D)
let wo2 tape.leaf(D, D)
let g2b tape.leaf(1, D)
let b2b tape.leaf(1, D)
let wf2 tape.leaf(D, F)
let wp2 tape.leaf(F, D)
; head
let gf tape.leaf(1, D)
let bf tape.leaf(1, D)
let whead tape.leaf(D, V)

var s 42
s := fill(tape, table, V * D, s)
s := fill(tape, posemb, T * D, s)
s := fill(tape, wq1, D * D, s)
s := fill(tape, wk1, D * D, s)
s := fill(tape, wv1, D * D, s)
s := fill(tape, wo1, D * D, s)
s := fill(tape, wf1, D * F, s)
s := fill(tape, wp1, F * D, s)
s := fill(tape, wq2, D * D, s)
s := fill(tape, wk2, D * D, s)
s := fill(tape, wv2, D * D, s)
s := fill(tape, wo2, D * D, s)
s := fill(tape, wf2, D * F, s)
s := fill(tape, wp2, F * D, s)
s := fill(tape, whead, D * V, s)
fill_const(tape, g1a, D, 1.0)
fill_const(tape, g1b, D, 1.0)
fill_const(tape, g2a, D, 1.0)
fill_const(tape, g2b, D, 1.0)
fill_const(tape, gf, D, 1.0)

; --- graph: B windows of T tokens (TT rows), mutated in place per
; step. Attention is windowed (per T-row window, no cross-window
; leakage); positional embeddings broadcast across the B windows. ---
let bsz TT as size_t
var ids Vector[i64](bsz)
let emb tape.embedding(table, ids, TT)
let x0 tape.add_bcast(emb, posemb)
; layer 1
let n1a tape.layernorm(x0, g1a, b1a, 0.00001)
let q1 tape.matmul(n1a, wq1)
let k1 tape.matmul(n1a, wk1)
let v1 tape.matmul(n1a, wv1)
let at1 tape.attention_windowed(q1, k1, v1, HEADS, T)
let o1 tape.matmul(at1, wo1)
let x1 tape.add(x0, o1)
let n1b tape.layernorm(x1, g1b, b1b, 0.00001)
let h1 tape.matmul(n1b, wf1)
let e1 tape.gelu(h1)
let m1 tape.matmul(e1, wp1)
let x2 tape.add(x1, m1)
; layer 2
let n2a tape.layernorm(x2, g2a, b2a, 0.00001)
let q2 tape.matmul(n2a, wq2)
let k2 tape.matmul(n2a, wk2)
let v2 tape.matmul(n2a, wv2)
let at2 tape.attention_windowed(q2, k2, v2, HEADS, T)
let o2 tape.matmul(at2, wo2)
let x3 tape.add(x2, o2)
let n2b tape.layernorm(x3, g2b, b2b, 0.00001)
let h2 tape.matmul(n2b, wf2)
let e2 tape.gelu(h2)
let m2 tape.matmul(e2, wp2)
let x4 tape.add(x3, m2)
; head
let nf tape.layernorm(x4, gf, bf, 0.00001)
let logits tape.matmul(nf, whead)
var tgs Vector[i64](bsz)
let loss tape.crossentropy(logits, tgs)

; --- trainable leaves ---
let NPARAM 25
var pids Vector[int](25)
pids.put(0, table)
pids.put(1, posemb)
pids.put(2, g1a)
pids.put(3, b1a)
pids.put(4, wq1)
pids.put(5, wk1)
pids.put(6, wv1)
pids.put(7, wo1)
pids.put(8, g1b)
pids.put(9, b1b)
pids.put(10, wf1)
pids.put(11, wp1)
pids.put(12, g2a)
pids.put(13, b2a)
pids.put(14, wq2)
pids.put(15, wk2)
pids.put(16, wv2)
pids.put(17, wo2)
pids.put(18, g2b)
pids.put(19, b2b)
pids.put(20, wf2)
pids.put(21, wp2)
pids.put(22, gf)
pids.put(23, bf)
pids.put(24, whead)
let pp pids.data

var hdr StringBuilder()
hdr.append "scaly mann-bpe demo: V="
let vs num_to_string(V as i64)
hdr.append vs
hdr.append " tokens, "
let nts num_to_string(ntok as i64)
hdr.append nts
hdr.append " corpus tokens, 2-layer T="
let ts num_to_string(T as i64)
hdr.append ts
hdr.append " D="
let ds num_to_string(D as i64)
hdr.append ds
hdr.append " F="
let fs num_to_string(F as i64)
hdr.append fs
hdr.append " heads="
let hs num_to_string(HEADS as i64)
hdr.append hs
let hline hdr.to_string()
Console.println(hline.to_c_string())

; --- train: Adam over random corpus windows, ~3 min budget ---
let train_t0 scaly_eio_now_ns()
var win_t0 train_t0
var win_sum: float 0.0
var done_steps 0
var step 1
while step <= STEPS
{
    var bb 0
    while bb < B
    {
        s := lcg(s)
        let p pmod(s, ntok - T - 1)
        var t 0
        while t < T
        {
            tape.set_token(emb, bb * T + t, tp[p + t])
            tape.set_token(loss, bb * T + t, tp[p + t + 1])
            t := t + 1
        }
        bb := bb + 1
    }
    tape.recompute()
    win_sum := win_sum + tape.value_at(loss, 0)
    tape.zero_grads()
    tape.backward loss
    var lr: float 0.0005
    if step * 4 > STEPS * 3
        lr := 0.0002
    var pi 0
    while pi < NPARAM
    {
        tape.adam_step(pp[pi], lr, 0.9, 0.999, 0.00000001, step)
        pi := pi + 1
    }
    done_steps := step
    if pmod(step, PROG) = 0
    {
        let now scaly_eio_now_ns()
        let ns now - win_t0
        var sps 0 as i64
        if ns > 0
            sps := ((PROG as i64) * 1000000000) / ns
        var sb StringBuilder()
        sb.append "step "
        let ss num_to_string(step as i64)
        sb.append ss
        sb.append "  loss "
        let avg win_sum / (PROG as float)
        let ls fixed3(avg)
        sb.append ls
        sb.append "  "
        let sp num_to_string(sps)
        sb.append sp
        sb.append " steps/s  "
        let el secs_to_string(now - train_t0)
        sb.append el
        sb.append " s"
        let line sb.to_string()
        Console.println(line.to_c_string())
        win_sum := 0.0
        win_t0 := now
        if now - train_t0 > BUDGET_NS
            step := STEPS
    }
    step := step + 1
}
let train_t1 scaly_eio_now_ns()
var tr StringBuilder()
tr.append "training done: "
let dss num_to_string(done_steps as i64)
tr.append dss
tr.append " steps in "
let trs secs_to_string(train_t1 - train_t0)
tr.append trs
tr.append " s"
let trline tr.to_string()
Console.println(trline.to_c_string())

; --- inference: extend a corpus prompt autoregressively ---
let P 24
let GEN 120
var hist Vector[i64]((P + GEN) as size_t)
let hp hist.data
var hi 0
while hi < P
{
    hp[hi] := tp[100 + hi]
    hi := hi + 1
}
let gen_t0 scaly_eio_now_ns()
var hlen P
while hlen < P + GEN
{
    var vis hlen
    if vis > T
        vis := T
    let start hlen - vis
    var t2 0
    while t2 < vis
    {
        tape.set_token(emb, t2, hp[start + t2])
        t2 := t2 + 1
    }
    tape.recompute()
    s := lcg(s)
    let u (pmod(s, 10000) as float) * 0.0001
    var pick tape.sample(logits, vis - 1, 0.8, u)
    if pick < 0
        pick := 0
    if pick >= V
        pick := 0
    hp[hlen] := pick as i64
    hlen := hlen + 1
}
let gen_t1 scaly_eio_now_ns()

; --- detokenize: replay each token's recorded UTF-8 bytes ---
var out StringBuilder()
out.append "["
var oi 0
while oi < P + GEN
{
    if oi = P
        out.append "]"
    let id hp[oi] as int
    var k 0
    while k < vl[id]
    {
        out.append(vf[vb[id] + k] as char)
        k := k + 1
    }
    oi := oi + 1
}
let text_out out.to_string()
Console.println("------------------------------------------------------------")
Console.println(text_out.to_c_string())
Console.println("------------------------------------------------------------")
var gl StringBuilder()
let gs num_to_string(GEN as i64)
gl.append gs
gl.append " tokens generated in "
let gts secs_to_string(gen_t1 - gen_t0)
gl.append gts
gl.append " s (temperature 0.8, prompt in brackets)"
let gline gl.to_string()
Console.println(gline.to_c_string())
