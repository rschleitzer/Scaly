; The circle learned with matrices (Machine Learning with Scaly, chapter 2,
; "Many Points at Once"):
; the network of the field's `field 0 500` -- the inputs x and y, hidden
; layers of four and two neurons, tanh, the output tanh, learning rate
; 0.03 -- on the same points from the same starting weights, but every
; layer computed for all points at once. It prints what `field 0 500`
; prints, digit for digit: the computation is the same, only arranged in
; matrices.

; --- numbers: the field's random numbers (xorshift), in the field's order --

mutable seed: u64 88172645463325252

procedure random() returns f64 mutable seed
{
    var x seed
    x := x xor (x << 13)
    x := x xor (x >> 7)
    x := x xor (x << 17)
    seed := x
    let top (x >> 11) as f64
    top / 9007199254740992.0
}

procedure between(a: f64, b: f64) returns f64 mutable seed
{
    let r random()
    a + (b - a) * r
}

; --- matrices ---------------------------------------------------------------

; A matrix: its numbers row by row, the one in row i and column j at
; i * cols + j.
define Matrix(rows: int, cols: int, data: Vector[f64])
{
    function at(this, i: int, j: int) returns f64
        this.data[i * this.cols + j]

    procedure put(mutable this, i: int, j: int, v: f64)
        this.data.put(i * this.cols + j, v)
}

function zeros(rows: int, cols: int) returns Matrix
{
    var data Vector[f64]#(rows * cols)
    for k in rows * cols
        data.put(k, 0.0)
    Matrix(rows, cols, data)
}

; A layer for all points at once, tanh(X W + b): row i of X is a point's
; inputs, column j of W the weights of neuron j, b its biases. Each sum
; begins with its bias, as in the field.
function layer(x: Matrix, w: Matrix, b: Matrix) returns Matrix
{
    var a zeros(x.rows, w.cols)
    for i in x.rows
    {
        var j 0
        while j < w.cols
        {
            var z b.at(0, j)
            var k 0
            while k < x.cols
            {
                z := z + w.at(k, j) * x.at(i, k)
                k := k + 1
            }
            a.put(i, j, tanh(z))
            j := j + 1
        }
    }
    a
}

; Half the squared error of every point, averaged.
function loss(a: Matrix, t: Matrix) returns f64
{
    var sum 0.0
    var i 0
    while i < a.rows
    {
        let e a.at(i, 0) - t.at(i, 0)
        sum := sum + 0.5 * e * e
        i := i + 1
    }
    sum / (a.rows as f64)
}

; The output's share of the error, point by point: (a - t)(1 - a²).
function out_share(a: Matrix, t: Matrix) returns Matrix
{
    var d zeros(a.rows, 1)
    for i in a.rows
    {
        let o a.at(i, 0)
        d.put(i, 0, (o - t.at(i, 0)) * (1.0 - o * o))
    }
    d
}

; The shares of the layer below: D Wᵀ, and each times its slope 1 - h².
function back(d: Matrix, w: Matrix, h: Matrix) returns Matrix
{
    var below zeros(d.rows, w.rows)
    for i in d.rows
    {
        var k 0
        while k < w.rows
        {
            var s 0.0
            var j 0
            while j < w.cols
            {
                s := s + d.at(i, j) * w.at(k, j)
                j := j + 1
            }
            let out h.at(i, k)
            below.put(i, k, s * (1.0 - out * out))
            k := k + 1
        }
    }
    below
}

; The weights' gradient, summed over the points: Hᵀ D.
function weight_grad(h: Matrix, d: Matrix) returns Matrix
{
    var g zeros(h.cols, d.cols)
    for k in h.cols
    {
        var j 0
        while j < d.cols
        {
            var s 0.0
            var i 0
            while i < d.rows
            {
                s := s + d.at(i, j) * h.at(i, k)
                i := i + 1
            }
            g.put(k, j, s)
            j := j + 1
        }
    }
    g
}

; The biases' gradient, summed over the points.
function bias_grad(d: Matrix) returns Matrix
{
    var g zeros(1, d.cols)
    for j in d.cols
    {
        var s 0.0
        var i 0
        while i < d.rows
        {
            s := s + d.at(i, j)
            i := i + 1
        }
        g.put(0, j, s)
    }
    g
}

; Each number moved against its gradient, the gradient averaged over the
; points.
procedure descend(mutable w: Matrix, g: Matrix, rate: f64, points: int)
{
    var k 0
    while k < w.rows * w.cols
    {
        w.data.put(k, w.data[k] - rate * (g.data[k] / (points as f64)))
        k := k + 1
    }
}

; --- the network ------------------------------------------------------------

define Net(w1: Matrix, b1: Matrix, w2: Matrix, b2: Matrix, w3: Matrix, b3: Matrix)

; The output for all the points of x.
function answer(net: Net, x: Matrix) returns Matrix
    layer(layer(layer(x, net.w1, net.b1), net.w2, net.b2), net.w3, net.b3)

; One step of gradient descent over all the points of x at once.
procedure step(mutable net: Net, x: Matrix, t: Matrix, rate: f64)
{
    ; forward, layer by layer
    let h1 layer(x, net.w1, net.b1)
    let h2 layer(h1, net.w2, net.b2)
    let a layer(h2, net.w3, net.b3)
    ; backward, layer by layer
    let d3 out_share(a, t)
    let d2 back(d3, net.w3, h2)
    let d1 back(d2, net.w2, h1)
    ; every weight a little against its gradient
    descend(net.w3, weight_grad(h2, d3), rate, x.rows)
    descend(net.b3, bias_grad(d3), rate, x.rows)
    descend(net.w2, weight_grad(h1, d2), rate, x.rows)
    descend(net.b2, bias_grad(d2), rate, x.rows)
    descend(net.w1, weight_grad(x, d1), rate, x.rows)
    descend(net.b1, bias_grad(d1), rate, x.rows)
}

; The losses on the training and on the test points. A procedure of its
; own: the answers it computes lie on its page and go with it.
procedure report(step: int, net: Net, x: Matrix, t: Matrix, tx: Matrix, tt: Matrix)
{
    print "step `step` train `loss(answer(net, x), t)` test `loss(answer(net, tx), tt)`"
}

; --- the run ----------------------------------------------------------------

; The starting weights as the field draws them: it keeps a network of up to
; seven layers of eight neurons, each layer's weights in 8 x 8 places (a row
; for each neuron, i, its inputs along it, m) and then 8 biases, and draws a
; number between -0.5 and 0.5 for every place in that order; a bias is 0.1.
; Ours takes the numbers of the places it has, weight m of neuron i at row
; m and column i.
var net Net(zeros(2, 4), zeros(1, 4), zeros(4, 2), zeros(1, 2), zeros(2, 1), zeros(1, 1))
var place 0
while place < 7 * 72
{
    let r between(0.0 - 0.5, 0.5)
    let block place / 72
    let at place % 72
    let i at / 8
    let m at % 8
    if at < 64
    {
        if block = 0 and i < 4 and m < 2
            net.w1.put(m, i, r)
        if block = 1 and i < 2 and m < 4
            net.w2.put(m, i, r)
        if block = 2 and i < 1 and m < 2
            net.w3.put(m, i, r)
    }
    else
    {
        if block = 0 and at - 64 < 4
            net.b1.put(0, at - 64, 0.1)
        if block = 1 and at - 64 < 2
            net.b2.put(0, at - 64, 0.1)
        if block = 2 and at - 64 < 1
            net.b3.put(0, at - 64, 0.1)
    }
    place := place + 1
}

; 400 points of the circle, the field's way: of each four the first two
; orange (+1) inside a radius of 2.5, the others blue (-1) in the ring from
; 3.5 to 5; of each two the second a test point.
var x zeros(200, 2)
var t zeros(200, 1)
var tx zeros(200, 2)
var tt zeros(200, 1)
var p 0
while p < 400
{
    let kind if (p / 2) % 2 = 0: 1.0 else 0.0 - 1.0
    let r if kind > 0.0: between(0.0, 2.5) else between(3.5, 5.0)
    let angle between(0.0, 6.283185307179586)
    ; the field draws noise for each point too, here none
    between(0.0 - 5.0, 5.0)
    between(0.0 - 5.0, 5.0)
    if p % 2 = 0
    {
        x.put(p / 2, 0, r * sin(angle))
        x.put(p / 2, 1, r * cos(angle))
        t.put(p / 2, 0, kind)
    }
    else
    {
        tx.put(p / 2, 0, r * sin(angle))
        tx.put(p / 2, 1, r * cos(angle))
        tt.put(p / 2, 0, kind)
    }
    p := p + 1
}

var s 0
while s <= 500
{
    if s % 100 = 0
        report(s, net, x, t, tx, tt)
    step(net, x, t, 0.03)
    s := s + 1
}
let out answer(net, tx)
var right 0
p := 0
while p < 200
{
    if out.at(p, 0) * tt.at(p, 0) > 0.0
        right := right + 1
    p := p + 1
}
print "test right `right` of 200"
