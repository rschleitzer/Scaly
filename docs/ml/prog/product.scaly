; The matrix product C = A B for square matrices of sizes 64 to 2048
; (Machine Learning with Scaly, chapter 2, "Fast"): how long one product
; takes. A round of the `for` makes one number of C, row i of A times
; column j of B; the numbers are f32, which a graphics card computes.
;
;   scaly build --release --gpu product.scaly -o product
;   ./product                              (Scaly decides where it runs)
;   SCALY_GPU=off ./product                (the processor's cores)
;   SCALY_GPU=off SCALY_WORKERS=1 ./product   (one core)
;   SCALY_GPU=on ./product                 (the card)

function product(A: Vector[f32], B: Vector[f32], n: int) returns Vector[f32]
{
    var C Vector[f32]#((n * n) as size_t)
    for t in n * n
    {
        let i t / n
        let j t % n
        var s: f32 0.0
        var k 0
        while k < n
        {
            let a A[(i * n + k) as size_t]
            s := s + a * B[(k * n + j) as size_t]
            k := k + 1
        }
        C.put(t as size_t, s)
    }
    C
}

; One product; its matrix goes with the call.
procedure once(A: Vector[f32], B: Vector[f32], n: int) returns f32
{
    let C product(A, B, n)
    C[0 as size_t]
}

procedure measure(n: int)
{
    var A Vector[f32]((n * n) as size_t)
    var B Vector[f32]((n * n) as size_t)
    for t in n * n
    {
        A.put(t as size_t, ((t % 7) as f32) * 0.25)
        B.put(t as size_t, ((t % 5) as f32) * 0.5)
    }
    ; once to warm up, then as often as fits in about a second
    once(A, B, n)
    var times 0
    let begun scaly_eio_now_ns()
    var spent: i64 0
    var check: f32 0.0
    while times = 0 or spent < 1000000000
    {
        check := once(A, B, n)
        times := times + 1
        spent := scaly_eio_now_ns() - begun
    }
    let micros spent / 1000 / (times as i64)
    print "`n` `micros` us (`times` runs, c[0] `check as f64`)"
}

measure(64)
measure(128)
measure(256)
measure(512)
measure(1024)
measure(2048)
