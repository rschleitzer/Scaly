; The circle learned with a tape and ReLU (Machine Learning with Scaly,
; chapter 4, "The Tape"): tape.scaly with ReLU in place of tanh in the
; hidden layers -- a function and its rule more, two words changed in the
; step. The output stays tanh. It prints what the field's own program
; prints for it (`field relu 0 3000`) up to the last digit or two of a loss
; and gets the same test points right.

; --- numbers: the field's random numbers (xorshift), in the field's order --

mutable seed: u64 88172645463325252

procedure random() returns f64 mutable seed
{
    var x seed
    x := x xor (x << 13)
    x := x xor (x >> 7)
    x := x xor (x << 17)
    seed := x
    let top (x >> 11) as f64
    top / 9007199254740992.0
}

procedure between(a: f64, b: f64) returns f64 mutable seed
{
    let r random()
    a + (b - a) * r
}

; --- matrices ---------------------------------------------------------------

; A matrix: its numbers row by row, the one in row i and column j at
; i * cols + j.
define Matrix(rows: int, cols: int, data: Vector[f64])
{
    function at(this, i: int, j: int) returns f64
        this.data[i * this.cols + j]

    procedure put(mutable this, i: int, j: int, v: f64)
        this.data.put(i * this.cols + j, v)
}

function zeros(rows: int, cols: int) returns Matrix
{
    var data Vector[f64]#(rows * cols)
    for k in rows * cols
        data.put(k, 0.0)
    Matrix(rows, cols, data)
}

; --- the tape ---------------------------------------------------------------

define LEAF: int 0
define TIMES: int 1
define PLUS: int 2
define TANH: int 3
define LOSS: int 4
define RELU: int 5

; An entry of the tape: how its value came about -- its kind and the
; entries it was computed from --, the value, and the derivative of the
; loss by each of its numbers, filled in on the way back.
define Entry(kind: int, a: ref[Entry]?, b: ref[Entry]?, value: Matrix,
             var grad: Matrix, var seen: bool)

; A value of the step: its entry on the tape. The entries lie on the page
; of the step that computes them, and go with it.
define Value(at: ref[Entry])
{
    operator *(this, other: Value) returns Value
    {
        let m product(this.at.value, other.at.value)
        Value(&# Entry(TIMES, this.at, other.at, m, zeros(m.rows, m.cols), false))
    }

    operator +(this, other: Value) returns Value
    {
        let m plus(this.at.value, other.at.value)
        Value(&# Entry(PLUS, this.at, other.at, m, zeros(m.rows, m.cols), false))
    }
}

; A matrix the computation starts from: the points, or the weights.
function leaf(m: Matrix) returns Value
    Value(&# Entry(LEAF, null, null, m, zeros(m.rows, m.cols), false))

function tanh(x: Value) returns Value
{
    let m apply_tanh(x.at.value)
    Value(&# Entry(TANH, x.at, null, m, zeros(m.rows, m.cols), false))
}

function relu(x: Value) returns Value
{
    let m apply_relu(x.at.value)
    Value(&# Entry(RELU, x.at, null, m, zeros(m.rows, m.cols), false))
}

function loss(a: Value, t: Value) returns Value
{
    var m zeros(1, 1)
    m.put(0, 0, mean_half_square(a.at.value, t.at.value))
    Value(&# Entry(LOSS, a.at, t.at, m, zeros(1, 1), false))
}

function product(A: Matrix, B: Matrix) returns Matrix
{
    var C zeros(A.rows, B.cols)
    for i in A.rows
    {
        var j 0
        while j < C.cols
        {
            var s 0.0
            var k 0
            while k < A.cols
            {
                s := s + A.at(i, k) * B.at(k, j)
                k := k + 1
            }
            C.put(i, j, s)
            j := j + 1
        }
    }
    C
}

; A + B, B of the same shape or one row added to every row of A.
function plus(A: Matrix, B: Matrix) returns Matrix
{
    var C zeros(A.rows, A.cols)
    for i in C.rows
    {
        let bi if B.rows = 1: 0 else i
        var j 0
        while j < C.cols
        {
            C.put(i, j, A.at(i, j) + B.at(bi, j))
            j := j + 1
        }
    }
    C
}

function apply_tanh(A: Matrix) returns Matrix
{
    var C zeros(A.rows, A.cols)
    for k in A.rows * A.cols
        C.data.put(k, tanh(A.data[k]))
    C
}

function apply_relu(A: Matrix) returns Matrix
{
    var C zeros(A.rows, A.cols)
    for k in A.rows * A.cols
    {
        let z A.data[k]
        C.data.put(k, if z > 0.0: z else 0.0)
    }
    C
}

function mean_half_square(A: Matrix, T: Matrix) returns f64
{
    var sum 0.0
    var i 0
    while i < A.rows
    {
        let e A.at(i, 0) - T.at(i, 0)
        sum := sum + 0.5 * e * e
        i := i + 1
    }
    sum / (A.rows as f64)
}

; --- the way back -----------------------------------------------------------

; The tape: every entry the loss was computed from, each after the entries
; it was computed from.
procedure order(mutable e: ref[Entry], mutable tape: Array[ref[Entry]])
{
    if e.seen
        return
    e.seen := true
    let a e.a
    if a <> null
        order(a, tape)
    let b e.b
    if b <> null
        order(b, tape)
    tape.add(e)
}

procedure backward(mutable loss: Value)
{
    var tape Array[ref[Entry]]()
    order(loss.at, tape)
    loss.at.grad.put(0, 0, 1.0)
    var k tape.length
    while k > 0
    {
        k := k - 1
        back(tape[k])
    }
}

; One entry's derivative handed to the entries it was computed from, by
; the rule of its kind.
procedure back(mutable e: ref[Entry])
{
    let a e.a
    if a = null
        return
    if e.kind = TANH
        back_tanh(e.value, e.grad, a)
    if e.kind = RELU
        back_relu(e.value, e.grad, a)
    let b e.b
    if b = null
        return
    if e.kind = TIMES
        back_times(e.grad, a, b)
    if e.kind = PLUS
        back_plus(e.grad, a, b)
    if e.kind = LOSS
        back_loss(e.grad, a, b)
}

; C = A B: G_A += G_C Bᵀ, G_B += Aᵀ G_C
procedure back_times(G: Matrix, mutable a: ref[Entry], mutable b: ref[Entry])
{
    let A a.value
    let B b.value
    for i in A.rows
    {
        var k 0
        while k < A.cols
        {
            var s 0.0
            var j 0
            while j < B.cols
            {
                s := s + G.at(i, j) * B.at(k, j)
                j := j + 1
            }
            a.grad.put(i, k, a.grad.at(i, k) + s)
            k := k + 1
        }
    }
    for k in B.rows
    {
        var j 0
        while j < B.cols
        {
            var s 0.0
            var i 0
            while i < A.rows
            {
                s := s + A.at(i, k) * G.at(i, j)
                i := i + 1
            }
            b.grad.put(k, j, b.grad.at(k, j) + s)
            j := j + 1
        }
    }
}

; C = A + B: G_A += G_C, G_B += G_C -- summed over the rows where B is one
; row added to every row
procedure back_plus(G: Matrix, mutable a: ref[Entry], mutable b: ref[Entry])
{
    for i in G.rows
    {
        let bi if b.value.rows = 1: 0 else i
        var j 0
        while j < G.cols
        {
            a.grad.put(i, j, a.grad.at(i, j) + G.at(i, j))
            b.grad.put(bi, j, b.grad.at(bi, j) + G.at(i, j))
            j := j + 1
        }
    }
}

; H = tanh(Z): G_Z += G_H (1 - H²), number by number
procedure back_tanh(H: Matrix, G: Matrix, mutable a: ref[Entry])
{
    for k in H.rows * H.cols
    {
        let h H.data[k]
        a.grad.data.put(k, a.grad.data[k] + G.data[k] * (1.0 - h * h))
    }
}

; H = max(0, Z): G_Z += G_H where Z > 0, number by number
procedure back_relu(H: Matrix, G: Matrix, mutable a: ref[Entry])
{
    for k in H.rows * H.cols
    {
        if H.data[k] > 0.0
            a.grad.data.put(k, a.grad.data[k] + G.data[k])
    }
}

; L = (1/n) Σ ½ (a - t)²: G_A += G_L (a - t) / n
procedure back_loss(G: Matrix, mutable a: ref[Entry], t: ref[Entry])
{
    let A a.value
    let T t.value
    let n A.rows as f64
    for i in A.rows
        a.grad.put(i, 0, a.grad.at(i, 0) + G.at(0, 0) * (A.at(i, 0) - T.at(i, 0)) / n)
}

; --- the network ------------------------------------------------------------

define Net(W1: Matrix, b1: Matrix, W2: Matrix, b2: Matrix, W3: Matrix, b3: Matrix)

; Each number moved against its derivative.
procedure descend(mutable W: Matrix, w: Value, rate: f64)
{
    var k 0
    while k < W.rows * W.cols
    {
        W.data.put(k, W.data[k] - rate * w.at.grad.data[k])
        k := k + 1
    }
}

; The output for all the points of X.
function answer(net: Net, X: Matrix) returns Matrix
{
    let h1 relu(leaf(X) * leaf(net.W1) + leaf(net.b1))
    let h2 relu(h1 * leaf(net.W2) + leaf(net.b2))
    let a tanh(h2 * leaf(net.W3) + leaf(net.b3))
    a.at.value
}

; One step of gradient descent: the forward computation written as the
; formulas, the way back taken by the tape.
procedure step(mutable net: Net, X: Matrix, T: Matrix, rate: f64)
{
    let w1 leaf(net.W1)
    let b1 leaf(net.b1)
    let w2 leaf(net.W2)
    let b2 leaf(net.b2)
    let w3 leaf(net.W3)
    let b3 leaf(net.b3)
    let h1 relu(leaf(X) * w1 + b1)
    let h2 relu(h1 * w2 + b2)
    let a tanh(h2 * w3 + b3)
    var l loss(a, leaf(T))
    backward(l)
    descend(net.W1, w1, rate)
    descend(net.b1, b1, rate)
    descend(net.W2, w2, rate)
    descend(net.b2, b2, rate)
    descend(net.W3, w3, rate)
    descend(net.b3, b3, rate)
}

procedure report(step: int, net: Net, X: Matrix, T: Matrix,
                 TX: Matrix, TT: Matrix)
{
    let train mean_half_square(answer(net, X), T)
    let test mean_half_square(answer(net, TX), TT)
    print "step `step` train `train` test `test`"
}

; --- the run ----------------------------------------------------------------

; The starting weights as the field draws them: it keeps a network of up to
; seven layers of eight neurons, each layer's weights in 8 x 8 places (a row
; for each neuron, i, its inputs along it, m) and then 8 biases, and draws a
; number between -0.5 and 0.5 for every place in that order; a bias is 0.1.
; Ours takes the numbers of the places it has, weight m of neuron i at row
; m and column i.
var net Net(zeros(2, 4), zeros(1, 4), zeros(4, 2), zeros(1, 2), zeros(2, 1), zeros(1, 1))
var place 0
while place < 7 * 72
{
    let r between(0.0 - 0.5, 0.5)
    let block place / 72
    let at place % 72
    let i at / 8
    let m at % 8
    if at < 64
    {
        if block = 0 and i < 4 and m < 2
            net.W1.put(m, i, r)
        if block = 1 and i < 2 and m < 4
            net.W2.put(m, i, r)
        if block = 2 and i < 1 and m < 2
            net.W3.put(m, i, r)
    }
    else
    {
        if block = 0 and at - 64 < 4
            net.b1.put(0, at - 64, 0.1)
        if block = 1 and at - 64 < 2
            net.b2.put(0, at - 64, 0.1)
        if block = 2 and at - 64 < 1
            net.b3.put(0, at - 64, 0.1)
    }
    place := place + 1
}

; 400 points of the circle, the field's way: of each four the first two
; orange (+1) inside a radius of 2.5, the others blue (-1) in the ring from
; 3.5 to 5; of each two the second a test point.
var X zeros(200, 2)
var T zeros(200, 1)
var TX zeros(200, 2)
var TT zeros(200, 1)
var p 0
while p < 400
{
    let kind if (p / 2) % 2 = 0: 1.0 else 0.0 - 1.0
    let r if kind > 0.0: between(0.0, 2.5) else between(3.5, 5.0)
    let angle between(0.0, 6.283185307179586)
    ; the field draws noise for each point too, here none
    between(0.0 - 5.0, 5.0)
    between(0.0 - 5.0, 5.0)
    if p % 2 = 0
    {
        X.put(p / 2, 0, r * sin(angle))
        X.put(p / 2, 1, r * cos(angle))
        T.put(p / 2, 0, kind)
    }
    else
    {
        TX.put(p / 2, 0, r * sin(angle))
        TX.put(p / 2, 1, r * cos(angle))
        TT.put(p / 2, 0, kind)
    }
    p := p + 1
}

var s 0
while s <= 3000
{
    if s % 100 = 0
        report(s, net, X, T, TX, TT)
    step(net, X, T, 0.03)
    s := s + 1
}
let A answer(net, TX)
var right 0
p := 0
while p < 200
{
    if A.at(p, 0) * TT.at(p, 0) > 0.0
        right := right + 1
    p := p + 1
}
print "test right `right` of 200"
