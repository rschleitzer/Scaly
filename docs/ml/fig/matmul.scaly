; A picture for Machine Learning with Scaly (docs/figures.py takes the SVG
; it shows): the matrix product Z = X W as three blocks of cells. On the
; left X, a row for each point (six shown) and a column for each input
; (two); on top W, a row for each input and a column for each neuron (four);
; below W and right of X, Z, a row for each point and a column for each
; neuron. Row i of X and column j of W are orange, and where they cross in Z
; the one number they make together, z with ij, is orange at full strength;
; x with ik and w with kj name a number of the row and of the column, both
; at the same place k (the first), the two that are multiplied together.
define CELL int 60
define MARGIN int 52
define LETTER int 44
define SMALL int 36
define ROWS int 6
; the row of X and the column of W shown
define ROW int 2
define COLUMN int 1

let pale "#f3f3f1"
let light "#efc3a3"
let orange "#e8853d"
let border "#9a9aa0"
let ink "#1d1d1f"

; where the blocks begin: X at the left below W's height and a gap, W and
; Z one cell right of X
let x_left MARGIN
let w_left MARGIN + 3 * CELL
let w_top MARGIN
let x_top MARGIN + 3 * CELL
let width w_left + 4 * CELL + MARGIN / 2
let height x_top + ROWS * CELL + MARGIN

var sheet Drawing(width, height)
sheet.rect(0, 0, width, height, "white")

; X: ROWS rows of 2
var r 0
while r < ROWS
{
    var c 0
    while c < 2
    {
        sheet.box(x_left + c * CELL, x_top + r * CELL, CELL, CELL, if r = ROW: light else pale, border)
        c := c + 1
    }
    r := r + 1
}
; W: 2 rows of 4
r := 0
while r < 2
{
    var c 0
    while c < 4
    {
        sheet.box(w_left + c * CELL, w_top + r * CELL, CELL, CELL, if c = COLUMN: light else pale, border)
        c := c + 1
    }
    r := r + 1
}
; Z: ROWS rows of 4
r := 0
while r < ROWS
{
    var c 0
    while c < 4
    {
        sheet.box(w_left + c * CELL, x_top + r * CELL, CELL, CELL, if r = ROW and c = COLUMN: orange else pale, border)
        c := c + 1
    }
    r := r + 1
}

; the names of the matrices: X above its block, W left of its block, Z
; below its block
sheet.math(x_left + CELL, x_top - LETTER / 3, "X", "", LETTER, ink)
sheet.math(w_left - LETTER * 3 / 4, w_top + CELL + LETTER / 3, "W", "", LETTER, ink)
sheet.math(w_left + 2 * CELL, x_top + ROWS * CELL + LETTER, "Z", "", LETTER, ink)
; the numbers: in row i of X and in column j of W at the same place k, and
; where row and column cross
sheet.math(x_left + CELL / 2, x_top + ROW * CELL + CELL / 2 + SMALL / 4, "x", "ik", SMALL, ink)
sheet.math(w_left + COLUMN * CELL + CELL / 2, w_top + CELL / 2 + SMALL / 4, "w", "kj", SMALL, ink)
sheet.math(w_left + COLUMN * CELL + CELL / 2, x_top + ROW * CELL + CELL / 2 + SMALL / 4, "z", "ij", SMALL, ink)
sheet.show()
