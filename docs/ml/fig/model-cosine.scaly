; A picture for Machine Learning with Scaly (docs/figures.py makes it a PNG):
; the model f(x, y) = cos(pi (x² + y²) / 72) as a colouring of the plane
; from -6 to 6, in the colours of the field (web/field) -- orange where it
; answers +1, blue where -1, pale where it is unsure. Each point of the
; picture is computed, the rounds of the `for` on all cores; the picture
; goes to picture.<size>x<size>.rgba, four bytes a point.
define SIZE int 480

; One channel, the part `sure` of the way from `zero` to `to`.
function mix(zero: f64, to: f64, sure: f64) returns u32
{
    (zero + (to - zero) * sure).round_even() as u32
}

; A value between -1 and 1 as the field's colour, and the axes drawn faintly
; over it where `axis` says how near one is (0 far, 1 on it).
function colour(v: f64, axis: f64) returns u32
{
    let sure (if v < 0.0: 0.0 - v else v) * 0.85
    let (r, g, b) if v > 0.0: (232.0, 133.0, 61.0) else (59.0, 125.0, 216.0)
    let dim 1.0 - 0.18 * axis
    let red mix(243.0, r, sure) as f64 * dim
    let green mix(243.0, g, sure) as f64 * dim
    let blue mix(241.0, b, sure) as f64 * dim
    (red as u32) | ((green as u32) << 8) | ((blue as u32) << 16) | ((255 as u32) << 24)
}

; How near a picture coordinate lies to the axis at the middle: 1 on it,
; fading to 0 a point and a half away.
function near_axis(c: f64) returns f64
{
    let d c - (SIZE as f64) / 2.0
    let a 1.5 - (if d < 0.0: 0.0 - d else d)
    if a < 0.0: 0.0 else if a > 1.0: 1.0 else a
}

function point(p: int) returns u32
{
    let px (p % SIZE) as f64 + 0.5
    let py (p / SIZE) as f64 + 0.5
    let x px * 12.0 / (SIZE as f64) - 6.0
    let y 6.0 - py * 12.0 / (SIZE as f64)
    let axis near_axis(px) + near_axis(py)
    colour(cos(3.141592653589793 * (x * x + y * y) / 72.0), if axis > 1.0: 1.0 else axis)
}

var picture Vector[u32]((SIZE * SIZE) as size_t)
for p in SIZE * SIZE
    picture.put(p as size_t, point(p))
if File.write_bytes("picture.`SIZE`x`SIZE`.rgba", picture.as_bytes()) = false
    print "the picture could not be written"
